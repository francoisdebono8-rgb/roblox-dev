-- Offline extraction of trusted repo sources. Never shipped to Studio/runtime.
local fs=require("@lune/fs")
local serde=require("@lune/serde")
local H=require("../tests/Harness")
local source=fs.readFile("src/Client/VelmoraMotionEngine.luau")
assert(source:match("return Motion%s*$"),"Motion source contract changed")
source=source:gsub("return Motion%s*$","return {clips=CLIPS,timing=timing,throws=THROWS}")
local fn=assert(loadstring(source,"CombatInventory"))
setfenv(fn,setmetatable({require=H.load,script={Parent={}}},{__index=function(_,k)return H.envBase[k] or getfenv()[k]end}))
local motion=fn();local fighters=H.fighters;local graphs=H.load("Shared/MoveGraphs")
local rows={};local characters={}
for _,id in {"Flashstep","Mirage","GentleFist","Lion"} do
 local def=assert(fighters[id]);local graph=assert(graphs[id]);local route=assert(motion.clips[id]);local actions={}
 for _,name in {"Light1","Light2","Light3","Heavy","Launcher","DashAttack","Air1","Air2","Slam","Grab","Throw","ThrowUp","Sweep","WallDive","Riposte"} do actions[name]=true end
 for _,name in graph.routes do actions[name]=true end
 for _,key in {"heavyAfterOne","readCounter"} do if graph[key] then actions[graph[key]]=true end end
 -- These are the only variant overrides used by the current motion renderer.
 if id=="Flashstep" then actions.Rasengan=true;actions.RasenganDrop=true elseif id=="Lion" then actions.LionBarrage=true end
 local names={};for name in actions do table.insert(names,name) end;table.sort(names)
 for _,name in names do
  local clip=route[name] or route.Light1
  local resolved=if route[name] then name else "Light1"
  local origin=id;local cursor=route
  while not rawget(cursor,resolved) do
   local parent=getmetatable(cursor) and getmetatable(cursor).__index
   if type(parent)~="table" then break end
   for parentId,parentRoute in motion.clips do if parentRoute==parent then origin=parentId;break end end
   cursor=parent
  end
  local aliases={};for alias,keys in route do if keys==clip then table.insert(aliases,alias) end end;table.sort(aliases)
  local startup,active,recovery=motion.timing(name,id)
  table.insert(rows,{character=def.Name,fighterId=id,action=name,clip=resolved,origin=origin,aliases=aliases,
   runtimePath="src/Client/VelmoraMotionEngine.luau: CLIPS."..id.."."..name,
   motionLabPreset=id,motionLabGrammar=name,automaticApply=false,keyCount=#clip,
   timing={startup=startup,active=active,recovery=recovery},notes="Resolved renderer clip; this is not a recommendation to assign a new bilateral/reference variant."})
 end
 local techniques={};for _,tech in def.Techniques do table.insert(techniques,{id=tech.Id,name=tech.Name,throw=tech.Throw,requires=tech.Requires}) end
 characters[id]={name=def.Name,routes=graph.routes,heavyAfterOne=graph.heavyAfterOne,counter=graph.readCounter,tool=def.Tool,toolMastery=def.ToolMastery,awakening=def.Awakening and def.Awakening.Name,techniques=techniques}
end
local throws={};for name in motion.throws do table.insert(throws,name) end;table.sort(throws)
local inventory={format="NinjaDuel.CombatInventory.v1",characters=characters,mapping=rows,throwOverlays=throws,
 notes={"Motion Lab exports are data-only and automaticApply=false.","Cast/throw/reaction/locomotion overlays are separate renderer branches, not necessarily CLIPS entries.","Timing here is presentation timing; authoritative tuned pending.spec is visible in the debug inspector.","Bilateral/reference library assets are candidates for manual artistic assignment, not currently applied to attacks."}}
fs.writeFile("docs/current/COMBAT_INVENTORY.json",serde.encode("json",inventory,true).."\n")
local lines={"# Character → Combat Action → Motion Variant","","Generated by `lune run tools/combat_inventory.luau` from the current runtime. No animation is changed.","","`origin` explicitly exposes inherited clips. Motion Lab preset IDs match fighter IDs. Exports stay inert; assigning a new L/R/reference asset is a manual artistic decision.","","| Character | Combat action/variant | CLIPS origin | Shared aliases | Presentation startup/active/recovery |","|---|---|---|---|---|"}
for _,r in rows do table.insert(lines,string.format("| %s (`%s`) | `%s` | `%s` | %s | %.3f / %.3f / %.3f s |",r.character,r.fighterId,r.action,r.origin,table.concat(r.aliases,", "),r.timing.startup,r.timing.active,r.timing.recovery)) end
fs.writeFile("docs/current/MOTION_ATTACK_MAPPING.md",table.concat(lines,"\n").."\n")
print("Combat inventory: "..#rows.." resolved four-character mappings; no runtime mutation")
