-- Konoha redone (19/11, plan-vrai-jeu § 4 ANIMATEUR; Shared/KonohaLayout, generated by
-- tools/blender/konoha_layout.py). Headless: no building on a street, in a kept-open place or
-- over a spot the game already uses (spawns, masters, the proctor, the street duels, the
-- welcome trio); the houses are the six models at 800 to 2 000 triangles; every HUD place has
-- its point on the minimap; the village wall is higher than any roof plus a leap.
local H=require("./Harness")
local passed=0
local function test(name,fn)
	local ok,err=pcall(fn);assert(ok,name..": "..tostring(err));passed+=1;print("PASS "..name)
end
local K=H.load("Shared/KonohaLayout")
local Map=H.load("Shared/HubMap")

local function rect(b)
	local w,d=b[4],b[5]
	if b[7]%180==90 then w,d=d,w end
	return b[2]-w/2,b[3]-d/2,b[2]+w/2,b[3]+d/2
end
local function inRect(x,z,x0,z0,x1,z1,pad) pad=pad or 0;return x>x0-pad and x<x1+pad and z>z0-pad and z<z1+pad end
local function streetRect(s)
	local h=s.width/2
	local x0,x1=math.min(s.a.X,s.b.X),math.max(s.a.X,s.b.X)
	local z0,z1=math.min(s.a.Y,s.b.Y),math.max(s.a.Y,s.b.Y)
	if s.a.X==s.b.X then x0-=h;x1+=h else z0-=h;z1+=h end
	return x0,z0,x1,z1
end
-- landmarks a master stands on or in by design
local STOOD_ON={pier=true,torii=true,exam_hall=true,exam_hall_wing=true}

test("houses: off the streets and the open places, apart from each other",function()
	local n=0
	for i,b in K.Buildings do
		if b[9]==nil then
			n+=1
			local x0,z0,x1,z1=rect(b)
			for _,s in K.Streets do
				local a0,b0,a1,b1=streetRect(s)
				assert(not(x0<a1 and a0<x1 and z0<b1 and b0<z1),("house %d (%s) on %s"):format(i,b[1],s.id))
			end
			for _,o in K.Open do
				if o.shape=="circle" then
					local nx=math.clamp(o.at.X,x0,x1);local nz=math.clamp(o.at.Y,z0,z1)
					assert((nx-o.at.X)^2+(nz-o.at.Y)^2>=o.radius^2,("house %d in %s"):format(i,o.why))
				else
					assert(not(x0<o.x1 and o.x0<x1 and z0<o.z1 and o.z0<z1),("house %d in %s"):format(i,o.why))
				end
			end
			for j,c in K.Buildings do
				if j~=i then
					local c0,d0,c1,d1=rect(c)
					assert(not(x0<c1 and c0<x1 and z0<d1 and d0<z1),("house %d overlaps building %d"):format(i,j))
				end
			end
		end
	end
	assert(n>=120,"a dense village: "..n.." houses")
end)

test("the spots the game already uses stay clear of every building",function()
	local s=Map.Scale
	local spots={}
	for k,v in Map.Spawns do spots["spawn "..k]=v.at/s end
	for k,v in Map.Masters do spots["master "..k]=v.at/s end
	for k,v in Map.Welcome do spots["welcome "..k]=v.at/s end
	spots.proctor=Map.Proctor.at/s
	for _,v in Map.Streets do spots["street "..v.key]=v.at/s end
	for what,at in spots do
		for _,b in K.Buildings do
			if not STOOD_ON[b[1]] then
				local x0,z0,x1,z1=rect(b)
				assert(not inRect(at.X,at.Z,x0,z0,x1,z1),("%s (%.0f,%.0f) inside %s"):format(what,at.X,at.Z,b[9] or b[1]))
			end
		end
	end
end)

test("six house models, each 800 to 2 000 triangles, and every house one of them",function()
	local count=0
	for name,m in K.Houses do
		count+=1
		assert(m.tris>=800 and m.tris<=2000,name..": "..m.tris.." triangles")
	end
	assert(count==6,"six models, got "..count)
	for i,b in K.Buildings do
		assert(b[9]~=nil or K.Houses[b[1]],("building %d: unknown model %s"):format(i,b[1]))
	end
end)

test("the minimap: a point for every HUD place, inside the map, the masters marked",function()
	local byPlace={}
	for _,p in K.Pois do
		if p.place then byPlace[p.place]=p end
		local u=K.toMap(p.at.X,p.at.Y)
		if not p.far then assert(u.X>=0 and u.X<=1 and u.Y>=0 and u.Y<=1,p.id.." off the map") end
		assert(p.tier>=1 and p.tier<=3,p.id.." tier")
	end
	for _,place in Map.Places do assert(byPlace[place.id],"no minimap point for "..place.id) end
	local met={}
	for _,p in K.Pois do if p.master then met[p.master]=true end end
	for key in Map.Masters do assert(met[key],"no minimap point for the master "..key) end
	assert(#K.poisFor(1)<#K.poisFor(3),"the zoom shows more")
	assert(K.districtAt(0,120).id=="Main" and K.districtAt(-152,-104).id=="Hyuga" and K.districtAt(150,-90).id=="Uchiha")
end)

test("the village wall: higher than the tallest roof plus a jump and its leap",function()
	local tallest=0
	for _,b in K.Buildings do if b[9]==nil then tallest=math.max(tallest,b[6]) end end
	local leap=21.61/K.Scale -- konoha_profile.json jumpApex, in base studs
	for _,w in K.Walls do
		if string.sub(w[1],1,4)=="Wall" then
			assert(w[6]>tallest+leap,("%s: %d tall, a roof is %d"):format(w[1],w[6],tallest))
		end
	end
end)

print(("%d tests passed"):format(passed))
