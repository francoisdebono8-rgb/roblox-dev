local H=require("./Harness")
local S=H.load("Server/ProfileSchema");local cfg=H.load("Server/ProgressionConfig")
local E=H.load("Server/CollectionEconomy");local P=H.load("Server/CharacterProgression")
local Definitions=H.load("Server/ProgressionDefinitions");local Roster=H.load("Server/ProgressionRoster")
local Lobby=H.load("Server/ProgressionLobby");local RNG=H.load("Server/ProgressionRandom");local Sim=H.load("Server/PackSimulation")
local passed=0
local function test(name,fn) local ok,err=pcall(fn);assert(ok,name..": "..tostring(err));passed+=1;print("PASS "..name) end
local function new() return S.new("dev_spec",cfg) end
local function apply(p,kind,args,rng) return E.apply(p,cfg,p.commandSequence+1,kind,args,rng or function() return .5 end) end
test("single online starter; full local roster is independent",function()
 local p=new();assert(#Roster.list(cfg,p,"Ranked")==1 and #Roster.list(cfg,nil,"Local")==5)
 assert(Roster.select(cfg,nil,"Local","Mirage"));assert(not Roster.select(cfg,p,"Ranked","Mirage"))
 assert(cfg.Enabled==false and cfg.CombatEffectsEnabled==false and cfg.MonetizationEnabled==false)
end)
test("configuration rejects invalid caps, weights and impossible guarantees",function()
 assert(Definitions.validate(cfg));local bad=S.copy(cfg)
 bad.Characters.Sand.stats.Speed.growth=math.huge;assert(not pcall(Definitions.validate,bad))
 bad=S.copy(cfg);bad.Rarities.Epic="bad";assert(not pcall(Definitions.validate,bad))
 bad=S.copy(cfg);bad.Characters.Sand.stats.Speed.cap=0;assert(not pcall(Definitions.validate,bad))
 bad=S.copy(cfg);bad.Packs.Training.entries[1].weight=0/0;assert(not pcall(Definitions.validate,bad))
 bad=S.copy(cfg);bad.Packs.Training.entries={{character="Sand",rarity="Common",weight=1,fragments=10}};bad.Packs.Training.guarantee={minRarity="Epic"};assert(not pcall(Definitions.validate,bad))
end)
test("XP/rank derives capped identity previews without mutating active fighters",function()
 local before=H.fighters.Sand.Speed;local p=apply(new(),"unlock",{character="Sand"})
 p=apply(p,"xp",{character="Sand",amount=99999});local a=P.project(cfg,"Sand",p.characters.Sand,false)
 assert(a.level==cfg.MaxLevel and a.stats.Speed<=cfg.Characters.Sand.stats.Speed.cap)
 assert(a.stats.Speed<H.fighters.Flashstep.Speed and H.fighters.Sand.Speed==before and not a.applicationEnabled)
 local rank=apply(p,"rank",{character="Sand",rank="Adept"});assert(P.rank(cfg,rank.characters.Sand.xp)=="Adept")
end)
test("ranked neutralizes all proposed growth; progression preview remains inert",function()
 local p=apply(new(),"xp",{character=cfg.Starter,amount=4900})
 local ranked=Roster.select(cfg,p,"Ranked",cfg.Starter);local growth=Roster.select(cfg,p,"ProgressionBattles",cfg.Starter)
 assert(ranked.potential.stats.Speed==cfg.Characters[cfg.Starter].stats.Speed.base)
 assert(growth.potential.stats.Speed>ranked.potential.stats.Speed and not growth.combatApplicationEnabled)
end)
test("mastery options/awakening/cosmetics/currency claim exactly once",function()
 local p=apply(new(),"xp",{character=cfg.Starter,amount=3000})
 for _,reward in cfg.Characters[cfg.Starter].rewards do
  p=apply(p,"mastery",{character=cfg.Starter,reward=reward.id});local previous=p.currencies.MasteryTokens
  local again,result=apply(p,"mastery",{character=cfg.Starter,reward=reward.id});assert(result.alreadyClaimed and again.currencies.MasteryTokens==previous);p=again
 end
 local ch=p.characters[cfg.Starter];assert(next(ch.variants) and next(ch.awakenings) and next(ch.cosmetics));assert(p.currencies.MasteryTokens==10)
 assert(not pcall(apply,new(),"mastery",{character=cfg.Starter,reward=cfg.Starter..":master"}))
end)
test("new definitions allow multiple techniques/awakenings and currencies",function()
 local c=S.copy(cfg)
 c.Currencies.EventTokens={premium=false,initial=0}
 c.Characters.NewCharacter={rarity="Rare",unlockFragments=20,stats={Speed={base=8,growth=.02,cap=9}},rewards={{id="branch-a",rank="Adept",grants={{kind="technique",id="tech-a"},{kind="technique",id="tech-b"},{kind="awakening",id="awake-a"},{kind="awakening",id="awake-b"},{kind="currency",id="EventTokens",amount=7}}}}}
 assert(Definitions.validate(c));local p=S.new("dev_new",c)
 p=E.apply(p,c,1,"unlock",{character="NewCharacter"});p=E.apply(p,c,2,"xp",{character="NewCharacter",amount=500});p=E.apply(p,c,3,"mastery",{character="NewCharacter",reward="branch-a"})
 assert(p.characters.NewCharacter.techniques["tech-a"] and p.characters.NewCharacter.techniques["tech-b"] and p.characters.NewCharacter.awakenings["awake-a"] and p.characters.NewCharacter.awakenings["awake-b"] and p.currencies.EventTokens==7)
end)
test("failed grants and overspend roll back every field",function()
 local p=new();assert(not pcall(apply,p,"currency",{currency="Coins",amount=-1}));assert(p.currencies.Coins==0 and p.commandSequence==0)
 assert(not pcall(apply,p,"reward",{stream="matches",rewardSequence=1,grants={{kind="currency",id="Coins",amount=50},{kind="unknown",id="bad"}}}))
 assert(p.currencies.Coins==0 and p.rewardStreams.matches==nil)
 assert(not pcall(apply,p,"xp",{character=cfg.Starter,amount=math.huge}))
end)
test("command replay and reward-stream replay cannot duplicate rewards",function()
 local p,result=apply(new(),"currency",{currency="Coins",amount=100})
 local again,cached,replay=E.apply(p,cfg,1,"currency",{currency="Coins",amount=999});assert(replay and again.currencies.Coins==100 and cached.balance==100)
 p=apply(p,"reward",{stream="matches",rewardSequence=1,grants={{kind="currency",id="Coins",amount=50}}})
 p,result=apply(p,"reward",{stream="matches",rewardSequence=1,grants={{kind="currency",id="Coins",amount=50}}});assert(result.alreadyApplied and p.currencies.Coins==150)
 assert(not pcall(E.apply,p,cfg,1,"pack",{pack="Training"},function() return 0 end))
 assert(not pcall(apply,p,"reward",{stream="matches",rewardSequence=3,grants={}}))
end)
test("fragments unlock once; duplicates and revocation preserve mastery",function()
 local p=new();E.fragments(p,cfg,"Mirage",49);assert(not p.collection.Mirage)
 E.fragments(p,cfg,"Mirage",2);assert(p.collection.Mirage and p.fragments.Mirage==1)
 p=apply(p,"xp",{character="Mirage",amount=500});p=apply(p,"select",{character="Mirage"});p=apply(p,"revoke",{character="Mirage"})
 assert(p.selected==cfg.Starter and p.characters.Mirage.xp==500)
 p=apply(p,"unlock",{character="Mirage"});assert(p.characters.Mirage.xp==500)
 assert(not pcall(apply,new(),"revoke",{character=cfg.Starter}))
end)
test("pack spend, rarity guarantees, pity and duplicate policies are atomic",function()
 local c=S.copy(cfg);c.Packs.Fixed={currency="Coins",cost=20,slots=1,entries={{character="Sand",rarity="Common",weight=99,fragments=10},{character="Mirage",rarity="Epic",weight=1,fragments=10}},duplicate={mode="currency",currency="MasteryTokens",amount=2},pity={after=3,minRarity="Epic"}}
 local p=S.new("dev_packs",c);p.currencies.Coins=100
 for i=1,3 do local q,result=E.apply(p,c,i,"pack",{pack="Fixed"},function() return 0 end);p=q
  if i==3 then assert(result.pityForced and result.drops[1].character=="Mirage" and p.pity.Fixed==0) else assert(result.drops[1].character=="Sand") end
 end
 assert(p.currencies.Coins==40)
 c.Packs.Fixed.guarantee={minRarity="Epic"};E.unlock(p,c,"Mirage")
 local q,result=E.apply(p,c,4,"pack",{pack="Fixed"},function() return 0 end)
 assert(result.drops[1].duplicate and q.currencies.MasteryTokens==2 and q.currencies.Premium==0)
end)
test("RNG failure does not consume currency or advance a transaction",function()
 local p=new();p.currencies.Coins=100
 assert(not pcall(apply,p,"pack",{pack="Training"},function() return 1 end));assert(p.currencies.Coins==100 and p.commandSequence==0)
end)
test("v1 migration preserves XP/unknown ownership; future/corrupt saves rejected",function()
 local old=new();old.schemaVersion=1;old.characterXP={[cfg.Starter]=700,Retired=123};old.characters=nil;old.collection.Retired=true
 local p=S.migrate(old,cfg);assert(p and p.characters.Retired.xp==123 and p.collection.Retired and p.characters[cfg.Starter].xp==700)
 local again=S.migrate(p,cfg);assert(again.characters.Retired.xp==123)
 local incomplete=new();incomplete.stats.packs=nil;assert(not S.validate(incomplete,cfg))
 incomplete=new();incomplete.characters[cfg.Starter].stats.xpEarned=nil;assert(not S.validate(incomplete,cfg))
 old.currencies=nil;assert(not S.migrate(old,cfg))
 p.schemaVersion=99;assert(not S.migrate(p,cfg));p=new();p.currencies.Coins=-1;assert(not S.validate(p,cfg))
 local cycle={};cycle.self=cycle;assert(not S.migrate(cycle,cfg));p=new();p.bad=function() end;assert(not S.validate(p,cfg))
end)
test("match records and XP are server data only and replay safe",function()
 local p=apply(new(),"matchResult",{character=cfg.Starter,won=true,xp=150})
 assert(p.stats.matches==1 and p.characters[cfg.Starter].stats.wins==1 and p.characters[cfg.Starter].stats.xpEarned==150)
 local again=E.apply(p,cfg,1,"matchResult",{character=cfg.Starter,won=true,xp=150});assert(again.stats.matches==1)
end)
test("lobby segregates modes, validates owned roster again on dequeue",function()
 assert(not Lobby.new(cfg,function() end))
 local c=S.copy(cfg);c.Enabled=true;local p,q,t={},{},{};local data={[p]=new(),[q]=new(),[t]=new()};local l=Lobby.new(c,function(player) return data[player],data[player]~=nil end)
 assert(not l:join(p,"Ranked","arbitrary-region",cfg.Starter) and next(l.queues)==nil)
 assert(not l:join(p,"Ranked","EU","Mirage"));assert(l:join(p,"Ranked","EU",cfg.Starter));assert(l:join(q,"ProgressionBattles","EU",cfg.Starter))
 assert(not l:pair("Ranked:EU"));assert(l:join(t,"Ranked","EU",cfg.Starter));local pair=l:pair("Ranked:EU");assert(pair.mode=="Ranked" and not pair.combatApplicationEnabled)
 l:leave(q);data[q]=apply(new(),"unlock",{character="Mirage"});assert(l:join(q,"Ranked","EU","Mirage"));data[q]=new();assert(not l:pair("Ranked:EU") and not l.queued[q] and next(l.queues)==nil)
end)
test("simulation reproducible, frequencies sum to one, censoring reported",function()
 local a=Sim.run(cfg,{profiles=20,packs=20,seed=42});local b=Sim.run(cfg,{profiles=20,packs=20,seed=42})
 assert(a.drops==400 and a.averageOwned==b.averageOwned and a.duplicateRate==b.duplicateRate)
 local sum=0;for id,row in a.distribution do sum+=row.frequency;assert(row.draws==b.distribution[id].draws and row.censoredProfiles==20-row.unlockedProfiles) end
 assert(math.abs(sum-1)<1e-8 and a.completedProfiles+a.censoredCompletionProfiles==20)
 assert(not pcall(Sim.run,cfg,{profiles=10000,packs=10000}))
end)
print("NinjaDuel progression/economy: "..passed.." PASS (isolated data, no combat modifiers)")
