local H=require("./Harness")
local S=H.load("Server/ProfileSchema");local cfg=H.load("Server/ProgressionConfig")
local Repo=H.load("Server/ProfileRepository");local Memory=H.load("Server/DevelopmentProfileStore")
local Tools=H.load("Server/DevelopmentProfiles")
local passed=0
local function test(name,fn) local ok,err=pcall(fn);assert(ok,name..": "..tostring(err));passed+=1;print("PASS "..name) end
local now=1000
local function repo(store,owner) return Repo.new(store,cfg,{owner=owner,clock=function() return now end,sleep=function() end}) end
local function credit(r,h,n) assert(r:apply(h,h.data.commandSequence+1,"currency",{currency="Coins",amount=n})) end
test("exclusive writer and release/reload preserve every important field",function()
 now=1000;local store=Memory.new();local a=repo(store,"A");local b=repo(store,"B");local h=a:load("dev_lock");assert(h)
 assert(not b:load("dev_lock"));credit(a,h,100);assert(a:save(h,true))
 local other=b:load("dev_lock");assert(other and other.data.currencies.Coins==100)
 assert(b:apply(other,2,"unlock",{character="Mirage"}));assert(b:apply(other,3,"xp",{character="Mirage",amount=500}));assert(b:save(other,true))
 local loaded=a:load("dev_lock");assert(loaded.data.characters.Mirage.xp==500 and loaded.data.commandSequence==3)
 local copy=a:view(loaded);copy.currencies.Coins=999;assert(loaded.data.currencies.Coins==100)
end)
test("failed load never falls back to writable default",function()
 now=1000;local store=Memory.new();store.failBefore=9;local r=repo(store,"A")
 assert(not r:load("dev_failed") and next(r.handles)==nil and next(store.data)==nil)
end)
test("ambiguous committed save retries same packet without duplicate currency",function()
 now=1000;local store=Memory.new();local r=repo(store,"A");local h=r:load("dev_ambiguous");credit(r,h,100)
 store.repeatTransform=true;store.failAfter=1;assert(r:save(h));local record=r:verify(h.id)
 assert(record.profile.currencies.Coins==100 and record.profile.commandSequence==1 and record.revision==2)
end)
test("save uncertainty blocks mutations, then safely resumes/releases",function()
 now=1000;local store=Memory.new();local r=repo(store,"A");local h=r:load("dev_retry");credit(r,h,100)
 store.failBefore=3;assert(not r:save(h) and h.state=="SaveUncertain")
 assert(not r:apply(h,2,"currency",{currency="Coins",amount=50}))
 assert(r:save(h,true) and h.state=="Closed");assert(r:verify(h.id).profile.currencies.Coins==100)
end)
test("expired/taken-over lease fences stale writers",function()
 now=1000;local store=Memory.new();local a=repo(store,"A");local b=repo(store,"B");local old=a:load("dev_fence");credit(a,old,999)
 now+=cfg.LeaseSeconds+1;local current=b:load(old.id);assert(current)
 assert(not a:save(old) and not a:apply(old,2,"currency",{currency="Coins",amount=10}))
 credit(b,current,20);assert(b:save(current));assert(b:verify(old.id).profile.currencies.Coins==20)
end)
test("revision conflict rejects stale save despite matching owner",function()
 now=1000;local store=Memory.new();local r=repo(store,"A");local h=r:load("dev_revision");credit(r,h,100)
 store.data['p_'..h.id].revision+=1
 assert(not r:save(h) and h.state=="Lost" and store.data['p_'..h.id].profile.currencies.Coins==0)
end)
test("corrupt/future records cannot be overwritten or reset",function()
 now=1000;local p=S.new("dev_corrupt",cfg);p.schemaVersion=99
 local store=Memory.new({p_dev_corrupt={envelopeVersion=1,revision=0,profile=p}});local r=repo(store,"A")
 assert(not r:load(p.id) and store.data.p_dev_corrupt.profile.schemaVersion==99)
 local bad=S.new("dev_bad",cfg);bad.currencies.Coins=-50;store.data.p_dev_bad={envelopeVersion=1,revision=0,profile=bad};assert(not r:load("dev_bad"))
 assert(not r:load("real_player_123") and not r:verify("123"))
end)
test("mutation is rejected while a save yields",function()
 now=1000;local store=Memory.new();local r=repo(store,"A");local h=r:load("dev_busy");credit(r,h,100)
 local original=store.update;local rejected=false
 store.update=function(self,key,fn) rejected=not r:apply(h,2,"currency",{currency="Coins",amount=1000});return original(self,key,fn) end
 assert(r:save(h) and rejected and h.data.currencies.Coins==100)
end)
test("pack randomness is evaluated once, outside repeated UpdateAsync callbacks",function()
 now=1000;local store=Memory.new();local r=repo(store,"A");local h=r:load("dev_rng");credit(r,h,100)
 local rolls=0;assert(r:apply(h,2,"pack",{pack="Training"},function() rolls+=1;return .4 end))
 store.repeatTransform=true;store.failAfter=1;assert(r:save(h));assert(rolls==1 and r:verify(h.id).profile.stats.packs==1)
end)
test("pulse renews lease; closed profiles are no longer writable",function()
 now=1000;local r=repo(Memory.new(),"A");local h=r:load("dev_pulse");now+=cfg.SaveInterval
 assert(next(r:pulse())==nil and h.leaseUntil==now+cfg.LeaseSeconds)
 assert(next(r:closeAll())==nil and h.state=="Closed");assert(not r:apply(h,1,"currency",{currency="Coins",amount=1}))
end)
test("dev commands/reset/verification remain isolated; verify never creates a save",function()
 now=1000;local store=Memory.new();local t=Tools.new(cfg,store,{owner="tools",clock=function() return now end,sleep=function() end})
 assert(not t:run("verify",{profile="dev_missing"}).ok and next(store.data)==nil)
 assert(not t:run("unknown",{profile="dev_missing"}).ok and next(store.data)==nil)
 assert(t:run("simulate",{profiles=10,packs=2}).report.openings==20)
 for _,entry in {{"give",{character="Mirage"}},{"xp",{character="Mirage",amount=500}},{"rank",{character="Mirage",rank="Master"}},{"currency",{currency="Coins",amount=200}},{"pack",{pack="Training"}},{"remove",{character="Mirage"}}} do assert(t:run(entry[1],entry[2]).ok) end
 local before=t:run("dump").profile.commandSequence;assert(t:run("reset").ok)
 local p=t:run("dump").profile;assert(p.commandSequence==before+1 and p.currencies.Coins==0 and not p.collection.Mirage)
 assert(t:run("save").ok and t:run("verify").ok)
 assert(not t:run("give",{profile="live_1",character="Mirage"}).ok)
end)
test("real DataStore adapter is inert outside Studio and disabled by default",function()
 local adapter,reason=H.load("Server/DevelopmentDataStore").new(cfg);assert(not adapter and reason=="Development DataStore disabled")
end)
print("NinjaDuel profile persistence: "..passed.." PASS (fault-injected memory adapter; real backend OFF)")
