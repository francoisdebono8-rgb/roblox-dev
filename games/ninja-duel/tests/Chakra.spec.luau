local H=require("./Harness")
local S=H.load("Server/ProfileSchema");local V=H.load("Server/ChakraVectors")
local cfg=H.load("Server/ChakraConfig");local Rules=H.load("Server/ChakraRules")
local Engine=H.load("Server/ChakraInteractions");local Lab=H.load("Server/ChakraLab");local Dev=H.load("Server/ChakraDev")
local passed=0
local function test(name,fn) local ok,err=pcall(fn);assert(ok,name..": "..tostring(err));passed+=1;print("PASS "..name) end
local function new() local c=S.copy(cfg);c.Enabled=true;return assert(Engine.new(c)) end
local function near(a,b) assert(math.abs(a-b)<1e-6,tostring(a).." / "..tostring(b)) end
test("default off; experimental sandbox never edits original configuration",function()
 assert(Rules.validate(cfg));assert(not Engine.new(cfg));local lab=Lab.new(cfg);lab:demo("kunai_wind")
 assert(cfg.Enabled==false);for _,r in cfg.Rules do assert(r.enabled==false) end
 assert(H.fighters.Flashstep.Speed==H.load("Shared/Fighters").Flashstep.Speed)
end)
test("configuration rejects unknown tags/results, duplicate IDs and invalid numbers",function()
 for _,mutate in {function(c)c.Rules[1].effects[1].kind="ExecuteCode" end,function(c)c.Rules[1].when.source.all={"misspelled"} end,function(c)c.Rules[2].id=c.Rules[1].id end,function(c)c.Objects.Kunai.caps.speed=0/0 end,function(c)c.Infusions.Wind.cost=math.huge end,function(c)c.CharacterMastery.Bad="Unknown" end} do local c=S.copy(cfg);mutate(c);assert(not pcall(Rules.validate,c)) end
end)
test("wind and reinforcement are distinct, mastery scales within tool caps",function()
 local e=new();e:toggle("wind-kunai",true);e:toggle("reinforced-tool",true)
 e:spawn("a","Kunai");e:spawn("b","Kunai",{mastery="WeaponExpert"})
 assert(e:infuse("a","Wind").ok and e:infuse("b","Wind").ok);near(e.objects.a.stats.speed,52.5);near(e.objects.b.stats.speed,56.28)
 assert(e.objects.a.tags.wind and not e.objects.a.tags.reinforced and e.objects.b.stats.speed<=cfg.Objects.Kunai.caps.speed)
 assert(e:infuse("a","Reinforce").ok);assert(not e.objects.a.tags.wind and e.objects.a.tags.reinforced);near(e.objects.a.stats.speed,47.04)
end)
test("reinfusion recomputes base without multiplicative stacking; clear restores base",function()
 local e=new();e:toggle("wind-kunai",true);e:spawn("a","Kunai")
 assert(e:infuse("a","Wind").ok);assert(e:infuse("a","Wind").ok);near(e.objects.a.stats.speed,52.5)
 assert(e:infuse("a","None").ok);near(e.objects.a.stats.speed,42);assert(not e.objects.a.tags.wind and e.objects.a.chakra==94)
end)
test("incompatible nature, zero direction and insufficient chakra change nothing",function()
 local e=new();e:spawn("w","Wire");local before=e:inspect("w")
 assert(not pcall(e.infuse,e,"w","Wind"));assert(e.objects.w.chakra==before.chakra and not e.objects.w.infusion)
 e:spawn("a","Kunai",{chakra=1});assert(not pcall(e.infuse,e,"a","Wind"));assert(e.objects.a.chakra==1)
 assert(not pcall(e.launch,e,"a",V.new()));assert(not e.objects.a.launched)
end)
test("known property can be added/removed without assigning a character-specific engine",function()
 local e=new();e:spawn("a","Shuriken");assert(e:property("a","Marked",true).ok and e.objects.a.tags.marked)
 assert(e:property("a","Marked",false).ok and not e.objects.a.tags.marked)
 e:spawn("actor","Target");assert(not pcall(e.property,e,"actor","Seal",true));assert(not pcall(e.property,e,"a","Injected",true))
end)
test("seal embeds and emits one spatial point; no teleport or combat mutation",function()
 local lab=Lab.new(cfg);lab:demo("kunai_seal");local report=lab:run(1)
 local a=report.objects.a;assert(a.embedded and not a.launched and a.tags.spatialAnchor and a.anchor.surface=="wall")
 near(a.velocity.x,0);near(a.position.x,8);assert(#report.events[#report.events].applied==2)
end)
test("priority and exclusive group choose redirection once; fallback reflects",function()
 local lab=Lab.new(cfg);lab:demo("redirection");local e=lab.engine
 local result=lab:forceClash("a","b",V.new(0,1,0),V.new(1,0,0));assert(result.ok);near(e.objects.b.velocity.y,30.6);near(e.objects.b.velocity.x,0)
 local skipped=false;for _,t in result.trace do if t.rule=="deflect-projectile" and t.status=="exclusive-group" then skipped=true end end;assert(skipped)
 lab:demo("redirection");e:toggle("redirect-projectile",false);result=lab:forceClash("a","b");assert(result.ok and e.objects.b.velocity.x>0)
end)
test("failed selected effect rolls back both objects and resource cost",function()
 local lab=Lab.new(cfg);lab:demo("redirection");local e=lab.engine;local before=e:inspect("b");local chakra=e.objects.a.chakra
 local result=lab:forceClash("a","b",V.new(),V.new(1,0,0));assert(not result.ok)
 near(e.objects.b.velocity.x,before.velocity.x);assert(e.objects.a.chakra==chakra and e.counters.rejected==1)
end)
test("surface compatibility suppresses anchor and flame signal is data only",function()
 local lab=Lab.new(cfg);lab:demo("kunai_seal");local e=lab.engine
 e:surface("wood","Wood",V.new(8,3,1));local result=lab:embed("a","wood");assert(result.ok and #result.effects==0 and not e.objects.a.anchor)
 lab:demo("fire_surface");local report=lab:run(1);assert(report.surfaces.wood.tags.ignited)
 local found=false;for _,event in report.events do for _,signal in event.signals or {} do found=found or signal.name=="surface-ignition-request" end end;assert(found)
end)
test("wire property and contact conduction use tag scopes, not named fighters",function()
 local lab=Lab.new(cfg);lab:demo("wire_property");local e=lab.engine
 assert(e.objects.a.tags.conductiveWire and e.objects.a.tags.conductive and not e.objects.a.launched)
 e:spawn("target","Target");e:toggle("contact-conduction",true)
 assert(#e:trigger({trigger="Contact",source="a",target="target"}).signals==1)
end)
test("swept collision detects crossings, uses remaining time, avoids overlap repeats",function()
 local lab=Lab.new(cfg);lab:demo("redirection");local e=lab.engine
 e.objects.a.position=V.new(-2,3,0);e.objects.b.position=V.new(2,3,0);e:launch("a",V.new(1,0,0),100);e:launch("b",V.new(-1,0,0),100)
 lab:step(.05);assert(e.objects.b.velocity.x>0)
 local hits=0;for _,event in e.events do if event.trigger=="ProjectileClash" then hits+=1 end end;assert(hits==1)
 lab:step(.01);hits=0;for _,event in e.events do if event.trigger=="ProjectileClash" then hits+=1 end end;assert(hits==1)
 assert(V.sweep(V.new(-10),V.new(40),V.new(10),V.new(-40),1))
end)
test("surface sweep catches fast tools but excludes contact outside finite plane",function()
 local lab=Lab.new(cfg);lab:demo("projectile_surface");lab:run(.3);assert(lab.engine.objects.a.embedded)
 lab:demo("projectile_surface");lab.engine.objects.a.position.x=20;lab:run(.3);assert(not lab.engine.objects.a.embedded)
end)
test("all/any/none and mastery requirements are declarative and explain rejection",function()
 local rule={when={source={all={"tool"},any={"metal","wire"},none={"fire"}},minMastery={Seal=2}}}
 local event={source={tags={tool=true,metal=true}},mastery={tags={},levels={Seal=1}}};local ok,why=Rules.match(rule,event);assert(not ok and why=="mastery Seal")
 event.mastery.levels.Seal=3;assert(Rules.match(rule,event));event.source.tags.fire=true;assert(not Rules.match(rule,event))
end)
test("32-character mappings share one interpreter and never overwrite active identities",function()
 local c=S.copy(cfg);c.Enabled=true;for i=1,32 do c.CharacterMastery["Fixture"..i]=if i%2==0 then "WeaponExpert" else "Basic" end
 local e=assert(Engine.new(c));e:toggle("wind-kunai",true)
 for i=1,32 do e:spawn("tool"..i,"Kunai",{character="Fixture"..i});assert(e:infuse("tool"..i,"Wind").ok) end
 assert(e.objects.tool2.stats.speed>e.objects.tool1.stats.speed);assert(not pcall(e.spawn,e,"overflow","Kunai"))
end)
test("event buffers and lifetimes are bounded; reset retains chosen switches",function()
 local e=new();e:spawn("a","Kunai");e:toggle("wind-kunai",false)
 for _=1,200 do assert(e:infuse("a","None").ok) end;assert(#e.events==cfg.MaxEvents)
 for _=1,301 do e:advance(.1) end;assert(next(e.objects)==nil and e.counters.expired==1)
 e:reset();assert(next(e.objects)==nil and #e.events==0 and e.switches["wind-kunai"]==false)
end)
test("dev tools cover spawn/nature/property/launch/collision/embed/report/toggles/reset",function()
 local d=Dev.new(cfg,false)
 for _,command in {{"spawn",{id="a"}},{"nature",{id="a",nature="Wind"}},{"property",{id="a",property="Marked",enabled=true}},{"property",{id="a",property="Seal",enabled=true}},{"launch",{id="a"}},{"surface",{id="wall"}},{"toggle",{rule="surface-embed",enabled=true}},{"embed",{id="a",surface="wall"}},{"inspect",{id="a"}},{"report",{}},{"reset",{clearRules=true}},{"demo",{name="redirection"}},{"collision",{source="a",target="b"}},{"step",{seconds=.1}}} do local result=d:run(command[1],command[2]);assert(result.ok,result.error) end
 assert(not d:run("show").ok and not d:run("play").ok and not d:run("unknown").ok)
 local unsafe={};unsafe.self=unsafe;assert(not d:run("spawn",unsafe).ok)
end)
test("independent variant comparison does not modify ongoing sandbox/config",function()
 local d=Dev.new(cfg,false);assert(d:run("demo",{name="kunai_seal"}).ok)
 local rows=d:run("compare").result;assert(#rows==6 and d.lab.engine.objects.a.properties.Seal)
 near(rows[1].result.source.stats.speed,42);assert(rows[6].result.source.stats.speed>rows[3].result.source.stats.speed)
 assert(cfg.Enabled==false)
end)
test("six optional input plans preserve the existing action and reject incompatible proposals",function()
 local planner=H.load("Server/ChakraInputPlan")
 local context={tool="Kunai",techniqueInfusion="Wind",selectedInfusion="Wind",compatible=true,contextInfusion="Wind",loadout={Kunai="Wind"},holdQualified=true,availableProperty="Marked",propertyInfusion="Wind"}
 for mode in planner.Modes do
  local p=planner.build(cfg,mode,{action="ExistingToolAction",modified=true,released=true},context)
  assert(p.infusion=="Wind" and p.action=="ExistingToolAction" and p.requiresServerValidation and not p.gameplayIntegration)
 end
 assert(planner.build(cfg,"Modifier",{action="ExistingToolAction"},context).infusion=="None")
 context.tool="Wire";local p=planner.build(cfg,"AutoTechnique",{action="ExistingToolAction"},context);assert(not p.compatible and p.infusion=="None")
 assert(not pcall(planner.build,cfg,"Unknown",{},context))
end)
print("NinjaDuel chakra interactions: "..passed.." PASS (optional data/kinematic lab; no gameplay integration)")
