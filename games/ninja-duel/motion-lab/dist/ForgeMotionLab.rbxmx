      <Item class="ModuleScript" referent="FML9">
        <Properties>
          <string name="Name">PoseSolver</string>
          <ProtectedString name="Source">-- R15 anatomical solver reused from Ninja Duel / VelmoraMotionEngine (MIT ancestry).
-- Presentation only; no world physics/authority. Original dimensions kept.
local Solver={}
local rad=math.rad;local CF=CFrame.new;local ANG=CFrame.Angles;local IDENTITY=CFrame.identity
local legIK
local L1,L2=1.05,1.0
local ANKLE_Y=-2.6 -- rest ankle height relative to HumanoidRootPart centre
local function ori(o)
	if not o then return IDENTITY end
	return ANG(rad(-(o.pitch or 0)),rad(-(o.yaw or 0)),rad(-(o.roll or 0)))
end
local function armCF(side,a)
	a=a or {}
	local shoulder=ANG(rad(a.raise or 0),0,0)*ANG(0,0,rad((a.out or 0)*side))*ANG(0,rad((a.twist or 0)*side),0)
	return shoulder,ANG(rad(a.elbow or 0),0,0),ANG(rad(a.wrist or 0),0,rad((a.wroll or 0)*side))
end
local function legFK(side,l)
	l=l or {}
	return ANG(rad(l.lift or 0),0,0)*ANG(0,0,rad((l.out or 0)*side))*ANG(0,rad((l.twist or 0)*side),0),ANG(rad(-(l.knee or 0)),0,0),ANG(rad(l.ankle or 0),0,0)
end
-- Two-bone IK in the LowerTorso frame: thigh/shin lengths are the rig's real
-- joint spacing; knees point forward (and a little out); the foot stays flat.
function legIK(rootCF,side,ankle,footYaw,toe)
	local hip=rootCF*Vector3.new(.5*side,-.55,0)
	local inv=rootCF.Rotation:Inverse()
	local d=inv*(ankle-hip)
	local u=if d.Magnitude&gt;1e-4 then d.Unit else Vector3.new(0,-1,0)
	local D=math.clamp(d.Magnitude,.45,L1+L2-1e-3)
	local bend=math.pi-math.acos(math.clamp((L1*L1+L2*L2-D*D)/(2*L1*L2),-1,1))
	local a=math.acos(math.clamp((L1*L1+D*D-L2*L2)/(2*L1*D),-1,1))
	local hint=Vector3.new(side*.18,0,-1).Unit
	local w=hint-u*hint:Dot(u)
	if w.Magnitude&lt;1e-3 then w=Vector3.new(0,0,-1) end
	w=w.Unit
	local up=-(u*math.cos(a)+w*math.sin(a))
	local x=w:Cross(up)
	if x.Magnitude&lt;1e-3 then x=Vector3.xAxis end
	x=x.Unit
	local z=x:Cross(up).Unit
	local hipCF=CFrame.fromMatrix(Vector3.zero,x,up,z)
	local kneeCF=ANG(-bend,0,0)
	local foot=(hipCF*kneeCF):Inverse()*inv*ANG(0,rad(-(footYaw or 0)),0)*ANG(rad(toe or 0),0,0)
	return hipCF,kneeCF,foot
end
local function rootCFOf(spec)
	local r=spec.root or {}
	return CF(r.x or 0,r.y or 0,r.z or 0)*ori(r)
end
-- Spec -&gt; joint transforms. Unspecified parts stay at rest.
local function build(spec)
	local out={}
	local rootCF=rootCFOf(spec)
	out.Root=rootCF
	out.Waist=ori(spec.torso)
	out.Neck=ori(spec.head)
	out.Right,out.RightElbow,out.RightWrist=armCF(1,spec.ra)
	out.Left,out.LeftElbow,out.LeftWrist=armCF(-1,spec.la)
	for _,side in {1,-1} do
		local prefix=if side==1 then "Right" else "Left"
		local free=if side==1 then spec.rl else spec.ll
		if free then
			-- A free leg (air, kicks) is posed directly.
			out[prefix.."Hip"],out[prefix.."Knee"],out[prefix.."Ankle"]=legFK(side,free)
		else
			-- Otherwise the foot is planted (at rest unless told where) and the
			-- leg is solved to reach it, whatever the hips are doing.
			local foot=(if side==1 then spec.rf else spec.lf) or {}
			local ankle=Vector3.new(.5*side+(foot.x or 0),ANKLE_Y+(foot.y or 0),foot.z or 0)
			out[prefix.."Hip"],out[prefix.."Knee"],out[prefix.."Ankle"]=legIK(rootCF,side,ankle,foot.yaw,foot.toe)
			-- Remember the planted foot: apply() re-solves the leg against the
			-- hips actually drawn this frame, so the foot stays where it was put.
			out.__feet=out.__feet or {}
			out.__feet[if side==1 then "R" else "L"]={ankle=ankle,yaw=foot.yaw or 0,toe=foot.toe or 0}
		end
	end
	return out
end

Solver.build=build
return Solver
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="FML10">
        <Properties>
          <string name="Name">Rig</string>
          <ProtectedString name="Source">-- Preview scaffold reuses Ninja Duel's R15 dimensions and joint spacing.
-- Explicit CFrame hierarchy also works in edit-mode ViewportFrames without physics.
local R={}
function R.new(parent,tint)
 local model=Instance.new("Model");model.Name="MotionLab_R15";model.Parent=parent
 local parts={};local joints={};local order={}
 local function body(name,size,offset,color)
  local p=Instance.new("Part");p.Name=name;p.Size=size;p.Anchored=true;p.CanCollide=false;p.CanQuery=false;p.CanTouch=false;p.Color=color;p.Material=Enum.Material.SmoothPlastic;p.CFrame=CFrame.new(offset);p.Parent=model;parts[name]=p;return p
 end
 local neutral=Color3.fromRGB(122,135,151);tint=tint or Color3.fromRGB(122,191,225)
 local root=body("HumanoidRootPart",Vector3.new(2,2,1),Vector3.zero,neutral);root.Transparency=1
 body("LowerTorso",Vector3.new(2,1,1),Vector3.zero,tint);body("UpperTorso",Vector3.new(2,1.4,1),Vector3.new(0,1.15,0),tint);body("Head",Vector3.new(1.5,1.5,1.5),Vector3.new(0,2.45,0),Color3.fromRGB(206,214,223))
 local function joint(key,name,p0,p1,c0,c1)
  local m=Instance.new("Motor6D");m.Name=name;m.Part0=parts[p0];m.Part1=parts[p1];m.C0=CFrame.new(c0);m.C1=CFrame.new(c1);m.Parent=parts[p0]
  joints[key]=m;table.insert(order,key)
 end
 joint("Root","Root","HumanoidRootPart","LowerTorso",Vector3.zero,Vector3.zero)
 joint("Waist","Waist","LowerTorso","UpperTorso",Vector3.new(0,.65,0),Vector3.new(0,-.5,0))
 joint("Neck","Neck","UpperTorso","Head",Vector3.new(0,.9,0),Vector3.new(0,-.55,0))
 for _,side in {-1,1} do
  local prefix=if side&lt;0 then "Left" else "Right";local key=if side&lt;0 then "Left" else "Right"
  for _,row in {{"UpperArm",Vector3.new(.8,1.1,.8),Vector3.new(side*1.45,.72,0),tint},{"LowerArm",Vector3.new(.76,.95,.76),Vector3.new(side*1.45,-.28,0),neutral},{"Hand",Vector3.new(.72,.5,.72),Vector3.new(side*1.45,-1,0),neutral},{"UpperLeg",Vector3.new(.85,1.1,.85),Vector3.new(side*.5,-.85,0),neutral},{"LowerLeg",Vector3.new(.8,1.05,.8),Vector3.new(side*.5,-1.75,0),neutral},{"Foot",Vector3.new(.8,.42,1.15),Vector3.new(side*.5,-2.55,-.15),neutral}} do body(prefix..row[1],row[2],row[3],row[4]) end
  joint(key,prefix.."Shoulder","UpperTorso",prefix.."UpperArm",Vector3.new(side*1.05,.45,0),Vector3.new(-side*.4,.5,0))
  joint(prefix.."Elbow",prefix.."Elbow",prefix.."UpperArm",prefix.."LowerArm",Vector3.new(0,-.55,0),Vector3.new(0,.45,0))
  joint(prefix.."Wrist",prefix.."Wrist",prefix.."LowerArm",prefix.."Hand",Vector3.new(0,-.48,0),Vector3.new(0,.25,0))
  joint(prefix.."Hip",prefix.."Hip","LowerTorso",prefix.."UpperLeg",Vector3.new(side*.5,-.55,0),Vector3.new(0,.5,0))
  joint(prefix.."Knee",prefix.."Knee",prefix.."UpperLeg",prefix.."LowerLeg",Vector3.new(0,-.55,0),Vector3.new(0,.5,0))
  joint(prefix.."Ankle",prefix.."Ankle",prefix.."LowerLeg",prefix.."Foot",Vector3.new(0,-.5,0),Vector3.new(0,.2,.15))
 end
 local hum=Instance.new("Humanoid");hum.RigType=Enum.HumanoidRigType.R15;hum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None;hum.RequiresNeck=false;hum.Parent=model
 model.PrimaryPart=root
 local weapon=body("PreviewWeapon",Vector3.new(.1,.25,1),Vector3.zero,Color3.fromRGB(207,223,239));weapon.Transparency=1
 return {model=model,parts=parts,joints=joints,order=order,root=root,weapon=weapon}
end
function R.apply(rig,pose,origin,showRoot,showWeapon)
 rig.root.CFrame=CFrame.new(origin+(if showRoot then pose.motion or Vector3.zero else Vector3.zero))
 for _,key in rig.order do local m=rig.joints[key];local transform=pose[key] or CFrame.identity;m.Transform=transform;m.Part1.CFrame=m.Part0.CFrame*m.C0*transform*m.C1:Inverse() end
 rig.weapon.CFrame=rig.parts[pose.weaponHand or "RightHand"].CFrame*CFrame.new(0,-.1,-.55)*(pose.Weapon or CFrame.identity);rig.weapon.Transparency=if showWeapon then 0 else 1
end
return R
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="FML11">
        <Properties>
          <string name="Name">Sampler</string>
          <ProtectedString name="Source">local M=require(script.Parent.Model)
local Solver=require(script.Parent.PoseSolver)
local S={}
S.Joints={Root={"Root"},Legs={"RightHip","RightKnee","RightAnkle","LeftHip","LeftKnee","LeftAnkle"},Hips={"Root"},Torso={"Waist"},LeftArm={"Left","LeftElbow","LeftWrist"},RightArm={"Right","RightElbow","RightWrist"},Head={"Neck"},Weapon={"Weapon"}}
local function smooth(t) t=math.clamp(t,0,1);return t*t*(3-2*t) end
local function mix(a,b,t)
 local out={};for k,v in a or {} do out[k]=M.copy(v) end
 for k,v in b or {} do if type(v)=="table" then out[k]=mix((a or {})[k] or {},v,t) elseif type(v)=="number" then out[k]=((a or {})[k] or 0)+(v-((a or {})[k] or 0))*t end end
 for k,v in a or {} do if (b or {})[k]==nil and type(v)=="number" then out[k]=v*(1-t) end end
 return out
end
local function merge(a,b) local out=M.copy(a);for k,v in b do out[k]=if type(v)=="table" then merge(out[k] or {},v) else v end;return out end
local function keysAt(keys,t)
 if t&lt;=keys[1].at then return M.copy(keys[1].pose) end
 for i=1,#keys-1 do local a,b=keys[i],keys[i+1]
  if t&lt;=b.at then local u=math.clamp((t-a.at)/math.max(.0001,b.at-a.at),0,1);u=if b.ease=="linear" then u elseif b.ease=="out" then 1-(1-u)^3 elseif b.ease=="in" then u^3 else smooth(u)
   local pose=mix(a.pose,b.pose,u)
   -- A kicking leg uses FK throughout that interval, rather than competing IK.
   if a.pose.rl or b.pose.rl then pose.rf=nil end;if a.pose.ll or b.pose.ll then pose.lf=nil end
   return pose
  end
 end
 return M.copy(keys[#keys].pose)
end
local base={root={y=-.3,pitch=5},torso={pitch=3},head={pitch=-3},ra={raise=45,out=10,elbow=90},la={raise=50,out=10,elbow=80},rf={x=.1,z=.4},lf={x=-.1,z=-.4}}
local function procedural(p,asset,t)
 local stance=merge(base,p.stance);local kind=asset.grammar;local cycle=t*math.pi*2
 local pulse=math.sin(math.pi*t)^2;local strike=math.sin(math.pi*math.clamp(t/.7,0,1))^2
 if asset.category=="Locomotion" then
  if kind=="Idle" then return merge(stance,{root={y=(stance.root.y or 0)+math.sin(cycle)*.03},torso={pitch=(stance.torso.pitch or 0)+math.sin(cycle)*1.4}}) end
  if kind=="Pivot" then return merge(stance,{root={yaw=math.sin(math.pi*t)*75},torso={yaw=-math.sin(math.pi*t)*25},rf={z=.3},lf={z=-.3}}) end
  local scale=if kind=="Sprint" then 1.4 elseif kind=="Walk" then .6 else 1
  local gait=p.gait;local stride=math.sin(cycle)*(gait.stride or 1)*p.motionDNA.stepLength*.75*scale
  local liftR=math.max(0,math.cos(cycle))*.35;local liftL=math.max(0,-math.cos(cycle))*.35
  return merge(stance,{root={pitch=(if kind=="Sprint" then 28 else 12),y=-.32+math.cos(cycle*2)*.08,roll=if kind=="Strafe" then 12 else 0},torso={yaw=math.sin(cycle)*-10},rf={z=stride,y=liftR},lf={z=-stride,y=liftL},ra={raise=15+math.sin(cycle)*(gait.arm or 35)},la={raise=15-math.sin(cycle)*(gait.arm or 35)}})
 end
 if asset.category=="Reactions" then return merge(stance,{root={y=-.3-pulse*.25,pitch=-pulse*20,roll=pulse*8},torso={pitch=-pulse*20,yaw=pulse*22},head={pitch=pulse*18},ra={raise=40+pulse*30},la={raise=45+pulse*20}}) end
 if asset.category=="Dodges" then return merge(stance,{root={x=-pulse*.65,y=-.3-pulse*.4,pitch=pulse*24,roll=-pulse*18},torso={roll=pulse*8},rf={x=.1+pulse*.5},lf={x=-.1-pulse*.4}}) end
 if kind=="Land" then return merge(stance,{root={y=-.3-pulse*.55,pitch=pulse*15},ra={raise=35,out=10+pulse*25},la={raise=40,out=10+pulse*25}}) end
 if kind=="Jump" then return merge(stance,{root={y=-.3+math.sin(math.pi*t)*1.4,pitch=pulse*12},rl={lift=15+pulse*30,knee=30+pulse*70},ll={lift=20+pulse*20,knee=25+pulse*80},ra={raise=35+pulse*90},la={raise=40+pulse*80}}) end
 if asset.category=="Aerial" or asset.category=="Wall" then
  return merge(stance,{root={y=-.15+math.sin(math.pi*t)*.5,pitch=if kind=="Slam" then pulse*45 else -pulse*12,roll=if asset.category=="Wall" then pulse*30 else 0},ra={raise=40+pulse*60},la={raise=40+pulse*65},rl={lift=35+pulse*40,knee=70},ll={lift=20+pulse*20,knee=95}})
 end
 if asset.category=="Kicks" then
  local spin=if kind=="Light3" then pulse*150 elseif kind=="Sweep" then pulse*80 else pulse*25
  return merge(stance,{root={y=-.3-pulse*(if kind=="Sweep" then .55 else .12),yaw=spin,roll=pulse*-15},torso={yaw=pulse*20},rl={lift=strike*90,out=if kind=="SideKick" then strike*65 else strike*25,knee=100*(1-strike)+8},ra={raise=35,out=30+strike*35},la={raise=45,out=30+strike*35}})
 end
 if asset.category=="Knees" then return merge(stance,{root={pitch=pulse*16,z=-pulse*.4},rl={lift=strike*105,knee=120},ra={raise=75,elbow=115},la={raise=80,elbow=110}}) end
 if asset.category=="Launchers" or kind=="Uppercut" then return merge(stance,{root={y=-.35-pulse*.3,z=-pulse*.4},torso={pitch=-strike*12},ra={raise=20+strike*140,out=15,elbow=100-strike*65}}) end
 if kind=="Hook" then return merge(stance,{root={z=-pulse*.2,yaw=-pulse*65,roll=-pulse*8},torso={yaw=-strike*45},ra={raise=70,out=-strike*75,elbow=95,twist=strike*35}}) end
 if kind=="Grab" then return merge(stance,{root={z=-pulse*.65,pitch=pulse*18},ra={raise=35+strike*65,out=-strike*12,elbow=95-strike*65},la={raise=40+strike*55,out=-strike*15,elbow=100-strike*65}}) end
 if kind=="ToolThrow" then return merge(stance,{root={yaw=-pulse*55,z=-pulse*.3},torso={yaw=-strike*35},ra={raise=50+strike*85,out=-strike*15,elbow=100-strike*85,wrist=-strike*40}}) end
 local left=kind=="Light2" or kind=="PalmThrust";local arm=if left then "la" else "ra";local hand={raise=30+strike*65,out=if asset.category=="Elbows" then -strike*45 else -strike*15,elbow=if asset.category=="Elbows" then 110 else 110-strike*100,wrist=if kind=="PalmThrust" then -35 else 0}
 return merge(stance,{root={z=-pulse*.45,pitch=pulse*8,yaw=(if kind=="SpinElbow" then pulse*140 else (if left then 1 else -1)*pulse*30)},torso={yaw=(if left then 1 else -1)*pulse*28},[arm]=hand})
end
local function dnaPose(p,pose,t,asset)
 local d=p.motionDNA;pose=M.copy(pose);pose.root=pose.root or {};pose.torso=pose.torso or {};pose.head=pose.head or {}
 pose.root.y=(pose.root.y or 0)+d.centerHeight-(d.groundedness-.7)*.18-(d.apparentWeight-.5)*.15
 pose.root.pitch=(pose.root.pitch or 0)*d.amplitude+(d.forwardPressure-.5)*8
 pose.root.yaw=(pose.root.yaw or 0)*d.rotationAmount*d.hipInvolvement
 pose.root.roll=(pose.root.roll or 0)+(d.lateralBias)*8
 pose.root.x=(pose.root.x or 0)*d.rootIntensity;pose.root.z=(pose.root.z or 0)*d.rootIntensity
 pose.torso.yaw=(pose.torso.yaw or 0)*d.rotationAmount;pose.torso.pitch=(pose.torso.pitch or 0)*d.upperActivity
 pose.head.yaw=(pose.head.yaw or 0)*(.4+d.headTracking);pose.head.pitch=(pose.head.pitch or 0)*(.6+d.precision*.4)
 for _,arm in {"ra","la"} do local a=pose[arm] or {};pose[arm]=a
  a.raise=(a.raise or 0)*d.upperActivity*d.amplitude+(if arm=="ra" then 1 else -1)*d.asymmetry*20
  a.out=(a.out or 0)+(d.guardOpenness-.5)*18;a.elbow=math.clamp((a.elbow or 0)+(d.looseness-.5)*-15,0,160)
 end
 for _,leg in {"rl","ll"} do if pose[leg] then pose[leg].lift=(pose[leg].lift or 0)*d.lowerActivity*(.7+d.acrobatics*.75) end end
 for _,foot in {"rf","lf"} do if pose[foot] then pose[foot].z=(pose[foot].z or 0)*d.lowerActivity*d.stepLength end end
 if asset.category~="Locomotion" then pose.root.z=(pose.root.z or 0)*(1+(d.aggression-.5)*.5) end
 local overrides=p.characterRules.grammarOverrides and p.characterRules.grammarOverrides[asset.grammar]
 if overrides then
  for _,arm in {"ra","la"} do pose[arm].raise*=overrides.bodyScale or 1 end
  pose.root.y+=(overrides.rootLift or 0)*math.sin(math.pi*t);pose.root.z-=(overrides.rootTravel or 0)*math.sin(math.pi*t);pose.root.x+=(overrides.lateralTravel or 0)*math.sin(math.pi*t)
 end
 return pose
end
function S.mirror(pose)
 local p=M.copy(pose);p.ra,p.la=p.la,p.ra;p.rl,p.ll=p.ll,p.rl;p.rf,p.lf=p.lf,p.rf
 for _,key in {"root","torso","head"} do if p[key] then for _,field in {"x","yaw","roll"} do if p[key][field] then p[key][field]=-p[key][field] end end end end
 for _,key in {"rf","lf","weapon"} do if p[key] then p[key].x=-(p[key].x or 0);p[key].yaw=-(p[key].yaw or 0) end end
 if p.weapon and p.weapon.roll then p.weapon.roll=-p.weapon.roll end
 return p
end
function S.duration(preset,asset,lib)
 local selected=S.resolveAsset(preset,asset,lib);local clip=preset.clips[selected.grammar]
 return (if clip then clip.duration else selected.duration)/preset.motionDNA.cadence/(if selected.category=="Locomotion" then preset.motionDNA.strideFrequency*(preset.gait.cadence or 1) else 1)
end
function S.resolveAsset(preset,asset,lib)
 local id=preset.locomotionSet[asset.id]
 return if id and lib and lib.assets[id] then lib.assets[id] else asset
end
function S.anatomy(preset,asset,t,mirror)
 local clip=preset.clips[asset.grammar];local pose=if clip then keysAt(clip.keys,t) else procedural(preset,asset,t)
 pose.weapon=pose.weapon or preset.stance.weapon;pose=dnaPose(preset,pose,t,asset);return if mirror then S.mirror(pose) else pose
end
local additive={apparentWeight=true,groundedness=true,centerHeight=true,forwardPressure=true,lateralBias=true,asymmetry=true,guardOpenness=true,precision=true,acrobatics=true,aggression=true,looseness=true,headTracking=true}
local function shaped(preset,dna,reference)
 if not dna then return preset end
 local result=table.clone(preset);result.motionDNA=table.clone(preset.motionDNA);local defaults=reference or M.defaults()
 for _,row in M.DNA do local key=row[1]
  result.motionDNA[key]=math.clamp(if additive[key] then preset.motionDNA[key]+dna[key]-defaults[key] else preset.motionDNA[key]*dna[key]/defaults[key],row[3],row[4])
 end
 return result
end
local function own(preset,asset,t,mirror,lib,dna,reference)
 preset=shaped(preset,dna,reference)
 local anatomy=S.anatomy(preset,S.resolveAsset(preset,asset,lib),t,mirror)
 local pose=Solver.build(anatomy);local weapon=anatomy.weapon or {}
 pose.Weapon=CFrame.new(weapon.x or 0,weapon.y or 0,weapon.z or 0)*CFrame.Angles(math.rad(weapon.pitch or 0),math.rad(weapon.yaw or 0),math.rad(weapon.roll or 0))
 return pose
end
function S.sample(preset,asset,t,lib,mirror)
 t=math.clamp(t,0,1);local output=own(preset,asset,t,mirror,lib);local poseCache={}
 local function sourcePose(id,layer,seen,depth)
  assert(depth&lt;9 and not seen[id],"Body source cycle");seen[id]=true
  local p=assert(lib.presets[id],"Missing motion source");if not poseCache[id] then poseCache[id]=own(p,asset,t,mirror,lib,preset.motionDNA,preset.metadata.dnaReference) end;local poses=table.clone(poseCache[id]);local spec=p.bodyLayers[layer]
  if spec.enabled and spec.source~="base" then
   local target=sourcePose(spec.source,layer,seen,depth+1)
   for _,joint in S.Joints[layer] do if target[joint] then poses[joint]=(poses[joint] or CFrame.identity):Lerp(target[joint],spec.strength) end end
  end
  seen[id]=nil;return poses
 end
 local rootSample=output.Root
 for _,layer in M.Layers do
  local spec=preset.bodyLayers[layer]
  if spec.enabled and spec.source~="base" then
   local target=sourcePose(spec.source,layer,{},0)
   if layer=="Root" then rootSample=rootSample:Lerp(target.Root,spec.strength)
   else for _,joint in S.Joints[layer] do if target[joint] then output[joint]=(output[joint] or CFrame.identity):Lerp(target[joint],spec.strength) end end end
  end
 end
 output.weaponHand=if mirror then "LeftHand" else "RightHand"
 output.motion=Vector3.new(rootSample.Position.X,0,rootSample.Position.Z)
 output.Root=CFrame.new(0,output.Root.Position.Y,0)*output.Root.Rotation
 return output
end
function S.mixedAnatomy(preset,asset,t,lib)
 local fields={Legs={"rf","lf","rl","ll"},Torso={"torso"},LeftArm={"la"},RightArm={"ra"},Head={"head"},Weapon={"weapon"}}
 local function resolve(p,layer,depth)
  assert(depth&lt;9,"Source depth");local expressive=if p==preset then p else shaped(p,preset.motionDNA,preset.metadata.dnaReference);local result=S.anatomy(expressive,S.resolveAsset(p,asset,lib),t,false);local spec=p.bodyLayers[layer]
  if spec.enabled and spec.source~="base" then
   local other=resolve(assert(lib.presets[spec.source]),layer,depth+1)
   if layer=="Root" or layer=="Hips" then
    local root=result.root or {};local blended=mix(root,other.root or {},spec.strength)
    for _,key in (if layer=="Root" then {"x","z"} else {"y","pitch","yaw","roll"}) do root[key]=blended[key] end;result.root=root
   else
    for _,field in fields[layer] do
     if layer=="Legs" and (field=="rf" or field=="lf") then
      local fk=if field=="rf" then "rl" else "ll"
      if other[fk] and spec.strength&gt;.5 then result[field]=nil end
     end
     if spec.strength==1 then result[field]=M.copy(other[field]) elseif other[field] then result[field]=mix(result[field] or {},other[field],spec.strength) end
    end
   end
  end
  return result
 end
 local out=S.anatomy(preset,S.resolveAsset(preset,asset,lib),t,false)
 for _,layer in M.Layers do
  local body=resolve(preset,layer,0)
  if layer=="Root" or layer=="Hips" then out.root=out.root or {};for _,key in (if layer=="Root" then {"x","z"} else {"y","pitch","yaw","roll"}) do out.root[key]=(body.root or {})[key] end
  else for _,field in fields[layer] do out[field]=body[field] end end
 end
 return out
end
function S.blendPose(from,to,t)
 local out=table.clone(from)
 for key,value in to do
  if typeof(value)=="CFrame" and from[key] then out[key]=from[key]:Lerp(value,smooth(t)) elseif key=="motion" and from.motion then out.motion=from.motion:Lerp(value,smooth(t)) end
 end
 return out
end
function S.sequence(preset,sequence,time,lib,mirror)
 if #sequence.orderedClips==0 then return S.sample(preset,lib.assets.idle,0,lib,mirror),nil,0 end
 local cursor=0
 for index,block in sequence.orderedClips do
  local duration=block.duration/preset.motionDNA.recoverySpeed
  if time&lt;cursor+duration or index==#sequence.orderedClips then
   local t=math.clamp((time-cursor)/duration,0,1);local asset=assert(lib.assets[block.asset],"Missing clip")
   local pose=S.sample(preset,asset,t,lib,mirror)
   if index&gt;1 and block.transition=="blend" and block.blend&gt;0 and time-cursor&lt;block.blend then
    local prev=sequence.orderedClips[index-1];local from=S.sample(preset,lib.assets[prev.asset],1,lib,mirror);local u=smooth((time-cursor)/block.blend)
    for key,value in pose do if typeof(value)=="CFrame" and from[key] then pose[key]=from[key]:Lerp(value,u) elseif key=="motion" then pose.motion=from.motion:Lerp(value,u) end end
   end
   return pose,index,t
  end
  cursor+=duration
 end
 error("Sequence unreachable")
end
return S
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="FML12">
        <Properties>
          <string name="Name">Store</string>
          <ProtectedString name="Source">local M=require(script.Parent.Model)
local Store={};Store.__index=Store
local KEY="ForgeMotionLab.presets.v1"
function Store.new(plugin,library)
 local self=setmetatable({plugin=plugin,library=library,builtins=M.copy(library.presets),custom={},writable=true,notice=nil},Store)
 local ok,raw=pcall(function()return plugin:GetSetting(KEY)end)
 if not ok then self.writable=false;self.notice="Preset settings unavailable; export before closing.";return self end
 if raw~=nil then
  if type(raw)~="string" or #raw&gt;2000000 then self.writable=false;self.notice="Preset settings invalid/too large; preserved.";return self end
  local decoded,data=pcall(function()return game:GetService("HttpService"):JSONDecode(raw)end)
  if not decoded or type(data)~="table" or data.version~=1 or not M.safe(data.presets) then self.writable=false;self.notice="Saved data could not be read. It has been preserved.";return self end
  local graph=M.copy(library.presets);for id,p in data.presets do if self.builtins[id] then self.writable=false;self.notice="Saved library collides with bundled sources; data preserved.";return self end;graph[id]=p end
  local valid,why=M.validateGraph(graph)
  if not valid then self.writable=false;self.notice=why..". Existing settings preserved.";return self end
  for _,p in data.presets do local good,reason=M.validateAssets(p,library.assets);if not good then self.writable=false;self.notice=reason..". Saved data preserved.";return self end end
  self.custom=M.copy(data.presets);for id,p in self.custom do library.presets[id]=M.copy(p);table.insert(library.order,id) end
 end
 return self
end
function Store:save(preset)
 assert(self.writable,self.notice)
 local valid,reason=M.validateAssets(preset,self.library.assets);assert(valid,reason)
 local all=M.copy(self.library.presets);all[preset.id]=preset;local ok,why=M.validateGraph(all);assert(ok,why)
 assert(not self.builtins[preset.id],"Duplicate a bundled profile before saving")
 local nextCustom=M.copy(self.custom);nextCustom[preset.id]=M.copy(preset)
 local function gather(p,seen)
  seen[p.id]=true
  for _,layer in p.bodyLayers do
   if layer.source~="base" and not self.builtins[layer.source] and not seen[layer.source] then
    local source=assert(self.library.presets[layer.source],"Missing saved source");nextCustom[source.id]=M.copy(source);gather(source,seen)
   end
  end
 end;gather(preset,{})
 local payload=game:GetService("HttpService"):JSONEncode({version=1,presets=nextCustom});assert(#payload&lt;=2000000,"Preset storage full; export a library first")
 self.plugin:SetSetting(KEY,payload);self.custom=nextCustom;self.library.presets[preset.id]=M.copy(preset)
 if not table.find(self.library.order,preset.id) then table.insert(self.library.order,preset.id) end
 return true
end
function Store:delete(id)
 assert(self.writable and self.custom[id],"Only custom presets can be deleted")
 for other,p in self.library.presets do if other~=id then for _,layer in p.bodyLayers do assert(layer.source~=id,"This profile is used by "..p.name) end end end
 local nextCustom=M.copy(self.custom);nextCustom[id]=nil
 self.plugin:SetSetting(KEY,game:GetService("HttpService"):JSONEncode({version=1,presets=nextCustom}));self.custom=nextCustom;self.library.presets[id]=nil
 local at=table.find(self.library.order,id);if at then table.remove(self.library.order,at) end
end
return Store
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="FML13">
        <Properties>
          <string name="Name">UI</string>
          <ProtectedString name="Source">-- Visual thesis: a quiet slate motion workspace with a large lit R15 canvas.
-- Content: source collection, live body, contextual mixer/DNA, editable phrase.
-- Interaction: fast preview, restrained hover, selected blocks and immediate sliders.
local UI={}
local studio=settings().Studio
local function palette()
 local light=studio.Theme:GetColor(Enum.StudioStyleGuideColor.MainBackground).R&gt;.6
 return if light then {bg=Color3.fromRGB(244,246,249),panel=Color3.fromRGB(235,239,244),hover=Color3.fromRGB(221,229,239),text=Color3.fromRGB(28,39,54),muted=Color3.fromRGB(96,112,132),line=Color3.fromRGB(208,217,228),accent=Color3.fromRGB(55,113,174),onAccent=Color3.new(1,1,1),canvas=Color3.fromRGB(224,233,243)} else {bg=Color3.fromRGB(22,28,37),panel=Color3.fromRGB(29,37,49),hover=Color3.fromRGB(43,56,73),text=Color3.fromRGB(232,239,247),muted=Color3.fromRGB(144,162,184),line=Color3.fromRGB(47,61,79),accent=Color3.fromRGB(104,181,230),onAccent=Color3.fromRGB(15,30,43),canvas=Color3.fromRGB(21,30,43)}
end
function UI.new(widget)
 local self={widget=widget,colors=palette(),styles=setmetatable({}, {__mode="k"}),connections={}}
 function self:connect(signal,fn) local c=signal:Connect(fn);table.insert(self.connections,c);return c end
 function self:paint(obj,property,role) obj[property]=self.colors[role];self.styles[obj]=self.styles[obj] or {};self.styles[obj][property]=role end
 function self:make(class,parent,props)
  local obj=Instance.new(class);for k,v in props or {} do obj[k]=v end;obj.Parent=parent;return obj
 end
 function self:frame(parent,props,role) local f=self:make("Frame",parent,props);f.BorderSizePixel=0;self:paint(f,"BackgroundColor3",role or "bg");return f end
 function self:label(parent,text,props,role)
  local t=self:make("TextLabel",parent,{Text=text,BackgroundTransparency=1,TextSize=14,Font=Enum.Font.BuilderSans,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Center,TextTruncate=Enum.TextTruncate.AtEnd})
  self:paint(t,"TextColor3",role or "text");for k,v in props or {} do t[k]=v end;return t
 end
 function self:button(parent,text,props,fn,primary)
  local b=self:make("TextButton",parent,{Text=text,TextSize=13,Font=Enum.Font.BuilderSansMedium,BorderSizePixel=0,AutoButtonColor=false})
  self:paint(b,"BackgroundColor3",primary and "accent" or "panel");self:paint(b,"TextColor3",primary and "onAccent" or "text")
  self:make("UICorner",b,{CornerRadius=UDim.new(0,5)});for k,v in props or {} do b[k]=v end
  self:connect(b.MouseEnter,function() if not primary then b.BackgroundColor3=self.colors.hover end end);self:connect(b.MouseLeave,function() b.BackgroundColor3=self.colors[primary and "accent" or "panel"] end)
  if fn then self:connect(b.Activated,fn) end;return b
 end
 function self:input(parent,text,props,callback)
  local b=self:make("TextBox",parent,{Text=text,ClearTextOnFocus=false,TextSize=13,Font=Enum.Font.BuilderSans,BorderSizePixel=0,TextXAlignment=Enum.TextXAlignment.Left})
  self:paint(b,"BackgroundColor3","panel");self:paint(b,"TextColor3","text");self:paint(b,"PlaceholderColor3","muted");self:make("UICorner",b,{CornerRadius=UDim.new(0,5)});self:make("UIPadding",b,{PaddingLeft=UDim.new(0,9),PaddingRight=UDim.new(0,9)})
  for k,v in props or {} do b[k]=v end;if callback then self:connect(b.FocusLost,function()callback(b.Text)end) end;return b
 end
 function self:scroll(parent,props)
  local s=self:make("ScrollingFrame",parent,{BorderSizePixel=0,BackgroundTransparency=1,ScrollBarThickness=4,CanvasSize=UDim2.fromOffset(0,0),AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollingDirection=Enum.ScrollingDirection.Y})
  self:paint(s,"ScrollBarImageColor3","line");for k,v in props or {} do s[k]=v end;return s
 end
 function self:slider(parent,label,min,max,value,y,callback,onBegin)
  local row=self:frame(parent,{Size=UDim2.new(1,-8,0,58),Position=UDim2.fromOffset(0,y),BackgroundTransparency=1})
  self:label(row,label,{Size=UDim2.new(1,-62,0,22),TextSize=13})
  local box=self:input(row,string.format("%.2f",value),{Position=UDim2.new(1,-60,0,0),Size=UDim2.fromOffset(58,22)})
  local track=self:frame(row,{Position=UDim2.fromOffset(0,34),Size=UDim2.new(1,0,0,5)},"line")
  local fill=self:frame(track,{Size=UDim2.fromScale((value-min)/(max-min),1)},"accent")
  local hit=self:make("TextButton",row,{Position=UDim2.fromOffset(0,26),Size=UDim2.new(1,0,0,24),Text="",BackgroundTransparency=1,AutoButtonColor=false})
  local drag=false
  local function update(v) value=math.clamp(v,min,max);fill.Size=UDim2.fromScale((value-min)/(max-min),1);box.Text=string.format("%.2f",value);callback(value) end
  local function mouse()
   local p=widget:GetRelativeMousePosition();local x=p.X-(hit.AbsolutePosition.X-widget.AbsolutePosition.X)
   update(min+math.clamp(x/math.max(1,hit.AbsoluteSize.X),0,1)*(max-min))
  end
  self:connect(hit.InputBegan,function(input)if input.UserInputType==Enum.UserInputType.MouseButton1 then drag=true;self.drag=mouse;self.dragOwner=hit;if onBegin then onBegin() end;mouse();self:connect(input.Changed,function()if input.UserInputState==Enum.UserInputState.End then drag=false;self.drag=nil;self.dragOwner=nil end end)end end)
  self:connect(box.FocusLost,function()local n=tonumber(box.Text);if n and n==n then if onBegin then onBegin() end;update(n)else box.Text=string.format("%.2f",value)end end)
  return row
 end
 function self:dispose() for _,c in self.connections do c:Disconnect() end;self.connections={};self.styles={} end
 self:connect(studio.ThemeChanged,function()self.colors=palette();for obj,roles in self.styles do if obj.Parent then for property,role in roles do obj[property]=self.colors[role] end end end end)
 self:connect(game:GetService("RunService").RenderStepped,function() if self.drag and self.dragOwner.Parent and widget.Enabled then self.drag() end end)
 return self
end
return UI
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="FML14">
        <Properties>
          <string name="Name">View</string>
          <ProtectedString name="Source">local UI=require(script.Parent.UI)
local M=require(script.Parent.Model)
local Library=require(script.Parent.Library)
local Sampler=require(script.Parent.Sampler)
local Rig=require(script.Parent.Rig)
local Controller=require(script.Parent.Controller)
local View={}
function View.mount(widget,plugin)
 local c=Controller.create(plugin);local ui=UI.new(widget);local scopes={};local alive=true
 local root=ui:frame(widget,{Size=UDim2.fromScale(1,1),ClipsDescendants=true})
 local header=ui:frame(root,{Size=UDim2.new(1,0,0,104)})
 ui:label(header,"Forge Motion Lab",{Position=UDim2.fromOffset(18,8),Size=UDim2.fromOffset(220,32),TextSize=20,Font=Enum.Font.BuilderSansBold})
 ui:label(header,"Motion creation · R15",{Position=UDim2.fromOffset(18,40),Size=UDim2.fromOffset(200,18),TextSize=12},"muted")
 local nameBox=ui:input(header,c.preset.name,{Position=UDim2.fromOffset(246,14),Size=UDim2.new(1,-538,0,30)},function(text)if #text&gt;0 and #text&lt;=80 then c:edit(function(p)p.name=text end)end end)
 local status=ui:label(root,"Ready",{Position=UDim2.new(0,16,1,-27),Size=UDim2.new(1,-32,0,22),TextSize=12},"muted")
 local dirty=ui:label(header,"Unsaved mix",{Position=UDim2.fromOffset(246,47),Size=UDim2.new(1,-540,0,18),TextSize=12},"muted")
 local left=ui:frame(root,{Position=UDim2.fromOffset(12,108),Size=UDim2.new(0,210,1,-312)})
 local right=ui:frame(root,{Position=UDim2.new(1,-292,0,108),Size=UDim2.new(0,280,1,-312)})
 local center=ui:frame(root,{Position=UDim2.fromOffset(234,108),Size=UDim2.new(1,-538,1,-312)},"canvas")
 local bottom=ui:frame(root,{Position=UDim2.new(0,12,1,-192),Size=UDim2.new(1,-24,0,158)})
 local timeReadout=ui:label(center,"0.00s",{Position=UDim2.new(1,-100,0,44),Size=UDim2.fromOffset(86,18),TextXAlignment=Enum.TextXAlignment.Right,TextSize=11},"muted")
 local title=ui:label(center,"Run",{Position=UDim2.fromOffset(14,12),Size=UDim2.new(1,-110,0,24),TextSize=17,Font=Enum.Font.BuilderSansBold})
 local subtitle=ui:label(center,"Live R15 preview",{Position=UDim2.fromOffset(14,38),Size=UDim2.new(1,-28,0,18),TextSize=12},"muted")
 local viewport=ui:make("ViewportFrame",center,{Position=UDim2.fromOffset(0,65),Size=UDim2.new(1,0,1,-110),BackgroundTransparency=1,Ambient=Color3.fromRGB(165,174,192),LightColor=Color3.fromRGB(233,240,255),LightDirection=Vector3.new(-1,-1,-.5),BorderSizePixel=0})
 local world=Instance.new("WorldModel");world.Parent=viewport
 local camera=Instance.new("Camera");camera.FieldOfView=38;camera.Parent=viewport;viewport.CurrentCamera=camera
 local rig=Rig.new(world);local rigB=Rig.new(world,Color3.fromRGB(225,180,115));rigB.model.Parent=nil
 local grid=Instance.new("Folder");grid.Name="Grid";grid.Parent=world
 for i=-8,8 do for _,axis in {"x","z"} do local p=Instance.new("Part");p.Size=if axis=="x" then Vector3.new(16,.015,.025) else Vector3.new(.025,.015,16);p.CFrame=CFrame.new(if axis=="x" then Vector3.new(0,-.02,i) else Vector3.new(i,-.02,0));p.Anchored=true;p.CanCollide=false;p.Color=Color3.fromRGB(68,87,111);p.Transparency=if i==0 then .2 else .65;p.Parent=grid end end
 local showGrid=true;local showRoot=true;local mode="front";local yaw=math.pi;local pitch=.16;local distance=12;local drag=nil;local last=nil
 local function updateCamera()camera.CFrame=CFrame.lookAt(Vector3.new(math.sin(yaw)*distance,2.2+math.sin(pitch)*distance,math.cos(yaw)*distance),Vector3.new(0,2.2,0))end;updateCamera()
 local refresh,refreshLibrary,refreshInspector,refreshTimeline
 local function state()nameBox.Text=c.preset.name;dirty.Text=if c.dirty then "Unsaved changes" else "Saved preset";title.Text=if c.sequenceMode then c:sequence().name else Sampler.resolveAsset(c.preset,c.library.assets[c.clip],c.library).name;subtitle.Text=if c.compare then "A: pinned reference    B: current edit" else "Live R15 · "..(if c.preset.clips[Sampler.resolveAsset(c.preset,c.library.assets[c.clip],c.library).grammar] then "authored clip / editable mix" else "procedural starting motion")end
 local function action(fn,message)
  local ok,err=pcall(fn);status.Text=if ok then message or "Updated" else tostring(err):gsub("^.-:%d+: ","");state();if ok and refresh then refresh() end
 end
 local popup=nil;local popupUI=nil
 local function closeMenu()if popupUI then popupUI:dispose();popupUI=nil end;if popup then popup:Destroy();popup=nil end end
 local function menu(anchor,items,chosen)
  closeMenu();popupUI=UI.new(widget)
  popup=ui:frame(root,{Size=UDim2.fromOffset(math.max(180,anchor.AbsoluteSize.X),math.min(320,#items*30+8)),Position=UDim2.fromOffset(math.clamp(anchor.AbsolutePosition.X-root.AbsolutePosition.X,8,root.AbsoluteSize.X-210),math.min(root.AbsoluteSize.Y-330,anchor.AbsolutePosition.Y-root.AbsolutePosition.Y+anchor.AbsoluteSize.Y+4)),ZIndex=50},"hover")
  local scroll=ui:scroll(popup,{Size=UDim2.new(1,-8,1,-8),Position=UDim2.fromOffset(4,4),ZIndex=51})
  for i,item in items do popupUI:button(scroll,item.name,{Position=UDim2.fromOffset(0,(i-1)*30),Size=UDim2.new(1,-4,0,28),ZIndex=52},function()closeMenu();chosen(item.id)end)end
 end
 local function pick(anchor,items,fn)menu(anchor,items,function(id)action(function()fn(id)end)end)end
 local save=ui:button(header,"Save",{Position=UDim2.new(1,-282,0,14),Size=UDim2.fromOffset(72,30)},function()action(function()c:save()end,"Preset saved locally")end,true)
 ui:button(header,"Export",{Position=UDim2.new(1,-200,0,14),Size=UDim2.fromOffset(82,30)},function()action(function()assert(not game:GetService("RunService"):IsRunning(),"Export in Edit mode");local module=c:export(game:GetService("ServerStorage"));game:GetService("Selection"):Set({module})end,"Config exported to ServerStorage · no gameplay changes")end)
 ui:button(header,"Attach R15",{Position=UDim2.new(1,-108,0,14),Size=UDim2.fromOffset(94,30)},function()action(function()assert(not game:GetService("RunService"):IsRunning(),"Apply in Edit mode");local selected=game:GetService("Selection"):Get()[1];assert(selected and selected:IsA("Model") and selected:FindFirstChild("Humanoid") and selected.Humanoid.RigType==Enum.HumanoidRigType.R15,"Select an R15 Model first");c:export(selected)end,"Profile attached to R15 · animations untouched")end)
 local new=ui:button(header,"New profile",{Position=UDim2.fromOffset(18,72),Size=UDim2.fromOffset(94,28)})
 ui:connect(new.Activated,function()local items={{id="blank",name="Blank profile"}};for _,t in Library.Templates do table.insert(items,{id=t.id,name=t.name.." starting profile"})end;pick(new,items,function(id)c:new(if id=="blank" then nil else id)end)end)
 ui:button(header,"Duplicate",{Position=UDim2.fromOffset(120,72),Size=UDim2.fromOffset(80,28)},function()action(function()c:duplicate()end)end)
 local deleting=false
 ui:button(header,"Delete",{Position=UDim2.fromOffset(208,72),Size=UDim2.fromOffset(64,28)},function()if not deleting then deleting=true;status.Text="Click Delete again to remove this custom preset";return end;deleting=false;action(function()c.store:delete(c.preset.id);c:new(nil)end,"Preset removed")end)
 ui:button(header,"↶",{Position=UDim2.fromOffset(286,72),Size=UDim2.fromOffset(30,28)},function()action(function()c:undo()end)end)
 ui:button(header,"↷",{Position=UDim2.fromOffset(320,72),Size=UDim2.fromOffset(30,28)},function()action(function()c:redo()end)end)
 ui:button(header,"Pin A",{Position=UDim2.fromOffset(366,72),Size=UDim2.fromOffset(66,28)},function()action(function()c:pinCompare();rigB.model.Parent=world end,"A pinned; edit B to compare")end)
 ui:button(header,"Clear A/B",{Position=UDim2.fromOffset(440,72),Size=UDim2.fromOffset(78,28)},function()action(function()c.compare=nil;rigB.model.Parent=nil end)end)
 ui:button(header,"Mirror",{Position=UDim2.fromOffset(534,72),Size=UDim2.fromOffset(70,28)},function()action(function()c.mirror=not c.mirror end,c.mirror and "Mirror off" or "Mirror on")end)
 local function scope(key,parent)
  if scopes[key] then scopes[key]:dispose() end;parent:ClearAllChildren();scopes[key]=UI.new(widget);return scopes[key]
 end
 local search="";local category="All"
 refreshLibrary=function()
  local u=scope("library",left);u:label(left,"Sources",{Position=UDim2.fromOffset(12,10),Size=UDim2.new(1,-24,0,24),TextSize=16,Font=Enum.Font.BuilderSansBold})
  for i,tab in {"Characters","Library","Custom"} do u:button(left,tab,{Position=UDim2.new((i-1)/3,8,0,42),Size=UDim2.new(1/3,-10,0,27)},function()c.tab=tab;search="";refreshLibrary()end,c.tab==tab)end
  local field=u:input(left,search,{Position=UDim2.fromOffset(10,78),Size=UDim2.new(1,-20,0,30),PlaceholderText="Search sources"})
  u:connect(field.FocusLost,function()search=field.Text:lower();refreshLibrary()end)
  local y=116
  if c.tab=="Library" then local filter=u:button(left,category.." ▾",{Position=UDim2.fromOffset(10,y),Size=UDim2.new(1,-20,0,28)})
   u:connect(filter.Activated,function()local items={{id="All",name="All families"}};for _,family in Library.Families do table.insert(items,{id=family,name=family})end;pick(filter,items,function(id)category=id end)end);y+=36 end
  local scroll=u:scroll(left,{Position=UDim2.fromOffset(8,y),Size=UDim2.new(1,-16,1,-y-42)})
  local rows={}
  if c.tab=="Library" then for _,id in c.library.assetOrder do local a=c.library.assets[id];if (category=="All" or a.category==category) and (search=="" or a.name:lower():find(search,1,true)) then table.insert(rows,{id=id,name=a.name,desc=a.category})end end
  else for _,id in c.library.order do local p=c.library.presets[id];local custom=c.store.custom[id]~=nil;if (c.tab=="Custom")==custom and (search=="" or p.name:lower():find(search,1,true)) then table.insert(rows,{id=id,name=p.name,desc=if p.metadata.sourceType=="ninja-duel" then "Authored · Ninja Duel" elseif custom then "Saved motion profile" else "Generated starting profile"})end end end
  for i,row in rows do
   local b=u:button(scroll,"",{Position=UDim2.fromOffset(0,(i-1)*62),Size=UDim2.new(1,-6,0,56)},function()action(function()if c.tab=="Library" then c.clip=row.id;c.sequenceMode=false;c.time=0 else c:load(row.id)end end)end)
   u:label(b,row.name,{Position=UDim2.fromOffset(10,6),Size=UDim2.new(1,-20,0,24),Font=Enum.Font.BuilderSansMedium})
   u:label(b,row.desc,{Position=UDim2.fromOffset(10,30),Size=UDim2.new(1,-20,0,18),TextSize=11},"muted")
   if c.tab=="Library" and c.clip==row.id then u:frame(b,{Size=UDim2.new(0,3,1,-10),Position=UDim2.fromOffset(0,5)},"accent")end
  end
  if #rows==0 then u:label(scroll,if c.tab=="Custom" then "No saved profiles yet.\nSave a mix to keep it here." else "No matching sources.",{Size=UDim2.new(1,-10,0,80),TextWrapped=true,TextSize=13},"muted")end
  u:button(left,"Import selected export",{Position=UDim2.new(0,10,1,-34),Size=UDim2.new(1,-20,0,26)},function()action(function()local item=game:GetService("Selection"):Get()[1];assert(item,"Select an exported ModuleScript or JSON value");c:import(item)end,"Imported safely from JSON")end)
 end
 local inspectorTab="Mixer"
 refreshInspector=function()
  local u=scope("inspector",right)
  for i,tab in {"Mixer","DNA","Advanced"} do u:button(right,tab,{Position=UDim2.new((i-1)/3,8,0,10),Size=UDim2.new(1/3,-12,0,30)},function()inspectorTab=tab;refreshInspector()end,inspectorTab==tab)end
  local scroll=u:scroll(right,{Position=UDim2.fromOffset(12,52),Size=UDim2.new(1,-24,1,-64)})
  if inspectorTab=="Mixer" then
   u:label(scroll,"Body Mixer",{Size=UDim2.new(1,0,0,28),TextSize=17,Font=Enum.Font.BuilderSansBold})
   u:label(scroll,"Choose an expression for each layer.",{Position=UDim2.fromOffset(0,28),Size=UDim2.new(1,0,0,22),TextSize=12},"muted")
   for i,layer in M.Layers do local y=60+(i-1)*124;local spec=c.preset.bodyLayers[layer]
    local label=layer:gsub("Arm"," arm");u:label(scroll,label,{Position=UDim2.fromOffset(0,y),Size=UDim2.new(1,-56,0,22),Font=Enum.Font.BuilderSansMedium})
    u:button(scroll,spec.enabled and "On" or "Off",{Position=UDim2.new(1,-48,0,y),Size=UDim2.fromOffset(42,22)},function()action(function()c:edit(function(p)p.bodyLayers[layer].enabled=not spec.enabled end)end)end,spec.enabled)
    local source=if spec.source=="base" then "Own profile" else c.library.presets[spec.source].name
    local pickButton=u:button(scroll,source.." ▾",{Position=UDim2.fromOffset(0,y+27),Size=UDim2.new(1,-6,0,28)})
    u:connect(pickButton.Activated,function()local choices={{id="base",name="Own profile"}};for _,id in c.library.order do if id~=c.preset.id then table.insert(choices,{id=id,name=c.library.presets[id].name})end end;pick(pickButton,choices,function(id)c:edit(function(p)p.bodyLayers[layer].source=id end)end)end)
    u:slider(scroll,"Blend",0,1,spec.strength,y+58,function(value)c:edit(function(p)p.bodyLayers[layer].strength=value end,false);state()end,function()c:checkpoint()end)
   end
  elseif inspectorTab=="DNA" then
   u:button(scroll,"Generate movement set",{Size=UDim2.new(1,-4,0,32)},function()action(function()c:generate()end,"Suggested route generated; every block remains editable")end,true)
   local y=44;local group=nil
   for _,row in M.DNA do if group~=row[6] then group=row[6];u:label(scroll,group,{Position=UDim2.fromOffset(0,y),Size=UDim2.new(1,-6,0,24),Font=Enum.Font.BuilderSansBold});y+=30 end
    u:slider(scroll,row[2],row[3],row[4],c.preset.motionDNA[row[1]],y,function(value)c:edit(function(p)p.motionDNA[row[1]]=value end,false);state()end,function()c:checkpoint()end);y+=62 end
  else
   local text="Profile ID\n"..c.preset.id.."\n\nSource\n"..c.preset.metadata.sourceType.."\n\nRig\nR15 · anatomical joint controls\n\nExport\nNinjaDuel.MotionDefinitions.v1\nData only. No automatic apply.\n\nCharacter expression\n"..game:GetService("HttpService"):JSONEncode(c.preset.characterRules)
   u:label(scroll,text,{Size=UDim2.new(1,-8,0,260),TextSize=13,TextWrapped=true,TextYAlignment=Enum.TextYAlignment.Top})
   u:label(scroll,"Character rules (JSON)",{Position=UDim2.fromOffset(0,266),Size=UDim2.new(1,-8,0,24),Font=Enum.Font.BuilderSansMedium})
   u:input(scroll,game:GetService("HttpService"):JSONEncode(c.preset.characterRules),{Position=UDim2.fromOffset(0,294),Size=UDim2.new(1,-8,0,74),MultiLine=true,TextWrapped=true,TextYAlignment=Enum.TextYAlignment.Top},function(text)action(function()
    local rules=game:GetService("HttpService"):JSONDecode(text);local candidate=M.copy(c.preset);candidate.characterRules=rules;local valid,why=M.validate(candidate,c.library.presets);assert(valid,why);c:edit(function(p)p.characterRules=rules end)
   end,"Expression rules updated")end)
   for i,key in {"idle","walk","run","dash","jump","land","wall"} do
    local y=382+(i-1)*38;u:button(scroll,key,{Position=UDim2.fromOffset(0,y),Size=UDim2.fromOffset(60,28)},function()c.clip=if key=="wall" then "wallrun" else key;c.sequenceMode=false;c.time=0;state();refreshTimeline()end)
    local id=c.preset.locomotionSet[key] or key;local button=u:button(scroll,(c.library.assets[id] and c.library.assets[id].name or id).." ▾",{Position=UDim2.fromOffset(70,y),Size=UDim2.new(1,-78,0,28)})
    u:connect(button.Activated,function()local items={};for _,assetId in c.library.assetOrder do table.insert(items,{id=assetId,name=c.library.assets[assetId].name})end;pick(button,items,function(chosen)c:edit(function(p)p.locomotionSet[key]=chosen end)end)end)
   end
  end
 end
 refreshTimeline=function()
  local u=scope("timeline",bottom);local seq=c:sequence()
  u:label(bottom,"Sequence",{Position=UDim2.fromOffset(12,8),Size=UDim2.fromOffset(90,24),Font=Enum.Font.BuilderSansBold,TextSize=15})
  u:input(bottom,seq.name,{Position=UDim2.fromOffset(106,8),Size=UDim2.fromOffset(180,26)},function(text)if #text&gt;0 and #text&lt;=64 then c:edit(function(p)p.sequences[1].name=text end);state()end end)
  u:button(bottom,"+ "..c.library.assets[c.clip].name,{Position=UDim2.fromOffset(300,8),Size=UDim2.fromOffset(120,26)},function()action(function()c:addClip(c.clip)end)end)
  u:button(bottom,"Preview phrase",{Position=UDim2.fromOffset(432,8),Size=UDim2.fromOffset(116,26)},function()c.sequenceMode=true;c.time=0;state()end)
  local line=u:make("ScrollingFrame",bottom,{Position=UDim2.fromOffset(12,44),Size=UDim2.new(1,-24,0,62),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=3,CanvasSize=UDim2.fromOffset(#seq.orderedClips*112,0),ScrollingDirection=Enum.ScrollingDirection.X})
  for i,block in seq.orderedClips do
   local asset=c.library.assets[block.asset];local b=u:button(line,asset.name.."\n"..string.format("%.2fs",block.duration),{Position=UDim2.fromOffset((i-1)*112,0),Size=UDim2.fromOffset(106,54),TextWrapped=true},function()c.selectedBlock=i;task.defer(function()if alive then refreshTimeline()end end)end,c.selectedBlock==i)
   local start=nil
   u:connect(b.InputBegan,function(input)if input.UserInputType==Enum.UserInputType.MouseButton1 then start=widget:GetRelativeMousePosition().X;u:connect(input.Changed,function()if input.UserInputState==Enum.UserInputState.End and start then local dx=widget:GetRelativeMousePosition().X-start;start=nil;local target=math.clamp(i+math.floor(dx/112+.5),1,#seq.orderedClips);if target~=i then action(function()c:edit(function(p)M.reorder(p.sequences[1],i,target)end);c.selectedBlock=target end,"Blocks reordered")end end end)end end)
  end
  if #seq.orderedClips==0 then u:label(line,"Choose a library block, then add it here.",{Size=UDim2.new(1,-12,0,44),TextSize=13},"muted")end
  local scrub=u:make("TextButton",bottom,{Position=UDim2.fromOffset(12,105),Size=UDim2.new(1,-24,0,8),Text="",BackgroundTransparency=.65,AutoButtonColor=false,BorderSizePixel=0})
  u:paint(scrub,"BackgroundColor3","line")
  u:connect(scrub.InputBegan,function(input)if input.UserInputType==Enum.UserInputType.MouseButton1 then
   local mouse=widget:GetRelativeMousePosition();local relative=mouse.X-(scrub.AbsolutePosition.X-widget.AbsolutePosition.X)
   c.sequenceMode=true;c.playing=false;c.time=math.clamp(relative/math.max(1,scrub.AbsoluteSize.X),0,1)*M.duration(seq)/c.preset.motionDNA.recoverySpeed;state()
  end end)
  local selected=seq.orderedClips[c.selectedBlock]
  if selected then
   u:label(bottom,"Duration",{Position=UDim2.fromOffset(12,115),Size=UDim2.fromOffset(56,26),TextSize=12},"muted")
   u:input(bottom,tostring(selected.duration),{Position=UDim2.fromOffset(72,115),Size=UDim2.fromOffset(60,26)},function(text)local n=tonumber(text);if n and n&gt;=.12 and n&lt;=5 then action(function()c:edit(function(p)p.sequences[1].orderedClips[c.selectedBlock].duration=n end)end)else status.Text="Duration: 0.12–5 seconds"end end)
   u:label(bottom,"Blend",{Position=UDim2.fromOffset(144,115),Size=UDim2.fromOffset(42,26),TextSize=12},"muted")
   u:input(bottom,tostring(selected.blend),{Position=UDim2.fromOffset(190,115),Size=UDim2.fromOffset(60,26)},function(text)local n=tonumber(text);if n and n&gt;=0 and n&lt;=.5 then action(function()c:edit(function(p)p.sequences[1].orderedClips[c.selectedBlock].blend=n end)end)end end)
   u:button(bottom,selected.transition=="cut" and "Cut" or "Blend",{Position=UDim2.fromOffset(266,115),Size=UDim2.fromOffset(62,26)},function()action(function()c:edit(function(p)local b=p.sequences[1].orderedClips[c.selectedBlock];b.transition=if b.transition=="cut" then "blend" else "cut" end)end)end)
   u:button(bottom,"Remove block",{Position=UDim2.fromOffset(340,115),Size=UDim2.fromOffset(108,26)},function()action(function()c:edit(function(p)table.remove(p.sequences[1].orderedClips,c.selectedBlock)end);c.selectedBlock=math.max(1,c.selectedBlock-1)end)end)
  end
 end
 refresh=function()refreshLibrary();refreshInspector();refreshTimeline();state()end
 local controls=ui:frame(center,{Position=UDim2.new(0,0,1,-39),Size=UDim2.new(1,0,0,39)})
 local function layout()
  local narrow=root.AbsoluteSize.X&lt;1000;local lw=if narrow then 180 else 210;local rw=if narrow then 240 else 280
  left.Size=UDim2.new(0,lw,1,-312);right.Position=UDim2.new(1,-rw-12,0,108);right.Size=UDim2.new(0,rw,1,-312)
  center.Position=UDim2.fromOffset(lw+24,108);center.Size=UDim2.new(1,-lw-rw-48,1,-312)
 end
 ui:connect(root:GetPropertyChangedSignal("AbsoluteSize"),layout);layout()
 local play;play=ui:button(controls,"Pause",{Position=UDim2.new(0,5,0,6),Size=UDim2.new(1/6,-7,0,28)},function()c.playing=not c.playing;play.Text=if c.playing then "Pause" else "Play" end)
 local loop;loop=ui:button(controls,"Loop ✓",{Position=UDim2.new(1/6,5,0,6),Size=UDim2.new(1/6,-7,0,28)},function()c.loop=not c.loop;loop.Text=if c.loop then "Loop ✓" else "Once" end)
 local speed=ui:button(controls,"1×",{Position=UDim2.new(2/6,5,0,6),Size=UDim2.new(1/6,-7,0,28)})
 ui:connect(speed.Activated,function()pick(speed,{{id="0.5",name="0.5×"},{id="1",name="1×"},{id="1.5",name="1.5×"},{id="2",name="2×"}},function(id)c.speed=tonumber(id);speed.Text=id.."×"end)end)
 local cameraButton=ui:button(center,"Front ▾",{Position=UDim2.new(1,-94,0,14),Size=UDim2.fromOffset(80,28)})
 ui:connect(cameraButton.Activated,function()pick(cameraButton,{{id="front",name="Front"},{id="side",name="Side"},{id="free",name="Free orbit"}},function(id)mode=id;cameraButton.Text=id.." ▾";if id=="front" then yaw=math.pi;pitch=.16 elseif id=="side" then yaw=math.pi/2;pitch=.16 end;updateCamera()end)end)
 local gridButton;gridButton=ui:button(controls,"Grid ✓",{Position=UDim2.new(3/6,5,0,6),Size=UDim2.new(1/6,-7,0,28)},function()showGrid=not showGrid;grid.Parent=if showGrid then world else nil;gridButton.Text=if showGrid then "Grid ✓" else "Grid" end)
 local rootButton;rootButton=ui:button(controls,"Root ✓",{Position=UDim2.new(4/6,5,0,6),Size=UDim2.new(1/6,-7,0,28)},function()showRoot=not showRoot;rootButton.Text=if showRoot then "Root ✓" else "Root" end)
 ui:button(controls,"Reset",{Position=UDim2.new(5/6,5,0,6),Size=UDim2.new(1/6,-7,0,28)},function()c.time=0 end)
 ui:connect(viewport.InputBegan,function(input)if mode=="free" and (input.UserInputType==Enum.UserInputType.MouseButton2 or input.UserInputType==Enum.UserInputType.MouseButton1) then drag=true;last=widget:GetRelativeMousePosition();ui:connect(input.Changed,function()if input.UserInputState==Enum.UserInputState.End then drag=nil end end)end end)
 ui:connect(viewport.InputChanged,function(input)if input.UserInputType==Enum.UserInputType.MouseWheel then distance=math.clamp(distance-input.Position.Z,7,22);updateCamera()end end)
 local debt=0
 ui:connect(game:GetService("RunService").RenderStepped,function(dt)
  if not alive or not widget.Enabled then return end
  play.Text=if c.playing then "Pause" else "Play"
  if drag then local now=widget:GetRelativeMousePosition();local diff=now-last;last=now;yaw-=diff.X*.009;pitch=math.clamp(pitch+diff.Y*.006,-.15,.8);updateCamera()end
  debt+=dt;if debt&lt;1/30 then return end;local tick=math.min(debt,.1);debt=0
  local total=if c.sequenceMode then M.duration(c:sequence())/c.preset.motionDNA.recoverySpeed else Sampler.duration(c.preset,c.library.assets[c.clip],c.library)
  total=math.max(total,.1)
  if c.playing then c.time+=tick*c.speed;if c.time&gt;=total then if c.loop then c.time%=total else c.time=total;c.playing=false;play.Text="Play" end end end
  timeReadout.Text=string.format("%.2f / %.2fs",c.time,total)
  local function pose(p,reference)
   local lib=if reference then c.compareLibrary else c.library
   local sequenceMode=if reference then c.compareSequenceMode else c.sequenceMode
   local clip=if reference then c.compareClip else c.clip
   if sequenceMode then
    local seq=p.sequences[1] or {orderedClips={}};local duration=math.max(.1,M.duration(seq)/p.motionDNA.recoverySpeed)
    local current=Sampler.sequence(p,seq,(c.time/total)*duration,lib,c.mirror)
    if c.loop and c.time&gt;total-.08 then return Sampler.blendPose(current,Sampler.sequence(p,seq,0,lib,c.mirror),math.clamp((c.time-total+.08)/.08,0,1))end
    return current
   end
   local current=Sampler.sample(p,lib.assets[clip],math.clamp(c.time/total,0,1),lib,c.mirror)
   if c.loop and c.time&gt;total-.08 then return Sampler.blendPose(current,Sampler.sample(p,lib.assets[clip],0,lib,c.mirror),math.clamp((c.time-total+.08)/.08,0,1))end
   return current
  end
  local ok,err=pcall(function()
   local current=pose(c.preset)
   if c.compare then Rig.apply(rig,pose(c.compare,true),Vector3.new(-2.5,3,0),showRoot,c.compare.bodyLayers.Weapon.enabled);Rig.apply(rigB,current,Vector3.new(2.5,3,0),showRoot,c.preset.bodyLayers.Weapon.enabled)
   else Rig.apply(rig,current,Vector3.new(0,3,0),showRoot,c.preset.bodyLayers.Weapon.enabled)end
  end)
  if not ok then c.playing=false;status.Text="Preview: "..tostring(err) end
 end)
 refresh();status.Text=c.store.notice or "Minato lower body + Itachi upper body · save to keep this mix"
 return function()alive=false;closeMenu();for _,scope in scopes do scope:dispose()end;ui:dispose();rig.model:Destroy();rigB.model:Destroy();world:Destroy();grid:Destroy();root:Destroy()end,c
end
return View
</ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="FML3">
      <Properties>
        <string name="Name">Main</string>
        <ProtectedString name="Source">-- Local Studio plugin only; importing the model into a place cannot start it.
if not plugin then return end
local toolbar=plugin:CreateToolbar("Forge Motion Lab")
local button=toolbar:CreateButton("Motion Lab","Create, mix and preview R15 motion profiles","","Motion Lab")
button.ClickableWhenViewportHidden=true
local widget=plugin:CreateDockWidgetPluginGuiAsync("ForgeMotionLab_v1",DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Float,false,false,1180,780,780,600))
widget.Title="Forge Motion Lab"
local dispose,controller=require(script.Parent.Modules.View).mount(widget,plugin)
button.Click:Connect(function()widget.Enabled=not widget.Enabled end)
widget:GetPropertyChangedSignal("Enabled"):Connect(function()button:SetActive(widget.Enabled)end)
button:SetActive(widget.Enabled)
plugin.Unloading:Connect(function()dispose();widget:Destroy();toolbar:Destroy()end)
</ProtectedString>
      </Properties>
    </Item>
  </Item>
</roblox>