<?xml version='1.0' encoding='utf-8'?>
<roblox version="4">
  <Item class="Model" referent="FML1">
    <Properties>
      <string name="Name">ForgeMotionLab</string>
    </Properties>
    <Item class="Folder" referent="FML2">
      <Properties>
        <string name="Name">Modules</string>
      </Properties>
      <Item class="ModuleScript" referent="FML4">
        <Properties>
          <string name="Name">BilateralLibrary</string>
          <ProtectedString name="Source">-- Common anatomical vocabulary. Data is materialized into independent clips;
-- no character exceptions, mirroring at playback, physics, or gameplay hooks.
local M=require(script.Parent.Model)
local Solver=require(script.Parent.PoseSolver)
local B={Revision=1}
-- Seven phases: feet/load -&gt; hips -&gt; torso/limb -&gt; contact -&gt; carry -&gt; recoil -&gt; guard.
B.Variants={
 Standard={duration=1,load=1,reach=1,travel=.22,turn=1,guard=0,step=0,contact=.44,follow=.63},
 Compact={duration=.83,load=.55,reach=.8,travel=.08,turn=.65,guard=14,step=0,contact=.39,follow=.57},
 Fast={duration=.75,load=.65,reach=.95,travel=.16,turn=.8,guard=8,step=0,contact=.36,follow=.54},
 Heavy={duration=1.3,load=1.45,reach=1.1,travel=.4,turn=1.25,guard=-8,step=.12,contact=.5,follow=.73},
 Long={duration=1.16,load=1.05,reach=1.2,travel=.65,turn=.95,guard=-5,step=.38,contact=.47,follow=.66},
 Rotational={duration=1.24,load=1.25,reach=1.05,travel=.3,turn=1.55,guard=-14,step=.16,contact=.48,follow=.72},
 Stepping={duration=1.18,load=1,reach=1.05,travel=.8,turn=1.05,guard=4,step=.55,contact=.48,follow=.67},
}
-- Each family has a distinct chamber/contact/carry silhouette, not a common strike pulse.
B.Strikes={
 {id="jab",name="Jab",category="Punches",mode="straight",raise=86,out=-8,elbow=12,hip=14,torso=9,duration=.5,variants={"Standard","Compact","Long"},old="jab"},
 {id="cross",name="Cross",category="Punches",mode="straight",raise=98,out=-14,elbow=8,hip=43,torso=24,duration=.65,variants={"Standard","Heavy","Stepping"},old="cross"},
 {id="hook",name="Hook",category="Punches",mode="hook",raise=83,out=-68,elbow=88,hip=48,torso=36,duration=.7,variants={"Standard","Compact","Rotational"},old="hook"},
 {id="uppercut",name="Uppercut",category="Punches",mode="upper",raise=135,out=-12,elbow=66,hip=30,torso=18,duration=.72,variants={"Standard","Compact","Heavy"},old="uppercut"},
 {id="backfist",name="Backfist",category="Punches",mode="backfist",raise=93,out=65,elbow=18,hip=55,torso=28,duration=.66,variants={"Standard","Fast","Rotational"},old="hook"},
 {id="palm",name="Palm",category="Punches",mode="palm",raise=88,out=-12,elbow=24,hip=23,torso=15,duration=.62,variants={"Standard","Compact","Stepping"},old="palm"},
 {id="frontkick",name="Front kick",category="Kicks",mode="front",lift=87,out=4,knee=12,hip=6,torso=-5,duration=.78,variants={"Standard","Fast","Long"},old="frontkick"},
 {id="sidekick",name="Side kick",category="Kicks",mode="side",lift=48,out=83,knee=8,hip=68,torso=-24,duration=.9,variants={"Standard","Heavy","Long"},old="sidekick"},
 {id="roundhouse",name="Roundhouse",category="Kicks",mode="round",lift=80,out=43,knee=15,hip=78,torso=-34,duration=.88,variants={"Standard","Fast","Rotational"},old="roundhouse"},
 {id="lowkick",name="Low kick",category="Kicks",mode="round",lift=32,out=35,knee=23,hip=52,torso=-19,duration=.7,variants={"Standard","Compact","Heavy"},old="roundhouse"},
 {id="highkick",name="High kick",category="Kicks",mode="round",lift=123,out=28,knee=10,hip=84,torso=-43,duration=1,variants={"Standard","Fast","Long"},old="roundhouse"},
 {id="backkick",name="Back kick",category="Kicks",mode="back",lift=-57,out=8,knee=12,hip=142,torso=-22,duration=.98,variants={"Standard","Compact","Stepping"},old="sidekick"},
 {id="spinningkick",name="Spinning kick",category="Kicks",mode="spin",lift=55,out=78,knee=10,hip=255,torso=-30,duration=1.15,variants={"Standard","Fast","Rotational"},old="spinkick"},
 {id="axekick",name="Axe kick",category="Kicks",mode="axe",lift=64,out=5,knee=8,hip=12,torso=-9,duration=1.08,variants={"Standard","Heavy","Stepping"},old="frontkick"},
 {id="sweep",name="Sweep",category="Kicks",mode="sweep",lift=12,out=83,knee=8,hip=118,torso=-32,duration=1,variants={"Standard","Compact","Rotational"},old="sweep"},
 {id="frontknee",name="Front knee",category="Knees",mode="knee",lift=94,out=6,knee=142,hip=12,torso=9,duration=.72,variants={"Standard","Compact","Stepping"},old="knee"},
 {id="risingknee",name="Rising knee",category="Knees",mode="rising",lift=120,out=9,knee=146,hip=18,torso=-8,duration=.82,variants={"Standard","Fast","Heavy"},old="risingknee"},
 {id="jumpingknee",name="Jumping knee",category="Knees",mode="jumpknee",lift=116,out=12,knee=140,hip=24,torso=12,duration=1.1,variants={"Standard","Long","Stepping"},old="risingknee"},
 {id="horizontalelbow",name="Horizontal elbow",category="Elbows",mode="elbow",raise=92,out=-70,elbow=143,hip=44,torso=28,duration=.66,variants={"Standard","Compact","Stepping"},old="elbow"},
 {id="downwardelbow",name="Downward elbow",category="Elbows",mode="downelbow",raise=70,out=-18,elbow=142,hip=20,torso=12,duration=.8,variants={"Standard","Heavy","Long"},old="elbow"},
 {id="spinningelbow",name="Spinning elbow",category="Elbows",mode="spinelbow",raise=90,out=-65,elbow=145,hip=250,torso=-30,duration=1.02,variants={"Standard","Fast","Rotational"},old="spinelbow"},
}
local function arm(raise,out,elbow,twist)return {raise=raise,out=out,elbow=elbow,twist=twist or 0,wrist=0,wroll=0}end
function B.guard(lead)
 local left=lead=="LeftLead"
 return {root={x=0,y=-.32,z=0,pitch=4,yaw=if left then -12 else 12,roll=0},torso={pitch=2,yaw=if left then 8 else -8,roll=0},head={pitch=-3,yaw=if left then 4 else -4,roll=0},
  la=arm(if left then 63 else 49,12,if left then 103 else 124),ra=arm(if left then 49 else 63,12,if left then 124 else 103),
  lf={x=-.06,y=0,z=if left then -.38 else .38,yaw=if left then -5 else -20,toe=0},rf={x=.06,y=0,z=if left then .38 else -.38,yaw=if left then 20 else 5,toe=0}}
end
local function key(at,pose,ease,phase)return {at=at,pose=pose,ease=ease or "smooth",phase=phase}end
local function footKey(side)return if side=="Left"then "lf"else "rf"end
local function legKey(side)return if side=="Left"then "ll"else "rl"end
local function armKey(side)return if side=="Left"then "la"else "ra"end
local function other(side)return if side=="Left"then "Right"else "Left"end
local function direction(side)return if side=="Left"then -1 else 1 end
local function fk(p,side)
 local f=footKey(side);local l=legKey(side);p[l]=Solver.freeLeg(p,direction(side));p[f]=nil
end
local function rotate(p,sign,hip,torso)
 p.root.yaw+=sign*hip;p.torso.yaw+=sign*torso
 -- Counter-rotate neck to preserve the target, instead of turning head with the pelvis.
 p.head.yaw=math.clamp(-(p.root.yaw+p.torso.yaw),-75,75);p.head.pitch=-(p.root.pitch+p.torso.pitch)*.5
end
function B.strike(def,side,variantName)
 local v=B.Variants[variantName];local sign=direction(side);local a=armKey(side);local guard=armKey(other(side));local f=footKey(side);local support=footKey(other(side));local l=legKey(side)
 local isLeg=def.category=="Kicks"or def.category=="Knees"
 -- Both versions work from the same target-facing lead, so rear-side actions
 -- must load/brace differently from lead-side actions. No mirrored source.
 local lead="LeftLead";local rear=side=="Right";local start=B.guard(lead)
 local load=M.copy(start);local drive=M.copy(start);local contact=M.copy(start);local carry=M.copy(start);local recoil=M.copy(start);local finish=M.copy(start)
 load.root.y-=.09*v.load;load.root.x=sign*(if rear then .12 else .2)*v.load;load.root.z=.1*v.load
 rotate(load,sign,-def.hip*.4*v.load,def.torso*.2)
 load[a].raise=if isLeg then 65 else 38;load[a].elbow=if isLeg then 118 else 138;load[a].out=20+v.load*10
 load[guard].raise=66+v.guard;load[guard].elbow=126
 drive.root.y-=.12*v.load;drive.root.x=-sign*.12;drive.root.z=-v.travel*.45
 rotate(drive,sign,def.hip*.52*v.turn,def.torso*.12)
 drive[support].yaw=start[support].yaw+sign*(def.hip*.42*v.turn);drive[support].toe=if isLeg or rear then 0 else 6;if not isLeg then drive[f].toe=if rear then 12 else 0 end
 drive[a].raise=if isLeg then 72 else 62;drive[a].elbow=120
 contact.root.x=-sign*(if isLeg then .25 else .1);contact.root.z=-v.travel;contact.root.pitch=if isLeg then -5 else 10*v.reach
 rotate(contact,sign,if def.mode=="spin"or def.mode=="spinelbow"then math.min(275,def.hip*v.turn)else def.hip*v.turn,def.torso*v.turn)
 contact[support].yaw=start[support].yaw+sign*math.min(105,def.hip*.65*v.turn);contact[support].toe=if isLeg or rear then 0 else 10;if not isLeg then contact[f].toe=if rear then 19 else 0 end
 contact[guard]=arm(72+v.guard,9,126,-8);contact.head.roll=-sign*3
 -- Stepping/long actions move the lead foot before committing weight. Rear
 -- strikes retain the brace and release the rear heel, lead strikes widen it.
 for _,p in {drive,contact,carry,recoil,finish}do
  p.lf.z-=v.step;p.lf.x-=v.step*.15
  if variantName=="Rotational"then p.rf.x+=.12;p.lf.x-=.08 end
 end
 if not isLeg then
  contact[a]=arm(def.raise*v.reach,def.out,def.elbow,if def.mode=="backfist"then -65 else 18)
  if def.mode=="palm"then contact[a].wrist=-42;contact[a].wroll=-12 end
  if def.mode=="hook"then load[a]=arm(67,66,103,-20);drive[a]=arm(82,18,96,15)end
  if def.mode=="upper"then load.root.y-=.22*v.load;load[a]=arm(10,4,113);drive.root.y=-.43;drive[a]=arm(60,-5,84);contact.root.y=-.12;contact.torso.pitch=-14;contact.head.pitch=5 end
  if def.mode=="backfist"then load[a]=arm(77,-55,123,70);drive[a]=arm(92,-22,78,10);contact[a].wroll=45 end
  if def.mode=="elbow"or def.mode=="spinelbow"then load[a]=arm(85,50,144,-30);drive[a]=arm(90,10,146,20)end
  if def.mode=="downelbow"then load[a]=arm(155,16,140,-12);drive[a]=arm(141,-8,146);contact.root.y=-.57;contact.root.pitch=20;contact.torso.pitch=16;contact.head.pitch=-15 end
 else
  -- Stable IK on support side; continuous FK on kicking side. Initial FK is
  -- converted from the exact guard IK to avoid a mode-switch pose pop.
  for _,p in {start,load,drive,contact,carry,recoil,finish}do fk(p,side)end
  load[l]={lift=if def.mode=="back"then 28 else 42,out=14,knee=119,twist=0,ankle=-12}
  drive[l]={lift=if def.mode=="axe"then 153 elseif def.mode=="back"then 68 else 78,out=if def.mode=="side"or def.mode=="spin"then 52 else 18,knee=if def.mode=="axe"then 16 else 108,twist=10,ankle=-12}
  contact[l]={lift=def.lift*v.reach,out=def.out,knee=def.knee,twist=if def.mode=="round"then 30 elseif def.mode=="side"then 65 else 0,ankle=if def.mode=="front"or def.mode=="back"then -15 else 8}
  contact.root.roll=sign*(if def.mode=="side"then 20 elseif def.mode=="round"then 16 else 5)
  contact[guard]=arm(72,22,122);contact[a]=arm(if def.category=="Knees"then 95 else 44,if def.category=="Knees"then 14 else 45,if def.category=="Knees"then 128 else 82)
  contact.root.y=if def.mode=="sweep"then -.98 elseif def.mode=="rising"then -.1 elseif def.mode=="jumpknee"then .8 else -.27
  if def.mode=="sweep"then load.root.y=-.75;drive.root.y=-.94;contact.torso.pitch=21;contact[a]=arm(60,55,55);contact[guard]=arm(90,10,126)end
  if def.mode=="back"then contact.root.pitch=38;contact.torso.pitch=10;contact.head.yaw=sign*65;contact[support].yaw=contact.root.yaw end
  if def.mode=="jumpknee"then
   -- Takeoff brace -&gt; both legs airborne -&gt; landing brace before recovery.
   fk(drive,other(side));drive[legKey(other(side))]={lift=18,out=6,knee=45,ankle=-20}
   fk(contact,other(side));contact[legKey(other(side))]={lift=-18,out=8,knee=90,ankle=-10};drive.root.y=.32
  end
 end
 -- Variant mechanics alter silhouettes, not just playback speed.
 if variantName=="Compact"then contact.torso.pitch+=5;contact.root.y-=.08;contact[guard].out=-4;load[a].out=5 end
 if variantName=="Heavy"then load.root.pitch=-8;drive.torso.pitch=4;contact.torso.pitch+=9;contact[guard].out=28 end
 if variantName=="Long"then contact.root.pitch+=12;contact[guard].raise-=12;contact[guard].out=25 end
 if variantName=="Rotational"then drive[guard].out=48;contact[guard].out=68;contact[guard].raise=48;load.root.y-=.13 end
 carry=M.copy(contact);carry.root.z-=.08*v.reach;carry.root.yaw+=sign*(if def.mode=="spin"or def.mode=="spinelbow"then 65 else def.hip*.18*v.turn);carry.torso.yaw+=sign*def.torso*.3;carry.head.yaw=math.clamp(-(carry.root.yaw+carry.torso.yaw),-75,75)
 if isLeg then
  carry[l].knee=if def.category=="Knees"then 140 else 32;carry[l].out+=if def.mode=="round"or def.mode=="sweep"then 18 else -4
  carry[l].lift+=if def.mode=="axe"then -46 else -9
  recoil[l]={lift=if def.mode=="sweep"then 22 else 55,out=12,knee=115,twist=0,ankle=-8};recoil.root.x=-sign*.12;recoil.root.z=-v.travel*.7;recoil.root.y=-.43
 else carry[a].out+=if def.mode=="hook"or def.mode=="elbow"then -24 else 10;carry[a].raise+=if def.mode=="upper"then 12 else -8;recoil[a]=arm(63,14,130)end
 -- End after the actual travelled step, rather than snapping root to origin.
 finish.root.z=-v.step;recoil.root.z=-math.max(v.step,v.travel*.65)
 if v.step&gt;0 then if finish.rf then finish.rf.z-=v.step end;if recoil.rf then recoil.rf.z-=v.step*.7 end end
 if isLeg then
  local endIK=B.guard(lead);endIK.root.z=finish.root.z;endIK.lf.z-=v.step;endIK.rf.z-=v.step;fk(endIK,side);finish[l]=endIK[l]
 end
 if def.mode=="spin"or def.mode=="spinelbow"then
  -- Unwrapped yaw through the turn; keep 360 at the end (same orientation).
  recoil.root.yaw=start.root.yaw+sign*340;finish.root.yaw=start.root.yaw+sign*360;recoil.head.yaw=-sign*12
  for _,p in {load,drive,contact,carry,recoil,finish}do
   p[support].yaw=p.root.yaw
   p.head.yaw=if p==finish then start.head.yaw else math.clamp(p.head.yaw,-70,70)
  end
 end
 if def.mode=="jumpknee"then for _,p in {start,load,recoil,finish}do if not p[legKey(other(side))]then fk(p,other(side))end end end
 local times={0,v.contact*.42,v.contact*.78,v.contact,v.follow,.85,1}
 local poses={start,load,drive,contact,carry,recoil,finish};local phases={"Start","Anticipation","HipDrive","Contact","FollowThrough","Rechamber","Recovery"};local keys={}
 for i,p in poses do table.insert(keys,key(times[i],p,if i==4 then "out"else "smooth",phases[i]))end
 return {duration=def.duration*v.duration,keys=keys,timing={startup=def.duration*v.duration*v.contact,active=def.duration*v.duration*(v.follow-v.contact),recovery=def.duration*v.duration*(1-v.follow)}}
end
local function asset(lib,id,name,category,family,side,variant,clip,metadata,legacy)
 local a={id=id,name=name,grammar=id,category=category,family=family,side=side,variantName=variant,attackingLimb=metadata.attackingLimb or "None",supportLimb=metadata.supportLimb or "BothFeet",stance=metadata.stance or "LeftLead",bodyMechanics=metadata.bodyMechanics or {"weight-transfer","target-aware","guard-recovery"},compatibleTransitions={},independentlyEditable=true,mirrorSource=false,sourceType="common-authored",tags={"Common",family,side,variant},compatibleBodyLayers=M.copy(M.Layers),defaultSpeed=1,duration=clip.duration,contactMarkers={{at=clip.timing.startup/clip.duration,name="contact"}},rootPolicy="presentation",styleTags={variant},authoredClip=clip,legacyAsset=legacy,metadata=metadata}
 a.metadata.variant=variant
 lib.assets[id]=a;table.insert(lib.assetOrder,id);return a
end
B.Movement={
 {id="idleneutral",name="Idle neutral",mode="idle",neutral=true,duration=2},
 {id="idlecombat",name="Idle combat",mode="idlecombat",neutral=true,duration=1.8},
 {id="walkforward",name="Walk forward",mode="gait",neutral=true,duration=1.2,travel=.8},
 {id="walkbackward",name="Walk backward",mode="gait",neutral=true,duration=1.35,travel=-.55},
 {id="runforward",name="Run forward",mode="gait",neutral=true,duration=.8,travel=1.8},
 {id="sprint",name="Sprint",mode="gait",neutral=true,duration=.65,travel=2.3},
 {id="strafe",name="Strafe",mode="lateral",duration=1.1,travel=.8},
 {id="lateralrun",name="Lateral run",mode="lateral",duration=.8,travel=1.5},
 {id="diagonal",name="Diagonal step",mode="diagonal",duration=1.15,travel=.85},
 {id="pivot",name="Pivot",mode="pivot",duration=.65},
 {id="stop",name="Stop / brace",mode="stop",duration=.6},
 {id="dodge",name="Short dodge",mode="dodge",duration=.56},
 {id="pursuit",name="Pursuit step",mode="pursuit",duration=.65},
 {id="recovery",name="Recovery step",mode="recovery",duration=.7},
 {id="step",name="Lateral step",mode="step",duration=.6},
 {id="sidecounter",name="Side counter",mode="counter",duration=.78},
 {id="wallexit",name="Wall exit",mode="wall",duration=.95},
 {id="launcher",name="Launcher drive",mode="launcher",duration=.8},
 {id="landing",name="Landing brace",mode="landing",duration=.65},
}
local function movement(def,side)
 local s=direction(side);local lead=if side=="Right"then "RightLead"else "LeftLead";local guard=B.guard(lead);local keys={};local duration=def.duration
 if def.mode=="gait"or def.mode=="lateral"or def.mode=="diagonal"then
  local lateral=def.mode~="gait";local travel=def.travel;local dx=if lateral then s*travel else 0;local dz=if def.mode=="lateral"then 0 else -travel
  local points={{0,0,0},{.125,.5,0},{.25,1,0},{.375,1,.5},{.5,1,1},{.625,1.5,1},{.75,2,1},{.875,2,1.5},{1,2,2}}
  -- Feet remain fixed during stance, then swing with clearance. Root advances
  -- one stride each half-cycle. Backward gait reverses travel, not knee lift.
  for _,q in points do local t,lp,rp=table.unpack(q);if lateral and side=="Right"then lp,rp=rp,lp end;local p=M.copy(guard)
   p.root.x=dx*t;p.root.z=dz*t;p.root.y=-.32-math.cos(t*math.pi*4)*.035
   p.root.pitch=if def.id=="sprint"then 22 elseif def.id=="runforward"then 13 elseif def.id=="walkbackward"then -4 else 5
   p.root.roll=if lateral then -s*math.sin(t*math.pi*2)*5 else math.sin(t*math.pi*2)*3
   p.root.yaw+=math.sin(t*math.pi*2)*(if lateral then 3 else 7);p.torso.yaw=-math.sin(t*math.pi*2)*(if lateral then 6 else 12)
   p.lf.x+=dx*lp*.5;p.rf.x+=dx*rp*.5;p.lf.z+=dz*lp*.5;p.rf.z+=dz*rp*.5
   p.lf.y=if t==.125 or t==.625 then .16 else 0;p.rf.y=if t==.375 or t==.875 then .16 else 0
   if lateral and side=="Right"then p.lf.y,p.rf.y=p.rf.y,p.lf.y end
   if not lateral then p.la=arm(20+math.sin(t*math.pi*2)*28,8,65);p.ra=arm(20-math.sin(t*math.pi*2)*28,8,65)
   else p.la=arm(61+math.sin(t*math.pi*2)*8,12,108);p.ra=arm(64-math.sin(t*math.pi*2)*8,12,117)end
   p.head.yaw=-(p.root.yaw+p.torso.yaw);table.insert(keys,key(t,p,"linear","Gait"))
  end
 elseif def.mode=="idle"or def.mode=="idlecombat"then
  for i=0,4 do local p=M.copy(guard);local t=i/4
   p.root.y+=math.sin(t*math.pi*2)*.02;p.root.x=math.sin(t*math.pi*2)*.03;p.torso.pitch+=math.sin(t*math.pi*2)*1.4;p.head.pitch=-p.torso.pitch
   if def.mode=="idle"then p.la=arm(7,3,16);p.ra=arm(9,3,20);p.root.yaw=0;p.torso.yaw=0;p.head.yaw=0 else p.la.raise+=math.sin(t*math.pi*2)*2;p.ra.elbow+=math.sin(t*math.pi*2)*3 end
   table.insert(keys,key(t,p,"smooth","Breath"))
  end
 else
  local start=M.copy(guard);local load=M.copy(guard);local drive=M.copy(guard);local contact=M.copy(guard);local recovery=M.copy(guard)
  load.root.y-=.1;load.root.x=-s*.12;load.head.yaw=0
  drive.root.x=s*.3;drive.root.y-=.2;drive[footKey(side)].x+=s*.4;drive[footKey(side)].y=.12
  contact.root.x=s*.65;contact[footKey(side)].x+=s*.55;recovery.root.x=s*.65;recovery.lf.x+=s*.65;recovery.rf.x+=s*.65
  if def.mode=="pivot"then
   for i,p in {load,drive,contact,recovery}do p.root.yaw=guard.root.yaw+s*({-8,25,55,55})[i];p.torso.yaw=-s*({0,12,18,8})[i];p.lf.yaw=p.root.yaw;p.rf.yaw=p.root.yaw;p.head.yaw=-(p.root.yaw+p.torso.yaw)end
  elseif def.mode=="stop"then
   start.root.z=-.2;start.root.pitch=15;load.root.z=-.35;drive.root.z=-.42;contact.root.z=-.48;recovery.root.z=-.48
   drive.root.pitch=-10;contact.root.pitch=-5;contact.root.y=-.57;contact[footKey(side)].z-=.55;recovery.lf.z-=.48;recovery.rf.z-=.48
  elseif def.mode=="dodge"or def.mode=="counter"then
   drive.root.roll=-s*15;drive.torso.roll=s*6;drive.root.y=-.75;contact.root.y=-.58;contact.root.x=s*.9;contact.root.roll=-s*7;recovery.root.x=s*.9;recovery.lf.x+=s*.25;recovery.rf.x+=s*.25
   if def.mode=="counter"then contact[armKey(other(side))]=arm(96,-14,12,20);contact.root.yaw+=s*35;contact.torso.yaw+=s*20;contact.head.yaw=-(contact.root.yaw+contact.torso.yaw)end
  elseif def.mode=="pursuit"or def.mode=="recovery"then
   local z=if def.mode=="pursuit"then -1 else .6
   drive.root.z=z*.45;drive.root.pitch=if z&lt;0 then 18 else -6;drive[footKey(side)].z+=z*.65
   contact.root.z=z;contact.lf.z+=z;contact.rf.z+=z*.6;recovery.root.z=z;recovery.lf.z+=z;recovery.rf.z+=z
  elseif def.mode=="wall"then
   start.root.y=.8;start.root.roll=s*42;fk(start,side);start[legKey(side)]={lift=55,out=25,knee=110,ankle=-15}
   load.root.y=1;drive.root.y=1.25;contact.root.y=.65;drive.root.x=s*.8;contact.root.x=s*1.1;recovery.root.x=s*1.1;recovery.lf.x+=s*.45;recovery.rf.x+=s*.45
   for _,p in {load,drive,contact}do fk(p,"Left");fk(p,"Right");p.ll={lift=35,out=15,knee=95,ankle=-10};p.rl={lift=55,out=15,knee=110,ankle=-10}end
  elseif def.mode=="launcher"then
   load.root.y=-.68;load[armKey(side)]=arm(15,8,118);drive.root.y=-.47;drive.root.z=-.2;contact.root.y=.05;contact.root.z=-.35;contact[armKey(side)]=arm(151,-12,42,20);contact.torso.pitch=-14;recovery.root.z=-.35;recovery.lf.z-=.35;recovery.rf.z-=.35
  elseif def.mode=="landing"then
   start.root.y=.55;start.root.pitch=8;load.root.y=-.68;drive.root.y=-.75;contact.root.y=-.52;load.ra=arm(60,42,80);load.la=arm(60,42,80);contact.root.x=s*.2;recovery.root.x=s*.2;recovery.lf.x+=s*.2;recovery.rf.x+=s*.2
  end
  -- Use one representation throughout wall/air intervals; convert planted
  -- endpoints to exact FK before interpolation, not at the first airborne key.
  if def.mode=="wall"then for _,p in {start,recovery}do for _,limb in {"Left","Right"}do if not p[legKey(limb)]then fk(p,limb)end end end end
  keys={key(0,start,"smooth","Start"),key(.18,load,"smooth","Anticipation"),key(.34,drive,"out","HipDrive"),key(.5,contact,"smooth","Contact"),key(1,recovery,"smooth","Recovery")}
 end
 return {duration=duration,keys=keys,timing={startup=duration*.5,active=duration*.2,recovery=duration*.3}}
end
B.Routes={
 {id="jab_cross",name="Jab → cross",from="jab",to="cross"},
 {id="jab_hook",name="Jab → hook",from="jab",to="hook"},
 {id="cross_kick",name="Cross → front kick",from="cross",to="frontkick"},
 {id="punch_knee",name="Punch → knee",from="cross",to="frontknee"},
 {id="kick_punch",name="Kick → punch",from="roundhouse",to="cross"},
 {id="kick_knee",name="Kick → knee",from="frontkick",to="frontknee"},
 {id="sweep_follow",name="Sweep → palm",from="sweep",to="palm"},
 {id="dodge_counter",name="Dodge → counter",from="dodge",to="sidecounter",sameSide=true},
 {id="pivot_strike",name="Pivot → strike",from="pivot",to="cross",sameSide=true},
 {id="launcher_pursue",name="Launcher → aerial pursuit",from="launcher",to="pursuit",sameSide=true,air=true},
 {id="landing_attack",name="Landing → jab",from="landing",to="jab",sameSide=true},
 {id="attack_guard",name="Attack → guard recovery",from="hook",to="recovery",sameSide=true},
}
local function recenter(p)
 local dx=p.root.x or 0;local dz=p.root.z or 0;p.root.x=0;p.root.z=0
 for _,f in {"rf","lf"}do if p[f]then p[f].x=(p[f].x or 0)-dx;p[f].z=(p[f].z or 0)-dz end end
 return p
end
function B.populate(lib)
 for _,def in B.Strikes do for _,variant in def.variants do for _,side in {"Left","Right"}do
  local suffix=if side=="Left"then "L"else "R";local id="common_"..def.id.."_"..suffix.."_"..variant
  local leg=def.category=="Kicks"or def.category=="Knees"
  local a=asset(lib,id,def.name.." · "..suffix.." · "..variant,def.category,def.name,side,variant,B.strike(def,side,variant),{attackingLimb=side..(if leg then "Leg"else "Arm"),supportLimb=other(side).."Foot",stance="LeftLead",bodyMechanics={"load-support","hip-before-torso","shoulder-drive","target-head","active-guard","re-chamber","independent-side"},supportPolicy=if def.mode=="jumpknee"then "brace → airborne → landing"else "planted IK / pivot",centerShift=if leg then "over support foot"else "rear load → front brace",variantMechanic=variant,stanceSwitch=false},def.old)
  a.counterpart="common_"..def.id.."_"..(if side=="Left"then "R"else "L").."_"..variant
 end end end
 for _,def in B.Movement do for _,side in (if def.neutral then {"Neutral"}else {"Left","Right"})do
  local suffix=if side=="Left"then "L"elseif side=="Right"then "R"else "N";local id="common_"..def.id.."_"..suffix.."_Standard"
  local category=if def.mode=="dodge"then "Dodges"elseif def.mode=="counter"then "Counters"elseif def.mode=="wall"then "Wall"elseif def.mode=="launcher"then "Launchers"elseif def.mode=="landing"then "Transitions"else "Locomotion"
  local old=if def.id=="walkforward"or def.id=="walkbackward"then "walk"elseif def.id=="runforward"or def.id=="lateralrun"then "run"elseif def.id=="idleneutral"or def.id=="idlecombat"then "idle"elseif def.id=="pivot"then "turn"elseif def.id=="landing"then "land"elseif def.id=="pursuit"then "pursue"elseif def.id=="wallexit"then "wallentry"else def.id
  local a=asset(lib,id,def.name.." · "..suffix,category,def.name,side,"Standard",movement(def,side),{stance=if side=="Right"then "RightLead"else "LeftLead",supportLimb="AlternatingFeet",bodyMechanics={"stance-swing","target-aware","foot-clearance","counterbalance"},loopDisplacement=def.travel~=nil,stanceSwitch=false},if lib.assets[old]then old else "dash")
  if side~="Neutral"then a.counterpart="common_"..def.id.."_"..(if side=="Left"then "R"else "L").."_Standard"end
 end end
 for _,route in B.Routes do for _,side in {"Left","Right"}do
  local suffix=if side=="Left"then "L"else "R";local targetSide=if route.sameSide then side else other(side);local targetSuffix=if targetSide=="Left"then "L"else "R"
  local from=lib.assets["common_"..route.from.."_"..suffix.."_Standard"];local to=lib.assets["common_"..route.to.."_"..targetSuffix.."_Standard"]
  local start=recenter(M.copy(from.authoredClip.keys[5].pose));local finish=M.copy(to.authoredClip.keys[2].pose);local middle=B.guard(to.stance)
  -- Keep exit mechanics, retract the striking limb, settle weight, then load
  -- the new limb. Changing FK/IK uses exact equivalent poses at both ends.
  middle.root.y=if route.air then .8 elseif route.from=="sweep"then -.6 else -.43;middle.root.z=-.12;finish.root.z-=.12;if finish.lf then finish.lf.z-=.12 end;if finish.rf then finish.rf.z-=.12 end
  if route.air then finish.root.y=.85;for _,p in {middle,finish}do fk(p,"Left");fk(p,"Right");p.ll={lift=48,out=8,knee=90,ankle=-10};p.rl={lift=32,out=8,knee=102,ankle=-10}end end
  for _,limb in {"Left","Right"}do if start[legKey(limb)]or finish[legKey(limb)]then for _,p in {start,middle,finish}do if not p[legKey(limb)]then fk(p,limb)end end end end
  local clip={duration=if route.air then .56 else .38,keys={key(0,start,"smooth","Start"),key(.5,middle,"smooth","WeightTransfer"),key(1,finish,"smooth","Recovery")},timing={startup=.16,active=.08,recovery=if route.air then .32 else .14}}
  local id="common_transition_"..route.id.."_"..suffix
  local a=asset(lib,id,route.name.." · "..suffix,"Transitions",route.name,side,"Bridge",clip,{stance=from.stance,attackingLimb=to.attackingLimb,supportLimb=to.supportLimb,fromAsset=from.id,toAsset=to.id,entryPhase="FollowThrough",exitPhase="Anticipation",entryRoot="recenter outgoing travel",stanceSwitch=from.stance~=to.stance,exitStance=to.stance,bodyMechanics={"re-chamber","transfer-support","continuous-leg-mode","explicit-stance"}},"land")
  a.counterpart="common_transition_"..route.id.."_"..(if side=="Left"then "R"else "L")
  table.insert(from.compatibleTransitions,id);table.insert(to.compatibleTransitions,id)
 end end
end
return B
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="FML5">
        <Properties>
          <string name="Name">Controller</string>
          <ProtectedString name="Source">local M=require(script.Parent.Model)
local Library=require(script.Parent.Library)
local Adapter=require(script.Parent.NinjaDuelAdapter)
local Store=require(script.Parent.Store)
local Edit=require(script.Parent.MotionEdit)
local Sampler=require(script.Parent.Sampler)
local C={};C.__index=C
function C.create(plugin)
 local lib=Library.new();Adapter.import(require(script.Parent.NinjaSources),lib)
 local self=setmetatable({library=lib,store=Store.new(plugin,lib),history={},future={},counter=0,dirty=false,clip="run",tab="Characters",playing=true,loop=true,speed=1,time=0,sequenceMode=false,mirror=false,compare=nil,selectedBlock=1},C)
 self.preset=M.copy(lib.presets.Flashstep);self.preset.id=self:newId();self.preset.name="Minato × Itachi"
 for _,layer in {"Torso","LeftArm","RightArm"} do self.preset.bodyLayers[layer].source="Mirage" end;self.preset.bodyLayers.Head.source="GentleFist"
 self.preset.sequences={{id="sequence1",name="Opening phrase",orderedClips={}}};self.dirty=true
 return self
end
function C:newId() self.counter+=1;return "custom_"..game:GetService("HttpService"):GenerateGUID(false):gsub("%-","") end
function C:checkpoint() table.insert(self.history,M.copy(self.preset));if #self.history&gt;40 then table.remove(self.history,1) end;self.future={} end
function C:edit(fn,record) if record~=false then self:checkpoint() end;fn(self.preset);self.dirty=true;self.time=0 end
function C:repairSelection() if not self:asset() then self.clip="run";self.selectedKey=nil end end
function C:undo()
 if #self.history==0 then return end;table.insert(self.future,M.copy(self.preset));self.preset=table.remove(self.history);self.dirty=true;self.time=0;self:repairSelection()
end
function C:redo()
 if #self.future==0 then return end;table.insert(self.history,M.copy(self.preset));self.preset=table.remove(self.future);self.dirty=true;self.time=0;self:repairSelection()
end
function C:load(id)
 self:checkpoint();self.preset=M.copy(assert(self.library.presets[id],"Missing profile"));self.clip="run";self.sequenceMode=false;self.selectedKey=nil;if not self.store.custom[id] then self.preset.id=self:newId();self.preset.name=self.preset.name.." study" end
 if #self.preset.sequences==0 then self.preset.sequences={{id="sequence1",name="Opening phrase",orderedClips={}}} end;self.dirty=self.store.custom[id]==nil;self.time=0
end
function C:new(template)
 self.clip="run";self.sequenceMode=false;self.selectedKey=nil
 self:checkpoint();self.preset=if template then M.copy(self.library.presets[template]) else M.new("new","Untitled motion")
 self.preset.id=self:newId();self.preset.name=if template then self.preset.name.." study" else "Untitled motion";self.preset=Library.propose(self.preset);self.dirty=true;self.time=0
end
function C:duplicate() self:checkpoint();self.preset.id=self:newId();self.preset.name=self.preset.name.." copy";self.dirty=true end
function C:generate() self:edit(function(p) local generated=Library.propose(p);p.locomotionSet=generated.locomotionSet;p.sequences=generated.sequences;p.metadata.generated=true end) end
function C:sequence() return self.preset.sequences[1] end
function C:addClip(id)
 local asset=assert(Edit.asset(self.preset,id,self.library),"Unknown block");assert(#self:sequence().orderedClips&lt;24,"Maximum 24 blocks")
 self:edit(function(p)table.insert(p.sequences[1].orderedClips,{asset=id,duration=math.clamp(asset.duration,.12,5),blend=.1,transition="blend"})end);self.selectedBlock=#self:sequence().orderedClips;self.sequenceMode=true
end
function C:asset(id) return Edit.asset(self.preset,id or self.clip,self.library) end
function C:variant() return Edit.variant(self.preset,self:asset()) end
function C:createVariant()
 local source=self:asset();assert(not source.variant or source.referenceBacked,"Select a source motion to create a variant")
 self.sequenceMode=false;self:pinCompare();local id=self:newId();local clip=source.authoredClip or self.preset.clips[source.grammar];local duration=Sampler.duration(self.preset,source,self.library)
 local contact,recovery=.42,.7;if clip and clip.timing then contact=clip.timing.startup/clip.duration;recovery=(clip.timing.startup+clip.timing.active)/clip.duration end
 self:edit(function(p)
  p.motionVariants=p.motionVariants or {};local v=if source.referenceBacked then M.copy(assert(self:variant()))else Edit.create(id,source.name.."_A",source,duration,contact,recovery);v.id=id;v.name=source.name.."_A"
  if source.authoredClip and not source.referenceBacked then
   for _,key in source.authoredClip.keys do if key.phase=="Anticipation"then v.poseOverrides[2].time=key.at;v.poseOverrides[2].sourceTime=key.at end end
  end
  p.motionVariants[id]=v
 end)
 self.clip=id;self.sequenceMode=false;self.selectedKey="Contact";self.selectedPart=if source.attackingLimb=="LeftArm"then "LeftArm"elseif source.attackingLimb=="LeftLeg"then "LeftLeg"elseif source.attackingLimb=="RightLeg"then "RightLeg"else "RightArm";self.playing=false;self.time=Edit.phase(self:variant(),"Contact").time*duration
 return id
end
function C:switchSide()
 local source=self:asset();assert(source.counterpart and self.library.assets[source.counterpart],"No opposite-side asset")
 self.clip=source.counterpart;self.sequenceMode=false;self.time=0;self.mirror=false;self.selectedKey=nil
end
function C:compareLegacy()
 local source=self:asset();assert(source.legacyAsset and self.library.assets[source.legacyAsset],"No legacy comparison")
 local selected=self.clip;self.clip=source.legacyAsset;self:pinCompare();self.clip=selected;self.sequenceMode=false;self.time=0;self.mirror=false
end
function C:variantEdit(fn,record)
 assert(self:variant(),"Create a variant before editing")
 local template=M.copy(self:variant());local at=self.time
 self:edit(function(p)p.motionVariants=p.motionVariants or {};p.motionVariants[self.clip]=p.motionVariants[self.clip]or template;fn(p.motionVariants[self.clip])end,record);self.time=at
end
function C:selectKey(id,part)
 local v=assert(self:variant(),"Select a variant");local key=assert(Edit.key(v,id),"Missing key")
 self.selectedKey=id;self.selectedPart=part or self.selectedPart or "Root";self.playing=false;self.sequenceMode=false;self.time=key.time*Sampler.duration(self.preset,self:asset(),self.library)
end
function C:setPose(field,value,record)
 local part=self.selectedPart or "Root";local control=nil;for _,row in Edit.Controls[part] or {} do if row[1]==field then control=row end end;assert(control and M.finite(value) and value&gt;=control[3] and value&lt;=control[4],"Invalid pose value");local v=assert(self:variant());assert(not(v.channels[part] and v.channels[part].locked),"Channel is locked")
 self:variantEdit(function(variant)local key=assert(Edit.key(variant,self.selectedKey));key.parts[part]=key.parts[part] or {};key.parts[part][field]=value end,record)
end
function C:assignVariant(slot)
 local variant=assert(self:variant(),"Select a variant");self:edit(function(p)p.locomotionSet[slot or variant.sourceAsset]=self.clip end)
end
function C:save()
 if self:asset().variantDefinition and not(self.preset.motionVariants and self.preset.motionVariants[self.clip])then self:variantEdit(function()end)end
 self.store:save(self.preset);self.dirty=false
end
function C:pinCompare() self.compare=M.copy(self.preset);self.compareLibrary={presets=M.copy(self.library.presets),assets=self.library.assets};self.compareSequenceMode=self.sequenceMode;self.compareClip=self.clip end
function C:export(parent)
 local bundle=Adapter.bundle(self.preset,self.library,self.clip);local payload=Adapter.serialize(bundle);assert(#payload&lt;=2000000,"Export too large")
 local history=game:GetService("ChangeHistoryService");local recording=history:TryBeginRecording("ForgeMotionLabExport","Export Motion Lab profile")
 assert(recording,"Finish the current Studio operation first")
 local module
 local ok,result=pcall(function()
  local folder=parent:FindFirstChild("ForgeMotionLabExports");if not folder then folder=Instance.new("Folder");folder.Name="ForgeMotionLabExports";folder.Parent=parent end
  assert(folder:IsA("Folder"),"ForgeMotionLabExports name occupied by another instance")
  module=Adapter.export(self.preset,self.library,folder,bundle)
  local json=Instance.new("StringValue");json.Name="MotionLabJSON";json.Value=payload;json.Parent=module
  module:SetAttribute("ForgeMotionLabFormat",Adapter.Format);return module
 end)
 history:FinishRecording(recording,if ok then Enum.FinishRecordingOperation.Commit else Enum.FinishRecordingOperation.Cancel)
 assert(ok,result);return result
end
function C:import(instance)
 local p,sources=Adapter.read(instance,self.library)
 -- Always remap imported snapshots: no bundled/live source is overwritten.
 local ids={};for id in sources do ids[id]=self:newId() end
 local function remap(profile)
  for _,layer in profile.bodyLayers do if ids[layer.source] then layer.source=ids[layer.source] end end
 end
 remap(p)
 for oldId,source in sources do source.id=ids[oldId];remap(source);source.metadata.imported=true;self.library.presets[source.id]=source;table.insert(self.library.order,source.id) end
 self:checkpoint();p.id=self:newId();self.preset=p;self.clip="run";self.selectedKey=nil;self.sequenceMode=false;self.dirty=true;self.time=0
end
return C
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="FML6">
        <Properties>
          <string name="Name">EditInspector</string>
          <ProtectedString name="Source">local E=require(script.Parent.MotionEdit)
local S=require(script.Parent.Sampler)
local Panel={}
function Panel.mount(u,scroll,c,tab,action,state,menu)
 local v=c:variant();local asset=c:asset()
 local function heading(text,y)u:label(scroll,text,{Position=UDim2.fromOffset(0,y),Size=UDim2.new(1,-4,0,24),Font=Enum.Font.BuilderSansBold,TextSize=14})end
 if not v then
  heading("Create a motion variant",0)
  u:label(scroll,(if asset.authoredClip then asset.side.." · Attack: "..asset.attackingLimb.."\nBrace: "..asset.supportLimb.." · "..asset.stance.."\nCreate an editable copy; source stays intact."else "Keep the original intact. Add pose corrections, timing and travel to a named variant."),{Position=UDim2.fromOffset(0,30),Size=UDim2.new(1,-4,0,66),TextWrapped=true,TextSize=12},"muted")
  u:button(scroll,"Create Variant",{Position=UDim2.fromOffset(0,108),Size=UDim2.new(1,-4,0,32)},function()action(function()c:createVariant()end,"Variant created · source pinned as A")end,true)
  return
 end
 u:input(scroll,v.name,{Name="VariantName",Size=UDim2.new(1,-4,0,28)},function(text)action(function()assert(#text&gt;0 and #text&lt;=80,"Name: 1–80 characters");c:variantEdit(function(x)x.name=text end)end,"Variant renamed")end)
 local source=u:label(scroll,(if asset.authoredClip then asset.attackingLimb.." · brace "..asset.supportLimb else "Source · "..c.library.assets[v.sourceAsset].name),{Position=UDim2.fromOffset(0,32),Size=UDim2.new(1,-4,0,20),TextSize=11},"muted")
 u:tip(source,c.library.assets[v.sourceAsset].name.." · "..(asset.attackingLimb or "Mixed body").." / support "..(asset.supportLimb or "profile").." · "..(asset.stance or "profile"))
 if tab=="Pose" then
  local key=E.key(v,c.selectedKey or "Contact");if not key then c.selectedKey="Contact";key=E.key(v,"Contact")end
  local part=c.selectedPart or "RightArm";c.selectedPart=part
  local select=u:button(scroll,(key.semantic or key.id).." ▾",{Position=UDim2.fromOffset(0,60),Size=UDim2.new(.55,-4,0,26)})
  u:connect(select.Activated,function()local items={};for _,k in v.poseOverrides do table.insert(items,{id=k.id,name=(k.semantic or k.id)..string.format("  %.3fs",k.time*S.duration(c.preset,c:asset(),c.library))})end;menu(select,items,function(id)action(function()c:selectKey(id)end)end)end)
  local partButton=u:button(scroll,part.." ▾",{Position=UDim2.new(.55,2,0,60),Size=UDim2.new(.45,-6,0,26)})
  u:connect(partButton.Activated,function()local choices={};for _,name in E.Parts do table.insert(choices,{id=name,name=name})end;menu(partButton,choices,function(id)action(function()c:selectKey(key.id,id)end)end)end)
  heading("Pose deltas · "..part,98)
  u:label(scroll,"Degrees / studs relative to the mixed base.",{Position=UDim2.fromOffset(0,122),Size=UDim2.new(1,-4,0,20),TextSize=11},"muted")
  local controls=E.Controls[part];local y=148;local controlRows={}
  for _,row in controls do
   local value=(key.parts[part] or {})[row[1]] or 0
   controlRows[row[1]]=u:slider(scroll,row[2],row[3],row[4],value,y,function(n)local ok,err=pcall(function()c:setPose(row[1],n,false)end);state(ok and nil or tostring(err))end,function()c:checkpoint()end)
   y+=46
  end
  heading("Fine nudge",y+4)
  local selectedField=controls[1][1];local fieldButton=u:button(scroll,controls[1][2].." ▾",{Position=UDim2.fromOffset(0,y+34),Size=UDim2.new(1,-86,0,26)})
  u:connect(fieldButton.Activated,function()local choices={};for _,row in controls do table.insert(choices,{id=row[1],name=row[2]})end;menu(fieldButton,choices,function(id)selectedField=id;fieldButton.Text=id.." ▾"end)end)
  local function nudge(sign,quiet)
   local function apply()
    local current=E.key(c:variant(),c.selectedKey);local value=(current.parts[part] or {})[selectedField] or 0;local control
    for _,row in controls do if row[1]==selectedField then control=row end end
    c:setPose(selectedField,math.clamp(value+sign*(if table.find({"x","y","z"},selectedField)then .05 else 1),control[3],control[4]))
   end
   if quiet then local ok,err=pcall(apply);state(ok and nil or tostring(err));if ok then
    local current=E.key(c:variant(),c.selectedKey);local field=controlRows[selectedField]:FindFirstChildWhichIsA("TextBox");field.Text=string.format("%.2f",current.parts[part][selectedField])
   end else action(apply)end
  end
  u:button(scroll,"−",{Position=UDim2.new(1,-78,0,y+34),Size=UDim2.fromOffset(34,26)},function()nudge(-1)end)
  u:button(scroll,"+",{Position=UDim2.new(1,-38,0,y+34),Size=UDim2.fromOffset(34,26)},function()nudge(1)end)
  -- Keyboard nudges are scoped to this focused editor; they never bind gameplay keys.
  local keyboard=u:input(scroll,"",{Name="NudgeKeys",Position=UDim2.fromOffset(0,y+68),Size=UDim2.new(1,-4,0,26),PlaceholderText="Focus here: ↑ / ↓ to nudge"})
  u:connect(keyboard.InputBegan,function(input)if input.KeyCode==Enum.KeyCode.Up then nudge(1,true)elseif input.KeyCode==Enum.KeyCode.Down then nudge(-1,true)end end)
  u:button(scroll,"Reset this part",{Position=UDim2.fromOffset(0,y+104),Size=UDim2.new(1,-4,0,28)},function()action(function()c:variantEdit(function(x)local k=E.key(x,c.selectedKey);assert(not(x.channels[part] and x.channels[part].locked),"Channel locked");k.parts[part]=nil end)end,"Pose corrections reset")end)
  u:label(scroll,"Leg edits use FK; foot edits use planted-foot IK. Hips share the anatomical root rotation.",{Position=UDim2.fromOffset(0,y+140),Size=UDim2.new(1,-4,0,58),TextWrapped=true,TextSize=11},"muted")
 else
  u:button(scroll,v.enabled and "Edits enabled ✓" or "Edits bypassed",{Position=UDim2.fromOffset(0,60),Size=UDim2.new(.6,-4,0,26)},function()action(function()c:variantEdit(function(x)x.enabled=not x.enabled end)end)end,v.enabled)
  u:button(scroll,"Assign",{Position=UDim2.new(.6,4,0,60),Size=UDim2.new(.4,-8,0,26)},function()action(function()c:assignVariant()end,"Assigned to source slot in this profile")end)
  heading("Timing",98)
  local function number(label,value,y,fn)
   u:label(scroll,label,{Position=UDim2.fromOffset(0,y),Size=UDim2.new(1,-90,0,26),TextSize=12})
   u:input(scroll,string.format("%.3f",value),{Name="Timing_"..label,Position=UDim2.new(1,-86,0,y),Size=UDim2.fromOffset(82,26)},function(text)action(function()local n=tonumber(text);assert(n and n==n,"Enter a finite number");fn(n)end)end)
  end
  number("Duration (s)",v.timing.duration,126,function(n)assert(n&gt;=.12 and n&lt;=30,"Duration: 0.12–30s");c:variantEdit(function(x)x.timing.duration=n end)end)
    local y=160
  local phases=if v.phaseSchema=="combat-six"then {"Anticipation","Acceleration","Contact","FollowThrough"}else {"Anticipation","Contact","FollowThrough"}
  for _,phase in phases do local marker=E.phase(v,phase);local label=if phase=="FollowThrough"and v.phaseSchema~="combat-six"then "Recovery start"else phase
   number(label.." (s)",marker.time*v.timing.duration,y,function(n)c:variantEdit(function(x)local current=E.key(x,marker.id);E.moveKeys(x,{[marker.id]=true},n/x.timing.duration-current.time)end);c:selectKey(marker.id)end);y+=32
  end
  number("Contact hold (norm)",v.timing.hold,y+2,function(n)assert(n&gt;=0 and n&lt;=.3,"Hold: 0–0.3 normalized");c:variantEdit(function(x)x.timing.hold=n end)end)
  number("Playback speed",v.timing.playbackSpeed,y+34,function(n)assert(n&gt;=.25 and n&lt;=3,"Speed: 0.25–3");c:variantEdit(function(x)x.timing.playbackSpeed=n end)end)
  local ease=u:button(scroll,"Easing · "..v.timing.easing.." ▾",{Position=UDim2.fromOffset(0,y+68),Size=UDim2.new(1,-4,0,26)})
  u:connect(ease.Activated,function()local choices={};for _,name in E.Easing do table.insert(choices,{id=name,name=name})end;menu(ease,choices,function(id)action(function()c:variantEdit(function(x)x.timing.easing=id end)end)end)end)
  heading("Exaggerate · whole motion",y+110)
  y+=140
  for _,row in E.Modifiers do u:slider(scroll,row[2],0,3,v.motionModifiers[row[1]],y,function(n)c:variantEdit(function(x)x.motionModifiers[row[1]]=n end,false);state()end,function()c:checkpoint()end);y+=46 end
  heading("Root trajectory",y+8);y+=38
  for _,row in {{"forward","Forward travel",-10,10},{"lateral","Lateral travel",-10,10},{"lift","Vertical lift",-10,10},{"turn","Turn / yaw",-360,360},{"startX","Start X",-10,10},{"startY","Start Y",-10,10},{"startZ","Start Z",-10,10},{"endX","End X",-10,10},{"endY","End Y",-10,10},{"endZ","End Z",-10,10}}do
   u:slider(scroll,row[2],row[3],row[4],v.rootPath[row[1]],y,function(n)c:variantEdit(function(x)x.rootPath[row[1]]=n end,false);state()end,function()c:checkpoint()end);y+=46
  end
 end
end
return Panel
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="FML7">
        <Properties>
          <string name="Name">Library</string>
          <ProtectedString name="Source">local M=require(script.Parent.Model)
local B=require(script.Parent.BilateralLibrary)
local Reference=require(script.Parent.ReferenceMotionLibrary)
local L={}
L.Families={"Locomotion","Punches","Kicks","Knees","Elbows","Launchers","Dodges","Counters","Reactions","Transitions","Aerial","Wall","Grabs","Projectiles"}
L.Blocks={
 {"idle","Idle","Locomotion","Idle",1.5},{"walk","Walk","Locomotion","Walk",1.1},{"run","Run","Locomotion","Run",.8},{"sprint","Sprint","Locomotion","Sprint",.65},{"strafe","Strafe","Locomotion","Strafe",1},{"turn","Pivot","Locomotion","Pivot",.6},{"jump","Jump","Aerial","Jump",.8},{"land","Land","Transitions","Land",.5},{"dash","Dash","Dodges","Dash",.4},{"dashattack","Dash attack","Punches","DashAttack",.6},
 {"jab","Jab","Punches","Light1",.5},{"cross","Cross","Punches","Light2",.55},{"hook","Hook","Punches","Hook",.6},{"uppercut","Uppercut","Punches","Uppercut",.6},{"palm","Palm","Punches","PalmThrust",.6},
 {"frontkick","Front kick","Kicks","FrontKick",.65},{"sidekick","Side kick","Kicks","SideKick",.7},{"roundhouse","Roundhouse","Kicks","Roundhouse",.8},{"spinkick","Spin kick","Kicks","Light3",.85},{"sweep","Sweep","Kicks","Sweep",.7},
 {"knee","Knee","Knees","KneeStrike",.6},{"risingknee","Rising knee","Knees","RisingKnee",.65},{"elbow","Elbow","Elbows","Elbow",.6},{"spinelbow","Spinning elbow","Elbows","SpinElbow",.7},
 {"launcher","Launcher","Launchers","Launcher",.7},{"dodge","Dodge","Dodges","Dodge",.6},{"counter","Counter palm","Counters","CounterPalm",.6},{"hit","Light hit","Reactions","Hit",.6},{"stagger","Stagger","Reactions","Stagger",.9},{"knockdown","Knockdown","Reactions","Knockdown",1.1},
 {"pursue","Pursuit","Transitions","Pursue",.6},{"air1","Air strike 1","Aerial","Air1",.55},{"air2","Air strike 2","Aerial","Air2",.6},{"slam","Slam","Aerial","Slam",.75},{"wallrun","Wall run","Wall","WallRun",1},{"wallentry","Wall re-entry","Wall","WallDive",.8},{"grab","Grab","Grabs","Grab",.8},{"throw","Weapon throw","Projectiles","ToolThrow",.65},
}
L.Templates={
 {id="lee",name="Lee",note="Lower-body drive / physical pursuit",dna={cadence=1.65,stepLength=1.4,lowerActivity=1.5,upperActivity=1.2,aggression=.95,forwardPressure=.9,acrobatics=.8,groundedness=.8},rules={preferredGrammar={Pursue="physical",Strike="taijutsu"},grammarOverrides={Pursue={rootTravel=1,bodyScale=1.2},Air1={bodyScale=1.3}}},stance={root={y=-.4,pitch=14},torso={pitch=8},ra={raise=60,elbow=110},la={raise=65,elbow=100}}},
 {id="gaara",name="Gaara",note="Calm body / sand conversion proposals",dna={cadence=.6,amplitude=.35,upperActivity=.3,lowerActivity=.3,rootIntensity=.3,looseness=.2,apparentWeight=.85,groundedness=.95,acrobatics=.1,guardOpenness=.85},rules={preferredGrammar={Launcher="sand-lift",Pursue="sand-carry",Strike="sand-pressure"},grammarOverrides={Launcher={bodyScale=.15,rootTravel=.05},Pursue={bodyScale=.2,rootLift=.25},Slam={bodyScale=.2}}},stance={root={y=-.12,pitch=0},torso={pitch=0},ra={raise=12,elbow=30},la={raise=12,elbow=30}}},
 {id="bee",name="Killer Bee",note="Asymmetric stance / irregular axes",dna={asymmetry=.65,cadence=1.15,amplitude=1.25,lateralBias=.35,rotationAmount=1.4,hipInvolvement=1.35,looseness=.85,acrobatics=.75,precision=.5},rules={preferredGrammar={Strike="multi-axis",Projectile="multi-weapon"},grammarOverrides={Hook={bodyScale=1.25,lateralTravel=.3},CounterPalm={bodyScale=1.1,lateralTravel=-.3}}},stance={root={y=-.45,roll=10,yaw=25},torso={roll=-12,yaw=-18},ra={raise=85,out=35,elbow=80},la={raise=25,out=40,elbow=120}}},
 {id="shisui",name="Shisui",note="Burst cadence / lateral transitions",dna={cadence=1.8,strideFrequency=1.5,lateralBias=.6,recoverySpeed=1.65,apparentWeight=.2,rotationAmount=1.2,precision=.9,rootIntensity=1.2,acrobatics=.75},rules={preferredGrammar={Transition="burst-step",Dodge="lateral-burst"},grammarOverrides={Dodge={lateralTravel=.8,rootTravel=.4},Pursue={rootTravel=.6,lateralTravel=.5}}},stance={root={y=-.38,pitch=12,yaw=-18},torso={pitch=7,yaw=8},ra={raise=45,elbow=100},la={raise=60,elbow=90}}},
}
function L.new()
 local lib={presets={},assets={},order={},assetOrder={}}
 for _,b in L.Blocks do
  lib.assets[b[1]]={id=b[1],name=b[2],category=b[3],grammar=b[4],tags={b[3]},compatibleBodyLayers=M.copy(M.Layers),defaultSpeed=1,duration=b[5],contactMarkers={{at=.38,name="contact"}},rootPolicy="presentation",styleTags={},sourceType="procedural",proceduralDefinition={kind=b[4]}}
  table.insert(lib.assetOrder,b[1])
 end
 for _,template in L.Templates do
  local p=M.new(template.id,template.name);for k,v in template.dna do p.motionDNA[k]=v end
  p.stance=M.copy(template.stance);p.stance.weapon={roll=template.dna.asymmetry and 45 or 0};p.characterRules=M.copy(template.rules);p.metadata.description=template.note;p.metadata.sourceType="generated";p.metadata.startingProfile=true;p.metadata.dnaReference=M.copy(p.motionDNA)
  lib.presets[p.id]=p;table.insert(lib.order,p.id)
 end
 B.populate(lib)
 Reference.populate(lib)
 return lib
end
function L.propose(preset)
 -- Suggested pieces stay ordinary editable references, never archetype locks.
 local dna=preset.motionDNA;local p=M.copy(preset)
 p.locomotionSet={idle="idle",walk="walk",run=if dna.cadence&gt;1.4 then "sprint" else "run",dash="dash",jump="jump",land="land",wall="wallrun"}
 local route=if dna.acrobatics&gt;.65 then {"jab","knee","spinkick"} elseif dna.precision&gt;.8 then {"palm","cross","launcher"} else {"jab","cross","frontkick"}
 p.sequences={{id="sequence1",name="Opening phrase",orderedClips={}}}
 for _,id in route do local block;for _,b in L.Blocks do if b[1]==id then block=b end end;table.insert(p.sequences[1].orderedClips,{asset=id,duration=block[5]/dna.cadence,blend=.1,transition="blend"}) end
 p.metadata.generated=true;return p
end
return L
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="FML8">
        <Properties>
          <string name="Name">Model</string>
          <ProtectedString name="Source">local Edit=require(script.Parent.MotionEdit)
local M={Version=1,Layers={"Root","Legs","Hips","Torso","LeftArm","RightArm","Head","Weapon"}}
M.DNA={
 {"cadence","Cadence",.5,2,1,"Rhythm"},{"amplitude","Amplitude",.2,1.8,1,"Rhythm"},{"apparentWeight","Apparent weight",0,1,.5,"Rhythm"},{"recoverySpeed","Recovery speed",.5,2,1,"Rhythm"},
 {"groundedness","Groundedness",0,1,.7,"Body"},{"centerHeight","Centre height",-.8,.35,0,"Body"},{"hipInvolvement","Hip involvement",0,1.5,1,"Body"},{"upperActivity","Upper activity",0,1.6,1,"Body"},{"lowerActivity","Lower activity",0,1.6,1,"Body"},{"asymmetry","Asymmetry",-1,1,0,"Body"},{"looseness","Looseness",0,1,.5,"Body"},
 {"forwardPressure","Forward pressure",0,1,.5,"Travel"},{"lateralBias","Lateral bias",-1,1,0,"Travel"},{"stepLength","Step length",.4,2,1,"Travel"},{"strideFrequency","Stride frequency",.5,2,1,"Travel"},{"rotationAmount","Rotation",0,1.6,1,"Travel"},{"rootIntensity","Root intensity",0,1.6,1,"Travel"},
 {"guardOpenness","Guard openness",0,1,.5,"Expression"},{"precision","Precision",0,1,.7,"Expression"},{"acrobatics","Acrobatics",0,1,.4,"Expression"},{"aggression","Aggression",0,1,.5,"Expression"},{"headTracking","Head / aim",0,1,.6,"Expression"},
}
function M.copy(v) if type(v)~="table" then return v end;local out={};for k,x in v do out[k]=M.copy(x) end;return out end
function M.id(s) return type(s)=="string" and #s&gt;0 and #s&lt;=100 and s:match("^[%w_.:%-]+$")~=nil end
function M.finite(n) return type(n)=="number" and n==n and math.abs(n)&lt;1e8 end
function M.safe(value)
 local seen={};local nodes=0
 local function walk(v,d)
  nodes+=1;if nodes&gt;400000 or d&gt;22 then return false end
  if type(v)=="table" then
   if seen[v] then return false end;seen[v]=true
   for k,x in v do if (type(k)~="string" and type(k)~="number") or not walk(k,d+1) or not walk(x,d+1) then return false end end
   seen[v]=nil;return true
  end
  return v==nil or type(v)=="boolean" or M.finite(v) or (type(v)=="string" and #v&lt;=2000000)
 end
 return walk(value,0)
end
function M.defaults() local d={};for _,row in M.DNA do d[row[1]]=row[5] end;return d end
function M.new(id,name)
 local p={schemaVersion=1,id=id,name=name,baseRig="R15",bodyLayers={},motionDNA=M.defaults(),locomotionSet={},sequences={},characterRules={},blendValues={},metadata={sourceType="generated",dnaReference=M.defaults()},stance={weapon={roll=0}},gait={stride=1,cadence=1,arm=35,bob=1,guard=.2},clips={}}
 for _,layer in M.Layers do p.bodyLayers[layer]={source="base",strength=1,enabled=true} end
 return p
end
function M.validate(p,known)
 if not M.safe(p) or type(p)~="table" or p.schemaVersion~=1 or not M.id(p.id) or type(p.name)~="string" or #p.name&lt;1 or #p.name&gt;80 or p.baseRig~="R15" then return false,"Invalid MotionPreset header" end
 if type(p.motionDNA)~="table" or type(p.bodyLayers)~="table" then return false,"Missing DNA/body layers" end
 for layer in p.bodyLayers do if not table.find(M.Layers,layer) then return false,"Unknown body layer" end end
 for _,row in M.DNA do local v=p.motionDNA and p.motionDNA[row[1]];if not M.finite(v) or v&lt;row[3] or v&gt;row[4] then return false,"Invalid DNA: "..row[1] end end
 for _,layer in M.Layers do
  local b=p.bodyLayers and p.bodyLayers[layer]
  if type(b)~="table" or not M.id(b.source) or b.source==p.id or not M.finite(b.strength) or b.strength&lt;0 or b.strength&gt;1 or type(b.enabled)~="boolean" then return false,"Invalid body layer" end
  if known and b.source~="base" and not known[b.source] then return false,"Missing source: "..b.source end
 end
 if type(p.sequences)~="table" or #p.sequences&gt;16 then return false,"Sequence budget" end
 for _,sequence in p.sequences do
  if type(sequence)~="table" or not M.id(sequence.id) or type(sequence.name)~="string" or type(sequence.orderedClips)~="table" or #sequence.orderedClips&gt;24 then return false,"Invalid sequence" end
  for _,clip in sequence.orderedClips do
   if type(clip)~="table" or not M.id(clip.asset) or not M.finite(clip.duration) or clip.duration&lt;.12 or clip.duration&gt;5 or not M.finite(clip.blend) or clip.blend&lt;0 or clip.blend&gt;.5 or (clip.transition~="blend" and clip.transition~="cut") then return false,"Invalid sequence clip" end
  end
 end
 for _,key in {"stance","gait","clips","characterRules","locomotionSet","metadata"} do if type(p[key])~="table" then return false,"Missing "..key end end
 if type(p.metadata.sourceType)~="string" or #p.metadata.sourceType&gt;100 then return false,"Invalid source metadata" end
 if p.metadata.dnaReference then
  if type(p.metadata.dnaReference)~="table" then return false,"Invalid DNA reference" end
  for _,row in M.DNA do local v=p.metadata.dnaReference[row[1]];if not M.finite(v) or v&lt;row[3] or v&gt;row[4] then return false,"Invalid DNA reference" end end
 end
 local function anatomy(pose)
  if type(pose)~="table" then return false end
  for key,part in pose do
   if (key=="breath" or key=="tempo") and M.finite(part) then continue end
   if key=="keep" and type(part)=="boolean" then continue end
   if not table.find({"root","torso","head","ra","la","rl","ll","rf","lf","weapon"},key) or type(part)~="table" then return false end
   for field,value in part do if type(field)~="string" or not M.finite(value) or math.abs(value)&gt;10000 then return false end end
  end
  return true
 end
 if not anatomy(p.stance) then return false,"Invalid anatomical stance" end
 for _,n in p.gait do if not M.finite(n) or math.abs(n)&gt;100 then return false,"Invalid gait" end end
 for name,clip in p.clips do
  if not M.id(name) or type(clip)~="table" or not M.finite(clip.duration) or clip.duration&lt;=0 or clip.duration&gt;30 or type(clip.keys)~="table" or #clip.keys&lt;1 or #clip.keys&gt;128 then return false,"Invalid authored clip" end
  local previous=-1
  for _,key in clip.keys do
   if type(key)~="table" or not M.finite(key.at) or key.at&lt;previous or key.at&lt;0 or key.at&gt;1 or not anatomy(key.pose) then return false,"Invalid motion key" end
   previous=key.at
  end
 end
 for key,value in p.locomotionSet do if not M.id(key) or not M.id(value) then return false,"Invalid locomotion reference" end end
 local overrides=p.characterRules.grammarOverrides
 if overrides then
  if type(overrides)~="table" then return false,"Invalid grammar overrides" end
  for grammar,values in overrides do
   if not M.id(grammar) or type(values)~="table" then return false,"Invalid grammar expression" end
   for key,value in values do if not table.find({"bodyScale","rootLift","rootTravel","lateralTravel"},key) or not M.finite(value) or math.abs(value)&gt;5 then return false,"Invalid expression value" end end
  end
 end
 if p.motionVariants~=nil then
  if type(p.motionVariants)~="table" then return false,"Invalid variants" end
  local count=0;for id,v in p.motionVariants do count+=1;if count&gt;64 or type(v)~="table" or id~=v.id then return false,"Variant budget/identity" end;local ok,why=Edit.validate(v);if not ok then return false,why end end
 end
 return true
end
function M.validateGraph(presets)
 if type(presets)~="table" then return false,"Invalid preset library" end
 local count=0
 for id,p in presets do
  count+=1;if count&gt;128 or type(p)~="table" or id~=p.id then return false,"Preset budget/identity" end
  local ok,why=M.validate(p,presets);if not ok then return false,why end
 end
 local visiting={};local heights={}
 local function visit(id)
  if visiting[id] then return nil,"Body source cycle" end
  if heights[id] then return heights[id] end
  visiting[id]=true;local height=0
  for _,b in presets[id].bodyLayers do if b.source~="base" then
   local child,why=visit(b.source);if not child then return nil,why end;height=math.max(height,child+1)
  end end
  visiting[id]=nil;if height&gt;8 then return nil,"Body source depth" end;heights[id]=height;return height
 end
 for id in presets do local height,why=visit(id);if not height then return false,why end end
 return true
end
function M.validateAssets(p,assets)
 for id,v in p.motionVariants or {} do if (assets[id] and(not assets[id].variantDefinition or assets[id].variantDefinition.sourceAsset~=v.sourceAsset)) or not assets[v.sourceAsset] or assets[v.sourceAsset].grammar~=v.sourceGrammar then return false,"Invalid variant source: "..v.sourceAsset end end
 for _,seq in p.sequences do for _,block in seq.orderedClips do if not assets[block.asset] and not (p.motionVariants and p.motionVariants[block.asset]) then return false,"Unknown motion block: "..block.asset end end end
 for _,id in p.locomotionSet do if not assets[id] and not (p.motionVariants and p.motionVariants[id]) then return false,"Unknown locomotion block: "..id end end
 return true
end
function M.duration(sequence) local n=0;for _,clip in sequence.orderedClips do n+=clip.duration end;return n end
function M.reorder(sequence,from,to)
 assert(from&gt;=1 and from&lt;=#sequence.orderedClips and to&gt;=1 and to&lt;=#sequence.orderedClips,"Invalid clip order")
 table.insert(sequence.orderedClips,to,table.remove(sequence.orderedClips,from))
end
return M
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="FML9">
        <Properties>
          <string name="Name">MotionEdit</string>
          <ProtectedString name="Source">-- Data-only, additive edits in the existing anatomical representation. No game hooks.
local Solver=require(script.Parent.PoseSolver)
local E={}
local function copy(v) if type(v)~="table" then return v end;local o={};for k,x in v do o[k]=copy(x)end;return o end
E.Parts={"Root","Hips","Torso","Head","LeftArm","RightArm","LeftLeg","RightLeg","LeftFoot","RightFoot","Weapon"}
E.Map={Root="root",Hips="root",Torso="torso",Head="head",LeftArm="la",RightArm="ra",LeftLeg="ll",RightLeg="rl",LeftFoot="lf",RightFoot="rf",Weapon="weapon"}
local rot={{"pitch","Pitch",-180,180},{"yaw","Yaw",-180,180},{"roll","Roll",-180,180}}
local pos={{"x","X",-5,5},{"y","Y",-5,5},{"z","Z",-5,5}}
E.Controls={Root={pos[1],pos[2],pos[3],rot[1],rot[2],rot[3]},Hips=rot,Torso=rot,Head=rot,Weapon={pos[1],pos[2],pos[3],rot[1],rot[2],rot[3]}}
for _,p in {"LeftArm","RightArm"}do E.Controls[p]={{"raise","Shoulder raise",-150,150},{"out","Shoulder out",-150,150},{"twist","Shoulder rotation",-180,180},{"elbow","Elbow bend",-150,150},{"elbowTwist","Elbow rotation",-180,180},{"wrist","Wrist bend",-120,120},{"wroll","Wrist roll",-120,120}}end
for _,p in {"LeftLeg","RightLeg"}do E.Controls[p]={{"lift","Hip raise",-150,150},{"out","Hip out",-120,120},{"twist","Hip rotation",-180,180},{"knee","Knee bend",-150,150},{"ankle","Ankle bend",-100,100}}end
for _,p in {"LeftFoot","RightFoot"}do E.Controls[p]={pos[1],pos[2],pos[3],{"yaw","Foot yaw",-180,180},{"toe","Toe pitch",-100,100}}end
E.Modifiers={{"amplitude","Amplitude"},{"hipRotation","Hip rotation"},{"torsoFollow","Torso follow"},{"limbExtension","Limb extension"},{"rootTravel","Root travel"},{"impactLean","Impact lean"},{"anticipation","Anticipation"},{"followThrough","Follow-through"},{"recoveryTightness","Recovery tightness"}}
E.Semantics={"Start","Anticipation","Contact","FollowThrough","Recovery"}
E.CombatSemantics={"Ready","Anticipation","Acceleration","Contact","FollowThrough","Recovery"}
E.Easing={"linear","smooth","in","out"}
function E.create(id,name,asset,duration,contact,recovery)
 contact=math.clamp(contact or .42,.12,.85);recovery=math.clamp(recovery or .7,contact+.04,.95)
 local combat=asset.combatPhases~=nil
 local semantics=if combat then E.CombatSemantics else E.Semantics
 local times=if combat then {0,contact*.35,contact*.7,contact,recovery,1}else {0,contact*.5,contact,recovery,1}
 if combat then for i,name in semantics do times[i]=asset.combatPhases[name] or times[i]end end
 local keys={};for i,name in semantics do table.insert(keys,{id=name,time=times[i],semantic=name,sourceTime=times[i],parts={}})end
 local modifiers={};for _,row in E.Modifiers do modifiers[row[1]]=1 end
 return {phaseSchema=if combat then "combat-six"else nil,id=id,name=name,sourceAsset=asset.id,sourceGrammar=asset.grammar,sourceDuration=duration,poseOverrides=keys,motionModifiers=modifiers,timing={duration=duration,playbackSpeed=1,easing="linear",hold=0},rootPath={forward=0,lateral=0,lift=0,turn=0,startX=0,startY=0,startZ=0,endX=0,endY=0,endZ=0},channels={},enabled=true}
end
local function finite(n) return type(n)=="number" and n==n and math.abs(n)&lt;1e8 end
local function id(s)return type(s)=="string" and #s&gt;0 and #s&lt;=100 and s:match("^[%w_.:%-]+$")~=nil end
function E.validate(v)
 if type(v)~="table" or not id(v.id) or not id(v.sourceAsset) or not id(v.sourceGrammar) or type(v.name)~="string" or #v.name&lt;1 or #v.name&gt;80 or type(v.enabled)~="boolean" or not finite(v.sourceDuration) or v.sourceDuration&lt;=0 or v.sourceDuration&gt;30 then return false,"Invalid variant header"end
 local t=v.timing;if type(t)~="table" or not finite(t.duration) or t.duration&lt;.12 or t.duration&gt;30 or not finite(t.playbackSpeed) or t.playbackSpeed&lt;.25 or t.playbackSpeed&gt;3 or not table.find(E.Easing,t.easing) or not finite(t.hold) or t.hold&lt;0 or t.hold&gt;.3 then return false,"Invalid variant timing"end
 if type(v.motionModifiers)~="table" or type(v.rootPath)~="table" or type(v.channels)~="table" then return false,"Missing variant controls"end
 for _,row in E.Modifiers do local n=v.motionModifiers[row[1]];if not finite(n) or n&lt;0 or n&gt;3 then return false,"Invalid motion modifier"end end
 for _,key in {"forward","lateral","lift","turn","startX","startY","startZ","endX","endY","endZ"}do local n=v.rootPath[key];if not finite(n) or math.abs(n)&gt;(if key=="turn" then 360 else 10) then return false,"Invalid root path"end end
 for part,channel in v.channels do if not table.find(E.Parts,part) or type(channel)~="table" or type(channel.muted)~="boolean" or type(channel.locked)~="boolean" then return false,"Invalid channel"end end
 if type(v.poseOverrides)~="table" or #v.poseOverrides&lt;5 or #v.poseOverrides&gt;64 then return false,"Pose key budget"end
 if v.phaseSchema~=nil and v.phaseSchema~="combat-six"then return false,"Unknown phase schema"end
 local expected=if v.phaseSchema=="combat-six"then E.CombatSemantics else E.Semantics
 local last=-1;local semantics={};local ids={};local lastSource=-1;local lastAnchor=-1
 for _,key in v.poseOverrides do
  if type(key)~="table" or not id(key.id) or ids[key.id] or not finite(key.time) or key.time&lt;0 or key.time&gt;1 or key.time-last&lt;.001 or type(key.parts)~="table" then return false,"Invalid pose key"end
  ids[key.id]=true;last=key.time
  if key.semantic then local index=table.find(expected,key.semantic);if not index or semantics[key.semantic] or index~=1+#semantics then return false,"Semantic order"end;table.insert(semantics,key.semantic);semantics[key.semantic]=true;if not finite(key.sourceTime) or key.sourceTime&lt;0 or key.sourceTime&gt;1 or key.sourceTime&lt;=lastSource then return false,"Invalid source marker"end;lastSource=key.sourceTime end
  if key.sourceTime~=nil then if not finite(key.sourceTime)or key.sourceTime&lt;0 or key.sourceTime&gt;1 or key.sourceTime&lt;=lastAnchor then return false,"Invalid source anchor"end;lastAnchor=key.sourceTime end
  for part,fields in key.parts do
   if not E.Controls[part] or type(fields)~="table" then return false,"Invalid pose part"end
   for field,n in fields do local control=nil;for _,row in E.Controls[part]do if row[1]==field then control=row end end;if not control or not finite(n) or n&lt;control[3] or n&gt;control[4] then return false,"Invalid pose channel"end end
  end
 end
 if #semantics~=#expected or v.poseOverrides[1].semantic~=expected[1] or v.poseOverrides[1].time~=0 or v.poseOverrides[#v.poseOverrides].semantic~="Recovery" or v.poseOverrides[#v.poseOverrides].time~=1 then return false,"Missing semantic boundaries"end
 return true
end
function E.asset(p,id,lib)
 local v=p.motionVariants and p.motionVariants[id]
 if not v then return lib.assets[id]end
 local base=assert(lib.assets[v.sourceAsset],"Missing variant source")
 local registered=lib.assets[id];local asset=copy(if registered and registered.variantDefinition then registered else base);asset.hidden=false;asset.id=v.id;asset.name=v.name;asset.duration=v.timing.duration;asset.variant=true;asset.sourceType="variant";asset.metadata=copy(v.metadata or base.metadata);asset.variantDefinition=nil;return asset
end
function E.variant(p,asset)return (p.motionVariants and p.motionVariants[asset.id])or asset.variantDefinition end
function E.phase(v,name)
 for _,k in v.poseOverrides do if k.semantic==name or(name=="Ready"and k.semantic=="Start")then return k end end
end
function E.boundary(key)return key.semantic=="Start"or key.semantic=="Ready"or key.semantic=="Recovery"end
function E.key(v,id)for i,k in v.poseOverrides do if k.id==id then return k,i end end end
function E.markers(v)local keys={};for _,k in v.poseOverrides do if k.semantic then table.insert(keys,k)end end;return keys end
local function ease(t,kind)return if kind=="linear" then t elseif kind=="in" then t^3 elseif kind=="out" then 1-(1-t)^3 else t*t*(3-2*t)end
function E.warp(v,t)
 local markers=E.markers(v)
 if v.phaseSchema=="combat-six"then markers={};for _,key in v.poseOverrides do if key.sourceTime~=nil then table.insert(markers,key)end end end
 local contactKey=E.phase(v,"Contact");local follow=E.phase(v,"FollowThrough");local contact=contactKey.time;local hold=math.min(v.timing.hold,follow.time-contact-.002)
 if t&gt;=contact and t&lt;=contact+hold then return contactKey.sourceTime end
 for i=1,#markers-1 do local a,b=markers[i],markers[i+1];local start=a.time+(if a==contactKey then hold else 0)
  if t&lt;=b.time then local u=ease(math.clamp((t-start)/math.max(.001,b.time-start),0,1),v.timing.easing);return a.sourceTime+(b.sourceTime-a.sourceTime)*u end
 end;return 1
end
function E.moveKeys(v,ids,delta)
 local low=-1;local high=1
 for i,key in v.poseOverrides do if ids[key.id] then
  if E.boundary(key)then return 0 end
  local j=i-1;while j&gt;=1 and ids[v.poseOverrides[j].id]do j-=1 end;low=math.max(low,(v.poseOverrides[j] and v.poseOverrides[j].time or 0)+.002-key.time)
  j=i+1;while j&lt;=#v.poseOverrides and ids[v.poseOverrides[j].id]do j+=1 end;high=math.min(high,(v.poseOverrides[j] and v.poseOverrides[j].time or 1)-.002-key.time)
 end end
 delta=math.clamp(delta,low,high);for _,key in v.poseOverrides do if ids[key.id]then key.time+=delta end end;return delta
end
function E.addKey(v,id,t)
 assert(#v.poseOverrides&lt;64,"Maximum 64 keys");for _,k in v.poseOverrides do assert(math.abs(k.time-t)&gt;=.002,"A key already exists here")end
 assert(t&gt;.002 and t&lt;.998,"Keep Start/Recovery boundaries");local a,b=v.poseOverrides[1],v.poseOverrides[#v.poseOverrides]
 for i=1,#v.poseOverrides-1 do if t&lt;=v.poseOverrides[i+1].time then a,b=v.poseOverrides[i],v.poseOverrides[i+1];break end end
 local u=ease((t-a.time)/(b.time-a.time),v.timing.easing);local parts={}
 for _,part in E.Parts do for _,row in E.Controls[part]do local field=row[1];local x=(a.parts[part] or {})[field] or 0;local y=(b.parts[part] or {})[field] or 0;local n=x+(y-x)*u;if math.abs(n)&gt;.000001 then parts[part]=parts[part] or {};parts[part][field]=n end end end
 table.insert(v.poseOverrides,{id=id,time=t,parts=parts});table.sort(v.poseOverrides,function(a,b)return a.time&lt;b.time end)
end
local function deltas(v,part,t)
 -- Empty semantic keys deliberately mean zero delta, so corrections return to base.
 local keys=v.poseOverrides;local a,b=keys[1],keys[#keys]
 for i=1,#keys-1 do if t&lt;=keys[i+1].time then a,b=keys[i],keys[i+1];break end end
 local u=ease(math.clamp((t-a.time)/math.max(.001,b.time-a.time),0,1),v.timing.easing);local out={}
 for _,row in E.Controls[part]do local field=row[1];local x=(a.parts[part] or {})[field] or 0;local y=(b.parts[part] or {})[field] or 0;out[field]=x+(y-x)*u end
 return out
end
function E.apply(v,base,t)
 if not v.enabled then return base end
 local p=copy(base);local m=v.motionModifiers;local pulse=math.sin(math.pi*t)^2;local contact=E.phase(v,"Contact").time
 local phaseScale=if t&lt;contact then m.anticipation elseif t&lt;E.phase(v,"FollowThrough").time then m.followThrough else m.recoveryTightness
 -- Exaggerate around existing stance-neutral axes, then apply sparse key deltas.
 for part,a in p do if type(a)=="table" then for field,n in a do if type(n)=="number" and not table.find({"x","y","z"},field)then a[field]=n*m.amplitude*(1+(phaseScale-1)*pulse)end end end end
 p.root=p.root or {};p.torso=p.torso or {}
 p.root.yaw=(p.root.yaw or 0)*m.hipRotation;p.torso.yaw=(p.torso.yaw or 0)*m.torsoFollow;p.torso.pitch=(p.torso.pitch or 0)*m.torsoFollow
 p.root.x=(p.root.x or 0)*m.rootTravel;p.root.z=(p.root.z or 0)*m.rootTravel;p.root.pitch=(p.root.pitch or 0)+(m.impactLean-1)*20*pulse
 for _,arm in {"ra","la"}do if p[arm]then p[arm].elbow=math.clamp((p[arm].elbow or 0)-(m.limbExtension-1)*60*pulse,0,160)end end
 for _,leg in {"rl","ll"}do if p[leg]then p[leg].knee=math.clamp((p[leg].knee or 0)-(m.limbExtension-1)*60*pulse,0,160)end end
 for _,part in E.Parts do if not (v.channels[part] and v.channels[part].muted) then
  local d=deltas(v,part,t);local target=E.Map[part];local nonzero=false;for _,n in d do if math.abs(n)&gt;.00001 then nonzero=true end end
  if nonzero then
   if part=="RightLeg"then p.rl=p.rl or Solver.freeLeg(p,1);p.rf=nil elseif part=="LeftLeg"then p.ll=p.ll or Solver.freeLeg(p,-1);p.lf=nil elseif part=="RightFoot"then p.rf=p.rf or Solver.footTarget(p,1);p.rl=nil elseif part=="LeftFoot"then p.lf=p.lf or Solver.footTarget(p,-1);p.ll=nil end
   p[target]=p[target] or {};for field,n in d do p[target][field]=(p[target][field] or 0)+n end
  end
 end end
 local r=v.rootPath;local root=p.root;root.x=(root.x or 0)+r.lateral*pulse+r.startX*(1-t)+r.endX*t;root.z=(root.z or 0)-r.forward*pulse+r.startZ*(1-t)+r.endZ*t;root.y=(root.y or 0)+r.lift*pulse+r.startY*(1-t)+r.endY*t;root.yaw=(root.yaw or 0)+r.turn*pulse
 for _,part in {"ra","la"}do if p[part] then p[part].elbow=math.clamp(p[part].elbow or 0,0,160)end end
 for _,part in {"rl","ll"}do if p[part] then p[part].knee=math.clamp(p[part].knee or 0,0,160)end end
 return p
end
return E
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="FML10">
        <Properties>
          <string name="Name">NinjaDuelAdapter</string>
          <ProtectedString name="Source">-- Adapter-owned character IDs. Core mixer/generator does not know Naruto names.
local M=require(script.Parent.Model)
local Sampler=require(script.Parent.Sampler)
local Edit=require(script.Parent.MotionEdit)
local A={Format="NinjaDuel.MotionDefinitions.v1"}
function A.import(data,lib)
 local index=0
 for _,id in {"Flashstep","Mirage","GentleFist","Lion"} do
  local def=data.fighters[id];if not def or not data.stances[id] then continue end
  local p=M.new(id,def.name);p.metadata={sourceType="ninja-duel",description="Authored Ninja Duel motion",characterSource=id};p.stance=M.copy(data.stances[id]);p.stance.weapon={roll=if id=="Flashstep" then -35 elseif id=="Mirage" then 15 else 0};p.gait=M.copy(data.gaits[id]);p.clips={}
  -- Preserve renderer inheritance explicitly; legacy imports without metadata
  -- retain their previous direct-clip behavior. Source keyframes stay single-copy.
  local effective={};local origins={}
  local function gather(sourceId,seen)
   assert(not seen[sourceId],"Cyclic clip inheritance");seen[sourceId]=true
   local parent=data.clipInheritance and data.clipInheritance[sourceId]
   if parent then gather(parent,seen) end
   for name,keys in data.clips[sourceId] or {} do effective[name]=keys;origins[name]=sourceId end
  end
  gather(id,{})
  p.metadata.motionClipSources=origins
  for name,keys in effective do
   local a=data.attacks[name] or data.attacks.DashAttack;local scale=def.attackProfile and def.attackProfile[name] or {}
   local startup=a.startup*(scale.startup or 1);local active=a.active*(scale.active or 1);local recovery=a.recovery*(scale.recovery or 1);local exact=data.timings and data.timings[id] and data.timings[id][name];if exact then startup,active,recovery=exact.startup,exact.active,exact.recovery end;local duration=startup+active+recovery
   local normalized={};for _,key in keys do
    local t=if key.at&lt;=1 then key.at*startup elseif key.at&lt;=2 then startup+(key.at-1)*active else startup+active+(key.at-2)*recovery
    table.insert(normalized,{at=math.clamp(t/duration,0,1),pose=M.copy(key.pose),ease=key.ease})
   end
   p.clips[name]={duration=duration,keys=normalized,timing={startup=startup,active=active,recovery=recovery},gameTimeline=M.copy(keys)}
  end
  lib.presets[id]=p;index+=1;table.insert(lib.order,index,id)
 end
 local mapped={};for _,asset in lib.assets do mapped[asset.grammar]=true end
 local names={};for _,profile in lib.presets do for name in profile.clips do if not mapped[name] then mapped[name]=true;table.insert(names,name)end end end;table.sort(names)
 for _,name in names do
  local category=if name:match("^Air") then "Aerial" elseif name:match("^Wall") then "Wall" elseif name:find("Sweep") or name:find("Kick") then "Kicks" elseif name:match("^Throw") then "Grabs" elseif name:find("Step") then "Transitions" elseif name=="Riposte" then "Counters" else "Punches"
  local id="ninja_"..name;local duration=.65;for _,p in lib.presets do if p.clips[name] then duration=p.clips[name].duration;break end end
  lib.assets[id]={id=id,name=name:gsub("(%l)(%u)","%1 %2"),category=category,grammar=name,tags={category,"NinjaDuel"},compatibleBodyLayers=M.copy(M.Layers),defaultSpeed=1,duration=duration,contactMarkers={},rootPolicy="presentation",styleTags={"authored"},sourceType="ninja-duel",proceduralDefinition={kind=name}}
  table.insert(lib.assetOrder,id)
 end
 return lib
end
function A.serialize(bundle)
 assert(M.safe(bundle),"Unsafe export data")
 return game:GetService("HttpService"):JSONEncode(bundle)
end
function A.toLuau(value,depth)
 depth=depth or 0;assert(depth&lt;24,"Export depth")
 if type(value)=="string" then return string.format("%q",value) elseif type(value)=="number" then assert(M.finite(value),"Invalid export number");return tostring(value) elseif type(value)=="boolean" then return tostring(value) elseif value==nil then return "nil" end
 assert(type(value)=="table","Unsupported export")
 local keys={};for key in value do table.insert(keys,key) end;table.sort(keys,function(a,b)return tostring(a)&lt;tostring(b)end)
 local rows={};for _,key in keys do table.insert(rows,"["..A.toLuau(key,depth+1).."]="..A.toLuau(value[key],depth+1)) end
 return "{"..table.concat(rows,",").."}"
end
-- Preserve legacy exports; materialize only selected/referenced common clips.
-- A growing catalogue must not overflow Studio's 2 MB JSON import budget.
function A.exportIds(preset,lib,selected)
 local ids={};for _,id in lib.assetOrder do if not lib.assets[id].authoredClip then ids[id]=true end end
 local function include(id)
  if not id or ids[id]then return end;local a=Edit.asset(preset,id,lib);if not a then return end;ids[id]=true
  local v=Edit.variant(preset,a);if v then include(v.sourceAsset)end
  if a.metadata then include(a.metadata.fromAsset);include(a.metadata.toAsset)end
 end
 include(selected);for _,id in preset.locomotionSet do include(id)end
 for _,seq in preset.sequences do for _,block in seq.orderedClips do include(block.asset)end end
 for id in preset.motionVariants or {}do include(id)end
 local result={};for id in ids do table.insert(result,id)end;table.sort(result);return result
end
function A.ninjaDefinitions(preset,lib,selected)
 -- Same anatomy and 0..3 phase convention as VelmoraMotionEngine CLIPS.
 -- Export is deliberately inert; Claude chooses whether/where to use these tables.
 local function layerGait(p,layer,depth)
  assert(depth&lt;9,"Source depth");local result=M.copy(p.gait);local spec=p.bodyLayers[layer]
  if spec.enabled and spec.source~="base" then local other=layerGait(lib.presets[spec.source],layer,depth+1);for key,value in other do result[key]=(result[key] or value)+(value-(result[key] or value))*spec.strength end end
  return result
 end
 local lower=layerGait(preset,"Legs",0);local upperLeft=layerGait(preset,"LeftArm",0);local upperRight=layerGait(preset,"RightArm",0);local hips=layerGait(preset,"Hips",0)
 local gait=M.copy(preset.gait);gait.stride=(lower.stride or 1)*preset.motionDNA.stepLength*preset.motionDNA.lowerActivity;gait.cadence=(lower.cadence or 1)*preset.motionDNA.cadence*preset.motionDNA.strideFrequency;gait.arm=((upperLeft.arm or 35)+(upperRight.arm or 35))*.5*preset.motionDNA.upperActivity;gait.bob=hips.bob or 1
 local out={id=preset.id,stance=Sampler.mixedAnatomy(preset,lib.assets.idle,0,lib),gait=gait,clips={},timings={},motionMetadata={},generated=true,automaticApply=false}
 local exportIds=A.exportIds(preset,lib,selected)
 for _,assetId in exportIds do
  local asset=Edit.asset(preset,assetId,lib);local actual=Sampler.resolveAsset(preset,asset,lib);local authored=actual.authoredClip or preset.clips[actual.grammar]
  local timing=if authored and authored.timing then authored.timing else {startup=asset.duration*.32,active=asset.duration*.2,recovery=asset.duration*.48}
  if actual.authoredClip then local scale=Sampler.duration(preset,actual,lib)/actual.authoredClip.duration;timing={startup=timing.startup*scale,active=timing.active*scale,recovery=timing.recovery*scale}end
  local variant=Edit.variant(preset,actual)
  if variant then local contactKey=Edit.phase(variant,"Contact");local followKey=Edit.phase(variant,"FollowThrough");local length=Sampler.duration(preset,actual,lib);local contact=if variant.enabled then contactKey.time else contactKey.sourceTime;local recovery=if variant.enabled then followKey.time else followKey.sourceTime;timing={startup=contact*length,active=(recovery-contact)*length,recovery=(1-recovery)*length} end
  local duration=timing.startup+timing.active+timing.recovery;local keys={}
  local samples={}
  if actual.authoredClip and not variant then
   for _,key in actual.authoredClip.keys do samples[key.at]=true end
  else for i=0,24 do samples[i/24]=true end end
  if variant then for _,key in variant.poseOverrides do samples[key.time]=true end;local contact=Edit.phase(variant,"Contact").time;samples[contact+math.min(variant.timing.hold,Edit.phase(variant,"FollowThrough").time-contact-.002)]=true end
  local times={};for t in samples do table.insert(times,t)end;table.sort(times)
  for _,t in times do
   local elapsed=t*duration
   local phase=if elapsed&lt;=timing.startup then elapsed/timing.startup elseif elapsed&lt;=timing.startup+timing.active then 1+(elapsed-timing.startup)/timing.active else 2+(elapsed-timing.startup-timing.active)/timing.recovery
   local easing="linear"
   if actual.authoredClip and not variant then for _,key in actual.authoredClip.keys do if key.at==t then easing=key.ease or "smooth";break end end end
   table.insert(keys,{at=phase,ease=easing,pose=Sampler.mixedAnatomy(preset,asset,t,lib)})
  end
  local exportName=if asset.variant then asset.id else asset.grammar
  out.clips[exportName]=keys;out.timings[exportName]=M.copy(timing)
  if actual.referenceBacked then
   local metadata=M.copy(actual.metadata);metadata.phaseMarkers={}
   if variant then for _,key in variant.poseOverrides do if key.sourceTime~=nil then metadata.phaseMarkers[key.semantic or key.id]={normalized=key.time,seconds=key.time*duration,sourceTime=key.sourceTime}end end end
   out.motionMetadata[exportName]=metadata
  end
 end
 return out
end
function A.bundle(preset,lib,selected)
 local graph=M.copy(lib.presets);graph[preset.id]=preset;local ok,why=M.validateGraph(graph);assert(ok,why)
 local required={};local function gather(p,depth)
  assert(depth&lt;9,"Source depth");for _,layer in p.bodyLayers do
   if layer.source~="base" and not required[layer.source] then local source=assert(lib.presets[layer.source],"Missing source");required[source.id]=M.copy(source);gather(source,depth+1) end
  end
 end;gather(preset,0)
 local assets={}
 local function collect(p,clip)for _,id in A.exportIds(p,lib,clip)do if lib.assets[id]then assets[id]=M.copy(lib.assets[id])end end end
 collect(preset,selected);for _,p in required do collect(p,nil)end
 return {format=A.Format,version=1,baseRig="R15",preset=M.copy(preset),sources=required,assets=assets,ninjaDuel=A.ninjaDefinitions(preset,lib,selected),automaticApply=false}
end
function A.export(preset,lib,parent,prepared)
 local bundle=prepared or A.bundle(preset,lib)
 local module=Instance.new("ModuleScript");module.Name=preset.name:gsub("[^%w_]","_").."_MotionProfile"
 local name=module.Name;local suffix=1;while parent:FindFirstChild(module.Name) do suffix+=1;module.Name=name.."_"..suffix end
 module.Source="-- Forge Motion Lab: data only; no automatic gameplay integration.\nreturn "..A.toLuau(bundle)
 module.Parent=parent;return module,bundle
end
function A.read(instance,lib)
 -- JSON only; never evaluates a selected ModuleScript or foreign Source.
 local json=instance:FindFirstChild("MotionLabJSON")
 local value=if instance:IsA("StringValue") then instance.Value elseif json and json:IsA("StringValue") then json.Value else instance:GetAttribute("ForgeMotionLabJSON")
 assert(type(value)=="string" and #value&lt;=2000000,"Select a Motion Lab JSON export")
 local data=game:GetService("HttpService"):JSONDecode(value);assert(M.safe(data) and data.format==A.Format and data.version==1,"Invalid export format")
 local all=M.copy(lib.presets);for id,p in data.sources or {} do all[id]=p end;all[data.preset.id]=data.preset
 local ok,why=M.validateGraph(all);assert(ok,why)
 for _,p in all do local valid,reason=M.validateAssets(p,lib.assets);assert(valid,reason) end
 return M.copy(data.preset),M.copy(data.sources or {})
end
return A
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="FML11">
        <Properties>
          <string name="Name">NinjaSources</string>
