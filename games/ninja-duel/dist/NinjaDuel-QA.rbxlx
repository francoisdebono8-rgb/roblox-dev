        </Item>
        <Item class="ModuleScript" referent="ND147">
          <Properties>
            <string name="Name">VfxKit</string>
            <ProtectedString name="Source">-- Presentation primitives on the project's own VFX textures
-- (tools/vfx_textures.py -&gt; assets/vfx -&gt; uploaded image ids below).
--
-- Cel-shaded fire and smoke flipbooks, ground cracks and scorch, an impact
-- star, a crescent slash, a shock ring, spark streaks and lightning. Every
-- helper degrades to a built-in Roblox texture (or to nothing) when an id is
-- not set, so the game never depends on an upload to run.
-- Presentation only: nothing here can change gameplay.
-- Uploaded ids feed real ParticleEmitters. Without them the packed textures
-- live in EditableImages, which a Decal or an ImageLabel can show but a
-- ParticleEmitter cannot (Studio, 2026-10-26: an emitter with EditableImage
-- content renders nothing): bursts and streams are then drawn by the small
-- sprite system below (billboards stepped on RenderStepped), with the same
-- property names as an emitter.
local Debris=game:GetService("Debris")
local TweenService=game:GetService("TweenService")
local Kit={}

-- Uploaded image ids (rbxassetid://...). Empty: the built-in fallback is used.
Kit.IDS={
	fire="",      -- nd_fire_flip.png   4x4 flipbook, colours baked in
	smoke="",     -- nd_smoke_flip.png  4x4 flipbook, grey cel tones (tinted)
	crack="",     -- nd_crack.png       radial web of cracks (dark)
	scorch="",    -- nd_scorch.png      radial burn streaks (dark)
	star="",      -- nd_star.png        impact star (white)
	slash="",     -- nd_slash.png       crescent arc (white)
	ring="",      -- nd_ring.png        shock ring (white)
	streak="",    -- nd_streak.png      spark streak (white)
	lightning="", -- nd_lightning_flip.png 2x2 flipbook (white)
}
local BUILTIN={
	fire="rbxasset://textures/particles/fire_main.dds",
	smoke="rbxasset://textures/particles/smoke_main.dds",
	star="rbxasset://textures/particles/sparkles_main.dds",
	streak="rbxasset://textures/particles/sparkles_main.dds",
	ring="rbxasset://textures/particles/explosion01_shockwave_main.dds",
	lightning="rbxasset://textures/particles/sparkles_main.dds",
}
local FLIP={fire=Enum.ParticleFlipbookLayout.Grid4x4,smoke=Enum.ParticleFlipbookLayout.Grid4x4,lightning=Enum.ParticleFlipbookLayout.Grid2x2}
local GRID={fire=4,smoke=4,lightning=2}
local dims={}

-- Where a texture comes from, best first: an uploaded id, else the packed
-- copy decoded once into an EditableImage (Client/VfxAtlas), else nothing
-- (the built-in fallback). `has` says whether our own art is available.
local runtime={}
local tried={}
local B64="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local DIGIT={}
for i=1,#B64 do DIGIT[string.byte(B64,i)]=i-1 end
-- Palette + run-length text (tools/vfx_textures.py --pack) -&gt; RGBA8 buffer.
function Kit.decode(entry)
	local w,h=entry.w,entry.h
	local pal=entry.pal
	local colours={}
	for i=0,#pal/4-1 do
		local r,g,b,a=pal[i*4+1],pal[i*4+2],pal[i*4+3],pal[i*4+4]
		colours[i]=r+g*256+b*65536+a*16777216
	end
	local out=buffer.create(w*h*4)
	local data=entry.data
	local n=#data
	local i,at=1,0
	local total=w*h
	while i&lt;=n and at&lt;total do
		local c=DIGIT[string.byte(data,i)]
		i+=1
		if c then
			local run,shift=0,0
			while true do
				local v=DIGIT[string.byte(data,i)]
				i+=1
				if v then
					run+=bit32.lshift(bit32.band(v,31),shift);shift+=5
					if bit32.band(v,32)==0 then break end
				end
			end
			local colour=colours[c] or 0
			for k=at,math.min(total-1,at+run) do buffer.writeu32(out,k*4,colour) end
			at+=run+1
		end
	end
	return out,w,h
end
local function editable(name)
	if tried[name] then return runtime[name] end
	tried[name]=true
	local ok,result=pcall(function()
		local atlas=require(script.Parent.VfxAtlas)
		local entry=atlas[name]
		if not entry then return nil end
		local pixels,w,h=Kit.decode(entry)
		local image=game:GetService("AssetService"):CreateEditableImage({Size=Vector2.new(w,h)})
		if not image then return nil end
		image:WritePixelsBuffer(Vector2.zero,Vector2.new(w,h),pixels)
		dims[name]=Vector2.new(w,h)
		return Content.fromObject(image)
	end)
	runtime[name]=if ok then result else nil
	return runtime[name]
end
function Kit.has(name)
	if (Kit.IDS[name] or "")~="" then return true end
	return editable(name)~=nil
end
-- True when this texture can only be drawn as sprites (no uploaded id).
function Kit.spriteOnly(name)
	return (Kit.IDS[name] or "")=="" and editable(name)~=nil
end
-- The texture as Content (assign to TextureContent).
function Kit.content(name)
	if not Content then return nil end
	local id=Kit.IDS[name]
	if id and id~="" then return Content.fromUri(id) end
	local image=editable(name)
	if image then return image end
	return Content.fromUri(BUILTIN[name] or BUILTIN.star)
end
-- Build every texture now (a frame of work at load, none mid-fight).
function Kit.warm()
	for name in Kit.IDS do Kit.has(name) end
end

local function new(class,props,parent)
	local x=Instance.new(class)
	for k,v in props do x[k]=v end
	if parent then x.Parent=parent end
	return x
end
Kit.new=new
local function tween(object,time,goal,style,direction)
	local t=TweenService:Create(object,TweenInfo.new(time,style or Enum.EasingStyle.Quad,direction or Enum.EasingDirection.Out),goal)
	t:Play();return t
end
Kit.tween=tween
function Kit.seq(points)
	local keys={}
	for _,p in points do table.insert(keys,ColorSequenceKeypoint.new(p[1],p[2])) end
	return ColorSequence.new(keys)
end
function Kit.num(points)
	local keys={}
	for _,p in points do table.insert(keys,NumberSequenceKeypoint.new(p[1],p[2],p[3] or 0)) end
	return NumberSequence.new(keys)
end
local seq,num=Kit.seq,Kit.num

local function holder(parent,position,life)
	local p=new("Part",{Name="FXAnchor",Size=Vector3.new(.2,.2,.2),CFrame=CFrame.new(position),Transparency=1,
		Anchored=true,CanCollide=false,CanQuery=false,CanTouch=false,CastShadow=false},parent)
	Debris:AddItem(p,life or 4)
	return p
end
Kit.holder=holder

-- ------------------------------------------------------------------ sprites
local function evalNum(v,u)
	if type(v)=="number" then return v end
	if typeof(v)~="NumberSequence" then return 0 end
	local k=v.Keypoints
	for i=1,#k-1 do
		local a,b=k[i],k[i+1]
		if u&lt;=b.Time then
			local t=if b.Time&gt;a.Time then (u-a.Time)/(b.Time-a.Time) else 1
			return a.Value+(b.Value-a.Value)*t
		end
	end
	return k[#k].Value
end
local function evalColor(v,u)
	if typeof(v)=="Color3" then return v end
	if typeof(v)~="ColorSequence" then return Color3.new(1,1,1) end
	local k=v.Keypoints
	for i=1,#k-1 do
		local a,b=k[i],k[i+1]
		if u&lt;=b.Time then
			local t=if b.Time&gt;a.Time then (u-a.Time)/(b.Time-a.Time) else 1
			return a.Value:Lerp(b.Value,t)
		end
	end
	return k[#k].Value
end
local function range(r,default)
	if typeof(r)=="NumberRange" then return r.Min+(r.Max-r.Min)*math.random() end
	return r or default
end
local live={}
local streams={}
local origin
local stepping=false
local function originPart()
	if origin and origin.Parent then return origin end
	origin=Instance.new("Part")
	origin.Name="FXSpriteOrigin";origin.Anchored=true;origin.CanCollide=false;origin.CanQuery=false;origin.CanTouch=false
	origin.Transparency=1;origin.Size=Vector3.new(.2,.2,.2);origin.CFrame=CFrame.new()
	origin.Parent=workspace
	return origin
end
-- A direction inside the emission cone (half-angle `spread` degrees round `axis`).
local function coneDirection(axis,spread)
	local tilt=math.rad(math.min(spread,180))*math.sqrt(math.random())
	local spin=math.random()*math.pi*2
	local up=if math.abs(axis.Y)&gt;.95 then Vector3.xAxis else Vector3.yAxis
	local side=axis:Cross(up).Unit
	local other=side:Cross(axis).Unit
	return (axis*math.cos(tilt)+(side*math.cos(spin)+other*math.sin(spin))*math.sin(tilt)).Unit
end
local stepAll
local function ensureStep()
	if stepping then return end
	stepping=true
	game:GetService("RunService").RenderStepped:Connect(function(dt) stepAll(dt) end)
end
-- One sprite: a billboard on the shared origin, an image (a flipbook cell).
local function spawnSprite(name,position,direction,props)
	local content=Kit.content(name)
	if not content then return end
	local size=props.Size or NumberSequence.new(1)
	local gui=Instance.new("BillboardGui")
	gui.Name="FXSprite";gui.Adornee=originPart();gui.LightInfluence=0;gui.ResetOnSpawn=false
	gui.Size=UDim2.fromScale(1,1);gui.StudsOffsetWorldSpace=position
	gui.Brightness=1+(props.LightEmission or 0)*1.5
	local img=Instance.new("ImageLabel")
	img.BackgroundTransparency=1;img.Size=UDim2.fromScale(1,1);img.ImageContent=content
	img.AnchorPoint=Vector2.new(.5,.5);img.Position=UDim2.fromScale(.5,.5)
	local grid=GRID[name]
	local dim=dims[name] or Vector2.new(256,256)
	local frames,frame0=nil,0
	if grid then
		img.ImageRectSize=dim/grid
		frames=grid*grid
		if props.FlipbookMode==Enum.ParticleFlipbookMode.Random then frame0=math.random(0,frames-1) end
	end
	img.Parent=gui
	local spread=if typeof(props.SpreadAngle)=="Vector2" then math.max(props.SpreadAngle.X,props.SpreadAngle.Y) else 0
	local dir=if spread&gt;0 then coneDirection(direction,spread) else direction
	local s={gui=gui,img=img,pos=position,vel=dir*range(props.Speed,0),age=0,life=math.max(.02,range(props.Lifetime,1)),
		size=size,trans=props.Transparency or 0,color=props.Color or Color3.new(1,1,1),drag=props.Drag or 0,
		accel=props.Acceleration or Vector3.zero,rot=range(props.Rotation,0),spin=range(props.RotSpeed,0),
		frames=frames,frame0=frame0,random=props.FlipbookMode==Enum.ParticleFlipbookMode.Random,grid=grid,cell=img.ImageRectSize,
		along=props.Orientation==Enum.ParticleOrientation.VelocityParallel,aspect=props.Aspect or 1}
	gui.Parent=Kit.spriteLayer()
	table.insert(live,s)
	ensureStep()
	return s
end
function Kit.spriteLayer()
	local player=game:GetService("Players").LocalPlayer
	local gui=player and player:FindFirstChildOfClass("PlayerGui")
	if not gui then return workspace end
	local layer=gui:FindFirstChild("NinjaDuelSprites")
	if not layer then layer=Instance.new("Folder");layer.Name="NinjaDuelSprites";layer.Parent=gui end
	return layer
end
stepAll=function(dt)
	local camera=workspace.CurrentCamera
	local n=#live
	local i=1
	while i&lt;=n do
		local s=live[i]
		s.age+=dt
		local u=s.age/s.life
		if u&gt;=1 or not s.gui.Parent then
			s.gui:Destroy()
			live[i]=live[n];live[n]=nil;n-=1
			continue
		end
		if s.drag&gt;0 then s.vel*=math.exp(-s.drag*dt) end
		s.vel+=s.accel*dt
		s.pos+=s.vel*dt
		s.gui.StudsOffsetWorldSpace=s.pos
		local size=evalNum(s.size,u)
		if s.along then
			-- Stretched along its motion on screen (a streak).
			local a=camera:WorldToViewportPoint(s.pos)
			local b=camera:WorldToViewportPoint(s.pos+s.vel*.02)
			local d=Vector2.new(b.X-a.X,b.Y-a.Y)
			if d.Magnitude&gt;.01 then s.img.Rotation=math.deg(math.atan2(d.X,-d.Y)) end
			s.gui.Size=UDim2.fromScale(size*s.aspect,size*s.aspect)
			s.img.Size=UDim2.fromScale(.22,1)
		else
			s.gui.Size=UDim2.fromScale(size*s.aspect,size)
			s.img.Rotation=s.rot+s.spin*s.age
		end
		s.img.ImageTransparency=evalNum(s.trans,u)
		s.img.ImageColor3=evalColor(s.color,u)
		if s.frames then
			local f=if s.random then (s.frame0+math.floor(s.age*24))%s.frames else math.min(s.frames-1,math.floor(u*s.frames))
			s.img.ImageRectOffset=Vector2.new(f%s.grid,math.floor(f/s.grid))*s.cell
		end
		i+=1
	end
	for handle in streams do
		local at=handle.attachment
		if not at.Parent or handle.dead then streams[handle]=nil;continue end
		if handle.Enabled and handle.Rate&gt;0 then
			handle.acc+=handle.Rate*dt
			local cf=at.WorldCFrame
			local axis=if handle.props.front then cf.LookVector else cf.UpVector
			while handle.acc&gt;=1 do
				handle.acc-=1
				spawnSprite(handle.name,cf.Position,axis,handle.props)
			end
		end
	end
end
-- A continuous emitter at an attachment: set handle.Rate / handle.Enabled /
-- handle.props.Size like an emitter's properties.
function Kit.stream(attachment,name,props)
	if not Kit.spriteOnly(name) then
		local e=Instance.new("ParticleEmitter")
		e.TextureContent=Kit.content(name);e.LightInfluence=0
		local flip=FLIP[name]
		if flip then e.FlipbookLayout=flip;e.FlipbookMode=props.FlipbookMode or Enum.ParticleFlipbookMode.OneShot end
		for k,v in props do if k~="front" and k~="Aspect" and k~="FlipbookMode" then e[k]=v end end
		if props.front then e.EmissionDirection=Enum.NormalId.Front end
		e.Parent=attachment
		return e
	end
	local handle={attachment=attachment,name=name,props=props,Rate=props.Rate or 0,Enabled=true,acc=0}
	streams[handle]=true
	ensureStep()
	return handle
end

-- Property writes that work on either kind of stream.
function Kit.setSize(stream,size)
	if not stream then return end
	if typeof(stream)=="Instance" then stream.Size=size else stream.props.Size=size end
end
function Kit.setRate(stream,rate)
	if stream then stream.Rate=rate end
end
function Kit.stop(stream)
	if not stream then return end
	if typeof(stream)=="Instance" then stream.Enabled=false else stream.dead=true end
end

-- A one-shot particle burst. `texture` is a Kit texture name; a flipbook
-- texture plays once over each particle's life.
function Kit.burst(parent,position,texture,count,props)
	if Kit.spriteOnly(texture) then
		local d=props.direction
		local axis=if d and d.Magnitude&gt;.01 then d.Unit else Vector3.yAxis
		for _=1,count do spawnSprite(texture,position,axis,props) end
		return nil
	end
	local h=holder(parent,position,(props.hold or 4))
	local at=new("Attachment",{},h)
	local e=new("ParticleEmitter",{Enabled=false,LightInfluence=0,TextureContent=Kit.content(texture),ZOffset=props.zoffset or .5},at)
	local flip=FLIP[texture]
	if flip and Kit.has(texture) then
		e.FlipbookLayout=flip;e.FlipbookMode=Enum.ParticleFlipbookMode.OneShot
	end
	for k,v in props do
		if k~="hold" and k~="zoffset" and k~="direction" then e[k]=v end
	end
	local d=props.direction
	if d and d.Magnitude&gt;.01 then
		d=d.Unit
		if d.Y&gt;.99 then -- straight up: the attachment's own +Y
		elseif d.Y&lt;-.99 then e.EmissionDirection=Enum.NormalId.Bottom
		else at.WorldCFrame=CFrame.lookAt(position,position+d)*CFrame.Angles(-math.pi/2,0,0) end
	end
	e:Emit(count)
	return e,h
end

-- A flat textured quad (both faces) at `cf`, growing and fading.
function Kit.plane(parent,cf,texture,size,growTo,time,color,transparency,light)
	if not Kit.has(texture) then return nil end
	local p=new("Part",{Name="FXPlane",Size=Vector3.new(size.X,size.Y,.05),CFrame=cf,Transparency=1,
		Anchored=true,CanCollide=false,CanQuery=false,CanTouch=false,CastShadow=false},parent)
	for _,face in {Enum.NormalId.Front,Enum.NormalId.Back} do
		local d=new("Decal",{TextureContent=Kit.content(texture),Face=face,Color3=color or Color3.new(1,1,1),Transparency=transparency or 0},p)
		tween(d,time,{Transparency=1},Enum.EasingStyle.Quad,Enum.EasingDirection.In)
	end
	if light then
		-- Bright: a second, additive-looking copy.
		local glow=new("SurfaceLight",{Brightness=light,Range=6,Color=color or Color3.new(1,1,1),Face=Enum.NormalId.Front},p)
		tween(glow,time,{Brightness=0})
	end
	tween(p,time,{Size=Vector3.new(growTo.X,growTo.Y,.05)})
	Debris:AddItem(p,time+.05)
	return p
end

-- A decal laid on the floor (crack, scorch), held then faded.
function Kit.floorUnder(position,exclude,depth)
	local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances=exclude or {}
	return workspace:Raycast(position+Vector3.new(0,2,0),Vector3.new(0,-(depth or 14),0),params)
end
function Kit.ground(parent,position,normal,texture,size,hold,fade,color,transparency)
	if not Kit.has(texture) then return nil end
	normal=(normal or Vector3.yAxis).Unit
	-- A flat part whose top face lies on the surface, spun at random.
	local side=if math.abs(normal.Y)&gt;.9 then Vector3.xAxis else Vector3.yAxis
	local right=side:Cross(normal).Unit
	local cf=CFrame.fromMatrix(position+normal*.04,right,normal)*CFrame.Angles(0,math.random()*math.pi*2,0)
	local p=new("Part",{Name="FXGround",Size=Vector3.new(size*.55,.05,size*.55),CFrame=cf,Transparency=1,
		Anchored=true,CanCollide=false,CanQuery=false,CanTouch=false,CastShadow=false},parent)
	local d=new("Decal",{TextureContent=Kit.content(texture),Face=Enum.NormalId.Top,Color3=color or Color3.new(1,1,1),Transparency=1},p)
	-- In fast: the crack opens in a few frames.
	tween(d,.06,{Transparency=transparency or 0})
	tween(p,.1,{Size=Vector3.new(size,.05,size)},Enum.EasingStyle.Back)
	task.delay(hold,function() if d.Parent then tween(d,fade,{Transparency=1}) end end)
	Debris:AddItem(p,hold+fade+.1)
	return p
end

-- The struck body tints for a few frames (red on a hit, gold on a guard).
local tints=setmetatable({},{__mode="k"})
function Kit.tint(model,color,time,strength)
	if not model then return end
	local h=tints[model]
	if not h or not h.Parent then
		h=new("Highlight",{Name="HitTint",DepthMode=Enum.HighlightDepthMode.Occluded,FillTransparency=1,OutlineTransparency=1},model)
		tints[model]=h
	end
	h.FillColor=color;h.OutlineColor=color
	h.FillTransparency=1-(strength or .55);h.OutlineTransparency=.35
	tween(h,time,{FillTransparency=1,OutlineTransparency=1},Enum.EasingStyle.Quad,Enum.EasingDirection.In)
end

-- Cel dust from the floor (landings, slams, skids).
function Kit.dust(parent,position,count,size,color,speed)
	return Kit.burst(parent,position,"smoke",count,{
		Lifetime=NumberRange.new(.45,.8),Speed=NumberRange.new(speed or 10,(speed or 10)*1.8),SpreadAngle=Vector2.new(80,8),
		Color=ColorSequence.new(color or Color3.fromRGB(214,200,172)),LightEmission=0,
		Size=num({{0,size*.5},{.3,size},{1,size*1.25}}),Transparency=num({{0,0},{.75,.1},{1,1}}),
		Drag=7,RotSpeed=NumberRange.new(-40,40),Rotation=NumberRange.new(0,360),Acceleration=Vector3.new(0,3,0),
		direction=Vector3.yAxis})
end

-- Streaks flying out of a contact, aligned to their own velocity.
function Kit.streaks(parent,position,direction,count,color,speed,spread)
	return Kit.burst(parent,position,"streak",count,{
		Lifetime=NumberRange.new(.08,.16),Speed=NumberRange.new(speed,speed*1.7),SpreadAngle=Vector2.new(spread or 50,spread or 50),
		Color=ColorSequence.new(color),LightEmission=1,Orientation=Enum.ParticleOrientation.VelocityParallel,
		Size=if Kit.spriteOnly("streak") then num({{0,2.6},{1,1.2}}) else num({{0,.35},{1,.08}}),
		Squash=num({{0,-1.2},{1,-1.6}}),Transparency=num({{0,0},{1,.6}}),Drag=8,
		direction=direction,zoffset=2})
end

-- The flash at the point of contact.
function Kit.star(parent,position,size,color,time)
	return Kit.burst(parent,position,"star",1,{
		Lifetime=NumberRange.new(time or .1),Speed=NumberRange.new(0),Color=ColorSequence.new(color),LightEmission=1,
		Size=num({{0,size*.5},{.25,size},{1,size*1.15}}),Transparency=num({{0,0},{.6,.2},{1,1}}),
		Rotation=NumberRange.new(0,360),zoffset=3})
end

return Kit
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND148">
          <Properties>
            <string name="Name">Wave1FX</string>
            <ProtectedString name="Source">-- Roster 20, batch 1 (Haku, Zabuza, Kimimaro): the batch's own drawing,
-- installed by Effects. Most of it is FamilyFX's (Shared/Looks); here only
-- what a look alone cannot say: the dome of ice mirrors standing round the
-- opponent, and the Hidden Mist thick enough to lose a body in.
local Debris=game:GetService("Debris")
local M={}
function M.install(FX,kit)
	local new,block,tween,flash,shockRing,num,TEX=kit.new,kit.block,kit.tween,kit.flash,kit.shockRing,kit.num,kit.TEX
	local ICE=Color3.fromRGB(214,240,255)
	local EDGE=Color3.fromRGB(150,206,240)
	local function mirrors(fx,position,radius,time)
		local floor=kit.floorUnder(fx,position,3,14)
		local base=if floor then floor.Position else position-Vector3.new(0,2.8,0)
		local count=10
		for i=1,count do
			local angle=i/count*math.pi*2
			local at=base+Vector3.new(math.cos(angle)*radius,3.6,math.sin(angle)*radius)
			local pane=block(fx.folder,Vector3.new(2.6,5.2,.18),CFrame.lookAt(at,Vector3.new(base.X,at.Y,base.Z)),ICE,Enum.Material.Glass)
			pane.Transparency=1;pane.Reflectance=.35
			local rim=block(pane,Vector3.new(2.8,5.4,.08),pane.CFrame*CFrame.new(0,0,.06),EDGE,Enum.Material.Neon)
			rim.Transparency=1
			tween(pane,.25,{Transparency=.35});tween(rim,.25,{Transparency=.75})
			task.delay(math.max(.3,time-.4),function()
				if pane.Parent then tween(pane,.35,{Transparency=1});tween(rim,.35,{Transparency=1}) end
			end)
			Debris:AddItem(pane,time+.2)
		end
		shockRing(fx.folder,base+Vector3.new(0,.2,0),ICE,2,radius*2,.4)
	end
	local function mist(fx,position,radius,time)
		local floor=kit.floorUnder(fx,position,3,14)
		local at=if floor then floor.Position+Vector3.new(0,1,0) else position
		local holder=kit.anchorPart(fx.folder,at)
		holder.Size=Vector3.new(radius*2,4,radius*2)
		local e=new("ParticleEmitter",{Texture=TEX.smoke,Rate=22,Lifetime=NumberRange.new(2.5,3.5),Speed=NumberRange.new(.4,1.2),SpreadAngle=Vector2.new(60,60),
			EmissionDirection=Enum.NormalId.Top,Shape=Enum.ParticleEmitterShape.Box,Color=ColorSequence.new(Color3.fromRGB(226,232,238)),LightInfluence=1,
			Size=num({{0,10},{1,18}}),Transparency=num({{0,1},{.2,.55},{.8,.6},{1,1}}),Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-8,8)},holder)
		task.delay(math.max(.3,time-1),function() if e.Parent then e.Enabled=false end end)
		Debris:AddItem(holder,time+3.5)
	end
	-- Zabuza: Kubikiribōchō in his hands from the guard to the recovery
	-- (bible ZABUZA.md §7): a blade welded to the right hand for the whole
	-- duel, the one on his back hidden; the edge trail only in live frames.
	local BACK={Cleaver=true,CleaverHole=true,CleaverGrip=true}
	local held=setmetatable({},{__mode="k"})
	local function cleaver(fx,model,actor)
		if actor.fighterId~="Mist" then return end
		local swinging=(actor.health or 1)&gt;0
		local st=held[model]
		if not st then
			local hand=model:FindFirstChild("RightHand")
			if not hand then return end
			local m=new("Model",{Name="HeldCleaver"},model)
			local blade=block(m,Vector3.new(.16,4.4,1.5),hand.CFrame*CFrame.new(0,-3.0,-.35),Color3.fromRGB(180,188,196),Enum.Material.Metal)
			local grip=block(m,Vector3.new(.24,1.1,.24),hand.CFrame*CFrame.new(0,-.25,0),Color3.fromRGB(60,46,36),Enum.Material.SmoothPlastic)
			local hole=block(m,Vector3.new(.18,.5,.5),hand.CFrame*CFrame.new(0,-4.6,-.55),Color3.fromRGB(30,30,34),Enum.Material.SmoothPlastic)
			for _,p in {blade,grip,hole} do p.Anchored=false;p.CanCollide=false;p.Massless=true;new("WeldConstraint",{Part0=hand,Part1=p},p) end
			-- The arc the edge cuts while the strike is live (QA-004 M6: the hit
			-- reads as coming from the blade, not from his fist).
			local a0=new("Attachment",{Position=Vector3.new(0,-2.1,-.6)},blade)
			local a1=new("Attachment",{Position=Vector3.new(0,2.1,-.6)},blade)
			local trail=new("Trail",{Attachment0=a0,Attachment1=a1,Lifetime=.14,Color=ColorSequence.new(Color3.fromRGB(226,236,244)),LightEmission=.5,
				Transparency=num({{0,.35},{1,1}}),FaceCamera=false,Enabled=false},blade)
			st={model=m,parts={blade,grip,hole},shown=nil,trail=trail};held[model]=st
		end
		st.trail.Enabled=swinging and actor.state=="Active"
		if st.shown==swinging then return end
		st.shown=swinging
		for _,p in st.parts do p.LocalTransparencyModifier=if swinging then 0 else 1 end
		for _,p in model:GetChildren() do if BACK[p.Name] and p:IsA("BasePart") then p.LocalTransparencyModifier=if swinging then 1 else 0 end end
	end
	-- Kimimaro: the skeleton in the blows (bible KIMIMARO.md §7, §11). A bone
	-- is born on the limb that strikes during the wind-up, is full during the
	-- live window and visibly retracts in the recovery: knuckles (L1, the
	-- rise), elbow (L2, flank arc, riposte, dash), shin (L3, reap, air), the
	-- forearm bones (Heavy, guard, Willow). Presentation only: the server's
	-- contact and guard rules are unchanged; nothing is left out at rest.
	local BONE=Color3.fromRGB(240,234,214)
	local USE={
		Light1="knuckle",BoneRise="forearm",
		Light2="elbow",CamelliaArc="elbowR",BoneElbow="elbow",DashAttack="elbowR",
		Light3="shin",BoneReap="shin",Air1="knee",Air2="shin",BoneHeel="shin",
		Heavy="forearm",WillowCut="forearm",
	}
	local skel=setmetatable({},{__mode="k"})
	local function spur(m,limb,anchor,dir,len,thick,color,material)
		local p=block(m,Vector3.new(thick,thick,len),limb.CFrame,color or BONE,material or Enum.Material.SmoothPlastic)
		p.Anchored=false;p.CanCollide=false;p.CanQuery=false;p.CanTouch=false;p.Massless=true
		local w=new("Weld",{Part0=limb,Part1=p,C0=anchor},p)
		p.LocalTransparencyModifier=1
		return {part=p,weld=w,anchor=anchor,dir=dir,len=len,thick=thick,f=0}
	end
	local function skeleton(model)
		local rh,la,ra,rl,ll=model:FindFirstChild("RightHand"),model:FindFirstChild("LeftLowerArm"),model:FindFirstChild("RightLowerArm"),model:FindFirstChild("RightLowerLeg"),model:FindFirstChild("LeftLowerLeg")
		if not (rh and la and ra and rl and ll) then return nil end
		local m=new("Model",{Name="LivingBones"},model)
		local down,back,fwd=Vector3.new(0,-1,0),Vector3.new(0,1,0),Vector3.new(0,0,-1)
		local st={sets={}}
		-- Knuckles: three short points out of the fist, along the punch.
		st.sets.knuckle={spur(m,rh,CFrame.new(-.15,-.35,0),down,.4,.1),spur(m,rh,CFrame.new(0,-.35,0),down,.45,.1),spur(m,rh,CFrame.new(.15,-.35,0),down,.4,.1)}
		-- Elbow spurs out past the joint (left for L2 / riposte, right for the flank arc and the dash).
		st.sets.elbow={spur(m,la,CFrame.new(0,.45,.12),back,.7,.16)}
		st.sets.elbowR={spur(m,ra,CFrame.new(0,.45,.12),back,.7,.16)}
		-- Shin spurs, short, on the front of the right shin.
		st.sets.shin={spur(m,rl,CFrame.new(0,.25,-.3),fwd,.35,.1),spur(m,rl,CFrame.new(0,-.15,-.3),fwd,.35,.1)}
		st.sets.knee={spur(m,rl,CFrame.new(0,.45,-.3),fwd,.4,.12)}
		-- Radius and ulna out along both forearms (the guard, the heavy).
		st.sets.forearm={spur(m,ra,CFrame.new(.2,-.1,0),down,1.1,.12),spur(m,la,CFrame.new(-.2,-.1,0),down,1.1,.12)}
		return st
	end
	-- Haku (bible HAKU.md §7, §11): senbon between the fingers of both hands
	-- for the whole duel (welded, never thrown by a light), a spike of ice
	-- born at the left wrist for the palm and the lift, at the right wrist
	-- for the heavy push and the guard's deflection; a thin plate of ice
	-- under the gliding foot that breaks at once.
	local ICE=Color3.fromRGB(214,240,255)
	local STEELN=Color3.fromRGB(200,206,214)
	local ICE_USE={Light2="wristL",FrostLift="wristL",Heavy="wristR"}
	local GLIDE={Light2=true,IceSlide=true,SenbonLow=true,DashAttack=true,Light3=true}
	local function icework(model)
		local rh,lh,la,ra=model:FindFirstChild("RightHand"),model:FindFirstChild("LeftHand"),model:FindFirstChild("LeftLowerArm"),model:FindFirstChild("RightLowerArm")
		if not (rh and lh and la and ra) then return nil end
		local m=new("Model",{Name="SenbonAndIce"},model)
		for _,hand in {rh,lh} do
			for i=-1,1 do
				local n=block(m,Vector3.new(.04,.7,.04),hand.CFrame*CFrame.new(i*.12,-.55,-.05),STEELN,Enum.Material.Metal)
				n.Anchored=false;n.CanCollide=false;n.CanQuery=false;n.CanTouch=false;n.Massless=true
				new("WeldConstraint",{Part0=hand,Part1=n},n)
			end
		end
		local down=Vector3.new(0,-1,0)
		local st={sets={}}
		st.sets.wristL={spur(m,la,CFrame.new(0,-.4,-.2),Vector3.new(0,0,-1),.7,.14,ICE,Enum.Material.Glass)}
		st.sets.wristR={spur(m,ra,CFrame.new(0,-.4,-.2),Vector3.new(0,0,-1),.7,.14,ICE,Enum.Material.Glass),spur(m,ra,CFrame.new(.18,-.1,0),down,.8,.1,ICE,Enum.Material.Glass)}
		return st
	end
	local KITS={Bone={build=skeleton,use=USE,guard="forearm"},Mirror={build=icework,use=ICE_USE,guard="wristR"}}
	local glided=setmetatable({},{__mode="k"})
	local function plate(fx,model,actor)
		local key=(actor.attackName or "").."@"..tostring(actor.state)
		if glided[model]==key then return end
		glided[model]=key
		if not (actor.state=="Active" and GLIDE[actor.attackName or ""]) then return end
		local root=model:FindFirstChild("HumanoidRootPart")
		if not root then return end
		local floor=kit.floorUnder(fx,root.Position,3,14)
		local at=if floor then floor.Position else root.Position-Vector3.new(0,2.9,0)
		local p=block(fx.folder,Vector3.new(2.2,.08,2.2),CFrame.new(at+Vector3.new(0,.05,0))*CFrame.Angles(0,math.rad(math.random(0,90)),0),ICE,Enum.Material.Glass)
		p.Transparency=.35
		tween(p,.35,{Transparency=1,Size=Vector3.new(2.6,.04,2.6)})
		Debris:AddItem(p,.4)
	end
	local function bones(fx,model,actor,dt)
		local kitOf=KITS[actor.fighterId or ""]
		if not kitOf then return end
		if actor.fighterId=="Mirror" then plate(fx,model,actor) end
		local st=skel[model]
		if st==nil then st=kitOf.build(model) or false;skel[model]=st end
		if not st then return end
		local a=actor.attackName
		local want=if (actor.health or 1)&lt;=0 then nil
			elseif actor.state=="Guarding" then kitOf.guard
			elseif a and (actor.state=="Startup" or actor.state=="Active") then kitOf.use[a]
			else nil
		for name,set in st.sets do
			-- Grow fast in the wind-up (before the contact), retract a little slower.
			local target=if name==want then 1 else 0
			for _,b in set do
				local rate=if target&gt;b.f then 14 else 7
				b.f=if math.abs(target-b.f)&lt;.02 then target else b.f+(target-b.f)*math.min(1,dt*rate)
				if b.f&lt;=.02 then
					if b.part.LocalTransparencyModifier~=1 then b.part.LocalTransparencyModifier=1 end
				else
					local l=b.len*b.f
					b.part.LocalTransparencyModifier=0
					b.part.Size=if b.dir.Z~=0 then Vector3.new(b.thick,b.thick,l) else Vector3.new(b.thick,l,b.thick)
					b.weld.C0=b.anchor*CFrame.new(b.dir*l/2)
				end
			end
		end
	end
	-- Lost in Zabuza's mist (Families.shrouded on the viewer): he fades to a
	-- shadow for the one who cannot see him.
	local faded=setmetatable({},{__mode="k"})
	local function shroud(fx,data,dt,folder)
		local me,them=data.human,data.bot
		if not me or not them or not folder then return end
		local model=folder:FindFirstChild(them.id or "")
		if not model then return end
		local lost=me.family~=nil and me.family.shrouded==true
		if (faded[model]==true)==lost then return end
		faded[model]=lost
		for _,p in model:GetDescendants() do
			if p:IsA("BasePart") and p.Name~="HumanoidRootPart" then p.LocalTransparencyModifier=if lost then .82 else 0 end
		end
	end
	-- Runs before FamilyFX's layer and lets it draw the zone's floor too.
	table.insert(FX.layers,1,{name="Wave1",fighter=function(fx,model,actor,dt) if model then cleaver(fx,model,actor);bones(fx,model,actor,dt or 1/60) end end,
		frame=function(fx,data,dt,folder) shroud(fx,data,dt,folder) end,impact=function(fx,impact,folder)
		if impact.style=="zone" and impact.kind=="mirror" then
			mirrors(fx,impact.position,math.max(3,(impact.radius or 7)-.5),impact.time or 5)
		elseif impact.style=="zone" and impact.kind=="mist" and (impact.radius or 0)&gt;=10 then
			mist(fx,impact.position,impact.radius,impact.time or 6)
		end
		return false
	end})
end
return M
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND149">
          <Properties>
            <string name="Name">Wave1Motion</string>
            <ProtectedString name="Source">-- Roster batch 1 bodies authored from their Combat Bibles (DEC-026). First:
-- Zabuza (docs/characters/ZABUZA.md §2–§7, §11, B): Kubikiribōchō held in
-- both hands from the guard to the recovery (Wave1FX welds it to the right
-- hand; the left hand rides the handle). The weight goes first, the blade
-- follows; the handle works close, the edge works far; every recovery takes
-- the mass back. No fan clip any more.
-- Keys as in Wave4Motion: 0 wind-up, 1 contact ("out"), 2 end of the live
-- window, 3 back to the stance (the server's startup/active/recovery set
-- their length). What is not authored (throws, grab, wall dive) falls back
-- to Itachi's body (Mirage). Presentation only.
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Fighters=require(Shared.Fighters)
local Wave1Motion={}
function Wave1Motion.install(E)
	local K,merge=E.K,E.merge
	local AIR={root={pitch=4},torso={pitch=6},head={pitch=-6},ra={raise=70,out=10,elbow=60},la={raise=66,out=-10,elbow=70},rl={lift=50,knee=86,ankle=-10},ll={lift=30,knee=64,ankle=-10}}
	local function clip(T,keys)
		local out={}
		for i,k in keys do
			local at,pose,ease=k[1],k[2],k[3]
			out[i]=K(at,if pose=="T" then T elseif pose.air then merge(AIR,pose.air) else merge(T,pose),ease)
		end
		return out
	end
	-- The left hand stays on the handle unless a gesture lets it go.
	local function both(ra,extra)
		local la={raise=ra.raise-4,out=(ra.out or 0)-14,twist=(ra.twist or 0),elbow=(ra.elbow or 0)+16,wrist=-10}
		local pose={ra=ra,la=la}
		for key,value in extra or {} do pose[key]=value end
		return pose
	end

	local Z=Fighters.Mist.Motion.stance
	local C={}
	-- L1: the handle, short, into the sternum; the blade stays high on the diagonal.
	C.Light1=clip(Z,{
		{0,both({raise=60,out=10,twist=-10,elbow=96},{root={y=-.6,yaw=30,z=.1},torso={yaw=14}})},
		{1,both({raise=86,out=-6,twist=-10,elbow=24},{root={y=-.62,z=-.35,yaw=20,pitch=6},torso={yaw=-4,pitch=6},lf={z=-.85}}),"out"},
		{2,both({raise=84,out=-6,twist=-10,elbow=28},{root={y=-.62,z=-.36,yaw=20,pitch=6},torso={yaw=-6,pitch=6},lf={z=-.85}})},
		{3,"T"}})
	-- L2: the edge, a horizontal arc right to left at the ribs, 60° of hip.
	C.Light2=clip(Z,{
		{0,both({raise=86,out=70,twist=-30,elbow=30},{root={y=-.62,yaw=58},torso={yaw=44,pitch=2},head={yaw=-30}})},
		{.7,both({raise=88,out=74,twist=-30,elbow=30},{root={y=-.64,yaw=62},torso={yaw=48,pitch=2},head={yaw=-32}})},
		{1,both({raise=90,out=-58,twist=20,elbow=12},{root={y=-.6,z=-.25,yaw=-4,pitch=4},torso={yaw=-40,pitch=4},head={yaw=-6},rf={z=.5,yaw=10}}),"out"},
		{2,both({raise=88,out=-64,twist=20,elbow=14},{root={y=-.6,z=-.26,yaw=-6,pitch=4},torso={yaw=-44,pitch=4},rf={z=.5,yaw=10}})},
		{3,"T"}})
	-- L3: the reverse cut from high left down to the opposite hip; the weight
	-- falls on the front foot and the blade visibly brakes.
	C.Light3=clip(Z,{
		{0,both({raise=156,out=-40,twist=40,elbow=40},{root={y=-.5,yaw=-20,pitch=-4},torso={yaw=-34,pitch=-6},head={pitch=-6}})},
		{.75,both({raise=162,out=-42,twist=40,elbow=44},{root={y=-.48,yaw=-22,pitch=-6},torso={yaw=-36,pitch=-8}})},
		{1,both({raise=26,out=46,twist=-20,elbow=10},{root={y=-.86,z=-.45,yaw=24,pitch=16},torso={yaw=26,pitch=18},head={pitch=8},lf={z=-1.05},rf={z=.8}}),"out"},
		{2,both({raise=20,out=50,twist=-20,elbow=12},{root={y=-.9,z=-.46,yaw=26,pitch=18},torso={yaw=28,pitch=20},lf={z=-1.05},rf={z=.8}})},
		{2.6,both({raise=22,out=48,twist=-20,elbow=16},{root={y=-.84,z=-.4,yaw=24,pitch=14},torso={yaw=24,pitch=16},lf={z=-1.0},rf={z=.8}})},
		{3,"T"}})
	-- Heavy: the cleaver charged over the shoulder, the rear foot pushes, a
	-- long diagonal down; the point ends low and must be taken back.
	C.Heavy=clip(Z,{
		{0,both({raise=172,out=26,twist=-20,elbow=76},{root={y=-.62,yaw=44,pitch=-4,z=.15},torso={yaw=36,pitch=-6},head={yaw=-26},rf={z=.95}})},
		{.8,both({raise=176,out=28,twist=-20,elbow=80},{root={y=-.66,yaw=48,pitch=-6,z=.18},torso={yaw=40,pitch=-8},head={yaw=-28},rf={z=1.0}})},
		{1,both({raise=34,out=-44,twist=24,elbow=8},{root={y=-.88,z=-.7,yaw=-12,pitch=18},torso={yaw=-34,pitch=18},head={pitch=8},lf={z=-1.15},rf={z=.85}}),"out"},
		{2,both({raise=24,out=-48,twist=24,elbow=10},{root={y=-.92,z=-.72,yaw=-14,pitch=20},torso={yaw=-36,pitch=20},lf={z=-1.15},rf={z=.85}})},
		{2.6,both({raise=26,out=-46,twist=24,elbow=14},{root={y=-.86,z=-.64,yaw=-12,pitch=16},torso={yaw=-32,pitch=16},lf={z=-1.1},rf={z=.85}})},
		{3,"T"}})
	-- Forward after two: the handle lifts the forearm, then the blade rises from the hip; the legs push.
	C.CleaverRise=clip(Z,{
		{0,both({raise=100,out=-10,twist=10,elbow=96},{root={y=-.95,pitch=14,yaw=16},torso={pitch=10,yaw=10}})},
		{1,both({raise=170,out=14,twist=-10,elbow=14},{root={y=-.15,z=-.3,pitch=-10,yaw=12},torso={pitch=-12,yaw=-6},head={pitch=-16},rf={toe=-20}}),"out"},
		{2,both({raise=172,out=14,twist=-10,elbow=16},{root={y=-.15,z=-.32,pitch=-12,yaw=12},torso={pitch=-14,yaw=-6},head={pitch=-16},rf={toe=-18}})},
		{3,"T"}})
	-- Side after one: the outer foot steps and the edge covers the flank (not a pirouette).
	C.CleaverArc=clip(Z,{
		{0,both({raise=80,out=-60,twist=30,elbow=30},{root={y=-.66,yaw=-36},torso={yaw=-40},lf={x=.45}})},
		{1,both({raise=84,out=64,twist=-30,elbow=12},{root={y=-.66,yaw=40,pitch=4},torso={yaw=44,pitch=4},head={yaw=-34},lf={x=.7,z=-.6}}),"out"},
		{2,both({raise=82,out=68,twist=-30,elbow=14},{root={y=-.66,yaw=42,pitch=4},torso={yaw=46,pitch=4},lf={x=.7,z=-.6}})},
		{3,"T"}})
	-- Away after two: a low cut as he backs off, the point keeps the space then returns.
	C.CleaverDrop=clip(Z,{
		{0,both({raise=60,out=40,twist=-20,elbow=30},{root={y=-.7,yaw=30},torso={yaw=24,pitch=6}})},
		{1,both({raise=12,out=-44,twist=30,elbow=8},{root={y=-1.05,z=.35,yaw=-10,pitch=22},torso={yaw=-30,pitch=16},lf={z=-.5},rf={z=1.2}}),"out"},
		{2,both({raise=14,out=-40,twist=30,elbow=10},{root={y=-1.0,z=.4,yaw=-8,pitch=20},torso={yaw=-28,pitch=14},lf={z=-.5},rf={z=1.25}})},
		{3,"T"}})
	-- The handle answers a held guard (riposte), and the heavy after one keeps it.
	C.CleaverHilt=clip(Z,{
		{0,both({raise=70,out=20,twist=-20,elbow=100},{root={y=-.58,yaw=34,z=.1},torso={yaw=20}})},
		{1,both({raise=92,out=-10,twist=-10,elbow=14},{root={y=-.6,z=-.4,yaw=12,pitch=8},torso={yaw=-12,pitch=8},lf={z=-.9}}),"out"},
		{2,both({raise=90,out=-10,twist=-10,elbow=16},{root={y=-.6,z=-.42,yaw=10,pitch=8},torso={yaw=-14,pitch=8},lf={z=-.9}})},
		{3,"T"}})
	-- Silent Killing: arrival with the blade already up, the weight behind it.
	C.SilentCleave=clip(Z,{
		{0,both({raise=168,out=20,twist=-20,elbow=60},{root={y=-.6,yaw=40},torso={yaw=34,pitch=-6}})},
		{1,both({raise=30,out=-40,twist=24,elbow=8},{root={y=-.86,z=-.6,yaw=-10,pitch=18},torso={yaw=-30,pitch=18},lf={z=-1.1}}),"out"},
		{2,both({raise=24,out=-44,twist=24,elbow=10},{root={y=-.9,z=-.62,yaw=-12,pitch=20},torso={yaw=-32,pitch=20},lf={z=-1.1}})},
		{3,"T"}})
	-- Air: a short strike of the flat, then the descending terminal cut.
	C.Air1=clip(Z,{
		{0,{air={torso={yaw=24},ra={raise=110,out=40,elbow=60},la={raise=104,out=26,elbow=76}}}},
		{1,{air={torso={yaw=-20,pitch=10},ra={raise=86,out=-30,elbow=12},la={raise=80,out=-44,elbow=28}}},"out"},
		{2,{air={torso={yaw=-22,pitch=10},ra={raise=84,out=-32,elbow=14},la={raise=78,out=-46,elbow=30}}}},
		{3,{air={}}}})
	C.Air2=clip(Z,{
		{0,{air={root={pitch=-8},torso={pitch=-12},ra={raise=168,out=10,elbow=50},la={raise=162,out=-4,elbow=66}}}},
		{1,{air={root={pitch=24},torso={pitch=24},ra={raise=40,out=-10,elbow=8},la={raise=36,out=-24,elbow=24}}},"out"},
		{2,{air={root={pitch=26},torso={pitch=24},ra={raise=38,out=-10,elbow=10},la={raise=34,out=-24,elbow=26}}}},
		{3,{air={}}}})
	C.CleaverDive=clip(Z,{
		{0,{air={root={pitch=-14},torso={pitch=-18},ra={raise=176,out=8,elbow=40},la={raise=170,out=-6,elbow=56}}}},
		{1,{air={root={pitch=34},torso={pitch=30},ra={raise=30,out=-6,elbow=8},la={raise=26,out=-20,elbow=24}}},"out"},
		{2,{air={root={pitch=36},torso={pitch=30},ra={raise=28,out=-6,elbow=10},la={raise=24,out=-20,elbow=26}}}},
		{3,{air={}}}})
	C.Slam=C.CleaverDive
	-- Dash strike: the handle first (an entry, not a brawler's dive).
	C.DashAttack=C.CleaverHilt
	E.CLIPS.Mist=C
	setmetatable(C,{__index=E.CLIPS.Mirage})
	-- A heavy run: shorter stride, little bounce, the blade near the flank.
	E.GAIT.Mist={stride=.9,cadence=.86,arm=6,lean=4,bob=.9,guard=.6,holdRear=false}

	-- Kimimaro (docs/characters/KIMIMARO.md §2–§7, §11, B): a living
	-- skeleton in the blows, not a white sword on a brawler. Wave1FX grows
	-- the bone on the limb that strikes (knuckles, elbow, shin, forearms)
	-- before the contact and retracts it after.
	local K2=Fighters.Bone.Motion.stance
	local B={}
	-- L1: a straight right, the knuckle bones lengthen it; a step in, the elbow by the ribs.
	B.Light1=clip(K2,{
		{0,{ra={raise=62,out=6,twist=10,elbow=112},la={raise=60,out=-10,elbow=100},root={y=-.52,yaw=32},torso={yaw=16}}},
		{1,{ra={raise=88,out=-4,twist=0,elbow=4},la={raise=56,out=-14,elbow=110},root={y=-.52,z=-.35,yaw=10,pitch=6},torso={yaw=-18,pitch=4},lf={z=-.8}},"out"},
		{2,{ra={raise=86,out=-4,twist=0,elbow=8},la={raise=56,out=-14,elbow=110},root={y=-.52,z=-.36,yaw=8,pitch=6},torso={yaw=-20,pitch=4},lf={z=-.8}}},
		{3,"T"}})
	-- L2: the left elbow from outside to the ribs on a turn of the hip; the
	-- spur grows before the contact.
	B.Light2=clip(K2,{
		{0,{la={raise=74,out=56,twist=-10,elbow=128},ra={raise=60,out=-10,elbow=110},root={y=-.56,yaw=34},torso={yaw=30},head={yaw=-20},rf={yaw=40}}},
		{1,{la={raise=88,out=-30,twist=20,elbow=140},ra={raise=56,out=-10,elbow=110},root={y=-.56,z=-.25,yaw=-16,pitch=4},torso={yaw=-40,pitch=4},head={yaw=-6},rf={yaw=60}},"out"},
		{2,{la={raise=86,out=-32,twist=20,elbow=140},ra={raise=56,out=-10,elbow=110},root={y=-.56,z=-.26,yaw=-18,pitch=4},torso={yaw=-42,pitch=4},rf={yaw=60}}},
		{3,"T"}})
	-- L3: a short round kick of the rear leg, hip to shoulder; the shin
	-- spurs bite then retract; a 90° pivot and a visible landing.
	B.Light3=clip(K2,{
		{0,{root={y=-.6,yaw=-34,pitch=6},torso={yaw=-18},ra={raise=56,out=-6,elbow=112},la={raise=56,out=-4,elbow=112},rl={lift=64,out=18,knee=106,ankle=-10},lf={z=-.35,yaw=-30}}},
		{1,{root={y=-.34,yaw=60,pitch=-6,roll=-18},torso={yaw=12,roll=-22},head={roll=14,yaw=-30},ra={raise=-4,out=40,elbow=46},la={raise=62,out=-6,twist=18,elbow=104},rl={lift=84,out=56,twist=-28,knee=12,ankle=-24},lf={z=-.3,yaw=40}},"out"},
		{2,{root={y=-.36,yaw=72,pitch=-4,roll=-16},torso={yaw=16,roll=-18},ra={raise=-4,out=40,elbow=48},la={raise=60,out=-6,twist=18,elbow=104},rl={lift=78,out=58,twist=-30,knee=18,ankle=-20},lf={z=-.3,yaw=52}}},
		{2.5,{root={y=-.56,yaw=50},rl={lift=36,out=18,knee=80},lf={z=-.3,yaw=36}}},
		{3,"T"}})
	-- Heavy: the elbows cross, ribs and forearms make an offensive guard,
	-- then the shoulder pushes; the spurs fold back in the recovery.
	B.Heavy=clip(K2,{
		{0,{ra={raise=82,out=-38,twist=40,elbow=118},la={raise=80,out=-38,twist=40,elbow=120},root={y=-.72,pitch=10,yaw=20,z=.12},torso={pitch=10,yaw=14},head={pitch=4}}},
		{.8,{ra={raise=84,out=-40,twist=40,elbow=120},la={raise=82,out=-40,twist=40,elbow=122},root={y=-.76,pitch=12,yaw=22,z=.14},torso={pitch=12,yaw=16}}},
		{1,{ra={raise=94,out=-20,twist=30,elbow=84},la={raise=92,out=-22,twist=30,elbow=88},root={y=-.6,z=-.65,pitch=14,yaw=-24},torso={pitch=10,yaw=-26},head={yaw=12},lf={z=-1.05},rf={z=.75}},"out"},
		{2,{ra={raise=92,out=-20,twist=30,elbow=86},la={raise=90,out=-22,twist=30,elbow=90},root={y=-.62,z=-.66,pitch=14,yaw=-26},torso={pitch=10,yaw=-28},lf={z=-1.05},rf={z=.75}}},
		{2.6,{ra={raise=80,out=-10,twist=20,elbow=96},la={raise=78,out=-12,twist=20,elbow=100},root={y=-.58,z=-.58,pitch=10,yaw=-20},torso={pitch=8,yaw=-20},lf={z=-1.0},rf={z=.75}}},
		{3,"T"}})
	-- Forward after two: the bone forearm rises under the guard and carries the body (a bounded lift).
	B.BoneRise=clip(K2,{
		{0,{ra={raise=40,out=10,twist=20,elbow=120},la={raise=70,out=-20,elbow=110},root={y=-.95,pitch=14,yaw=14},torso={pitch=12,yaw=10}}},
		{1,{ra={raise=156,out=8,twist=20,elbow=70},la={raise=60,out=-20,elbow=110},root={y=-.2,z=-.3,pitch=-10,yaw=6},torso={pitch=-12,yaw=-6},head={pitch=-14},rf={toe=-20}},"out"},
		{2,{ra={raise=158,out=8,twist=20,elbow=72},la={raise=60,out=-20,elbow=110},root={y=-.2,z=-.32,pitch=-12,yaw=6},torso={pitch=-14,yaw=-6},rf={toe=-18}}},
		{3,"T"}})
	-- Side after one: the flank elbow on an arc of the hip (the bone follows the real limb).
	B.CamelliaArc=clip(K2,{
		{0,{ra={raise=76,out=60,twist=-10,elbow=128},root={y=-.56,yaw=-36},torso={yaw=-40},lf={x=.45}}},
		{1,{ra={raise=88,out=-34,twist=20,elbow=140},root={y=-.56,yaw=40,pitch=4},torso={yaw=44,pitch=4},head={yaw=-30},lf={x=.7,z=-.5}},"out"},
		{2,{ra={raise=86,out=-36,twist=20,elbow=140},root={y=-.56,yaw=42,pitch=4},torso={yaw=46,pitch=4},lf={x=.7,z=-.5}}},
		{3,"T"}})
	-- Away after two: the leg reaps with brief shin spurs, the body backs off.
	B.BoneReap=clip(K2,{
		{0,{root={y=-.8,yaw=-20,pitch=10},torso={yaw=-10,pitch=8},ra={raise=50,out=-10,elbow=110},la={raise=50,out=-10,elbow=110},rl={lift=20,out=10,knee=60}}},
		{1,{root={y=-1.0,z=.35,yaw=46,pitch=16},torso={yaw=20,pitch=12},ra={raise=30,out=30,elbow=60},la={raise=60,out=-20,elbow=100},rl={lift=40,out=60,twist=-20,knee=10,ankle=-10},lf={z=.1,yaw=30}},"out"},
		{2,{root={y=-1.0,z=.4,yaw=52,pitch=16},torso={yaw=22,pitch=12},rl={lift=36,out=62,twist=-20,knee=14},lf={z=.12,yaw=34}}},
		{3,"T"}})
	-- The bone elbow answers a held guard.
	B.BoneElbow=clip(K2,{
		{0,{la={raise=76,out=50,twist=-10,elbow=130},root={y=-.56,yaw=36},torso={yaw=28}}},
		{1,{la={raise=90,out=-30,twist=20,elbow=140},root={y=-.56,z=-.4,yaw=-10,pitch=6},torso={yaw=-36,pitch=6},lf={z=-.85}},"out"},
		{2,{la={raise=88,out=-32,twist=20,elbow=140},root={y=-.56,z=-.42,yaw=-12,pitch=6},torso={yaw=-38,pitch=6},lf={z=-.85}}},
		{3,"T"}})
	-- Willow (signature): a lunge, the forearm bones out ahead.
	B.WillowCut=clip(K2,{
		{0,{ra={raise=60,out=20,elbow=120},la={raise=60,out=20,elbow=120},root={y=-.8,pitch=18,z=.2},torso={pitch=12}}},
		{1,{ra={raise=96,out=-10,twist=20,elbow=20},la={raise=92,out=-14,twist=20,elbow=24},root={y=-.62,z=-.8,pitch=20,yaw=-10},torso={pitch=14,yaw=-14},lf={z=-1.2},rf={z=.9}},"out"},
		{2,{ra={raise=94,out=-10,twist=20,elbow=22},la={raise=90,out=-14,twist=20,elbow=26},root={y=-.62,z=-.82,pitch=20,yaw=-10},torso={pitch=14,yaw=-14},lf={z=-1.2},rf={z=.9}}},
		{3,"T"}})
	-- Air: a knee with a short spur, then the bone heel driven down.
	B.Air1=clip(K2,{
		{0,{air={rl={lift=40,knee=120},ra={raise=80,out=20,elbow=90},la={raise=70,out=10,elbow=90}}}},
		{1,{air={root={pitch=10},rl={lift=110,knee=130},ra={raise=50,out=30,elbow=60},la={raise=60,out=20,elbow=80}}},"out"},
		{2,{air={root={pitch=10},rl={lift=106,knee=128}}}},
		{3,{air={}}}})
	B.Air2=clip(K2,{
		{0,{air={root={pitch=-10},rl={lift=150,knee=10,ankle=-30},ra={raise=40,out=40,elbow=30},la={raise=40,out=40,elbow=30}}}},
		{1,{air={root={pitch=24},rl={lift=40,knee=10,ankle=20},ra={raise=60,out=30,elbow=40},la={raise=60,out=30,elbow=40}}},"out"},
		{2,{air={root={pitch=26},rl={lift=36,knee=12,ankle=20}}}},
		{3,{air={}}}})
	B.BoneHeel=B.Air2
	B.Slam=B.Air2
	-- Dash strike: an elbow entry, the spur born during the push.
	B.DashAttack=clip(K2,{
		{0,{ra={raise=76,out=50,twist=-10,elbow=128},root={y=-.7,pitch=18},torso={pitch=12,yaw=20}}},
		{1,{ra={raise=88,out=-30,twist=20,elbow=140},root={y=-.62,z=-.55,pitch=18,yaw=-16},torso={pitch=12,yaw=-30},lf={z=-1.0}},"out"},
		{2,{ra={raise=86,out=-32,twist=20,elbow=140},root={y=-.62,z=-.56,pitch=18,yaw=-16},torso={pitch=12,yaw=-32},lf={z=-1.0}}},
		{3,"T"}})
	E.CLIPS.Bone=B
	setmetatable(B,{__index=E.CLIPS.Lion})
	-- Fluid, the bones do not trail: a light gliding stride.
	E.GAIT.Bone={stride=1.0,cadence=1.02,arm=5,lean=6,bob=.8,guard=.7,holdRear=false}

	-- Haku (docs/characters/HAKU.md §2–§7, §11, B): precise touches with the
	-- senbon held in the fingers, ice only in the transitions (a spike at the
	-- wrist, a thin plate under the gliding foot: Wave1FX). Not seven
	-- projectiles per light, not an ice mallet.
	local H=Fighters.Mirror.Motion.stance
	local M={}
	-- L1: the right hand pricks obliquely at the shoulder; a short inner step.
	M.Light1=clip(H,{
		{0,{ra={raise=80,out=10,twist=30,elbow=120,wrist=-10},root={y=-.36,yaw=36},torso={yaw=12}}},
		{1,{ra={raise=104,out=-14,twist=20,elbow=24,wrist=-20},root={y=-.38,z=-.25,yaw=14,pitch=4},torso={yaw=-14,pitch=2},lf={z=-.7}},"out"},
		{2,{ra={raise=102,out=-14,twist=20,elbow=28,wrist=-20},root={y=-.38,z=-.26,yaw=12,pitch=4},torso={yaw=-16,pitch=2},lf={z=-.7}}},
		{3,"T"}})
	-- L2: the left palm inside to the forearm, a spike born at the wrist; a
	-- lateral glide on a plate that breaks.
	M.Light2=clip(H,{
		{0,{la={raise=60,out=40,twist=-10,elbow=90,wrist=20},ra={raise=80,out=-10,elbow=110},root={y=-.4,yaw=10,x=.1},torso={yaw=20}}},
		{1,{la={raise=90,out=-20,twist=10,elbow=14,wrist=-40},ra={raise=78,out=-10,elbow=112},root={y=-.42,x=-.4,z=-.15,yaw=-10,pitch=4},torso={yaw=-24,pitch=4},lf={x=-.4}},"out"},
		{2,{la={raise=88,out=-22,twist=10,elbow=16,wrist=-40},ra={raise=78,out=-10,elbow=112},root={y=-.42,x=-.42,z=-.16,yaw=-12,pitch=4},torso={yaw=-26,pitch=4},lf={x=-.4}}},
		{3,"T"}})
	-- L3: the exiting senbon, shoulder to outside while he withdraws; the
	-- outer foot brakes (a small shard marks it).
	M.Light3=clip(H,{
		{0,{ra={raise=110,out=-30,twist=40,elbow=60,wrist=-10},root={y=-.38,yaw=0},torso={yaw=-20}}},
		{1,{ra={raise=90,out=60,twist=-10,elbow=10,wrist=-10},root={y=-.46,z=.3,yaw=40,pitch=-4},torso={yaw=34,pitch=-2},head={yaw=-30},rf={z=.85,x=.4}},"out"},
		{2,{ra={raise=88,out=64,twist=-10,elbow=12,wrist=-10},root={y=-.48,z=.32,yaw=44,pitch=-4},torso={yaw=36,pitch=-2},rf={z=.85,x=.4}}},
		{2.5,{ra={raise=80,out=30,elbow=60},root={y=-.42,z=.2,yaw=34},rf={z=.75,x=.3}}},
		{3,"T"}})
	-- Heavy: the left forearm leans on a short spike, the right hand drives
	-- the senbon in a short push. Readable, little physical push.
	M.Heavy=clip(H,{
		{0,{la={raise=70,out=-10,twist=20,elbow=100,wrist=-20},ra={raise=60,out=20,twist=20,elbow=130,wrist=-10},root={y=-.5,pitch=6,yaw=30,z=.1},torso={pitch=4,yaw=20}}},
		{.8,{la={raise=72,out=-10,twist=20,elbow=102,wrist=-20},ra={raise=58,out=24,twist=20,elbow=134,wrist=-10},root={y=-.52,pitch=8,yaw=32,z=.12},torso={pitch=6,yaw=22}}},
		{1,{la={raise=80,out=-16,twist=20,elbow=90,wrist=-30},ra={raise=94,out=-6,twist=10,elbow=6,wrist=-20},root={y=-.5,z=-.5,pitch=10,yaw=4},torso={pitch=8,yaw=-12},lf={z=-.95},rf={z=.7}},"out"},
		{2,{la={raise=80,out=-16,twist=20,elbow=90,wrist=-30},ra={raise=92,out=-6,twist=10,elbow=8,wrist=-20},root={y=-.5,z=-.52,pitch=10,yaw=2},torso={pitch=8,yaw=-14},lf={z=-.95},rf={z=.7}}},
		{2.6,{la={raise=74,out=-12,elbow=96},ra={raise=86,out=0,elbow=30},root={y=-.46,z=-.44,pitch=8},lf={z=-.9},rf={z=.7}}},
		{3,"T"}})
	-- Forward after two: the wrist takes a hold, a spike lifts the foe's
	-- foot and the palm guides it up.
	M.FrostLift=clip(H,{
		{0,{la={raise=40,out=10,elbow=60,wrist=30},ra={raise=70,out=-10,elbow=110},root={y=-.8,pitch=14,yaw=14},torso={pitch=10,yaw=10}}},
		{1,{la={raise=150,out=10,elbow=20,wrist=-20},ra={raise=80,out=-10,elbow=110},root={y=-.2,z=-.25,pitch=-8,yaw=4},torso={pitch=-10,yaw=-6},head={pitch=-12},rf={toe=-18}},"out"},
		{2,{la={raise=152,out=10,elbow=22,wrist=-20},ra={raise=80,out=-10,elbow=110},root={y=-.2,z=-.26,pitch=-10,yaw=4},torso={pitch=-12,yaw=-6},rf={toe=-16}}},
		{3,"T"}})
	-- Side after one: a lateral glide on ice and a senbon touch.
	M.IceSlide=clip(H,{
		{0,{ra={raise=80,out=-30,twist=40,elbow=110},root={y=-.42,yaw=-24,x=-.2},torso={yaw=-20},lf={x=.3}}},
		{1,{ra={raise=96,out=40,twist=10,elbow=16,wrist=-20},root={y=-.46,x=.6,yaw=30,pitch=4},torso={yaw=30,pitch=2},head={yaw=-26},lf={x=.8,z=-.4}},"out"},
		{2,{ra={raise=94,out=42,twist=10,elbow=18,wrist=-20},root={y=-.46,x=.62,yaw=32,pitch=4},torso={yaw=32,pitch=2},lf={x=.8,z=-.4}}},
		{3,"T"}})
	-- Away after two: a low prick, then the retreat on an ice footing.
	M.SenbonLow=clip(H,{
		{0,{ra={raise=50,out=10,twist=20,elbow=110,wrist=-10},root={y=-.7,yaw=20,pitch=10},torso={yaw=14,pitch=8}}},
		{1,{ra={raise=40,out=-10,twist=10,elbow=10,wrist=-30},root={y=-.95,z=.35,yaw=6,pitch=20},torso={yaw=-10,pitch=16},lf={z=-.4},rf={z=1.15}},"out"},
		{2,{ra={raise=42,out=-10,twist=10,elbow=12,wrist=-30},root={y=-.9,z=.4,yaw=6,pitch=18},torso={yaw=-10,pitch=14},lf={z=-.4},rf={z=1.2}}},
		{3,"T"}})
	-- The senbon to a vital point: the riposte, and the Mirror Step's arrival.
	M.SenbonStab=clip(H,{
		{0,{ra={raise=84,out=0,twist=30,elbow=120,wrist=-10},root={y=-.4,yaw=30,z=.1},torso={yaw=16}}},
		{1,{ra={raise=100,out=-6,twist=20,elbow=6,wrist=-24},root={y=-.42,z=-.4,yaw=8,pitch=6},torso={yaw=-12,pitch=4},head={pitch=2},lf={z=-.85}},"out"},
		{2,{ra={raise=98,out=-6,twist=20,elbow=8,wrist=-24},root={y=-.42,z=-.42,yaw=6,pitch=6},torso={yaw=-14,pitch=4},lf={z=-.85}}},
		{3,"T"}})
	-- Air: a body senbon, then the senbon driven down.
	M.Air1=clip(H,{
		{0,{air={torso={yaw=20},ra={raise=110,out=20,elbow=80,wrist=-10}}}},
		{1,{air={torso={yaw=-16,pitch=8},ra={raise=88,out=-10,elbow=8,wrist=-20}}},"out"},
		{2,{air={torso={yaw=-18,pitch=8},ra={raise=86,out=-10,elbow=10,wrist=-20}}}},
		{3,{air={}}}})
	M.SenbonDive=clip(H,{
		{0,{air={root={pitch=-10},torso={pitch=-12},ra={raise=170,out=6,elbow=30,wrist=-10},la={raise=150,out=-10,elbow=40}}}},
		{1,{air={root={pitch=30},torso={pitch=26},ra={raise=40,out=-6,elbow=6,wrist=-30},la={raise=60,out=-10,elbow=40}}},"out"},
		{2,{air={root={pitch=32},torso={pitch=26},ra={raise=38,out=-6,elbow=8,wrist=-30}}}},
		{3,{air={}}}})
	M.Air2=M.SenbonDive
	M.Slam=M.SenbonDive
	-- Dash strike: a short glide on an ice footing that ends on a planted foot.
	M.DashAttack=clip(H,{
		{0,{ra={raise=80,out=10,twist=30,elbow=120},root={y=-.6,pitch=14},torso={pitch=8}}},
		{1,{ra={raise=100,out=-10,twist=20,elbow=8,wrist=-20},root={y=-.5,z=-.55,pitch=12,yaw=-10},torso={pitch=8,yaw=-16},lf={z=-1.0}},"out"},
		{2,{ra={raise=98,out=-10,twist=20,elbow=10,wrist=-20},root={y=-.5,z=-.56,pitch=12,yaw=-10},torso={pitch=8,yaw=-16},lf={z=-1.0}}},
		{3,"T"}})
	E.CLIPS.Mirror=M
	setmetatable(M,{__index=E.CLIPS.Mirage})
	-- A fine run, limbs close; short gliding steps.
	E.GAIT.Mirror={stride=.95,cadence=1.06,arm=3,lean=6,bob=.7,guard=.6,holdRear=false}
end
return Wave1Motion
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND150">
          <Properties>
            <string name="Name">Wave2FX</string>
            <ProtectedString name="Source">-- Roster 20, batch 2 (Shikamaru, Shino, Orochimaru): the batch's own drawing, installed by
-- Effects like SandFX: projectile builders (kit.BUILD[kind]), FX.poses[kind],
-- and layers in FX.layers ({impact=..., fighter=..., step=..., frame=...}).
-- Most objects need nothing here: Shared/Looks + Client/FamilyFX draw them.
local M={}
function M.install(FX,kit) end
return M
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND151">
          <Properties>
            <string name="Name">Wave3FX</string>
            <ProtectedString name="Source">-- Roster 20, batch 3 (Deidara, Sasori, Nagato, Killer Bee): the batch's own
-- drawing, installed by Effects like SandFX: projectile builders
-- (kit.BUILD[kind]), FX.poses[kind], and layers in FX.layers
-- ({impact=..., fighter=..., step=..., frame=...}). Most objects need nothing
-- here: Shared/Looks + Client/FamilyFX draw them.
local M={}
function M.install(FX,kit)
	local new,block,num=kit.new,kit.block,kit.num
	-- Killer Bee's seven blades (bible KILLER_BEE.md §7): configuration A =
	-- a blade in each hand (continuing the forearm, as Wave3Motion authors
	-- them) and one under the left elbow; four sheathed on the back. For L3
	-- and the knee kick the elbow blade rides behind the right knee, point
	-- out of the body. Lariat / KO: everything goes back to the sheaths (the
	-- three spare ones fill). Presentation only: the server's single contact
	-- is unchanged, no blade adds a hitbox.
	local STEEL=Color3.fromRGB(206,212,220)
	local GRIP=Color3.fromRGB(40,36,40)
	local SHEATH=Color3.fromRGB(70,48,34)
	local KNEE={Light3=true,KneeKick=true}
	local ELBOW={Light2=true,ElbowCut=true}
	local BOTH={Heavy=true,Air2=true}
	local STOW={Lariat=true,LariatArm=true}
	local held=setmetatable({},{__mode="k"})
	local function weld(part0,parts)
		for _,p in parts do p.Anchored=false;p.CanCollide=false;p.CanQuery=false;p.CanTouch=false;p.Massless=true;new("WeldConstraint",{Part0=part0,Part1=p},p) end
	end
	local function show(parts,on) for _,p in parts do p.LocalTransparencyModifier=if on then 0 else 1 end end
	local function trail(blade,from,to)
		local a0=new("Attachment",{Position=from},blade)
		local a1=new("Attachment",{Position=to},blade)
		return new("Trail",{Attachment0=a0,Attachment1=a1,Lifetime=.12,Color=ColorSequence.new(Color3.fromRGB(236,240,248)),LightEmission=.5,
			Transparency=num({{0,.35},{1,1}}),FaceCamera=false,Enabled=false},blade)
	end
	local function handBlade(m,hand)
		local cf=hand.CFrame
		local blade=block(m,Vector3.new(.08,2.4,.26),cf*CFrame.new(0,-1.55,-.04),STEEL,Enum.Material.Metal)
		local guard=block(m,Vector3.new(.34,.08,.34),cf*CFrame.new(0,-.36,0),GRIP,Enum.Material.Metal)
		local grip=block(m,Vector3.new(.16,.6,.16),cf*CFrame.new(0,-.05,0),GRIP,Enum.Material.SmoothPlastic)
		weld(hand,{blade,guard,grip})
		return {blade,guard,grip},trail(blade,Vector3.new(0,-1.1,0),Vector3.new(0,1.1,0))
	end
	local function blades(model)
		local rh,lh=model:FindFirstChild("RightHand"),model:FindFirstChild("LeftHand")
		local la,rl=model:FindFirstChild("LeftLowerArm"),model:FindFirstChild("RightLowerLeg")
		local torso=model:FindFirstChild("UpperTorso")
		if not (rh and lh and la and rl and torso) then return nil end
		local m=new("Model",{Name="SevenBlades"},model)
		local st={}
		st.right,st.rightTrail=handBlade(m,rh)
		st.left,st.leftTrail=handBlade(m,lh)
		-- Under the left elbow: along the forearm, past the elbow, tilted out.
		local e=block(m,Vector3.new(.08,2.1,.24),la.CFrame*CFrame.new(0,.75,.26)*CFrame.Angles(math.rad(14),0,0),STEEL,Enum.Material.Metal)
		weld(la,{e})
		st.elbow={e};st.elbowTrail=trail(e,Vector3.new(0,-1,0),Vector3.new(0,1,0))
		-- Behind the right knee, the point out to the side.
		local k=block(m,Vector3.new(2.1,.24,.08),rl.CFrame*CFrame.new(1.2,.3,.24),STEEL,Enum.Material.Metal)
		local kg=block(m,Vector3.new(.3,.3,.14),rl.CFrame*CFrame.new(.2,.3,.24),GRIP,Enum.Material.SmoothPlastic)
		weld(rl,{k,kg})
		st.knee={k,kg};st.kneeTrail=trail(k,Vector3.new(-1,0,0),Vector3.new(1,0,0))
		-- Seven sheaths fanned on the back; the last three are filled only
		-- while the hand/elbow blades are put away.
		st.sheaths={};st.spare={}
		for i=1,7 do
			local x=(i-4)*.18
			local cf=torso.CFrame*CFrame.new(x,.15,.58)*CFrame.Angles(0,0,math.rad((i-4)*9))
			local s=block(m,Vector3.new(.14,2.2,.16),cf,SHEATH,Enum.Material.Wood)
			local h=block(m,Vector3.new(.12,.42,.12),cf*CFrame.new(0,1.3,0),GRIP,Enum.Material.SmoothPlastic)
			weld(torso,{s})
			weld(torso,{h})
			table.insert(st.sheaths,s)
			if i&gt;=5 then table.insert(st.spare,h) end
		end
		return st
	end
	local function sevenBlades(model,actor)
		if actor.fighterId~="Ink" then return end
		local st=held[model]
		if st==nil then st=blades(model) or false;held[model]=st end
		if not st then return end
		local a=actor.attackName
		local stow=(actor.health or 1)&lt;=0 or (a~=nil and STOW[a]==true)
		local knee=not stow and a~=nil and KNEE[a]==true
		local config=if stow then "stow" elseif knee then "knee" else "A"
		local live=actor.state=="Active" and a~=nil
		st.rightTrail.Enabled=live and not stow and not KNEE[a] and not ELBOW[a]
		st.leftTrail.Enabled=live and BOTH[a]==true
		st.elbowTrail.Enabled=live and ELBOW[a]==true
		st.kneeTrail.Enabled=live and knee
		if st.config==config then return end
		st.config=config
		show(st.right,not stow);show(st.left,not stow)
		show(st.elbow,config=="A");show(st.knee,knee)
		show(st.spare,stow)
	end
	table.insert(FX.layers,{name="Wave3",fighter=function(fx,model,actor,dt) if model then sevenBlades(model,actor) end end})
end
return M
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND152">
          <Properties>
            <string name="Name">Wave3Motion</string>
            <ProtectedString name="Source">-- Roster batch 3 bodies authored from their Combat Bibles (DEC-026). First:
-- Killer Bee (docs/characters/KILLER_BEE.md §2–§7, §11, B): a young
-- swordsman with seven blades. Configuration A = a blade in each hand and a
-- third held under the left elbow, four (seven when he stows) sheathed on
-- the back (Wave3FX draws and moves them). Each light strikes from another
-- grip: L1 the right hand, L2 the elbow, L3 the back of the right knee; the
-- heavy opens two blades in an X. The hand blades continue the forearm, so
-- these arm angles are the blades' angles.
-- Keys as in Wave1Motion: 0 wind-up, 1 contact ("out"), 2 end of the live
-- window, 3 back to the stance. What is not authored (throws, grab, wall
-- dive) falls back to the Lion body. Presentation only.
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Fighters=require(Shared.Fighters)
local Wave3Motion={}
function Wave3Motion.install(E)
	local K,merge=E.K,E.merge
	local AIR={root={pitch=4},torso={pitch=6},head={pitch=-6},ra={raise=70,out=10,elbow=50},la={raise=66,out=10,elbow=60},rl={lift=50,knee=86,ankle=-10},ll={lift=30,knee=64,ankle=-10}}
	local function clip(T,keys)
		local out={}
		for i,k in keys do
			local at,pose,ease=k[1],k[2],k[3]
			out[i]=K(at,if pose=="T" then T elseif pose.air then merge(AIR,pose.air) else merge(T,pose),ease)
		end
		return out
	end
	-- The off blade keeps a guard while the other one works.
	local RGUARD={raise=96,out=-14,twist=10,elbow=50}
	local LGUARD={raise=92,out=-18,twist=10,elbow=56}

	local B=Fighters.Ink.Motion.stance
	local C={}
	-- L1: the right-hand blade on the diagonal, right hip to the opposite
	-- shoulder; an inner step; the left blade stays up.
	C.Light1=clip(B,{
		{0,{ra={raise=14,out=44,twist=-10,elbow=14},la=LGUARD,root={y=-.56,yaw=30},torso={yaw=18}}},
		{1,{ra={raise=126,out=-36,twist=20,elbow=10},la=LGUARD,root={y=-.52,z=-.45,yaw=8,pitch=6},torso={yaw=-22,pitch=4},lf={z=-.75}},"out"},
		{2,{ra={raise=128,out=-38,twist=20,elbow=12},la=LGUARD,root={y=-.52,z=-.46,yaw=6,pitch=6},torso={yaw=-24,pitch=4},lf={z=-.75}}},
		{3,"T"}})
	-- L2: the blade under the left elbow, a reverse cut from outside to the
	-- ribs on the way back (60° of pivot, not a full turn); the left hand has
	-- taken the other grip and the elbow leads.
	C.Light2=clip(B,{
		{0,{la={raise=84,out=-56,twist=20,elbow=124},ra=RGUARD,root={y=-.6,yaw=52},torso={yaw=36},head={yaw=-28}}},
		{.7,{la={raise=86,out=-58,twist=20,elbow=126},ra=RGUARD,root={y=-.62,yaw=56},torso={yaw=40},head={yaw=-30}}},
		{1,{la={raise=88,out=54,twist=-10,elbow=120},ra=RGUARD,root={y=-.56,z=-.3,yaw=-8,pitch=4},torso={yaw=-38,pitch=4},head={yaw=-4},rf={z=.45,yaw=12}},"out"},
		{2,{la={raise=86,out=58,twist=-10,elbow=120},ra=RGUARD,root={y=-.56,z=-.3,yaw=-10,pitch=4},torso={yaw=-40,pitch=4},rf={z=.45,yaw=12}}},
		{3,"T"}})
	-- L3: the freed blade rides behind the right knee, point out of the body;
	-- a small hip kick swings it flat into the flank, the hand takes it back.
	C.Light3=clip(B,{
		{0,{ra=RGUARD,la=LGUARD,root={y=-.5,yaw=-30,roll=6},torso={yaw=-10},rl={lift=30,out=6,knee=104,ankle=-10},lf={z=-.3,yaw=-30}}},
		{1,{ra={raise=70,out=30,elbow=40},la={raise=80,out=-20,elbow=60},root={y=-.42,yaw=44,roll=-14},torso={yaw=18,roll=-12},head={yaw=-34},rl={lift=56,out=64,twist=-20,knee=92,ankle=-14},lf={z=-.3,yaw=36}},"out"},
		{2,{ra={raise=70,out=30,elbow=40},la={raise=80,out=-20,elbow=60},root={y=-.44,yaw=54,roll=-12},torso={yaw=20,roll=-10},rl={lift=52,out=66,twist=-20,knee=94,ankle=-14},lf={z=-.3,yaw=44}}},
		{2.5,{ra={raise=40,out=10,elbow=60},root={y=-.52,yaw=30},rl={lift=20,out=14,knee=70},lf={z=-.3,yaw=24}}},
		{3,"T"}})
	-- Heavy: the crossed guard opens in an X, the shoulder carries the
	-- weight; two blades on distinct planes, one accent. A long take-back.
	C.Heavy=clip(B,{
		{0,{ra={raise=150,out=-40,twist=20,elbow=24},la={raise=146,out=-40,twist=20,elbow=26},root={y=-.62,pitch=-4,z=.12},torso={pitch=-8},head={pitch=-6}}},
		{.8,{ra={raise=156,out=-44,twist=20,elbow=26},la={raise=150,out=-44,twist=20,elbow=28},root={y=-.64,pitch=-6,z=.14},torso={pitch=-10}}},
		{1,{ra={raise=50,out=56,twist=-10,elbow=4},la={raise=64,out=52,twist=-10,elbow=6},root={y=-.78,z=-.6,pitch=16,yaw=10},torso={pitch=14,yaw=8},head={pitch=6},lf={z=-1.0},rf={z=.8}},"out"},
		{2,{ra={raise=44,out=60,twist=-10,elbow=6},la={raise=58,out=56,twist=-10,elbow=8},root={y=-.8,z=-.62,pitch=18,yaw=10},torso={pitch=16,yaw=8},lf={z=-1.0},rf={z=.8}}},
		{2.6,{ra={raise=50,out=50,twist=-10,elbow=14},la={raise=60,out=46,twist=-10,elbow=16},root={y=-.74,z=-.54,pitch=14,yaw=8},torso={pitch=12},lf={z=-.95},rf={z=.8}}},
		{3,"T"}})
	-- Forward after two: the elbow blade beats the guard down, then the
	-- shoulder and the right blade lift the body (a wrestler's push, not an uppercut).
	C.BladeLift=clip(B,{
		{0,{la={raise=70,out=-36,elbow=126},ra={raise=30,out=20,elbow=30},root={y=-.95,pitch=16,yaw=14},torso={pitch=12,yaw=10}}},
		{1,{la={raise=118,out=10,elbow=100},ra={raise=168,out=10,twist=-10,elbow=8},root={y=-.2,z=-.35,pitch=-10,yaw=6},torso={pitch=-12,yaw=-6},head={pitch=-16},rf={toe=-20}},"out"},
		{2,{la={raise=120,out=10,elbow=100},ra={raise=170,out=10,twist=-10,elbow=10},root={y=-.2,z=-.36,pitch=-12,yaw=6},torso={pitch=-14,yaw=-6},rf={toe=-18}}},
		{3,"T"}})
	-- Side after one: the hand and elbow blades change places, the outer foot
	-- steps out; one edge makes the contact.
	C.BladeSwap=clip(B,{
		{0,{ra={raise=92,out=-50,twist=20,elbow=22},la={raise=70,out=-30,elbow=110},root={y=-.56,yaw=-30},torso={yaw=-34},lf={x=.4}}},
		{1,{ra={raise=90,out=62,twist=-20,elbow=8},la={raise=86,out=-20,elbow=120},root={y=-.56,yaw=38,pitch=4},torso={yaw=42,pitch=4},head={yaw=-30},lf={x=.7,z=-.5}},"out"},
		{2,{ra={raise=88,out=66,twist=-20,elbow=10},la={raise=86,out=-20,elbow=120},root={y=-.56,yaw=40,pitch=4},torso={yaw=44,pitch=4},lf={x=.7,z=-.5}}},
		{3,"T"}})
	-- Away after two: blades barred across, a retreating kick that puts the
	-- knee blade between them; the configuration closes.
	C.KneeKick=clip(B,{
		{0,{ra={raise=104,out=-40,twist=30,elbow=60},la={raise=100,out=-40,twist=30,elbow=64},root={y=-.6,yaw=-20},rl={lift=40,knee=110,ankle=-10}}},
		{1,{ra={raise=104,out=-40,twist=30,elbow=60},la={raise=100,out=-40,twist=30,elbow=64},root={y=-.4,z=.35,yaw=36,pitch=-6,roll=-10},torso={yaw=12,pitch=-6},rl={lift=88,out=40,twist=-20,knee=66,ankle=-20},lf={z=.1,yaw=30}},"out"},
		{2,{ra={raise=102,out=-40,twist=30,elbow=62},la={raise=98,out=-40,twist=30,elbow=66},root={y=-.42,z=.4,yaw=40,pitch=-6,roll=-8},rl={lift=84,out=42,twist=-20,knee=70},lf={z=.12,yaw=34}}},
		{3,"T"}})
	-- The blade nobody expected answers a held guard: the elbow.
	C.ElbowCut=clip(B,{
		{0,{la={raise=82,out=-50,twist=20,elbow=130},ra=RGUARD,root={y=-.58,yaw=40},torso={yaw=30}}},
		{1,{la={raise=90,out=46,twist=-10,elbow=124},ra=RGUARD,root={y=-.56,z=-.4,yaw=-6,pitch=6},torso={yaw=-34,pitch=6},lf={z=-.85}},"out"},
		{2,{la={raise=88,out=48,twist=-10,elbow=124},ra=RGUARD,root={y=-.56,z=-.42,yaw=-8,pitch=6},torso={yaw=-36,pitch=6},lf={z=-.85}}},
		{3,"T"}})
	-- Air: one return cut, then the finisher — two blades crossing in a big X.
	C.Air1=clip(B,{
		{0,{air={torso={yaw=24},ra={raise=140,out=30,elbow=10},la={raise=96,out=-20,elbow=50}}}},
		{1,{air={torso={yaw=-20,pitch=10},ra={raise=50,out=-30,elbow=8},la={raise=96,out=-20,elbow=50}}},"out"},
		{2,{air={torso={yaw=-22,pitch=10},ra={raise=48,out=-32,elbow=10},la={raise=96,out=-20,elbow=50}}}},
		{3,{air={}}}})
	C.Air2=clip(B,{
		{0,{air={root={pitch=-8},torso={pitch=-10},ra={raise=160,out=44,elbow=8},la={raise=158,out=44,elbow=8}}}},
		{1,{air={root={pitch=20},torso={pitch=20},ra={raise=60,out=-44,elbow=4},la={raise=56,out=-44,elbow=4}}},"out"},
		{2,{air={root={pitch=22},torso={pitch=20},ra={raise=56,out=-46,elbow=6},la={raise=52,out=-46,elbow=6}}}},
		{3,{air={}}}})
	-- Air down: the blade brought down (not every weapon thrown).
	C.BladeFall=clip(B,{
		{0,{air={root={pitch=-14},torso={pitch=-16},ra={raise=174,out=8,elbow=10},la={raise=110,out=-20,elbow=50}}}},
		{1,{air={root={pitch=32},torso={pitch=28},ra={raise=36,out=-6,elbow=4},la={raise=80,out=-20,elbow=50}}},"out"},
		{2,{air={root={pitch=34},torso={pitch=28},ra={raise=34,out=-6,elbow=6},la={raise=78,out=-20,elbow=52}}}},
		{3,{air={}}}})
	C.Slam=C.BladeFall
	-- Dash strike: a shoulder entry under a covering blade.
	C.DashAttack=clip(B,{
		{0,{la={raise=112,out=-40,twist=20,elbow=60},ra={raise=30,out=10,elbow=40},root={y=-.7,pitch=20},torso={pitch=14,yaw=-10}}},
		{1,{la={raise=112,out=-40,twist=20,elbow=60},ra={raise=96,out=10,elbow=6},root={y=-.62,z=-.55,pitch=20,yaw=-16},torso={pitch=14,yaw=-24},lf={z=-1.0}},"out"},
		{2,{la={raise=110,out=-40,twist=20,elbow=62},ra={raise=94,out=10,elbow=8},root={y=-.62,z=-.56,pitch=20,yaw=-16},torso={pitch=14,yaw=-24},lf={z=-1.0}}},
		{3,"T"}})
	E.CLIPS.Ink=C
	setmetatable(C,{__index=E.CLIPS.Lion})
	-- Wide but mobile, the weight alternates; two blades steady while running.
	E.GAIT.Ink={stride=1.0,cadence=1.04,arm=4,lean=6,bob=1.1,guard=.6,holdRear=false}
end
return Wave3Motion
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND153">
          <Properties>
            <string name="Name">Wave4FX</string>
            <ProtectedString name="Source">-- DEC-026 newcomers (Madara, Hashirama, Hiruzen as children): the weapons
-- their bodies fight with, installed by Effects. Presentation only; the
-- server's strike is the contact.
--   Madara: the short sword leaves the scabbard for his right hand while he
--     strikes or guards (a trail on the live edge); the hilt at the hip hides.
--   Hashirama: a sheath of wood grows over the forearms while a strike is
--     live, and the small grips his routes name (a stump under the launcher,
--     a low root for the brake, the awakening's root at the contact point).
--   Hiruzen: the dark staff, always in his hands.
--   Both Katon breaths: a short cone of fire ahead of the caster.
local Debris=game:GetService("Debris")
local M={}
function M.install(FX,kit)
	local new,block,tween,flash,shockRing,num,TEX,smokePuff=kit.new,kit.block,kit.tween,kit.flash,kit.shockRing,kit.num,kit.TEX,kit.smokePuff
	local held=setmetatable({},{__mode="k"})
	local function weld(hand,parts)
		for _,p in parts do p.Anchored=false;p.CanCollide=false;p.CanQuery=false;p.CanTouch=false;p.Massless=true;new("WeldConstraint",{Part0=hand,Part1=p},p) end
	end
	local function live(actor) return actor.attackName~=nil and (actor.state=="Startup" or actor.state=="Active" or actor.state=="Recovery") end
	local function show(parts,on) for _,p in parts do p.LocalTransparencyModifier=if on then 0 else 1 end end
	local function trail(blade,from,to,color)
		local a0=new("Attachment",{Position=from},blade)
		local a1=new("Attachment",{Position=to},blade)
		return new("Trail",{Attachment0=a0,Attachment1=a1,Lifetime=.12,Color=ColorSequence.new(color),LightEmission=.5,
			Transparency=num({{0,.35},{1,1}}),FaceCamera=false,Enabled=false},blade)
	end

	local function sword(model,actor)
		local st=held[model]
		if not st then
			local hand=model:FindFirstChild("RightHand")
			if not hand then return end
			local m=new("Model",{Name="HeldSword"},model)
			local cf=hand.CFrame
			local blade=block(m,Vector3.new(.1,.28,2.5),cf*CFrame.new(0,-.2,-1.75),Color3.fromRGB(200,206,214),Enum.Material.Metal)
			local guard=block(m,Vector3.new(.5,.12,.12),cf*CFrame.new(0,-.2,-.45),Color3.fromRGB(50,44,40),Enum.Material.Metal)
			local grip=block(m,Vector3.new(.16,.16,.7),cf*CFrame.new(0,-.2,0),Color3.fromRGB(60,40,30),Enum.Material.SmoothPlastic)
			weld(hand,{blade,guard,grip})
			st={parts={blade,guard,grip},trail=trail(blade,Vector3.new(0,0,-1.2),Vector3.new(0,0,1.2),Color3.fromRGB(230,236,244)),shown=nil};held[model]=st
		end
		local drawn=live(actor) or actor.state=="Guarding" or actor.state=="TechniqueChannel"
		st.trail.Enabled=actor.state=="Active" and actor.attackName~=nil
		if st.shown==drawn then return end
		st.shown=drawn
		show(st.parts,drawn)
		local hilt=model:FindFirstChild("Hilt")
		if hilt and hilt:IsA("BasePart") then hilt.LocalTransparencyModifier=if drawn then 1 else 0 end
	end

	local function staff(model,actor)
		local st=held[model]
		if not st then
			local hand=model:FindFirstChild("RightHand")
			if not hand then return end
			local m=new("Model",{Name="HeldStaff"},model)
			local cf=hand.CFrame
			local pole=block(m,Vector3.new(.22,.22,5.4),cf*CFrame.new(0,-.2,-.7),Color3.fromRGB(70,50,36),Enum.Material.Wood)
			local cap1=block(m,Vector3.new(.26,.26,.2),cf*CFrame.new(0,-.2,-3.35),Color3.fromRGB(40,32,26),Enum.Material.SmoothPlastic)
			local cap2=block(m,Vector3.new(.26,.26,.2),cf*CFrame.new(0,-.2,1.95),Color3.fromRGB(40,32,26),Enum.Material.SmoothPlastic)
			weld(hand,{pole,cap1,cap2})
			st={trail=trail(pole,Vector3.new(0,0,-2.6),Vector3.new(0,0,-1.2),Color3.fromRGB(236,220,190))};held[model]=st
		end
		st.trail.Enabled=actor.state=="Active" and actor.attackName~=nil
	end

	local WOOD=Color3.fromRGB(132,96,60)
	local LEAF=Color3.fromRGB(110,160,80)
	local function grip(fx,at,height,width,time)
		local floor=kit.floorUnder(fx,at,3,14)
		local base=if floor then floor.Position else at-Vector3.new(0,2.8,0)
		local stump=block(fx.folder,Vector3.new(width,.2,width),CFrame.new(base),WOOD,Enum.Material.Wood)
		stump.Shape=Enum.PartType.Cylinder;stump.CFrame=CFrame.new(base)*CFrame.Angles(0,0,math.rad(90))
		tween(stump,.12,{Size=Vector3.new(height,width,width),CFrame=CFrame.new(base+Vector3.new(0,height/2,0))*CFrame.Angles(0,0,math.rad(90))})
		local bud=block(fx.folder,Vector3.new(.4,.4,.4),CFrame.new(base+Vector3.new(width*.4,height*.8,0)),LEAF,Enum.Material.Grass)
		task.delay(time,function()
			if stump.Parent then tween(stump,.25,{Size=Vector3.new(.2,width,width),CFrame=CFrame.new(base)*CFrame.Angles(0,0,math.rad(90)),Transparency=1}) end
			if bud.Parent then tween(bud,.2,{Transparency=1}) end
		end)
		Debris:AddItem(stump,time+.4);Debris:AddItem(bud,time+.4)
		smokePuff(fx.folder,base+Vector3.new(0,.4,0),Color3.fromRGB(150,120,90),6,1.2)
	end
	local GRIPS={StumpRise={reach=3.2,height=2.6,width=1.6,time=.7},RootRise={reach=3.4,height=3.2,width=1.2,time=.8},RootBrake={reach=2.4,height=1,width=.9,time=1.1}}
	local function wood(fx,model,actor)
		local st=held[model]
		if not st then
			local sheaths={}
			for _,side in {"Left","Right"} do
				local arm=model:FindFirstChild(side.."LowerArm")
				if arm then
					local s=block(model,Vector3.new(.74,1.0,.74),arm.CFrame*CFrame.new(0,-.05,0),WOOD,Enum.Material.Wood)
					weld(arm,{s});table.insert(sheaths,s)
				end
			end
			if #sheaths==0 then return end
			st={parts=sheaths,shown=nil,serial=nil};held[model]=st
		end
		local on=actor.state=="Active" and actor.attackName~=nil
		if st.shown~=on then st.shown=on;show(st.parts,on) end
		-- The grip a route grows, once per strike, as its contact opens.
		local key=actor.state=="Active" and actor.attackName and GRIPS[actor.attackName] and (actor.attackName..tostring(actor.attackSerial or actor.attackAt or ""))
		if key and key~=st.serial then
			st.serial=key
			local root=model:FindFirstChild("HumanoidRootPart")
			local g=GRIPS[actor.attackName]
			if root then grip(fx,root.Position+root.CFrame.LookVector*g.reach,g.height,g.width,g.time) end
		elseif not key and actor.state~="Active" then st.serial=nil end
	end

	local function breath(fx,position,direction,reach)
		local look=if direction and direction.Magnitude&gt;.1 then direction.Unit else Vector3.zAxis
		local from=position+Vector3.new(0,1.2,0)+look*1.2
		local holder=kit.anchorPart(fx.folder,from)
		holder.CFrame=CFrame.lookAt(from,from+look)
		local e=new("ParticleEmitter",{Texture=TEX.glow,Rate=260,Lifetime=NumberRange.new(.22,.32),Speed=NumberRange.new(reach*2.6,reach*3.2),
			SpreadAngle=Vector2.new(22,22),EmissionDirection=Enum.NormalId.Front,LightEmission=1,
			Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(255,240,180)),ColorSequenceKeypoint.new(.4,Color3.fromRGB(255,150,50)),ColorSequenceKeypoint.new(1,Color3.fromRGB(150,40,20))}),
			Size=num({{0,.8},{.6,3.2},{1,4}}),Transparency=num({{0,.1},{.7,.4},{1,1}}),Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-90,90)},holder)
		local light=new("PointLight",{Color=Color3.fromRGB(255,150,60),Brightness=3,Range=reach*1.6},holder)
		task.delay(.3,function() if e.Parent then e.Enabled=false end;if light.Parent then tween(light,.25,{Brightness=0}) end end)
		Debris:AddItem(holder,1)
		flash(fx.folder,from,Color3.fromRGB(255,170,70),1,5,.2,.3)
	end

	table.insert(FX.layers,1,{name="Wave4",fighter=function(fx,model,actor,dt)
		if not model then return end
		if actor.fighterId=="Rival" then sword(model,actor)
		elseif actor.fighterId=="Professor" then staff(model,actor)
		elseif actor.fighterId=="Sapling" then wood(fx,model,actor) end
	end,impact=function(fx,impact,folder)
		if impact.style=="look" and impact.kind=="firebreath" and impact.radius then
			breath(fx,impact.position,impact.direction,impact.radius)
			return true
		end
		return false
	end})
end
return M
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND154">
          <Properties>
            <string name="Name">Wave4Motion</string>
            <ProtectedString name="Source">-- DEC-026 newcomers: the bodies of Madara, Hashirama and Hiruzen as children
-- (bibles docs/characters/{MADARA,HASHIRAMA,HIRUZEN}_CHILD.md §3–§6, §11).
-- Added to the motion engine's clip table by install(E), like GaleMotion.
-- Keys: 0 wind-up, 1 contact ("out"), 2 end of the live window, 3 back to the
-- stance; the server's startup/active/recovery set how long each takes, so
-- the contact frame is the strike's. What they do not author (throws, grabs,
-- dash strike, wall dive) falls back to their body family's clips.
-- Presentation only.
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Fighters=require(Shared.Fighters)
local Wave4Motion={}
function Wave4Motion.install(E)
	local K,merge=E.K,E.merge
	local AIR={root={pitch=4},torso={pitch=6},head={pitch=-6},ra={raise=60,out=30,elbow=70},la={raise=40,out=30,elbow=60},rl={lift=50,knee=86,ankle=-10},ll={lift=30,knee=64,ankle=-10}}
	local function air(over) return merge(AIR,over) end
	local function clip(T,keys)
		local out={}
		for i,k in keys do
			local at,pose,ease=k[1],k[2],k[3]
			out[i]=K(at,if pose=="T" then T elseif pose.air then air(pose.air) else merge(T,pose),ease)
		end
		return out
	end

	-- Madara: the right hand is the sword hand (Wave4FX), the left is free.
	local M=Fighters.Rival.Motion.stance
	local C={}
	C.Light1=clip(M,{ -- right short sword, diagonal from high right to the left hip
		{0,{root={y=-.46,yaw=40},torso={yaw=26,pitch=-4},ra={raise=150,out=46,twist=-20,elbow=50,wrist=0},la={raise=50,out=-10,elbow=60}}},
		{1,{root={y=-.52,z=-.3,yaw=2,pitch=8},torso={yaw=-30,pitch=8},head={yaw=-6},ra={raise=40,out=-46,twist=30,elbow=10},la={raise=30,out=24,elbow=50},lf={z=-.8},rf={z=.7}},"out"},
		{2,{root={y=-.52,z=-.32,yaw=0,pitch=8},torso={yaw=-34,pitch=8},ra={raise=36,out=-50,twist=30,elbow=12},la={raise=30,out=24,elbow=50},lf={z=-.8},rf={z=.7}}},
		{3,"T"}})
	C.Light2=clip(M,{ -- the sword hand drawn back, the left palm (pommel side) into the sternum
		{0,{root={y=-.44,yaw=34},torso={yaw=22},ra={raise=40,out=30,elbow=96},la={raise=60,out=10,elbow=100,wrist=-10}}},
		{1,{root={y=-.48,z=-.26,yaw=10,pitch=6},torso={yaw=-18,pitch=6},ra={raise=30,out=40,elbow=100},la={raise=88,out=-6,elbow=6,wrist=-40},lf={z=-.72}},"out"},
		{2,{root={y=-.48,z=-.28,yaw=8,pitch=6},torso={yaw=-20,pitch=6},ra={raise=30,out=40,elbow=100},la={raise=86,out=-6,elbow=8,wrist=-40},lf={z=-.72}}},
		{3,"T"}})
	C.Light3=clip(M,{ -- the reverse cut, hip to shoulder, on a 60° pivot
		{0,{root={y=-.6,yaw=-20},torso={yaw=-40,pitch=6},ra={raise=20,out=-50,twist=40,elbow=30},la={raise=40,out=30,elbow=60}}},
		{1,{root={y=-.48,z=-.4,yaw=50,pitch=-2},torso={yaw=30,pitch=-4},head={yaw=-20},ra={raise=150,out=60,twist=-20,elbow=10},la={raise=20,out=-10,elbow=70},lf={z=-.9},rf={z=.8,yaw=50}},"out"},
		{2,{root={y=-.48,z=-.42,yaw=54,pitch=-2},torso={yaw=34,pitch=-4},ra={raise=154,out=62,twist=-20,elbow=12},la={raise=20,out=-10,elbow=70},lf={z=-.9},rf={z=.8,yaw=50}}},
		{3,"T"}})
	C.Heavy=clip(M,{ -- the shoulder charges in behind a big diagonal
		{0,{root={y=-.7,yaw=50,pitch=6},torso={yaw=36,pitch=8},ra={raise=160,out=30,elbow=60},la={raise=70,out=-20,elbow=80}}},
		{.75,{root={y=-.74,yaw=54,pitch=6},torso={yaw=40,pitch=8},ra={raise=166,out=32,elbow=64},la={raise=70,out=-20,elbow=80}}},
		{1,{root={y=-.8,z=-.6,yaw=-10,pitch=16},torso={yaw=-34,pitch=14},head={pitch=6},ra={raise=30,out=-50,elbow=6},la={raise=20,out=30,elbow=40},lf={z=-1.1},rf={z=.9}},"out"},
		{2,{root={y=-.8,z=-.62,yaw=-12,pitch=16},torso={yaw=-36,pitch=14},ra={raise=28,out=-52,elbow=8},la={raise=20,out=30,elbow=40},lf={z=-1.1},rf={z=.9}}},
		{3,"T"}})
	C.QuillonRise=clip(M,{ -- the quillon catches the guard low, then a short rising cut
		{0,{root={y=-.9,pitch=16,yaw=20},torso={pitch=10,yaw=10},ra={raise=40,out=-20,twist=30,elbow=40},la={raise=70,out=-10,elbow=40}}},
		{1,{root={y=-.2,z=-.3,pitch=-10,yaw=10},torso={pitch=-12},head={pitch=-16},ra={raise=168,out=10,elbow=10},la={raise=20,out=30,elbow=40},rf={toe=-20}},"out"},
		{2,{root={y=-.2,z=-.32,pitch=-12,yaw=10},torso={pitch=-14},head={pitch=-16},ra={raise=172,out=10,elbow=12},la={raise=20,out=30,elbow=40},rf={toe=-18}}},
		{3,"T"}})
	C.GuardCut=clip(M,{ -- an outer step and a cut on the guarding arm
		{0,{root={y=-.5,yaw=60},torso={yaw=40},ra={raise=110,out=60,twist=-20,elbow=40},la={raise=50,out=-10,elbow=60},lf={x=.4}}},
		{1,{root={y=-.5,yaw=-10,pitch=6},torso={yaw=-30,pitch=6},ra={raise=80,out=-30,twist=20,elbow=10},la={raise=20,out=30,elbow=40},lf={x=.6,z=-.7}},"out"},
		{2,{root={y=-.5,yaw=-14,pitch=6},torso={yaw=-32,pitch=6},ra={raise=78,out=-34,twist=20,elbow=12},la={raise=20,out=30,elbow=40},lf={x=.6,z=-.7}}},
		{3,"T"}})
	C.HeelBarrier=clip(M,{ -- a low heel to the shin, the blade held across as he backs off
		{0,{root={y=-.6,pitch=-4,yaw=20},ra={raise=80,out=-60,twist=60,elbow=30},la={raise=40,out=30,elbow=60},rl={lift=50,knee=90}}},
		{1,{root={y=-.62,pitch=-8,yaw=10},torso={pitch=-6},ra={raise=84,out=-64,twist=60,elbow=20},la={raise=30,out=40,elbow=50},rl={lift=40,knee=10,ankle=30}},"out"},
		{2,{root={y=-.62,pitch=-8,yaw=10},torso={pitch=-6},ra={raise=84,out=-64,twist=60,elbow=20},la={raise=30,out=40,elbow=50},rl={lift=36,knee=14,ankle=30}}},
		{3,"T"}})
	C.PommelRiposte=clip(M,{ -- the pommel punched straight in off the parry
		{0,{root={y=-.46,yaw=30},torso={yaw=16},ra={raise=60,out=10,elbow=110},la={raise=60,out=-10,elbow=60}}},
		{1,{root={y=-.5,z=-.3,yaw=6,pitch=6},torso={yaw=-16,pitch=6},ra={raise=88,out=-6,elbow=8},la={raise=30,out=30,elbow=50},lf={z=-.8}},"out"},
		{2,{root={y=-.5,z=-.32,yaw=4,pitch=6},torso={yaw=-18,pitch=6},ra={raise=86,out=-6,elbow=10},la={raise=30,out=30,elbow=50},lf={z=-.8}}},
		{3,"T"}})
	C.SharinganCut=clip(M,{ -- awake: round the guard, a cut at an angle
		{0,{root={y=-.5,yaw=-30},torso={yaw=-30},ra={raise=100,out=-40,twist=40,elbow=40},la={raise=50,out=20,elbow=60}}},
		{1,{root={y=-.52,yaw=70,pitch=6},torso={yaw=36,pitch=6},head={yaw=-30},ra={raise=90,out=70,twist=-30,elbow=8},la={raise=20,out=-10,elbow=70},lf={x=.5,z=-.6}},"out"},
		{2,{root={y=-.52,yaw=74,pitch=6},torso={yaw=38,pitch=6},ra={raise=88,out=74,twist=-30,elbow=10},la={raise=20,out=-10,elbow=70},lf={x=.5,z=-.6}}},
