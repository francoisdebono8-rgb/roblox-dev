   end
   confirm();assert(c:request(a,"Attack"));step(c,.02)
   a.move=a.root.CFrame.LookVector
   assert(c:request(a,"Attack"));assert(a.buffered and a.buffered.intent[1]=="forward")
   a.move=Vector3.zero
