        <Item class="ModuleScript" referent="ND92">
          <Properties>
            <string name="Name">AuthoredClips</string>
            <ProtectedString name="Source">-- GENERATED by tools/blender/clips_to_luau.py from the Blender pipeline
-- The clips are split over AuthoredClips1..31 (module size); merged here.
local all={}
for name,clip in require(script.Parent.AuthoredClips1) do all[name]=clip end
for name,clip in require(script.Parent.AuthoredClips2) do all[name]=clip end
