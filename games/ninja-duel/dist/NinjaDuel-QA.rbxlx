  <Item class="ServerScriptService" referent="ND29">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="ND30">
      <Properties>
        <string name="Name">NinjaDuelServer</string>
      </Properties>
      <Item class="ModuleScript" referent="ND31">
        <Properties>
          <string name="Name">AI</string>
          <ProtectedString name="Source">local Config=require(game:GetService("ReplicatedStorage").NinjaDuel.Config)
local Techniques=require(script.Parent.Techniques)
local Brawler=require(script.Parent.Brawler)
local Chakra=require(script.Parent.ChakraCombat)
local Bodies=require(script.Parent.Bodies)
local Zones=require(script.Parent.Zones)
local Families=require(script.Parent.Families)
local Perception=require(script.Parent.Perception)
-- Family techniques (roster breadth pass): when one is worth using is read
-- from its family and its own spec.AI band, never from the fighter's name.
local function familyWants(self,c,a,target,spec,distance,danger)
	local rule=spec.AI or {}
	local family=spec.Family
	local range=spec.Range or 30
	local opening=target.state=="Recovery" or target.state=="TechniqueRecovery" or target.state=="Stunned" or target.reaction=="Bound"
	local lo,hi,chance
	if family=="Projectile" then lo,hi,chance=8,math.min(range*.85,40),.45
	elseif family=="Strike" then lo,hi,chance=3.5,math.min(range,16),if opening then .9 else .3
	elseif family=="Burst" then lo,hi,chance=0,(spec.Radius or 7)-.5,if danger or target.state=="Rush" then .8 else .25
	elseif family=="Zone" then
		if spec.At=="Self" then lo,hi,chance=0,(spec.Radius or 8)+4,.35 else lo,hi,chance=6,math.min(range,34),.35 end
	elseif family=="Buff" then lo,hi,chance=0,24,.5
	elseif family=="Teleport" then
		if spec.To=="Back" then lo,hi,chance=0,6,if danger then .6 else 0 else lo,hi,chance=8,math.min(range,34),if opening then .7 else .25 end
	elseif family=="Counter" then lo,hi,chance=0,8,if danger then .7 else 0
	elseif family=="Summon" then
		-- Out first; once out, a lunge now and then.
		if Bodies.count(c,a,spec.Body or "puppet")==0 then lo,hi,chance=0,40,.8 else lo,hi,chance=0,30,.25 end
	else return false end
	lo=rule.Min or lo;hi=rule.Max or hi;chance=rule.Chance or chance
	-- Synergies read from data, not names: a strike that is stronger inside
	-- his own zone is taken while the body stands in it; a burst that clears
	-- blades answers blades flying at him; a detonation answers his own
	-- objects lying near the body.
	if spec.InZone and Families.inOwnZone(c,a,target) then chance=math.max(chance,.85) end
	if family=="Burst" and spec.Clear then
		for _,p in c.projectiles do
			if p.a==target and (p.position-a.root.Position).Magnitude&lt;(spec.Radius or 7)+10 then lo,hi,chance=0,math.huge,math.max(chance,.7);break end
		end
	end
	if rule.Punish and not opening then return false end
	if distance&lt;lo or distance&gt;hi then return false end
	if (family=="Projectile" or family=="Strike" or family=="Teleport") and not c:lineOfSight(a,target) then return false end
	return self.rng:NextNumber()&lt;chance
end
local AI={}; AI.__index=AI
function AI.new(combat,actor,seed)
	return setmetatable({combat=combat,actor=actor,nextTick=0,observed=nil,observedAt=0,guardUntil=0,rng=Random.new(seed or 23)},AI)
end
local function slotOf(a,id)
	for slot,spec in a.def.Techniques do if spec.Id==id then return "Technique"..slot,spec end end
	return nil
end
-- A press with an explicit route intent. The stick memory (Brawler.observe)
-- keeps the latest strong push for a moment; the bot's approach must never
-- turn into a route it did not choose, so it declares the one it wants.
local function press(c,a,action,dir,sideSign,aim)
	a.intentOverride={dir or "neutral",sideSign or 0}
	local ok,reason=c:request(a,action,aim)
	a.intentOverride=nil
	return ok,reason
end
-- How keen each prodigy is to re-engage (chakra dash from mid range, chase in
-- a window): Sasuke presses after the body, Itachi waits for it.
local DASH={Flashstep=1.1,Mirage=.75,GentleFist=1,Lion=1.45}
local CHASE={Flashstep=.62,Mirage=.5,GentleFist=.58,Lion=.74}
-- Rock Lee (stress-test wave) is the keenest of all: he never lets the body go.
DASH.Leaf=1.6;CHASE.Leaf=.8
-- Naruto (roster wave): rushes in almost as eagerly, from any angle, and
-- chases every launch (his barrage needs it).
DASH.Legion=1.5;CHASE.Legion=.8
-- Temari (roster wave) re-enters at her range (the wind step) and rarely
-- chases: her conversions are at range (AI:zone).
DASH.Gale=.35;CHASE.Gale=.25
-- A wind lane (Zones) the body stands in that blows against its way to the
-- opponent: the side to step out of it, else nil.
local function laneAgainst(c,a,toward)
	for _,z in c.zones or {} do
		if z.owner~=a and z.tune.headwind and z.direction:Dot(toward)&lt;-.4 and Zones.inside(z,a.root.Position) then
			local d=a.root.Position-z.origin
			local across=Vector3.new(d.X,0,d.Z)-z.direction*(d.X*z.direction.X+d.Z*z.direction.Z)
			return if across.Magnitude&gt;.3 then across.Unit else z.direction:Cross(Vector3.yAxis).Unit
		end
	end
	return nil
end
-- A straight dash at the opponent would run up an enemy lane (it breaks there).
local function laneOnPath(c,a,target)
	if not c.zones or #c.zones==0 then return false end
	local from,to=a.root.Position,target.root.Position
	local way=Vector3.new(to.X-from.X,0,to.Z-from.Z)
	if way.Magnitude&lt;1 then return false end
	for _,z in c.zones do
		if z.owner~=a and z.tune.headwind and z.direction:Dot(way.Unit)&lt;-.35 then
			for k=1,6 do if Zones.inside(z,from:Lerp(to,k/7)) then return true end end
		end
	end
	return false
end
local function plantedSeals(a)
	local count=0
	for _,entry in a.anchors or {} do if not entry.actor then count+=1 end end
	return count
end
-- Defence first: wall tech on the impact, and a substitution decided once per
-- combo (like a player choosing when to spend it), not rolled every tick.
function AI:defend(now)
	local c,a=self.combat,self.actor
	if a.reaction=="WallSplat" then
		local elapsed=now-(a.splatAt or now)
		if self.techPlan==nil then self.techPlan=self.rng:NextNumber()&lt;.5 end
		if self.techPlan and elapsed&gt;=Config.Wall.TechFrom+.03 and elapsed&lt;=Config.Wall.TechUntil then
			if c:request(a,"Dodge") then self.techPlan=nil;return true end
		end
	else self.techPlan=nil end
	-- Incoming blades or fire: guard or sidestep once, at reaction speed.
	if a.state=="Neutral" and not a.reaction and not a.wall and now&gt;=(self.projectileReact or 0) then
		for _,p in c.projectiles do
			if p.a~=a then
				local offset=a.root.Position-p.position
				local gap=offset.Magnitude
				if gap&lt;16 and gap&gt;2 and p.direction:Dot(offset.Unit)&gt;.92 then
					self.projectileReact=now+.6
					-- Neji answers blades and fire with Rotation when it is ready.
					local rotation=slotOf(a,"Rotation")
					if rotation and gap&lt;11 and self.rng:NextNumber()&lt;.55 and c:request(a,rotation) then return true end
					-- Rock Lee kicks a blade out of the air (his tool is the deflecting kick).
					if a.def.Tool=="Deflect" and Techniques.DEFLECTABLE[p.kind] and gap&lt;12 and self.rng:NextNumber()&lt;.6 and c:request(a,"Tool",p.position) then return true end
					local roll=self.rng:NextNumber()
					if roll&lt;.35 then
						c:request(a,"Guard");self.guardUntil=now+.35;return true
					elseif roll&lt;.6 and a.dodgeUntil&lt;=now then
						a.move=Vector3.new(-p.direction.Z,0,p.direction.X)*(if self.rng:NextNumber()&lt;.5 then 1 else -1)
						if c:request(a,"Dodge") then return true end
					end
					break
				end
			end
		end
	end
	-- Grabbed: try to break the throw on reaction.
	if a.reaction=="Grabbed" and a.grabbedAt and now-a.grabbedAt&gt;.12 and self.rng:NextNumber()&lt;.45 then
		if c:request(a,"Grab") then return true end
	end
	-- Low on health: awaken (once per match).
	if not a.awakened and a.def.Awakening and a.health&lt;=a.def.Health*Config.Awaken.Threshold and not a.reaction and self.rng:NextNumber()&lt;.4 then
		if c:request(a,"Awaken") then return true end
	end
	-- Global kunai (DEC-030): the bot draws a blade now and then for the close
	-- fight (and puts it away again), so the player meets the system too.
	-- Only fighters whose own tool is a thrown blade: a bot keeps his identity
	-- (Lee's bare hands, Temari's fan, Gaara's sand); the player may draw with anyone.
	if (a.def.Tool=="Kunai" or a.def.Tool=="Shuriken") and not a.reaction and not a.airborne and a.target and a.target.root and now&gt;=(self.armThought or 0) then
		-- its own dice: the fight's decisions keep their sequence
		self.armRng=self.armRng or Random.new(7)
		local roll=self.armRng:NextNumber()
		self.armThought=now+2.5+roll*3
		local gap=(a.target.root.Position-a.root.Position).Magnitude
		if not a.armed and gap&lt;14 and roll&lt;.3 then
			if c:request(a,"Arm") then return true end
		elseif a.armed and roll&gt;.88 then
			if c:request(a,"Arm") then return true end
		end
	end
	local hits=a.comboHits or 0
	if hits==0 then self.subPlan=nil end
	if hits&gt;0 and self.subPlan==nil then
		self.subPlan=if self.rng:NextNumber()&lt;.5 then 3+math.floor(self.rng:NextNumber()*3) else false
	end
	local hurt=a.state=="Stunned" or (a.reaction~=nil and a.reaction~="Wakeup")
	if hurt and self.subPlan and hits&gt;=self.subPlan and a.subCharges&gt;0 and a.chakra&gt;=Config.Substitution.Cost then
		if c:request(a,"Substitute") then self.subPlan=false;return true end
	end
	-- Ninja Embodiment (EMB-003): the blow's own window to answer it, decided
	-- once per reaction: guard back up or step out (away or to a side) on the
	-- ground, right itself in the air, roll out of a knockdown.
	if a.reaction and self.recoverFor~=a.reactionStartedAt then
		local kind=Brawler.recoverable(c,a)
		if kind then
			self.recoverFor=a.reactionStartedAt
			if self.rng:NextNumber()&lt;(Config.AI.Recover or .5) then
				local away=a.root.Position-a.target.root.Position;away=Vector3.new(away.X,0,away.Z)
				away=if away.Magnitude&gt;.1 then away.Unit else -a.root.CFrame.LookVector
				local side=Vector3.new(-away.Z,0,away.X)*(if self.rng:NextNumber()&lt;.5 then 1 else -1)
				if kind=="stand" and self.rng:NextNumber()&lt;.55 then
					if c:request(a,"Guard") then self.guardUntil=now+.3;return true end
				else
					a.move=if self.rng:NextNumber()&lt;.5 then away else (side+away*.4).Unit
					if c:request(a,"Dodge") then return true end
				end
			end
		end
	end
	return false
end
-- A zoner (def.Zoner: Temari). The distance is hers: too close, the fan pushes
-- the body out or she steps back on the wind (else the fan string makes the
-- distance); a body thrown or held up in the air is converted at range, never
-- chased; at range the scythe, a whirlwind where the body is going, the Great
-- Gust at an approach or at blades, and no walking into melee. Same costs and
-- windows as the player. True when it decided this tick.
function AI:zone(now,distance,toward,tangent,target)
	local c,a=self.combat,self.actor
	local tune=a.def.Zoner
	if a.state=="Rush" then return true end
	if a.reaction or a.airborne or a.state~="Neutral" then return false end
	local function cast(id,aim)
		local slot=slotOf(a,id)
		if slot and c:request(a,slot,aim or target.root.Position) then self.techReadyAt=now+.5+self.rng:NextNumber()*.9;return true end
		return false
	end
	local tool=now&gt;=(a.neutralToolAt or 0) and a.chakra&gt;=Config.ToolCost
	local closing=(target.locomotion or Vector3.zero):Dot(-toward)
	local threat=target.state=="Rush" or target.state=="Pursuit" or closing&gt;6
	local hurt=target.reaction~=nil or target.state=="Stunned"
	-- Where the body will be when the wind gets there (a scythe at ~74 studs/s).
	local lead=target.root.Position+(target.locomotion or Vector3.zero)*math.min(.5,distance/74)*.8
	-- A dash or a chase at her: the gust stops it in the air (it is not
	-- armoured); already on her, the guard takes the arrival strike.
	if target.state=="Rush" or target.state=="Pursuit" then
		if distance&lt;7 and self.rng:NextNumber()&lt;.6 then c:request(a,"Guard");self.guardUntil=now+.4;return true end
		if distance&lt;(a.def.Gust and a.def.Gust.Range or 18)+2 and tool and self.rng:NextNumber()&lt;.75 then
			a.move=Vector3.zero
			if press(c,a,"Tool","neutral",0,target.root.Position) then return true end
		end
	end
	if distance&lt;tune.Close then
		if hurt then return false end
		-- A strike already coming: the guard (her fan string or a gust answers after).
		if (target.state=="Startup" or target.state=="Active") and distance&lt;8 and self.rng:NextNumber()&lt;.55 then
			c:request(a,"Guard");self.guardUntil=now+.35;return true
		end
		-- Walking into the fan's length: the tip first (it out-reaches a fist),
		-- the string then throws the body back out.
		if distance&gt;4.6 and distance&lt;7.6 and target.state~="Startup" and target.state~="Active" and self.rng:NextNumber()&lt;.45 then
			a.move=Vector3.zero
			if press(c,a,"Attack") then return true end
		end
		if distance&lt;tune.Push and tool and self.rng:NextNumber()&lt;.55 and press(c,a,"Tool","neutral",0,target.root.Position) then return true end
		if a.pursuitUntil&lt;=now and self.rng:NextNumber()&lt;.45 then
			a.move=-toward
			if press(c,a,"Pursuit","back",0) then return true end
		end
		return false
	end
	local floating=target.reaction=="Launched" or target.reaction=="Juggled" or (target.reaction=="Knockback" and target.airborne)
	local sight=c:lineOfSight(a,target)
	if floating and sight and distance&lt;32 then
		if cast("Kamaitachi") then return true end
		if distance&lt;17 and tool and press(c,a,"Tool","neutral",0,target.root.Position) then return true end
	end
	-- Blades coming at her: the gust sends them back.
	if tool and Techniques.bladeIncoming(c,a,{Radius=6,Reach=16}) and self.rng:NextNumber()&lt;.55 then
		if press(c,a,"Tool","neutral",0,target.root.Position) then return true end
	end
	-- Coming in fast inside her band: out on the wind before the body arrives.
	if threat and distance&lt;tune.Close+5 and a.pursuitUntil&lt;=now and self.rng:NextNumber()&lt;.35 then
		a.move=-toward
		if press(c,a,"Pursuit","back",0) then return true end
	end
	if now&gt;=(self.techReadyAt or 0) and sight and target.state~="Defeated" then
		local roll=self.rng:NextNumber()
		if distance&lt;24 and threat and roll&lt;.3 and cast("GreatGust") then return true end
		if distance&gt;12 and distance&lt;34 and closing&gt;3 and roll&lt;.5 then
			-- (where the body will be when the column rises: the signs, then the beat)
			if cast("Cyclone",target.root.Position+(target.locomotion or Vector3.zero)*.69) then return true end
		end
		-- (against a body coming in fast, from far enough that a dash into the
		-- channel meets the scythe)
		if distance&gt;(if threat then 15 else 10) and distance&lt;42 and roll&lt;.7 and cast("Kamaitachi",lead) then return true end
	end
	-- Hold the band: inside it she backs off at an angle (a straight backpedal
	-- is slower than any approach), never walks into melee.
	if distance&lt;(tune.Keep or tune.Close+6) then
		a.move=(-toward*.75+tangent*(self.strafeSign or 1)*.66).Unit;a.sprinting=distance&lt;tune.Close+3
	end
	return true
end
-- (Rupture) Break off an exchange: a hop away, an arc, a jump out; a blade
-- may fly on the way. The next approach is a fresh decision.
function AI:breakOff(now,tangent,toward)
	local c,a=self.combat,self.actor
	local tune=Config.AI
	local roll=self.rng:NextNumber()
	self.reposKind=if roll&lt;.4 then "arc" elseif roll&lt;.75 then "out" else "jump"
	self.reposSide=if self.rng:NextNumber()&lt;.5 then 1 else -1
	self.reposUntil=now+(tune.RepositionTime or .9)+self.rng:NextNumber()*(tune.RepositionJitter or .6)
	self.reposThrown=false
	Brawler.event(c,a,"BreakOff:"..self.reposKind)
	if self.reposKind=="jump" then
		a.move=(-toward+tangent*self.reposSide*.6).Unit;c:request(a,"Jump")
	elseif self.reposKind=="out" then
		a.move=(-toward+tangent*self.reposSide*.4).Unit;c:request(a,"Dodge")
	end
end
-- True when `move` is already two of the bot's last five: vary instead.
function AI:habit(move)
	local n=0
	for _,m in self.recent or {} do if m==move then n+=1 end end
	return n&gt;=2
end
function AI:update(now)
	local c,a=self.combat,self.actor; local target=a.target; local tune=Config.AI
	if c.match.phase~="Duel" or a.health&lt;=0 or target.health&lt;=0 then a.move=Vector3.zero; return end
	if now&lt;self.nextTick then return end
	self.nextTick=now+tune.Tick
	-- No exemption from a shroud: lost in it, the bot aims at where it last saw him.
	if Families.shrouded(c,a) then a.fogAim=self.lastSeen or target.root.Position
	else a.fogAim=nil;self.lastSeen=target.root.Position end
	if a.state~="Rush" then self.feinted=nil end
	-- (User 28/10: "the bot repeats itself", recorded match and player agent:
	-- DashAttack 40 % of its moves.) It remembers its last moves; an entry it
	-- has just used twice is set aside for another (Bot:habit).
	self.recent=self.recent or {}
	if a.attackName and a.attackName~=self.lastMove then
		table.insert(self.recent,a.attackName);if #self.recent&gt;5 then table.remove(self.recent,1) end
	end
	self.lastMove=a.attackName
	if self:defend(now) then return end
	-- Genjutsu: sometimes the bot sees through the decoy, sometimes it does not.
	if a.illusionUntil&gt;now then
		if self.illusionSeen==nil then self.illusionSeen=self.rng:NextNumber()&lt;.35 end
	else self.illusionSeen=nil end
	local fooled=a.decoyPosition and a.illusionUntil&gt;now and not self.illusionSeen
	local position=if fooled then a.decoyPosition else target.root.Position
	local delta=position-a.root.Position; delta=Vector3.new(delta.X,0,delta.Z)
	local distance=delta.Magnitude; local toward=if distance&gt;0.1 then delta.Unit else Vector3.zAxis
	-- Facing is Combat:faceLocked's job (the bot is locked like the player): a
	-- lookAt snap on every 0.18 s decision made the body pivot in visible jerks.
	local tangent=Vector3.new(-toward.Z,0,toward.X);local minato=a.def.Name=="Minato"
	local desired=a.def.PreferredRange or 7
	-- Rhythm: press for a while, then probe at range (spacing, reading), and
	-- breathe after a combo lands instead of restarting at once.
	if now&gt;=(self.modeUntil or 0) then
		local wasProbing=self.probing
		self.probing=not self.probing and self.rng:NextNumber()&lt;.55
		self.modeUntil=now+(if self.probing then 1.6+self.rng:NextNumber()*2 else 2.2+self.rng:NextNumber()*2.6)
		self.probeRange=8+self.rng:NextNumber()*12
		-- A probe often resolves into an entry: the press opens with a dash.
		if wasProbing and not self.probing then self.entryUntil=now+1.2 end
	end
	-- Against a zoner (a far longer preferred range than ours: Temari) waiting
	-- at range is losing: no probing, weave on the way in, dash from further,
	-- step out of a wind lane that blows against the approach (below).
	local zoner=(target.def.PreferredRange or 7)&gt;=14 and (a.def.PreferredRange or 7)&lt;12 and not a.def.Zoner
	if zoner then self.probing=false end
	local downed=target.reaction=="Knockdown" or target.reaction=="Wakeup" or (target.reaction=="Knockback" and target.airborne==false)
	if downed and not self.wasDowned and a.pursuitUntil&lt;=now then self.breathUntil=now+.35+self.rng:NextNumber()*.5 end
	self.wasDowned=downed
	-- Got hit and out of it: back off into neutral (reset, tools, reads)
	-- instead of mashing straight back in.
	local hurt=a.reaction~=nil or a.state=="Stunned"
	if self.wasHurt and not hurt and self.rng:NextNumber()&lt;tune.Disengage then
		self.probing=true;self.modeUntil=now+1.2+self.rng:NextNumber()*1.4;self.probeRange=10+self.rng:NextNumber()*8
	end
	self.wasHurt=hurt
	local calm=self.probing or now&lt;(self.breathUntil or 0)
	-- Probing happens at tool range: spacing, throws and reads before running in.
	if self.probing then desired+=self.probeRange or 14 elseif calm then desired+=4 end
	-- Genjutsu image (Itachi's Mirage): hold the line behind the image while it
	-- stands; the opponent has to come to it (blades still fly through it).
	local holding=target.illusionBy==a and (target.illusionUntil or 0)&gt;now
	if holding then desired=distance end
	local radial=if distance&gt;desired+2 then 1 elseif distance&lt;desired-2 then -0.6 else 0
	-- Lateral movement is committed for a beat, then changes side: readable
	-- repositioning, not a sine-wave drift around the opponent.
	if now&gt;=(self.strafeUntil or 0) then
		self.strafeSign=if self.rng:NextNumber()&lt;.5 then 1 else -1
		self.strafeUntil=now+.6+self.rng:NextNumber()*(if minato then .7 else 1.1)
		self.strafeAmount=if self.rng:NextNumber()&lt;.2 then 0 else (if minato then .95 else .6)
	end
	-- Pressing in from range: straight at them, angling only on the last
	-- steps. Two sprinting fighters offset the same way (velocity turns at a
	-- bounded rate) orbit each other forever instead of meeting.
	local lateral=self.strafeAmount or .5
	if radial&gt;0 and not calm then lateral*=if zoner then .8 elseif distance&gt;desired+8 then 0 else .35 end
	if holding then lateral=0 end
	a.move=(toward*radial+tangent*(self.strafeSign or 1)*lateral)
	-- Standing in a wind lane that blows against the way in: out of it sideways.
	local outOfLane=radial&gt;0 and laneAgainst(c,a,toward)
	if outOfLane then a.move=outOfLane+toward*.25;Brawler.event(c,a,"LaneAvoid") end
	-- Space is a resource: backing off drifts toward the open middle, so the
	-- wall is a choice (wall run, splat) and not where every retreat ends.
	local centre=(a.root.Position-c.match.origin)*Vector3.new(1,0,1)
	local edge=math.clamp((centre.Magnitude-(Config.ArenaRadius-45))/30,0,1)
	if edge&gt;0 and radial&lt;.5 and centre.Magnitude&gt;.1 then a.move-=centre.Unit*edge*.9 end
	-- (Embodiment) A ninja moves through the terrain: spacing at range, it
	-- drifts to the scenery (a boulder to stand behind, a trunk, the wall),
	-- so the exchanges that follow happen where the space can be used.
	if self.probing and not holding and not fooled then
		local spot=Perception.nearest(c,a.root.Position,tune.Terrain or 50)
		if spot and spot.distance&gt;5 then
			a.move+=spot.direction*(tune.TerrainPull or .9)
			if (self.terrainAt or -9)&lt;now-3 then self.terrainAt=now;Brawler.event(c,a,"Perceive:terrain:"..spot.kind) end
		end
	end
	a.sprinting=distance&gt;desired+6 and not calm
	if calm then a.move*=.7 end
	-- Step-in feint at probing range: two quick steps in, then out of reach,
	-- often with a blade on the way out.
	if self.feintOut then
		if now&lt;self.feintOut then
			a.move=-toward+tangent*(self.strafeSign or 1)*.4;a.sprinting=false
			if edge&gt;0 and centre.Magnitude&gt;.1 then a.move-=centre.Unit*edge end
			if self.feintThrow and now&gt;=self.feintThrow then self.feintThrow=nil;c:request(a,"Tool",target.root.Position) end
		else self.feintOut=nil end
	elseif self.feintIn then
		if now&lt;self.feintIn then a.move=toward;a.sprinting=true
		else self.feintIn=nil;self.feintOut=now+.35+self.rng:NextNumber()*.2
			self.feintThrow=if self.rng:NextNumber()&lt;.45 then now+.12 else nil
			Brawler.event(c,a,"FeintStep")
		end
	elseif self.probing and a.state=="Neutral" and not a.airborne and distance&gt;9 and distance&lt;19 and self.rng:NextNumber()&lt;tune.Feint then
		self.feintIn=now+.22+self.rng:NextNumber()*.12
	end
	if a.move.Magnitude&gt;1 then a.move=a.move.Unit end
	if now&gt;=self.guardUntil and a.state=="Guarding" then c:request(a,"GuardOff") end
	-- Wall run: rise along the wall, then dive at the opponent.
	local fromCenter=(a.root.Position-c.match.origin)*Vector3.new(1,0,1)
	local outward=if fromCenter.Magnitude&gt;.1 then fromCenter.Unit else Vector3.xAxis
	if a.wall then
		self.wallSince=self.wallSince or now
		local along=Vector3.new(-a.wall.normal.Z,0,a.wall.normal.X)
		a.move=(-a.wall.normal*.7+along*(self.wallSide or 1)*.7).Unit
		if now-self.wallSince&gt;.3 and (target.root.Position-a.root.Position).Magnitude&lt;=Config.Wall.DiveRange and self.rng:NextNumber()&lt;.55 then
			c:request(a,"Attack")
		end
		return
	end
	self.wallSince=nil
	if self.wallRun and now&lt;self.wallRun and a.state=="Neutral" and not a.reaction then
		a.move=(outward+tangent*.25).Unit;a.sprinting=true
		return
	end
	if fromCenter.Magnitude&gt;Config.ArenaRadius-22 and distance&gt;11 and distance&lt;44 and a.state=="Neutral" and not a.airborne and self.rng:NextNumber()&lt;tune.WallRun then
		self.wallRun=now+1.1;self.wallSide=if self.rng:NextNumber()&lt;.5 then 1 else -1
		return
	end
	if target.state~=self.observed then
  if target.state=="Startup" or target.state=="TechniqueChannel" then self.threatAt=now end
  self.observed=target.state;self.observedAt=now
 end
	-- Reads: an opponent stepping into melee range is answered before the
	-- strike lands. Not a reaction (no latency): a guess, taken once per entry
	-- - guard (a parry when the timing lands), sidestep or counter-poke.
	local closing=(target.locomotion or Vector3.zero):Dot(-toward)
	local entering=distance&lt;8.5 and (self.lastDistance or 99)&gt;=8.5 and closing&gt;4
	self.lastDistance=distance
	local free=a.state=="Neutral" and not a.reaction and not a.airborne
	-- (Rupture) An ordinary exchange is short: after it the bot breaks off and
	-- moves (a hop away and a blade, an arc round him, a jump, a technique)
	-- instead of standing toe to toe trading the next string.
	-- Each confirmed hit of its string is a decision: carry on, or end it
	-- here and move.
	local combo=a.combo or 0
	if combo~=(self.comboSeen or 0) then
		if combo&gt;(self.comboSeen or 0) and not a.airborne
			and self.rng:NextNumber()&lt;(if combo&gt;=2 then (tune.BreakOff2 or .55) else (tune.BreakOff1 or .3)) then
			self:breakOff(now,tangent,toward)
		end
		self.comboSeen=combo
	end
	if (self.reposUntil or 0)&gt;now and not a.reaction then
		local kind=self.reposKind
		local away=-toward
		if kind=="arc" then a.move=(tangent*(self.reposSide or 1)+away*.35).Unit;a.sprinting=true
		elseif kind=="out" then a.move=(away+tangent*(self.reposSide or 1)*.5).Unit;a.sprinting=true
		else a.move=(away*.6+tangent*(self.reposSide or 1)).Unit;a.sprinting=distance&lt;10 end
		if not self.reposThrown and distance&gt;7 and free and self.rng:NextNumber()&lt;.5 then
			self.reposThrown=true
			if press(c,a,"Tool","neutral",0,target.root.Position) then return end
		end
		return
	end
	-- (Embodiment) A state held in the body (the Chidori in the hand): run it
	-- in and release it, sometimes from a jump (the release reads the air).
	if a.bodyState then
		a.move=toward;a.sprinting=distance&gt;7
		if distance&lt;(a.bodyState.state.Reach or 9) then c:request(a,"Attack")
		elseif distance&gt;11 and not a.airborne and self.rng:NextNumber()&lt;.12 then c:request(a,"Jump") end
		return
	end
	-- A zoner plays her own range game (AI:zone) before any melee logic.
	if a.def.Zoner and self:zone(now,distance,toward,tangent,target) then return end
	if entering and free then
		local roll=self.rng:NextNumber()
		if roll&lt;tune.ReadGuard then
			c:request(a,"Guard");self.guardUntil=now+.42;return
		elseif roll&lt;tune.ReadGuard+tune.ReadDodge and a.dodgeUntil&lt;=now then
			a.move=tangent*(self.strafeSign or 1)
			if c:request(a,"Dodge") then return end
		elseif roll&lt;tune.ReadGuard+tune.ReadDodge+tune.ReadPoke and distance&lt;7.5 then
			if c:request(a,"Attack") then return end
		end
	end
	-- Toe to toe with a fighter who is not swinging yet: sometimes hold a
	-- guard in anticipation (a parry if the strike comes right then).
	if free and distance&lt;7 and target.state=="Neutral" and not target.reaction and self.rng:NextNumber()&lt;tune.GuardRead then
		c:request(a,"Guard");self.guardUntil=now+.28+self.rng:NextNumber()*.22;return
	end
	local reacted=now-self.observedAt&gt;=tune.Reaction
	local danger=target.state=="Startup" or target.state=="TechniqueChannel"
	local reactedThreat=reacted and (target.state=="Startup" or target.state=="Active")
 -- Remember the wind-up through Active/Recovery: short attacks used to erase
 -- the observation before reaction latency elapsed, so defense never fired.
 local remembered=self.threatAt and now-self.threatAt&gt;=tune.Reaction and now-self.threatAt&lt;.9
 if remembered and distance&lt;9 and a.state=="Neutral" and not a.reaction then
  self.threatAt=nil
  if target.state=="Recovery" then
   a.move=toward;a.sprinting=true
   if distance&lt;6 then c:request(a,"Attack") else c:request(a,"Dodge") end
  elseif minato then
   a.move=tangent;c:request(a,"Dodge")
  else
   c:request(a,"Guard");self.guardUntil=now+.36
  end
  return
 end
	-- Neji: a strike about to land at close range is a Rotation read.
	if reactedThreat and a.state=="Neutral" and distance&lt;6.5 and slotOf(a,"Rotation") and self.rng:NextNumber()&lt;.3 then
		if c:request(a,(slotOf(a,"Rotation"))) then return end
	end
	if a.state=="Startup" and a.attackName=="Heavy" and now-a.attackStarted&gt;.08 and self.rng:NextNumber()&lt;(if minato then .18 else .3) then c:request(a,"Feint");return end
	-- A newly observed telegraph may alter movement, but cannot trigger an
	-- instant defensive action or coincidental interrupt before reaction latency.
	if danger and not reacted then return end
	if reacted and danger and distance&lt;9 then
		if target.state=="TechniqueChannel" and distance&lt;=6.8 and self.rng:NextNumber()&lt;tune.Aggression then
			c:request(a,"Attack"); return
		end
		if self.rng:NextNumber()&lt;tune.Defense then
			if self.rng:NextNumber()&lt;0.45 then c:request(a,"Dodge")
			else c:request(a,"Guard"); self.guardUntil=now+0.5 end
			return
		end
	end
	if a.grabVictim then c:request(a,if self.rng:NextNumber()&lt;.4 then "Heavy" else "Attack");return end
	-- Re-engage: Itachi sometimes turns his dash into a feint (a guard and a
	-- read) instead of arriving; on arrival the bot converts with the dash
	-- strike, the quick heavy or, close to a guard, a grab.
	if a.state=="Rush" then
		if a.fighterId=="Mirage" and not self.feinted and distance&lt;10 then
			self.feinted=true
			if self.rng:NextNumber()&lt;.3 and c:request(a,"Guard") then self.guardUntil=now+.3;return end
		end
		press(c,a,"Attack");return
	end
	if (a.rushArriveUntil or 0)&gt;now and not a.airborne then
		local roll=self.rng:NextNumber()
		if target.state=="Guarding" and distance&lt;4.5 and roll&lt;.45 then press(c,a,"Grab")
		elseif roll&lt;.2 then press(c,a,"Heavy")
		else press(c,a,"Attack") end
		return
	end
	-- Sasuke under the rising body: one strike, then the Lion Combo.
	if (a.lionUntil or 0)&gt;now and a.airborne and a.state=="Neutral" then
		press(c,a,if (a.airCombo or 0)&gt;=1 and self.rng:NextNumber()&lt;.7 then "Heavy" else "Attack");return
	end
	-- Wired opponent: the current down the wire first when the reserve pays
	-- for both (it holds the body longer, ChakraCombat.conduct), then the
	-- Dragon Flame along it. The current is a tool action, not a jutsu.
	local wired=a.wireVictim
	if wired and wired.reaction=="Bound" and wired.boundBy==a and (a.state=="Neutral" or a.state=="TechniqueRecovery") then
		local fire,spec=slotOf(a,"FireBloom")
		local current=Chakra.plan(c,a,"Shuriken")
		if current and current.mode=="conduct" and (wired.wireConducts or 0)==0 and a.chakra&gt;=Chakra.cost(current,false)+(spec and spec.Cost or 0)
			and c:request(a,"Tool",nil,nil,{chakra=true}) then return end
		if fire and c:request(a,fire,target.root.Position) then return end
	end
	-- His stretched wire with the opponent standing by it: lightning thrown
	-- at the wire charges it (and the trap is live), once per wire.
	if a.state=="Neutral" and not target.airborne then
		for _,w in c.projectiles do
			if w.a==a and w.planted=="wire" and not w.dead and not w.charged then
				self.armed=self.armed or {}
				local far=w.origin+w.direction*w.range
				local ab=far-w.origin
				local k=math.clamp((target.root.Position-w.origin):Dot(ab)/math.max(ab:Dot(ab),1e-6),0,1)
				local spot=w.origin+ab*k
				local gap=(target.root.Position-spot)*Vector3.new(1,0,1)
				if not self.armed[w.id] and gap.Magnitude&lt;8 then
					self.armed[w.id]=true
					local plan=Chakra.plan(c,a,"Shuriken")
					if plan and plan.mode=="throw" and plan.tags.lightning and a.chakra&gt;=Chakra.cost(plan,false)+10
						and c:request(a,"Tool",spot,nil,{chakra=true}) then return end
				end
			end
		end
	end
	-- A read that landed (Read or a caught genjutsu): cash it in.
	-- A counter with a reach (a caught genjutsu image, a repelled strike) glides to the body.
	local counterRange=8+(if a.counterReach and a.counterReach.expires&gt;now then a.counterReach.max else 0)
	if (a.counterUntil or 0)&gt;now and distance&lt;counterRange then a.move=toward;c:request(a,"Attack");return end
	-- Flying Thunder God arrival: strike from the new angle, or Rasengan at once.
	if (a.flashUntil or 0)&gt;now then
		local rasengan=slotOf(a,"BurstStrike")
		if rasengan and self.rng:NextNumber()&lt;.35 and c:request(a,rasengan) then return end
		c:request(a,if self.rng:NextNumber()&lt;.3 then "Heavy" else "Attack");return
	end
	-- The opponent is pinned against a wall: pursue, extend, bounce or pin it.
	if target.reaction=="WallSplat" then
		local gap=(target.root.Position-a.root.Position).Magnitude
		if gap&lt;7 then a.move=toward;c:request(a,if self.rng:NextNumber()&lt;.45 then "Heavy" else "Attack");return end
		if a.pursuitUntil&gt;now and gap&lt;Config.PursuitRange and c:request(a,"Pursuit") then return end
		if not minato and gap&lt;32 and c:request(a,"Tool",target.root.Position) then return end
		a.move=toward;a.sprinting=true;return
	end
	-- A marked kunai that is about to pass the opponent is a teleport cue.
	if minato and a.state=="Neutral" then
		local seal=Techniques.sealOf(c,a,now)
		if seal and (seal-target.root.Position).Magnitude&lt;7 and (c:markedInFlight(a) or self.rng:NextNumber()&lt;.5) then
			local slot=slotOf(a,"Flashstep")
			if slot and c:request(a,slot) then return end
		end
	end
	-- A body launched straight up above him is out of reach too: the flat
	-- distance stays short while it rises (Naruto's barrage, a pillar).
	local above=target.airborne and target.root.Position.Y-a.root.Position.Y&gt;4
	if a.pursuitUntil&gt;now and (distance&gt;8 or above) and distance&lt;Config.PursuitRange and self.rng:NextNumber()&lt;(CHASE[a.fighterId] or .58) and not self:habit("DashAttack") then
		c:request(a,"Pursuit"); return
	end
	if a.state=="Recovery" and a.chainOpen then
		-- In the air Minato may finish with a plunging Rasengan instead of the slam.
		if a.airborne and minato and (a.airCombo or 0)&gt;=1 and self.rng:NextNumber()&lt;.25 then
			local rasengan=slotOf(a,"BurstStrike")
			if rasengan and c:request(a,rasengan) then return end
		end
		-- The directional grammar: the stick picks the route, so the bot sets it
		-- explicitly (an approach held by accident must not pick a launcher).
		local roll=self.rng:NextNumber()
		if a.airborne then
			-- A fighter with its own air finisher (Rock Lee's lotuses) cashes it in
			-- after one confirmed hit inside the Shadow of the Dancing Leaf window.
			if (a.lionUntil or 0)&gt;now and (a.airCombo or 0)&gt;=1 and (Brawler.graph(a) or {}).airFinisher and roll&lt;.75 then a.move=Vector3.zero;press(c,a,"Heavy");return end
			if (a.airCombo or 0)&gt;=2 and roll&lt;.4 then a.move=Vector3.zero;press(c,a,"Heavy");return end
			if (a.airCombo or 0)&gt;=1 then
				if roll&lt;.22 then a.move=-toward;press(c,a,"Attack","back");return
				elseif roll&lt;.42 then a.move=toward;press(c,a,"Attack","forward");return
				elseif roll&lt;.54 then
					local sign=if self.rng:NextNumber()&lt;.5 then 1 else -1
					a.move=tangent*sign;press(c,a,"Attack","side",sign);return
				end
			end
			a.move=Vector3.zero;press(c,a,"Attack");return
		end
		-- Neji: end a string with Vacuum Palm.
		if a.fighterId=="GentleFist" and a.combo&gt;=2 and roll&lt;.18 then
			local palm=slotOf(a,"VacuumPalm")
			if palm and c:request(a,palm,target.root.Position) then return end
		end
		local nearWall=fromCenter.Magnitude&gt;Config.ArenaRadius-22
		if a.combo&gt;=2 then
			-- (Rupture) the launcher is a choice now and then, not the default end.
			if roll&lt;.12 then a.move=toward;press(c,a,"Attack","forward");return end -- launcher
			if roll&lt;.46 then a.move=-toward;press(c,a,"Attack","back");return end -- low route
			if roll&lt;.56 then a.move=Vector3.zero;press(c,a,"Heavy");return end
		elseif a.combo==1 and roll&lt;.2 then a.move=Vector3.zero;press(c,a,"Heavy");return end
		if roll&lt;.7 and roll&gt;=.56 then
			local sign=if self.rng:NextNumber()&lt;.5 then 1 else -1
			a.move=tangent*sign;press(c,a,"Attack","side",sign);return
		end
		if roll&gt;=.92 then
			-- Tool inside the string; away + tool hops out behind it.
			local away=not nearWall and self.rng:NextNumber()&gt;=.5
			a.move=if away then -toward else Vector3.zero
			press(c,a,"Tool",if away then "back" else "neutral",0,target.root.Position);return
		end
		a.move=Vector3.zero;press(c,a,"Attack");return
	end
	if a.state~="Neutral" or a.reaction then return end
	-- Bodies (Naruto's clones): a clone winding up a jab close by is struck
	-- first (the stick aims the opener at it), one merely close now and then.
	local body=not a.airborne and Bodies.threat(c,a,6.5)
	if body and self.rng:NextNumber()&lt;(if body.state=="Startup" then .8 else .3) then
		local to=Vector3.new(body.position.X-a.root.Position.X,0,body.position.Z-a.root.Position.Z)
		-- (The push at the clone is aim, not the stick's opener: neutral intent.)
		if to.Magnitude&gt;.5 then a.move=to.Unit;if press(c,a,"Attack","neutral",0) then return end end
	end
	if a.chakra&lt;18 then a.move=-toward+tangent*0.2; return end
	-- (Rock Lee has no blade to probe with: his tool is the deflecting kick.)
	if distance&gt;7 and distance&lt;46 and a.def.Tool~="Deflect" and self.rng:NextNumber()&lt;(if a.def.Name=="Itachi" then 0.11 else 0.09)*(if self.probing then tune.ProbeTool else 1) and target.state~="Guarding" then
		-- A tool master sometimes throws the geometry instead (side + tool).
		if a.def.ToolMastery and a.def.ToolMastery.Geometry and self.rng:NextNumber()&lt;.4 then
			a.move=tangent*(if self.rng:NextNumber()&lt;.5 then 1 else -1)
		end
		-- Chakra tool (isolated, no extra roll): every third probing throw with a
		-- comfortable reserve is infused; a body-chakra fighter (Neji) keeps the blade.
		self.probeThrows=(self.probeThrows or 0)+1
		local infuse=self.probeThrows%3==0 and not a.def.GentleFist and a.chakra&gt;=(a.def.Chakra or Config.Chakra)*.6
		if c:request(a,"Tool",target.root.Position,nil,if infuse then {chakra=true} else nil) then return end
	end
	-- Choose by capabilities/technique identifiers, never by a second bot combat engine.
	-- Jutsu are paced: after one, a few seconds of movement, tools and reads
	-- before the next. A close punish (stunned, bound, or recovering within
	-- reach) is not; a recovery seen from range is still neutral.
	local punish=target.state=="Stunned" or target.reaction=="Bound"
		or ((target.state=="Recovery" or target.state=="TechniqueRecovery") and distance&lt;7)
	if self.rng:NextNumber()&lt;tune.Technique and (now&gt;=(self.techReadyAt or 0) or punish) then
		-- A kit made only of family techniques is scanned from a rotating slot
		-- (the whole kit gets used, not slot 1 first); a kit with bespoke
		-- techniques keeps its authored priority order.
		-- (Rupture) A technique that is a held state (the Chidori) is formed
		-- first when it can be: in the open, at range, the threat is what the
		-- body does with it next.
		for slot,spec in a.def.Techniques do
			if spec.State and not a.bodyState and distance&gt;7 and distance&lt;(spec.Range or 20) and self.rng:NextNumber()&lt;(tune.StateForm or .35)
				and c:request(a,"Technique"..slot,target.root.Position) then
				self.techReadyAt=now+(tune.TechniqueGap or 0)+self.rng:NextNumber()*(tune.TechniqueJitter or 0);return
			end
		end
		local count=#a.def.Techniques
		local rotate=true
		for _,spec in a.def.Techniques do if not spec.Family then rotate=false end end
		self.techStart=if rotate then ((self.techStart or 0)%math.max(count,1))+1 else 1
		for k=0,count-1 do
			local slot=((self.techStart+k-1)%count)+1
			local spec=a.def.Techniques[slot]
			local use=false; local aim=target.root.Position
			if spec.Id=="MarkedBlade" then use=plantedSeals(a)&lt;2 and not c:markedInFlight(a) and distance&gt;8; aim=position+target.hum.MoveDirection*3
			elseif spec.Id=="Flashstep" then local seal=Techniques.sealOf(c,a,now);use=seal~=nil and (distance&gt;14 or (seal-target.root.Position).Magnitude&lt;7)
			elseif spec.Id=="BurstStrike" then use=distance&lt;7 and (target.state=="Recovery" or target.state=="Stunned" or target.state=="TechniqueRecovery")
			elseif spec.Id=="Read" then use=distance&lt;8 and danger and reacted
			elseif spec.Id=="NeedleFan" then use=distance&gt;8 and distance&lt;36
			elseif spec.Id=="MirageCast" then use=distance&gt;10 and distance&lt;21 and (target.state=="Recovery" or target.state=="Guarding" or self.rng:NextNumber()&lt;0.18) end
			if spec.Id=="FireBloom" then use=distance&gt;6 and distance&lt;46 and c:lineOfSight(a,target) and (target.state=="Recovery" or target.state=="TechniqueChannel" or self.rng:NextNumber()&lt;0.32) end
			if spec.Id=="WireTrap" then use=distance&gt;7 and distance&lt;28 and c:lineOfSight(a,target) and self.rng:NextNumber()&lt;.4 end
			if spec.Id=="Chidori" then use=distance&gt;4 and distance&lt;16 and (target.state=="Recovery" or target.state=="TechniqueRecovery" or target.state=="Stunned" or target.reaction=="Bound" or self.rng:NextNumber()&lt;.06) end
			if spec.Id=="FireBloom" and a.wireVictim and a.wireVictim.reaction=="Bound" then use=true end
			if spec.Id=="SandCoffin" then use=distance&gt;7 and distance&lt;28 and c:lineOfSight(a,target) and self.rng:NextNumber()&lt;.45 end
			if spec.Id=="SandShuriken" then use=distance&gt;9 and distance&lt;34 and self.rng:NextNumber()&lt;.5 end
			if spec.Id=="DesertWave" then use=distance&lt;8 and (target.state=="Startup" or target.state=="Rush" or target.state=="Active" or self.rng:NextNumber()&lt;.25) end
			if spec.Id=="VacuumPalm" then use=distance&gt;7 and distance&lt;24 and c:lineOfSight(a,target) and self.rng:NextNumber()&lt;.45 end
			if spec.Id=="SixtyFourPalms" then use=distance&lt;4.6 and (target.state=="Recovery" or target.state=="Stunned" or target.state=="TechniqueRecovery" or target.state=="TechniqueChannel") end
			if spec.Id=="Rotation" then use=false end
			if spec.Id=="PhoenixFlower" then use=distance&gt;9 and distance&lt;34 and c:lineOfSight(a,target) and self.rng:NextNumber()&lt;.5 end
			if spec.Id=="WindCut" then use=distance&gt;8 and distance&lt;28 end
			if spec.Id=="Quickstep" then use=distance&gt;9 and distance&lt;20 and self.rng:NextNumber()&lt;0.25 end
			-- Rock Lee (stress-test wave): the spinning kick crosses a gap or
			-- punishes a recovery, in line of sight; nothing he has is thrown.
			if spec.Id=="LeafGreatWhirlwind" then use=distance&gt;5 and distance&lt;16 and c:lineOfSight(a,target)
				and (target.state=="Recovery" or target.state=="TechniqueChannel" or target.state=="TechniqueRecovery" or self.rng:NextNumber()&lt;.4) end
			-- Naruto (roster wave): clones out in neutral (two at most), a pair
			-- charging from mid range, the Rasengan on an opening or with a clone
			-- out to shape it.
			-- (With none out, now and then he holds the single clone for the pair.)
			if spec.Id=="ShadowClone" then local out=Bodies.count(c,a,"clone");use=distance&gt;4 and distance&lt;26 and out&lt;2 and a.chakra&gt;=36 and (out&gt;0 or self.rng:NextNumber()&lt;.6) end
			if spec.Id=="MassShadowClone" then use=distance&gt;7 and distance&lt;22 and Bodies.count(c,a,"clone")==0 and a.chakra&gt;=70 and self.rng:NextNumber()&lt;.5 end
			if spec.Id=="CloneRasengan" then use=distance&lt;9 and (target.state=="Recovery" or target.state=="Stunned" or target.state=="TechniqueRecovery"
				or (Bodies.count(c,a,"clone")&gt;0 and self.rng:NextNumber()&lt;.35)) end
			if spec.Family and not use then use=familyWants(self,c,a,target,spec,distance,danger) end
			if use and c:request(a,"Technique"..slot,aim) then
				-- A held technique (spec.Hold): the bot holds it for a while of its
				-- choosing, longer when the opponent is far (more time to see it).
				if spec.Hold then
					a.techHold={slot=slot,down=true}
					local want=if distance&gt;18 then self.rng:NextNumber() else self.rng:NextNumber()*.35
					local hold=a.techHold
					c:schedule(now+spec.Channel+want*(spec.Hold.Time or 1),function() hold.down=false end)
				end
				self.techReadyAt=now+(tune.TechniqueGap or 0)+self.rng:NextNumber()*(tune.TechniqueJitter or 0);return
			end
		end
	end
	local whiff=target.state=="Recovery" and (target.attackName=="Heavy" or not target.hitConfirmed)
	if whiff and distance&lt;10 then a.move=toward;a.sprinting=true;c:request(a,"Attack");return end
	-- Probing or breathing: no fresh melee initiation, only punishes and reads.
	if calm then return end
	local reach=(a.def.AttackProfile and a.def.AttackProfile.Light1 and a.def.AttackProfile.Light1.range or 6)+1.5
	-- A body on the floor with wake-up cover cannot be hit: no swings at it.
	local covered=target.groundPose~=nil and (target.invulnerableUntil or 0)&gt;now
	if covered then return end
	-- Ninja Embodiment: the space. A body on a wall is finished there (light
	-- blows pin, a heavy bounces him back out); a body with its own back to a
	-- surface gets out of the corner; and with a surface near the opponent
	-- the bot circles to put him between itself and it, so the strike that
	-- follows (the resolver's wall situation) drives him into it.
	local seen=if fooled then nil else Perception.read(c,a)
	if seen and free and not self.plan then
		if target.reaction=="WallSplat" and distance&lt;6.5 then
			c:request(a,if self.rng:NextNumber()&lt;.35 then "Heavy" else "Attack");return
		end
		local corner=seen.behindSelf
		if corner and corner.distance&lt;(tune.Corner or 4.5) and distance&lt;9 then
			a.move=(tangent*(self.strafeSign or 1)+toward*.15).Unit
			if (self.cornerAt or -9)&lt;now-1 then self.cornerAt=now;Brawler.event(c,a,"Perceive:corner") end
			if self.rng:NextNumber()&lt;.2 then c:request(a,"Dodge") end
			return
		end
		local near=seen.nearest
		local driven=seen.behindTarget and seen.behindTarget.distance&lt;=12
		if near and not driven and near.distance&lt;(tune.Herd or 16) and distance&gt;2.5 and distance&lt;14 then
			if not self.herdUntil and now&gt;(self.herdNext or 0) then
				self.herdUntil=now+(tune.HerdTime or 1.6);self.herdNext=now+(tune.HerdTime or 1.6)+(tune.HerdGap or 2.5)
				Brawler.event(c,a,"Perceive:herd:"..near.kind)
			end
			if self.herdUntil and now&lt;self.herdUntil then
				-- Where to stand: on the far side of him from the surface.
				local want=-near.direction
				local have=-seen.line
				if have:Dot(want)&lt;.85 then
					local cross=have.X*want.Z-have.Z*want.X
					local s=if cross&lt;0 then 1 else -1
					a.move=(tangent*s+toward*(if distance&gt;5 then .35 else -.15)).Unit
					a.sprinting=distance&gt;8
					return
				end
				self.herdUntil=nil
			end
		end
		if self.herdUntil and now&gt;=self.herdUntil then self.herdUntil=nil end
	end
	-- Ninja Embodiment (EMB-002): an entry is a plan, not a walk into the
	-- string. Out of a run (the running strike), over the top (the drop
	-- strike on the way down), round a committed body to its side, or
	-- straight in. The strike then reads the situation the plan made.
	if not self.plan and free and distance&gt;6.5 and distance&lt;13 and self.rng:NextNumber()&lt;(tune.Plan or 0) then
		local roll=self.rng:NextNumber()
		local committed=target.state=="Recovery" or target.state=="TechniqueChannel" or target.state=="TechniqueRecovery" or target.state=="Startup"
		self.plan=if committed and roll&lt;.45 then "flank" elseif roll&lt;.45 then "run" elseif roll&lt;.75 then "jump" else "straight"
		self.planUntil=now+1.4;self.planSide=self.strafeSign or 1
		Brawler.event(c,a,"Plan:"..self.plan)
		if self.plan=="jump" then a.move=toward;c:request(a,"Jump") end
	end
	if self.plan and (now&gt;(self.planUntil or 0) or a.reaction) then self.plan=nil end
	if self.plan=="run" then
		a.move=toward;a.sprinting=false
		if distance&lt;9 and distance&gt;3.5 and c:request(a,"Attack") then self.plan=nil end
		return
	elseif self.plan=="jump" then
		a.move=toward
		local vy=a.root.AssemblyLinearVelocity.Y
		local above=a.root.Position.Y-target.root.Position.Y
		if a.airborne and vy&lt;-6 and distance&lt;6.5 and above&gt;1.5 and above&lt;=6 then
			if c:request(a,"Attack") then self.plan=nil end
		elseif not a.airborne and now&gt;(self.planUntil or 0)-1.1 then self.plan=nil end
		return
	elseif self.plan=="flank" then
		a.move=(tangent*(self.planSide or 1)+toward*.45).Unit
		if distance&lt;5.5 and c:request(a,"Attack") then self.plan=nil end
		return
	elseif self.plan=="straight" then self.plan=nil end
	if distance&lt;math.max(8,reach) and self.rng:NextNumber()&lt;tune.Aggression then
		c:request(a,if a.grabVictim then "Attack" elseif distance&lt;5 and self.rng:NextNumber()&lt;.12 then "Grab" elseif self.rng:NextNumber()&lt;.16 then "Heavy" else "Attack")
	end
	-- Out-ranged (sand lashes): close the gap instead of waiting at its edge.
	local theirs=(target.def.AttackProfile and target.def.AttackProfile.Light1 and target.def.AttackProfile.Light1.range or 6)
	if theirs&gt;reach and distance&gt;reach-1 and distance&lt;theirs+3 and target.state~="Startup" then
		a.move=toward;a.sprinting=true
		if distance&gt;Config.Rush.MinRange+.5 and self.rng:NextNumber()&lt;.3 and not laneOnPath(c,a,target) and c:request(a,"Pursuit") then return end
		if self.rng:NextNumber()&lt;.2 then c:request(a,"Dodge");return end
	end
	if distance&gt;6 and distance&lt;17 and self.rng:NextNumber()&lt;0.1 then c:request(a,"Jump") end
	-- Chakra dash in from mid range when the opponent is not attacking (nor
	-- holding a guard the arrival would run into); Neji closes in from closer.
	local dashFrom=if a.fighterId=="GentleFist" then 7.5 else 11
	-- Keener at the start of a press and from far away (walking twenty studs
	-- into a zoner is the slow answer).
	local keen=.1*(DASH[a.fighterId] or 1)
	if (self.entryUntil or 0)&gt;now then keen*=4 elseif distance&gt;desired+10 then keen*=2 end
	if zoner then keen*=1.3 end
	if not calm and distance&gt;dashFrom and distance&lt;44 and target.state~="Startup" and target.state~="TechniqueChannel" and target.state~="Guarding"
		and self.rng:NextNumber()&lt;keen and not laneOnPath(c,a,target) then
		if c:request(a,"Pursuit") then self.entryUntil=nil;return end
	end
	-- Sidestep cover when the direct route is obstructed.
	local block=workspace:Raycast(a.root.Position,toward*6,c:rayParams(true))
	if block then a.move=tangent; c:request(a,"Jump") end
end
return AI
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND32">
        <Properties>
          <string name="Name">Animation</string>
          <ProtectedString name="Source">-- Bangla PunchMoves animation playback, adapted for server-owned human and AI R15.
-- Combat uses imported choreography; the previous procedural punch fallback is removed.
local Shared=game:GetService('ReplicatedStorage').NinjaDuel
local Combo=require(Shared.BanglaCombo)
local Bindings=require(Shared.AnimationBindings)
local Donor=require(script.Parent.DonorAnimations)
local RunService=game:GetService('RunService')
local Provider=game:GetService('KeyframeSequenceProvider')
local ServerStorage=game:GetService('ServerStorage')
local Animation={}
local catalog={Idle=656117400,Run=656118852,Walk=656121766,Jump=656117878,Fall=656115606,Climb=656114359}
local cache,failures,loading={},{},{}
local function resolve(name)
 if Bindings[name] and Bindings[name]&gt;0 then return 'rbxassetid://'..Bindings[name] end
 if not RunService:IsStudio() then return nil,'Publish the retargeted '..name..' R15 sequence and fill AnimationBindings.' end
 if cache[name] then return cache[name] end
 if failures[name] then return nil,failures[name] end
 if loading[name] then
  local deadline=os.clock()+15
  repeat task.wait(.05) until not loading[name] or os.clock()&gt;=deadline
  return cache[name],failures[name] or 'Animation fetch still pending'
 end
 loading[name]=true
 local ok,value=pcall(function()
 local seq=Provider:GetKeyframeSequenceAsync('rbxassetid://'..Combo.AnimationIds[name])
 local r15=Donor.retarget(seq);seq:Destroy()
 local folder=ServerStorage:FindFirstChild('BanglaR15Sequences')
 if not folder then folder=Instance.new('Folder');folder.Name='BanglaR15Sequences';folder.Parent=ServerStorage end
 r15.Name=name;r15.Parent=folder
 return Provider:RegisterKeyframeSequence(r15)
 end)
 loading[name]=nil
 if ok then cache[name]=value;return value end
 failures[name]=tostring(value);return nil,failures[name]
end
function Animation.attach(a)
 if a.model:GetAttribute('SkipDonorAnimationQA') then return false end
 local animator=a.hum:FindFirstChildOfClass('Animator');if not animator then return false end
 local player={tracks={},instances={},current=nil,currentEvent=nil};a.animation=player
 a.model:SetAttribute('AuthoredAnimations',true)
 a.model:SetAttribute('DonorAnimationStatus','Loading')
 task.spawn(function()
  for name,id in catalog do
   local asset=Instance.new('Animation');asset.AnimationId='rbxassetid://'..id
   local ok,track=pcall(function() return animator:LoadAnimation(asset) end)
   if a.animation~=player then if ok then track:Destroy() end;asset:Destroy();return end
   table.insert(player.instances,asset)
   if ok then track.Priority=Enum.AnimationPriority.Movement;track.Looped=name=='Idle' or name=='Run' or name=='Walk' or name=='Climb';player.tracks[name]=track end
  end
  local ready=true
  for name in Combo.AnimationIds do
   local ok,id,reason=pcall(resolve,name)
   if a.animation~=player then return end
   if ok and id then
    local asset=Instance.new('Animation');asset.Name=name;asset.AnimationId=id
    local loaded,track=pcall(function() return animator:LoadAnimation(asset) end)
    table.insert(player.instances,asset)
    if loaded then track.Priority=Enum.AnimationPriority.Action;player.tracks[name]=track
    else ready=false;warn('[NinjaDuelAnimation] BLOCKED '..name..': '..tostring(track)) end
   else ready=false;warn('[NinjaDuelAnimation] BLOCKED '..name..': '..tostring(reason or id)) end
  end
  a.model:SetAttribute('DonorAnimationStatus',if ready then 'Ready' else 'Blocked')
 end)
 return true
end
local function choose(a,now)
 if a.health&lt;=0 then return nil end
 if a.state=='Startup' or a.state=='Active' or a.state=='Recovery' and a.attackName and now-a.attackStarted&lt;.5 then
  local action=Combo.Actions[a.attackName]
  -- Missing ninja branches reuse the imported moves; no local pose timeline.
  action=action or (if a.attackName=='Air1' or a.attackName=='DashAttack' then 'Punch' elseif a.attackName=='Air2' then 'HardSmack' else 'MegaPunch')
  return action,a.attackStarted
 end
 if a.reaction or a.state=='Stunned' then return nil end
 if a.state=='Guarding' then return 'Parry',0 end
 if a.state=='TechniqueChannel' then return 'Parry',a.untilTime end
 if a.wall then return 'Climb',0 end
 if a.airborne then return if a.root.AssemblyLinearVelocity.Y&gt;0 then 'Jump' else 'Fall',0 end
 if a.locomotion.Magnitude&gt;2 then return if a.locomotion.Magnitude&gt;30 then 'Run' else 'Walk',0 end
 return 'Idle',0
end
function Animation.step(a,now)
 local p=a.animation;if not p then return false end
 local name,event=choose(a,now)
 if p.current~=name or p.currentEvent~=event then
  if p.current and p.tracks[p.current] then p.tracks[p.current]:Stop(.08) end
  p.current=name;p.currentEvent=event
  if name and p.tracks[name] then p.tracks[name]:Play(.06) end
 elseif name and p.tracks[name] and not p.tracks[name].IsPlaying and (name=='Idle' or name=='Run' or name=='Walk' or name=='Climb' or name=='Parry') then
  p.tracks[name]:Play(.08)
 end
 if (name=='Run' or name=='Walk') and p.tracks[name] then p.tracks[name]:AdjustSpeed(math.clamp(a.locomotion.Magnitude/(if name=='Run' then 32 else 18),.75,1.7)) end
 return true
end
function Animation.clear(a)
 local p=a.animation;a.animation=nil;if not p then return end
 for _,track in p.tracks do track:Stop(0);track:Destroy() end
 for _,asset in p.instances do asset:Destroy() end
end
return Animation
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND33">
        <Properties>
          <string name="Name">BanglaCombat</string>
          <ProtectedString name="Source">-- Adapted from BanglaBattlegrounds ServerScriptService/StarterCombat.
-- Copyright (c) 2024 Dewan Mukto, MIT (vendor/bangla/LICENSE).
-- Retained: forward hitbox, per-swing Hits, damage table, parry seam, hit counter,
-- BasicPunch emission and swing/contact sounds. Changes: one validated actor API,
-- deterministic broadphase for anchored hitboxes, active-window lifetime/cleanup,
-- collision occlusion, and Ninja Duel's guard/chakra/damage authority.
local Debris=game:GetService('Debris')
local assets=game:GetService('ReplicatedStorage').NinjaDuel:WaitForChild('BanglaAssets')
local Combo=require(game:GetService('ReplicatedStorage').NinjaDuel.BanglaCombo)
local Bangla={}
local function sound(parent,id)
 local s=Instance.new('Sound');s.SoundId=id;s.Volume=.5;s.Parent=parent
 s:Play();Debris:AddItem(s,1.5)
end
function Bangla.begin(c,a,p)
 local hitbox=Instance.new('Part')
 hitbox.Name='BanglaHitbox';hitbox.Anchored=true;hitbox.CanCollide=false
 hitbox.CanQuery=false;hitbox.CanTouch=false;hitbox.Transparency=1
 hitbox.Size=Vector3.new(5,5,2)
 hitbox.CFrame=a.root.CFrame*CFrame.new(0,0,-2)
 hitbox.Parent=c.match.effects
 p.donor={hitbox=hitbox,Hits={},action=Combo.Actions[p.name] or 'MegaPunch'}
 -- The donor used Debris for lifetime; c.effects also cleans interrupted swings.
 table.insert(c.effects,{part=hitbox,expires=c.now+p.spec.startup+p.spec.active+.05})
 sound(a.root,'rbxassetid://5835032207')
 a.model:SetAttribute('CombatBase','BanglaBattlegrounds')
end
function Bangla.close(p)
 if p and p.donor then p.donor.hitbox:Destroy() end
end
function Bangla.tryHit(c,a,p)
 local donor=p.donor;local target=a.target
 if not donor or not donor.hitbox.Parent or not target or target.health&lt;=0 then return false end
 -- Same donor forward volume; missing air/grab mechanics supply their bounded shape.
 local hitbox=donor.hitbox
 hitbox.Size=Vector3.new(p.spec.width or 5,p.spec.height or 5,p.spec.depth or 2)
 -- A strike carried out by another body (Ninja Duel Bodies: Naruto's clone)
 -- is thrown, validated and judged from that body's frame (p.from).
 local frame=p.from or a.root.CFrame
 hitbox.CFrame=frame*CFrame.new(0,0,-(p.spec.offset or 2))
 local params=OverlapParams.new();params.FilterType=Enum.RaycastFilterType.Include
 params.FilterDescendantsInstances={target.model}
 -- Touched on a teleported anchored part was unreliable; query the same volume.
 for _,hit in workspace:GetPartBoundsInBox(hitbox.CFrame,hitbox.Size,params) do
  if hit:IsDescendantOf(target.model) and not donor.Hits[target.id] then
   if not c:targetValid(a,target,p.spec.range,p.spec.facing or .05,p.from) then continue end
   donor.Hits[target.id]=true
   local delta=frame.Position-target.root.Position
   local frontal=delta.Magnitude&lt;.001 or target.root.CFrame.LookVector:Dot(delta.Unit)&gt;.15
   local guarded=target.state=='Guarding' and target.chakra&gt;0 and frontal
   local protected=target.state=='TechniqueChannel' and target.pending and not target.pending.spec.Interruptible
   local damage=if Combo.Actions[p.name] then Combo.Damage[donor.action] else p.spec.damage
   c.damageTag=if p.rasengan then "Rasengan" else p.name
   -- A Flow strike (chained on the beat) lands a little harder.
   local flow=if p.flow then require(game:GetService("ReplicatedStorage").NinjaDuel.Config).Flow.Damage else 1
   if p.from then c.hitOrigin=frame.Position end
   local success=c:damage(a,target,damage*(a.def.CombatDamage or 1)*flow*(p.spec.damageScale or 1),false,true)
   if p.from then c.hitOrigin=nil end
   c.damageTag=nil
   -- The defence resolution (guard, Byakugan sight, guard break) is the truth.
   if success then guarded=target.impactStyle=='block' end
   -- A Gentle Fist palm is not a punch: no donor fist burst on the body (the
   -- client strikes the chakra point itself, IdentityFX).
   if success and not a.def.GentleFist then
    -- Contact audio comes from the client's impact feed (VelmoraHitFeedback);
    -- a replicated server Sound here doubled every hit, out of sync.
    local vfx=if donor.action=='MegaPunch' then 'ComboPunch' else 'BasicPunch'
    local basicPunch=assets.VFX[vfx].Attachment:Clone()
    basicPunch.Parent=target.root
    for _,v in basicPunch:GetChildren() do
     if v:IsA('ParticleEmitter') then v:Emit(v:GetAttribute('EmitCount') or 1) end
    end
    Debris:AddItem(basicPunch,.25)
   end
   if success then
    if c.now-(a.donorLastHit or -10)&gt;2 then a.donorHitCount=0 end
    a.donorHitCount=(a.donorHitCount or 0)+1;a.donorLastHit=c.now
   end
   return success,guarded,protected
  end
 end
 return false
end
return Bangla
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND34">
        <Properties>
          <string name="Name">BanglaEvade</string>
          <ProtectedString name="Source">-- performEvade from Bangla WalkRunHandler (Dewan Mukto, MIT), adapted.
-- One finite server tick loop replaces leaked RenderStepped connections. No global
-- gravity change; swept travel preserves walls, lane boundaries and root facing.
local Evade={}
function Evade.begin(a,c)
 local direction=if a.move.Magnitude&gt;.1 then a.move.Unit else a.root.CFrame.RightVector
 local evadeDistance=14*(a.def.DashScale or 1)
 local evadeDuration=.32
 -- Movement overhaul (docs/movement/MOVEMENT_OVERHAUL_AUDIT.md): the speed the
 -- body had going in is handed back on the way out, so a dodge inside a run
 -- flows back into the run (or an attack) instead of stopping dead.
 local v=a.root.AssemblyLinearVelocity
 local entry=math.max(Vector3.new(v.X,0,v.Z).Magnitude,(a.locomotion or Vector3.zero).Magnitude)
 -- Locked near the opponent, a side or back dodge is a sidestep / hop away
 -- that keeps the chest on them (Studio: turning into it made every dodge read
 -- as a forward dash, and hid the acrobatic bodies' cartwheel / handspring).
 local keep=false
 if a.locked~=false and a.target and a.target.root then
  local to=a.target.root.Position-a.root.Position;to=Vector3.new(to.X,0,to.Z)
  -- Not out of a committed run away (sprint, or travel facing the way it goes,
  -- Combat:faceLocked): running off, the dodge stays a dash along the run.
  keep=to.Magnitude&lt;40 and to.Magnitude&gt;.1 and direction:Dot(to.Unit)&lt;.5 and not a.sprinting and not a.facingCommitted
 end
 a.evade={startPosition=a.root.Position,targetPosition=a.root.Position+direction*evadeDistance,startTime=c.now,duration=evadeDuration,direction=direction,entry=entry,keep=keep}
end
-- Exit with momentum: at least a running pace along the dodge, at most the
-- sprint, never more than it came in with plus a run (no free speed). Called
-- when the evade runs out and when the dodge state ends first.
function Evade.finish(a)
 local e=a.evade;if not e then return end
 a.evade=nil
 local walk=(a.def.Speed or 18)
 local carry=math.min(math.max(e.entry or 0,walk),walk+(e.entry or 0),45*(a.def.SprintScale or 1))
 local out=e.direction*carry
 a.evadeCarry=out
 local v=a.root.AssemblyLinearVelocity
 a.root.AssemblyLinearVelocity=Vector3.new(out.X,v.Y,out.Z)
end
function Evade.step(a,c,travel)
 local e=a.evade;if not e then return end
 local rootPart=a.root
 local targetPosition=e.targetPosition
 local evadeDuration=e.duration
 local startTime=e.startTime
 local elapsedTime=c.now-startTime
 if elapsedTime&lt;evadeDuration then
  local t=math.clamp(elapsedTime/evadeDuration,0,1)
  -- Fast launch, soft brake: distance stays deterministic without the donor's
  -- moving-origin snap near the end of the evade. Quadratic, not cubic: the
  -- cubic left at 3x the mean speed (~2 studs in the first frame), which read
  -- as a pop in Studio; same distance and duration.
  local eased=1-(1-t)^2
  local position=e.startPosition:Lerp(targetPosition,eased)
  local delta=position-rootPart.Position
  travel(a,c,delta,delta.Magnitude)
  -- Turn into the dash at a bounded rate instead of snapping 90 degrees in a frame.
  local dt=math.max(1/240,c.now-(e.lastAt or startTime));e.lastAt=c.now
  -- Only a forward-ish dodge turns the body into it (Studio, §20 route: a side
  -- dodge out of a sprint swung the root 90 degrees and back in 0.3 s, a
  -- pivot that also hid the cartwheel); sideways or back, the body keeps its
  -- facing and the dodge reads as a sidestep / hop back (or the acrobatics).
  local look=rootPart.CFrame.LookVector;look=Vector3.new(look.X,0,look.Z)
  local ahead=look.Magnitude&lt;.05 or e.direction:Dot(look.Unit)&gt;.3
  if e.direction.Magnitude&gt;.1 and not e.keep then if ahead then c:turnToward(a,e.direction,dt,900) end
  elseif e.keep and a.target and a.target.root then
   -- Chest held on them through the sidestep / hop away (small corrections).
   local to=a.target.root.Position-rootPart.Position
   to=Vector3.new(to.X,0,to.Z)
   if to.Magnitude&gt;.1 then c:turnToward(a,to,dt,900) end
  end
  rootPart.AssemblyLinearVelocity=Vector3.zero
 else Evade.finish(a) end
end
return Evade
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND35">
        <Properties>
          <string name="Name">Bodies</string>
          <ProtectedString name="Source">-- Light bodies that are not actors (roster hook H12): Naruto's shadow clones
-- first; a puppet or a ninja hound later takes the same path. A body is a
-- point on the stage with a small controller, a lifetime and a hit volume:
-- one blow from the other side (a strike, a blade, a dome) dispels it.
-- It never becomes a target, a lock-on or a camera subject: Combat keeps its
-- two actors. Bodies only add strike origins (a blow is judged from where the
-- body stands, through Combat hitOrigin, so a frontal guard does not cover a
-- clone behind) and volumes the opponent's strikes and blades reach first.
-- The client draws them from the snapshot (`bodies`, Client/BodyViews).
--
-- Data: Fighters[id].Bodies[kind] = {Max, Cost, Life, ...} (Max counts the
-- persistent bodies; a body made for one strike is `ephemeral`).
-- Persist=true: a body that carried a strike returns to its own controller
-- instead of being spent (a marionette, not a one-strike clone).
-- MoveGraphs[id].proxy[move] = {move, body, summon, solo, awake}: a strike
-- another body carries out (Bodies.route / Bodies.bind); Attacks[move].proxy
-- says where it stands ("behind", "side", "under").
local Bodies={}
Bodies.RADIUS=1.2 -- horizontal reach of a body's volume
Bodies.HALF=2.7 -- half height around its root (feet to head)
-- Kit hooks, filled by fighter modules (Server/Legion): a controller per
-- mode, what a dispel of a kind does, what a transforming tool becomes.
Bodies.controllers={}
Bodies.onDispel={}
Bodies.transforms={}
-- Jutsu volumes go through a body (it puffs away, the jutsu carries on);
-- blades stop in it.
local VOLUME={fireball=true,phoenix=true,palm=true,wind=true,sandwave=true}
local function flat(v) return Vector3.new(v.X,0,v.Z) end
local function brawler() return require(script.Parent.Brawler) end
local function list(c) c.bodies=c.bodies or {};return c.bodies end
Bodies.list=list
function Bodies.tuning(a,kind)
	return (a.def.Bodies and a.def.Bodies[kind]) or {}
end
-- An awakening that takes the bodies away (Naruto's Nine-Tails cloak).
function Bodies.blocked(c,a)
	local tune=a.def.Awakening
	return tune~=nil and tune.NoBodies==true and (a.awakenUntil or 0)&gt;c.now
end
-- Live bodies of `a` (of one kind), persistent ones only unless asked.
function Bodies.of(c,a,kind,ephemeral)
	local out={}
	for _,body in c.bodies or {} do
		if body.alive and body.owner==a and (not kind or body.kind==kind) and (ephemeral or not body.ephemeral) then table.insert(out,body) end
	end
	return out
end
function Bodies.count(c,a,kind) return #Bodies.of(c,a,kind) end
-- A persistent body free for a job (not already carrying a strike or shaping
-- a jutsu): the one nearest the owner's target.
function Bodies.free(c,a,kind)
	local best,bestGap
	local t=a.target
	for _,body in Bodies.of(c,a,kind) do
		if not body.carry and body.mode~="shape" and body.mode~="spent" then
			local gap=if t then (body.position-t.root.Position).Magnitude else 0
			if not bestGap or gap&lt;bestGap then best,bestGap=body,gap end
		end
	end
	return best
end
function Bodies.face(body,point)
	local d=flat(point-body.position)
	if d.Magnitude&gt;.1 then body.look=d.Unit end
end
-- Kinematic motion toward a point (bodies do not collide with fighters).
function Bodies.move(c,body,goal,speed,dt)
	local to=goal-body.position
	local step=speed*dt
	body.position=c:clamp(if to.Magnitude&lt;=step then goal else body.position+to.Unit*step)
end
function Bodies.spawn(c,owner,spec)
	local kind=spec.kind or "clone"
	if not spec.ephemeral and Bodies.count(c,owner,kind)&gt;=(Bodies.tuning(owner,kind).Max or 2) then return nil end
	c.bodySerial=(c.bodySerial or 0)+1
	local position=c:clamp(spec.position or owner.root.Position)
	local look=spec.look
	if not look then
		local t=owner.target
		look=flat(if t then t.root.Position-position else owner.root.CFrame.LookVector)
		look=if look.Magnitude&gt;.1 then look.Unit else Vector3.new(0,0,-1)
	end
	local body={id=c.bodySerial,owner=owner,kind=kind,position=position,look=look,born=c.now,expires=c.now+(spec.life or Bodies.tuning(owner,kind).Life or 6),
		alive=true,state=spec.state or "Neutral",action=spec.action,actionAt=c.now,actionSerial=if spec.action then 1 else 0,mode=spec.mode or "guard",
		ephemeral=spec.ephemeral==true,velocity=Vector3.zero,airborne=spec.airborne==true,side=spec.side or 1,nextStrike=c.now+(spec.delay or 1),warp=0}
	table.insert(list(c),body)
	c:pushImpact(position,"body",false,{phase="appear",kind=kind,body=body.id,owner=owner.id,fighter=owner.fighterId})
	brawler().event(c,owner,"BodySpawned")
	return body
end
-- Gone in a puff of smoke. why: "hit", "blade", "area", "expire", "spent"
-- (its strike is over), "swap" (a substitution), "cloak", "owner".
function Bodies.dispel(c,body,why,by,extra)
	if not body.alive then return false end
	body.alive=false
	local all=c.bodies
	local index=all and table.find(all,body)
	if index then table.remove(all,index) end
	if body.carry then body.carry.lost=true;body.carry.from=nil;body.carry=nil end
	local entry={phase=why or "hit",kind=body.kind,body=body.id,owner=body.owner.id,fighter=body.owner.fighterId,by=by and by.id}
	for k,v in extra or {} do entry[k]=v end
	c:pushImpact(body.position,"body",why=="hit" or why=="blade",entry)
	local hook=Bodies.onDispel[body.kind]
	if hook then hook(c,body,why,by) end
	local Brawler=brawler()
	Brawler.event(c,body.owner,"BodyLost")
	if by and by~=body.owner then
		Brawler.event(c,by,"BodyDispelled")
		c:cue(by,string.upper(body.kind).." DISPELLED",.5)
	end
	return true
end
-- A real relocation (a body flickering across the stage): the client snaps.
function Bodies.warp(c,body,at)
	c:pushImpact(body.position,"body",false,{phase="vanish",kind=body.kind,body=body.id,owner=body.owner.id,fighter=body.owner.fighterId})
	body.position=c:clamp(at);body.warp+=1
	c:pushImpact(body.position,"body",false,{phase="appear",kind=body.kind,body=body.id,owner=body.owner.id,fighter=body.owner.fighterId})
end
-- Where a carried strike is thrown from (Attacks[move].proxy): "behind" the
-- target (the far side from its owner), "side" (the flank the stick asked
-- for), "under" (in close beside it, for a launcher). On the ground.
function Bodies.place(c,a,how,side)
	local b=a.target
	local at=b.root.Position
	local line=flat(at-a.root.Position)
	line=if line.Magnitude&gt;.1 then line.Unit else flat(a.root.CFrame.LookVector).Unit
	local right=line:Cross(Vector3.yAxis)
	local s=if side and side~=0 then side else 1
	local p
	if how=="behind" then p=at+line*2.7
	elseif how=="side" then p=at+right*s*2.9
	else p=at-line*1.9+right*s*1.3 end
	return c:clamp(Vector3.new(p.X,c.match.origin.Y+3,p.Z))
end
-- Which move a press actually starts (Brawler.start): the proxy move with
-- the body that carries it (a free one, or "summon" for its cost), its
-- awakened form, or the solo move when there is no body to carry it.
function Bodies.route(c,a,name)
	local graph=brawler().graph(a)
	local d=graph and graph.proxy and graph.proxy[name]
	if not d then return name end
	if (a.awakenUntil or 0)&gt;c.now and d.awake then return d.awake end
	if not Bodies.blocked(c,a) then
		local free=Bodies.free(c,a,d.body)
		if free then return d.move,free,d.body end
		if d.summon and a.chakra&gt;=(Bodies.tuning(a,d.body).Cost or 12) then return d.move,"summon",d.body end
	end
	return d.solo or name
end
-- The strike's body goes to its spot (a summoned one appears there in a
-- puff, an existing one runs, or flickers from far away) and the strike is
-- judged from it: `p.from` is its frame, kept current by Bodies.step.
function Bodies.bind(c,a,p,proxy,kind)
	local spec=p.spec
	p.side=if (a.angleSide or 0)~=0 then a.angleSide else 1
	local at=Bodies.place(c,a,spec.proxy,p.side)
	local body=proxy
	local span=spec.startup+spec.active+spec.recovery
	if proxy=="summon" then
		a.chakra=math.max(0,a.chakra-(Bodies.tuning(a,kind).Cost or 12))
		body=Bodies.spawn(c,a,{kind=kind,position=at,ephemeral=true,life=span+.6,mode="carry"})
		if not body then p.lost=true;return nil end
	elseif (at-body.position).Magnitude&gt;14 then
		Bodies.warp(c,body,at)
	end
	-- A persistent body that keeps its own job after the strike (tuning
	-- Persist: Sasori's marionette) goes back to it; others are spent.
	if proxy~="summon" and Bodies.tuning(a,body.kind).Persist and body.mode~="carry" then body.resume=body.mode end
	body.carry=p;body.mode="carry";body.goal=at
	body.action=p.name;body.variant=spec.proxyClip;body.actionAt=c.now;body.actionSerial+=1;body.state="Startup"
	body.expires=math.max(body.expires,c.now+span+.6)
	Bodies.face(body,a.target.root.Position)
	p.body=body;p.from=CFrame.lookAt(body.position,body.position+body.look)
	brawler().event(c,a,"BodyStrike")
	return body
end
local function carry(c,body,dt)
	local p=body.carry
	local a=body.owner
	local b=a.target
	if a.pending~=p or a.health&lt;=0 or not b or b.health&lt;=0 then
		-- The strike is over (landed, missed, or its owner was hit): spent,
		-- unless it is a persistent body back to its own job (Persist).
		body.carry=nil;body.state="Recovery"
		if body.resume and a.health&gt;0 and not body.ephemeral then
			body.mode=body.resume;body.resume=nil
			body.actionAt=c.now;body.nextStrike=math.max(body.nextStrike or 0,c.now+.6)
			c:schedule(c.now+.25,function() if body.alive and body.mode~="carry" and body.state=="Recovery" then body.state="Neutral" end end)
			return
		end
		body.resume=nil;body.mode="spent"
		body.expires=math.min(body.expires,c.now+.22)
		return
	end
	body.state=a.state
	if a.state=="Startup" then body.goal=Bodies.place(c,a,p.spec.proxy,p.side) end
	Bodies.move(c,body,body.goal or body.position,90,dt)
	Bodies.face(body,b.root.Position)
	p.from=CFrame.lookAt(body.position,body.position+body.look)
end
function Bodies.step(c,dt)
	local all=c.bodies
	if not all or #all==0 then return end
	for _,body in table.clone(all) do
		if body.alive then
			local owner=body.owner
			if owner.health&lt;=0 or c.match.phase~="Duel" then Bodies.dispel(c,body,"owner")
			elseif c.now&gt;=body.expires then Bodies.dispel(c,body,if body.mode=="spent" then "spent" else "expire")
			elseif Bodies.blocked(c,owner) then Bodies.dispel(c,body,"cloak")
			else
				local from=body.position
				if body.carry then carry(c,body,dt)
				else
					local control=Bodies.controllers[body.mode]
					if control then control(c,body,dt) end
				end
				if body.alive and dt&gt;0 then body.velocity=(body.position-from)/dt end
			end
		end
	end
end
-- A body's own blow (a clone's jab, a barrage kick), judged from where it
-- stands and paid to its owner's account; it never touches its owner's own
-- string (hitConfirmed) and cannot be read or parried into a stun of him.
-- spec: damage, reach, height, arc (cosine of the half angle in front of the
-- body), reaction, push, up, stun, tag. Returns whether it landed.
function Bodies.hitFrom(c,body,victim,spec)
	local owner=body.owner
	if c.match.phase~="Duel" or not body.alive or owner.health&lt;=0 or not victim or victim.health&lt;=0 then return false end
	local d=victim.root.Position-body.position
	local f=flat(d)
	if f.Magnitude&gt;(spec.reach or 5.5) or math.abs(d.Y)&gt;(spec.height or 4) then return false end
	if f.Magnitude&gt;.5 and body.look:Dot(f.Unit)&lt;(spec.arc or .2) then return false end
	local confirmed=owner.hitConfirmed
	c.hitOrigin=body.position;c.damageTag=spec.tag or "Body"
	local landed=c:damage(owner,victim,(spec.damage or 4)*(owner.def.CombatDamage or 1),false,false)
	c.hitOrigin=nil;c.damageTag=nil
	owner.hitConfirmed=confirmed
	if c.match.phase~="Duel" then return landed end
	if landed and victim.impactStyle~="block" and victim.health&gt;0 then
		local push=if f.Magnitude&gt;.1 then f.Unit else body.look
		brawler().react(c,victim,spec.reaction or "HitStun",push*(spec.push or 10)+Vector3.new(0,spec.up or 3,0),spec.stun or .32,owner)
	end
	return landed
end
local function inBox(box,size,point,margin)
	local q=box:PointToObjectSpace(point)
	return math.abs(q.X)&lt;=size.X/2+margin and math.abs(q.Y)&lt;=size.Y/2+Bodies.HALF-.7 and math.abs(q.Z)&lt;=size.Z/2+margin
end
-- A melee strike that reaches an enemy body first (Brawler.hit): the body is
-- dispelled and the strike is spent on it, like a blocked one (the string
-- starts over, the recovery stays short). The real fighter still takes the
-- blow when he stands nearer in the same swing, unless it was aimed at the
-- body (Bodies.aim). A wide swing (Bodies.WIDE: sweeps, spinning kicks,
-- claws) clears every enemy body it covers and still reaches the fighter.
-- Returns true when a body took the strike.
Bodies.WIDE=6.5
function Bodies.strike(c,a,p)
	local all=c.bodies
	if not all or #all==0 or p.lost then return false end
	local spec=p.spec
	local frame=p.from or a.root.CFrame
	local box=frame*CFrame.new(0,0,-(spec.offset or 2))
	local size=Vector3.new(spec.width or 5,spec.height or 5,spec.depth or 2)
	local covered={}
	local best,bestGap
	for _,body in all do
		if body.alive and body.owner~=a and inBox(box,size,body.position,1) then
			table.insert(covered,body)
			local gap=(body.position-frame.Position).Magnitude
			if not bestGap or gap&lt;bestGap then best,bestGap=body,gap end
		end
	end
	if not best then return false end
	local t=a.target
	local real=t~=nil and t.health&gt;0 and inBox(box,size,t.root.Position,1)
	if (spec.width or 5)&gt;=Bodies.WIDE then
		for _,body in covered do Bodies.dispel(c,body,"hit",a) end
		if real then return false end
		a.hitBlocked=true
		return true
	end
	if p.aim~=best and real and (t.root.Position-frame.Position).Magnitude&lt;bestGap then return false end
	a.hitBlocked=true
	Bodies.dispel(c,best,"hit",a)
	return true
end
local function closestOnSegment(a,b,point)
	local ab=b-a
	local length=ab:Dot(ab)
	if length&lt;1e-6 then return a end
	return a+ab*math.clamp((point-a):Dot(ab)/length,0,1)
end
-- A projectile's step through an enemy body (Combat:updateProjectiles): the
-- body puffs away; a blade stops in it (true: the projectile is spent), a
-- jutsu volume carries on (false).
function Bodies.projectile(c,p,step)
	local all=c.bodies
	if not all or #all==0 or not p.a then return false end
	local radius=(p.radius or 0)+(p.growth or 0)*math.max(0,c.now-(p.born or c.now))
	local from=p.position
	local hit,best
	for _,body in all do
		if body.alive and body.owner~=p.a then
			local close=closestOnSegment(from,from+step,body.position)
			local d=body.position-close
			if flat(d).Magnitude&lt;=Bodies.RADIUS+radius and math.abs(d.Y)&lt;=Bodies.HALF+radius then
				local along=(close-from).Magnitude
				if not best or along&lt;best then hit,best=body,along end
			end
		end
	end
	if not hit then return false end
	-- The real fighter nearer on the same step takes it (a clone behind him is
	-- no shield for the blade that reaches him first).
	local t=p.a.target
	if t and t.health&gt;0 then
		local close=closestOnSegment(from,from+step,t.root.Position)
		local d=t.root.Position-close
		if flat(d).Magnitude&lt;=Bodies.RADIUS+radius and math.abs(d.Y)&lt;=Bodies.HALF+radius and (close-from).Magnitude&lt;best then return false end
	end
	local volume=VOLUME[p.kind]==true
	Bodies.dispel(c,hit,"blade",p.a,if volume then {kind=hit.kind,through=p.kind} else {projectile=p.id,blade=p.kind,direction=p.direction})
	return not volume
end
-- Every enemy body of `a` within `radius` of `center` (a dome, a shockwave).
function Bodies.area(c,a,center,radius)
	local all=c.bodies
	if not all or #all==0 then return 0 end
	local count=0
	for _,body in table.clone(all) do
		local d=body.position-center
		if body.alive and body.owner~=a and flat(d).Magnitude&lt;=radius+Bodies.RADIUS and math.abs(d.Y)&lt;6 then
			Bodies.dispel(c,body,"area",a);count+=1
		end
	end
	return count
end
-- The enemy body a string opener is pushed at: the lock stays on the real
-- fighter, the stick picks the clone. nil when the stick points at none in
-- reach, or points closer to the locked target.
function Bodies.aim(c,a)
	local all=c.bodies
	if not all or #all==0 then return nil end
	local stick=flat(a.move or Vector3.zero)
	if stick.Magnitude&lt;.45 then return nil end
	stick=stick.Unit
	local best,bestDot
	for _,body in all do
		if body.alive and body.owner~=a and math.abs(body.position.Y-a.root.Position.Y)&lt;4 then
			local d=flat(body.position-a.root.Position)
			if d.Magnitude&gt;.5 and d.Magnitude&lt;=8 then
				local dot=stick:Dot(d.Unit)
				if dot&gt;=.7 and (not bestDot or dot&gt;bestDot) then best,bestDot=body,dot end
			end
		end
	end
	local t=a.target
	if best and t then
		local d=flat(t.root.Position-a.root.Position)
		if d.Magnitude&gt;.5 and stick:Dot(d.Unit)&gt;bestDot then return nil end
	end
	return best
end
-- The nearest enemy body within `reach` of `a` (the AI answers it).
function Bodies.threat(c,a,reach)
	local best,bestGap
	for _,body in c.bodies or {} do
		if body.alive and body.owner~=a then
			local gap=flat(body.position-a.root.Position).Magnitude
			if gap&lt;=reach and math.abs(body.position.Y-a.root.Position.Y)&lt;4 and (not bestGap or gap&lt;bestGap) then best,bestGap=body,gap end
		end
	end
	return best
end
-- Substitution by swap (Fighters[id].Substitution.Mode "clone"): the free
-- body he trades places with, and that body left where he was hit.
function Bodies.swapWith(c,a)
	local best,bestGap
	for _,body in Bodies.of(c,a) do
		if not body.carry and body.mode~="shape" and body.mode~="spent" then
			local gap=(body.position-a.root.Position).Magnitude
			if gap&lt;=45 and (not bestGap or gap&lt;bestGap) then best,bestGap=body,gap end
		end
	end
	return best
end
function Bodies.swapped(c,body,departure)
	body.position=departure
	return Bodies.dispel(c,body,"swap")
end
-- A tool that turns into a body (ToolMastery.Transform, the chakra chord):
-- the body's cost while one can still be made, else nil.
function Bodies.transformCost(c,a,mastery)
	local kind=mastery and mastery.Transform
	if not kind or not Bodies.transforms[kind] or Bodies.blocked(c,a) then return nil end
	local tune=Bodies.tuning(a,kind)
	if Bodies.count(c,a,kind)&gt;=(tune.Max or 2) then return nil end
	return tune.Cost or 12
end
-- The transforming tool in flight: close to its target, or at the end of its
-- flight, it becomes the body (Bodies.transforms[kind]). true: the
-- projectile is gone.
function Bodies.transform(c,p,step)
	local make=Bodies.transforms[p.transform]
	local b=p.a.target
	if not make or not b or b.health&lt;=0 or p.a.health&lt;=0 then return false end
	if (b.root.Position-p.position).Magnitude&gt;5.5 and p.remaining-step.Magnitude&gt;0 then return false end
	c:pushImpact(p.position,"body",false,{phase="transform",kind=p.transform,projectile=p.id,owner=p.a.id,fighter=p.a.fighterId})
	make(c,p)
	return true
end
-- Round over, KO, a new duel: every body goes without a puff.
function Bodies.clear(c)
	for _,body in c.bodies or {} do body.alive=false;body.carry=nil end
	if c.bodies then table.clear(c.bodies) end
end
-- The snapshot list the client draws (Matches:view).
function Bodies.view(c)
	local out={}
	for _,body in c.bodies or {} do
		if body.alive then
			table.insert(out,{id=body.id,owner=body.owner.id,fighterId=body.owner.fighterId,kind=body.kind,position=body.position,look=body.look,
				state=body.state,action=body.action,variant=body.variant,actionSerial=body.actionSerial,actionElapsed=c.now-(body.actionAt or c.now),
				airborne=body.airborne,velocity=body.velocity,remaining=math.max(0,body.expires-c.now),mode=body.mode,cast=body.cast,
				ephemeral=body.ephemeral,warp=body.warp})
		end
	end
	return out
end
return Bodies
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND36">
        <Properties>
          <string name="Name">BodyState</string>
          <ProtectedString name="Source">-- Ninja Embodiment (DEC-027, SYS-001 sustained chakra): a technique that is a
-- state of the body, not a packet that plays itself.
--
--   prepare (the technique's channel) -&gt; the state holds on the body (chakra
--   drains while it is kept) -&gt; the body moves freely with it -&gt; the next
--   strike releases it, shaped by the situation it is pressed in -&gt; the world
--   or the opponent takes the consequence.
--
-- A technique opts in with data: `State = {...}` on its spec.
--   Time     seconds the state can be held
--   Drain    chakra per second while held (it ends when the chakra runs out)
--   Strike   the strike it releases into on the ground
--   Air      the strike out of the air (default: the shared drop strike)
--   Wall     the strike off a wall run (default: the shared wall dive)
--   Damage   the released strike's damage
--   World    {contact, element}: how the world takes it (Server/WorldReaction)
--   Style    the contact style pushed to the client on release
--   Name     the cue
-- The state ends on release, on a blow taken, on a guard, when its time or
-- the chakra runs out (a fizzle). Nothing here names a fighter.
local BodyState={}

local function brawler() return require(script.Parent.Brawler) end

function BodyState.active(a,now)
	local s=a.bodyState
	return s~=nil and now&lt;s.untilTime and s or nil
end

function BodyState.enter(c,a,spec)
	local st=spec.State
	a.bodyState={id=spec.Id,spec=spec,state=st,at=c.now,untilTime=c.now+(st.Time or 2)}
	c:cue(a,string.upper(st.Name or spec.Name or spec.Id).." • ATTACK TO RELEASE",.9)
	brawler().event(c,a,"State:"..spec.Id)
	c:pushImpact(a.root.Position,st.Style or "chidori",false,{owner=a.id,state=spec.Id,phase="form"})
end

function BodyState.finish(c,a,why)
	local s=a.bodyState
	if not s then return end
	a.bodyState=nil
	if why~="release" then
		brawler().event(c,a,"StateEnd:"..why)
		if why=="fizzle" then c:cue(a,string.upper(s.state.Name or s.id).." • FADED",.6) end
	end
end

-- Per frame: the drain, the time limit, and what breaks the state.
function BodyState.step(c,a,dt)
	local s=a.bodyState
	if not s then return end
	if a.health&lt;=0 or c.match.phase~="Duel" then a.bodyState=nil;return end
	if a.reaction or a.state=="Stunned" then BodyState.finish(c,a,"broken");return end
	if a.state=="Guarding" then BodyState.finish(c,a,"guard");return end
	a.chakra=math.max(0,a.chakra-(s.state.Drain or 0)*dt)
	if c.now&gt;=s.untilTime or a.chakra&lt;=0 then BodyState.finish(c,a,"fizzle") end
end

-- The strike press while the state holds: the state's strike, shaped by the
-- situation (off a wall: a dive; out of the air: a drop; running: it carries
-- the run). Returns the request's result, or nil when the state does not
-- answer this press.
function BodyState.release(c,a,action)
	local s=BodyState.active(a,c.now)
	if not s or (action~="Attack" and action~="Heavy") then return nil end
	if a.state~="Neutral" and a.state~="Recovery" and a.state~="Dodging" and a.state~="TechniqueRecovery" and a.state~="TechniqueActive" then return nil end
	local Brawler=brawler()
	local st=s.state
	local Motor=require(script.Parent.Motor)
	local move,shape=st.Strike or "Light3","ground"
	if a.wall then
		Motor.detach(a,c.now,false)
		move,shape=st.Wall or "WallDive","wall"
	elseif a.airborne then
		move,shape=st.Air or "DropStrike","air"
	end
	local runSpeed=a.locomotion and a.locomotion.Magnitude or 0
	a.state="Neutral";a.untilTime=c.now;a.evade=nil
	Brawler.breakString(a,a.airborne==true)
	BodyState.finish(c,a,"release")
	local ok=Brawler.start(c,a,move)
	local p=a.pending
	if ok==false or not p then return ok end
	p.spec.damage=st.Damage or p.spec.damage
	p.spec.world=st.World
	p.state=s.id
	a.attackVariant=s.id
	a.lastAttack=c.now
	if shape=="ground" and runSpeed&gt;8 then
		-- Released out of a run: the run is in the thrust.
		local need=runSpeed*(p.spec.travelTime or .3)*.9
		if need&gt;p.spec.travel then p.spec.travel=need;a.travelRemaining=need end
	end
	Brawler.event(c,a,"Release:"..s.id);Brawler.event(c,a,"Release:"..shape)
	c:pushImpact(a.root.Position,st.Style or "chidori",true,{owner=a.id,state=s.id,phase="release",shape=shape})
	c:cue(a,string.upper(st.Name or s.id),.6)
	-- The risk, said to both: a release that touched nothing (not even a
	-- guard) leaves the body open for its whole recovery.
	local serial=a.attackSerial
	c:schedule(c.now+p.spec.startup+p.spec.active+.02,function()
		if a.health&lt;=0 or a.attackSerial~=serial or a.hitConfirmed or a.state~="Recovery" then return end
		c:cue(a,string.upper(st.Name or s.id).." • MISSED • OPEN",.8)
		if a.target and a.target.health&gt;0 then c:cue(a.target,string.upper(st.Name or s.id).." MISSED • PUNISH",.8) end
		Brawler.event(c,a,"StateMissed:"..s.id)
	end)
	return ok
end

function BodyState.snapshot(a,now)
	local s=a.bodyState
	if not s or now&gt;=s.untilTime then return nil end
	return {id=s.id,remaining=s.untilTime-now}
end

return BodyState
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND37">
        <Properties>
          <string name="Name">Brawler</string>
          <ProtectedString name="Source">local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Attacks=require(Shared.Attacks)
local Motor=require(script.Parent.Motor)
local Bangla=require(script.Parent.BanglaCombat)
local MoveGraphs=require(Shared.MoveGraphs)
local ActionContext=require(Shared.ActionContext)
local WorldReaction=require(script.Parent.WorldReaction)
local Perception=require(script.Parent.Perception)
local BodyState=require(script.Parent.BodyState)
local Config=require(Shared.Config)
local Rules=require(Shared.Rules)
-- Bodies that are not actors (Naruto's shadow clones): strikes they carry
-- out, strikes they take first, strikes aimed at them.
local Bodies=require(script.Parent.Bodies)
-- Adapter: reaction/air/grab mechanics missing from the donor; all strike hit
-- volumes/damage/feedback run through Bangla. String progression is Ninja
-- Duel's own (confirmed hits, below), no longer the donor's press counter.
local Brawler={}
-- A fighter module's own route payoffs (MoveGraphs onRoute kinds), e.g.
-- Naruto's "uzumaki" (Server/Legion).
Brawler.payoffs={}
local airReactions={Launched=true,Juggled=true,Knockback=true,Knockdown=true,WallSplat=true,Spiked=true}
local TUNE=Config.Combo
local UP=Vector3.yAxis
local function flatUnit(v)
 local f=Vector3.new(v.X,0,v.Z)
 return if f.Magnitude&gt;.01 then f.Unit else nil
end
-- The move graph this actor fights with: its skill build's copy when it has
-- one (Combat:add), otherwise the canonical MoveGraphs entry.
function Brawler.graph(a)
 return a.graph or MoveGraphs[a.fighterId]
end
-- Ninja Embodiment (EMB-002): the body's situation for the strike input
-- (Shared/ActionContext reads it; this only gathers the server facts).
function Brawler.situation(c,a)
 local b=a.target
 if not b or not b.root or b.health&lt;=0 then return nil end
 local vel=a.root.AssemblyLinearVelocity
 local loco=a.locomotion or Vector3.zero
 if Vector3.new(loco.X,0,loco.Z).Magnitude&gt;Vector3.new(vel.X,0,vel.Z).Magnitude then vel=Vector3.new(loco.X,vel.Y,loco.Z) end
 -- Under an illusion the body reads the image it believes in (Itachi's
 -- Mirage): where it stands, facing this body.
 local fooled=a.decoyPosition and (a.illusionUntil or 0)&gt;c.now
 local seen=if fooled then a.decoyPosition else b.root.Position
 local look=if fooled then (a.root.Position-seen) else b.root.CFrame.LookVector
 local x=ActionContext.read({pos=a.root.Position,look=a.root.CFrame.LookVector,vel=vel,airborne=a.airborne,
  target={pos=seen,look=look,airborne=b.airborne and not fooled,
   down=b.reaction=="Knockdown" or b.reaction=="Wakeup" or b.groundPose~=nil,guarding=b.state=="Guarding"}})
 -- How far this fighter's plain strike already reaches (its step-in plus its
 -- contact): the reach situation starts beyond it.
 local light=Attacks.Light1
 local profile=a.def.AttackProfile and a.def.AttackProfile.Light1
 -- (+1: the strike's volume lands about a stud past the contact distance.)
 x.plainReach=light.travel*(a.def.CombatTravel or 1)*(profile and profile.travel or 1)+(profile and profile.contact or light.contact or 3.6)+1
 -- The stick: what the player (or the bot) is doing with the body as it
 -- presses (moving round him, backing off), so an opener follows the body.
 x.stick=(Brawler.intent(a,c.now))
 -- The space: a surface at the target's back on this body's line (a drive
 -- puts him into it). Not under an illusion (the image has no wall behind).
 if not fooled then
  local seen=Perception.read(c,a)
  x.wallBehind=seen and seen.behindTarget and seen.behindTarget.distance or nil
 end
 return x
end
-- The strike this situation calls for (nil: the plain strike). `only`
-- limits the situations read (inside a string only the wall counts).
function Brawler.contextual(c,a,only)
 local x=Brawler.situation(c,a)
 if not x then return nil end
 return ActionContext.resolve(x,Brawler.graph(a),Attacks,only)
end
local WALL_ONLY={wall=true}
-- The strike a riposte (or a counter stance's answer) comes out as: the
-- fighter's own gesture (MoveGraphs riposte: Madara's pommel, Hashirama's
-- shoulder, Hiruzen's point), and while awake the one Awakening.Riposte
-- names for the stick held now (forward/back/side, `any` otherwise).
function Brawler.riposteMove(c,a,base)
 local graph=Brawler.graph(a) or {}
 local move=base or graph.riposte or "Riposte"
 local aw=a.def.Awakening
 if aw and aw.Riposte and (a.awakenUntil or 0)&gt;c.now then
  local dir=Brawler.intent(a)
  local pick=(dir and aw.Riposte[dir]) or aw.Riposte.any
  if pick and Attacks[pick] then move=pick;Brawler.event(c,a,"AwakenedRiposte") end
 end
 return if Attacks[move] then move else "Riposte"
end
function Brawler.free(a,now)
 return a.reaction==nil or now&gt;=(a.reactionUntil or 0)
end
function Brawler.event(c,a,event)
 a.events=a.events or {};a.events[event]=(a.events[event] or 0)+1
 if c.match.onCombatEvent then c.match.onCombatEvent(a,event) end
end
-- Combo model (CORE_COMBAT_CONVERGENCE_2 §1). A string is counted in
-- CONFIRMED hits: a press, a startup, a buffered input or a whiff never
-- advances it.
--   a.combo / a.airCombo   confirmed hits of the current ground / air string
--   a.stringUntil / a.airStringUntil   until then a press from neutral still
--                          continues it (chain window plus Config.Combo.Grace)
--   a.stringAt             when its last hit was confirmed (a hit taken since
--                          breaks it)
--   pending.step           the count a chain move confirms if it connects
-- Light step = confirmed hits + 1 (third light ends the string); routes ask for
-- confirmed hits; a whiff, a blocked strike or a hit taken restarts at Light1.
function Brawler.chainWindow(c,a)
 return a.state=="Recovery" and a.chainOpen==true and c.now&gt;=(a.chainAt or 0)
end
function Brawler.stringAlive(c,a,air)
 local count=if air then a.airCombo else a.combo
 if (count or 0)&lt;1 then return false end
 if air and not a.airborne then return false end
 if (a.lastHurt or -10)&gt;((if air then a.airStringAt else a.stringAt) or -10) then return false end
 if Brawler.chainWindow(c,a) and (a.chainAir==true)==(air==true) then return true end
 return c.now&lt;=((if air then a.airStringUntil else a.stringUntil) or 0)
end
function Brawler.breakString(a,air)
 if air then a.airCombo=0;a.airStringUntil=0 else a.combo=0;a.stringUntil=0 end
end
function Brawler.resetStrings(a)
 Brawler.breakString(a,false);Brawler.breakString(a,true)
end
-- The swing connected (cleanly, or into armour or a sand shield): it is the
-- string's next confirmed hit.
function Brawler.confirm(c,a,p)
 if p.spec.air then a.airCombo=p.step;a.airStringAt=c.now else a.combo=p.step;a.stringAt=c.now end
end
-- The swing's outcome is known (end of its active window): a clean chain hit
-- keeps its string alive for the chain window plus the grace; a whiff or a
-- blocked hit ends it, so the next press is an opener again.
function Brawler.settle(c,a,p)
 local air=p.spec.air==true
 if a.chainOpen then
  a.chainAir=air
  if air then a.airStringUntil=a.untilTime+TUNE.Grace else a.stringUntil=a.untilTime+TUNE.Grace end
 elseif p.spec.chain then
  Brawler.breakString(a,air)
 end
end
-- Directional intent, relative to the opponent (CORE_COMBAT_CONVERGENCE_2 §1.6):
-- "forward" (toward him), "back" (away), "side" (+1 to the right of the line to
-- him, -1 to the left), or nil for a weak push. Toward and away are wide cones
-- (Config.Combo.Toward/Away), so a camera a few degrees off still reads the
-- route the player meant.
function Brawler.classify(a,stick)
 local m=Vector3.new(stick.X,0,stick.Z)
 if m.Magnitude&lt;TUNE.IntentStrong then return nil,0 end
 local line=a.target and a.target.root and flatUnit(a.target.root.Position-a.root.Position)
 line=line or flatUnit(a.root.CFrame.LookVector) or Vector3.new(0,0,-1)
 local u=m.Unit
 local along=u:Dot(line)
 if along&gt;=TUNE.Toward then return "forward",0 end
 if along&lt;=-TUNE.Away then return "back",0 end
 return "side",if u:Dot(line:Cross(UP))&gt;=0 then 1 else -1
end
-- The directional memory: the latest strong push, sampled every frame and at
-- every packet, so a stick released (or crossing the threshold) a moment
-- before the press still picks the route it was pushed for.
function Brawler.observe(c,a)
 a.intentAt=c.now
 local dir,sideSign=Brawler.classify(a,a.move or Vector3.zero)
 if dir then a.intentMemory={dir=dir,side=sideSign,at=c.now} end
end
-- Movement intent read when a press lands: this is what turns one string into
-- a small move graph per character. The current strong push first, else the
-- latest strong push inside Config.Combo.IntentWindow, else neutral. A
-- buffered press replays its own intent (intentOverride); the AI sets one too.
function Brawler.intent(a,now)
 if a.intentOverride then return a.intentOverride[1],a.intentOverride[2] end
 local dir,sideSign=Brawler.classify(a,a.move or Vector3.zero)
 if dir then return dir,sideSign end
 local memory=a.intentMemory
 now=now or a.intentAt or 0
 if memory and now-memory.at&lt;=TUNE.IntentWindow then return memory.dir,memory.side end
 return "neutral",0
end
-- Presses made while the body is committed wait for its outcome: a swing
-- before its contact is known, a chase or a dash before the arrival, a
-- teleport before it lands.
local function bufferable(a)
 local p=a.pending
 if p and p.kind=="Brawl" and (a.state=="Startup" or a.state=="Active") then return true end
 -- (User 28/10, player agent: 23 presses refused "Committed" in 45 s) A
 -- press in the first frames of a strike's recovery, before its chain window
 -- opens, is what a player mashing does: it waits for the window (or for the
 -- end of the recovery) instead of being eaten.
 if a.state=="Recovery" and a.attackName~=nil then return true end
 if a.state=="Pursuit" or a.state=="Rush" then return true end
 return p~=nil and p.kind=="Technique" and p.spec.Id=="Flashstep" and (a.state=="TechniqueChannel" or a.state=="TechniqueActive")
end
local function bufferExpiry(a)
 local p=a.pending
 local active=0
 if p and a.state=="Startup" and p.kind=="Brawl" then active=p.spec.active
 elseif p and a.state=="TechniqueChannel" then active=p.spec.Active or 0 end
 return a.untilTime+active+TUNE.Buffer
end
-- Re-engage (CORE_COMBAT_CONVERGENCE_2 §3) -----------------------------------
local REENTRY={name="dash",speed=1,arrive=3.6,angle=0,chase=.3}
function Brawler.reentry(a)
 local graph=Brawler.graph(a)
 return (graph and graph.reengage) or REENTRY
end
-- A chase is over once the body is within reach and no longer escaping faster
-- than an air strike follows (a launched body near its apex, a knocked-away
-- one, a grounded one).
function Brawler.chaseArrived(c,a)
 local b=a.target
 if not b or c.now-(a.pursuitStarted or c.now)&lt;.1 then return false end
 if (b.root.Position-a.root.Position).Magnitude&gt;4.6 then return false end
 local rising=if b.reaction and b.reactionVelocity then b.reactionVelocity.Y else 0
 return rising&lt;=30 or not b.airborne
end
-- The re-entry windows in which a press is the arrival strike (dash attack on
-- the ground, the air string in the air) or the arrival heavy.
function Brawler.arrival(c,a)
 if a.state=="Dodging" then return c.now&gt;=a.untilTime-.23 end
 if a.state=="Rush" then
  local r=a.rush
  if c.now&gt;=a.untilTime-.15 then return true end
  if r and not r.line and a.target then
   local d=a.target.root.Position-a.root.Position
   return Vector3.new(d.X,0,d.Z).Magnitude&lt;=(r.arrive or 3.6)+1.4
  end
  return false
 end
 if a.state=="Pursuit" then return Brawler.chaseArrived(c,a) end
 if (a.rushArriveUntil or 0)&gt;c.now then return a.state=="Neutral" or (a.state=="Recovery" and a.arrivalRecovery==true) end
 return false
end
-- The closest planted (not flying, not body) seal of Minato's near the target.
function Brawler.nearSeal(c,a,b,radius)
 local best,bestGap
 for _,seal in require(script.Parent.Techniques).seals(c,a,c.now) do
  if not seal.flying and not seal.body then
   local d=seal.position-b.root.Position
   local gap=Vector3.new(d.X,0,d.Z).Magnitude
   if gap&lt;=(radius or 12) and (not bestGap or gap&lt;bestGap) then best,bestGap=seal.position,gap end
  end
 end
 return best
end
-- Where a dash arrives: a step short of the body on the centre line, an angle
-- beside it (fixed in the world at the start, so it tracks the body without
-- spiralling), or a point through it for a committed line.
function Brawler.rushGoal(a,r)
 local b=a.target
 local y=a.root.Position.Y
 local there=Vector3.new(b.root.Position.X,y,b.root.Position.Z)
 if r.offset then return there+r.offset end
 local line=flatUnit(b.root.Position-a.root.Position) or flatUnit(a.root.CFrame.LookVector) or Vector3.new(0,0,-1)
 if r.past then return there+line*r.past end
 return there-line*r.arrive
end
function Brawler.rushPlan(c,a,style,line)
 local tune=Config.Rush
 local r={style=style,speed=tune.Speed*(style.speed or 1),arrive=style.arrive or 3.6,recovery=style.recovery or tune.Recovery,from=a.root.Position}
 if line then
  r.line=line;r.goal=c:clamp(a.root.Position+line*tune.Reposition)
  return r
 end
 local b=a.target
 local toward=flatUnit(b.root.Position-a.root.Position) or flatUnit(a.root.CFrame.LookVector) or Vector3.new(0,0,-1)
 local right=toward:Cross(UP)
 local angle=style.angle or 0
 local sign=nil
 if style.sealAngle then
  -- A planted seal near the target pulls the re-entry onto its side.
  local seal=Brawler.nearSeal(c,a,b)
  if seal then
   sign=if (seal-b.root.Position):Dot(right)&gt;=0 then 1 else -1
   angle=style.sealAngle;r.speed*=style.sealPull or 1;r.sealed=true
  end
 end
 if angle&gt;0 then
  if not sign then
   local dir,stickSide=Brawler.classify(a,a.move or Vector3.zero)
   sign=if dir=="side" then stickSide else (a.rushSide or 1)
   -- With no side asked for, the angle alternates from one dash to the next.
   a.rushSide=-sign
   -- (shuffle: Naruto) not a plain alternation: an irregular side, and every
   -- third entry a wider angle.
   if style.shuffle and dir~="side" then
    a.rushCount=(a.rushCount or 0)+1
    sign=if (a.rushCount*3+1)%5&lt;2 then 1 else -1
    if a.rushCount%3==0 then angle*=1.5 end
   end
  end
  local rad=math.rad(angle)
  r.offset=(-toward*math.cos(rad)+right*sign*math.sin(rad))*r.arrive
  r.side=sign
 end
 if style.past then r.past=style.past;r.commitAt=c.now+(style.commit or 0) end
 r.goal=Brawler.rushGoal(a,r)
 return r
end
-- The dash is over: a short recovery that converts at once into a strike, a
-- heavy or a grab (Brawler.arrival), and into guard / dodge / jump only after
-- Config.Rush.CancelAfter. Nobody answering it leaves a punishable gap.
function Brawler.arrive(c,a)
 local r=a.rush or {}
 a.rush=nil;a.aimIntent=nil
 -- The dash stops where it arrives: the body keeps a step of momentum, not
 -- the dash speed (measured in Studio: live physics slid the root 10-25 studs
 -- past the opponent through the whole recovery).
 Brawler.brake(a,Config.Rush.Carry or 8)
 local recovery=r.recovery or Config.Rush.Recovery
 c:setState(a,"Recovery",recovery)
 a.recoveryCancelAt=c.now+math.min(Config.Rush.CancelAfter,recovery)
 a.arrivalRecovery=true
 a.rushArriveUntil=c.now+Config.Rush.Arrive
 Brawler.event(c,a,"RushArrive")
end
-- Kill a kinetic burst (dash, chase) down to `carry` studs/s along its line.
function Brawler.brake(a,carry)
 local v=a.root.AssemblyLinearVelocity
 local flat=Vector3.new(v.X,0,v.Z)
 local keep=if flat.Magnitude&gt;.1 then flat.Unit*math.min(flat.Magnitude,carry) else Vector3.zero
 a.root.AssemblyLinearVelocity=Vector3.new(keep.X,v.Y,keep.Z)
 a.locomotion=keep
end
-- Itachi's feint: guard or dodge during his dash stops it where he is; an
-- afterimage carries on the illusion of the approach.
function Brawler.feintRush(c,a)
 a.rush=nil;a.rushArriveUntil=0;a.aimIntent=nil
 Brawler.brake(a,0)
 c:setState(a,"Neutral",0)
 c:pushImpact(a.root.Position,"afterimage",false,{owner=a.id,fighter=a.fighterId,variant="feint"})
 Brawler.event(c,a,"RushFeint")
 c:cue(a,"FEINT",.5)
end
-- Pad re-engage: sprint + dodge with the stick toward a locked opponent at
-- mid range (Combat:request turns it into the re-engage).
function Brawler.dashIntent(c,a)
 if not a.sprinting or not a.locked or a.airborne or a.wall or a.def.SandFlicker then return false end
 local b=a.target
 if not b or b.health&lt;=0 then return false end
 -- The current push (a dodge goes where the stick is now), or the bot's own.
 local dir=if a.intentOverride then a.intentOverride[1] else (Brawler.classify(a,a.move or Vector3.zero))
 if dir~="forward" then return false end
 local d=b.root.Position-a.root.Position
 return Vector3.new(d.X,0,d.Z).Magnitude&gt;=(Brawler.reentry(a).minRange or Config.Rush.MinRange)
end
function Brawler.releaseGrab(a)
 local b=a.grabVictim
 if b then b.grabbedBy=nil;b.reaction=nil;b.reactionUntil=0;a.grabVictim=nil end
 if a.grabbedBy then a.grabbedBy.grabVictim=nil;a.grabbedBy=nil end
end
-- `cause` (optional): what threw the body (a move or technique name); a wall
-- the flight ends on reports it, so the client can say which blow did it.
function Brawler.react(c,a,kind,velocity,duration,source,cause)
 Brawler.releaseGrab(a)
 Bangla.close(a.pending)
 -- A guard break or channel interrupt already set a longer stun: the melee
 -- reaction that follows keeps it instead of shortening it to the move's own.
 duration=math.max(duration,(a.stunFloorUntil or 0)-c.now);a.stunFloorUntil=nil
 a.chainOpen=false;a.recoveryCancelAt=nil
 a.reaction=kind;a.reactionUntil=c.now+duration;a.reactionVelocity=velocity;a.reactionStartedAt=c.now
	 a.reactionSource=source;a.reactionCause=cause
 a.pending=nil;a.buffered=nil;a.attackName=nil;a.guardHeld=false;a.state="Neutral";a.untilTime=c.now
 -- Hit out of it: his own strings and re-entry are over.
 Brawler.resetStrings(a);a.rush=nil;a.arrivalRecovery=nil;a.rushArriveUntil=0
 a.locomotion=Vector3.zero
 if airReactions[kind] then a.airborne=true end
 if kind=="Knockdown" then
  a.invulnerableUntil=c.now+duration+.24
  a.groundPose="Knockdown"
  -- Which side the body rolls onto, taken from the incoming direction.
  local from=a.hitFrom or Vector3.zAxis
  a.groundSide=if a.root.CFrame.RightVector:Dot(from)&gt;=0 then 1 else -1
 end
 if kind=="WallSplat" then a.groundPose="Splat" end
 if not airReactions[kind] then a.groundPose=nil end
end
-- Ninja Embodiment (EMB-003): what a struck body may do about the blow now.
-- "stand": an ordinary standing reaction past its share (Config.Agency.Stand);
-- "air": thrown up or juggled, falling, past its share (a launcher holds
-- longer); "tech": knocked down and just landed. nil: no say yet (or none:
-- grabbed, bound, spiked, pinned to a wall, guard broken).
function Brawler.recoverable(c,a)
 local kind=a.reaction
 if not kind then return nil end
 local tune=Config.Agency
 local started=a.reactionStartedAt or c.now
 local length=math.max((a.reactionUntil or c.now)-started,.01)
 local share=(c.now-started)/length
 if (kind=="HitStun" or kind=="GuardStun") and not a.airborne then
  if share&gt;=tune.Stand and c.now-started&gt;=tune.Min then return "stand" end
  return nil
 end
 if (kind=="Juggled" or kind=="Launched" or kind=="Knockback") and a.airborne and not a.airRecoverUsed then
  -- An air string keeps the body rising, so a juggled body answers past its
  -- share whatever its way; only the earned launcher also waits for its apex.
  local falling=(a.reactionVelocity and a.reactionVelocity.Y or 0)&lt;0
  if kind=="Launched" then if falling and share&gt;=tune.Launched then return "air" end return nil end
  if share&gt;=tune.Air then return "air" end
  return nil
 end
 if kind=="Knockback" and not a.airborne then return "stand" end
 if kind=="Knockdown" and not a.airborne and a.landedAt and c.now-a.landedAt&lt;=tune.Tech then return "tech" end
 return nil
end
-- Take the body back. A "stand" recovery only ends the reaction (the guard or
-- the dodge then proceeds as usual); "air" rights the body in the air; "tech"
-- rolls it out of the knockdown. The price is paid here.
function Brawler.recover(c,a,kind,action)
 local tune=Config.Agency
 if kind=="stand" then
  if action=="Guard" then
   if (a.stamina or 100)&lt;tune.GuardCost then return false,"Exhausted" end
   a.stamina=(a.stamina or 100)-tune.GuardCost
  else
   if a.chakra&lt;tune.StepCost then return false,"Need chakra" end
   a.chakra-=tune.StepCost
  end
 elseif kind=="air" then
  if a.chakra&lt;tune.AirCost then return false,"Need chakra" end
  a.chakra-=tune.AirCost
 end
 local attacker=a.reactionSource or a.target
 local away=if attacker and attacker.root then a.root.Position-attacker.root.Position else -a.root.CFrame.LookVector
 away=Vector3.new(away.X,0,away.Z);away=if away.Magnitude&gt;.05 then away.Unit else -a.root.CFrame.LookVector
 a.reaction=nil;a.reactionUntil=0;a.reactionVelocity=nil;a.groundPose=nil;a.state="Neutral";a.untilTime=c.now
 a.comboHits=0
 if kind=="air" then
  -- Righted in the air: a small lift and drift away from the striker, then
  -- the body falls under its own control (no second air recovery).
  a.airRecoverUsed=true;a.airDodgeUsed=true
  a.root.AssemblyLinearVelocity=away*tune.AirPush+Vector3.new(0,tune.AirLift,0)
  Brawler.event(c,a,"AirRecover");c:cue(a,"RECOVER",.5)
  c:pushImpact(a.root.Position,"recover",false,{owner=a.id,fighter=a.fighterId,kind="air"})
  return true,"Recovered"
 end
 if kind=="tech" then
  -- Rolled out of the fall: up and away, briefly untouchable.
  a.hop={direction=away,remaining=tune.TechDistance,speed=30}
  a.invulnerableUntil=math.max(a.invulnerableUntil or 0,c.now+.3)
  Brawler.event(c,a,"Tech");c:cue(a,"TECH",.5)
  c:pushImpact(a.root.Position,"recover",false,{owner=a.id,fighter=a.fighterId,kind="tech"})
  return true,"Recovered"
 end
 Brawler.event(c,a,"Recover")
 c:pushImpact(a.root.Position,"recover",false,{owner=a.id,fighter=a.fighterId,kind=action=="Guard" and "guard" or "step"})
 return true,"Recovered"
end
function Brawler.start(c,a,name)
 Bangla.close(a.pending)
 -- A strike pressed out of a dash or a chase (the arrival strike) takes over
 -- from it: the burst's speed does not carry the body on through its startup
 -- (Studio: rush -&gt; dash attack slid 1.9 studs into the opponent).
 if a.state=="Rush" or a.state=="Pursuit" then a.rush=nil;a.aimIntent=nil;Brawler.brake(a,Config.Rush.Carry or 8) end
 a.attackWhiffed=nil
 -- Any new strike drops a pending running-strike hand-back (it is for the
 -- run after the swing, not for the next blow of a string).
 a.strikeCarry=nil
 -- A strike another body may carry out (MoveGraphs proxy: Naruto's clones),
 -- or its solo / awakened form when there is no body for it.
 local proxy,kind
 name,proxy,kind=Bodies.route(c,a,name)
 local spec=table.clone(Attacks[name]);spec.travel*=a.def.CombatTravel or 1
	local profile=a.def.AttackProfile and a.def.AttackProfile[name]
	if profile then
		spec.startup*=profile.startup or 1;spec.active*=profile.active or 1;spec.recovery*=profile.recovery or 1;spec.travel*=profile.travel or 1
		spec.travelTime=spec.startup+spec.active;spec.range=profile.range or spec.range;spec.angle=profile.angle
		spec.zone=profile.zone or spec.zone;spec.kind=profile.kind or spec.kind
		spec.chainTool=profile.chainTool;spec.depth=profile.depth or spec.depth;spec.damageScale=profile.damage;spec.offset=profile.offset or spec.offset;spec.width=profile.width or spec.width;spec.impulse=Vector3.new(spec.impulse.X,profile.impulseY or spec.impulse.Y,profile.impulseZ or spec.impulse.Z)
		-- A weapon's reach: the step-in stops further out (Temari's iron fan).
		spec.contact=profile.contact or spec.contact
	end
 -- A drawn kunai (Combat:arm, global): the string and heavy cut with it.
 if a.armed and (name=="Light1" or name=="Light2" or name=="Light3" or name=="Heavy") then
  spec.range=(spec.range or 5)+.6;spec.contact=(spec.contact or 3.2)+.4
  spec.damageScale=(spec.damageScale or 1)*1.1;spec.kind="slash"
 end
 -- An awakening that quickens the body (Awakening.Recovery: Naruto's cloak).
 local awake=a.def.Awakening
 if awake and awake.Recovery and (a.awakenUntil or 0)&gt;c.now then spec.recovery*=awake.Recovery end
 -- A strike that opens (no string alive) may be pushed at an enemy body.
 local opener=not Brawler.stringAlive(c,a,spec.air==true)
 a.buffered=nil
 a.attackVariant=nil
 a.hitBlocked=false
 a.attackSerial=(a.attackSerial or 0)+1
 -- String bookkeeping: a chain move records the count it confirms if it
 -- connects (the string continues only while it is alive); a string ender
 -- (third light, route, heavy, grab, slam) closes its string now.
 local air=spec.air==true
 local step=nil
 if spec.chain then
  if not Brawler.stringAlive(c,a,air) then Brawler.breakString(a,air) end
  step=((if air then a.airCombo else a.combo) or 0)+1
 else
  Brawler.breakString(a,air or name=="Slam")
 end
 a.arrivalRecovery=nil
 a.attackName=name;a.attackStarted=c.now;a.hitConfirmed=false;a.chainOpen=false;a.chainAt=c.now+1e9;a.guardHeld=false
 -- The swing must reach the client as fast as the contact it leads to.
 c.urgent=true
 local slamWindow=0
 if name=="Slam" then
  -- Size the descent so the active window provably ends on or near the floor.
  local drop=math.max(6,a.root.Position.Y-(c.match.origin.Y+3.4))
  -- The plunge starts from rest and accelerates at 320 studs/s² up to 118
  -- (Motor.descend): time that fall, not an instant 118, or the window ends in
  -- mid-air and the recovery hovers there.
  local reach=118*118/(2*320)
  local fall=if drop&lt;=reach then math.sqrt(2*drop/320) else 118/320+(drop-reach)/118
  slamWindow=math.clamp(fall+.04,.28,1.1)
 elseif name=="WallDive" then
  -- The dive lasts as long as the flight to the opponent (92 studs/s).
  local gap=(a.target.root.Position-a.root.Position).Magnitude
  slamWindow=math.clamp(gap/88,.16,.5)
 end
 a.pending={kind="Brawl",name=name,spec=spec,hit=false,slamWindow=slamWindow,flow=a.nextFlow==true,step=step}
 if not a.nextFlow then a.flowStreak=0 end
 a.nextFlow=nil
 Bangla.begin(c,a,a.pending)
 a.travelRemaining=spec.travel
 local flat=a.root.CFrame.LookVector*Vector3.new(1,0,1)
 local delta=a.target.root.Position-a.root.Position;delta=delta*Vector3.new(1,0,1)
 if delta.Magnitude&gt;.1 and delta.Magnitude&lt;11 and (flat:Dot(delta.Unit)&gt;.55 or a.locked) then flat=delta.Unit end
 -- The lock stays on the real fighter, but an opener pushed at one of his
 -- bodies (a shadow clone in reach) swings at it (Bodies.aim; Combat turns
 -- and steps toward it).
 local body=opener and not spec.air and Bodies.aim(c,a)
 if body then
  a.pending.aim=body
  local to=body.position-a.root.Position
  flat=Vector3.new(to.X,0,to.Z).Unit
 end
 -- Locked on, a strike started mid-run turns into the opponent during its
 -- startup (Combat:turnToward, bounded rate) instead of snapping in one frame.
	local side=a.root.CFrame.RightVector*(spec.angle or 0)
	a.travelDirection=(flat+side).Unit;a.state="Startup";a.untilTime=c.now+spec.startup
 if proxy then Bodies.bind(c,a,a.pending,proxy,kind) end
 if spec.air or name=="Slam" then
  -- The air hold carries a string that works (or the first swing of a jump,
  -- and the slam): mashed whiffs used to keep a body hovering a stud above the
  -- floor indefinitely (an AI duel showed four seconds of Air1/Air2 over a
  -- knocked-down opponent).
  -- Movement overhaul (Studio, real keys): a jump-in swing with nobody in
  -- reach keeps the jump's momentum and gravity (a sprint leap's air light
  -- froze at the apex, 58 studs/s to 0); the hold is for an air string at a
  -- body in reach.
  local tgt=a.target and a.target.root
  local gap=tgt and (tgt.Position-a.root.Position)
  local inReach=gap~=nil and Vector3.new(gap.X,0,gap.Z).Magnitude&lt;=(spec.range or 5)+4 and math.abs(gap.Y)&lt;10
  if name=="Slam" or (a.airCombo or 0)&gt;=1 or (not a.airSwingUsed and inReach) then
   -- Combat convergence (Studio: the body hung still ~0.4 s after the last
   -- air hit, a hover): the hold covers the swing itself; through the
   -- recovery gravity takes the body back (the juggled body falls with it, so
   -- the string still reaches). The slam keeps its full hold.
   a.airHold=c.now+spec.startup+math.max(spec.active,slamWindow)+(if name=="Slam" then spec.recovery+.18 else .06)
  end
  a.airSwingUsed=true
 end
 -- Lateral routes leave an afterimage where the body was (a flash for Minato).
 if name=="FeintStep" or name=="AirSwitch" or name=="CircleStep" then
  c:pushImpact(a.root.Position,if a.fighterId=="Flashstep" then "quickstep" else "afterimage",false,{owner=a.id,fighter=a.fighterId})
  -- Where the afterimage stays (a skill build's echo payoff turns it into a decoy).
  a.stepFrom=a.root.Position
 end
 if name=="WallDive" then a.airborne=true;a.airHold=c.now+spec.startup end
 Brawler.event(c,a,name)
 return true
end
-- Disengage branch: hop out of the string while a blade (Minato) or a pair of
-- shuriken (Itachi) covers the retreat. Ends the string; buys space, not damage.
function Brawler.disengage(c,a,kind)
 Bangla.close(a.pending);a.pending=nil;a.attackName=nil;a.chainOpen=false;a.buffered=nil
 Brawler.breakString(a,false)
 local away=a.root.Position-a.target.root.Position;away=Vector3.new(away.X,0,away.Z)
 if away.Magnitude&lt;.1 then away=-a.root.CFrame.LookVector end
 local minato=kind=="Kunai"
 a.state="Recovery";a.untilTime=c.now+(if minato then .26 else .32);a.recoveryCancelAt=a.untilTime
 a.hop={direction=away.Unit,remaining=if minato then 5 else 6,speed=if minato then 46 else 38}
 c:beginThrow(a,{kind=kind,release=if minato then .07 else .1,count=if minato then 1 else 2,interval=.07,
  fire=function(index,target)
   local spread=if minato then Vector3.zero else a.root.CFrame.RightVector*(if index==1 then -.7 else .7)
   c:projectile(a,target+spread,if minato then 96 else 84,22,2,if minato then "kunai" else "shuriken")
  end})
 Brawler.event(c,a,"Disengage")
 return true
end
function Brawler.request(c,a,action)
 local relevant=action=="Attack" or action=="Heavy" or action=="Grab" or action=="ThrowUp"
 if not relevant then return nil end
 -- Throw break: grab back right as you are seized and both are thrown apart.
 if action=="Grab" and a.reaction=="Grabbed" and a.grabbedBy and c.now-(a.grabbedAt or -10)&lt;=Config.ThrowBreak then
  local g=a.grabbedBy
  Brawler.releaseGrab(g);Brawler.releaseGrab(a)
  local away=a.root.Position-g.root.Position;away=Vector3.new(away.X,0,away.Z)
  away=if away.Magnitude&gt;.05 then away.Unit else -a.root.CFrame.LookVector
  for _,x in {a,g} do Bangla.close(x.pending);x.pending=nil;x.attackName=nil;x.chainOpen=false;x.state="Recovery";x.untilTime=c.now+.22;x.recoveryCancelAt=c.now+.12 end
  a.hop={direction=away,remaining=3.5,speed=30};g.hop={direction=-away,remaining=3.5,speed=30}
  c:pushImpact(a.root.Position:Lerp(g.root.Position,.5),"clash",true,{direction=away})
  Brawler.event(c,a,"ThrowBreak");c:cue(a,"THROW BREAK",.7);c:cue(g,"THROW BROKEN",.7)
  return true
 end
 if not Brawler.free(a,c.now) then return false,"Reacting" end
 -- A state of the body (the Chidori held in the hand): the strike releases it.
 local released=BodyState.release(c,a,action)
 if released~=nil then return released end
 -- Riposte: right after a clean block or a perfect dodge, a strike comes out
 -- at once and opens a string (its contact is the string's first hit).
 if action=="Attack" and (a.riposteUntil or 0)&gt;c.now and (a.state=="Guarding" or a.state=="Neutral" or a.state=="Dodging" or a.state=="Recovery") and not a.airborne then
  a.riposteUntil=0;a.guardHeld=false;a.state="Neutral";a.untilTime=c.now;a.evade=nil
  Brawler.breakString(a,false);a.lastAttack=c.now
  c:cue(a,"RIPOSTE",.6);Brawler.event(c,a,"Riposte")
  return Brawler.start(c,a,Brawler.riposteMove(c,a))
 end
 if a.wall then
  -- From a wall run a strike becomes a dive at the opponent: height and an
  -- angle the guard has to read.
  local wall=a.wall
  Motor.detach(a,c.now,false)
  local diving=(action=="Attack" or action=="Heavy") and a.state=="Neutral" and a.target and a.target.health&gt;0
   and (a.target.root.Position-a.root.Position).Magnitude&lt;=Config.Wall.DiveRange
  -- (A dive swings round off the wall over its crouched beat, Combat's
  -- WallDive step; free fights showed the one-frame turn as a 125-165 degree snap.)
  if wall.mode~="run" and (action=="Attack" or action=="Heavy") and not diving then
   -- Movement overhaul (Studio): a strike off a climb swung at the wall itself
   -- (the body still faced it). It springs off: the body turns out, toward
   -- the opponent when they are on this side of the wall.
   local out=Vector3.new(wall.normal.X,0,wall.normal.Z)
   if a.target and a.target.root then
    local to=a.target.root.Position-a.root.Position;to=Vector3.new(to.X,0,to.Z)
    if to.Magnitude&gt;.1 and to.Unit:Dot(out)&gt;0 then out=to end
   end
   if out.Magnitude&gt;.05 then a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+out.Unit) end
  end
  if diving then
   return Brawler.start(c,a,"WallDive")
  end
 end
 if a.grabVictim then
  if action=="Attack" or action=="Heavy" or action=="Grab" or action=="ThrowUp" then
   return Brawler.start(c,a,if action=="Heavy" or action=="ThrowUp" then "ThrowUp" else "Throw")
  end
 end
 local pending=a.pending
 local canChain=Brawler.chainWindow(c,a)
 -- Re-entry windows: the end of a dodge, a dash or a chase arrival.
 local canDash=Brawler.arrival(c,a)
 local reentry=canDash and a.state~="Dodging"
 local style=reentry and Brawler.reentry(a)
 -- Rhythm: a chained press made on the beat (around the moment the chain
 -- opens, not mashed early during the swing) becomes a Flow strike. A bonus
 -- only: an off-beat press chains just the same.
 local pressAt=a.pressAt or c.now;a.pressAt=nil
 a.nextFlow=canChain and pressAt&gt;=(a.chainAt or 0)-Config.Flow.Early and pressAt&lt;=(a.chainAt or 0)+Config.Flow.Late
 -- Flying Thunder God arrival: the technique recovery is cancelled by a strike,
 -- so the teleport flows straight into an attack from the new angle. The
 -- arrival strike opens a fresh string.
 local canFlash=(a.state=="TechniqueRecovery" or a.state=="TechniqueActive") and (a.flashUntil or 0)&gt;c.now
  and (a.pending==nil or (a.pending.kind=="Technique" and a.pending.spec.Id=="Flashstep"))
 -- Rotation already repelled a strike and is winding down: the strike comes
 -- straight out of the spin as the counter.
 if action=="Attack" and (a.counterUntil or 0)&gt;c.now and (a.rotationCounterUntil or 0)&gt;c.now and (a.state=="TechniqueActive" or a.state=="TechniqueRecovery") then
  a.pending=nil;a.rotationUntil=0;c:setState(a,"Neutral",0)
  return Brawler.counterStart(c,a)
 end
 -- A strike pressed inside a counter stance (Read, Rotation) waits for the
 -- stance to pay off instead of being refused.
 if action=="Attack" and Brawler.counterStance(a) then a.counterQueued=c.now;return true,"Buffered" end
 if canFlash then
  a.flashUntil=0;a.state="Neutral";a.untilTime=c.now;a.pending=nil;pending=nil
  local gap=(a.target.root.Position-a.root.Position).Magnitude
  -- The arrival strike (Brawler.hit reads it: a chain carried through the jump).
  local function arrival(ok) a.flashStrike=a.attackSerial;return ok end
  if action=="Heavy" then
   if a.airborne then return arrival(Brawler.start(c,a,"Slam")) end
   return arrival(Brawler.start(c,a,"Launcher"))
  end
  if action=="Attack" then
   if a.airborne then Brawler.breakString(a,true);a.lastAirAttack=c.now;return arrival(Brawler.start(c,a,"Air1")) end
   Brawler.breakString(a,false);a.lastAttack=c.now
   return arrival(Brawler.start(c,a,if gap&gt;5.5 then "DashAttack" else "Light1"))
  end
 end
 if a.state~="Neutral" and a.state~="Guarding" and not canChain and not canDash then
  if bufferable(a) then
   -- Buffer a press made before the outcome of the committed swing, chase,
   -- dash or teleport is known: a press made a few frames early is never
   -- eaten, yet it prepares nothing. It fires when the chain opens (the swing
   -- landed cleanly), on the arrival, or, after a whiff or a block, as a fresh
   -- opener once the full recovery is over. The direction is the one it was
   -- pressed with (or pushed while it waits): Brawler.step.
   local dir,sideSign=Brawler.intent(a)
   a.buffered={action=action,at=c.now,intent={dir,sideSign},explicit=a.intentOverride~=nil,expires=bufferExpiry(a)}
   return true,"Buffered"
  end
  return false,"Committed"
 end
 if action=="Grab" then
  if a.airborne or (a.grabCooldown or 0)&gt;c.now then return false,"Grab unavailable" end
  a.grabCooldown=c.now+1.4;return Brawler.start(c,a,"Grab")
 end
 if action=="ThrowUp" then return false,"No grab" end
 -- Running taijutsu: out of a full sprint the opening strike is the
 -- fighter's own running entry (its DashAttack: Bee's shoulder, Kimimaro's
 -- elbow, Zabuza's handle...; MoveGraphs runStrike names a kicker's flying
 -- kick) and the heavy a sliding sweep. Movement overhaul (Studio, real
 -- keys): the swing carries the run's speed and, after its recovery, hands
 -- part of it back so the run continues (the heavy pays more). Openers only:
 -- the confirmed-hit invariant is untouched.
 if not canChain and not canDash and a.state=="Neutral" and not a.airborne and a.sprinting and a.locomotion.Magnitude&gt;28 and (action=="Attack" or action=="Heavy") then
  local runSpeed=a.locomotion.Magnitude
  local runGraph=Brawler.graph(a) or {}
  -- (User 28/10) Running in is how anyone approaches: the light out of a
  -- run is the string's first blow, carried by the run (it never ends the
  -- exchange); the fighter's running strike (a flying kick that throws the
  -- body away) is a choice, on the heavy.
  local name=if action=="Heavy" then (runGraph.runStrike or "DashAttack") else "Light1"
  if not Attacks[name] then name="FlyingKick" end
  local ok=Brawler.start(c,a,name)
  local p=a.pending
  if ok~=false and p and p.kind=="Brawl" then
   local need=runSpeed*(p.spec.travelTime or .22)*.85
   if need&gt;p.spec.travel then p.spec.travel=need;a.travelRemaining=need end
   -- The run continues after the running strike; the light stays in the string.
   if action=="Heavy" then a.strikeCarry={dir=a.travelDirection,speed=runSpeed*.6,at=c.now} end
   Brawler.event(c,a,"RunningStrike")
  end
  return ok
 end
 local graph=Brawler.graph(a) or {}
 local routes=graph.routes or {}
 -- Inside a confirmed string: its chain window picks routes and heavy
 -- conversions; the light step alone also continues in the short grace after
 -- it (a press a moment late is still the next light, never a route).
 local alive=not a.airborne and Brawler.stringAlive(c,a,false)
 local inChain=canChain and alive
 if action=="Heavy" then
  if a.airborne then
   -- A fighter's own finisher in the same window (MoveGraphs airFinisher,
   -- Rock Lee's lotuses); Sasuke's Lion Combo below stays the default.
   if graph.airFinisher and (a.lionUntil or 0)&gt;c.now and a.target and a.target.health&gt;0 then return Brawler.airFinisher(c,a,graph.airFinisher) end
   -- Lion Combo: after Shadow of the Dancing Leaf, the heavy is a barrage
   -- that ends in a heel drop driving the body into the floor.
   if (a.lionUntil or 0)&gt;c.now and a.target and a.target.health&gt;0 then
    a.lionUntil=0
    -- The flip over the body: the heel comes down from above it.
    local b=a.target
    local look=b.root.Position-a.root.Position;look=Vector3.new(look.X,0,look.Z)
    look=if look.Magnitude&gt;.1 then look.Unit else a.root.CFrame.LookVector
    -- (Continuity blocker) Not a teleport: the body vaults there through
    -- the barrage's startup (Combat's vault step), so the heel comes down
    -- from where the body really went.
    a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+look)
    a.airborne=true
    local ok=Brawler.start(c,a,"Slam")
    if a.pending then a.vault={goal=b.root.Position+Vector3.new(0,2.4,0)-look*1.2,untilTime=c.now+a.pending.spec.startup,serial=a.attackSerial} end
    if a.pending then a.pending.spec.damage=17;a.pending.spec.impulse=Vector3.new(0,-90,8);a.attackVariant="LionBarrage" end
    c:cue(a,"LION COMBO",.9);Brawler.event(c,a,"LionCombo")
    return ok
   end
   -- (User 28/10) The plunge ends an air string; out of a plain jump the
   -- heavy is the salto heel kick (punishable), never a safe drop.
   if (a.airCombo or 0)&gt;=1 or c.now-(a.airStringAt or -10)&lt;1.0 then return Brawler.start(c,a,"Slam") end
   return Brawler.start(c,a,a.def.AirHeavy or "AirFlip")
  end
  if inChain and a.combo==1 and graph.heavyAfterOne then return Brawler.start(c,a,graph.heavyAfterOne) end
  if inChain and a.combo&gt;=2 then return Brawler.start(c,a,a.def.LauncherMove or "Launcher") end
  -- Heavy on a re-engage arrival: the prodigy's quick heavy (knee, palm),
  -- except on a body pinned to a wall, where the heavy is the wall bounce.
  if reentry and graph.heavyAfterOne and not (a.target and a.target.reaction=="WallSplat") then
   Brawler.event(c,a,"ArrivalHeavy");return Brawler.start(c,a,graph.heavyAfterOne)
  end
  return Brawler.start(c,a,a.def.HeavyMove or "Heavy")
 end
 if a.airborne then
  -- Air grammar: after a confirmed air hit the stick picks the follow-up.
  local airAlive=Brawler.stringAlive(c,a,true)
  -- Like the ground routes, an air route also takes the grace after its
  -- window: in Studio, W + a click a moment late after Air1 played Air2.
  if (canChain or a.state=="Neutral") and airAlive and (a.airCombo or 0)&gt;=1 then
   local dir,sideSign=Brawler.intent(a)
   local route=if dir=="forward" then routes.airUp elseif dir=="back" then routes.airDown elseif dir=="side" then routes.airSide else nil
   if route then
    a.angleSide=sideSign;a.lastAirAttack=c.now
    Brawler.event(c,a,"Route");return Brawler.start(c,a,route)
   end
  end
  if not airAlive then
   Brawler.breakString(a,true)
   -- An air opener reads the situation: falling onto a body below is a drop
   -- strike, not the first hit of an air string.
   local move,tag=Brawler.contextual(c,a)
   if move and tag=="drop" then
    a.lastAirAttack=c.now
    Brawler.event(c,a,"Context");Brawler.event(c,a,"Context:"..tag)
    return Brawler.start(c,a,move)
   end
  end
  a.lastAirAttack=c.now
  return Brawler.start(c,a,if (a.airCombo or 0)%2==0 then "Air1" else "Air2")
 end
 -- A successful Read (Itachi) pays off with the graph's counter on the next press.
 if action=="Attack" and graph.readCounter and (a.counterUntil or 0)&gt;c.now and not canChain then
  return Brawler.counterStart(c,a)
 end
 -- Directional combo grammar: inside a confirmed string the stick picks the
 -- route. Toward the opponent launches, away goes low, sideways turns the
 -- angle; each fighter answers with its own move. A route also takes the
 -- grace after the window (Config.Combo.Grace), like the next light: with
 -- toward held, a press a moment late launched in Studio one time in three and
 -- played Light3 otherwise. (Heavy conversions still need the real window.)
 if action=="Attack" and (inChain or (alive and a.state=="Neutral")) then
  local dir,sideSign=Brawler.intent(a)
  local route=nil
  if dir=="forward" and a.combo&gt;=2 then route=routes.up
  elseif dir=="back" and a.combo&gt;=2 then route=routes.down
  elseif dir=="side" and a.combo&gt;=1 then route=routes.side end
  if route and Attacks[route] then
   a.angleSide=sideSign;a.lastAttack=c.now
   Brawler.event(c,a,"Route");Brawler.event(c,a,if dir=="forward" then "RouteUp" elseif dir=="back" then "RouteDown" else "RouteSide")
   return Brawler.start(c,a,route)
  end
 end
 -- (EMB-002) Inside a string the wall decides when it ends: with a surface at
 -- his back, the next press is the drive that puts him into it (the string's
 -- own finisher unless the fighter declares another), not the next light.
 if action=="Attack" and inChain and (a.combo or 0)&gt;=1 then
  local move,tag=Brawler.contextual(c,a,WALL_ONLY)
  if move then
   a.lastAttack=c.now
   Brawler.event(c,a,"Context");Brawler.event(c,a,"Context:"..tag)
   return Brawler.start(c,a,move)
  end
 end
 -- The light step follows the confirmed hits: Light1 opens, Light2 after one
 -- confirmed hit, Light3 (the string's end) after two. Out of a string (a
 -- whiff, a block, a pause, a hit taken) it is Light1 again.
 if not alive then Brawler.breakString(a,false) end
 -- Ninja Embodiment (EMB-002): out of a string (an opener, or after a whiff,
 -- a block or a hit taken), the strike is the one the body's situation calls
 -- for: from behind, from the flank, out of a run, inside arm's length, at
 -- the edge of reach. The light string is what is left when nothing does.
 if action=="Attack" and not inChain and not canDash then
  local move,tag=Brawler.contextual(c,a)
  if move then
   a.lastAttack=c.now
   Brawler.event(c,a,"Context");Brawler.event(c,a,"Context:"..tag)
   if tag=="flank" or tag=="aside" then local _,sideSign=Brawler.intent(a);a.angleSide=if sideSign~=0 then sideSign else (a.angleSide or 1) end
   local runSpeed=a.locomotion and a.locomotion.Magnitude or 0
   local ok=Brawler.start(c,a,move)
   local p=a.pending
   if tag=="away" and ok~=false and p and p.kind=="Brawl" and a.target then
    -- The step back is the move: it goes with the strike, landed or not.
    local back=a.root.Position-a.target.root.Position;back=Vector3.new(back.X,0,back.Z)
    a.hop={direction=if back.Magnitude&gt;.1 then back.Unit else -a.root.CFrame.LookVector,remaining=1.6,speed=18}
    p.spec.travel=0;a.travelRemaining=0
   end
   if tag=="run" and ok~=false and p and p.kind=="Brawl" then
    -- Out of a run the swing carries the run (as out of a sprint, below).
    local need=runSpeed*(p.spec.travelTime or .22)*.85
    if need&gt;p.spec.travel then p.spec.travel=need;a.travelRemaining=need end
    a.strikeCarry={dir=a.travelDirection,speed=runSpeed*.6,at=c.now}
   end
   return ok
  end
 end
 local name="Light"..math.min((a.combo or 0)+1,3)
 a.lastAttack=c.now
 -- Context finisher (Neji): with three chakra points closed, the third palm
 -- becomes the twin-palm thrust that throws the body away.
 if name=="Light3" and a.def.GentleFist and a.target and (a.target.tenketsuUntil or 0)&gt;c.now and (a.target.tenketsu or 0)&gt;=3 then
  return Brawler.start(c,a,"PalmThrust")
 end
 if canDash then
  local ok=Brawler.start(c,a,"DashAttack")
  -- Sasuke's explosive re-entry: the arrival strike lands harder.
  if reentry and style and style.dashDamage and a.pending then
   a.pending.spec.damageScale=(a.pending.spec.damageScale or 1)*style.dashDamage
  end
  return ok
 end
 return Brawler.start(c,a,name)
end
-- What a fighter's own version of a route adds on contact.
function Brawler.routePayoff(c,a,b,p)
 local graph=Brawler.graph(a)
 local kind=graph and graph.onRoute and graph.onRoute[p.name]
 if not kind or b.health&lt;=0 then return end
 local Techniques=require(script.Parent.Techniques)
 -- A payoff a fighter's own module registered (Techniques.payoffs: Temari's updraft).
 local custom=Techniques.payoffs and Techniques.payoffs[kind]
 if custom then custom(c,a,b,p);return end
 if kind=="bodySeal" then
  -- Minato: the rising kick leaves a short seal on the body: 2 follows it up.
  local entry=Techniques.plant(c,a,b.root.Position,Vector3.yAxis,b)
  entry.expires=c.now+1.8
  c:cue(a,"SEALED • 2 TO FOLLOW UP",.8)
 elseif kind=="floorSeal" then
  -- Minato: the sweep plants a marked kunai where the opponent falls.
  local floor=Vector3.new(b.root.Position.X,c.match.origin.Y,b.root.Position.Z)
  Techniques.plant(c,a,floor,Vector3.yAxis)
 elseif kind=="coverBlades" then
  -- Itachi: two shuriken follow the body up, keeping it in the air.
  c:schedule(c.now+.2,function()
   if a.health&lt;=0 or b.health&lt;=0 or c.match.phase~="Duel" then return end
   c:beginThrow(a,{kind="Shuriken",release=.06,count=2,interval=.08,fire=function(index,target)
    local spread=a.root.CFrame.RightVector*(if index==1 then -.6 else .6)
    c:projectile(a,target+spread,92,30,1.5,"shuriken")
   end})
  end)
 elseif kind=="shadowLeaf" then
  -- Sasuke: Shadow of the Dancing Leaf. He shoots up after the rising body
  -- (a free chase); a heavy up there is the Lion Combo.
  a.lionUntil=c.now+2.1
  c:schedule(c.now+.12,function()
   if a.health&lt;=0 or b.health&lt;=0 or c.match.phase~="Duel" or not (b.reaction=="Launched" or b.reaction=="Juggled") then return end
   a.chakra+=Config.PursuitCost
   local from=a.root.Position
   if c:request(a,"Pursuit") then
    -- The shadow sticks to the rising body up to its apex, then hangs there.
    a.untilTime=c.now+.5;a.shadowUntil=a.untilTime;a.airHold=c.now+1.1
    c:pushImpact(from,"afterimage",false,{owner=a.id,fighter=a.fighterId})
    c:cue(a,"SHADOW OF THE DANCING LEAF • HEAVY = "..(if graph.airFinisher then graph.airFinisher.cue else "LION COMBO"),1)
    Brawler.event(c,a,"ShadowLeaf")
   else a.chakra-=Config.PursuitCost end
  end)
 elseif kind=="tenketsu" then
  -- Neji: the low route strikes a second chakra point.
  Brawler.gentleFist(c,a,b,false)
 elseif kind=="echo" then
  -- Itachi (skill build Feint Echo): the feint step's afterimage stays as a
  -- genjutsu decoy; a swing at it is caught (Combat: MirageCatch on a whiff).
  if b.def.Byakugan then c:cue(b,"BYAKUGAN • SEES THROUGH",.8);return end
  b.illusionUntil=c.now+1.2
  b.decoyPosition=c:clamp(a.stepFrom or a.root.Position)
  c:effect("Echo",b.decoyPosition,a.color,Vector3.new(2,5,1),1.2)
  c:pushImpact(a.root.Position,"mirage",false,{owner=a.id,fighter=a.fighterId,to=b.decoyPosition})
  c:cue(a,"ECHO LEFT",.8);c:cue(b,"MIRAGE • TRUST THE BODY",1.2)
 elseif Brawler.payoffs[kind] then
  Brawler.payoffs[kind](c,a,b,p)
 end
end
-- A fighter's own air finisher after the Shadow of the Dancing Leaf
-- (MoveGraphs[...].airFinisher, read by the heavy in its window; Sasuke keeps
-- the Lion Combo). Like the Lion Combo the body is put above the target and the
-- slam drives both down; the descriptor says what it is (name: the client clip
-- and attackVariant, cue, event, damage, impulse, reaction, stun) and what it
-- costs: healthCost from the attacker's own health, never to a KO and refused
-- at or under minHealth (then `fallback`), free in its `awakened` form.
function Brawler.airFinisher(c,a,f)
 a.lionUntil=0
 local b=a.target
 local use,cost=f,f.healthCost or 0
 if f.awakened and (a.awakenUntil or 0)&gt;c.now then use,cost=f.awakened,0
 elseif cost&gt;0 and a.health&lt;=math.max(f.minHealth or 0,cost+1) then use,cost=f.fallback or {},0 end
 local look=b.root.Position-a.root.Position;look=Vector3.new(look.X,0,look.Z)
 look=if look.Magnitude&gt;.1 then look.Unit else a.root.CFrame.LookVector
 -- Beside the body, a little above, more than a body width away and facing
 -- along the line (the dive is head first): put over its head, or turned
 -- toward it, the two bodies interpenetrated all the way down (seen in Studio).
 local side=look:Cross(Vector3.yAxis)
 -- (Continuity blocker) It vaults there through the startup (Combat's vault
 -- step), not a relocation.
 local goal=b.root.Position+Vector3.new(0,1.8,0)+side*3
 a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+look)
 a.airborne=true
 local ok=Brawler.start(c,a,"Slam")
 local p=a.pending
 if p then a.vault={goal=goal,untilTime=c.now+p.spec.startup,serial=a.attackSerial} end
 if p then
  if use.damage then p.spec.damage=use.damage end
  if use.impulse then p.spec.impulse=use.impulse end
  if use.reaction then p.spec.reaction=use.reaction;p.spec.feedback=use.reaction end
  if use.stun then p.spec.stun=use.stun end
  a.attackVariant=use.name
 end
 if cost&gt;0 then a.health=math.max(1,a.health-cost);a.hum.Health=math.max(1,a.health) end
 c:cue(a,use.cue or "AIR FINISHER",.9);Brawler.event(c,a,use.event or "AirFinisher")
 return ok
end
-- The weight of a contact (Combat.Hitstop). By name for the shared grammar,
-- and by what the strike is (Attacks kind / reaction) for a fighter's own
-- routes and heavies (QA-004 M6): a cleaver brought down, a lariat or a
-- launcher of the roster weighed nothing before (every unnamed move was a
-- light, no stop at all).
function Brawler.stopStyle(p)
 local spec=p.spec or {}
 if p.name=="Slam" or spec.kind=="slam" or spec.kind=="spike" then return "slam" end
 if p.name=="Launcher" or p.name=="ThrowUp" or spec.kind=="launch" then return "launcher" end
 if p.name=="Heavy" or p.name=="Throw" or p.name=="Light3" or spec.kind=="heavy" or spec.reaction=="Knockdown" then return "finisher" end
 if spec.air then return "air" end
 return "light"
end
-- Surfaces a flying body can be slammed into: the stadium wall, the field
-- trees and the boulders.
-- (Server/Perception owns the rule: a broken one is a stump or a mound now.)
function Brawler.splatSurface(part)
 return Perception.surface(part)
end
-- Wall splat: a body carried into a wall hard enough sticks to it for a
-- moment. The attacker chooses: pursue (E), pin it with lighter hits or
-- blades, bounce it back out with a heavy blow, or reset. The defender can
-- tech off the wall on the impact (Q), spend a substitution, or take it.
function Brawler.splat(c,a,hit)
 local tune=Config.Wall
 local normal=Vector3.new(hit.Normal.X,0,hit.Normal.Z)
 normal=if normal.Magnitude&gt;.05 then normal.Unit else -a.root.CFrame.LookVector
 a.reaction="WallSplat";a.reactionUntil=c.now+tune.SplatTime;a.splatAt=c.now;a.splatNormal=normal;a.splatPart=hit.Instance
 a.wallSplats=(a.wallSplats or 0)+1
 a.reactionVelocity=Vector3.zero;a.groundPose="Splat";a.invulnerableUntil=c.now
 a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+normal)
 a.hitstopUntil=math.max(a.hitstopUntil or 0,c.now+.07)
 Brawler.event(c,a,"WallSplat")
 local source=a.reactionSource
 -- `cause`/`by`: the blow that drove the body into the wall (a Vacuum Palm
 -- reads as Neji's air pressure on the stone, not a generic wall hit).
 c:pushImpact(hit.Position,"wall",true,{normal=normal,owner=a.id,cause=a.reactionCause,by=source and source.fighterId})
 if source and source.health&gt;0 then
  c.damageTag="wall";c:damage(source,a,tune.SplatDamage,false,false);c.damageTag=nil
  if c.match.phase~="Duel" then return end
  a.reaction="WallSplat";a.state="Neutral";a.untilTime=c.now
  source.pursuitUntil=math.max(source.pursuitUntil or 0,c.now+.8)
  Brawler.event(c,source,"WallConvert")
  c:cue(source,"WALL SPLAT • E PURSUE • HEAVY BOUNCE",.8)
 end
 c:cue(a,"WALL SPLAT • Q ON IMPACT TO TECH",.6)
end
-- Wall Palm (skill build): the nearest wall the body can be driven into, within
-- steer.Range and a cone of +-acos(steer.Cone) around the attacker's facing.
-- Returns the flat direction toward it, or nil (the strike keeps its own line).
function Brawler.wallAim(c,a,b,steer)
 local look=a.root.CFrame.LookVector*Vector3.new(1,0,1)
 if look.Magnitude&lt;.05 then return nil end
 look=look.Unit
 local half=math.acos(math.clamp(steer.Cone,-1,1))
 local params=c:rayParams(true)
 local best,bestDistance
 for k=-2,2 do
  local dir=CFrame.fromAxisAngle(Vector3.yAxis,half*k/2):VectorToWorldSpace(look)
  local hit=workspace:Raycast(b.root.Position,dir*steer.Range,params)
  if hit and math.abs(hit.Normal.Y)&lt;.3 and Brawler.splatSurface(hit.Instance) and (not bestDistance or hit.Distance&lt;bestDistance) then
   best,bestDistance=dir,hit.Distance
  end
 end
 if best then c:cue(a,"WALL READ",.6);Brawler.event(c,a,"WallSteer") end
 return best
end
-- Keep a splatted body on the wall a little longer (lighter hits, blades).
function Brawler.pin(c,b,duration,source)
 if b.reaction~="WallSplat" or (b.splatPins or 0)&gt;=Config.Wall.PinMax then return false end
 b.splatPins=(b.splatPins or 0)+1
 b.reactionUntil=math.max(b.reactionUntil,c.now+duration)
 b.reactionVelocity=Vector3.zero
 c:pushImpact(b.root.Position,"pin",false,{owner=source and source.id,normal=b.splatNormal})
 if source then c:cue(source,"WALL PIN",.5) end
 return true
end
-- Hits on a pinned body: a heavy blow (heavy, launcher, Rasengan, dive) bounces
-- it off the wall back into the open for a fresh air phase; lighter hits pin
-- it for a short extension. Both are limited, so a wall is a phase, not a trap.
function Brawler.wallFollow(c,a,b,p)
 -- graph.wallBounce (skill build Trigram Rebound): extra moves that bounce too.
 local bounce=(Brawler.graph(a) or {}).wallBounce
 local heavy=p.name=="Heavy" or p.name=="Launcher" or p.name=="Slam" or p.name=="WallDive" or p.rasengan==true or (bounce~=nil and bounce[p.name]==true)
 if heavy and not b.wallBounced then
  b.wallBounced=true
  local out=b.splatNormal or -a.root.CFrame.LookVector
  Brawler.react(c,b,"Launched",out*24+Vector3.new(0,46,0),1.05,a)
  b.hitstopUntil=math.max(b.hitstopUntil or 0,c.now+.07);a.hitstopUntil=math.max(a.hitstopUntil or 0,c.now+.04)
  a.pursuitUntil=c.now+1.1
  c:pushImpact(b.root.Position-out*1.2,"wallbounce",true,{normal=out,owner=b.id})
  Brawler.event(c,a,"WallBounce");c:cue(a,"WALL BOUNCE • E TO PURSUE",.9)
  return true
 end
 if not heavy and Brawler.pin(c,b,Config.Wall.PinTime,a) then Brawler.event(c,a,"WallPin");return true end
 return false
end
-- Clash: both strikes became active together, facing, in reach. Neither
-- lands; both fighters are pushed apart into a fresh close-range neutral.
function Brawler.clash(c,a,p)
 local b=a.target
 local q=b and b.pending
 -- (A strike another body carries out, Bodies.bind, never meets a blow thrown at its owner.)
 if not q or q.kind~="Brawl" or q.from or (b.state~="Active" and b.state~="Startup") or b.target~=a or b.hitConfirmed or a.hitConfirmed then return false end
 if q.name=="Grab" or q.name=="Throw" or q.name=="ThrowUp" then return false end
 -- Simultaneous means the two active frames start within the clash window
 -- (the other swing may be a frame or two from becoming active).
 local other=if b.state=="Active" then (b.activeAt or 10) else b.untilTime
 if math.abs((a.activeAt or -10)-other)&gt;Config.Clash.Window then return false end
 local delta=b.root.Position-a.root.Position
 local flat=Vector3.new(delta.X,0,delta.Z)
 if flat.Magnitude&lt;.1 or delta.Magnitude&gt;math.max(p.spec.range or 6,q.spec.range or 6)+1.5 then return false end
 if a.root.CFrame.LookVector:Dot(flat.Unit)&lt;.4 or b.root.CFrame.LookVector:Dot(-flat.Unit)&lt;.4 then return false end
 for _,x in {a,b} do
  Bangla.close(x.pending);x.pending=nil;x.attackName=nil;x.chainOpen=false;x.buffered=nil;x.travelRemaining=0
  -- Neither strike landed: both strings start over.
  Brawler.resetStrings(x)
  x.state="Recovery";x.untilTime=c.now+.24;x.recoveryCancelAt=c.now+.12
  x.hitstopUntil=math.max(x.hitstopUntil or 0,c.now+.08)
 end
 a.hop={direction=-flat.Unit,remaining=Config.Clash.Push,speed=30}
 b.hop={direction=flat.Unit,remaining=Config.Clash.Push,speed=30}
 c:pushImpact(a.root.Position:Lerp(b.root.Position,.5),"clash",true,{direction=flat.Unit})
 Brawler.event(c,a,"Clash");Brawler.event(c,b,"Clash")
 c:cue(a,"CLASH",.6);c:cue(b,"CLASH",.6)
 return true
end
-- Neji's Gentle Fist: palms reach the chakra network. Every palm drains
-- chakra, even through a guard; a clean one closes a chakra point, which slows
-- the victim's chakra recovery for a few seconds (stacks up to four). Each
-- closed point is a real place on the body: the snapshot lists them
-- (tenketsuPoints) and the client lights them, so the network is seen closing.
-- Which point closes follows where the palm landed (the strike's zone).
local TENKETSU_ORDER={
 head={"throat","leftShoulder","rightShoulder","heart","solar","navel","leftHip","rightHip"},
 chin={"throat","heart","leftShoulder","rightShoulder","solar","navel","leftHip","rightHip"},
 body={"heart","solar","navel","leftShoulder","rightShoulder","throat","leftHip","rightHip"},
 legs={"navel","leftHip","rightHip","solar","heart","throat","leftShoulder","rightShoulder"},
}
Brawler.TENKETSU_ORDER=TENKETSU_ORDER
-- Close one point on b; nil when every point is already closed (the palm then
-- only keeps them closed longer).
function Brawler.closePoint(c,a,b,zone)
 local g=a.def.GentleFist
 if (b.tenketsuUntil or 0)&lt;=c.now then b.tenketsu=0;b.tenketsuPoints={} end
 b.tenketsuPoints=b.tenketsuPoints or {}
 b.tenketsuUntil=c.now+g.Duration;b.tenketsuCut=g.RegenCut
 if #b.tenketsuPoints&gt;=g.MaxPoints then b.tenketsu=#b.tenketsuPoints;return nil end
 local closed={}
 for _,id in b.tenketsuPoints do closed[id]=true end
 local point
 for _,id in TENKETSU_ORDER[zone or "body"] or TENKETSU_ORDER.body do if not closed[id] then point=id;break end end
 if not point then return nil end
 table.insert(b.tenketsuPoints,point)
 b.tenketsu=#b.tenketsuPoints
 local severe=b.tenketsu&gt;=g.MaxPoints
 c:pushImpact(b.root.Position,"tenketsu",false,{owner=a.id,fighter=a.fighterId,victim=b.id,point=point,count=b.tenketsu,severe=severe})
 Brawler.event(c,a,"PointClosed")
 if severe then c:cue(b,"CHAKRA NETWORK SEALED",1);Brawler.event(c,a,"Severed") end
 return point
end
-- Every point at once (the last of the Sixty-Four Palms).
function Brawler.sealPoints(c,a,b)
 for _=1,a.def.GentleFist.MaxPoints do if not Brawler.closePoint(c,a,b,"body") then break end end
end
-- The contact entry Combat:damage pushed for a blow on `b` this very frame
-- (a hit, a block), so the blow can say what it was. nil when there is none.
local CONTACT={light=true,palm=true,finisher=true,launcher=true,slam=true,block=true}
function Brawler.contactImpact(c,b)
 local feed=c.impacts or {}
 for i=#feed,1,-1 do
  local entry=feed[i]
  if entry.at~=c.now then return nil end
  if CONTACT[entry.style] and (entry.position-b.root.Position).Magnitude&lt;2.4 then return entry end -- (contact point, not the chest centre)
 end
 return nil
end
-- What a landed (or blocked) strike was, written on its contact: the move, its
-- variant (Rasengan, a counter...), who threw it and at whom. Each fighter's
-- client identity layer draws its own blows from it.
function Brawler.tagContact(c,a,b,p)
 local entry=Brawler.contactImpact(c,b)
 if not entry then return nil end
 entry.move=p.name;entry.variant=a.attackVariant;entry.owner=a.id;entry.fighter=a.fighterId;entry.victim=b.id
 return entry
end
-- How much of its chakra recovery a body keeps under closed points (1: all).
-- Combat regenerates with it, the snapshot shows it on the chakra bar.
function Brawler.tenketsuRegen(a,now)
 if (a.tenketsuUntil or 0)&lt;=now then return 1 end
 return math.max(.2,1-(a.tenketsuCut or .15)*(a.tenketsu or 0))
end
-- `zone`: where the palm landed (defaults to the body's last hit zone);
-- `palm`: a melee contact whose generic hit feedback becomes the palm's.
function Brawler.gentleFist(c,a,b,guarded,zone,palm)
 local g=a.def.GentleFist
 local tune=a.def.Awakening
 local awake=(a.awakenUntil or 0)&gt;c.now and tune
 local boost=if awake then (tune.Drain or 1) else 1
 -- Skill build (Full Field Points): awakened, the palms reach the points
 -- through a guard (full drain and a closed point).
 local through=guarded and awake and tune.GuardPoints==true
 if through then c:cue(a,"FULL FIELD • THROUGH THE GUARD",.5) end
 local drained=(if guarded and not through then g.GuardDrain else g.Drain)*boost
 b.chakra=math.max(0,b.chakra-drained)
 -- The palm's own contact: even a blocked one shows the chakra it drained.
 local entry=if palm then Brawler.contactImpact(c,b) else nil
 if entry then entry.owner=a.id;entry.drain=drained end
 if guarded and not through then return end
 -- The contact reads as a palm on the network, not a punch: the generic light
 -- hit this blow pushed takes the palm's feedback (sound, flash, camera).
 if entry and entry.style=="light" then entry.style="palm" end
 zone=zone or b.hitZone or "body"
 -- Byakugan Full Field: he sees the whole network, a clean palm closes two.
 -- The palm lands on the (first) point it closes: the client strikes there.
 for _=1,(if awake and tune.Points and not guarded then tune.Points else 1) do
  local point=Brawler.closePoint(c,a,b,zone)
  if entry and point and not entry.point then entry.point=point end
 end
 -- Full Field: a palm that breaks a jutsu being moulded cuts the flow itself.
 if awake and tune.ChannelCut and b.interruptedAt==c.now then
  b.sealedUntil=math.max(b.sealedUntil or 0,c.now+tune.ChannelCut)
  c:cue(a,"BYAKUGAN • CHAKRA FLOW CUT",.8);c:cue(b,"CHAKRA FLOW SEALED • NO JUTSU",.9)
  Brawler.event(c,a,"FlowCut")
 end
end
-- Counter stances (Itachi's Read, Neji's Rotation): a strike pressed while the
-- stance holds is kept and fires the moment the stance reads or repels.
function Brawler.counterStance(a)
 local p=a.pending
 return (a.state=="TechniqueChannel" or a.state=="TechniqueActive") and p~=nil and p.kind=="Technique" and (p.spec.Id=="Read" or p.spec.Id=="Rotation")
end
-- The graph's counter (CounterPalm, PalmThrust...) out of a read, a repel or a
-- caught genjutsu. With a reach (a caught image, a repelled body) it glides the
-- distance to the body instead of swinging at the air.
function Brawler.counterStart(c,a)
 local graph=Brawler.graph(a) or {}
 if not graph.readCounter or not a.target then return false end
 a.counterUntil=0;a.counterQueued=nil
 local reach=a.counterReach;a.counterReach=nil
 -- The counter opens a fresh string (combo model: hits, not presses).
 Brawler.breakString(a,false)
 local ok=Brawler.start(c,a,graph.readCounter)
 local p=a.pending
 if ok and p and reach and reach.expires&gt;c.now then
  local d=a.target.root.Position-a.root.Position
  local need=math.clamp(Vector3.new(d.X,0,d.Z).Magnitude-(p.spec.contact or 3.6),0,reach.max)
  if need&gt;p.spec.travel then p.spec.travel=need;a.travelRemaining=need end
  a.attackVariant=reach.variant
 end
 Brawler.event(c,a,"Counter")
 return ok
end
function Brawler.hit(c,a,p)
 local b=a.target;local spec=p.spec
 if p.name=="Throw" or p.name=="ThrowUp" then
  b=a.grabVictim
  if not b or b.health&lt;=0 then return false end
  Brawler.releaseGrab(a)
  local look=a.root.CFrame.LookVector*Vector3.new(1,0,1)
  local direction=if a.move.Magnitude&gt;.2 then a.move.Unit else a.root.CFrame.LookVector
  -- The held body is in front: a throw behind sent it through the thrower
  -- (free fights: Neji's back throw left Hinata 0.46 studs inside him). A
  -- stick pushed back throws to that side instead.
  if look.Magnitude&gt;.1 then
   look=look.Unit
   local flat=Vector3.new(direction.X,0,direction.Z)
   if flat.Magnitude&gt;.1 and flat.Unit:Dot(look)&lt;0 then
    local side=flat-look*flat:Dot(look)
    direction=if side.Magnitude&gt;.1 then side.Unit else look
   end
  end
  a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+direction)
 end
 local success,guarded,protected
 -- A strike carried by a body (Bodies.bind) that was dispelled on the way misses.
 if p.lost then return false end
 if p.name~="Throw" and p.name~="ThrowUp" then
	-- An enemy body in the swing takes it first and puffs away (Bodies.strike).
	if Bodies.strike(c,a,p) then return true end
	-- Two strikes meeting in the same instant cancel out (a carried strike's
	-- body is not its owner's).
	if p.name~="Grab" and not p.from and Brawler.clash(c,a,p) then return false end
	if p.spec.chainTool and not p.chainToolFired then
		p.chainToolFired=true;c:projectile(a,b.root.Position,88,11,2,"needle");Brawler.event(c,a,"ChainTool")
	end
  -- Grab has no donor damage action; donor contact volume still validates it.
  if p.name=="Grab" then
   if not c:targetValid(a,b,spec.range,.05) then return false end
   local donor=p.donor
   donor.hitbox.CFrame=a.root.CFrame*CFrame.new(0,0,-2)
   local params=OverlapParams.new();params.FilterType=Enum.RaycastFilterType.Include;params.FilterDescendantsInstances={b.model}
   if #workspace:GetPartBoundsInBox(donor.hitbox.CFrame,donor.hitbox.Size,params)==0 then return false end
  else
   success,guarded,protected=Bangla.tryHit(c,a,p)
   if not success then return false end
  end
 end
 if p.name=="Grab" then
  if b.invulnerableUntil&gt;c.now or b.grabbedBy or b.reaction=="Wakeup" then return false end
  Brawler.releaseGrab(b);b.pending=nil;b.state="Neutral";b.guardHeld=false
  b.lastHurt=c.now; b.reaction="Grabbed";b.reactionUntil=c.now+.8;b.grabbedBy=a;a.grabVictim=b;b.grabbedAt=c.now
  a.grabUntil=c.now+.8;Brawler.event(c,a,"GrabHit");return true
 end
 if p.name=="Throw" or p.name=="ThrowUp" then
  c.damageTag=p.name;success=c:damage(a,b,spec.damage*(a.def.CombatDamage or 1),false,true);c.damageTag=nil
 end
 -- What landed (or was blocked), written on its contact for the client.
 local contact=if success then Brawler.tagContact(c,a,b,p) else nil
 if not success or b.health&lt;=0 then return success end
 if protected then return true end
 if a.def.GentleFist then Brawler.gentleFist(c,a,b,guarded,p.spec.zone,true) end
 -- Flying Thunder God: the arrival strike lands on a body still inside the
 -- combo that led to the teleport. The chain went on through the relocation.
 if contact and not guarded and a.flashStrike==a.attackSerial and (b.comboHits or 0)&gt;=2 then
  contact.arrival=true
  c:cue(a,"FLYING THUNDER GOD • THE CHAIN GOES ON",.8)
  Brawler.event(c,a,"FlashChain")
 end
 if p.flow and not guarded and b.health&gt;0 then
  a.flowStreak=(a.flowStreak or 0)+1
  b.hitstopUntil=math.max(b.hitstopUntil or 0,c.now+Config.Flow.Stop)
  c:pushImpact(b.root.Position,"flow",false,{owner=a.id,fighter=a.fighterId,count=a.flowStreak})
  c:cue(a,if a.flowStreak&gt;1 then "FLOW ×"..a.flowStreak else "FLOW",.6)
  Brawler.event(c,a,"Flow")
 end
 if guarded then
  a.hitBlocked=true
  b.riposteUntil=c.now+.34
	 c:applyHitstop(a,b,"block",false)
  Brawler.event(c,b,"GuardHit")
  if p.name=="Heavy" or p.name=="Slam" then b.chakra=math.max(0,b.chakra-25) end
  if b.chakra&lt;=0 then Brawler.react(c,b,"GuardStun",Vector3.zero,.6);b.guardHeld=false
	else
		b.guardImpact=c.now+.18
		local push=if p.name=="Heavy" or p.name=="Slam" or p.name=="Light3" then 1.15 else .42
		-- Skidded over a few frames (Combat step), not moved in one.
		b.guardSlide={dir=Vector3.new(a.root.CFrame.LookVector.X,0,a.root.CFrame.LookVector.Z).Unit,remaining=push,speed=push*12}
	end
  return true
 end
 -- (A carried strike drives the body away from its carrier: a clone's kick
 -- from behind sends it toward Naruto.)
 local forward=(p.from or a.root.CFrame).LookVector
 -- Skill build (Wall Palm): the knockback of the listed moves aims at a wall
 -- in reach in front of the attacker, when there is one.
 local steer=a.def.WallSteer
 if steer and steer.Moves[p.name] then forward=Brawler.wallAim(c,a,b,steer) or forward end
 -- A lateral strike (Attacks lateral: Temari's pirouette) throws the body to
 -- the side the stick asked for instead of straight away.
 if spec.lateral then forward=a.root.CFrame.RightVector*(if (a.angleSide or 0)~=0 then a.angleSide else 1) end
 local impulse=forward*spec.impulse.Z+Vector3.yAxis*spec.impulse.Y
 -- What the body took: the client answers a head snap, a fold, a swept base.
 b.hitZone=spec.zone;b.hitKind=spec.kind;b.hitTwist=(spec.side or 1)*(if (a.angleSide or 0)~=0 and spec.orbit then a.angleSide else 1)
 -- A strike that backs off as it lands (Attacks retreat, studs: Madara's heel
 -- with the blade held across, Hiruzen's heel with the point covering).
 if spec.retreat then
  local away=a.root.Position-b.root.Position;away=Vector3.new(away.X,0,away.Z)
  a.hop={direction=if away.Magnitude&gt;.1 then away.Unit else -a.root.CFrame.LookVector,remaining=spec.retreat,speed=26}
 end
 Brawler.routePayoff(c,a,b,p)
 -- Awakening rules on a landed strike (Techniques.awakenedHit/awakenedReact).
 local Techniques=require(script.Parent.Techniques)
 Techniques.awakenedHit(c,a,b,p)
 -- Move-specific weight: a light jab must not stop the fight, a slam must land hard.
 c:applyHitstop(a,b,Brawler.stopStyle(p),false)
 if b.reaction=="WallSplat" and Brawler.wallFollow(c,a,b,p) then Brawler.event(c,a,"Hit");return true end
 -- Super armour (Families Heavy buff): a plain hit-stun strike does not stop him.
 local Families=require(script.Parent.Families)
 if not (spec.reaction=="HitStun" and Families.withstands(b,c.now,false,spec.damage or 0)) then
  Brawler.react(c,b,spec.reaction,impulse,spec.stun,a,a.attackVariant or p.name)
 end
 Techniques.awakenedReact(c,a,b,p)
 -- A family strike (Families Strike/Teleport) adds its contact fields; so
 -- does a fighter's own strike that declares them (Attacks `riders`).
 if p.family or p.spec.riders then Families.strikeHit(c,a,b,p,false) end
 -- A combo that runs too long drops the body out of it (with wake-up cover).
 -- Ninja Embodiment (EMB-003): an air string is a few blows, not a stay up
 -- there (free fights: four seconds and ten hits at 24 studs). Past
 -- Config.Agency.AirHits in one air time the body drops out of it.
 if b.airborne and (b.reaction=="Juggled" or b.reaction=="Launched") then
  b.airStringHits=(b.airStringHits or 0)+1
  if b.airStringHits&gt;Config.Agency.AirHits then
   Brawler.react(c,b,"Knockdown",Vector3.new(impulse.X*.3,math.min(impulse.Y,0)-18,impulse.Z*.3),.5,a)
   Brawler.event(c,a,"AirLimit")
   return true
  end
 end
 if (b.comboHits or 0)&gt;=Config.ComboScaling.MaxHits and b.reaction~="Knockdown" then
  Brawler.react(c,b,"Knockdown",Vector3.new(impulse.X*.3,math.min(impulse.Y,0)-18,impulse.Z*.3),.5,a)
  c:cue(a,"COMBO LIMIT",.7);Brawler.event(c,a,"ComboLimit")
  return true
 end
 if spec.reaction=="Launched" then a.pursuitUntil=c.now+1.15;Brawler.event(c,a,"LaunchHit") end
 -- Knock-away -&gt; chase -&gt; re-entry: a body sent flying by a strike can be
 -- chased down (E) for a fresh exchange.
 if spec.reaction=="Knockback" and b.reaction=="Knockback" then
  a.pursuitUntil=math.max(a.pursuitUntil or 0,c.now+.8)
  c:cue(a,"KNOCK AWAY • E TO CHASE",.7)
 end
 if p.name=="Air1" or p.name=="Air2" then Brawler.event(c,a,"AirHit") end
 if p.name=="Slam" then Brawler.event(c,a,"SlamHit");a.airHold=0 end
 if p.name=="Throw" or p.name=="ThrowUp" then
  Brawler.event(c,a,"ThrowHit")
  -- Projection -&gt; pursuit: the thrown body can be chased to where it lands.
  if p.name=="Throw" then a.pursuitUntil=math.max(a.pursuitUntil or 0,c.now+.9);c:cue(a,"THROWN • E TO CHASE",.8) end
 end
 Brawler.event(c,a,"Hit");return true
end
function Brawler.step(c,a,dt)
 if a.buffered and c.now&gt;a.buffered.expires then a.buffered=nil end
 if a.grabVictim then
  local b=a.grabVictim
  if c.now&gt;=(a.grabUntil or 0) or a.health&lt;=0 or b.health&lt;=0 then Brawler.releaseGrab(a)
  else
   local pos=a.root.Position+a.root.CFrame.LookVector*2.6
   local delta=pos-b.root.Position
   local grip=b.root.Position+(if delta.Magnitude&gt;.001 then delta.Unit*math.min(delta.Magnitude,26*dt) else Vector3.zero)
   b.root.CFrame=CFrame.lookAt(grip,a.root.Position);b.root.AssemblyLinearVelocity=Vector3.zero;b.hum:Move(Vector3.zero)
  end
 end
 if a.reaction then
  if a.reaction=="Grabbed" then return true end
  -- Bound in sand: held in place until the burial or a substitution.
  if a.reaction=="Bound" and c.now&lt;a.reactionUntil then
   a.hum:Move(Vector3.zero);a.root.AssemblyLinearVelocity=Vector3.zero
   return true
  end
  if c.now&gt;=a.reactionUntil then
   if a.reaction=="WallSplat" and a.airborne and a.root.Position.Y&gt;c.match.origin.Y+5 then
    -- Released high on the wall: drop to the floor, then wake up.
    local normal=a.splatNormal or Vector3.zero
    a.reaction="Knockdown";a.reactionUntil=c.now+.9;a.reactionVelocity=normal*7+Vector3.new(0,-6,0)
    a.groundPose="Knockdown";a.invulnerableUntil=c.now+1.1
   elseif a.reaction=="Knockdown" or a.reaction=="WallSplat" then a.reaction="Wakeup";a.reactionUntil=c.now+.24;a.invulnerableUntil=c.now+.24
   else
    a.reaction=nil;a.reactionVelocity=nil
    -- Fully recovered: drop the grounded presentation state with it.
    a.groundPose=nil
   end
  end
  if a.reaction then
   a.hum:Move(Vector3.zero);a.root.AssemblyLinearVelocity=Vector3.zero
   local velocity=a.reactionVelocity or Vector3.zero
   if a.reaction=="WallSplat" then
    -- Pinned: slide slowly down the wall instead of falling off it.
    velocity=Vector3.new(0,math.max(velocity.Y-30*dt,-11),0)
    local hit=Motor.flight(a,c,velocity*dt)
    if hit and hit.Normal.Y&gt;.5 then velocity=Vector3.zero;a.airborne=false;a.landedAt=c.now end
   elseif airReactions[a.reaction] and not a.airborne and velocity.Y&lt;=0 then
    -- Down on the floor (landed, or thrown along it): no more flight, a short
    -- skid on the back that dies out instead of gliding at standing height.
    local skid=Vector3.new(velocity.X,0,velocity.Z)
    if skid.Magnitude&gt;.05 then Motor.travel(a,c,skid,skid.Magnitude*dt) end
    velocity=skid*math.exp(-dt*7)
   elseif airReactions[a.reaction] then
    velocity+=Vector3.new(0,-75*dt,0)
    local hit=Motor.flight(a,c,velocity*dt)
    -- The real floor sits three studs under the root and the swept ray only
    -- reaches 1.4 past the frame's travel: a low flight (a knockback along the
    -- ground, a spike from close above) never touched it, so the body glided
    -- at standing height for the whole reaction and a spike never bounced.
    if not hit and velocity.Y&lt;0 then
     local params=c:rayParams(true);params.RespectCanCollide=true
     local floor=workspace:Raycast(a.root.Position,Vector3.new(0,-3.6,0),params)
     if floor and floor.Normal.Y&gt;.5 then
      -- Set down on the floor itself, not left hanging where the probe caught it.
      a.root.CFrame=CFrame.new(Vector3.new(a.root.Position.X,floor.Position.Y+3,a.root.Position.Z))*a.root.CFrame.Rotation
      hit=floor
     end
    end
    if hit then
     if hit.Normal.Y&gt;.5 and velocity.Y&lt;0 and a.reaction=="Spiked" and not a.groundBounced then
      -- Ground bounce: the spike drives the body into the floor and it pops
      -- back up once, low, for a pick-up.
      a.groundBounced=true;a.reaction="Juggled";a.reactionUntil=c.now+.62
      velocity=Vector3.new(velocity.X*.3,30,velocity.Z*.3)
      c:pushImpact(a.root.Position-Vector3.new(0,2.6,0),"groundbounce",true,{victim=a.id})
      Brawler.event(c,a,"GroundBounce")
      -- The floor keeps the spike (EMB-004): a crater where the body went in.
      WorldReaction.landing(c,a,hit,-velocity.Y)
      a.reactionVelocity=velocity;return true
     end
     if hit.Normal.Y&gt;.5 and velocity.Y&lt;0 then
      if a.reaction=="Spiked" then a.reaction="Knockdown";a.groundPose="Knockdown";a.reactionUntil=c.now+.6;a.invulnerableUntil=c.now+.85 end
      if a.reaction=="Knockdown" then a.reactionUntil=math.min(a.reactionUntil,c.now+.55);Brawler.event(c,a,"LandedSlam") end
      WorldReaction.landing(c,a,hit,-velocity.Y)
      -- The body is on the floor now: stop reporting it as airborne so the
      -- presentation plays the grounded pose instead of an air reaction.
      a.airborne=false;a.airRecoverUsed=false;a.airStringHits=0
      a.landedAt=c.now
      -- A body thrown along the floor keeps some of its run as a skid.
      velocity=Vector3.new(velocity.X,0,velocity.Z)*.6
     elseif math.abs(hit.Normal.Y)&lt;.3 and WorldReaction.body(c,a,hit,-velocity:Dot(hit.Normal),velocity) and hit.Instance:GetAttribute("WorldState")=="Broken" then
      -- (EMB-004) The surface gave way under the body: the tree falls, the
      -- boulder bursts, and the body carries on through with what is left of
      -- its flight instead of sticking to it.
      velocity*=Config.World.SmashCarry
      Brawler.event(c,a,"SmashThrough")
      if a.reactionSource then Brawler.event(c,a.reactionSource,"WorldBreak") end
     elseif math.abs(hit.Normal.Y)&lt;.3 and Brawler.splatSurface(hit.Instance) and -velocity:Dot(hit.Normal)&gt;=Config.Wall.SplatSpeed and (a.wallSplats or 0)&lt;2 then
      Brawler.splat(c,a,hit)
      if c.match.phase~="Duel" or not a.reaction then return true end
      velocity=a.reactionVelocity or Vector3.zero
     end
    end
   else
    -- A light hit (HitStun) slides the body back ~0.9 stud, enough for the
    -- string to drive forward instead of the attacker walking into it.
    Motor.travel(a,c,velocity,velocity.Magnitude*dt);velocity*=math.exp(-dt*(if a.reaction=="HitStun" then 8 else 14))
   end
		 a.reactionVelocity=velocity;return true
  end
 end
 local p=a.pending
 if p and p.kind=="Brawl" then
  if a.state=="Active" and not p.hit then
   -- Re-check every active frame. A single early test used to mark the whole
   -- swing as a whiff, so a target that entered the volume one frame later
   -- took no damage from a visibly connected strike.
   -- Contact is this swing's own: a blade, a burn or a cover shuriken landing
   -- while it is out (they also set hitConfirmed) is not the strike connecting.
   a.hitConfirmed=false
   local hit=Brawler.hit(c,a,p)
   if (hit or a.hitConfirmed) and not p.contact then
    p.contact=true
    -- The string's next confirmed hit (a guarded strike confirms nothing).
    if p.step and not a.hitBlocked then Brawler.confirm(c,a,p) end
   end
   p.hit=hit or nil
   a.hitConfirmed=p.contact==true
  end
 end
 local buffered=a.buffered
 if buffered and c.now&gt;buffered.expires then a.buffered=nil;buffered=nil end
 if buffered and not a.reaction and not (a.throwing and c.now&lt;a.throwing.release) then
  -- Released on the chain (the swing before it landed cleanly), on a re-entry
  -- arrival, or once the body is free again: after a whiff or a block the
  -- buffered press is a fresh opener that waited out the whole recovery.
  local canFlash=(a.flashUntil or 0)&gt;c.now and (a.state=="TechniqueRecovery" or a.state=="TechniqueActive")
   and (a.pending==nil or (a.pending.kind=="Technique" and a.pending.spec.Id=="Flashstep"))
  if Brawler.chainWindow(c,a) or Brawler.arrival(c,a) or canFlash or Rules.canAct(a,c.now) then
   a.buffered=nil;a.pressAt=buffered.at
   -- The direction: a strong push made while it waited wins (the latest
   -- intent), else the one it was pressed with.
   local memory=a.intentMemory
   a.intentOverride=if memory and memory.at&gt;buffered.at and not buffered.explicit then {memory.dir,memory.side} else buffered.intent
   Brawler.request(c,a,buffered.action)
   a.intentOverride=nil
  end
 end
 return false
end
return Brawler
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND38">
        <Properties>
          <string name="Name">BuildPresets</string>
          <ProtectedString name="Source">-- Example ranked builds (PROG-002) and AI budget builds (PROG-003). Every
-- preset is an ordinary build of the fighter's skill tree: Matches validates it
-- through SkillBuilds like a player's, so an AI gets choices, never hidden
-- stats. AI presets favour nodes the current AI already exercises (passive
-- rules, routes, defence riders) over inputs it never makes.
local Presets={}
-- Budget per AI tier: Min/Max skill points, or within NearMax of the fighter's
-- playable maximum (SkillBuilds.maxCost(fighter,true)).
Presets.AITiers={
	{Id="Beginner",Min=20,Max=30},
	{Id="Medium",Min=40,Max=50},
	{Id="Hard",Min=60,Max=70},
	{Id="Boss",Min=80,Max=100},
	{Id="Legendary",NearMax=8},
}
Presets.AI={
	Flashstep={
		Beginner={Why="Seals that survive his substitution: the base loop, a little more forgiving.",
			Nodes={"FlashEconomy","SealCraft","ReturnSeal","DeepReserves","Endurance"}},
		Medium={Why="Adds the air spike that plants a destination and a cheaper Rasengan.",
			Nodes={"FlashEconomy","SealCraft","ReturnSeal","DeepReserves","Endurance","SpikeAnchor","RasenganFocus","QuickHands"}},
		Hard={Why="Rasengan drive pick-ups, longer seals and a parry that seals the attacker.",
			Nodes={"FlashEconomy","SealCraft","ReturnSeal","DeepReserves","Endurance","SpikeAnchor","RasenganFocus","QuickHands","RasenganDrive","SealInk","ParrySeal"}},
		Boss={Why="The full relocation fighter: string teleports and air exits.",
			Nodes={"FlashEconomy","SealCraft","ReturnSeal","DeepReserves","Endurance","SpikeAnchor","RasenganFocus","QuickHands","RasenganDrive","SealInk","ParrySeal","StringFlash","AirExit","LongSeal"}},
		Legendary={Why="Everything, with the floor-seal air spike.",
			Nodes={"SealInk","LongSeal","SealCraft","KunaiRecall","ReturnSeal","FlashEconomy","StringFlash","SpikeAnchor","AirExit","ParrySeal","YellowFlow","QuickstepCut","GaleChase","RasenganFocus","RasenganDrive","DeepReserves","Endurance","QuickHands"}},
	},
	Mirage={
		Beginner={Why="Crow counter and blades: calm defence first.",
			Nodes={"EconomicRead","CrowCounter","Precision","WideFan","SteadyBreath"}},
		Medium={Why="A longer Read and ricochets that lead to a chase.",
			Nodes={"EconomicRead","CrowCounter","Precision","WideFan","SteadyBreath","QuickRead","PatientRead","RicochetChase"}},
		Hard={Why="Feint echoes and the palm that finds the wall.",
			Nodes={"EconomicRead","CrowCounter","Precision","WideFan","SteadyBreath","QuickRead","PatientRead","RicochetChase","FeintEcho","WallPalm","Composure"}},
		Boss={Why="Flank blades and burning geometry: every angle is covered.",
			Nodes={"EconomicRead","CrowCounter","Precision","WideFan","SteadyBreath","QuickRead","PatientRead","RicochetChase","FeintEcho","WallPalm","Composure","FlankBlades","FireTempo","FireGeometry"}},
		Legendary={Why="Everything, with the patient Read and the awakened reflex.",
			Nodes={"QuickRead","EconomicRead","PatientRead","MirageReflex","CrowCounter","Precision","WideFan","RicochetChase","FlankBlades","FeintEcho","WallPalm","ShortSigns","PhoenixVolley","FireTempo","FireGeometry","SteadyBreath","Composure"}},
	},
	GentleFist={
		Beginner={Why="The Rotation defence and a second point on the circular step.",
			Nodes={"SwiftRotation","WideDome","PrecisePalms","PointStep","Conditioning"}},
		Medium={Why="Blades come back off the dome; the vacuum palm closes points.",
			Nodes={"SwiftRotation","WideDome","PrecisePalms","PointStep","Conditioning","ReturningRotation","VacuumEconomy","SealingPalm"}},
		Hard={Why="The outside-step substitution and deeper points.",
			Nodes={"SwiftRotation","WideDome","PrecisePalms","PointStep","Conditioning","ReturningRotation","VacuumEconomy","SealingPalm","NarrowBlindSpot","OutsideStep","DeepPoints"}},
		Boss={Why="Redirecting parries, wall rebounds and a lasting seal.",
			Nodes={"SwiftRotation","WideDome","PrecisePalms","PointStep","Conditioning","ReturningRotation","VacuumEconomy","SealingPalm","NarrowBlindSpot","OutsideStep","DeepPoints","RedirectParry","TrigramRebound","LingeringSeal"}},
		Legendary={Why="Everything, with the 64 Palms string ender.",
			Nodes={"PrecisePalms","DeepPoints","PointStep","PalmBarrage","FullFieldPoints","SwiftRotation","WideDome","ReturningRotation","NarrowBlindSpot","RedirectParry","OutsideStep","VacuumEconomy","SealingPalm","LingeringSeal","TrigramRebound","Conditioning","ChakraControl","ChakraReserve"}},
	},
	Lion={
		Beginner={Why="The Dancing Leaf from the heavy and cheaper fire.",
			Nodes={"DancingLeaf","FireMastery","PhoenixTempo","Stamina","ChakraFlow"}},
		Medium={Why="Wired flames into the Dragon Flame, sharper eyes.",
			Nodes={"DancingLeaf","FireMastery","PhoenixTempo","Stamina","ChakraFlow","ShurikenFan","WiredFlames","SharperEyes"}},
		Hard={Why="Sharingan counters, a faster Chidori, a lighter curse.",
			Nodes={"DancingLeaf","FireMastery","PhoenixTempo","Stamina","ChakraFlow","ShurikenFan","WiredFlames","SharperEyes","SharinganCounter","ChidoriFocus","CurseControl"}},
		Boss={Why="Blood for chakra and the counter-rush: the cornered assault.",
			Nodes={"DancingLeaf","FireMastery","PhoenixTempo","Stamina","ChakraFlow","ShurikenFan","WiredFlames","SharperEyes","SharinganCounter","ChidoriFocus","CurseControl","CurseBlood","CounterRush"}},
		Legendary={Why="Everything, with the wired flames.",
			Nodes={"DancingLeaf","SharperEyes","SharinganCounter","CounterRush","ShurikenFan","BlockedTool","WireCancel","WiredFlames","FireMastery","PhoenixTempo","ChidoriFocus","ChidoriEconomy","WallChidori","CurseControl","CurseBlood","Stamina","ChakraFlow","Reserves"}},
	},
}
-- One example build per ranked bracket: what a fighter looks like at that budget.
Presets.Ranked={
	Flashstep={
		Fundamentals={Why="Teleport strings, kunai recall and the quickstep cut.",
			Nodes={"FlashEconomy","StringFlash","SealInk","KunaiRecall","QuickstepCut","DeepReserves","Endurance"}},
		Identity={Why="The air chain: switch seal and air exits.",
			Nodes={"FlashEconomy","StringFlash","SealInk","KunaiRecall","QuickstepCut","DeepReserves","Endurance","AirSwitchSeal","AirExit","SealCraft","LongSeal","QuickHands"}},
		Advanced={Why="Return seals and the gust that re-enters.",
			Nodes={"FlashEconomy","StringFlash","SealInk","KunaiRecall","QuickstepCut","DeepReserves","Endurance","AirSwitchSeal","AirExit","SealCraft","LongSeal","QuickHands","ReturnSeal","RasenganFocus","GaleChase"}},
		Endgame={Why="The whole tree with the switch seal.",
			Nodes={"SealInk","LongSeal","SealCraft","KunaiRecall","ReturnSeal","FlashEconomy","StringFlash","AirSwitchSeal","AirExit","ParrySeal","YellowFlow","QuickstepCut","GaleChase","RasenganFocus","RasenganDrive","DeepReserves","Endurance","QuickHands"}},
	},
	Mirage={
		Fundamentals={Why="Read cancels, ricochet chases, the feint echo and the crow counter.",
			Nodes={"QuickRead","ReadCancel","Precision","RicochetChase","FeintEcho","EconomicRead","CrowCounter"}},
		Identity={Why="Geometry everywhere: wall palm, wide fan, flank blades.",
			Nodes={"QuickRead","ReadCancel","Precision","RicochetChase","FeintEcho","EconomicRead","CrowCounter","WallPalm","WideFan","FlankBlades","SteadyBreath"}},
		Advanced={Why="Adds burning geometry.",
			Nodes={"QuickRead","ReadCancel","Precision","RicochetChase","FeintEcho","EconomicRead","CrowCounter","WallPalm","WideFan","FlankBlades","SteadyBreath","FireTempo","FireGeometry","Composure"}},
		Endgame={Why="The whole tree with the Read cancel.",
			Nodes={"QuickRead","EconomicRead","ReadCancel","MirageReflex","CrowCounter","Precision","WideFan","RicochetChase","FlankBlades","FeintEcho","WallPalm","ShortSigns","PhoenixVolley","FireTempo","FireGeometry","SteadyBreath","Composure"}},
	},
	GentleFist={
		Fundamentals={Why="Kaiten cancels, returning blades, redirecting parries.",
			Nodes={"PrecisePalms","KaitenCancel","SwiftRotation","ReturningRotation","NarrowBlindSpot","RedirectParry","Conditioning"}},
		Identity={Why="Points everywhere: step, sealing palm, outside step.",
			Nodes={"PrecisePalms","KaitenCancel","SwiftRotation","ReturningRotation","NarrowBlindSpot","RedirectParry","Conditioning","PointStep","VacuumEconomy","SealingPalm","OutsideStep","ChakraControl"}},
		Advanced={Why="Wall rebounds and a wider dome.",
			Nodes={"PrecisePalms","KaitenCancel","SwiftRotation","ReturningRotation","NarrowBlindSpot","RedirectParry","Conditioning","PointStep","VacuumEconomy","SealingPalm","OutsideStep","ChakraControl","TrigramRebound","WideDome","DeepPoints"}},
		Endgame={Why="The whole tree with the 64 Palms ender.",
			Nodes={"PrecisePalms","DeepPoints","PointStep","PalmBarrage","FullFieldPoints","SwiftRotation","WideDome","ReturningRotation","NarrowBlindSpot","RedirectParry","OutsideStep","VacuumEconomy","SealingPalm","LingeringSeal","TrigramRebound","Conditioning","ChakraControl","ChakraReserve"}},
	},
	Lion={
		Fundamentals={Why="Dancing Leaf from the heavy, Sharingan counters, wire cancels.",
			Nodes={"DancingLeaf","SharperEyes","SharinganCounter","BlockedTool","WireCancel","ChidoriFocus","Stamina"}},
		Identity={Why="Wire pins on the walls and the counter-rush.",
			Nodes={"DancingLeaf","SharperEyes","SharinganCounter","BlockedTool","WireCancel","ChidoriFocus","Stamina","ShurikenFan","WirePin","CounterRush","FireMastery","ChakraFlow"}},
		Advanced={Why="A cheaper, faster Chidori and a lighter curse.",
			Nodes={"DancingLeaf","SharperEyes","SharinganCounter","BlockedTool","WireCancel","ChidoriFocus","Stamina","ShurikenFan","WirePin","CounterRush","FireMastery","ChakraFlow","CurseControl","ChidoriEconomy","PhoenixTempo","Reserves"}},
		Endgame={Why="The whole tree with the wall wire.",
			Nodes={"DancingLeaf","SharperEyes","SharinganCounter","CounterRush","ShurikenFan","BlockedTool","WireCancel","WirePin","FireMastery","PhoenixTempo","ChidoriFocus","ChidoriEconomy","WallChidori","CurseControl","CurseBlood","Stamina","ChakraFlow","Reserves"}},
	},
}
function Presets.tier(id)
	for _,tier in Presets.AITiers do if tier.Id==id then return tier end end
	return nil
end
-- A copy of a preset's node list, or nil when it does not exist.
function Presets.ai(fighterId,tier)
	local preset=Presets.AI[fighterId] and Presets.AI[fighterId][tier]
	return preset and table.clone(preset.Nodes)
end
function Presets.ranked(fighterId,bracketId)
	local preset=Presets.Ranked[fighterId] and Presets.Ranked[fighterId][bracketId]
	return preset and table.clone(preset.Nodes)
end
return Presets
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND39">
        <Properties>
          <string name="Name">ChakraCombat</string>
          <ProtectedString name="Source">-- ChakraCombat: the runtime adapter between the real duel (projectiles,
-- bodies, guards, wire) and the declarative rules Codex prepared
-- (ChakraRules + ChakraInputPlan) over the live ChakraTuning data.
--
--   OBJECT / BODY ACTION + CHAKRA + NATURE / MASTERY + CONTEXT = MODIFIED ACTION
--
-- Server-only. The client sends one validated boolean (the chakra modifier was
-- held with the tool action); the fighter's mastery profile, the object, the
-- cost, the context and every consequence are decided here from server state.
-- The rules select named signals; the handlers below are the only code that
-- turns a signal into a gameplay change, each one bounded and explicit.
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Config=require(Shared.Config)
local Rules=require(script.Parent.ChakraRules)
local InputPlan=require(script.Parent.ChakraInputPlan)
local T=require(script.Parent.ChakraTuning)
local Brawler=require(script.Parent.Brawler)
local Motor=require(script.Parent.Motor)
assert(Rules.validate(T),"Invalid chakra tuning")
local E=T.Effects
local Chakra={Tuning=T}
local NATURE_TAGS={"fire","wind","lightning","earth"}
local NATURE_OF={}
for name,nature in T.Natures do NATURE_OF[nature.tag]=name end
local LABEL={Reinforce="CHAKRA",Wind="WIND",Fire="KATON",Lightning="RAITON",GentleFist="GENTLE FIST"}

local function set(list,into)
	into=into or {}
	for _,tag in list or {} do into[tag]=true end
	return into
end
local function copy(t)
	local out={}
	for k,v in t do out[k]=v end
	return out
end
local function flat(v) return Vector3.new(v.X,0,v.Z) end
local function natureOf(tags)
	for _,tag in NATURE_TAGS do if tags[tag] then return NATURE_OF[tag] end end
	return nil
end
local function beats(a,b) return a~=nil and b~=nil and T.Beats[a]==b end
local function closest(a,b,point)
	local ab=b-a
	local length=ab:Dot(ab)
	if length&lt;1e-6 then return a end
	return a+ab*math.clamp((point-a):Dot(ab)/length,0,1)
end
-- Closest points of two segments [p1,q1] and [p2,q2] (s, t in 0..1).
local function segments(p1,q1,p2,q2)
	local d1,d2,r=q1-p1,q2-p2,p1-p2
	local a,e,f=d1:Dot(d1),d2:Dot(d2),d2:Dot(r)
	local s,t
	if a&lt;1e-8 and e&lt;1e-8 then return p1,p2,0,0 end
	if a&lt;1e-8 then s=0;t=math.clamp(f/e,0,1)
	else
		local c=d1:Dot(r)
		if e&lt;1e-8 then t=0;s=math.clamp(-c/a,0,1)
		else
			local b=d1:Dot(d2)
			local denom=a*e-b*b
			s=if denom&gt;1e-8 then math.clamp((b*f-c*e)/denom,0,1) else 0
			t=(b*s+f)/e
			if t&lt;0 then t=0;s=math.clamp(-c/a,0,1) elseif t&gt;1 then t=1;s=math.clamp((b-c)/a,0,1) end
		end
	end
	return p1+d1*s,p2+d2*t,s,t
end
-- Earliest time in [0,horizon] at which two moving spheres touch.
local function meet(p0,v0,q0,v1,horizon,radius)
	local d=p0-q0
	local r=v0-v1
	local c0=d:Dot(d)-radius*radius
	if c0&lt;=0 then return 0 end
	local aa=r:Dot(r)
	if aa&lt;1e-8 then return nil end
	local bb=2*d:Dot(r)
	local disc=bb*bb-4*aa*c0
	if disc&lt;0 then return nil end
	local t=(-bb-math.sqrt(disc))/(2*aa)
	if t&gt;=0 and t&lt;=horizon then return t end
	return nil
end
local function ground(c,position)
	local hit=workspace:Raycast(position+Vector3.new(0,1,0),Vector3.new(0,-80,0),c:rayParams(true))
	return if hit then hit.Position else Vector3.new(position.X,c.match.origin.Y,position.Z)
end
-- The far end of a stretched wire (its blade); `origin` is the stake.
local function far(w) return w.origin+w.direction*w.range end
-- Planted metal that carries a charge: a resting chakra blade or a stretched
-- wire (a held wire carries its own current, see Chakra.conduct).
local function metal(q)
	return q.planted~=nil and q.planted~="held" and not q.dead and q.tags~=nil and q.tags.metal==true
end

-- ------------------------------------------------------------- profiles
-- A character id only selects a mastery profile; the interpreter is shared.
function Chakra.profile(a)
	local id=T.CharacterMastery[a.fighterId] or "Basic"
	return id,T.Masteries[id] or T.Masteries.Basic
end
local function masteryOf(a)
	local _,m=Chakra.profile(a)
	return {tags=set(m.tags),levels=m.levels}
end
-- Studio A/B switch (devtools): changes the next triggers only.
function Chakra.toggle(c,ruleId,enabled)
	assert(type(enabled)=="boolean","Boolean switch required")
	local found=false
	for _,r in T.Rules do found=found or r.id==ruleId end
	assert(found,"Unknown chakra rule: "..tostring(ruleId))
	c.chakraSwitches=c.chakraSwitches or {}
	c.chakraSwitches[ruleId]=enabled
end
local function plan(c,trigger,event)
	event.trigger=trigger
	event.context=event.context or {tags={}}
	local selected=Rules.plan(T,event,c.chakraSwitches or {})
	local signals,applied={},{}
	for _,r in selected do
		table.insert(applied,r.id)
		for _,e in r.effects do if e.kind=="signal" then table.insert(signals,e.name) end end
	end
	return selected,signals,applied
end
-- Bounded decision log: which rules fired, for tests and Studio inspection.
local function record(c,trigger,applied,detail)
	if #applied==0 then return end
	c.chakraLog=c.chakraLog or {}
	local row={trigger=trigger,rules=applied,at=c.now}
	for k,v in detail or {} do row[k]=v end
	table.insert(c.chakraLog,row)
	while #c.chakraLog&gt;40 do table.remove(c.chakraLog,1) end
end
Chakra.record=record

-- ------------------------------------------------------------- infusion
local function resolve(c,a,objectId,infusionId,innate)
	local def=T.Objects[objectId]
	local infusion=T.Infusions[infusionId]
	local tags=set(def.tags)
	local stats=copy(def.stats)
	if innate then
		-- Carried by a jutsu (blades hidden in fire): the nature only, no
		-- reinforcement, no cost, no stat change.
		if infusion.nature then tags[T.Natures[infusion.nature].tag]=true end
		return {object=objectId,infusion=infusionId,nature=infusion.nature,tags=tags,stats=stats,cost=0,mode="throw",innate=true,rules={},signals={}}
	end
	set(infusion.tags,tags)
	if infusion.nature then tags[T.Natures[infusion.nature].tag]=true end
	-- Context comes from server state only.
	local context={}
	local victim=a.wireVictim
	if victim and victim.reaction=="Bound" and victim.boundBy==a and victim.health&gt;0 and (victim.wireConducts or 0)&lt;E.conduct.uses then
		context.holdingWire=true
	end
	local mastery=masteryOf(a)
	local selected,signals,applied=plan(c,"Infuse",{source={tags=tags,toolType=def.toolType},context={tags=context},mastery=mastery})
	local cost=infusion.cost
	for _,r in selected do
		cost+=r.cost or 0
		for _,e in r.effects do
			if e.kind=="scaleStat" and stats[e.stat]~=nil then
				-- Codex's semantics: factor + per-level mastery bonus, bounded by
				-- maxFactor, the result bounded by the object's cap.
				local factor=e.factor+(e.perLevel or 0)*(if e.mastery then mastery.levels[e.mastery] or 0 else 0)
				factor=math.min(e.maxFactor or 4,factor)
				stats[e.stat]=math.min(def.caps[e.stat] or math.huge,stats[e.stat]*factor)
			elseif e.kind=="tag" then tags[e.tag]=true end
		end
	end
	local mode="throw"
	if table.find(signals,"conduct-wire") then mode="conduct" elseif table.find(signals,"chakra-palm") then mode="body" end
	return {object=objectId,infusion=infusionId,nature=infusion.nature,tags=tags,stats=stats,cost=cost,mode=mode,rules=applied,signals=signals}
end
-- The chakra modifier on the tool action. `object` is the tool the fighter's
-- action uses ("Kunai", "Shuriken", "Sand"); a body mastery replaces it with
-- the palm. Codex's input planner (Modifier mode) keeps the existing action
-- and refuses an incompatible proposal. Returns the plan, or nil + refusal.
function Chakra.plan(c,a,object)
	local profileId=Chakra.profile(a)
	local objectId=T.BodyTool[profileId] or object
	if not T.Objects[objectId] then return nil,"No chakra tool" end
	local preferred=(T.Preferred[profileId] or {})[objectId] or T.Preferred.Basic[objectId]
	local input=InputPlan.build(T,"Modifier",{action="Tool",modified=true},{tool=objectId,selectedInfusion=preferred})
	if input.infusion=="None" then return nil,"No chakra tool" end
	local result=resolve(c,a,objectId,input.infusion,false)
	result.profile=profileId;result.owner=a.id
	-- The palm is a grounded twin-palm thrust: refused in the air, before any cost.
	if result.mode=="body" and a.airborne then return nil,"Palm needs the ground" end
	return result
end
-- A nature carried by a jutsu (no input, no cost).
function Chakra.innate(c,a,object,infusionId)
	if not T.Objects[object] or not T.Infusions[infusionId] then return nil end
	return resolve(c,a,object,infusionId,true)
end
-- Chakra spent: a thrown chakra tool also pays the plain throw cost, which a
-- string cancel waives; a palm or a current down the wire throws nothing.
function Chakra.cost(p,chainCancel)
	return p.cost+(if p.mode=="throw" and E.toolCost and not chainCancel then Config.ToolCost else 0)
end
function Chakra.label(p)
	return (LABEL[p.infusion] or "CHAKRA").." "..string.upper(p.object)
end
-- Refused (chakra short, or nothing to infuse): the chakra fizzles at the
-- hand, so the refusal is seen even when the HUD cue stays quiet.
function Chakra.refuse(c,a)
	local hand=a.root.Position+a.root.CFrame.RightVector*1.1+a.root.CFrame.LookVector*1.1+Vector3.new(0,.9,0)
	c:pushImpact(hand,"fade",false,{owner=a.id,chakra="fizzle"})
	Brawler.event(c,a,"ChakraRefused")
end
-- The infusion is logged once, when the chakra is actually committed (a plan
-- refused for cost leaves no trace).
local function committed(c,infused)
	if infused.logged or infused.innate then return end
	infused.logged=true
	record(c,"Infuse",infused.rules,{owner=infused.owner,object=infused.object,infusion=infused.infusion,mode=infused.mode})
end
-- A projectile thrown with a plan carries it for its whole life.
function Chakra.arm(c,p,infused)
	committed(c,infused)
	local s=infused.stats
	p.chakra=infused;p.infusion=infused.infusion;p.tags=infused.tags
	if not infused.innate then
		p.speed*=s.speed or 1;p.range*=s.range or 1;p.remaining=p.range;p.damage*=s.damage or 1
		-- Stronger contact: the chakra blade connects through a small sphere.
		p.radius=math.max(p.radius or 0,E.hitRadius)
	end
	p.weight=s.weight or 1;p.impact=s.impact or 1
	p.contest=(T.Objects[infused.object].radius or .45)+(if infused.innate then 0 else E.contestBonus)
end

-- A blade born from an infused one (a ricochet) carries the same chakra,
-- without scaling its flight a second time.
function Chakra.inherit(q,p)
	if not p.chakra then return end
	q.chakra=p.chakra;q.infusion=p.infusion;q.tags=p.tags;q.weight=p.weight;q.impact=p.impact;q.contest=p.contest;q.flared=p.flared
	q.radius=math.max(q.radius or 0,p.radius or 0)
end

-- ------------------------------------------------------------- views
-- The interaction view of any live projectile: tags, weight and the radius at
-- which it meets another object. Plain tools and jutsu volumes come straight
-- from their object data (a plain throw itself is never changed).
local function view(c,p)
	if p.chakra then
		local def=T.Objects[p.chakra.object]
		return {tags=p.tags,weight=p.weight or 1,contest=p.contest or .5,volume=false,nature=natureOf(p.tags),toolType=def.toolType}
	end
	local id=T.ObjectOf[p.kind]
	local def=id and T.Objects[id]
	if not def then return nil end
	local tags=set(def.tags)
	-- A shuriken that crossed its thrower's burning ground (Fire Geometry) burns.
	if p.ignited then tags.fire=true end
	local volume=tags.volume==true
	local contest=if volume then (p.radius or 0)+(p.growth or 0)*math.max(0,c.now-p.born) else def.radius
	return {tags=tags,weight=def.stats.weight or 1,contest=math.max(contest,.3),volume=volume,nature=natureOf(tags),toolType=def.toolType}
end
Chakra.view=view
local function moving(p)
	return not p.dead and not p.planted and (p.speed or 0)&gt;0 and (p.remaining or 0)&gt;0
end
local function kill(c,p,position,style,extra)
	if p.dead then return end
	p.dead=true
	local entry={projectile=p.id,kind=p.kind,owner=p.a.id,direction=p.direction}
	for k,v in extra or {} do entry[k]=v end
	c:pushImpact(position,style,false,entry)
end

-- ------------------------------------------------------------- clashes
-- Which side leads a meeting: elemental precedence, then a reinforced blade
-- heavier than a small flame, then the jutsu volume, then weight, then age.
local function dominant(p,q,vp,vq)
	if vp.volume and vq.volume then
		if p.id&lt;=q.id then return p,q,vp,vq end
		return q,p,vq,vp
	end
	if vp.volume~=vq.volume then
		local vol,tool,vv,vt=p,q,vp,vq
		if vq.volume then vol,tool,vv,vt=q,p,vq,vp end
		local steel=vt.tags.reinforced and vt.weight&gt;vv.weight+.25 and not (vv.nature=="Fire" and vt.nature=="Wind")
		if steel then return tool,vol,vt,vv end
		return vol,tool,vv,vt
	end
	if beats(vp.nature,vq.nature) then return p,q,vp,vq end
	if beats(vq.nature,vp.nature) then return q,p,vq,vp end
	if math.abs(vp.weight-vq.weight)&gt;.25 then
		if vp.weight&gt;vq.weight then return p,q,vp,vq end
		return q,p,vq,vp
	end
	if p.id&lt;=q.id then return p,q,vp,vq end
	return q,p,vq,vp
end
local OUTCOME={["clash-pass"]="pass",["clash-absorb"]="absorb",["clash-pierce"]="pierce",["clash-swallow"]="swallow",
	["clash-swat"]="swat",["clash-deflect"]="deflect",["clash-intercept"]="intercept"}
local function tumble(direction,across)
	local side=across:Cross(Vector3.yAxis)
	if side.Magnitude&lt;.05 then side=Vector3.xAxis end
	local away=(direction*.4+side.Unit*(if direction:Dot(side)&gt;=0 then 1 else -1)+Vector3.new(0,.7,0))
	return if away.Magnitude&gt;.05 then away.Unit else Vector3.yAxis
end
local function flare(s)
	if s.chakra or not (s.radius and s.radius&gt;0) then
		s.damage+=E.feed.damage;s.flared=true
	else
		s.radius+=.6;s.damage*=1.15;s.flared=true
	end
end
-- Why the dominant side won, sent with the loser's impact so the client can
-- show it: the winner flashes in its nature's colour and keeps flying, the
-- loser falls, burns or is cut in two. Reasons: nature (elemental
-- precedence), cut (wind through a lighter blade), steel (reinforced steel
-- through a small flame), volume (a jutsu swallows a tool), palm, weight,
-- even (both fall).
local REASON={absorb="nature",swallow="volume",swat="palm",deflect="weight",intercept="even"}
local function explain(outcome,s,t,vs,vt,ctx,forced)
	local reason=REASON[outcome]
	if outcome=="pierce" then reason=if ctx.natureAdvantage then "nature" elseif vs.tags.cutting then "cut" else "steel" end
	return {reason=reason,winner=if forced or outcome=="intercept" then nil else s.id,winnerKind=s.kind,
		winnerNature=vs.nature or s.infusion,loserNature=vt.nature or t.infusion}
end
local function with(extra,more)
	for k,v in more do extra[k]=v end
	return extra
end
-- Resolve one meeting. The rules pick one outcome (exclusive group "clash");
-- the dominant side is the rule source.
local function settle(c,s,t,vs,vt,at,forced)
	local ctx={}
	if not (vs.tags.chakra or vs.tags.volume or vt.tags.chakra or vt.tags.volume) then ctx.plain=true end
	if beats(vs.nature,vt.nature) then ctx.natureAdvantage=true end
	local gap=vs.weight-vt.weight
	if gap&gt;.25 then ctx.heavier=true elseif gap&gt;=-.25 then ctx.even=true end
	local _,signals,applied=plan(c,"ProjectileClash",{source={tags=vs.tags,toolType=vs.toolType},target={tags=vt.tags,toolType=vt.toolType},
		context={tags=ctx},mastery=masteryOf(s.a or forced)})
	local outcome="pass"
	for _,name in signals do if OUTCOME[name] then outcome=OUTCOME[name];break end end
	-- A forced source (the palm) is not a projectile: it only ever swats a blade
	-- (switching its rule off leaves the blades alone).
	if forced and outcome~="swat" then outcome="pass" end
	local owner=forced or s.a
	local dir=s.direction or (owner and owner.root.CFrame.LookVector) or Vector3.zAxis
	local infusion=s.infusion
	local why=explain(outcome,s,t,vs,vt,ctx,forced)
	if outcome=="absorb" then
		kill(c,t,at,"ember",with({chakra="absorb",infusion="Fire",by=owner.id},why))
		if not forced then flare(s) end
	elseif outcome=="pierce" then
		kill(c,t,at,"deflect",with({chakra="cut",infusion=infusion,direction=dir,tumble=tumble(t.direction,dir),by=owner.id},why))
	elseif outcome=="swallow" then
		local fire=vs.tags.fire==true
		kill(c,t,at,if fire then "ember" else "deflect",with({chakra=if fire then "burn" else "blown",infusion=infusion,direction=dir,tumble=tumble(t.direction,dir),by=owner.id},why))
	elseif outcome=="swat" then
		kill(c,t,at,"deflect",with({chakra="swat",infusion="GentleFist",direction=dir,tumble=tumble(t.direction,dir),by=owner.id},why))
	elseif outcome=="deflect" then
		kill(c,t,at,"deflect",with({chakra="deflect",infusion=infusion,direction=dir,tumble=tumble(t.direction,dir),by=owner.id},why))
	elseif outcome=="intercept" then
		t.dead=true
		kill(c,s,at,"clash",with({chakra="intercept",other=t.id,otherKind=t.kind,direction=dir,tumble=tumble(s.direction,t.direction),by=owner.id},why))
	end
	if outcome~="pass" then
		Brawler.event(c,owner,"ChakraClash")
		Brawler.event(c,owner,"Clash_"..outcome)
		-- Wind Cut's lane (Techniques.cutLane) and this clash rule are one
		-- behaviour: whichever meets the blade first, the gust cut it.
		if s.kind=="wind" and t.kind~="wind" and outcome~="intercept" then Brawler.event(c,owner,"WindCutBlade") end
	end
	record(c,"ProjectileClash",applied,{outcome=outcome,source=s.kind,target=t.kind,sourceInfusion=s.infusion,targetInfusion=t.infusion})
	return outcome
end
-- Neji's chakra palm: for its startup and active frames, the blades in front of
-- it are swatted aside (a frontal answer, unlike the 360-degree Rotation).
local function swat(c,a)
	local st=a.chakraPalm
	local look=flat(a.root.CFrame.LookVector)
	if look.Magnitude&lt;.05 then return end
	look=look.Unit
	local palm={tags=st.plan.tags,weight=T.Objects.Palm.stats.weight,contest=1,volume=false,toolType="Palm"}
	for _,p in c.projectiles do
		if p.a~=a and moving(p) then
			local v=view(c,p)
			if v and not v.volume and v.tags.tool then
				local d=p.position-a.root.Position
				local f=flat(d)
				if d.Magnitude&lt;=E.palm.reach and (f.Magnitude&lt;1 or look:Dot(f.Unit)&gt;=E.palm.cone) then
					settle(c,{direction=look,kind="palm",infusion="GentleFist"},p,palm,v,p.position,a)
				end
			end
		end
	end
end
-- ------------------------------------------------------------- conduction
-- Metal conducts lightning. A planted blade or a stretched wire the lightning
-- enters is charged for a while (a stretched wire only by its own thrower's
-- lightning); the charge runs on into the planted metal touching it, and a
-- charged object shocks the body that touches it (PointContact, WireContact).
-- Where two metal objects are closest to each other (the arc's two ends).
local function contact(q,r)
	if q.planted=="wire" and r.planted=="wire" then
		local x,y=segments(q.origin,far(q),r.origin,far(r))
		return x,y
	end
	if q.planted=="wire" then return closest(q.origin,far(q),r.position),r.position end
	if r.planted=="wire" then return q.position,closest(r.origin,far(r),q.position) end
	return q.position,r.position
end
-- Who a live charge belongs to: a charged object's charger, a lightning
-- point's thrower (a shock point is born charged), else nobody.
local function chargerOf(q)
	if q.tags.charged and q.chargedBy then return q.chargedBy end
	if q.tags.shockPoint then return q.a end
	return nil
end
local function electrify(c,q,by)
	local life=if q.planted=="wire" then E.tripwire.charge else E.charge.life
	q.charged=math.max(q.charged or 0,c.now+life);q.chargedBy=by;q.tags.charged=true
	-- A charged wire is drawn as a lightning wire (Effects restStep).
	if q.planted=="wire" then q.infusion="Lightning" end
	c.urgent=true
	Brawler.event(c,by,if q.planted=="wire" then "WireCharged" else "MetalCharged")
end
-- The charge runs through every planted metal object touching `source` (each
-- once; a wire only when it is the charger's own). Returns what it reached.
local function spread(c,source,by)
	local seen,queue,reached={[source]=true},{source},{}
	while #queue&gt;0 do
		local q=table.remove(queue,1)
		for _,r in c.projectiles do
			if not seen[r] and metal(r) and (r.planted~="wire" or r.a==by) then
				local x,y=contact(q,r)
				if (x-y).Magnitude&lt;=E.charge.reach then
					seen[r]=true;table.insert(queue,r);table.insert(reached,r)
					electrify(c,r,by)
					c:pushImpact(y,"fade",false,{owner=by.id,chakra="arc",infusion="Lightning",from=x,to=y,target=r.id})
				end
			end
		end
	end
	if #reached&gt;0 then record(c,"Conduct",{"metal-conducts"},{by=by.id,reached=#reached}) end
	return reached
end
-- Lightning enters one object (from `from`): charged, then the metal touching it.
local function charge(c,q,by,from)
	electrify(c,q,by)
	local to=if q.planted=="wire" then closest(q.origin,far(q),from or q.origin) else q.position
	c:pushImpact(to,"fade",false,{owner=by.id,chakra="arc",infusion="Lightning",from=from or to,to=to,target=q.id})
	c:cue(by,if q.planted=="wire" then "LIVE WIRE" else "METAL CHARGED",.6)
	spread(c,q,by)
end
-- A metal object just came to rest: a lightning point charges what it
-- touches; anything else touching a live charge is charged by it.
local function settleMetal(c,q)
	if q.tags.shockPoint then spread(c,q,q.a);return end
	for _,r in c.projectiles do
		local by=r~=q and metal(r) and chargerOf(r)
		if by and (q.planted~="wire" or q.a==by) then
			local x,y=contact(r,q)
			if (x-y).Magnitude&lt;=E.charge.reach then charge(c,q,by,x);return end
		end
	end
end
Chakra.chargerOf=chargerOf

-- Wire crossed by a flying object: fire runs along it, the owner's lightning
-- charges it (and the metal touching it), wind cuts it.
local burnWire
local function crossWire(c,p,w,at)
	local v=view(c,p)
	if not v then return end
	local ctx={}
	if p.a==w.a then ctx.own=true end
	local _,signals,applied=plan(c,"WireCross",{source={tags=v.tags,toolType=v.toolType},target={tags=w.tags},context={tags=ctx},mastery=masteryOf(p.a)})
	for _,name in signals do
		if name=="wire-burn" then burnWire(c,w,p.a)
		elseif name=="wire-charge" then
			charge(c,w,w.a,p.position)
		elseif name=="wire-cut" then
			kill(c,w,at,"deflect",{chakra="wirecut",infusion=p.infusion,by=p.a.id})
			Brawler.event(c,p.a,"WireCut")
		end
	end
	record(c,"WireCross",applied,{source=p.kind,infusion=p.infusion})
end
function burnWire(c,w,fireOwner)
	if w.dead then return end
	local tune=E.tripwire
	local far=w.origin+w.direction*w.range
	local steps=math.max(1,math.floor(w.range/tune.patch))
	for k=0,steps do
		local point=w.origin:Lerp(far,k/steps)
		c:addHazard(fireOwner,point,2.2,tune.burn,4,"Fire")
	end
	kill(c,w,w.origin:Lerp(far,.5),"ember",{chakra="wireburn",infusion="Fire",from=w.origin,to=far,by=fireOwner.id})
	Brawler.event(c,fireOwner,"WireBurn")
end

-- ------------------------------------------------------------- planted points
local POINT={}
POINT["point-recover"]=function(c,q,x)
	kill(c,q,q.position,"fade",{chakra="recover",infusion=q.infusion})
	x.chakra=math.min(x.def.Chakra or Config.Chakra,x.chakra+E.plant.refund)
	c:cue(x,"CHAKRA BLADE RECOVERED • +"..E.plant.refund,.6)
	Brawler.event(c,x,"ChakraRecover")
end
POINT["point-shock"]=function(c,q,x)
	-- The current belongs to whoever charged the metal: Sasuke's lightning in
	-- his own point, or in the opponent's planted blade it jumped into.
	local by=chargerOf(q) or q.a
	kill(c,q,q.position,"shock",{chakra="pointshock",infusion="Lightning",victim=x.id,owner=by.id})
	c.damageTag="Shock Point";c.hitOrigin=q.position
	local hit=c:damage(by,x,E.shockPoint.damage,false,false)
	c.hitOrigin=nil;c.damageTag=nil
	if hit and x.state=="Stunned" and not x.reaction then
		x.untilTime=math.max(x.untilTime,c.now+E.shockPoint.stun)
		x.shockUntil=math.max(x.shockUntil or 0,x.untilTime)
	end
	c:cue(by,"SHOCK POINT",.6)
	-- His own blade turned against him: say why.
	if q.a==x then c:cue(x,"LIVE METAL • SHOCKED",.7) end
	Brawler.event(c,by,"ChakraShockPoint")
end
POINT["point-deny"]=function(c,q,x)
	kill(c,q,q.position,"fade",{chakra="deny",infusion=q.infusion})
	Brawler.event(c,x,"ChakraDeny")
end
local function touchPoint(c,q,x,owner)
	local d=x.root.Position-q.position
	if flat(d).Magnitude&gt;E.plant.radius or math.abs(d.Y)&gt;E.plant.height then return end
	if x.health&lt;=0 or (not owner and x.invulnerableUntil&gt;c.now) then return end
	local ctx={}
	ctx[if owner then "owner" else "opponent"]=true
	if not x.airborne then ctx.grounded=true end
	-- A live charge that is not his own shocks him, whoever planted the blade.
	local by=chargerOf(q)
	if by and by~=x then ctx.chargeFoe=true end
	local _,signals,applied=plan(c,"PointContact",{source={tags=q.tags},target={tags={actor=true}},context={tags=ctx},mastery=masteryOf(q.a)})
	for _,name in signals do
		local handler=POINT[name]
		if handler and not q.dead then handler(c,q,x) end
		if c.match.phase~="Duel" then return end
	end
	record(c,"PointContact",applied,{owner=q.a.id,actor=x.id,infusion=q.infusion})
end
local function touchWire(c,w,x)
	local tune=E.tripwire
	if x.health&lt;=0 or x.invulnerableUntil&gt;c.now or x.reaction=="Bound" then return end
	local far=w.origin+w.direction*w.range
	local point=closest(w.origin,far,x.root.Position)
	if (x.root.Position-point).Magnitude&gt;tune.radius then return end
	local ctx={opponent=true}
	if not x.airborne then ctx.grounded=true end
	local _,signals,applied=plan(c,"WireContact",{source={tags=w.tags},target={tags={actor=true}},context={tags=ctx},mastery=masteryOf(w.a)})
	local bind,shock=table.find(signals,"tripwire-bind")~=nil,table.find(signals,"tripwire-shock")~=nil
	if bind then
		kill(c,w,point,"pin",{chakra="tripwire",infusion=w.infusion,from=w.origin,to=far,victim=x.id})
		require(script.Parent.Techniques).wireBind(c,w.a,x,nil,w.direction)
		if c.match.phase~="Duel" then return end
		-- The wire stays tied to its stake and its blade: the body is held in
		-- the line it walked into (the held wire runs stake -&gt; body -&gt; blade).
		if x.reaction=="Bound" and x.boundBy==w.a then x.wireAnchor={from=w.origin,to=far,at=x.boundAt} end
		if shock and x.reaction=="Bound" then
			c.damageTag="Charged Wire";c.hitOrigin=point
			c:damage(w.a,x,tune.shock,false,false)
			c.hitOrigin=nil;c.damageTag=nil
			if c.match.phase~="Duel" then return end
			x.reactionUntil+=tune.bind
			x.shockUntil=math.max(x.shockUntil or 0,x.reactionUntil)
			c:pushImpact(x.root.Position,"chidori",false,{owner=w.a.id,victim=x.id,chakra="surge",infusion="Lightning",from=point,to=x.root.Position})
		end
		-- ("WIRED": the HUD speaks it, like the Wire Trap hit's own cue.)
		c:cue(w.a,"TRIPWIRE • WIRED • 1 = DRAGON FLAME",.9)
		Brawler.event(c,w.a,"TripwireBind")
	end
	record(c,"WireContact",applied,{owner=w.a.id,actor=x.id,charged=w.charged~=nil})
end
-- A flying object reaches a planted blade (`touch`: it physically met it;
-- lightning also jumps in from further away): lightning charges the metal
-- and what touches it, anything else that met it knocks it out.
local function metalCross(c,p,q,at,touch)
	local v=view(c,p)
	if not v then return end
	local _,signals,applied=plan(c,"MetalCross",{source={tags=v.tags,toolType=v.toolType},target={tags=q.tags},context={tags={}},mastery=masteryOf(p.a)})
	local done={}
	for _,name in signals do
		if name=="metal-charge" then
			charge(c,q,p.a,at);table.insert(done,name)
		elseif name=="point-knock" and touch then
			kill(c,q,q.position,"deflect",{chakra="knock",tool=q.planted,infusion=q.infusion,direction=p.direction,tumble=tumble(p.direction,p.direction),by=p.a.id})
			Brawler.event(c,p.a,"ChakraPointKnocked");table.insert(done,name)
		end
	end
	if #done&gt;0 then record(c,"MetalCross",applied,{owner=q.a.id,by=p.kind,infusion=p.infusion}) end
end

-- ------------------------------------------------------------- the held wire
-- A wire that caught a body (a Wire Trap hit, or a stretched wire walked
-- into) is one object for as long as the bind lasts (kind "wirehold",
-- planted "held"): from the thrower's hand, or tied to the stake and the
-- blade of the stretched wire (`anchored`), to the body it holds. Its life is
-- the bind (its tension: the current tightens it), lightning charges it (the
-- current, Chakra.conduct), fire burns it (Chakra.dragonFlame), and it goes
-- with the bind, whatever ends it (expiry, substitution, a knockdown).
local function heldBy(a)
	local b=a.wireVictim
	if b and b.reaction=="Bound" and b.boundBy==a and b.health&gt;0 and a.health&gt;0 then return b end
	return nil
end
local function holds(c)
	for _,a in c.actors do
		local b=heldBy(a)
		local w=a.heldWire
		if w and (w.dead or w.holds~=b or w.boundAt~=(b and b.boundAt)) then w.dead=true;a.heldWire=nil;w=nil end
		if b and not w then
			local anchor=b.wireAnchor
			if anchor and anchor.at~=b.boundAt then anchor=nil end
			c.projectileSerial=(c.projectileSerial or 0)+1
			w={id=c.projectileSerial,a=a,kind="wirehold",planted="held",holds=b,boundAt=b.boundAt,born=b.boundAt or c.now,
				speed=0,remaining=0,damage=0,radius=0,growth=0,tags={tool=true,wire=true,metal=true},anchored=anchor~=nil}
			if anchor then
				-- The line it was stretched on: the stake (origin) to the blade.
				local span=anchor.to-anchor.from
				w.origin=anchor.from;w.position=anchor.from;w.range=span.Magnitude
				w.direction=if span.Magnitude&gt;.05 then span.Unit else Vector3.zAxis
			end
			table.insert(c.projectiles,w);a.heldWire=w;c.urgent=true
		end
		if w then
			if not w.anchored then
				-- Held in the hand: the line runs from the hand to the body.
				local hand=c.launchPoint(a,"Kunai")
				local span=b.root.Position-hand
				w.origin=hand;w.position=hand;w.range=span.Magnitude
				w.direction=if span.Magnitude&gt;.05 then span.Unit else a.root.CFrame.LookVector
			end
			w.expires=b.reactionUntil
			if w.charged and c.now&gt;=w.charged then w.charged=nil;w.chargedBy=nil;w.tags.charged=nil;w.infusion=nil end
		end
	end
end
-- Where the current or the fire enters a held wire: the stake it is tied
-- to, else the thrower's hand.
local function wireStart(c,a)
	local w=a.heldWire
	if w and not w.dead and w.anchored then return w.origin end
	return c.launchPoint(a,"Kunai")
end
-- Dragon Flame (Techniques.FireBloom on a body held by his wire): the fire
-- runs the wire from his hand (or the stake) to the body, and the wire burns
-- away with the bind. Presentation of an existing conversion: the damage and
-- the knockdown stay in the technique.
function Chakra.dragonFlame(c,a,b)
	-- (The technique has already let go of the body: the held wire of the
	-- last tick is the one that burns.)
	local from=wireStart(c,a)
	local w=a.heldWire
	if w then w.dead=true;a.heldWire=nil end
	c:pushImpact(b.root.Position,"fire",true,{owner=a.id,normal=Vector3.yAxis,from=from,to=b.root.Position,victim=b.id,chakra="dragonflame",infusion="Fire"})
	Brawler.event(c,a,"DragonFlameWire")
end

-- ------------------------------------------------------------- per tick
-- Runs before projectiles move: palm swats, meetings between flying objects
-- (and with planted points and stretched wires), then the planted objects
-- against bodies and fire. Meetings resolve in time order, so the outcome
-- never depends on the order of the projectile list.
function Chakra.step(c,dt)
	local now=c.now
	holds(c)
	for _,a in c.actors do
		if a.chakraPalm and now&lt;a.chakraPalm.untilTime and a.health&gt;0 then swat(c,a) end
	end
	local list=c.projectiles
	local hits={}
	for i=1,#list do
		local p=list[i]
		if moving(p) then
			local vp=view(c,p)
			if vp then
				local horizon=math.min(dt,p.remaining/p.speed)
				local velocity=p.direction*p.speed
				for j=1,#list do
					local q=list[j]
					-- Own objects never meet, except a stretched wire: the owner's
					-- lightning charges it and his own fire runs along it. A held
					-- wire is not in anybody's path.
					if q~=p and (q.a~=p.a or q.planted=="wire") and q.planted~="held" and not q.dead and not (p.clashed and p.clashed[q.id]) then
						if q.planted=="wire" then
							local a1,b1=p.position,p.position+velocity*horizon
							local far=q.origin+q.direction*q.range
							local onPath,onWire,s=segments(a1,b1,q.origin,far)
							-- His own lightning jumps into his wire from further away.
							local reach=if vp.tags.lightning and q.a==p.a then E.charge.arc else vp.contest+.35
							if (onPath-onWire).Magnitude&lt;=reach then table.insert(hits,{t=s*horizon,p=p,q=q,kind="wire",at=onWire}) end
						elseif q.planted then
							local touch=meet(p.position,velocity,q.position,Vector3.zero,horizon,vp.contest+E.plant.contest)
							-- Lightning jumps into planted metal it flies past.
							local arc=if vp.tags.lightning and q.tags.metal then meet(p.position,velocity,q.position,Vector3.zero,horizon,E.charge.arc) else nil
							local t=arc or touch
							if t then table.insert(hits,{t=t,p=p,q=q,kind="point",touch=touch~=nil}) end
						elseif j&gt;i and moving(q) then
							local vq=view(c,q)
							if vq then
								local t=meet(p.position,velocity,q.position,q.direction*q.speed,math.min(horizon,q.remaining/q.speed),vp.contest+vq.contest)
								if t then table.insert(hits,{t=t,p=p,q=q,kind="pair",vp=vp,vq=vq}) end
							end
						end
					end
				end
			end
		end
	end
	table.sort(hits,function(x,y)
		if x.t~=y.t then return x.t&lt;y.t end
		local xa,ya=math.min(x.p.id,x.q.id),math.min(y.p.id,y.q.id)
		if xa~=ya then return xa&lt;ya end
		return math.max(x.p.id,x.q.id)&lt;math.max(y.p.id,y.q.id)
	end)
	for _,hit in hits do
		local p,q=hit.p,hit.q
		if not p.dead and not q.dead then
			p.clashed=p.clashed or {};p.clashed[q.id]=true
			q.clashed=q.clashed or {};q.clashed[p.id]=true
			if hit.kind=="pair" then
				local P=p.position+p.direction*p.speed*hit.t
				local Q=q.position+q.direction*q.speed*hit.t
				local s,t,vs,vt=dominant(p,q,hit.vp,hit.vq)
				settle(c,s,t,vs,vt,P:Lerp(Q,.5))
			elseif hit.kind=="point" then
				-- A planted point is contestable: a thrown object knocks it out,
				-- lightning charges it (MetalCross).
				metalCross(c,p,q,p.position+p.direction*p.speed*hit.t,hit.touch)
			elseif hit.kind=="wire" then
				crossWire(c,p,q,hit.at)
			end
			if c.match.phase~="Duel" then return end
		end
	end
	-- Planted points and wires against bodies, fire and time.
	for i=#list,1,-1 do
		local q=list[i]
		if q and q.planted and not q.dead then
			if q.planted=="held" then
				-- (A held wire lives and goes with its bind: see holds.)
			elseif now&gt;=(q.expires or 0) or q.a.health&lt;=0 then
				kill(c,q,q.position,"fade",{chakra="expire",infusion=q.infusion})
			elseif q.planted=="wire" then
				if q.charged and now&gt;=q.charged then q.charged=nil;q.chargedBy=nil;q.tags.charged=nil;q.infusion=nil end
				local far=q.origin+q.direction*q.range
				for _,h in c.hazards do
					if h.kind=="Fire" and not q.dead and (h.position-closest(q.origin,far,h.position)).Magnitude&lt;=h.radius then burnWire(c,q,h.a) end
				end
				-- Rotation's dome snaps a wire it touches anywhere along its length.
				for _,spin in c.actors do
					if spin~=q.a and (spin.rotationUntil or 0)&gt;now and not q.dead then
						local reach=spin.rotationReach or 7
						local point=closest(q.origin,far,spin.root.Position)
						if (point-spin.root.Position).Magnitude&lt;=reach then
							kill(c,q,point,"deflect",{chakra="wirecut",by=spin.id})
							Brawler.event(c,spin,"WireCut")
						end
					end
				end
				local x=q.a.target
				if x and not q.dead then touchWire(c,q,x) end
			elseif now-q.born&gt;=E.plant.settle then
				if q.charged and now&gt;=q.charged then q.charged=nil;q.chargedBy=nil;q.tags.charged=nil end
				touchPoint(c,q,q.a,true)
				local x=q.a.target
				if x and not q.dead then touchPoint(c,q,x,false) end
			end
			if c.match.phase~="Duel" then return end
		end
	end
end

-- ------------------------------------------------------------- contact
local CONTACT={}
CONTACT["guard-crush"]=function(c,p,b)
	-- Reinforced steel leans on the guard: stamina, a shove, and a break when
	-- the guard has nothing left.
	local tune=E.guardCrush
	local impact=p.impact or 1
	b.stamina=math.max(0,(b.stamina or 100)-tune.stamina*impact)
	local push=flat(p.direction)
	if push.Magnitude&gt;.05 then Motor.travel(b,c,push.Unit,tune.push*impact) end
	b.guardImpact=c.now+.18
	local broken=b.stamina&lt;=0 and b.guardHeld
	if broken then
		b.guardHeld=false;c:setState(b,"Stunned",tune.stun)
		c:cue(b,"GUARD BREAK",.7);c:cue(p.a,"GUARD BREAK",.7)
		Brawler.event(c,p.a,"GuardCrushBreak")
	end
	c:pushImpact(b.root.Position,"crush",broken,{owner=p.a.id,victim=b.id,direction=p.direction,chakra="crush",infusion=p.infusion})
	Brawler.event(c,p.a,"GuardCrush")
end
CONTACT["shock"]=function(c,p,b)
	-- Lightning locks the muscles: the hit stun lasts longer (grounded only),
	-- and the body says so for exactly that long (snapshot `shocked`).
	if b.state=="Stunned" and not b.reaction then
		b.untilTime=math.max(b.untilTime,c.now+E.shock.stun)
		b.shockUntil=math.max(b.shockUntil or 0,b.untilTime)
	end
	c:pushImpact(b.root.Position,"shock",false,{owner=p.a.id,victim=b.id,chakra="shock",infusion="Lightning"})
	Brawler.event(c,p.a,"ChakraShock")
end
-- The held wire glows with the current that just ran along it.
local function wireGlow(c,a)
	local w=a.heldWire
	if not w or w.dead then return end
	w.charged=math.max(w.charged or 0,c.now+E.conduct.glow);w.chargedBy=a;w.tags.charged=true;w.infusion="Lightning"
	c.urgent=true
end
CONTACT["wire-surge"]=function(c,p,b)
	-- Lightning reaching a body held by the thrower's own wire runs through it.
	local tune=E.wireSurge
	c.damageTag="Wire Lightning"
	c:damage(p.a,b,tune.damage,false,false)
	c.damageTag=nil
	if c.match.phase~="Duel" then return end
	if b.reaction=="Bound" then
		b.reactionUntil=math.min(b.reactionUntil+tune.bind,(b.boundAt or c.now)+E.conduct.maxBind)
		b.shockUntil=math.max(b.shockUntil or 0,b.reactionUntil)
	end
	wireGlow(c,p.a)
	c:pushImpact(b.root.Position,"chidori",false,{owner=p.a.id,victim=b.id,chakra="surge",infusion="Lightning",from=p.position,to=b.root.Position})
	Brawler.event(c,p.a,"WireSurge")
end
CONTACT["ignite"]=function(c,p,b)
	local tune=E.ignite
	c:addHazard(p.a,ground(c,b.root.Position),tune.radius*(if p.flared then 1.4 else 1),tune.duration,tune.damage,"Fire")
	c:pushImpact(b.root.Position,"ember",false,{owner=p.a.id,victim=b.id,chakra="ignite",infusion="Fire"})
	Brawler.event(c,p.a,"ChakraIgnite")
end
CONTACT["gust"]=function(c,p,b)
	-- The wind kunai shoves the body along its line and opens a chase.
	local tune=E.gust
	local push=flat(p.direction)
	if push.Magnitude&gt;.05 and not b.reaction then b.root.AssemblyLinearVelocity=push.Unit*tune.push+Vector3.new(0,tune.lift,0) end
	p.a.pursuitUntil=math.max(p.a.pursuitUntil or 0,c.now+tune.chase)
	c:cue(p.a,"WIND KUNAI • E TO CHASE",tune.chase)
	c:pushImpact(b.root.Position,"gust",false,{owner=p.a.id,victim=b.id,chakra="gust",infusion="Wind",direction=p.direction})
	Brawler.event(c,p.a,"ChakraGust")
end
-- A chakra projectile reached a body. `damaged` is what Combat:damage
-- returned (false: evaded, parried, absorbed: the chakra does nothing).
function Chakra.contact(c,p,b,damaged)
	if not p.chakra or not damaged or b.health&lt;=0 or c.match.phase~="Duel" then return end
	local guarded=b.impactStyle=="block"
	local tags={actor=true}
	if guarded then tags.guarding=true end
	if b.reaction=="Bound" then tags.bound=true;if b.boundBy==p.a then tags.wired=true end end
	if b.airborne then tags.airborne=true end
	local ctx={}
	ctx[if guarded then "guarded" else "clean"]=true
	local _,signals,applied=plan(c,"Contact",{source={tags=p.tags,toolType=T.Objects[p.chakra.object].toolType},target={tags=tags},context={tags=ctx},mastery=masteryOf(p.a)})
	for _,name in signals do
		local handler=CONTACT[name]
		if handler then handler(c,p,b) end
		if c.match.phase~="Duel" or b.health&lt;=0 then break end
	end
	record(c,"Contact",applied,{source=p.kind,infusion=p.infusion,victim=b.id,guarded=guarded})
end

-- ------------------------------------------------------------- surfaces
local function plantPoint(c,p,position,normal,shock)
	local into=p.direction
	if into:Dot(normal)&gt;-.2 then into=(into-normal*1.2).Unit end
	c.projectileSerial=(c.projectileSerial or 0)+1
	local tags=copy(p.tags)
	tags.charged=nil
	if shock then tags.shockPoint=true end
	-- `mark`: what the point is for at a glance (client marker): a shock trap,
	-- or a blade its thrower walks over for chakra (and the other one tramples).
	local q={id=c.projectileSerial,a=p.a,origin=position,position=position,direction=into,speed=0,range=0,remaining=0,damage=0,
		kind="point",planted=p.kind,born=c.now,radius=0,growth=0,expires=c.now+E.plant.life,normal=normal,
		chakra=p.chakra,infusion=p.infusion,tags=tags,weight=p.weight,impact=p.impact,contest=E.plant.contest,
		mark=if shock then "shock" else "refund"}
	table.insert(c.projectiles,q)
	local mine={}
	for _,x in c.projectiles do if x.a==p.a and x.kind=="point" and not x.dead then table.insert(mine,x) end end
	for i=1,#mine-E.plant.max do kill(c,mine[i],mine[i].position,"fade",{chakra="expire",infusion=mine[i].infusion}) end
	c.urgent=true
	Brawler.event(c,p.a,"ChakraPlant")
	-- Metal touching metal: a lightning point charges what it lands against,
	-- a blade landing against live metal takes its charge.
	settleMetal(c,q)
	return q
end
-- A wired shuriken that misses stays strung from where it was thrown (tied
-- off at ankle height) to where it landed: a tripwire across that lane.
local function stretch(c,p,position,normal)
	local near=ground(c,p.origin)+Vector3.new(0,.7,0)
	local far=position+normal*.15
	local span=far-near
	if span.Magnitude&lt;3 or span.Magnitude&gt;80 then return nil end
	for _,x in c.projectiles do
		if x.a==p.a and x.kind=="tripwire" and not x.dead then kill(c,x,x.position,"fade",{chakra="expire"}) end
	end
	c.projectileSerial=(c.projectileSerial or 0)+1
	local w={id=c.projectileSerial,a=p.a,origin=near,position=near,direction=span.Unit,speed=0,range=span.Magnitude,remaining=0,damage=0,
		kind="tripwire",planted="wire",born=c.now,radius=0,growth=0,expires=c.now+E.tripwire.life,tags={tool=true,wire=true,metal=true}}
	table.insert(c.projectiles,w)
	c.urgent=true
	c:cue(p.a,"WIRE STRETCHED",.8)
	Brawler.event(c,p.a,"Tripwire")
	-- Strung against one of his live lightning points, the wire is live too.
	settleMetal(c,w)
	return w
end
-- A chakra blade or a wire reached a wall or the floor. Returns what stayed
-- behind ({point=, wire=, burn=}) so the caller tags its own impact.
function Chakra.surface(c,p,position,normal,instance)
	local v=view(c,p)
	if not v or not (p.chakra or v.tags.wire) then return nil end
	local tags={solid=true}
	tags[if math.abs(normal.Y)&lt;.7 then "wall" else "floor"]=true
	if instance==nil or instance.CanCollide~=false then tags.anchorCompatible=true end
	local selected,signals,applied=plan(c,"SurfaceHit",{source={tags=v.tags,toolType=v.toolType},surface={tags=tags},mastery=masteryOf(p.a)})
	local embed,shock=false,false
	for _,r in selected do
		for _,e in r.effects do
			if e.kind=="embed" then embed=true elseif e.kind=="tag" and e.tag=="shockPoint" then shock=true end
		end
	end
	local outcome={}
	if embed then outcome.point=plantPoint(c,p,position,normal,shock) end
	for _,name in signals do
		if name=="burn-point" then
			local tune=E.burnPoint
			c:addHazard(p.a,position+normal*.6,tune.radius*(if p.flared then 1.4 else 1),tune.duration,tune.damage,"Fire")
			outcome.burn=true
		elseif name=="wire-stretch" then outcome.wire=stretch(c,p,position,normal) end
	end
	record(c,"SurfaceHit",applied,{source=p.kind,infusion=p.infusion,planted=outcome.point~=nil,wire=outcome.wire~=nil})
	return outcome
end
-- End of flight: a chakra blade or a wire drops to the floor and stays there.
function Chakra.expire(c,p)
	if not ((p.chakra and not p.chakra.innate) or p.kind=="wire") then return false end
	local floor=workspace:Raycast(p.position,Vector3.new(0,-80,0),c:rayParams(true))
	if not floor then return false end
	local outcome=Chakra.surface(c,p,floor.Position,floor.Normal,floor.Instance)
	if not outcome or not (outcome.point or outcome.wire) then return false end
	c:pushImpact(floor.Position,"stick",false,{projectile=p.id,kind=p.kind,normal=floor.Normal,owner=p.a.id,direction=p.direction,
		chakra=if outcome.wire then "stretch" else "plant",infusion=p.infusion})
	return true
end

-- ------------------------------------------------------------- body chakra
-- Neji: the chakra goes through the palm. A short twin-palm thrust that swats
-- the blades in front of it while it comes out, drains and closes a point
-- through a guard, and closes an extra point on a clean hit.
function Chakra.palm(c,a,infused)
	committed(c,infused)
	Brawler.start(c,a,"PalmThrust")
	local pending=a.pending
	if not pending then return false,"Committed" end
	local tune=E.palm
	pending.spec.damage*=tune.damage;pending.spec.travel=tune.travel;a.travelRemaining=tune.travel
	pending.chakra=infused
	a.attackVariant="ChakraPalm"
	local window=pending.spec.startup+pending.spec.active
	local serial=a.attackSerial
	a.chakraPalm={untilTime=c.now+window+.04,serial=serial,plan=infused}
	c:schedule(c.now+window+.02,function() Chakra.palmResolve(c,a,serial) end)
	c:pushImpact(a.root.Position,"cast",false,{owner=a.id,fighter=a.fighterId,technique="ChakraPalm",chakra="palm",infusion="GentleFist"})
	c:cue(a,"CHAKRA PALM",.5)
	Brawler.event(c,a,"ChakraPalm")
	return true
end
function Chakra.palmResolve(c,a,serial)
	local st=a.chakraPalm
	if not st or st.serial~=serial then return end
	a.chakraPalm=nil
	local b=a.target
	if a.health&lt;=0 or not b or b.health&lt;=0 or a.attackSerial~=serial or not a.hitConfirmed or not a.def.GentleFist then return end
	local guarded=a.hitBlocked==true
	local tags={actor=true}
	if guarded then tags.guarding=true end
	local ctx={}
	ctx[if guarded then "guarded" else "clean"]=true
	local _,signals,applied=plan(c,"Contact",{source={tags=st.plan.tags,toolType="Palm"},target={tags=tags},context={tags=ctx},mastery=masteryOf(a)})
	local tune=E.palm
	for _,name in signals do
		if name=="palm-through-guard" then
			b.chakra=math.max(0,b.chakra-tune.drain)
			b.stamina=math.max(0,(b.stamina or 100)-tune.stamina)
			-- The point closes as if the guard were not there.
			Brawler.gentleFist(c,a,b,false)
			local push=flat(b.root.Position-a.root.Position)
			if push.Magnitude&gt;.05 then Motor.travel(b,c,push.Unit,tune.push) end
			b.guardImpact=c.now+.18
			c:pushImpact(b.root.Position,"palm",true,{owner=a.id,victim=b.id,chakra="throughguard",infusion="GentleFist",direction=a.root.CFrame.LookVector})
			c:cue(a,"CHAKRA PALM • THROUGH THE GUARD",.8);c:cue(b,"CHAKRA DRAINED",.6)
			Brawler.event(c,a,"PalmThroughGuard")
		elseif name=="palm-point" then
			for _=1,tune.points do Brawler.gentleFist(c,a,b,false) end
			c:pushImpact(b.root.Position,"palm",false,{owner=a.id,victim=b.id,chakra="tenketsu",infusion="GentleFist"})
			Brawler.event(c,a,"PalmPoint")
		end
	end
	record(c,"Contact",applied,{source="palm",infusion="GentleFist",victim=b.id,guarded=guarded})
end
-- Sasuke: with the wire still on a bound body, the chakra tool sends the
-- lightning down the wire instead of throwing (the wire stays: Dragon Flame
-- remains available). Bounded: two currents per bind, never past 2.2 s.
function Chakra.conduct(c,a,infused)
	local b=a.wireVictim
	if not (b and b.reaction=="Bound" and b.boundBy==a and b.health&gt;0) then return false,"Wire lost" end
	local tune=E.conduct
	committed(c,infused)
	b.wireConducts=(b.wireConducts or 0)+1
	-- The current enters where the wire starts (his hand, or the stake of the
	-- stretched wire that caught the body) and runs its length to the body.
	holds(c)
	local hand=wireStart(c,a)
	c.damageTag="Wire Lightning";c.hitOrigin=hand
	local hit=c:damage(a,b,tune.damage,false,false)
	c.hitOrigin=nil;c.damageTag=nil
	if c.match.phase~="Duel" then return true end
	if b.reaction=="Bound" then
		b.reactionUntil=math.min(b.reactionUntil+tune.bind,(b.boundAt or c.now)+tune.maxBind)
		b.shockUntil=math.max(b.shockUntil or 0,b.reactionUntil)
	end
	if hit and b.state=="Stunned" then b.untilTime=math.max(b.untilTime,b.reactionUntil or c.now) end
	wireGlow(c,a)
	c:pushImpact(b.root.Position,"chidori",false,{owner=a.id,victim=b.id,chakra="conduct",infusion="Lightning",from=hand,to=b.root.Position})
	c:cue(a,"WIRED • LIGHTNING • 1 = DRAGON FLAME",.9);c:cue(b,"WIRED • X TO ESCAPE",.9)
	Brawler.event(c,a,"WireLightning")
	record(c,"Conduct",infused.rules,{owner=a.id,victim=b.id,uses=b.wireConducts})
	return true
end
return Chakra
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND40">
        <Properties>
          <string name="Name">ChakraDev</string>
          <ProtectedString name="Source">-- Server-internal tool facade. Studio bindable or offline CLI, no client Remote.
-- Chakra lab (Codex 7091585, ported verbatim): reached only through
-- dev:Invoke("interactions",op,args), loaded on the first call and only when
-- the chakra runtime modules exist (DevTools.ChakraRuntime). Debug/QA places
-- only (DEBUG_SOURCES).
local S=require(script.Parent.ProfileSchema)
local V=require(script.Parent.ChakraVectors)
local Lab=require(script.Parent.ChakraLab)
local Dev={};Dev.__index=Dev
function Dev.new(cfg,studio)
 if studio then assert(game:GetService("RunService"):IsStudio(),"Studio only") end
 return setmetatable({cfg=cfg,lab=Lab.new(cfg),studio=studio==true,view=nil,connection=nil,running=false,log=false,accumulator=0,lastPrinted=0},Dev)
end
function Dev:draw()
 if self.view then self.view:update({objects=self.lab.engine.objects,surfaces=self.lab.engine.surfaces}) end
 if self.log then
  for _,event in self.lab.engine.events do if event.sequence&gt;self.lastPrinted then
   print("[NinjaDuelChakra] "..game:GetService("HttpService"):JSONEncode(event));self.lastPrinted=event.sequence
  end end
 end
end
function Dev:stop()
 if self.connection then self.connection:Disconnect();self.connection=nil end;self.running=false;self.accumulator=0
end
function Dev:destroy()
 self:stop();if self.view then self.view:destroy();self.view=nil end;self.lab:reset(true)
end
function Dev:_run(op,arg)
 local e=self.lab.engine
 if op=="qa" then assert(self.studio,"Native QA is Studio only");return require(script.Parent.ChakraStudioQA).run()
 elseif op=="spawn" then return e:spawn(arg.id,arg.tool or "Kunai",arg)
 elseif op=="surface" then return e:surface(arg.id,arg.kind or "Wall",arg.position or V.new(8,3,0),arg.normal)
 elseif op=="nature" then return e:infuse(arg.id,arg.nature or "None")
 elseif op=="property" then return e:property(arg.id,arg.property,arg.enabled)
 elseif op=="launch" then return e:launch(arg.id,arg.direction or V.new(1,0,0),arg.speed)
 elseif op=="collision" then return self.lab:forceClash(arg.source,arg.target,arg.direction,arg.normal)
 elseif op=="embed" then return self.lab:embed(arg.id,arg.surface)
 elseif op=="trigger" then return e:trigger(arg)
 elseif op=="toggle" then e:toggle(arg.rule,arg.enabled);return {rule=arg.rule,enabled=arg.enabled}
 elseif op=="inspect" then return e:inspect(arg.id)
 elseif op=="report" then return self.lab:report()
 elseif op=="compare" then return Lab.compare(self.cfg,arg.tool or "Kunai",arg.infusions or {"None","Reinforce","Wind"},arg.masteries or {"Basic","WeaponExpert"})
 elseif op=="demo" then self:stop();self.lastPrinted=0;if self.view then self.view:reset() end;return self.lab:demo(arg.name,arg.mastery)
 elseif op=="step" then return self.lab:run(arg.seconds or 1)
 elseif op=="reset" then self:stop();self.lab:reset(arg.clearRules==true);self.lastPrinted=0;if self.view then self.view:reset() end;return self.lab:report()
 elseif op=="stop" then self:stop();return {running=false}
 elseif op=="close" then self:destroy();return {closed=true}
 elseif op=="log" then assert(self.studio and type(arg.enabled)=="boolean","Studio boolean log switch");self.log=arg.enabled;return {enabled=self.log}
 elseif op=="show" then
  assert(self.studio,"Studio view only");if self.view then self.view:destroy();self.view=nil end
  if arg.enabled~=false then
   assert(not arg.origin or V.valid(arg.origin),"Invalid lab origin")
   self.view=require(script.Parent.ChakraStudioView).new(self.cfg,arg.origin and Vector3.new(arg.origin.x,arg.origin.y,arg.origin.z))
  end
  return {visible=self.view~=nil,folder="Workspace.NinjaDuelChakraLab",cameraChanged=false}
 elseif op=="play" then
  assert(self.studio,"Realtime lab is Studio only");self:stop();self.running=true
  self.connection=game:GetService("RunService").Heartbeat:Connect(function(dt)
   self.accumulator+=dt;local limit=8/60
   if self.accumulator&gt;limit then self.lab.discardedSeconds+=self.accumulator-limit;self.accumulator=limit end
   local ok,err=pcall(function()
    while self.accumulator&gt;=1/60 do self.lab:step(1/60);self.accumulator-=1/60 end;self:draw()
   end)
   if not ok then self:stop();warn("[NinjaDuelChakra] lab stopped: "..tostring(err)) end
  end)
  return {running=true}
 end
 error("Unknown interaction operation")
end
function Dev:run(op,arg)
 arg=arg or {};if type(arg)~="table" or not S.serializable(arg) then return {ok=false,error="Invalid dev arguments"} end
 local ok,value=pcall(self._run,self,op,arg)
 if ok then
  local drawn,err=pcall(self.draw,self);if not drawn then self:stop();return {ok=false,error="Lab view: "..tostring(err)} end
 end
 if ok and type(value)=="table" and value.ok==false then return value end
 return if ok then {ok=true,result=value} else {ok=false,error=tostring(value)}
end
return Dev
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND41">
        <Properties>
          <string name="Name">ChakraInputPlan</string>
          <ProtectedString name="Source">-- Optional intent planner ONLY. Does not bind keys or send/change combat actions.
-- context MUST be resolved by a future host (technique/loadout/mastery/geometry),
-- never accepted as authoritative client data. Hold qualification belongs to Claude.
local S=require(script.Parent.ProfileSchema)
local P={Modes={AutoTechnique=true,Modifier=true,Contextual=true,Loadout=true,HoldRelease=true,CompatibleAuto=true}}
function P.build(cfg,mode,intent,context)
 assert(P.Modes[mode] and S.serializable(intent) and S.serializable(context),"Invalid input proposal")
 assert(type(intent)=="table" and type(context)=="table" and S.id(intent.action) and cfg.Objects[context.tool],"Action/tool required")
 assert(intent.modified==nil or type(intent.modified)=="boolean","Invalid modifier")
 assert(intent.released==nil or type(intent.released)=="boolean","Invalid release")
 local candidate="None"
 if mode=="AutoTechnique" then candidate=context.techniqueInfusion or "None"
 elseif mode=="Modifier" and intent.modified then candidate=context.selectedInfusion or "None"
 elseif mode=="Contextual" and context.compatible==true then candidate=context.contextInfusion or "None"
 elseif mode=="Loadout" then candidate=(context.loadout or {})[context.tool] or "None"
 elseif mode=="HoldRelease" and intent.released and context.holdQualified==true then candidate=context.selectedInfusion or "None"
 elseif mode=="CompatibleAuto" and context.compatible==true and context.availableProperty then candidate=context.propertyInfusion or "None" end
 assert(candidate=="None" or cfg.Infusions[candidate],"Unknown proposed infusion")
 local compatible=candidate=="None" or cfg.Objects[context.tool].infusions[candidate]==true
 return {action=intent.action,mode=mode,candidate=candidate,compatible=compatible,infusion=if compatible then candidate else "None",requiresServerValidation=true,gameplayIntegration=false}
end
return P
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND42">
        <Properties>
          <string name="Name">ChakraLab</string>
          <ProtectedString name="Source">-- Explicit experimental sandbox: kinematic proxies, never the live projectiles.
-- Chakra lab (Codex 7091585, ported verbatim). Needs the chakra runtime
-- modules ChakraConfig/ChakraRules/ChakraInteractions/ChakraVectors, which are
-- NOT part of the dev-tools port: DevHooks loads this lab only when all four
-- exist (DevTools.ChakraRuntime). Debug/QA places only (DEBUG_SOURCES).
local S=require(script.Parent.ProfileSchema)
local V=require(script.Parent.ChakraVectors)
local Engine=require(script.Parent.ChakraInteractions)
local Lab={};Lab.__index=Lab
function Lab.new(cfg)
 local copy=S.copy(cfg);copy.Enabled=true
 return setmetatable({engine=assert(Engine.new(copy)),contacts={},steps=0,discardedSeconds=0},Lab)
end
local demos={
 kunai_wind={rules={"wind-kunai"}},kunai_seal={rules={"surface-embed","seal-anchor"}},
 redirection={rules={"wind-kunai","redirect-projectile","deflect-projectile"}},wire_property={rules={"wire-property","metal-conduction"}},
 projectile_surface={rules={"surface-embed"}},fire_surface={rules={"fire-surface"}},
}
function Lab:reset(clearRules)
 self.engine:reset();if clearRules then self.engine.switches={} end;self.contacts={};self.steps=0;self.discardedSeconds=0
end
function Lab:demo(name,mastery)
 local def=assert(demos[name],"Unknown chakra demo");self:reset(false)
 local e=self.engine;for _,id in def.rules do if e.switches[id]==nil then e:toggle(id,true) end end
 local kind=if name=="wire_property" then "Wire" else "Kunai"
 e:spawn("a",kind,{position=V.new(-10,3,0),mastery=mastery or "Basic"})
 if name=="kunai_wind" then assert(e:infuse("a","Wind").ok);e:launch("a",V.new(1,0,0))
 elseif name=="kunai_seal" then
  assert(e:property("a","Marked",true).ok);assert(e:property("a","Seal",true).ok)
  e:surface("wall","Wall",V.new(8,3,0));e:launch("a",V.new(1,0,0))
 elseif name=="redirection" then
  assert(e:infuse("a","Wind").ok);e:spawn("b","Shuriken",{position=V.new(10,3,0)});e:launch("a",V.new(1,0,0));e:launch("b",V.new(-1,0,0))
 elseif name=="wire_property" then assert(e:infuse("a","Lightning").ok)
 elseif name=="projectile_surface" then
  e:surface("floor","Floor",V.new(0,0,0));e.objects.a.position=V.new(0,9,0);e:launch("a",V.new(0,-1,0))
 elseif name=="fire_surface" then
  assert(e:infuse("a","Fire").ok);e:surface("wood","Wood",V.new(8,3,0));e:launch("a",V.new(1,0,0))
 end
 return e:inspect()
end
function Lab:forceClash(a,b,direction,normal)
 local e=self.engine;local source=assert(e.objects[a],"Unknown source")
 local tagList={};for _,nature in e.cfg.Natures do if source.tags[nature.tag] then table.insert(tagList,nature.tag) end end
 return e:trigger({trigger="ProjectileClash",source=a,target=b,direction=direction or V.new(0,1,0),normal=normal or V.new(1,0,0),tags=tagList})
end
function Lab:embed(id,surface)
 local s=assert(self.engine.surfaces[surface],"Unknown surface")
 return self.engine:trigger({trigger="SurfaceHit",source=id,surface=surface,position=s.position,normal=s.normal})
end
function Lab:step(dt)
 local e=self.engine;local before=S.copy(e.objects);local candidates={};local ids={}
 for id,o in before do if o.launched then table.insert(ids,id) end end;table.sort(ids)
 local overlapping={}
 for i,id in ids do
  local a=before[id];local da=V.mul(a.velocity,dt)
  for j=i+1,#ids do
   local b=before[ids[j]];local key=id..":"..b.id;local radius=a.radius+b.radius
   local touching=V.length(V.sub(a.position,b.position))&lt;=radius+.01
   if touching then overlapping[key]=true end
   if not (touching and self.contacts[key]) then
    local t=V.sweep(a.position,da,b.position,V.mul(b.velocity,dt),radius)
    if t then table.insert(candidates,{t=t,source=id,target=b.id,key=key}) end
   end
  end
  for surfaceId,s in e.surfaces do
   local signed=V.dot(V.sub(a.position,s.position),s.normal)-a.radius;local travel=V.dot(da,s.normal)
   if signed&gt;=0 and travel&lt;0 and signed+travel&lt;=0 then
    local t=-signed/travel;local center=V.add(a.position,V.mul(da,t));local hit=V.sub(center,V.mul(s.normal,a.radius))
    if V.length(V.sub(hit,s.position))&lt;=s.radius then table.insert(candidates,{t=t,source=id,surface=surfaceId,hit=hit,key=id..":"..surfaceId}) end
   end
  end
 end
 table.sort(candidates,function(a,b) return if a.t==b.t then a.key&lt;b.key else a.t&lt;b.t end)
 e:advance(dt);self.steps+=1;local handled={}
 for _,hit in candidates do
  local a=e.objects[hit.source];local b=hit.target and e.objects[hit.target]
  if a and not handled[a.id] and (not hit.target or b and not handled[b.id]) then
   local oldA=S.copy(a.position);local oldB=b and S.copy(b.position)
   a.position=V.add(before[a.id].position,V.mul(before[a.id].velocity,dt*hit.t))
   local result
   if b then
    b.position=V.add(before[b.id].position,V.mul(before[b.id].velocity,dt*hit.t))
    local normal=V.sub(a.position,b.position);if V.length(normal)&lt;1e-8 then normal=V.sub(a.velocity,b.velocity) end
    if V.length(normal)&lt;1e-8 then normal=V.new(1,0,0) end
    result=self:forceClash(a.id,b.id,a.velocity,normal);overlapping[hit.key]=true
   else result=e:trigger({trigger="SurfaceHit",source=a.id,surface=hit.surface,position=hit.hit,normal=e.surfaces[hit.surface].normal}) end
   if result.ok then
    for _,id in {a.id,b and b.id} do
     local o=e.objects[id];handled[id]=true;if o.launched then o.position=V.add(o.position,V.mul(o.velocity,dt*(1-hit.t))) end
    end
   else a.position=oldA;if b then b.position=oldB end end
  end
 end
 self.contacts=overlapping
end
function Lab:run(seconds)
 assert(type(seconds)=="number" and seconds&gt;0 and seconds&lt;=30,"Run budget 0..30 seconds")
 local remaining=seconds;while remaining&gt;1e-8 do local dt=math.min(1/60,remaining);self:step(dt);remaining-=dt end
 return self:report()
end
function Lab:report()
 local report=self.engine:inspect();report.lab={kinematicProxies=true,steps=self.steps,discardedSeconds=self.discardedSeconds};return report
end
-- Compare in independent sandboxes; never mutates the current run or config.
function Lab.compare(cfg,kind,infusions,masteries)
 assert(cfg.Objects[kind] and #infusions&gt;0 and #infusions&lt;=8 and #masteries&gt;0 and #masteries&lt;=8,"Comparison budget")
 local rows={}
 for _,mastery in masteries do for _,infusion in infusions do
  local lab=Lab.new(cfg);for _,rule in cfg.Rules do if rule.trigger=="Infuse" then lab.engine:toggle(rule.id,true) end end
  lab.engine:spawn("preview",kind,{mastery=mastery});local ok,result=pcall(lab.engine.infuse,lab.engine,"preview",infusion);if not ok then result={ok=false,error=tostring(result)} end
  table.insert(rows,{tool=kind,infusion=infusion,mastery=mastery,result=result})
 end end
 return rows
end
Lab.demos=demos
return Lab
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND43">
        <Properties>
          <string name="Name">ChakraRules</string>
          <ProtectedString name="Source">-- Declarative matching only. No callbacks/code strings supplied by configuration.
local S=require(script.Parent.ProfileSchema)
local V=require(script.Parent.ChakraVectors)
local R={}
local kinds={scaleStat=true,tag=true,signal=true,redirect=true,reflect=true,embed=true,anchor=true}
local scopes={source=true,target=true,surface=true,context=true,mastery=true}
local function number(n,max) return type(n)=="number" and n==n and n&gt;=0 and n&lt;=(max or 1000) end
local function tags(cfg,list)
 assert(type(list)=="table" and #list&lt;=64,"Tag list required")
 for _,tag in list do assert(cfg.Tags[tag]==true,"Unknown tag: "..tostring(tag)) end
end
function R.validate(cfg)
 assert(S.serializable(cfg) and type(cfg.Enabled)=="boolean","Unsafe interaction config")
 for _,key in {"MaxObjects","MaxSurfaces","MaxEvents","MaxLife","MaxSpeed","MaxChakra"} do assert(S.integer(cfg[key],1000) and cfg[key]&gt;0,"Invalid limit") end
 assert(cfg.MaxObjects&lt;=64 and cfg.MaxSurfaces&lt;=32 and cfg.MaxEvents&lt;=256 and cfg.MaxSpeed&lt;=1000,"Lab budget exceeded")
 for id,value in cfg.Tags do assert(S.id(id) and value==true,"Invalid tag") end
 for id,nature in cfg.Natures do assert(S.id(id) and cfg.Tags[nature.tag],"Invalid nature") end
 for id,property in cfg.Properties do assert(S.id(id) and cfg.Tags[property.tag],"Invalid property");tags(cfg,property.requires) end
 for id,enabled in cfg.MasterySkills do assert(S.id(id) and enabled==true,"Invalid mastery skill") end
 for id,mastery in cfg.Masteries do
  assert(S.id(id),"Invalid mastery");tags(cfg,mastery.tags)
  for name,level in mastery.levels do assert(cfg.MasterySkills[name] and S.integer(level,100),"Invalid mastery level") end
 end
 assert(cfg.Masteries.Basic,"Basic mastery required")
 for character,mastery in cfg.CharacterMastery do assert(S.id(character) and cfg.Masteries[mastery],"Invalid character mastery mapping") end
 for id,def in cfg.Objects do
  assert(S.id(id) and S.id(def.toolType) and type(def.canLaunch)=="boolean" and number(def.radius,3) and def.radius&gt;0,"Invalid tool");tags(cfg,def.tags)
  assert(({kunai=true,shuriken=true,wire=true,target=true})[def.visual],"Unknown lab visual")
  for infusion,enabled in def.infusions do assert(cfg.Infusions[infusion] and enabled==true,"Invalid tool infusion") end
  for stat,n in def.stats do assert(S.id(stat) and number(n,cfg.MaxSpeed) and number(def.caps[stat],cfg.MaxSpeed) and def.caps[stat]&gt;=n,"Invalid stat cap") end
 end
 for id,def in cfg.Surfaces do assert(S.id(id) and V.valid(def.normal) and V.length(def.normal)&gt;0 and number(def.radius,30) and def.radius&gt;0,"Invalid surface");tags(cfg,def.tags) end
 for id,def in cfg.Infusions do assert(S.id(id) and number(def.cost,cfg.MaxChakra) and (not def.nature or cfg.Natures[def.nature]),"Invalid infusion");tags(cfg,def.tags) end
 local ids={}
 for _,rule in cfg.Rules do
  assert(S.id(rule.id) and not ids[rule.id] and cfg.Triggers[rule.trigger] and type(rule.enabled)=="boolean" and S.integer(rule.priority,1000),"Invalid interaction rule");ids[rule.id]=true
  assert(not rule.group or S.id(rule.group),"Invalid exclusive group")
  assert(not rule.cost or number(rule.cost,cfg.MaxChakra),"Invalid rule cost")
  for scope,filter in rule.when do
   if scope=="toolType" then assert(S.id(filter),"Invalid tool type")
   elseif scope=="minMastery" then for name,level in filter do assert(cfg.MasterySkills[name] and S.integer(level,100),"Invalid mastery threshold") end
   else assert(scopes[scope],"Unknown condition scope");for op,list in filter do assert(op=="all" or op=="any" or op=="none","Unknown tag filter");tags(cfg,list) end end
  end
  assert(#rule.effects&gt;0 and #rule.effects&lt;=16,"Invalid result count")
  for _,effect in rule.effects do
   assert(kinds[effect.kind],"Unknown result kind")
   if effect.kind=="scaleStat" then
    assert(S.id(effect.stat) and number(effect.factor,4) and effect.factor&gt;0,"Invalid stat result")
    assert(not effect.mastery or cfg.MasterySkills[effect.mastery],"Invalid scaling mastery")
    assert(not effect.perLevel or number(effect.perLevel,1),"Invalid mastery factor")
    assert(not effect.maxFactor or number(effect.maxFactor,4) and effect.maxFactor&gt;0,"Invalid max factor")
   elseif effect.kind=="signal" then assert(S.id(effect.name),"Invalid signal")
   else
    assert(effect.target=="source" or effect.target=="target" or (effect.kind=="tag" and effect.target=="surface"),"Invalid result target")
    if effect.kind=="tag" then assert(cfg.Tags[effect.tag],"Invalid result tag") end
    if effect.kind=="reflect" or effect.kind=="redirect" then assert(number(effect.speedScale,2) and effect.speedScale&gt;0,"Invalid velocity scale") end
   end
  end
 end
 return true
end
local function filter(tagsValue,spec)
 tagsValue=tagsValue or {}
 for _,tag in spec.all or {} do if not tagsValue[tag] then return false,"missing "..tag end end
 if spec.any and #spec.any&gt;0 then local found=false;for _,tag in spec.any do found=found or tagsValue[tag]==true end;if not found then return false,"missing any tag" end end
 for _,tag in spec.none or {} do if tagsValue[tag] then return false,"excluded "..tag end end
 return true
end
function R.match(rule,event)
 for _,scope in {"source","target","surface","context","mastery"} do
  local spec=rule.when[scope]
  if spec then local ok,why=filter(event[scope] and event[scope].tags,spec);if not ok then return false,scope..": "..why end end
 end
 if rule.when.toolType and event.source.toolType~=rule.when.toolType then return false,"toolType" end
 for name,min in rule.when.minMastery or {} do if (event.mastery.levels[name] or 0)&lt;min then return false,"mastery "..name end end
 return true
end
function R.plan(cfg,event,switches)
 assert(cfg.Triggers[event.trigger],"Unknown trigger")
 local ordered={};for _,rule in cfg.Rules do if rule.trigger==event.trigger then table.insert(ordered,rule) end end
 table.sort(ordered,function(a,b) return if a.priority==b.priority then a.id&lt;b.id else a.priority&gt;b.priority end)
 local selected={};local trace={};local used={}
 for _,rule in ordered do
  local enabled=rule.enabled;if switches[rule.id]~=nil then enabled=switches[rule.id] end
  local matched,why=R.match(rule,event);local status
  if not enabled then status="disabled" elseif not matched then status=why elseif rule.group and used[rule.group] then status="exclusive-group" else status="selected";table.insert(selected,rule);if rule.group then used[rule.group]=true end end
  table.insert(trace,{rule=rule.id,status=status})
 end
 return selected,trace
end
return R
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND44">
        <Properties>
          <string name="Name">ChakraStudioQA</string>
          <ProtectedString name="Source">-- Explicit smoke test of the chakra lab, run by dev:Invoke("interactions","qa")
-- in the Debug/QA place (Codex 7091585, ported verbatim; DEBUG_SOURCES). Never
-- called by bootstrap. Needs the chakra runtime modules (DevTools.ChakraRuntime).
local QA={}
function QA.run()
 assert(game:GetService("RunService"):IsStudio(),"Studio only")
 local cfg=require(script.Parent.ChakraConfig)
 local Dev=require(script.Parent.ChakraDev)
 local Shared=game:GetService("ReplicatedStorage").NinjaDuel
 local fighters=require(Shared.Fighters);local before={};for id,f in fighters do before[id]={speed=f.Speed,health=f.Health} end
 local camera=workspace.CurrentCamera;local cf=camera and camera.CFrame
 local tool=Dev.new(cfg,true);local passed=0
 local ok,err=pcall(function()
  for _,name in {"kunai_wind","kunai_seal","redirection","wire_property","projectile_surface","fire_surface"} do
   local demo=tool:run("demo",{name=name});assert(demo.ok,demo.error)
   local shown=tool:run("show",{enabled=true});assert(shown.ok,shown.error)
   local result=tool:run("step",{seconds=1});assert(result.ok,result.error)
   local report=result.result;local a=report.objects.a;assert(a and #report.events&gt;0)
   if name=="kunai_wind" then assert(a.stats.speed&gt;42)
   elseif name=="kunai_seal" then assert(a.embedded and a.anchor)
   elseif name=="redirection" then assert(report.objects.b.velocity.x&gt;0)
   elseif name=="wire_property" then assert(a.tags.conductiveWire)
   elseif name=="projectile_surface" then assert(a.embedded)
   elseif name=="fire_surface" then assert(report.surfaces.wood.tags.ignited) end
   local model=tool.view.objects.a.model;assert((model:GetPivot().Position-(tool.view.origin+Vector3.new(a.position.x,a.position.y,a.position.z))).Magnitude&lt;.01)
   for _,part in tool.view.folder:GetDescendants() do if part:IsA("BasePart") then assert(part.Anchored and not part.CanCollide and not part.CanQuery and not part.CanTouch) end end
   passed+=1
  end
  tool:run("play");assert(tool.connection and tool.running);tool:stop();assert(not tool.connection)
  local folder=tool.view.folder;tool:destroy();assert(folder.Parent==nil)
  for id,f in fighters do assert(f.Speed==before[id].speed and f.Health==before[id].health) end
  assert(workspace.CurrentCamera==camera and (not camera or camera.CFrame==cf) and cfg.Enabled==false)
  passed+=1
 end)
 tool:destroy()
 local result={ok=ok,passed=passed,expected=7,build=Shared.BuildFingerprint.Value,gameplayIntegration=false,error=not ok and tostring(err) or nil}
 print("[NinjaDuelChakraQA] RESULT "..game:GetService("HttpService"):JSONEncode(result))
 assert(ok,err);return result
end
return QA
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND45">
        <Properties>
          <string name="Name">ChakraStudioView</string>
          <ProtectedString name="Source">-- Optional Studio proxy renderer. Only draws its own folder; no camera/UI changes.
-- Chakra lab (Codex 7091585, ported verbatim). Debug/QA places only (DEBUG_SOURCES).
local S=require(script.Parent.ProfileSchema)
local View={};View.__index=View
local function vector(v) return Vector3.new(v.x,v.y,v.z) end
local colors={wind=Color3.fromRGB(120,255,200),fire=Color3.fromRGB(255,125,70),lightning=Color3.fromRGB(120,175,255),spatialAnchor=Color3.fromRGB(225,125,255)}
local function part(parent,name,size,cf,color)
 local p=Instance.new("Part");p.Name=name;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Size=size;p.CFrame=cf;p.Color=color;p.Material=Enum.Material.Neon;p.Parent=parent;return p
end
function View.new(cfg,origin)
 assert(game:GetService("RunService"):IsStudio(),"Studio only")
 local folder=Instance.new("Folder");folder.Name="NinjaDuelChakraLab";folder.Parent=workspace
 return setmetatable({cfg=cfg,folder=folder,origin=origin or Vector3.new(0,250,500),objects={},surfaces={}},View)
end
function View:reset()
 self.folder:ClearAllChildren();self.objects={};self.surfaces={}
end
function View:destroy() self.folder:Destroy() end
function View:object(o)
 local model=Instance.new("Model");model.Name=o.id.."_"..o.kind;model.Parent=self.folder
 local color=Color3.fromRGB(195,200,215)
 local root=part(model,"Root",Vector3.new(.14,.14,2),CFrame.new(),color);root.Transparency=1;model.PrimaryPart=root
 local shape=self.cfg.Objects[o.kind].visual
 if shape=="kunai" then
  part(model,"Blade",Vector3.new(.35,.15,1.25),CFrame.new(0,0,-.55),color)
  part(model,"Grip",Vector3.new(.18,.18,.65),CFrame.new(0,0,.4),color)
  local ring=part(model,"Ring",Vector3.new(.35,.12,.35),CFrame.new(0,0,.95),color);ring.Shape=Enum.PartType.Ball
 elseif shape=="shuriken" then
  for i=0,3 do part(model,"Blade"..i,Vector3.new(.2,.08,1.2),CFrame.Angles(0,math.pi*i/2,0)*CFrame.new(0,0,-.35),color) end
 elseif shape=="wire" then part(model,"Wire",Vector3.new(12,.06,.06),CFrame.new(),color)
 else part(model,"Target",Vector3.new(2,3,2),CFrame.new(),color) end
 local gui=Instance.new("BillboardGui");gui.Name="Tags";gui.Adornee=root;gui.Size=UDim2.fromOffset(420,64);gui.StudsOffset=Vector3.new(0,2,0);gui.AlwaysOnTop=true;gui.Parent=root
 local label=Instance.new("TextLabel");label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=.3;label.BackgroundColor3=Color3.new(0,0,0);label.TextColor3=Color3.new(1,1,1);label.TextSize=14;label.TextWrapped=true;label.Parent=gui
 self.objects[o.id]={model=model,label=label}
 return self.objects[o.id]
end
function View:update(report)
 for id,entry in self.objects do if not report.objects[id] then entry.model:Destroy();self.objects[id]=nil end end
 for id,o in report.objects do
  local entry=self.objects[id] or self:object(o);local p=self.origin+vector(o.position)
  local direction=if vector(o.velocity).Magnitude&gt;.01 then vector(o.velocity).Unit elseif o.anchor then -vector(o.anchor.normal) else Vector3.new(1,0,0)
  local up=if math.abs(direction.Y)&gt;.95 then Vector3.zAxis else Vector3.yAxis
  entry.model:PivotTo(CFrame.lookAt(p,p+direction,up))
  local color=Color3.fromRGB(195,200,215);for _,tag in {"wind","fire","lightning","spatialAnchor"} do if o.tags[tag] then color=colors[tag] end end
  for _,child in entry.model:GetChildren() do if child:IsA("BasePart") then child.Color=color end end
  local active={};for tag in o.tags do table.insert(active,tag) end;table.sort(active)
  entry.label.Text=id.." / "..o.kind.." / "..o.mastery.."\n"..table.concat(active," · ")
 end
 for id,s in report.surfaces do
  if not self.surfaces[id] then
   local p=self.origin+vector(s.position);local n=vector(s.normal);local up=if math.abs(n.Y)&gt;.95 then Vector3.zAxis else Vector3.yAxis
   local surface=part(self.folder,id,Vector3.new(s.radius*2,s.radius*2,.15),CFrame.lookAt(p,p+n,up),Color3.fromRGB(85,100,130));surface.Transparency=.6
   self.surfaces[id]=surface
  end
  if s.tags.ignited then self.surfaces[id].Color=colors.fire end
 end
end
return View
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND46">
        <Properties>
          <string name="Name">ChakraTuning</string>
          <ProtectedString name="Source">-- Live chakra interaction data (SYS-001 / TOOL-006): OBJECT + CHAKRA + NATURE /
-- MASTERY + CONTEXT -&gt; a modified action. Same format as Codex's prepared
-- fixtures (7091585) and validated by ChakraRules at load; ChakraCombat is the
-- only reader. Character ids only select a mastery profile: one interpreter,
-- different identities. Stats are scales on the fighter's own ToolMastery
-- (speed, range, damage) or absolute contest values (weight, impact, contest).
local T={Enabled=true,MaxObjects=64,MaxSurfaces=32,MaxEvents=256,MaxLife=30,MaxSpeed=400,MaxChakra=1000,
	Triggers={Infuse=true,ProjectileClash=true,SurfaceHit=true,Contact=true,PointContact=true,WireContact=true,WireCross=true,MetalCross=true},
	Tags={tool=true,projectile=true,metal=true,blade=true,wire=true,sand=true,body=true,volume=true,actor=true,
		solid=true,wall=true,floor=true,anchorCompatible=true,
		chakra=true,reinforced=true,cutting=true,conductive=true,ignited=true,shockPoint=true,charged=true,
		wind=true,fire=true,lightning=true,earth=true,marked=true,
		guarding=true,bound=true,wired=true,airborne=true,holdingWire=true,
		clean=true,guarded=true,heavier=true,even=true,natureAdvantage=true,plain=true,owner=true,opponent=true,grounded=true,own=true,
		chargeFoe=true},
	Natures={Wind={tag="wind"},Fire={tag="fire"},Lightning={tag="lightning"},Earth={tag="earth"}},
	-- Elemental precedence between natured objects (fire feeds on wind, wind
	-- cuts lightning, lightning breaks earth). Anything else is decided by weight.
	Beats={Fire="Wind",Wind="Lightning",Lightning="Earth"},
	Properties={Marked={tag="marked",requires={"tool"}}},
	MasterySkills={Wind=true,Fire=true,Lightning=true,GentleFist=true,Seal=true},
	Masteries={
		Basic={tags={},levels={Wind=0,Fire=0,Lightning=0,GentleFist=0,Seal=0}},
		-- Minato: wind through the kunai, seals in the hand.
		WindBlade={tags={"wind"},levels={Wind=3,Fire=0,Lightning=0,GentleFist=0,Seal=3}},
		-- Itachi: Katon carried by precise shuriken.
		FireBlade={tags={"fire"},levels={Wind=0,Fire=3,Lightning=0,GentleFist=0,Seal=0}},
		-- Neji: chakra goes through the body, never into a thrown blade.
		GentleFist={tags={"body"},levels={Wind=0,Fire=0,Lightning=0,GentleFist=3,Seal=0}},
		-- Sasuke: lightning in steel and wire (fire stays in his jutsu).
		LightningWire={tags={"lightning","wire"},levels={Wind=0,Fire=2,Lightning=3,GentleFist=0,Seal=0}},
	},
	CharacterMastery={Flashstep="WindBlade",Mirage="FireBlade",GentleFist="GentleFist",Lion="LightningWire",Sand="Basic"},
	-- What the chakra modifier pours into each tool, per mastery (Basic: plain
	-- reinforcement). A body mastery turns the tool action into a palm.
	Preferred={
		Basic={Kunai="Reinforce",Shuriken="Reinforce",Sand="Reinforce",Palm="GentleFist"},
		WindBlade={Kunai="Wind",Shuriken="Wind"},
		FireBlade={Shuriken="Fire",Kunai="Fire"},
		GentleFist={Palm="GentleFist"},
		LightningWire={Shuriken="Lightning",Kunai="Lightning"},
	},
	BodyTool={GentleFist="Palm"},
	-- Projectile kinds as interaction objects. Volumes are jutsu bodies: they
	-- take part in clashes with their real radius.
	ObjectOf={kunai="Kunai",marked="Marked",shuriken="Shuriken",wire="Wire",sand="Sand",
		fireball="Fireball",phoenix="Phoenix",palm="VacuumPalm",wind="WindCut",sandwave="SandWave"},
	Objects={},Surfaces={},Infusions={},Rules={},
}
-- Rock Lee (stress-test wave): he cannot mould chakra at all, so there is
-- nothing to pour into a tool and no palm either. His tool is a kick
-- (Techniques.deflectKick) and the chakra modifier is refused with the usual
-- fizzle (Combat, def.Tool "Deflect"). Named here so every reader of the
-- profile (logs, lab, tools) says Taijutsu instead of falling back to Basic.
T.Masteries.Taijutsu={tags={"body"},levels={Wind=0,Fire=0,Lightning=0,GentleFist=0,Seal=0}}
T.CharacterMastery.Leaf="Taijutsu"
T.Preferred.Taijutsu={}
-- Naruto (roster wave): no nature yet (his wind is Part II). His chakra goes
-- into a body, not into the steel: the chord turns the thrown kunai into a
-- shadow clone near the target (ToolMastery.Transform, Server/Bodies). With
-- two clones already out, the same chord only reinforces the kunai.
T.Masteries.ShadowClone={tags={},levels={Wind=0,Fire=0,Lightning=0,GentleFist=0,Seal=0}}
T.CharacterMastery.Legion="ShadowClone"
T.Preferred.ShadowClone={Kunai="Reinforce"}
-- Temari (roster wave): wind through the iron fan. Her tool is not thrown; the
-- chakra modifier on it (Gale.gust) is a Wind infusion of the fan: a longer
-- gust that leaves a short lane. Her Kamaitachi and Kamatari meet other
-- flights as cutting wind volumes (they blow blades away, fire feeds on them).
T.Objects.Fan={toolType="Fan",tags={"tool","wind"},canLaunch=false,infusions={Wind=true},stats={weight=3,impact=1},caps={weight=8,impact=4},radius=1,visual="target"}
T.Masteries.WindFan={tags={"wind"},levels={Wind=3,Fire=0,Lightning=0,GentleFist=0,Seal=0}}
T.CharacterMastery.Gale="WindFan"
T.Preferred.WindFan={Fan="Wind"}
T.ObjectOf.gale="WindCut";T.ObjectOf.kamatari="WindCut"
local O=T.Objects
local function tool(toolType,tags,infusions,weight,impact,contest,visual)
	return {toolType=toolType,tags=tags,canLaunch=true,infusions=infusions,
		stats={speed=1,range=1,damage=1,weight=weight,impact=impact},
		caps={speed=2,range=2,damage=2,weight=8,impact=4},radius=contest,visual=visual}
end
local steel={Reinforce=true,Wind=true,Fire=true,Lightning=true}
O.Kunai=tool("Kunai",{"tool","projectile","metal","blade"},steel,2,1,.45,"kunai")
O.Marked=tool("Kunai",{"tool","projectile","metal","blade","marked"},{},2,1,.45,"kunai")
O.Shuriken=tool("Shuriken",{"tool","projectile","metal","blade"},steel,1.5,.6,.5,"shuriken")
O.Wire=tool("Wire",{"tool","projectile","metal","wire"},{},1.5,.5,.5,"wire")
O.Sand=tool("Sand",{"tool","projectile","sand","earth"},{Reinforce=true},2,1,.6,"target")
O.Palm={toolType="Palm",tags={"body"},canLaunch=false,infusions={GentleFist=true},stats={damage=1,weight=6,impact=1},caps={damage=2,weight=8,impact=4},radius=1,visual="target"}
local function volume(tags,weight)
	return {toolType="Volume",tags=tags,canLaunch=true,infusions={},stats={weight=weight},caps={weight=8},radius=1,visual="target"}
end
O.Fireball=volume({"projectile","volume","fire"},6)
O.Phoenix=volume({"projectile","volume","fire"},2.5)
O.VacuumPalm=volume({"projectile","volume","body"},5)
O.WindCut=volume({"projectile","volume","wind","cutting"},4)
O.SandWave=volume({"projectile","volume","sand","earth"},6)
T.Surfaces.Wall={tags={"solid","wall","anchorCompatible"},normal={x=-1,y=0,z=0},radius=8}
T.Surfaces.Floor={tags={"solid","floor","anchorCompatible"},normal={x=0,y=1,z=0},radius=8}
-- Every chakra blade is reinforced steel; a mastered nature adds its own rule.
T.Infusions.Reinforce={tags={"chakra","reinforced"},cost=6}
T.Infusions.Wind={nature="Wind",tags={"chakra","reinforced","cutting"},cost=8}
T.Infusions.Fire={nature="Fire",tags={"chakra","reinforced"},cost=8}
T.Infusions.Lightning={nature="Lightning",tags={"chakra","reinforced","conductive"},cost=8}
T.Infusions.GentleFist={tags={"chakra","body"},cost=10}
-- Magnitudes of the signals the rules select (read by ChakraCombat only).
T.Effects={
	toolCost=true, -- a thrown chakra tool also pays the plain throw cost (free in a string cancel)
	contestBonus=.45, -- a chakra blade meets other projectiles from further away
	hitRadius=.25, -- and connects with a body through a small sphere ("stronger contact")
	guardCrush={stamina=14,push=1.1,stun=.45},
	shock={stun=.38,damage=1},
	wireSurge={damage=3,bind=.45},
	ignite={radius=2.2,duration=1.0,damage=3},
	burnPoint={radius=2.6,duration=2.0,damage=4},
	gust={push=20,lift=6,chase=.6},
	plant={life=5,max=4,refund=4,radius=2.4,height=4.5,settle=.5,contest=.9},
	shockPoint={stun=.4,damage=3},
	palm={damage=.6,travel=2.2,reach=8.5,cone=.3,drain=8,stamina=18,points=1,push=1.6},
	conduct={damage=5,bind=.4,maxBind=2.2,uses=2,glow=.5},
	tripwire={life=6,radius=2.7,shock=4,bind=.4,charge=4,burn=1.4,patch=4},
	feed={damage=1.5},
	-- Metal conducts lightning: a charged planted blade stays live `life`
	-- seconds, and the charge runs into metal within `reach` of it; a
	-- lightning blade jumps into metal it flies past within `arc` studs.
	charge={life=4,reach=1.6,arc=4},
}
local function rule(id,trigger,priority,when,effects,extra)
	local r={id=id,enabled=true,priority=priority,trigger=trigger,when=when,effects=effects}
	for k,v in extra or {} do r[k]=v end
	table.insert(T.Rules,r)
end
local function scale(stat,factor,extra)
	local e={kind="scaleStat",stat=stat,factor=factor}
	for k,v in extra or {} do e[k]=v end
	return e
end
local function signal(name) return {kind="signal",name=name} end
-- Infuse: how the chakra changes the object itself (stats are scales).
rule("reinforced-steel","Infuse",20,{source={all={"tool","reinforced"}}},
	{scale("weight",2),scale("impact",1.8),scale("range",1.15),scale("damage",1.25)})
rule("wind-blade","Infuse",30,{source={all={"blade","wind"}}},
	{scale("speed",1.3,{mastery="Wind",perLevel=.05,maxFactor=1.5}),scale("range",1.5),scale("weight",.8)})
rule("fire-blade","Infuse",30,{source={all={"blade","fire"}}},
	{scale("speed",1.05),{kind="tag",tag="ignited",target="source"}})
rule("lightning-steel","Infuse",30,{source={all={"metal","lightning"}}},
	{scale("speed",1.1),{kind="tag",tag="conductive",target="source"}})
rule("sand-reinforced","Infuse",30,{source={all={"sand","reinforced"}}},{scale("weight",1.2)})
-- With the wire still on a bound opponent, Sasuke's lightning runs down it.
rule("lightning-down-the-wire","Infuse",60,{source={all={"lightning"}},context={all={"holdingWire"}}},{signal("conduct-wire")})
rule("gentle-palm","Infuse",40,{source={all={"body","chakra"}}},{signal("chakra-palm")})
-- ProjectileClash: one exclusive outcome per meeting, from the dominant side.
rule("plain-pass","ProjectileClash",100,{context={all={"plain"}}},{signal("clash-pass")},{group="clash"})
-- Two jutsu never cancel each other: matchups between techniques stay as they are.
rule("volumes-pass","ProjectileClash",99,{source={all={"volume"}},target={all={"volume"}}},{signal("clash-pass")},{group="clash"})
rule("fire-feeds-on-wind","ProjectileClash",95,{source={all={"fire"}},target={all={"wind"}},context={all={"natureAdvantage"}}},{signal("clash-absorb")},{group="clash"})
rule("element-overpowers","ProjectileClash",90,{context={all={"natureAdvantage"}}},{signal("clash-pierce")},{group="clash"})
-- Neji's chakra palm swats the blades in front of it (it never meets a jutsu).
rule("palm-swats-blades","ProjectileClash",85,{source={all={"body","chakra"}},target={all={"tool"}}},{signal("clash-swat")},{group="clash"})
rule("volume-swallows-tool","ProjectileClash",80,{source={all={"volume"}},target={all={"tool"}}},{signal("clash-swallow")},{group="clash"})
-- A reinforced blade heavier than a small flame (Phoenix Flower) goes through it.
rule("heavy-steel-pierces-flame","ProjectileClash",78,{source={all={"tool","reinforced"}},target={all={"volume"}},context={all={"heavier"}}},{signal("clash-pierce")},{group="clash"})
rule("wind-cuts-the-lane","ProjectileClash",70,{source={all={"cutting","tool"}},target={all={"tool"}},context={any={"heavier","even"}}},{signal("clash-pierce")},{group="clash"})
rule("heavier-deflects","ProjectileClash",50,{context={all={"heavier"}}},{signal("clash-deflect")},{group="clash"})
rule("even-intercept","ProjectileClash",10,{},{signal("clash-intercept")},{group="clash"})
-- Contact: what the infused object does to the body it reaches.
rule("reinforced-guard-crush","Contact",50,{source={all={"reinforced"}},target={all={"guarding"}}},{signal("guard-crush")})
rule("lightning-wire-surge","Contact",45,{source={all={"lightning"}},target={all={"wired"}}},{signal("wire-surge")})
rule("lightning-shock","Contact",40,{source={all={"lightning"}},context={all={"clean"}}},{signal("shock")})
rule("fire-ignites","Contact",40,{source={all={"fire","tool"}},context={all={"clean"}}},{signal("ignite")})
rule("wind-gust","Contact",40,{source={all={"wind","tool"}},context={all={"clean"}}},{signal("gust")})
rule("gentle-palm-through-guard","Contact",50,{source={all={"body","chakra"}},target={all={"guarding"}}},{signal("palm-through-guard")})
rule("gentle-palm-point","Contact",40,{source={all={"body","chakra"}},context={all={"clean"}}},{signal("palm-point")})
-- SurfaceHit: a chakra blade stays planted; natures leave their mark.
rule("chakra-blade-plants","SurfaceHit",50,{source={all={"chakra","blade"}},surface={all={"anchorCompatible"}}},{{kind="embed",target="source"}})
rule("lightning-shock-point","SurfaceHit",45,{source={all={"lightning","blade"}}},{{kind="tag",tag="shockPoint",target="source"}})
rule("fire-burn-point","SurfaceHit",40,{source={all={"fire","tool"}}},{signal("burn-point")})
rule("wire-stretches","SurfaceHit",60,{source={all={"wire"}},surface={all={"anchorCompatible"}}},{signal("wire-stretch")})
-- PointContact: a planted chakra blade is a contestable point.
rule("owner-recovers","PointContact",50,{context={all={"owner","grounded"}}},{signal("point-recover")},{group="point"})
rule("shock-point-trap","PointContact",60,{source={all={"shockPoint"}},context={all={"opponent","grounded"}}},{signal("point-shock")},{group="point"})
-- A blade charged by the other fighter's lightning shocks whoever steps on
-- it, its own thrower included (his chakra back is lost to the current).
rule("charged-point-shocks","PointContact",70,{source={all={"charged"}},context={all={"chargeFoe","grounded"}}},{signal("point-shock")},{group="point"})
rule("opponent-tramples","PointContact",10,{context={all={"opponent","grounded"}}},{signal("point-deny")},{group="point"})
-- MetalCross: a flying object reaches a planted blade. Lightning jumps into
-- the metal and charges it; anything else knocks the point out.
rule("lightning-charges-metal","MetalCross",60,{source={all={"lightning"}},target={all={"metal"}}},{signal("metal-charge")},{group="metal"})
rule("thrown-object-knocks-point","MetalCross",10,{},{signal("point-knock")},{group="metal"})
-- Wire: a stretched wire binds on contact, carries fire, conducts lightning.
rule("tripwire-binds","WireContact",50,{context={all={"opponent","grounded"}}},{signal("tripwire-bind")})
rule("charged-wire-shocks","WireContact",60,{source={all={"charged"}},context={all={"opponent","grounded"}}},{signal("tripwire-shock")})
rule("fire-runs-the-wire","WireCross",60,{source={all={"fire"}}},{signal("wire-burn")},{group="wire"})
rule("lightning-charges-wire","WireCross",50,{source={all={"lightning"}},context={all={"own"}}},{signal("wire-charge")},{group="wire"})
rule("wind-cuts-wire","WireCross",40,{source={all={"cutting"}}},{signal("wire-cut")},{group="wire"})
return T
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND47">
        <Properties>
          <string name="Name">ChakraVectors</string>
          <ProtectedString name="Source">-- Serializable vector math: simulation/reporting has no Roblox instance dependency.
local V={}
function V.valid(v) return type(v)=="table" and type(v.x)=="number" and type(v.y)=="number" and type(v.z)=="number" and v.x==v.x and v.y==v.y and v.z==v.z and math.max(math.abs(v.x),math.abs(v.y),math.abs(v.z))&lt;=100000 end
function V.new(x,y,z) return {x=x or 0,y=y or 0,z=z or 0} end
function V.add(a,b) return V.new(a.x+b.x,a.y+b.y,a.z+b.z) end
function V.sub(a,b) return V.new(a.x-b.x,a.y-b.y,a.z-b.z) end
function V.mul(a,n) return V.new(a.x*n,a.y*n,a.z*n) end
function V.dot(a,b) return a.x*b.x+a.y*b.y+a.z*b.z end
function V.length(a) return math.sqrt(V.dot(a,a)) end
function V.unit(a) local length=V.length(a);assert(length&gt;1e-8,"Zero direction");return V.mul(a,1/length) end
function V.reflect(a,n) n=V.unit(n);return V.sub(a,V.mul(n,2*V.dot(a,n))) end
-- Swept relative spheres catch fast projectiles that cross between ticks.
function V.sweep(a,da,b,db,radius)
 local p=V.sub(a,b);local d=V.sub(da,db);local c=V.dot(p,p)-radius*radius
 if c&lt;=0 then return 0 end
 local aa=V.dot(d,d);if aa&lt;1e-10 then return nil end
 local bb=2*V.dot(p,d);local disc=bb*bb-4*aa*c;if disc&lt;0 then return nil end
 local t=(-bb-math.sqrt(disc))/(2*aa);return if t&gt;=0 and t&lt;=1 then t else nil
end
return V
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND48">
        <Properties>
          <string name="Name">Combat</string>
          <ProtectedString name="Source">local Shared = game:GetService("ReplicatedStorage").NinjaDuel
local Config = require(Shared.Config)
local Fighters = require(Shared.Fighters)
local Rules = require(Shared.Rules)
local World = require(script.Parent.World)
local Motor = require(script.Parent.Motor)
local Animation = require(script.Parent.Animation)
local Techniques = require(script.Parent.Techniques)
-- Reusable technique families and fighter traits (roster breadth pass).
local Families = require(script.Parent.Families)
local Looks = require(Shared.Looks)
local Brawler = require(script.Parent.Brawler)
local WorldReaction = require(script.Parent.WorldReaction)
local BodyState = require(script.Parent.BodyState)
-- Bodies that are not actors (Naruto's shadow clones): stepped, struck,
-- cleared and sent with the duel (Server/Bodies).
local Bodies = require(script.Parent.Bodies)
local Bangla = require(script.Parent.BanglaCombat)
local Evade = require(script.Parent.BanglaEvade)
local HitDetection = require(script.Parent.VelmoraHitDetection)
local Defense = require(script.Parent.VelmoraDefense)
-- Persistent typed zones (wind lanes, updrafts) beside the burning hazards.
local Zones = require(script.Parent.Zones)
local Combat = {}; Combat.__index = Combat
function Combat.new(match)
	return setmetatable({match=match,now=0,actors={},effects={},projectiles={},hazards={},historyAt=0,impacts={},impactSerial=0,projectileSerial=0},Combat)
end
-- Where a thrown or breathed object physically leaves the body. Server-side
-- approximation of the animated hand/mouth so the projectile's first frame is
-- where the throwing arm actually is, not the middle of the chest.
local LAUNCH={
	Kunai={side=1.15,up=.95,forward=1.1},MarkedKunai={side=1.15,up=1.05,forward=1.1},Palm={side=.2,up=.9,forward=1.9},Ground={side=0,up=-2.2,forward=2.2},
	Shuriken={side=-1.1,up=.9,forward=1.2},Fireball={side=0,up=2.1,forward=2.6},Wind={side=.6,up=1,forward=2.2},
}
function Combat.launchPoint(a,kind)
	local spec=LAUNCH[kind] or {side=0,up=.6,forward=1.4}
	local cf=a.root.CFrame
	return cf.Position+cf.RightVector*spec.side+Vector3.yAxis*spec.up+cf.LookVector*spec.forward
end
-- `kit` (optional) is a validated skill build from SkillBuilds: its own copy
-- of the definition and move graph with the active nodes applied. Without one
-- the actor reads Fighters/MoveGraphs directly: today's fighter, unchanged.
function Combat:add(id,model,hum,root,joints,definition,kit)
	assert(kit==nil or kit.fighterId==definition,"Skill build does not belong to "..tostring(definition))
	local def = if kit then kit.def else Fighters[definition]
	if kit then hum.MaxHealth=def.Health;hum.Health=def.Health;hum.WalkSpeed=def.Speed end
	local a = { id=id,fighterId=definition,model=model,hum=hum,root=root,joints=joints,def=def,health=def.Health,
		graph=kit and kit.graph,build=kit and {nodes=table.clone(kit.nodes),spent=kit.spent,bracket=kit.bracket},
		chakra=def.Chakra or Config.Chakra,state="Neutral",untilTime=0,lockUntil=0,cooldowns={},move=Vector3.zero,
		combo=0,lastAttack=-10,readUntil=0,illusionUntil=0,bonusUntil=0,dodgeUntil=0,invulnerableUntil=0,
		color=Color3.fromRGB(table.unpack(def.Color)),guardHeld=false,lastMove=0, cue="",cueUntil=0,
		locomotion=Vector3.zero,sprinting=false,airborne=false,airDodgeUsed=false,landUntil=0,
		pursuitUntil=0,travelRemaining=0,travelDirection=Vector3.zero,chainOpen=false,hitConfirmed=false,airHold=0,
		subCharges=Config.Substitution.Charges,subCooldown=0,subRegenAt=math.huge,lastHurt=-10,neutralToolAt=0,wall=nil,wallNext=0,
		comboHits=0,comboDamage=0,anchors={},
		shieldCharges=def.SandShield and def.SandShield.Charges or 0,shieldRegenAt=0 }
	table.insert(self.actors,a)
	Defense.init(a)
	-- The client motion engine owns every pose. Server Animator tracks (Roblox
	-- default walk/run/idle, donor punches) replicate to clients and overwrote
	-- that motion, so they only play when explicitly enabled.
	if Config.DonorAnimations then Animation.attach(a) end
	return a
end
-- The tournament stage is round: positions are held inside a circle so no
-- corner of the old square limit reaches into the stands.
function Combat:clamp(p)
	local o=self.match.origin; local r=Config.ArenaRadius
	local flat=Vector3.new(p.X-o.X,0,p.Z-o.Z)
	if flat.Magnitude&gt;r then flat=flat.Unit*r end
	return Vector3.new(o.X+flat.X,math.clamp(p.Y,o.Y+3,o.Y+Config.ArenaHeight),o.Z+flat.Z)
end
function Combat:relocate(a,p)
	-- A real teleport (seal, substitution, setup): the client snaps on it and
	-- smooths everything else.
	a.warpSerial=(a.warpSerial or 0)+1
	local look=a.root.CFrame.LookVector
	a.model:PivotTo(CFrame.lookAt(self:clamp(p),self:clamp(p)+Vector3.new(look.X,0,look.Z)))
	a.root.AssemblyLinearVelocity=Vector3.zero
end
function Combat:rayParams(excludeActors)
	local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude
	local exclude={self.match.effects}
	if excludeActors then for _,a in self.actors do table.insert(exclude,a.model) end end
	params.FilterDescendantsInstances=exclude
	return params
end
function Combat:overlapParams()
	local p=OverlapParams.new(); p.FilterType=Enum.RaycastFilterType.Exclude
	local exclude={self.match.effects}; for _,a in self.actors do table.insert(exclude,a.model) end
	p.FilterDescendantsInstances=exclude; return p
end
function Combat:lineOfSight(a,b)
	local delta=b.root.Position-a.root.Position
	return workspace:Raycast(a.root.Position,delta,self:rayParams(true)) == nil
end
-- `from` (optional): the frame a strike is thrown from when another body
-- carries it out (Bodies.bind); the attacker's own root otherwise.
function Combat:targetValid(a,b,range,facing,from)
	if not b or b.health&lt;=0 then return false end
	local roots={};for _,candidate in self.actors do table.insert(roots,candidate.root) end
	local angle=math.deg(math.acos(math.clamp(facing,-1,1)))
	-- Resolve each active-window sample against the newest recorded pose; the short
	-- history keeps interpolation stable without freezing a target at button-down.
	local root=HitDetection.resolve(a.root,range,angle,if from then from.Position else a.root.Position,if from then from.LookVector else a.root.CFrame.LookVector,self.now,roots,self.match.effects)
	return root==b.root
end
-- Server effects are logical markers only (anchor, echo, hitbox lifetimes).
-- Everything the player sees is drawn by the client from the snapshot and the
-- contact feed; the old translucent neon blocks read as debug geometry.
function Combat:effect(name,p,color,size,lifetime)
	local v=World.part(self.match.effects,name,size,CFrame.new(p),color,Enum.Material.Neon)
	v.CanCollide=false; v.CanQuery=false; v.CanTouch=false; v.Transparency=1; v.CastShadow=false
	table.insert(self.effects,{part=v,expires=self.now+lifetime})
	return v
end
function Combat:addHazard(a,position,radius,duration,damage,kind)
	local hazard={a=a,position=position,radius=radius,expires=self.now+duration,damage=damage,kind=kind,lastHit={}}
	table.insert(self.hazards,hazard)
	return hazard
end
-- Hitstop budget by impact weight. Only the defender stops, and only briefly:
-- freezing both actors on every light made a normal combo read as
-- move -&gt; stop -&gt; move -&gt; stop.
local HITSTOP={light=0,air=0,block=.01,finisher=.05,launcher=.06,parry=.075,slam=.09,jutsu=.065,default=.025}
Combat.Hitstop=HITSTOP
function Combat:applyHitstop(attacker,victim,style,heavy)
	local stop=HITSTOP[style] or (if heavy then HITSTOP.default else 0)
	if stop&lt;=0 then return stop end
	victim.hitstopUntil=math.max(victim.hitstopUntil or 0,self.now+stop)
	-- The attacker only joins on a genuinely heavy contact.
	if heavy then attacker.hitstopUntil=math.max(attacker.hitstopUntil or 0,self.now+stop*.5) end
	return stop
end
-- Short feed of contacts that actually happened. Snapshots carry it so the
-- client can layer sound and VFX on the real contact frame, never on the press.
-- Shortest channel the tutorial's interrupt step shows.
Combat.TRAINING_CHANNEL=.75
function Combat:pushImpact(position,style,heavy,extra)
	local feed=self.impacts or {}
	self.impacts=feed
	self.impactSerial=(self.impactSerial or 0)+1
	local role="neutral"
	for _,actor in self.actors do
		if actor.root and (actor.root.Position-position).Magnitude&lt;4.5 then
			role=if actor.health&gt;0 then "victim" else "neutral"
			break
		end
	end
	local entry={style=style,at=self.now,position=position,heavy=heavy==true,serial=self.impactSerial,role=role}
	-- Optional context (projectile id, surface normal, teleport endpoints, owner)
	-- so the client can finish the exact object it was drawing.
	if extra then for k,v in extra do entry[k]=v end end
	table.insert(feed,entry)
	while #feed&gt;12 do table.remove(feed,1) end
	-- Contacts are worth a snapshot now rather than at the next 50 ms tick.
	self.urgent=true
	return self.impactSerial
end
function Combat:cue(a,message,duration)
	a.cue=message; a.cueUntil=self.now+(duration or 1.1)
	if self.match.onCue then self.match.onCue(a,message) end
end
function Combat:setState(a,state,duration)
	a.state=state; a.untilTime=self.now+duration
	-- Chain and cancel windows belong to the attack recovery that computes them
	-- right after this call; any other state change must not inherit stale ones
	-- (a substitution or awaken recovery used to open a string-cancel). The
	-- same holds for a re-engage arrival (Brawler.arrive sets it after this).
	a.chainOpen=false; a.recoveryCancelAt=nil; a.arrivalRecovery=nil
end
-- Strikes that crack Gaara's sand shield outright (the rest each cost a charge).
local SHIELD_BREAKERS={Heavy=true,Launcher=true,Light3=true,Slam=true,KneeStrike=true,FlyingKick=true,PalmThrust=true,CounterPalm=true,WallDive=true,SandPillar=true}
-- Damage over time (burning ground, a burning wire): chip damage that never
-- stuns, interrupts, scales or confirms anything. Through Combat:damage a body
-- standing in fire was re-stunned every 0.48 s (its action cancelled), every
-- tick filled the combo counter and its scaling (one fire shuriken read
-- "8 HITS, next x0.35" in Studio) and Gaara's shield spent itself on flames.
function Combat:chip(attacker,victim,amount)
	if self.match.phase~="Duel" or self.match.finishing or victim.health&lt;=0 or attacker.health&lt;=0 then return false end
	if (victim.rotationUntil or 0)&gt;self.now or victim.invulnerableUntil&gt;self.now then return false end
	if (attacker.awakenUntil or 0)&gt;self.now then amount*=attacker.def.Awakening.Damage or 1 end
	victim.health=math.max(0,victim.health-amount); victim.hum.Health=math.max(1,victim.health)
	if self.damageLog then table.insert(self.damageLog,{t=self.now,by=attacker.fighterId,amount=amount,tag=self.damageTag or "chip",hits=victim.comboHits}) end
	if victim.health&lt;=0 then
		Brawler.releaseGrab(victim); victim.reaction=nil
		victim.state="Defeated"; victim.pending=nil; victim.move=Vector3.zero
		victim.koStyle="light";victim.koAirborne=victim.airborne==true
		self.match.finish(attacker,victim)
	end
	return true
end
function Combat:damage(attacker,victim,amount,heavy,readEligible)
	if self.match.phase~="Duel" or self.match.finishing or victim.health&lt;=0 or attacker.health&lt;=0 then return false end
	-- Inside Rotation nothing reaches Neji; the dome answers on its own step.
	if (victim.rotationUntil or 0)&gt;self.now then return false end
	-- A counter stance (Families Counter) answers the blow before any defence.
	if Families.beforeHit(self,attacker,victim,readEligible) then return false end
	if victim.wall then Motor.detach(victim,self.now,false) end
	-- A blade is judged from where it came from (a redirected shuriken reaches
	-- the flank even when the thrower stands in front).
	local delta=(self.hitOrigin or attacker.root.Position)-victim.root.Position
	local frontal=delta.Magnitude&lt;0.1 or victim.root.CFrame.LookVector:Dot(delta.Unit)&gt;0.15
	-- Byakugan: the guard covers every side but a narrow blind spot behind.
	if victim.def.Byakugan and delta.Magnitude&gt;=0.1 then
		local full=(victim.awakenUntil or 0)&gt;self.now and victim.def.Awakening and victim.def.Awakening.NoBlindSpot
		frontal=full or victim.root.CFrame.LookVector:Dot(delta.Unit)&gt;-victim.def.Byakugan.BlindSpot
	end
	-- Sharingan tracking: a raised guard follows a teleport instead of being crossed up.
	if not frontal and victim.def.Sharingan and victim.guardHeld and attacker.teleportAt and self.now-attacker.teleportAt&lt;.7 then
		frontal=true
		local flat=Vector3.new(delta.X,0,delta.Z)
		if flat.Magnitude&gt;.1 then victim.root.CFrame=CFrame.lookAt(victim.root.Position,victim.root.Position+flat) end
		self:cue(victim,"SHARINGAN • TRACKED",.7)
	end
	-- Sharingan Read: the blow is seen coming (VelmoraDefense.read).
	if readEligible and frontal and victim.readUntil&gt;self.now then return Defense.read(self,attacker,victim) end
	-- Gaara's sand shield stops the hit by itself while it has charges.
	local shield=victim.def.SandShield
	-- Not while he is attacking or recovering from it: a whiffed lash is the opening.
	-- The sand covers his front and flanks, not his back: a blow that gets
	-- round him (a teleport, an angle, a clone) is the way past it, so he is
	-- punishable when bypassed instead of absorbing every basic string.
	local covered=delta.Magnitude&lt;0.1 or victim.root.CFrame.LookVector:Dot(delta.Unit)&gt;(shield and shield.Cover or -1)
	if shield and covered and (victim.shieldCharges or 0)&gt;0 and victim.state~="Startup" and victim.state~="Active" and victim.state~="Recovery" and victim.state~="Stunned"
		and not victim.reaction and not victim.grabbedBy and victim.invulnerableUntil&lt;=self.now then
		local breaking=heavy or amount&gt;=shield.Break or SHIELD_BREAKERS[attacker.attackName or ""]==true
		-- A new fighter's strike carries the flag in its own data (Attacks
		-- breaksShield: Rock Lee's rising kick and spinning dash kick).
		breaking=breaking or (attacker.pending~=nil and attacker.pending.kind=="Brawl" and attacker.pending.spec.breaksShield==true)
		-- Wind scatters sand (TEMARI.md §11): a contact flagged by its source
		-- (Combat.shieldBreak, set around the damage: Temari's scythe and gust).
		breaking=breaking or self.shieldBreak==true
		victim.shieldCharges=if breaking then 0 else victim.shieldCharges-1
		victim.shieldRegenAt=self.now+shield.Regen
		-- The sand absorbs the blow but the string keeps its rhythm: pressing on
		-- (light, light, third hit) is how the shield is cracked.
		attacker.hitConfirmed=true
		local face=if delta.Magnitude&gt;.1 then delta.Unit else victim.root.CFrame.LookVector
		self:pushImpact(victim.root.Position+face*1.6,"sandshield",breaking,{owner=victim.id,direction=face})
		Brawler.event(self,victim,"SandShield")
		if breaking then
			self:setState(victim,"Stunned",.5)
			self:cue(victim,"SAND SHIELD BROKEN",.8);self:cue(attacker,"SAND SHIELD BROKEN",.8)
		else self:cue(victim,"SAND SHIELD",.4) end
		return false
	end
	local counterBefore=victim.counterUntil
	local outcome,resolved=Defense.resolve(self,attacker,victim,amount,frontal,readEligible)
	-- Skill build (Mirage Reflex): the read that just opened a Sharingan counter
	-- also leaves a genjutsu decoy while awakened.
	if (outcome=="Evaded" or outcome=="Parried") and victim.counterUntil~=counterBefore then self:reflexEcho(victim,attacker) end
	-- A guard break keeps its full stun through the melee reaction that follows.
	if outcome=="GuardBreak" then victim.stunFloorUntil=victim.untilTime end
	if outcome=="Evaded" then Brawler.event(self,victim,"Evaded");self:cue(victim,"EVADED");return false end
	if outcome=="Parried" then
		Brawler.event(self,victim,"Parry")
		if readEligible then Brawler.event(self,attacker,"Parried") end
		local style=if readEligible then "parry" else "deflect"
		victim.impactStyle=style;victim.impactAt=self.now
		self:pushImpact(victim.root.Position,style,false)
		self:effect("Parry",victim.root.Position,Color3.fromRGB(255,236,145),Vector3.new(3.8,3.8,3.8),.16)
		if readEligible then self:parryRider(victim,attacker) end
		return false
	end
	amount=resolved
	local guarded=outcome=="Blocked"
	if guarded then
		self:cue(victim,"GUARDED")
	else
		local interrupted=Rules.interruptible(victim)
		local protected= victim.state=="TechniqueChannel" and victim.pending and not victim.pending.spec.Interruptible
		-- Super armour (a Heavy buff): a light blow lands but does not stop him.
		protected=protected or Families.withstands(victim,self.now,heavy,amount)
		if not protected then
			Brawler.releaseGrab(victim)
			victim.pending=nil; victim.readUntil=0; victim.guardHeld=false
			if outcome~="GuardBreak" then self:setState(victim,"Stunned",if interrupted then Config.InterruptStun else Config.HitStun) end
			if interrupted then victim.stunFloorUntil=victim.untilTime end
			if interrupted then victim.interruptedAt=self.now; Brawler.event(self,attacker,"Interrupt"); self:cue(victim,"INTERRUPTED"); self:cue(attacker,"CHANNEL INTERRUPTED") end
		end
	end
	if attacker.bonusUntil&gt;self.now then amount*=1.35; attacker.bonusUntil=0 end
	if (attacker.awakenUntil or 0)&gt;self.now then amount*=attacker.def.Awakening.Damage or 1 end
	-- Buffs and armour (Families): outgoing and incoming.
	amount*=Families.damageScale(attacker,victim,self.now)
	-- An awakening with a price (the Curse Mark): the body that carries it takes more.
	if (victim.awakenUntil or 0)&gt;self.now and victim.def.Awakening then amount*=1+(victim.def.Awakening.Vulnerability or 0) end
	-- Combo scaling: the opening hits of a combo land in full, every later hit
	-- is worth less. Long routes stay possible; they just stop being lethal.
	if not guarded then
		local tune=Config.ComboScaling
		local n=victim.comboHits or 0
		if n&gt;=tune.Free then amount*=math.max(tune.Floor,1-tune.Step*(n-tune.Free+1)) end
		victim.comboHits=n+1;victim.comboDamage=(victim.comboDamage or 0)+amount;victim.comboBy=attacker
	end
	victim.lastHurt=self.now
	victim.health=math.max(0,victim.health-amount); victim.hum.Health=math.max(1,victim.health)
	-- The attacker's on-hit trait (def.OnHit: a drain, a slow).
	Families.afterHit(self,attacker,victim,amount,guarded)
	-- Studio tooling only: where damage comes from, to tune fight length.
	if self.damageLog then table.insert(self.damageLog,{t=self.now,by=attacker.fighterId,amount=amount,tag=self.damageTag or "other",hits=victim.comboHits}) end
	victim.impactSerial=(victim.impactSerial or 0)+1; victim.impactHeavy=heavy or amount&gt;=12
	local style=(if guarded then "block" elseif heavy and amount&gt;=16 then "slam" elseif heavy then "launcher" elseif amount&gt;=20 then "finisher" else "light")
	victim.impactStyle=style
	victim.impactAt=self.now
	-- Direction and weight of the contact so the victim's body can answer the
	-- hit it actually took instead of playing one generic recoil.
	local toward=Vector3.new(delta.X,0,delta.Z)
	if toward.Magnitude&gt;.05 then
		victim.hitFrom=toward.Unit
		local facing=Vector3.new(victim.root.CFrame.LookVector.X,0,victim.root.CFrame.LookVector.Z)
		if facing.Magnitude&gt;.05 then
			facing=facing.Unit
			victim.hitAngle=math.deg(math.atan2(facing:Cross(victim.hitFrom).Y,facing:Dot(victim.hitFrom)))
		else
			victim.hitAngle=0
		end
	else
		victim.hitFrom=Vector3.zAxis
		victim.hitAngle=0
	end
	victim.hitStrength=math.clamp(amount/26,0,1)
	-- Seed the stop; Brawler adds the exact per-move weight once it knows the move.
	self:applyHitstop(attacker,victim,style,heavy)
	-- Combat convergence: the spark sits where the blow met the body (the
	-- side facing the striker, at the struck height), not in the chest centre.
	local contactZone=attacker.pending and attacker.pending.kind=="Brawl" and attacker.pending.spec and attacker.pending.spec.zone
	local contactAt=victim.root.Position+(victim.hitFrom or Vector3.zero)*.7
		+Vector3.new(0,if contactZone=="head" or contactZone=="chin" then 1.55 elseif contactZone=="legs" then -1.4 else .45,0)
	-- (Reference quality) the client draws the blow along its strike and tints
	-- the body it struck: who, which way, how hard.
	self:pushImpact(if self.hitOrigin then victim.root.Position else contactAt,style,victim.impactHeavy,
		{victim=victim.id,direction=-(victim.hitFrom or Vector3.zero),amount=amount,guarded=guarded})
	Brawler.event(self,attacker,"Damage"); if guarded then Brawler.event(self,victim,"GuardHit") end
	self:effect("Impact",if self.hitOrigin then victim.root.Position else contactAt,if guarded then Color3.fromRGB(221,203,152) else attacker.color,Vector3.new(2,2,2),0.12)
	if heavy and not guarded and victim.health&gt;0 then
		attacker.pursuitUntil=self.now+Config.PursuitWindow
		self:cue(attacker,"LAUNCH • E TO PURSUE",Config.PursuitWindow)
		local push=Vector3.new(-delta.X,0,-delta.Z)
		if push.Magnitude&gt;0.1 then Brawler.react(self,victim,"Launched",push.Unit*22+Vector3.new(0,42,0),.9) end
	end
	if victim.health&lt;=0 then
		Brawler.releaseGrab(victim); victim.reaction=nil
		victim.state="Defeated"; victim.pending=nil; victim.move=Vector3.zero
		-- Remember the blow that ended it so the KO body matches the final hit.
		victim.koStyle=style
		victim.koAirborne=victim.airborne==true
		-- The last blow freezes for a beat on both bodies.
		attacker.hitstopUntil=self.now+.22;victim.hitstopUntil=self.now+.22
		attacker.pending=nil;attacker.move=Vector3.zero
		self.match.finish(attacker,victim)
	end
	attacker.hitConfirmed=true
	return true
end
function Combat:strike(a,damage,range,facing,heavy)
	if self:targetValid(a,a.target,range,facing) then return self:damage(a,a.target,damage,heavy,true) end
	return false
end
-- Skill-build hooks (SkillBuilds.OPTIONAL). Each reads one optional field of
-- the actor's definition; canonical kits never carry these fields.
-- Parry riders: ParrySeal (Minato) seals the stunned attacker for a teleport;
-- ParryRedirect (Neji) turns him aside, closes a point and opens a counter.
function Combat:parryRider(victim,attacker)
	if attacker.health&lt;=0 then return end
	local seal=victim.def.ParrySeal
	if seal then
		local entry=Techniques.plant(self,victim,attacker.root.Position,Vector3.yAxis,attacker)
		entry.expires=self.now+seal
		self:cue(victim,"PARRY • SEALED • 2 TO FOLLOW",.8)
		Brawler.event(self,victim,"ParrySeal")
	end
	local redirect=victim.def.ParryRedirect
	if redirect then
		local away=attacker.root.Position-victim.root.Position;away=Vector3.new(away.X,0,away.Z)
		if away.Magnitude&gt;.1 then
			-- A quarter turn aside: his chest no longer faces the palm that follows.
			local aside=Vector3.new(-away.Z,0,away.X).Unit
			attacker.root.CFrame=CFrame.lookAt(attacker.root.Position,attacker.root.Position+aside)
		end
		if victim.def.GentleFist then for _=1,redirect.Points or 1 do Brawler.gentleFist(self,victim,attacker,false) end end
		if redirect.Counter then victim.counterUntil=math.max(victim.counterUntil or 0,self.now+redirect.Counter) end
		self:pushImpact(attacker.root.Position,"deflect",false,{owner=victim.id})
		self:cue(victim,"REDIRECTED • COUNTER",.8);self:cue(attacker,"REDIRECTED",.6)
		Brawler.event(self,victim,"Redirect")
	end
end
-- Mirage Reflex (Itachi's awakening): the clean read that just opened a
-- Sharingan counter leaves a genjutsu decoy on the attacker.
function Combat:reflexEcho(victim,attacker)
	local tune=victim.def.Awakening
	local reflex=tune and tune.Reflex
	if not reflex or (victim.awakenUntil or 0)&lt;=self.now or attacker==victim or attacker.health&lt;=0 or attacker.def.Byakugan then return end
	attacker.illusionUntil=self.now+reflex
	attacker.decoyPosition=self:clamp(victim.root.Position+victim.root.CFrame.RightVector*5)
	self:effect("Echo",attacker.decoyPosition,victim.color,Vector3.new(2,5,1),reflex)
	self:pushImpact(victim.root.Position,"mirage",false,{owner=victim.id,fighter=victim.fighterId,to=attacker.decoyPosition})
	self:cue(victim,"FOCUS • MIRAGE REFLEX",.8);self:cue(attacker,"MIRAGE • TRUST THE BODY",reflex)
	Brawler.event(self,victim,"MirageReflex")
end
-- Blood for Chakra (Sasuke's Curse Mark): awakened, the chakra a technique
-- lacks is paid with health, never down to a KO.
function Combat:curseBlood(a,spec)
	local tune=a.def.Awakening
	if not (tune and tune.BloodChakra) or (a.awakenUntil or 0)&lt;=self.now or a.chakra&gt;=spec.Cost then return false end
	if (a.cooldowns[spec.Id] or 0)&gt;self.now or (a.sealedUntil or 0)&gt;self.now or self.match.techniquesDisabled then return false end
	local debt=spec.Cost-a.chakra
	if a.health&lt;=debt+1 then return false end
	a.health-=debt;a.hum.Health=math.max(1,a.health);a.chakra=spec.Cost
	self:cue(a,"CURSE MARK • BLOOD FOR CHAKRA",.8)
	Brawler.event(self,a,"BloodChakra")
	return true
end
-- Air Exit (Minato): Tool during a teleport arrival in the air throws a marked
-- kunai straight down; where it lands becomes a seal. nil when not applicable.
function Combat:arrivalThrow(a)
	local throw=a.def.ArrivalThrow
	if not throw or (a.flashUntil or 0)&lt;=self.now or not a.airborne or a.throwing
		or (a.state~="TechniqueRecovery" and a.state~="TechniqueActive") then return nil end
	if a.chakra&lt;Config.ToolCost then return false,"Need chakra" end
	a.chakra-=Config.ToolCost
	a.flashUntil=0;a.pending=nil;self:setState(a,"Neutral",0)
	a.neutralToolAt=self.now+((a.def.ToolMastery and a.def.ToolMastery.Recover) or .55)
	local below=Vector3.new(a.root.Position.X,self.match.origin.Y,a.root.Position.Z)
	self:beginThrow(a,{kind="MarkedKunai",release=.08,count=1,aim=below,fire=function(_,target)
		self:projectile(a,target,96,40,throw.Damage or 2,"marked",function(position,normal,victim)
			if a.health&lt;=0 or self.match.phase~="Duel" then return end
			Techniques.plant(self,a,position,normal,victim)
		end)
	end})
	self:cue(a,"SEAL BELOW",.6)
	Brawler.event(self,a,"ArrivalThrow")
	return true
end
-- Chakra infusion and projectile interactions (ChakraCombat over the rules
-- Codex prepared): infused throws, meetings in flight, planted points, wire.
local Chakra=require(script.Parent.ChakraCombat)
-- Projectile kinds: "kunai", "marked" (Minato's seal kunai), "shuriken",
-- "fireball" and "wind". Legacy names ("blade", "needle", "tool") still work.
local KIND_ALIAS={blade="marked",needle="shuriken",tool="kunai"}
local LAUNCH_FOR={kunai="Kunai",marked="MarkedKunai",shuriken="Shuriken",fireball="Fireball",wind="Wind"}
-- Straight, constant-speed flights: the client reproduces the exact path from
-- (origin, direction, speed, born) and only needs the end event from the feed.
function Combat:projectile(a,aim,speed,range,damage,kind,onSurface,opts)
	opts=opts or {}
	kind=KIND_ALIAS[kind] or kind
	local start=opts.origin or Combat.launchPoint(a,LAUNCH_FOR[kind] or "Kunai")
	local delta=aim-start
	if delta.Magnitude&lt;0.1 then delta=a.root.CFrame.LookVector end
	self.projectileSerial=(self.projectileSerial or 0)+1
	local p={id=self.projectileSerial,a=a,origin=start,position=start,direction=delta.Unit,speed=speed,range=range,remaining=range,
		damage=damage,onSurface=onSurface,kind=kind,born=self.now,radius=opts.radius or 0,growth=opts.growth or 0,
		reaction=opts.reaction,impulse=opts.impulse,explode=opts.explode,heavy=opts.heavy,
		-- A flight that names its own contact (style, and reaction/impulse/stun:
		-- Temari's wind scythe knocks away; breaksShield: wind scatters sand)
		-- instead of its kind's.
		style=opts.style,stun=opts.stun,breaksShield=opts.breaksShield,
		-- Skill-build riders (chase, chakra point, wall pin, bind): see projectileRiders.
		riders=opts.riders,
		-- A tool that turns into a body near its target (Bodies.transform).
		transform=opts.transform}
	-- A chakra plan (Chakra.plan / Chakra.innate) changes how this object flies
	-- and what it does on contact; without one the throw is the plain one.
	if opts.chakra then Chakra.arm(self,p,opts.chakra) end
	table.insert(self.projectiles,p)
	self.urgent=true
	return p
end
function Combat:removeProjectile(p)
	for i=#self.projectiles,1,-1 do
		if self.projectiles[i]==p then table.remove(self.projectiles,i) end
	end
end
-- A flight changed in the air (a wind lane turns it aside, speeds it up or
-- feeds it): the client rebuilds every flight as origin + direction x speed x
-- (t - born), so the change starts a new leg here and now (origin, born and
-- range re-based, a volume's growth folded into its radius) and goes out in
-- the next snapshot. Changing direction or speed in place drew it on the old line.
function Combat:redirect(p,direction,speed)
	p.radius=(p.radius or 0)+(p.growth or 0)*math.max(0,self.now-p.born)
	p.origin=p.position;p.born=self.now;p.range=p.remaining
	if direction and direction.Magnitude&gt;.01 then p.direction=direction.Unit end
	if speed then p.speed=speed end
	p.leg=(p.leg or 0)+1
	self.urgent=true
	return p
end
-- The marked kunai that is still travelling, if any: Minato can relocate onto
-- it mid-flight, which is the whole point of the seal.
function Combat:markedInFlight(a)
	for _,p in self.projectiles do
		if p.a==a and p.kind=="marked" then return p end
	end
	return nil
end
-- Throws keep the thrower in Neutral so locomotion continues: the arm releases
-- on its authored frame while the legs keep running.
function Combat:beginThrow(a,spec)
	a.throwSerial=(a.throwSerial or 0)+1
	a.throwing={kind=spec.kind,started=self.now,release=self.now+spec.release,nextRelease=self.now+spec.release,
		count=spec.count or 1,fired=0,interval=spec.interval or .07,aim=spec.aim,fire=spec.fire,serial=a.throwSerial}
	a.throwKind=spec.kind;a.throwStarted=self.now;a.throwRelease=spec.release
	self.urgent=true
end
function Combat:stepThrow(a)
	local throw=a.throwing
	if not throw then return end
	if a.health&lt;=0 or a.reaction or a.state=="Stunned" or a.state=="Defeated" or a.state=="Dodging" then
		a.throwing=nil;return
	end
	while a.throwing==throw and self.now&gt;=throw.nextRelease and throw.fired&lt;throw.count do
		throw.fired+=1
		-- Re-aim at release against the live target, unless an explicit point was
		-- chosen: a throw tracks the opponent the arm is actually throwing at.
		-- A point picked on or near the opponent (the mouse on his body or the
		-- floor at his feet) means him: the blade goes to where he is now.
		local aim=throw.aim
		local b=a.target
		if b and b.health&gt;0 and not Families.shrouded(self,a) and (not aim or Vector3.new(aim.X-b.root.Position.X,0,aim.Z-b.root.Position.Z).Magnitude&lt;=Families.AIM_SNAP) then aim=b.root.Position end
		aim=aim or (a.root.Position+a.root.CFrame.LookVector*20)
		throw.fire(throw.fired,aim)
		throw.nextRelease+=throw.interval
	end
	if a.throwing==throw and throw.fired&gt;=throw.count then a.throwing=nil end
end
-- Facing while locked on. Small moves around the opponent are strafes with
-- the chest on them; a committed run (held away from them, sprinting, or from
-- far) turns the body into the run, three-quarters toward the opponent, so a
-- fighter never slides around a point like a mannequin. The turn is
-- progressive; guarding always squares up.
-- Turn the root toward a flat direction at a bounded angular speed (deg/s).
-- Instant lookAt writes read as the body teleporting its facing (measured up
-- to 175 degrees in one frame) and drag the planted feet with them.
function Combat:turnToward(a,direction,dt,rate)
	local want=Vector3.new(direction.X,0,direction.Z)
	if want.Magnitude&lt;.01 then return end
	want=want.Unit
	local current=Vector3.new(a.root.CFrame.LookVector.X,0,a.root.CFrame.LookVector.Z)
	current=if current.Magnitude&gt;.01 then current.Unit else want
	local angle=math.atan2(current:Cross(want).Y,current:Dot(want))
	local step=math.clamp(angle,-math.rad(rate)*dt,math.rad(rate)*dt)
	local look=CFrame.fromAxisAngle(Vector3.yAxis,step):VectorToWorldSpace(current)
	a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+look)
end
function Combat:faceLocked(a,dt)
	-- Lost in the opponent's shroud: no auto-facing on a body he cannot see.
	if Families.shrouded(self,a) then return end
	if not a.airborne then a.airFace=nil end
	local toward=a.target.root.Position-a.root.Position;toward=Vector3.new(toward.X,0,toward.Z)
	if toward.Magnitude&lt;.1 then return end
	local target=toward.Unit
	local distance=toward.Magnitude
	local intent=Vector3.new(a.move.X,0,a.move.Z)
	local desired=target
	local committed=false
	if a.state=="Neutral" and intent.Magnitude&gt;.4 then
		local moveDir=intent.Unit
		local along=target:Dot(moveDir) -- 1 toward, -1 away, 0 around
		if along&lt;.55 then a.awayHeld=(a.awayHeld or 0)+dt else a.awayHeld=0 end
		committed=a.sprinting or (a.awayHeld or 0)&gt;.3 or (distance&gt;16 and along&lt;.55)
		-- Close in and retreating a step: a backpedal keeps the chest on them.
		if along&lt;-.5 and distance&lt;10 and not a.sprinting then committed=false end
		-- Movement overhaul (Studio, real keys): a jump away from or around a
		-- close opponent keeps the chest on them through the air, so the back
		-- flip / side flip leaving contact does not twist round mid-air.
		-- Decided near the opponent, held for the whole airtime.
		if a.airborne and along&lt;.55 and distance&lt;16 and not a.sprinting then a.airFace=true end
		if a.airFace and along&lt;.55 then committed=false end
		if committed then
			local look=if distance&lt;12 then .45 else .2
			desired=(moveDir+target*look).Unit
		end
	else a.awayHeld=0 end
	local current=Vector3.new(a.root.CFrame.LookVector.X,0,a.root.CFrame.LookVector.Z)
	if current.Magnitude&lt;.01 then current=desired end
	current=current.Unit
	local angle=math.atan2(current:Cross(desired).Y,current:Dot(desired))
	-- (Continuity blocker: magnetic facing) A turn the hips and feet can
	-- carry: a body whipping 180 degrees in under a quarter second read as the
	-- lock, not the fighter (Config.Facing.Neutral / Committed).
	local rate=math.rad(if committed then Config.Facing.Committed else Config.Facing.Neutral)*dt
	local turn=math.clamp(angle,-rate,rate)
	local look=CFrame.fromAxisAngle(Vector3.yAxis,turn):VectorToWorldSpace(current)
	a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+look)
	a.facingCommitted=committed
end
-- Kawarimi. A limited escape from a combo: two charges that come back one at a
-- time, a chakra cost, and a short tracking window for the attacker so a
-- predictable substitution can still be punished. Each prodigy reappears in
-- his own way: Minato on a planted seal if he has one, Itachi as a crow clone
-- behind the attacker, otherwise a short hop away.
function Combat:substitute(a)
	local tune=Config.Substitution
	if a.subCharges&lt;=0 then return false,"No substitution" end
	if self.now&lt;a.subCooldown then return false,"Substitution recovering" end
	if a.chakra&lt;tune.Cost then return false,"Need chakra" end
	local hurt=(a.reaction~=nil and a.reaction~="Wakeup" and not (a.reaction=="Knockdown" and not a.airborne))
		or a.state=="Stunned" or self.now-a.lastHurt&lt;=tune.Window
	if not hurt then return false,"No escape window" end
	local attacker=a.target
	local departure=a.root.Position
	local destination,mode,swap=nil,"hop",nil
	-- Skill-build twist (SkillBuilds def.Substitution); nil for canonical kits.
	local twist=a.def.Substitution
	local seal=a.fighterId=="Flashstep" and Techniques.escapeSeal(self,a,self.now)
	if seal then
		destination=self:clamp(seal.position);mode="seal"
	elseif a.fighterId=="Mirage" and attacker and attacker.health&gt;0 then
		local back=-attacker.root.CFrame.LookVector*Vector3.new(1,0,1)
		if back.Magnitude&gt;.1 then
			local spot=self:clamp(Vector3.new(attacker.root.Position.X,self.match.origin.Y+3,attacker.root.Position.Z)+back.Unit*5.5)
			if self:openSpot(attacker,spot) then destination=spot;mode="crow" end
		end
	elseif twist and twist.Mode=="flank" and attacker and attacker.health&gt;0 then
		-- Neji's outside step: reappear on the attacker's flank, on the side he
		-- was already on, else the other one.
		local right=attacker.root.CFrame.RightVector*Vector3.new(1,0,1)
		if right.Magnitude&gt;.1 then
			right=right.Unit
			local first=if (a.root.Position-attacker.root.Position):Dot(right)&gt;=0 then 1 else -1
			for _,sign in {first,-first} do
				local spot=self:clamp(Vector3.new(attacker.root.Position.X,self.match.origin.Y+3,attacker.root.Position.Z)+right*sign*5)
				if self:openSpot(attacker,spot) then destination=spot;mode="flank";break end
			end
		end
	elseif twist and twist.Mode=="clone" then
		-- Naruto: "it was a clone!" He trades places with one of his clones
		-- (Bodies); the body that was being hit puffs away where he stood.
		swap=Bodies.swapWith(self,a)
		if swap then destination=swap.position;mode="clone" end
	end
	if destination then
		self:relocate(a,destination)
		if swap then Bodies.swapped(self,swap,departure) end
	elseif twist and twist.Mode=="burst" then
		-- Rock Lee's Rupture: no ninjutsu, so no body swap. He stays where he is;
		-- the kick that throws the attacker off is Techniques.rupture (below).
	else
		local away=a.root.Position-(if attacker then attacker.root.Position else a.root.Position-a.root.CFrame.LookVector)
		away=Vector3.new(away.X,0,away.Z)
		if away.Magnitude&lt;0.1 then away=a.root.CFrame.RightVector end
		-- Pinned against a wall the straight escape is blocked: slide along it.
		-- (A twist may jump further: Temari's wind retreat.)
		local hop=(twist and twist.Distance) or tune.Distance
		local moved=Motor.travel(a,self,away,hop)
		if moved&lt;2 then
			local side=Vector3.new(-away.Z,0,away.X)
			moved=Motor.travel(a,self,side,hop)
			if moved&lt;2 then moved=Motor.travel(a,self,-side,hop) end
		end
		if moved&lt;2 then return false,"Escape blocked" end
		-- The hop is a substitution, not a run: the client cuts to the new spot
		-- (free fights in Studio: drawn as an 8-stud slide with a 180 degree spin
		-- over three frames).
		a.warpSerial=(a.warpSerial or 0)+1
	end
	if attacker then
		local face=attacker.root.Position-a.root.Position;face=Vector3.new(face.X,0,face.Z)
		if face.Magnitude&gt;.1 then a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+face) end
	end
	if a.subCharges&gt;=tune.Charges then a.subRegenAt=self.now+tune.Recharge end
	a.subCharges-=1; a.chakra-=tune.Cost; a.subCooldown=self.now+tune.Cooldown
	a.subUntil=self.now+0.17
	Brawler.releaseGrab(a); a.reaction=nil; a.reactionVelocity=nil; a.airHold=0; a.throwing=nil;a.groundPose=nil
	a.airborne=a.root.Position.Y&gt;self.match.origin.Y+4.2
	if seal then Techniques.consumeSeal(self,a,seal) end
	-- Skill-build twist riders: a seal left where he stood (Return Seal), a
	-- counter window (Crow Counter, Outside Step), a free counter-rush.
	local extra=""
	if twist then
		if twist.PlantDeparture then
			Techniques.plant(self,a,Vector3.new(departure.X,self.match.origin.Y,departure.Z),Vector3.yAxis)
			extra=" • SEAL LEFT"
		end
		if twist.Counter then a.counterUntil=self.now+twist.Counter;extra=extra.." • COUNTER" end
		if twist.FreeRush then a.freeRushUntil=self.now+twist.FreeRush;extra=extra.." • E: COUNTER-RUSH" end
	end
	Brawler.event(self,a,"Substitute"); a.pending=nil; a.guardHeld=false; a.invulnerableUntil=self.now+0.24
	a.comboHits=0;a.comboDamage=0
	self:setState(a,"Recovery",0.14)
	-- The attacker may read the reappearance: a short chase window.
	if attacker and attacker.health&gt;0 then
		attacker.pursuitUntil=math.max(attacker.pursuitUntil,self.now+tune.Track)
		self:cue(attacker,"SUBSTITUTION • E TO TRACK",tune.Track)
	end
	if twist and twist.Mode=="burst" then return Techniques.rupture(self,a,attacker,twist) end
	self:pushImpact(departure,"substitute",false,{owner=a.id,fighter=a.fighterId,to=a.root.Position,mode=mode})
	self:effect("Afterimage",departure,a.color,Vector3.new(2,4,2),0.35)
	self:effect("Substitution",a.root.Position,a.color,Vector3.new(3,4,3),0.25)
	self:cue(a,(if mode=="seal" then "SUBSTITUTION • TO THE SEAL" elseif mode=="crow" then "SUBSTITUTION • CROW CLONE" elseif mode=="flank" then "SUBSTITUTION • OUTSIDE STEP"
		elseif mode=="clone" then "SUBSTITUTION • IT WAS A CLONE!" else "SUBSTITUTION • REPOSITIONED")..extra)
	return true
end
-- A reappearance point next to `attacker` is usable when nothing solid fills it
-- and the attacker has a clear line to it.
function Combat:openSpot(attacker,spot)
	for _,part in workspace:GetPartBoundsInBox(CFrame.new(spot),Vector3.new(2.6,4.6,2.6),self:overlapParams()) do
		if part.CanCollide then return false end
	end
	return workspace:Raycast(attacker.root.Position,spot-attacker.root.Position,self:rayParams(true))==nil
end
-- Wall tech: pinned against a wall, a well-timed dodge kicks off it. Too early
-- (before the impact settles) or too late and the pin holds.
-- Re-engage (CORE_COMBAT_CONVERGENCE_2 §3): ONE contextual action — keyboard
-- E; on a pad × inside a chase window, sprint + ○ toward outside one. Inside a
-- chase window (knock-away, launch, throw, wall splat or bounce, a substitution
-- to track) it is the chase; outside it is the chakra dash at a locked
-- opponent. Same chakra either way; each prodigy re-enters his own way
-- (MoveGraphs[...].reengage, Brawler.rushPlan).
function Combat:reengage(a)
	if a.pursuitUntil&gt;self.now and a.target.health&gt;0 then return self:chase(a) end
	return self:rush(a)
end
-- The chase: reach the knocked-away / launched / thrown body in three
-- dimensions (motion in updateActor). The strike that connected and opened the
-- window (a launcher, the third light, a palm thrust...) may be cancelled into
-- it at once: E pressed on the knock-away is never eaten by its active frames.
-- (Continuity blocker: magnetic pursuit) The chase heads for where the body
-- was going when it set off; that point only follows the body's real path at
-- Config.Chase.Steer studs/s. A chase that re-solved the body's position every
-- frame read as the chaser glued to it (constant spacing all through the air).
function Combat.steerChase(a,want,dt)
	local p=a.chasePoint
	if not p or a.chaseSerial~=a.pursuitStarted then a.chasePoint=want;a.chaseSerial=a.pursuitStarted;return want end
	local delta=want-p
	local step=Config.Chase.Steer*dt
	if delta.Magnitude&gt;step then p+=delta.Unit*step else p=want end
	a.chasePoint=p
	return p
end
function Combat:chase(a)
	if a.chakra&lt;Config.PursuitCost then return false,"Need chakra" end
	if (a.target.root.Position-a.root.Position).Magnitude&gt;Config.PursuitRange then return false,"Too far" end
	local launchCancel=a.hitConfirmed and (a.state=="Active" or a.state=="Recovery")
		and a.pending~=nil and a.pending.kind=="Brawl"
	if a.state~="Neutral" and a.state~="Recovery" and a.state~="TechniqueRecovery" and not launchCancel then return false,"Committed" end
	if launchCancel then Bangla.close(a.pending);a.pending=nil;a.hitstopUntil=0 end
	local style=Brawler.reentry(a)
	a.chakra-=Config.PursuitCost; a.pursuitUntil=0
	a.reaction=nil; a.airborne=true
	a.pursuitStarted=self.now
	-- A body still rising fast (a chase pressed on the launch itself) is
	-- followed up to where an air strike can catch it, not dropped at 0.24 s.
	local b=a.target
	local rising=if b.reaction and b.reactionVelocity then math.max(0,b.reactionVelocity.Y) else 0
	local duration=(style.chase or .3)+math.clamp((rising-30)/75,0,.3)
	a.pursuitDuration=duration
	-- The side of the body the chase arrives on: the attacker's own.
	local line=Vector3.new(b.root.Position.X-a.root.Position.X,0,b.root.Position.Z-a.root.Position.Z)
	a.pursuitLine=if line.Magnitude&gt;.2 then line.Unit else Vector3.new(a.root.CFrame.LookVector.X,0,a.root.CFrame.LookVector.Z).Unit
	a.airHold=self.now+duration+.45
	Brawler.breakString(a,false)
	Brawler.event(self,a,"Chase");Brawler.event(self,a,"Reengage")
	self:setState(a,"Pursuit",duration)
	self:effect("Pursuit",a.root.Position,a.color,Vector3.new(2,4,2),0.35)
	self:pushImpact(a.root.Position,"chase",false,{owner=a.id,fighter=a.fighterId,variant=style.name,mode="chase"})
	return true
end
-- Chakra dash. A committed burst at a locked opponent from neutral (or out of
-- a recovery's cancel point), a straight reposition when unlocked. It is not
-- armoured: a blade, a guard or a read answers it. The arrival (Brawler.arrive)
-- converts at once into the dash attack, the quick heavy or a grab, but guards
-- only after Config.Rush.CancelAfter: a predictable dash is punished.
function Combat:rush(a)
	local tune=Config.Rush
	local style=Brawler.reentry(a)
	-- A re-entry at range instead of into melee (Temari's wind step, Gale.reposition).
	if style.reposition and Techniques.reposition then return Techniques.reposition(self,a,style) end
	local cancel=a.state=="Recovery" and self.now&gt;=(a.recoveryCancelAt or math.huge)
	if not Rules.canAct(a,self.now) and not cancel then return false,"Committed" end
	if a.airborne or a.wall or a.reaction then return false,"No chakra dash" end
	-- Skill build (Counter-Rush): right after a substitution the dash is free.
	local free=(a.freeRushUntil or 0)&gt;self.now
	if a.chakra&lt;Config.PursuitCost and not free then return false,"Need chakra" end
	if self.now&lt;(a.rushReadyAt or 0) then return false,"Cooldown" end
	local gap=(a.target.root.Position-a.root.Position).Magnitude
	local line=nil
	if a.locked==false or Families.shrouded(self,a) then
		-- Unlocked (or lost in a shroud): no homing, a straight burst along the stick (or the facing).
		local stick=Vector3.new(a.move.X,0,a.move.Z)
		local look=a.root.CFrame.LookVector
		line=if stick.Magnitude&gt;.2 then stick.Unit else Vector3.new(look.X,0,look.Z).Unit
	else
		if gap&lt;(style.minRange or tune.MinRange) then return false,"Too close" end
		if gap&gt;tune.Range then return false,"Too far" end
	end
	if cancel then Bangla.close(a.pending) end
	if free then a.freeRushUntil=nil;self:cue(a,"COUNTER-RUSH",.5) else a.chakra-=Config.PursuitCost end
	a.rushReadyAt=self.now+tune.Cooldown
	a.pending=nil;a.attackName=nil;a.guardHeld=false;a.chainOpen=false
	-- A re-entry opens a fresh string on arrival.
	Brawler.breakString(a,false)
	local departure=a.root.Position
	local plan=Brawler.rushPlan(self,a,style,line)
	local travel=if line then tune.Reposition else gap
	local duration=math.clamp(travel/plan.speed+.12,.12,tune.MaxTime*(style.time or 1))
	self:setState(a,"Rush",duration)
	a.rush=plan
	a.rushArriveUntil=self.now+duration+tune.Arrive
	Brawler.event(self,a,"Rush");Brawler.event(self,a,"Reengage")
	-- Itachi: the approach starts from an afterimage left where he stood.
	if style.afterimage then self:pushImpact(departure,"afterimage",false,{owner=a.id,fighter=a.fighterId,variant="reengage"}) end
	self:pushImpact(departure,"chase",false,{owner=a.id,fighter=a.fighterId,variant=style.name,mode="dash",to=plan.goal,sealed=plan.sealed})
	return true
end
-- Awakening: once per match, below a third of health. A shockwave buys space,
-- chakra comes back, and each prodigy's own strength is pushed for a while.
function Combat:awaken(a)
	local tune=a.def.Awakening
	if not tune or a.awakened then return false,"No awakening" end
	if a.health&gt;a.def.Health*Config.Awaken.Threshold then return false,"Not yet" end
	if not Brawler.free(a,self.now) then return false,"Reacting" end
	a.awakened=true;a.awakenUntil=self.now+Config.Awaken.Duration;a.awakenedAt=self.now;a.curseLanded=self.now;a.curseFedUntil=0
	a.chakra=math.min(a.def.Chakra or Config.Chakra,a.chakra+40)
	a.cooldowns={}
	a.invulnerableUntil=math.max(a.invulnerableUntil,self.now+.45)
	a.pending=nil;a.guardHeld=false;self:setState(a,"Recovery",.3)
	local b=a.target
	if b and b.health&gt;0 then
		local away=b.root.Position-a.root.Position;away=Vector3.new(away.X,0,away.Z)
		if away.Magnitude&lt;9 and away.Magnitude&gt;.05 then Brawler.react(self,b,"Knockback",away.Unit*34+Vector3.new(0,12,0),.45,a) end
	end
	-- The shockwave also blows away the enemy bodies close by (shadow clones).
	Bodies.area(self,a,a.root.Position,9)
	a.hitstopUntil=self.now+.12
	self:pushImpact(a.root.Position,"awaken",true,{owner=a.id,fighter=a.fighterId})
	self:cue(a,"AWAKENING • "..tune.Name,1.4)
	if b then self:cue(b,"OPPONENT AWAKENED",1) end
	Brawler.event(self,a,"Awaken")
	-- What an awakening sets off on entry (Techniques.awakenHooks: Kamatari).
	for _,hook in Techniques.awakenHooks or {} do hook(self,a) end
	return true
end
-- Awakened techniques recover faster (and Itachi's cost less).
function Combat:awakenTechnique(a,spec)
	if (a.awakenUntil or 0)&lt;=self.now then return end
	local tune=a.def.Awakening
	a.cooldowns[spec.Id]=self.now+spec.Cooldown*(tune.Cooldown or 1)
	if tune.CostScale then a.chakra=math.min(a.def.Chakra or Config.Chakra,a.chakra+spec.Cost*(1-tune.CostScale)) end
end
function Combat:wallTech(a)
	local tune=Config.Wall
	local elapsed=self.now-(a.splatAt or -10)
	if elapsed&lt;tune.TechFrom or elapsed&gt;tune.TechUntil or (a.hitstopUntil or 0)&gt;self.now then
		a.techLockUntil=self.now+.25
		return false,"Tech missed"
	end
	if (a.techLockUntil or 0)&gt;self.now then return false,"Tech missed" end
	if a.chakra&lt;tune.TechCost then return false,"Need chakra" end
	local normal=a.splatNormal or -a.root.CFrame.LookVector
	normal=Vector3.new(normal.X,0,normal.Z)
	normal=if normal.Magnitude&gt;.05 then normal.Unit else -a.root.CFrame.LookVector
	a.chakra-=tune.TechCost
	a.reaction=nil;a.reactionVelocity=nil;a.groundPose=nil;a.comboHits=0;a.comboDamage=0
	-- Kick off along the stick (sideways along the wall or straight out).
	local stick=Vector3.new(a.move.X,0,a.move.Z)
	local along=stick-normal*stick:Dot(normal)
	local out=normal*30+(if along.Magnitude&gt;.3 then along.Unit*18 else Vector3.zero)
	a.root.AssemblyLinearVelocity=out+Vector3.new(0,36,0)
	a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+normal)
	a.airborne=true;a.airDodgeUsed=false;a.takeoffUntil=self.now+.12;a.wallNext=self.now+.35
	a.invulnerableUntil=self.now+.28
	self:setState(a,"Recovery",.16)
	Brawler.event(self,a,"WallTech")
	self:pushImpact(a.root.Position-normal*1.2,"walltech",false,{owner=a.id,fighter=a.fighterId,normal=normal})
	self:cue(a,"WALL TECH")
	if a.target then self:cue(a.target,"WALL TECH • RESET",.7) end
	return true
end
-- Global kunai (DEC-030): any fighter may draw a kunai and fight with it.
-- Drawn, his lights and heavy cut with the blade (Brawler.start: a little more
-- reach and damage, slash contacts, the shared Kunai.* clips on the client);
-- the tool button throws that blade, which is then gone until drawn again.
-- Reference: Naruto Shippuden fights where every ninja draws a kunai to parry
-- and slash (Sasuke vs Itachi, Kakashi vs Obito), and Shinobi Striker / Storm
-- where the kunai is a common stance, not a character's move.
function Combat:arm(a)
	if a.airborne or not Rules.canAct(a,self.now) then return false,"Busy" end
	if self.now&lt;(a.armAt or 0) then return false,"Too soon" end
	a.armed=not a.armed;a.armAt=self.now+.25
	Brawler.event(self,a,if a.armed then "Draw" else "Sheathe")
	self:cue(a,if a.armed then "KUNAI DRAWN" else "KUNAI SHEATHED",.45)
	return true
end
function Combat:throwDrawn(a,aim)
	-- The drawn blade may end a string that is alive (a thrown finisher).
	local cancel=a.state=="Recovery" and a.chainOpen and self.now&gt;=(a.chainAt or 0)
	if (not cancel and not Rules.canAct(a,self.now)) or self.now&lt;a.neutralToolAt then return false,"Tool recovering" end
	if a.throwing then return false,"Throwing" end
	if cancel then a.pending=nil;a.attackName=nil;a.chainOpen=false;self:setState(a,"Neutral",0);Brawler.event(self,a,"ChainTool") end
	if a.state=="Guarding" then Defense.guard(a,false,self.now);self:setState(a,"Neutral",0) end
	if a.wall then Motor.detach(a,self.now,false) end
	a.armed=false;a.armAt=self.now+.3
	a.neutralToolAt=self.now+(if cancel then .42 else .6)
	self:beginThrow(a,{kind="Kunai",release=.08,count=1,interval=.08,aim=aim,fire=function(_,target)
		self:projectile(a,target,100,if cancel then 24 else 62,5,"kunai")
	end})
	self:cue(a,if cancel then "KUNAI • FINISHER" else "KUNAI THROWN",.5)
	return true
end
function Combat:request(a,action,aim,clientTime,opts)
	if self.match.phase~="Duel" or a.health&lt;=0 then return false,"No duel" end
	if self.match.introUntil and self.now&lt;self.match.introUntil then return false,"Intro" end
	if self.match.finishing then return false,"Intro" end
	-- The press carries its own stick (Matches:act): remember it as intent.
	Brawler.observe(self,a)
	-- A bot lost in a shroud aims where it last saw the body (set by AI).
	if a.fogAim and aim and (action=="Tool" or string.sub(action,1,9)=="Technique") then aim=a.fogAim end
	if action=="GuardOff" then
		Defense.guard(a,false,self.now)
		if a.state=="Guarding" then self:setState(a,"Neutral",0) end
		return true
	end
	-- The jump key held (Jump ... JumpOff): Temari's glide reads it.
	if action=="Jump" then a.jumpHeld=true end
	if action=="JumpOff" then
		a.jumpHeld=false
		if a.airborne and a.root.AssemblyLinearVelocity.Y&gt;22 and self.now&lt;(a.takeoffUntil or 0)+0.18 then
			local v=a.root.AssemblyLinearVelocity
			a.root.AssemblyLinearVelocity=Vector3.new(v.X,v.Y*0.66,v.Z)
		end
		return true
	end
	if action=="WallDetach" then Motor.detach(a,self.now,false); return true end
	-- Pinned against a wall, the dodge button is a timed wall tech, never a
	-- substitution: a mistimed tech must not silently spend a charge.
	if action=="Dodge" and a.reaction=="WallSplat" then return self:wallTech(a) end
	-- Ninja Embodiment (EMB-003): past its share of an ordinary blow the body
	-- answers it (Brawler.recoverable): guard or step out standing, right
	-- itself in the air, roll out of a knockdown. Earlier, the dodge is still
	-- the substitution.
	if (action=="Guard" or action=="Dodge") and a.reaction then
		local kind=Brawler.recoverable(self,a)
		if kind then
			local ok,why=Brawler.recover(self,a,kind,action)
			if not ok or kind~="stand" then return ok,why end
		end
	end
	if action=="Dodge" and not Brawler.free(a,self.now) then action="Substitute" end
	if action=="Substitute" then return self:substitute(a) end
	if action=="Awaken" then return self:awaken(a) end
	if action=="Arm" then return self:arm(a) end
	if action=="Feint" then
		local pending=a.pending
		if a.state=="Startup" and pending and pending.kind=="Brawl" and pending.name=="Heavy" and self.now-a.attackStarted&lt;=pending.spec.startup*.62 then
			Bangla.close(pending);a.pending=nil;a.attackName=nil;a.travelRemaining=0;a.chakra=math.max(0,a.chakra-4)
			self:setState(a,"Recovery",.09);self:cue(a,"HEAVY FEINT • MOVE");Brawler.event(self,a,"Feint")
			return true
		end
		if a.state~="TechniqueChannel" or not pending or not pending.spec.Feintable then return false,"No feint window" end
		if self.now&gt;a.untilTime-pending.spec.Channel*0.5 then return false,"Feint too late" end
		a.chakra=math.min(a.def.Chakra or Config.Chakra,a.chakra+pending.spec.Cost*0.35)
		a.pending=nil; self:setState(a,"Recovery",0.24); self:cue(a,"FEINT • CHAKRA PARTIAL")
		return true
	end
	-- The throwing arm owns the body until the blade leaves the hand; after the
	-- release the follow-up is free, which is what lets a kunai lead a rush.
	local throwHeld=a.throwing and self.now&lt;a.throwing.release
	if throwHeld and (action=="Attack" or action=="Heavy" or action=="Grab" or action=="Tool" or string.match(action,"^Technique")) then
		return false,"Committed"
	end
	-- (The light step is no longer resolved here: Brawler.request reads it from
	-- the confirmed hits when the press actually starts a strike.)
	if action=="Attack" or action=="Heavy" or action=="Grab" then a.attackCommitTime=clientTime or self.now end
	local handled,reason=Brawler.request(self,a,action)
	if handled~=nil then return handled,reason end
	if not Brawler.free(a,self.now) then return false,"Reacting" end
	-- Itachi's re-entry is a feint he can abort: guard or dodge stops the dash.
	if (action=="Guard" or action=="Dodge") and a.state=="Rush" and Brawler.reentry(a).feint then Brawler.feintRush(self,a) end
	if (action=="Guard" or action=="Dodge") and (a.state=="Recovery" or a.state=="TechniqueRecovery") and self.now&gt;=(a.recoveryCancelAt or math.huge) then
		a.pending=nil;self:setState(a,"Neutral",0)
	end
	-- Pad re-engage: sprint + dodge toward a locked opponent at mid range is the
	-- re-engage (chase in a window, chakra dash outside); anything else, or a
	-- re-engage that is not available (cooldown, chakra), stays a dodge.
	if action=="Dodge" and Brawler.dashIntent(self,a) then
		local ok,why=self:reengage(a)
		if ok then return ok,why end
	end
	if action=="Pursuit" then return self:reengage(a) end
	if action=="Jump" then
		if a.wall then Motor.detach(a,self.now,true); return true end
		if a.state~="Neutral" and a.state~="Recovery" then return false,"Committed" end
		-- Like a guard or a dodge, a jump leaves a recovery only at its cancel
		-- point: a whiff (or an unanswered dash) cannot hop out of its punish.
		if a.state=="Recovery" and self.now&lt;(a.recoveryCancelAt or 0) then return false,"Committed" end
		return Motor.jump(a,self,self.now),"Airborne"
	end
	if action=="Tool" and a.armed and not (opts~=nil and opts.chakra==true) then return self:throwDrawn(a,aim) end
	if action=="Tool" then
		-- No blade to throw (Rock Lee): the tool button is his deflecting kick, and
		-- his chakra profile (ChakraTuning Taijutsu) infuses nothing: the chakra
		-- modifier is refused with the usual fizzle, before any cost.
		if a.def.Tool=="Deflect" then
			if opts~=nil and opts.chakra==true then Chakra.refuse(self,a);return false,"No chakra tool" end
			return Techniques.deflectKick(self,a)
		end
		-- A tool that is not thrown, registered by its fighter's module
		-- (Techniques.Tools: Temari's fan gust); it owns its chakra rule too.
		local custom=Techniques.Tools and Techniques.Tools[a.def.Tool]
		if custom then return custom(self,a,opts~=nil and opts.chakra==true,aim) end
		if a.def.ArrivalThrow then
			local thrown,refusal=self:arrivalThrow(a)
			if thrown~=nil then return thrown,refusal end
		end
		local graph=Brawler.graph(a) or {}
		local chainCancel=a.def.ComboToolCancel and a.state=="Recovery" and (a.chainOpen or (a.hitBlocked and graph.blockCancels and graph.blockCancels.Tool)) and self.now&gt;=(a.chainAt or 0)
		-- Chakra modifier held (keyboard Z + R, pad R1 + R2). With the wire still on
		-- a bound body, the current may leave the jutsu recovery, like Dragon Flame.
		local chakra=opts~=nil and opts.chakra==true
		local wired=chakra and a.state=="TechniqueRecovery" and a.wireVictim~=nil and a.wireVictim.reaction=="Bound" and a.wireVictim.boundBy==a
		if (not chainCancel and not wired and not Rules.canAct(a,self.now)) or self.now&lt;a.neutralToolAt then return false,"Tool recovering" end
		if a.throwing then return false,"Throwing" end
		-- The fighter's mastery decides what the chakra does to this tool (server
		-- side only); a reserve that cannot pay refuses with a visible fizzle.
		local mastery=a.def.ToolMastery or {Kind="kunai",Count=1,Speed=90,Damage=3,Recover=.75}
		local infused=nil
		-- A tool that turns into a body (ToolMastery.Transform: Naruto's kunai
		-- into a shadow clone, Bodies.transform): the chakra chord pays for the
		-- body instead of an infusion, while one can still be made.
		local transform=if chakra and not wired then Bodies.transformCost(self,a,mastery) else nil
		if chakra and not transform then
			local why
			infused,why=Chakra.plan(self,a,if a.def.Tool=="Sand" then "Sand" elseif mastery.Kind=="kunai" then "Kunai" else "Shuriken")
			if not infused then Chakra.refuse(self,a);return false,why end
			if wired and infused.mode~="conduct" then return false,"Tool recovering" end
			if a.chakra&lt;Chakra.cost(infused,chainCancel) then Chakra.refuse(self,a);return false,"Need chakra" end
		end
		if transform and a.chakra&lt;transform+(if chainCancel then 0 else Config.ToolCost) then Chakra.refuse(self,a);return false,"Need chakra" end
		-- A neutral throw costs a little chakra so blades pressure, not spam;
		-- the throw that cancels a confirmed string stays free.
		if not infused and not transform and not chainCancel and a.chakra&lt;Config.ToolCost then return false,"Need chakra" end
		if transform then a.chakra-=transform end
		if infused then a.chakra-=Chakra.cost(infused,chainCancel) elseif not chainCancel then a.chakra-=Config.ToolCost end
		if wired then a.pending=nil;self:setState(a,"Neutral",0) end
		-- Stick away + tool inside a string: hop out of it behind the throw.
		local disengage=graph.disengage
		if chainCancel and a.chainOpen and disengage and Brawler.intent(a)=="back" and not infused and not transform then
			a.neutralToolAt=self.now+.5
			return Brawler.disengage(self,a,disengage)
		end
		if chainCancel then a.pending=nil;a.attackName=nil;a.chainOpen=false;self:setState(a,"Neutral",0);Brawler.event(self,a,"ChainTool") end
		-- Throwing lowers the guard: a blade never leaves a fully blocking body.
		if a.state=="Guarding" then Defense.guard(a,false,self.now);self:setState(a,"Neutral",0) end
		if a.wall then Motor.detach(a,self.now,false) end
		-- Chakra without a throw: down the wire (Sasuke) or through the palm (Neji).
		if infused and infused.mode=="conduct" then
			a.neutralToolAt=self.now+.35
			return Chakra.conduct(self,a,infused)
		end
		if infused and infused.mode=="body" then
			a.neutralToolAt=self.now+mastery.Recover
			return Chakra.palm(self,a,infused)
		end
		if a.def.Tool=="Sand" then
			a.neutralToolAt=self.now+(if chainCancel then .42 else .6)
			self:beginThrow(a,{kind="Sand",release=.12,count=1,aim=aim,fire=function(_,target)
				self:projectile(a,target,90,if chainCancel then 20 else 56,3,"sand",nil,{origin=self.launchPoint(a,"Palm"),radius=.6,chakra=infused})
			end})
			self:cue(a,if infused then Chakra.label(infused) else "SAND BULLET",.5)
			return true
		end
		local blade=mastery.Kind=="kunai"
		a.neutralToolAt=self.now+(if chainCancel then .42 else mastery.Recover)
		local range=if chainCancel then 20 else 62
		-- Shuriken Geometry (mastery): side + tool throws one blade wide and a
		-- second that strikes it beside the opponent; both fly into the flank.
		local dir,sideSign=Brawler.intent(a)
		if mastery.Geometry and dir=="side" and not chainCancel and a.target and a.target.health&gt;0 then
			return self:shurikenGeometry(a,sideSign,infused)
		end
		-- In the air a master fans several blades down at the opponent.
		local count=if a.airborne and mastery.AirSpread then mastery.AirSpread else mastery.Count
		self:beginThrow(a,{kind=if blade then "Kunai" else "Shuriken",release=if blade then .1 else .13,
			count=count,interval=if count&gt;2 then .05 else .08,aim=aim,
			fire=function(index,target)
				local spread=Vector3.zero
				if count&gt;1 then spread=a.root.CFrame.RightVector*((index-(count+1)/2)*(if count&gt;2 then 1.6 else 1.8)) end
				-- A mastery may throw its own object (ToolMastery.Projectile: a Looks
				-- kind such as Haku's senbon) with family contact riders (Contact).
				local p=self:projectile(a,target+spread,mastery.Speed,range,mastery.Damage,mastery.Projectile or (if blade then "kunai" else "shuriken"),nil,{chakra=infused,transform=if transform then mastery.Transform else nil})
				if p and mastery.Contact and not infused then p.family=mastery.Contact end
			end})
		self:cue(a,if infused then Chakra.label(infused) elseif transform then "KUNAI • TRANSFORMATION" elseif chainCancel then "CHAIN TOOL • KEEP PRESSURE" else (if blade then "KUNAI" else "SHURIKEN"))
		return true
	end
	-- Melee -&gt; technique: Minato may spend a confirmed string on Rasengan with
	-- a shortened wind-up. It is a read/finisher, not a neutral button.
	a.stringCancel=nil
	local cancelSlot=tonumber(string.match(action,"^Technique([1-5])$"))
	local cancelSpec=cancelSlot and a.def.Techniques[cancelSlot]
	-- Skill build (Blood for Chakra): the Curse Mark pays what the reserve lacks
	-- before the usual checks, for a cancel or a neutral cast alike.
	if cancelSpec and a.def.Awakening and a.def.Awakening.BloodChakra and ((a.state=="Recovery" and a.chainOpen) or Rules.canAct(a,self.now))
		and Techniques[cancelSpec.Id].check(self,a,cancelSpec,self.now) then self:curseBlood(a,cancelSpec) end
	local cancelGraph=Brawler.graph(a) or {}
	-- The technique's own condition is checked before the string is spent (a
	-- teleport cancel needs a seal); the original cancels have none.
	if cancelSpec and cancelGraph.stringCancels and cancelGraph.stringCancels[cancelSpec.Id] and a.state=="Recovery" and a.chainOpen and self.now&gt;=(a.chainAt or 0)
		and (a.cooldowns[cancelSpec.Id] or 0)&lt;=self.now and a.chakra&gt;=cancelSpec.Cost and Techniques[cancelSpec.Id].check(self,a,cancelSpec,self.now) then
		Bangla.close(a.pending);a.pending=nil;a.attackName=nil;a.chainOpen=false;a.state="Neutral";a.untilTime=self.now
		a.stringCancel=cancelSpec.Id
	end
	-- Flying Thunder God arrival: the Rasengan is already forming in the hand,
	-- so it cancels the teleport recovery with almost no wind-up.
	a.flashCancel=nil
	local arriving=(a.flashUntil or 0)&gt;self.now and (a.state=="TechniqueRecovery" or a.state=="TechniqueActive")
		and (a.pending==nil or a.pending.spec.Id=="Flashstep")
	if cancelSpec and cancelSpec.Id=="BurstStrike" and arriving
		and (a.cooldowns[cancelSpec.Id] or 0)&lt;=self.now and a.chakra&gt;=cancelSpec.Cost then
		a.flashUntil=0;a.state="Neutral";a.untilTime=self.now;a.pending=nil
		a.flashCancel=true
	end
	-- Dragon Flame: with the wire still holding the body, the fire runs along
	-- it at once (the wire throw's recovery is cancelled, the signs are short).
	a.wireCancel=nil
	local wired=a.wireVictim and a.wireVictim.reaction=="Bound" and a.wireVictim.boundBy==a
	if cancelSpec and cancelSpec.Id=="FireBloom" and wired and (a.state=="TechniqueRecovery" or a.state=="Neutral" or a.state=="Recovery")
		and (a.cooldowns[cancelSpec.Id] or 0)&lt;=self.now and a.chakra&gt;=cancelSpec.Cost then
		a.state="Neutral";a.untilTime=self.now;a.pending=nil
		a.wireCancel=true
	end
	local chain=action=="Attack" and a.state=="Recovery" and a.chainOpen and self.now&gt;a.chainAt
	if not chain and not Rules.canAct(a,self.now) then return false,"Committed" end
	if action=="Guard" then Brawler.event(self,a,"Guard");Defense.guard(a,true,self.now);self:setState(a,"Guarding",0);return true end
	if action=="Dodge" and a.def.SandFlicker and not a.airborne then
		-- Gaara's dodge: a sand body-flicker, an instant reposition.
		if a.chakra&lt;Config.DodgeCost then return false,"Need chakra" end
		if a.dodgeUntil&gt;self.now then return false,"Cooldown" end
		a.chakra-=Config.DodgeCost;a.dodgeUntil=self.now+Config.DodgeCooldown
		local direction=if a.move.Magnitude&gt;.1 then a.move.Unit else -a.root.CFrame.LookVector
		local from=a.root.Position
		Motor.travel(a,self,direction,a.def.SandFlicker.Distance)
		a.warpSerial=(a.warpSerial or 0)+1
		a.invulnerableUntil=self.now+.24;Defense.guard(a,false,self.now);Defense.dodge(a,self.now)
		self:setState(a,"Recovery",.14)
		self:pushImpact(from,"sandflicker",false,{owner=a.id,fighter=a.fighterId,to=a.root.Position})
		Brawler.event(self,a,"Dodge")
		return true
	end
	if action=="Dodge" then
		if a.chakra&lt;Config.DodgeCost then return false,"Need chakra" end
		if a.airborne and a.airDodgeUsed then return false,"Air dodge used" end
		if a.dodgeUntil&gt;self.now then return false,"Cooldown" end
		a.chakra-=Config.DodgeCost; a.dodgeUntil=self.now+Config.DodgeCooldown
		if a.wall then Motor.detach(a,self.now,false) end
		if a.airborne then a.airDodgeUsed=true end
		a.dodgeDirection=if a.move.Magnitude&gt;0.1 then a.move.Unit else a.root.CFrame.RightVector
		a.invulnerableUntil=self.now+Config.DodgeIFrames;Defense.guard(a,false,self.now);Defense.dodge(a,self.now)
		Evade.begin(a,self)
		self:pushImpact(a.root.Position,"dodge",false)
		Brawler.event(self,a,"Dodge"); self:setState(a,"Dodging",Config.DodgeTime); self:effect("Dodge",a.root.Position,a.color,Vector3.new(2,4,1),0.2)
		return true
	end
	if self.match.techniquesDisabled then return false,"Techniques disabled" end
	if string.match(action,"^Technique") and (a.sealedUntil or 0)&gt;self.now then return false,"Chakra points sealed" end
	local slot=tonumber(string.match(action,"^Technique([1-5])$"))
	local spec=slot and a.def.Techniques[slot]
 if spec and (a.trainingChannelScale or 1)~=1 then
  -- Tutorial (interrupt step): the signs last long enough to be read and hit,
  -- whoever the bot is (Rock Lee's only jutsu channels 0.08 s).
  spec=table.clone(spec);spec.Channel=math.max(spec.Channel*a.trainingChannelScale,Combat.TRAINING_CHANNEL)
 end
	if not spec then return false,"Unknown action" end
	local technique=Techniques[spec.Id]
	-- A string cancel shortens the wind-up to .14 s; a technique that is already
	-- quicker (a teleport, the Read, Rotation) keeps its own.
	if a.stringCancel==spec.Id then spec=table.clone(spec);spec.Channel=math.min(spec.Channel,.14) end
	a.stringCancel=nil
	if a.wireCancel and spec.Id=="FireBloom" then spec=table.clone(spec);spec.Channel=.16 end
	a.wireCancel=nil
	-- Context: the same Rasengan is a different tool after a teleport (instant
	-- thrust) and in the air (a plunge that ends the air phase).
	local variant=nil
	if spec.Id=="BurstStrike" then
		if a.flashCancel then spec=table.clone(spec);spec.Channel=.05;variant="FlashRasengan"
		elseif a.airborne then spec=table.clone(spec);spec.Channel=math.min(spec.Channel,.12);variant="RasenganDrop" end
	end
	-- Skill build (Wall Chidori): charged from a wall run, he hangs on the wall
	-- for a shorter charge, then the thrust dives at the opponent.
	if spec.Id=="Chidori" and spec.WallCharge and a.wall then spec=table.clone(spec);spec.Channel=math.min(spec.Channel,spec.WallCharge);variant="WallChidori" end
	a.flashCancel=nil
	local ready,why=technique.check(self,a,spec,self.now)
	local ok,reason=Rules.technique(a,spec,self.now,ready,why)
	if not ok then return false,reason end
	if a.wall then Motor.detach(a,self.now,false) end
	if spec.Mobile then
		-- A thrown technique (Minato's marked kunai): chakra and cooldown are
		-- committed now, but the body stays in Neutral so the legs keep moving
		-- while the arm throws; the payoff fires on the release frame.
		Brawler.event(self,a,"Technique"); Brawler.event(self,a,"Cast:"..spec.Id); a.chakra-=spec.Cost; a.cooldowns[spec.Id]=self.now+spec.Cooldown; a.guardHeld=false
		-- Same for a thrown technique: no guard pose (and guard speed) without a guard.
		if a.state=="Guarding" then self:setState(a,"Neutral",0) end
		self:awakenTechnique(a,spec)
		a.castId=spec.Id;a.castStarted=self.now
		local pending={kind="Technique",spec=spec,implementation=technique,aim=aim}
		self:beginThrow(a,{kind=spec.Throw or "MarkedKunai",release=spec.Channel,count=1,aim=aim,fire=function(_,target)
			pending.aim=target
			technique.execute(self,a,pending,self.now)
			Brawler.event(self,a,"TechniqueResolved")
		end})
		self:cue(a,spec.Name,.6)
		return true
	end
	Brawler.event(self,a,"Technique"); Brawler.event(self,a,"Cast:"..spec.Id); Rules.reserve(a,spec,self.now); a.guardHeld=false
	self:awakenTechnique(a,spec)
	a.pending={kind="Technique",spec=spec,implementation=technique,aim=aim or a.target.root.Position,variant=variant}
	-- A technique may set itself up as its channel begins (Naruto's Rasengan
	-- calls the clone that shapes it, and its channel follows).
	if technique.start then technique.start(self,a,a.pending);spec=a.pending.spec end
	a.castId=spec.Id;a.castStarted=self.now
	local offset=a.pending.aim-a.root.Position
	local flat=Vector3.new(offset.X,0,offset.Z)
	a.castFace=nil
	if flat.Magnitude&gt;0.1 then
		-- A small correction snaps (unseen); a large one turns through the
		-- channel instead of teleporting the facing on the first frame.
		local look=Vector3.new(a.root.CFrame.LookVector.X,0,a.root.CFrame.LookVector.Z)
		if look.Magnitude&lt;.01 or look.Unit:Dot(flat.Unit)&gt;=.82 then a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+flat)
		else a.castFace=flat.Unit end
	end
	self:cue(a,spec.Name.." • PREPARING",spec.Channel)
	if variant=="WallChidori" then
		-- Held off the wall for the whole charge (the hover window zeroes the fall).
		a.airborne=true;a.airHold=self.now+spec.Channel+.05
		self:cue(a,"CHIDORI • FROM THE WALL",spec.Channel)
	end
	self:effect("Channel",a.root.Position-Vector3.new(0,2.8,0),a.color,Vector3.new(4,0.12,4),spec.Channel)
	self:pushImpact(a.root.Position,"cast",false,{owner=a.id,fighter=a.fighterId,technique=spec.Id,channel=spec.Channel})
	return true
end
-- (Reference quality) A held technique (spec.Hold = {Time, Cost}): while its
-- key stays down past the channel it keeps gathering, up to Hold.Time more
-- seconds; pending.charge (0..1) is what it gathered. Released, out of time
-- or out of chakra, it goes. The body stays in the channel the whole time
-- (a blow taken interrupts it like any channel).
function Combat.charging(c,a,pending,now)
	local hold=pending.spec.Hold
	local key=a.techHold
	if not hold or not key or not key.down then return false end
	local slotSpec=a.def.Techniques and a.def.Techniques[key.slot]
	if not slotSpec or slotSpec.Id~=pending.spec.Id then return false end
	pending.chargeStart=pending.chargeStart or now
	local held=now-pending.chargeStart
	local cost=(hold.Cost or 0)/(hold.Time or 1)*(1/30)
	if held&gt;=(hold.Time or 1) or a.chakra&lt;cost then pending.charge=math.min(1,held/(hold.Time or 1));return false end
	if not pending.charge then
		c:cue(a,string.upper(pending.spec.Name).." • HOLD TO GATHER",hold.Time)
		require(script.Parent.Brawler).event(c,a,"Hold:"..pending.spec.Id)
	end
	a.chakra-=cost
	pending.charge=held/(hold.Time or 1)
	a.techCharge=pending.charge
	return true
end
-- Where a melee swing goes: the locked target, or the enemy body it was
-- pushed at (Bodies.aim) while that body lives.
function Combat.swingAt(a)
	local body=a.pending and a.pending.aim
	return if body and body.alive then body.position else a.target.root.Position
end
function Combat:updateActor(a,dt)
	local now=self.now
	if a.health&lt;=0 then a.hum:Move(Vector3.zero); return end
	-- Movement intents last exactly one frame; each control block re-declares its own.
	a.aimIntent=nil
	-- Directional memory for routes: the latest strong push, every frame.
	Brawler.observe(self,a)
	Defense.step(self,a,dt,now)
	Techniques.expireSeals(self,a,now)
	-- A combo ends once the victim has been free to act for a moment.
	if a.reaction or a.state=="Stunned" then a.freeSince=nil elseif not a.freeSince then a.freeSince=now end
	if a.freeSince and now-a.freeSince&gt;=Config.ComboScaling.Reset and (a.comboHits&gt;0 or (a.wallSplats or 0)&gt;0) then a.comboHits=0;a.comboDamage=0;a.wallSplats=0;a.splatPins=0;a.wallBounced=false;a.groundBounced=false end
	-- Substitution charges come back one at a time.
	if a.subCharges&lt;Config.Substitution.Charges and now&gt;=a.subRegenAt then
		a.subCharges+=1
		a.subRegenAt=if a.subCharges&lt;Config.Substitution.Charges then now+Config.Substitution.Recharge else math.huge
		self:cue(a,"SUBSTITUTION READY",.6)
	end
	Techniques.stepIllusion(self,a,now)
	if a.state~="TechniqueChannel" and a.state~="Stunned" then
		local regen=a.def.ChakraRegen or Config.ChakraRegen
		-- Closed chakra points (Gentle Fist) slow the recovery.
		regen*=Brawler.tenketsuRegen(a,now)
		if (a.awakenUntil or 0)&gt;now then regen*=a.def.Awakening.Regen or 1 end
		regen*=Families.regenScale(a,now)
		a.chakra=math.min(a.def.Chakra or Config.Chakra,a.chakra+regen*dt)
	end
	if (a.rotationUntil or 0)&gt;now then self:stepRotation(a) end
	if a.def.SandShield and a.shieldCharges&lt;a.def.SandShield.Charges and now&gt;=(a.shieldRegenAt or 0) then
		a.shieldCharges+=1
		local rate=if (a.awakenUntil or 0)&gt;now then (a.def.Awakening.ShieldRegen or 1) else 1
		a.shieldRegenAt=now+a.def.SandShield.Regen/rate
	end
	-- (x the wind: walking into a lane is slower, with it faster, Zones.speedScale;
	-- x buffs and slows, Families.speedScale)
	a.speedScale=(if (a.awakenUntil or 0)&gt;now then (a.def.Awakening.Speed or 1) else 1)*Zones.speedScale(self,a)*Families.speedScale(a,now)
	-- Family traits that act every frame (an Absorb buff drinking blades).
	Families.step(self,a,now)
	-- The curse mark burns the body that carries it (never to a KO), faster
	-- while it goes hungry (Techniques.curseDrain).
	Techniques.curseDrain(self,a,dt,now)
	BodyState.step(self,a,dt)
	-- Per-fighter steps registered by a fighter's module (Temari's glide).
	for _,step in Techniques.actorSteps or {} do step(self,a,dt,now) end
	-- Rooted while spinning or striking the sixty-four palms.
	if (a.rotationUntil or 0)&gt;now or (a.flurryUntil or 0)&gt;now then a.move=Vector3.zero end
	if now&lt;(a.hitstopUntil or 0) then
		-- Weight, not a pause: the swing clock keeps running so the animation never
		-- drifts behind the hitbox, and only the frozen body is held still.
		a.hum:Move(Vector3.zero)
		if a.reaction then a.root.AssemblyLinearVelocity=Vector3.zero end
		World.pose(a,now,dt);return
	end
	if a.state~="Neutral" and a.state~="Guarding" and a.untilTime&lt;=now then
		local pending=a.pending
		if a.state=="Startup" and pending then
			-- The slam's active window is its sized descent; everything else uses
			-- the authored active duration.
			self:setState(a,"Active",if pending.slamWindow and pending.slamWindow&gt;0 then pending.slamWindow else pending.spec.active)
			a.activeAt=now
		elseif a.state=="Active" then
			Bangla.close(pending)
			-- The swing's own contact (Brawler.step), never a blade or a burn that
			-- landed while it was out.
			local brawl=pending~=nil and pending.kind=="Brawl"
			a.hitConfirmed=brawl and pending.contact==true
			-- A committed swing that never touched anything: report the whiff so
			-- the client can answer with air movement instead of silence.
			a.attackWhiffed=brawl and not a.hitConfirmed or nil
			if brawl and not a.hitConfirmed then
				self:pushImpact(a.root.Position+a.root.CFrame.LookVector*2.2,"whiff",false,{owner=a.id,fighter=a.fighterId,move=pending.name,variant=a.attackVariant})
				-- Genjutsu image / Sharingan Focus: a swing at the wrong place is read.
				Techniques.whiffRead(self,a,pending,now)
				-- A swing that met the world instead of a body marks it (EMB-004).
				WorldReaction.strike(self,a,pending)
			end
			local recovery=if pending then pending.spec.recovery else .22
			a.pending=nil; self:setState(a,"Recovery",recovery)
			-- Cancel philosophy: a string continues only on a clean hit. On block the
			-- attacker keeps a dodge cancel (and Itachi a shuriken cancel); a whiff
			-- keeps its full recovery.
			a.chainOpen=a.hitConfirmed and not a.hitBlocked and brawl and pending.spec.chain==true
			a.chainAt=now
			-- Combo model: a clean chain hit keeps its string for the chain window
			-- plus the grace; a whiff or a block ends it (the next press opens).
			if brawl then Brawler.settle(self,a,pending) end
			local whiffHeavy=brawl and pending.name=="Heavy" and not a.hitConfirmed
			a.recoveryCancelAt=if whiffHeavy then a.untilTime else now+recovery*(if a.hitConfirmed then .36 else .72)
		elseif a.state=="Rush" then
			-- The dash is over: its arrival (Brawler.arrive).
			Brawler.arrive(self,a)
		elseif a.state=="Pursuit" then
			-- The chase arrived: a short window in which a press is the arrival
			-- strike (air string up there, dash attack on the ground) or heavy.
			a.pending=nil;a.attackName=nil;self:setState(a,"Neutral",0)
			a.rushArriveUntil=now+Config.Rush.Arrive
			-- The chase stops where it arrives (Studio: its speed carried the
			-- body on into the one it reached).
			a.aimIntent=nil;Brawler.brake(a,Config.Rush.Carry or 8)
		elseif a.state=="TechniqueChannel" and pending and Combat.charging(self,a,pending,now) then
			-- (Reference quality) Held: the technique keeps gathering (spec.Hold).
			a.untilTime=now+1/30
		elseif a.state=="TechniqueChannel" and pending then
			a.techCharge=nil
			-- State changes before payoff so simultaneous channels resolve deterministically.
			self:setState(a,"TechniqueActive",pending.spec.Active)
			-- (Embodiment) A technique that is a state of the body forms it
			-- here; the next strike releases it (Server/BodyState).
			if pending.spec.State then BodyState.enter(self,a,pending.spec)
			else pending.implementation.execute(self,a,pending,now) end
			Brawler.event(self,a,"TechniqueResolved")
		elseif a.state=="TechniqueActive" and pending then
			a.pending=nil; self:setState(a,"TechniqueRecovery",pending.spec.Recovery)
			-- A utility jutsu (Flow) yields the second half of its recovery to a
			-- guard or a dodge: it flows back into movement instead of freezing.
			if pending.spec.Flow then a.recoveryCancelAt=now+pending.spec.Recovery*.5 end
		else
			a.pending=nil;a.attackName=nil; self:setState(a,"Neutral",0)
		end
	end
	if self.match.phase~="Duel" then a.hum:Move(Vector3.zero); return end
 -- A dodge that ends free hands its speed back (Evade.finish); one cut by a
 -- hit, an attack or a technique simply stops.
 if a.state~="Dodging" and a.evade then
  if a.state=="Neutral" and not a.reaction then Evade.finish(a) else a.evade=nil end
 end
	self:stepThrow(a)
	-- A guard key still held through a hit, a recovery or a throw comes back up
	-- as soon as the fighter is free. The automatic raise leaves guardPressedAt
	-- alone, so it never grants a fresh parry window.
	if a.guardWanted and a.state=="Neutral" and not a.guardHeld and not a.throwing and not a.reaction
		and not a.grabbedBy and not a.pending and Rules.canAct(a,now) then
		a.guardHeld=true;self:setState(a,"Guarding",0)
	end
	-- Movement overhaul (Studio): out of a running strike the body slides on
	-- through its recovery, the speed fading, instead of standing dead still;
	-- the recovery's commitment (no new action) is unchanged.
	-- Combat convergence (Studio): a blocked blow used to move the guard in one
	-- frame (a 0.4-1.15 stud pop); the guard now skids back over a few frames.
	if a.guardSlide then
		local g=a.guardSlide
		local step=math.min(g.remaining,g.speed*dt)
		if step&gt;0 and not a.reaction then g.remaining-=Motor.travel(a,self,g.dir,step) end
		g.speed=math.max(g.speed*math.exp(-dt*6),4)
		if g.remaining&lt;=.01 or a.reaction then a.guardSlide=nil end
	end
	-- (Studio, §20 route: the sweep's travel ran out early in its active window,
	-- 112 -&gt; 12 studs/s in one frame; the slide starts as soon as it is spent.)
	if a.strikeCarry and (a.state=="Recovery" or (a.state=="Active" and (a.travelRemaining or 0)&lt;=.05)) and not a.reaction and a.strikeCarry.dir then
		local carry=a.strikeCarry
		carry.slide=(carry.slide or carry.speed)*math.exp(-dt*3) -- (real keys: at 6 the slide was ~3 studs/s by the end of the recovery, a visible stop before the hand-back)
		-- Never into the opponent: the slide stops short of a body ahead.
		local ahead=a.target and a.target.root and (a.target.root.Position-a.root.Position)
		local blocked=ahead and Vector3.new(ahead.X,0,ahead.Z).Magnitude&lt;4.5 and ahead:Dot(carry.dir)&gt;0
		if not blocked then Motor.travel(a,self,carry.dir,carry.slide*dt) end
	end
	if a.hop then
		local step=math.min(a.hop.remaining,a.hop.speed*dt)
		a.hop.remaining-=step
		Motor.travel(a,self,a.hop.direction,step)
		if a.hop.remaining&lt;=.01 or a.reaction then a.hop=nil end
	end
	if a.castId and not a.pending and not a.throwing and a.state~="TechniqueRecovery" then a.castId=nil end
	-- A cast that started off-line turns into its aim through the channel.
	if a.castFace then
		if (a.state=="TechniqueChannel" or a.state=="TechniqueActive") and (a.rotationUntil or 0)&lt;=now then self:turnToward(a,a.castFace,dt,1440)
		elseif a.state~="TechniqueChannel" and a.state~="TechniqueActive" then a.castFace=nil end
	end
	if Brawler.step(self,a,dt) then World.pose(a,now,dt); return end
	if a.locked and (a.state=="Neutral" or a.state=="Guarding") then
		a.hum.AutoRotate=false
		self:faceLocked(a,dt)
	else a.hum.AutoRotate=not a.locked end
	if a.state=="Dodging" then
		Evade.step(a,self,Motor.travel)
	elseif a.state=="Pursuit" and (a.shadowUntil or 0)&gt;now then
		-- Shadow of the Dancing Leaf: glued just behind and below the rising
		-- body, closing the gap in proportion to it (no overshoot, no bobbing).
		local b=a.target
		local back=a.root.Position-b.root.Position;back=Vector3.new(back.X,0,back.Z)
		back=if back.Magnitude&gt;.1 then back.Unit else -b.root.CFrame.LookVector
		-- Where the rising body will be when the follow ends (not where it is).
		local ahead=math.max(0,(a.shadowUntil or now)-now)
		local rise=if b.reaction and b.reactionVelocity then b.reactionVelocity else Vector3.zero
		local fall=if b.reaction and b.airborne then 37.5*ahead*ahead else 0
		local point=Combat.steerChase(a,b.root.Position+rise*ahead-Vector3.new(0,fall,0)+back*2.1-Vector3.new(0,1.1,0),dt)
		local offset=point-a.root.Position
		a.airborne=true
		a.aimIntent={target=point,speed=math.clamp(offset.Magnitude*16,0,140),acceleration=3200}
		local flat=Vector3.new(-back.X,0,-back.Z)
		a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+flat)
	elseif a.state=="Pursuit" then
		-- Reach the victim in three dimensions, but kinetically: the chase keeps
		-- a continuous velocity instead of being teleported frame by frame. A
		-- body in a reaction flies on its reactionVelocity (its root velocity is
		-- held at zero), so that is what the chase leads. It arrives on its own
		-- side of the body, a step short and a little below, facing it, and ends
		-- as soon as the body is within reach and an air strike can follow it.
		local b=a.target
		local elapsed=now-(a.pursuitStarted or now)
		local remaining=math.max(.04,(a.pursuitDuration or .24)-elapsed)
		local velocity=if b.reaction and b.reactionVelocity then b.reactionVelocity else b.root.AssemblyLinearVelocity
		-- Lead to the end of the chase: it sets off for the intercept.
		local lead=remaining
		local fall=if b.reaction and b.airborne then 37.5*lead*lead else 0
		local predicted=b.root.Position+velocity*lead-Vector3.new(0,fall,0)
		local line=a.pursuitLine or Vector3.new(a.root.CFrame.LookVector.X,0,a.root.CFrame.LookVector.Z).Unit
		local point=Combat.steerChase(a,predicted-line*2.6-Vector3.new(0,.6,0),dt)
		local toward=point-a.root.Position
		local distance=(b.root.Position-a.root.Position).Magnitude
		local face=Vector3.new(b.root.Position.X-a.root.Position.X,0,b.root.Position.Z-a.root.Position.Z)
		-- (Combat convergence: bounded, a chase no longer snaps the body round.)
		if face.Magnitude&gt;.3 then self:turnToward(a,face,dt,Config.Chase.Turn) end
		if Brawler.chaseArrived(self,a) then
			a.untilTime=math.min(a.untilTime,now)
		elseif toward.Magnitude&gt;.2 then
			-- Reach the window in time, then ease in on approach so the chaser
			-- never overshoots its own target and snaps back.
			local speed=math.clamp(toward.Magnitude/math.max(remaining,.06),70,420)
			if distance&lt;7 then speed=math.min(speed,60+distance*distance*3) end
			a.aimIntent={target=point,speed=speed,acceleration=1600}
		end
	elseif a.state=="Rush" then
		-- Chakra dash toward its arrival point (Brawler.rushPlan): a step short of
		-- the body, an angle beside it, or a committed line through it.
		local r=a.rush
		if not r then a.untilTime=math.min(a.untilTime,now)
		else
			local b=a.target
			if not r.line and (not r.commitAt or now&lt;r.commitAt) then r.goal=Brawler.rushGoal(a,r) end
			local toTarget=Vector3.new(b.root.Position.X-a.root.Position.X,0,b.root.Position.Z-a.root.Position.Z)
			local toGoal=Vector3.new(r.goal.X-a.root.Position.X,0,r.goal.Z-a.root.Position.Z)
			local committed=r.line~=nil or (r.commitAt~=nil and now&gt;=r.commitAt)
			local face=if committed then toGoal elseif toTarget.Magnitude&gt;.1 then toTarget else toGoal
			-- (Combat convergence, Studio: 3000 deg/s snaps when the dash committed
			-- to its line; the body now swings onto it.)
			if face.Magnitude&gt;.1 then self:turnToward(a,face,dt,1440) end
			-- Combat convergence (Studio: two dashes meeting closed 5.8 -&gt; 1.4 studs
			-- in one frame and the bodies merged): the arrival reads the closing
			-- speed of both bodies, so it stops a frame early rather than inside.
			local closing=if toTarget.Magnitude&gt;.1 then math.max(0,(a.root.AssemblyLinearVelocity-b.root.AssemblyLinearVelocity):Dot(toTarget.Unit)) else 0
			if toGoal.Magnitude&lt;.6 or (not r.line and toTarget.Magnitude-closing*dt&lt;=r.arrive) then
				-- Stopped this frame, not on the next state change: the solver would
				-- carry the dash speed one more step.
				a.untilTime=math.min(a.untilTime,now)
				if not r.line then a.aimIntent=nil;Brawler.brake(a,Config.Rush.Carry or 8) end
			else a.aimIntent={target=a.root.Position+toGoal,speed=r.speed,acceleration=1100} end
		end
	elseif (a.state=="Startup" or a.state=="Active") and a.pending and a.pending.kind=="Brawl" and a.attackName=="WallDive" then
		-- Wall dive: a beat crouched against the wall (held by airHold), then a
		-- straight lunge at the opponent's body.
		local delta=a.target.root.Position-a.root.Position
		local flat=Vector3.new(delta.X,0,delta.Z)
		-- (Free fights: the dive snapped 125-165 degrees off the wall in one
		-- frame; the crouched beat now swings the body round.)
		if flat.Magnitude&gt;.1 then self:turnToward(a,flat,dt,2400) end
		if a.state=="Active" and delta.Magnitude&gt;2.8 then
			a.aimIntent={target=a.target.root.Position-delta.Unit*2.4,speed=92,acceleration=2600}
		end
	elseif a.state=="Startup" and a.vault and a.vault.serial==a.attackSerial and now&lt;a.vault.untilTime+.05 then
		-- (Continuity blocker) A vault over the body (the Lion Combo's flip):
		-- a short kinetic arc to its point, never a relocation.
		local to=a.vault.goal-a.root.Position
		local left=math.max(.03,a.vault.untilTime-now)
		a.aimIntent={target=a.vault.goal,speed=math.clamp(to.Magnitude/left,20,160),acceleration=4000}
	elseif a.state=="Active" and a.pending and a.pending.kind=="Brawl" and a.attackName=="Slam" then
  -- The slam owns a continuous plunge: a constant downward velocity with bounded
  -- acceleration, plus a gentle drift onto the victim. No per-frame correction.
  local delta=a.target.root.Position-a.root.Position
  local horizontal=Vector3.new(delta.X,0,delta.Z)
  if horizontal.Magnitude&gt;2.7 then
   -- Horizontal only: an aimed move toward a point at the same height braked
   -- the plunge (vertical velocity pulled toward 0) and moved it twice.
   Motor.travel(a,self,horizontal,math.min(horizontal.Magnitude-2.7,42*dt))
  end
  if a.airborne then
   local landed=Motor.descend(a,self,118,dt)
   if landed or a.root.Position.Y&lt;=self.match.origin.Y+3.6 then
    a.hum:ChangeState(Enum.HumanoidStateType.Landed)
    a.airborne=false;a.airHold=0
    a.root.AssemblyLinearVelocity=Vector3.zero
   end
  end
	elseif (a.state=="Startup" or a.state=="Active") and a.pending and a.pending.kind=="Brawl" and a.pending.spec.air and not a.pending.spec.orbit then
  local delta=a.target.root.Position-a.root.Position
  if delta.Magnitude&lt;10 and self:lineOfSight(a,a.target) then
		 local horizontal=Vector3.new(delta.X,0,delta.Z)
		 -- Arm's length, as on the ground (free fights: an air string held the
		 -- bodies 2.7 studs apart, inside a juggled body and its held blade).
		 local reach=a.pending.spec.contact or 3.6
		 local planar=if horizontal.Magnitude&gt;reach then horizontal.Unit*math.min(horizontal.Magnitude-reach,30*dt) else Vector3.zero
		 local vertical=math.clamp(delta.Y,-48*dt,48*dt)
		 if math.abs(delta.Y)&lt;.45 then vertical=0 end
		 local correction=planar+Vector3.new(0,vertical,0)
   Motor.flight(a,self,correction)
  end
 elseif (a.state=="Startup" or a.state=="Active") and a.pending and a.pending.kind=="Brawl" and a.travelRemaining&gt;0 then
		local toTarget=Combat.swingAt(a)-a.root.Position
		local flatTarget=Vector3.new(toTarget.X,0,toTarget.Z)
		local gap=a.pending.spec.contact or 3.6
		if flatTarget.Magnitude&gt;gap then
			local elapsed=now-(a.attackStarted or now)
			local progress=math.clamp(elapsed/a.pending.spec.travelTime,0,1)
			local drive=.32+1.18*math.sin(progress*math.pi)
			-- Combat convergence: the step-in steers during the startup only. Once
			-- the strike is out it is committed: a body that slipped aside is
			-- overshot (a whiff that reads), not followed by a magnet.
			if flatTarget.Magnitude&gt;.1 and a.state=="Startup" then a.travelDirection=(a.travelDirection:Lerp(flatTarget.Unit,math.min(1,dt*10))).Unit end
			local distance=math.min(a.travelRemaining,a.pending.spec.travel*drive*dt/a.pending.spec.travelTime,flatTarget.Magnitude-gap)
			a.travelRemaining-=Motor.travel(a,self,a.travelDirection,distance)
		end
	end
 local attack=a.pending
 if attack and attack.kind=="Brawl" and (a.state=="Startup" or a.state=="Active") then
  local delta=Combat.swingAt(a)-a.root.Position
  local flat=Vector3.new(delta.X,0,delta.Z)
  -- A locked strike starting up to 11 studs out turns into the opponent here
  -- (Brawler.start no longer snaps the body round in one frame).
  -- (The wall dive owns its own turn, above.)
  if flat.Magnitude&gt;2 and flat.Magnitude&lt;(if a.state=="Startup" and a.locked then 11 else 9) and attack.name~="WallDive" then
   local tangent=Vector3.new(-flat.Z,0,flat.X).Unit
   local spec=attack.spec
   if spec.orbit and a.state~="Recovery" then
    -- Lateral routes: swing around the opponent's guard while striking (an
    -- air switch vaults all the way to the other side).
    if spec.air then Motor.flight(a,self,tangent*(a.angleSide or 1)*dt*spec.orbit)
    else Motor.travel(a,self,tangent*(a.angleSide or 1),dt*spec.orbit) end
   elseif a.fighterId=="Flashstep" and spec.angle then
    Motor.travel(a,self,tangent*(if spec.angle&lt;0 then -1 else 1),dt*(if a.airborne then 9 else 7))
   elseif a.fighterId=="Mirage" and a.state=="Active" and a.hitConfirmed and (attack.name=="Light3" or attack.name=="Air2") then
    Motor.travel(a,self,-flat,dt*9)
   end
   -- Combat convergence (Studio: 1400-1900 deg/s root snaps at strike
   -- starts): a bounded turn in the startup; a strike already out only
   -- adjusts slowly (a body that slipped away is not chased round by the
   -- swing); lateral routes still track it.
   -- (A fighter's own weight in the turn, StrikeTurnScale: Zabuza's cleaver
   -- swings round slower, Itachi's economy turns a little sharper.)
   -- (Continuity blocker: magnetic facing) A strike turns little once it
   -- has started and barely while it is out: a body that slipped aside is
   -- missed, not tracked; one that went past behind is not turned to at all
   -- (the overshoot reads; the next action turns round).
   local look=Vector3.new(a.root.CFrame.LookVector.X,0,a.root.CFrame.LookVector.Z)
   local behind=not attack.aim and look.Magnitude&gt;.01 and look.Unit:Dot(flat.Unit)&lt;math.cos(math.rad(115))
   -- (A strike pushed at another body, a clone at his side, turns to it.)
   local turn=if spec.orbit or spec.angle then 1080 elseif attack.aim then 900 elseif a.state=="Startup" then Config.Facing.Startup else Config.Facing.Active
   if not behind then self:turnToward(a,flat,dt,turn*(a.def.StrikeTurnScale or 1)) end
  end
 end
	if a.landedAtSerial~=a.model:GetAttribute("MovementLandedAt") then
		a.landedAtSerial=a.model:GetAttribute("MovementLandedAt")
		-- Only a real drop shakes the lens and throws debris; a ninja jump lands
		-- light (Motor still leaves its small dust ring).
		if a.landedAtSerial and a.model:GetAttribute("MovementHardLanding")==true then self:pushImpact(a.root.Position,"landing",false) end
	end
	if a.aimIntent then
		-- Chase, slam drift and any other aimed motion outrank the hover window;
		-- hovering exists to hold a fighter still, never to cancel their movement.
		Motor.step(a,self,dt,now)
	elseif a.state=="Active" and a.attackName=="Slam" and a.airborne then
		-- The slam branch above already drove this frame's plunge; holding the
		-- body here would zero it every frame (a ~5 studs/s float, not a dive).
	elseif now&lt;(a.airHold or 0) and a.airborne then
		a.root.AssemblyLinearVelocity=Vector3.zero; a.hum:Move(Vector3.zero)
	else Motor.step(a,self,dt,now) end
	-- Server-owned humanoids + server-clamped arena coordinates.
	local p=a.root.Position
	if Vector3.new(p.X-self.match.origin.X,0,p.Z-self.match.origin.Z).Magnitude&gt;Config.ArenaRadius or p.Y&lt;self.match.origin.Y-3 then self:relocate(a,p) end
	World.pose(a,now,dt)
end
local IMPACT_STYLE={wire="shuriken",kunai="kunai",marked="kunai",shuriken="shuriken",wind="jutsu",fireball="fire",phoenix="ember",palm="palmburst",sand="sandhit",sandwave="sandburst"}
-- Eight Trigrams Rotation: blades and fire near the dome are deflected, and an
-- opponent inside it is thrown out once. Repelling a strike opens a counter.
local REFLECTED={kunai="kunai",shuriken="shuriken",marked="kunai"}
function Combat:stepRotation(a)
	-- Skill builds: a wider dome (rotationReach) and blades sent back at their
	-- thrower (rotationReflect), both set by Techniques.Rotation from the spec.
	local reach=a.rotationReach or Techniques.ROTATION_REACH or 7
	-- The dome sweeps away the enemy bodies inside it (shadow clones).
	Bodies.area(self,a,a.root.Position,reach)
	for i=#self.projectiles,1,-1 do
		local p=self.projectiles[i]
		if p.a~=a and (p.position-a.root.Position).Magnitude&lt;=reach+1.5 then
			table.remove(self.projectiles,i)
			self:pushImpact(p.position,"deflect",false,{projectile=p.id,kind=p.kind,owner=p.a.id,direction=-p.direction})
			Brawler.event(self,a,"Deflect")
			local thrower=p.a
			if a.rotationReflect and REFLECTED[p.kind] and thrower.health&gt;0 and a.target==thrower then
				local gap=(thrower.root.Position-p.position).Magnitude
				local back=self:projectile(a,thrower.root.Position,p.speed,gap+8,p.damage,REFLECTED[p.kind],nil,{origin=p.position})
				back.bounced=true
				Brawler.event(self,a,"Reflect")
			end
		end
	end
	local b=a.target
	a.rotationHit=a.rotationHit or {}
	if b and b.health&gt;0 and not a.rotationHit[b] and (b.root.Position-a.root.Position).Magnitude&lt;=reach then
		a.rotationHit[b]=true
		local attacking=b.state=="Startup" or b.state=="Active" or b.state=="Pursuit"
		local away=b.root.Position-a.root.Position;away=Vector3.new(away.X,0,away.Z)
		away=if away.Magnitude&gt;.1 then away.Unit else a.root.CFrame.LookVector
		self.damageTag="Rotation"
		local hit=self:damage(a,b,a.rotationDamage or 6,false,false)
		self.damageTag=nil
		if self.match.phase~="Duel" then return end
		-- The dome throws a body that was only standing in it out, even through a
		-- guard; a strike it turns aside staggers out of the dome instead, still
		-- inside the palm that answers (Techniques.rotationCounter).
		if hit then
			if attacking and b.airborne then Brawler.react(self,b,"Juggled",away*16+Vector3.new(0,14,0),.6,a)
			elseif attacking then Brawler.react(self,b,"HitStun",away*20,.6,a)
			else Brawler.react(self,b,"Knockback",away*48+Vector3.new(0,18,0),.55,a) end
		end
		self:pushImpact(b.root.Position,"repel",true,{owner=a.id,direction=away})
		if attacking then
			a.counterUntil=self.now+.9
			a.counterReach={expires=self.now+.9,max=7,variant="TrigramCounter"}
			Brawler.event(self,a,"Repel")
			self:cue(a,"ROTATION • REPELLED • COUNTER",.8);self:cue(b,"REPELLED",.6)
			Techniques.rotationCounter(self,a)
		end
	end
end
-- Delayed releases (hidden shuriken, the Phoenix Flower volley). Each entry
-- re-checks its owner when it fires, so a hit fighter never keeps throwing.
function Combat:schedule(at,fn)
	self.scheduled=self.scheduled or {}
	table.insert(self.scheduled,{at=at,fn=fn})
end
function Combat:runScheduled()
	local list=self.scheduled
	if not list or #list==0 then return end
	local due={}
	for i=#list,1,-1 do if list[i].at&lt;=self.now then table.insert(due,1,list[i]);table.remove(list,i) end end
	for _,entry in due do
		if self.match.phase~="Duel" then return end
		entry.fn()
	end
end
local function closestOnSegment(a,b,point)
	local ab=b-a
	local length=ab:Dot(ab)
	if length&lt;1e-6 then return a end
	return a+ab*math.clamp((point-a):Dot(ab)/length,0,1)
end
-- A Katon blast: the impact flash, a short splash, then flames that keep the
-- ground dangerous for a moment.
function Combat:fireExplosion(p,position,direct)
	local target=p.a.target
	-- A blast that misses the body becomes space denial: a wider patch of
	-- burning ground that holds the lane for a few seconds.
	if direct then self:addHazard(p.a,position,5.5,1.5,p.damage*.6,"Fire")
	else self:addHazard(p.a,position,7.5,3.2,p.damage*.45,"Fire") end
	if not direct and target and target.health&gt;0 then
		local delta=target.root.Position-position
		if delta.Magnitude&lt;=7.5 and workspace:Raycast(position,delta,self:rayParams(true))==nil then
			self.damageTag="splash"
			self:damage(p.a,target,p.damage*.5,false,false)
			self.damageTag=nil
		end
	end
end
-- Skill-build riders (SkillBuilds) on a clean projectile hit: a chase window
-- (Wind Cut, or a ricochet/Geometry blade with ToolMastery.Chase), a closed
-- chakra point (Vacuum Palm) and the fire patch of a blade that crossed the
-- thrower's burning ground. Inert for canonical kits.
function Combat:projectileRiders(p,target)
	local riders=p.riders or {}
	local owner=p.a
	local mastery=owner.def.ToolMastery
	local chase=riders.chase
	if not chase and p.bounced and p.kind=="shuriken" and mastery and mastery.Chase then chase=mastery.Chase end
	if chase then
		owner.pursuitUntil=math.max(owner.pursuitUntil or 0,self.now+chase)
		self:cue(owner,if p.kind=="wind" then "GUST • E TO CHASE" else "BLADE • E TO PURSUE",chase)
		Brawler.event(self,owner,"RiderChase")
	end
	if riders.tenketsu and owner.def.GentleFist and target.health&gt;0 then
		Brawler.gentleFist(self,owner,target,false)
		self:cue(owner,"VACUUM PALM • POINT CLOSED",.6)
	end
	if p.ignited and mastery and mastery.FireBlades then
		self:addHazard(owner,Vector3.new(target.root.Position.X,self.match.origin.Y+.5,target.root.Position.Z),2.5,mastery.FireBlades.Patch,p.damage,"Fire")
	end
end
-- Fire Geometry (skill build): a thrower's shuriken that crosses his own
-- burning ground catches fire once (+damage, an ember on the client).
function Combat:igniteBlade(p)
	local fire=p.a.def.ToolMastery.FireBlades
	for _,h in self.hazards do
		if h.a==p.a and h.kind=="Fire" then
			local d=p.position-h.position
			if Vector3.new(d.X,0,d.Z).Magnitude&lt;=h.radius and math.abs(d.Y)&lt;6 then
				p.ignited=true;p.damage+=fire.Damage
				self:pushImpact(p.position,"ember",false,{projectile=p.id,kind=p.kind,owner=p.a.id,direction=p.direction})
				Brawler.event(self,p.a,"BladeIgnited")
				return true
			end
		end
	end
	return false
end
function Combat:projectileHit(p,target,position,normal)
	local style=p.style or IMPACT_STYLE[p.kind] or (if Looks[p.kind] then "look" else "shuriken")
	self:pushImpact(position,style,p.kind=="fireball",{projectile=p.id,kind=p.kind,normal=normal,owner=p.a.id,victim=target.id,direction=p.direction,charge=p.charge})
	-- The entry still finishes the blade on the client; it only reads as a body
	-- hit once the defence has resolved. A blade that was evaded, parried or
	-- absorbed ends silently ("spent"): the defence pushed its own effect.
	local entry=self.impacts[#self.impacts]
	self.damageTag=p.kind
	self.hitOrigin=position-p.direction*4
	self.shieldBreak=p.breaksShield
	local damaged=self:damage(p.a,target,p.damage,false,false)
	if not damaged and entry and entry.projectile==p.id then entry.style="spent";entry.heavy=false end
	self.hitOrigin=nil
	self.shieldBreak=nil
	self.damageTag=nil
	if self.match.phase~="Duel" then return end
	-- Infused objects add their own consequence (guard crush, shock, ignition,
	-- gust, current through a wire) once the defence has resolved.
	if p.chakra then
		if entry and entry.projectile==p.id then entry.infusion=p.infusion end
		Chakra.contact(self,p,target,damaged)
		if self.match.phase~="Duel" then return end
	end
	local guarded=target.impactStyle=="block"
	-- A family object's contact fields (Families.contact): bind, drain, slow...
	if p.family then
		Families.projectileHit(self,p,target,damaged,guarded,position)
		if self.match.phase~="Duel" then return end
	end
	if damaged and not guarded then
		if p.kind=="sandwave" then
			Techniques.bindInSand(self,p.a,target)
		elseif p.kind=="wire" then
			Techniques.wireBind(self,p.a,target,p.riders,p.direction)
		elseif p.kind=="palm" then
			-- Vacuum Palm: a wall of air that carries the body away.
			local push=Vector3.new(p.direction.X,0,p.direction.Z)
			if push.Magnitude&lt;.05 then push=p.a.root.CFrame.LookVector end
			Brawler.react(self,target,"Knockback",push.Unit*54+Vector3.new(0,12,0),.5,p.a,"VacuumPalm")
		elseif p.kind=="wind" then
			target.root.AssemblyLinearVelocity=p.direction*37+Vector3.new(0,14,0)
		elseif p.kind=="fireball" then
			local push=Vector3.new(p.direction.X,0,p.direction.Z)
			if push.Magnitude&lt;.05 then push=p.a.root.CFrame.LookVector end
			-- (Reference quality) a held breath throws the body down and away.
			local charge=p.charge or 0
			if charge&gt;=.5 then Brawler.react(self,target,"Knockdown",push.Unit*(46+20*charge)+Vector3.new(0,26+8*charge,0),.8,p.a)
			else Brawler.react(self,target,"Knockback",push.Unit*44+Vector3.new(0,20,0),.55,p.a) end
		elseif p.reaction then
			-- A flight that names its reaction (impulse: lift, push along its line):
			-- a real Knockback, so the wind can splat a body on a wall at range.
			local push=Vector3.new(p.direction.X,0,p.direction.Z)
			if push.Magnitude&lt;.05 then push=p.a.root.CFrame.LookVector end
			local impulse=p.impulse or Vector3.new(0,12,40)
			Brawler.react(self,target,p.reaction,push.Unit*impulse.Z+Vector3.new(0,impulse.Y,0),p.stun or .5,p.a)
		end
		if p.riders or p.bounced or p.ignited then self:projectileRiders(p,target) end
	end
	-- Blades thrown at a body pinned against a wall nail it there a little longer
	-- (Itachi's precision): the wall phase is extended, never restarted.
	if damaged and not guarded and (p.kind=="shuriken" or p.kind=="kunai" or p.kind=="marked") and target.reaction=="WallSplat" then
		Brawler.pin(self,target,.34,p.a)
	end
	-- A guarded blast is absorbed whole: no burning ground under a raised guard.
	if p.kind=="fireball" and not guarded then self:fireExplosion(p,position,true) end
	-- A marked blade that connects leaves its seal on the body; a guarded one
	-- drops at the guard's feet.
	if p.onSurface then
		if damaged and not guarded and target.health&gt;0 then p.onSurface(position,normal or Vector3.yAxis,target)
		else
			local floor=workspace:Raycast(target.root.Position,Vector3.new(0,-8,0),self:rayParams(true))
			p.onSurface(if floor then floor.Position else position,if floor then floor.Normal else Vector3.yAxis)
		end
	end
end
function Combat:projectileSurface(p,hit)
	local style=if p.kind=="fireball" then "fire" elseif p.kind=="phoenix" then "ember" elseif p.kind=="wind" then "jutsu" elseif p.kind=="palm" then "palmburst" elseif Looks[p.kind] and not IMPACT_STYLE[p.kind] then "look" else "stick"
	-- A family object that leaves a zone where it lands (an explosive tag).
	if p.family and p.family.Charge and hit.Instance.CanCollide then Families.projectileEnd(self,p,hit.Position+hit.Normal*.4) end
	if p.family and p.family.Zone and hit.Instance.CanCollide then
		local z=p.family.Zone
		local h=self:addHazard(p.a,hit.Position+hit.Normal*.6,z.Radius or 6,z.Time or 3,z.Damage or 4,z.Kind or "Fire")
		h.effects=z;h.look=z.Look or p.kind
	end
	local mastery=p.a.def.ToolMastery
	local target=p.a.target
	-- Itachi's ricochet is decided first: a blade that bounces does not also stay.
	local bounceFrom=nil
	if mastery and mastery.Ricochet and p.kind=="shuriken" and not p.bounced and hit.Instance.CanCollide and math.abs(hit.Normal.Y)&lt;.7
		and target and target.health&gt;0 and (target.root.Position-hit.Position).Magnitude&lt;36 then
		local from=hit.Position+hit.Normal*.8
		local clear=workspace:Raycast(from,target.root.Position-from,self:rayParams(true))
		if not clear or clear.Instance:IsDescendantOf(target.model) then bounceFrom=from end
	end
	-- A chakra blade stays planted (a contestable point), a fire blade leaves a
	-- burning point, a missed wire stays stretched: decided before the impact
	-- so the client draws the object that stays instead of a plain stuck blade.
	local stayed=(p.chakra or p.kind=="wire") and not bounceFrom and Chakra.surface(self,p,hit.Position,hit.Normal,hit.Instance)
	local marker=if stayed and stayed.wire then "stretch" elseif stayed and stayed.point then "plant" else nil
	self:pushImpact(hit.Position,style,p.kind=="fireball",{projectile=p.id,kind=p.kind,normal=hit.Normal,owner=p.a.id,direction=p.direction,chakra=marker,infusion=p.infusion,charge=p.charge})
	-- The surface keeps it (EMB-004): a hole in the trunk, a scorch on the stone.
	if hit.Instance.CanCollide and not bounceFrom then WorldReaction.projectile(self,p,hit) end
	if p.kind=="fireball" then self:fireExplosion(p,hit.Position+hit.Normal*1.5,false) end
	if p.kind=="phoenix" then self:addHazard(p.a,hit.Position+hit.Normal*1.2,3.4,1.8,p.damage*.6,"Fire") end
	if self.match.phase~="Duel" then return end
	if p.onSurface and hit.Instance.CanCollide then p.onSurface(hit.Position,hit.Normal) end
	if bounceFrom then
		local bounce=self:projectile(p.a,target.root.Position,p.speed*.9,40,p.damage,"shuriken",nil,{origin=bounceFrom})
		bounce.bounced=true
		-- An infused blade keeps its chakra through the bounce (no second scaling).
		Chakra.inherit(bounce,p)
		-- The new path is shown (ricochet, to): the geometry is the threat.
		self:pushImpact(hit.Position,"deflect",false,{owner=p.a.id,fighter=p.a.fighterId,ricochet=true,to=target.root.Position,direction=bounce.direction})
		Brawler.event(self,p.a,"Ricochet")
	end
end
-- Itachi's Shuriken Geometry: a blade thrown wide of the opponent, a second
-- thrown to strike it beside them; the collision sends both into the flank.
function Combat:shurikenGeometry(a,sideSign,infused)
	local b=a.target
	local start=Combat.launchPoint(a,"Shuriken")
	local toward=Vector3.new(b.root.Position.X-start.X,0,b.root.Position.Z-start.Z)
	if toward.Magnitude&lt;.1 then toward=a.root.CFrame.LookVector end
	local forward=toward.Unit
	local right=forward:Cross(Vector3.yAxis).Unit*-(sideSign~=0 and sideSign or 1)
	-- The meeting point: beside the opponent and a little past them.
	local meet=b.root.Position+right*-6+forward*1.5
	meet=Vector3.new(meet.X,start.Y,meet.Z)
	local flight=(meet-start).Magnitude
	local arrive=flight/70
	a.neutralToolAt=self.now+.8
	self:beginThrow(a,{kind="Shuriken",release=.12,count=2,interval=.1,fire=function(index)
		local from=Combat.launchPoint(a,"Shuriken")
		local gap=(meet-from).Magnitude
		-- The second blade is thrown later and faster: both reach the point together.
		local speed=if index==1 then 70 else math.max(70,gap/math.max(.08,arrive-.1))
		local p=self:projectile(a,meet,speed,gap,0,"shuriken",nil,{origin=from})
		p.geometry=index==1 and {meet=meet,chakra=infused}
	end})
	self:cue(a,"SHURIKEN GEOMETRY",.7)
	Brawler.event(self,a,"Geometry")
	return true
end
function Combat:projectileExpire(p)
	-- A family object that ends without a body may stay as a charge.
	Families.projectileEnd(self,p,p.position)
	if p.geometry and p.a.target and p.a.target.health&gt;0 then
		local b=p.a.target
		self:pushImpact(p.position,"clash",false,{owner=p.a.id,fighter=p.a.fighterId,direction=p.direction,geometry=true,to=b.root.Position})
		for k=1,2 do
			local aim=b.root.Position+Vector3.new(0,(k-1.5)*.8,0)
			local redirected=self:projectile(p.a,aim,88,18,2.5,"shuriken",nil,{origin=p.position,chakra=p.geometry.chakra})
			redirected.bounced=true
		end
		Brawler.event(self,p.a,"GeometryHit")
		return
	end
	if p.kind=="fireball" then
		self:pushImpact(p.position,"fire",true,{projectile=p.id,kind=p.kind,normal=Vector3.yAxis,owner=p.a.id,direction=p.direction,charge=p.charge})
		self:fireExplosion(p,p.position,false)
		return
	end
	if p.kind=="phoenix" then
		self:pushImpact(p.position,"ember",false,{projectile=p.id,kind=p.kind,normal=Vector3.yAxis,owner=p.a.id,direction=p.direction})
		return
	end
	-- A chakra blade (or a wire) at the end of its flight drops and stays there.
	if Chakra.expire(self,p) then return end
	-- A marked kunai that reaches the end of its flight drops to the ground and
	-- still plants its seal there: a long throw is a long-range anchor.
	if p.kind=="marked" and p.onSurface then
		local floor=workspace:Raycast(p.position,Vector3.new(0,-80,0),self:rayParams(true))
		if floor then
			self:pushImpact(floor.Position,"stick",false,{projectile=p.id,kind=p.kind,normal=floor.Normal,owner=p.a.id,direction=p.direction})
			p.onSurface(floor.Position,floor.Normal)
			return
		end
	end
	self:pushImpact(p.position,"fade",false,{projectile=p.id,kind=p.kind,owner=p.a.id})
end
function Combat:updateProjectiles(dt)
	-- Meetings in flight, planted points and stretched wires (ChakraCombat).
	Chakra.step(self,dt)
	if self.match.phase~="Duel" then return end
	for i=#self.projectiles,1,-1 do
		local p=self.projectiles[i]
		if not p or self.match.phase~="Duel" then return end
		-- Removed by a meeting, or planted: never moved here. A projectile without
		-- speed (a reflection of something planted) cannot fly either.
		if p.dead or p.planted or (p.speed or 0)&lt;=0 then
			if p.dead or not p.planted then
				local index=table.find(self.projectiles,p)
				if index then table.remove(self.projectiles,index) end
			end
			continue
		end
		if p.kind=="shuriken" and not p.ignited and p.a.def.ToolMastery and p.a.def.ToolMastery.FireBlades then self:igniteBlade(p) end
		local travel=math.min(p.speed*dt,p.remaining)
		local step=p.direction*travel
		-- Bodies (Naruto's clones): a transforming tool becomes one near its
		-- target; an enemy body on the path puffs away and stops a blade (a
		-- jutsu volume carries on through it).
		if (p.transform and Bodies.transform(self,p,step)) or Bodies.projectile(self,p,step) then
			local index=table.find(self.projectiles,p)
			if index then table.remove(self.projectiles,index) end
			if self.match.phase~="Duel" then return end
			continue
		end
		local target=p.a.target
		local done=false
		-- Volumetric techniques test the body against the swept sphere, so a
		-- fireball that visibly engulfs the fighter always connects.
		local radius=p.radius+p.growth*(self.now-p.born)
		if radius&gt;0 and target and target.health&gt;0 then
			local closest=closestOnSegment(p.position,p.position+step,target.root.Position)
			if (target.root.Position-closest).Magnitude&lt;=radius+1.2 then
				self:projectileHit(p,target,closest,-p.direction)
				if self.match.phase~="Duel" then return end
				done=true
			end
		end
		if not done then
			local ray=RaycastParams.new(); ray.FilterType=Enum.RaycastFilterType.Exclude
			local exclude={self.match.effects,p.a.model}
			if radius&gt;0 and target then table.insert(exclude,target.model) end
			ray.FilterDescendantsInstances=exclude
			local hit=workspace:Raycast(p.position,step,ray)
			if hit then
				if target and hit.Instance:IsDescendantOf(target.model) then
					self:projectileHit(p,target,hit.Position,hit.Normal)
				else
					self:projectileSurface(p,hit)
				end
				if self.match.phase~="Duel" then return end
				done=true
			end
		end
		p.position+=step; p.remaining-=travel
		if not done and p.remaining&lt;=0 then
			self:projectileExpire(p)
			if self.match.phase~="Duel" then return end
		end
		if done or p.remaining&lt;=0 or p.a.health&lt;=0 or p.dead then
			local index=table.find(self.projectiles,p)
			if index then table.remove(self.projectiles,index) end
		end
	end
end
function Combat:updateHazards()
	for i=#self.hazards,1,-1 do
		local h=self.hazards[i]
		if not h.worldMarked then
			-- An elemental zone marks the ground under it once (EMB-004). "Fire"
			-- is also the default kind of a generic family zone: a family zone
			-- marks by its declared Element (or an explicit Fire kind) only.
			h.worldMarked=true
			local fx=h.effects
			local element=if fx then (fx.Element and string.lower(fx.Element)) or (fx.Kind=="Fire" and "fire") or nil
				elseif h.kind=="Fire" then "fire" else nil
			if element then WorldReaction.zone(self,h.position,h.radius,element) end
		end
		if self.now&gt;=h.expires or h.a.health&lt;=0 then table.remove(self.hazards,i)
		else
			local target=h.a.target
			local delta=target.root.Position-h.position
			local flat=Vector3.new(delta.X,0,delta.Z)
			if target.health&gt;0 and flat.Magnitude&lt;=h.radius and math.abs(delta.Y)&lt;6 and self.now-(h.lastHit[target] or -10)&gt;0.48 then
				local ray=workspace:Raycast(h.position,target.root.Position-h.position,self:rayParams(true))
				if not ray then
					h.lastHit[target]=self.now
					self.damageTag="burn"
					-- Seen burning while the ticks land (snapshot `burning`); still no stun, no hit.
					if h.damage&gt;0 and self:chip(h.a,target,h.damage*0.34) and h.kind=="Fire" then target.burnUntil=self.now+.55 end
					-- A family zone's riders (Families.zoneTick): slow, drain, seal.
					if h.effects and target.health&gt;0 then Families.zoneTick(self,h,target) end
					self.damageTag=nil
					-- A burn that ends the duel may clear the hazard list (Combat:clear).
					if self.match.phase~="Duel" then return end
				end
			end
		end
	end
end
-- Bodies do not collide physically (that made fighters climb each other);
-- two grounded fighters closer than a body width are eased apart instead.
function Combat:separate()
	local a,b=self.actors[1],self.actors[2]
	if not a or not b or a.health&lt;=0 or b.health&lt;=0 or a.grabVictim or b.grabVictim then return end
	local delta=b.root.Position-a.root.Position
	local flat=Vector3.new(delta.X,0,delta.Z)
	local gap=flat.Magnitude
	if gap&gt;=3 or math.abs(delta.Y)&gt;4 then return end
	local push=math.min(3-gap,.35)*.5
	local dir=if gap&gt;.05 then flat.Unit else a.root.CFrame.RightVector
	Motor.travel(a,self,-dir,push);Motor.travel(b,self,dir,push)
	-- Combat convergence (Studio: kinetic bursts carried one body into the
	-- other): inside a body width neither root keeps velocity into the other,
	-- the contact a physical collision would have made. A dodge passes.
	if gap&lt;2.6 then
		for _,pair in {{a,dir},{b,-dir}} do
			local body,n=pair[1],pair[2]
			if body.state~="Dodging" and not (body.rush and body.rush.line) then
				local v=body.root.AssemblyLinearVelocity
				local inward=v:Dot(n)
				if inward&gt;0 then body.root.AssemblyLinearVelocity=v-n*inward end
			end
		end
	end
end
function Combat:update(dt,now)
	self.now=now
	if self.match.phase~="Duel" then return end
	-- Record every frame. Sampling at 1/30 used to validate contact against a
	-- position up to a third of a second stale while the attacker closed in,
	-- so visibly connected strikes were rejected as out of range.
	for _,a in self.actors do HitDetection.record(a.root,now) end
	for _,a in self.actors do
		if self.match.phase~="Duel" then break end
		self:updateActor(a,dt)
	end
	if self.match.phase=="Duel" then self:separate() end
	if self.match.phase=="Duel" then self:runScheduled() end
	if self.match.phase=="Duel" then Bodies.step(self,dt) end
	-- Zones act before the flights move (a blade entering a lane turns this frame).
	if self.match.phase=="Duel" then Zones.step(self,dt) end
	if self.match.phase=="Duel" then self:updateProjectiles(dt); self:updateHazards() end
	for i=#self.effects,1,-1 do
		local e=self.effects[i]
		if e.expires&lt;=now or not e.part.Parent then e.part:Destroy(); table.remove(self.effects,i) end
	end
end
function Combat:clear(preserveAnimations)
	for _,a in self.actors do
		HitDetection.clear(a.root)
		if not preserveAnimations then Animation.clear(a) end
		Bangla.close(a.pending); Motor.reset(a);
		Brawler.releaseGrab(a); a.reaction=nil; a.reactionVelocity=nil; a.buffered=nil; a.airHold=0; a.pursuitUntil=0; a.chainOpen=false
		a.state=if a.health&gt;0 then "Neutral" else "Defeated";Defense.guard(a,false,self.now);a.readUntil=0;a.bonusUntil=0;a.dodgeUntil=0;a.invulnerableUntil=0;a.travelRemaining=0
		a.evade=nil;a.evadeCarry=nil;a.strikeCarry=nil;a.donorHitCount=0;a.donorLastHit=nil; a.combo=0;a.lastAttack=-10;a.throwing=nil;a.castId=nil;a.flashUntil=0;a.hop=nil;a.counterUntil=0;a.hitBlocked=false;
		a.anchors={};a.comboHits=0;a.comboDamage=0;a.splatAt=nil;a.splatPins=0;a.flashCancel=nil
		a.rotationUntil=0;a.flurryUntil=0;a.sealedUntil=0;a.tenketsu=0;a.tenketsuUntil=0
		a.rushArriveUntil=0;a.awakenUntil=0;a.flowStreak=0;a.nextFlow=nil;a.grabbedAt=nil;a.boundBy=nil
		Brawler.resetStrings(a);a.intentMemory=nil;a.intentOverride=nil;a.rush=nil;a.arrivalRecovery=nil;a.pursuitDuration=nil;a.rushReadyAt=0
		a.shieldCharges=a.def.SandShield and a.def.SandShield.Charges or 0
		a.bodyState=nil
		a.attackName=nil; a.attackStarted=0; a.pending=nil; a.anchor=nil; a.illusionUntil=0; a.decoyPosition=nil; a.move=Vector3.zero; a.wall=nil
		a.hum:Move(Vector3.zero); a.root.AssemblyLinearVelocity=Vector3.zero; a.locomotion=Vector3.zero; a.airborne=false
		-- Every other temporary state (buffs, stances, slows, poison, windows).
		Families.clearState(a)
	end
	self.match.effects:ClearAllChildren(); table.clear(self.effects); table.clear(self.projectiles); table.clear(self.hazards)
	Zones.clear(self)
	if self.scheduled then table.clear(self.scheduled) end
	Bodies.clear(self)
	self.impacts={}; self.impactSerial=0
end
return Combat
</ProtectedString>
        </Properties>
