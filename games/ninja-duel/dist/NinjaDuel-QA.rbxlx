  <Item class="ServerScriptService" referent="ND17">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="ND18">
      <Properties>
        <string name="Name">NinjaDuelServer</string>
      </Properties>
      <Item class="ModuleScript" referent="ND19">
        <Properties>
          <string name="Name">AI</string>
          <ProtectedString name="Source">local Config=require(game:GetService("ReplicatedStorage").NinjaDuel.Config)
local Techniques=require(script.Parent.Techniques)
local AI={}; AI.__index=AI
function AI.new(combat,actor,seed)
	return setmetatable({combat=combat,actor=actor,nextTick=0,observed=nil,observedAt=0,guardUntil=0,rng=Random.new(seed or 23)},AI)
end
function AI:update(now)
	local c,a=self.combat,self.actor; local target=a.target; local tune=Config.AI
	if c.match.phase~="Duel" or a.health&lt;=0 or target.health&lt;=0 then a.move=Vector3.zero; return end
	if now&lt;self.nextTick then return end
	self.nextTick=now+tune.Tick
	if (a.state=="Stunned" or a.reaction) and a.subCharges&gt;0 and a.chakra&gt;=Config.Substitution.Cost and self.rng:NextNumber()&lt;0.42 then
		c:request(a,"Substitute")
	end
	local position=if a.decoyPosition and a.illusionUntil&gt;now then a.decoyPosition else target.root.Position
	local delta=position-a.root.Position; delta=Vector3.new(delta.X,0,delta.Z)
	local distance=delta.Magnitude; local toward=if distance&gt;0.1 then delta.Unit else Vector3.zAxis
	if a.state~="Dodging" and not a.wall then a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+toward) end
	local tangent=Vector3.new(-toward.Z,0,toward.X);local minato=a.def.Name=="Minato"
	local desired=a.def.PreferredRange or 7
	local radial=if distance&gt;desired+2 then 1 elseif distance&lt;desired-2 then -0.6 else 0
	a.move=(toward*radial+tangent*math.sin(now*(if minato then 1.15 else .58))*(if minato then .95 else .48))
	a.sprinting=distance&gt;desired+6
	if a.move.Magnitude&gt;1 then a.move=a.move.Unit end
	if now&gt;=self.guardUntil and a.state=="Guarding" then c:request(a,"GuardOff") end
	if target.state~=self.observed then
  if target.state=="Startup" or target.state=="TechniqueChannel" then self.threatAt=now end
  self.observed=target.state;self.observedAt=now
 end
	local reacted=now-self.observedAt&gt;=tune.Reaction
	local danger=target.state=="Startup" or target.state=="TechniqueChannel"
 -- Remember the wind-up through Active/Recovery: short attacks used to erase
 -- the observation before reaction latency elapsed, so defense never fired.
 local remembered=self.threatAt and now-self.threatAt&gt;=tune.Reaction and now-self.threatAt&lt;.9
 if remembered and distance&lt;9 and a.state=="Neutral" and not a.reaction then
  self.threatAt=nil
  if target.state=="Recovery" then
   a.move=toward;a.sprinting=true
   if distance&lt;6 then c:request(a,"Attack") else c:request(a,"Dodge") end
  elseif minato then
   a.move=tangent;c:request(a,"Dodge")
  else
   c:request(a,"Guard");self.guardUntil=now+.36
  end
  return
 end
	if a.state=="Startup" and a.attackName=="Heavy" and now-a.attackStarted&gt;.08 and self.rng:NextNumber()&lt;(if minato then .18 else .3) then c:request(a,"Feint");return end
	-- A newly observed telegraph may alter movement, but cannot trigger an
	-- instant defensive action or coincidental interrupt before reaction latency.
	if danger and not reacted then return end
	if reacted and danger and distance&lt;9 then
		if target.state=="TechniqueChannel" and distance&lt;=6.8 and self.rng:NextNumber()&lt;tune.Aggression then
			c:request(a,"Attack"); return
		end
		if self.rng:NextNumber()&lt;tune.Defense then
			if self.rng:NextNumber()&lt;0.45 then c:request(a,"Dodge")
			else c:request(a,"Guard"); self.guardUntil=now+0.5 end
			return
		end
	end
	if a.grabVictim then c:request(a,if self.rng:NextNumber()&lt;.4 then "Heavy" else "Attack");return end
	-- Flying Thunder God arrival: strike from the new angle immediately.
	if (a.flashUntil or 0)&gt;now then
		c:request(a,if self.rng:NextNumber()&lt;.3 then "Heavy" else "Attack");return
	end
	-- A marked kunai that is about to pass the opponent is a teleport cue.
	if minato and a.state=="Neutral" then
		local seal=Techniques.sealOf(c,a,now)
		if seal and (seal-target.root.Position).Magnitude&lt;7 and c:markedInFlight(a) then
			for slot,spec in a.def.Techniques do
				if spec.Id=="Flashstep" and c:request(a,"Technique"..slot) then return end
			end
		end
	end
	if a.pursuitUntil&gt;now and distance&gt;8 and distance&lt;Config.PursuitRange and self.rng:NextNumber()&lt;0.58 then
		c:request(a,"Pursuit"); return
	end
	if a.state=="Recovery" and a.chainOpen then
		local branch=if a.airborne then (if (a.airCombo or 0)&gt;=2 then "Heavy" else "Attack") elseif a.combo&gt;=2 and self.rng:NextNumber()&lt;.55 then "Heavy" else "Attack"
		if not a.airborne and self.rng:NextNumber()&lt;(if minato then .18 else .34) then branch="Tool" end
		c:request(a,branch);return
	end
	if a.state~="Neutral" or a.reaction then return end
	if a.chakra&lt;18 then a.move=-toward+tangent*0.2; return end
	if distance&gt;7 and distance&lt;30 and self.rng:NextNumber()&lt;(if a.def.Name=="Itachi" then 0.24 else 0.18) then
		if c:request(a,"Tool",target.root.Position) then return end
	end
	-- Choose by capabilities/technique identifiers, never by a second bot combat engine.
	if self.rng:NextNumber()&lt;tune.Technique then
		for slot,spec in a.def.Techniques do
			local use=false; local aim=target.root.Position
			if spec.Id=="MarkedBlade" then use=not a.anchor and not c:markedInFlight(a) and distance&gt;8; aim=position+target.hum.MoveDirection*3
			elseif spec.Id=="Flashstep" then local seal=Techniques.sealOf(c,a,now);use=seal~=nil and (distance&gt;14 or (seal-target.root.Position).Magnitude&lt;7)
			elseif spec.Id=="BurstStrike" then use=distance&lt;7 and (target.state=="Recovery" or target.state=="Stunned" or target.state=="TechniqueRecovery")
			elseif spec.Id=="Read" then use=distance&lt;8 and danger and reacted
			elseif spec.Id=="NeedleFan" then use=distance&gt;8 and distance&lt;36
			elseif spec.Id=="MirageCast" then use=distance&gt;10 and distance&lt;21 and (target.state=="Recovery" or target.state=="Guarding" or self.rng:NextNumber()&lt;0.18) end
			if spec.Id=="FireBloom" then use=distance&gt;6 and distance&lt;46 and c:lineOfSight(a,target) and (target.state=="Recovery" or target.state=="TechniqueChannel" or self.rng:NextNumber()&lt;0.32) end
			if spec.Id=="WindCut" then use=distance&gt;8 and distance&lt;28 end
			if spec.Id=="Quickstep" then use=distance&gt;9 and distance&lt;20 and self.rng:NextNumber()&lt;0.25 end
			if use and c:request(a,"Technique"..slot,aim) then return end
		end
	end
	local whiff=target.state=="Recovery" and (target.attackName=="Heavy" or not target.hitConfirmed)
	if whiff and distance&lt;10 then a.move=toward;a.sprinting=true;c:request(a,"Attack");return end
	if distance&lt;8 and self.rng:NextNumber()&lt;tune.Aggression then
		c:request(a,if a.grabVictim then "Attack" elseif distance&lt;5 and self.rng:NextNumber()&lt;.12 then "Grab" elseif self.rng:NextNumber()&lt;.16 then "Heavy" else "Attack")
	end
	if distance&gt;6 and distance&lt;17 and self.rng:NextNumber()&lt;0.1 then c:request(a,"Jump") end
	-- Sidestep cover when the direct route is obstructed.
	local block=workspace:Raycast(a.root.Position,toward*6,c:rayParams(true))
	if block then a.move=tangent; c:request(a,"Jump") end
end
return AI
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND20">
        <Properties>
          <string name="Name">Animation</string>
          <ProtectedString name="Source">-- Bangla PunchMoves animation playback, adapted for server-owned human and AI R15.
-- Combat uses imported choreography; the previous procedural punch fallback is removed.
local Shared=game:GetService('ReplicatedStorage').NinjaDuel
local Combo=require(Shared.BanglaCombo)
local Bindings=require(Shared.AnimationBindings)
local Donor=require(script.Parent.DonorAnimations)
local RunService=game:GetService('RunService')
local Provider=game:GetService('KeyframeSequenceProvider')
local ServerStorage=game:GetService('ServerStorage')
local Animation={}
local catalog={Idle=656117400,Run=656118852,Walk=656121766,Jump=656117878,Fall=656115606,Climb=656114359}
local cache,failures,loading={},{},{}
local function resolve(name)
 if Bindings[name] and Bindings[name]&gt;0 then return 'rbxassetid://'..Bindings[name] end
 if not RunService:IsStudio() then return nil,'Publish the retargeted '..name..' R15 sequence and fill AnimationBindings.' end
 if cache[name] then return cache[name] end
 if failures[name] then return nil,failures[name] end
 if loading[name] then
  local deadline=os.clock()+15
  repeat task.wait(.05) until not loading[name] or os.clock()&gt;=deadline
  return cache[name],failures[name] or 'Animation fetch still pending'
 end
 loading[name]=true
 local ok,value=pcall(function()
 local seq=Provider:GetKeyframeSequenceAsync('rbxassetid://'..Combo.AnimationIds[name])
 local r15=Donor.retarget(seq);seq:Destroy()
 local folder=ServerStorage:FindFirstChild('BanglaR15Sequences')
 if not folder then folder=Instance.new('Folder');folder.Name='BanglaR15Sequences';folder.Parent=ServerStorage end
 r15.Name=name;r15.Parent=folder
 return Provider:RegisterKeyframeSequence(r15)
 end)
 loading[name]=nil
 if ok then cache[name]=value;return value end
 failures[name]=tostring(value);return nil,failures[name]
end
function Animation.attach(a)
 if a.model:GetAttribute('SkipDonorAnimationQA') then return false end
 local animator=a.hum:FindFirstChildOfClass('Animator');if not animator then return false end
 local player={tracks={},instances={},current=nil,currentEvent=nil};a.animation=player
 a.model:SetAttribute('AuthoredAnimations',true)
 a.model:SetAttribute('DonorAnimationStatus','Loading')
 task.spawn(function()
  for name,id in catalog do
   local asset=Instance.new('Animation');asset.AnimationId='rbxassetid://'..id
   local ok,track=pcall(function() return animator:LoadAnimation(asset) end)
   if a.animation~=player then if ok then track:Destroy() end;asset:Destroy();return end
   table.insert(player.instances,asset)
   if ok then track.Priority=Enum.AnimationPriority.Movement;track.Looped=name=='Idle' or name=='Run' or name=='Walk' or name=='Climb';player.tracks[name]=track end
  end
  local ready=true
  for name in Combo.AnimationIds do
   local ok,id,reason=pcall(resolve,name)
   if a.animation~=player then return end
   if ok and id then
    local asset=Instance.new('Animation');asset.Name=name;asset.AnimationId=id
    local loaded,track=pcall(function() return animator:LoadAnimation(asset) end)
    table.insert(player.instances,asset)
    if loaded then track.Priority=Enum.AnimationPriority.Action;player.tracks[name]=track
    else ready=false;warn('[NinjaDuelAnimation] BLOCKED '..name..': '..tostring(track)) end
   else ready=false;warn('[NinjaDuelAnimation] BLOCKED '..name..': '..tostring(reason or id)) end
  end
  a.model:SetAttribute('DonorAnimationStatus',if ready then 'Ready' else 'Blocked')
 end)
 return true
end
local function choose(a,now)
 if a.health&lt;=0 then return nil end
 if a.state=='Startup' or a.state=='Active' or a.state=='Recovery' and a.attackName and now-a.attackStarted&lt;.5 then
  local action=Combo.Actions[a.attackName]
  -- Missing ninja branches reuse the imported moves; no local pose timeline.
  action=action or (if a.attackName=='Air1' or a.attackName=='DashAttack' then 'Punch' elseif a.attackName=='Air2' then 'HardSmack' else 'MegaPunch')
  return action,a.attackStarted
 end
 if a.reaction or a.state=='Stunned' then return nil end
 if a.state=='Guarding' then return 'Parry',0 end
 if a.state=='TechniqueChannel' then return 'Parry',a.untilTime end
 if a.wall then return 'Climb',0 end
 if a.airborne then return if a.root.AssemblyLinearVelocity.Y&gt;0 then 'Jump' else 'Fall',0 end
 if a.locomotion.Magnitude&gt;2 then return if a.locomotion.Magnitude&gt;30 then 'Run' else 'Walk',0 end
 return 'Idle',0
end
function Animation.step(a,now)
 local p=a.animation;if not p then return false end
 local name,event=choose(a,now)
 if p.current~=name or p.currentEvent~=event then
  if p.current and p.tracks[p.current] then p.tracks[p.current]:Stop(.08) end
  p.current=name;p.currentEvent=event
  if name and p.tracks[name] then p.tracks[name]:Play(.06) end
 elseif name and p.tracks[name] and not p.tracks[name].IsPlaying and (name=='Idle' or name=='Run' or name=='Walk' or name=='Climb' or name=='Parry') then
  p.tracks[name]:Play(.08)
 end
 if (name=='Run' or name=='Walk') and p.tracks[name] then p.tracks[name]:AdjustSpeed(math.clamp(a.locomotion.Magnitude/(if name=='Run' then 32 else 18),.75,1.7)) end
 return true
end
function Animation.clear(a)
 local p=a.animation;a.animation=nil;if not p then return end
 for _,track in p.tracks do track:Stop(0);track:Destroy() end
 for _,asset in p.instances do asset:Destroy() end
end
return Animation
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND21">
        <Properties>
          <string name="Name">BanglaCombat</string>
          <ProtectedString name="Source">-- Adapted from BanglaBattlegrounds ServerScriptService/StarterCombat.
-- Copyright (c) 2024 Dewan Mukto, MIT (vendor/bangla/LICENSE).
-- Retained: forward hitbox, per-swing Hits, damage table, parry seam, hit counter,
-- BasicPunch emission and swing/contact sounds. Changes: one validated actor API,
-- deterministic broadphase for anchored hitboxes, active-window lifetime/cleanup,
-- collision occlusion, and Ninja Duel's guard/chakra/damage authority.
local Debris=game:GetService('Debris')
local assets=game:GetService('ReplicatedStorage').NinjaDuel:WaitForChild('BanglaAssets')
local Combo=require(game:GetService('ReplicatedStorage').NinjaDuel.BanglaCombo)
local Bangla={}
local weaponSounds={['Light Melee']='rbxassetid://8595980577',['Heavy Melee']='rbxassetid://9117969717'}
local function sound(parent,id)
 local s=Instance.new('Sound');s.SoundId=id;s.Volume=.5;s.Parent=parent
 s:Play();Debris:AddItem(s,1.5)
end
function Bangla.begin(c,a,p)
 local hitbox=Instance.new('Part')
 hitbox.Name='BanglaHitbox';hitbox.Anchored=true;hitbox.CanCollide=false
 hitbox.CanQuery=false;hitbox.CanTouch=false;hitbox.Transparency=1
 hitbox.Size=Vector3.new(5,5,2)
 hitbox.CFrame=a.root.CFrame*CFrame.new(0,0,-2)
 hitbox.Parent=c.match.effects
 p.donor={hitbox=hitbox,Hits={},action=Combo.Actions[p.name] or 'MegaPunch'}
 -- The donor used Debris for lifetime; c.effects also cleans interrupted swings.
 table.insert(c.effects,{part=hitbox,expires=c.now+p.spec.startup+p.spec.active+.05})
 sound(a.root,'rbxassetid://5835032207')
 a.model:SetAttribute('CombatBase','BanglaBattlegrounds')
end
function Bangla.close(p)
 if p and p.donor then p.donor.hitbox:Destroy() end
end
function Bangla.tryHit(c,a,p)
 local donor=p.donor;local target=a.target
 if not donor or not donor.hitbox.Parent or not target or target.health&lt;=0 then return false end
 -- Same donor forward volume; missing air/grab mechanics supply their bounded shape.
 local hitbox=donor.hitbox
 hitbox.Size=Vector3.new(p.spec.width or 5,p.spec.height or 5,p.spec.depth or 2)
 hitbox.CFrame=a.root.CFrame*CFrame.new(0,0,-(p.spec.offset or 2))
 local params=OverlapParams.new();params.FilterType=Enum.RaycastFilterType.Include
 params.FilterDescendantsInstances={target.model}
 -- Touched on a teleported anchored part was unreliable; query the same volume.
 for _,hit in workspace:GetPartBoundsInBox(hitbox.CFrame,hitbox.Size,params) do
  if hit:IsDescendantOf(target.model) and not donor.Hits[target.id] then
   if not c:targetValid(a,target,p.spec.range,.05) then continue end
   donor.Hits[target.id]=true
   local delta=a.root.Position-target.root.Position
   local frontal=delta.Magnitude&lt;.001 or target.root.CFrame.LookVector:Dot(delta.Unit)&gt;.15
   local guarded=target.state=='Guarding' and target.chakra&gt;0 and frontal
   local protected=target.state=='TechniqueChannel' and target.pending and not target.pending.spec.Interruptible
   local damage=if Combo.Actions[p.name] then Combo.Damage[donor.action] else p.spec.damage
   local success=c:damage(a,target,damage*(a.def.CombatDamage or 1),false,true)
   if success then
    local weaponType=if donor.action=='MegaPunch' then 'Heavy Melee' else 'Light Melee'
    sound(target.root,weaponSounds[weaponType])
    local vfx=if donor.action=='MegaPunch' then 'ComboPunch' else 'BasicPunch'
    local basicPunch=assets.VFX[vfx].Attachment:Clone()
    basicPunch.Parent=target.root
    for _,v in basicPunch:GetChildren() do
     if v:IsA('ParticleEmitter') then v:Emit(v:GetAttribute('EmitCount') or 1) end
    end
    Debris:AddItem(basicPunch,.25)
    if c.now-(a.donorLastHit or -10)&gt;2 then a.donorHitCount=0 end
    a.donorHitCount=(a.donorHitCount or 0)+1;a.donorLastHit=c.now
   end
   return success,guarded,protected
  end
 end
 return false
end
return Bangla
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND22">
        <Properties>
          <string name="Name">BanglaEvade</string>
          <ProtectedString name="Source">-- performEvade from Bangla WalkRunHandler (Dewan Mukto, MIT), adapted.
-- One finite server tick loop replaces leaked RenderStepped connections. No global
-- gravity change; swept travel preserves walls, lane boundaries and root facing.
local Evade={}
function Evade.begin(a,c)
 local direction=if a.move.Magnitude&gt;.1 then a.move.Unit else a.root.CFrame.RightVector
 local evadeDistance=14*(a.def.DashScale or 1)
 local evadeDuration=.32
 a.evade={startPosition=a.root.Position,targetPosition=a.root.Position+direction*evadeDistance,startTime=c.now,duration=evadeDuration,direction=direction}
end
function Evade.step(a,c,travel)
 local e=a.evade;if not e then return end
 local rootPart=a.root
 local targetPosition=e.targetPosition
 local evadeDuration=e.duration
 local startTime=e.startTime
 local elapsedTime=c.now-startTime
 if elapsedTime&lt;evadeDuration then
  local t=math.clamp(elapsedTime/evadeDuration,0,1)
  -- Fast launch, soft brake: distance stays deterministic without the donor's
  -- moving-origin snap near the end of the evade.
  local eased=1-(1-t)^3
  local position=e.startPosition:Lerp(targetPosition,eased)
  local delta=position-rootPart.Position
  travel(a,c,delta,delta.Magnitude)
  if e.direction.Magnitude&gt;.1 then rootPart.CFrame=CFrame.lookAt(rootPart.Position,rootPart.Position+e.direction) end
  rootPart.AssemblyLinearVelocity=Vector3.zero
 else a.evade=nil end
end
return Evade
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND23">
        <Properties>
          <string name="Name">Brawler</string>
          <ProtectedString name="Source">local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Attacks=require(Shared.Attacks)
local Motor=require(script.Parent.Motor)
local Bangla=require(script.Parent.BanglaCombat)
local Combo=require(Shared.BanglaCombo)
-- Adapter: reaction/air/grab mechanics missing from the donor; ground M1
-- progression and all strike hit volumes/damage/feedback run through Bangla.
local Brawler={}
local airReactions={Launched=true,Juggled=true,Knockback=true,Knockdown=true,WallSplat=true}
function Brawler.free(a,now)
 return a.reaction==nil or now&gt;=(a.reactionUntil or 0)
end
function Brawler.event(c,a,event)
 a.events=a.events or {};a.events[event]=(a.events[event] or 0)+1
 if c.match.onCombatEvent then c.match.onCombatEvent(a,event) end
end
function Brawler.releaseGrab(a)
 local b=a.grabVictim
 if b then b.grabbedBy=nil;b.reaction=nil;b.reactionUntil=0;a.grabVictim=nil end
 if a.grabbedBy then a.grabbedBy.grabVictim=nil;a.grabbedBy=nil end
end
function Brawler.react(c,a,kind,velocity,duration,source)
 Brawler.releaseGrab(a)
 Bangla.close(a.pending)
 a.reaction=kind;a.reactionUntil=c.now+duration;a.reactionVelocity=velocity
	 a.reactionSource=source
 a.pending=nil;a.buffered=nil;a.attackName=nil;a.guardHeld=false;a.state="Neutral";a.untilTime=c.now
 a.locomotion=Vector3.zero
 if airReactions[kind] then a.airborne=true end
 if kind=="Knockdown" then
  a.invulnerableUntil=c.now+duration+.24
  a.groundPose="Knockdown"
  -- Which side the body rolls onto, taken from the incoming direction.
  local from=a.hitFrom or Vector3.zAxis
  a.groundSide=if a.root.CFrame.RightVector:Dot(from)&gt;=0 then 1 else -1
 end
 if kind=="WallSplat" then a.groundPose="Splat" end
 if not airReactions[kind] then a.groundPose=nil end
end
function Brawler.start(c,a,name)
 Bangla.close(a.pending)
 local spec=table.clone(Attacks[name]);spec.travel*=a.def.CombatTravel or 1
	local profile=a.def.AttackProfile and a.def.AttackProfile[name]
	if profile then
		spec.startup*=profile.startup or 1;spec.active*=profile.active or 1;spec.recovery*=profile.recovery or 1;spec.travel*=profile.travel or 1
		spec.travelTime=spec.startup+spec.active;spec.range=profile.range or spec.range;spec.angle=profile.angle
		spec.chainTool=profile.chainTool;spec.impulse=Vector3.new(spec.impulse.X,profile.impulseY or spec.impulse.Y,profile.impulseZ or spec.impulse.Z)
	end
 a.buffered=nil
 a.queuedLight=nil
 a.attackVariant=nil
 a.attackSerial=(a.attackSerial or 0)+1
 a.attackName=name;a.attackStarted=c.now;a.hitConfirmed=false;a.chainOpen=false;a.chainAt=c.now+1e9;a.guardHeld=false
 local slamWindow=0
 if name=="Slam" then
  -- Size the descent so the active window provably ends on or near the floor.
  local drop=math.max(6,a.root.Position.Y-(c.match.origin.Y+3.4))
  -- 118 studs/s is the plunge speed the slam uses at runtime.
  slamWindow=math.clamp(drop/118,.28,1.1)
 end
 a.pending={kind="Brawl",name=name,spec=spec,hit=false,slamWindow=slamWindow}
 Bangla.begin(c,a,a.pending)
 a.travelRemaining=spec.travel
 local flat=a.root.CFrame.LookVector*Vector3.new(1,0,1)
 local delta=a.target.root.Position-a.root.Position;delta=delta*Vector3.new(1,0,1)
 if delta.Magnitude&gt;.1 and delta.Magnitude&lt;11 and flat:Dot(delta.Unit)&gt;.55 then flat=delta.Unit end
	local side=a.root.CFrame.RightVector*(spec.angle or 0)
	a.travelDirection=(flat+side).Unit;a.state="Startup";a.untilTime=c.now+spec.startup
 if name=="Air1" or name=="Air2" or name=="Slam" then a.airHold=c.now+spec.startup+math.max(spec.active,slamWindow)+spec.recovery+.18 end
 Brawler.event(c,a,name)
 return true
end
function Brawler.request(c,a,action)
 local relevant=action=="Attack" or action=="Heavy" or action=="Grab" or action=="ThrowUp"
 if not relevant then return nil end
 if not Brawler.free(a,c.now) then return false,"Reacting" end
 if a.wall then Motor.detach(a,c.now,false) end
 if a.grabVictim then
  if action=="Attack" or action=="Heavy" or action=="Grab" or action=="ThrowUp" then
   return Brawler.start(c,a,if action=="Heavy" or action=="ThrowUp" then "ThrowUp" else "Throw")
  end
 end
 local pending=a.pending
 local canChain=a.state=="Recovery" and a.chainOpen and c.now&gt;=(a.chainAt or 0)
 local canDash=a.state=="Dodging" and c.now&gt;=a.untilTime-.23
 -- Flying Thunder God arrival: the technique recovery is cancelled by a strike,
 -- so the teleport flows straight into an attack from the new angle.
 local canFlash=(a.state=="TechniqueRecovery" or a.state=="TechniqueActive") and (a.flashUntil or 0)&gt;c.now and a.pending==nil
 if canFlash then
  a.flashUntil=0;a.state="Neutral";a.untilTime=c.now
  local gap=(a.target.root.Position-a.root.Position).Magnitude
  if action=="Heavy" then
   if a.airborne then return Brawler.start(c,a,"Slam") end
   return Brawler.start(c,a,"Launcher")
  end
  if action=="Attack" then
   if a.airborne then a.airCombo=1;a.lastAirAttack=c.now;return Brawler.start(c,a,"Air1") end
   a.combo=1;a.lastAttack=c.now
   return Brawler.start(c,a,if gap&gt;5.5 then "DashAttack" else "Light1")
  end
 end
  if a.state~="Neutral" and a.state~="Guarding" and not canChain and not canDash then
   if pending and pending.kind=="Brawl" and a.hitConfirmed then
    -- Buffer the follow-up, but only behind a swing that actually connected.
    -- Waiting for the open chain felt sticky; buffering a whiffed swing would
    -- queue a phantom combo through a recovery the player is meant to respect.
    a.buffered={action=action,expires=c.now+.32}
    return true,"Buffered"
   end
   return false,"Committed"
  end
 if action=="Grab" then
  if a.airborne or (a.grabCooldown or 0)&gt;c.now then return false,"Grab unavailable" end
  a.grabCooldown=c.now+1.4;return Brawler.start(c,a,"Grab")
 end
 if action=="ThrowUp" then return false,"No grab" end
 if action=="Heavy" then
  if a.airborne then return Brawler.start(c,a,"Slam") end
  if canChain and a.combo&gt;=2 then a.combo=0;return Brawler.start(c,a,"Launcher") end
  return Brawler.start(c,a,"Heavy")
 end
 if a.airborne then
  a.airCombo=if c.now-(a.lastAirAttack or 0)&gt;.8 then 1 else (a.airCombo or 0)%2+1
  a.lastAirAttack=c.now;return Brawler.start(c,a,"Air"..a.airCombo)
 end
 -- The ground light step is resolved once per accepted press, so a buffered
 -- chain cannot advance the combo counter twice.
 local name=a.queuedLight
 if not name then
  name=Combo.next(a,c.now)
  a.queuedLight=name
 end
 return Brawler.start(c,a,if canDash then "DashAttack" else name)
end
function Brawler.stopStyle(p)
 if p.name=="Slam" then return "slam" end
 if p.name=="Launcher" or p.name=="ThrowUp" then return "launcher" end
 if p.name=="Heavy" or p.name=="Throw" or p.name=="Light3" then return "finisher" end
 if p.name=="Air1" or p.name=="Air2" then return "air" end
 return "light"
end
function Brawler.hit(c,a,p)
 local b=a.target;local spec=p.spec
 if p.name=="Throw" or p.name=="ThrowUp" then
  b=a.grabVictim
  if not b or b.health&lt;=0 then return false end
  Brawler.releaseGrab(a)
  local direction=if a.move.Magnitude&gt;.2 then a.move.Unit else a.root.CFrame.LookVector
  a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+direction)
 end
 local success,guarded,protected
 if p.name~="Throw" and p.name~="ThrowUp" then
	if p.spec.chainTool and not p.chainToolFired then
		p.chainToolFired=true;c:projectile(a,b.root.Position,88,11,2,"needle");Brawler.event(c,a,"ChainTool")
	end
  -- Grab has no donor damage action; donor contact volume still validates it.
  if p.name=="Grab" then
   if not c:targetValid(a,b,spec.range,.05) then return false end
   local donor=p.donor
   donor.hitbox.CFrame=a.root.CFrame*CFrame.new(0,0,-2)
   local params=OverlapParams.new();params.FilterType=Enum.RaycastFilterType.Include;params.FilterDescendantsInstances={b.model}
   if #workspace:GetPartBoundsInBox(donor.hitbox.CFrame,donor.hitbox.Size,params)==0 then return false end
  else
   success,guarded,protected=Bangla.tryHit(c,a,p)
   if not success then return false end
  end
 end
 if p.name=="Grab" then
  if b.invulnerableUntil&gt;c.now or b.grabbedBy or b.reaction=="Wakeup" then return false end
  Brawler.releaseGrab(b);b.pending=nil;b.state="Neutral";b.guardHeld=false
  b.lastHurt=c.now; b.reaction="Grabbed";b.reactionUntil=c.now+.8;b.grabbedBy=a;a.grabVictim=b
  a.grabUntil=c.now+.8;Brawler.event(c,a,"GrabHit");return true
 end
 if p.name=="Throw" or p.name=="ThrowUp" then
  success=c:damage(a,b,spec.damage*(a.def.CombatDamage or 1),false,true)
 end
 if not success or b.health&lt;=0 then return success end
 if protected then return true end
 if guarded then
	 c:applyHitstop(a,b,"block",false)
  Brawler.event(c,b,"GuardHit")
  if p.name=="Heavy" or p.name=="Slam" then b.chakra=math.max(0,b.chakra-25) end
  if b.chakra&lt;=0 then Brawler.react(c,b,"GuardStun",Vector3.zero,.6);b.guardHeld=false
	else
		b.guardImpact=c.now+.18
		local push=if p.name=="Heavy" or p.name=="Slam" or p.name=="Light3" then 1.15 else .42
		Motor.travel(b,c,a.root.CFrame.LookVector,push)
	end
  return true
 end
 local impulse=a.root.CFrame.LookVector*spec.impulse.Z+Vector3.yAxis*spec.impulse.Y
 -- Move-specific weight: a light jab must not stop the fight, a slam must land hard.
 c:applyHitstop(a,b,Brawler.stopStyle(p),false)
 Brawler.react(c,b,spec.reaction,impulse,spec.stun,a)
 if spec.reaction=="Launched" then a.pursuitUntil=c.now+1.15;Brawler.event(c,a,"LaunchHit") end
 if p.name=="Air1" or p.name=="Air2" then Brawler.event(c,a,"AirHit") end
 if p.name=="Slam" then Brawler.event(c,a,"SlamHit");a.airHold=0 end
 if p.name=="Throw" or p.name=="ThrowUp" then Brawler.event(c,a,"ThrowHit") end
 Brawler.event(c,a,"Hit");return true
end
function Brawler.step(c,a,dt)
 if a.buffered and c.now&gt;a.buffered.expires then a.buffered=nil end
 if a.grabVictim then
  local b=a.grabVictim
  if c.now&gt;=(a.grabUntil or 0) or a.health&lt;=0 or b.health&lt;=0 then Brawler.releaseGrab(a)
  else
   local pos=a.root.Position+a.root.CFrame.LookVector*2.6
   local delta=pos-b.root.Position
   local grip=b.root.Position+(if delta.Magnitude&gt;.001 then delta.Unit*math.min(delta.Magnitude,26*dt) else Vector3.zero)
   b.root.CFrame=CFrame.lookAt(grip,a.root.Position);b.root.AssemblyLinearVelocity=Vector3.zero;b.hum:Move(Vector3.zero)
  end
 end
 if a.reaction then
  if a.reaction=="Grabbed" then return true end
  if c.now&gt;=a.reactionUntil then
   if a.reaction=="Knockdown" or a.reaction=="WallSplat" then a.reaction="Wakeup";a.reactionUntil=c.now+.24;a.invulnerableUntil=c.now+.24
   else
    a.reaction=nil;a.reactionVelocity=nil
    -- Fully recovered: drop the grounded presentation state with it.
    a.groundPose=nil
   end
  end
  if a.reaction then
   a.hum:Move(Vector3.zero);a.root.AssemblyLinearVelocity=Vector3.zero
   local velocity=a.reactionVelocity or Vector3.zero
   if airReactions[a.reaction] then
    velocity+=Vector3.new(0,-75*dt,0)
    local hit=Motor.flight(a,c,velocity*dt)
    if hit then
     if hit.Normal.Y&gt;.5 and velocity.Y&lt;0 then
      if a.reaction=="Knockdown" then a.reactionUntil=math.min(a.reactionUntil,c.now+.55);Brawler.event(c,a,"LandedSlam") end
      -- The body is on the floor now: stop reporting it as airborne so the
      -- presentation plays the grounded pose instead of an air reaction.
      a.airborne=false
      a.landedAt=c.now
      velocity=Vector3.zero
     elseif math.abs(hit.Normal.Y)&lt;.2 and hit.Instance:GetAttribute("NinjaWall") then
			 a.reaction="WallSplat";a.reactionUntil=c.now+.42;velocity=hit.Normal*8;Brawler.event(c,a,"WallSplat")
			 a.groundPose="Splat"
			 c:pushImpact(hit.Position,"wall",false)
			 local source=a.reactionSource
			 if source and source.health&gt;0 then source.pursuitUntil=math.max(source.pursuitUntil or 0,c.now+.72);Brawler.event(c,source,"WallConvert");c:cue(source,"WALL CONVERT • PURSUE",.65) end
     end
    end
   else Motor.travel(a,c,velocity,velocity.Magnitude*dt);velocity*=math.exp(-dt*14) end
		 a.reactionVelocity=velocity;return true
  end
 end
 local p=a.pending
 if p and p.kind=="Brawl" then
  if a.state=="Active" and not p.hit then
   -- Re-check every active frame. A single early test used to mark the whole
   -- swing as a whiff, so a target that entered the volume one frame later
   -- took no damage from a visibly connected strike.
   p.hit=Brawler.hit(c,a,p) or nil;a.hitConfirmed=p.hit==true or a.hitConfirmed
  end
 end
	if a.buffered and c.now&lt;=a.buffered.expires and a.state=="Recovery" and a.chainOpen and c.now&gt;=a.chainAt then
  local action=a.buffered.action;a.buffered=nil;Brawler.request(c,a,action)
 end
 return false
end
return Brawler
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND24">
        <Properties>
          <string name="Name">Combat</string>
          <ProtectedString name="Source">local Shared = game:GetService("ReplicatedStorage").NinjaDuel
local Config = require(Shared.Config)
local Fighters = require(Shared.Fighters)
local Rules = require(Shared.Rules)
local World = require(script.Parent.World)
local Motor = require(script.Parent.Motor)
local Animation = require(script.Parent.Animation)
local Techniques = require(script.Parent.Techniques)
local Brawler = require(script.Parent.Brawler)
local Bangla = require(script.Parent.BanglaCombat)
local Evade = require(script.Parent.BanglaEvade)
local HitDetection = require(script.Parent.VelmoraHitDetection)
local Defense = require(script.Parent.VelmoraDefense)
local Combat = {}; Combat.__index = Combat
function Combat.new(match)
	return setmetatable({match=match,now=0,actors={},effects={},projectiles={},hazards={},historyAt=0,impacts={},impactSerial=0,projectileSerial=0},Combat)
end
-- Where a thrown or breathed object physically leaves the body. Server-side
-- approximation of the animated hand/mouth so the projectile's first frame is
-- where the throwing arm actually is, not the middle of the chest.
local LAUNCH={
	Kunai={side=1.15,up=.95,forward=1.1},MarkedKunai={side=1.15,up=1.05,forward=1.1},
	Shuriken={side=-1.1,up=.9,forward=1.2},Fireball={side=0,up=2.1,forward=2.6},Wind={side=.6,up=1,forward=2.2},
}
function Combat.launchPoint(a,kind)
	local spec=LAUNCH[kind] or {side=0,up=.6,forward=1.4}
	local cf=a.root.CFrame
	return cf.Position+cf.RightVector*spec.side+Vector3.yAxis*spec.up+cf.LookVector*spec.forward
end
function Combat:add(id,model,hum,root,joints,definition)
	local def = Fighters[definition]
	local a = { id=id,fighterId=definition,model=model,hum=hum,root=root,joints=joints,def=def,health=def.Health,
		chakra=def.Chakra or Config.Chakra,state="Neutral",untilTime=0,lockUntil=0,cooldowns={},move=Vector3.zero,
		combo=0,lastAttack=-10,readUntil=0,illusionUntil=0,bonusUntil=0,dodgeUntil=0,invulnerableUntil=0,
		color=Color3.fromRGB(table.unpack(def.Color)),guardHeld=false,lastMove=0, cue="",cueUntil=0,
		locomotion=Vector3.zero,sprinting=false,airborne=false,airDodgeUsed=false,landUntil=0,
		pursuitUntil=0,travelRemaining=0,travelDirection=Vector3.zero,chainOpen=false,hitConfirmed=false,airHold=0,
		subCharges=Config.Substitution.Charges,subCooldown=0,lastHurt=-10,neutralToolAt=0,wall=nil,wallNext=0 }
	table.insert(self.actors,a)
	Defense.init(a)
	Animation.attach(a)
	return a
end
function Combat:clamp(p)
	local o=self.match.origin; local r=Config.ArenaRadius
	return Vector3.new(math.clamp(p.X,o.X-r,o.X+r),math.clamp(p.Y,o.Y+3,o.Y+Config.ArenaHeight),math.clamp(p.Z,o.Z-r,o.Z+r))
end
function Combat:relocate(a,p)
	local look=a.root.CFrame.LookVector
	a.model:PivotTo(CFrame.lookAt(self:clamp(p),self:clamp(p)+Vector3.new(look.X,0,look.Z)))
	a.root.AssemblyLinearVelocity=Vector3.zero
end
function Combat:rayParams(excludeActors)
	local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude
	local exclude={self.match.effects}
	if excludeActors then for _,a in self.actors do table.insert(exclude,a.model) end end
	params.FilterDescendantsInstances=exclude
	return params
end
function Combat:overlapParams()
	local p=OverlapParams.new(); p.FilterType=Enum.RaycastFilterType.Exclude
	local exclude={self.match.effects}; for _,a in self.actors do table.insert(exclude,a.model) end
	p.FilterDescendantsInstances=exclude; return p
end
function Combat:lineOfSight(a,b)
	local delta=b.root.Position-a.root.Position
	return workspace:Raycast(a.root.Position,delta,self:rayParams(true)) == nil
end
function Combat:targetValid(a,b,range,facing)
	if not b or b.health&lt;=0 then return false end
	local roots={};for _,candidate in self.actors do table.insert(roots,candidate.root) end
	local angle=math.deg(math.acos(math.clamp(facing,-1,1)))
	-- Resolve each active-window sample against the newest recorded pose; the short
	-- history keeps interpolation stable without freezing a target at button-down.
	local root=HitDetection.resolve(a.root,range,angle,a.root.Position,a.root.CFrame.LookVector,self.now,roots,self.match.effects)
	return root==b.root
end
-- Server effects are logical markers only (anchor, echo, hitbox lifetimes).
-- Everything the player sees is drawn by the client from the snapshot and the
-- contact feed; the old translucent neon blocks read as debug geometry.
function Combat:effect(name,p,color,size,lifetime)
	local v=World.part(self.match.effects,name,size,CFrame.new(p),color,Enum.Material.Neon)
	v.CanCollide=false; v.CanQuery=false; v.CanTouch=false; v.Transparency=1; v.CastShadow=false
	table.insert(self.effects,{part=v,expires=self.now+lifetime})
	return v
end
function Combat:addHazard(a,position,radius,duration,damage,kind)
	local hazard={a=a,position=position,radius=radius,expires=self.now+duration,damage=damage,kind=kind,lastHit={}}
	table.insert(self.hazards,hazard)
	return hazard
end
-- Hitstop budget by impact weight. Only the defender stops, and only briefly:
-- freezing both actors on every light made a normal combo read as
-- move -&gt; stop -&gt; move -&gt; stop.
local HITSTOP={light=0,air=0,block=.01,finisher=.03,launcher=.04,parry=.05,slam=.065,jutsu=.055,default=.02}
Combat.Hitstop=HITSTOP
function Combat:applyHitstop(attacker,victim,style,heavy)
	local stop=HITSTOP[style] or (if heavy then HITSTOP.default else 0)
	if stop&lt;=0 then return stop end
	victim.hitstopUntil=math.max(victim.hitstopUntil or 0,self.now+stop)
	-- The attacker only joins on a genuinely heavy contact.
	if heavy then attacker.hitstopUntil=math.max(attacker.hitstopUntil or 0,self.now+stop*.5) end
	return stop
end
-- Short feed of contacts that actually happened. Snapshots carry it so the
-- client can layer sound and VFX on the real contact frame, never on the press.
function Combat:pushImpact(position,style,heavy,extra)
	local feed=self.impacts or {}
	self.impacts=feed
	self.impactSerial=(self.impactSerial or 0)+1
	local role="neutral"
	for _,actor in self.actors do
		if actor.root and (actor.root.Position-position).Magnitude&lt;4.5 then
			role=if actor.health&gt;0 then "victim" else "neutral"
			break
		end
	end
	local entry={style=style,at=self.now,position=position,heavy=heavy==true,serial=self.impactSerial,role=role}
	-- Optional context (projectile id, surface normal, teleport endpoints, owner)
	-- so the client can finish the exact object it was drawing.
	if extra then for k,v in extra do entry[k]=v end end
	table.insert(feed,entry)
	while #feed&gt;12 do table.remove(feed,1) end
	-- Contacts are worth a snapshot now rather than at the next 50 ms tick.
	self.urgent=true
	return self.impactSerial
end
function Combat:cue(a,message,duration)
	a.cue=message; a.cueUntil=self.now+(duration or 1.1)
	if self.match.onCue then self.match.onCue(a,message) end
end
function Combat:setState(a,state,duration)
	a.state=state; a.untilTime=self.now+duration
end
function Combat:damage(attacker,victim,amount,heavy,readEligible)
	if self.match.phase~="Duel" or victim.health&lt;=0 or attacker.health&lt;=0 then return false end
	if victim.wall then Motor.detach(victim,self.now,false) end
	local delta=attacker.root.Position-victim.root.Position
	local frontal=delta.Magnitude&lt;0.1 or victim.root.CFrame.LookVector:Dot(delta.Unit)&gt;0.15
	if readEligible and frontal and victim.readUntil&gt;self.now then
		victim.readUntil=0; victim.bonusUntil=self.now+1.4; victim.chakra=math.min(victim.def.Chakra or Config.Chakra,victim.chakra+10)
		attacker.pending=nil; self:setState(attacker,"Stunned",0.48)
		self:setState(victim,"Neutral",0)
		self:cue(victim,"READ SUCCESS • PUNISH"); self:cue(attacker,"READ • EXPOSED")
		return false
	end
	local outcome,resolved=Defense.resolve(self,attacker,victim,amount,frontal)
	if outcome=="Evaded" then Brawler.event(self,victim,"Evaded");self:cue(victim,"EVADED");return false end
	if outcome=="Parried" then
		Brawler.event(self,victim,"Parry");Brawler.event(self,attacker,"Parried")
		victim.impactStyle="parry";victim.impactAt=self.now
		self:pushImpact(victim.root.Position,"parry",false)
		self:effect("Parry",victim.root.Position,Color3.fromRGB(255,236,145),Vector3.new(3.8,3.8,3.8),.16)
		return false
	end
	amount=resolved
	local guarded=outcome=="Blocked"
	if guarded then
		self:cue(victim,"GUARDED")
	else
		local interrupted=Rules.interruptible(victim)
		local protected= victim.state=="TechniqueChannel" and victim.pending and not victim.pending.spec.Interruptible
		if not protected then
			Brawler.releaseGrab(victim)
			victim.pending=nil; victim.readUntil=0; victim.guardHeld=false
			if outcome~="GuardBreak" then self:setState(victim,"Stunned",if interrupted then Config.InterruptStun else Config.HitStun) end
			if interrupted then Brawler.event(self,attacker,"Interrupt"); self:cue(victim,"INTERRUPTED"); self:cue(attacker,"CHANNEL INTERRUPTED") end
		end
	end
	if attacker.bonusUntil&gt;self.now then amount*=1.35; attacker.bonusUntil=0 end
	victim.lastHurt=self.now
	victim.health=math.max(0,victim.health-amount); victim.hum.Health=victim.health
	victim.impactSerial=(victim.impactSerial or 0)+1; victim.impactHeavy=heavy or amount&gt;=12
	local style=(if guarded then "block" elseif heavy and amount&gt;=16 then "slam" elseif heavy then "launcher" elseif amount&gt;=20 then "finisher" else "light")
	victim.impactStyle=style
	victim.impactAt=self.now
	-- Direction and weight of the contact so the victim's body can answer the
	-- hit it actually took instead of playing one generic recoil.
	local toward=Vector3.new(delta.X,0,delta.Z)
	if toward.Magnitude&gt;.05 then
		victim.hitFrom=toward.Unit
		local facing=Vector3.new(victim.root.CFrame.LookVector.X,0,victim.root.CFrame.LookVector.Z)
		if facing.Magnitude&gt;.05 then
			facing=facing.Unit
			victim.hitAngle=math.deg(math.atan2(facing:Cross(victim.hitFrom).Y,facing:Dot(victim.hitFrom)))
		else
			victim.hitAngle=0
		end
	else
		victim.hitFrom=Vector3.zAxis
		victim.hitAngle=0
	end
	victim.hitStrength=math.clamp(amount/26,0,1)
	-- Seed the stop; Brawler adds the exact per-move weight once it knows the move.
	self:applyHitstop(attacker,victim,style,heavy)
	self:pushImpact(victim.root.Position,style,victim.impactHeavy)
	Brawler.event(self,attacker,"Damage"); if guarded then Brawler.event(self,victim,"GuardHit") end
	self:effect("Impact",victim.root.Position,if guarded then Color3.fromRGB(221,203,152) else attacker.color,Vector3.new(2,2,2),0.12)
	if heavy and not guarded and victim.health&gt;0 then
		attacker.pursuitUntil=self.now+Config.PursuitWindow
		self:cue(attacker,"LAUNCH • E TO PURSUE",Config.PursuitWindow)
		local push=Vector3.new(-delta.X,0,-delta.Z)
		if push.Magnitude&gt;0.1 then Brawler.react(self,victim,"Launched",push.Unit*22+Vector3.new(0,42,0),.9) end
	end
	if victim.health&lt;=0 then
		Brawler.releaseGrab(victim); victim.reaction=nil
		victim.state="Defeated"; victim.pending=nil; victim.move=Vector3.zero
		-- Remember the blow that ended it so the KO body matches the final hit.
		victim.koStyle=style
		victim.koAirborne=victim.airborne==true
		self.match.finish(attacker,victim)
	end
	attacker.hitConfirmed=true
	return true
end
function Combat:strike(a,damage,range,facing,heavy)
	if self:targetValid(a,a.target,range,facing) then return self:damage(a,a.target,damage,heavy,true) end
	return false
end
-- Projectile kinds: "kunai", "marked" (Minato's seal kunai), "shuriken",
-- "fireball" and "wind". Legacy names ("blade", "needle", "tool") still work.
local KIND_ALIAS={blade="marked",needle="shuriken",tool="kunai"}
local LAUNCH_FOR={kunai="Kunai",marked="MarkedKunai",shuriken="Shuriken",fireball="Fireball",wind="Wind"}
-- Straight, constant-speed flights: the client reproduces the exact path from
-- (origin, direction, speed, born) and only needs the end event from the feed.
function Combat:projectile(a,aim,speed,range,damage,kind,onSurface,opts)
	opts=opts or {}
	kind=KIND_ALIAS[kind] or kind
	local start=opts.origin or Combat.launchPoint(a,LAUNCH_FOR[kind] or "Kunai")
	local delta=aim-start
	if delta.Magnitude&lt;0.1 then delta=a.root.CFrame.LookVector end
	self.projectileSerial=(self.projectileSerial or 0)+1
	local p={id=self.projectileSerial,a=a,origin=start,position=start,direction=delta.Unit,speed=speed,range=range,remaining=range,
		damage=damage,onSurface=onSurface,kind=kind,born=self.now,radius=opts.radius or 0,growth=opts.growth or 0,
		reaction=opts.reaction,impulse=opts.impulse,explode=opts.explode,heavy=opts.heavy}
	table.insert(self.projectiles,p)
	self.urgent=true
	return p
end
function Combat:removeProjectile(p)
	for i=#self.projectiles,1,-1 do
		if self.projectiles[i]==p then table.remove(self.projectiles,i) end
	end
end
-- The marked kunai that is still travelling, if any: Minato can relocate onto
-- it mid-flight, which is the whole point of the seal.
function Combat:markedInFlight(a)
	for _,p in self.projectiles do
		if p.a==a and p.kind=="marked" then return p end
	end
	return nil
end
-- Throws keep the thrower in Neutral so locomotion continues: the arm releases
-- on its authored frame while the legs keep running.
function Combat:beginThrow(a,spec)
	a.throwSerial=(a.throwSerial or 0)+1
	a.throwing={kind=spec.kind,started=self.now,release=self.now+spec.release,nextRelease=self.now+spec.release,
		count=spec.count or 1,fired=0,interval=spec.interval or .07,aim=spec.aim,fire=spec.fire,serial=a.throwSerial}
	a.throwKind=spec.kind;a.throwStarted=self.now;a.throwRelease=spec.release
	self.urgent=true
end
function Combat:stepThrow(a)
	local throw=a.throwing
	if not throw then return end
	if a.health&lt;=0 or a.reaction or a.state=="Stunned" or a.state=="Defeated" or a.state=="Dodging" then
		a.throwing=nil;return
	end
	while a.throwing==throw and self.now&gt;=throw.nextRelease and throw.fired&lt;throw.count do
		throw.fired+=1
		-- Re-aim at release against the live target, unless an explicit point was
		-- chosen: a throw tracks the opponent the arm is actually throwing at.
		local aim=throw.aim or (a.target and a.target.root.Position) or (a.root.Position+a.root.CFrame.LookVector*20)
		throw.fire(throw.fired,aim)
		throw.nextRelease+=throw.interval
	end
	if a.throwing==throw and throw.fired&gt;=throw.count then a.throwing=nil end
end
function Combat:request(a,action,aim,clientTime)
	if self.match.phase~="Duel" or a.health&lt;=0 then return false,"No duel" end
	if action=="GuardOff" then
		Defense.guard(a,false,self.now)
		if a.state=="Guarding" then self:setState(a,"Neutral",0) end
		return true
	end
	if action=="JumpOff" then
		if a.airborne and a.root.AssemblyLinearVelocity.Y&gt;22 and self.now&lt;(a.takeoffUntil or 0)+0.18 then
			local v=a.root.AssemblyLinearVelocity
			a.root.AssemblyLinearVelocity=Vector3.new(v.X,v.Y*0.66,v.Z)
		end
		return true
	end
	if action=="WallDetach" then Motor.detach(a,self.now,false); return true end
	if action=="Dodge" and not Brawler.free(a,self.now) then action="Substitute" end
	if action=="Substitute" then
		local tune=Config.Substitution
		if a.subCharges&lt;=0 or self.now&lt;a.subCooldown then return false,"No substitution" end
		if a.chakra&lt;tune.Cost then return false,"Need chakra" end
		if self.now-a.lastHurt&gt;tune.Window or (a.state~="Stunned" and Brawler.free(a,self.now)) then return false,"No escape window" end
		local away=a.root.Position-a.target.root.Position
		away=Vector3.new(away.X,0,away.Z)
		if away.Magnitude&lt;0.1 then away=a.root.CFrame.RightVector end
		local departure=a.root.Position
		local moved=Motor.travel(a,self,away,tune.Distance)
		if moved&lt;2 then return false,"Escape blocked" end
		a.subCharges-=1; a.chakra-=tune.Cost; a.subCooldown=self.now+tune.Cooldown
		a.subUntil=self.now+0.17
		Brawler.releaseGrab(a); a.reaction=nil; a.reactionVelocity=nil; a.airHold=0; a.throwing=nil
		Brawler.event(self,a,"Substitute"); a.pending=nil; a.guardHeld=false; a.invulnerableUntil=self.now+0.16
		self:setState(a,"Recovery",0.16)
		self:pushImpact(departure,"substitute",false,{owner=a.id,fighter=a.fighterId,to=a.root.Position})
		self:effect("Afterimage",departure,a.color,Vector3.new(2,4,2),0.35)
		self:effect("Substitution",a.root.Position,a.color,Vector3.new(3,4,3),0.25)
		self:cue(a,"SUBSTITUTION • REPOSITIONED")
		return true
	end
	if action=="Feint" then
		local pending=a.pending
		if a.state=="Startup" and pending and pending.kind=="Brawl" and pending.name=="Heavy" and self.now-a.attackStarted&lt;=pending.spec.startup*.62 then
			Bangla.close(pending);a.pending=nil;a.attackName=nil;a.travelRemaining=0;a.chakra=math.max(0,a.chakra-4)
			self:setState(a,"Recovery",.09);self:cue(a,"HEAVY FEINT • MOVE");Brawler.event(self,a,"Feint")
			return true
		end
		if a.state~="TechniqueChannel" or not pending or not pending.spec.Feintable then return false,"No feint window" end
		if self.now&gt;a.untilTime-pending.spec.Channel*0.5 then return false,"Feint too late" end
		a.chakra=math.min(a.def.Chakra or Config.Chakra,a.chakra+pending.spec.Cost*0.35)
		a.pending=nil; self:setState(a,"Recovery",0.24); self:cue(a,"FEINT • CHAKRA PARTIAL")
		return true
	end
	-- The throwing arm owns the body until the blade leaves the hand; after the
	-- release the follow-up is free, which is what lets a kunai lead a rush.
	local throwHeld=a.throwing and self.now&lt;a.throwing.release
	if throwHeld and (action=="Attack" or action=="Heavy" or action=="Grab" or action=="Tool" or string.match(action,"^Technique")) then
		return false,"Committed"
	end
	if action=="Attack" and a.state=="Recovery" and a.chainOpen and self.now&gt;=(a.chainAt or 0) and a.queuedLight==nil then
		-- A buffered press is resolved when it actually chains, never when it was
		-- first pressed, so the light progression advances exactly once per hit.
		a.queuedLight=require(Shared.BanglaCombo).next(a,self.now)
	end
	if action=="Attack" or action=="Heavy" or action=="Grab" then a.attackCommitTime=clientTime or self.now end
	local handled,reason=Brawler.request(self,a,action)
	if handled~=nil then return handled,reason end
	if not Brawler.free(a,self.now) then return false,"Reacting" end
	if (action=="Guard" or action=="Dodge") and a.state=="Recovery" and self.now&gt;=(a.recoveryCancelAt or math.huge) then
		a.pending=nil;self:setState(a,"Neutral",0)
	end
	if action=="Pursuit" then
		if a.pursuitUntil&lt;=self.now or a.target.health&lt;=0 then return false,"No pursuit" end
		if a.chakra&lt;Config.PursuitCost then return false,"Need chakra" end
		if (a.target.root.Position-a.root.Position).Magnitude&gt;Config.PursuitRange then return false,"Too far" end
		local launchCancel=a.attackName=="Launcher" and a.hitConfirmed and (a.state=="Active" or a.state=="Recovery")
		if a.state~="Neutral" and a.state~="Recovery" and a.state~="TechniqueRecovery" and not launchCancel then return false,"Committed" end
		if launchCancel then Bangla.close(a.pending);a.pending=nil;a.hitstopUntil=0 end
		a.chakra-=Config.PursuitCost; a.pursuitUntil=0
		a.reaction=nil; a.airborne=true; a.airHold=self.now+.75
		a.pursuitStarted=self.now
		Brawler.event(self,a,"Chase")
		self:setState(a,"Pursuit",0.24)
		self:effect("Pursuit",a.root.Position,a.color,Vector3.new(2,4,2),0.35)
		self:pushImpact(a.root.Position,"chase",false,{owner=a.id,fighter=a.fighterId})
		return true
	end
	if action=="Jump" then
		if a.wall then Motor.detach(a,self.now,true); return true end
		if a.state~="Neutral" and a.state~="Recovery" then return false,"Committed" end
		return Motor.jump(a,self,self.now),"Airborne"
	end
	if action=="Tool" then
		local chainCancel=a.def.ComboToolCancel and a.state=="Recovery" and a.chainOpen and self.now&gt;=(a.chainAt or 0)
		if (not chainCancel and not Rules.canAct(a,self.now)) or self.now&lt;a.neutralToolAt then return false,"Tool recovering" end
		if a.throwing then return false,"Throwing" end
		if chainCancel then a.pending=nil;a.attackName=nil;a.chainOpen=false;self:setState(a,"Neutral",0);Brawler.event(self,a,"ChainTool") end
		if a.wall then Motor.detach(a,self.now,false) end
		local minato=a.def.Name=="Minato"
		a.neutralToolAt=self.now+(if chainCancel then .42 elseif minato then .55 else .75)
		local range=if chainCancel then 20 else 44
		-- Minato: one fast kunai from the right hand. Itachi: a precise left-hand
		-- pair of shuriken. Both keep running while the arm throws.
		self:beginThrow(a,{kind=if minato then "Kunai" else "Shuriken",release=if minato then .1 else .13,
			count=if minato then 1 else 2,interval=.08,aim=aim,
			fire=function(index,target)
				local spread=if minato then Vector3.zero else a.root.CFrame.RightVector*(if index==1 then -.9 else .9)
				self:projectile(a,target+spread,if minato then 96 else 84,range,if minato then 4 else 3,if minato then "kunai" else "shuriken")
			end})
		self:cue(a,if chainCancel then "CHAIN TOOL • KEEP PRESSURE" else (if minato then "KUNAI" else "SHURIKEN"))
		return true
	end
	local chain=action=="Attack" and a.state=="Recovery" and a.chainOpen and self.now&gt;a.chainAt
	if not chain and not Rules.canAct(a,self.now) then return false,"Committed" end
	if action=="Guard" then Brawler.event(self,a,"Guard");Defense.guard(a,true,self.now);self:setState(a,"Guarding",0);return true end
	if action=="Dodge" then
		if a.chakra&lt;Config.DodgeCost then return false,"Need chakra" end
		if a.airborne and a.airDodgeUsed then return false,"Air dodge used" end
		if a.dodgeUntil&gt;self.now then return false,"Cooldown" end
		a.chakra-=Config.DodgeCost; a.dodgeUntil=self.now+Config.DodgeCooldown
		if a.wall then Motor.detach(a,self.now,false) end
		if a.airborne then a.airDodgeUsed=true end
		a.dodgeDirection=if a.move.Magnitude&gt;0.1 then a.move.Unit else a.root.CFrame.RightVector
		a.invulnerableUntil=self.now+Config.DodgeIFrames;Defense.guard(a,false,self.now);Defense.dodge(a,self.now)
		Evade.begin(a,self)
		self:pushImpact(a.root.Position,"dodge",false)
		Brawler.event(self,a,"Dodge"); self:setState(a,"Dodging",Config.DodgeTime); self:effect("Dodge",a.root.Position,a.color,Vector3.new(2,4,1),0.2)
		return true
	end
	if self.match.techniquesDisabled then return false,"Techniques disabled" end
	local slot=tonumber(string.match(action,"^Technique([1-5])$"))
	local spec=slot and a.def.Techniques[slot]
 if spec and (a.trainingChannelScale or 1)~=1 then spec=table.clone(spec);spec.Channel*=a.trainingChannelScale end
	if not spec then return false,"Unknown action" end
	local technique=Techniques[spec.Id]
	local ok,reason=Rules.technique(a,spec,self.now,technique.check(self,a,spec,self.now))
	if not ok then return false,reason end
	if a.wall then Motor.detach(a,self.now,false) end
	if spec.Mobile then
		-- A thrown technique (Minato's marked kunai): chakra and cooldown are
		-- committed now, but the body stays in Neutral so the legs keep moving
		-- while the arm throws; the payoff fires on the release frame.
		Brawler.event(self,a,"Technique"); a.chakra-=spec.Cost; a.cooldowns[spec.Id]=self.now+spec.Cooldown; a.guardHeld=false
		a.castId=spec.Id;a.castStarted=self.now
		local pending={kind="Technique",spec=spec,implementation=technique,aim=aim}
		self:beginThrow(a,{kind=spec.Throw or "MarkedKunai",release=spec.Channel,count=1,aim=aim,fire=function(_,target)
			pending.aim=target
			technique.execute(self,a,pending,self.now)
			Brawler.event(self,a,"TechniqueResolved")
		end})
		self:cue(a,spec.Name,.6)
		return true
	end
	Brawler.event(self,a,"Technique"); Rules.reserve(a,spec,self.now); a.guardHeld=false
	a.pending={kind="Technique",spec=spec,implementation=technique,aim=aim or a.target.root.Position}
	a.castId=spec.Id;a.castStarted=self.now
	local offset=a.pending.aim-a.root.Position
	local flat=Vector3.new(offset.X,0,offset.Z)
	if flat.Magnitude&gt;0.1 then a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+flat) end
	self:cue(a,spec.Name.." • PREPARING",spec.Channel)
	self:effect("Channel",a.root.Position-Vector3.new(0,2.8,0),a.color,Vector3.new(4,0.12,4),spec.Channel)
	self:pushImpact(a.root.Position,"cast",false,{owner=a.id,fighter=a.fighterId,technique=spec.Id,channel=spec.Channel})
	return true
end
function Combat:updateActor(a,dt)
	local now=self.now
	if a.health&lt;=0 then a.hum:Move(Vector3.zero); return end
	-- Movement intents last exactly one frame; each control block re-declares its own.
	a.aimIntent=nil
	Defense.step(self,a,dt,now)
	if a.anchor and a.anchor.expires&lt;=now then a.anchor.part:Destroy(); a.anchor=nil end
	if a.illusionUntil&lt;=now then a.decoyPosition=nil end
	if a.state~="TechniqueChannel" and a.state~="Stunned" then
		a.chakra=math.min(a.def.Chakra or Config.Chakra,a.chakra+(a.def.ChakraRegen or Config.ChakraRegen)*dt)
	end
	if now&lt;(a.hitstopUntil or 0) then
		-- Weight, not a pause: the swing clock keeps running so the animation never
		-- drifts behind the hitbox, and only the frozen body is held still.
		a.hum:Move(Vector3.zero)
		if a.reaction then a.root.AssemblyLinearVelocity=Vector3.zero end
		World.pose(a,now,dt);return
	end
	if a.state~="Neutral" and a.state~="Guarding" and a.untilTime&lt;=now then
		local pending=a.pending
		if a.state=="Startup" and pending then
			-- The slam's active window is its sized descent; everything else uses
			-- the authored active duration.
			self:setState(a,"Active",if pending.slamWindow and pending.slamWindow&gt;0 then pending.slamWindow else pending.spec.active)
		elseif a.state=="Active" then
			Bangla.close(pending)
			-- A committed swing that never touched anything: report the whiff so
			-- the client can answer with air movement instead of silence.
			if pending and pending.kind=="Brawl" and not a.hitConfirmed then
				self:pushImpact(a.root.Position+a.root.CFrame.LookVector*2.2,"whiff",false)
			end
			local recovery=if pending then pending.spec.recovery else .22
			a.pending=nil; self:setState(a,"Recovery",recovery)
			a.chainOpen=a.hitConfirmed and pending and pending.kind=="Brawl" and pending.spec.chain==true
			a.chainAt=now
			local whiffHeavy=pending and pending.kind=="Brawl" and pending.name=="Heavy" and not a.hitConfirmed
			a.recoveryCancelAt=if whiffHeavy then a.untilTime else now+recovery*(if a.hitConfirmed then .36 else .72)
		elseif a.state=="TechniqueChannel" and pending then
			-- State changes before payoff so simultaneous channels resolve deterministically.
			self:setState(a,"TechniqueActive",pending.spec.Active)
			pending.implementation.execute(self,a,pending,now)
			Brawler.event(self,a,"TechniqueResolved")
		elseif a.state=="TechniqueActive" and pending then
			a.pending=nil; self:setState(a,"TechniqueRecovery",pending.spec.Recovery)
		else
			a.pending=nil;a.attackName=nil; self:setState(a,"Neutral",0)
		end
	end
	if self.match.phase~="Duel" then a.hum:Move(Vector3.zero); return end
 if a.state~="Dodging" then a.evade=nil end
	self:stepThrow(a)
	if a.castId and not a.pending and not a.throwing and a.state~="TechniqueRecovery" then a.castId=nil end
	if Brawler.step(self,a,dt) then World.pose(a,now,dt); return end
	if a.locked and (a.state=="Neutral" or a.state=="Guarding") then
		a.hum.AutoRotate=false
		local toward=a.target.root.Position-a.root.Position; toward=Vector3.new(toward.X,0,toward.Z)
		if toward.Magnitude&gt;0.1 then a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+toward) end
	else a.hum.AutoRotate=not a.locked end
	if a.state=="Dodging" then
		Evade.step(a,self,Motor.travel)
	elseif a.state=="Pursuit" then
		-- Reach a rising victim in three dimensions, but kinetically: the chase
		-- keeps a continuous velocity instead of being teleported frame by frame.
		local elapsed=now-(a.pursuitStarted or now)
		local remaining=math.max(.02,.24-elapsed)
		local toTarget=a.target.root.Position-a.root.Position
		local grab=toTarget+a.target.root.AssemblyLinearVelocity*remaining*.6
		local close=a.target.root.Position-a.root.Position
		local point=if grab.Magnitude&gt;3.2 then grab-grab.Unit*3
			else close-close.Unit*3
		if point.Magnitude&gt;.05 then
			-- Reach the window in time, then brake on approach so the chaser never
			-- overshoots its own target and snaps back.
			local speed=math.clamp(point.Magnitude/math.max(remaining,.06),70,420)
			local distance=close.Magnitude
			if distance&lt;7 then speed=math.min(speed,40+distance*distance*2.4) end
			a.aimIntent={target=a.root.Position+point,speed=speed,acceleration=1400}
		end
	elseif a.state=="Active" and a.pending and a.pending.kind=="Brawl" and a.attackName=="Slam" then
  -- The slam owns a continuous plunge: a constant downward velocity with bounded
  -- acceleration, plus a gentle drift onto the victim. No per-frame correction.
  local delta=a.target.root.Position-a.root.Position
  local horizontal=Vector3.new(delta.X,0,delta.Z)
  if horizontal.Magnitude&gt;2.7 then
   Motor.move(a,self,{target=a.root.Position+horizontal-horizontal.Unit*2.7,speed=42,acceleration=220},dt)
  end
  if a.airborne then
   local landed=Motor.descend(a,self,118,dt)
   if landed or a.root.Position.Y&lt;=self.match.origin.Y+3.6 then
    a.hum:ChangeState(Enum.HumanoidStateType.Landed)
    a.airborne=false;a.airHold=0
    a.root.AssemblyLinearVelocity=Vector3.zero
   end
  end
	elseif (a.state=="Startup" or a.state=="Active") and a.pending and a.pending.kind=="Brawl" and (a.attackName=="Air1" or a.attackName=="Air2") then
  local delta=a.target.root.Position-a.root.Position
  if delta.Magnitude&lt;10 and self:lineOfSight(a,a.target) then
		 local horizontal=Vector3.new(delta.X,0,delta.Z)
		 local planar=if horizontal.Magnitude&gt;2.7 then horizontal.Unit*math.min(horizontal.Magnitude-2.7,30*dt) else Vector3.zero
		 local vertical=math.clamp(delta.Y,-48*dt,48*dt)
		 if math.abs(delta.Y)&lt;.45 then vertical=0 end
		 local correction=planar+Vector3.new(0,vertical,0)
   Motor.flight(a,self,correction)
  end
 elseif (a.state=="Startup" or a.state=="Active") and a.pending and a.pending.kind=="Brawl" and a.travelRemaining&gt;0 then
		local toTarget=a.target.root.Position-a.root.Position
		local flatTarget=Vector3.new(toTarget.X,0,toTarget.Z)
		if flatTarget.Magnitude&gt;2.6 then
			local elapsed=now-(a.attackStarted or now)
			local progress=math.clamp(elapsed/a.pending.spec.travelTime,0,1)
			local drive=.32+1.18*math.sin(progress*math.pi)
			if flatTarget.Magnitude&gt;.1 then a.travelDirection=(a.travelDirection:Lerp(flatTarget.Unit,math.min(1,dt*10))).Unit end
			local distance=math.min(a.travelRemaining,a.pending.spec.travel*drive*dt/a.pending.spec.travelTime,flatTarget.Magnitude-2.6)
			a.travelRemaining-=Motor.travel(a,self,a.travelDirection,distance)
		end
	end
 local attack=a.pending
 if attack and attack.kind=="Brawl" and (a.state=="Startup" or a.state=="Active") then
  local delta=a.target.root.Position-a.root.Position
  local flat=Vector3.new(delta.X,0,delta.Z)
  if flat.Magnitude&gt;2 and flat.Magnitude&lt;9 then
   local tangent=Vector3.new(-flat.Z,0,flat.X).Unit
   local spec=attack.spec
   if a.fighterId=="Flashstep" and spec.angle then
    Motor.travel(a,self,tangent*(if spec.angle&lt;0 then -1 else 1),dt*(if a.airborne then 9 else 7))
   elseif a.fighterId=="Mirage" and a.state=="Active" and a.hitConfirmed and (attack.name=="Light3" or attack.name=="Air2") then
    Motor.travel(a,self,-flat,dt*9)
   end
   a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+flat)
  end
 end
	if a.landedAtSerial~=a.model:GetAttribute("MovementLandedAt") then
		a.landedAtSerial=a.model:GetAttribute("MovementLandedAt")
		if a.landedAtSerial then self:pushImpact(a.root.Position,"landing",false) end
	end
	if a.aimIntent then
		-- Chase, slam drift and any other aimed motion outrank the hover window;
		-- hovering exists to hold a fighter still, never to cancel their movement.
		Motor.step(a,self,dt,now)
	elseif now&lt;(a.airHold or 0) and a.airborne then
		a.root.AssemblyLinearVelocity=Vector3.zero; a.hum:Move(Vector3.zero)
	else Motor.step(a,self,dt,now) end
	-- Server-owned humanoids + server-clamped arena coordinates.
	local p=a.root.Position
	if math.abs(p.X-self.match.origin.X)&gt;Config.ArenaRadius or math.abs(p.Z-self.match.origin.Z)&gt;Config.ArenaRadius or p.Y&lt;self.match.origin.Y-3 then self:relocate(a,p) end
	World.pose(a,now,dt)
end
local IMPACT_STYLE={kunai="kunai",marked="kunai",shuriken="shuriken",wind="jutsu",fireball="fire"}
local function closestOnSegment(a,b,point)
	local ab=b-a
	local length=ab:Dot(ab)
	if length&lt;1e-6 then return a end
	return a+ab*math.clamp((point-a):Dot(ab)/length,0,1)
end
-- A Katon blast: the impact flash, a short splash, then flames that keep the
-- ground dangerous for a moment.
function Combat:fireExplosion(p,position,direct)
	local target=p.a.target
	self:addHazard(p.a,position,5.5,1.5,p.damage*.6,"Fire")
	if not direct and target and target.health&gt;0 then
		local delta=target.root.Position-position
		if delta.Magnitude&lt;=7.5 and workspace:Raycast(position,delta,self:rayParams(true))==nil then
			self:damage(p.a,target,p.damage*.5,false,false)
		end
	end
end
function Combat:projectileHit(p,target,position,normal)
	local style=IMPACT_STYLE[p.kind] or "shuriken"
	self:pushImpact(position,style,p.kind=="fireball",{projectile=p.id,kind=p.kind,normal=normal,owner=p.a.id,victim=target.id,direction=p.direction})
	local damaged=self:damage(p.a,target,p.damage,false,false)
	if self.match.phase~="Duel" then return end
	local guarded=target.impactStyle=="block"
	if damaged and not guarded then
		if p.kind=="wind" then
			target.root.AssemblyLinearVelocity=p.direction*37+Vector3.new(0,14,0)
		elseif p.kind=="fireball" then
			local push=Vector3.new(p.direction.X,0,p.direction.Z)
			if push.Magnitude&lt;.05 then push=p.a.root.CFrame.LookVector end
			Brawler.react(self,target,"Knockback",push.Unit*44+Vector3.new(0,20,0),.55,p.a)
		end
	end
	-- A guarded blast is absorbed whole: no burning ground under a raised guard.
	if p.kind=="fireball" and not guarded then self:fireExplosion(p,position,true) end
	-- A marked blade also leaves its seal beneath the struck target.
	if p.onSurface then p.onSurface(position,normal or Vector3.yAxis) end
end
function Combat:projectileSurface(p,hit)
	local style=if p.kind=="fireball" then "fire" elseif p.kind=="wind" then "jutsu" else "stick"
	self:pushImpact(hit.Position,style,p.kind=="fireball",{projectile=p.id,kind=p.kind,normal=hit.Normal,owner=p.a.id,direction=p.direction})
	if p.kind=="fireball" then self:fireExplosion(p,hit.Position+hit.Normal*1.5,false) end
	if self.match.phase~="Duel" then return end
	if p.onSurface and hit.Instance.CanCollide then p.onSurface(hit.Position,hit.Normal) end
end
function Combat:projectileExpire(p)
	if p.kind=="fireball" then
		self:pushImpact(p.position,"fire",true,{projectile=p.id,kind=p.kind,normal=Vector3.yAxis,owner=p.a.id,direction=p.direction})
		self:fireExplosion(p,p.position,false)
		return
	end
	-- A marked kunai that reaches the end of its flight drops to the ground and
	-- still plants its seal there: a long throw is a long-range anchor.
	if p.kind=="marked" and p.onSurface then
		local floor=workspace:Raycast(p.position,Vector3.new(0,-80,0),self:rayParams(true))
		if floor then
			self:pushImpact(floor.Position,"stick",false,{projectile=p.id,kind=p.kind,normal=floor.Normal,owner=p.a.id,direction=p.direction})
			p.onSurface(floor.Position,floor.Normal)
			return
		end
	end
	self:pushImpact(p.position,"fade",false,{projectile=p.id,kind=p.kind,owner=p.a.id})
end
function Combat:updateProjectiles(dt)
	for i=#self.projectiles,1,-1 do
		local p=self.projectiles[i]
		if not p or self.match.phase~="Duel" then return end
		local travel=math.min(p.speed*dt,p.remaining)
		local step=p.direction*travel
		local target=p.a.target
		local done=false
		-- Volumetric techniques test the body against the swept sphere, so a
		-- fireball that visibly engulfs the fighter always connects.
		local radius=p.radius+p.growth*(self.now-p.born)
		if radius&gt;0 and target and target.health&gt;0 then
			local closest=closestOnSegment(p.position,p.position+step,target.root.Position)
			if (target.root.Position-closest).Magnitude&lt;=radius+1.2 then
				self:projectileHit(p,target,closest,-p.direction)
				if self.match.phase~="Duel" then return end
				done=true
			end
		end
		if not done then
			local ray=RaycastParams.new(); ray.FilterType=Enum.RaycastFilterType.Exclude
			local exclude={self.match.effects,p.a.model}
			if radius&gt;0 and target then table.insert(exclude,target.model) end
			ray.FilterDescendantsInstances=exclude
			local hit=workspace:Raycast(p.position,step,ray)
			if hit then
				if target and hit.Instance:IsDescendantOf(target.model) then
					self:projectileHit(p,target,hit.Position,hit.Normal)
				else
					self:projectileSurface(p,hit)
				end
				if self.match.phase~="Duel" then return end
				done=true
			end
		end
		p.position+=step; p.remaining-=travel
		if not done and p.remaining&lt;=0 then
			self:projectileExpire(p)
			if self.match.phase~="Duel" then return end
		end
		if done or p.remaining&lt;=0 or p.a.health&lt;=0 or p.dead then
			local index=table.find(self.projectiles,p)
			if index then table.remove(self.projectiles,index) end
		end
	end
end
function Combat:updateHazards()
	for i=#self.hazards,1,-1 do
		local h=self.hazards[i]
		if self.now&gt;=h.expires or h.a.health&lt;=0 then table.remove(self.hazards,i)
		else
			local target=h.a.target
			local delta=target.root.Position-h.position
			local flat=Vector3.new(delta.X,0,delta.Z)
			if target.health&gt;0 and flat.Magnitude&lt;=h.radius and math.abs(delta.Y)&lt;6 and self.now-(h.lastHit[target] or -10)&gt;0.48 then
				local ray=workspace:Raycast(h.position,target.root.Position-h.position,self:rayParams(true))
				if not ray then
					h.lastHit[target]=self.now
					self:damage(h.a,target,h.damage*0.34,false,false)
				end
			end
		end
	end
end
function Combat:update(dt,now)
	self.now=now
	if self.match.phase~="Duel" then return end
	-- Record every frame. Sampling at 1/30 used to validate contact against a
	-- position up to a third of a second stale while the attacker closed in,
	-- so visibly connected strikes were rejected as out of range.
	for _,a in self.actors do HitDetection.record(a.root,now) end
	for _,a in self.actors do
		if self.match.phase~="Duel" then break end
		self:updateActor(a,dt)
	end
	if self.match.phase=="Duel" then self:updateProjectiles(dt); self:updateHazards() end
	for i=#self.effects,1,-1 do
		local e=self.effects[i]
		if e.expires&lt;=now or not e.part.Parent then e.part:Destroy(); table.remove(self.effects,i) end
	end
end
function Combat:clear(preserveAnimations)
	for _,a in self.actors do
		HitDetection.clear(a.root)
		if not preserveAnimations then Animation.clear(a) end
		Bangla.close(a.pending); Motor.reset(a);
		Brawler.releaseGrab(a); a.reaction=nil; a.reactionVelocity=nil; a.buffered=nil; a.airHold=0; a.pursuitUntil=0; a.chainOpen=false
		a.state=if a.health&gt;0 then "Neutral" else "Defeated";Defense.guard(a,false,self.now);a.readUntil=0;a.bonusUntil=0;a.dodgeUntil=0;a.invulnerableUntil=0;a.travelRemaining=0
		a.evade=nil;a.donorHitCount=0;a.donorLastHit=nil; a.combo=0;a.lastAttack=-10;a.throwing=nil;a.castId=nil;a.flashUntil=0;
		a.attackName=nil; a.attackStarted=0; a.pending=nil; a.anchor=nil; a.illusionUntil=0; a.decoyPosition=nil; a.move=Vector3.zero; a.wall=nil
		a.hum:Move(Vector3.zero); a.root.AssemblyLinearVelocity=Vector3.zero; a.locomotion=Vector3.zero; a.airborne=false
	end
	self.match.effects:ClearAllChildren(); table.clear(self.effects); table.clear(self.projectiles); table.clear(self.hazards)
	self.impacts={}; self.impactSerial=0
end
return Combat
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND25">
        <Properties>
          <string name="Name">DevHooks</string>
          <ProtectedString name="Source">-- Studio-only playtest hooks. A BindableFunction in ServerStorage lets a Studio
-- tool (or the command bar) start duels, drive either fighter through the real
-- combat requests, let the AI play both sides, and read a compact state dump.
-- Never active outside Studio; it only calls the same server APIs players use.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local DevHooks={}
function DevHooks.install(matches)
	if not RunService:IsStudio() then return end
	local AI=require(script.Parent.AI)
	local hook=Instance.new("BindableFunction");hook.Name="NinjaDuelDev";hook.Parent=game:GetService("ServerStorage")
	local autopilot=nil
	-- Client diagnostics (Studio only): the local client forwards its warnings,
	-- errors and camera framing so a playtest can be inspected from tooling.
	local logRemote=Instance.new("RemoteEvent");logRemote.Name="NinjaDuelDevLog";logRemote.Parent=game:GetService("ReplicatedStorage")
	local clientLog={}
	local clientInfo={}
	logRemote.OnServerEvent:Connect(function(_,kind,payload)
		if kind=="log" and type(payload)=="string" then
			table.insert(clientLog,payload);while #clientLog&gt;60 do table.remove(clientLog,1) end
		elseif kind=="info" and type(payload)=="table" then clientInfo=payload end
	end)
	local function session()
		local player=Players:GetPlayers()[1]
		return player,player and matches.sessions[player]
	end
	local function summary(a,now)
		if not a then return nil end
		return {state=a.state,health=a.health,chakra=math.floor(a.chakra),position=a.root.Position,reaction=a.reaction,attackName=a.attackName,
			airborne=a.airborne,wall=a.wall~=nil,airHold=a.airHold,pending=a.pending and (a.pending.name or (a.pending.spec and a.pending.spec.Id)),
			throwing=a.throwing and a.throwing.kind,anchor=a.anchor and a.anchor.position,velocity=a.root.AssemblyLinearVelocity,
			untilIn=a.untilTime-now,groundPose=a.groundPose,flash=(a.flashUntil or 0)&gt;now}
	end
	hook.OnInvoke=function(op,arg1,arg2,arg3)
		local player,s=session()
		if op=="start" then
			if not player then return "no player" end
			if s and s.phase~="Selection" then matches:selection(player) end
			return matches:start(player,arg1 or "Flashstep",arg2 or "Mirage",arg3==true)
		elseif op=="selection" then
			if player then matches:selection(player) end;return true
		end
		if not s or not s.combat then return "no duel" end
		local c=s.combat
		local actor=if arg1=="bot" then s.bot else s.human
		if op=="act" then
			-- arg1 = "human"/"bot", arg2 = action, arg3 = optional aim
			local ok,reason=c:request(actor,arg2,arg3)
			return {ok=ok,reason=reason}
		elseif op=="scripted" then
			-- Ignore the local client's (idle) move packets while a tool drives the human.
			s.scripted=arg1==true;return true
		elseif op=="move" then
			actor.move=arg2 or Vector3.zero;actor.lastMove=os.clock()+(arg3 or 0)
			if arg1~="bot" then actor.sprinting=false end
			return true
		elseif op=="refill" then
			for _,a in {s.human,s.bot} do a.chakra=a.def.Chakra;a.cooldowns={};a.health=a.def.Health;a.hum.Health=a.health;a.subCharges=2;a.subCooldown=0 end
			return true
		elseif op=="place" then
			-- arg1 / arg2 = offsets from the arena origin for human / bot
			c:relocate(s.human,s.origin+(arg1 or Vector3.new(0,3,6)));c:relocate(s.bot,s.origin+(arg2 or Vector3.new(0,3,-6)))
			s.human.root.CFrame=CFrame.lookAt(s.human.root.Position,s.bot.root.Position*Vector3.new(1,0,1)+Vector3.new(0,s.human.root.Position.Y,0))
			s.bot.root.CFrame=CFrame.lookAt(s.bot.root.Position,s.human.root.Position*Vector3.new(1,0,1)+Vector3.new(0,s.bot.root.Position.Y,0))
			return true
		elseif op=="freezeBot" then
			s.botFrozen=arg1==true
			if s.botFrozen then s.bot.move=Vector3.zero end
			return true
		elseif op=="autopilot" then
			-- The AI drives the human fighter too: full AI-vs-AI fights to watch.
			if arg1 then autopilot=AI.new(c,s.human,99) else autopilot=nil end
			s.autopilot=arg1==true
			return true
		elseif op=="clientlog" then
			local out=table.concat(clientLog," || ");if arg1 then table.clear(clientLog) end;return out
		elseif op=="clientinfo" then
			logRemote:FireAllClients("info");task.wait(.3);return clientInfo
		elseif op=="state" then
			local projectiles={}
			for _,p in c.projectiles do table.insert(projectiles,{kind=p.kind,position=p.position}) end
			return {phase=s.phase,now=c.now,human=summary(s.human,c.now),bot=summary(s.bot,c.now),projectiles=projectiles,hazards=#c.hazards,events=s.human.events}
		end
		return "unknown op"
	end
	RunService.Heartbeat:Connect(function()
		local _,s=session()
		if autopilot and s and s.phase=="Duel" and autopilot.actor==s.human then autopilot:update(s.combat.now)
		elseif autopilot and s and s.combat and autopilot.actor~=s.human then autopilot=AI.new(s.combat,s.human,99) end
	end)
end
return DevHooks
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND26">
        <Properties>
          <string name="Name">DonorAnimations</string>
          <ProtectedString name="Source">-- R6 -&gt; R15 compatibility only; transforms/times remain the donor choreography.
local Donor={}
local basis={
 Torso=CFrame.Angles(-math.pi/2,0,math.pi),Head=CFrame.Angles(-math.pi/2,0,math.pi),
 ['Right Arm']=CFrame.Angles(0,math.pi/2,0),['Left Arm']=CFrame.Angles(0,-math.pi/2,0),
 ['Right Leg']=CFrame.Angles(0,math.pi/2,0),['Left Leg']=CFrame.Angles(0,-math.pi/2,0),
}
local mapped={Head='Head',['Right Arm']='RightUpperArm',['Left Arm']='LeftUpperArm',
 ['Right Leg']='RightUpperLeg',['Left Leg']='LeftUpperLeg'}
local function pose(parent,name,cf,weight)
 local p=Instance.new('Pose');p.Name=name;p.CFrame=cf;p.Weight=weight or 1;p.Parent=parent;return p
end
function Donor.retarget(sequence)
 local result=Instance.new('KeyframeSequence');result.Name=sequence.Name..'_R15';result.Loop=sequence.Loop;result.Priority=sequence.Priority
 for _,frame in sequence:GetKeyframes() do
  local key=Instance.new('Keyframe');key.Name=frame.Name;key.Time=frame.Time;key.Parent=result
  local byName={};for _,p in frame:GetDescendants() do if p:IsA('Pose') then byName[p.Name]=p end end
  local source=byName.Torso
  local root=pose(key,'HumanoidRootPart',CFrame.identity,0)
  local torsoCF=if source then basis.Torso*source.CFrame*basis.Torso:Inverse() else CFrame.identity
  local lower=pose(root,'LowerTorso',torsoCF)
  local upper=pose(lower,'UpperTorso',CFrame.identity)
  for old,name in mapped do
   local src=byName[old]
   if src then
    local b=basis[old]
    local cf=b*src.CFrame*b:Inverse()
    local p=pose(if old:find('Leg') then lower else upper,name,cf,src.Weight)
    p.EasingStyle=src.EasingStyle;p.EasingDirection=src.EasingDirection
   end
  end
  for _,child in frame:GetChildren() do if child:IsA('KeyframeMarker') then child:Clone().Parent=key end end
 end
 return result
end
return Donor
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND27">
        <Properties>
          <string name="Name">Elements</string>
          <ProtectedString name="Source">-- Element families define different gameplay primitives. Fire and Wind are
-- equipped in this slice; the other families reserve explicit behavior seams.
local Elements={
	Families={
		Fire={primitive="TravellingBlast",counter="Sidestep the fireball, then punish the recovery"},
		Lightning={primitive="PrecisionBurst",counter="Bait the committed line"},
		Wind={primitive="Displacement",counter="Sidestep the cutting lane"},
		Water={primitive="MovingControlVolume",counter="Cross behind the wave"},
		Earth={primitive="SolidGroundCover",counter="Reposition around cover"},
	},
}
-- Katon: Great Fireball. Released from the mouth after the hand signs, it is a
-- real travelling volume that grows as it flies, bursts on contact and leaves
-- burning ground behind.
function Elements.fire(c,a,pending,now)
	local spec=pending.spec
	local aim=pending.aim or (a.target and a.target.root.Position) or a.root.Position+a.root.CFrame.LookVector*spec.Range
	local origin=c.launchPoint(a,"Fireball")
	-- Fire travels flat and slightly down onto the opponent's body, never into
	-- the sky when the aim point is a little high.
	local delta=aim-origin
	local flat=Vector3.new(delta.X,0,delta.Z)
	if flat.Magnitude&lt;1 then flat=a.root.CFrame.LookVector*Vector3.new(1,0,1) end
	local drop=math.clamp(delta.Y,-flat.Magnitude*.35,flat.Magnitude*.08)
	local target=origin+flat.Unit*spec.Range+Vector3.new(0,drop*spec.Range/math.max(flat.Magnitude,1),0)
	c:projectile(a,target,spec.Speed or 54,spec.Range,spec.Damage,"fireball",nil,{origin=origin,radius=2.4,growth=2.2,heavy=true})
	c:cue(a,"KATON • GREAT FIREBALL")
end
function Elements.wind(c,a,pending)
	local aim=pending.aim
	if (aim-a.root.Position).Magnitude&lt;1 then aim=a.root.Position+a.root.CFrame.LookVector*pending.spec.Range end
	c:projectile(a,aim,88,pending.spec.Range,pending.spec.Damage,"wind",nil,{radius=1.4})
	c:cue(a,"WIND • CUTTING LANE")
end
return Elements
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="ND28">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">workspace:SetAttribute("NinjaDuelQA",true)
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("NinjaDuel")
Players.CharacterAutoLoads=false
local remote=Instance.new("RemoteEvent"); remote.Name="Action"; remote.Parent=Shared
local Matches=require(script.Parent.Matches)
local matches=Matches.new(remote)
remote.OnServerEvent:Connect(function(player,payload) matches:request(player,payload) end)
Players.PlayerAdded:Connect(function(player) matches:selection(player) end)
Players.PlayerRemoving:Connect(function(player) matches:remove(player) end)
for _,player in Players:GetPlayers() do matches:selection(player) end
RunService.Heartbeat:Connect(function(dt) matches:update(dt,workspace:GetServerTimeNow()) end)
-- Studio-only playtest hooks (no effect in a live server).
require(script.Parent.DevHooks).install(matches)
-- Available only in the separately built native QA place; never in the playable artifact.
if RunService:IsStudio() and workspace:GetAttribute("NinjaDuelQA")==true then
	task.spawn(function() require(script.Parent.NativeQA).run(matches) end)
end
print("[NinjaDuel] BUILD "..Shared.BuildFingerprint.Value)
print("[NinjaDuel] Ready — select a fighter and start the duel")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND29">
        <Properties>
          <string name="Name">Matches</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Config=require(Shared.Config)
local Fighters=require(Shared.Fighters)
local Rules=require(Shared.Rules)
local World=require(script.Parent.World)
local Combat=require(script.Parent.Combat)
local AI=require(script.Parent.AI)
local Tutorial=require(script.Parent.Tutorial)
local AntiCheat=require(script.Parent.VelmoraAntiCheat)
local Techniques=require(script.Parent.Techniques)
local Matches={}; Matches.__index=Matches
function Matches.new(remote)
	local folder=Instance.new("Folder"); folder.Name="NinjaDuels"; folder.Parent=workspace
	return setmetatable({remote=remote,folder=folder,sessions={},nextLane=0,epoch=0},Matches)
end
function Matches:send(player,data)
	if player.Parent==Players then self.remote:FireClient(player,data) end
end
function Matches:session(player)
	if self.sessions[player] then return self.sessions[player] end
	self.nextLane+=1
	local s={phase="Selection",lane=self.nextLane,bucket={tokens=Config.RequestBurst,time=os.clock()},lastLifecycle=-10,epoch=0}
	self.sessions[player]=s; return s
end
function Matches:destroy(s)
	if s.combat then s.combat:clear() end
	if s.human then AntiCheat.clear(s.human) end
	if s.folder then s.folder:Destroy() end
	s.tutorial=nil; s.folder=nil; s.combat=nil; s.ai=nil; s.human=nil; s.bot=nil
end
function Matches:selection(player)
	local s=self:session(player); self:destroy(s)
	player.Character=nil; s.phase="Selection"; s.epoch+=1
	self:send(player,{phase="Selection",epoch=s.epoch})
end
function Matches:start(player,playerId,botId,training)
	local s=self:session(player)
	if not Fighters[playerId] or not Fighters[botId] then return false end
	self:destroy(s); s.epoch+=1
	s.playerId=playerId; s.botId=botId; s.winner=nil; s.phase="Duel"; s.origin=Vector3.new((s.lane-1)*240,0,0)
	s.folder=Instance.new("Folder"); s.folder.Name="Duel_"..s.lane; s.folder.Parent=self.folder
	s.effects=Instance.new("Folder"); s.effects.Name="Effects"; s.effects.Parent=s.folder
	World.arena(s.folder,s.origin)
	s.combat=Combat.new(s); s.combat.now=workspace:GetServerTimeNow()
	local function actor(id,def,position,look)
		local model,hum,root,joints=World.rig(s.folder,Fighters[def],CFrame.lookAt(position,look),id)
		return s.combat:add(id,model,hum,root,joints,def)
	end
	s.human=actor("PlayerFighter",playerId,s.origin+Vector3.new(0,3,14),s.origin+Vector3.new(0,3,-14))
	s.bot=actor("AIFighter",botId,s.origin+Vector3.new(0,3,-14),s.origin+Vector3.new(0,3,14))
	s.human.target=s.bot; s.bot.target=s.human; s.human.locked=true
	player.Character=s.human.model
	s.ai=AI.new(s.combat,s.bot,player.UserId%100000+ s.epoch)
	s.finish=function(winner,_loser)
		if s.phase~="Duel" then return end
		s.phase="Result"; s.winner=winner.id; s.combat:clear(true)
		for _,a in s.combat.actors do World.pose(a,s.combat.now,0.1) end
		for _,a in s.combat.actors do a.hum.WalkSpeed=0; a.root.Anchored=true end
		self:snapshot(player,s)
	end
	s.tutorial=nil; if training then Tutorial.new(s) end
	local epoch=s.epoch
	s.human.hum.Died:Connect(function() if s.epoch==epoch and s.phase=="Duel" then s.human.health=0; s.human.state="Defeated"; s.finish(s.bot,s.human) end end)
	s.bot.hum.Died:Connect(function() if s.epoch==epoch and s.phase=="Duel" then s.bot.health=0; s.bot.state="Defeated"; s.finish(s.human,s.bot) end end)
	self:snapshot(player,s)
	return true
end
function Matches:snapshot(player,s)
	local now=s.combat.now
	local function data(a)
		local ready={}
		for i,spec in a.def.Techniques do
			ready[i]={id=spec.Id,name=spec.Name,cost=spec.Cost,remaining=math.max(0,(a.cooldowns[spec.Id] or 0)-now),condition=not spec.Requires or (spec.Requires=="Anchor" and Techniques.sealOf(s.combat,a,now)~=nil) or (spec.Requires=="Target" and s.combat:targetValid(a,a.target,spec.Range,0.35))}
		end
		return {id=a.id,fighterId=a.fighterId,fighter=a.def.Name,health=a.health,maxHealth=a.def.Health,chakra=a.chakra,maxChakra=a.def.Chakra or Config.Chakra,stamina=a.stamina or 100,state=a.state,
			techniques=ready,position=a.root.Position,channel=if a.state=="TechniqueChannel" then math.max(0,a.untilTime-s.combat.now) else 0,
			anchor=a.anchor and a.anchor.position,illusion=math.max(0,a.illusionUntil-s.combat.now),decoy=a.decoyPosition,
			cue=if a.cueUntil&gt;s.combat.now then a.cue else "",dodge=math.max(0,a.dodgeUntil-s.combat.now),read=math.max(0,a.readUntil-s.combat.now),
			speed=a.locomotion.Magnitude,airborne=a.airborne,
			landStrong=a.model:GetAttribute("MovementHardLanding")==true,pursuit=math.max(0,a.pursuitUntil-s.combat.now),combo=a.combo,
			subCharges=a.subCharges,wall=a.wall~=nil,reaction=a.reaction,guardImpact=math.max(0,(a.guardImpact or 0)-s.combat.now),attackName=a.attackName,attackElapsed=s.combat.now-(a.attackStarted or 0),airHold=a.airHold,impactSerial=a.impactSerial or 0,impactHeavy=a.impactHeavy,impactStyle=a.impactStyle,
			hitFrom=a.hitFrom,hitAngle=a.hitAngle,hitStrength=a.hitStrength or 0,groundPose=a.groundPose,groundSide=a.groundSide,koStyle=a.koStyle,koAirborne=a.koAirborne,reactionElapsed=math.max(0,s.combat.now-(a.reactionStartedAt or s.combat.now)),events=a.events,velocity=if a.state=="Dodging" then (a.dodgeDirection or Vector3.zero)*35 else a.root.AssemblyLinearVelocity,
			-- Presentation timing for throws, casts, teleports and variants:
			-- elapsed values are measured on the server clock the client shares.
			attackSerial=a.attackSerial or 0,attackVariant=a.attackVariant,
			throwSerial=a.throwSerial or 0,throwKind=a.throwKind,throwElapsed=now-(a.throwStarted or -10),throwRelease=a.throwRelease or .1,
			castId=a.castId,castElapsed=now-(a.castStarted or now),
			anchorSurface=a.anchor and a.anchor.surface,anchorNormal=a.anchor and a.anchor.normal,anchorRemaining=a.anchor and math.max(0,a.anchor.expires-now) or 0,
			teleportSerial=a.teleportSerial or 0,flash=(a.flashUntil or 0)&gt;now,lookVector=a.root.CFrame.LookVector}
	end
	-- Live projectiles: straight constant-speed flights the client reproduces
	-- exactly on the shared server clock, so blades and fire never stutter.
	local projectiles={}
	for _,p in s.combat.projectiles do
		table.insert(projectiles,{id=p.id,kind=p.kind,origin=p.origin,direction=p.direction,speed=p.speed,born=p.born,range=p.range,owner=p.a.id,radius=p.radius,growth=p.growth})
	end
	local hazards={}
	for _,h in s.combat.hazards do
		table.insert(hazards,{position=h.position,radius=h.radius,remaining=math.max(0,h.expires-now),kind=h.kind,owner=h.a.id})
	end
	-- Only contacts the client has not been sent yet; remotes are ordered and
	-- reliable, and the client still filters by serial.
	local feed={}
	local sent=if s.impactEpoch==s.epoch then (s.sentImpact or 0) else 0
	for _,impact in s.combat.impacts do if impact.serial&gt;sent then table.insert(feed,impact) end end
	s.sentImpact=s.combat.impactSerial or 0;s.impactEpoch=s.epoch
	self:send(player,{phase=s.phase,epoch=s.epoch,winner=s.winner,tutorial=Tutorial.snapshot(s),origin=s.origin,human=data(s.human),bot=data(s.bot),impacts=feed,impactSerial=s.combat.impactSerial or 0,
		projectiles=projectiles,hazards=hazards,serverNow=now})
end
function Matches:request(player,payload)
	local s=self:session(player); local clock=os.clock()
	if not Rules.consumeToken(s.bucket,clock,Config.RequestRate,Config.RequestBurst) then return end
	if type(payload)~="table" or type(payload.action)~="string" or #payload.action&gt;24 then return end
	local action=payload.action
	if action=="Ready" then
		if s.phase=="Selection" then self:send(player,{phase="Selection",epoch=s.epoch}) else self:snapshot(player,s) end
		return
	end
	if payload.epoch~=s.epoch then return end
	if action=="TutorialSkip" and s.tutorial then self:selection(player);s.tutorial=nil;return end
	if action=="Start" or action=="Tutorial" or action=="Rematch" or action=="Selection" then
		if clock-s.lastLifecycle&lt;0.8 then return end
		if (action=="Start" or action=="Tutorial") and s.phase=="Selection" then
			if type(payload.player)~="string" or type(payload.bot)~="string" then return end
			s.lastLifecycle=clock; self:start(player,payload.player,payload.bot,action=="Tutorial")
		elseif action=="Rematch" and s.phase=="Result" then
			s.lastLifecycle=clock; self:start(player,s.playerId,s.botId,s.tutorial~=nil)
		elseif action=="Selection" and (s.phase=="Result" or s.tutorial) then s.lastLifecycle=clock; self:selection(player) end
		return
	end
	if s.phase~="Duel" or not s.human then return end
	if action~="Move" and not AntiCheat.check(s.human,action,payload.clientTime,workspace:GetServerTimeNow()) then return end
	local function vector(v)
		return typeof(v)=="Vector3" and Rules.finite(v.X) and Rules.finite(v.Y) and Rules.finite(v.Z)
	end
	if action=="Move" then
		if s.autopilot or s.scripted then return end
		if not vector(payload.direction) or payload.direction.Magnitude&gt;1.01 or math.abs(payload.direction.Y)&gt;0.01 then return end
		s.human.move=payload.direction; s.human.lastMove=clock
		if type(payload.sprint)=="boolean" then s.human.sprinting=payload.sprint end
		if type(payload.locked)=="boolean" then
			if s.human.locked~=payload.locked then require(script.Parent.Brawler).event(s.combat,s.human,if payload.locked then "Lock" else "Unlock") end
			s.human.locked=payload.locked
		end
		return
	end
	local aim=nil
	if payload.aim~=nil then
		if not vector(payload.aim) or (payload.aim-s.human.root.Position).Magnitude&gt;150 then return end
		aim=payload.aim
	end
	local ok,reason=s.combat:request(s.human,action,aim,payload.clientTime)
	if not ok and reason~="Committed" then s.combat:cue(s.human,string.upper(reason)) end
end
function Matches:update(dt,now)
	for player,s in self.sessions do
		if s.phase=="Duel" then
			if os.clock()-s.human.lastMove&gt;0.4 then s.human.move=Vector3.zero end
			s.combat:update(math.min(dt,0.1),now)
			if s.phase=="Duel" then
				if s.tutorial then Tutorial.update(s,now,dt) elseif not s.botFrozen then s.ai:update(now) end
			end
		end
		-- Regular cadence, plus an immediate packet when a contact, throw or
		-- teleport happened so presentation never waits a full interval.
		local urgent=s.combat and s.combat.urgent and now&gt;=(s.lastUrgent or 0)+.03
		if s.combat and (now&gt;=(s.nextSnapshot or 0) or urgent) then
			s.nextSnapshot=now+Config.SnapshotInterval; s.combat.urgent=false; s.lastUrgent=now; self:snapshot(player,s)
		end
	end
end
function Matches:remove(player)
	local s=self.sessions[player]
	if s then self:destroy(s); self.sessions[player]=nil end
end
return Matches
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND30">
        <Properties>
          <string name="Name">Motor</string>
          <ProtectedString name="Source">-- Server movement authority. This module owns locomotion, landing and safe
-- action travel; AI and human actors use the same movement profile.
local Config=require(game:GetService("ReplicatedStorage").NinjaDuel.Config)
local Place1Movement=require(script.Parent.Place1Movement)
local Place1Parkour=require(script.Parent.Place1Parkour)
-- This adapter retains swept action travel and the NinjaWall extension only.
-- Place1 owns free locomotion/jump/air steering/mantle/wall-hop at runtime.
local Motor={}
local function donor(a,c)
 if not a.movementDonor then a.movementDonor=Place1Movement.new(a,c);a.parkourDonor=Place1Parkour.new(a,c) end
 return a.movementDonor,a.parkourDonor
end
function Motor.reset(a)
 if a.parkourDonor then a.parkourDonor.reset() end
 a.movementDonor=nil;a.parkourDonor=nil
end
local UP=Vector3.yAxis
local function flat(v) return Vector3.new(v.X,0,v.Z) end
function Motor.grounded(a,c)
	local p=RaycastParams.new(); p.FilterType=Enum.RaycastFilterType.Exclude
	p.FilterDescendantsInstances={a.model,c.match.effects}
	p.RespectCanCollide=true
	return workspace:Raycast(a.root.Position,Vector3.new(0,-3.6,0),p)~=nil
end
function Motor.jump(a,c,now)
 local movement,parkour=donor(a,c)
 if parkour.jump() then return true end
 return movement.jump(Motor.grounded(a,c))
end
function Motor.detach(a,now,rebound)
	local wall=a.wall
	if not wall then return false end
	a.wall=nil; a.wallNext=now+Config.Wall.ReattachDelay
	if rebound then a.wallJumpUntil=now+0.22 end
	if rebound and a.parkourDonor then a.parkourDonor.rebound(wall.normal)
 else a.root.AssemblyLinearVelocity=wall.normal*12+UP*8 end
	a.airborne=true
	return true
end
function Motor.tryWall(a,c,now)
	if a.wall or now&lt;(a.wallNext or 0) or a.move.Magnitude&lt;0.25 or a.state~="Neutral" then return false end
	local heading=flat(a.move)
	if heading.Magnitude&lt;0.25 then return false end
 local _,parkour=donor(a,c)
 local hit=parkour.wallSurface()
	if not hit or not hit.Instance:GetAttribute("NinjaWall") or math.abs(hit.Normal.Y)&gt;0.18 then return false end
	if heading.Unit:Dot(-hit.Normal)&lt;0.45 then return false end
	a.wall={part=hit.Instance,normal=hit.Normal,untilTime=now+Config.Wall.MaxTime}
	a.airborne=true;a.airDodgeUsed=false
	c:cue(a,"WALL RUN • SPACE REBOUND / C DETACH",0.8)
	return true
end
function Motor.stepWall(a,c,dt,now)
	local wall=a.wall
	if not wall then return false end
	if now&gt;=wall.untilTime or not wall.part.Parent or a.state=="Stunned" or a.state=="Defeated" then
		Motor.detach(a,now,false);return false
	end
	local p=RaycastParams.new();p.FilterType=Enum.RaycastFilterType.Exclude
	p.FilterDescendantsInstances={a.model,c.match.effects};p.RespectCanCollide=true
	local hit=workspace:Raycast(a.root.Position, -wall.normal*Config.Wall.Detect,p)
	if not hit or hit.Instance~=wall.part or hit.Normal:Dot(wall.normal)&lt;0.72 then
		Motor.detach(a,now,false);return false
	end
	local into=math.max(0,flat(a.move):Dot(-wall.normal))
	local side=flat(a.move)+wall.normal*into
	local motion=side*Config.Wall.SideSpeed+UP*Config.Wall.RiseSpeed*math.max(0.2,into)
	local target=hit.Position+wall.normal*Config.Wall.Clearance+motion*dt
	if target.Y&gt;wall.part.Position.Y+wall.part.Size.Y*0.5+1 then Motor.detach(a,now,true);return false end
	local obstacle=workspace:Raycast(a.root.Position,target-a.root.Position,p)
	if obstacle and obstacle.Instance~=wall.part then Motor.detach(a,now,false);return false end
	a.root.CFrame=CFrame.lookAt(c:clamp(target),c:clamp(target)-wall.normal)
	a.root.AssemblyLinearVelocity=Vector3.zero
	a.hum.AutoRotate=false;a.hum:Move(Vector3.zero,false)
	a.locomotion=side*Config.Wall.SideSpeed
	return true
end
function Motor.travel(a,c,direction,distance)
	local v=flat(direction)
	if v.Magnitude&lt;0.01 or distance&lt;=0 then return 0 end
	local start=a.root.Position
	local vector=v.Unit*distance
	local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances={a.model,c.match.effects}
	params.RespectCanCollide=true
	local hit=workspace:Raycast(start,vector,params)
	local advance=if hit then math.max(0,hit.Distance-2.1) else vector.Magnitude
	local target=c:clamp(start+v.Unit*advance)
	a.root.CFrame=CFrame.new(target)*a.root.CFrame.Rotation
	return (target-start).Magnitude
end
-- Full 3D swept travel used by chase and controlled victim trajectories.
function Motor.flight(a,c,delta)
 if delta.Magnitude&lt;.001 then return nil end
 local params=c:rayParams(true);params.RespectCanCollide=true
 local hit=workspace:Raycast(a.root.Position,delta.Unit*(delta.Magnitude+1.4),params)
 local movement=if hit then delta.Unit*math.max(0,hit.Distance-1.4) else delta
 local target=c:clamp(a.root.Position+movement)
 -- Root centre stays above the floor; actor body geometry is cosmetic.
 a.root.CFrame=CFrame.new(target)*a.root.CFrame.Rotation
 a.root.AssemblyLinearVelocity=Vector3.zero
 return hit
end
-- Continuous aimed motion in three dimensions. The swept helper above teleports
-- the root along a line, which made chase and slam read as
-- advance -&gt; correction -&gt; advance. Kinetic motion instead accelerates a real
-- velocity towards the target and integrates it, so the server position and the
-- replicated velocity never disagree.
local function paramsFor(a,c)
	local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances={a.model,c.match.effects};params.RespectCanCollide=true
	return params
end
local function approach(current,target,delta)
	if target&gt;current then return math.min(target,current+delta) end
	return math.max(target,current-delta)
end
function Motor.move(a,c,aim,dt)
	local velocity=a.root.AssemblyLinearVelocity
	local offset=aim.target-a.root.Position
	if offset.Magnitude&lt;.02 then return 0 end
	local desired=offset.Unit*aim.speed
	local accel=aim.acceleration or 200
	local target=Vector3.new(
		approach(velocity.X,desired.X,accel*dt),
		approach(velocity.Y,desired.Y,accel*dt),
		approach(velocity.Z,desired.Z,accel*dt))
	-- Integrate the horizontal part by hand: server-owned actors must move even
	-- when no physics solver is stepping them. Vertical follows the same velocity
	-- unless the floor stops it, which also keeps grounded actors on the ground.
	local deltaPos=Vector3.new(target.X*dt,0,target.Z*dt)
	local advance=deltaPos
	if deltaPos.Magnitude&gt;.0001 then
		local hit=workspace:Raycast(a.root.Position,deltaPos,paramsFor(a,c))
		if hit then advance=deltaPos.Unit*math.max(0,hit.Distance-1.9) end
	end
	local floor=c.match and c.match.origin.Y+3 or -math.huge
	local nextY=a.root.Position.Y+target.Y*dt
	local blockedFloor=nextY&lt;floor
	local y=if blockedFloor then floor else nextY
	local nextPosition=c:clamp(Vector3.new(a.root.Position.X+advance.X,y,a.root.Position.Z+advance.Z))
	a.root.CFrame=CFrame.new(nextPosition)*a.root.CFrame.Rotation
	a.root.AssemblyLinearVelocity=Vector3.new(target.X,if blockedFloor then 0 else target.Y,target.Z)
	a.fallSpeed=if target.Y&lt;0 then math.max(a.fallSpeed or 0,-target.Y) else 0
	return advance.Magnitude
end
-- Vertical partner of Motor.move, used by the slam plunge.
function Motor.descend(a,c,speed,dt)
	local velocity=a.root.AssemblyLinearVelocity
	local vertical=approach(velocity.Y,-math.abs(speed),320*dt)
	local delta=Vector3.new(0,vertical*dt,0)
	local hit=workspace:Raycast(a.root.Position,delta,paramsFor(a,c))
	if hit then
		a.root.CFrame=CFrame.new(c:clamp(hit.Position+hit.Normal*1.9))*a.root.CFrame.Rotation
		a.root.AssemblyLinearVelocity=Vector3.new(velocity.X,0,velocity.Z)
		return true
	end
	a.root.CFrame=CFrame.new(c:clamp(a.root.Position+delta))*a.root.CFrame.Rotation
	a.root.AssemblyLinearVelocity=Vector3.new(velocity.X,vertical,velocity.Z)
	return false
end
function Motor.step(a,c,dt,now)
	local profile=Config.Movement
 donor(a,c)
	if not a.wall then Motor.tryWall(a,c,now) end
	if Motor.stepWall(a,c,dt,now) then return false end
	local vertical=a.root.AssemblyLinearVelocity.Y
	if vertical&lt;0 then a.fallSpeed=math.max(a.fallSpeed or 0,-vertical) end
	local grounded=Motor.grounded(a,c)
	if grounded and a.airborne and now&gt;(a.takeoffUntil or 0) and a.root.AssemblyLinearVelocity.Y&lt;=5 then
		a.airborne=false; a.airDodgeUsed=false; a.airHold=0
		local falling=a.fallSpeed or 0;a.fallSpeed=0
		a.landUntil=now+(if falling&gt;profile.HardLandVelocity then profile.HardLandRecovery else profile.SoftLandRecovery)
		a.model:SetAttribute("MovementLandedAt",now)
		a.model:SetAttribute("MovementHardLanding",falling&gt;profile.HardLandVelocity)
		c:effect("Land dust",a.root.Position-Vector3.new(0,2.8,0),a.color,Vector3.new(3,0.15,3),0.15)
	end
	if not grounded then a.airborne=true end
 local movement,parkour=donor(a,c)
 a.grounded=grounded
 if parkour.step() then return false end
 local sprinting=movement.step(dt,grounded)
 -- Gravity fallback for server-owned actors with no client simulation. Real
 -- physics owns a falling root; this only pulls back a body that has stalled in
 -- the air, which is what used to leave a fighter hovering after a slam.
 if not grounded and a.reaction==nil and not a.wall then
  local velocity=a.root.AssemblyLinearVelocity
  local fall=math.min(70,velocity.Y-140*dt)
  a.root.CFrame=CFrame.new(c:clamp(a.root.Position+Vector3.new(0,fall*dt,0)))*a.root.CFrame.Rotation
  a.root.AssemblyLinearVelocity=Vector3.new(velocity.X,fall,velocity.Z)
 end
 local locomotion=a.locomotion
 local limit=if sprinting then profile.SprintSpeed*(a.def.SprintScale or 1) else a.def.Speed
 if a.state=="Guarding" then limit=Config.GuardSpeed
 elseif a.state=="TechniqueChannel" then limit=Config.ChannelSpeed
 elseif a.state=="Stunned" or a.state=="Defeated" or a.state=="Dodging" or a.state=="Pursuit" then limit=0
 elseif a.state~="Neutral" then limit=profile.AttackWalkSpeed end
 if a.aimIntent then
  -- Chase and slam supply their own continuous motion for this frame.
  Motor.move(a,c,a.aimIntent,dt)
  a.locomotion=Vector3.new(a.root.AssemblyLinearVelocity.X,0,a.root.AssemblyLinearVelocity.Z)
  a.hum.WalkSpeed=a.locomotion.Magnitude
  a.hum:Move(if a.locomotion.Magnitude&gt;.01 then a.locomotion.Unit else Vector3.zero)
  a.model:SetAttribute("MovementBase","Kinetic")
  return grounded
 end
 if a.grabVictim then limit=math.min(limit,5) end
 if now&lt;(a.landUntil or 0) then limit=math.min(limit,profile.HardLandSpeed) end
	 if locomotion.Magnitude&gt;limit then locomotion=locomotion.Unit*limit end
	 a.locomotion=locomotion
	 a.hum.WalkSpeed=locomotion.Magnitude
	 a.hum:Move(if locomotion.Magnitude&gt;.01 then locomotion.Unit else Vector3.zero,false)
 a.model:SetAttribute("MovementBase","Place1")
	return grounded
end
return Motor
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND31">
        <Properties>
          <string name="Name">NativeQA</string>
          <ProtectedString name="Source">-- Test-only module omitted from playable artifact.
local Players=game:GetService("Players")
local World=require(script.Parent.World)
local Combat=require(script.Parent.Combat)
local AI=require(script.Parent.AI)
local Fighters=require(game:GetService("ReplicatedStorage").NinjaDuel.Fighters)
local Elements=require(script.Parent.Elements)
local Brawler=require(script.Parent.Brawler)
local Tutorial=require(script.Parent.Tutorial)
local Controls=require(game:GetService("ReplicatedStorage").NinjaDuel.Controls)
local QA={}
function QA.run(matches)
	print("[NinjaDuelQA] START "..require(game:GetService("ReplicatedStorage").NinjaDuel.Config).Version)
	print("[NinjaDuelQA] BUILD "..game:GetService("ReplicatedStorage").NinjaDuel.BuildFingerprint.Value)
	local passed,failed=0,0
	local function test(name,fn)
		local ok,err=xpcall(fn,debug.traceback)
		if ok then passed+=1; print("[NinjaDuelQA] PASS "..name)
		else failed+=1; warn("[NinjaDuelQA] FAIL "..name.." "..tostring(err)) end
	end
	local active={}
	local function pair(first,second)
		local f=Instance.new("Folder"); f.Name="NativeQAFixture"; f.Parent=workspace; table.insert(active,f)
		local e=Instance.new("Folder"); e.Name="Effects"; e.Parent=f
		local match={origin=Vector3.new(1200+#active*240,0,0),folder=f,effects=e,phase="Duel"}
		World.arena(f,match.origin)
		local c=Combat.new(match); c.now=100
		local function add(id,def,z)
			local p=match.origin+Vector3.new(0,3,z)
			local m,h,r,j=World.rig(f,Fighters[def],CFrame.lookAt(p,match.origin+Vector3.new(0,3,-z)),id)
			r.Anchored=true;m:SetAttribute("SkipDonorAnimationQA",true)
			return c:add(id,m,h,r,j,def)
		end
		local a,b=add("A",first,2.5),add("B",second,-2.5); a.target=b; b.target=a
		match.finish=function(winner) match.phase="Result"; match.winner=winner.id; c:clear() end
		task.wait() -- allow native broadphase / joints to settle before ray tests
		return c,a,b,match
	end
	local function step(c,n)
		for _=1,math.ceil(n/0.02) do c:update(0.02,c.now+0.02) end
	end
	test("R15 rigs expose standard animation joints",function()
		local c,a,b=pair("Flashstep","Mirage")
		for _,actor in {a,b} do
			assert(actor.hum.RigType==Enum.HumanoidRigType.R15)
			assert(actor.hum:FindFirstChildOfClass("Animator")~=nil)
			for _,name in {"Root","Waist","Neck","LeftShoulder","RightShoulder","LeftElbow","RightElbow","LeftHip","RightHip","LeftKnee","RightKnee","LeftAnkle","RightAnkle"} do
				assert(actor.joints[name]~=nil,"Missing R15 joint "..name)
			end
		end
	end)
 test("imported Bangla dependencies, three-hit route and Place1 runtime",function()
  local shared=game:GetService("ReplicatedStorage").NinjaDuel
  local combo=require(shared.BanglaCombo)
  assert(combo.maxComboCount==3 and combo.Damage.Punch==5)
  assert(shared.BanglaAssets.Animations.Punch.AnimationId=="rbxassetid://18342131933")
  assert(shared.ThirdPartyLicenses.bangla.Value:find("Dewan Mukto"))
  assert(shared.ThirdPartyLicenses.velmora.Value:find("Yashveer Singh"))
  local c,a,b=pair("Flashstep","Mirage")
  assert(c:request(a,"Attack"));step(c,.3)
  assert(a.model:GetAttribute("CombatBase")=="BanglaBattlegrounds")
  assert(a.model:GetAttribute("MovementBase")=="Place1")
  assert(a.donorHitCount==1 and b.health==b.def.Health-5)
 end)
	test("data-driven identities and five element families",function()
		assert(Fighters.Flashstep.Name=="Minato" and Fighters.Mirage.Name=="Itachi")
		assert(Fighters.Flashstep.Speed&gt;Fighters.Mirage.Speed)
		assert(Fighters.Mirage.Chakra&gt;Fighters.Flashstep.Chakra)
		for _,element in {"Fire","Lightning","Wind","Water","Earth"} do
			assert(Elements.Families[element] and Elements.Families[element].primitive)
		end
	end)
	test("wall enter, rise, rebound and clean detach",function()
		local c,a,b=pair("Flashstep","Mirage")
		c:relocate(a,c.match.origin+Vector3.new(24,3,0))
		a.move=Vector3.xAxis
		step(c,0.3)
		assert(a.wall~=nil,"Wall did not attach")
		assert(a.root.Position.Y&gt;5,"Wall run did not rise")
		assert(c:request(a,"Jump") and a.wall==nil,"Wall rebound failed")
		assert(a.root.AssemblyLinearVelocity.Y&gt;30)
		step(c,0.1); assert(a.wall==nil,"Wall immediately reattached")
	end)
	test("wall edge exits and arena travel stays bounded",function()
		local c,a,b=pair("Flashstep","Mirage")
		c:relocate(a,c.match.origin+Vector3.new(24,3,12))
		a.move=Vector3.xAxis; step(c,0.05); assert(a.wall)
		a.move=Vector3.zAxis; step(c,0.35)
		assert(a.wall==nil,"Wall edge kept actor attached")
		c:relocate(a,c.match.origin+Vector3.new(74,3,50))
		local moved=require(script.Parent.Motor).travel(a,c,Vector3.xAxis,30)
		assert(moved&lt;=4.01 and a.root.Position.X&lt;=c.match.origin.X+78)
	end)
	test("substitution needs fresh hit, charge and chakra",function()
		local c,a,b=pair("Flashstep","Mirage")
		assert(not c:request(b,"Substitute"))
		assert(c:damage(a,b,10,false,true))
		local hp=b.health
		assert(c:request(b,"Substitute")); assert(b.subCharges==1 and b.health==hp)
		assert(not c:request(b,"Substitute"))
		b.state="Stunned"; b.lastHurt=c.now; b.subCharges=0
		assert(not c:request(b,"Substitute"))
	end)
	test("declared early technique feint keeps cooldown and partial cost",function()
		local c,a,b=pair("Flashstep","Mirage")
		assert(c:request(a,"Technique1",b.root.Position))
		local reserved=a.chakra
		assert(c:request(a,"Feint"))
		assert(a.pending==nil and a.state=="Recovery" and a.chakra&gt;reserved)
		step(c,0.3)
		assert(not c:request(a,"Technique1"),"Feint erased cooldown")
	end)
	test("death clears wall, projectiles, hazards and stale combat state",function()
		local c,a,b,m=pair("Flashstep","Mirage")
		a.wall={part=a.root,normal=Vector3.xAxis,untilTime=110}
		c:addHazard(a,a.root.Position,4,3,10,"Fire")
		c:projectile(a,b.root.Position,50,20,3,"tool")
		assert(c:damage(b,a,1000,false,true))
		assert(m.phase=="Result" and a.wall==nil and #c.projectiles==0 and #c.hazards==0)
	end)
	test("launcher chase air combo slam knockdown and wakeup",function()
 local c,a,b=pair("Flashstep","Mirage")
 for _=1,2 do assert(c:request(a,"Attack"));step(c,.3) end
 assert(c:request(a,"Heavy"));assert(a.attackName=="Launcher")
 step(c,.35);assert(b.reaction=="Launched" and b.root.Position.Y&gt;8)
 local chakra=a.chakra;assert(c:request(a,"Pursuit"));assert(a.chakra==chakra-8)
 step(c,.26);assert(a.airborne and (a.root.Position-b.root.Position).Magnitude&lt;8)
 assert(c:request(a,"Attack"));step(c,.28);assert(b.reaction=="Juggled")
 assert(c:request(a,"Attack"));step(c,.28);assert((a.events.AirHit or 0)&gt;=2)
 assert(c:request(a,"Heavy"));assert(a.attackName=="Slam");step(c,.4)
 assert(b.reaction=="Knockdown" and (a.events.SlamHit or 0)&gt;0)
 step(c,.8);assert(not b.reaction or b.reaction=="Wakeup")
 assert(not c:request(a,"Pursuit"))
 end)
 test("grab directional throw upthrow invalid range and escape",function()
 local c,a,b=pair("Mirage","Flashstep")
 c:relocate(b,c.match.origin+Vector3.new(0,3,-20));assert(c:request(a,"Grab"));step(c,.4);assert(not a.grabVictim)
 step(c,1.2);c:relocate(b,c.match.origin+Vector3.new(0,3,-2));assert(c:request(a,"Grab"));step(c,.23)
 assert(a.grabVictim==b and b.reaction=="Grabbed")
 assert(not c:request(b,"Attack"));a.move=Vector3.xAxis;assert(c:request(a,"Attack"));step(c,.2)
 assert(not a.grabVictim and not b.grabbedBy and b.reaction=="Knockdown" and b.reactionVelocity.X&gt;20)
 step(c,1.5);a.state="Neutral";b.reaction=nil;c:relocate(a,c.match.origin+Vector3.new(0,3,2.5));c:relocate(b,c.match.origin+Vector3.new(0,3,-2.5));a.root.CFrame=CFrame.lookAt(a.root.Position,b.root.Position)
 assert(c:request(a,"Grab"));step(c,.23);assert(c:request(a,"Heavy"));step(c,.2);assert(b.reaction=="Launched")
 end)
 test("active window catches late entry, whiff cannot chain, defender can escape",function()
 local c,a,b=pair("Flashstep","Mirage")
 c:relocate(b,c.match.origin+Vector3.new(0,3,-18));assert(c:request(a,"Attack"));step(c,.12);assert(b.health==b.def.Health)
 c:relocate(b,a.root.Position+a.root.CFrame.LookVector*3);step(c,.04);assert(b.health&lt;b.def.Health)
 assert(c:request(b,"Dodge"));assert(b.subCharges==1 and not b.reaction)
 step(c,.7);c:relocate(b,c.match.origin+Vector3.new(0,3,-35));assert(c:request(a,"Attack"));step(c,.25)
 assert(not a.chainOpen and not c:request(a,"Attack"))
 end)
	test("Fire area and Wind projectile differ, with costs and cooldown",function()
		local c,a,b=pair("Mirage","Flashstep")
		assert(c:request(a,"Technique4",b.root.Position))
		step(c,0.58)
		assert(b.health&lt;b.def.Health and #c.hazards&gt;0,"Fire area did not pressure target")
		assert(not c:request(a,"Technique4"),"Fire ignored commitment")
		step(c,1.1); assert(#c.hazards==0)
		local w,x,y=pair("Flashstep","Mirage")
		assert(w:request(x,"Technique5",y.root.Position))
		step(w,0.8)
		assert(y.health&lt;y.def.Health,"Wind projectile did not hit")
		assert(#w.hazards==0,"Wind reused Fire area behavior")
	end)
	test("sprint accelerates, braking settles, and jump exceeds default height",function()
		local c,a,b=pair("Flashstep","Mirage")
		a.root.Anchored=false; a.move=Vector3.new(1,0,0); a.sprinting=true
		step(c,0.1); local early=a.locomotion.Magnitude
			step(c,0.3); assert(early&gt;35 and a.locomotion.Magnitude&gt;35)
		a.move=Vector3.zero; a.sprinting=false; step(c,0.3)
		assert(a.locomotion.Magnitude&lt;1,"Ground braking failed")
		assert(c:request(a,"Jump")); assert(a.airborne)
		local originalY=a.root.Position.Y
		task.wait(0.35)
		assert(a.root.Position.Y&gt;originalY+4,"Ninja jump lacks visible height")
	end)
	test("horizontal chain and dash attack remain advancing and bounded",function()
 local c,a,b=pair("Flashstep","Mirage");local first=a.root.Position
	 for beat=1,3 do assert(c:request(a,"Attack"));step(c,.31) end
 assert(a.attackName=="Light3" and b.reaction=="Knockback")
 assert((a.root.Position-first).Magnitude&gt;1)
 step(c,1);a.move=-Vector3.zAxis;assert(c:request(a,"Dodge"));step(c,.18)
 assert(c:request(a,"Attack") and a.attackName=="DashAttack")
 end)
	test("one air dodge per jump, server rejects repeats",function()
		local c,a,b=pair("Flashstep","Mirage")
		a.root.Anchored=false
		assert(c:request(a,"Jump"))
		task.wait(0.08)
		assert(a.airborne and c:request(a,"Dodge"))
		step(c,0.4)
		assert(not c:request(a,"Dodge")); assert(a.airDodgeUsed)
	end)
	test("all four fighter pairings complete by real validated melee",function()
		for _,f in {"Flashstep","Mirage"} do for _,g in {"Flashstep","Mirage"} do
			local c,a,b,m=pair(f,g)
			for _=1,40 do
				if m.phase~="Duel" then break end
				c:relocate(b,a.root.Position+a.root.CFrame.LookVector*5);b.reaction=nil; c:request(a,"Attack"); step(c,0.7)
			end
			assert(m.winner=="A" and b.health==0 and b.state=="Defeated")
			assert(not c:request(b,"Attack"))
		end end
	end)
	test("all interruptible technique channels cancel before payoff",function()
		for _,f in {"Flashstep","Mirage"} do
			for slot,spec in Fighters[f].Techniques do if spec.Interruptible then
				local c,a,b=pair(f,"Flashstep")
				if spec.Requires=="Anchor" then
					a.anchor={position=a.root.Position+Vector3.new(8,0,0),expires=120,part=c:effect("Anchor",a.root.Position,a.color,Vector3.one,12)}
				end
				assert(c:request(a,"Technique"..slot,b.root.Position))
				local initial=a.root.Position
				assert(c:damage(b,a,7,false,true)); assert(a.state=="Stunned" and a.pending==nil and a.cue=="INTERRUPTED")
			assert(a.cooldowns[spec.Id]&gt;100 and a.chakra==(a.def.Chakra or 100)-spec.Cost)
				step(c,1.3)
				assert(b.health==b.def.Health and b.illusionUntil==0)
				assert((a.root.Position-initial).Magnitude&lt;0.1)
			end end
		end
	end)
	test("cost, cooldown, invalid slot and missing anchor rejected",function()
		local c,a,b=pair("Flashstep","Mirage")
		assert(not c:request(a,"Technique2")); a.chakra=0; assert(not c:request(a,"Technique1"))
		a.chakra=100; assert(c:request(a,"Technique3")); step(c,1.1)
		assert(not c:request(a,"Technique3")); assert(not c:request(a,"Technique99"))
	end)
	test("range, facing and real geometry occlusion validate hits",function()
		local c,a,b=pair("Flashstep","Mirage")
		b.root.CFrame=CFrame.new(c.match.origin+Vector3.new(0,3,-30)); assert(not c:strike(a,99,7,0.25,false))
		c:relocate(b,c.match.origin+Vector3.new(0,3,-2.5))
		local wall=World.part(c.match.folder,"CoverQA",Vector3.new(8,8,1),CFrame.new(c.match.origin+Vector3.new(0,4,0)),Color3.new())
		assert(not c:strike(a,99,7,0.25,false)); wall:Destroy()
		a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+Vector3.zAxis)
		assert(not c:strike(a,99,7,0.25,false)); assert(b.health==b.def.Health)
	end)
	test("guard chip, backside hit and guard break",function()
		local c,a,b=pair("Flashstep","Mirage")
			assert(c:request(b,"Guard"));step(c,.22);c:damage(a,b,10,false,true)
			assert(math.abs(b.health-(b.def.Health-2.4))&lt;0.01 and b.state=="Guarding")
			b.stamina=1;c:damage(a,b,10,false,true);assert(b.state=="Stunned" and b.cue=="GUARD BREAK")
			b.state="Guarding";b.stamina=100;b.root.CFrame=CFrame.lookAt(b.root.Position,b.root.Position-Vector3.zAxis)
		local old=b.health; c:damage(a,b,10,false,true); assert(old-b.health==10)
	end)
	test("dodge invulnerability ends; cooldown blocks repeat",function()
		local c,a,b=pair("Flashstep","Mirage")
		assert(c:request(b,"Dodge")); local hp=b.health
		assert(not c:damage(a,b,10,false,true)); assert(b.health==hp)
		step(c,0.4); assert(not c:request(b,"Dodge")); assert(c:damage(a,b,10,false,true))
	end)
	test("Read catches one frontal melee, grants punish, projectiles bypass",function()
		local c,a,b=pair("Flashstep","Mirage")
		assert(c:request(b,"Technique1")); step(c,0.15)
		assert(not c:damage(a,b,10,false,true)); assert(b.bonusUntil&gt;c.now and a.state=="Stunned")
		local hp=a.health; c:damage(b,a,10,false,true); assert(math.abs(hp-a.health-13.5)&lt;0.01)
		b.readUntil=c.now+1; hp=b.health; c:damage(a,b,5,false,false); assert(hp-b.health==5)
	end)
	test("noninterruptible Read preparation survives a hit but still takes damage",function()
		local c,a,b=pair("Flashstep","Mirage")
		assert(c:request(b,"Technique1")); c:damage(a,b,7,false,true)
		assert(b.health==b.def.Health-7 and b.state=="TechniqueChannel" and b.pending~=nil)
		step(c,0.15); assert(b.readUntil&gt;c.now)
	end)
	test("Mirage cast preserves movement and expires cleanly",function()
		local c,a,b=pair("Mirage","Flashstep")
		assert(c:request(a,"Technique3")); step(c,1.2)
		assert(b.illusionUntil&gt;c.now and b.decoyPosition~=nil and b.state=="Neutral")
		b.move=Vector3.xAxis; step(c,0.1); assert(b.hum.WalkSpeed&gt;0)
		step(c,3.1); assert(b.decoyPosition==nil)
	end)
	test("Mirage rechecks sight at payoff",function()
		local c,a,b=pair("Mirage","Flashstep")
		assert(c:request(a,"Technique3")); c:relocate(b,c.match.origin+Vector3.new(0,3,-35)); step(c,1.2)
		assert(b.illusionUntil==0 and a.cue=="CAST LOST SIGHT")
	end)
	test("real projectile places floor anchor; relocation consumes it",function()
		local c,a,b=pair("Flashstep","Mirage")
		local floor=c.match.origin+Vector3.new(12,0,0)
		assert(c:request(a,"Technique1",floor)); step(c,1)
		assert(a.anchor~=nil and a.anchor.part.Parent~=nil,"Floor anchor missing; projectiles="..#c.projectiles.." actor="..tostring(a.root.Position).." cue="..a.cue)
		local at=a.anchor.position
		assert(c:request(a,"Technique2")); step(c,0.5)
		assert(a.anchor==nil and (a.root.Position-at).Magnitude&lt;0.1 and a.state=="TechniqueRecovery")
	end)
	test("AI interrupts after reaction delay via shared combat API",function()
		local interrupted=false
		for seed=1,8 do
			local c,a,b=pair("Mirage","Flashstep")
			local ai=AI.new(c,b,seed)
			assert(c:request(a,"Technique3")); ai:update(c.now)
			assert(b.state=="Neutral","AI reacted without delay")
			for _=1,50 do
				step(c,0.02); ai:update(c.now)
				if a.cue=="INTERRUPTED" then
					assert(c.now&gt;=100+0.38,"AI interrupt bypassed reaction latency")
					interrupted=true; break
				end
			end
			if interrupted then break end
		end
		assert(interrupted,"AI never interrupted across seeded decisions")
	end)
	test("death during channel and effect/reset cleanup",function()
		local c,a,b,m=pair("Mirage","Flashstep")
		c:request(a,"Technique3"); c:damage(b,a,1000,false,true)
		assert(m.phase=="Result" and a.pending==nil and #c.projectiles==0 and #c.effects==0)
		assert(#m.effects:GetChildren()==0); local hp=b.health; step(c,5); assert(b.health==hp)
	end)
 test("controller semantic actions and tutorial objectives are complete",function()
 for _,name in {"Light","Heavy","Jump","Dodge","Guard","Tool","Grab","Lock","Sprint","Modifier","Technique5","Skip"} do
  local key=Controls.Gamepad[name]
  assert(key~=nil,"No gamepad mapping "..name)
  assert(string.match(key.Name,"^Button") or string.match(key.Name,"^DPad"),"Not a controller key for "..name)
 end
 assert(#Tutorial.Steps==18)
 local c,a,b=pair("Flashstep","Mirage");local s=c.match;s.combat=c;s.human=a;s.bot=b;s.ai=AI.new(c,b,23)
 Tutorial.new(s);Tutorial.update(s,c.now,.02)
 a.root.CFrame+=Vector3.new(4,0,0);Tutorial.update(s,c.now+.02,.02)
 assert(s.tutorial.index==1,"Uncompleted movement objective skipped")
 for _=1,4 do a.root.CFrame+=Vector3.new(4,0,0);Tutorial.update(s,c.now+.04,.02) end
 Tutorial.update(s,c.now+.4,.02);assert(s.tutorial.index==2,"Real movement did not advance objective")
 end)
 test("death during grab and launch clears both relationship endpoints",function()
 local c,a,b,m=pair("Flashstep","Mirage")
 assert(c:request(a,"Grab"));step(c,.23);assert(a.grabVictim==b)
 c:damage(b,a,1000,false,false);assert(m.phase=="Result" and not b.grabbedBy and not a.grabVictim and not b.reaction)
 end)
	test("contacts are reported once with a hit position and a style",function()
		local c,a,b=pair("Flashstep","Mirage")
		assert(c:request(a,"Attack"));step(c,.4)
		assert(b.health&lt;b.def.Health,"native strike did not land")
		local feed=c.impacts or {}
		assert(#feed&gt;0,"no contact was reported")
		local last=0
		for _,impact in feed do
			assert(impact.serial&gt;last,"impact serials are not ordered")
			assert(typeof(impact.position)=="Vector3","impact without a position")
			assert(type(impact.style)=="string","impact without a style")
			last=impact.serial
		end
		assert(c.impactSerial==last,"impactSerial disagrees with the feed")
		-- A whiff must be reported separately from a contact.
		local before=#(c.impacts or {})
		c:relocate(b,c.match.origin+Vector3.new(0,3,-40))
		assert(c:request(a,"Attack"));step(c,.6)
		local sawWhiff=false;local sawContact=false
		for _,impact in c.impacts or {} do
			if impact.style=="whiff" then sawWhiff=true end
			if impact.style=="light" or impact.style=="finisher" then sawContact=true end
		end
		assert(sawWhiff,"native whiff was not reported")
		assert(not sawContact,"out-of-range swing reported a contact")
	end)
	test("the slam brings its own actor back to the floor",function()
		local c,a,b=pair("Flashstep","Mirage")
		c:relocate(a,c.match.origin+Vector3.new(0,26,1))
		c:relocate(b,c.match.origin+Vector3.new(0,3,-1))
		a.root.CFrame=CFrame.lookAt(a.root.Position,b.root.Position)
		a.root.Anchored=false
		a.airborne=true;a.hitConfirmed=true;a.chainOpen=true;a.attackName="Air2";a.state="Recovery";a.chainAt=0
		assert(c:request(a,"Heavy"),"slam refused")
		assert(a.attackName=="Slam","air heavy did not select the slam")
		step(c,2)
		assert(not a.airborne,"slam left the attacker airborne")
		assert(a.root.Position.Y&lt;c.match.origin.Y+7,"slam parked the attacker at Y="..string.format("%.1f",a.root.Position.Y))
		a.root.Anchored=true
	end)
	-- The animation/presentation contract is a client module and cannot be
	-- required from the server; it is covered by tests/Animation.spec.luau.
	test("PC keyboard mapping matches the documented home-row layout",function()
		local keyboard=Controls.Keyboard
		for _,action in {"Light","Heavy","Dodge","Guard","Grab","Pursuit","Tool","Jump","Substitute"} do
			assert(keyboard[action]~=nil,"no keyboard binding for "..action)
		end
		assert(keyboard.Light==Enum.UserInputType.MouseButton1 and keyboard.Heavy==Enum.UserInputType.MouseButton2)
		assert(keyboard.Jump==Enum.KeyCode.Space and keyboard.Dodge==Enum.KeyCode.Q)
		assert(keyboard.Grab==Enum.KeyCode.V and keyboard.Guard==Enum.KeyCode.F)
		local seen={}
		for action,key in keyboard do
			assert(seen[key.Name]==nil,"key "..key.Name.." drives both "..seen[key.Name].." and "..action)
			seen[key.Name]=action
		end
	end)
	for _,f in active do f:Destroy() end
	local player=Players:GetPlayers()[1] or Players.PlayerAdded:Wait()
	test("remote validation + two rematches + return selection",function()
		matches:start(player,"Flashstep","Mirage")
		local s=matches.sessions[player]; local oldEpoch=s.epoch
		matches:request(player,{action="Move",epoch=s.epoch,direction=Vector3.new(0/0,0,0)})
		assert(s.human.move==Vector3.zero)
		matches:request(player,{action="Technique3",epoch=s.epoch,aim=Vector3.new(math.huge,0,0)})
		assert(s.human.state=="Neutral")
		matches:request(player,{action="Move",epoch=s.epoch-1,direction=Vector3.xAxis}); assert(s.human.move==Vector3.zero)
		for _=1,2 do
			s.combat:damage(s.human,s.bot,1000,false,true)
			local old=s.folder; assert(s.phase=="Result")
			s.lastLifecycle=-10; matches:request(player,{action="Rematch",epoch=s.epoch})
			assert(s.phase=="Duel" and old.Parent==nil and s.human.health==125)
		end
		assert(s.epoch==oldEpoch+2)
		s.combat:damage(s.human,s.bot,1000,false,true); s.lastLifecycle=-10
		matches:request(player,{action="Selection",epoch=s.epoch}); assert(s.phase=="Selection" and not s.folder)
		s.lastLifecycle=-10; matches:request(player,{action="Start",epoch=s.epoch,player="Mirage",bot="Flashstep"})
		assert(s.phase=="Duel" and s.human.def.Name=="Itachi")
		matches:selection(player)
	end)
	 test("R15 procedural combat motion is local and donor clips are optional",function()
  local c,a,b=pair("Flashstep","Mirage")
	  local client=game:GetService("StarterPlayer").StarterPlayerScripts.NinjaDuelClient
	  assert(client:FindFirstChild("VelmoraMotionEngine") and client:FindFirstChild("VelmoraHitFeedback"))
  a.model:SetAttribute("SkipDonorAnimationQA",nil)
  local animation=require(script.Parent.Animation)
  assert(animation.attach(a))
  local deadline=os.clock()+15
  repeat task.wait(.1) until a.model:GetAttribute("DonorAnimationStatus")~="Loading" or os.clock()&gt;deadline
	  if a.model:GetAttribute("DonorAnimationStatus")=="Ready" then
	   for _,name in {"Punch","HardSmack","MegaPunch","Parry"} do
	    local track=a.animation.tracks[name];assert(track,name.." missing")
	    track:Play();task.wait(.2);assert(track.Length&gt;0 and track.IsPlaying,name.." did not play");track:Stop()
	   end
	  else warn("[NinjaDuelQA] External Bangla clips unavailable; Velmora procedural R15 motion remains active") end
  animation.clear(a)
 end)
 for _,f in active do if f.Parent then f:Destroy() end end
	print(string.format("[NinjaDuelQA] TOTAL %d PASS / %d FAIL",passed,failed))
end
return QA
</ProtectedString>
