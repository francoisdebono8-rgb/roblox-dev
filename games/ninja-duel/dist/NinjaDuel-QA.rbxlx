	ThrowUp={pose({16,0,-14},{24,-18,0},{45,0,30},{-35,0,-30},{-55,0,0},{-20,0,0},{-85,-65}),pose({-14,22,0},{-24,28,0},{-160,0,12},{18,0,-30},{-60,0,0},{26,0,0},{-15,-70})},
	},
