for name,clip in require(script.Parent.AuthoredClips11) do all[name]=clip end
for name,clip in require(script.Parent.AuthoredClips12) do all[name]=clip end
for name,clip in require(script.Parent.AuthoredClips13) do all[name]=clip end
for name,clip in require(script.Parent.AuthoredClips14) do all[name]=clip end
for name,clip in require(script.Parent.AuthoredClips15) do all[name]=clip end
for name,clip in require(script.Parent.AuthoredClips16) do all[name]=clip end
for name,clip in require(script.Parent.AuthoredClips17) do all[name]=clip end
for name,clip in require(script.Parent.AuthoredClips18) do all[name]=clip end
for name,clip in require(script.Parent.AuthoredClips19) do all[name]=clip end
for name,clip in require(script.Parent.AuthoredClips20) do all[name]=clip end
for name,clip in require(script.Parent.AuthoredClips21) do all[name]=clip end
for name,clip in require(script.Parent.AuthoredClips22) do all[name]=clip end
for name,clip in require(script.Parent.AuthoredClips23) do all[name]=clip end
for name,clip in require(script.Parent.AuthoredClips24) do all[name]=clip end
for name,clip in require(script.Parent.AuthoredClips25) do all[name]=clip end
for name,clip in require(script.Parent.AuthoredClips26) do all[name]=clip end
for name,clip in require(script.Parent.AuthoredClips27) do all[name]=clip end
for name,clip in require(script.Parent.AuthoredClips28) do all[name]=clip end
for name,clip in require(script.Parent.AuthoredClips29) do all[name]=clip end
for name,clip in require(script.Parent.AuthoredClips30) do all[name]=clip end
for name,clip in require(script.Parent.AuthoredClips31) do all[name]=clip end
return all
</ProtectedString>
