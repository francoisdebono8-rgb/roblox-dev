	K(1,le({root={y=-.3,yaw=-30,pitch=-6},torso={yaw=-20},head={yaw=10},la={raise=40,out=60,elbow=30},ll={lift=100,out=-10,twist=-30,knee=10,ankle=-20}}),"out"),
