		LeftAnkle={0.2971,0.1039,0.239,0.9186,0.2971,0.1039,0.239,0.9186,0.2971,0.1039,0.239,0.9186,0.2971,0.1039,0.239,0.9186,0.2972,0.1038,0.239,0.9186,0.2972,0.1038,0.239,0.9186,0.2973,0.1037,0.2391,0.9185,0.2973,0.1036,0.2391,0.9185,0.2974,0.1036,0.2391,0.9185,0.2975,0.1035,0.2392,0.9185,0.2976,0.1034,0.2392,0.9184,0.2977,0.1033,0.2392,0.9184,0.2978,0.1032,0.2393,0.9184,0.298,0.103,0.2393,0.9183,0.2981,0.1029,0.2394,0.9183,0.2982,0.1028,0.2394,0.9182,0.2984,0.1026,0.2395,0.9182,0.2985,0.1025,0.2395,0.9182,0.2987,0.1023,0.2396,0.9181,0.2988,0.1022,0.2397,0.9181,0.299,0.102,0.2397,0.918,0.2992,0.1019,0.2398,0.918,0.2993,0.1017,0.2398,0.9179,0.2995,0.1015,0.2399,0.9178,0.2997,0.1014,0.24,0.9178,0.2999,0.1012,0.24,0.9177,0.3,0.101,0.2401,0.9177,0.3002,0.1008,0.2402,0.9176,0.3004,0.1006,0.2402,0.9176,0.3006,0.1005,0.2403,0.9175,0.3008,0.1003,0.2404,0.9174,0.3009,0.1001,0.2405,0.9174,0.3011,0.0999,0.2405,0.9173,0.3013,0.0997,0.2406,0.9173,0.3015,0.0995,0.2407,0.9172,0.3017,0.0994,0.2407,0.9172,0.3018,0.0992,0.2408,0.9171,0.302,0.099,0.2409,0.917,0.3022,0.0988,0.2409,0.917,0.3024,0.0987,0.241,0.9169,0.3025,0.0985,0.241,0.9169,0.3027,0.0984,0.2411,0.9168,0.3028,0.0982,0.2412,0.9168,0.303,0.098,0.2412,0.9167,0.3031,0.0979,0.2413,0.9167,0.3033,0.0978,0.2413,0.9166,0.3034,0.0976,0.2414,0.9166,0.3035,0.0975,0.2414,0.9166,0.3036,0.0974,0.2415,0.9165,0.3038,0.0973,0.2415,0.9165,0.3039,0.0972,0.2416,0.9164,0.304,0.0971,0.2416,0.9164,0.304,0.097,0.2416,0.9164,0.3041,0.0969,0.2417,0.9164,0.3042,0.0968,0.2417,0.9163,0.3043,0.0968,0.2417,0.9163,0.3043,0.0967,0.2417,0.9163,0.3043,0.0967,0.2417,0.9163,0.3044,0.0966,0.2418,0.9163,0.3044,0.0966,0.2418,0.9163,0.3044,0.0966,0.2418,0.9163,0.3044,0.0966,0.2418,0.9163,0.3044,0.0966,0.2418,0.9163,0.3043,0.0967,0.2417,0.9163,0.3043,0.0967,0.2417,0.9163,0.3043,0.0968,0.2417,0.9163,0.3042,0.0968,0.2417,0.9163,0.3041,0.0969,0.2417,0.9164,0.304,0.097,0.2416,0.9164,0.304,0.0971,0.2416,0.9164,0.3039,0.0972,0.2416,0.9164,0.3038,0.0973,0.2415,0.9165,0.3036,0.0974,0.2415,0.9165,0.3035,0.0975,0.2414,0.9166,0.3034,0.0976,0.2414,0.9166,0.3033,0.0978,0.2413,0.9166,0.3031,0.0979,0.2413,0.9167,0.303,0.098,0.2412,0.9167,0.3028,0.0982,0.2412,0.9168,0.3027,0.0984,0.2411,0.9168,0.3025,0.0985,0.241,0.9169,0.3024,0.0987,0.241,0.9169,0.3022,0.0988,0.2409,0.917,0.302,0.099,0.2409,0.917,0.3018,0.0992,0.2408,0.9171,0.3017,0.0994,0.2407,0.9172,0.3015,0.0995,0.2407,0.9172,0.3013,0.0997,0.2406,0.9173,0.3011,0.0999,0.2405,0.9173,0.3009,0.1001,0.2405,0.9174,0.3008,0.1003,0.2404,0.9174,0.3006,0.1005,0.2403,0.9175,0.3004,0.1006,0.2402,0.9176,0.3002,0.1008,0.2402,0.9176,0.3,0.101,0.2401,0.9177,0.2999,0.1012,0.24,0.9177,0.2997,0.1014,0.24,0.9178,0.2995,0.1015,0.2399,0.9178,0.2993,0.1017,0.2398,0.9179,0.2992,0.1019,0.2398,0.918,0.299,0.102,0.2397,0.918,0.2988,0.1022,0.2397,0.9181,0.2987,0.1023,0.2396,0.9181,0.2985,0.1025,0.2395,0.9182,0.2984,0.1026,0.2395,0.9182,0.2982,0.1028,0.2394,0.9182,0.2981,0.1029,0.2394,0.9183,0.298,0.103,0.2393,0.9183,0.2978,0.1032,0.2393,0.9184,0.2977,0.1033,0.2392,0.9184,0.2976,0.1034,0.2392,0.9184,0.2975,0.1035,0.2392,0.9185,0.2974,0.1036,0.2391,0.9185,0.2973,0.1036,0.2391,0.9185,0.2973,0.1037,0.2391,0.9185,0.2972,0.1038,0.239,0.9186,0.2972,0.1038,0.239,0.9186,0.2971,0.1039,0.239,0.9186,0.2971,0.1039,0.239,0.9186,0.2971,0.1039,0.239,0.9186,0.2971,0.1039,0.239,0.9186},
