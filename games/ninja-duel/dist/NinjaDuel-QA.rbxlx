      <Item class="ModuleScript" referent="ND49">
        <Properties>
          <string name="Name">CombatInspector</string>
          <ProtectedString name="Source">-- Read-only QA projection. Never imported by combat, movement or Motion Lab.
-- State, reaction and locomotion are independent axes in the existing engine.
local Inspector={}
-- Discoverable hooks into the existing common engine, not a second tool system.
Inspector.ToolHooks={
 holdEquip="Combat.beginThrow(actor, spec); no persistent inventory/equip state",
 release="Combat.stepThrow(actor): spec.fire(index, aim) on the authored release frame",
 spawn="Combat.projectile(actor, aim, speed, range, damage, kind, onSurface?, opts?)",
 impact="Combat.projectileHit(projectile, target, position, normal)",
 surface="Combat.projectileSurface(projectile, raycastResult); projectile.onSurface(position, normal, victim?)",
 embedded="Techniques.plant / actor.anchors for Minato seals; ordinary blade stick is a presentation impact",
 recall="Combat.markedInFlight reads a travelling seal; no generic weapon recall mechanic",
 cleanup="Combat.removeProjectile / updateProjectiles / Combat.clear / Techniques.expireSeals",
 conversion="Existing ToolMastery, MoveGraphs, onSurface callbacks and Techniques.wireBind; preserve character identity",
}
local function remaining(value,now) return math.max(0,(value or 0)-now) end
local function counts(source)
 local result={};for key,value in source or {} do if type(value)=="number" then result[key]=value end end;return result
end
function Inspector.actor(c,a)
 local now=c.now;local pending=a.pending;local spec=pending and pending.spec
 local attack=if pending then pending.name or (spec and spec.Id) else nil
 local phase=if a.state=="Startup" or a.state=="TechniqueChannel" then "startup" elseif a.state=="Active" or a.state=="TechniqueActive" then "active" elseif a.state=="Recovery" or a.state=="TechniqueRecovery" then "recovery" else "none"
 local durations=if spec then {startup=spec.startup or spec.Channel or 0,active=spec.active or spec.Active or 0,recovery=spec.recovery or spec.Recovery or 0} else nil
 local velocity=a.root.AssemblyLinearVelocity
 local terrain=if a.wall then "wall" elseif a.airborne then (if velocity.Y&lt;-.1 then "falling" else "air") else "ground"
 local movement=if a.wall then "wall" elseif a.reaction then "reaction:"..a.reaction elseif a.state=="Pursuit" or a.state=="Rush" or a.state=="Dodging" then a.state elseif a.airborne then "air" elseif (a.locomotion or Vector3.zero).Magnitude&gt;.1 then (if a.sprinting then "sprint" else "locomotion") else "idle"
 local projectiles={}
 for _,p in c.projectiles do if p.a==a then table.insert(projectiles,{id=p.id,kind=p.kind,remaining=p.remaining,age=now-p.born}) end end
 local anchors={}
 for _,anchor in a.anchors or {} do table.insert(anchors,{id=anchor.id,body=anchor.actor and anchor.actor.id,remaining=remaining(anchor.expires,now)}) end
 return {id=a.id,fighterId=a.fighterId,name=a.def.Name,state=a.state,reaction=a.reaction or "none",reactionRemaining=remaining(a.reactionUntil,now),
  move=attack or "none",attackVariant=a.attackVariant or "none",phase=phase,phaseRemaining=remaining(a.untilTime,now),durations=durations,
  elapsed=if pending then math.max(0,now-(if pending.kind=="Brawl" then a.attackStarted or now else a.castStarted or now)) else 0,
  combo=a.combo or 0,comboRoute=attack or a.attackName or "none",comboHits=a.comboHits or 0,hitConfirmed=a.hitConfirmed==true,chainOpen=a.chainOpen==true and now&gt;=(a.chainAt or math.huge),
  buffered=a.buffered and a.buffered.action or "none",target=a.target and a.target.id or "none",locked=a.locked==true,terrain=terrain,movement=movement,
  cue=if (a.cueUntil or 0)&gt;now then a.cue or "" else "",guard=a.guardHeld==true,stamina=a.stamina or 0,parryCooldown=remaining(a.parryReadyAt,now),dodge=remaining(a.dodgeUntil,now),invulnerability=remaining(a.invulnerableUntil,now),
  counter=remaining(a.counterUntil,now),riposte=remaining(a.riposteUntil,now),read=remaining(a.readUntil,now),
  grabbedBy=a.grabbedBy and a.grabbedBy.id or "none",grabVictim=a.grabVictim and a.grabVictim.id or "none",
  throw=if a.throwing then {kind=a.throwing.kind,fired=a.throwing.fired,count=a.throwing.count,releaseIn=remaining(a.throwing.nextRelease,now)} else nil,
  projectiles=projectiles,anchors=anchors,wireVictim=a.wireVictim and a.wireVictim.id or "none",bound=a.reaction=="Bound",
  awakening=remaining(a.awakenUntil,now),events=counts(a.events),health=a.health,chakra=a.chakra,
  -- Clashes are events followed by Recovery, not a persistent WeaponClash state.
  clashes=(a.events or {}).Clash or 0,weaponClashState="not a persistent state"}
end
function Inspector.snapshot(s)
 local rows={};for _,a in s.combat.actors do table.insert(rows,Inspector.actor(s.combat,a)) end
 local impacts={}
 for _,impact in s.combat.impacts or {} do table.insert(impacts,{id=impact.id or impact.serial,style=impact.style,kind=impact.kind,owner=impact.owner,victim=impact.victim}) end
 return {phase=s.phase,epoch=s.epoch,now=s.combat.now,actors=rows,projectileCount=#s.combat.projectiles,hazardCount=#s.combat.hazards,impacts=impacts}
end
function Inspector.record(trace,snapshot,limit)
 -- Compare projections, never hold references to mutable actors or pending moves.
 trace.last=trace.last or {};trace.entries=trace.entries or {}
 for _,a in snapshot.actors do
  local key=table.concat({a.state,a.reaction,a.move,a.attackVariant,a.terrain,tostring(a.combo),tostring(a.clashes),a.throw and a.throw.kind or "none"},"|")
  if trace.last[a.id]~=key then
   trace.last[a.id]=key
   table.insert(trace.entries,{at=snapshot.now,id=a.id,fighter=a.fighterId,state=a.state,reaction=a.reaction,move=a.move,variant=a.attackVariant,terrain=a.terrain,combo=a.combo,clashes=a.clashes})
  end
 end
 while #trace.entries&gt;(limit or 80) do table.remove(trace.entries,1) end
end
return Inspector
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND50">
        <Properties>
          <string name="Name">Costumes</string>
          <ProtectedString name="Source">-- Costumes of the roster breadth pass (ROSTER_20): each one registers under
-- its fighter's Name and is built from World's costume helpers (kit: wear,
-- cyl, headband, face, hairCap, spike, rgb, A, R). Young fighters (12-14),
-- practical gear, silhouettes that read at combat distance; flat materials.
local Costumes={}

function Costumes.install(dressers,kit)
	local wear,face,hairCap,spike,rgb,A,R=kit.wear,kit.face,kit.hairCap,kit.spike,kit.rgb,kit.A,kit.R

	local function paint(model,names,color)
		for _,name in names do local part=model:FindFirstChild(name);if part then part.Color=color end end
	end
	local ARMS={"LeftUpperArm","RightUpperArm","LeftLowerArm","RightLowerArm"}
	local LEGS={"LeftUpperLeg","RightUpperLeg","LeftLowerLeg","RightLowerLeg"}
	local TORSO={"UpperTorso","LowerTorso"}
	local function sandals(model,def,strap)
		local skin=Color3.fromRGB(table.unpack(def.Skin))
		for _,side in {"Left","Right"} do
			local foot=model:FindFirstChild(side.."Foot");if foot then foot.Color=strap end
			wear(model,side.."Foot","Toes",Vector3.new(.7,.16,.34),CFrame.new(0,.1,-.42),skin)
		end
	end
	Costumes.paint=paint;Costumes.sandals=sandals

	-- Hinata (12): short dark-indigo hair with two long locks framing the face,
	-- a pale lavender hooded jacket with a fur-trimmed hood down, navy trousers,
	-- the headband worn round the neck, the Byakugan's pale eyes.
	dressers.Hinata=function(model,def)
		local hair=rgb(40,36,70)
		local jacket=rgb(222,214,236)
		local jacketShade=rgb(190,180,212)
		local trousers=rgb(44,48,82)
		local cap=model:FindFirstChild("Hair");if cap then cap.Color=hair;cap.Transparency=1 end
		face(model,rgb(214,206,240),hair)
		for _,p in model:GetChildren() do
			if p.Name=="Eye" then p.Color=rgb(244,242,252);p.Size=Vector3.new(.32,.2,.04) end
			if p.Name=="Iris" then p.Material=Enum.Material.Neon;p.Transparency=.35;p.Color=rgb(206,198,240) end
		end
		hairCap(model,hair)
		-- Short cut: a straight fringe and two long locks down to the chin.
		wear(model,"Head","Fringe",Vector3.new(1.62,.3,.18),CFrame.new(0,.52,-.78),hair)
		for _,side in {-1,1} do
			wear(model,"Head","FaceLock",Vector3.new(.2,1.25,.32),CFrame.new(side*.78,-.22,-.5)*A(0,0,R(side*-3)),hair)
			wear(model,"Head","SideHair",Vector3.new(.18,.9,.9),CFrame.new(side*.82,.02,.2),hair)
		end
		wear(model,"Head","BackHair",Vector3.new(1.66,1.1,.28),CFrame.new(0,0,.74),hair)
		paint(model,TORSO,jacket);paint(model,ARMS,jacket);paint(model,LEGS,trousers)
		-- The jacket: a zip, a fur trim where the hood falls, cuffs.
		wear(model,"UpperTorso","Zip",Vector3.new(.06,1.5,.04),CFrame.new(0,-.05,-.53),jacketShade)
		wear(model,"UpperTorso","HoodDown",Vector3.new(1.5,.5,.6),CFrame.new(0,.7,.42),jacketShade)
		wear(model,"UpperTorso","FurTrim",Vector3.new(1.56,.2,1.12),CFrame.new(0,.86,0),rgb(238,234,226))
		wear(model,"LowerTorso","Hem",Vector3.new(2.08,.34,1.1),CFrame.new(0,-.1,0),jacket)
		for _,side in {"Left","Right"} do
			wear(model,side.."LowerArm","Cuff",Vector3.new(.86,.2,.86),CFrame.new(0,-.42,0),jacketShade)
		end
		-- The Leaf headband round her neck, the plate at her throat.
		wear(model,"UpperTorso","NeckBand",Vector3.new(1.3,.22,1.0),CFrame.new(0,.98,0),rgb(28,36,58))
		wear(model,"UpperTorso","NeckPlate",Vector3.new(.66,.24,.06),CFrame.new(0,.98,-.52),rgb(176,184,194),Enum.Material.Metal)
		sandals(model,def,rgb(40,46,66))
	end

	-- Kakashi (14, the Copy Ninja): silver hair swept up and to one side, the
	-- mask over his nose and mouth, the headband slanted over his left eye
	-- (the Sharingan under it), a green flak vest over navy.
	dressers.Kakashi=function(model,def)
		local hair=rgb(214,218,222)
		local hairShade=rgb(178,184,192)
		local navy=rgb(40,50,72)
		local vest=rgb(92,112,70)
		local vestShade=rgb(70,88,54)
		local cap=model:FindFirstChild("Hair");if cap then cap.Color=hair;cap.Transparency=1 end
		face(model,rgb(40,40,44),rgb(150,150,156))
		hairCap(model,hair)
		-- The hair rises in a slanted crest toward his right.
		local spikes={{Vector3.new(0,.8,.1),Vector3.new(.5,1,.2),1.5},{Vector3.new(-.3,.75,.2),Vector3.new(.1,1,.3),1.4},{Vector3.new(.35,.65,.1),Vector3.new(.9,.7,.2),1.3},
			{Vector3.new(-.55,.55,.2),Vector3.new(-.4,1,.4),1.1},{Vector3.new(0,.5,.6),Vector3.new(.3,.6,1),1.2},{Vector3.new(.55,.35,.3),Vector3.new(1,.25,.4),1.0}}
		for i,s in spikes do spike(model,s[1],s[2],s[3],.5,.42,if i%2==0 then hairShade else hair) end
		-- The mask: up over the nose, the mouth hidden.
		wear(model,"Head","Mask",Vector3.new(1.62,.62,1.62),CFrame.new(0,-.36,-.02),navy)
		for _,p in model:GetChildren() do if p.Name=="Mouth" then p.Transparency=1 end end
		-- The headband slanted down over the left eye (+12 degrees of roll lowers
		-- his left side, -X).
		local tilt=A(0,0,R(12))
		wear(model,"Head","Headband",Vector3.new(1.68,.26,1.68),CFrame.new(0,.26,0)*tilt,rgb(28,36,58))
		wear(model,"Head","HeadbandPlate",Vector3.new(.9,.32,.06),CFrame.new(-.06,.24,-.86)*tilt,rgb(176,184,194),Enum.Material.Metal)
		wear(model,"Head","LeafMark",Vector3.new(.3,.14,.02),CFrame.new(-.06,.26,-.9)*tilt,rgb(70,78,90),Enum.Material.Metal)
		wear(model,"Head","EyeCover",Vector3.new(.42,.26,.06),CFrame.new(-.3,.1,-.83),rgb(28,36,58))
		paint(model,TORSO,navy);paint(model,ARMS,navy);paint(model,LEGS,navy)
		-- Flak vest with its scroll pouches, the red swirl on the shoulders skipped.
		wear(model,"UpperTorso","Vest",Vector3.new(2.1,1.62,1.14),CFrame.new(0,-.02,0),vest)
		wear(model,"UpperTorso","VestCollar",Vector3.new(1.5,.3,1.16),CFrame.new(0,.82,.02),vestShade)
		for _,x in {-.5,.5} do
			for k=0,1 do wear(model,"UpperTorso","Pouch",Vector3.new(.42,.36,.12),CFrame.new(x,-.12-k*.42,-.6),vestShade) end
		end
		wear(model,"LowerTorso","Belt",Vector3.new(2.06,.2,1.06),CFrame.new(0,.34,0),rgb(30,34,46))
		for _,side in {"Left","Right"} do
			wear(model,side.."LowerArm","Glove",Vector3.new(.84,.4,.84),CFrame.new(0,-.36,0),rgb(30,32,40))
			wear(model,side.."LowerLeg","ShinWrap",Vector3.new(.86,.55,.86),CFrame.new(0,-.2,0),rgb(220,220,214))
		end
		wear(model,"RightUpperLeg","Holster",Vector3.new(.24,.5,.5),CFrame.new(.5,-.05,0),rgb(30,34,46))
		sandals(model,def,rgb(40,46,66))
	end
end
return Costumes
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND51">
        <Properties>
          <string name="Name">DevCommands</string>
          <ProtectedString name="Source">-- Studio tooling boundary (Codex 33028b2, ported): the F6 panel's remote and
-- the `tool` bindable op reach DevTools only through this allowlist of
-- operations, argument keys and types. Debug/QA places only (DEBUG_SOURCES).
local Commands={}
Commands.ops={reset=true,character=true,scenario=true,["repeat"]=true,profile=true,report=true,
	dummy=true,refill=true,awaken=true,ko=true,list=true,panel=true,selftest=true}
function Commands.validate(op,arg)
	if type(op)~="string" or not Commands.ops[op] then return false end
	if arg==nil then return true,{} end
	if type(arg)~="table" then return false end
	local out={};local n=0
	for k,v in arg do
		n+=1;if n&gt;5 then return false end
		if k=="first" or k=="second" or k=="name" then
			if type(v)~="string" or #v&gt;32 then return false end
		elseif k=="actor" then
			if v~="human" and v~="bot" then return false end
		elseif k=="enabled" then
			if type(v)~="boolean" then return false end
		else return false end
		out[k]=v
	end
	return true,out
end
return Commands
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND52">
        <Properties>
          <string name="Name">DevGateCheck</string>
          <ProtectedString name="Source">-- Debug/QA places only (build.py DEBUG_SOURCES): QA-004 gate scenarios run
-- in the real build (native physics, real stage, real Combat) on the live
-- session, from the Server command bar:
--   workspace:SetAttribute("NinjaDuelGate","M1,M2")  (DevHooks runs it here)
-- Each scenario starts its own duel through the dev hook, drives both sides
-- through Combat:request (the remote's own entry point) and prints PASS/FAIL
-- with what was measured. It proves server behaviour in the native world;
-- real keys, the look and human feel are separate checks.
local ServerStorage=game:GetService("ServerStorage")
local LogService=game:GetService("LogService")
local Fighters=require(game:GetService("ReplicatedStorage").NinjaDuel.Fighters)
local DevHooks=require(script.Parent.DevHooks)
local Bodies=require(script.Parent.Bodies)
local Brawler=require(script.Parent.Brawler)

local function flat(v) return Vector3.new(v.X,0,v.Z) end
local function slot(id,tech)
	for i,spec in Fighters[id].Techniques do if spec.Id==tech then return "Technique"..i,spec end end
	error(id.." has no "..tech)
end
local dev
local function session()
	for _,s in DevHooks.matches.sessions do if s.combat then return s end end
end
local function start(a,b)
	dev:Invoke("start",a,b)
	local t0=os.clock()
	repeat task.wait(.2);local r=dev:Invoke("act","human","GuardOff") until (type(r)=="table" and r.reason~="Intro") or os.clock()-t0&gt;12
	dev:Invoke("autopilot",false);dev:Invoke("freezeBot",true);dev:Invoke("scripted",true);dev:Invoke("refill")
	dev:Invoke("health","bot",400)
	local s=session()
	return s.combat,s.human,s.bot,s
end
local function place(c,a,b,pa,pb)
	local o=c.match.origin
	c:relocate(a,o+pa);c:relocate(b,o+pb)
	a.root.CFrame=CFrame.lookAt(a.root.Position,Vector3.new(b.root.Position.X,a.root.Position.Y,b.root.Position.Z))
	b.root.CFrame=CFrame.lookAt(b.root.Position,Vector3.new(a.root.Position.X,b.root.Position.Y,a.root.Position.Z))
	a.move=Vector3.zero;b.move=Vector3.zero
	task.wait(.2)
end
local function confirmOne(c,a)
	c:request(a,"Attack")
	local t=os.clock()
	repeat task.wait() until (a.state=="Recovery" and a.chainOpen==true and c.now&gt;=(a.chainAt or 0)) or os.clock()-t&gt;1
end

local S={}
-- M1 ----------------------------------------------------------------------
S.S1=function()
	local c,a,b=start("Puppet","Leaf");place(c,a,b,Vector3.new(0,3,3.5),Vector3.new(0,3,-3.5));a.chakra=999
	c:request(a,(slot("Puppet","Marionette")),b.root.Position);task.wait(.8)
	local p=Bodies.of(c,a,"puppet")[1];if not p then return false,"no marionette" end
	place(c,a,b,Vector3.new(0,3,3.5),Vector3.new(0,3,-3.5))
	confirmOne(c,a);c:request(a,"Heavy")
	local carried=a.attackName=="PuppetBlade" and a.pending and a.pending.body==p
	task.wait(2)
	return carried and p.alive and p.mode=="marionette",string.format("carried=%s alive=%s mode=%s",tostring(carried),tostring(p.alive),tostring(p.mode))
end
S.S2=function()
	local c,a,b=start("Puppet","Leaf");place(c,a,b,Vector3.new(0,3,3.5),Vector3.new(0,3,-3.5));a.chakra=999
	c:request(a,(slot("Puppet","Marionette")),b.root.Position);task.wait(.8)
	local p=Bodies.of(c,a,"puppet")[1];if not p then return false,"no marionette" end
	place(c,a,b,Vector3.new(0,3,3.5),Vector3.new(0,3,-3.5))
	confirmOne(c,a);confirmOne(c,a)
	a.move=flat(b.root.Position-a.root.Position).Unit;c:request(a,"Attack");a.move=Vector3.zero
	local route=a.attackName
	task.wait(2)
	return route=="PuppetRise" and p.alive and p.mode=="marionette",string.format("route=%s alive=%s mode=%s",tostring(route),tostring(p.alive),tostring(p.mode))
end
S.S3=function()
	local c,a,b=start("Puppet","Leaf");place(c,a,b,Vector3.new(0,3,3.5),Vector3.new(0,3,-3.5));a.chakra=999
	c:request(a,(slot("Puppet","Marionette")),b.root.Position);task.wait(.8)
	local p=Bodies.of(c,a,"puppet")[1];if not p then return false,"no marionette" end
	place(c,a,b,Vector3.new(0,3,3.5),Vector3.new(0,3,-3.5))
	confirmOne(c,a);c:request(a,"Heavy")
	Brawler.react(c,a,"HitStun",Vector3.zero,.4,b)
	task.wait(1)
	return p.alive and p.mode=="marionette" and not p.carry,string.format("alive=%s mode=%s carry=%s",tostring(p.alive),tostring(p.mode),tostring(p.carry~=nil))
end
S.S4=function()
	local out={}
	for _,guarding in {true,false} do
		local c,a,b=start("Puppet","Leaf");place(c,a,b,Vector3.new(0,3,10),Vector3.new(0,3,-10));a.chakra=999;b.health=400
		c:request(a,(slot("Puppet","Marionette")),b.root.Position)
		local t=os.clock()
		repeat
			if guarding and b.state~="Guarding" then c:request(b,"Guard") end
			task.wait()
		until b.health&lt;400 or os.clock()-t&gt;5
		task.wait(.1)
		table.insert(out,{guarding=guarding,hit=b.health&lt;400,poisoned=(b.poisonedUntil or 0)&gt;0})
	end
	local ok=out[1].hit and not out[1].poisoned and out[2].hit and out[2].poisoned
	return ok,string.format("guard: hit=%s poisoned=%s • open: hit=%s poisoned=%s",tostring(out[1].hit),tostring(out[1].poisoned),tostring(out[2].hit),tostring(out[2].poisoned))
end
S.S5=function()
	local c,a,b,s=start("Puppet","Leaf");place(c,a,b,Vector3.new(0,3,6),Vector3.new(0,3,-6));a.chakra=999
	c:request(a,(slot("Puppet","Marionette")),b.root.Position);task.wait(.5)
	local p=Bodies.of(c,a,"puppet")[1];if not p then return false,"no marionette" end
	Bodies.dispel(c,p,"hit",b);task.wait(.3)
	local broken=#Bodies.of(c,a,"puppet")==0
	-- KO and the next round: nothing left over.
	dev:Invoke("ko","bot")
	task.wait(6)
	local s2=session()
	local left=s2 and s2.combat and #(s2.combat.bodies or {}) or 0
	return broken and left==0,string.format("broken=%s bodies after KO/reset=%d phase=%s",tostring(broken),left,tostring(s2 and s2.phase))
end
-- M2 ----------------------------------------------------------------------
S.S6=function()
	local c,a,b=start("Clay","Leaf");place(c,a,b,Vector3.new(0,3,0),Vector3.new(0,3,-20));a.chakra=999
	local s,spec=slot("Clay","ClayMine")
	local o=c.match.origin
	c:request(a,s,o+Vector3.new(-10,3,-15));task.wait(.6)
	local near
	for _,h in c.hazards do if h.a==a then near=flat(h.position-a.root.Position).Magnitude end end
	a.cooldowns={};a.chakra=999
	local before=#c.hazards
	c:request(a,s,o+Vector3.new(0,3,-100));task.wait(.6)
	local far=0
	for _,h in c.hazards do if h.a==a then far=math.max(far,flat(h.position-a.root.Position).Magnitude) end end
	return near~=nil and far&lt;=spec.Range+.5,string.format("aimed at 18: set at %.1f • aimed at 100: furthest %.1f (Range %d, hazards %d→%d)",near or -1,far,spec.Range,before,#c.hazards)
end
S.S8=function()
	local c,a,b=start("Mist","Leaf");place(c,a,b,Vector3.new(0,3,0),Vector3.new(0,3,-20));a.chakra=999
	local from=a.root.Position
	local ok=c:request(a,(slot("Mist","SilentKilling")),b.root.Position)
	c:relocate(b,c.match.origin+Vector3.new(0,3,-105))
	task.wait(.7)
	local moved=flat(a.root.Position-from).Magnitude
	return ok and moved&lt;4,string.format("accepted=%s moved=%.1f studs after the body left to 105",tostring(ok),moved)
end
S.S10=function()
	local c,a,b=start("Flicker","Leaf");place(c,a,b,Vector3.new(0,3,0),Vector3.new(0,3,-20));a.chakra=999
	c:request(a,(slot("Flicker","BodyFlicker")),b.root.Position);task.wait(.4)
	local arrived=flat(a.root.Position-b.root.Position).Magnitude&lt;6
	place(c,a,b,Vector3.new(0,3,0),Vector3.new(0,3,-80));a.chakra=999;a.cooldowns={}
	local back=c:request(a,(slot("Flicker","FlickerOut")),b.root.Position)
	local c2,a2,b2=start("Mist","Leaf");place(c2,a2,b2,Vector3.new(0,3,0),Vector3.new(0,3,-90));a2.chakra=999
	local chakra=a2.chakra
	local far,why=c2:request(a2,(slot("Mist","SilentKilling")),b2.root.Position)
	local mist=c2:request(a2,(slot("Mist","HiddenMist")))
	return arrived and back and not far and a2.chakra&lt;=chakra and mist,string.format("flicker in range arrived=%s • retreat at 80=%s • kill at 90 refused=%s (%s) • mist Self=%s",
		tostring(arrived),tostring(back),tostring(not far),tostring(why),tostring(mist))
end
-- M3 ----------------------------------------------------------------------
local Families=require(script.Parent.Families)
-- S11/S13: the player (Copycat) stands in the bot Zabuza's mist; Zabuza steps
-- sideways three times (watch the camera: it must not follow him), then the
-- player leaves the mist (the lock comes back).
S.S11=function()
	local c,a,b=start("Copycat","Mist");place(c,a,b,Vector3.new(0,3,0),Vector3.new(0,3,-8));b.chakra=999
	c:request(b,(slot("Mist","HiddenMist")));task.wait(1)
	local lost=Families.shrouded(c,a)
	local o=c.match.origin
	for k=1,3 do c:relocate(b,o+Vector3.new(k%2==0 and -7 or 7,3,-8+k));task.wait(1.6) end
	local stillLost=Families.shrouded(c,a)
	c:relocate(a,o+Vector3.new(0,3,30));task.wait(1.5)
	local found=not Families.shrouded(c,a)
	return lost and stillLost and found,string.format("player lost in mist=%s (after 3 side steps=%s) • out of it, found again=%s",tostring(lost),tostring(stillLost),tostring(found))
end
-- S12/S14: inside the mist a manual tool aim goes where it was given (no
-- homing); Zabuza in his own mist is not lost; the bot lost aims at its memory.
S.S12=function()
	local c,a,b=start("Copycat","Mist");place(c,a,b,Vector3.new(0,3,0),Vector3.new(0,3,-8));b.chakra=999
	c:request(b,(slot("Mist","HiddenMist")));task.wait(1)
	a.neutralToolAt=0;a.chakra=999
	local wide=b.root.Position+Vector3.new(5,0,0)
	local ok=c:request(a,"Tool",wide)
	local dir
	for _=1,30 do task.wait();for _,p in c.projectiles do if p.a==a then dir=p.direction end end;if dir then break end end
	local toAim,toBody=(wide-a.root.Position).Unit,(b.root.Position-a.root.Position).Unit
	local manual=dir~=nil and dir:Dot(toAim)&gt;dir:Dot(toBody)
	local zabuzaSees=not Families.shrouded(c,b)
	return ok and manual and zabuzaSees,string.format("tool thrown=%s goes to the given aim=%s • Zabuza lost in his own mist=%s",tostring(ok),tostring(manual),tostring(not zabuzaSees))
end
-- M4 ----------------------------------------------------------------------
-- Native baseline of the grid's measures (no tuning). S15: third light then
-- heavy on a body at its HP: distance/time from each contact to the end of
-- its reaction. S16: L1, L2, toward+L (launcher), E, three air strikes, in one
-- sequence without refill or replacement; every request logged. S17: an AI
-- duel; distinct techniques counted by Cast:&lt;Id&gt; events.
local function measure(c,a,b,action,stick)
	local hp=b.health
	if stick then a.move=stick end
	local ok,why=c:request(a,action);a.move=Vector3.zero
	local t0=os.clock();local from,at,push,done=nil,nil,0,nil
	repeat
		task.wait()
		if not from and b.health&lt;hp then from=b.root.Position;at=os.clock() end
		if from then push=math.max(push,flat(b.root.Position-from).Magnitude);if b.reaction==nil then done=os.clock() end end
	until done or os.clock()-t0&gt;2.5
	return ok,why,from~=nil,push,(done and at) and done-at or -1
end
S.S15=function()
	local out={}
	for _,id in {"Lion","Mist","Puppet","Ink"} do
		local c,a,b=start(id,"Leaf");place(c,a,b,Vector3.new(0,3,(id=="Puppet" and 3.5) or 1.7),Vector3.new(0,3,-((id=="Puppet" and 3.5) or 1.7)))
		confirmOne(c,a);confirmOne(c,a)
		local _,_,hit3,push3,react3=measure(c,a,b,"Attack")
		task.wait(.6);place(c,a,b,Vector3.new(0,3,1.7),Vector3.new(0,3,-1.7))
		local _,_,hitH,pushH,reactH=measure(c,a,b,"Heavy")
		table.insert(out,string.format("%s L3 hit=%s push=%.1f react=%.2fs • heavy hit=%s push=%.1f react=%.2fs",id,tostring(hit3),push3,react3,tostring(hitH),pushH,reactH))
	end
	return true,table.concat(out," | ")
end
S.S16=function()
	local out={}
	for _,id in {"Flicker","Bone","Clay"} do
		local c,a,b=start(id,"Leaf");place(c,a,b,Vector3.new(0,3,1.7),Vector3.new(0,3,-1.7))
		local log={}
		confirmOne(c,a);confirmOne(c,a)
		a.move=flat(b.root.Position-a.root.Position).Unit
		local ok,why=c:request(a,"Attack");a.move=Vector3.zero
		table.insert(log,"up="..(if ok then tostring(a.attackName) else tostring(why)))
		task.wait(.35)
		ok,why=c:request(a,"Pursuit");table.insert(log,"E="..(if ok then "ok" else tostring(why)));task.wait(.45)
		local before=b.health;local air=0
		for k=1,3 do
			ok,why=c:request(a,"Attack");table.insert(log,"A"..k.."="..(if ok then tostring(a.attackName) else tostring(why)));task.wait(.35)
			if b.health&lt;before then air+=1;before=b.health end
		end
		local t=os.clock();repeat task.wait() until (not a.airborne and not b.airborne) or os.clock()-t&gt;3
		table.insert(out,id.." "..table.concat(log," ").." air hits="..air.." landed="..tostring(not a.airborne))
	end
	return true,table.concat(out," | ")
end
S.S17=function()
	local c,a,b,s=start("Ink","Leaf")
	dev:Invoke("freezeBot",false);dev:Invoke("scripted",false);dev:Invoke("autopilot",true)
	local t=os.clock();repeat task.wait(.5) until s.phase~="Duel" or os.clock()-t&gt;60
	dev:Invoke("autopilot",false)
	local casts,distinct={},0
	for k,v in a.events or {} do if string.sub(k,1,5)=="Cast:" and v&gt;0 then distinct+=1;table.insert(casts,string.sub(k,6).."×"..v) end end
	return distinct&gt;=1,string.format("duel %.0fs phase=%s • distinct techniques=%d (%s)",os.clock()-t,tostring(s.phase),distinct,table.concat(casts,", "))
end
-- M5 ----------------------------------------------------------------------
-- S18: a mine set 8 studs in front of the player, posed then armed (watch the
-- fuse light), then the body walks on it: one detonation, the charge gone.
S.S18=function()
	local c,a,b=start("Clay","Leaf");place(c,a,b,Vector3.new(0,3,6),Vector3.new(0,3,-12));a.chakra=999
	local o=c.match.origin
	c:request(a,(slot("Clay","ClayMine")),o+Vector3.new(-6,3,-2))
	task.wait(.3)
	local h
	for _,x in c.hazards do if x.a==a and x.charge then h=x end end
	if not h then return false,"no charge" end
	local posed=c.now&lt;(h.armedAt or 0)
	task.wait(1.6)
	local armed=c.now&gt;=(h.armedAt or 0)
	local before=(a.events or {}).Detonation or 0
	c:relocate(b,h.position+Vector3.new(0,2.5,0));task.wait(.8)
	local after=(a.events or {}).Detonation or 0
	local gone=c.now&gt;=h.expires
	return posed and armed and after==before+1 and gone,string.format("posed at 0.3s=%s • armed at 1.9s=%s • detonations=%d • gone=%s",tostring(posed),tostring(armed),after-before,tostring(gone))
end
-- S20/S21: Nagato opens Absorb (watch the sphere), a kunai thrown into it is
-- swallowed (reward: chakra), melee still lands; after it closes a kunai hits.
S.S20=function()
	local c,a,b=start("Rinnegan","Copycat");place(c,a,b,Vector3.new(0,3,0),Vector3.new(0,3,-14));a.chakra=40;b.chakra=999
	c:request(a,(slot("Rinnegan","Absorb")));task.wait(.2)
	local chakra=a.chakra
	b.neutralToolAt=0;c:request(b,"Tool",a.root.Position);task.wait(.6)
	local absorbed=((a.events or {}).Absorbed or 0)&gt;0 and a.chakra&gt;chakra
	place(c,a,b,Vector3.new(0,3,1.7),Vector3.new(0,3,-1.7))
	local hp=a.health;c:request(b,"Attack");task.wait(.4)
	local melee=a.health&lt;hp
	task.wait(2.2)
	local closed=not (a.buff and c.now&lt;a.buff.untilT)
	place(c,a,b,Vector3.new(0,3,0),Vector3.new(0,3,-14))
	hp=a.health;b.neutralToolAt=0;b.chakra=999;c:request(b,"Tool",a.root.Position);task.wait(.8)
	return absorbed and melee and closed and hp-a.health&gt;0,string.format("kunai absorbed (+chakra)=%s • melee still lands=%s • window closed=%s • kunai after close dmg=%.1f",tostring(absorbed),tostring(melee),tostring(closed),hp-a.health)
end
-- M7 ----------------------------------------------------------------------
-- One continuous sequence per fighter, no refill, no replacement after the
-- start (QA-004 M7): walk in, light, light, toward+light (its route), chase
-- (E), air strikes, land, step out, tool, every technique it can pay for in
-- turn (a refused one is logged with its reason), a guard that holds a blow,
-- then a KO and the next round: nothing of the first round left over (buff,
-- stance, slow, poison, zones/charges of his, bodies, cooldowns).
local Roster=require(game:GetService("ReplicatedStorage").NinjaDuel.Roster)
local Rules=require(game:GetService("ReplicatedStorage").NinjaDuel.Rules)
local function Rules_canAct(a,c) return Rules.canAct(a,c.now) end
local function seq(id)
	local c,a,b,s=start(id,"Leaf")
	place(c,a,b,Vector3.new(0,3,7),Vector3.new(0,3,-7))
	dev:Invoke("health","bot",250)
	local log={}
	local fails={}
	local function note(k,v) table.insert(log,k.."="..tostring(v)) end
	-- Every contract is mandatory (Codex audit 5bb52fd..aeff49a, F1): a step
	-- that is refused, whiffs or times out fails the sequence.
	local function need(k,ok) if not ok then table.insert(fails,k) end end
	local MoveGraphs=require(game:GetService("ReplicatedStorage").NinjaDuel.MoveGraphs)
	local graph=MoveGraphs[id] or {}
	-- In reach (the human's own walking is the client's: placed, not walked).
	local reach=((a.def.AttackProfile and a.def.AttackProfile.Light1 and a.def.AttackProfile.Light1.contact) or 3.4)
	place(c,a,b,Vector3.new(0,3,reach/2),Vector3.new(0,3,-reach/2))
	local t=os.clock()
	local hp=b.health
	confirmOne(c,a);confirmOne(c,a)
	note("lights",string.format("%.0f",hp-b.health))
	need("lights",hp-b.health&gt;0 and (b.comboHits or 0)&gt;=2)
	a.move=flat(b.root.Position-a.root.Position).Unit;local ok,why=c:request(a,"Attack");a.move=Vector3.zero
	note("route",if ok then a.attackName else why)
	-- The toward route of its own graph (or the launcher it names, or the
	-- proxy that carries it).
	local up=graph.routes and graph.routes.up
	local proxy=graph.proxy and up and graph.proxy[up]
	local expected={[up or ""]=true,[a.def.LauncherMove or ""]=true,[(proxy and proxy.move) or ""]=true,[(proxy and proxy.solo) or ""]=true}
	need("route",ok and expected[a.attackName or "?"]==true)
	task.wait(.4)
	ok,why=c:request(a,"Pursuit");note("E",if ok then "ok" else why);task.wait(.45)
	-- A route that chases by itself (Sasuke's Lion Kick, Lee's Rising Wind)
	-- refuses E as Committed; any other refusal fails.
	local selfChase=graph.onRoute and up and graph.onRoute[up]~=nil
	need("E",ok or (selfChase and why=="Committed"))
	local airHits,before=0,b.health
	-- Each air strike gets its own time to land (Gaara's lashes are slow).
	for _=1,2 do
		c:request(a,"Attack")
		local ta=os.clock();repeat task.wait() until b.health&lt;before or os.clock()-ta&gt;.6
		if b.health&lt;before then airHits+=1;before=b.health end
	end
	note("air",airHits)
	need("air",airHits&gt;=1)
	t=os.clock();repeat task.wait() until (not a.airborne and Rules_canAct(a,c)) or os.clock()-t&gt;3
	-- Step out and throw.
	local away=flat(a.root.Position-b.root.Position);away=if away.Magnitude&gt;.1 then away.Unit else Vector3.zAxis
	c:relocate(a,b.root.Position+away*12+Vector3.new(0,.1,0));task.wait(.2)
	ok,why=c:request(a,"Tool",b.root.Position);note("tool",if ok then "ok" else why);task.wait(.8)
	-- Lee's tool is a deflecting kick: with nothing thrown at him it refuses.
	need("tool",ok or (a.def.Tool=="Deflect" and why=="Nothing to deflect"))
	-- Every technique, as the reserve allows.
	local casts={}
	for slot,spec in a.def.Techniques do
		t=os.clock();repeat task.wait() until (Rules_canAct(a,c) and a.state=="Neutral") or os.clock()-t&gt;2.5
		local gap=math.clamp((spec.Range or 10)*.45,3.4,14)
		if spec.Family=="Burst" or spec.Family=="Counter" then gap=math.min(gap,(spec.Radius or 6)-1.5) end
		local d=flat(a.root.Position-b.root.Position).Magnitude
		local dir=flat(a.root.Position-b.root.Position);dir=if dir.Magnitude&gt;.1 then dir.Unit else Vector3.zAxis
		if math.abs(d-gap)&gt;2 then c:relocate(a,b.root.Position+dir*math.max(gap,3)+Vector3.new(0,.1,0));task.wait(.15) end
		local hpT,evT=b.health,0
		for _,v in a.events or {} do evT+=v end
		local r1,r2=c:request(a,"Technique"..slot,b.root.Position)
		local effect=false
		local t1=os.clock()
		repeat
			task.wait()
			local ev=0;for _,v in a.events or {} do ev+=v end
			if b.health&lt;hpT or b.reaction or a.buff or a.counterStance or #c.hazards&gt;0 or #(c.bodies or {})&gt;0 or ev&gt;evT+1 then effect=true end
		until os.clock()-t1&gt;1.2
		table.insert(casts,spec.Id..":"..(if r1 then (if effect then "ok" else "noeffect") else tostring(r2)))
		-- A technique that needs a setup (Minato's seal) may refuse with its reason.
		need(spec.Id,(r1 and effect) or (not r1 and spec.Requires~=nil))
	end
	note("jutsu",table.concat(casts,","))
	-- Defence: the bot throws a light at a raised guard.
	t=os.clock();repeat task.wait() until (Rules_canAct(a,c) and a.state=="Neutral") or os.clock()-t&gt;3
	place(c,a,b,Vector3.new(0,3,1.8),Vector3.new(0,3,-1.8))
	-- His own bodies (Sasori's marionette) step out of this check: it is about
	-- his guard, and a marionette that keeps jabbing would keep the bot reacting.
	for _,body in Bodies.of(c,a) do Bodies.dispel(c,body,"expire") end
	-- The bot must be free to strike (its last technique may still hold it:
	-- a water prison, coils, a tentacle, a mist it cannot see through).
	t=os.clock();repeat task.wait() until (b.reaction==nil and Rules_canAct(b,c)) or os.clock()-t&gt;4
	place(c,a,b,Vector3.new(0,3,1.8),Vector3.new(0,3,-1.8))
	-- Held past the parry window, so the blow meets a plain guard (a parry is
	-- its own scenario); a parry, or a sand shield taking it, counts as held.
	c:request(a,"Guard");task.wait(.35)
	local hpA=a.health
	local ev=a.events or {}
	local guardHits,shield=ev.GuardHit or 0,ev.SandShield or 0
	local hit=c:request(b,"Attack")
	local blocked=false
	local t2=os.clock()
	repeat
		task.wait()
		local e=a.events or {}
		if (a.riposteUntil or 0)&gt;c.now or a.impactStyle=="block" or b.state=="Stunned" or (e.GuardHit or 0)&gt;guardHits or (e.SandShield or 0)&gt;shield then blocked=true end
	until blocked or os.clock()-t2&gt;.6
	note("guard",string.format("solicited=%s blocked=%s chip=%.1f",tostring(hit),tostring(blocked),hpA-a.health))
	need("guard",hit and blocked)
	c:request(a,"GuardOff")
	-- KO and the next round.
	dev:Invoke("ko","bot")
	t=os.clock();repeat task.wait(.2) until s.round and s.round&gt;=2 and s.phase=="Duel" or os.clock()-t&gt;10
	local c2=s.combat
	local mine=0
	for _,h in c2.hazards do if h.a==a then mine+=1 end end
	local bodies=#(c2.bodies or {})
	local leftover=(a.buff~=nil) or (a.counterStance~=nil) or ((a.slowUntil or 0)&gt;c2.now) or ((a.poisonedUntil or 0)&gt;c2.now) or mine&gt;0 or bodies&gt;0
	local cools=0
	for _,v in a.cooldowns or {} do if v&gt;c2.now then cools+=1 end end
	for _,v in b.cooldowns or {} do if v&gt;c2.now then cools+=1 end end
	local theirs=(b.buff~=nil) or ((b.slowUntil or 0)&gt;c2.now) or ((b.poisonedUntil or 0)&gt;c2.now) or b.reaction=="Bound"
	note("reset",string.format("round=%s phase=%s clean=%s cooldowns=%d",tostring(s.round),tostring(s.phase),tostring(not leftover and not theirs),cools))
	need("reset",(s.round or 0)&gt;=2 and s.phase=="Duel" and not leftover and not theirs and cools==0)
	if #fails&gt;0 then table.insert(log,"FAILED["..table.concat(fails,",").."]") end
	return #fails==0,table.concat(log," ")
end
for _,id in Roster do S["Q:"..id]=function() return seq(id) end end
local everyone={}
for _,id in Roster do table.insert(everyone,"Q:"..id) end
-- NEW (DEC-026 newcomers, Shared/RosterStaging): the M7 sequence for each,
-- then its own body checks in the native world: side after one and away
-- after two are its own routes, a clean block is answered with its own
-- riposte gesture, its counter stance answers a blow with a strike that
-- lands, and (Madara, Hiruzen) the Katon cone burns ahead and not at the flank.
local Staging=require(game:GetService("ReplicatedStorage").NinjaDuel.RosterStaging)
local MoveGraphs=require(game:GetService("ReplicatedStorage").NinjaDuel.MoveGraphs)
local function body(id)
	local log={}
	local pass=true
	local function check(name,ok,detail) table.insert(log,name.."="..(if ok then "ok" else "NO").."("..tostring(detail)..")");pass=pass and ok end
	local g=MoveGraphs[id]
	local c,a,b=start(id,"Leaf")
	local reach=a.def.AttackProfile.Light1.contact
	place(c,a,b,Vector3.new(0,3,reach/2),Vector3.new(0,3,-reach/2))
	confirmOne(c,a)
	a.move=a.root.CFrame.RightVector;c:request(a,"Attack");a.move=Vector3.zero
	check("side",a.attackName==g.routes.side,a.attackName)
	task.wait(1.2)
	place(c,a,b,Vector3.new(0,3,reach/2),Vector3.new(0,3,-reach/2))
	confirmOne(c,a);confirmOne(c,a)
	a.move=flat(a.root.Position-b.root.Position).Unit;c:request(a,"Attack");a.move=Vector3.zero
	check("away",a.attackName==g.routes.down,a.attackName)
	task.wait(1.4)
	-- Riposte: the bot strikes a raised guard.
	place(c,a,b,Vector3.new(0,3,1.8),Vector3.new(0,3,-1.8))
	c:request(a,"Guard");task.wait(.25)
	c:request(b,"Attack")
	local t=os.clock();repeat task.wait() until a.impactStyle=="block" or os.clock()-t&gt;.6
	c:request(a,"Attack")
	check("riposte",a.attackName==g.riposte,a.attackName)
	task.wait(1.2)
	-- Counter stance.
	local counter
	for i,spec in a.def.Techniques do if spec.Family=="Counter" then counter=i end end
	place(c,a,b,Vector3.new(0,3,1.8),Vector3.new(0,3,-1.8));dev:Invoke("refill")
	c:request(a,"Technique"..counter);task.wait(.12)
	local hp=b.health
	c:request(b,"Attack")
	t=os.clock();repeat task.wait() until a.attackName==a.def.Techniques[counter].Move or os.clock()-t&gt;.8
	local answered=a.attackName
	task.wait(.7)
	check("counter",answered==a.def.Techniques[counter].Move and b.health&lt;hp,string.format("%s dmg=%.1f",tostring(answered),hp-b.health))
	-- Katon cone.
	for i,spec in a.def.Techniques do
		if spec.Family=="Burst" and spec.Arc then
			task.wait(1);dev:Invoke("refill")
			place(c,a,b,Vector3.new(0,3,4),Vector3.new(0,3,-4))
			hp=b.health;c:request(a,"Technique"..i,b.root.Position);task.wait(.9)
			local front=hp-b.health
			task.wait(spec.Cooldown+.2);dev:Invoke("refill")
			place(c,a,b,Vector3.new(0,3,4),Vector3.new(0,3,-4))
			-- The aim is taken before the body moves to the flank (the caster's
			-- auto-facing turns him toward it within a frame).
			local ahead=a.root.Position+a.root.CFrame.LookVector*8
			c:relocate(b,a.root.Position+a.root.CFrame.RightVector*7);task.wait(.15)
			hp=b.health;c:request(a,"Technique"..i,ahead);task.wait(.9)
			check("katon",front&gt;0 and hp-b.health==0,string.format("front=%.1f flank=%.1f",front,hp-b.health))
		end
	end
	return pass,table.concat(log," ")
end
local newcomers={}
for _,id in Staging do
	S["Q:"..id]=function() return seq(id) end
	S["N:"..id]=function() return body(id) end
	table.insert(newcomers,"Q:"..id);table.insert(newcomers,"N:"..id)
end
-- Negative controls (Codex F1): the verdict must fail when a contract is
-- broken. NEG1 refuses the human's every Attack (no string, no route, no air);
-- NEG2 has the bot never strike the raised guard. Both must print FAIL.
local Combat=require(script.Parent.Combat)
local function withRefusal(filter,fn)
	local orig=Combat.request
	Combat.request=function(self,actor,action,...)
		if filter(actor,action) then return false,"Injected refusal" end
		return orig(self,actor,action,...)
	end
	local ok,pass,detail=pcall(fn)
	Combat.request=orig
	if not ok then error(pass) end
	return pass,detail
end
S.NEG1=function()
	local pass,detail=withRefusal(function(actor,action) return actor.fighterId=="Mirage" and action=="Attack" end,function() return seq("Mirage") end)
	return not pass,"control (must fail): verdict="..(if pass then "PASS" else "FAIL").." • "..tostring(detail)
end
S.NEG2=function()
	local pass,detail=withRefusal(function(actor,action) return actor.fighterId=="Leaf" and action=="Attack" end,function() return seq("Mirage") end)
	return not pass,"control (must fail): verdict="..(if pass then "PASS" else "FAIL").." • "..tostring(detail)
end
local GROUPS={M1={"S1","S2","S3","S4","S5"},M2={"S6","S8","S10"},M3={"S11","S12"},M4={"S15","S16","S17"},M5={"S18","S20"},M7=everyone,NEW=newcomers,NEG={"NEG1","NEG2"}}

return function(list)
	dev=ServerStorage:WaitForChild("NinjaDuelDev",10)
	local errors={}
	local conn=LogService.MessageOut:Connect(function(m,k) if k==Enum.MessageType.MessageError then table.insert(errors,m) end end)
	local lines={}
	for group in string.gmatch(list,"[^,%s]+") do
		for _,name in GROUPS[group] or {group} do
			local fn=S[name]
			local ok,pass,detail=pcall(fn)
			local line=if not ok then name.." ERROR "..tostring(pass) else name.." "..(if pass then "PASS" else "FAIL").." • "..tostring(detail)
			print("[GateCheck] "..line);table.insert(lines,line)
		end
	end
	conn:Disconnect()
	print("[GateCheck] errors in Output during the run: "..#errors..(if #errors&gt;0 then " • "..errors[1] else ""))
	return table.concat(lines,"\n")
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND53">
        <Properties>
          <string name="Name">DevHooks</string>
          <ProtectedString name="Source">-- Studio-only playtest hooks. A BindableFunction in ServerStorage lets a Studio
-- tool (or the command bar) start duels, drive either fighter through the real
-- combat requests, let the AI play both sides, and read a compact state dump.
-- Never active outside Studio; it only calls the same server APIs players use.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local DevHooks={}
-- Studio latency simulation for the client-to-server half (Studio's Incoming
-- Replication Lag covers server-to-client). Each player's requests reach the
-- server `latency` ms (± `jitter` ms) late and in order, like a slow reliable
-- remote. Wraps this matches instance only; returns the per-frame flush.
-- Debug/QA places only: this module never ships in the normal build.
function DevHooks.delayRequests(matches,settings,clock,random)
	local inbound=matches.request
	local queues={}
	matches.request=function(self,player,payload)
		local latency,jitter=settings()
		if latency&lt;=0 and jitter&lt;=0 and not queues[player] then return inbound(self,player,payload) end
		local queue=queues[player] or {}
		queues[player]=queue
		local due=clock()+math.max(0,latency+(random()*2-1)*jitter)/1000
		-- Reliable remotes never reorder: a request is never due before the previous one.
		if queue[#queue] and queue[#queue].due&gt;due then due=queue[#queue].due end
		table.insert(queue,{due=due,payload=payload})
	end
	return function()
		local now=clock()
		for player,queue in queues do
			while queue[1] and queue[1].due&lt;=now and player.Parent~=nil do inbound(matches,player,table.remove(queue,1).payload) end
			if #queue==0 or player.Parent==nil then queues[player]=nil end
		end
	end
end
function DevHooks.install(matches)
	-- Debug-only probes (DevGateCheck) reach the live session through this.
	-- The command bar has its own module cache, so a gate is started from it
	-- by an attribute and runs here, in the server's own context:
	--   workspace:SetAttribute("NinjaDuelGate","M1,M2")
	DevHooks.matches=matches
	if RunService:IsStudio() and workspace:GetAttribute("NinjaDuelDebug")==true then
		workspace:GetAttributeChangedSignal("NinjaDuelGate"):Connect(function()
			local list=workspace:GetAttribute("NinjaDuelGate")
			if type(list)~="string" or list=="" then return end
			workspace:SetAttribute("NinjaDuelGate","")
			local ok,gate=pcall(require,script.Parent:FindFirstChild("DevGateCheck"))
			if ok and gate then task.spawn(gate,list) end
		end)
	end
	if not RunService:IsStudio() or workspace:GetAttribute("NinjaDuelDebug")~=true then return end
	-- Set from the server command bar or the Workspace properties while testing:
	-- workspace:SetAttribute("NinjaDuelSimLatency",60) and ("NinjaDuelSimJitter",15).
	local flushRequests=DevHooks.delayRequests(matches,function()
		return tonumber(workspace:GetAttribute("NinjaDuelSimLatency")) or 0,tonumber(workspace:GetAttribute("NinjaDuelSimJitter")) or 0
	end,os.clock,math.random)
	local Inspector=require(script.Parent.CombatInspector)
	local debugRemote=Instance.new("RemoteEvent");debugRemote.Name="NinjaDuelCombatDebug";debugRemote.Parent=game:GetService("ReplicatedStorage")
	local traces=setmetatable({},{__mode="k"})
	local nextDebug=0
	local AI=require(script.Parent.AI)
	local hook=Instance.new("BindableFunction");hook.Name="NinjaDuelDev";hook.Parent=game:GetService("ServerStorage")
	local autopilot=nil
	-- Client diagnostics (Studio only): the local client forwards its warnings,
	-- errors and camera framing so a playtest can be inspected from tooling.
	local logRemote=Instance.new("RemoteEvent");logRemote.Name="NinjaDuelDevLog";logRemote.Parent=game:GetService("ReplicatedStorage")
	local clientLog={}
	local clientInfo={}
	logRemote.OnServerEvent:Connect(function(_,kind,payload)
		if kind=="log" and type(payload)=="string" then
			table.insert(clientLog,payload);while #clientLog&gt;60 do table.remove(clientLog,1) end
		elseif kind=="info" and type(payload)=="table" then clientInfo=payload end
	end)
	local function session()
		local player=Players:GetPlayers()[1]
		return player,player and matches.sessions[player]
	end
	local function summary(a,now)
		if not a then return nil end
		return {state=a.state,health=a.health,chakra=math.floor(a.chakra),position=a.root.Position,reaction=a.reaction,attackName=a.attackName,
			airborne=a.airborne,wall=a.wall~=nil,airHold=a.airHold,pending=a.pending and (a.pending.name or (a.pending.spec and a.pending.spec.Id)),
			throwing=a.throwing and a.throwing.kind,anchor=a.anchor and a.anchor.position,velocity=a.root.AssemblyLinearVelocity,
			untilIn=a.untilTime-now,groundPose=a.groundPose,flash=(a.flashUntil or 0)&gt;now,comboHits=a.comboHits,subCharges=a.subCharges,seals=#(a.anchors or {}),attackVariant=a.attackVariant,
			chainOpen=a.chainOpen and now&gt;=(a.chainAt or 0) and a.state=="Recovery",combo=a.combo,hitZone=a.hitZone,hitKind=a.hitKind,
			build=a.build and {spent=a.build.spent,bracket=a.build.bracket,nodes=table.clone(a.build.nodes)}}
	end
	-- Codex's Studio tools (33028b2 / 7091585, ported; docs/tools/DEVTOOLS.md):
	-- the F6 panel's remote, the `tool` ops (setups, profiler, report, self-test)
	-- and the optional chakra lab (`interactions`). Debug/QA places only, like
	-- this module; the ops above and below keep their exact behaviour.
	local Shared=game:GetService("ReplicatedStorage").NinjaDuel
	local Rules=require(Shared.Rules)
	local Metrics=require(Shared.DevMetrics)
	local DevTools=require(script.Parent.DevTools)
	local tools=DevTools.new(matches)
	local buckets={}
	local function allowed(player,kind,rate,burst)
		buckets[player]=buckets[player] or {}
		local bucket=buckets[player][kind] or {tokens=burst,time=os.clock()};buckets[player][kind]=bucket
		return Rules.consumeToken(bucket,os.clock(),rate,burst)
	end
	-- The client's side of a measurement report: bounded and validated.
	logRemote.OnServerEvent:Connect(function(player,kind,payload)
		if kind~="report" or not allowed(player,"report",2,4) then return end
		if type(payload)=="table" and Metrics.validPayload(payload,8192) and Metrics.estimate(payload,0,{left=8192})&lt;200000 then tools.reports[player]=payload end
	end)
	local qaRunning=false
	local function run(player,op,arg)
		if not player then return {ok=false,error="No player"} end
		if op=="report" then
			-- Ask the client for its measurements, then wait briefly for them.
			tools.reports[player]=nil;logRemote:FireClient(player,"report")
			local deadline=os.clock()+.6
			while tools.reports[player]==nil and os.clock()&lt;deadline do task.wait(.05) end
		end
		if op=="selftest" and qaRunning then return {ok=false,error="Self-test already running"} end
		local result=tools:run(player,op,arg)
		if not result.ok then return result end
		if op=="profile" then logRemote:FireClient(player,"profile",result.enabled)
		elseif op=="report" then require(script.Parent.DevReport).print(result)
		elseif op=="panel" then logRemote:FireClient(player,"panel")
		elseif op=="selftest" then
			qaRunning=true;result.started=true
			task.spawn(function()
				local ok,err=pcall(require(script.Parent.DevQA).run,matches)
				qaRunning=false
				if not ok then warn("[NinjaDuelDevQA] FAIL "..tostring(err)) end
			end)
		end
		return result
	end
	local control=Instance.new("RemoteFunction");control.Name="NinjaDuelDevControl";control.Parent=game:GetService("ReplicatedStorage")
	control.OnServerInvoke=function(player,op,arg)
		if not allowed(player,"control",4,8) then return {ok=false,error="Dev command rate limit"} end
		return run(player,op,arg)
	end
	Players.PlayerRemoving:Connect(function(player) tools:remove(player);buckets[player]=nil end)
	-- Chakra lab: loaded on its first command, and only when the chakra runtime
	-- modules (DevTools.ChakraRuntime) are part of this build.
	local chakraDev=nil
	local function interactions(op,arg)
		if not chakraDev then
			local missing=DevTools.missing(script.Parent,DevTools.ChakraRuntime)
			if missing then return {ok=false,error="Chakra lab needs the chakra runtime module "..missing.." (not in this build)"} end
			local ok,value=pcall(function() return require(script.Parent.ChakraDev).new(require(script.Parent.ChakraConfig),true) end)
			if not ok then return {ok=false,error="Chakra lab failed to load: "..tostring(value)} end
			chakraDev=value
		end
		return chakraDev:run(op,arg)
	end
	RunService.Heartbeat:Connect(function() tools.profiler:watch() end)
	hook.OnInvoke=function(op,arg1,arg2,arg3,arg4)
		local player,s=session()
		if op=="tool" then return run(player,arg1,arg2) end
		if op=="interactions" then return interactions(arg1,arg2) end
		if op=="contracts" then
			return table.clone(Inspector.ToolHooks)
		elseif op=="start" then
			if not player then return "no player" end
			if s and s.phase~="Selection" then matches:selection(player) end
			return matches:start(player,arg1 or "Flashstep",arg2 or "Mirage",arg3==true)
		elseif op=="startBuild" then
			-- Skill builds (PROG-001..003), validated exactly like a real start.
			-- arg1 = {player=id, bot=id, training=bool, bracket=id,
			--   playerNodes={...} or playerRanked=bracket id (example build),
			--   botPreset=AI tier or botNodes={...}}
			if not player then return "no player" end
			local BuildPresets=require(script.Parent.BuildPresets)
			local spec=if type(arg1)=="table" then arg1 else {}
			local playerId,botId=spec.player or "Flashstep",spec.bot or "Mirage"
			local playerNodes=spec.playerNodes or (spec.playerRanked and BuildPresets.ranked(playerId,spec.playerRanked))
			local options={bracket=spec.bracket,player=if playerNodes then {nodes=playerNodes} else nil,
				bot=if spec.botPreset then {preset=spec.botPreset} elseif spec.botNodes then {nodes=spec.botNodes} else nil}
			if s and s.phase~="Selection" then matches:selection(player) end
			local ok,reason=matches:start(player,playerId,botId,spec.training==true,options)
			return {ok=ok,reason=reason}
		elseif op=="skills" then
			-- Trees, brackets and presets, for tooling and Studio checks.
			local SkillBuilds=require(script.Parent.SkillBuilds)
			local BuildPresets=require(script.Parent.BuildPresets)
			local out={brackets=SkillBuilds.Brackets,aiTiers=BuildPresets.AITiers,fighters={}}
			for id,tree in SkillBuilds.Trees do
				local nodes={}
				for _,node in tree.Nodes do
					table.insert(nodes,{id=node.Id,kind=node.Kind,cost=node.Cost,major=node.Major==true,branch=node.Branch,
						requires=node.Requires,requiresAny=node.RequiresAny,exclusive=node.Exclusive,wired=SkillBuilds.wired(id,node.Id),shows=node.Shows})
				end
				out.fighters[id]={nodes=nodes,designMax=SkillBuilds.maxCost(id,false),playableMax=SkillBuilds.maxCost(id,true),unwired=SkillBuilds.unwired(id)}
			end
			return out
		elseif op=="selection" then
			if player then matches:selection(player) end;return true
		elseif op=="lag" then
			-- arg1 = one-way request delay (ms), arg2 = jitter (± ms); 0, 0 turns it off.
			workspace:SetAttribute("NinjaDuelSimLatency",tonumber(arg1) or 0);workspace:SetAttribute("NinjaDuelSimJitter",tonumber(arg2) or 0)
			return {latency=workspace:GetAttribute("NinjaDuelSimLatency"),jitter=workspace:GetAttribute("NinjaDuelSimJitter")}
		elseif op=="online" then
			return matches.online and matches.online:summary()
		end
		if not s or not s.combat then return "no duel" end
		local c=s.combat
		local actor=if arg1=="bot" then s.bot else s.human
		if op=="act" then
			-- arg1 = "human"/"bot", arg2 = action, arg3 = optional aim, arg4 =
			-- optional request options (e.g. {chakra=true}, the chakra chord)
			local ok,reason=c:request(actor,arg2,arg3,nil,if type(arg4)=="table" then arg4 else nil)
			return {ok=ok,reason=reason}
		elseif op=="scripted" then
			-- Ignore the local client's (idle) move packets while a tool drives the human.
			s.scripted=arg1==true;return true
		elseif op=="move" then
			actor.move=arg2 or Vector3.zero;actor.lastMove=os.clock()+(arg3 or 0)
			if arg1~="bot" then actor.sprinting=false end
			return true
		elseif op=="chakra" then
			-- (Visual QA: a pure-taijutsu fight keeps both bodies dry of chakra.)
			actor.chakra=math.max(0,arg2 or actor.chakra);return actor.chakra
		elseif op=="health" then
			actor.health=math.max(1,arg2 or actor.health);actor.hum.Health=actor.health;return actor.health
		elseif op=="sprint" then
			actor.sprinting=arg2==true;return true
		elseif op=="refill" then
			for _,a in {s.human,s.bot} do a.chakra=a.def.Chakra;a.cooldowns={};a.health=a.def.Health;a.hum.Health=a.health;a.subCharges=2;a.subCooldown=0;a.subRegenAt=math.huge end
			return true
		elseif op=="place" then
			-- arg1 / arg2 = offsets from the arena origin for human / bot
			c:relocate(s.human,s.origin+(arg1 or Vector3.new(0,3,6)));c:relocate(s.bot,s.origin+(arg2 or Vector3.new(0,3,-6)))
			s.human.root.CFrame=CFrame.lookAt(s.human.root.Position,s.bot.root.Position*Vector3.new(1,0,1)+Vector3.new(0,s.human.root.Position.Y,0))
			s.bot.root.CFrame=CFrame.lookAt(s.bot.root.Position,s.human.root.Position*Vector3.new(1,0,1)+Vector3.new(0,s.bot.root.Position.Y,0))
			return true
		elseif op=="freezeBot" then
			s.botFrozen=arg1==true
			if s.botFrozen then s.bot.move=Vector3.zero end
			return true
		elseif op=="autopilot" then
			-- The AI drives the human fighter too: full AI-vs-AI fights to watch.
			if arg1 then autopilot=AI.new(c,s.human,99) else autopilot=nil end
			s.autopilot=arg1==true
			return true
		elseif op=="clientlog" then
			local out=table.concat(clientLog," || ");if arg1 then table.clear(clientLog) end;return out
		elseif op=="probe" then
			-- Smoothness probe from the client (Studio only); resets on read.
			logRemote:FireAllClients("probe");task.wait(.3);return clientInfo.probe
		elseif op=="clientinfo" then
			logRemote:FireAllClients("info");task.wait(.3);return clientInfo
		elseif op=="ko" then
			-- arg1 = "human"/"bot": that fighter is knocked out by the other.
			local victim=if arg1=="human" then s.human else s.bot
			local by=if arg1=="human" then s.bot else s.human
			victim.invulnerableUntil=0;victim.rotationUntil=0;victim.readUntil=0;victim.guardHeld=false;victim.comboHits=0
			c:damage(by,victim,victim.health+50,false,false)
			return if s.finishing then "KO" else s.phase
		elseif op=="rematch" then
			s.lastLifecycle=-10
			matches:request(player,{action="Rematch",epoch=s.epoch})
			return s.phase
		elseif op=="damagelog" then
			-- arg1=true clears it; the log starts when first requested.
			c.damageLog=c.damageLog or {}
			local out=c.damageLog
			if arg1 then c.damageLog={} end
			return out
		elseif op=="inspect" then
			return Inspector.snapshot(s)
		elseif op=="world" then
			-- What the arena remembers (EMB-004): marks, breaks, embedded blades.
			return require(script.Parent.WorldReaction).summary(c)
		elseif op=="trace" then
			local trace=traces[s];local entries={}
			if trace then for _,entry in trace.entries do table.insert(entries,table.clone(entry)) end end
			return entries
		elseif op=="intent" then
			-- Route intent as the server reads it (stick, remembered push, line).
			local Brawler=require(script.Parent.Brawler)
			local dir,side=Brawler.classify(actor,actor.move or Vector3.zero)
			local d=actor.target and (actor.target.root.Position-actor.root.Position) or Vector3.zero
			return {move=actor.move,dir=dir,side=side,memory=actor.intentMemory and {dir=actor.intentMemory.dir,age=c.now-actor.intentMemory.at},
				combo=actor.combo,gap=Vector3.new(d.X,0,d.Z).Magnitude,state=actor.state,attack=actor.attackName,chainOpen=actor.chainOpen==true}
		elseif op=="state" then
			local projectiles={}
			for _,p in c.projectiles do table.insert(projectiles,{kind=p.kind,position=p.position}) end
			return {phase=s.phase,now=c.now,human=summary(s.human,c.now),bot=summary(s.bot,c.now),projectiles=projectiles,hazards=#c.hazards,events=s.human.events,botEvents=s.bot.events}
		end
		return "unknown op"
	end
	RunService.Heartbeat:Connect(function()
		flushRequests()
		if workspace:GetAttribute("NinjaDuelDebugEnabled")~=false then
			for viewer,session in matches.sessions do
				if session.combat then
					local snapshot=Inspector.snapshot(session);local trace=traces[session] or {};traces[session]=trace
					Inspector.record(trace,snapshot,80)
					if os.clock()&gt;=nextDebug then debugRemote:FireClient(viewer,snapshot) end
				end
			end
			if os.clock()&gt;=nextDebug then nextDebug=os.clock()+.1 end
		end
		local _,s=session()
		if autopilot and s and s.phase=="Duel" and autopilot.actor==s.human then autopilot:update(s.combat.now)
		elseif autopilot and s and s.combat and autopilot.actor~=s.human then autopilot=AI.new(s.combat,s.human,99) end
	end)
end
return DevHooks
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND54">
        <Properties>
          <string name="Name">DevProfiler</string>
          <ProtectedString name="Source">-- Studio profiler (Codex 33028b2, ported): instance-level instrumentation,
-- installed only while measurements are ON and removed at OFF and when a
-- duel is destroyed. Never changes positions, states, packet content, tick
-- rate or network ownership. Local duels and online duels are both observed.
-- Debug/QA places only (build.py DEBUG_SOURCES).
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Metrics=require(Shared.DevMetrics)
local Profiler={};Profiler.__index=Profiler
local TRANSIENT={Startup=true,Active=true,Recovery=true,TechniqueChannel=true,TechniqueActive=true,TechniqueRecovery=true,Pursuit=true,Rush=true,Dodging=true,Stunned=true}
local function weak() return setmetatable({},{__mode="k"}) end
function Profiler.new(matches)
	return setmetatable({matches=matches,metrics=Metrics.new(),attached=weak(),tracks=weak(),lastWatch=0,lastSend={},lastEvents=weak(),lastCommand=nil},Profiler)
end
-- Every live Combat: local sessions and online duels.
function Profiler:combats()
	local list={}
	for _,s in self.matches.sessions do if s.combat then table.insert(list,s.combat) end end
	local online=self.matches.online
	if online and online.duels then for d in online.duels do if d.combat then table.insert(list,d.combat) end end end
	return list
end
function Profiler:attach(c)
	if self.attached[c] then return end
	self.attached[c]=true
	local m=self.metrics
	for _,key in {"updateActor","updateProjectiles","updateHazards","runScheduled","separate"} do
		m:wrap(c,key,"server."..key)
	end
	m:wrap(c,"update","server.combat",function(_,dt)
		m:sample("server.dt.ms",dt*1000)
		m:sample("server.projectiles",#c.projectiles);m:sample("server.impacts.retained",#c.impacts)
		m:sample("server.scheduled",c.scheduled and #c.scheduled or 0)
	end)
	m:wrap(c,"pushImpact","server.pushImpact")
	m:wrap(c,"relocate","server.relocate",function(_,a)
		m:event("intentional-relocation",{actor=a.id,state=a.state,attack=a.attackName,command=self.lastCommand})
	end)
	local separate=c.separate
	-- Observe the actual separation correction around the existing implementation.
	c.separate=function(selfCombat,...)
		local a,b=selfCombat.actors[1],selfCombat.actors[2]
		local pa,pb=a and a.root.Position,b and b.root.Position
		local result=table.pack(separate(selfCombat,...))
		if m.enabled and a and b then
			local correction=(a.root.Position-pa).Magnitude+(b.root.Position-pb).Magnitude
			m:sample("server.separation.studs",correction)
			if correction&gt;.001 then m:count("server.separation.corrections") end
		end
		return table.unpack(result,1,result.n)
	end
	local observer=c.separate
	m:addRestore(c,function() if c.separate==observer then c.separate=separate end end)
end
function Profiler:release(c)
	if c and self.attached[c] then self.metrics:restoreObject(c);self.attached[c]=nil end
end
function Profiler:start()
	self.metrics:stop();self.metrics:start()
	self.attached=weak();self.tracks=weak();self.lastSend={};self.lastEvents=weak()
	local m=self.metrics
	m:wrap(self.matches,"destroy","server.destroy",nil,function(_,s) self:release(s.combat) end)
	if self.matches.online then
		m:wrap(self.matches.online,"teardown","server.online.teardown",nil,function(_,d) self:release(d.combat) end)
	end
	m:wrap(self.matches,"update","server.matches",function(_,dt)
		m:sample("server.heartbeat.ms",dt*1000)
		if dt&gt;.05 then m:event("heartbeat-spike",{ms=dt*1000}) end
	end)
	m:wrap(self.matches,"request","server.request",function(_,player,payload)
		if type(payload)=="table" and type(payload.action)=="string" and #payload.action&lt;=24 then
			m:count("input."..payload.action)
			if payload.action~="Move" then
				local s=self.matches.sessions[player];local a=s and s.human
				local epoch=payload.epoch
				m:event("input-intent",{userId=player.UserId,action=payload.action,
					epoch=if type(epoch)=="number" and epoch==epoch and math.abs(epoch)&lt;1e6 then epoch else nil,state=a and a.state,
					direction=if typeof(payload.direction)=="Vector3" then tostring(payload.direction) else nil,attack=a and a.attackName})
			end
		end
	end)
	m:wrap(self.matches,"send","server.snapshot",function(_,player,payload)
		local now=os.clock();local last=self.lastSend[player];self.lastSend[player]=now
		if last then m:sample("server.snapshot.gap.ms",(now-last)*1000) end
		m:sample("server.snapshot.estimatedBytes",Metrics.estimate(payload))
	end)
	for _,c in self:combats() do self:attach(c) end
end
-- Called every Heartbeat by DevHooks; samples at most every 0.1 s.
function Profiler:watch()
	local m=self.metrics;if not m.enabled then return end
	local now=os.clock();if now-self.lastWatch&lt;.1 then return end;self.lastWatch=now
	for _,c in self:combats() do
		self:attach(c)
		for _,a in c.actors do
			local previous=self.tracks[a]
			local position=a.root.Position
			if previous then
				local elapsed=now-previous.at;local delta=(position-previous.position).Magnitude
				m:sample("server.root.sampleDelta.studs",delta)
				if delta&gt;math.max(8,elapsed*160) then m:event("server-position-jump",{actor=a.id,state=a.state,attack=a.attackName,studs=delta,warp=a.warpSerial or 0,previousWarp=previous.warp,command=self.lastCommand}) end
				if previous.state~=a.state or previous.reaction~=a.reaction then m:event("state",{actor=a.id,from=previous.state,state=a.state,reaction=a.reaction,attack=a.attackName}) end
			end
			self.tracks[a]={at=now,position=position,state=a.state,reaction=a.reaction,warp=a.warpSerial or 0}
			if TRANSIENT[a.state] and c.now-(a.untilTime or c.now)&gt;.6 then m:count("watchdog.overdueState");m:event("overdue-state",{actor=a.id,state=a.state,overdue=c.now-a.untilTime}) end
			if (a.airHold or 0)-c.now&gt;3 then m:count("watchdog.longAirHold") end
			local events=a.events or {};local old=self.lastEvents[a] or {}
			for name,n in events do if n&gt;(old[name] or 0) then m:count("event."..name,n-(old[name] or 0)) end end
			self.lastEvents[a]=table.clone(events)
		end
	end
end
function Profiler:command(op)
	self.lastCommand=op;self.metrics:event("qa-command",{op=op})
end
function Profiler:stop() self.metrics:stop() end
function Profiler:report()
	local report=self.metrics:report();report.build=Shared.BuildFingerprint.Value
	report.units="*.ms = milliseconds; *.studs = studs; estimatedBytes = estimate, not wire bytes"
	return report
end
return Profiler
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND55">
        <Properties>
          <string name="Name">DevQA</string>
          <ProtectedString name="Source">-- Native smoke of the Studio dev tools themselves (Codex 33028b2, ported).
-- Never runs at bootstrap: started explicitly from the Debug/QA place with
-- dev:Invoke("tool","selftest"). It drives the same NinjaDuelDev "tool" ops
-- as the F6 panel: the nine setups, character / refill / awakening / repeat,
-- an AI-vs-AI capture with measurements on both sides, then checks that every
-- profiling wrapper is gone. Prints [NinjaDuelDevQA] PASS/FAIL rows and one
-- RESULT row (read by tools/dev.py report). Debug/QA places only (DEBUG_SOURCES).
local QA={}
local function stamp() return game:GetService("ReplicatedStorage").NinjaDuel.BuildFingerprint.Value end
function QA.run(matches)
	if not game:GetService("RunService"):IsStudio() then return end
	local Players=game:GetService("Players");local p=Players:GetPlayers()[1]
	local http=game:GetService("HttpService")
	if not p then warn("[NinjaDuelDevQA] FAIL no player in the playtest");return end
	local s0=matches.sessions[p]
	if s0 and s0.online then warn("[NinjaDuelDevQA] FAIL leave the online session first");return end
	local hook=game:GetService("ServerStorage"):WaitForChild("NinjaDuelDev")
	local failures={};local passed=0
	local function check(name,fn)
		local ok,err=pcall(fn)
		if ok then passed+=1;print("[NinjaDuelDevQA] PASS "..name)
		else table.insert(failures,name..": "..tostring(err));warn("[NinjaDuelDevQA] FAIL "..failures[#failures]) end
	end
	local function command(op,arg)
		local result=hook:Invoke("tool",op,arg);assert(type(result)=="table" and result.ok,type(result)=="table" and result.error or tostring(result));return result
	end
	local report=nil
	local ok,err=pcall(function()
		command("profile",{enabled=true})
		for _,name in {"neutral","launcher","air","wall","substitution","grab","whiff","projectile","ko"} do
			check(name,function()
				command("scenario",{name=name});local s=matches.sessions[p]
				assert(s and s.combat and s.botFrozen,"no frozen duel")
				if name=="launcher" then assert(s.bot.reaction=="Launched","bot not launched")
				elseif name=="wall" then assert(s.bot.reaction=="WallSplat","bot not splatted")
				elseif name=="air" then assert(s.human.airborne and s.bot.airborne,"not airborne")
				elseif name=="substitution" then assert(s.human.subCharges==1,"substitution charge not spent")
				elseif name=="ko" then assert(s.finishing,"no KO beat") end
				task.wait(.8)
			end)
		end
		check("fresh character / refill / awakening / repeat",function()
			command("character",{first="GentleFist",second="Mirage"});command("refill");command("awaken")
			assert(matches.sessions[p].human.awakened,"not awakened");command("repeat")
			assert(matches.sessions[p].human.fighterId=="GentleFist","repeat changed the fighter")
		end)
		command("reset",{first="Flashstep",second="Mirage"});command("dummy",{enabled=false});hook:Invoke("autopilot",true)
		task.wait(12);hook:Invoke("autopilot",false)
		report=command("report")
		check("both client and server measurements delivered",function()
			assert(report.client and report.client.stats["client.frame.ms"],"no client frame measurements (DevClient loaded? Studio in the foreground?)")
			assert(report.client.build==report.server.build,"client and server builds differ")
			assert(report.server.stats["server.combat.ms"],"no server combat measurements")
		end)
		command("profile",{enabled=false})
		check("all profiling wrappers removed",function()
			assert(rawget(matches,"update")==nil and rawget(matches.sessions[p].combat,"update")==nil,"a wrapper survived OFF")
		end)
		command("reset")
	end)
	if not ok then table.insert(failures,"aborted: "..tostring(err));warn("[NinjaDuelDevQA] FAIL aborted: "..tostring(err)) end
	pcall(function() hook:Invoke("autopilot",false);hook:Invoke("tool","profile",{enabled=false}) end)
	print("[NinjaDuelDevQA] RESULT "..http:JSONEncode({pass=passed,failures=failures,build=stamp()}))
end
return QA
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND56">
        <Properties>
          <string name="Name">DevReport</string>
          <ProtectedString name="Source">-- Profiler report export (Codex 33028b2, ported). Roblox truncates long Output
-- lines: one bounded JSON row per metric/event, framed by begin/end rows that
-- carry the exact build fingerprint (tools/dev.py report checks both).
-- Debug/QA places only (build.py DEBUG_SOURCES).
local Report={}
function Report.print(report)
	local http=game:GetService("HttpService")
	local id=report.server.build:sub(1,12).."-"..tostring(math.floor(os.clock()*1000));local rows=0
	local function emit(row)
		row.id=id;row.build=report.server.build
		print("[NinjaDuelPerf] "..http:JSONEncode(row))
	end
	emit({kind="begin",clientPresent=report.client~=nil})
	for _,side in {"server","client"} do
		local data=report[side]
		if data then
			emit({kind="meta",side=side,enabled=data.enabled,seconds=data.seconds});rows+=1
			for name,value in data.stats do emit({kind="metric",side=side,name=name,value=value});rows+=1 end
			for name,value in data.counters do emit({kind="counter",side=side,name=name,value=value});rows+=1 end
			for _,value in data.events do
				local event=table.clone(value)
				if event.context and event.context.error then event.context=table.clone(event.context);event.context.error=tostring(event.context.error):sub(1,300) end
				emit({kind="event",side=side,value=event});rows+=1
			end
		end
	end
	emit({kind="end",rows=rows})
end
return Report
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND57">
        <Properties>
          <string name="Name">DevRosterCheck</string>
          <ProtectedString name="Source">-- Debug/QA places only (build.py DEBUG_SOURCES): a native Studio pass for
-- roster fighters through the real server pipeline (the dev hook's `act`, the
-- same Combat:request the client remote reaches), for a Studio session driven
-- without the Windows MCP bridge (tools/studio/fighter_check.py). From the
-- command bar, Server side:
--   require(game.ServerScriptService.NinjaDuelServer.DevRosterCheck)("Mirror,Mist", 1.2)
-- For each fighter, against a frozen Rock Lee: a three-light string, the
-- toward route after two hits, the heavy, a jump and an air strike, the tool,
-- every technique aimed at the body, the awakening; then an AI-vs-AI duel to a
-- KO. Prints one line per step (what it produced) and every error the Output
-- received meanwhile. `pause` (s) leaves time to watch or capture each step.
-- It proves the server path in the real build; real keys and the look stay
-- checks of their own.
local LogService=game:GetService("LogService")
local ServerStorage=game:GetService("ServerStorage")
return function(list,pause)
	pause=pause or 1
	local dev=ServerStorage:WaitForChild("NinjaDuelDev",10)
	local Fighters=require(game:GetService("ReplicatedStorage").NinjaDuel.Fighters)
	local errors={}
	local conn=LogService.MessageOut:Connect(function(message,kind)
		if kind==Enum.MessageType.MessageError then table.insert(errors,message) end
	end)
	local report={}
	local function line(text) print("[RosterCheck] "..text);table.insert(report,text) end
	local function state() return dev:Invoke("state") end
	local function place(gap) dev:Invoke("move","human",Vector3.zero);dev:Invoke("place",Vector3.new(0,3,gap/2),Vector3.new(0,3,-gap/2));task.wait(.25) end
	local function act(action,aim,stick)
		if stick then dev:Invoke("move","human",stick) end
		local r=dev:Invoke("act","human",action,aim)
		if stick then dev:Invoke("move","human",Vector3.zero) end
		return r
	end
	local function botPos() local s=state();return s.bot and s.bot.position end
	for id in string.gmatch(list,"[^,%s]+") do
		local def=Fighters[id]
		if not def then line(id..": NO DEFINITION");continue end
		local before=#errors
		dev:Invoke("start",id,"Leaf")
		local t0=os.clock()
		repeat task.wait(.2);local r=dev:Invoke("act","human","GuardOff") until (type(r)=="table" and r.reason~="Intro") or os.clock()-t0&gt;12
		dev:Invoke("autopilot",false);dev:Invoke("freezeBot",true);dev:Invoke("scripted",true)
		local function reset(gap) dev:Invoke("refill");dev:Invoke("health","bot",400);dev:Invoke("health","human",def.Health);place(gap or 3.4) end
		-- String.
		reset(3.4)
		local hits=0
		local hp=state().bot.health
		for k=1,3 do
			act("Attack");task.wait(.42)
			local s=state()
			if s.bot.health&lt;hp then hits+=1;hp=s.bot.health end
		end
		line(string.format("%s string: %d/3 lights landed",id,hits))
		task.wait(pause)
		-- Toward route after two confirmed hits.
		reset(3.4)
		act("Attack");task.wait(.42);act("Attack");task.wait(.36)
		local toward=(botPos()-state().human.position)*Vector3.new(1,0,1)
		act("Attack",nil,toward.Unit)
		task.wait(.05)
		line(string.format("%s toward route: %s",id,tostring(state().human.attackName)))
		task.wait(pause)
		-- Heavy.
		reset(3.4);act("Heavy");task.wait(.05)
		line(string.format("%s heavy: %s",id,tostring(state().human.attackName)))
		task.wait(pause)
		-- Jump + air strike.
		reset(6);act("Jump");task.wait(.2);act("Attack");task.wait(.05)
		local s=state()
		line(string.format("%s air: airborne=%s strike=%s",id,tostring(s.human.airborne),tostring(s.human.attackName)))
		task.wait(pause)
		-- Tool.
		reset(12)
		local r=act("Tool",botPos())
		local kinds={}
		for _=1,8 do task.wait(.05);for _,p in state().projectiles do kinds[p.kind]=true end end
		local seen={}
		for k in kinds do table.insert(seen,k) end
		line(string.format("%s tool: ok=%s reason=%s objects=%s",id,tostring(r.ok),tostring(r.reason),table.concat(seen,"/")))
		task.wait(pause)
		-- Techniques.
		for slot,spec in def.Techniques do
			local gap=math.clamp((spec.Range or 10)*.45,3.4,14)
			if spec.Family=="Burst" or spec.Family=="Counter" then gap=math.min(gap,(spec.Radius or 6)-1.5) end
			reset(math.max(gap,3))
			local hp0=state().bot.health
			local tr=act("Technique"..slot,botPos())
			local most,reaction,objects,hazards=0,nil,0,0
			for _=1,30 do
				task.wait(.05)
				local st=state()
				most=math.max(most,hp0-st.bot.health)
				reaction=reaction or st.bot.reaction
				objects=math.max(objects,#st.projectiles);hazards=math.max(hazards,st.hazards)
			end
			line(string.format("%s %s (%s): ok=%s reason=%s damage=%.1f reaction=%s objects=%d zones=%d",id,spec.Id,tostring(spec.Family or "own"),
				tostring(tr.ok),tostring(tr.reason),most,tostring(reaction),objects,hazards))
			task.wait(pause)
		end
		-- Awakening under the threshold.
		reset(10)
		dev:Invoke("health","human",def.Health*.25)
		local ar=act("Awaken");task.wait(.6)
		line(string.format("%s awakening: ok=%s reason=%s",id,tostring(ar.ok),tostring(ar.reason)))
		task.wait(pause)
		-- AI vs AI to a KO.
		dev:Invoke("start",id,"Leaf")
		task.wait(4)
		dev:Invoke("freezeBot",false);dev:Invoke("scripted",false);dev:Invoke("autopilot",true)
		local t1=os.clock()
		local phase
		repeat task.wait(.5);phase=state().phase until phase~="Duel" or os.clock()-t1&gt;90
		dev:Invoke("autopilot",false)
		line(string.format("%s AI duel vs Leaf: phase=%s after %.0f s",id,tostring(phase),os.clock()-t1))
		local new=#errors-before
		line(string.format("%s errors during the pass: %d%s",id,new,if new&gt;0 then " • "..errors[before+1] else ""))
	end
	conn:Disconnect()
	return table.concat(report,"\n")
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND58">
        <Properties>
          <string name="Name">DevScenarios</string>
          <ProtectedString name="Source">-- Explicit QA setups (Codex 33028b2, ported to the current Matches API). Each
-- one rebuilds the duel through Matches:start (fresh actors and epoch, no
-- intro, the bot held as a dummy), then puts it in a state through the live
-- engine only: Brawler reactions, Brawler.splat on a real NinjaWall panel,
-- Combat:request and Combat:damage. A setup reproduces a state; it does not
-- prove that a human executed the route. Online sessions are never touched.
-- Debug/QA places only (build.py DEBUG_SOURCES).
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Config=require(Shared.Config)
local Fighters=require(Shared.Fighters)
local Brawler=require(script.Parent.Brawler)
local World=require(script.Parent.World)
local Scenarios={}
Scenarios.names={"neutral","launcher","air","wall","substitution","grab","whiff","projectile","ko"}
-- The selectable CORE4 roster. Other ids (Sand) stay reachable from the command bar.
Scenarios.core={"Flashstep","Mirage","GentleFist","Lion"}
function Scenarios.known(name) return table.find(Scenarios.names,name)~=nil end
-- A fresh duel at close range. `first`/`second` default to the current pair.
function Scenarios.reset(matches,player,first,second,dummy)
	local old=matches.sessions[player]
	if old and old.online then return false,"Online session: leave it first (back to Selection)" end
	first=first or (old and old.playerId) or "Flashstep"
	second=second or (old and old.botId) or "Mirage"
	if type(first)~="string" or type(second)~="string" or not Fighters[first] or not Fighters[second] then return false,"Unknown fighter" end
	-- The same pairing keeps its validated skill builds (startBuild); a new
	-- pairing starts on the canonical kits.
	local options=if old and old.playerId==first and old.botId==second then old.options else nil
	local ok,reason=matches:start(player,first,second,false,options)
	if not ok then return false,reason or "Start refused" end
	local s=matches.sessions[player]
	s.introUntil=nil;s.botFrozen=dummy~=false
	if s.botFrozen then s.bot.move=Vector3.zero end
	local c=s.combat
	c:relocate(s.human,s.origin+Vector3.new(0,3,3));c:relocate(s.bot,s.origin+Vector3.new(0,3,-3))
	s.human.root.CFrame=CFrame.lookAt(s.human.root.Position,s.bot.root.Position)
	s.bot.root.CFrame=CFrame.lookAt(s.bot.root.Position,s.human.root.Position)
	matches:snapshot(player,s)
	return true,s
end
-- Chakra, cooldowns and substitution charges back to full (health untouched).
function Scenarios.refill(s,actor)
	for _,a in (if actor then {actor} else {s.human,s.bot}) do
		a.chakra=a.def.Chakra or Config.Chakra;a.cooldowns={}
		a.subCharges=Config.Substitution.Charges;a.subCooldown=0;a.subRegenAt=math.huge
	end
end
function Scenarios.setup(matches,player,name,first,second)
	if not Scenarios.known(name) then return false,"Unknown scenario" end
	local ok,s=Scenarios.reset(matches,player,first,second,true)
	if not ok then return false,s end
	local c,a,b=s.combat,s.human,s.bot
	local accepted,reason=true,nil
	if name=="launcher" then
		Brawler.react(c,b,"Launched",Vector3.new(0,48,0),1.2,a);a.pursuitUntil=c.now+Config.PursuitWindow
	elseif name=="air" then
		for _,x in {a,b} do c:relocate(x,x.root.Position+Vector3.new(0,13,0));x.airborne=true end
		a.airHold=c.now+2;Brawler.react(c,b,"Juggled",Vector3.zero,2,a)
	elseif name=="wall" then
		-- A real NinjaWall panel probed at World.WALL_RADIUS on +X, never a stored coordinate.
		local hit=workspace:Raycast(s.origin+Vector3.new(World.WALL_RADIUS-12,12,0),Vector3.xAxis*24,c:rayParams(true))
		if not hit or not hit.Instance:GetAttribute("NinjaWall") then return false,"No wall surface on probe ray" end
		c:relocate(b,hit.Position+hit.Normal*2.1)
		local front=b.root.Position+hit.Normal*5
		c:relocate(a,Vector3.new(front.X,s.origin.Y+3,front.Z))
		a.root.CFrame=CFrame.lookAt(a.root.Position,Vector3.new(b.root.Position.X,a.root.Position.Y,b.root.Position.Z))
		-- The engine's own splat: pin window, wall impact, splat damage and the attacker's chase window.
		Brawler.react(c,b,"Knockback",Vector3.zero,.42,a)
		Brawler.splat(c,b,hit)
	elseif name=="substitution" then
		a.lastHurt=c.now;Brawler.react(c,a,"HitStun",Vector3.zero,.45,b)
		accepted,reason=c:request(a,"Substitute")
	elseif name=="grab" then
		c:relocate(b,a.root.Position+a.root.CFrame.LookVector*3.4)
		accepted,reason=c:request(a,"Grab")
	elseif name=="whiff" then
		c:relocate(b,s.origin+Vector3.new(0,3,-22))
		accepted,reason=c:request(a,"Heavy")
	elseif name=="projectile" then
		c:relocate(b,s.origin+Vector3.new(0,3,-24))
		accepted,reason=c:request(a,"Tool",b.root.Position)
	elseif name=="ko" then
		b.rotationUntil=0;b.shieldCharges=0;b.invulnerableUntil=0;b.readUntil=0;b.guardHeld=false
		c:damage(a,b,b.health+200,false,false)
		accepted,reason=b.health&lt;=0,"damage refused"
	end
	if not accepted then return false,name..": "..tostring(reason) end
	matches:snapshot(player,s)
	return true,{scenario=name,epoch=s.epoch,first=s.playerId,second=s.botId}
end
return Scenarios
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND59">
        <Properties>
          <string name="Name">DevTools</string>
          <ProtectedString name="Source">-- Studio dev-tool dispatcher (Codex 33028b2, ported): shared by the F6 panel
-- (NinjaDuelDevControl remote) and the command bar (NinjaDuelDev "tool" op).
-- Every op acts on the calling player's own local session, through the
-- allowlist in DevCommands; online sessions are refused, never rebuilt.
-- Debug/QA places only (build.py DEBUG_SOURCES).
local Commands=require(script.Parent.DevCommands)
local Scenarios=require(script.Parent.DevScenarios)
local Profiler=require(script.Parent.DevProfiler)
local Tools={};Tools.__index=Tools
-- The chakra lab (ChakraDev/ChakraLab) runs on the chakra runtime modules,
-- which arrive with the chakra-interactions work, not with these tools.
Tools.ChakraRuntime={"ChakraConfig","ChakraRules","ChakraInteractions","ChakraVectors"}
-- First module of `names` absent from `parent` (nil when all are present).
function Tools.missing(parent,names)
	for _,name in names do
		if not parent:FindFirstChild(name) then return name end
	end
	return nil
end
function Tools.new(matches)
	return setmetatable({matches=matches,profiler=Profiler.new(matches),last={},reports={},dummy={}},Tools)
end
function Tools:run(player,op,arg)
	local valid,clean=Commands.validate(op,arg)
	if not valid then return {ok=false,error="Invalid command"} end
	local matches=self.matches;local s=matches.sessions[player];arg=clean
	self.profiler:command(op)
	if op=="list" then
		return {ok=true,scenarios=table.clone(Scenarios.names),fighters=table.clone(Scenarios.core),last=self.last[player],
			profiling=self.profiler.metrics.enabled,dummy=s~=nil and s.botFrozen==true}
	elseif op=="profile" then
		if arg.enabled then self.profiler:start() else self.profiler:stop() end
		return {ok=true,enabled=self.profiler.metrics.enabled}
	elseif op=="report" then
		return {ok=true,server=self.profiler:report(),client=self.reports[player]}
	elseif op=="panel" or op=="selftest" then
		-- Carried out by DevHooks (client toggle / DevQA task).
		return {ok=true}
	end
	if s and s.online then return {ok=false,error="Online session: leave it first (back to Selection)"} end
	if op=="reset" or op=="character" then
		local ok,value=Scenarios.reset(matches,player,arg.first,arg.second,self.dummy[player]~=false)
		return {ok=ok,epoch=if ok then value.epoch else nil,error=if ok then nil else value}
	elseif op=="scenario" or op=="repeat" then
		local name=if op=="repeat" then self.last[player] or "neutral" else arg.name
		local ok,value=Scenarios.setup(matches,player,name,arg.first,arg.second)
		if ok then self.last[player]=name;self.dummy[player]=true end
		return {ok=ok,scenario=if ok then value else nil,error=if ok then nil else value}
	end
	if not s or not s.combat or s.phase~="Duel" then return {ok=false,error="No active duel"} end
	local c=s.combat;local a=if arg.actor=="bot" then s.bot else s.human
	if op=="dummy" then
		self.dummy[player]=arg.enabled==true;s.botFrozen=self.dummy[player]
		if s.botFrozen then s.bot.move=Vector3.zero end
	elseif op=="refill" then
		Scenarios.refill(s)
	elseif op=="awaken" then
		-- QA override of once-per-match: health under the threshold, then the real Awaken request.
		Scenarios.refill(s,a);a.awakened=false;a.health=a.def.Health*.3;a.hum.Health=a.health
		local ok,reason=c:request(a,"Awaken")
		matches:snapshot(player,s)
		return {ok=ok,error=if ok then nil else reason}
	elseif op=="ko" then
		a.invulnerableUntil=0;a.rotationUntil=0;a.readUntil=0;a.guardHeld=false;a.shieldCharges=0;a.comboHits=0
		c:damage(a.target,a,a.health+200,false,false)
	else
		return {ok=false,error="Unknown command"}
	end
	matches:snapshot(player,s)
	return {ok=true,epoch=s.epoch,dummy=s.botFrozen==true}
end
function Tools:remove(player)
	self.last[player]=nil;self.reports[player]=nil;self.dummy[player]=nil;self.profiler.lastSend[player]=nil
end
return Tools
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND60">
        <Properties>
          <string name="Name">DonorAnimations</string>
          <ProtectedString name="Source">-- R6 -&gt; R15 compatibility only; transforms/times remain the donor choreography.
local Donor={}
local basis={
 Torso=CFrame.Angles(-math.pi/2,0,math.pi),Head=CFrame.Angles(-math.pi/2,0,math.pi),
 ['Right Arm']=CFrame.Angles(0,math.pi/2,0),['Left Arm']=CFrame.Angles(0,-math.pi/2,0),
 ['Right Leg']=CFrame.Angles(0,math.pi/2,0),['Left Leg']=CFrame.Angles(0,-math.pi/2,0),
}
local mapped={Head='Head',['Right Arm']='RightUpperArm',['Left Arm']='LeftUpperArm',
 ['Right Leg']='RightUpperLeg',['Left Leg']='LeftUpperLeg'}
local function pose(parent,name,cf,weight)
 local p=Instance.new('Pose');p.Name=name;p.CFrame=cf;p.Weight=weight or 1;p.Parent=parent;return p
end
function Donor.retarget(sequence)
 local result=Instance.new('KeyframeSequence');result.Name=sequence.Name..'_R15';result.Loop=sequence.Loop;result.Priority=sequence.Priority
 for _,frame in sequence:GetKeyframes() do
  local key=Instance.new('Keyframe');key.Name=frame.Name;key.Time=frame.Time;key.Parent=result
  local byName={};for _,p in frame:GetDescendants() do if p:IsA('Pose') then byName[p.Name]=p end end
  local source=byName.Torso
  local root=pose(key,'HumanoidRootPart',CFrame.identity,0)
  local torsoCF=if source then basis.Torso*source.CFrame*basis.Torso:Inverse() else CFrame.identity
  local lower=pose(root,'LowerTorso',torsoCF)
  local upper=pose(lower,'UpperTorso',CFrame.identity)
  for old,name in mapped do
   local src=byName[old]
   if src then
    local b=basis[old]
    local cf=b*src.CFrame*b:Inverse()
    local p=pose(if old:find('Leg') then lower else upper,name,cf,src.Weight)
    p.EasingStyle=src.EasingStyle;p.EasingDirection=src.EasingDirection
   end
  end
  for _,child in frame:GetChildren() do if child:IsA('KeyframeMarker') then child:Clone().Parent=key end end
 end
 return result
end
return Donor
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND61">
        <Properties>
          <string name="Name">Elements</string>
          <ProtectedString name="Source">-- Element families define different gameplay primitives. Fire and Wind are
-- equipped in this slice; the other families reserve explicit behavior seams.
local Chakra=require(script.Parent.ChakraCombat)
local Elements={
	Families={
		Fire={primitive="TravellingBlast",counter="Sidestep the fireball, then punish the recovery"},
		Lightning={primitive="PrecisionBurst",counter="Bait the committed line"},
		Wind={primitive="Displacement",counter="Sidestep the cutting lane"},
		Water={primitive="MovingControlVolume",counter="Cross behind the wave"},
		Earth={primitive="SolidGroundCover",counter="Reposition around cover"},
	},
}
-- Katon: Great Fireball. Released from the mouth after the hand signs, it is a
-- real travelling volume that grows as it flies, bursts on contact and leaves
-- burning ground behind.
function Elements.fire(c,a,pending,now)
	local spec=pending.spec
	local aim=pending.aim or (a.target and a.target.root.Position) or a.root.Position+a.root.CFrame.LookVector*spec.Range
	local origin=c.launchPoint(a,"Fireball")
	-- Fire travels flat and slightly down onto the opponent's body, never into
	-- the sky when the aim point is a little high.
	local delta=aim-origin
	local flat=Vector3.new(delta.X,0,delta.Z)
	if flat.Magnitude&lt;1 then flat=a.root.CFrame.LookVector*Vector3.new(1,0,1) end
	-- Out of the air the breath goes down onto him (or the ground under him).
	local steep=if a.airborne then 1.6 else .35
	local drop=math.clamp(delta.Y,-flat.Magnitude*steep,flat.Magnitude*.08)
	local target=origin+flat.Unit*spec.Range+Vector3.new(0,drop*spec.Range/math.max(flat.Magnitude,1),0)
	-- (Reference quality) Held, the breath is bigger, slower and harder: it
	-- throws a body down instead of knocking it back (spec.Hold).
	local charge=math.clamp(pending.charge or 0,0,1)
	local hold=spec.Hold
	local radius=2.4*(1+(if hold then (hold.Radius or 1)-1 else 0)*charge)
	local damage=spec.Damage*(1+(if hold then (hold.Damage or 1)-1 else 0)*charge)
	local speed=(spec.Speed or 54)*(1-(if hold then 1-(hold.Speed or 1) else 0)*charge)
	local ball=c:projectile(a,target,speed,spec.Range,damage,"fireball",nil,{origin=origin,radius=radius,growth=2.2*(1+charge*.5),heavy=true})
	ball.charge=charge
	if spec.Lane then Elements.burnLane(c,a,ball) end
	-- The body takes the breath: a step back on the ground, and in the air a
	-- recoil that holds him up for a moment and pushes him back.
	local back=-flat.Unit
	if a.airborne then
		a.root.AssemblyLinearVelocity=back*(10+8*charge)+Vector3.new(0,14+6*charge,0)
	elseif charge&gt;.3 then
		a.root.AssemblyLinearVelocity=back*(10*charge)+Vector3.new(0,a.root.AssemblyLinearVelocity.Y,0)
	end
	c:cue(a,if charge&gt;=.99 then "KATON • GREAT FIREBALL • FULL" elseif charge&gt;0 then "KATON • GREAT FIREBALL • HELD" else "KATON • GREAT FIREBALL")
end
-- Itachi's Katon is control, not only damage (spec.Lane): where the fireball
-- passes the opponent, the ground under its path catches, patch after patch at
-- an even spacing. The lane cuts the field beside the body that dodged it:
-- walk round it, jump it, or take the burn (Combat:chip, it never stuns).
local LANE={Reach=14,Spacing=5,Radius=2.4,Life=2.6,Damage=.3,Drop=24}
Elements.LANE=LANE
function Elements.burnLane(c,a,ball)
	c:schedule(c.now+.03,function()
		if c.match.phase~="Duel" or ball.dead or not table.find(c.projectiles,ball) then return end
		local b=a.target
		if b and b.health&gt;0 then
			local near=Vector3.new(ball.position.X-b.root.Position.X,0,ball.position.Z-b.root.Position.Z).Magnitude&lt;=LANE.Reach
			if near and not ball.laneNext then ball.laneNext=ball.position end
			-- Every patch point the flight has passed since the last poll.
			while near and ball.laneNext and (ball.position-ball.laneNext):Dot(ball.direction)&gt;=0 do
				local floor=workspace:Raycast(ball.laneNext,Vector3.new(0,-LANE.Drop,0),c:rayParams(true))
				if floor then
					local patch=c:addHazard(a,floor.Position+Vector3.new(0,.5,0),LANE.Radius,LANE.Life,ball.damage*LANE.Damage,"Fire")
					patch.lane=ball.id
				end
				ball.laneNext+=ball.direction*LANE.Spacing
			end
			-- Past the opponent: the lane is laid.
			if not near and ball.laneNext then return end
		end
		Elements.burnLane(c,a,ball)
	end)
end
-- Katon: Phoenix Flower. Five small flames released one after another, each
-- re-aimed at the opponent with a lateral offset: a fan that follows the
-- target and pressures a sidestep, with small burning patches where they land.
function Elements.phoenix(c,a,pending,now)
	local spec=pending.spec
	local offsets={0,-5,5,-2.5,2.5}
	for k,offset in offsets do
		c:schedule(now+(k-1)*.06,function()
			if a.health&lt;=0 or a.reaction or a.state=="Stunned" then return end
			local victim=a.target
			local goal=if victim and victim.health&gt;0 then victim.root.Position+victim.root.AssemblyLinearVelocity*Vector3.new(1,0,1)*.15 else a.root.Position+a.root.CFrame.LookVector*spec.Range
			local origin=c.launchPoint(a,"Fireball")
			local flat=Vector3.new(goal.X-origin.X,0,goal.Z-origin.Z)
			if flat.Magnitude&lt;1 then flat=a.root.CFrame.LookVector*Vector3.new(1,0,1) end
			local side=Vector3.new(-flat.Unit.Z,0,flat.Unit.X)
			local aim=goal+side*offset+Vector3.new(0,-.6,0)
			c:projectile(a,aim,spec.Speed or 68,spec.Range,spec.Damage,"phoenix",nil,{origin=origin,radius=.9,growth=.35})
		end)
	end
	-- Sasuke hides two shuriken inside the flames.
	if spec.HiddenBlades then
		for k=1,2 do
			c:schedule(now+.14+k*.07,function()
				if a.health&lt;=0 or a.reaction or a.state=="Stunned" or not a.target or a.target.health&lt;=0 then return end
				local side=a.root.CFrame.RightVector*(if k==1 then -1.5 else 1.5)
				local blade
				-- Skill build (Wired Flames): the hidden blades trail wire and bind.
				if spec.WiredBlades then
					blade=c:projectile(a,a.target.root.Position+side,90,spec.Range,2,"wire",nil,{riders={bind=spec.WiredBlades}})
				else
					-- Blades hidden in the flames come out burning: they ignite what they
					-- touch and leave a burning point where they land (ChakraCombat).
					blade=c:projectile(a,a.target.root.Position+side,90,spec.Range,2,"shuriken",nil,{chakra=Chakra.innate(c,a,"Shuriken","Fire")})
				end
				-- The client shows the steel leaving the flames (IdentityFX).
				blade.hidden=true
			end)
		end
	end
	c:cue(a,"KATON • PHOENIX FLOWER")
end
function Elements.wind(c,a,pending)
	local aim=pending.aim
	if (aim-a.root.Position).Magnitude&lt;1 then aim=a.root.Position+a.root.CFrame.LookVector*pending.spec.Range end
	-- Skill build (Gale Chase): a gust that connects opens the chase window.
	c:projectile(a,aim,88,pending.spec.Range,pending.spec.Damage,"wind",nil,{radius=1.4,riders=if pending.spec.Chase then {chase=pending.spec.Chase} else nil})
	c:cue(a,"WIND • CUTTING LANE")
end
return Elements
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND62">
        <Properties>
          <string name="Name">Families</string>
          <ProtectedString name="Source">-- Reusable technique families and fighter traits (ROSTER_20_BREADTH_PASS).
--
-- A technique that names a `Family` and has no bespoke Techniques.&lt;Id&gt; runs
-- here, driven by its own spec fields, so a new fighter is data first. The
-- core reads traits (buffs, on-hit riders, counter stances, zone effects)
-- through the few hooks below and never by fighter name. Bespoke techniques
-- (Flying Thunder God, Rotation, the Chidori...) stay in Techniques.
--
-- Families (spec.Family):
--   Projectile  Kind (Looks kind), Speed, Range, Damage, Count, Spread (rad,
--               whole fan), Radius, Growth, Launch (Combat launch point),
--               Ground (runs along the floor from the feet), Volley (s between
--               shots), plus the contact fields.
--   Strike      Move (Attacks name): a strike started by the jutsu pipeline
--               (like the Chidori thrust), Damage overrides the move's.
--   Burst       Radius, Arc (cosine, -1 = all round), Clear (enemy objects
--               in reach are destroyed), Style (contact style), at his feet;
--               Leave {Radius, Time, Damage, Kind, Look}: a zone left there.
--   Zone        At ("Self" | "Aim" | "Target"), Radius, Time, Damage (tick
--               base), ZoneKind, Slow/Drain/Seal applied per tick.
--   Buff        Time, Speed, Damage, Armor (share of damage removed), Heavy
--               (light strikes do not stagger), Regen, Heal (instant).
--   Teleport    To ("Behind" | "Side" | "Back" | "Aim"), Distance, Move
--               (strike on arrival), Invuln (s).
--   Counter     Time (window), Damage, Swap (reappears behind), contact fields:
--               a melee blow that meets the stance is answered.
-- Contact fields (Projectile, Strike, Burst, Counter): Knock, Lift, React,
-- Stun, Bind (s, held), Crush (damage when the bind ends), Drain (chakra
-- taken), Steal (share of the drain he gains), Slow {Scale, Time}, Seal (s:
-- techniques sealed), Pull (impulse toward him, never past PullTo studs in
-- front of him), Zone (left where it lands), Poison {Damage, Time, Every}
-- (damage over time, no stagger).
-- Teleport also reads Heal (instant, on arrival) and InZone (damage scale of
-- its arrival strike when the target stands in one of his own zones).
-- A Buff may carry OnHit (the same rider as def.OnHit while it lasts) and
-- Absorb {Radius, Chakra, Heal}: while it lasts, enemy objects that come
-- within Radius are drunk (Nagato's Preta seal).
-- Charges (Deidara): a Projectile or a Zone with Charge {Trigger, Radius,
-- Damage, Knock, Lift, Arm, Life, Look} leaves a planted charge (a missed
-- spider where it stops, a buried mine) that blasts when the body steps on
-- it once armed, or when its owner detonates (Burst Detonate=true).
-- Awakening rules read here: ChainCharges (a blast sets off his other
-- charges near it, charges arm at once), ReflectClear (a Clear burst sends
-- the blades back at their thrower), ChainTeleport=N (a relocation strike
-- that lands refreshes its own cooldown, N times in a row), ZoneFree (a Ring
-- relocation inside his own zone costs nothing and comes back at once).
-- Teleport Ring {Look, Volley}: inside his own zone of that look, the
-- relocation lands on its ring behind the body and throws a Volley
-- {Count, Kind, Damage, Speed, Slow} from there instead of the Move strike.
-- Summon (family) Body, Mode, Life, Lunge {Damage, Knock, Lift, Poison}: a
-- persistent body (Server/Bodies); cast again while it is out, it lunges.
local Families={}
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Looks=require(Shared.Looks)

local function brawler() return require(script.Parent.Brawler) end
local function flat(v) return Vector3.new(v.X,0,v.Z) end
local function unitOr(v,fallback)
	if v.Magnitude&gt;.05 then return v.Unit end
	return fallback
end
local function aimOf(a,pending)
	return pending.aim or (a.target and a.target.root.Position) or a.root.Position+a.root.CFrame.LookVector*20
end
Families.flat=flat

-- ----------------------------------------------------------- traits
-- Composition of a body's temporary traits (one policy for the twenty).
-- Two layers can be active together: a technique's buff (Buff family) and
-- the awakening's (Awakening.Buff). They are MERGED, never one hiding the
-- other, with bounded rules:
--   Heavy   either layer grants it;
--   Armor   the larger of the two (never added: 0.3 + 0.12 is not 0.42);
--   Damage, Speed   multiplied, then the whole outgoing scale including the
--           awakening's own Damage/Speed (applied by Combat) is capped at
--           Families.CAP (a buff inside an awakening still helps, it never
--           runs away);
--   Regen   the larger.
-- def.Armor (Kimimaro's bones) is a separate, permanent trait.
Families.CAP={Damage=1.4,Speed=1.35}
local TRAITS={"Heavy","Armor","Damage","Speed","Regen"}
local function layers(a,now)
	local b=a.buff
	local own=if b and now&lt;b.untilT then b.spec else nil
	local awake=(a.awakenUntil or 0)&gt;now and a.def.Awakening and a.def.Awakening.Buff or nil
	return own,awake
end
function Families.buff(a,now)
	local own,awake=layers(a,now)
	if not own then return awake end
	if not awake then return own end
	local merged={}
	for _,key in TRAITS do
		local x,y=own[key],awake[key]
		if key=="Heavy" then merged.Heavy=(x==true or y==true) or nil
		elseif key=="Damage" or key=="Speed" then merged[key]=if x or y then (x or 1)*(y or 1) else nil
		elseif x or y then merged[key]=math.max(x or 0,y or 0) end
	end
	return merged
end
-- The awakening's own multiplier (Combat applies it); the buff's part is
-- trimmed so that both together stay under the cap.
local function capped(a,now,key,value)
	local aw=(a.awakenUntil or 0)&gt;now and a.def.Awakening and a.def.Awakening[key] or 1
	return math.min(value,Families.CAP[key]/aw)
end
-- Movement scale: buffs and slows (Combat sets speedScale every frame).
function Families.speedScale(a,now)
	local s=1
	local b=Families.buff(a,now)
	if b and b.Speed then s*=capped(a,now,"Speed",b.Speed) end
	if (a.slowUntil or 0)&gt;now then s*=a.slowScale or 1 end
	return s
end
function Families.regenScale(a,now)
	local b=Families.buff(a,now)
	return (b and b.Regen) or 1
end
-- Outgoing and incoming damage: the attacker's buff, the victim's armour.
function Families.damageScale(attacker,victim,now)
	local s=1
	local b=Families.buff(attacker,now)
	if b and b.Damage then s*=capped(attacker,now,"Damage",b.Damage) end
	local armor=Families.buff(victim,now)
	if armor and armor.Armor then s*=1-armor.Armor end
	if victim.def.Armor then s*=1-victim.def.Armor end
	return s
end
-- Super armour: a light blow lands (damage) but does not stagger or interrupt.
function Families.withstands(a,now,heavy,amount)
	if heavy or amount&gt;=12 then return false end
	local b=Families.buff(a,now)
	return b~=nil and b.Heavy==true
end
-- On-hit riders (def.OnHit, a running buff's OnHit, the awakening's OnHit):
-- merged FIELD BY FIELD, so a layer adds what it has without erasing the
-- others' (Kabuto's scalpel drain stays when his awakening adds its slow).
-- Where two layers carry the same rider the stronger wins: Drain/Steal/Heal
-- the larger, Slow the lower Scale (and the longer Time), Poison the larger
-- Damage per tick.
local function stronger(key,x,y)
	if x==nil then return y end
	if y==nil then return x end
	if key=="Slow" then
		return {Scale=math.min(x.Scale or .8,y.Scale or .8),Time=math.max(x.Time or 1.5,y.Time or 1.5)}
	elseif key=="Poison" then
		return if (y.Damage or 1)&gt;(x.Damage or 1) then y else x
	end
	return math.max(x,y)
end
function Families.onHit(a,now)
	local own=a.buff and now&lt;a.buff.untilT and a.buff.spec.OnHit or nil
	local awake=(a.awakenUntil or 0)&gt;now and a.def.Awakening and a.def.Awakening.OnHit or nil
	local sources={a.def.OnHit,own,awake}
	local merged=nil
	for _,src in sources do
		if src then
			merged=merged or {}
			for key,value in src do merged[key]=stronger(key,merged[key],value) end
		end
	end
	return merged
end

-- ----------------------------------------------------------- contact
-- What a family contact does to the body it reached, once the defence has
-- resolved (damaged: the blow landed; guarded: it met a guard).
function Families.contact(c,a,b,spec,direction,damaged,guarded,position)
	if not b or b.health&lt;=0 or c.match.phase~="Duel" then return end
	local now=c.now
	local Brawler=brawler()
	direction=unitOr(flat(direction or (b.root.Position-a.root.Position)),flat(a.root.CFrame.LookVector).Unit)
	-- Chakra drained, even through a guard (half): insects, Samehada, a palm.
	if spec.Drain and (damaged or guarded) then
		local taken=math.min(b.chakra,spec.Drain*(if guarded then .5 else 1))
		b.chakra-=taken
		if spec.Steal then a.chakra=math.min(a.def.Chakra or 100,a.chakra+taken*spec.Steal) end
		if taken&gt;0 then c:pushImpact(b.root.Position,"drain",false,{owner=a.id,victim=b.id,amount=taken}) end
	end
	if not damaged or guarded then return end
	if spec.Slow then
		b.slowUntil=now+(spec.Slow.Time or 2);b.slowScale=spec.Slow.Scale or .7
		c:cue(b,"SLOWED",.6)
	end
	if spec.Seal then
		b.sealedUntil=math.max(b.sealedUntil or 0,now+spec.Seal)
		c:cue(b,"JUTSU SEALED",.8)
	end
	if spec.Poison then Families.poison(c,a,b,spec.Poison) end
	if spec.Zone then
		local z=spec.Zone
		local h=c:addHazard(a,position or b.root.Position,z.Radius or 6,z.Time or 3,z.Damage or 4,z.Kind or "Fire")
		h.effects=z
		h.look=z.Look
	end
	if spec.Bind then
		Families.bind(c,a,b,spec)
		return
	end
	if spec.Pull then
		-- Toward him, never past PullTo studs in front of him (a close body
		-- would otherwise be thrown behind him).
		local gap=flat(b.root.Position-a.root.Position).Magnitude
		local pull=math.min(spec.Pull,math.max(0,gap-(spec.PullTo or 3.5))*4.2)
		Brawler.react(c,b,"Knockback",-direction*pull+Vector3.yAxis*(spec.Lift or 8),spec.Stun or .45,a)
	elseif spec.Knock or spec.Lift or spec.React then
		local kind=spec.React or (if (spec.Lift or 0)&gt;=40 then "Launched" else "Knockback")
		Brawler.react(c,b,kind,direction*(spec.Knock or 0)+Vector3.yAxis*(spec.Lift or 0),spec.Stun or .5,a)
		if kind=="Knockback" and (spec.Knock or 0)&gt;=30 then
			a.pursuitUntil=math.max(a.pursuitUntil or 0,now+.8)
			c:cue(a,"KNOCK AWAY • E TO CHASE",.7)
		end
	end
end
-- Poison: damage over time (needles, a puppet's blades, a snake's fangs).
-- A fresh dose replaces the running one; it never staggers.
function Families.poison(c,a,b,spec)
	local every=spec.Every or .5
	local ticks=math.max(1,math.floor((spec.Time or 3)/every))
	b.poisonSerial=(b.poisonSerial or 0)+1
	local serial=b.poisonSerial
	b.poisonedUntil=c.now+ticks*every
	c:cue(b,"POISONED",.7)
	for i=1,ticks do
		c:schedule(c.now+i*every,function()
			if b.poisonSerial~=serial or b.health&lt;=0 or a.health&lt;=0 or c.match.phase~="Duel" then return end
			c.damageTag="poison"
			c:chip(a,b,(spec.Damage or 1))
			c.damageTag=nil
		end)
	end
end
-- Held where it stands (shadow, water prison, snakes, hounds): substitution
-- escapes, as for the Sand Coffin. Crush lands when the hold ends.
function Families.bind(c,a,b,spec)
	if b.health&lt;=0 or (b.invulnerableUntil or 0)&gt;c.now then return end
	local Brawler=brawler()
	local awake=(a.awakenUntil or 0)&gt;c.now and a.def.Awakening and a.def.Awakening.BindScale or 1
	local duration=spec.Bind*awake
	Brawler.react(c,b,"Bound",Vector3.zero,duration,a)
	b.boundBy=a
	-- What holds it, for the client (hounds at the legs, a shadow, coils...).
	b.boundKind=spec.Kind or "chakra"
	local name=string.upper(spec.Name or "BOUND")
	c:cue(a,name.." • BOUND",.8);c:cue(b,"BOUND • X TO ESCAPE",.9)
	Brawler.event(c,a,"FamilyBind")
	if spec.Crush then
		c:schedule(c.now+duration-.05,function()
			if b.reaction~="Bound" or b.boundBy~=a or a.health&lt;=0 or b.health&lt;=0 then return end
			b.boundBy=nil
			c.damageTag=spec.Name or "bind"
			c:damage(a,b,spec.Crush,true,false)
			c.damageTag=nil
			if c.match.phase~="Duel" or b.health&lt;=0 then return end
			Brawler.react(c,b,"Knockdown",Vector3.new(0,16,0),.7,a)
			c:pushImpact(b.root.Position,"look",true,{owner=a.id,kind=spec.Kind,victim=b.id})
		end)
	end
end

-- The zone of a's (with that look, when given) that b stands in.
function Families.ownZone(c,a,b,look)
	for _,h in c.hazards do
		if h.a==a and c.now&lt;h.expires and not h.charge and (not look or h.look==look) then
			local d=b.root.Position-h.position
			if Vector3.new(d.X,0,d.Z).Magnitude&lt;=h.radius and math.abs(d.Y)&lt;8 then return h end
		end
	end
	return nil
end
-- Is b inside one of a's own zones (hazards he left)?
function Families.inOwnZone(c,a,b)
	for _,h in c.hazards do
		if h.a==a and c.now&lt;h.expires and not h.charge then
			local d=b.root.Position-h.position
			if Vector3.new(d.X,0,d.Z).Magnitude&lt;=h.radius and math.abs(d.Y)&lt;8 then return true end
		end
	end
	return false
end

-- Where a thrown technique flies, decided on its RELEASE frame, not on the
-- press: a cast aimed at the opponent's body (the mouse on or near him) is
-- re-aimed at where he is now, with a partial lead on his motion (spec.Lead,
-- default .55 of the flight). The channel no longer makes every jutsu miss a
-- body that merely walks; a late sidestep, a dash or a jump still beat it. An
-- aim far from the body (a zone, a lane) is kept as it was.
Families.AIM_SNAP=12
function Families.snapAim(a,aim,c)
	-- Lost in the opponent's shroud: no aid finds the body for him.
	if c and Families.shrouded(c,a) then return aim end
	local b=a.target
	if b and b.health&gt;0 and flat(aim-b.root.Position).Magnitude&lt;=Families.AIM_SNAP*.5 then return b.root.Position end
	return aim
end
function Families.releaseAim(c,a,pending,spec)
	local aim=aimOf(a,pending)
	local b=a.target
	if not b or b.health&lt;=0 then return aim end
	-- In his shroud: the aim as given, no snap onto the body, no lead.
	if Families.shrouded(c,a) then return pending.aim or a.root.Position+a.root.CFrame.LookVector*20 end
	local at=b.root.Position
	if flat(aim-at).Magnitude&gt;Families.AIM_SNAP and pending.aim then return aim end
	local motion=b.root.AssemblyLinearVelocity
	if motion.Magnitude&lt;.5 then motion=b.locomotion or Vector3.zero end
	local flight=(at-a.root.Position).Magnitude/math.max(spec.Speed or 70,1)
	return at+flat(motion)*flight*(spec.Lead or .55)
end

-- ----------------------------------------------------------- charges
local function awakeRule(a,c,key)
	local aw=a.def.Awakening
	return (a.awakenUntil or 0)&gt;c.now and aw~=nil and aw[key] or nil
end
Families.awakeRule=awakeRule
function Families.plant(c,a,position,charge,kindLook)
	local floor=workspace:Raycast(position+Vector3.new(0,3,0),Vector3.new(0,-30,0),c:rayParams(true))
	local at=if floor then floor.Position+Vector3.new(0,.5,0) else position
	local h=c:addHazard(a,at,charge.Trigger or 2.6,charge.Life or 9,0,"Charge")
	h.charge=charge;h.effects={charge=true}
	h.look=charge.Look or kindLook
	h.armedAt=if awakeRule(a,c,"ChainCharges") then c.now else c.now+(charge.Arm or .5)
	c:pushImpact(at,"zone",false,{owner=a.id,kind=h.look,radius=h.radius,time=charge.Life or 9})
	return h
end
function Families.charges(c,a)
	local out={}
	for _,h in c.hazards do if h.a==a and h.charge and c.now&lt;h.expires then table.insert(out,h) end end
	return out
end
function Families.detonate(c,h,chained)
	if not h.charge or c.now&gt;=h.expires then return end
	h.expires=c.now
	local a,z=h.a,h.charge
	local b=a.target
	c:pushImpact(h.position,"look",true,{owner=a.id,kind=z.Blast or "clay",radius=z.Radius or 5})
	if b and b.health&gt;0 and c.match.phase=="Duel" then
		local d=b.root.Position-h.position
		if Vector3.new(d.X,0,d.Z).Magnitude&lt;=(z.Radius or 5) and math.abs(d.Y)&lt;7 then
			c.damageTag="charge"
			local hit=c:damage(a,b,z.Damage or 8,(z.Damage or 8)&gt;=12,false)
			c.damageTag=nil
			if c.match.phase~="Duel" then return end
			Families.contact(c,a,b,{Knock=z.Knock or 30,Lift=z.Lift or 20},d,hit,hit and b.impactStyle=="block",b.root.Position)
		end
	end
	brawler().event(c,a,"Detonation")
	-- The awakening chains: every other charge of his near the blast goes too.
	if awakeRule(a,c,"ChainCharges") then
		for _,other in Families.charges(c,a) do
			if (other.position-h.position).Magnitude&lt;=(z.Chain or 10) then
				c:schedule(c.now+.08,function() Families.detonate(c,other,true) end)
			end
		end
	end
end
-- A thrown object that ends without a body (Combat: surface or range end).
function Families.projectileEnd(c,p,position)
	local spec=p.family
	if spec and spec.Charge and not p.planted then
		p.planted=true
		Families.plant(c,p.a,position,spec.Charge,p.kind)
	end
end
-- Every frame, per body: an Absorb buff drinks the enemy objects near it.
function Families.step(c,a,now)
	local b=a.buff
	local absorb=b and now&lt;b.untilT and b.spec.Absorb
	if not absorb then return end
	for i=#c.projectiles,1,-1 do
		local p=c.projectiles[i]
		if p.a~=a and not p.planted and (p.position-a.root.Position).Magnitude&lt;=(absorb.Radius or 6) then
			table.remove(c.projectiles,i)
			local worth=math.max(2,p.damage or 2)
			a.chakra=math.min(a.def.Chakra or 100,a.chakra+worth*(absorb.Chakra or 2))
			if absorb.Heal then a.health=math.min(a.def.Health,a.health+worth*absorb.Heal);a.hum.Health=math.max(1,a.health) end
			c:pushImpact(p.position,"drain",false,{owner=a.id,victim=p.a.id,amount=worth,projectile=p.id,kind=p.kind})
			c:cue(a,"ABSORBED",.5)
			brawler().event(c,a,"Absorbed")
		end
	end
end

-- ----------------------------------------------------------- families
local F={}
F.Projectile={
	check=function() return true end,
	execute=function(c,a,pending)
		local spec=pending.spec
		local aim=Families.releaseAim(c,a,pending,spec)
		local kind=spec.Kind or "chakra"
		local look=Looks[kind]
		local launch=spec.Launch or (look and look.launch) or (if spec.Ground then "Ground" else "Palm")
		local origin=c.launchPoint(a,launch)
		local count=spec.Count or 1
		local fan=spec.Spread or 0
		local function fire(i)
			if a.health&lt;=0 or c.match.phase~="Duel" then return end
			local from=if (spec.Volley or 0)&gt;0 then c.launchPoint(a,launch) else origin
			local d=aim-from
			if spec.Ground then d=flat(d) end
			d=unitOr(d,a.root.CFrame.LookVector)
			local angle=if count&gt;1 then -fan/2+fan*(i-1)/(count-1) else 0
			if angle~=0 then d=CFrame.fromAxisAngle(Vector3.yAxis,angle):VectorToWorldSpace(d) end
			local range=spec.Range or 40
			local p=c:projectile(a,from+d*range,spec.Speed or 70,range,spec.Damage or 4,kind,nil,{origin=from,radius=spec.Radius or (look and look.radius) or .6,growth=spec.Growth or 0})
			p.family=spec
		end
		for i=1,count do
			if (spec.Volley or 0)&gt;0 and i&gt;1 then c:schedule(c.now+spec.Volley*(i-1),function() fire(i) end) else fire(i) end
		end
		c:cue(a,string.upper(spec.Name),.6)
	end,
}
F.Strike={
	check=function() return true end,
	execute=function(c,a,pending)
		local spec=pending.spec
		local Brawler=brawler()
		a.stringCancel=nil
		Brawler.start(c,a,spec.Move or "JutsuStrike")
		if a.pending then
			if spec.Damage then a.pending.spec.damage=spec.Damage end
			a.pending.family=spec
		end
		c:pushImpact(a.root.Position,"afterimage",false,{owner=a.id,fighter=a.fighterId})
		c:cue(a,string.upper(spec.Name),.7)
	end,
}
F.Burst={
	check=function() return true end,
	execute=function(c,a,pending)
		local spec=pending.spec
		local reach=spec.Radius or 7
		local look=flat(a.root.CFrame.LookVector)
		look=unitOr(look,Vector3.zAxis)
		-- A cone (Arc) goes where it was aimed at the press: the channel's
		-- auto-facing must not swing it onto a body that side-stepped (a
		-- short Katon is open on the sides).
		if spec.Arc and pending.aim then
			look=unitOr(flat(pending.aim-a.root.Position),look)
			a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+look)
		end
		if spec.Clear then
			local reflect=awakeRule(a,c,"ReflectClear")
			for i=#c.projectiles,1,-1 do
				local p=c.projectiles[i]
				if p.a~=a and not p.planted and (p.position-a.root.Position).Magnitude&lt;=reach+2 then
					table.remove(c.projectiles,i)
					c:pushImpact(p.position,"deflect",false,{projectile=p.id,kind=p.kind,owner=p.a.id})
					-- The awakening sends it back where it came from.
					if reflect and p.a.health&gt;0 then
						local back=c:projectile(a,p.a.root.Position,math.max(p.speed or 80,80),40,p.damage or 3,p.kind,nil,{origin=p.position,radius=p.radius})
						back.family=p.family
						c:cue(a,"REPELLED BACK",.5)
					end
				end
			end
		end
		-- His own charges go off wherever they lie (Katsu!).
		if spec.Detonate then
			for k,h in Families.charges(c,a) do
				c:schedule(c.now+.04*k,function() Families.detonate(c,h) end)
			end
		end
		local b=a.target
		if b and b.health&gt;0 then
			local d=flat(b.root.Position-a.root.Position)
			local inArc=d.Magnitude&lt;2 or look:Dot(d.Unit)&gt;(spec.Arc or -1)
			if d.Magnitude&lt;=reach and math.abs(b.root.Position.Y-a.root.Position.Y)&lt;7 and inArc then
				c.damageTag=spec.Name
				local hit=c:damage(a,b,spec.Damage or 6,(spec.Damage or 6)&gt;=12,false)
				c.damageTag=nil
				if c.match.phase~="Duel" then return end
				Families.contact(c,a,b,spec,d,hit,hit and b.impactStyle=="block",b.root.Position)
			end
		end
		c:pushImpact(a.root.Position,spec.Style or "look",true,{owner=a.id,kind=spec.Kind,radius=reach,direction=look})
		-- What the burst leaves at his feet (Leave: a zone, e.g. spiked floor).
		if spec.Leave and c.match.phase=="Duel" then
			local z=spec.Leave
			local floor=workspace:Raycast(a.root.Position+Vector3.new(0,2,0),Vector3.new(0,-30,0),c:rayParams(true))
			local at=if floor then floor.Position+Vector3.new(0,.5,0) else a.root.Position
			local h=c:addHazard(a,at,z.Radius or 6,z.Time or 3,z.Damage or 3,z.Kind or "Spikes")
			h.effects=z
			h.look=z.Look
			c:pushImpact(at,"zone",true,{owner=a.id,kind=z.Look,radius=z.Radius or 6,time=z.Time or 3})
		end
		c:cue(a,string.upper(spec.Name),.6)
	end,
}
-- Where a zone or a charge may be set (QA-004 M2): Self is at his feet, with
-- no other bound. Target needs the body inside Range (+slack) and in sight,
-- refused before any cost, like a relocation. Aim is clamped: along the aim,
-- never further than Range from him, never through a wall (it stops short of
-- the first obstacle on the way).
function Families.placeWithin(c,a,position,range)
	local from=a.root.Position
	local off=flat(position-from)
	if off.Magnitude&gt;range then position=from+off.Unit*range+Vector3.new(0,position.Y-from.Y,0) end
	-- A level ray at body height (the floor under the point is not a wall).
	local level=Vector3.new(position.X,from.Y,position.Z)
	local ray=workspace:Raycast(from,level-from,c:rayParams(true))
	if ray then
		local back=flat(ray.Position-from)
		position=if back.Magnitude&gt;1.5 then from+back.Unit*(back.Magnitude-1.2) else from
	end
	return position
end
F.Zone={
	check=function(c,a,spec)
		if (spec.At or "Aim")~="Target" then return true end
		local b=a.target
		if not b or b.health&lt;=0 then return false,"No target" end
		if (b.root.Position-a.root.Position).Magnitude&gt;(spec.Range or 30)+Families.TELEPORT_SLACK then return false,"Out of range" end
		if not c:lineOfSight(a,b) then return false,"No line of sight" end
		return true
	end,
	execute=function(c,a,pending)
		local spec=pending.spec
		local at=spec.At or "Aim"
		-- An aim on or near the body (the mouse at his feet) means him, now.
		local position=if at=="Self" then a.root.Position elseif at=="Target" and a.target then a.target.root.Position
			else Families.snapAim(a,aimOf(a,pending),c)
		if at~="Self" then position=Families.placeWithin(c,a,position,(spec.Range or 30)+(if at=="Target" then Families.TELEPORT_SLACK else 0)) end
		local floor=workspace:Raycast(position+Vector3.new(0,4,0),Vector3.new(0,-30,0),c:rayParams(true))
		if floor then position=floor.Position+Vector3.new(0,.5,0) end
		if spec.Charge then
			-- A buried charge, not a field: it waits for the body or for Katsu.
			Families.plant(c,a,position,spec.Charge,spec.Kind)
			c:cue(a,string.upper(spec.Name),.6)
			return
		end
		local h=c:addHazard(a,position,spec.Radius or 8,spec.Time or 4,spec.Damage or 3,spec.ZoneKind or "Fire")
		h.effects=spec
		h.look=spec.Kind
		c:pushImpact(position,"zone",true,{owner=a.id,kind=spec.Kind,radius=spec.Radius or 8,time=spec.Time or 4})
		c:cue(a,string.upper(spec.Name),.6)
	end,
}
F.Buff={
	check=function(c,a,spec,now)
		-- Not while the same buff still runs.
		return not (a.buff and now&lt;a.buff.untilT and a.buff.spec==spec)
	end,
	execute=function(c,a,pending)
		local spec=pending.spec
		a.buff={untilT=c.now+(spec.Time or 5),spec=spec,id=spec.Id}
		if spec.Heal then
			a.health=math.min(a.def.Health,a.health+spec.Heal);a.hum.Health=math.max(1,a.health)
		end
		c:pushImpact(a.root.Position,"buff",true,{owner=a.id,kind=spec.Kind,technique=spec.Id,time=spec.Time or 5})
		c:cue(a,string.upper(spec.Name),.8)
		brawler().event(c,a,"Buff")
	end,
}
-- A relocation onto the opponent (Behind, Side, Aim) needs the body inside
-- the technique's Range and in sight (no blinking through a wall to it); a
-- refusal happens before any cost. A step back (Back) needs neither.
Families.TELEPORT_SLACK=1.5
F.Teleport={
	check=function(c,a,spec)
		local b=a.target
		if not b or b.health&lt;=0 then return false,"No target" end
		if (spec.To or "Behind")=="Back" then return true end
		local gap=(b.root.Position-a.root.Position).Magnitude
		if gap&gt;(spec.Range or 30)+Families.TELEPORT_SLACK then return false,"Out of range" end
		if not c:lineOfSight(a,b) then return false,"No line of sight" end
		return true
	end,
	execute=function(c,a,pending)
		local spec=pending.spec
		local b=a.target
		local to=spec.To or "Behind"
		-- The bound holds at the release too (QA-004 M2): a body that left the
		-- Range or the line of sight during the channel is not followed. The
		-- jutsu fizzles where he stands: the chakra is spent (the opponent read
		-- it), the cooldown is a short one (not the full one on top).
		if to~="Back" then
			local ok,why=F.Teleport.check(c,a,spec)
			if not ok then
				a.cooldowns[spec.Id]=c.now+math.min(spec.Cooldown or 1,.8)
				c:cue(a,string.upper(spec.Name).." • "..string.upper(why or "lost"),.7)
				brawler().event(c,a,"TeleportFizzle")
				return
			end
		end
		local d=spec.Distance or 3.2
		local from=a.root.Position
		local line=unitOr(flat(b.root.Position-from),flat(a.root.CFrame.LookVector).Unit)
		local destination
		-- Inside his own zone of the ring's look (Haku's dome): out of the
		-- mirror on its far side, a volley from there, no step into melee.
		local ring=spec.Ring and Families.ownZone(c,a,b,spec.Ring.Look)
		if ring then
			local around=flat(b.root.Position-ring.position)
			local side=unitOr(line+around*.0,line)
			destination=ring.position+side*ring.radius
		elseif to=="Behind" then destination=b.root.Position+line*d
		elseif to=="Side" then a.teleportSide=-(a.teleportSide or 1);destination=b.root.Position+line:Cross(Vector3.yAxis)*d*a.teleportSide
		elseif to=="Back" then destination=from-line*d
		else
			local aim=aimOf(a,pending)
			local off=flat(aim-from)
			destination=from+unitOr(off,line)*math.min(off.Magnitude,d)
		end
		destination=Vector3.new(destination.X,from.Y,destination.Z)
		c:relocate(a,destination)
		local face=flat(b.root.Position-a.root.Position)
		if face.Magnitude&gt;.1 then a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+face) end
		a.teleportAt=c.now
		if spec.Invuln then a.invulnerableUntil=math.max(a.invulnerableUntil or 0,c.now+spec.Invuln) end
		if spec.Heal then a.health=math.min(a.def.Health,a.health+spec.Heal);a.hum.Health=math.max(1,a.health) end
		local bonus=1
		if spec.InZone and Families.inOwnZone(c,a,b) then bonus=spec.InZone;c:cue(a,"FROM THE "..string.upper(spec.ZoneName or "zone"),.6) end
		c:pushImpact(destination,"teleport",false,{owner=a.id,from=from,to=destination,kind=spec.Kind})
		c:cue(a,string.upper(spec.Name),.6)
		if ring then
			local v=spec.Ring.Volley or {}
			for k=1,(v.Count or 3) do
				c:schedule(c.now+.05*k,function()
					if a.health&lt;=0 or b.health&lt;=0 or c.match.phase~="Duel" or a.reaction then return end
					local spread=b.root.CFrame.RightVector*((k-((v.Count or 3)+1)/2)*.9)
					local p=c:projectile(a,b.root.Position+spread,v.Speed or 110,ring.radius*2+8,(v.Damage or 2)*bonus,v.Kind or "senbon",nil,{origin=a.root.Position+Vector3.new(0,.6,0),radius=.6})
					p.family={Slow=v.Slow,Name=spec.Name}
				end)
			end
			brawler().event(c,a,"RingStep")
			-- The awakening: travel between his mirrors is free and immediate.
			if awakeRule(a,c,"ZoneFree") then
				a.chakra=math.min(a.def.Chakra or 100,a.chakra+(spec.Cost or 0))
				a.cooldowns[spec.Id]=c.now+.35
				c:cue(a,"MIRROR TO MIRROR",.5)
			end
			return
		end
		if spec.Move then
			c:schedule(c.now+.06,function()
				if a.health&lt;=0 or c.match.phase~="Duel" or a.reaction then return end
				brawler().start(c,a,spec.Move)
				if a.pending then
					if spec.Damage then a.pending.spec.damage=spec.Damage end
					if bonus~=1 then a.pending.spec.damage=(a.pending.spec.damage or 8)*bonus end
					a.pending.family=spec
				end
			end)
		end
	end,
}
-- A persistent body of his (Server/Bodies): a puppet on its threads. Out
-- already, the cast sends it lunging at the body instead.
F.Summon={
	check=function(c,a) return a.target~=nil and a.target.health&gt;0 end,
	execute=function(c,a,pending)
		local spec=pending.spec
		local Bodies=require(script.Parent.Bodies)
		local kind=spec.Body or "puppet"
		local out=Bodies.of(c,a,kind)[1]
		if out then
			out.lunge=spec.Lunge or {};out.nextStrike=c.now
			c:cue(a,string.upper(spec.LungeName or "LUNGE"),.6)
			brawler().event(c,a,"BodyLunge")
			return
		end
		local b=a.target
		local line=unitOr(flat(b.root.Position-a.root.Position),flat(a.root.CFrame.LookVector).Unit)
		local at=a.root.Position+line*3
		local body=Bodies.spawn(c,a,{kind=kind,position=Vector3.new(at.X,c.match.origin.Y+3,at.Z),mode=spec.Mode or "marionette",life=spec.Life,delay=.8})
		if body then body.side=if (a.summonSide or 1)&gt;0 then -1 else 1;a.summonSide=body.side end
		c:cue(a,string.upper(spec.Name),.7)
	end,
}
F.Counter={
	check=function() return true end,
	execute=function(c,a,pending)
		local spec=pending.spec
		a.counterStance={untilT=c.now+(spec.Time or .8),spec=spec}
		c:pushImpact(a.root.Position,"stance",false,{owner=a.id,kind=spec.Kind,time=spec.Time or .8})
		c:cue(a,string.upper(spec.Name),.6)
	end,
}
Families.F=F

-- ----------------------------------------------------------- core hooks
-- Combat:damage, before any defence: a counter stance answers a melee blow.
-- Returns true when the blow was taken by the stance.
function Families.beforeHit(c,attacker,victim,readEligible)
	local stance=victim.counterStance
	if not stance or c.now&gt;=stance.untilT or not readEligible then return false end
	victim.counterStance=nil
	local spec=stance.spec
	local Brawler=brawler()
	if spec.Swap then
		local line=unitOr(flat(attacker.root.Position-victim.root.Position),flat(victim.root.CFrame.LookVector).Unit)
		local from=victim.root.Position
		c:relocate(victim,attacker.root.Position+line*3)
		victim.root.CFrame=CFrame.lookAt(victim.root.Position,Vector3.new(attacker.root.Position.X,victim.root.Position.Y,attacker.root.Position.Z))
		c:pushImpact(victim.root.Position,"teleport",false,{owner=victim.id,from=from,to=victim.root.Position,kind=spec.Kind})
	end
	attacker.pending=nil
	-- A stance answered by a real strike (Counter Move: Madara's pommel,
	-- Hashirama's shoulder, Hiruzen's point): the blow is turned aside, the
	-- attacker staggers, and the answer is a strike of his body that must
	-- still land (it opens a string like a riposte).
	if spec.Move then
		Brawler.react(c,attacker,"HitStun",Vector3.zero,.42,victim)
		c:pushImpact(victim.root.Position:Lerp(attacker.root.Position,.5),"clash",true,{direction=flat(attacker.root.Position-victim.root.Position)})
		c:pushImpact(victim.root.Position,"look",true,{owner=victim.id,kind=spec.Kind,victim=attacker.id})
		c:cue(victim,string.upper(spec.Name).." • COUNTER",.8)
		Brawler.event(c,victim,"Counter")
		c:schedule(c.now+.04,function()
			if victim.health&lt;=0 or attacker.health&lt;=0 or c.match.phase~="Duel" or victim.reaction then return end
			victim.state="Neutral";victim.untilTime=c.now;victim.guardHeld=false;victim.evade=nil
			Brawler.breakString(victim,false);victim.lastAttack=c.now
			Brawler.start(c,victim,Brawler.riposteMove(c,victim,spec.Move))
		end)
		return true
	end
	c.damageTag=spec.Name
	local hit=c:damage(victim,attacker,spec.Damage or 8,true,false)
	c.damageTag=nil
	if c.match.phase~="Duel" then return true end
	Families.contact(c,victim,attacker,spec,attacker.root.Position-victim.root.Position,hit,hit and attacker.impactStyle=="block",attacker.root.Position)
	if hit and not spec.Bind and not spec.Knock and not spec.Lift and not spec.React then
		Brawler.react(c,attacker,"Knockback",unitOr(flat(attacker.root.Position-victim.root.Position),Vector3.zAxis)*40+Vector3.new(0,14,0),.5,victim)
	end
	c:pushImpact(attacker.root.Position,"look",true,{owner=victim.id,kind=spec.Kind,victim=attacker.id})
	c:cue(victim,string.upper(spec.Name).." • COUNTER",.8)
	Brawler.event(c,victim,"Counter")
	return true
end
-- Combat:damage, after health was taken: the attacker's on-hit trait
-- (def.OnHit: Samehada's drain, insects on the body...).
function Families.afterHit(c,attacker,victim,amount,guarded)
	if victim.health&lt;=0 or attacker==victim then return end
	local spec=Families.onHit(attacker,c.now)
	if not spec then return end
	if spec.Drain then
		local taken=math.min(victim.chakra,spec.Drain*(if guarded then .5 else 1))
		victim.chakra-=taken
		if spec.Steal then attacker.chakra=math.min(attacker.def.Chakra or 100,attacker.chakra+taken*spec.Steal) end
		if spec.Heal and taken&gt;0 then attacker.health=math.min(attacker.def.Health,attacker.health+taken*spec.Heal);attacker.hum.Health=math.max(1,attacker.health) end
		if taken&gt;0 then c:pushImpact(victim.root.Position,"drain",false,{owner=attacker.id,victim=victim.id,amount=taken}) end
	end
	if spec.Slow and not guarded then victim.slowUntil=c.now+(spec.Slow.Time or 1.5);victim.slowScale=spec.Slow.Scale or .8 end
	-- A dose that still runs is not stacked by every light of a string.
	if spec.Poison and not guarded and c.now&gt;=(victim.poisonedUntil or 0) then Families.poison(c,attacker,victim,spec.Poison) end
end
-- Brawler.hit, after the strike's own reaction: a Strike/Teleport family move
-- adds its contact fields.
function Families.strikeHit(c,a,b,p,guarded)
	local spec=p.family or (p.spec and p.spec.riders)
	if not spec then return end
	-- The awakening's chain: a relocation strike that lands gives the
	-- relocation back at once, a few times in a row (Shisui).
	local chain=p.family and p.family.Family=="Teleport" and not guarded and awakeRule(a,c,"ChainTeleport")
	if chain then
		if c.now-(a.chainTeleportAt or -10)&gt;2.5 then a.chainTeleportCount=0 end
		if (a.chainTeleportCount or 0)&lt;chain then
			a.chainTeleportCount=(a.chainTeleportCount or 0)+1;a.chainTeleportAt=c.now
			a.cooldowns[p.family.Id]=c.now+.12
			c:cue(a,"FLICKER CHAIN "..a.chainTeleportCount.."/"..chain,.5)
			brawler().event(c,a,"ChainTeleport")
		end
	end
	Families.contact(c,a,b,spec,a.root.CFrame.LookVector,not guarded,guarded,b.root.Position)
end
-- Combat:updateHazards, on each tick that reached the body: the zone's riders.
function Families.zoneTick(c,h,target)
	local z=h.effects
	if not z then return end
	if h.charge then
		if c.now&gt;=(h.armedAt or 0) then Families.detonate(c,h) end
		return
	end
	if z.Slow then target.slowUntil=c.now+.6;target.slowScale=z.Slow.Scale or .7 end
	if z.Drain then
		local taken=math.min(target.chakra,z.Drain)
		target.chakra-=taken
		if z.Steal then h.a.chakra=math.min(h.a.def.Chakra or 100,h.a.chakra+taken*z.Steal) end
	end
	if z.Seal then target.sealedUntil=math.max(target.sealedUntil or 0,c.now+z.Seal) end
end
-- Projectiles: a family object reports its contact (Combat:projectileHit).
function Families.projectileHit(c,p,target,damaged,guarded,position)
	if p.family then Families.contact(c,p.a,target,p.family,p.direction,damaged,guarded,position) end
end
-- Techniques: every fighter technique that names a Family and has no bespoke
-- implementation gets the family's.
function Families.install(Techniques,Fighters)
	for _,def in Fighters do
		for _,spec in def.Techniques or {} do
			if spec.Family and not Techniques[spec.Id] then
				local family=F[spec.Family]
				assert(family,"Unknown technique family "..tostring(spec.Family).." for "..tostring(spec.Id))
				Techniques[spec.Id]=family
			end
		end
	end
end
-- Lifecycle (Combat:clear: a new round, the result screen, a rematch, a
-- player who leaves): every temporary state a body carries ends there, the
-- families' own (buff, counter stance, slow, poison, the bind's look) and any
-- `...Until` window the core or a fighter module left on the actor, so
-- nothing of a round leaks into the next one (a buff, a dose still ticking).
function Families.clearState(a)
	a.buff=nil;a.counterStance=nil;a.slowScale=nil;a.boundKind=nil;a.teleportSide=nil;a.fogAim=nil
	-- A dose already scheduled checks its serial: a new one cancels it.
	a.poisonSerial=(a.poisonSerial or 0)+1
	for key,value in a do
		if type(key)=="string" and type(value)=="number" and string.sub(key,-5)=="Until" then a[key]=0 end
	end
end
-- Shroud (Zabuza's Hidden Mist): a body standing inside its opponent's
-- shroud has lost sight of him (QA-004 M3, one contract): no auto-facing on
-- him, a chakra dash without homing, no snap/lead of a jutsu or a tool onto
-- him (Families.releaseAim/snapAim, Combat throw release), its camera stops
-- following him (Client/Camera, the lock preference itself is kept) and its
-- client draws him as a fading shadow. The bot has no exemption: while lost
-- it aims where it last saw him (AI, a.fogAim). Manual inputs are untouched:
-- a press or a mouse aim still goes exactly where it was given. His own
-- shroud never hides anything from him.
function Families.shrouded(c,a)
	local b=a.target
	if not b or b.health&lt;=0 then return false end
	for _,h in c.hazards do
		if h.a==b and c.now&lt;h.expires and h.effects and h.effects.Shroud then
			local d=a.root.Position-h.position
			if Vector3.new(d.X,0,d.Z).Magnitude&lt;=h.radius and math.abs(d.Y)&lt;10 then return true end
		end
	end
	return false
end
-- Snapshot: what a body carries from the families (client auras, HUD).
function Families.snapshot(a,now,c)
	local b=a.buff
	return {
		buff=if b and now&lt;b.untilT then b.id else nil,
		buffLeft=if b and now&lt;b.untilT then b.untilT-now else 0,
		stance=if a.counterStance and now&lt;a.counterStance.untilT then a.counterStance.spec.Id else nil,
		slowed=math.max(0,(a.slowUntil or 0)-now),
		poisoned=math.max(0,(a.poisonedUntil or 0)-now),
		shrouded=c~=nil and Families.shrouded(c,a) or nil,
	}
end
return Families
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND63">
        <Properties>
          <string name="Name">Gale</string>
          <ProtectedString name="Source">-- Temari (Gale, roster wave): the wind fan, on the shared systems. Her kit
-- lives here so the contested combat files only carry short registries
-- (Techniques.Tools / payoffs / awakenHooks / actorSteps / reposition, read by
-- Combat and Brawler): Kamaitachi, Great Gust and Rising Whirlwind (each one
-- leaves a zone, Zones.luau), the fan gust that replaces a thrown tool, the
-- wind step that re-enters at her range, the updraft route, the glide and the
-- Kirikiri Mai awakening. Sheet: docs/characters/TEMARI.md.
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Config=require(Shared.Config)
local Rules=require(Shared.Rules)
local Zones=require(script.Parent.Zones)
local Motor=require(script.Parent.Motor)
local Brawler=require(script.Parent.Brawler)
local Defense=require(script.Parent.VelmoraDefense)
local Gale={}
local function flat(v) return Vector3.new(v.X,0,v.Z) end
local function flatUnit(v,fallback)
	local f=flat(v)
	return if f.Magnitude&gt;.05 then f.Unit else (fallback or Vector3.zAxis)
end
local function awake(c,a) return (a.awakenUntil or 0)&gt;c.now and a.def.Awakening or nil end
-- After Kirikiri Mai the fan stays shut for a moment: no technique.
function Gale.fanOpen(c,a,_spec,now)
	local tune=a.def.Awakening
	local until_=a.awakenUntil or 0
	if tune and tune.FanClosed and a.awakened and until_&gt;0 and now&gt;=until_ and now&lt;until_+tune.FanClosed then return false,"Fan closed" end
	return true
end
-- A lane of wind from `origin` (put on the floor) along `direction`. Kirikiri
-- Mai: longer, wider, and blades going up it are sent back.
local function lane(c,a,origin,direction,length,width,life,carrier)
	local on=awake(c,a)
	return Zones.add(c,a,"Wind",{origin=Vector3.new(origin.X,c.match.origin.Y,origin.Z),direction=direction,length=length,
		width=width*(if on then on.LaneWidth or 1 else 1),life=life*(if on then on.LaneLife or 1 else 1),carrier=carrier,reflect=on~=nil and on.Reflect==true})
end
Gale.lane=lane
-- The fan's line: from the hand at the aim, rising to a body held up in the
-- air (never steeper than ~40 degrees), and the flat direction of its lane.
local function windLine(c,a,aim,range)
	local origin=c.launchPoint(a,"Wind")
	aim=aim or (a.target and a.target.root.Position) or a.root.Position+a.root.CFrame.LookVector*range
	local d=aim-origin
	local f=flat(d)
	if f.Magnitude&lt;1 then f=flat(a.root.CFrame.LookVector);d=f end
	local rise=math.clamp(d.Y,-f.Magnitude*.2,f.Magnitude*.84)
	return origin,Vector3.new(f.X,rise,f.Z).Unit,f.Unit
end
-- In the fan's cone (flat reach, cosine of the half angle, 10 studs up or down).
local function inCone(a,position,reach,cos)
	local d=position-a.root.Position
	local f=flat(d)
	if f.Magnitude&gt;reach or math.abs(d.Y)&gt;10 then return false end
	if f.Magnitude&lt;1.5 then return true end
	return flatUnit(a.root.CFrame.LookVector):Dot(f.Unit)&gt;=cos
end
Gale.inCone=inCone
-- The blades in the cone are blown out of the air (sent back at their thrower
-- when `back`), fire in it grows. Returns how many blades.
local function sweep(c,a,reach,cos,back)
	local count=0
	for _,p in table.clone(c.projectiles) do
		if p.a~=a and not p.dead and not p.planted and (p.speed or 0)&gt;0 and inCone(a,p.position,reach,cos) then
			if Zones.FIRE[p.kind] then
				Zones.feed(c,p,a,Zones.KINDS.Wind.feed,Zones.KINDS.Wind.feedDamage)
			elseif Zones.OBJECT[p.kind] then
				count+=1
				if back then Zones.sendBack(c,p,a)
				else
					p.dead=true
					local index=table.find(c.projectiles,p)
					if index then table.remove(c.projectiles,index) end
					c:pushImpact(p.position,"deflect",false,{projectile=p.id,kind=p.kind,owner=p.a.id,direction=-p.direction,chakra="blown"})
				end
			end
		end
	end
	return count
end

-- --------------------------------------------------------------- techniques
-- Kamaitachi: a wind scythe that knocks away (a wall behind the body splats
-- it) and leaves a lane of wind behind it, laid as it flies. Wind scatters
-- sand: it breaks Gaara's shield outright (breaksShield), as the Great Gust does.
local function kamaitachi(c,a,pending)
	local spec=pending.spec
	local origin,line,direction=windLine(c,a,pending.aim,spec.Range)
	local p=c:projectile(a,origin+line*spec.Range,spec.Speed or 74,spec.Range,spec.Damage,"gale",nil,
		{origin=origin,radius=2.4,growth=3,reaction="Knockback",impulse=Vector3.new(0,12,46),stun=.5,style="jutsu",breaksShield=true})
	lane(c,a,origin,direction,spec.Range,spec.Lane or 3.2,spec.LaneLife or 3.6,p)
	c:cue(a,"KAMAITACHI",.6)
	Brawler.event(c,a,"Kamaitachi")
end
-- Great Gust: the fan fully open. Blades in the cone are blown away, fire
-- grows, the body is thrown back (a wall splat at range) and a wide lane stays.
local function greatGust(c,a,pending)
	local spec=pending.spec
	local reach,cos=spec.Range,spec.Cone or .74
	local look=flatUnit(a.root.CFrame.LookVector)
	local blown=sweep(c,a,reach,cos,false)
	local b=a.target
	if b and b.health&gt;0 and inCone(a,b.root.Position,reach,cos) and c:lineOfSight(a,b) then
		c.damageTag="Great Gust";c.shieldBreak=true
		local hit=c:damage(a,b,spec.Damage,false,false)
		c.damageTag=nil;c.shieldBreak=nil
		if c.match.phase~="Duel" then return end
		if hit then
			local away=flatUnit(b.root.Position-a.root.Position,look)
			if b.impactStyle=="block" then Motor.travel(b,c,away,3)
			else Brawler.react(c,b,"Knockback",away*(spec.Push or 58)+Vector3.new(0,14,0),.6,a) end
			Brawler.event(c,a,"GreatGustHit")
		end
	end
	lane(c,a,a.root.Position+look*2,look,reach,spec.Lane or 5,spec.LaneLife or 4.2)
	c:pushImpact(a.root.Position+look*3,"greatgust",true,{owner=a.id,fighter=a.fighterId,direction=look,range=reach,blown=blown})
	c:cue(a,if blown&gt;0 then "GREAT GUST • "..blown.." BLADES BLOWN AWAY" else "GREAT GUST",.7)
	Brawler.event(c,a,"GreatGust")
end
-- Rising Whirlwind: the spot where the opponent stands is marked; a beat later
-- a column of rising air erupts there. A body still in it is thrown up and
-- held (Zones "Updraft"); one that kept moving is not.
local function cyclone(c,a,pending)
	local spec=pending.spec
	local b=a.target
	local aim=pending.aim or (b and b.root.Position) or a.root.Position+a.root.CFrame.LookVector*spec.Range
	local d=flat(aim-a.root.Position)
	if d.Magnitude&gt;spec.Range then aim=a.root.Position+d.Unit*spec.Range end
	local spot=Vector3.new(aim.X,c.match.origin.Y,aim.Z)
	local radius=spec.Radius or 3.4
	local delay=spec.Delay or .45
	c:pushImpact(spot+Vector3.new(0,.3,0),"cyclone",false,{owner=a.id,fighter=a.fighterId,phase="mark",delay=delay,radius=radius})
	c:cue(a,"RISING WHIRLWIND",.6)
	Brawler.event(c,a,"Cyclone")
	c:schedule(c.now+delay,function()
		if a.health&lt;=0 or c.match.phase~="Duel" then return end
		local z=Zones.add(c,a,"Updraft",{origin=spot,radius=radius,life=spec.Life or 2.2})
		c:pushImpact(spot+Vector3.new(0,.3,0),"cyclone",true,{owner=a.id,fighter=a.fighterId,phase="rise",radius=radius,zone=z.id})
		local victim=a.target
		if not victim or victim.health&lt;=0 or victim.invulnerableUntil&gt;c.now or not Zones.inside(z,victim.root.Position) then return end
		c.damageTag="Rising Whirlwind";c.hitOrigin=spot+Vector3.new(0,3,0)
		local hit=c:damage(a,victim,spec.Damage,false,false)
		c.hitOrigin=nil;c.damageTag=nil
		if c.match.phase~="Duel" or not hit or victim.impactStyle=="block" then return end
		Brawler.react(c,victim,"Launched",Vector3.new(0,spec.Lift or 50,0),1.1,a)
		Brawler.event(c,a,"CycloneHit")
	end)
end

-- ---------------------------------------------------------------- the fan
-- The release of a gust: everything in the cone at that frame.
function Gale.blow(c,a,infused)
	local tune=a.def.Gust
	local on=awake(c,a)
	local reach=tune.Range*(if infused then tune.Infused or 1 else 1)*(if on then on.GustReach or 1 else 1)
	local cos=tune.Cone or .8
	local look=flatUnit(a.root.CFrame.LookVector)
	local sent=sweep(c,a,reach,cos,true)
	local b=a.target
	if b and b.health&gt;0 and b.invulnerableUntil&lt;=c.now and (b.rotationUntil or 0)&lt;=c.now and not b.groundPose
		and inCone(a,b.root.Position,reach,cos) and c:lineOfSight(a,b) then
		local away=flatUnit(b.root.Position-a.root.Position,look)
		if b.state=="Guarding" then Motor.travel(b,c,away,tune.GuardPush or 2)
		else
			Brawler.react(c,b,"Knockback",away*(tune.Push or 34)+Vector3.new(0,8,0),.4,a)
			Brawler.event(c,a,"GustPush")
		end
	end
	if infused or (on and on.GustLane) then lane(c,a,a.root.Position+look*2,look,reach,tune.Lane or 3,tune.LaneLife or 2.6) end
	c:pushImpact(a.root.Position+look*2.5,"gust",infused~=nil,{owner=a.id,fighter=a.fighterId,direction=look,range=reach,sent=sent,infusion=infused and infused.infusion})
	if sent&gt;0 then c:cue(a,"GUST • "..sent.." SENT BACK",.6);Brawler.event(c,a,"GustReturn") end
end
-- The tool button (Fighters.Gale.Gust): the fan swung like a throw (the legs
-- keep moving, a hit cancels it before the release). Free inside a clean
-- string (away + tool there also hops her back); with the chakra modifier a
-- Wind infusion (ChakraTuning WindFan): further, and a short lane stays.
function Gale.gust(c,a,chakra,aim)
	local tune=a.def.Gust
	if not tune then return false,"No tool" end
	if a.throwing then return false,"Throwing" end
	if a.reaction or a.wall then return false,"Committed" end
	local chainCancel=a.def.ComboToolCancel and a.state=="Recovery" and a.chainOpen and c.now&gt;=(a.chainAt or 0)
	if (not chainCancel and not Rules.canAct(a,c.now)) or c.now&lt;(a.neutralToolAt or 0) then return false,"Tool recovering" end
	local infused=nil
	if chakra then
		local Chakra=require(script.Parent.ChakraCombat)
		local why
		infused,why=Chakra.plan(c,a,"Fan")
		if not infused then Chakra.refuse(c,a);return false,why end
		local cost=Chakra.cost(infused,chainCancel)
		if a.chakra&lt;cost then Chakra.refuse(c,a);return false,"Need chakra" end
		a.chakra-=cost
		Chakra.record(c,"Infuse",infused.rules,{owner=a.id,object="Fan",infusion=infused.infusion,mode="gust"})
	elseif not chainCancel then
		if a.chakra&lt;Config.ToolCost then return false,"Need chakra" end
		a.chakra-=Config.ToolCost
	end
	local back=chainCancel and Brawler.intent(a)=="back"
	if chainCancel then a.pending=nil;a.attackName=nil;a.chainOpen=false;c:setState(a,"Neutral",0);Brawler.event(c,a,"ChainTool") end
	if a.state=="Guarding" then Defense.guard(a,false,c.now);c:setState(a,"Neutral",0) end
	if back and a.target then
		a.hop={direction=flatUnit(a.root.Position-a.target.root.Position,-a.root.CFrame.LookVector),remaining=tune.Hop or 6,speed=40}
		Brawler.event(c,a,"Disengage")
	end
	a.neutralToolAt=c.now+(if chainCancel then .45 else tune.Recover or .7)
	c:beginThrow(a,{kind="Gust",release=tune.Release or .1,count=1,aim=aim,fire=function() Gale.blow(c,a,infused) end})
	c:cue(a,if infused then "WIND GUST • LANE" else "GUST",.5)
	Brawler.event(c,a,"Gust")
	return true
end

-- ------------------------------------------------------------ the wind step
-- E outside a chase window (MoveGraphs.Gale.reengage.reposition): back to her
-- range on the wind. Close in, out at an angle; far, in to `keep` studs (never
-- into melee); at range, a step aside that changes her lanes' angle. Same
-- price, cooldown and Rush state as the shared chakra dash (its motion and
-- arrival are Combat's), so it can be read and punished the same way.
function Gale.reposition(c,a,style)
	local tune=Config.Rush
	local cancel=a.state=="Recovery" and c.now&gt;=(a.recoveryCancelAt or math.huge)
	if not Rules.canAct(a,c.now) and not cancel then return false,"Committed" end
	if a.airborne or a.wall or a.reaction then return false,"No chakra dash" end
	if a.chakra&lt;Config.PursuitCost then return false,"Need chakra" end
	if c.now&lt;(a.rushReadyAt or 0) then return false,"Cooldown" end
	local b=a.target
	if not b then return false,"No target" end
	local look=flatUnit(a.root.CFrame.LookVector)
	local gap=flat(b.root.Position-a.root.Position).Magnitude
	local toward=flatUnit(b.root.Position-a.root.Position,look)
	local right=toward:Cross(Vector3.yAxis)
	local dir,stickSide=Brawler.classify(a,a.move or Vector3.zero)
	local side=if dir=="side" then stickSide else (a.rushSide or 1)
	a.rushSide=-side
	local keep=style.keep or 17
	local line,distance,mode
	if a.locked==false then
		local stick=flat(a.move or Vector3.zero)
		line=if stick.Magnitude&gt;.2 then stick.Unit else look;distance=tune.Reposition;mode="step"
	elseif gap&gt;keep+4 then
		line=toward;distance=math.min(gap-keep,style.reach or 22);mode="in"
	elseif gap&lt;keep-4 then
		-- Out at an angle, to `keep` studs from the body.
		local rad=math.rad(style.angle or 30)
		line=(-toward*math.cos(rad)+right*side*math.sin(rad)).Unit
		local along=gap*line:Dot(toward)
		distance=math.clamp(along+math.sqrt(math.max(0,along*along-gap*gap+keep*keep)),6,style.reach or 22)
		mode="out"
	else
		line=right*side;distance=style.side or 10;mode="aside"
	end
	if cancel then a.pending=nil end
	a.chakra-=Config.PursuitCost
	a.rushReadyAt=c.now+tune.Cooldown
	a.pending=nil;a.attackName=nil;a.guardHeld=false;a.chainOpen=false
	Brawler.breakString(a,false)
	local speed=tune.Speed*(style.speed or 1)
	local goal=c:clamp(a.root.Position+line*distance)
	local duration=math.clamp(distance/speed+.12,.12,tune.MaxTime*(style.time or 1))
	c:setState(a,"Rush",duration)
	a.rush={style=style,speed=speed,arrive=0,recovery=style.recovery or tune.Recovery,from=a.root.Position,line=line,goal=goal,reposition=mode}
	a.rushArriveUntil=c.now+duration+tune.Arrive
	Brawler.event(c,a,"Rush");Brawler.event(c,a,"Reengage");Brawler.event(c,a,"WindStep")
	c:pushImpact(a.root.Position,"chase",false,{owner=a.id,fighter=a.fighterId,variant=style.name,mode="dash",to=goal,reposition=mode})
	c:cue(a,"WIND STEP",.4)
	return true
end

-- ------------------------------------------------------------ air and route
-- The glide (Fighters.Gale.Glide): jump held in the air, the open fan holds
-- her up (the fall is capped). Free bodies only: an attack, a reaction, a
-- dash or a hover window own their own motion.
function Gale.glide(c,a,_dt,now)
	local g=a.def.Glide
	if not g then return end
	local on=a.jumpHeld==true and a.airborne and not a.reaction and not a.wall and a.state=="Neutral" and (a.airHold or 0)&lt;=now
	if on then
		local v=a.root.AssemblyLinearVelocity
		if v.Y&lt;-g.Fall then a.root.AssemblyLinearVelocity=Vector3.new(v.X,-g.Fall,v.Z) end
		if not a.gliding then a.gliding=true;Brawler.event(c,a,"Glide") end
	else a.gliding=nil end
end
-- The Updraft route (onRoute "updraft"): the scooped body is held up by a
-- column of rising air, in reach of the wind instead of a chase.
function Gale.updraft(c,a,b,_p)
	local z=Zones.add(c,a,"Updraft",{origin=Vector3.new(b.root.Position.X,c.match.origin.Y,b.root.Position.Z),radius=4.6,life=2})
	c:pushImpact(b.root.Position,"cyclone",false,{owner=a.id,fighter=a.fighterId,phase="updraft",radius=4.6,zone=z.id})
	c:cue(a,"UPDRAFT • KAMAITACHI OR GUST",1)
	Brawler.event(c,a,"UpdraftHold")
end

-- --------------------------------------------------------------- awakening
-- Kuchiyose: Kirikiri Mai (Combat:awaken, Techniques.awakenHooks): Kamatari
-- cuts across the arena at the opponent, a big wind projectile that knocks
-- down and lays a long lane. The rest of the rules are read where they apply
-- (lane, Gale.blow, Gale.fanOpen).
function Gale.summon(c,a)
	local tune=a.def.Awakening
	local s=tune and tune.Summon
	if not s then return end
	local b=a.target
	local look=flatUnit(a.root.CFrame.LookVector)
	local toward=if b then flatUnit(b.root.Position-a.root.Position,look) else look
	local origin=a.root.Position+toward*2+Vector3.new(0,.6,0)
	local p=c:projectile(a,origin+toward*s.Range,s.Speed,s.Range,s.Damage,"kamatari",nil,
		{origin=origin,radius=s.Radius,growth=0,reaction="Knockdown",impulse=Vector3.new(0,16,34),stun=.8,style="jutsu",heavy=true,breaksShield=true})
	lane(c,a,origin,toward,s.Range,s.Lane or 4.5,s.LaneLife or 6,p)
	c:cue(a,"KUCHIYOSE • KIRIKIRI MAI",1.2)
	Brawler.event(c,a,"Kamatari")
end

function Gale.install(T)
	T.Kamaitachi={check=Gale.fanOpen,execute=kamaitachi}
	T.GreatGust={check=Gale.fanOpen,execute=greatGust}
	T.Cyclone={check=Gale.fanOpen,execute=cyclone}
	T.Tools=T.Tools or {};T.Tools.Gust=Gale.gust
	T.payoffs=T.payoffs or {};T.payoffs.updraft=Gale.updraft
	T.awakenHooks=T.awakenHooks or {};table.insert(T.awakenHooks,Gale.summon)
	T.actorSteps=T.actorSteps or {};table.insert(T.actorSteps,Gale.glide)
	T.reposition=Gale.reposition
end
return Gale
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND64">
        <Properties>
          <string name="Name">Legion</string>
          <ProtectedString name="Source">-- Naruto Uzumaki (roster wave: Part I, the Chunin Exam to the Valley of the
-- End, 13). The shadow clones on the shared Bodies component: how a clone
-- behaves (at his side, out on a flank, in the Uzumaki Barrage, shaping the
-- Rasengan), his jutsu (Shadow Clone, Rasengan, Multi Shadow Clone), the
-- transformed kunai, and the Nine-Tails chakra that takes the clones away
-- (Bodies.blocked: the cloak has claws instead). Installed into Techniques
-- by its last line, like a client identity layer into Effects.
-- Sheet: docs/characters/NARUTO.md; report: docs/reports/convergence3/NARUTO.md.
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Attacks=require(Shared.Attacks)
local Bodies=require(script.Parent.Bodies)
local Legion={}
local CLONE="clone"
local JAB,KICK=Attacks.CloneJab,Attacks.BarrageKick
local function flat(v) return Vector3.new(v.X,0,v.Z) end
local function brawler() return require(script.Parent.Brawler) end
local function tune(a) return Bodies.tuning(a,CLONE) end
local function rightOf(a)
	local right=flat(a.root.CFrame.RightVector)
	return if right.Magnitude&gt;.1 then right.Unit else Vector3.xAxis
end
-- Clones come out on alternate sides of him.
local function nextSide(a)
	a.cloneSide=-(a.cloneSide or -1)
	return a.cloneSide
end
local function aside(c,a,side,distance)
	local p=a.root.Position+rightOf(a)*side*(distance or 2.8)
	return Vector3.new(p.X,c.match.origin.Y+3,p.Z)
end
-- The opponent is open to a clone's jab: not swinging, not in a reaction, not
-- under wake-up cover.
local function open(c,b)
	if b.health&lt;=0 or b.reaction or b.groundPose or (b.invulnerableUntil or 0)&gt;c.now then return false end
	return b.state=="Neutral" or b.state=="Guarding" or b.state=="Recovery" or b.state=="TechniqueRecovery" or b.state=="Stunned"
end
-- Persistent clones ---------------------------------------------------------
-- "guard": at his side (a decoy for blades, a partner for the swap and the
-- Rasengan) until the opponent comes close; "flank": out to the opponent's
-- side, a jab (Attacks.CloneJab, judged from the clone) whenever the opponent
-- is open; when Naruto dashes in, a flanking clone rushes the other side.
local function jab(c,body,b)
	local t=c.now-body.actionAt
	if body.state=="Startup" and t&gt;=JAB.startup then
		body.state="Active"
		local reach=tune(body.owner).Reach or 5.4
		if Bodies.hitFrom(c,body,b,{damage=tune(body.owner).Strike or 4,reach=reach+.8,arc=.2,reaction="HitStun",push=10,up=3,stun=JAB.stun,tag="Shadow Clone"}) then
			brawler().event(c,body.owner,"CloneJab")
		end
	elseif body.state=="Active" and t&gt;=JAB.startup+JAB.active then body.state="Recovery"
	elseif body.state=="Recovery" and t&gt;=JAB.startup+JAB.active+JAB.recovery then body.state="Neutral";body.action=nil end
end
local function persistent(c,body,dt)
	local a=body.owner
	local b=a.target
	if not b or b.health&lt;=0 then return end
	local gap=flat(b.root.Position-body.position).Magnitude
	if body.state~="Neutral" then
		jab(c,body,b)
		if body.alive then Bodies.face(body,b.root.Position) end
		return
	end
	if body.mode=="guard" and gap&lt;=12 then body.mode="flank" end
	local goal,speed
	if body.mode=="guard" then
		-- At his side, keeping pace with him even at a sprint.
		goal,speed=aside(c,a,body.side,2.8),math.max(28,(a.locomotion and a.locomotion.Magnitude or 0)*1.25)
	else
		-- Out on the opponent's flank, off the line between the two of them.
		local line=flat(a.root.Position-b.root.Position)
		line=if line.Magnitude&gt;.1 then line.Unit else flat(-b.root.CFrame.LookVector).Unit
		local angle=body.side*100
		speed=if body.rush then 50 else 38
		if a.state=="Rush" and a.rush then
			-- The pincer: Naruto comes in on one angle, the clone on the other.
			if not body.pincer then body.pincer=true;body.nextStrike=c.now+.08 end
			angle=-(a.rush.side or body.side)*70;speed=80
		else body.pincer=nil end
		local around=CFrame.fromAxisAngle(Vector3.yAxis,math.rad(angle)):VectorToWorldSpace(line)
		goal=b.root.Position+around*4.2
		goal=Vector3.new(goal.X,c.match.origin.Y+3,goal.Z)
	end
	Bodies.move(c,body,goal,speed,dt)
	Bodies.face(body,b.root.Position)
	local reach=tune(a).Reach or 5.4
	if body.mode=="flank" and c.now&gt;=body.nextStrike and gap&lt;=reach and open(c,b) then
		body.rush=nil
		body.state="Startup";body.action="CloneJab";body.variant=nil;body.actionAt=c.now;body.actionSerial+=1
		-- A clone's rhythm: not the same beat twice in a row.
		body.nextStrike=c.now+(tune(a).Every or 1.9)*(.85+((body.id*7+body.actionSerial*3)%5)*.1)
	end
end
-- Uzumaki Barrage clones: they burst out beside the launched body, kick it
-- higher ("U-ZU-MA-") and puff away; Naruto brings the last word down.
local function barrage(c,body,dt)
	local b=body.owner.target
	if not b or b.health&lt;=0 then return end
	local around=CFrame.fromAxisAngle(Vector3.yAxis,math.rad(body.angle or 0)):VectorToWorldSpace(body.line or Vector3.new(0,0,-1))
	local goal=b.root.Position+around*2.3-Vector3.new(0,1.1,0)
	body.position=c:clamp(body.position:Lerp(goal,math.min(1,dt*18)))
	Bodies.face(body,b.root.Position)
	if body.state=="Startup" and c.now&gt;=body.actionAt+KICK.startup then
		body.state="Active"
		if Bodies.hitFrom(c,body,b,{damage=KICK.damage,reach=4.8,height=6,arc=-1,reaction="Juggled",push=2,up=22,stun=KICK.stun,tag="Uzumaki Barrage"}) then
			brawler().event(c,body.owner,"BarrageKick")
			c:pushImpact(b.root.Position,"uzumaki",false,{owner=body.owner.id,fighter=body.owner.fighterId,syllable=body.syllable})
		end
	elseif body.state=="Active" and c.now&gt;=body.actionAt+KICK.startup+KICK.active then body.state="Recovery" end
end
-- The Rasengan's helper: beside his right hand, shaping the sphere in his
-- palm until the release (or until it is struck: the jutsu falls apart).
local function shape(c,body,dt)
	local a=body.owner
	local p=body.shaping
	if not p or a.pending~=p or a.health&lt;=0 then
		body.shaping=nil;body.cast=nil;body.mode="spent";body.state="Recovery"
		body.expires=math.min(body.expires,c.now+.2)
		return
	end
	local fwd=flat(a.root.CFrame.LookVector)
	fwd=if fwd.Magnitude&gt;.1 then fwd.Unit else Vector3.new(0,0,-1)
	local right=rightOf(a)
	local goal=a.root.Position+right*1.9+fwd*.7
	Bodies.move(c,body,Vector3.new(goal.X,c.match.origin.Y+3,goal.Z),60,dt)
	body.look=-right;body.cast="RasenganShape";body.state="Neutral"
end
-- A clone struck while it shapes the Rasengan: the technique falls apart
-- (the chakra is spent, the cooldown runs, a short recovery to punish).
local function lost(c,body,why,by)
	local a=body.owner
	local p=body.shaping
	if p and a.pending==p and a.state=="TechniqueChannel" and (why=="hit" or why=="blade" or why=="area") then
		a.pending=nil;c:setState(a,"Recovery",.4)
		c:pushImpact(a.root.Position,"rasengan",false,{phase="broken",owner=a.id,fighter=a.fighterId})
		c:cue(a,"RASENGAN • THE CLONE WAS BROKEN",.9)
		if by then c:cue(by,"CLONE BROKEN • NO RASENGAN",.8) end
		brawler().event(c,a,"RasenganBroken")
	end
end
-- The kunai transformed back into a clone near the target (the chakra chord
-- on his tool): it lands on the opponent's flank and strikes at once.
local function kunaiClone(c,p)
	local a=p.a
	local b=a.target
	local at=Vector3.new(p.position.X,c.match.origin.Y+3,p.position.Z)
	local line=flat(a.root.Position-b.root.Position)
	local side=if line.Magnitude&gt;.1 and line.Unit:Cross(Vector3.yAxis):Dot(flat(at-b.root.Position))&gt;=0 then 1 else -1
	local body=Bodies.spawn(c,a,{kind=CLONE,position=at,mode="flank",side=side,delay=0})
	if body then
		-- It pops where the kunai was and hops onto the flank before it strikes.
		body.rush=true;body.nextStrike=c.now+.16
		c:cue(a,"TRANSFORMATION • CLONE",.6)
		brawler().event(c,a,"CloneKunai")
	end
end
-- The Uzumaki Barrage (route payoff of the launcher route UzumakiKick): two
-- more clones keep the body up, and the heavy after the chase is his own
-- finisher (MoveGraphs.Legion.airFinisher: NARUTO UZUMAKI RENDAN).
local function uzumaki(c,a,b,p)
	a.lionUntil=c.now+2.1
	c:cue(a,"U-ZU-MA-KI • E, THEN HEAVY: NARUTO RENDAN",1)
	brawler().event(c,a,"UzumakiBarrage")
	c:pushImpact(b.root.Position,"uzumaki",false,{owner=a.id,fighter=a.fighterId,syllable="U"})
	local line=flat(a.root.Position-b.root.Position)
	line=if line.Magnitude&gt;.1 then line.Unit else Vector3.new(0,0,-1)
	local syllables={"ZU","MA"}
	for k,angle in {125,-125} do
		c:schedule(c.now+.12+k*.18,function()
			if a.health&lt;=0 or b.health&lt;=0 or c.match.phase~="Duel" or not (b.reaction=="Launched" or b.reaction=="Juggled") then return end
			local around=CFrame.fromAxisAngle(Vector3.yAxis,math.rad(angle)):VectorToWorldSpace(line)
			local body=Bodies.spawn(c,a,{kind=CLONE,position=b.root.Position+around*2.3-Vector3.new(0,1.1,0),ephemeral=true,life=.42,
				mode="barrage",airborne=true,state="Startup",action="BarrageKick"})
			if body then body.line=line;body.angle=angle;body.syllable=syllables[k] end
		end)
	end
end
function Legion.install(Techniques)
	Bodies.controllers.guard=persistent
	Bodies.controllers.flank=persistent
	Bodies.controllers.barrage=barrage
	Bodies.controllers.shape=shape
	Bodies.onDispel[CLONE]=lost
	Bodies.transforms[CLONE]=kunaiClone
	brawler().payoffs.uzumaki=uzumaki
	-- Kage Bunshin: one clone at his side (two at most). Near the opponent it
	-- goes straight out to a flank.
	local function canClone(c,a)
		if Bodies.blocked(c,a) then c:cue(a,"NINE-TAILS CHAKRA • NO CLONES",.6);return false end
		if Bodies.count(c,a,CLONE)&gt;=(tune(a).Max or 2) then c:cue(a,"TWO CLONES AT MOST",.6);return false end
		return true
	end
	Techniques.ShadowClone={
		check=canClone,
		execute=function(c,a)
			local side=nextSide(a)
			local b=a.target
			local near=b~=nil and b.health&gt;0 and (b.root.Position-a.root.Position).Magnitude&lt;=16
			local body=Bodies.spawn(c,a,{kind=CLONE,position=aside(c,a,side),mode=if near then "flank" else "guard",side=side,delay=.3})
			if not body then return end
			c:cue(a,"SHADOW CLONE • "..Bodies.count(c,a,CLONE).." / "..(tune(a).Max or 2),.7)
			brawler().event(c,a,"ShadowClone")
		end,
	}
	-- Tajū Kage Bunshin: clones burst out on both sides at once and charge
	-- (only with none out: it always makes the pair).
	Techniques.MassShadowClone={
		check=function(c,a)
			if not canClone(c,a) then return false end
			if Bodies.count(c,a,CLONE)&gt;0 then c:cue(a,"CLONES ALREADY OUT",.6);return false end
			return true
		end,
		execute=function(c,a)
			local made=0
			for _,side in {1,-1} do
				local body=Bodies.spawn(c,a,{kind=CLONE,position=aside(c,a,side,3.2),mode="flank",side=side,delay=.2})
				if body then body.rush=true;made+=1 end
			end
			c:cue(a,"MULTI SHADOW CLONE",.8)
			if made&gt;0 then brawler().event(c,a,"MassShadowClone") end
		end,
	}
	-- Rasengan, Part I: he cannot shape it alone. A free clone comes to his
	-- side and shapes it through the channel; with none he makes one for it
	-- (CloneCost more chakra, a longer channel). Striking that clone breaks
	-- the jutsu. In the Nine-Tails cloak: no clone, almost no wind-up.
	Techniques.CloneRasengan={
		check=function(c,a,spec)
			if Bodies.blocked(c,a) or Bodies.free(c,a,CLONE) then return true end
			return a.chakra&gt;=spec.Cost+(spec.CloneCost or 12)
		end,
		start=function(c,a,pending)
			local spec=table.clone(pending.spec);pending.spec=spec
			-- (A channel lengthened elsewhere, the tutorial's interrupt step, stays long.)
			if Bodies.blocked(c,a) then
				spec.Channel=math.min(spec.Channel,spec.CloakChannel or .2);pending.cloak=true
				c:cue(a,"NINE-TAILS RASENGAN",.6)
			else
				local body=Bodies.free(c,a,CLONE)
				if body then
					c:cue(a,"RASENGAN • THE CLONE SHAPES IT",spec.Channel)
				else
					a.chakra=math.max(0,a.chakra-(spec.CloneCost or 12))
					spec.Channel=math.max(spec.Channel,spec.SoloChannel or .6)
					body=Bodies.spawn(c,a,{kind=CLONE,position=aside(c,a,1,1.9),ephemeral=true,life=spec.Channel+1})
					c:cue(a,"RASENGAN • A CLONE FOR IT",spec.Channel)
				end
				if body then body.mode="shape";body.shaping=pending;body.cast="RasenganShape";body.expires=math.max(body.expires,c.now+spec.Channel+1);pending.shaper=body end
			end
			a.untilTime=c.now+spec.Channel
		end,
		execute=function(c,a,pending)
			local shaper=pending.shaper
			if shaper and not shaper.alive then return end
			local Brawler=brawler()
			Brawler.start(c,a,"DashAttack")
			local p=a.pending
			if not p then return end
			p.spec=table.clone(p.spec)
			p.spec.damage=pending.spec.Damage;p.spec.travel=10;p.spec.recovery=.45
			p.spec.reaction="Knockback";p.spec.impulse=Vector3.new(0,22,74);p.spec.stun=.62
			p.rasengan=true;a.travelRemaining=10
			-- (One variant: the client draws it red in the cloak.)
			a.attackVariant="Rasengan"
			c:pushImpact(a.root.Position,"burst",false,{owner=a.id,fighter=a.fighterId,cloak=pending.cloak})
			Brawler.event(c,a,"Rasengan")
		end,
	}
end
return Legion
</ProtectedString>
