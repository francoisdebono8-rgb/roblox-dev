	smokePuff=smokePuff,floorUnder=floorUnder,anchorPart=anchorPart,weldAll=weldAll,num=num,seq=seq,TEX=TEX,SOUND=SOUND,BUILD=BUILD})
return FX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND132">
          <Properties>
            <string name="Name">FamilyFX</string>
            <ProtectedString name="Source">-- Family objects seen in play (roster breadth pass): every projectile kind of
-- Shared/Looks gets a real model (never the kunai fallback), its flight pose,
-- its contact burst and, for zones, a ground look; buffs, counter stances,
-- drains and slows show on the bodies. Installed by Effects like SandFX.
local Debris=game:GetService("Debris")
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Looks=require(Shared.Looks)
local Fighters=require(Shared.Fighters)
local FamilyFX={}
-- Studio/test switch: drawing errors surface instead of being swallowed.
FamilyFX.strict=false

local function c3(t) return Color3.fromRGB(t[1],t[2],t[3]) end

function FamilyFX.install(FX,kit)
	local new,block,tween,sound,flash,shockRing,burst,smokePuff,sparks=kit.new,kit.block,kit.tween,kit.sound,kit.flash,kit.shockRing,kit.burst,kit.smokePuff,kit.sparks
	local num,seq,TEX,SOUND,BUILD,weldAll,floorUnder,anchorPart=kit.num,kit.seq,kit.TEX,kit.SOUND,kit.BUILD,kit.weldAll,kit.floorUnder,kit.anchorPart

	-- An ellipsoid of the given size (a Ball part stays round at its smallest
	-- side, which turned every beast into a small brown ball in Studio).
	local function ball(model,size,cf,color,material,transparency)
		local p=block(model,size,cf,color,material or Enum.Material.SmoothPlastic)
		p.Transparency=transparency or 0
		new("SpecialMesh",{MeshType=Enum.MeshType.Sphere},p)
		return p
	end
	local function trail(root,width,color,lifetime)
		if width&lt;=0 then return end
		local a0=new("Attachment",{Position=Vector3.new(0,width*.5,.2)},root)
		local a1=new("Attachment",{Position=Vector3.new(0,-width*.5,.2)},root)
		new("Trail",{Attachment0=a0,Attachment1=a1,Color=ColorSequence.new(color),Lifetime=lifetime or .18,LightEmission=.4,
			Transparency=num({{0,.35},{1,1}}),WidthScale=num({{0,1},{1,.2}}),FaceCamera=true},root)
	end
	local function glow(root,color,brightness,range)
		if brightness&gt;0 then new("PointLight",{Color=color,Brightness=brightness,Range=range or 9,Shadows=false},root) end
	end
	local function spray(root,color,rate,size,speed)
		local at=new("Attachment",{},root)
		return new("ParticleEmitter",{Texture=TEX.smoke,Rate=rate,Lifetime=NumberRange.new(.25,.5),Speed=NumberRange.new(speed or 2,(speed or 2)*2),
			SpreadAngle=Vector2.new(40,40),EmissionDirection=Enum.NormalId.Back,Color=ColorSequence.new(color),LightInfluence=.4,
			Size=num({{0,size},{1,size*2.4}}),Transparency=num({{0,.35},{1,1}}),Drag=4,Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-60,60)},at)
	end

	-- One builder per shape. Every model is welded to an anchored root that the
	-- flight pose moves; sizes come from the look ({width, height, length}).
	local SHAPES={}
	SHAPES.orb=function(look)
		local m=new("Model",{Name="FamilyOrb"})
		local s=look.size
		local core=ball(m,Vector3.new(s[1]*.55,s[2]*.55,s[3]*.55),CFrame.new(),c3(look.color2),Enum.Material.Neon,.05)
		local shell=ball(m,Vector3.new(s[1],s[2],s[3]),CFrame.new(),c3(look.color),Enum.Material.Glass,.45)
		weldAll(core,{shell});m.PrimaryPart=core
		glow(core,c3(look.color),look.light)
		trail(core,look.trail,c3(look.color))
		spray(core,c3(look.color),30,s[1]*.35)
		return m
	end
	SHAPES.needle=function(look)
		local m=new("Model",{Name="FamilyNeedle"})
		local s=look.size
		local shaft=block(m,Vector3.new(s[1],s[2],s[3]),CFrame.new(),c3(look.color),Enum.Material.Metal)
		local tip=block(m,Vector3.new(s[1]*.6,s[2]*.6,s[3]*.25),CFrame.new(0,0,-s[3]*.6),c3(look.color2),Enum.Material.Metal)
		weldAll(shaft,{tip});m.PrimaryPart=shaft
		trail(shaft,math.max(look.trail,.08),c3(look.color),.08)
		return m
	end
	SHAPES.blade=function(look)
		local m=new("Model",{Name="FamilyBlade"})
		local s=look.size
		local glass=look.hit=="shatter"
		local body=block(m,Vector3.new(s[1],s[2],s[3]),CFrame.new(),c3(look.color),if glass then Enum.Material.Glass else Enum.Material.SmoothPlastic)
		body.Transparency=if glass then .25 else 0
		local edge=block(m,Vector3.new(s[1]*.5,s[2]*.5,s[3]*.4),CFrame.new(0,0,-s[3]*.55),c3(look.color2),if glass then Enum.Material.Ice else Enum.Material.SmoothPlastic,"WedgePart")
		edge.CFrame=CFrame.new(0,0,-s[3]*.6)*CFrame.Angles(math.rad(90),0,0)
		weldAll(body,{edge});m.PrimaryPart=body
		glow(body,c3(look.color),look.light,6)
		trail(body,math.max(look.trail,.1),c3(look.color),.12)
		return m
	end
	SHAPES.wave=function(look)
		local m=new("Model",{Name="FamilyWave"})
		local s=look.size
		local root=block(m,Vector3.new(s[1]*.4,s[2]*.4,s[3]*.4),CFrame.new(),c3(look.color),Enum.Material.SmoothPlastic)
		root.Transparency=1
		local parts={}
		for i=-2,2 do
			local h=s[2]*(1-math.abs(i)*.18)
			local p=ball(m,Vector3.new(s[1]*.32,h,s[3]),CFrame.new(i*s[1]*.18,h*.5-s[2]*.2,math.abs(i)*.35),c3(if math.abs(i)==2 then look.color2 else look.color),Enum.Material.Slate)
			table.insert(parts,p)
		end
		weldAll(root,parts);m.PrimaryPart=root
		local e=spray(root,c3(look.color),50,s[1]*.25,4)
		e.EmissionDirection=Enum.NormalId.Top
		return m
	end
	SHAPES.beast=function(look)
		-- A creature read from its silhouette: a long body, the head raised
		-- forward with a pale snout and a dark nose, ears up, four legs and a
		-- tail for a hound; a dorsal and a tail fin, no legs, for a shark.
		local m=new("Model",{Name="FamilyBeast"})
		local s=look.size
		local w,h,l=s[1],s[2],s[3]
		local color,pale=c3(look.color),c3(look.color2)
		local dark=Color3.fromRGB(26,22,24)
		local water=look.zone=="water"
		local body=ball(m,Vector3.new(w*.8,h*.6,l*.64),CFrame.new(0,h*.08,0),color)
		local parts={}
		local function add(p) table.insert(parts,p);return p end
		add(ball(m,Vector3.new(w*.64,h*.34,l*.5),CFrame.new(0,-h*.1,-l*.02),pale))
		add(ball(m,Vector3.new(w*.62,h*.5,l*.3),CFrame.new(0,h*.34,-l*.4),color))
		add(ball(m,Vector3.new(w*.36,h*.24,l*.22),CFrame.new(0,h*.26,-l*.56),pale))
		add(ball(m,Vector3.new(w*.12,w*.1,w*.1),CFrame.new(0,h*.3,-l*.67),dark))
		for _,side in {-1,1} do
			add(ball(m,Vector3.new(w*.09,w*.09,w*.06),CFrame.new(side*w*.19,h*.46,-l*.52),dark))
		end
		if water then
			add(block(m,Vector3.new(w*.1,h*.55,l*.26),CFrame.new(0,h*.5,l*.02)*CFrame.Angles(0,math.pi,0),color,Enum.Material.SmoothPlastic,"WedgePart"))
			add(block(m,Vector3.new(w*.1,h*.7,l*.22),CFrame.new(0,h*.05,l*.46)*CFrame.Angles(0,math.pi,0),color,Enum.Material.SmoothPlastic,"WedgePart"))
			for _,side in {-1,1} do
				add(block(m,Vector3.new(w*.4,h*.06,l*.16),CFrame.new(side*w*.45,-h*.1,-l*.1)*CFrame.Angles(0,0,math.rad(side*-20)),color,Enum.Material.SmoothPlastic))
			end
		else
			for _,side in {-1,1} do
				add(block(m,Vector3.new(w*.12,h*.28,l*.08),CFrame.new(side*w*.17,h*.68,-l*.38),color,Enum.Material.SmoothPlastic,"WedgePart"))
				for _,z in {-.22,.22} do
					add(block(m,Vector3.new(w*.16,h*.46,w*.16),CFrame.new(side*w*.24,-h*.32,z*l),color,Enum.Material.SmoothPlastic))
				end
			end
			add(block(m,Vector3.new(w*.1,h*.12,l*.34),CFrame.new(0,h*.3,l*.42)*CFrame.Angles(math.rad(30),0,0),color,Enum.Material.SmoothPlastic))
		end
		weldAll(body,parts);m.PrimaryPart=body
		trail(body,look.trail,color,.2)
		if water then spray(body,color,40,w*.4,3) else spray(body,Color3.fromRGB(150,130,110),14,w*.3,2) end
		return m
	end
	SHAPES.serpent=function(look)
		local m=new("Model",{Name="FamilySerpent"})
		local s=look.size
		local head=ball(m,Vector3.new(s[1]*1.3,s[2]*1.1,s[1]*1.8),CFrame.new(),c3(look.color),Enum.Material.SmoothPlastic)
		local parts={}
		-- Segments are posed every frame along the path behind the head.
		for i=1,6 do
			local w=s[1]*(1-i*.11)
			local seg=ball(m,Vector3.new(w,w,w*1.6),CFrame.new(0,0,i*s[3]/7),c3(if i%2==0 then look.color2 else look.color),Enum.Material.SmoothPlastic)
			seg.Name="Segment"..i;seg.Anchored=true
			table.insert(parts,seg)
		end
		for _,side in {-1,1} do
			local eye=ball(m,Vector3.new(s[1]*.22,s[1]*.22,s[1]*.12),CFrame.new(side*s[1]*.4,s[2]*.25,-s[1]*.6),Color3.fromRGB(250,220,80),Enum.Material.Neon)
			eye.Anchored=false;eye.Massless=true
			new("WeldConstraint",{Part0=head,Part1=eye},head)
		end
		m.PrimaryPart=head
		glow(head,c3(look.color),look.light)
		if look.zone=="water" then spray(head,c3(look.color),50,s[1]*.5,4) end
		return m
	end
	SHAPES.swarm=function(look)
		local m=new("Model",{Name="FamilySwarm"})
		local s=look.size
		local root=block(m,Vector3.new(.4,.4,.4),CFrame.new(),c3(look.color),Enum.Material.SmoothPlastic)
		root.Transparency=1
		local at=new("Attachment",{},root)
		new("ParticleEmitter",{Texture=TEX.spark,Rate=180,Lifetime=NumberRange.new(.25,.5),Speed=NumberRange.new(2,5),SpreadAngle=Vector2.new(180,180),
			Color=ColorSequence.new(c3(look.color),c3(look.color2)),LightEmission=0,LightInfluence=1,Size=num({{0,.22},{1,.12}}),
			Transparency=num({{0,0},{1,.6}}),Acceleration=Vector3.zero,Drag=2,Shape=Enum.ParticleEmitterShape.Sphere},at).ShapeStyle=Enum.ParticleEmitterShapeStyle.Volume
		local cloud=new("ParticleEmitter",{Texture=TEX.smoke,Rate=24,Lifetime=NumberRange.new(.3,.6),Speed=NumberRange.new(1,2),SpreadAngle=Vector2.new(180,180),
			Color=ColorSequence.new(c3(look.color)),LightInfluence=1,Size=num({{0,s[1]*.5},{1,s[1]*.9}}),Transparency=num({{0,.6},{1,1}})},at)
		cloud.Name="Cloud"
		m.PrimaryPart=root
		return m
	end
	SHAPES.shadow=function(look)
		-- A flat dark tongue running over the floor: its tip is the object, the
		-- strip back to where it left is a beam laid on the ground.
		local m=new("Model",{Name="FamilyShadow"})
		local s=look.size
		local tip=block(m,Vector3.new(s[1],s[2],s[1]*1.4),CFrame.new(),c3(look.color),Enum.Material.SmoothPlastic)
		tip.Shape=Enum.PartType.Cylinder;tip.Size=Vector3.new(s[2],s[1]*1.2,s[1]*1.2)
		tip.Transparency=.1
		m.PrimaryPart=tip
		return m
	end
	SHAPES.boulder=function(look)
		local m=new("Model",{Name="FamilyBoulder"})
		local s=look.size
		local body=ball(m,Vector3.new(s[1],s[2],s[3]),CFrame.new(),c3(look.color),Enum.Material.SmoothPlastic)
		local band=block(m,Vector3.new(s[1]*1.02,s[2]*.2,s[3]*1.02),CFrame.new(),c3(look.color2),Enum.Material.SmoothPlastic)
		band.Shape=Enum.PartType.Cylinder;band.Size=Vector3.new(s[2]*.22,s[1]*1.02,s[3]*1.02)
		weldAll(body,{band});m.PrimaryPart=body
		spray(body,Color3.fromRGB(170,150,120),30,s[1]*.3,3)
		return m
	end
	FamilyFX.SHAPES=SHAPES

	for kind,look in Looks do
		if not BUILD[kind] and SHAPES[look.shape] then
			BUILD[kind]=function() return SHAPES[look.shape](look) end
		end
	end

	-- Flight poses (FX.poses): orient, roll and animate by shape.
	for kind,look in Looks do
		if FX.poses[kind] then continue end
		local shape=look.shape
		if shape=="needle" or shape=="blade" then
			FX.poses[kind]=function(_,entry,p,age,cf,dt)
				entry.spin+=dt*(if shape=="needle" then 6 else 2)
				return cf*CFrame.Angles(0,0,entry.spin)
			end
		elseif shape=="beast" then
			FX.poses[kind]=function(_,entry,p,age,cf)
				local bob=math.abs(math.sin(age*14))*.5
				local flatLook=Vector3.new(p.direction.X,0,p.direction.Z)
				local at=cf.Position+Vector3.new(0,bob,0)
				return if flatLook.Magnitude&gt;.05 then CFrame.lookAt(at,at+flatLook) else cf
			end
		elseif shape=="serpent" then
			FX.poses[kind]=function(_,entry,p,age,cf)
				local back=-p.direction
				local side=p.direction:Cross(Vector3.yAxis)
				side=if side.Magnitude&gt;.05 then side.Unit else Vector3.xAxis
				local length=look.size[3]
				for i=1,6 do
					local seg=entry.model:FindFirstChild("Segment"..i)
					if seg then
						local d=i*length/7
						local wave=math.sin(age*12-i*.9)*look.size[1]*.6
						local at=cf.Position+back*d+side*wave
						seg.CFrame=CFrame.lookAt(at,at-back)
					end
				end
				return cf*CFrame.new(math.sin(age*12)*look.size[1]*.3,0,0)
			end
		elseif shape=="swarm" then
			FX.poses[kind]=function(_,entry,p,age,cf)
				return cf*CFrame.new(math.sin(age*9)*.4,math.cos(age*7)*.3,0)
			end
		elseif shape=="shadow" then
			FX.poses[kind]=function(fx,entry,p,age,cf)
				-- Laid on the floor under the flight line; the strip follows.
				local floor=floorUnder(fx,cf.Position,3,10)
				local at=if floor then floor.Position+Vector3.new(0,.04,0) else cf.Position
				if not entry.strip then
					local start=anchorPart(entry.model,if floor then Vector3.new(p.origin.X,at.Y,p.origin.Z) else p.origin)
					local a0=new("Attachment",{CFrame=CFrame.Angles(0,0,math.rad(90))},start)
					local a1=new("Attachment",{CFrame=CFrame.Angles(0,0,math.rad(90))},entry.root)
					entry.strip=new("Beam",{Attachment0=a0,Attachment1=a1,Width0=look.size[1]*.7,Width1=look.size[1]*1.1,Color=ColorSequence.new(c3(look.color)),
						Transparency=num({{0,.25},{1,.05}}),FaceCamera=false,LightInfluence=1,Segments=1},entry.root)
				end
				return CFrame.new(at)*CFrame.Angles(0,0,math.rad(90))
			end
		elseif shape=="boulder" then
			FX.poses[kind]=function(_,entry,p,age,cf,dt)
				entry.spin+=dt*10
				return cf*CFrame.Angles(-entry.spin,0,0)
			end
		end
	end

	-- Contact bursts by look.
	local function hit(fx,look,position,heavy,normal)
		local color,edge=c3(look.color),c3(look.color2)
		local kind=look.hit
		local scale=if heavy then 1.4 else 1
		if kind=="splash" then
			burst(fx.folder,position,{Texture=TEX.smoke,Lifetime=NumberRange.new(.35,.7),Speed=NumberRange.new(12,22),SpreadAngle=Vector2.new(70,70),
				EmissionDirection=Enum.NormalId.Top,Acceleration=Vector3.new(0,-50,0),Color=seq({{0,Color3.fromRGB(235,248,255)},{1,color}}),LightEmission=.2,
				Size=num({{0,.9*scale},{1,2.2*scale}}),Transparency=num({{0,.1},{1,1}}),Drag=2},28)
			shockRing(fx.folder,position-Vector3.new(0,1.5,0),edge,2,9*scale,.35)
			sound(anchorPart(fx.folder,position),SOUND.land,.5,.7)
		elseif kind=="shatter" then
			burst(fx.folder,position,{Texture=TEX.spark,Lifetime=NumberRange.new(.3,.6),Speed=NumberRange.new(14,26),SpreadAngle=Vector2.new(180,180),
				Acceleration=Vector3.new(0,-40,0),Color=ColorSequence.new(color),LightEmission=.6,Size=num({{0,.6},{1,.1}}),Drag=3},24)
			flash(fx.folder,position,color,.6,3*scale,.18,.3)
		elseif kind=="sparks" then
			sparks(fx.folder,position,edge,10,16)
		elseif kind=="smoke" then
			smokePuff(fx.folder,position,color,16,1.8*scale)
		elseif kind=="crush" then
			smokePuff(fx.folder,position-Vector3.new(0,1.5,0),Color3.fromRGB(176,160,138),18,2.2*scale)
			shockRing(fx.folder,position-Vector3.new(0,2,0),edge,2,10*scale,.4)
			sound(anchorPart(fx.folder,position),SOUND.heavy,.5,.9)
		else
			flash(fx.folder,position,color,.8,4*scale,.2,.2)
			burst(fx.folder,position,{Texture=TEX.spark,Lifetime=NumberRange.new(.2,.4),Speed=NumberRange.new(10,20),SpreadAngle=Vector2.new(180,180),
				Color=ColorSequence.new(edge),LightEmission=1,Size=num({{0,.6},{1,0}}),Drag=4},16)
		end
	end

	-- Zones on the ground (hazards with a look): drawn while they last.
	local ZONES={}
	ZONES.mist=function(holder,h,look)
		return new("ParticleEmitter",{Texture=TEX.smoke,Rate=26,Lifetime=NumberRange.new(2.4,3.6),Speed=NumberRange.new(.5,1.5),SpreadAngle=Vector2.new(30,30),
			EmissionDirection=Enum.NormalId.Top,Shape=Enum.ParticleEmitterShape.Box,Color=ColorSequence.new(c3(look.color)),LightInfluence=1,
			Size=num({{0,8},{1,14}}),Transparency=num({{0,1},{.25,.45},{.75,.5},{1,1}}),Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-10,10)},holder)
	end
	ZONES.swarm=function(holder,h,look)
		return new("ParticleEmitter",{Texture=TEX.spark,Rate=140,Lifetime=NumberRange.new(.4,.9),Speed=NumberRange.new(2,6),SpreadAngle=Vector2.new(180,180),
			Shape=Enum.ParticleEmitterShape.Box,Color=ColorSequence.new(c3(look.color),c3(look.color2)),LightInfluence=1,
			Size=num({{0,.2},{1,.12}}),Transparency=num({{0,0},{1,.5}}),Drag=2},holder)
	end
	local function decal(holder,h,color,transparency,material)
		local disc=block(holder.Parent,Vector3.new(.08,h.radius*2,h.radius*2),CFrame.new(holder.Position)*CFrame.Angles(0,0,math.rad(90)),color,material or Enum.Material.SmoothPlastic)
		disc.Shape=Enum.PartType.Cylinder;disc.Transparency=1
		tween(disc,.3,{Transparency=transparency})
		return disc
	end
	ZONES.water=function(holder,h,look) local d=decal(holder,h,c3(look.color),.35,Enum.Material.Glass);d.Reflectance=.2;return nil,d end
	ZONES.ice=function(holder,h,look) local d=decal(holder,h,c3(look.color),.55,Enum.Material.Ice);return nil,d end
	ZONES.shadow=function(holder,h,look) local d=decal(holder,h,c3(look.color),.15);return nil,d end
	ZONES.mud=function(holder,h,look) local d=decal(holder,h,c3(look.color),.1,Enum.Material.Mud);return nil,d end
	ZONES.crater=function(holder,h,look) local d=decal(holder,h,Color3.fromRGB(96,78,60),.2,Enum.Material.Slate);return nil,d end
	ZONES.scorch=function(holder,h,look)
		local d=decal(holder,h,Color3.fromRGB(30,24,20),.3)
		local e=new("ParticleEmitter",{Texture=TEX.fire,Rate=30,Lifetime=NumberRange.new(.3,.6),Speed=NumberRange.new(2,5),EmissionDirection=Enum.NormalId.Top,
			Shape=Enum.ParticleEmitterShape.Box,Color=seq({{0,Color3.fromRGB(255,220,140)},{1,Color3.fromRGB(150,40,16)}}),LightEmission=1,LightInfluence=0,
			Size=num({{0,1},{1,.3}}),Transparency=num({{0,.2},{1,1}})},holder)
		return e,d
	end
	-- Bones out of the floor (Kimimaro's Dance of the Larch): a ring of spikes.
	ZONES.spikes=function(holder,h,look)
		local d=decal(holder,h,c3(look.color2),.6)
		for i=1,10 do
			local angle=i/10*math.pi*2
			local r=h.radius*(.45+.45*((i*7)%3)/2)
			local spike=block(holder.Parent,Vector3.new(.5,2.8,.5),CFrame.new(holder.Position+Vector3.new(math.cos(angle)*r,1.2,math.sin(angle)*r))*CFrame.Angles(math.rad(12*math.sin(angle)),0,math.rad(12*math.cos(angle))),c3(look.color),Enum.Material.SmoothPlastic)
			spike.Parent=d
		end
		return nil,d
	end
	-- A charge on the floor: a small lump of clay whose fuse glows, brighter
	-- once armed (Families.plant).
	-- A buried clay charge (QA-004 M5): posed, the fuse is dark; armed (the
	-- server's armedAt), it glows and a thin ring shows the trigger radius;
	-- consumed or expired, it goes with the hazard (detonation draws its blast).
	ZONES.charge=function(holder,h,look)
		local lump=block(holder.Parent,Vector3.new(.9,.5,.9),CFrame.new(holder.Position+Vector3.new(0,.25,0)),c3(look.color),Enum.Material.SmoothPlastic)
		new("SpecialMesh",{MeshType=Enum.MeshType.Sphere},lump)
		local fuse=block(lump,Vector3.new(.25,.25,.25),CFrame.new(holder.Position+Vector3.new(0,.6,0)),Color3.fromRGB(70,60,52),Enum.Material.SmoothPlastic)
		fuse.Name="Fuse"
		local light=new("PointLight",{Color=c3(look.color2),Brightness=0,Range=5,Shadows=false},fuse)
		local ring=block(lump,Vector3.new(.06,h.radius*2,h.radius*2),CFrame.new(holder.Position+Vector3.new(0,.05,0))*CFrame.Angles(0,0,math.rad(90)),c3(look.color2),Enum.Material.Neon)
		ring.Shape=Enum.PartType.Cylinder;ring.Transparency=1;ring.Name="TriggerRing"
		return nil,lump
	end
	FX.hazardUpdate=function(entry,h)
		if not h.charge or not entry.disc then return end
		local lump=entry.disc
		entry.chargeState=entry.chargeState or "posed"
		if h.charge=="armed" and entry.chargeState~="armed" then
			entry.chargeState="armed"
			local fuse=lump:FindFirstChild("Fuse")
			if fuse then fuse.Material=Enum.Material.Neon;fuse.Color=Color3.fromRGB(255,120,60);local l=fuse:FindFirstChildOfClass("PointLight");if l then l.Brightness=1.6 end end
			local ring=lump:FindFirstChild("TriggerRing")
			if ring then ring.Transparency=.85 end
		end
		-- Armed: a slow pulse (readable without F8, never a flashing light).
		if h.charge=="armed" then
			local fuse=lump:FindFirstChild("Fuse")
			local l=fuse and fuse:FindFirstChildOfClass("PointLight")
			if l then l.Brightness=1.2+math.sin(os.clock()*6)*.5 end
		end
	end
	FX.hazardBuild=function(fx,h)
		local look=Looks[h.look or ""]
		if not look then return nil end
		local draw=ZONES[look.zone or ""]
		if not draw then return nil end
		local floor=floorUnder(fx,h.position,3,14)
		local at=if floor then floor.Position+Vector3.new(0,.06,0) else h.position
		local holder=anchorPart(fx.folder,at);holder.Size=Vector3.new(h.radius*1.7,.2,h.radius*1.7)
		local e,disc=draw(holder,h,look)
		return {holder=holder,emitter=e,disc=disc,family=true}
	end
	FX.hazardFinish=function(entry)
		if entry.emitter then entry.emitter.Enabled=false end
		if entry.disc then tween(entry.disc,.4,{Transparency=1});Debris:AddItem(entry.disc,.5) end
		Debris:AddItem(entry.holder,3)
	end

	-- A body held by a family bind shows what holds it: beasts biting at the
	-- legs, coils round the torso, a pool of shadow, a swarm, or a sphere of
	-- the jutsu's substance (water prison). Anchored parts placed each frame.
	function FamilyFX.bindVisual(fx,model,root,look)
		local m=new("Model",{Name="FamilyBind"},fx.folder)
		local color,edge=c3(look.color),c3(look.color2)
		local feet=root.CFrame*CFrame.new(0,-2.5,0)
		if look.shape=="beast" then
			for _,side in {-1,1} do
				local b=SHAPES.beast(look)
				b.Name="BindBeast"
				-- Full size, flanking the legs, turned a little inward so each
				-- head reaches the shin from the front (facing the centre put the
				-- heads inside the legs in Studio).
				local cf=feet*CFrame.new(side*(.95+look.size[1]*.45),look.size[2]*.55-.3,.35)*CFrame.Angles(0,math.rad(side*-28),0)
				b.Parent=m;b:PivotTo(cf)
			end
		elseif look.shape=="serpent" then
			for k=1,3 do
				local ring=block(m,Vector3.new(.45,3.2,3.2),root.CFrame,if k%2==0 then edge else color,Enum.Material.SmoothPlastic)
				ring.Shape=Enum.PartType.Cylinder;ring.Name="BindCoil"
				ring:SetAttribute("Spin",1.5+k*.4);ring:SetAttribute("Y",-1.6+k*.9)
			end
		elseif look.shape=="shadow" then
			local pool=block(m,Vector3.new(.06,5.2,5.2),feet*CFrame.new(0,.05,0)*CFrame.Angles(0,0,math.rad(90)),color,Enum.Material.SmoothPlastic)
			pool.Shape=Enum.PartType.Cylinder;pool.Transparency=.15;pool.Name="BindShadow"
			for _,side in {-1,1} do
				local tendril=block(m,Vector3.new(.35,2.6,.35),feet*CFrame.new(side*.5,1.3,0),color,Enum.Material.SmoothPlastic)
				tendril.Transparency=.25;tendril.Name="BindShadow"
			end
		elseif look.shape=="swarm" then
			local core=block(m,Vector3.new(.2,.2,.2),root.CFrame,color,Enum.Material.SmoothPlastic);core.Transparency=1
			new("ParticleEmitter",{Texture=TEX.spark,Rate=200,Lifetime=NumberRange.new(.3,.6),Speed=NumberRange.new(3,6),SpreadAngle=Vector2.new(180,180),
				Shape=Enum.ParticleEmitterShape.Sphere,Color=ColorSequence.new(color,edge),LightInfluence=1,Size=num({{0,.2},{1,.12}})},new("Attachment",{},core))
		else
			local shell=block(m,Vector3.new(6,7,6),root.CFrame,color,Enum.Material.Glass);shell.Shape=Enum.PartType.Ball;shell.Transparency=.55;shell.Name="BindShell"
		end
		return m
	end
	-- Bodies: buff aura, counter stance ring, the dark of a slow.
	local auras=setmetatable({},{__mode="k"})
	local function auraOf(model)
		local st=auras[model]
		if st then return st end
		st={}
		auras[model]=st
		return st
	end
	local function fighterColor(actor)
		local def=Fighters[actor.fighterId or ""]
		return if def and def.Color then c3(def.Color) else Color3.fromRGB(220,220,255)
	end
	table.insert(FX.layers,{
		impact=function(fx,impact,folder)
			local style=impact.style
			-- A family relocation drawn in its own look (a mirror of ice, a swirl
			-- of mist, a body flicker), never Minato's yellow flash.
			if style=="teleport" and impact.kind and Looks[impact.kind] then
				local look=Looks[impact.kind]
				local color,edge=c3(look.color),c3(look.color2)
				local from,to=impact.from or impact.position,impact.to or impact.position
				smokePuff(fx.folder,from,color,14,2)
				flash(fx.folder,from,edge,1,4,.18,.3)
				smokePuff(fx.folder,to,color,10,1.6)
				flash(fx.folder,to,edge,1.5,6,.2,.2)
				shockRing(fx.folder,to-Vector3.new(0,2.6,0),color,2,10,.3)
				return true
			end
			if style=="look" then
				local look=Looks[impact.kind or ""] or Looks.chakra
				hit(fx,look,impact.position,impact.heavy,impact.normal)
				if impact.radius then shockRing(fx.folder,impact.position-Vector3.new(0,2.4,0),c3(look.color),2,impact.radius*2,.45) end
				return true
			elseif style=="zone" then
				local look=Looks[impact.kind or ""] or Looks.chakra
				shockRing(fx.folder,impact.position,c3(look.color2),2,(impact.radius or 8)*2,.5)
				smokePuff(fx.folder,impact.position+Vector3.new(0,1,0),c3(look.color),14,2.6)
				return true
			elseif style=="buff" then
				local model=folder and folder:FindFirstChild(impact.owner or "")
				local root=model and model:FindFirstChild("HumanoidRootPart")
				local color=Looks[impact.kind or ""] and c3(Looks[impact.kind].color) or Color3.fromRGB(255,240,200)
				flash(fx.folder,impact.position,color,2,9,.3,.4)
				shockRing(fx.folder,impact.position-Vector3.new(0,2.6,0),color,3,14,.5)
				if root then sound(root,SOUND.boom,.25,1.3) end
				return true
			elseif style=="stance" then
				local color=Looks[impact.kind or ""] and c3(Looks[impact.kind].color) or Color3.fromRGB(255,255,255)
				shockRing(fx.folder,impact.position-Vector3.new(0,2.6,0),color,7,3,impact.time or .6)
				return true
			elseif style=="drain" then
				local owner=folder and folder:FindFirstChild(impact.owner or "")
				local to=owner and owner:FindFirstChild("HumanoidRootPart")
				burst(fx.folder,impact.position,{Texture=TEX.glow,Lifetime=NumberRange.new(.3,.5),Speed=NumberRange.new(4,8),SpreadAngle=Vector2.new(60,60),
					Acceleration=if to then (to.Position-impact.position).Unit*30 else Vector3.zero,Color=ColorSequence.new(Color3.fromRGB(120,190,255)),
					LightEmission=1,Size=num({{0,.8},{1,.1}}),Transparency=num({{0,.2},{1,1}})},10)
				-- An object swallowed by an absorbing window: the reward reads on him.
				if impact.projectile and to then
					flash(fx.folder,to.Position,Color3.fromRGB(196,170,230),1,5,.25,.3)
					shockRing(fx.folder,to.Position-Vector3.new(0,2.6,0),Color3.fromRGB(196,170,230),1.5,7,.3)
				end
				return true
			end
			return false
		end,
		fighter=function(fx,model,actor,dt)
			if not model then return end
			local st=auraOf(model)
			local fam=actor.family
			local root=model:FindFirstChild("HumanoidRootPart")
			if not root then return end
			local buffed=fam and fam.buff~=nil
			-- An absorbing window (a Buff with Absorb: Nagato's seal), QA-004 M5:
			-- open, a faint sphere of its radius round him; closed, it folds in
			-- with a ring, so the end of the window reads without F8.
			local absorbSpec=nil
			if buffed then
				local def=Fighters[actor.fighterId or ""]
				for _,spec in (def and def.Techniques) or {} do if spec.Id==fam.buff and spec.Absorb then absorbSpec=spec end end
			end
			if absorbSpec and not st.absorb then
				local look=Looks[absorbSpec.Kind or "chakra"] or Looks.chakra
				local r=(absorbSpec.Absorb.Radius or 6)
				local sphere=block(fx.folder,Vector3.new(r*2,r*2,r*2),root.CFrame,c3(look.color),Enum.Material.ForceField)
				new("SpecialMesh",{MeshType=Enum.MeshType.Sphere},sphere)
				sphere.Name="AbsorbWindow";sphere.Transparency=.55
				st.absorb=sphere;st.absorbColor=c3(look.color)
			elseif not absorbSpec and st.absorb then
				local sphere=st.absorb;st.absorb=nil
				tween(sphere,.25,{Size=Vector3.new(.5,.5,.5),Transparency=1});Debris:AddItem(sphere,.3)
				shockRing(fx.folder,root.Position-Vector3.new(0,2.6,0),st.absorbColor,6,1,.25)
			end
			if st.absorb then st.absorb.CFrame=root.CFrame end
			-- A buff that draws a weapon (its Kind is a blade/needle look: the
			-- Camellia's bone sword, the chakra scalpel) holds it in the right hand.
			local held=nil
			if buffed then
				local def=Fighters[actor.fighterId or ""]
				for _,spec in (def and def.Techniques) or {} do
					if spec.Id==fam.buff and spec.Kind and Looks[spec.Kind] and (Looks[spec.Kind].shape=="blade" or Looks[spec.Kind].shape=="needle") then held=spec.Kind end
				end
			end
			if held~=st.weaponKind then
				if st.weapon then st.weapon:Destroy();st.weapon=nil end
				st.weaponKind=held
				local hand=model:FindFirstChild("RightHand")
				if held and hand then
					local look=Looks[held]
					local length=math.max(look.size[3]*1.6,2.2)
					local w=block(model,Vector3.new(math.max(look.size[1],.18),math.max(look.size[2],.18),length),hand.CFrame*CFrame.new(0,-.4,-length*.5),c3(look.color),Enum.Material.Neon)
					w.Name="FamilyWeapon";w.Anchored=false;w.CanCollide=false;w.Massless=true;w.Transparency=.1
					new("WeldConstraint",{Part0=hand,Part1=w},w)
					glow(w,c3(look.color2),look.light)
					st.weapon=w
				end
			end
			if buffed and not st.aura then
				local at=new("Attachment",{Name="FamilyAura"},root)
				local color=fighterColor(actor)
				st.aura=new("ParticleEmitter",{Texture=TEX.glow,Rate=26,Lifetime=NumberRange.new(.35,.6),Speed=NumberRange.new(2,4),SpreadAngle=Vector2.new(25,25),
					EmissionDirection=Enum.NormalId.Top,Shape=Enum.ParticleEmitterShape.Cylinder,Color=ColorSequence.new(color),LightEmission=.8,LightInfluence=0,
					Size=num({{0,1.4},{1,.2}}),Transparency=num({{0,.45},{1,1}})},at)
				st.aura.ShapeStyle=Enum.ParticleEmitterShapeStyle.Surface
				st.auraAt=at
			elseif not buffed and st.aura then
				st.aura.Enabled=false;Debris:AddItem(st.auraAt,1);st.aura=nil;st.auraAt=nil
			end
			-- Held by a family bind: what holds the body shows on it.
			local held=actor.boundKind
			if held~=st.heldKind then
				if st.held then st.held:Destroy();st.held=nil end
				st.heldKind=held
				if held and Looks[held] then st.held=FamilyFX.bindVisual(fx,model,root,Looks[held]) end
			end
			if st.held and st.held.Parent then
				local t=os.clock()
				for _,p in st.held:GetChildren() do
					local spin=p:GetAttribute("Spin")
					if spin then p.CFrame=root.CFrame*CFrame.new(0,p:GetAttribute("Y") or 0,0)*CFrame.Angles(0,t*spin,0)*CFrame.Angles(0,0,math.rad(90)) end
				end
			end
			local slowed=fam and (fam.slowed or 0)&gt;0
			if slowed and not st.slow then
				local at=new("Attachment",{Name="FamilySlow",Position=Vector3.new(0,-2.6,0)},root)
				st.slow=new("ParticleEmitter",{Texture=TEX.smoke,Rate=14,Lifetime=NumberRange.new(.4,.7),Speed=NumberRange.new(.5,1.5),
					Color=ColorSequence.new(Color3.fromRGB(40,36,52)),LightInfluence=1,Size=num({{0,1.2},{1,2}}),Transparency=num({{0,.5},{1,1}})},at)
				st.slowAt=at
			elseif not slowed and st.slow then
				st.slow.Enabled=false;Debris:AddItem(st.slowAt,1);st.slow=nil;st.slowAt=nil
			end
		end,
	})
end
return FamilyFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND133">
          <Properties>
            <string name="Name">GaleFX</string>
            <ProtectedString name="Source">-- Temari on the client (roster wave): the iron fan (closed on her back at rest,
-- a heavy club in the hand for her strikes, opened moon by moon for the wind,
-- planted beside her at the intro), the Kamaitachi scythe and Kamatari in
-- flight, the zones (Zones.luau: wind lanes stream along their direction,
-- updraft columns rise; never fire), her gusts, the whirlwind and her contacts
-- in the wind's colours. One identity layer installed into Effects (like
-- SandFX and LeeFX), plus a `frame` step that draws the snapshot's zones.
-- Presentation only: nothing here can change gameplay.
local Debris=game:GetService("Debris")

local GaleFX={}
local K -- Effects' helpers, handed over by install()
GaleFX.clock=os.clock -- (headless tests drive time)
local GALE="Gale"

local WIND=Color3.fromRGB(196,255,232)
local WIND_CORE=Color3.fromRGB(242,255,250)
local WIND_DEEP=Color3.fromRGB(116,204,170)
local MOON=Color3.fromRGB(146,108,204)
local IRON=Color3.fromRGB(60,62,72)
local IRON_EDGE=Color3.fromRGB(150,152,166)
local PAPER=Color3.fromRGB(230,226,214)
local DUST=Color3.fromRGB(214,206,186)
local FIRE=Color3.fromRGB(255,150,60)

local function flatUnit(v,fallback)
	local f=Vector3.new(v.X,0,v.Z)
	return if f.Magnitude&gt;.05 then f.Unit else (fallback or Vector3.zAxis)
end
local function ground(fx,position,fallback)
	local ok,hit=pcall(K.floorUnder,fx,position,3,12)
	return if ok and hit then hit.Position.Y else fallback
end
-- Thin streaks of air: the readable unit of every wind effect here.
local function streak(parent,from,to,color,width,time,transparency)
	local d=to-from
	if d.Magnitude&lt;.05 then return nil end
	local s=K.block(parent,Vector3.new(width or .1,width or .1,d.Magnitude),CFrame.lookAt(from:Lerp(to,.5),to),color or WIND,Enum.Material.Neon)
	s.Name="WindStreak";s.Transparency=transparency or .3
	if time then K.tween(s,time,{Transparency=1,Size=Vector3.new(.02,.02,d.Magnitude*1.2)});Debris:AddItem(s,time+.05) end
	return s
end
-- A fan of streaks blown from `at` along `direction` (a cone of half angle `spread`).
local function gustCone(fx,name,at,direction,range,spread,count,color,time)
	local holder=K.new("Model",{Name=name},fx.folder)
	local look=flatUnit(direction)
	for k=1,count do
		local a=((k-1)/math.max(1,count-1)-.5)*2*spread+(math.random()-.5)*.08
		local dir=CFrame.fromAxisAngle(Vector3.yAxis,a):VectorToWorldSpace(look)
		local from=at+dir*(1+math.random()*2)+Vector3.new(0,(math.random()-.5)*2.4,0)
		streak(holder,from,from+dir*(range*(.55+math.random()*.45)),color or WIND,.12,time or .3,.25)
	end
	Debris:AddItem(holder,(time or .3)+.2)
	return holder
end

-- ------------------------------------------------------------------ the fan
-- Nine slats on one pivot (the grip), along -Y: folded onto one bar it is a
-- heavy iron club, spread over half a circle it is the open fan with its three
-- moons painted on the face.
local SLATS,LENGTH=9,4.4
local function buildFan()
	local model=K.new("Model",{Name="TemariFan"})
	local grip=K.block(model,Vector3.new(.3,.3,.3),CFrame.new(),IRON);grip.Name="Grip";grip.Transparency=1;grip.Anchored=false;grip.Massless=true
	model.PrimaryPart=grip
	local function hinge(part,c0)
		part.Anchored=false;part.Massless=true
		return K.new("Weld",{Name="Hinge",Part0=grip,Part1=part,C0=c0},part)
	end
	local slats={}
	for i=1,SLATS do
		local slat=K.block(model,Vector3.new(.95,LENGTH,.1),CFrame.new(),if i%2==0 then PAPER else Color3.fromRGB(238,234,224))
		slat.Name="FanSlat"
		table.insert(slats,{part=slat,weld=hinge(slat,CFrame.new(0,-LENGTH/2,0)),spread=(i-(SLATS+1)/2)/((SLATS-1)/2)})
	end
	-- Closed: the iron spine that makes it a weapon; two bands and a cap.
	local bar=K.block(model,Vector3.new(1.05,LENGTH+.1,.42),CFrame.new(),IRON,Enum.Material.Metal);bar.Name="FanBar"
	hinge(bar,CFrame.new(0,-LENGTH/2,0))
	local bands={}
	for k,y in {-.5,-LENGTH+.6} do
		local band=K.block(model,Vector3.new(1.12,.16,.5),CFrame.new(),IRON_EDGE,Enum.Material.Metal);band.Name="FanBand"
		hinge(band,CFrame.new(0,y,0));bands[k]=band
	end
	local moons={}
	for k=1,3 do
		local moon=K.block(model,Vector3.new(.04,1.05,1.05),CFrame.new(),MOON);moon.Name="FanMoon";moon.Shape=Enum.PartType.Cylinder;moon.Transparency=1
		moons[k]={part=moon,weld=hinge(moon,CFrame.new()),angle=({-46,0,46})[k]}
	end
	return {model=model,grip=grip,slats=slats,bar=bar,bands=bands,moons=moons,open=0,moonsShown=0}
end
-- Open fraction 0 (closed club) .. 1 (half circle), `moons` painted moons shown.
local function shapeFan(fan,open,moons,lit)
	fan.open=open;fan.moonsShown=moons
	for _,s in fan.slats do s.weld.C0=CFrame.Angles(0,0,math.rad(s.spread*82*open))*CFrame.new(0,-LENGTH/2,0) end
	local closed=open&lt;.25
	fan.bar.Transparency=if closed then 0 else 1
	for _,band in fan.bands do band.Transparency=if closed then 0 else 1 end
	for k,m in fan.moons do
		m.weld.C0=CFrame.Angles(0,0,math.rad(m.angle*open))*CFrame.new(0,-LENGTH*.62,-.08)*CFrame.Angles(0,math.rad(90),0)
		-- One moon per third of the opening.
		m.part.Transparency=if k&lt;=moons and open&gt;=k/3-.02 then 0 else 1
		m.part.Material=if lit then Enum.Material.Neon else Enum.Material.SmoothPlastic
	end
end
-- Where it sits: on the back (grip over the right shoulder, across to the left
-- hip), in the right hand (closed along the forearm, open with its face to the
-- swing), planted beside her (the intro).
local MOUNT={
	back={"UpperTorso",CFrame.new(.72,1.25,.72)*CFrame.Angles(0,0,math.rad(-30))},
	hand={"RightHand",CFrame.new(0,-.22,0)},
	open={"RightHand",CFrame.new(0,-.22,0)*CFrame.Angles(0,math.rad(90),0)},
	planted={"HumanoidRootPart",CFrame.new(2.4,-2.9,.2)*CFrame.Angles(0,math.rad(70),math.pi)},
}
GaleFX.MOUNT=MOUNT
local CAST_MOONS={Kamaitachi=1,Cyclone=2,GreatGust=3}
local CHANNEL={Kamaitachi=.3,Cyclone=.24,GreatGust=.5}
-- The fan opens for the strikes that blow (the third, the pirouette, the dive, the scoop).
local OPEN_STRIKE={Light3=1,FanPirouette=1,FanDive=1,Updraft=.6}
local SWINGING={Startup=true,Active=true,Recovery=true}
local CASTING={TechniqueChannel=true,TechniqueActive=true,TechniqueRecovery=true}
-- Mount, open fraction and moons for this frame, from the snapshot alone.
function GaleFX.fanPose(actor)
	if (actor.health or 1)&lt;=0 then return "back",0,0 end
	if (actor.intro or 0)&gt;0 and actor.state=="Neutral" then return "planted",1,3 end
	local awake=(actor.awaken or 0)&gt;0
	local cast=actor.castId
	if cast and CAST_MOONS[cast] and CASTING[actor.state] then
		local open=if actor.state=="TechniqueChannel" then math.clamp((actor.castElapsed or 0)/CHANNEL[cast],.15,1) else 1
		local moons=math.max(1,math.ceil(CAST_MOONS[cast]*open-.01))
		return "open",open,if awake then 3 else moons
	end
	if actor.throwKind=="Gust" and (actor.throwElapsed or 99)&gt;=0 and (actor.throwElapsed or 99)&lt;.45 then return "open",1,if awake then 3 else 1 end
	local name=actor.attackName
	-- (late in a recovery the arm is back on the hip: the fan is put away)
	if name and SWINGING[actor.state] and not (actor.state=="Recovery" and (actor.attackElapsed or 0)&gt;.45) then
		local open=OPEN_STRIKE[name] or 0
		return if open&gt;0 then "open" else "hand",open,if open&gt;0 then 1 else 0
	end
	if actor.glide then return "open",1,0 end
	return "back",0,if awake then 3 else 0
end
local function fanFor(fx,model)
	fx.galeFans=fx.galeFans or setmetatable({},{__mode="k"})
	local fan=fx.galeFans[model]
	if fan and fan.model.Parent==model then return fan end
	fan=buildFan()
	fan.model.Parent=model
	fan.carry=K.new("Weld",{Name="FanCarry",Part1=fan.grip},fan.grip)
	fx.galeFans[model]=fan
	return fan
end
local function holdFan(fx,model,actor)
	local fan=fanFor(fx,model)
	local mount,open,moons=GaleFX.fanPose(actor)
	local spec=MOUNT[mount]
	local part=model:FindFirstChild(spec[1]) or model:FindFirstChild("HumanoidRootPart")
	if part and (fan.carry.Part0~=part or fan.mount~=mount) then
		fan.carry.Part0=part;fan.carry.C0=spec[2]
		-- Drawn or put away: a small gust where the fan moves.
		if fan.mount and (mount=="back")~=(fan.mount=="back") then
			local at=(part.CFrame*spec[2]).Position
			K.shockRing(fx.folder,at,WIND,.4,3.2,.18)
		end
		fan.mount=mount
	end
	if math.abs(fan.open-open)&gt;.01 or fan.moonsShown~=moons or fan.lit~=((actor.awaken or 0)&gt;0) then
		fan.lit=(actor.awaken or 0)&gt;0
		shapeFan(fan,open,moons,fan.lit)
	end
	return fan
end

-- ------------------------------------------------------------------ flights
-- Kamaitachi: a wide crescent of cutting air, as big as the server's swept
-- radius at every moment (it grows as it flies), streaming a pale trail.
local ARC=9
local function buildScythe(name,color)
	return function()
		local model=K.new("Model",{Name=name})
		local root=K.block(model,Vector3.new(.1,.1,.1),CFrame.new(),Color3.new());root.Name="Root";root.Transparency=1
		for k=1,ARC do
			local seg=K.block(model,Vector3.new(1,.08,.4),CFrame.new(),color or WIND,Enum.Material.Neon)
			seg.Name="ScytheArc";seg.Transparency=.25+math.abs(k-(ARC+1)/2)*.07
		end
		local a0=K.new("Attachment",{Position=Vector3.new(-2.6,0,0)},root)
		local a1=K.new("Attachment",{Position=Vector3.new(2.6,0,0)},root)
		K.new("Trail",{Attachment0=a0,Attachment1=a1,Color=ColorSequence.new(color or WIND),LightEmission=.6,Transparency=K.num({{0,.5},{1,1}}),
			Lifetime=.22,FaceCamera=true},root)
		model.PrimaryPart=root
		return model
	end
end
local function scythePose(_,entry,p,age,look,dt)
	local radius=(p.radius or 2)+(p.growth or 0)*math.max(0,age)
	entry.spin=(entry.spin or 0)+dt*2
	local i=0
	for _,seg in entry.model:GetChildren() do
		if seg.Name=="ScytheArc" then
			i+=1
			local a=math.rad(-62+(i-1)*124/(ARC-1))
			local tilt=math.sin(entry.spin+i)*.06
			seg.Size=Vector3.new(radius*.48,.08+radius*.02,.42)
			seg.CFrame=look*CFrame.Angles(0,a,tilt)*CFrame.new(0,0,-radius*.85)
		end
	end
	return look
end
-- Kamatari: the one-eyed weasel riding a giant crescent, its sickle out.
local function buildKamatari()
	local model=buildScythe("Kamatari",WIND_CORE)()
	local root=model.PrimaryPart
	local fur=Color3.fromRGB(240,236,226)
	local parts={}
	local body=K.block(model,Vector3.new(1.1,1,2.2),CFrame.new(0,.9,.4),fur);body.Shape=Enum.PartType.Ball;body.Name="KamatariBody";table.insert(parts,body)
	local head=K.block(model,Vector3.new(.9,.85,.9),CFrame.new(0,1.5,-.7),fur);head.Shape=Enum.PartType.Ball;head.Name="KamatariHead";table.insert(parts,head)
	for _,x in {-.3,.3} do table.insert(parts,K.block(model,Vector3.new(.2,.3,.12),CFrame.new(x,1.95,-.75),fur)) end
	table.insert(parts,K.block(model,Vector3.new(.24,.06,.04),CFrame.new(-.18,1.58,-1.14),Color3.fromRGB(30,26,30))) -- the scarred eye
	local tail=K.block(model,Vector3.new(.35,.35,1.6),CFrame.new(0,1.1,1.8)*CFrame.Angles(math.rad(-25),0,0),fur);tail.Name="KamatariTail";table.insert(parts,tail)
	local blade=K.block(model,Vector3.new(.08,.5,2.6),CFrame.new(.9,1.3,-.6)*CFrame.Angles(0,math.rad(20),math.rad(-30)),IRON_EDGE,Enum.Material.Metal)
	blade.Name="KamatariSickle";table.insert(parts,blade)
	K.weldAll(root,parts)
	return model
end

-- ------------------------------------------------------------------ zones
-- A lane: a faint band on the floor and streaks of air running along it,
-- downwind, at body height (the kind of zone is read at a glance: no flame).
local LANE_STREAKS=12
local function laneVisual(fx,z)
	local holder=K.new("Model",{Name="WindLane"},fx.folder)
	local y=ground(fx,z.origin+Vector3.new(0,1,0),z.origin.Y)
	-- The band itself stays almost invisible (seen in Studio: a translucent slab
	-- on the floor read as a placeholder block); the ground shows the wind by
	-- the dust it drags along the lane.
	local band=K.block(holder,Vector3.new(1,.06,1),CFrame.new(),if z.reflect then MOON else WIND_DEEP);band.Name="WindBand";band.Transparency=1
	K.new("ParticleEmitter",{Name="LaneDust",Texture=K.TEX.smoke,Rate=26,Lifetime=NumberRange.new(.45,.8),Speed=NumberRange.new(7,12),
		SpreadAngle=Vector2.new(6,4),EmissionDirection=Enum.NormalId.Front,Shape=Enum.ParticleEmitterShape.Box,
		Color=ColorSequence.new(if z.reflect then MOON else Color3.fromRGB(214,226,218)),LightInfluence=1,
		Size=K.num({{0,.9},{1,2.4}}),Transparency=K.num({{0,1},{.25,.78},{1,1}}),Drag=2,Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-40,40)},band)
	local streaks={}
	for k=1,LANE_STREAKS do
		local s=K.block(holder,Vector3.new(.09,.09,2.6),CFrame.new(),if z.reflect and k%3==0 then MOON else WIND,Enum.Material.Neon)
		s.Name="WindStreak";s.Transparency=.4
		table.insert(streaks,{part=s,phase=math.random(),across=(math.random()*2-1),height=.5+math.random()*4,speed=.75+math.random()*.5})
	end
	Debris:AddItem(holder,(z.remaining or 4)+1)
	return {holder=holder,band=band,streaks=streaks,floor=y,shown=0}
end
local function laneStep(fx,v,z,dt)
	-- The lane grows with the scythe that lays it: ease toward the reported length.
	v.shown=v.shown+(z.length-v.shown)*math.min(1,dt*18)
	local length=math.max(.5,v.shown)
	local dir=flatUnit(z.direction)
	local across=dir:Cross(Vector3.yAxis)
	local base=Vector3.new(z.origin.X,v.floor,z.origin.Z)
	local fade=math.clamp((z.remaining or 1)/.5,0,1)
	v.band.Size=Vector3.new(z.width*2,.06,length)
	v.band.CFrame=CFrame.lookAt(base+dir*length/2+Vector3.new(0,.04,0),base+dir*length/2+Vector3.new(0,.04,0)+dir)
	local dust=v.band:FindFirstChild("LaneDust")
	if dust then dust.Rate=26*fade*math.clamp(length/12,.4,2) end
	local t=GaleFX.clock()
	for _,s in v.streaks do
		local along=((t*s.speed*1.4+s.phase)%1)*length
		local at=base+dir*along+across*s.across*z.width*.9+Vector3.new(0,s.height,0)
		s.part.CFrame=CFrame.lookAt(at,at+dir)
		-- Bright mid-lane, fading at both ends and as the lane dies.
		local edge=math.min(along,length-along)/math.max(1,length*.2)
		s.part.Transparency=1-(.6*math.clamp(edge,0,1)*fade)
	end
end
-- A column of rising air: rings climbing and turning, streaks spiralling up.
local function columnVisual(fx,z)
	local holder=K.new("Model",{Name="Updraft"},fx.folder)
	local y=ground(fx,z.origin+Vector3.new(0,1,0),z.origin.Y)
	local rings={}
	for k=1,3 do
		local r=K.block(holder,Vector3.new(.08,z.radius*2,z.radius*2),CFrame.new(),WIND,Enum.Material.Neon);r.Name="UpdraftRing";r.Shape=Enum.PartType.Cylinder;r.Transparency=.6
		table.insert(rings,{part=r,phase=k/3})
	end
	local spirals={}
	for k=1,6 do
		local s=K.block(holder,Vector3.new(.1,1.8,.1),CFrame.new(),WIND_CORE,Enum.Material.Neon);s.Name="WindStreak";s.Transparency=.4
		table.insert(spirals,{part=s,phase=k/6})
	end
	K.smokePuff(fx.folder,Vector3.new(z.origin.X,y+.6,z.origin.Z),DUST,14,1.8)
	Debris:AddItem(holder,(z.remaining or 2)+1)
	return {holder=holder,rings=rings,spirals=spirals,floor=y}
end
local function columnStep(fx,v,z,dt)
	local t=GaleFX.clock()
	local base=Vector3.new(z.origin.X,v.floor,z.origin.Z)
	local fade=math.clamp((z.remaining or 1)/.4,0,1)
	local h=math.min(z.height or 16,16)
	for _,r in v.rings do
		local u=(t*.8+r.phase)%1
		r.part.Size=Vector3.new(.08,z.radius*2*(1-u*.3),z.radius*2*(1-u*.3))
		r.part.CFrame=CFrame.new(base+Vector3.new(0,.2+u*h,0))*CFrame.Angles(0,t*3,math.pi/2)
		r.part.Transparency=1-(.4*(1-u)*fade)
	end
	for _,s in v.spirals do
		local u=(t*.9+s.phase)%1
		local a=s.phase*math.pi*2+t*5
		local at=base+Vector3.new(math.cos(a)*z.radius*.8,.5+u*h,math.sin(a)*z.radius*.8)
		s.part.CFrame=CFrame.new(at)*CFrame.Angles(0,-a,math.rad(18))
		s.part.Transparency=1-(.55*(1-u)*fade)
	end
end
local function frame(fx,data,dt)
	local st=fx.galeZones
	if not st or st.epoch~=data.epoch then
		if st then for _,v in st.list do v.holder:Destroy() end end
		st={epoch=data.epoch,list={}};fx.galeZones=st
	end
	local live={}
	for _,z in data.zones or {} do
		live[z.id]=true
		local v=st.list[z.id]
		if not v then
			v=if z.kind=="Updraft" then columnVisual(fx,z) else laneVisual(fx,z)
			v.kind=z.kind;st.list[z.id]=v
		end
		if z.kind=="Updraft" then columnStep(fx,v,z,dt) else laneStep(fx,v,z,dt) end
	end
	for id,v in st.list do
		if not live[id] then
			for _,d in v.holder:GetDescendants() do if d:IsA("BasePart") then K.tween(d,.25,{Transparency=1}) end end
			Debris:AddItem(v.holder,.3)
			st.list[id]=nil
		end
	end
end

-- ------------------------------------------------------------------ contacts
local function windBurst(fx,at,direction,size,color)
	local holder=K.new("Model",{Name="WindBurst"},fx.folder)
	local look=flatUnit(direction or Vector3.zAxis)
	for k=1,7 do
		local a=math.rad(-70+(k-1)*140/6)
		local dir=CFrame.fromAxisAngle(Vector3.yAxis,a):VectorToWorldSpace(look)
		streak(holder,at+dir*.6,at+dir*(size*(1+math.random()*.5)),color or WIND,.12,.22,.2)
	end
	K.shockRing(holder,at,color or WIND,.6,size*2.4,.24,look)
	Debris:AddItem(holder,.4)
	K.sound(K.anchorPart(fx.folder,at),K.SOUND.whoosh,.4,.8+math.random()*.2)
end
local function impact(fx,data,folder)
	local style=data.style
	local at=data.position
	if data.kind=="gale" or data.kind=="kamatari" then
		-- The scythe (or Kamatari) ends: on a body, on a wall, on a guard, or in the air.
		local big=data.kind=="kamatari"
		local size=if style=="fade" then 1.4 elseif style=="spent" then 2 else 3
		windBurst(fx,at,data.direction,size*(if big then 1.6 else 1),if big then WIND_CORE else WIND)
		if style~="fade" then K.smokePuff(fx.folder,at,DUST,if big then 16 else 8,if big then 2.2 else 1.4) end
		if style~="fade" and style~="spent" then fx:cheer(if big then 1 else .5) end
		return true
	end
	if style=="gust" then
		local reach=data.range or 18
		gustCone(fx,"FanGust",at,data.direction or Vector3.zAxis,reach,math.rad(34),if data.heavy then 14 else 9,if data.infusion then WIND_CORE else WIND,.32)
		K.smokePuff(fx.folder,at-Vector3.new(0,2.2,0)+flatUnit(data.direction or Vector3.zAxis)*3,DUST,8,1.3)
		K.sound(K.anchorPart(fx.folder,at),K.SOUND.whoosh,.45,.7)
		return true
	elseif style=="greatgust" then
		local look=flatUnit(data.direction or Vector3.zAxis)
		gustCone(fx,"GreatGust",at,look,data.range or 30,math.rad(42),22,WIND,.45)
		K.shockRing(fx.folder,at-Vector3.new(0,2.4,0),WIND,3,(data.range or 30)*.9,.45)
		K.smokePuff(fx.folder,at-Vector3.new(0,2.2,0)+look*6,DUST,24,2.6)
		K.sound(K.anchorPart(fx.folder,at),K.SOUND.boom,.4,1.4)
		fx:cheer(.8)
		return true
	elseif style=="cyclone" then
		local radius=data.radius or 3.4
		if data.phase=="mark" then
			-- The spot is marked a beat before it rises: a swirl on the floor.
			local y=ground(fx,at,at.Y-.3)
			local holder=K.new("Model",{Name="CycloneMark"},fx.folder)
			local disc=K.block(holder,Vector3.new(.05,radius*2,radius*2),CFrame.new(at.X,y+.05,at.Z)*CFrame.Angles(0,0,math.pi/2),WIND_DEEP);disc.Shape=Enum.PartType.Cylinder;disc.Transparency=.6
			for k=0,5 do
				local a=k/6*math.pi*2
				streak(holder,Vector3.new(at.X+math.cos(a)*radius,y+.1,at.Z+math.sin(a)*radius),Vector3.new(at.X+math.cos(a+1)*radius*.4,y+.1,at.Z+math.sin(a+1)*radius*.4),WIND,.1,data.delay or .45,.3)
			end
			K.tween(disc,data.delay or .45,{Transparency=.3})
			Debris:AddItem(holder,(data.delay or .45)+.1)
		else
			-- It rises (or holds the scooped body): a burst of air straight up.
			local holder=K.new("Model",{Name="CycloneRise"},fx.folder)
			for k=0,7 do
				local a=k/8*math.pi*2
				local from=at+Vector3.new(math.cos(a)*radius*.7,.2,math.sin(a)*radius*.7)
				streak(holder,from,from+Vector3.new(math.cos(a+.6),8,math.sin(a+.6)),WIND,.14,.4,.2)
			end
			K.shockRing(holder,at,WIND,1,radius*3,.3)
			Debris:AddItem(holder,.5)
			K.smokePuff(fx.folder,at,DUST,if data.phase=="rise" then 16 else 6,1.6)
			K.sound(K.anchorPart(fx.folder,at),K.SOUND.whoosh,.5,.6)
		end
		return true
	elseif style=="windfeed" then
		-- Fire crossing her wind flares up.
		K.flash(fx.folder,at,FIRE,1,5,.25,.2)
		K.shockRing(fx.folder,at,WIND,.8,5,.25,data.direction)
		return true
	elseif style=="winddeflect" then
		-- A blade turned aside by a lane: a swirl, the blade tumbles out of it.
		K.shockRing(fx.folder,at,WIND,.5,3.6,.2,data.direction)
		pcall(fx.tumble,fx,data.kind,at,data.direction,WIND)
		return true
	end
	if data.fighter~=GALE then return false end
	if style=="awaken" then
		-- Kirikiri Mai: the fan fully open, the moons lit, the wind around her.
		local model=folder and folder:FindFirstChild(data.owner or "")
		if model then fx:ghost(model,WIND,.4,.4) end
		K.flash(fx.folder,at,WIND_CORE,2,12,.3,.15)
		K.shockRing(fx.folder,at-Vector3.new(0,2.6,0),MOON,3,22,.45)
		K.shockRing(fx.folder,at-Vector3.new(0,2.4,0),WIND,3,28,.55)
		gustCone(fx,"KirikiriMai",at,Vector3.xAxis,14,math.pi,16,WIND,.5)
		K.sound(K.anchorPart(fx.folder,at),K.SOUND.boom,.45,1.2)
		fx:cheer(1)
		return true
	elseif style=="chase" then
		-- Her wind step (or a chase): a pale copy left behind, streaks along the way.
		local model=folder and folder:FindFirstChild(data.owner or "")
		if model then fx:ghost(model,WIND,.25,.55) end
		if data.to then
			for k=1,4 do
				local off=Vector3.new((math.random()-.5)*1.6,(math.random()-.2)*2,(math.random()-.5)*1.6)
				streak(fx.folder,at+off,data.to+off,WIND,.1,.25,.35)
			end
		end
		K.smokePuff(fx.folder,at-Vector3.new(0,2.6,0),DUST,6,1.2)
		K.sound(K.anchorPart(fx.folder,at),K.SOUND.whoosh,.35,1.05)
		return true
	elseif style=="afterimage" then
		local model=folder and folder:FindFirstChild(data.owner or "")
		if model then fx:ghost(model,WIND,.3,.5) end
		return true
	elseif style=="cast" then
		-- The fan opens: air gathers round the hand.
		local model=folder and folder:FindFirstChild(data.owner or "")
		local hand=model and model:FindFirstChild("RightHand")
		local where=if hand then hand.Position else at
		K.shockRing(fx.folder,where,WIND,.4,4,.25)
		return true
	end
	return false
end

-- ------------------------------------------------------------------ per frame
local function fighter(fx,model,actor,_dt)
	if not model or not actor or actor.fighterId~=GALE then return end
	holdFan(fx,model,actor)
	-- Her awakening mantle and speed trail take the wind's colour.
	local aura=fx.auras and fx.auras[model]
	if aura and aura.mantle and aura.galeMantle~=aura.mantle then
		aura.mantle.emitter.Color=ColorSequence.new(WIND)
		aura.mantle.light.Color=WIND
		aura.galeMantle=aura.mantle
	end
	if aura and aura.trail and not aura.galeTrail then aura.trail.Color=ColorSequence.new(WIND);aura.galeTrail=true end
end

function GaleFX.install(FX,kit)
	K=kit
	kit.BUILD.gale=buildScythe("Kamaitachi",WIND)
	kit.BUILD.kamatari=buildKamatari
	FX.poses.gale=scythePose
	FX.poses.kamatari=scythePose
	table.insert(FX.layers,{name="Gale",impact=impact,fighter=fighter,frame=frame})
end
return GaleFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND134">
          <Properties>
            <string name="Name">GaleMotion</string>
            <ProtectedString name="Source">-- Temari's motion family (roster wave, DEC-015): her stance, gait, clips,
-- throw overlay (the fan gust), cast poses and intro, added to the motion
-- engine's tables by install(E) (VelmoraMotionEngine passes its STANCE, GAIT,
-- CLIPS, THROWS, CAST, INTRO and builders). No clip of another fighter for her
-- string, routes, heavy or air: the right hand always carries the iron fan
-- (GaleFX draws it), so every strike is a thrust, a sweep or a chop with a
-- long, heavy weapon, the third and the routes open it into a gust. Grabs and
-- throws fall back to Itachi's (listed in TEMARI.md). Presentation only.
local GaleMotion={}
function GaleMotion.install(E)
	local K,merge,smooth=E.K,E.merge,E.smooth
	-- Upright and composed, weight on the back foot, left side to the opponent,
	-- chin up; the right hand rests on the hip (the fan is on her back), the
	-- left hand low and open in front.
	local T={root={y=-.22,pitch=-2,yaw=26},torso={pitch=-3,yaw=-12},head={pitch=-6,yaw=-14},
		ra={raise=-8,out=38,twist=-50,elbow=104,wrist=10},la={raise=46,out=6,twist=-14,elbow=40,wrist=-20},
		rf={x=.18,z=.66,yaw=34},lf={x=-.06,z=-.5,yaw=-4},breath=.6,tempo=4.4}
	E.STANCE.Gale=T
	-- Measured steps, little bounce, no guard carried; the hand stays on the
	-- hip until she breaks into a full run (holdRear).
	E.GAIT.Gale={stride=.98,cadence=.92,arm=16,lean=-1,bob=.65,guard=0,holdRear=true}
	local function t(over) return merge(T,over) end
	local AIR={root={pitch=4},torso={pitch=6},head={pitch=-6},ra={raise=60,out=30,elbow=70},la={raise=40,out=30,elbow=60},rl={lift=50,knee=86,ankle=-10},ll={lift=30,knee=64,ankle=-10}}
	local function air(over) return merge(AIR,over) end
	local C={}
	C.Light1={ -- the closed fan driven straight out like a spear
		K(0,t({root={y=-.34,yaw=40,pitch=2},torso={yaw=18,pitch=2},ra={raise=50,out=24,twist=10,elbow=118,wrist=0},la={raise=40,out=10,elbow=50}})),
		K(1,t({root={y=-.36,z=-.28,yaw=8,pitch=8},torso={yaw=-18,pitch=6},head={yaw=-6},ra={raise=88,out=-4,twist=0,elbow=4,wrist=0},la={raise=20,out=30,elbow=40},lf={z=-.82},rf={z=.72}}),"out"),
		K(2,t({root={y=-.36,z=-.3,yaw=6,pitch=8},torso={yaw=-20,pitch=6},ra={raise=86,out=-6,elbow=8},la={raise=20,out=30,elbow=40},lf={z=-.82},rf={z=.72}})),
		K(3,T),
	}
	C.Light2={ -- a flat sweep from the right across her front, the whole body turning
		K(0,t({root={y=-.32,yaw=52},torso={yaw=30},ra={raise=80,out=76,twist=-6,elbow=16},la={raise=50,out=-10,elbow=70}})),
		K(1,t({root={y=-.36,yaw=-6,pitch=6},torso={yaw=-30,pitch=4},head={yaw=8},ra={raise=86,out=-34,twist=6,elbow=10},la={raise=26,out=30,elbow=40},lf={z=-.7,x=-.1}}),"out"),
		K(2,t({root={y=-.36,yaw=-12,pitch=6},torso={yaw=-38,pitch=4},ra={raise=84,out=-48,elbow=14},la={raise=26,out=30,elbow=40},lf={z=-.7,x=-.1}})),
		K(3,T),
	}
	C.Light3={ -- both hands: the fan raised overhead opens and comes down in a gust
		K(0,t({root={y=-.2,pitch=-8,yaw=12},torso={pitch=-14,yaw=6},head={pitch=-10},ra={raise=168,out=14,elbow=40},la={raise=160,out=-6,elbow=60}})),
		K(1,t({root={y=-.62,z=-.4,pitch=14,yaw=0},torso={pitch=18},head={pitch=4},ra={raise=74,out=-6,elbow=8},la={raise=70,out=-14,elbow=20},lf={z=-1.1},rf={z=.9}}),"out"),
		K(2,t({root={y=-.62,z=-.42,pitch=14},torso={pitch=20},ra={raise=68,out=-6,elbow=10},la={raise=64,out=-14,elbow=22},lf={z=-1.1},rf={z=.9}})),
		K(3,T),
	}
	C.Heavy={ -- the closed fan chopped down from overhead, one hand
		K(0,t({root={y=-.3,pitch=-6,yaw=24},torso={pitch=-10,yaw=14},ra={raise=172,out=22,elbow=46},la={raise=60,out=16,elbow=60}})),
		K(.75,t({root={y=-.36,pitch=-8,yaw=26},torso={pitch=-12,yaw=16},ra={raise=176,out=24,elbow=52},la={raise=62,out=16,elbow=60}})),
		K(1,t({root={y=-.8,z=-.5,pitch=22,yaw=4},torso={pitch=24,yaw=-8},head={pitch=8},ra={raise=46,out=-4,elbow=4},la={raise=10,out=40,elbow=30},lf={z=-1.2},rf={z=1.0}}),"out"),
		K(2,t({root={y=-.8,z=-.52,pitch=22,yaw=2},torso={pitch=24,yaw=-10},ra={raise=42,out=-4,elbow=6},la={raise=10,out=40,elbow=30},lf={z=-1.2},rf={z=1.0}})),
		K(3,T),
	}
	C.Updraft={ -- low, then the half-open fan scoops the body up into the rising air
		K(0,t({root={y=-1.0,pitch=20,yaw=20},torso={pitch=14,yaw=10},ra={raise=-20,out=24,twist=-10,elbow=20},la={raise=40,out=20,elbow=50},lf={z=-.6},rf={z=.6}})),
		K(1,t({root={y=.08,pitch=-14,yaw=-4},torso={pitch=-16,yaw=-6},head={pitch=-22},ra={raise=168,out=8,elbow=10},la={raise=-10,out=36,elbow=24},rf={toe=-20},lf={z=-.3}}),"out"),
		K(2,t({root={y=.06,pitch=-16},torso={pitch=-18},head={pitch=-22},ra={raise=172,out=8,elbow=14},la={raise=-10,out=36,elbow=24},rf={toe=-18},lf={z=-.3}})),
		K(3,T),
	}
	C.FanSlam={ -- both hands: the closed fan brought down like a beam
		K(0,t({root={y=-.16,pitch=-10},torso={pitch=-18},head={pitch=-12},ra={raise=170,out=6,elbow=40},la={raise=166,out=-4,elbow=50}})),
		K(1,t({root={y=-.95,z=-.3,pitch=28},torso={pitch=26},head={pitch=10},ra={raise=34,out=-8,elbow=8},la={raise=30,out=-12,elbow=14},lf={z=-1.0},rf={z=.9}}),"out"),
		K(2,t({root={y=-.95,z=-.32,pitch=28},torso={pitch=26},ra={raise=32,out=-8,elbow=10},la={raise=28,out=-12,elbow=16},lf={z=-1.0},rf={z=.9}})),
		K(3,T),
	}
	local Y=T.root.yaw
	-- A full turn on the lead foot, the open fan held out at arm's length (each
	-- key under half a turn from the next, so the body turns the right way).
	local turn={
		K(0,t({root={y=-.4,yaw=Y-30},torso={yaw=-20},ra={raise=84,out=70,elbow=14},la={raise=60,out=40,elbow=30}})),
		K(1,t({root={y=-.48,yaw=Y+90,roll=-6},torso={yaw=10},head={yaw=-60},ra={raise=88,out=86,elbow=8},la={raise=70,out=60,elbow=20},lf={x=.3,yaw=90}}),"out"),
		K(2,t({root={y=-.48,yaw=Y+200,roll=-6},torso={yaw=10},head={yaw=-60},ra={raise=88,out=86,elbow=8},la={raise=70,out=60,elbow=20},lf={x=.3,yaw=200}})),
		K(2.5,t({root={y=-.36,yaw=Y+290},ra={raise=70,out=50,elbow=30},lf={x=.2,yaw=290}})),
		K(3,merge(T,{root={yaw=Y+360}})),
	}
	C.FanPirouette=turn
	C.FanBackhand={ -- the backhand: from across her body out to the right
		K(0,t({root={y=-.32,yaw=-10},torso={yaw=-34},ra={raise=80,out=-54,twist=40,elbow=74},la={raise=40,out=24,elbow=50}})),
		K(1,t({root={y=-.38,z=-.3,yaw=48,pitch=6},torso={yaw=30},head={yaw=-10},ra={raise=86,out=66,twist=-10,elbow=10},la={raise=30,out=-10,elbow=80},lf={z=-.8},rf={z=.8,yaw=40}}),"out"),
		K(2,t({root={y=-.38,z=-.32,yaw=54,pitch=6},torso={yaw=34},ra={raise=84,out=70,elbow=12},la={raise=30,out=-10,elbow=80},lf={z=-.8},rf={z=.8,yaw=40}})),
		K(3,T),
	}
	C.DashAttack={ -- a running thrust, the fan leading
		K(0,t({root={y=-.7,z=.2,pitch=26,yaw=20},torso={pitch=6},ra={raise=40,out=24,twist=10,elbow=110},la={raise=70,out=-6,elbow=30},lf={z=-1.1},rf={z=1.2}})),
		K(1,t({root={y=-.66,z=-.95,pitch=26,yaw=-6},torso={yaw=-12},head={pitch=-14},ra={raise=94,out=-4,elbow=0},la={raise=-26,out=24,elbow=30},lf={z=-1.6},rf={z=1.45,y=.2,toe=-20}}),"out"),
		K(2,t({root={y=-.64,z=-.98,pitch=24,yaw=-8},torso={yaw=-14},ra={raise=92,out=-4,elbow=4},la={raise=-24,out=24,elbow=30},lf={z=-1.6},rf={z=1.45,y=.2,toe=-20}})),
		K(3,T),
	}
	C.Riposte=C.Light1
	C.FlyingKick={ -- out of a full run: a leaping thrust
		K(0,t({root={y=-.5,pitch=18},ra={raise=40,out=20,elbow=110},la={raise=60,out=20,elbow=40},lf={z=-.9},rf={z=1.0}})),
		K(1,t({root={y=-.1,z=-.8,pitch=10},torso={pitch=8},ra={raise=96,out=-4,elbow=2},la={raise=-20,out=30,elbow=20},rl={lift=40,knee=80},lf={z=-1.2,toe=-20}}),"out"),
		K(2,t({root={y=-.12,z=-.82,pitch=10},torso={pitch=8},ra={raise=94,out=-4,elbow=4},la={raise=-20,out=30,elbow=20},rl={lift=36,knee=76},lf={z=-1.2,toe=-18}})),
		K(3,T),
	}
	C.SlideSweep={ -- out of a full run: dropped low, the closed fan reaps the ankles
		K(0,t({root={y=-.9,pitch=20,yaw=30},torso={yaw=20},ra={raise=30,out=70,elbow=20},la={raise=30,out=20,elbow=40},lf={z=-1.0},rf={z=1.1}})),
		K(1,t({root={y=-1.15,pitch=24,yaw=-20},torso={yaw=-30,pitch=10},ra={raise=24,out=-40,elbow=10},la={raise=-10,out=40,elbow=20},lf={z=-1.3},rf={z=1.3}}),"out"),
		K(2,t({root={y=-1.15,pitch=24,yaw=-24},torso={yaw=-34,pitch=10},ra={raise=22,out=-48,elbow=12},la={raise=-10,out=40,elbow=20},lf={z=-1.3},rf={z=1.3}})),
		K(3,T),
	}
	C.WallDive={ -- off the wall: the fan first, the body behind it
		K(0,air({root={pitch=-10},ra={raise=150,out=20,elbow=60},la={raise=100,out=30,elbow=40},rl={lift=80,knee=110},ll={lift=70,knee=100}})),
		K(1,air({root={pitch=36},torso={pitch=20},ra={raise=100,out=-4,elbow=2},la={raise=20,out=40,elbow=30},rl={lift=10,knee=30},ll={lift=30,knee=50}}),"out"),
		K(2,air({root={pitch=38},torso={pitch=22},ra={raise=98,out=-4,elbow=4},la={raise=20,out=40,elbow=30},rl={lift=10,knee=30},ll={lift=30,knee=50}})),
		K(3,T),
	}
	C.Air1={ -- in the air: a sweep from the right
		K(0,air({torso={yaw=-24},ra={raise=100,out=70,elbow=30}})),
		K(1,air({torso={yaw=26,pitch=12},ra={raise=80,out=-30,elbow=10},la={raise=20,out=40,elbow=40}}),"out"),
		K(2,air({torso={yaw=30,pitch=12},ra={raise=78,out=-40,elbow=12},la={raise=20,out=40,elbow=40}})),
		K(3,AIR),
	}
	C.Air2={ -- in the air: the backhand
		K(0,air({torso={yaw=26},ra={raise=80,out=-40,twist=30,elbow=70}})),
		K(1,air({torso={yaw=-28,pitch=10},ra={raise=86,out=64,elbow=10},rl={lift=70,knee=60}}),"out"),
		K(2,air({torso={yaw=-32,pitch=10},ra={raise=84,out=70,elbow=12},rl={lift=66,knee=62}})),
		K(3,AIR),
	}
	C.AirDrive={ -- in the air: the fan driven straight through the body
		K(0,air({root={pitch=-6},ra={raise=50,out=20,elbow=110},la={raise=60,out=10,elbow=60}})),
		K(1,air({root={pitch=14},torso={pitch=12},ra={raise=92,out=-4,elbow=2},la={raise=10,out=40,elbow=30},rl={lift=20,knee=40},ll={lift=70,knee=90}}),"out"),
		K(2,air({root={pitch=14},torso={pitch=12},ra={raise=90,out=-4,elbow=4},la={raise=10,out=40,elbow=30},rl={lift=20,knee=40},ll={lift=70,knee=90}})),
		K(3,AIR),
	}
	C.FanDive={ -- in the air: the open fan beats down, the body under it is driven into the floor
		K(0,air({root={pitch=-14},torso={pitch=-18},ra={raise=172,out=8,elbow=40},la={raise=168,out=-4,elbow=44},rl={lift=70,knee=100},ll={lift=60,knee=96}})),
		K(1,air({root={pitch=34},torso={pitch=30},head={pitch=10},ra={raise=30,out=-6,elbow=8},la={raise=26,out=-10,elbow=12},rl={lift=10,knee=40},ll={lift=20,knee=60}}),"out"),
		K(2,air({root={pitch=36},torso={pitch=30},ra={raise=28,out=-6,elbow=10},la={raise=24,out=-10,elbow=14},rl={lift=10,knee=40},ll={lift=20,knee=60}})),
		K(3,AIR),
	}
	C.Slam={ -- the air heavy: an overhead chop that carries her down
		K(0,air({root={pitch=-10},torso={pitch=-16},ra={raise=176,out=10,elbow=42},la={raise=80,out=30,elbow=50},rl={lift=64,knee=110},ll={lift=58,knee=100}})),
		K(1,air({root={pitch=28},torso={pitch=40},head={pitch=12},ra={raise=40,out=-6,elbow=6},la={raise=40,out=30,elbow=30},rl={lift=-10,knee=40},ll={lift=14,knee=60}}),"out"),
		K(2,air({root={pitch=30},torso={pitch=42},ra={raise=36,out=-6,elbow=8},la={raise=40,out=30,elbow=30},rl={lift=-10,knee=40},ll={lift=14,knee=60}})),
		K(3,t({root={y=-.9,pitch=22},torso={pitch=18}})),
	}
	E.CLIPS.Gale=C
	setmetatable(C,{__index=E.CLIPS.Mirage})
	-- The tool: the fan flicked open from the right and swept across her front.
	E.THROWS.Gust=function(time,release)
		local wind={torso={yaw=34,pitch=-2},head={yaw=-16},ra={raise=86,out=74,twist=-10,elbow=30,wrist=0},la={raise=40,out=10,elbow=60}}
		local snap={torso={yaw=-26,pitch=6},head={yaw=6},ra={raise=88,out=-30,twist=10,elbow=8,wrist=0},la={raise=30,out=30,elbow=50}}
		if time&lt;release then return wind,smooth(time/math.max(release*.7,.02)) end
		if time&lt;release+.28 then return snap,1 end
		return snap,1-smooth((time-release-.28)/.17)
	end
	-- Casts: the fan drawn and opened (one moon, two, all three), then swung.
	local channel={Kamaitachi=.3,GreatGust=.5,Cyclone=.24}
	E.CAST.Kamaitachi=function(actor,base,time,state)
		if state=="TechniqueChannel" then
			local u=smooth(time/channel.Kamaitachi)
			return merge(base,{root={y=-.4,yaw=30+16*u},torso={yaw=30+10*u,pitch=-4},head={yaw=-30},ra={raise=120+30*u,out=50+10*u,twist=-20,elbow=70-10*u},la={raise=60,out=-10,elbow=60},lf={z=-.7},rf={z=.8}})
		end
		return merge(base,{root={y=-.46,yaw=-10,pitch=8},torso={yaw=-34,pitch=6},head={yaw=4},ra={raise=88,out=-50,elbow=8},la={raise=30,out=30,elbow=40},lf={z=-.9},rf={z=.8}})
	end
	E.CAST.GreatGust=function(actor,base,time,state)
		if state=="TechniqueChannel" then
			local u=smooth(time/channel.GreatGust)
			return merge(base,{root={y=-.5-.2*u,yaw=40+14*u},torso={yaw=36+8*u,pitch=-6},head={yaw=-36},ra={raise=140+20*u,out=40,elbow=40},la={raise=130+20*u,out=10,elbow=70},lf={z=-1.1,x=-.2},rf={z=1.0,x=.3,yaw=50}})
		end
		return merge(base,{root={y=-.72,z=-.3,yaw=-20,pitch=14},torso={yaw=-40,pitch=14},head={yaw=8},ra={raise=90,out=-40,elbow=8},la={raise=84,out=-20,elbow=16},lf={z=-1.2},rf={z=1.0}})
	end
	E.CAST.Cyclone=function(actor,base,time,state)
		if state=="TechniqueChannel" then
			-- The open fan held up in front, turned in the wrist: the air starts to spin.
			return merge(base,{root={y=-.5,yaw=10},torso={yaw=-6,pitch=4},head={pitch=-6},ra={raise=110,out=10,elbow=30,wroll=(time*900)%360},la={raise=50,out=20,elbow=60},lf={z=-.8},rf={z=.7}})
		end
		return merge(base,{root={y=-.3,pitch=-4},torso={pitch=-8},head={pitch=-10},ra={raise=150,out=10,elbow=10},la={raise=40,out=30,elbow=50}})
	end
	-- The intro: the fan planted open beside her (GaleFX), her right hand on its
	-- edge, the left on her hip, chin up.
	E.INTRO.Gale=function(base)
		return merge(base,{root={y=-.1,pitch=-3,yaw=10},torso={pitch=-5,yaw=-4},head={pitch=-12,yaw=-10},
			ra={raise=72,out=60,twist=0,elbow=26,wrist=20},la={raise=-8,out=38,twist=-50,elbow=104,wrist=10},rf={x=.14,z=.3},lf={x=-.1,z=-.3}})
	end
end
return GaleMotion
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND135">
          <Properties>
            <string name="Name">IdentityFX</string>
            <ProtectedString name="Source">-- CORE4 identity on the client (mission NEXT_VALIDATION_ROSTER_SCALE §5): what
-- each of the four prodigies does differently must be seen, not read in numbers.
-- Every cue answers a server fact (the contact feed and the snapshot).
--   Neji    the palm lands on the very chakra point it closes (an open palm
--           printed there, not a fist burst at the body's centre); a blocked
--           palm still shows the chakra it drained; the closed points keep a
--           marker readable at any distance; 64 Palms counts 2-4-8-16-32-64 over
--           the victim for both players and the last palm throws the body; the
--           palms stay lit while the Rotation counter is open; a body a Vacuum
--           Palm drives into a wall leaves the air's palm print on the stone.
--   Minato  a planted kunai, a floor formula and a body mark look apart; the
--           arrival window rings under him; an arrival strike that carries the
--           combo through the jump links in gold; the Rasengan grinds where it
--           lands; Yellow Flash draws its thread back to the return seal.
--   Itachi  the Read stance turns its tomoe at his feet; a read draws the line
--           from his eyes to the swing and the counter window closes under him;
--           a caught image lights the real body; ricochet and Geometry paths
--           flash; his fire lane is one scorched strip across the field.
--   Sasuke  the curse spreads from the neck as it takes him (across the face
--           when it starves); the Dancing Leaf's shadow and the vault's arc; the
--           Phoenix Flower's hidden steel glints out of the flames; a Chidori
--           bursts along its line, or fizzles when it finds nothing.
-- One identity layer installed into Effects (like SandFX and LeeFX): Effects
-- only offers the registry and its helpers. Presentation only: nothing here can
-- change gameplay.
local Debris=game:GetService("Debris")

local IdentityFX={}
local K -- Effects' helpers, handed over by install()
local Kit=require(script.Parent.VfxKit)
IdentityFX.clock=os.clock -- (headless tests drive time)

local HYUGA=Color3.fromRGB(190,208,255)
local HYUGA_CORE=Color3.fromRGB(240,246,255)
local HYUGA_DEEP=Color3.fromRGB(110,140,230)

local function find(folder,id) return folder and id and folder:FindFirstChild(id) end
local function rootOf(model) return model and model:FindFirstChild("HumanoidRootPart") end
local function flatUnit(v,fallback)
	local f=Vector3.new(v.X,0,v.Z)
	return if f.Magnitude&gt;.05 then f.Unit else (fallback or Vector3.zAxis)
end
local function stateOf(fx,model)
	fx.identityState=fx.identityState or setmetatable({},{__mode="k"})
	local st=fx.identityState[model]
	if not st then st={};fx.identityState[model]=st end
	return st
end
local function fade(part,time,grow)
	K.tween(part,time,{Transparency=1,Size=part.Size*(grow or 1)})
end
-- A straight line of light from one point to another that fades at once: a
-- path shown for a beat (a prediction, a ricochet, the body behind an image).
local function streak(fx,from,to,color,width,life,name)
	local delta=to-from
	if delta.Magnitude&lt;.3 then return nil end
	local line=K.block(fx.folder,Vector3.new(width,width,delta.Magnitude),CFrame.lookAt(from:Lerp(to,.5),to),color,Enum.Material.Neon)
	line.Name=name or "Streak";line.Transparency=.15
	K.tween(line,life,{Transparency=1,Size=Vector3.new(width*.2,width*.2,delta.Magnitude)})
	Debris:AddItem(line,life+.05)
	return line
end

-- ------------------------------------------------------------------- Neji
-- An open palm laid on a point, facing `normal` (out of the body, toward the
-- striker): the heel of the hand, four fingers and the thumb. It flares, then
-- sinks into the body: the strike reaches the network, it does not shatter.
local FINGERS={{-.21,.34},{-.07,.42},{.07,.44},{.21,.36}}
local function palmPrint(fx,at,normal,scale,transparency,life)
	local base=CFrame.lookAt(at,at+normal)
	local model=K.new("Model",{Name="PalmPrint"},fx.folder)
	local function piece(size,offset)
		local p=K.block(model,size*scale,base*offset,HYUGA_CORE,Enum.Material.Neon)
		p.Transparency=transparency
		fade(p,life,1.3)
	end
	piece(Vector3.new(.62,.56,.03),CFrame.new(0,-.06*scale,0))
	for _,f in FINGERS do piece(Vector3.new(.11,f[2],.03),CFrame.new(f[1]*scale,(.22+f[2]/2)*scale,0)) end
	piece(Vector3.new(.12,.32,.03),CFrame.new(-.4*scale,-.02*scale,0)*CFrame.Angles(0,0,math.rad(42)))
	Debris:AddItem(model,life+.05)
	return model,base
end
-- The point that took the palm: the chakra point it closed, else the chest
-- facing the striker. Returns the point and the outward normal.
local function struckPoint(fx,data,folder)
	local victim=find(folder,data.victim)
	local striker=rootOf(find(folder,data.owner))
	local at=nil
	if victim and data.point then at=fx.tenketsuWorld(victim,data.point) end
	local center=rootOf(victim)
	local from=if striker then striker.Position elseif data.direction then (data.position-data.direction*4) else nil
	local normal=if from then flatUnit(from-(at or data.position)) else Vector3.zAxis
	if not at then at=(if center then center.Position else data.position)+normal*.6+Vector3.new(0,.35,0) end
	return at,normal
end
-- The striking hand flares with the chakra it just released.
local function handFlare(fx,folder,owner,at,color)
	local model=find(folder,owner)
	local best,gap=nil,math.huge
	for _,name in {"RightHand","LeftHand"} do
		local hand=model and model:FindFirstChild(name)
		if hand then
			local d=(hand.Position-at).Magnitude
			if d&lt;gap then best,gap=hand,d end
		end
	end
	if best then K.flash(fx.folder,best.Position,color,.2,1.3,.14,.1) end
	return best
end
-- A palm on the network (the melee palms, the 64 Palms, the chakra palm).
local function palmCue(fx,data,folder)
	local at,normal=struckPoint(fx,data,folder)
	local heavy=data.heavy==true
	palmPrint(fx,at,normal,if heavy then 1.6 else 1,if heavy then 0 else .1,if heavy then .32 else .22)
	K.flash(fx.folder,at,HYUGA_CORE,.15,if heavy then 2.4 else 1.3,.12,0)
	-- Through the body: the chakra goes in, it does not bounce off.
	local line=K.block(fx.folder,Vector3.new(.07,.07,1.5),CFrame.lookAt(at,at+normal)*CFrame.new(0,0,.75),HYUGA,Enum.Material.Neon)
	line.Name="PalmThrough";line.Transparency=.2
	fade(line,.18)
	Debris:AddItem(line,.22)
	K.shockRing(fx.folder,at,HYUGA,.3,if heavy then 6 else 2.6,.2,normal)
	handFlare(fx,folder,data.owner,at,HYUGA)
	if heavy then
		-- The palm that throws the body: the air in front of it bursts the way it flies.
		local along=flatUnit(data.direction or -normal,-normal)
		K.shockRing(fx.folder,at+along*1.2,HYUGA_CORE,2,12,.3,along)
		K.sound(K.anchorPart(fx.folder,at),K.SOUND.heavy,.4,.7)
	end
	return at,normal
end
-- A palm stopped by a guard still drains: a faint print on the guard and the
-- chakra pulled out of the body into the striking hand.
local function drainCue(fx,data,folder)
	local victim=rootOf(find(folder,data.victim))
	local striker=find(folder,data.owner)
	if not victim then return end
	local normal=flatUnit((rootOf(striker) or victim).Position-victim.Position)
	local at=victim.Position+normal*1.1+Vector3.new(0,.3,0)
	palmPrint(fx,at,normal,1.15,.55,.2)
	local hand=handFlare(fx,folder,data.owner,at,HYUGA_DEEP)
	local target=if hand then hand.Position else at+normal*2
	local holder=K.new("Model",{Name="ChakraDrain"},fx.folder)
	for k=1,math.clamp(math.floor((data.drain or 3)+.5),2,6) do
		local start=victim.Position+Vector3.new((k%3-1)*.5,.2+(k%2)*.4,0)
		local wisp=K.block(holder,Vector3.one*.18,CFrame.new(start),HYUGA,Enum.Material.Neon)
		wisp.Shape=Enum.PartType.Ball;wisp.Transparency=.15
		K.tween(wisp,.28,{CFrame=CFrame.new(target),Transparency=1,Size=Vector3.one*.06})
	end
	Debris:AddItem(holder,.35)
end
-- 64 Palms: the count every palm calls (2, 4, 8 ... 64) over the victim, the
-- same for both players; a ring under Neji at each new call; it holds a beat
-- on the throwing palm, then clears.
local function countCue(fx,data,folder)
	local victim=find(folder,data.victim)
	local head=victim and (victim:FindFirstChild("Head") or rootOf(victim))
	if not head then return end
	local st=stateOf(fx,victim)
	local board=st.palmCount
	if not board or not board.gui.Parent then
		local gui=K.new("BillboardGui",{Name="PalmCount",Size=UDim2.fromOffset(150,84),StudsOffset=Vector3.new(0,3.4,0),AlwaysOnTop=true,LightInfluence=0,Adornee=head},fx.folder)
		local number=K.new("TextLabel",{Name="Count",Size=UDim2.fromScale(1,.68),BackgroundTransparency=1,Font=Enum.Font.Bangers,TextScaled=true,
			TextColor3=HYUGA_CORE,TextStrokeColor3=Color3.fromRGB(26,34,70),TextStrokeTransparency=.1,Text=""},gui)
		K.new("TextLabel",{Name="Palms",Position=UDim2.fromScale(0,.66),Size=UDim2.fromScale(1,.34),BackgroundTransparency=1,Font=Enum.Font.GothamBlack,TextScaled=true,
			TextColor3=HYUGA,TextStrokeColor3=Color3.fromRGB(26,34,70),TextStrokeTransparency=.3,Text="PALMS"},gui)
		board={gui=gui,number=number,shown=0}
		st.palmCount=board
	end
	st.palmCountAt=IdentityFX.clock()
	local count=data.count or 0
	board.number.Text=tostring(count)
	if count~=board.shown then
		board.shown=count
		-- Each new call lands a little bigger.
		board.gui.Size=UDim2.fromOffset(150+count*.9,84+count*.5)
		local neji=rootOf(find(folder,data.owner))
		if neji then
			local floor=K.floorUnder(fx,neji.Position,2,10)
			local y=if floor then floor.Position.Y+.06 else neji.Position.Y-2.9
			local size=3+math.log(math.max(count,2),2)*1.6
			K.shockRing(fx.folder,Vector3.new(neji.Position.X,y,neji.Position.Z),if data.final then HYUGA_CORE else HYUGA,size*.6,size*2,.28)
		end
	end
	if data.final then
		board.number.TextColor3=Color3.fromRGB(255,255,255)
		st.palmCountAt=IdentityFX.clock()+.6
	end
end
-- Wall hit: what drove the body into the stone. Neji's air pressure (a Vacuum
-- Palm, the twin palm, the throwing 64th) leaves a big palm print on the wall.
local PRESSURE={VacuumPalm=true,PalmThrust=true,SixtyFourPalms=true,Light3=true,AirDrive=true}
local function wallCue(fx,data)
	if data.by~="GentleFist" or not PRESSURE[data.cause or ""] then return end
	local normal=data.normal or Vector3.zAxis
	local at=data.position+normal*.1+Vector3.new(0,.6,0)
	palmPrint(fx,at,normal,4,.05,.45)
	for k=1,3 do K.shockRing(fx.folder,data.position+normal*.12,HYUGA,1+k,6+k*4,.25+k*.08,normal) end
	K.smokePuff(fx.folder,data.position+normal,Color3.fromRGB(226,232,246),14,2)
end
-- The twin palm out of Rotation releases the dome's chakra the palms held: a
-- ring the size of the dome closes onto the palm and bursts out of the body.
local function trigramRelease(fx,data,folder,at,normal)
	local neji=rootOf(find(folder,data.owner))
	if neji then K.shockRing(fx.folder,neji.Position-Vector3.new(0,.6,0),HYUGA,12,3,.2) end
	K.shockRing(fx.folder,at,HYUGA_CORE,1,9,.3,normal)
	local burst=K.new("Model",{Name="TrigramRelease"},fx.folder)
	for k=0,7 do
		local a=k/8*math.pi*2
		local ray=K.block(burst,Vector3.new(.08,.08,1.4),CFrame.lookAt(at,at-normal)*CFrame.Angles(0,0,a)*CFrame.Angles(math.rad(70),0,0)*CFrame.new(0,0,-.9),HYUGA,Enum.Material.Neon)
		ray.Transparency=.15
		fade(ray,.22,1.5)
	end
	Debris:AddItem(burst,.3)
end
local function nejiImpact(fx,data,folder)
	local style=data.style
	if style=="palm" then
		local at,normal=palmCue(fx,data,folder)
		if data.variant=="TrigramCounter" then trigramRelease(fx,data,folder,at,normal) end
		if data.count then countCue(fx,data,folder) end
		-- A chakra palm (ChakraCombat) keeps its own layer on top.
		return data.chakra==nil
	end
	if style=="block" and data.drain and data.fighter=="GentleFist" then drainCue(fx,data,folder);return false end
	if style=="wall" then wallCue(fx,data);return false end
	return false
end
-- Every closed point gets a marker of constant screen size, drawn over the
-- body: the network closing reads from any distance, for both players.
local function tenketsuMarks(fx,model,actor)
	local aura=fx.auras and fx.auras[model]
	if not aura or not aura.points then return end
	local severe=actor.tenketsuSevere==true
	for _,entry in aura.points do
		local dot=entry.dot
		if dot and dot.Parent then
			local mark=entry.mark
			if not mark or not mark.Parent then
				local gui=K.new("BillboardGui",{Name="TenketsuMark",Size=UDim2.fromOffset(12,12),AlwaysOnTop=true,LightInfluence=0,Adornee=dot},dot)
				local disc=K.new("Frame",{Name="Point",Size=UDim2.fromScale(1,1),BackgroundColor3=HYUGA,BorderSizePixel=0,BackgroundTransparency=.1},gui)
				K.new("UICorner",{CornerRadius=UDim.new(1,0)},disc)
				K.new("UIStroke",{Color=HYUGA_CORE,Thickness=1.5},disc)
				entry.mark=gui;entry.markDisc=disc
				mark=gui
			end
			entry.mark.Size=if severe then UDim2.fromOffset(16,16) else UDim2.fromOffset(12,12)
			entry.markDisc.BackgroundColor3=if severe then HYUGA_CORE else HYUGA
		end
	end
end
-- Rotation repelled a strike: until the counter is spent, Neji's palms hold the
-- dome's chakra (the twin palm that glides out of the spin releases it).
local function counterGlow(fx,model,actor,st)
	local open=actor.fighterId=="GentleFist" and (actor.counter or 0)&gt;0 and (actor.health or 1)&gt;0
	if open and not st.counterGlow then
		local glow={}
		for _,name in {"RightHand","LeftHand"} do
			local hand=model:FindFirstChild(name)
			if hand then
				local at=K.new("Attachment",{Name="CounterPalmGlow"},hand)
				K.new("PointLight",{Color=HYUGA,Brightness=2.4,Range=6,Shadows=false},at)
				K.new("ParticleEmitter",{Texture=K.TEX.glow,Rate=24,Lifetime=NumberRange.new(.12,.2),Speed=NumberRange.new(0,.5),LockedToPart=true,
					Color=ColorSequence.new(HYUGA),LightEmission=1,LightInfluence=0,Size=K.num({{0,1},{1,.3}}),Transparency=K.num({{0,.3},{1,1}})},at)
				table.insert(glow,at)
			end
		end
		st.counterGlow=glow
		local root=rootOf(model)
		if root then K.shockRing(fx.folder,root.Position-Vector3.new(0,2.6,0),HYUGA,12,2,.25) end
	elseif not open and st.counterGlow then
		for _,at in st.counterGlow do at:Destroy() end
		st.counterGlow=nil
	end
end
-- Any body can carry closed points and a 64 Palms count; only Neji glows.
local function networkFrame(fx,model,actor,st)
	tenketsuMarks(fx,model,actor)
	counterGlow(fx,model,actor,st)
	-- A 64 Palms count left over (the flurry cut short, or the throw held its beat).
	local board=st.palmCount
	if board and IdentityFX.clock()-(st.palmCountAt or 0)&gt;.6 then
		board.gui:Destroy();st.palmCount=nil
	end
end

-- ----------------------------------------------------------------- Minato
local MINATO=Color3.fromRGB(255,214,92)
local MINATO_CORE=Color3.fromRGB(255,248,214)
local WIND=Color3.fromRGB(190,255,226)
local RASENGAN=Color3.fromRGB(150,210,255)
local RASENGAN_CORE=Color3.fromRGB(235,250,255)
-- Three kinds of Flying Thunder God seal, three looks (Effects draws the kunai
-- and its disc; this adds what tells them apart):
--   planted kunai  a thrown marked kunai stuck in a surface: a gold beacon
--                  stands over it, seen across the stadium;
--   floor formula  the Yellow Flash return seal written where he stood (no
--                  kunai): the formula drawn on the floor, white-gold, turning;
--   body mark      a seal riding on the opponent (a marked kunai that hit, the
--                  rising kick, a wind cut): a ring of formula round the body,
--                  seen from the front as from the back, tightening as it expires.
local function segmentRing(parent,count,radius,size,color)
	local parts={}
	for _=1,count do
		local p=K.block(parent,size,CFrame.new(),color,Enum.Material.Neon)
		p.Transparency=.25
		table.insert(parts,p)
	end
	return parts
end
local function placeRing(parts,center,radius,spin,tilt)
	for i,p in parts do
		local a=(i-1)/#parts*math.pi*2+spin
		p.CFrame=center*CFrame.Angles(tilt or 0,a,0)*CFrame.new(0,0,-radius)
	end
end
local function buildSeal(fx,info)
	local model=K.new("Model",{Name="SealMark"},fx.folder)
	local look={model=model}
	if info.body then
		look.kind="body"
		look.ring=segmentRing(model,8,1.6,Vector3.new(.5,.09,.07),if info.wind then WIND else MINATO)
		look.tags=segmentRing(model,3,1.75,Vector3.new(.08,.5,.08),if info.wind then WIND else MINATO_CORE)
	elseif info.wake then
		look.kind="floor"
		look.ring=segmentRing(model,16,2.5,Vector3.new(.85,.04,.12),MINATO_CORE)
		look.strokes=segmentRing(model,8,1.5,Vector3.new(.1,.04,.7),MINATO)
		local cross={}
		for _,yaw in {0,math.pi/2} do
			local p=K.block(model,Vector3.new(1.4,.04,.14),CFrame.new(),MINATO_CORE,Enum.Material.Neon);p.Transparency=.2
			table.insert(cross,{part=p,yaw=yaw})
		end
		look.cross=cross
		K.flash(fx.folder,info.surface,MINATO_CORE,.6,5,.25,.2)
	else
		look.kind="kunai"
		local beam=K.block(model,Vector3.new(.14,7,.14),CFrame.new(),MINATO,Enum.Material.Neon)
		beam.Name="SealBeacon";beam.Transparency=.6
		look.beacon=beam
	end
	return look
end
local function stepSeal(fx,folder,look,info,clock)
	local remaining=info.remaining or 12
	local ending=remaining&lt;1 and math.sin(clock*30)&gt;0
	if look.kind=="body" then
		local body=folder and folder:FindFirstChild(info.body or "")
		local torso=body and (body:FindFirstChild("UpperTorso") or rootOf(body))
		if not torso then return end
		-- Round the waist, turning: wherever the camera stands it crosses the body.
		local center=CFrame.new(torso.Position-Vector3.new(0,.35,0))
		local radius=1.25+.45*math.clamp(remaining/1.5,0,1)
		placeRing(look.ring,center,radius,clock*2.2)
		placeRing(look.tags,center,radius+.15,-clock*1.4)
		for _,p in look.ring do p.Transparency=if ending then .9 else .25 end
	elseif look.kind=="floor" then
		local at=info.surface+(info.normal or Vector3.yAxis)*.06
		local base=CFrame.new(at)
		placeRing(look.ring,base,2.5,clock*.35)
		placeRing(look.strokes,base,1.5,-clock*.6)
		for _,c in look.cross do c.part.CFrame=base*CFrame.Angles(0,c.yaw+clock*.35,0) end
		local glow=if ending then .9 else .2+.15*math.sin(clock*4)
		for _,p in look.ring do p.Transparency=glow end
	else
		-- The beacon stands up from the kunai, whatever surface holds it.
		local at=info.surface+(info.normal or Vector3.yAxis)*.3
		look.beacon.CFrame=CFrame.new(at+Vector3.new(0,3.6,0))
		look.beacon.Transparency=if ending then .95 else .55+.15*math.sin(clock*5)
	end
end
local function sealFrame(fx,model,actor,clock)
	fx.identitySeals=fx.identitySeals or {}
	local folder=model.Parent
	local live={}
	for _,info in actor.seals or {} do
		local key=tostring(actor.id)..":"..tostring(info.id)
		live[key]=true
		local look=fx.identitySeals[key]
		if not look or not look.model.Parent then look=buildSeal(fx,info);fx.identitySeals[key]=look end
		stepSeal(fx,folder,look,info,clock)
	end
	local prefix=tostring(actor.id)..":"
	for key,look in fx.identitySeals do
		if string.sub(key,1,#prefix)==prefix and not live[key] then look.model:Destroy();fx.identitySeals[key]=nil end
	end
end
-- After a teleport the arrival window is open (a strike or Rasengan cancels the
-- recovery): a gold ring under him shrinks to nothing as it closes.
local function arrivalRing(fx,model,actor,st,clock)
	local root=rootOf(model)
	if actor.flash and root and (actor.health or 1)&gt;0 then
		if not st.arrival or not st.arrival.ring.Parent then
			local ring=K.block(fx.folder,Vector3.new(.06,5,5),CFrame.new(),MINATO,Enum.Material.Neon)
			ring.Name="ArrivalWindow";ring.Shape=Enum.PartType.Cylinder;ring.Transparency=.35
			st.arrival={ring=ring,born=clock,window=if (actor.awaken or 0)&gt;0 then .8 else .55}
		end
		local left=1-math.clamp((clock-st.arrival.born)/st.arrival.window,0,1)
		local size=1+4*left
		st.arrival.ring.Size=Vector3.new(.06,size,size)
		st.arrival.ring.CFrame=CFrame.new(root.Position-Vector3.new(0,2.85,0))*CFrame.Angles(0,0,math.pi/2)
	elseif st.arrival then
		st.arrival.ring:Destroy();st.arrival=nil
	end
end
-- Yellow Flash: a thin gold thread from him to his newest return seal, the way
-- back the next jump takes (A -&gt; B -&gt; A).
local function returnThread(fx,model,actor,st)
	local awake=(actor.awaken or 0)&gt;0 and (actor.health or 1)&gt;0
	local newest=nil
	if awake then
		for _,info in actor.seals or {} do
			if info.wake and info.surface and (not newest or info.id&gt;newest.id) then newest=info end
		end
	end
	local torso=model:FindFirstChild("UpperTorso") or rootOf(model)
	if newest and torso then
		local thread=st.thread
		if not thread or not thread.anchor.Parent then
			if thread then thread.a0:Destroy() end
			local anchor=K.anchorPart(fx.folder,newest.surface);anchor.Name="ReturnSeal"
			local a0=K.new("Attachment",{Name="ReturnThread"},torso)
			local a1=K.new("Attachment",{},anchor)
			local beam=K.new("Beam",{Name="ReturnThread",Attachment0=a0,Attachment1=a1,Width0=.12,Width1=.3,FaceCamera=true,Segments=1,
				Color=ColorSequence.new(MINATO),LightEmission=1,Transparency=K.num({{0,.35},{1,.55}})},anchor)
			thread={anchor=anchor,a0=a0,beam=beam,id=newest.id}
			st.thread=thread
		end
		if thread.id~=newest.id then thread.anchor.CFrame=CFrame.new(newest.surface+Vector3.new(0,.3,0));thread.id=newest.id end
	elseif st.thread then
		st.thread.anchor:Destroy();st.thread.a0:Destroy();st.thread=nil
	end
end
-- The arrival strike landed on a body still inside the combo that led to the
-- jump: a gold link where it lands, the chain visibly goes on.
local function chainCue(fx,data,folder)
	local at=data.position
	local striker=rootOf(find(folder,data.owner))
	local along=if striker then flatUnit(at-striker.Position) else Vector3.zAxis
	K.shockRing(fx.folder,at,MINATO_CORE,1.5,7,.24,along)
	K.shockRing(fx.folder,at,MINATO,3,11,.32,along)
	K.sparks(fx.folder,at,MINATO,16,22)
	if striker then streak(fx,striker.Position,at,MINATO,.25,.18,"ChainLink") end
end
-- Rasengan where it lands: the sphere grinds into the body (rings turning on
-- every axis), not a punch flash.
local function grindCue(fx,data)
	local at=data.position
	local model=K.new("Model",{Name="RasenganGrind"},fx.folder)
	for k=1,3 do
		local ring=K.block(model,Vector3.new(.08,1.6,1.6),CFrame.new(at)*CFrame.Angles(k*1.1,k*.7,k*1.9),if k==1 then RASENGAN_CORE else RASENGAN,Enum.Material.Neon)
		ring.Shape=Enum.PartType.Cylinder;ring.Transparency=.2
		K.tween(ring,.32,{Size=Vector3.new(.03,5.5,5.5),Transparency=1,CFrame=ring.CFrame*CFrame.Angles(math.pi,0,0)})
	end
	K.flash(fx.folder,at,RASENGAN_CORE,1,5,.2,0)
	K.sparks(fx.folder,at,RASENGAN,24,26)
	Debris:AddItem(model,.4)
	if Kit.has("slash") then
		-- (Reference quality) the sphere grinds: crescents of wind whirl round
		-- the contact, a star, and the floor under it cracks and blows out.
		Kit.star(fx.folder,at,8,RASENGAN_CORE,.12)
		for k=1,4 do
			local cf=CFrame.new(at)*CFrame.Angles(math.rad(70+k*8),k*math.pi/2,0)
			Kit.plane(fx.folder,cf,"slash",Vector2.new(3,1.5),Vector2.new(9,4.5),.22+k*.03,if k%2==0 then RASENGAN_CORE else RASENGAN,0)
		end
		Kit.streaks(fx.folder,at,data.direction or Vector3.zAxis,12,RASENGAN_CORE,70,60)
		local floor=Kit.floorUnder(at,{fx.folder},8)
		if floor then
			Kit.ground(fx.folder,floor.Position,floor.Normal,"crack",8,2,1,Color3.new(1,1,1),.1)
			Kit.dust(fx.folder,floor.Position,7,2.6,Color3.fromRGB(222,214,196),16)
		end
	end
end
local function minatoImpact(fx,data,folder)
	if data.arrival then chainCue(fx,data,folder) end
	if data.variant=="Rasengan" or data.variant=="RasenganDrop" then grindCue(fx,data) end
	return false
end
local function minatoFrame(fx,model,actor,st,clock)
	sealFrame(fx,model,actor,clock)
	arrivalRing(fx,model,actor,st,clock)
	returnThread(fx,model,actor,st)
end

-- ----------------------------------------------------------------- Itachi
local SHARINGAN=Color3.fromRGB(230,36,44)
local SHARINGAN_DEEP=Color3.fromRGB(150,16,26)
local EMBER=Color3.fromRGB(255,128,44)
-- Read stance: three tomoe turn round his feet while the eye waits for the
-- blow. The attacker sees it too: swinging into it is his choice.
local function tomoeRing(fx,model,actor,st,clock)
	local root=rootOf(model)
	if (actor.read or 0)&gt;0 and root and (actor.health or 1)&gt;0 then
		if not st.tomoe or not st.tomoe.model.Parent then
			local holder=K.new("Model",{Name="ReadTomoe"},fx.folder)
			local ring=K.block(holder,Vector3.new(.05,4.6,4.6),CFrame.new(),SHARINGAN,Enum.Material.Neon)
			ring.Shape=Enum.PartType.Cylinder;ring.Transparency=.7
			local marks={}
			for _=1,3 do
				local head=K.block(holder,Vector3.one*.42,CFrame.new(),SHARINGAN_DEEP,Enum.Material.Neon);head.Shape=Enum.PartType.Ball
				local tail=K.block(holder,Vector3.new(.14,.06,.5),CFrame.new(),SHARINGAN_DEEP,Enum.Material.Neon)
				table.insert(marks,{head=head,tail=tail})
			end
			st.tomoe={model=holder,ring=ring,marks=marks}
		end
		local base=CFrame.new(root.Position-Vector3.new(0,2.85,0))
		st.tomoe.ring.CFrame=base*CFrame.Angles(0,0,math.pi/2)
		for k,m in st.tomoe.marks do
			local at=base*CFrame.Angles(0,clock*3+k*2*math.pi/3,0)*CFrame.new(0,.05,-1.75)
			m.head.CFrame=at;m.tail.CFrame=at*CFrame.new(.28,0,.12)*CFrame.Angles(0,math.rad(-50),0)
		end
	elseif st.tomoe then
		st.tomoe.model:Destroy();st.tomoe=nil
	end
end
-- A read paid off: a red ring under him shrinks with the counter window (the
-- snapshot's counter is the time left), the punish is now.
local function counterWindow(fx,model,actor,st)
	local root=rootOf(model)
	local left=actor.counter or 0
	if left&gt;0 and root and (actor.health or 1)&gt;0 then
		if not st.window or not st.window.Parent then
			local ring=K.block(fx.folder,Vector3.new(.06,5,5),CFrame.new(),SHARINGAN,Enum.Material.Neon)
			ring.Name="CounterWindow";ring.Shape=Enum.PartType.Cylinder;ring.Transparency=.35
			st.window=ring
		end
		local size=1+4*math.clamp(left,0,1)
		st.window.Size=Vector3.new(.06,size,size)
		st.window.CFrame=CFrame.new(root.Position-Vector3.new(0,2.85,0))*CFrame.Angles(0,0,math.pi/2)
	elseif st.window then
		st.window:Destroy();st.window=nil
	end
end
local function itachiImpact(fx,data,folder)
	local style=data.style
	if style=="read" and data.phase~="whiff" then
		-- He saw it coming: a line from his eyes to the body that swung.
		local reader=find(folder,data.owner)
		local head=reader and reader:FindFirstChild("Head")
		local swing=rootOf(find(folder,data.victim))
		if head and swing then
			streak(fx,head.Position,swing.Position+Vector3.new(0,.6,0),SHARINGAN,.07,.3,"ReadLine")
			K.flash(fx.folder,swing.Position+Vector3.new(0,.6,0),SHARINGAN,.3,2.2,.16,.25)
		end
	elseif style=="mirage" and data.phase=="catch" then
		-- The image breaks: the real body behind it lights for a beat.
		local caster=rootOf(find(folder,data.owner))
		if caster then
			streak(fx,data.position,caster.Position,SHARINGAN,.12,.3,"MirageReveal")
			K.flash(fx.folder,caster.Position,SHARINGAN,.5,3.5,.2,.2)
		end
	elseif style=="deflect" and data.ricochet and data.to then
		-- A ricochet: its new path flashes from the bounce to the body it seeks.
		streak(fx,data.position,data.to,Color3.fromRGB(255,236,236),.1,.25,"RicochetPath")
		K.shockRing(fx.folder,data.position,SHARINGAN,.5,3.2,.18,data.direction)
	elseif style=="clash" and data.geometry and data.to then
		-- Shuriken Geometry: the two blades' meeting sends them into the flank.
		for _,side in {-.6,.6} do
			local across=flatUnit(data.to-data.position):Cross(Vector3.yAxis)*side
			streak(fx,data.position,data.to+across,Color3.fromRGB(255,236,236),.08,.25,"GeometryPath")
		end
	end
	return false
end
-- Itachi's burning lane (Elements.burnLane): the patches of one lane share a
-- scorched strip from the first to the last, so it reads as a line across the
-- field, not as scattered fires.
local function laneFrame(fx,data)
	fx.identityLanes=fx.identityLanes or {}
	local lanes={}
	for _,h in data.hazards or {} do
		if h.lane then
			local lane=lanes[h.lane] or {}
			table.insert(lane,h)
			lanes[h.lane]=lane
		end
	end
	for id,patches in lanes do
		local strip=fx.identityLanes[id]
		local first,last=patches[1].position,patches[#patches].position
		local span=Vector3.new(last.X-first.X,0,last.Z-first.Z)
		if #patches&gt;=2 and span.Magnitude&gt;.5 and (not strip or strip.count~=#patches or not strip.model.Parent) then
			if strip then strip.model:Destroy() end
			local model=K.new("Model",{Name="FireLane"},fx.folder)
			local width=patches[1].radius*1.5
			local along=CFrame.lookAt(first:Lerp(last,.5)-Vector3.new(0,.42,0),last-Vector3.new(0,.42,0))
			local scorch=K.block(model,Vector3.new(width,.05,span.Magnitude+width),along,Color3.fromRGB(32,22,18),Enum.Material.Slate)
			scorch.Transparency=.25
			for _,side in {-1,1} do
				local edge=K.block(model,Vector3.new(.12,.06,span.Magnitude+width*.8),along*CFrame.new(side*width*.5,.02,0),EMBER,Enum.Material.Neon)
				edge.Transparency=.3
			end
			strip={model=model,count=#patches}
			fx.identityLanes[id]=strip
		end
	end
	for id,strip in fx.identityLanes do
		if not lanes[id] then strip.model:Destroy();fx.identityLanes[id]=nil end
	end
end
local function itachiFrame(fx,model,actor,st,clock)
	tomoeRing(fx,model,actor,st,clock)
	if actor.fighterId=="Mirage" then counterWindow(fx,model,actor,st) end
end

-- ----------------------------------------------------------------- Sasuke
local CURSE=Color3.fromRGB(120,60,200)
local CURSE_INK=Color3.fromRGB(14,10,18)
local SHADOW=Color3.fromRGB(40,44,74)
local CHIDORI=Color3.fromRGB(190,220,255)
local CHIDORI_CORE=Color3.fromRGB(236,244,255)
-- The cursed seal spreads out of the neck as the awakening takes him, one
-- flame mark after another (the dress keeps three at the seal itself), and on
-- across the face while it starves. {part, offset}: the offset's Z axis is the
-- surface normal (front faces -Z, the left side turned a quarter).
local SIDE=CFrame.Angles(0,math.pi/2,0)
local CURSE_SPREAD={
	{"Head",CFrame.new(-.77,-.12,-.3)*SIDE*CFrame.Angles(0,0,math.rad(20))},
	{"Head",CFrame.new(-.77,.16,-.5)*SIDE*CFrame.Angles(0,0,math.rad(40))},
	{"UpperTorso",CFrame.new(-.75,.6,-.51)*CFrame.Angles(0,0,math.rad(-15))},
	{"Head",CFrame.new(-.5,.32,-.77)*CFrame.Angles(0,0,math.rad(55))},
	{"UpperTorso",CFrame.new(-1.01,.35,-.15)*SIDE},
	{"UpperTorso",CFrame.new(-.45,.25,-.51)*CFrame.Angles(0,0,math.rad(25))},
	{"LeftUpperArm",CFrame.new(-.05,.3,-.41)},
	{"LeftUpperArm",CFrame.new(-.41,0,-.05)*SIDE*CFrame.Angles(0,0,math.rad(15))},
	{"LeftUpperArm",CFrame.new(-.05,-.32,-.41)},
	-- Hunger: the curse reaches across the face.
	{"Head",CFrame.new(-.2,.48,-.77)*CFrame.Angles(0,0,math.rad(70)),hunger=true},
	{"Head",CFrame.new(.12,-.36,-.77)*CFrame.Angles(0,0,math.rad(-30)),hunger=true},
}
IdentityFX.CURSE_SPREAD=CURSE_SPREAD
local SPREAD_STEP=.09
local function curseSpread(fx,model,actor,st,clock)
	local awake=(actor.awaken or 0)&gt;0 and (actor.health or 1)&gt;0
	if not awake then
		if st.curse then for _,mark in st.curse.marks do mark:Destroy() end;st.curse=nil end
		return
	end
	if not st.curse then
		local marks={}
		for i,spec in CURSE_SPREAD do
			local body=model:FindFirstChild(spec[1])
			if body then
				local mark=K.block(model,Vector3.new(.12,.34,.04),body.CFrame*spec[2],CURSE_INK,Enum.Material.SmoothPlastic)
				mark.Name="CurseSpread";mark.Anchored=false;mark.Massless=true;mark.Transparency=1
				K.new("WeldConstraint",{Part0=body,Part1=mark},mark)
				marks[i]=mark
			end
		end
		st.curse={marks=marks,born=clock}
	end
	local hungry=actor.curseHunger==true
	local pulse=math.sin(clock*18)&gt;0
	for i,mark in st.curse.marks do
		local spec=CURSE_SPREAD[i]
		local shown=clock-st.curse.born&gt;=(i-1)*SPREAD_STEP and (not spec.hunger or hungry)
		mark.Transparency=if shown then 0 else 1
		mark.Material=if hungry and pulse then Enum.Material.Neon else Enum.Material.SmoothPlastic
		mark.Color=if hungry and pulse then CURSE else CURSE_INK
	end
end
-- Shadow of the Dancing Leaf: a dark shadow chain glued under the rising body
-- while he follows it up (the heavy up there is the Lion Combo); the vault kick
-- draws its arc over the opponent.
local function shadowLeaf(fx,model,actor,st,clock)
	if actor.state=="Pursuit" and (actor.lion or 0)&gt;0 then
		if clock-(st.shadowAt or -1)&gt;=.07 then st.shadowAt=clock;fx:ghost(model,SHADOW,.3,.45) end
	end
	local aura=fx.auras and fx.auras[model]
	if aura and aura.trail and actor.attackName=="VaultKick" and (actor.state=="Startup" or actor.state=="Active") then aura.trail.Enabled=true end
end
-- Chidori: a thrust that lands bursts in lightning along its line; one that
-- finds nothing fizzles out in front of him (the opening is his).
local function chidoriCue(fx,data,folder)
	local at=data.position
	local striker=rootOf(find(folder,data.owner))
	if striker then streak(fx,striker.Position,at,CHIDORI,.3,.22,"ChidoriLine") end
	for k=1,4 do
		local a=k*math.pi/2+math.random()*.6
		fx:bolt(at,at+Vector3.new(math.cos(a)*3.2,(math.random()-.3)*2.4,math.sin(a)*3.2),CHIDORI_CORE)
	end
	K.flash(fx.folder,at,CHIDORI_CORE,1,7,.2,0)
	K.shockRing(fx.folder,at,CHIDORI,2,12,.26,data.direction)
	if Kit.has("lightning") then
		-- (Reference quality) the bolt sheet bursts out of the contact, the star
		-- flashes white-blue and the floor under him is scored.
		Kit.star(fx.folder,at,9,CHIDORI_CORE,.12)
		Kit.burst(fx.folder,at,"lightning",6,{Lifetime=NumberRange.new(.08,.16),Speed=NumberRange.new(0,4),SpreadAngle=Vector2.new(180,180),
			Color=ColorSequence.new(CHIDORI),LightEmission=1,Size=Kit.num({{0,4},{1,7}}),Transparency=Kit.num({{0,0},{1,.4}}),
			Rotation=NumberRange.new(0,360),zoffset=2})
		Kit.streaks(fx.folder,at,data.direction or Vector3.zAxis,16,CHIDORI_CORE,70,40)
		local floor=Kit.floorUnder(at,{fx.folder},8)
		if floor then
			Kit.ground(fx.folder,floor.Position,floor.Normal,"crack",7,2,1,Color3.new(1,1,1),.1)
			Kit.ground(fx.folder,floor.Position,floor.Normal,"scorch",6,2,1,Color3.fromRGB(120,150,220),.3)
		end
	end
end
local function chidoriFizzle(fx,data)
	local holder=K.new("Model",{Name="ChidoriFizzle"},fx.folder)
	K.burst(holder,data.position,{Texture=K.TEX.spark,Lifetime=NumberRange.new(.2,.5),Speed=NumberRange.new(2,6),SpreadAngle=Vector2.new(60,60),
		Color=ColorSequence.new(CHIDORI),LightEmission=1,Size=K.num({{0,.5},{1,0}}),Acceleration=Vector3.new(0,-40,0),Drag=2},18)
	K.flash(holder,data.position,Color3.fromRGB(120,140,170),.4,2.2,.25,.4)
	K.sound(K.anchorPart(fx.folder,data.position),K.SOUND.whoosh,.3,.5)
	Debris:AddItem(holder,.6)
end
-- The steel hidden in the Phoenix Flower glints once as it leaves the flames.
local function hiddenGlint(fx,data)
	fx.identityGlints=fx.identityGlints or {}
	local now=fx:visualTime()
	for _,p in data.projectiles or {} do
		local entry=fx.projectiles[p.id]
		if p.hidden and entry and not fx.identityGlints[p.id] and now-p.born&gt;=.1 then
			fx.identityGlints[p.id]=true
			local at=entry.root.Position
			local glint=K.new("Model",{Name="HiddenGlint"},fx.folder)
			for _,roll in {0,math.pi/2} do
				local ray=K.block(glint,Vector3.new(.06,1.6,.06),CFrame.new(at)*CFrame.Angles(0,0,roll+math.pi/4),Color3.fromRGB(255,255,255),Enum.Material.Neon)
				fade(ray,.18,1.6)
			end
			K.flash(glint,at,Color3.fromRGB(255,250,236),.2,1.4,.12,0)
			K.sound(K.anchorPart(fx.folder,at),K.SOUND.whoosh,.25,2.4)
			Debris:AddItem(glint,.25)
		end
	end
end
local function sasukeImpact(fx,data,folder)
	if data.move=="ChidoriThrust" then
		if data.style=="whiff" then chidoriFizzle(fx,data) elseif data.style~="block" then chidoriCue(fx,data,folder) end
	end
	return false
end
local function sasukeFrame(fx,model,actor,st,clock)
	if actor.fighterId~="Lion" then return end
	curseSpread(fx,model,actor,st,clock)
	shadowLeaf(fx,model,actor,st,clock)
end

-- ------------------------------------------------------------------ layer
local function impact(fx,data,folder)
	if minatoImpact(fx,data,folder) then return true end
	if itachiImpact(fx,data,folder) then return true end
	if sasukeImpact(fx,data,folder) then return true end
	return nejiImpact(fx,data,folder)
end
local function fighter(fx,model,actor,dt)
	if not model or not actor then return end
	local st=stateOf(fx,model)
	local clock=IdentityFX.clock()
	networkFrame(fx,model,actor,st)
	if actor.fighterId=="Flashstep" or #(actor.seals or {})&gt;0 then minatoFrame(fx,model,actor,st,clock) end
	itachiFrame(fx,model,actor,st,clock)
	sasukeFrame(fx,model,actor,st,clock)
end
local function frame(fx,data,dt,folder)
	-- A new duel numbers its projectiles from one again.
	if fx.identityEpoch~=data.epoch then fx.identityEpoch=data.epoch;fx.identityGlints={} end
	laneFrame(fx,data)
	hiddenGlint(fx,data)
end
function IdentityFX.install(FX,kit)
	K=kit
	table.insert(FX.layers,{name="Identity",impact=impact,fighter=fighter,frame=frame})
end
IdentityFX.palmPrint=function(fx,at,normal) return palmPrint(fx,at,normal,1,.1,.22) end
return IdentityFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND136">
          <Properties>
            <string name="Name">Input</string>
            <ProtectedString name="Source">local CAS=game:GetService("ContextActionService")
local UIS=game:GetService("UserInputService")
local Controls=require(game:GetService("ReplicatedStorage").NinjaDuel.Controls)
local Input={};Input.__index=Input
-- Chakra chord: a modifier released this long before the tool still counts
-- (Z then R rolled quickly); the clock is a field so specs can drive it.
Input.ChakraChord=.3
Input.now=os.clock
local KEYBOARD,GAMEPAD=Controls.Keyboard,Controls.Gamepad
local function key(code) return {code} end
local function both(action) return {KEYBOARD[action],GAMEPAD[action]} end
local function padObject(object)
 return Controls.isGamepad(object.UserInputType) or object.KeyCode.Name:match("^Button")~=nil
  or object.KeyCode.Name:match("^DPad")~=nil or object.KeyCode.Name:match("^Thumbstick")~=nil
end
local function released(state) return state==Enum.UserInputState.End or state==Enum.UserInputState.Cancel end
-- The plain throw's aim (the client's send only computes it without extras):
-- the opponent on the pad, the mouse point on keyboard, within reach.
local function toolAim(state,pad)
 local ok,hit=pcall(function()
  local player=game:GetService("Players").LocalPlayer
  local point=if pad then state.bot and state.bot.position else player:GetMouse().Hit.Position
  local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
  if point and root and (point-root.Position).Magnitude&lt;=140 then return point end
  return nil
 end)
 return if ok then hit else nil
end
function Input.new(send,getState,toggleLock,camera)
 local self=setmetatable({send=send,getState=getState,keys={},stick=Vector2.zero,look=Vector2.zero,
  sprinting=false,modifier=false,camera=camera,pad=Controls.isGamepad(UIS:GetLastInputType()),held={},guards={},jumps={}},Input)
 local function bind(name,keys,callback)
  local list={};for _,code in keys do if code then table.insert(list,code) end end
  CAS:BindActionAtPriority("Ninja"..name,function(_,state,object)
   if UIS:GetFocusedTextBox() or getState().phase~="Duel" or (name=="Skip" and not getState().tutorial) then return Enum.ContextActionResult.Pass end
   local stick=object.KeyCode==Enum.KeyCode.Thumbstick1 or object.KeyCode==Enum.KeyCode.Thumbstick2
   if not released(state) and (not stick or object.Position.Magnitude&gt;.15) then self.pad=padObject(object) end
   callback(state,object)
   return Enum.ContextActionResult.Sink
  end,false,3000,table.unpack(list))
 end
 local function begin(state) return state==Enum.UserInputState.Begin end
 -- Schmitt thresholds: an analog trigger crossing its press threshold emits
 -- once. Change events while it is held never become repeated attacks.
 local function pressed(state,object)
  local code=object.KeyCode
  local id=if object.UserInputType==Enum.UserInputType.MouseButton1 or object.UserInputType==Enum.UserInputType.MouseButton2 then object.UserInputType.Name else code.Name
  if code==GAMEPAD.Grab or code==GAMEPAD.Tool then
   if released(state) or object.Position.Z&lt;=.25 then self.held[id]=nil;return false end
   if object.Position.Z&gt;=.55 and not self.held[id] then self.held[id]=true;return true end
   return false
  end
  if released(state) then self.held[id]=nil;return false end
  if begin(state) and not self.held[id] then self.held[id]=true;return true end
  return false
 end
 for _,code in {Enum.KeyCode.W,Enum.KeyCode.A,Enum.KeyCode.S,Enum.KeyCode.D} do
  bind(code.Name,key(code),function(state)
   if begin(state) then self.keys[code.Name]=true elseif released(state) then self.keys[code.Name]=nil end
  end)
 end
 bind("MoveStick",key(Enum.KeyCode.Thumbstick1),function(state,obj)
  self.stick=if released(state) then Vector2.zero else Vector2.new(obj.Position.X,obj.Position.Y)
 end)
 bind("LookStick",key(Enum.KeyCode.Thumbstick2),function(state,obj)
  self.look=if released(state) then Vector2.zero else Vector2.new(obj.Position.X,obj.Position.Y)
  camera.look=self.look
 end)
 bind("Modifier",key(GAMEPAD.Modifier),function(state)
  if begin(state) then self.modifier=true elseif released(state) then self.modifier=false end
 end)
 local function face(state,object,normal,slot)
  if pressed(state,object) then
   local modified=padObject(object) and self.modifier
   send(if modified then "Technique"..slot else normal)
   return not modified
  end
  return false
 end
 bind("Light",both("Light"),function(state,obj) face(state,obj,"Attack",2) end)
 bind("Heavy",both("Heavy"),function(state,obj) face(state,obj,"Heavy",3) end)
 bind("Dodge",both("Dodge"),function(state,obj) face(state,obj,"Dodge",4) end)
 bind("Jump",both("Jump"),function(state,obj)
  local id=if padObject(obj) then obj.KeyCode.Name else obj.UserInputType.Name..obj.KeyCode.Name
  if released(state) then
   if self.jumps[id] then self.jumps[id]=nil;send("JumpOff") end
   pressed(state,obj)
  else
   local h=getState().human;local action=if h and h.pursuit&gt;0 then "Pursuit" else "Jump"
   if face(state,obj,action,1) and action=="Jump" then self.jumps[id]=true end
  end
 end)
 bind("Guard",both("Guard"),function(state,obj)
  local id=obj.KeyCode.Name
  if released(state) then
   if self.guards[id] then
    self.guards[id]=nil
    if next(self.guards)==nil then send("GuardOff") end
   end
   pressed(state,obj)
  elseif pressed(state,obj) then
   if padObject(obj) and self.modifier then send("WallDetach")
   else
    local already=next(self.guards)~=nil;self.guards[id]=true
    if not already then send("Guard") end
   end
  end
 end)
 -- Chakra modifier + tool: keyboard Z (held, or just pressed), pad R1 + R2.
 -- Only a boolean leaves the client; the server picks what the chakra does.
 bind("ChakraKey",key(KEYBOARD.Chakra),function(state)
  if begin(state) then self.chakra=true;self.chakraAt=Input.now() elseif released(state) then self.chakra=false;self.chakraAt=Input.now() end
 end)
 bind("Tool",both("Tool"),function(state,obj)
  if pressed(state,obj) then
   local chakra=if padObject(obj) then self.modifier else (self.chakra or Input.now()-(self.chakraAt or -math.huge)&lt;=Input.ChakraChord)
   if chakra then send("Tool",{chakra=true,aim=toolAim(getState(),padObject(obj))}) else send("Tool") end
  end
 end)
 bind("Grab",both("Grab"),function(state,obj)
  if pressed(state,obj) then send(if padObject(obj) and self.modifier then "Feint" else "Grab") end
 end)
 bind("Lock",both("Lock"),function(state,obj) if pressed(state,obj) then toggleLock() end end)
 bind("Sprint",both("Sprint"),function(state,obj)
  if obj.KeyCode==GAMEPAD.Sprint then if pressed(state,obj) then self.sprinting=not self.sprinting end
  elseif begin(state) then self.sprinting=true elseif released(state) then self.sprinting=false end
 end)
 for _,action in {"Substitute","WallDetach","Feint","Pursuit"} do
  bind(action.."Key",key(KEYBOARD[action]),function(state,obj) if pressed(state,obj) then send(action) end end)
 end
 for _,action in {"Technique5","Awaken","Arm"} do
  bind(action,both(action),function(state,obj) if pressed(state,obj) then send(action) end end)
 end
 -- Pad re-engage has no button of its own: × in a chase window (Jump above),
 -- else ○ toward a locked opponent while sprinting. The Dodge packet already
 -- carries the stick and the sprint toggle; the server turns it into the dash.
 bind("SubstitutePad",key(GAMEPAD.Substitute),function(state,obj) if pressed(state,obj) then send("Substitute") end end)
 bind("Skip",both("Skip"),function(state,obj) if pressed(state,obj) and getState().tutorial then send("TutorialSkip") end end)
 for index,code in {Enum.KeyCode.One,Enum.KeyCode.Two,Enum.KeyCode.Three,Enum.KeyCode.Four} do
  bind("Technique"..index,key(code),function(state,obj)
   if pressed(state,obj) then send("Technique"..index)
   -- The release lets a held technique go (a charged Katon).
   elseif released(state) then send("SealRelease") end
  end)
 end
 local function blur()
  local jumping=next(self.jumps)~=nil
  self:reset();send("GuardOff");if jumping then send("JumpOff") end;send("Move",Vector3.zero)
 end
 UIS.WindowFocusReleased:Connect(blur)
 UIS.TextBoxFocused:Connect(blur)
 UIS.GamepadDisconnected:Connect(function() if self.pad then blur();self.pad=false end end)
 UIS.LastInputTypeChanged:Connect(function(kind)
  -- Moving the cursor while using the pad must not erase the PS5 prompts.
  if kind~=Enum.UserInputType.MouseMovement then self.pad=Controls.isGamepad(kind) end
 end)
 return self
end
function Input:reset()
 table.clear(self.keys);table.clear(self.held);table.clear(self.guards);table.clear(self.jumps)
 self.stick=Vector2.zero;self.look=Vector2.zero;self.modifier=false;self.sprinting=false;self.camera.look=Vector2.zero
 self.chakra=false;self.chakraAt=nil
end
function Input:direction(camera)
 -- The current device owns movement; a resting controller cannot steer WASD.
 local stick=if self.pad and self.stick.Magnitude&gt;.15 then self.stick else Vector2.zero
 -- (User 28/10) The pad's sprint is a toggle (L3); it ends when the stick
 -- rests a moment, so a stop always gives the walk / string back (it stayed on
 -- and every light became the running strike).
 if self.pad and self.sprinting then
  if stick.Magnitude&lt;.2 then
   self.restAt=self.restAt or Input.now()
   if Input.now()-self.restAt&gt;.18 then self.sprinting=false;self.restAt=nil end
  else self.restAt=nil end
 end
 local x=stick.X+(if self.keys.D and not self.pad then 1 else 0)-(if self.keys.A and not self.pad then 1 else 0)
 local z=stick.Y+(if self.keys.W and not self.pad then 1 else 0)-(if self.keys.S and not self.pad then 1 else 0)
 local look=camera.CFrame.LookVector*Vector3.new(1,0,1)
 if look.Magnitude&lt;.01 then look=-Vector3.zAxis end
 local right=Vector3.new(-look.Unit.Z,0,look.Unit.X)
 local v=right*x+look.Unit*z
 return if v.Magnitude&gt;1 then v.Unit else v
end
return Input
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND137">
          <Properties>
            <string name="Name">LeeFX</string>
            <ProtectedString name="Source">-- Rock Lee on the client (stress-test wave, DEC-015): the Fifth Gate (a green
-- chakra mantle and a flushed, burning body), his lotuses (the spin drawn
-- round the body, the crater where it lands), the crescent of the deflecting
-- kick, the Rupture's ring, and his speed (green afterimages, dust kicked up)
-- instead of the shared colours. One identity layer installed into Effects
-- (like SandFX): Effects only offers the registry and its helpers.
-- Presentation only: nothing here can change gameplay.
local Debris=game:GetService("Debris")

local LeeFX={}
local K -- Effects' helpers, handed over by install()
LeeFX.clock=os.clock -- (headless tests drive time)
local LEE="Leaf"

local GATE=Color3.fromRGB(120,230,140) -- the gates' chakra
local GATE_CORE=Color3.fromRGB(226,255,226)
local FLUSH=Color3.fromRGB(226,92,72) -- the body burning in the gates
local DUST=Color3.fromRGB(206,194,168)
local LOTUS={PrimaryLotus=true,HiddenLotus=true,LeafHeel=true}

local function stateOf(fx,model)
	fx.leeState=fx.leeState or setmetatable({},{__mode="k"})
	local st=fx.leeState[model]
	if not st then st={};fx.leeState[model]=st end
	return st
end
local function ground(fx,position,fallback)
	local ok,hit=pcall(K.floorUnder,fx,position,3,12)
	return if ok and hit then hit.Position.Y else fallback
end
local function kickDust(fx,position,count,size)
	K.smokePuff(fx.folder,position,DUST,count,size)
end
-- Cracks and a ring of dust where a body was driven into the floor.
local function crater(fx,at,size)
	local y=ground(fx,at,at.Y-2.8)
	local holder=K.new("Model",{Name="LotusCrater"},fx.folder)
	local disc=K.block(holder,Vector3.new(.06,size,size),CFrame.new(at.X,y+.04,at.Z)*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(70,62,54),Enum.Material.Slate)
	disc.Shape=Enum.PartType.Cylinder;disc.Transparency=.35
	for k=0,5 do
		local a=k/6*math.pi*2+math.random()*.4
		local crack=K.block(holder,Vector3.new(.08,.05,size*.45),CFrame.new(at.X,y+.06,at.Z)*CFrame.Angles(0,a,0)*CFrame.new(0,0,-size*.3),Color3.fromRGB(40,36,32),Enum.Material.Slate)
		crack.Transparency=.2
	end
	task.delay(1.2,function() for _,d in holder:GetChildren() do K.tween(d,.6,{Transparency=1}) end end)
	Debris:AddItem(holder,2)
	K.shockRing(fx.folder,Vector3.new(at.X,y+.1,at.Z),DUST,2,size*2.2,.35)
	kickDust(fx,Vector3.new(at.X,y+.8,at.Z),22,2.4)
end

-- ------------------------------------------------------------------ contacts
local function awaken(fx,impact,folder)
	-- The Fifth Gate opens: a green burst, the floor cracked under him.
	local at=impact.position
	local model=folder and folder:FindFirstChild(impact.owner or "")
	if model then fx:ghost(model,GATE,.4,.35) end
	local burst=K.new("Model",{Name="GateBurst"},fx.folder)
	K.flash(burst,at,GATE_CORE,2,10,.3,.1)
	K.flash(burst,at,GATE,4,16,.45,.35)
	Debris:AddItem(burst,.6)
	crater(fx,at,7)
	K.shockRing(fx.folder,at-Vector3.new(0,2.6,0),GATE,3,26,.5)
	K.sound(K.anchorPart(fx.folder,at),K.SOUND.boom,.5,1.3)
	fx:cheer(1)
end
local function speed(fx,impact,folder)
	-- His dash and the shadow under a rising body: a green afterimage and the
	-- dust his feet tear up.
	local model=folder and folder:FindFirstChild(impact.owner or "")
	if model then fx:ghost(model,GATE,.2,.6) end
	kickDust(fx,impact.position-Vector3.new(0,2.6,0),10,1.5)
	K.sound(K.anchorPart(fx.folder,impact.position),K.SOUND.whoosh,.4,1.25)
end
local function rupture(fx,impact)
	-- The Rupture: a spinning kick on the spot that throws the attacker off.
	local at=impact.position
	local holder=K.new("Model",{Name="RuptureRing"},fx.folder)
	K.shockRing(holder,at-Vector3.new(0,.6,0),GATE_CORE,2,13,.25)
	K.shockRing(holder,at-Vector3.new(0,2.5,0),DUST,2,10,.3)
	Debris:AddItem(holder,.4)
	kickDust(fx,at-Vector3.new(0,2.5,0),12,1.6)
	K.sound(K.anchorPart(fx.folder,at),K.SOUND.whoosh,.5,.9)
end
local function windUp(fx,impact)
	-- The Leaf Great Whirlwind needs no seal: the dust spins up round his feet.
	local at=impact.position
	K.shockRing(fx.folder,at-Vector3.new(0,2.6,0),DUST,2,9,.3)
	kickDust(fx,at-Vector3.new(0,2.4,0),10,1.4)
end
local function impact(fx,data,folder)
	if data.fighter~=LEE then return false end
	local style=data.style
	if style=="awaken" then awaken(fx,data,folder);return true end
	if style=="chase" or style=="afterimage" then speed(fx,data,folder);return true end
	if style=="repel" then rupture(fx,data);return true end
	if style=="cast" and data.technique=="LeafGreatWhirlwind" then windUp(fx,data);return true end
	return false
end

-- ------------------------------------------------------------------ per frame
-- The Fifth Gate: the shared mantle burns green, the body glows red.
local function gate(fx,model,actor,st)
	local aura=fx.auras and fx.auras[model]
	local open=(actor.awaken or 0)&gt;0 and (actor.health or 1)&gt;0
	if aura and aura.mantle and aura.leeMantle~=aura.mantle then
		aura.mantle.emitter.Color=ColorSequence.new(GATE)
		aura.mantle.light.Color=GATE
		aura.leeMantle=aura.mantle
	end
	if aura and aura.trail and not aura.leeTrail then aura.trail.Color=ColorSequence.new(GATE);aura.leeTrail=true end
	local head=model:FindFirstChild("Head")
	if open and head and not (st.glow and st.glow.Parent) then
		local glow=K.block(model,Vector3.one*2.1,head.CFrame,FLUSH,Enum.Material.Neon)
		glow.Name="GateGlow";glow.Shape=Enum.PartType.Ball;glow.Transparency=.82;glow.Anchored=false;glow.Massless=true
		K.new("WeldConstraint",{Part0=head,Part1=glow},glow)
		st.glow=glow
	elseif not open and st.glow then
		st.glow:Destroy();st.glow=nil
	end
end
-- The lotuses: a spiral of chakra round the falling body, a crater where it lands.
local function lotus(fx,model,actor,st)
	local root=model:FindFirstChild("HumanoidRootPart")
	local variant=actor.attackVariant
	local falling=root and LOTUS[variant or ""] and actor.attackName=="Slam" and (actor.state=="Startup" or actor.state=="Active")
	if falling then
		st.lotus=variant
		st.spin=(st.spin or 0)+.9
		local hidden=variant=="HiddenLotus"
		for k=0,1 do
			local a=st.spin+k*math.pi
			local at=root.Position+Vector3.new(math.cos(a)*2.2,(k-.5)*1.2,math.sin(a)*2.2)
			local streak=K.block(fx.folder,Vector3.new(.18,.18,1.6),CFrame.lookAt(at,at+Vector3.new(-math.sin(a),0,math.cos(a))),if hidden then FLUSH else GATE_CORE,Enum.Material.Neon)
			streak.Name="LotusSpiral";streak.Transparency=.25
			K.tween(streak,.22,{Transparency=1,Size=Vector3.new(.04,.04,2.2)})
			Debris:AddItem(streak,.25)
		end
	elseif st.lotus and root then
		-- Landed (or cut short): the floor takes it.
		crater(fx,root.Position,if st.lotus=="HiddenLotus" then 10 else 7)
		if st.lotus=="HiddenLotus" then K.shockRing(fx.folder,root.Position-Vector3.new(0,2.5,0),FLUSH,3,20,.4) end
		st.lotus=nil
	end
end
-- The deflecting kick: a crescent of air swept across his front.
local function crescent(fx,model,actor,st)
	if actor.attackName~="DeflectKick" or actor.state~="Startup" then return end
	local serial=actor.attackSerial or 0
	if st.kick==serial then return end
	st.kick=serial
	local root=model:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local holder=K.new("Model",{Name="DeflectArc"},fx.folder)
	for k=-3,3 do
		local a=math.rad(k*20)
		local cf=root.CFrame*CFrame.new(0,.6,0)*CFrame.Angles(0,a,0)*CFrame.new(0,0,-3.2)
		local piece=K.block(holder,Vector3.new(1.15,.1,.22),cf,Color3.fromRGB(236,244,255),Enum.Material.Neon)
		piece.Transparency=.35+math.abs(k)*.08
		K.tween(piece,.24,{Transparency=1})
	end
	Debris:AddItem(holder,.3)
end
local function fighter(fx,model,actor,dt)
	if not model or not actor or actor.fighterId~=LEE then return end
	local st=stateOf(fx,model)
	gate(fx,model,actor,st)
	lotus(fx,model,actor,st)
	crescent(fx,model,actor,st)
end

function LeeFX.install(FX,kit)
	K=kit
	table.insert(FX.layers,{name="Lee",impact=impact,fighter=fighter})
end
return LeeFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="ND138">
          <Properties>
            <string name="Name">Main</string>
            <ProtectedString name="Source">local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local player=Players.LocalPlayer
local shared=game:GetService("ReplicatedStorage"):WaitForChild("NinjaDuel")
local remote=shared:WaitForChild("Action")
pcall(function() game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Health,false); game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Chat,false); game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList,false) end)
local UI=require(script.Parent.UI)
local Input=require(script.Parent.Input)
local Camera=require(script.Parent.Camera)
local Presentation=require(script.Parent.Presentation)
local presentation=Presentation.new()
local camera=Camera.new(); local current={phase="Selection",epoch=0}; local ui; local input
camera.presentation=presentation
local mouse=player:GetMouse()
local function send(action,extra)
	local payload={action=action,epoch=current.epoch}
	if current.phase=="Duel" and action~="Move" then
  payload.clientTime=workspace:GetServerTimeNow()
  -- Sample intent at the press, not at the previous 80 ms movement tick.
  if input then payload.direction=input:direction(workspace.CurrentCamera);payload.sprint=input.sprinting end
 end
	if action=="Move" then payload.direction=extra; payload.locked=camera.locked; payload.sprint=input and input.sprinting or false
	elseif type(extra)=="table" then for k,v in extra do payload[k]=v end
	elseif action=="Tool" or string.match(action,"^Technique") then
		local gamepad=input and input.pad
		local hit=if gamepad and current.bot then current.bot.position else mouse.Hit.Position
		if gamepad and action=="Technique1" and current.human and current.human.fighterId=="Flashstep" then hit-=Vector3.new(0,2.8,0) end
		local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and (hit-root.Position).Magnitude&lt;=140 then payload.aim=hit end
	end
	remote:FireServer(payload)
	if current.phase=="Duel" and (action=="Attack" or action=="Heavy") then presentation:predictStrike(action,current) end
end
ui=UI.new(player:WaitForChild("PlayerGui"),send)
-- Debug/QA places only: the Studio dev panel (F6, DevClient). While it is open
-- Input sees a non-Duel state, so no combat binding fires behind the panel.
local dev
input=Input.new(send,function() return if dev and dev.panelOpen then dev.blocked else current end,function() camera:setLocked(not camera.locked);send("Move",input:direction(workspace.CurrentCamera)) end,camera)
-- Disable the default movement controller; server receives finite normalized intent.
local playerModule=player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")
require(playerModule):GetControls():Disable()
remote.OnClientEvent:Connect(function(data)
	if data.epoch&lt;(current.epoch or 0) then return end
	if data.epoch~=current.epoch or data.phase~=current.phase then input:reset() end
	if data.epoch~=current.epoch then camera.locked=true end
	data.gamepad=input.pad
	current=data; presentation.receivedAt=os.clock(); presentation:impacts(data,camera); ui:render(data)
end)
local nextMove=0
local lastDir,lastSprint=nil,nil
local lastSentAt=0
RunService:BindToRenderStep("NinjaDuelCamera",Enum.RenderPriority.Camera.Value,function(dt)
	-- Last moment before the frame is drawn: the replicated roots have their
	-- final positions for this frame, so the smoothed bodies and the camera agree.
	presentation:smoothStep(current,dt)
	presentation:update(current,dt)
	camera:update(current,dt)
	-- (DEC-030 Partie 1, responsiveness) The stick goes out the frame it
	-- changes, not on the next 80 ms tick (that alone cost up to 80 ms on every
	-- start, stop and turn); the tick stays as a heartbeat.
	if current.phase=="Duel" then
		local dir=input:direction(workspace.CurrentCamera)
		presentation.inputDir=dir;presentation.inputSprint=input.sprinting
		local changed=lastDir==nil or (dir-lastDir).Magnitude&gt;.15 or input.sprinting~=lastSprint
		if (changed and os.clock()-lastSentAt&gt;=1/30) or os.clock()&gt;=nextMove then
			lastSentAt=os.clock()
			nextMove=os.clock()+0.08;lastDir=dir;lastSprint=input.sprinting
			send("Move",dir)
		end
	end
end)
-- Studio-only diagnostics channel (created by the server's DevHooks).
if RunService:IsStudio() then
	task.spawn(function()
		local log=shared:WaitForChild("NinjaDuelDevLog",10) or game:GetService("ReplicatedStorage"):WaitForChild("NinjaDuelDevLog",10)
		if not log then return end
		game:GetService("LogService").MessageOut:Connect(function(message,kind)
			if kind==Enum.MessageType.MessageError or kind==Enum.MessageType.MessageWarning then log:FireServer("log",string.sub(message,1,400)) end
		end)
		-- Smoothness probe: per rendered frame, the apparent acceleration of each
		-- fighter's head (what the eye follows) and root. A visual jump shows up
		-- as an acceleration spike.
		local probe={frames=0,headSpikes=0,rootSpikes=0,headMax=0,rootMax=0}
		local track={}
		local trace={}
		RunService:BindToRenderStep("NinjaDuelProbe",Enum.RenderPriority.Camera.Value+1,function(dt)
			if current.phase~="Duel" or dt&lt;=0 then return end
			local folder=player.Character and player.Character.Parent
			for _,model in {player.Character,Presentation.opponent(current,folder)} do
				for _,partName in {"Head","HumanoidRootPart"} do
					local part=model and model:FindFirstChild(partName)
					if part then
						local key=model.Name..partName
						local st=track[key] or {}
						local p=part.Position
						if model==player.Character and #trace&lt;90 and partName=="Head" then
							local vr=presentation:visualRoot("human")
							local root=model:FindFirstChild("HumanoidRootPart")
							local lt=model:FindFirstChild("LowerTorso")
							local joint=lt and lt:FindFirstChild("Root") or (root and root:FindFirstChild("Root"))
							table.insert(trace,string.format("H%.2f off%.2f lt%.2f tf%.2f",(p-(st.p or p)).Magnitude,vr and root and (vr-root.Position).Magnitude or -1,
								lt and root and (lt.Position-root.Position).Magnitude or -1,joint and joint.Transform.Position.Magnitude or -1))
						end
						if st.p then
							local v=(p-st.p)/dt
							if st.v then
								local acc=(v-st.v).Magnitude/dt
								local head=partName=="Head"
								if head then probe.frames+=1 end
								if acc&gt;900 and v.Magnitude&lt;150 then
									if head then probe.headSpikes+=1 else probe.rootSpikes+=1 end
								end
								if head then probe.headMax=math.max(probe.headMax,acc) else probe.rootMax=math.max(probe.rootMax,acc) end
							end
							st.v=v
						end
						st.p=p;track[key]=st
					end
				end
			end
		end)
		log.OnClientEvent:Connect(function(kind)
			if kind=="probe" then
				local out=table.clone(probe);out.trace=table.concat(trace," ")
				log:FireServer("info",{probe=out})
				probe={frames=0,headSpikes=0,rootSpikes=0,headMax=0,rootMax=0};trace={}
				return
			end
			if kind=="info" then
				local cam=workspace.CurrentCamera
				local gui={}
				local hud=player.PlayerGui:FindFirstChild("NinjaDuelHUD")
				if hud then
					for _,g in hud:GetDescendants() do
						if g:IsA("GuiObject") and #gui&lt;40 and (g.Parent==hud or (g.Parent and g.Parent.Parent==hud)) then
							table.insert(gui,string.format("%s vis=%s pos=%s size=%s",g:GetFullName():sub(-40),tostring(g.Visible),tostring(g.AbsolutePosition),tostring(g.AbsoluteSize)))
						end
					end
				end
				log:FireServer("info",{presented=presentation.presented,camera=cam.CFrame,fov=cam.FieldOfView,focus=camera.focus,mode=camera.mode,boomAngle=camera.boomAngle,distance=camera.distance,viewport=cam.ViewportSize,gui=table.concat(gui," || ")})
			end
		end)
	end)
end
-- The normal build has no DevClient module, so this stays inert there.
local devModule=RunService:IsStudio() and script.Parent:FindFirstChild("DevClient")
if devModule then
	task.spawn(function()
		local ok,err=pcall(function()
			dev=require(devModule).install({player=player,input=input,presentation=presentation,camera=camera,ui=ui,state=function() return current end,send=send})
		end)
		if not ok then warn("[NinjaDuel] dev panel unavailable: "..tostring(err)) end
	end)
end
send("Ready")
print("[NinjaDuel] Client ready")
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND139">
          <Properties>
            <string name="Name">MotionSmear</string>
            <ProtectedString name="Source">-- Speed smear (fluidity pass, user reference 28/10). What the eye cannot
-- follow is drawn as motion: a body moving faster than a sprint leaves dark
-- translucent copies of its pose along its path and thin speed streaks around
-- it; a body that jumps several studs in one frame (a teleport, a substitution,
-- a flash step) leaves copies interpolated along the line it crossed, so the
-- jump reads as a very fast move, not a cut. Presentation only.
local TweenService=game:GetService("TweenService")
local Debris=game:GetService("Debris")

local Smear={}

local LIMBS={"Head","UpperTorso","LowerTorso","LeftUpperArm","LeftLowerArm","LeftHand","RightUpperArm","RightLowerArm","RightHand",
	"LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperLeg","RightLowerLeg","RightFoot","HairCap"}
local GHOST=Color3.fromRGB(26,26,36)
local SPEED=55 -- studs/s: above a sprint (45); dodge 61, pursuit 74, rush 90
local JUMP=6 -- studs in one frame: a teleport
local CADENCE=1/20
local LIFE=.12
local STREAK_LIFE=.12

type State={pos:Vector3?,at:number?,pose:{[string]:CFrame}?}

local function folder():Instance
	local f=workspace:FindFirstChild("NinjaDuelFX")
	if not f then
		f=Instance.new("Folder");f.Name="NinjaDuelFX";f.Parent=workspace
	end
	return f
end

local function snapshot(model:Model):{[string]:CFrame}
	local out={}
	for _,name in LIMBS do
		local p=model:FindFirstChild(name)
		if p and p:IsA("BasePart") and p.Transparency&lt;.9 then out[name]=p.CFrame end
	end
	return out
end

local function ghost(model:Model,pose:{[string]:CFrame},shift:Vector3,transparency:number,life:number)
	local holder=Instance.new("Model");holder.Name="Smear"
	for name,cf in pose do
		local src=model:FindFirstChild(name)
		if src and src:IsA("BasePart") then
			local g=Instance.new("Part")
			g.Anchored=true;g.CanCollide=false;g.CanQuery=false;g.CanTouch=false;g.CastShadow=false
			g.Material=Enum.Material.SmoothPlastic;g.Color=GHOST
			g.Size=src.Size;g.CFrame=cf+shift
			g.Transparency=transparency
			g.Parent=holder
			TweenService:Create(g,TweenInfo.new(life,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Transparency=1}):Play()
		end
	end
	holder.Parent=folder()
	Debris:AddItem(holder,life+.05)
end

local function streaks(at:Vector3,count:number,direction:Vector3)
	local f=folder()
	for _=1,count do
		local s=Instance.new("Part")
		s.Anchored=true;s.CanCollide=false;s.CanQuery=false;s.CanTouch=false;s.CastShadow=false
		s.Material=Enum.Material.SmoothPlastic;s.Color=GHOST
		local length=2+math.random()*2.2
		s.Size=Vector3.new(.05,length,.05)
		local side=direction:Cross(Vector3.yAxis)
		if side.Magnitude&lt;1e-3 then side=Vector3.xAxis end
		side=side.Unit
		local offset=side*((math.random()-.5)*3.4)+Vector3.new(0,(math.random()-.3)*2.4,0)-direction*(math.random()*1.5)
		s.CFrame=CFrame.new(at+offset)
		s.Transparency=.35
		s.Parent=f
		TweenService:Create(s,TweenInfo.new(STREAK_LIFE,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Transparency=1,Size=Vector3.new(.03,length*1.4,.03)}):Play()
		Debris:AddItem(s,STREAK_LIFE+.05)
	end
end

-- One rendered frame of one body. `st` is the caller's per-body table.
function Smear.step(st:State,model:Model?,dt:number)
	if not model then return end
	local root=model:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) then return end
	local now=os.clock()
	local pos=root.Position
	local pose=snapshot(model)
	if st.pos and st.pose then
		local delta=pos-(st.pos::Vector3)
		local flat=Vector3.new(delta.X,0,delta.Z)
		if delta.Magnitude&gt;JUMP and delta.Magnitude&lt;80 then
			-- A teleport: copies across the gap, fading the farther back they are.
			-- (Partie 0: four dense copies read as a cloud of dark cubes; three
			-- light ones read as a body that crossed the gap.)
			for k=1,3 do
				local u=k/4
				ghost(model,pose,-delta*(1-u),.6+.15*(1-u),LIFE*1.3)
			end
			streaks(pos-delta*.5,6,if flat.Magnitude&gt;.1 then flat.Unit else Vector3.zAxis)
			st.at=now
		elseif delta.Magnitude/math.max(dt,1e-3)&gt;SPEED and now-(st.at or 0)&gt;=CADENCE then
			ghost(model,st.pose::{[string]:CFrame},Vector3.zero,.68,LIFE)
			streaks(pos,2,if flat.Magnitude&gt;.1 then flat.Unit else Vector3.zAxis)
			st.at=now
		end
	end
	st.pos=pos;st.pose=pose
end

-- Thin arcs behind the hands and feet while a strike is out (the reference's
-- fine swing lines): built once per body, lit only during the swing; they
-- only show where a limb moves fast, so a still hand leaves nothing.
local ENDS={RightHand=Vector3.new(0,-.35,0),LeftHand=Vector3.new(0,-.35,0),RightFoot=Vector3.new(0,-.1,-.35),LeftFoot=Vector3.new(0,-.1,-.35)}
function Smear.limbs(st:any,model:Model?,active:boolean)
	if not model then return end
	if st.trailModel~=model then
		st.trailModel=model;st.trails={}
		for name,tip in ENDS do
			local part=model:FindFirstChild(name)
			if part and part:IsA("BasePart") then
				local a0=Instance.new("Attachment");a0.Name="SmearA";a0.Position=tip*.3;a0.Parent=part
				local a1=Instance.new("Attachment");a1.Name="SmearB";a1.Position=tip;a1.Parent=part
				local t=Instance.new("Trail")
				t.Name="SwingArc";t.Attachment0=a0;t.Attachment1=a1
				t.Color=ColorSequence.new(Color3.fromRGB(235,238,245))
				t.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.45),NumberSequenceKeypoint.new(1,1)})
				t.WidthScale=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,.1)})
				t.Lifetime=.11;t.MinLength=.15;t.FaceCamera=true;t.LightEmission=.2
				t.Enabled=false;t.Parent=part
				table.insert(st.trails,t)
			end
		end
	end
	for _,t in st.trails do
		if t.Parent and t.Enabled~=active then t.Enabled=active end
	end
end

return Smear
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND140">
          <Properties>
            <string name="Name">NarutoFX</string>
            <ProtectedString name="Source">-- Naruto on the client (roster wave, several bodies): the puffs of smoke of
-- his shadow clones (appearing, dispelled by one blow, spent after a route,
-- swapped in a substitution, a kunai turning back into one, burnt away by the
-- red chakra), the Rasengan forming between his palm and the clone that
-- shapes it, the Uzumaki Barrage called out (U-ZU-MA-KI), his orange dash,
-- and the Nine-Tails cloak (red chakra, one tail, slit eyes). The clones'
-- bodies themselves are Client/BodyViews. One identity layer installed into
-- Effects (like SandFX and LeeFX). Presentation only.
local Debris=game:GetService("Debris")
local NarutoFX={}
local K -- Effects' helpers, handed over by install()
NarutoFX.clock=os.clock -- (headless tests drive time)
local NARUTO="Legion"
local SMOKE=Color3.fromRGB(240,240,244)
local CHAKRA=Color3.fromRGB(255,160,70) -- his orange
local BLUE=Color3.fromRGB(110,190,255)
local CORE=Color3.fromRGB(235,250,255)
local FOX=Color3.fromRGB(232,64,30) -- the Nine-Tails' red chakra
local FOX_CORE=Color3.fromRGB(255,176,96)
local DUST=Color3.fromRGB(206,194,168)
local function stateOf(fx,model)
	fx.narutoState=fx.narutoState or setmetatable({},{__mode="k"})
	local st=fx.narutoState[model]
	if not st then st={};fx.narutoState[model]=st end
	return st
end
local function puff(fx,at,count,size,color) K.smokePuff(fx.folder,at,color or SMOKE,count,size) end
local function sparks(fx,at,color,count,speed)
	K.burst(fx.folder,at,{Texture=K.TEX.spark,Lifetime=NumberRange.new(.15,.35),Speed=NumberRange.new(speed or 10,(speed or 10)*1.8),SpreadAngle=Vector2.new(180,180),
		Color=ColorSequence.new(color),LightEmission=1,Size=K.num({{0,.45},{1,0}}),Drag=5},count or 10)
end
-- A word called out over the fight (the barrage's syllables).
local function call(fx,at,text,size)
	local holder=K.anchorPart(fx.folder,at)
	holder.Name="UzumakiCall"
	local gui=K.new("BillboardGui",{Size=UDim2.fromOffset(size or 110,(size or 110)*.6),AlwaysOnTop=true,LightInfluence=0},holder)
	K.new("TextLabel",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text=text,TextColor3=CHAKRA,TextStrokeTransparency=0,TextScaled=true,Font=Enum.Font.GothamBlack},gui)
	Debris:AddItem(holder,.8)
	return holder
end

-- ------------------------------------------------------------------ contacts
-- A shadow clone comes or goes: always in a puff of smoke.
local function body(fx,impact)
	if impact.kind~="clone" then return false end
	local at=impact.position
	local phase=impact.phase
	local holder=K.new("Model",{Name="ClonePuff"},fx.folder)
	if phase=="appear" then
		K.flash(holder,at,SMOKE,.6,3.2,.14,.35)
		puff(fx,at,14,2)
		K.sound(K.anchorPart(fx.folder,at),K.SOUND.whoosh,.3,1.4)
	elseif phase=="hit" or phase=="blade" or phase=="area" then
		-- One blow and it is gone: a bigger puff and a dry pop.
		K.flash(holder,at,SMOKE,.8,4.4,.16,.25)
		K.shockRing(holder,at,SMOKE,1,7,.22)
		puff(fx,at,22,2.6)
		K.sound(K.anchorPart(fx.folder,at),K.SOUND.hit,.35,1.6)
		fx:cheer(.4)
	elseif phase=="cloak" then
		-- The red chakra burns the clones away.
		K.flash(holder,at,FOX,.8,4,.2,.3)
		puff(fx,at,14,2.2,Color3.fromRGB(255,190,170))
	elseif phase=="transform" then
		-- The kunai was a clone all along.
		K.flash(holder,at,CHAKRA,.4,2.6,.14,.3)
		puff(fx,at,14,2)
		if fx.tumble then fx:tumble("kunai",at,Vector3.yAxis,nil) end
	else
		-- Its time is up, its strike is over, a swap, a flicker.
		puff(fx,at,12,2)
	end
	Debris:AddItem(holder,.5)
	return true
end
-- "It was a clone!": smoke where he was hit, smoke where he comes back (no log).
local function swap(fx,impact)
	puff(fx,impact.position,22,2.4)
	if impact.to then puff(fx,impact.to,8,1.4) end
	K.sound(K.anchorPart(fx.folder,impact.position),K.SOUND.whoosh,.4,1.1)
	return true
end
local function cast(fx,impact,folder)
	local model=folder and folder:FindFirstChild(impact.owner or "")
	local hand=model and model:FindFirstChild("RightHand")
	if impact.technique=="ShadowClone" or impact.technique=="MassShadowClone" then
		-- The cross seal: his chakra flares in his hands.
		if hand then sparks(fx,hand.Position,CHAKRA,if impact.technique=="MassShadowClone" then 18 else 10,8) end
		return true
	elseif impact.technique=="CloneRasengan" then
		if hand then sparks(fx,hand.Position,BLUE,10,6) end
		return true
	end
	return false
end
-- The Rasengan comes apart: the clone shaping it was struck.
local function broken(fx,impact,folder)
	local model=folder and folder:FindFirstChild(impact.owner or "")
	local hand=model and model:FindFirstChild("RightHand")
	local at=if hand then hand.Position else impact.position
	local holder=K.new("Model",{Name="RasenganBroken"},fx.folder)
	K.flash(holder,at,BLUE,1,3.6,.18,.3)
	sparks(fx,at,BLUE,16,14)
	puff(fx,at,6,1,Color3.fromRGB(200,220,240))
	Debris:AddItem(holder,.4)
	return true
end
-- The release: the sphere bursts forward with him (red in the cloak).
local function release(fx,impact,folder)
	local model=folder and folder:FindFirstChild(impact.owner or "")
	local tone=if impact.cloak then FOX else BLUE
	if model then fx:ghost(model,tone,.25,.5) end
	K.flash(fx.folder,impact.position,tone,1,4,.16,.3)
	return true
end
local function speed(fx,impact,folder)
	-- His dash: an orange afterimage and the dust his feet throw up.
	local model=folder and folder:FindFirstChild(impact.owner or "")
	if model then fx:ghost(model,CHAKRA,.22,.55) end
	puff(fx,impact.position-Vector3.new(0,2.6,0),10,1.5,DUST)
	K.sound(K.anchorPart(fx.folder,impact.position),K.SOUND.whoosh,.4,1.05)
	return true
end
local function awaken(fx,impact,folder)
	-- The Nine-Tails chakra boils out of him.
	local at=impact.position
	local model=folder and folder:FindFirstChild(impact.owner or "")
	if model then fx:ghost(model,FOX,.4,.35) end
	local burstModel=K.new("Model",{Name="FoxBurst"},fx.folder)
	K.flash(burstModel,at,FOX_CORE,2,10,.3,.1)
	K.flash(burstModel,at,FOX,4,18,.5,.35)
	Debris:AddItem(burstModel,.6)
	K.shockRing(fx.folder,at-Vector3.new(0,2.6,0),FOX,3,26,.5)
	puff(fx,at-Vector3.new(0,2.4,0),20,2.6,Color3.fromRGB(214,180,170))
	K.sound(K.anchorPart(fx.folder,at),K.SOUND.boom,.5,.8)
	fx:cheer(1)
	return true
end
local function impact(fx,data,folder)
	local style=data.style
	if style=="body" then return body(fx,data) end
	if data.fighter~=NARUTO then return false end
	if style=="substitute" and data.mode=="clone" then return swap(fx,data) end
	if style=="cast" then return cast(fx,data,folder) end
	if style=="rasengan" then return broken(fx,data,folder) end
	if style=="burst" then return release(fx,data,folder) end
	if style=="uzumaki" then
		call(fx,data.position+Vector3.new(0,2.6,0),data.syllable or "U")
		K.shockRing(fx.folder,data.position,CHAKRA,1,8,.2)
		return true
	end
	if style=="chase" or style=="afterimage" then return speed(fx,data,folder) end
	if style=="awaken" then return awaken(fx,data,folder) end
	return false
end

-- ------------------------------------------------------------------ per frame
-- The Rasengan forming in his palm through the channel, chakra drawn in from
-- the clone at his right side; the thrust itself is Effects' sphere (red in
-- the cloak).
local function rasengan(fx,model,actor,st)
	local forming=actor.castId=="CloneRasengan" and (actor.state=="TechniqueChannel" or actor.state=="TechniqueActive") and (actor.health or 1)&gt;0
	local hand=model:FindFirstChild("RightHand")
	local cloak=(actor.awaken or 0)&gt;0
	if forming and hand then
		if not (st.orb and st.orb.Parent) then
			local holder=K.new("Model",{Name="RasenganForming"},fx.folder)
			local core=K.block(holder,Vector3.one*.4,hand.CFrame,CORE,Enum.Material.Neon);core.Shape=Enum.PartType.Ball
			local shell=K.block(holder,Vector3.one,hand.CFrame,BLUE,Enum.Material.Neon);shell.Shape=Enum.PartType.Ball;shell.Transparency=.5
			st.orb=holder;st.core=core;st.shell=shell;st.born=NarutoFX.clock();st.wisp=nil
		end
		local t=NarutoFX.clock()-st.born
		local grow=math.clamp(t/.45,.25,1)
		local center=hand.CFrame*CFrame.new(0,-.7,-.35)
		st.core.CFrame=center;st.core.Size=Vector3.one*.6*grow;st.core.Color=if cloak then FOX_CORE else CORE
		st.shell.CFrame=center;st.shell.Size=Vector3.one*1.5*grow*(1+math.sin(t*40)*.06);st.shell.Color=if cloak then FOX else BLUE
		local root=model:FindFirstChild("HumanoidRootPart")
		local beat=math.floor(t*30)
		if not cloak and root and beat~=st.wisp then
			st.wisp=beat
			local from=(root.CFrame*CFrame.new(1.6,.4,-.9)).Position
			local wisp=K.block(fx.folder,Vector3.new(.08,.08,1.2),CFrame.lookAt(from,center.Position),BLUE,Enum.Material.Neon)
			wisp.Name="RasenganWisp";wisp.Transparency=.3
			K.tween(wisp,.14,{CFrame=CFrame.lookAt(center.Position,center.Position+(center.Position-from)),Transparency=1,Size=Vector3.new(.03,.03,.4)})
			Debris:AddItem(wisp,.16)
		end
	elseif st.orb then
		st.orb:Destroy();st.orb=nil
	end
	local sphere=fx.rasengan and fx.rasengan[model]
	if sphere and cloak then
		sphere.core.Color=FOX_CORE;sphere.shell.Color=FOX
		for _,band in sphere.bands do band.Color=FOX_CORE end
	end
end
-- The Nine-Tails cloak: the shared mantle burns red, one tail of red chakra
-- waves behind his hips, the eyes turn red; his dash trail is his orange.
local function cloak(fx,model,actor,st)
	local aura=fx.auras and fx.auras[model]
	local open=(actor.awaken or 0)&gt;0 and (actor.health or 1)&gt;0
	if aura and aura.mantle and aura.foxMantle~=aura.mantle then
		aura.mantle.emitter.Color=ColorSequence.new(FOX);aura.mantle.light.Color=FOX;aura.foxMantle=aura.mantle
	end
	if aura and aura.trail and not aura.foxTrail then aura.trail.Color=ColorSequence.new(CHAKRA);aura.foxTrail=true end
	local hips=model:FindFirstChild("LowerTorso") or model:FindFirstChild("HumanoidRootPart")
	if open and hips and not (st.tail and st.tail.Parent) then
		local tail=K.new("Model",{Name="FoxTail"},fx.folder)
		local parts={}
		for k=1,4 do
			local p=K.block(tail,Vector3.one*(.8-k*.12),hips.CFrame,FOX,Enum.Material.Neon)
			p.Shape=Enum.PartType.Ball;p.Transparency=.25+k*.12
			table.insert(parts,p)
		end
		st.tail=tail;st.tailParts=parts
		st.irises={}
		for _,p in model:GetChildren() do
			if p.Name=="Iris" then table.insert(st.irises,{part=p,color=p.Color,material=p.Material});p.Color=FOX;p.Material=Enum.Material.Neon end
		end
	elseif not open and st.tail then
		st.tail:Destroy();st.tail=nil
		for _,iris in st.irises or {} do iris.part.Color=iris.color;iris.part.Material=iris.material end
		st.irises=nil
	end
	if st.tail and hips then
		local t=NarutoFX.clock()
		for k,p in st.tailParts do
			p.CFrame=hips.CFrame*CFrame.new(math.sin(t*6-k*.8)*.35*k,.15+k*.35,.6+k*.55)
		end
	end
end
-- Naruto Rendan: the last syllable called as the heel comes down.
local function rendan(fx,model,actor,st)
	if actor.attackVariant~="NarutoRendan" or actor.state~="Startup" then return end
	local serial=actor.attackSerial or 0
	if st.rendan==serial then return end
	st.rendan=serial
	local root=model:FindFirstChild("HumanoidRootPart")
	if root then call(fx,root.Position+Vector3.new(0,3.4,0),"KI!",150) end
end
local function fighter(fx,model,actor,dt)
	if not model or not actor or actor.fighterId~=NARUTO then return end
	local st=stateOf(fx,model)
	rasengan(fx,model,actor,st)
	cloak(fx,model,actor,st)
	rendan(fx,model,actor,st)
end

function NarutoFX.install(FX,kit)
	K=kit
	table.insert(FX.layers,{name="Naruto",impact=impact,fighter=fighter})
end
return NarutoFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND141">
          <Properties>
            <string name="Name">Presentation</string>
            <ProtectedString name="Source">-- Velmora's additive combat motion and hit feedback, retaining Ninja Duel's
-- deception visual. Rendering is continuous: bodies are drawn on a smoothed
-- track of their replicated roots instead of jumping once per network packet.
local Motion=require(script.Parent.VelmoraMotionEngine)
local Feedback=require(script.Parent.VelmoraHitFeedback)
local Effects=require(script.Parent.Effects)
-- Bodies that are not fighters (Naruto's shadow clones).
local BodyViews=require(script.Parent.BodyViews)
local Smear=require(script.Parent.MotionSmear)
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Fighters=require(Shared.Fighters)
local Config=require(Shared.Config)
local Presentation={};Presentation.__index=Presentation
local LOCOMOTION_POSE_SPEED=26
function Presentation.new()
	return setmetatable({last={},recoil={},impactSerial=0,impactEpoch=nil,clocks={},landings={},botModel=nil,fx=Effects.new(),bodies=BodyViews.new(),smooth={}},Presentation)
end
-- The opponent's body in the viewer's duel folder: the server names it by the
-- id it sends as data.bot.id ("AIFighter" against the AI, a duelist online).
function Presentation.opponent(data,folder)
	return folder and folder:FindFirstChild(data and data.bot and data.bot.id or "AIFighter")
end
-- The replicated root of a server-owned fighter only moves every other
-- rendered frame (physics replication at ~30 Hz against a 60 Hz render), so a
-- body drawn on it advances in jerks. Each fighter is instead drawn on a short
-- interpolated track of its replicated positions, a fixed ~45 ms behind: the
-- motion is continuous every frame. A real teleport still snaps.
local TRACK_DELAY,TRACK_SNAP,TRACK_MAX,TRACK_SAMPLES=.045,45,12,8
local function yawOf(cf)
	local look=cf.LookVector
	return math.atan2(-look.X,-look.Z)
end
local function lerpAngle(a,b,t)
	local d=(b-a+math.pi)%(2*math.pi)-math.pi
	return a+d*t
end
function Presentation:smoothRoot(key,actualCF,dt,warp)
	local now=os.clock()
	local st=self.smooth[key]
	if not st then st={samples={},vel=Vector3.zero};self.smooth[key]=st end
	local samples=st.samples
	local actual=actualCF.Position
	local newest=samples[#samples]
	if (warp and warp~=st.warp) or (newest and (actual-newest.p).Magnitude&gt;TRACK_SNAP) then
		table.clear(samples);newest=nil;st.vel=Vector3.zero;st.pos=nil
	end
	st.warp=warp
	local yaw=yawOf(actualCF)
	if not newest or (actual-newest.p).Magnitude&gt;1e-4 or math.abs(lerpAngle(newest.yaw,yaw,1)-newest.yaw)&gt;1e-4 then
		table.insert(samples,{t=now,p=actual,yaw=yaw})
		while #samples&gt;TRACK_SAMPLES do table.remove(samples,1) end
	elseif now-newest.t&gt;.1 then
		-- Standing still: keep the track anchored to the present.
		newest.t=now
	end
	local at=now-TRACK_DELAY
	local pos,face=samples[#samples].p,samples[#samples].yaw
	if at&lt;=samples[1].t then pos,face=samples[1].p,samples[1].yaw
	else
		for i=#samples-1,1,-1 do
			local a,b=samples[i],samples[i+1]
			if at&gt;=a.t then
				local span=b.t-a.t
				local t=if span&gt;1e-4 then math.clamp((at-a.t)/span,0,1) else 1
				pos=a.p:Lerp(b.p,t);face=lerpAngle(a.yaw,b.yaw,t)
				break
			end
		end
	end
	local offset=pos-actual
	if offset.Magnitude&gt;TRACK_MAX then pos=actual+offset.Unit*TRACK_MAX end
	-- Velocity of the drawn body: what the legs and lean must match.
	if st.pos then
		local v=(pos-st.pos)/math.max(dt,1/240)
		st.vel=st.vel:Lerp(v,math.min(1,dt*18))
	end
	st.pos=pos;st.yaw=face
	return CFrame.new(pos)*CFrame.Angles(0,face,0)
end
function Presentation:visualRoot(key)
	local st=self.smooth[key]
	return st and st.pos
end
function Presentation:visualVelocity(key)
	-- (The player's own body: the velocity it is drawn with, lead included.)
	if key=="human" and self.lead and self.lead.vel then return self.lead.vel end
	local st=self.smooth[key]
	return st and st.vel
end
-- (DEC-030 Partie 1, responsiveness) The player's own body answers the stick
-- at once. The server still moves it (authority), but its track arrives
-- 100-170 ms after the press; the body is drawn ahead of that track by what a
-- body obeying the stick would have run since - an offset that fades as the
-- track catches up (it is zero at any steady speed), never more than 3 studs,
-- never into the opponent. Outside free movement it follows the track.
local LEAD_TAU,LEAD_MAX=.13,3
function Presentation:leadLocal(actor,drawn,dt)
	local st=self.lead
	if not st then st={off=Vector3.zero,v=Vector3.zero};self.lead=st end
	local track=self.smooth.human and self.smooth.human.vel or Vector3.zero
	local trackFlat=Vector3.new(track.X,0,track.Z)
	local free=actor.state=="Neutral" and not actor.reaction and not actor.airborne and not actor.wall and actor.groundPose==nil
	local want=trackFlat
	if free then
		local dir=self.inputDir or Vector3.zero
		dir=Vector3.new(dir.X,0,dir.Z)
		if dir.Magnitude&gt;1 then dir=dir.Unit end
		local def=Fighters[actor.fighterId]
		local move=Config.Movement or {}
		local speed=if self.inputSprint then (move.SprintSpeed or 45)*(def and def.SprintScale or 1) else (def and def.Speed or 18)
		want=dir*speed
	end
	st.v=st.v:Lerp(want,math.min(1,dt*28))
	st.off+=(st.v-trackFlat)*dt
	st.off*=math.exp(-dt/(if free then LEAD_TAU else .07))
	if st.off.Magnitude&gt;LEAD_MAX then st.off=st.off.Unit*LEAD_MAX end
	local other=self:visualRoot("bot")
	if other then
		local at=drawn.Position+st.off
		local d=Vector3.new(at.X-other.X,0,at.Z-other.Z)
		if d.Magnitude&lt;2.6 and st.off.Magnitude&gt;1e-3 then st.off*=math.clamp((d.Magnitude-1.6),0,1) end
	end
	local out=drawn+st.off
	if st.prev then
		local v=(out.Position-st.prev)/math.max(dt,1/240)
		st.vel=(st.vel or v):Lerp(v,math.min(1,dt*18))
	end
	st.prev=out.Position
	return out
end
-- (Responsiveness) A light or heavy pressed starts moving the body on the
-- press: the strike the server will start is guessed (the next light of the
-- string, or a heavy from neutral) and drawn from the press; when the server's
-- strike arrives it continues from the same instant if the guess was right,
-- otherwise the server's strike takes over (through the transition). A guess
-- the server never confirms fades after 0.25 s.
local NEXT_LIGHT={Light1="Light2",Light2="Light3"}
function Presentation:predictStrike(action,data)
	local h=data and data.human
	if not h or h.airborne or h.reaction or h.wall or h.groundPose or (h.health or 1)&lt;=0 then return end
	local guess
	if action=="Heavy" then
		if h.state=="Neutral" then guess="Heavy" end
	elseif h.state=="Neutral" then guess="Light1"
	elseif h.state=="Recovery" and h.attackName and NEXT_LIGHT[h.attackName] then guess=NEXT_LIGHT[h.attackName] end
	if guess then self.prediction={name=guess,at=os.clock(),serial=h.attackSerial or 0} end
end
function Presentation:applyPrediction(actor,now)
	local p=self.prediction
	if not p then return actor end
	if (actor.attackSerial or 0)~=p.serial then
		self.prediction=nil
		if actor.attackName==p.name then
			local clock=self.clocks.human
			if not clock then clock={};self.clocks.human=clock end
			clock.attackName=actor.attackName;clock.attackSerial=actor.attackSerial or 0;clock.attackAt=p.at
		end
		return actor
	end
	if now-p.at&gt;.25 or actor.reaction then self.prediction=nil;return actor end
	local v=table.clone(actor)
	v.attackName=p.name;v.state="Startup";v.attackSerial=-1-p.serial;v.attackElapsed=now-p.at
	return v
end
-- Just before rendering: the replicated roots have their positions for this
-- frame; advance each track and draw the body on it (position and facing).
function Presentation:smoothStep(data,dt)
	if not data or data.phase~="Duel" then return end
	local character=game:GetService("Players").LocalPlayer.Character
	local folder=character and character.Parent
	for key,model in {human=character,bot=Presentation.opponent(data,folder)} do
		local root=model and model:FindFirstChild("HumanoidRootPart")
		local actor=data[key]
		if root and not root.Anchored and actor then
			-- The true replicated pose: if the root still sits exactly where we
			-- drew it last frame, no new packet arrived since.
			local st=self.smooth[key]
			local actualCF=root.CFrame
			if st and st.drawnCF and st.replicatedCF and (actualCF.Position-st.drawnCF.Position).Magnitude&lt;1e-3
				and actualCF.LookVector:Dot(st.drawnCF.LookVector)&gt;.99999 then actualCF=st.replicatedCF end
			local drawn=self:smoothRoot(key,actualCF,math.max(dt,1/240),actor.warpSerial)
			if key=="human" then drawn=self:leadLocal(actor,drawn,math.max(dt,1/240)) end
			st=self.smooth[key]
			st.replicatedCF=actualCF
			-- Draw the whole body on the track for this frame only; the next
			-- replication packet overwrites the client copy, never the server.
			local target=drawn
			if (target.Position-root.Position).Magnitude&gt;1e-4 or target.LookVector:Dot(root.CFrame.LookVector)&lt;.99999 then
				model:PivotTo(target*root.CFrame:Inverse()*model:GetPivot())
			end
			st.drawnCF=root.CFrame
		end
	end
end
-- Contact feed straight from the server: play the impact on the frame the hit
-- happened, so sound and VFX never lead or lag the animation.
function Presentation:impacts(data,camera)
 -- Projectiles first, so a contact in the same packet can finish its blade.
 if data.phase=="Duel" then self.fx:sync(data) end
 if not data.impacts then return end
 -- The server restarts its contact serial with every duel.
 if self.impactEpoch~=data.epoch then self.impactEpoch=data.epoch;self.impactSerial=0 end
 local serial=data.impactSerial or 0
 if serial&lt;=self.impactSerial then return end
 local character=game:GetService("Players").LocalPlayer.Character
 local folder=character and character.Parent
 for _,impact in data.impacts do
  if impact.serial==nil or impact.serial&gt;self.impactSerial then
   Feedback.impact(impact.style or "light",impact.position,impact)
   self.fx:impact(impact,folder)
   if camera and camera.impulse then camera:impulse(impact.style,impact.role,impact) end
  end
 end
 self.impactSerial=serial
end
-- Genjutsu image. The server says who is deceived (illusion + decoy on that
-- actor). Seen by the deceived player, the image IS Itachi: a frozen copy in
-- his stance facing them, with a faint red outline pulsing now and then (the
-- tell), and the real body behind it drawn faint. Seen by Itachi's player, the
-- image is a red translucent afterimage of himself: he sees the trap he left.
function Presentation.fade(model,amount)
 if not model then return end
 for _,d in model:GetDescendants() do if d:IsA("BasePart") then d.LocalTransparencyModifier=amount end end
end
function Presentation:clearEcho()
 local echo=self.echo
 if not echo then return end
 if echo.model then echo.model:Destroy() end
 if echo.mode=="deceived" then Presentation.fade(echo.source,0) end
 self.echo=nil
end
-- Which view of the genjutsu this client draws: "deceived" (my fighter is
-- under it), "caster" (the opponent is under mine) or nil.
function Presentation.illusionView(data)
 if not data or data.phase~="Duel" then return nil end
 if data.human and (data.human.illusion or 0)&gt;0 and data.human.decoy then return "deceived",data.human.decoy end
 if data.bot and (data.bot.illusion or 0)&gt;0 and data.bot.decoy then return "caster",data.bot.decoy end
 return nil
end
function Presentation:illusion(data,model)
 local folder=model and model.Parent
 local opponent=Presentation.opponent(data,folder)
 local mode,decoy=Presentation.illusionView(data)
 local source=if mode=="deceived" then opponent elseif mode=="caster" then model else nil
 local watcher=if mode=="deceived" then model else opponent
 if not source then mode=nil end
 local echo=self.echo
 if echo and (echo.mode~=mode or echo.epoch~=data.epoch or echo.source~=source) then self:clearEcho();echo=nil end
 if not mode then return end
 if not echo then
  echo={mode=mode,epoch=data.epoch,source=source,model=self.fx:image(source,mode),born=os.clock()}
  self.echo=echo
 end
 if mode=="deceived" then Presentation.fade(source,.55) end
 local image=echo.model
 if not image then return end
 local root=watcher and watcher:FindFirstChild("HumanoidRootPart")
 local look=if root then Vector3.new(root.Position.X-decoy.X,0,root.Position.Z-decoy.Z) else Vector3.zero
 if look.Magnitude&lt;.1 then look=Vector3.zAxis end
 local t=os.clock()-echo.born
 local at=decoy+Vector3.new(0,math.sin(t*5)*.03,0)
 image:PivotTo(CFrame.lookAt(at,at+look.Unit))
 local tell=image:FindFirstChild("Tell")
 if tell then tell.OutlineTransparency=1-.45*math.max(0,math.sin(t*7))^8 end
end
-- Local presentation clocks: an attack animates from the frame it was first
-- seen, so a late or jittery packet cannot make the body jump backwards.
local function clockFor(self,key,actor,now)
 local clock=self.clocks[key]
 if not clock then clock={};self.clocks[key]=clock end
 -- A new swing restarts the clock even when it repeats the same move name.
 if actor.attackName~=clock.attackName or (actor.attackSerial or 0)~=clock.attackSerial then
  -- Start the clip where the server already is: a snapshot arrives up to an
  -- interval late, and a clip restarted at 0 trailed the real contact (the
  -- launcher's kick was cut off by the chase before it ever showed).
  clock.attackName=actor.attackName;clock.attackSerial=actor.attackSerial or 0
  clock.attackAt=now-math.clamp(actor.attackElapsed or 0,0,.12)
 end
 -- A fresh contact restarts the recoil even when it repeats the same reaction
 -- kind (Light1 -&gt; Light2 are both HitStun), so every hit reads as a hit.
 if actor.reaction~=clock.reaction or (actor.reaction and (actor.impactSerial or 0)~=clock.impactSerial) then
  clock.reaction=actor.reaction;clock.reactionAt=now
 end
 clock.impactSerial=actor.impactSerial or 0
 clock.attackElapsed=if actor.attackName then now-clock.attackAt else 0
 clock.reactionElapsed=if actor.reaction then now-clock.reactionAt else 0
 return clock
end
-- A landing belongs to one body. Opponent landings must never bend the
-- player's knees; keep a local phase so compression releases before neutral.
function Presentation:landing(key,actor,previous,now)
 if previous and previous.airborne and not actor.airborne then
  self.landings[key]={at=now,duration=if actor.landStrong then .22 else .1,strong=actor.landStrong==true}
 end
 local landing=self.landings[key]
 if not landing then return false,0,false end
 if actor.airborne or now&gt;=landing.at+landing.duration then
  self.landings[key]=nil
  return false,0,false
 end
 return true,math.clamp((now-landing.at)/landing.duration,0,1),landing.strong
end
function Presentation:update(data,dt)
 dt=math.max(dt or 1/60,.001)
 -- One presentation tick per rendered frame; every pose below reads this clock.
 Motion.tick(dt)
 local players=game:GetService("Players")
 if not data.human then
  self:clearEcho()
  self.fx:update(data,dt,nil)
  self.bodies:update(data,dt,nil)
  return
 end
 if self.epoch~=data.epoch then
  -- Character switch, rematch or a fresh duel: the only place a hard reset is
  -- right. Normal presentation never snaps the skeleton.
  self.epoch=data.epoch
  table.clear(self.clocks);table.clear(self.last);table.clear(self.smooth);table.clear(self.landings)
  self.lead=nil;self.prediction=nil
  self.smears={}
  if players.LocalPlayer.Character then Motion.reset(players.LocalPlayer.Character) end
  if self.botModel then Motion.reset(self.botModel) end
 end
 local now=os.clock()
 local character=players.LocalPlayer.Character
 self:illusion(data,character)
 local folder=character and character.Parent
 local bot=Presentation.opponent(data,folder)
 self.botModel=bot
 local models={human=character,bot=bot}
 for key,model in models do
  local actor=data[key];local previous=self.last[key]
  if model and actor then
   -- The motion engine owns every joint. A Humanoid Animator (run locally for
   -- the player's own character) resets the joints between our write and the
   -- render, which left the body in its rest pose; remove it on this client.
   local humanoid=model:FindFirstChildOfClass("Humanoid")
   local animator=humanoid and humanoid:FindFirstChildOfClass("Animator")
   if animator then animator:Destroy() end
   if key=="human" then actor=self:applyPrediction(actor,now) end
   local clock=clockFor(self,key,actor,now)
   local root=model:FindFirstChild("HumanoidRootPart")
   -- The body is drawn on a smoothed track of the replicated root (see
   -- Presentation:smoothStep, run just before each frame is rendered).
   -- Take-off and get-up sounds, from the state change itself.
   if previous and not previous.airborne and actor.airborne and root and root.AssemblyLinearVelocity.Y&gt;15 and not actor.reaction then self.fx:jumpSound(root.Position) end
   if previous and previous.reaction=="Wakeup" and actor.reaction~="Wakeup" and root then self.fx:getUpSound(root.Position) end
   local landing,landingPhase,landingStrong=self:landing(key,actor,previous,now)
   -- Health lost without a new contact (burn, sand): a slow drain such as the
   -- curse mark (~0.1 HP per snapshot) is not a hit and spawns nothing.
   if previous and actor.health&lt;=previous.health-1 and actor.impactSerial==(previous.impactSerial or -1) then
    local damage=previous.health-actor.health
    if root then Feedback.burst(root.Position,if actor.cue=="GUARDED" then Color3.fromRGB(255,235,160) else Color3.fromRGB(255,91,74),damage,actor.cue=="GUARDED") end
   end
   if actor.events and previous and actor.events.Parry and actor.events.Parry&gt;(previous.parry or 0) then
    if root then Feedback.burst(root.Position,Color3.fromRGB(255,245,176),0,true) end
   end
   -- Locomotion is posed from the rig's live velocity, not a 10 Hz value.
   local tracked=self:visualVelocity(key)
   local velocity=if root then root.AssemblyLinearVelocity else actor.velocity
   if tracked and velocity then
    -- Wall motion is positioned by the server with zero assembly velocity.
    -- Its vertical cadence must follow the drawn track as well as its X/Z.
    velocity=Vector3.new(tracked.X,if actor.wall then tracked.Y else velocity.Y,tracked.Z)
   end
   local planar=if velocity then Vector3.new(velocity.X,0,velocity.Z).Magnitude else 0
   local speed=if key=="human" and self.lead then planar else math.max(actor.speed or 0,planar)
   -- Everything the presentation contract needs, with locally measured clocks so
   -- a late packet cannot make the body replay its wind-up.
   local visual=table.clone(actor)
   -- A dash is server-driven translation: pose it from its declared direction.
   visual.velocity=if actor.state=="Dodging" then actor.velocity else velocity
   visual.speed=speed
   visual.reactionElapsed=clock.reactionElapsed
   visual.attackElapsed=clock.attackElapsed
   visual.landing=landing;visual.landingPhase=landingPhase;visual.landStrong=landingStrong
   visual.intro=data.intro
   -- (Partie 2) The winner's pose after the K.O. and on the result screen.
   visual.victory=data.winner~=nil and (data.ko==true or data.phase=="Result") and (actor.health or 0)&gt;0
    and ((key=="human")==(data.winner=="PlayerFighter"))
   local other=if key=="human" then "bot" else "human"
   visual.lookAt=self:visualRoot(other) or (data[other] and data[other].position)
   -- Throws and casts run on the shared server clock (slightly behind, like the
   -- projectiles), so the blade leaves the hand on the frame it starts flying.
   if data.serverNow then
    local visualNow=workspace:GetServerTimeNow()-Effects.DELAY
    if actor.throwElapsed then visual.throwElapsed=visualNow-(data.serverNow-actor.throwElapsed) end
    if actor.castElapsed then visual.castElapsed=workspace:GetServerTimeNow()-(data.serverNow-actor.castElapsed) end
    if actor.channel then visual.channel=math.max(0,actor.channel-(workspace:GetServerTimeNow()-data.serverNow)) end
   end
   Motion.weapon(model,visual)
   self.presented=self.presented or {}
   self.presented[key]=string.format("%s hp=%s state=%s",tostring(Motion.present(model,visual,clock,dt)),tostring(visual.health),tostring(visual.state))
   -- Speed smear (fluidity pass): faster than a sprint, or a teleport, is
   -- drawn as motion. Not during an intro or between rounds (repositioning).
   self.smears=self.smears or {}
   self.smears[key]=self.smears[key] or {}
   if data.phase=="Duel" and (data.intro or 0)&lt;=0 then Smear.step(self.smears[key],model,dt) else self.smears[key]={} end
   self.arcs=self.arcs or {}
   self.arcs[key]=self.arcs[key] or {}
   Smear.limbs(self.arcs[key],model,actor.attackName~=nil and (actor.state=="Startup" or actor.state=="Active"))
   self.last[key]={health=actor.health,attackName=actor.attackName,parry=actor.events and actor.events.Parry or 0,
    impactSerial=actor.impactSerial or 0,airborne=actor.airborne,reaction=actor.reaction}
  end
 end
 self.fx:update(data,dt,folder)
 self.bodies:update(data,dt,folder)
end
return Presentation
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND142">
          <Properties>
            <string name="Name">SandFX</string>
            <ProtectedString name="Source">-- Gaara's sand on the client: the sand bullet and Sand Shuriken in flight, the
-- Sand Coffin wave and the body it holds, the automatic shield and its charges,
-- the body-flicker, the burial, the Desert Wave, the glide, and the lashes and
-- pillar of his strings. One identity layer installed into Effects (DEC-015: a
-- fighter's look lives in its own module, Effects only offers the registry and
-- helpers). Presentation only: nothing here can change gameplay.
--
-- Sand is one medium: moving sand is drawn as streams (two Beams with a
-- scrolling dust texture, a pale loose layer over a dense darker core) carried
-- by invisible handles, with grains and dust thrown off them. The first pass
-- used solid balls and cylinders, which read as blobs and planks (V1 directive).
local Debris=game:GetService("Debris")
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Attacks=require(Shared.Attacks)
local Fighters=require(Shared.Fighters)

local SandFX={}
local K -- Effects' helpers, handed over by install()
SandFX.clock=os.clock -- (headless tests drive time)

local SAND=Color3.fromRGB(212,176,118)
local SAND_DARK=Color3.fromRGB(176,136,82)
local SAND_PALE=Color3.fromRGB(238,218,176)
local SHUKAKU=Color3.fromRGB(222,176,112)
local GRAIN=Enum.Material.Sand

local function smooth(x) x=math.clamp(x,0,1) return x*x*(3-2*x) end
local function flatUnit(v,fallback)
	local f=Vector3.new(v.X,0,v.Z)
	return if f.Magnitude&gt;.05 then f.Unit else (fallback or Vector3.zAxis)
end
local function ground(fx,position,fallback)
	local ok,hit=pcall(K.floorUnder,fx,position,3,12)
	return if ok and hit then hit.Position.Y else fallback
end
-- Grains thrown out and falling back: what makes it read as sand, not smoke.
local function grains(fx,position,count,speed,up)
	K.burst(fx.folder,position,{Texture=K.TEX.smoke,Lifetime=NumberRange.new(.35,.7),Speed=NumberRange.new(speed*.5,speed),
		SpreadAngle=if up then Vector2.new(40,40) else Vector2.new(180,180),EmissionDirection=Enum.NormalId.Top,
		Color=ColorSequence.new(SAND),LightEmission=0,LightInfluence=1,Size=K.num({{0,.4},{1,.15}}),
		Transparency=K.num({{0,.05},{.7,.25},{1,1}}),Acceleration=Vector3.new(0,-60,0),Drag=1.5,Rotation=NumberRange.new(0,360)},count)
end
local function dust(fx,position,count,size) K.smokePuff(fx.folder,position,SAND_PALE,count,size) end
local function thud(fx,position,volume,speed) K.sound(K.anchorPart(fx.folder,position),K.SOUND.land,volume,speed) end

-- ------------------------------------------------------------------ streams
-- An invisible handle whose X axis is the stream's direction there (a Beam
-- curves along its attachments' axes: CurveSize0/1).
local function frame(pos,dir)
	dir=if dir.Magnitude&gt;.01 then dir.Unit else Vector3.yAxis
	local up=Vector3.yAxis-dir*dir.Y
	if up.Magnitude&lt;.05 then up=Vector3.xAxis-dir*dir.X end
	return CFrame.fromMatrix(pos,dir,up.Unit)
end
local function handle(parent,pos,dir)
	local p=K.block(parent,Vector3.new(.2,.2,.2),frame(pos,dir or Vector3.yAxis),SAND,Enum.Material.SmoothPlastic)
	p.Name="Handle";p.Transparency=1
	return p,K.new("Attachment",{},p)
end
local function ribbon(parent,a0,a1,w0,w1,core)
	return K.new("Beam",{Attachment0=a0,Attachment1=a1,Width0=w0,Width1=w1,Texture=K.TEX.smoke,TextureMode=Enum.TextureMode.Wrap,
		TextureLength=if core then 2 else 3,TextureSpeed=if core then 2.4 else 1.5,Color=ColorSequence.new(if core then SAND_DARK else SAND_PALE),
		Transparency=K.num(if core then {{0,0},{1,.04}} else {{0,.12},{1,.25}}),LightEmission=0,LightInfluence=1,FaceCamera=true,
		Segments=14,ZOffset=if core then .1 else 0},parent)
end
-- A stream: loose dust over a dense core, both between the same two handles.
local function stream(parent,a0,a1,w0,w1)
	return {ribbon(parent,a0,a1,w0*1.6,w1*1.6,false),ribbon(parent,a0,a1,w0,w1,true)}
end
local function widths(beams,w0,w1) beams[1].Width0=w0*1.6;beams[1].Width1=w1*1.6;beams[2].Width0=w0;beams[2].Width1=w1 end
local function curves(beams,c0,c1) for _,b in beams do b.CurveSize0=c0;b.CurveSize1=c1 end end
local function fadeWidths(beams,time) for _,b in beams do K.tween(b,time,{Width0=0,Width1=0}) end end
-- A one-off upright stream from `foot`, rising to `height` over `rise` s.
local function column(parent,foot,height,w0,w1,rise,lean)
	local h0,a0=handle(parent,foot,Vector3.yAxis)
	local h1,a1=handle(parent,foot+Vector3.new(0,.3,0),Vector3.yAxis)
	local beams=stream(parent,a0,a1,w0,w1)
	local top=foot+Vector3.new(0,height,0)+(lean or Vector3.zero)
	K.tween(h1,rise,{CFrame=frame(top,top-foot)})
	return {base=h0,top=h1,beams=beams,foot=foot}
end
-- A burst of sand that stays together as a curtain: emitted inside a box.
local function curtain(fx,cf,size,count,up)
	local box=K.block(fx.folder,size,cf,SAND,Enum.Material.SmoothPlastic);box.Transparency=1
	local e=K.new("ParticleEmitter",{Enabled=false,Texture=K.TEX.smoke,Shape=Enum.ParticleEmitterShape.Box,ShapeStyle=Enum.ParticleEmitterShapeStyle.Volume,
		EmissionDirection=Enum.NormalId.Top,Speed=NumberRange.new(up*.5,up),Lifetime=NumberRange.new(.4,.75),SpreadAngle=Vector2.new(15,15),
		Color=ColorSequence.new(SAND),LightEmission=0,LightInfluence=1,Size=K.num({{0,1.2},{.5,2},{1,1.4}}),Transparency=K.num({{0,.15},{.7,.35},{1,1}}),
		Acceleration=Vector3.new(0,-30,0),Drag=1,Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-40,40)},box)
	e:Emit(count)
	Debris:AddItem(box,1.2)
	return box
end
-- A body pours to the floor: each visible part sheds its volume as sand.
local function sandBody(fx,model,at)
	local root=model:FindFirstChild("HumanoidRootPart")
	if not root then return end
	-- The impact may arrive after the body already reappeared elsewhere.
	local shift=at-root.Position
	if shift.Magnitude&lt;1.5 then shift=Vector3.zero end
	local holder=K.new("Model",{Name="SandBody"},fx.folder)
	for _,d in model:GetChildren() do
		if d:IsA("BasePart") and d.Name~="HumanoidRootPart" and d.Transparency&lt;.9 then
			local box=K.block(holder,d.Size,d.CFrame+shift,SAND,Enum.Material.SmoothPlastic);box.Transparency=1
			local e=K.new("ParticleEmitter",{Enabled=false,Texture=K.TEX.smoke,Shape=Enum.ParticleEmitterShape.Box,ShapeStyle=Enum.ParticleEmitterShapeStyle.Volume,
				Speed=NumberRange.new(0,1.5),Lifetime=NumberRange.new(.45,.75),Color=ColorSequence.new(SAND),LightEmission=0,LightInfluence=1,
				Size=K.num({{0,.9},{1,.5}}),Transparency=K.num({{0,.1},{.6,.3},{1,1}}),Acceleration=Vector3.new(0,-45,0),Rotation=NumberRange.new(0,360)},box)
			e:Emit(math.clamp(math.floor(d.Size.X*d.Size.Y*d.Size.Z*4),4,18))
		end
	end
	grains(fx,at,20,8,true)
	Debris:AddItem(holder,1)
end

-- ------------------------------------------------------------------ flights
-- Sand bullet / Sand Shuriken: a small hardened clump tumbling, shedding dust.
local function buildBullet()
	local model=K.new("Model",{Name="SandBullet"})
	local root=K.block(model,Vector3.one*.8,CFrame.new(),SAND,GRAIN);root.Name="Root";root.Shape=Enum.PartType.Ball
	local tail=K.block(model,Vector3.one*.5,CFrame.new(0,.1,.32),SAND_DARK,GRAIN);tail.Name="Tail";tail.Shape=Enum.PartType.Ball
	K.weldAll(root,{tail})
	local at=K.new("Attachment",{},root)
	K.new("ParticleEmitter",{Texture=K.TEX.smoke,Rate=80,Lifetime=NumberRange.new(.25,.45),Speed=NumberRange.new(0,1.5),SpreadAngle=Vector2.new(25,25),
		Color=ColorSequence.new(SAND_PALE),LightEmission=0,LightInfluence=1,Size=K.num({{0,.8},{1,1.8}}),Transparency=K.num({{0,.3},{1,1}}),
		Drag=3,Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-60,60)},at)
	model.PrimaryPart=root
	return model
end
local function bulletPose(_,entry,_,_,look,dt)
	entry.spin+=dt*9
	return look*CFrame.Angles(entry.spin,entry.spin*.6,0)
end
-- Sand Coffin: a wave of sand running along the floor — a churning crest that
-- grows as it travels and lays dust down behind it.
local function buildWave()
	local model=K.new("Model",{Name="SandWave"})
	local root=K.block(model,Vector3.new(3,.4,3),CFrame.new(),SAND,Enum.Material.SmoothPlastic);root.Name="Root";root.Transparency=1
	local at=K.new("Attachment",{Name="Spray"},root)
	K.new("ParticleEmitter",{Name="Crest",Texture=K.TEX.smoke,Shape=Enum.ParticleEmitterShape.Box,ShapeStyle=Enum.ParticleEmitterShapeStyle.Volume,
		EmissionDirection=Enum.NormalId.Top,Rate=170,Lifetime=NumberRange.new(.3,.6),Speed=NumberRange.new(5,11),SpreadAngle=Vector2.new(25,25),
		Color=ColorSequence.new(SAND),LightEmission=0,LightInfluence=1,Size=K.num({{0,1.4},{.5,2.4},{1,1.6}}),Transparency=K.num({{0,.12},{.7,.3},{1,1}}),
		Acceleration=Vector3.new(0,-38,0),Drag=1,Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-60,60)},root)
	K.new("ParticleEmitter",{Name="Spray",Texture=K.TEX.smoke,Rate=60,Lifetime=NumberRange.new(.35,.7),Speed=NumberRange.new(3,7),SpreadAngle=Vector2.new(55,55),
		EmissionDirection=Enum.NormalId.Top,Color=ColorSequence.new(SAND_PALE),LightEmission=0,LightInfluence=1,Size=K.num({{0,1.2},{1,3}}),
		Transparency=K.num({{0,.3},{1,1}}),Drag=3,Acceleration=Vector3.new(0,-6,0),Rotation=NumberRange.new(0,360)},at)
	K.new("ParticleEmitter",{Name="Settle",Texture=K.TEX.smoke,Rate=40,Lifetime=NumberRange.new(.9,1.3),Speed=NumberRange.new(0,.6),SpreadAngle=Vector2.new(180,180),
		Color=ColorSequence.new(SAND_DARK),LightEmission=0,LightInfluence=1,Size=K.num({{0,2.2},{1,3.4}}),Transparency=K.num({{0,.55},{1,1}}),
		Rotation=NumberRange.new(0,360)},at)
	model.PrimaryPart=root
	return model
end
local function wavePose(fx,entry,p,age,look,dt)
	local radius=((p.radius or 1.8)+(p.growth or 0)*math.max(0,age))*1.2
	local pos=look.Position
	entry.groundIn=(entry.groundIn or 0)-dt
	if entry.groundIn&lt;=0 then entry.groundIn=.1;entry.ground=ground(fx,pos,entry.ground or pos.Y-1.6) end
	local y=entry.ground or pos.Y-1.6
	local at=Vector3.new(pos.X,y+.3,pos.Z)
	-- The crest box grows with the wave (the emitter fills the root's volume).
	entry.root.Size=Vector3.new(radius*1.7,.4,radius*1.1)
	return CFrame.lookAt(at,at+flatUnit(p.direction))
end

-- ------------------------------------------------------------------ contacts
local STYLES={}
STYLES.sandhit=function(fx,impact)
	dust(fx,impact.position,8,1.3)
	grains(fx,impact.position,12,14,false)
	thud(fx,impact.position,.3,1.4)
end
STYLES.sandburst=function(fx,impact)
	local y=ground(fx,impact.position,impact.position.Y-2.6)
	dust(fx,impact.position,18,2.4)
	grains(fx,impact.position,26,22,true)
	curtain(fx,CFrame.new(impact.position.X,y+1,impact.position.Z),Vector3.new(5,1.5,5),40,14)
	thud(fx,impact.position,.45,.8)
end
-- The shield: an arc of sand streams snaps up between him and the blow with a
-- curtain of sand in front, then pours back down; a breaking blow bursts it.
STYLES.sandshield=function(fx,impact)
	local at=impact.position
	local face=flatUnit(impact.direction or Vector3.zAxis)
	local breaking=impact.heavy==true
	local centre=at-face*1.6
	local y=ground(fx,centre,centre.Y-3)
	local holder=K.new("Model",{Name="SandShield"},fx.folder)
	local cols={}
	for k=-2,2 do
		local dir=CFrame.fromAxisAngle(Vector3.yAxis,math.rad(k*22)):VectorToWorldSpace(face)
		local foot=Vector3.new(centre.X,y+.2,centre.Z)+dir*2.4
		local c=column(holder,foot,5.6-math.abs(k)*.45,2.6,2.1,.07,dir*.35)
		c.dir=dir
		table.insert(cols,c)
	end
	curtain(fx,CFrame.lookAt(Vector3.new(centre.X,y+2.4,centre.Z)+face*2.3,Vector3.new(centre.X,y+2.4,centre.Z)+face*4),Vector3.new(4.5,4,.8),if breaking then 70 else 45,6)
	dust(fx,at,if breaking then 22 else 10,if breaking then 2.4 else 1.6)
	grains(fx,at,if breaking then 30 else 14,if breaking then 26 else 14,false)
	thud(fx,at,if breaking then .7 else .45,if breaking then .55 else .9)
	if breaking then
		fx:cheer(.6)
		task.delay(.06,function()
			for _,c in cols do
				if c.top.Parent then
					local fly=c.foot+c.dir*4+Vector3.new((math.random()-.5)*2,2+math.random()*2,(math.random()-.5)*2)
					K.tween(c.top,.35,{CFrame=frame(fly,fly-c.foot)});fadeWidths(c.beams,.35)
				end
			end
		end)
		Debris:AddItem(holder,.5)
	else
		task.delay(.24,function()
			for _,c in cols do
				if c.top.Parent then K.tween(c.top,.35,{CFrame=frame(c.foot+Vector3.new(0,.4,0),Vector3.yAxis)},Enum.EasingStyle.Quad,Enum.EasingDirection.In);fadeWidths(c.beams,.35) end
			end
		end)
		Debris:AddItem(holder,.7)
	end
end
-- Sand body-flicker: the body pours to the floor where he stood and a column
-- of sand gathers into him where he reappears.
STYLES.sandflicker=function(fx,impact,folder)
	local from=impact.position
	local to=impact.to or from
	local model=folder and folder:FindFirstChild(impact.owner or "")
	if model then sandBody(fx,model,from) end
	local y=ground(fx,to,to.Y-3)
	local holder=K.new("Model",{Name="SandGather"},fx.folder)
	local c=column(holder,Vector3.new(to.X,y,to.Z),5.5,1.8,1,.12)
	task.delay(.12,function() if c.top.Parent then fadeWidths(c.beams,.22) end end)
	Debris:AddItem(holder,.4)
	dust(fx,to-Vector3.new(0,2.4,0),10,1.5)
	if (to-from).Magnitude&gt;1 then
		for k=1,4 do grains(fx,from:Lerp(to,k/5)-Vector3.new(0,1,0),5,6,true) end
	end
	K.sound(K.anchorPart(fx.folder,from),K.SOUND.whoosh,.35,.6)
end
-- Sand Burial: the sand closes in on the body and bursts.
STYLES.sandburial=function(fx,impact)
	local at=impact.position
	local shell=K.block(fx.folder,Vector3.one*.4,CFrame.new(at),SAND,Enum.Material.SmoothPlastic);shell.Transparency=1
	local e=K.new("ParticleEmitter",{Enabled=false,Texture=K.TEX.smoke,Shape=Enum.ParticleEmitterShape.Sphere,ShapeInOut=Enum.ParticleEmitterShapeInOut.Inward,
		Speed=NumberRange.new(14,20),Lifetime=NumberRange.new(.18,.26),Color=ColorSequence.new(SAND),LightEmission=0,LightInfluence=1,
		Size=K.num({{0,2.4},{1,1.4}}),Transparency=K.num({{0,.1},{1,.4}}),Rotation=NumberRange.new(0,360)},shell)
	shell.Size=Vector3.one*8
	e:Emit(70)
	Debris:AddItem(shell,.6)
	task.delay(.16,function()
		dust(fx,at,30,3)
		grains(fx,at+Vector3.new(0,1,0),40,30,false)
		local y=ground(fx,at,at.Y-3)
		curtain(fx,CFrame.new(at.X,y+1,at.Z),Vector3.new(6,1.5,6),50,18)
		K.sound(K.anchorPart(fx.folder,at),K.SOUND.boom,.55,.6)
	end)
	fx:cheer(1)
end
-- Desert Wave: a wall of sand streams rises in front of him, then its crest
-- falls forward onto whoever stood there.
STYLES.sandwall=function(fx,impact)
	local at=impact.position
	local look=flatUnit(impact.direction or Vector3.zAxis)
	local y=ground(fx,at,at.Y-3)
	local across=Vector3.new(-look.Z,0,look.X)
	local holder=K.new("Model",{Name="DesertWave"},fx.folder)
	for k=-3,3 do
		local foot=Vector3.new(at.X,y,at.Z)+across*k*1.6-look*math.abs(k)*.3
		local height=6.8-math.abs(k)*.5+math.random()*.6
		local c=column(holder,foot,height,2.8,2.1,.12+math.abs(k)*.02,look*.6)
		task.delay(.42,function()
			if not c.top.Parent then return end
			-- The crest tips forward and pours down in front of the wall.
			local fall=foot+look*4.5+Vector3.new(0,1,0)
			K.tween(c.top,.4,{CFrame=frame(fall,fall-foot)},Enum.EasingStyle.Quad,Enum.EasingDirection.In)
			fadeWidths(c.beams,.45)
		end)
	end
	Debris:AddItem(holder,1.1)
	local foot=Vector3.new(at.X,y,at.Z)
	curtain(fx,CFrame.lookAt(foot+Vector3.new(0,1.5,0),foot+Vector3.new(0,1.5,0)+look),Vector3.new(11,2.5,1.4),80,16)
	dust(fx,foot+Vector3.new(0,1,0),26,3)
	grains(fx,foot+Vector3.new(0,.5,0),40,30,true)
	K.sound(K.anchorPart(fx.folder,at),K.SOUND.whoosh,.55,.5)
	thud(fx,at,.5,.6)
	fx:cheer(.6)
end
-- Shukaku's Sand (awakening): sand spirals up around him.
local function awaken(fx,impact,folder)
	local at=impact.position
	local model=folder and folder:FindFirstChild(impact.owner or "")
	if model then fx:ghost(model,SHUKAKU,.35,.45) end
	local y=ground(fx,at,at.Y-3)
	local holder=K.new("Model",{Name="ShukakuSand"},fx.folder)
	for k=0,3 do
		local a=k/4*math.pi*2
		local foot=Vector3.new(at.X,y,at.Z)+Vector3.new(math.cos(a),0,math.sin(a))*2.4
		local c=column(holder,foot,7,1.4,.9,.18,Vector3.new(math.cos(a+1.4),0,math.sin(a+1.4))*2)
		task.delay(.3,function() if c.top.Parent then fadeWidths(c.beams,.3) end end)
	end
	Debris:AddItem(holder,.8)
	dust(fx,Vector3.new(at.X,y+1,at.Z),26,2.8)
	grains(fx,at,40,26,true)
	curtain(fx,CFrame.new(at.X,y+1,at.Z),Vector3.new(7,2,7),60,18)
	fx:cheer(1)
end
local function impact(fx,data,folder)
	local style=data.style
	local handler=STYLES[style]
	if handler then handler(fx,data,folder);return true end
	if data.fighter~="Sand" then return false end
	-- Shared contact styles drawn in sand instead of another fighter's colours.
	if style=="awaken" then awaken(fx,data,folder);return true end
	if style=="chase" or style=="afterimage" then
		local model=folder and folder:FindFirstChild(data.owner or "")
		if model then sandBody(fx,model,data.position) end
		dust(fx,data.position-Vector3.new(0,2.6,0),8,1.4)
		K.sound(K.anchorPart(fx.folder,data.position),K.SOUND.whoosh,.35,.7)
		return true
	end
	return false
end

-- ------------------------------------------------------------------ per frame
-- Lashes: a stream of sand from the hand that strikes, out on the clip's
-- contact key, held through the active frames, drawn back in the recovery.
local LASH={
	Light1={{"RightHand",1}},Light2={{"LeftHand",-1}},Light3={{"RightHand",.7},{"LeftHand",-.7}},
	Air1={{"RightHand",1}},Air2={{"LeftHand",-1}},Riposte={{"RightHand",1}},
	DashAttack={{"RightHand",.45},{"LeftHand",-.45}},Sweep={{"RightHand",1.3,low=true}},
	Slam={{"RightHand",.25,down=true},{"LeftHand",-.25,down=true}},
}
-- The move's own timeline as the motion engine plays it (same per-fighter
-- timings and lead), so the sand leaves the hand on the clip's contact key.
local LEAD=.03
local function timing(name)
	local spec=Attacks[name] or Attacks.Light1
	local profile=Fighters.Sand.AttackProfile and Fighters.Sand.AttackProfile[name]
	return spec.startup*(profile and profile.startup or 1),spec.active*(profile and profile.active or 1),spec.recovery*(profile and profile.recovery or 1)
end
local function reachOf(name)
	local profile=Fighters.Sand.AttackProfile and Fighters.Sand.AttackProfile[name]
	return (profile and profile.range) or (Attacks[name] and Attacks[name].range) or 8
end
local function stateOf(fx,model)
	fx.sandState=fx.sandState or setmetatable({},{__mode="k"})
	local st=fx.sandState[model]
	if not st then st={};fx.sandState[model]=st end
	return st
end
local function newLash(fx,spec)
	local holder=K.new("Model",{Name="SandLash"},fx.folder)
	local h0,a0=handle(holder,Vector3.zero)
	local h1,a1=handle(holder,Vector3.zero)
	h1.Name="Tip"
	local beams=stream(holder,a0,a1,0,0)
	local spray=K.new("ParticleEmitter",{Texture=K.TEX.smoke,Rate=0,Lifetime=NumberRange.new(.2,.4),Speed=NumberRange.new(1,3),SpreadAngle=Vector2.new(180,180),
		Color=ColorSequence.new(SAND),LightEmission=0,LightInfluence=1,Size=K.num({{0,1.4},{1,2.2}}),Transparency=K.num({{0,.2},{1,1}}),Drag=4,
		Rotation=NumberRange.new(0,360)},a1)
	return {holder=holder,h0=h0,h1=h1,beams=beams,spray=spray,hand=spec[1],arc=spec[2],low=spec.low,down=spec.down}
end
local function dropLashes(st)
	for _,l in st.lashes or {} do l.holder:Destroy() end
	st.lashes=nil
end
-- Sand Pillar: sand erupts under the opponent when he stands in the volume,
-- otherwise where the volume ends: twisting streams, a crown that bursts open
-- and a geyser of sand.
local function pillar(fx,model,root)
	local look=flatUnit(root.CFrame.LookVector)
	local spot=root.Position+look*7
	for _,id in fx.fighterIds or {} do
		local other=fx.fighters and fx.fighters:FindFirstChild(id)
		local r=other and other~=model and other:FindFirstChild("HumanoidRootPart")
		if r then
			local d=r.Position-root.Position
			local f=Vector3.new(d.X,0,d.Z)
			if f.Magnitude&lt;13 and (f.Magnitude&lt;1 or look:Dot(f.Unit)&gt;.25) then spot=r.Position end
		end
	end
	local base=Vector3.new(spot.X,ground(fx,spot,root.Position.Y-3),spot.Z)
	local holder=K.new("Model",{Name="SandPillar"},fx.folder)
	local cols={}
	for k=0,2 do
		local a=k/3*math.pi*2
		local off=Vector3.new(math.cos(a),0,math.sin(a))*.9
		local twist=Vector3.new(math.cos(a+1.2),0,math.sin(a+1.2))*.9-off
		table.insert(cols,column(holder,base+off,10,4.2,2.4,.1+k*.02,twist))
	end
	local top=base+Vector3.new(0,10,0)
	task.delay(.08,function()
		K.burst(fx.folder,top,{Texture=K.TEX.smoke,Lifetime=NumberRange.new(.5,.9),Speed=NumberRange.new(14,26),SpreadAngle=Vector2.new(45,45),
			EmissionDirection=Enum.NormalId.Top,Color=ColorSequence.new(SAND),LightEmission=0,LightInfluence=1,Size=K.num({{0,1.8},{1,3.6}}),
			Transparency=K.num({{0,.2},{1,1}}),Acceleration=Vector3.new(0,-40,0),Drag=1,Rotation=NumberRange.new(0,360)},34)
	end)
	task.delay(.3,function()
		for _,c in cols do
			if c.top.Parent then K.tween(c.top,.45,{CFrame=frame(c.foot+Vector3.new(0,2,0),Vector3.yAxis)},Enum.EasingStyle.Quad,Enum.EasingDirection.In);fadeWidths(c.beams,.45) end
		end
	end)
	Debris:AddItem(holder,.9)
	curtain(fx,CFrame.new(base+Vector3.new(0,1,0)),Vector3.new(5,1.5,5),40,22)
	dust(fx,base+Vector3.new(0,1,0),22,2.4)
	grains(fx,base+Vector3.new(0,1.5,0),34,34,true)
	thud(fx,base,.6,.55)
end
local function stepStrike(fx,model,actor,st)
	local root=model:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local name=actor.attackName
	local swinging=name~=nil and (actor.state=="Startup" or actor.state=="Active" or actor.state=="Recovery")
	local serial=actor.attackSerial or 0
	if swinging and serial~=st.serial then
		-- A new swing: its clock starts where the server's is, like the clip's.
		st.serial=serial
		dropLashes(st)
		st.name=name;st.cut=nil;st.landed=false;st.pillarDone=name~="SandPillar"
		st.startedAt=SandFX.clock()-math.clamp(actor.attackElapsed or 0,0,.12)
		if LASH[name] then
			st.lashes={}
			for _,spec in LASH[name] do table.insert(st.lashes,newLash(fx,spec)) end
		end
	end
	if not st.name then return end
	local startup,active,recovery=timing(st.name)
	local t=SandFX.clock()-st.startedAt+LEAD
	if not st.pillarDone and t&gt;=startup*.9 then st.pillarDone=true;pillar(fx,model,root) end
	if not st.lashes then
		if t&gt;startup+active+recovery then st.name=nil end
		return
	end
	local out0=startup*.45
	local ext=if t&lt;out0 then 0 elseif t&lt;startup then smooth((t-out0)/math.max(startup-out0,1e-3))
		elseif t&lt;startup+active then 1 else 1-smooth((t-startup-active)/math.max(recovery*.55,1e-3))
	-- Hit out of the swing: the sand collapses at once.
	if actor.reaction or actor.state=="Stunned" then st.cut=st.cut or SandFX.clock() end
	if st.cut then ext=math.min(ext,1-(SandFX.clock()-st.cut)/.12) end
	if ext&lt;=0 and (t&gt;startup or st.cut) then dropLashes(st);st.name=nil;return end
	local reach=reachOf(st.name)
	local base=root.CFrame
	for _,l in st.lashes do
		local hand=model:FindFirstChild(l.hand)
		local from=if hand then hand.Position else base.Position
		local tipLocal=if l.down then Vector3.new(l.arc*.8,-2.6,-reach*.75) elseif l.low then Vector3.new(l.arc*.6,-2.5,-reach) else Vector3.new(l.arc*.5,.2,-reach)
		local tip=base:PointToWorldSpace(tipLocal)
		local mid=from:Lerp(tip,.45)+base.RightVector*l.arc*reach*.22+Vector3.new(0,if l.down then 2.2 else .9,0)
		-- The part of the curve already out: a quadratic Bezier cut at `ext`,
		-- drawn as the Beam's cubic (CurveSize along each handle's axis).
		local u=math.max(ext,.02)
		local c1=from:Lerp(mid,u)
		local p1=c1:Lerp(mid:Lerp(tip,u),u)
		local q1=from+(c1-from)*(2/3)
		local q2=p1+(c1-p1)*(2/3)
		l.h0.CFrame=frame(from,q1-from)
		l.h1.CFrame=frame(p1,p1-q2)
		curves(l.beams,(q1-from).Magnitude,(p1-q2).Magnitude)
		widths(l.beams,.45*ext,1.5*ext)
		l.spray.Rate=if ext&gt;.6 then 60 else 0
	end
	if not st.landed and t&gt;=startup and not st.cut then
		st.landed=true
		for _,l in st.lashes do
			local at=l.h1.Position
			grains(fx,at,12,12,false)
			dust(fx,at,6,1.2)
		end
	end
end
-- Shield charges: one cluster of sand circling his hips per charge. They dim
-- while he swings or is hurt, the moments the shield does not answer.
local function stepCharges(fx,model,actor,st,dt)
	local max=actor.shieldMax or 0
	local root=model:FindFirstChild("HumanoidRootPart")
	if max&lt;=0 or not root or (actor.health or 1)&lt;=0 then
		if st.charges then st.charges.holder:Destroy();st.charges=nil end
		return
	end
	if not st.charges or not st.charges.holder.Parent then
		local holder=K.new("Model",{Name="SandShieldCharges"},fx.folder)
		local list={}
		for i=1,max do
			local orb=K.block(holder,Vector3.one*.5,root.CFrame,SAND,GRAIN);orb.Shape=Enum.PartType.Ball
			K.new("ParticleEmitter",{Texture=K.TEX.smoke,Rate=14,Lifetime=NumberRange.new(.3,.5),Speed=NumberRange.new(0,.5),Color=ColorSequence.new(SAND_PALE),
				LightEmission=0,LightInfluence=1,Size=K.num({{0,.6},{1,1}}),Transparency=K.num({{0,.5},{1,1}}),Rotation=NumberRange.new(0,360)},orb)
			list[i]={part=orb,shown=0}
		end
		st.charges={holder=holder,list=list,spin=0,count=actor.shield or 0}
	end
	local o=st.charges
	local count=actor.shield or 0
	for i=count+1,o.count do local e=o.list[i];if e then grains(fx,e.part.Position,6,6,false) end end
	o.count=count
	o.spin+=dt*(if (actor.awaken or 0)&gt;0 then 2.6 else 1.5)
	local open=actor.state=="Startup" or actor.state=="Active" or actor.state=="Recovery" or actor.state=="Stunned" or actor.reaction~=nil
	for i,e in o.list do
		local want=if i&lt;=count then (if open then .3 else 1) else 0
		e.shown+=(want-e.shown)*math.min(1,dt*10)
		local a=o.spin+(i-1)/#o.list*math.pi*2
		e.part.CFrame=CFrame.new(root.Position+Vector3.new(math.cos(a)*2.1,-.5+math.sin(o.spin*2+i)*.18,math.sin(a)*2.1))
		e.part.Size=Vector3.one*(.18+.3*e.shown)
		e.part.Transparency=1-e.shown*.95
	end
end
-- Bound in Sand Coffin (any fighter whose opponent is Gaara): streams of sand
-- wind up the body from the feet and hold it.
local function stepCoffin(fx,model,actor,st)
	local held=actor.bound==true and actor.opponentFighter=="Sand" and (actor.health or 1)&gt;0
	local root=model:FindFirstChild("HumanoidRootPart")
	if held and root and not (st.coffin and st.coffin.holder.Parent) then
		local holder=K.new("Model",{Name="SandCoffin"},fx.folder)
		local winds={}
		for k=0,2 do
			local h0,a0=handle(holder,root.Position)
			local h1,a1=handle(holder,root.Position)
			table.insert(winds,{h0=h0,h1=h1,beams=stream(holder,a0,a1,1.4,1),phase=k/3*math.pi*2})
		end
		local swirl=K.new("ParticleEmitter",{Texture=K.TEX.smoke,Rate=50,Lifetime=NumberRange.new(.4,.8),Speed=NumberRange.new(1,3),SpreadAngle=Vector2.new(180,180),
			Color=ColorSequence.new(SAND),LightEmission=0,LightInfluence=1,Size=K.num({{0,1.2},{1,2.4}}),Transparency=K.num({{0,.35},{1,1}}),
			Drag=2,Acceleration=Vector3.new(0,-3,0),Rotation=NumberRange.new(0,360)},K.new("Attachment",{},winds[1].h0))
		st.coffin={holder=holder,winds=winds,born=SandFX.clock(),swirl=swirl}
		thud(fx,root.Position,.5,.5)
	elseif not held and st.coffin then
		local c=st.coffin;st.coffin=nil
		c.swirl.Enabled=false
		for _,w in c.winds do fadeWidths(w.beams,.3) end
		Debris:AddItem(c.holder,.35)
	end
	local c=st.coffin
	if c and root then
		local grow=smooth((SandFX.clock()-c.born)/.35)
		local spin=SandFX.clock()*2.4
		for _,w in c.winds do
			local a=spin+w.phase
			local foot=root.Position+Vector3.new(math.cos(a)*1.7,-2.8,math.sin(a)*1.7)
			local b=a+2.2
			local top=root.Position+Vector3.new(math.cos(b)*1.5,-2.8+4.4*grow,math.sin(b)*1.5)
			w.h0.CFrame=frame(foot,top-foot)
			w.h1.CFrame=frame(top,top-foot)
		end
	end
end
-- The shared speed trail and awakening mantle, in sand.
local function tint(fx,model)
	local aura=fx.auras and fx.auras[model]
	if not aura then return end
	if aura.trail and not aura.sandTrail then aura.trail.Color=ColorSequence.new(SAND);aura.sandTrail=true end
	if aura.mantle and aura.sandMantle~=aura.mantle then
		aura.mantle.emitter.Color=ColorSequence.new(SHUKAKU)
		aura.mantle.emitter.Texture=K.TEX.smoke
		aura.mantle.emitter.LightEmission=.2
		aura.mantle.light.Color=SHUKAKU
		aura.sandMantle=aura.mantle
	end
end
-- The re-engage is a glide on a wave of sand, not a run: sand pours under
-- his feet for as long as it lasts.
local function stepGlide(fx,model,actor,st)
	local root=model:FindFirstChild("HumanoidRootPart")
	local gliding=actor.state=="Rush" and (actor.health or 1)&gt;0
	if gliding and root and not (st.glide and st.glide.Parent) then
		local at=K.new("Attachment",{Name="SandGlide",Position=Vector3.new(0,-2.8,0)},root)
		K.new("ParticleEmitter",{Texture=K.TEX.smoke,Rate=90,Lifetime=NumberRange.new(.3,.6),Speed=NumberRange.new(2,5),SpreadAngle=Vector2.new(70,70),
			EmissionDirection=Enum.NormalId.Top,Color=ColorSequence.new(SAND),LightEmission=0,LightInfluence=1,Size=K.num({{0,1.4},{1,3.2}}),
			Transparency=K.num({{0,.2},{1,1}}),Drag=3,Acceleration=Vector3.new(0,-8,0),Rotation=NumberRange.new(0,360)},at)
		st.glide=at
	elseif not gliding and st.glide then
		local e=st.glide:FindFirstChildOfClass("ParticleEmitter");if e then e.Enabled=false end
		Debris:AddItem(st.glide,.7);st.glide=nil
	end
end
local function fighter(fx,model,actor,dt)
	if not model or not actor then return end
	local st=stateOf(fx,model)
	stepCoffin(fx,model,actor,st)
	if actor.fighterId~="Sand" then return end
	stepGlide(fx,model,actor,st)
	stepStrike(fx,model,actor,st)
	stepCharges(fx,model,actor,st,dt)
	tint(fx,model)
end

function SandFX.install(FX,kit)
	K=kit
	kit.BUILD.sand=buildBullet
	kit.BUILD.sandwave=buildWave
	FX.poses.sand=bulletPose
	FX.poses.sandwave=wavePose
	table.insert(FX.layers,{name="Sand",impact=impact,fighter=fighter})
end
SandFX.STYLES=STYLES
return SandFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND143">
          <Properties>
            <string name="Name">UI</string>
            <ProtectedString name="Source">-- Prodigy Tournament interface: roster/selection, online queue and fighter
-- pick, duel HUD, match intro and result framing. Presentation only; every
-- value comes from the snapshot.
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Fighters=require(Shared.Fighters)
local Roster=require(Shared.Roster)
local Controls=require(Shared.Controls)
local MoveGraphs=require(Shared.MoveGraphs)
local Protocol=require(Shared.OnlineProtocol)
local GuiService=game:GetService("GuiService")
local UIS=game:GetService("UserInputService")
local Tween=game:GetService("TweenService")
local UI={}; UI.__index=UI
local palette={
	ink=Color3.fromRGB(16,15,20),panel=Color3.fromRGB(28,26,32),paper=Color3.fromRGB(240,232,212),
	text=Color3.fromRGB(240,236,226),muted=Color3.fromRGB(170,164,150),red=Color3.fromRGB(190,40,36),
	gold=Color3.fromRGB(230,184,86),blue=Color3.fromRGB(82,177,244),crimson=Color3.fromRGB(222,70,80),
	track=Color3.fromRGB(46,42,48),locked=Color3.fromRGB(38,36,42),
}
local TITLE_FONT=Enum.Font.Bangers
local BODY_FONT=Enum.Font.GothamBold
local function create(class,parent,props)
	local x=Instance.new(class)
	for k,v in props do x[k]=v end
	x.Parent=parent; return x
end
local function frame(parent,position,size,color,transparency)
	return create("Frame",parent,{Position=position,Size=size,BackgroundColor3=color or palette.panel,BorderSizePixel=0,BackgroundTransparency=transparency or 0})
end
local function text(parent,value,position,size,fontSize,color,font,align)
	return create("TextLabel",parent,{Text=value,Position=position,Size=size,TextSize=fontSize or 16,Font=font or BODY_FONT,
		TextColor3=color or palette.text,BackgroundTransparency=1,TextXAlignment=align or Enum.TextXAlignment.Left,TextWrapped=true})
end
local function corner(parent,radius) return create("UICorner",parent,{CornerRadius=UDim.new(0,radius or 6)}) end
local function stroke(parent,color,thickness) return create("UIStroke",parent,{Color=color or palette.ink,Thickness=thickness or 2}) end
local function button(parent,value,position,size,callback,color)
	local b=create("TextButton",parent,{Text=value,Position=position,Size=size,TextSize=24,Font=TITLE_FONT,TextColor3=palette.text,
		BackgroundColor3=color or palette.panel,BorderSizePixel=0,AutoButtonColor=true})
	corner(b,6)
	b.Activated:Connect(callback); return b
end
local function accentOf(def) return Color3.fromRGB(table.unpack(def.Color)) end
-- A tiny posed figure built from the fighter's palette.
local function portrait(parent,def,position,size)
	local vp=create("ViewportFrame",parent,{Position=position,Size=size or UDim2.fromOffset(100,116),BackgroundTransparency=1,
		Ambient=Color3.fromRGB(190,186,180),LightColor=Color3.new(1,1,1),LightDirection=Vector3.new(-1,-1,-1)})
	local function p(sz,at,color)
		create("Part",vp,{Size=sz,CFrame=CFrame.new(at),Color=if typeof(color)=="Color3" then color else Color3.fromRGB(table.unpack(color)),Anchored=true})
	end
	p(Vector3.new(2,2,1),Vector3.zero,def.Outfit)
	p(Vector3.new(1.6,1.6,1.6),Vector3.new(0,1.7,0),def.Skin)
	p(Vector3.new(1.8,.7,1.8),Vector3.new(0,2.55,0),def.Hair)
	p(Vector3.new(1.7,.25,1.7),Vector3.new(0,2.1,0),Color3.fromRGB(28,36,58))
	for _,s in {-1,1} do p(Vector3.new(.9,2,.9),Vector3.new(s*1.45,0,0),def.Outfit) end
	local camera=create("Camera",vp,{CFrame=CFrame.lookAt(Vector3.new(3.5,2.6,-7.5),Vector3.new(0,.9,0))})
	vp.CurrentCamera=camera
	return vp
end
local ROSTER_SLOTS=20
function UI.new(parent,send)
	local self=setmetatable({player="Flashstep",bot="Mirage",send=send,selectionButtons={},introShown=nil},UI)
	self.gui=create("ScreenGui",parent,{Name="NinjaDuelHUD",ResetOnSpawn=false,IgnoreGuiInset=true,ZIndexBehavior=Enum.ZIndexBehavior.Sibling})
	-- ------------------------------------------------------------ selection
	self.selection=frame(self.gui,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.ink,.08)
	local shell=frame(self.selection,UDim2.fromScale(.5,.5),UDim2.fromOffset(900,712),palette.ink,1)
	shell.AnchorPoint=Vector2.new(.5,.5)
	local scale=create("UIScale",shell,{Scale=1})
	local function resize() scale.Scale=math.min(1.2,workspace.CurrentCamera.ViewportSize.X/980,workspace.CurrentCamera.ViewportSize.Y/772) end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(resize);resize()
	frame(shell,UDim2.fromOffset(0,74),UDim2.fromOffset(900,4),palette.red)
	text(shell,"PRODIGY TOURNAMENT",UDim2.fromOffset(0,0),UDim2.fromOffset(620,72),64,palette.paper,TITLE_FONT)
	text(shell,"天才忍者大会",UDim2.fromOffset(620,10),UDim2.fromOffset(280,56),40,palette.red,BODY_FONT,Enum.TextXAlignment.Right)
	text(shell,"Twenty future legends. Twelve to fourteen years old. One stage — before they become who they are meant to be.",
		UDim2.fromOffset(2,86),UDim2.fromOffset(896,40),16,palette.muted)
	-- Roster: the two prodigies who have arrived, and the slots still empty.
	local grid=frame(shell,UDim2.fromOffset(0,136),UDim2.fromOffset(900,230),palette.ink,1)
	-- The playable roster, in menu order (Shared/Roster).
	local playable=table.clone(Roster)
	for index=1,ROSTER_SLOTS do
		local col=(index-1)%10;local row=math.floor((index-1)/10)
		local slot=frame(grid,UDim2.fromOffset(col*90,row*116),UDim2.fromOffset(84,108),palette.locked)
		corner(slot,6)
		local id=playable[index]
		if id then
			local def=Fighters[id]
			slot.BackgroundColor3=palette.panel
			stroke(slot,accentOf(def),2)
			portrait(slot,def,UDim2.fromOffset(2,2),UDim2.fromOffset(80,78))
			text(slot,string.upper(def.Name),UDim2.fromOffset(0,80),UDim2.fromOffset(84,26),20,accentOf(def),TITLE_FONT,Enum.TextXAlignment.Center)
			local pick=create("TextButton",slot,{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text=""})
			pick.Activated:Connect(function()
				if self.picking then self:choose(id);return end
				self.player=id
				if self.bot==id then self.bot=playable[index%#playable+1] end
				self:refreshSelection()
			end)
			self.selectionButtons["slot"..id]=slot
		else
			text(slot,"?",UDim2.fromOffset(0,14),UDim2.fromOffset(84,56),48,Color3.fromRGB(70,66,74),TITLE_FONT,Enum.TextXAlignment.Center)
			text(slot,"PRODIGY "..index,UDim2.fromOffset(0,78),UDim2.fromOffset(84,22),14,Color3.fromRGB(96,90,98),TITLE_FONT,Enum.TextXAlignment.Center)
		end
	end
	-- Matchup panel.
	self.matchup=text(shell,"",UDim2.fromOffset(0,372),UDim2.fromOffset(900,44),38,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
	self.matchupNote=text(shell,"",UDim2.fromOffset(0,410),UDim2.fromOffset(900,34),13,palette.muted,BODY_FONT,Enum.TextXAlignment.Center)
	-- The selected fighter's reading of the shared combo grammar.
	self.routeNote=text(shell,"",UDim2.fromOffset(0,440),UDim2.fromOffset(900,16),12,palette.gold,BODY_FONT,Enum.TextXAlignment.Center)
	text(shell,"YOU",UDim2.fromOffset(0,460),UDim2.fromOffset(200,18),14,palette.muted)
	self.opponentLabel=text(shell,"OPPONENT (AI)",UDim2.fromOffset(470,460),UDim2.fromOffset(430,18),14,palette.muted)
	-- Fighter buttons: a five-wide grid on each half of the panel, however
	-- many are playable (twenty fill four rows). During an online pick the
	-- left half is yours, the right shows the opponent's.
	local COLS=5
	local function cell(i) return (i-1)%COLS*86,480+math.floor((i-1)/COLS)*26 end
	for i,id in playable do
		local x,y=cell(i)
		self.selectionButtons["player"..id]=button(shell,string.upper(Fighters[id].Name),UDim2.fromOffset(x,y),UDim2.fromOffset(82,22),function()
			if self.picking then self:choose(id);return end
			self.player=id; self:refreshSelection()
		end)
		self.selectionButtons["bot"..id]=button(shell,string.upper(Fighters[id].Name),UDim2.fromOffset(470+x,y),UDim2.fromOffset(82,22),function()
			if self.picking then return end
			self.bot=id; self:refreshSelection()
		end)
	end
	-- A long name (ROCK LEE, OROCHIMARU) shrinks to fit its button.
	for _,id in playable do
		for _,side in {"player","bot"} do
			local b=self.selectionButtons[side..id]
			b.TextScaled=true
			create("UITextSizeConstraint",b,{MaxTextSize=16})
		end
	end
	local below=480+math.ceil(#playable/COLS)*26+8
	self.startButton=button(shell,"ENTER THE STAGE",UDim2.fromOffset(470,below),UDim2.fromOffset(430,52),function()
		if self.picking then send("Confirm") else send("Start",{player=self.player,bot=self.bot}) end
	end,palette.red)
	self.tutorialButton=button(shell,"TRAINING (TUTORIAL)",UDim2.fromOffset(0,below),UDim2.fromOffset(430,52),function()
		if self.picking then send("Cancel") else send("Tutorial",{player=self.player,bot=self.bot}) end
	end)
	-- Online 1v1 with the fighter chosen above: casual queue, or a private duel
	-- by code (host one, or type a friend's code and join).
	self.onlineRow=frame(shell,UDim2.fromOffset(0,below+60),UDim2.fromOffset(900,40),palette.ink,1)
	self.queueButton=button(self.onlineRow,"ONLINE DUEL",UDim2.fromOffset(0,0),UDim2.fromOffset(290,40),function() send("Queue",{player=self.player}) end)
	self.hostButton=button(self.onlineRow,"HOST PRIVATE DUEL",UDim2.fromOffset(300,0),UDim2.fromOffset(290,40),function() send("Host",{player=self.player}) end)
	local codeBox=create("TextBox",self.onlineRow,{Position=UDim2.fromOffset(600,0),Size=UDim2.fromOffset(170,40),Text="",PlaceholderText="CODE",
		TextSize=24,Font=TITLE_FONT,TextColor3=palette.text,PlaceholderColor3=palette.muted,BackgroundColor3=palette.panel,BorderSizePixel=0,ClearTextOnFocus=false})
	corner(codeBox,6)
	codeBox:GetPropertyChangedSignal("Text"):Connect(function()
		local clean=string.sub(string.gsub(string.upper(codeBox.Text),"[^A-Z0-9]",""),1,Protocol.CodeLength)
		if clean~=codeBox.Text then codeBox.Text=clean end
	end)
	self.codeBox=codeBox
	self.joinButton=button(self.onlineRow,"JOIN",UDim2.fromOffset(780,0),UDim2.fromOffset(120,40),function() send("Join",{player=self.player,code=codeBox.Text}) end)
	self.notice=text(shell,"",UDim2.fromOffset(0,below+104),UDim2.fromOffset(900,18),13,palette.gold,BODY_FONT,Enum.TextXAlignment.Center)
	-- ------------------------------------------------------------------ HUD
	self.hud=frame(self.gui,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.ink,1)
	local hudScale=create("UIScale",self.hud,{Scale=1})
	self.hudScale=hudScale
	local function plate(side)
		local right=side=="right"
		local box=frame(self.hud,if right then UDim2.new(1,-24,0,18) else UDim2.fromOffset(24,18),UDim2.fromOffset(440,92),palette.ink,.25)
		box.AnchorPoint=Vector2.new(if right then 1 else 0,0)
		corner(box,8)
		local align=if right then Enum.TextXAlignment.Right else Enum.TextXAlignment.Left
		local name=text(box,"",UDim2.fromOffset(14,4),UDim2.fromOffset(412,34),32,palette.paper,TITLE_FONT,align)
		local title=text(box,"",UDim2.fromOffset(14,36),UDim2.fromOffset(412,16),12,palette.muted,BODY_FONT,align)
		local track=frame(box,UDim2.fromOffset(14,56),UDim2.fromOffset(412,14),palette.track)
		corner(track,4)
		local lag=frame(track,UDim2.fromScale(0,0),UDim2.fromScale(1,1),Color3.fromRGB(240,220,190))
		corner(lag,4)
		local fill=frame(track,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.gold)
		corner(fill,4)
		if right then lag.AnchorPoint=Vector2.new(1,0);lag.Position=UDim2.fromScale(1,0);fill.AnchorPoint=Vector2.new(1,0);fill.Position=UDim2.fromScale(1,0) end
		local chakraTrack=frame(box,UDim2.fromOffset(14,74),UDim2.fromOffset(412,6),palette.track)
		local chakra=frame(chakraTrack,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.blue)
		if right then chakra.AnchorPoint=Vector2.new(1,0);chakra.Position=UDim2.fromScale(1,0) end
		local status=text(box,"",UDim2.fromOffset(14,80),UDim2.fromOffset(412,12),10,palette.muted,BODY_FONT,align)
		-- Neji's chakra points closed on this fighter: four pips at the far end of
		-- the status row (both players read them), each lit as it closes.
		local points={}
		for k=1,4 do
			local pip=frame(box,UDim2.fromOffset(if right then 19+(k-1)*13 else 421-(k-1)*13,86),UDim2.fromOffset(9,9),palette.track)
			pip.AnchorPoint=Vector2.new(.5,.5);pip.Visible=false
			corner(pip,5)
			points[k]=pip
		end
		-- Substitution charges: two diamonds, the recharging one fills up.
		local pips={}
		for k=1,2 do
			local x=if right then 14+(k-1)*26 else 404-(k-1)*26
			local pip=frame(box,UDim2.fromOffset(x,12),UDim2.fromOffset(16,16),palette.track)
			pip.Rotation=45;pip.ClipsDescendants=true
			local fill=frame(pip,UDim2.fromScale(0,1),UDim2.fromScale(1,1),palette.paper)
			fill.AnchorPoint=Vector2.new(0,1)
			pips[k]={pip=pip,fill=fill}
		end
		local subLabel=text(box,"SUB",UDim2.fromOffset(if right then 68 else 314,14),UDim2.fromOffset(36,12),10,palette.muted,BODY_FONT,
			if right then Enum.TextXAlignment.Left else Enum.TextXAlignment.Right)
		-- Round wins: small medallions under the plate.
		local medals={}
		for k=1,2 do
			local m=frame(box,UDim2.fromOffset(if right then 412-(k-1)*20 else 14+(k-1)*20,96),UDim2.fromOffset(14,14),palette.track)
			corner(m,7);table.insert(medals,m)
		end
		-- The awakening while it burns: its name, the time left and what it
		-- changes in the fight (UI.awakening), under the plate.
		local awake=text(box,"",UDim2.fromOffset(14,114),UDim2.fromOffset(412,30),13,palette.gold,TITLE_FONT,align)
		create("UIStroke",awake,{Color=palette.ink,Thickness=1.5,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
		return {box=box,name=name,title=title,fill=fill,lag=lag,chakra=chakra,status=status,pips=pips,subLabel=subLabel,medals=medals,points=points,pointsShown=0,awake=awake}
	end
	self.hp=plate("left")
	self.enemy=plate("right")
	self.round=text(self.hud,"ROUND 1",UDim2.new(.5,-120,0,22),UDim2.fromOffset(240,30),26,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
	self.roundSub=text(self.hud,"PRODIGY TOURNAMENT",UDim2.new(.5,-120,0,50),UDim2.fromOffset(240,16),11,palette.muted,BODY_FONT,Enum.TextXAlignment.Center)
	self.cue=text(self.hud,"",UDim2.new(.5,-300,0,124),UDim2.fromOffset(600,40),30,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
	create("UIStroke",self.cue,{Color=palette.ink,Thickness=2,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
	self.channel=text(self.hud,"",UDim2.new(.5,-250,0,166),UDim2.fromOffset(500,28),15,palette.muted,BODY_FONT,Enum.TextXAlignment.Center)
	self.statusLine=text(self.hud,"",UDim2.new(0,24,1,-118),UDim2.fromOffset(420,16),12,palette.muted)
	-- Combo counters: yours on the left, the opponent's on you on the right.
	local function counter(side)
		local right=side=="right"
		local box=frame(self.hud,if right then UDim2.new(1,-40,.36,0) else UDim2.new(0,40,.36,0),UDim2.fromOffset(220,90),palette.ink,1)
		box.AnchorPoint=Vector2.new(if right then 1 else 0,0)
		local align=if right then Enum.TextXAlignment.Right else Enum.TextXAlignment.Left
		local hits=text(box,"",UDim2.fromOffset(0,0),UDim2.fromOffset(220,56),54,palette.paper,TITLE_FONT,align)
		create("UIStroke",hits,{Color=palette.ink,Thickness=3,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
		local detail=text(box,"",UDim2.fromOffset(0,56),UDim2.fromOffset(220,18),14,palette.gold,BODY_FONT,align)
		create("UIStroke",detail,{Color=palette.ink,Thickness=1.5,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
		return {box=box,hits=hits,detail=detail,shown=0}
	end
	self.comboMine=counter("left")
	self.comboTheirs=counter("right")
	self.techniqueButtons={}
	for i=1,5 do
		local box=frame(self.hud,UDim2.new(.5,-440+(i-1)*178,1,-122),UDim2.fromOffset(170,58),palette.ink,.2)
		corner(box,8)
		local key=text(box,"",UDim2.fromOffset(8,4),UDim2.fromOffset(154,18),14,palette.gold,TITLE_FONT)
		local title=text(box,"",UDim2.fromOffset(8,22),UDim2.fromOffset(154,20),18,palette.paper,TITLE_FONT)
		local status=text(box,"",UDim2.fromOffset(8,43),UDim2.fromOffset(154,12),11,palette.muted)
		local cool=frame(box,UDim2.fromScale(0,1),UDim2.fromScale(1,0),palette.ink,.35)
		cool.AnchorPoint=Vector2.new(0,1);corner(cool,8)
		self.techniqueButtons[i]={box=box,key=key,title=title,status=status,cool=cool}
	end
	self.help=text(self.hud,Controls.Help,UDim2.new(.5,-640,1,-30),UDim2.fromOffset(1280,22),11,palette.muted,BODY_FONT,Enum.TextXAlignment.Center)
	self.grammar=text(self.hud,Controls.Grammar,UDim2.new(.5,-640,1,-48),UDim2.fromOffset(1280,18),11,Color3.fromRGB(196,176,130),BODY_FONT,Enum.TextXAlignment.Center)
	self.hint=text(self.hud,"",UDim2.new(.5,-260,0,200),UDim2.fromOffset(520,30),18,palette.gold,TITLE_FONT,Enum.TextXAlignment.Center)
	self.ko=text(self.hud,"K.O.",UDim2.new(.5,-300,.3,0),UDim2.fromOffset(600,130),120,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
	create("UIStroke",self.ko,{Color=palette.red,Thickness=5,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
	self.ko.Visible=false
	-- ---------------------------------------------------------------- intro
	-- (Partie 1 feedback) The names sit at the bottom edge and the round title
	-- at the top, like a fighting game's entrance: the middle of the screen is
	-- left to the close-up of each fighter's pose (Camera intro shots).
	self.intro=frame(self.gui,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.ink,1)
	self.introLeft=frame(self.intro,UDim2.new(0,0,1,-118),UDim2.new(.5,0,0,110),palette.ink,.15)
	self.introRight=frame(self.intro,UDim2.new(.5,0,1,-118),UDim2.new(.5,0,0,110),palette.ink,.15)
	self.introLeftName=text(self.introLeft,"",UDim2.new(0,40,0,6),UDim2.new(1,-80,0,64),64,palette.paper,TITLE_FONT)
	self.introLeftTitle=text(self.introLeft,"",UDim2.new(0,42,0,70),UDim2.new(1,-80,0,26),18,palette.muted)
	self.introRightName=text(self.introRight,"",UDim2.new(0,40,0,6),UDim2.new(1,-80,0,64),64,palette.paper,TITLE_FONT,Enum.TextXAlignment.Right)
	self.introRightTitle=text(self.introRight,"",UDim2.new(0,40,0,70),UDim2.new(1,-82,0,26),18,palette.muted,BODY_FONT,Enum.TextXAlignment.Right)
	self.introVs=text(self.intro,"VS",UDim2.new(.5,-80,1,-110),UDim2.fromOffset(160,96),88,palette.red,TITLE_FONT,Enum.TextXAlignment.Center)
	create("UIStroke",self.introVs,{Color=palette.paper,Thickness=3,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
	self.introRound=text(self.intro,"",UDim2.new(.5,-400,0,70),UDim2.fromOffset(800,40),30,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
	self.introBegin=text(self.intro,"",UDim2.new(.5,-400,.38,-60),UDim2.fromOffset(800,120),120,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
	create("UIStroke",self.introBegin,{Color=palette.red,Thickness=4,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
	self.intro.Visible=false
	-- --------------------------------------------------------------- result
	self.result=frame(self.gui,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.ink,.25)
	local resultBox=frame(self.result,UDim2.new(.5,-300,.5,-170),UDim2.fromOffset(600,340),palette.ink,.1)
	corner(resultBox,10)
	stroke(resultBox,palette.red,3)
	self.resultBox=resultBox
	self.resultTitle=text(resultBox,"",UDim2.fromOffset(30,18),UDim2.fromOffset(540,70),72,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
	self.resultName=text(resultBox,"",UDim2.fromOffset(30,92),UDim2.fromOffset(540,36),30,palette.gold,TITLE_FONT,Enum.TextXAlignment.Center)
	self.resultNote=text(resultBox,"",UDim2.fromOffset(30,132),UDim2.fromOffset(540,44),15,palette.muted,BODY_FONT,Enum.TextXAlignment.Center)
	self.rematchButton=button(resultBox,"REMATCH",UDim2.fromOffset(30,196),UDim2.fromOffset(540,52),function() send("Rematch") end,palette.red)
	button(resultBox,"RETURN TO THE ROSTER",UDim2.fromOffset(30,260),UDim2.fromOffset(540,52),function() send("Selection") end)
	-- ---------------------------------------------------------- online queue
	self.queue=frame(self.gui,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.ink,.25)
	local queueBox=frame(self.queue,UDim2.new(.5,-300,.5,-150),UDim2.fromOffset(600,300),palette.ink,.1)
	corner(queueBox,10)
	stroke(queueBox,palette.red,3)
	self.queueTitle=text(queueBox,"",UDim2.fromOffset(30,18),UDim2.fromOffset(540,56),48,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
	self.queueCode=text(queueBox,"",UDim2.fromOffset(30,80),UDim2.fromOffset(540,70),72,palette.gold,TITLE_FONT,Enum.TextXAlignment.Center)
	self.queueNote=text(queueBox,"",UDim2.fromOffset(30,154),UDim2.fromOffset(540,44),15,palette.muted,BODY_FONT,Enum.TextXAlignment.Center)
	self.cancelButton=button(queueBox,"CANCEL",UDim2.fromOffset(30,222),UDim2.fromOffset(540,52),function() send("Cancel") end)
	self.queue.Visible=false
	-- The genjutsu image carries no label: the world shows it (Presentation:illusion).
	self.tutorialPanel=frame(self.hud,UDim2.new(.5,-260,0,84),UDim2.fromOffset(520,90),palette.ink,.15)
	corner(self.tutorialPanel,8)
	self.tutorialTitle=text(self.tutorialPanel,"",UDim2.fromOffset(16,6),UDim2.fromOffset(490,30),24,palette.paper,TITLE_FONT)
	self.tutorialPrompt=text(self.tutorialPanel,"",UDim2.fromOffset(16,40),UDim2.fromOffset(490,40),14,palette.muted)
	GuiService.AutoSelectGuiEnabled=true
	-- HUD scale follows the viewport so plates and slots never leave the screen.
	local function fitHud()
		local size=workspace.CurrentCamera.ViewportSize
		local s=math.clamp(math.min(size.X/1500,size.Y/860),.55,1.25)
		-- Studio capture aid (see Camera): shrink the HUD into the visible region.
		if game:GetService("RunService"):IsStudio() and workspace:GetAttribute("NinjaDuelCaptureShift") then s*=.66 end
		hudScale.Scale=s
		-- A UIScale also shrinks the frame it scales: size the HUD up by the
		-- same factor so its bottom row sits at the bottom of the screen (the
		-- slots and help used to float mid-screen on a small viewport).
		self.hud.Size=UDim2.fromScale(1/s,1/s)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fitHud);fitHud()
	self:refreshSelection(); self:render({phase="Selection"})
	return self
end
function UI:refreshSelection()
	-- During an online pick the right half shows the opponent's live choice.
	local other=if self.picking and Fighters[self.opponentPick or ""] then self.opponentPick else self.bot
	for key,b in self.selectionButtons do
		local selected=key=="player"..self.player or key=="bot"..other or key=="slot"..self.player
		b.BackgroundColor3=if selected then Color3.fromRGB(120,36,34) else palette.panel
	end
	local p,o=Fighters[self.player],Fighters[other]
	self.matchup.Text=string.upper((p.FullName or p.Name).."  VS  "..(o.FullName or o.Name))
	self.matchupNote.Text=(p.Description or "").."\n"..(o.Description or "")
	self.routeNote.Text=if p.Routes then string.upper(p.Name).." STRINGS  "..p.Routes else ""
end
-- Online pick: your fighter changes until you confirm; the server echoes it.
function UI:choose(id)
	if self.onlineInfo and self.onlineInfo.ready then return end
	self.player=id;self:refreshSelection();self.send("Pick",{player=id})
end
-- Roster, online waiting screen and online pick (the roster in versus mode).
function UI:lobby(data)
	local online=data.online
	self.picking=data.phase=="Pick" and online~=nil
	if self.picking then
		if Fighters[online.me or ""] then self.player=online.me end
		self.opponentPick=online.them
		self.opponentLabel.Text="OPPONENT  •  "..string.upper(online.opponent or "")..(if online.theirReady then "  •  READY" else "")
		self.startButton.Text=if online.ready then "READY  •  WAITING FOR OPPONENT" else "READY"
		self.tutorialButton.Text="LEAVE"
		self.notice.Text=string.format("ONLINE 1v1  •  THE DUEL STARTS IN %d s",math.ceil(online.remaining or 0))
	else
		self.opponentPick=nil
		self.opponentLabel.Text="OPPONENT (AI)"
		self.startButton.Text="ENTER THE STAGE"
		self.tutorialButton.Text="TRAINING (TUTORIAL)"
		self.notice.Text=data.notice or ""
	end
	self.onlineRow.Visible=data.phase=="Selection"
	if data.phase=="Queue" then
		local private=online~=nil and online.mode=="private"
		self.queueTitle.Text=if private then "PRIVATE DUEL" else "SEARCHING FOR AN OPPONENT"
		self.queueCode.Text=if private then (online.code or "") else ""
		self.queueNote.Text=if private then "Share this code: your friend types it next to JOIN on the roster screen."
			else "Casual 1v1  •  you meet the next player who searches."
	end
	self:refreshSelection()
end
local function fullName(actor)
	local def=Fighters[actor.fighterId]
	return string.upper(def and def.FullName or actor.fighter or "")
end
local function subtitle(actor)
	local def=Fighters[actor.fighterId]
	if not def then return "" end
	return string.format("AGE %d  •  %s",def.Age or 13,def.Title or "")
end
-- Server cues name keyboard keys; a pad player reads the pad button instead
-- (labels from Controls, so the copy cannot drift from the bindings).
function UI.padCue(cue)
	local P=Controls.PadLabel
	cue=cue:gsub("SPACE REBOUND",P.Jump.." REBOUND"):gsub("C DETACH",P.WallDetach.." DETACH")
	cue=cue:gsub("• E ","• "..P.Pursuit.." "):gsub("X TO ESCAPE",P.Substitute.." TO ESCAPE")
	cue=cue:gsub("• 1 = ","• "..Controls.TechniquePad[1].." = ")
	return cue
end
-- A plate's chakra network (Neji): four pips, lit per closed point (a fresh one
-- pops), shown whenever the opponent fights with the Gentle Fist; the chakra
-- bar dims with the recovery the points cost.
local HYUGA=Color3.fromRGB(190,208,255)
function UI.network(widget,actor,foe)
	local count=#(actor.tenketsuPoints or {})
	if count==0 then count=actor.tenketsu or 0 end
	local shown=(foe and foe.fighterId=="GentleFist") or count&gt;0
	local severe=actor.tenketsuSevere==true
	for k,pip in widget.points do
		pip.Visible=shown
		pip.BackgroundColor3=if k&lt;=count then (if severe then palette.paper else HYUGA) else palette.track
		if k&lt;=count and k&gt;widget.pointsShown then
			pip.Size=UDim2.fromOffset(15,15)
			Tween:Create(pip,TweenInfo.new(.22,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=UDim2.fromOffset(9,9)}):Play()
		end
	end
	widget.pointsShown=count
	local regen=math.clamp(actor.chakraRegen or 1,0,1)
	widget.chakra.BackgroundColor3=if regen&lt;1 then palette.blue:Lerp(Color3.fromRGB(112,118,138),math.min(1,(1-regen)*1.4)) else palette.blue
end
-- What each CORE4 awakening changes in the fight, said while it burns (a
-- fighter without a line here shows its name and time only).
local AWAKENED={
	Flashstep="EACH JUMP LEAVES A RETURN SEAL  •  FLASH ONTO A LAUNCHED BODY",
	GentleFist="NO BLIND SPOT  •  ONE PALM CLOSES TWO POINTS",
	Mirage="HIS GUARD READS  •  A MISS NEAR HIM IS READ",
	Lion="KICKS DO NOT LET GO  •  LAUNCHERS BECOME THE DANCING LEAF",
}
UI.AWAKENED=AWAKENED
function UI.awakening(actor)
	if (actor.awaken or 0)&lt;=0 or (actor.health or 1)&lt;=0 then return "" end
	local def=Fighters[actor.fighterId]
	local name=def and def.Awakening and def.Awakening.Name or "AWAKENED"
	local line=string.format("%s  %.1fs",name,actor.awaken)
	if actor.curseHunger then return line.."  •  HUNGRY: LAND A BLOW" end
	return if AWAKENED[actor.fighterId] then line.."  •  "..AWAKENED[actor.fighterId] else line
end
-- The counter a read, a repel or a caught image opened: named, with the time
-- it stays open (it closes fast; the HUD says how fast).
local COUNTER_NAME={CounterPalm="COUNTER PALM",PalmThrust="TWIN PALM"}
function UI.counterPrompt(h,pad)
	local move=(MoveGraphs[h.fighterId] or {}).readCounter
	local name=COUNTER_NAME[move or ""] or "COUNTER"
	return string.format("%s — %s  %.1fs",if pad then Controls.PadLabel.Light else Controls.KeyLabel.Light,name,h.counter or 0)
end
-- Contextual prompts for a conversion that is open right now (nil: none):
-- after a teleport the arrival strike or Rasengan, after the Dancing Leaf the
-- air finisher.
function UI.conversion(h,pad)
	local light=if pad then Controls.PadLabel.Light else Controls.KeyLabel.Light
	local heavy=if pad then Controls.PadLabel.Heavy else Controls.KeyLabel.Heavy
	if h.flash then
		local line=light.." — ARRIVAL STRIKE  •  "..heavy..(if h.airborne then " — SLAM" else " — LAUNCH")
		for i,tech in h.techniques or {} do
			if tech.id=="BurstStrike" and tech.remaining==0 and h.chakra&gt;=tech.cost and (h.sealed or 0)&lt;=0 then
				line..="  •  "..(if pad then Controls.TechniquePad[i] else tostring(i)).." — RASENGAN"
			end
		end
		return line
	end
	if (h.lion or 0)&gt;0 and h.airborne then
		local finisher=(MoveGraphs[h.fighterId] or {}).airFinisher
		return heavy.." — "..(if finisher then finisher.cue else "LION COMBO")
	end
	return nil
end
function UI:render(data)
	local pad=if data.gamepad~=nil then data.gamepad else Controls.isGamepad(UIS:GetLastInputType())
	self.tutorialPanel.Visible=data.tutorial~=nil and data.phase=="Duel"
	if data.tutorial then
		self.tutorialTitle.Text=data.tutorial.index.." / "..data.tutorial.total.."  "..data.tutorial.title
		self.tutorialPrompt.Text=(if pad then data.tutorial.pad else data.tutorial.key).."  •  "..(if pad then "Touchpad to skip" else "ESC to skip")
	end
	local introActive=data.phase=="Duel" and (data.intro or 0)&gt;0
	self.onlineInfo=data.online
	self.selection.Visible=data.phase=="Selection" or data.phase=="Pick"; self.hud.Visible=data.phase=="Duel" and not introActive; self.result.Visible=data.phase=="Result"
	self.queue.Visible=data.phase=="Queue"
	self.intro.Visible=introActive
	-- Gamepad focus moves only after the matching screen is visible.
	if self.lastPhase~=data.phase then
		GuiService.SelectedObject=if data.phase=="Selection" or data.phase=="Pick" then self.startButton elseif data.phase=="Result" then self.rematchButton
			elseif data.phase=="Queue" then self.cancelButton else nil
		self.lastPhase=data.phase
	end
	if data.phase~="Duel" and data.phase~="Result" then self:lobby(data);return end
	local h,b=data.human,data.bot
	if not h or not b then return end
	if introActive then
		self.introLeftName.Text=fullName(h);self.introLeftTitle.Text=subtitle(h)
		self.introRightName.Text=fullName(b);self.introRightTitle.Text=subtitle(b)
		self.introLeftName.TextColor3=accentOf(Fighters[h.fighterId]);self.introRightName.TextColor3=accentOf(Fighters[b.fighterId])
		self.introRound.Text="PRODIGY TOURNAMENT  —  ROUND "..(data.round or 1)..(if (data.round or 1)&gt;1 and (data.wins and (data.wins.human==1 and data.wins.bot==1)) then "  •  FINAL ROUND" else "")
		self.introBegin.Text=if data.intro&lt;.75 then "始め!  BEGIN" else ""
		if self.introShown~=data.epoch then
			self.introShown=data.epoch
			self.introLeft.Position=UDim2.new(-.5,0,1,-118);self.introRight.Position=UDim2.new(1,0,1,-118)
			Tween:Create(self.introLeft,TweenInfo.new(.45,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Position=UDim2.new(0,0,1,-118)}):Play()
			Tween:Create(self.introRight,TweenInfo.new(.45,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Position=UDim2.new(.5,0,1,-118)}):Play()
		end
		return
	end
	if data.ko and not self.ko.Visible then
		self.ko.TextSize=170
		Tween:Create(self.ko,TweenInfo.new(.35,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{TextSize=120}):Play()
	end
	self.ko.Visible=data.ko==true
	self.round.Text=if data.matchPoint and data.ko then "MATCH" else "ROUND "..(data.round or 1)
	self.hp.name.Text=fullName(h);self.hp.title.Text=subtitle(h).."  •  YOU"
	self.enemy.name.Text=fullName(b);self.enemy.title.Text=(if data.online then string.upper(data.online.opponent or "OPPONENT") else "AI").."  •  "..subtitle(b)
	for _,pair in {{self.hp,h},{self.enemy,b}} do
		local widget,actor=pair[1],pair[2]
		local ratio=math.clamp(actor.health/actor.maxHealth,0,1)
		widget.fill.Size=UDim2.fromScale(ratio,1)
		widget.fill.BackgroundColor3=if ratio&gt;.5 then palette.gold elseif ratio&gt;.25 then Color3.fromRGB(236,134,60) else palette.red
		Tween:Create(widget.lag,TweenInfo.new(.6,Enum.EasingStyle.Quad,Enum.EasingDirection.In,0,false,.25),{Size=UDim2.fromScale(ratio,1)}):Play()
		widget.chakra.Size=UDim2.fromScale(math.clamp(actor.chakra/actor.maxChakra,0,1),1)
		widget.status.Text=string.format("%d / %d",math.ceil(actor.health),actor.maxHealth)
		-- Gentle Fist effects on this fighter: the closed points (pips), what
		-- they cost (the chakra bar dims, its recovery is spelled out) and the
		-- jutsu the 64 Palms sealed.
		UI.network(widget,actor,if actor==h then b else h)
		widget.awake.Text=UI.awakening(actor)
		local tone=Fighters[actor.fighterId] and Fighters[actor.fighterId].Awakening and Fighters[actor.fighterId].Awakening.Color
		widget.awake.TextColor3=if tone then Color3.fromRGB(table.unpack(tone)) else palette.gold
		if (actor.sealed or 0)&gt;0 then widget.status.Text..=string.format("   •   JUTSU SEALED %.1fs",actor.sealed)
		elseif (actor.chakraRegen or 1)&lt;1 then widget.status.Text..=string.format("   •   CHAKRA REGEN -%d%%%s",math.floor((1-actor.chakraRegen)*100+.5),if actor.tenketsuSevere then "  •  NETWORK SEALED" else "") end
		-- Naruto: his shadow clones out (a route's own clone is not counted).
		local clones=0
		for _,body in data.bodies or {} do if body.owner==actor.id and body.kind=="clone" and not body.ephemeral then clones+=1 end end
		if clones&gt;0 then widget.status.Text..="   •   CLONES "..clones end
		local won=if actor==h then (data.wins and data.wins.human or 0) else (data.wins and data.wins.bot or 0)
		for k,m in widget.medals do
			m.Visible=(data.roundsToWin or 1)&gt;1 and k&lt;=(data.roundsToWin or 1)
			m.BackgroundColor3=if k&lt;=won then palette.gold else palette.track
		end
		local charges=actor.subCharges or 0
		for k,pip in widget.pips do
			local level=if k&lt;=charges then 1 elseif k==charges+1 and (actor.subRegen or 0)&gt;0 then 1-math.clamp((actor.subRegen or 0)/9,0,1) else 0
			pip.fill.Size=UDim2.fromScale(1,level)
			pip.fill.BackgroundColor3=if k&lt;=charges then palette.paper else palette.muted
		end
	end
	-- Combo counters with the damage scale of the next hit.
	for _,pair in {{self.comboMine,b},{self.comboTheirs,h}} do
		local widget,victim=pair[1],pair[2]
		local hits=victim.comboHits or 0
		if hits&gt;=2 then
			local scale=math.max(.35,1-.12*math.max(0,hits-1))
			widget.hits.Text=hits.." HITS"
			widget.detail.Text=string.format("%d DMG  •  NEXT x%.2f",math.floor((victim.comboDamage or 0)+.5),scale)
			widget.box.Visible=true
			if hits~=widget.shown then
				widget.shown=hits
				widget.hits.TextSize=64
				Tween:Create(widget.hits,TweenInfo.new(.18,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{TextSize=54}):Play()
			end
		else
			widget.box.Visible=false;widget.shown=0
		end
	end
	self.statusLine.Text=string.format("STAMINA %d   •   SUBSTITUTION %d   •   %s   •   %s",math.floor(h.stamina or 100),h.subCharges or 0,
		if h.wall then "WALL RUN" elseif h.dodge&gt;0 then string.format("DASH %.1fs",h.dodge) else "DASH READY",
		-- Global kunai (DEC-030): whether a blade is drawn, and how to use it.
		if h.armed then "KUNAI DRAWN (R throws it)" else "B: draw kunai")
	-- Only decisive moments speak; routine cues stay silent.
	local cue=h.cue or ""
	local loud=cue:find("READ") or cue:find("PARRY") or cue:find("PERFECT") or cue:find("FLYING THUNDER") or cue:find("GUARD BREAK") or cue:find("WALL ")
		or cue:find("CLASH") or cue:find("SUBSTITUTION •") or cue:find("SEAL") or cue:find("COMBO LIMIT") or cue:find("GENJUTSU")
		or cue:find("PALMS") or cue:find("ROTATION") or cue:find("BYAKUGAN") or cue:find("SHARINGAN")
		or cue:find("FLOW") or cue:find("AWAKEN") or cue:find("THROW BREAK") or cue:find("KNOCK AWAY") or cue:find("RIPOSTE")
		-- Caught in wire or sand: the way out must be on screen.
		or cue:find("WIRED") or cue:find("BOUND")
		-- Sasuke's (and Lee's) continuations and risks must be read too: the
		-- Dancing Leaf, the Lion Combo, the curse, a Chidori and its miss.
		or cue:find("DANCING LEAF") or cue:find("LION") or cue:find("CURSE") or cue:find("CHIDORI") or cue:find("PUNISH") or cue:find("LOTUS")
		-- Naruto's clones (made, broken, swapped) and the barrage's instruction.
		or cue:find("CLONE") or cue:find("U-ZU-MA-KI")
	if loud and pad then cue=UI.padCue(cue) end
	self.cue.Text=if loud then cue else ""
	self.channel.Text=""
	for i,tech in h.techniques do
		local ui=self.techniqueButtons[i]
		ui.box.Visible=true
		ui.key.Text=if pad then Controls.TechniquePad[i] else string.format("%d",i)
		ui.title.Text=string.upper(tech.name)
		-- Sealed by the 64 Palms: every jutsu greys out and says why.
		local sealed=(h.sealed or 0)&gt;0
		local ready=tech.remaining==0 and tech.condition and h.chakra&gt;=tech.cost and not sealed
		ui.status.Text=if sealed then string.format("SEALED  •  %.1fs",h.sealed) elseif tech.remaining&gt;0 then string.format("%.1fs",tech.remaining) elseif not tech.condition then "NEEDS A SEAL / TARGET" elseif h.chakra&lt;tech.cost then "NEED CHAKRA" else tech.cost.." CHAKRA"
		if tech.id=="Flashstep" and #(h.seals or {})&gt;0 and tech.remaining==0 and not sealed then
			local count=#(h.seals or {})
			ui.status.Text=count.." SEAL"..(if count&gt;1 then "S" else "").."  •  "..ui.status.Text
		end
		ui.box.BackgroundTransparency=if ready then .05 else .35
		ui.title.TextColor3=if ready then palette.paper else palette.muted
		ui.cool.Size=UDim2.fromScale(1,math.clamp(math.max(tech.remaining/6,if sealed then h.sealed/5 else 0),0,1))
	end
	for i=#h.techniques+1,5 do self.techniqueButtons[i].box.Visible=false end
	local techOpen=h.reaction=="WallSplat" and (h.splatElapsed or 9)&lt;.34
	local conversion=UI.conversion(h,pad)
	self.hint.Text=if techOpen then (if pad then "○ — WALL TECH" else "Q — WALL TECH")
		elseif conversion then conversion
		elseif b.reaction=="WallSplat" and h.pursuit&gt;0 then (if pad then "× — PURSUE  •  △ — WALL BOUNCE" else Controls.KeyLabel.Pursuit.." — PURSUE  •  RMB — WALL BOUNCE")
		elseif (h.counter or 0)&gt;0 then UI.counterPrompt(h,pad)
		-- The Chidori's risk, from the other side: its charge can be broken.
		elseif b.castId=="Chidori" and b.state=="TechniqueChannel" then (if pad then Controls.PadLabel.Light else Controls.KeyLabel.Light).." — BREAK THE CHIDORI CHARGE"
		elseif h.awakenReady then (if pad then "D-PAD ↓ — AWAKEN" else "T — AWAKEN")
		elseif h.wall then (if pad then "× — REBOUND  •  R1 + L1 — DETACH" else "SPACE — REBOUND  •  C — DETACH")
		elseif h.state=="Startup" and h.attackName=="Heavy" then (if pad then "R1 + L2 — FEINT" else "G — FEINT")
		elseif h.reaction=="Grabbed" then (if pad then "L2 — THROW BREAK" else "V — THROW BREAK")
		elseif h.pursuit&gt;0 then (if pad then "× — CHASE" else Controls.KeyLabel.Pursuit.." / SPACE — CHASE")
		elseif (h.combo or 0)&gt;=2 and h.state=="Recovery" and not h.airborne and (h.comboHits or 0)==0 and b.reaction then Controls.comboHelp(MoveGraphs[h.fighterId] or {},pad)
		else ""
	self.help.Text=if pad then Controls.HelpPad else Controls.Help
	self.grammar.Text=Controls.comboHelp(MoveGraphs[h.fighterId] or {},pad)
	-- (Reference quality) The control sheet is for the first seconds of a duel
	-- (and the tutorial), not a permanent band across the fight.
	if self.helpEpoch~=data.epoch then self.helpEpoch=data.epoch;self.helpUntil=os.clock()+10 end
	local helping=data.tutorial~=nil or os.clock()&lt;(self.helpUntil or 0)
	self.help.Visible=helping;self.grammar.Visible=helping
	local won=data.winner=="PlayerFighter"
	local winner=if won then h else b
	self.resultTitle.Text=(if won then "VICTORY" else "DEFEAT")..(if (data.roundsToWin or 1)&gt;1 and data.wins then string.format("  %d–%d",data.wins.human or 0,data.wins.bot or 0) else "")
	self.resultTitle.TextColor3=if won then palette.gold else palette.crimson
	self.resultName.Text=fullName(winner).."  ADVANCES"
	self.resultNote.Text=if won then "The judges saw it too. The bracket waits for no one." else "Read the commitment. Find a better opening — prodigies learn fastest from defeat."
	-- Online: a rematch needs both players; a forfeit says so.
	local online=data.online
	self.rematchButton.Text=if not online then "REMATCH" elseif online.opponentLeft then "OPPONENT LEFT" elseif online.rematch then "WAITING FOR OPPONENT…"
		elseif online.theirRematch then "REMATCH  •  OPPONENT IS READY" else "REMATCH"
	if online and online.forfeit then
		self.resultTitle.Text=(if won then "VICTORY" else "DEFEAT").."  •  FORFEIT"
		self.resultNote.Text="Your opponent left the duel. The win is yours."
	end
end
return UI
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND144">
          <Properties>
            <string name="Name">VelmoraHitFeedback</string>
            <ProtectedString name="Source">-- Impact presentation. Adapted from Velmora src/client/Combat/HitFeedback.luau
-- (Copyright (c) 2026 Yashveer Singh, MIT), extended with a style hierarchy so
-- small hits, finishers, launchers and slams do not feel identical.
-- Every effect is driven by a server-reported contact, never by a button press.
local Debris=game:GetService("Debris")
local TweenService=game:GetService("TweenService")
local Kit=require(script.Parent.VfxKit)
local Feedback={}
-- Audio stays on assets already imported and verified by this project; extra
-- cues are declared here so adding one later is a one-line change.
local AUDIO={light="rbxassetid://8595980577",heavy="rbxassetid://9117969717",whiff="rbxassetid://9126284094",
	-- (Reference quality) a crack and a body thud under the heavy blows.
	punch="rbxassetid://9117971636",body="rbxassetid://9113524242"}
local LAYERED={finisher=true,launcher=true,slam=true,wallbounce=true,clash=true}
local LOOPED={}
-- style -&gt; shard count, light range, colour, pitch, volume, tint of the target
local look={
 light   ={shards=5, range=7,  color=Color3.fromRGB(255,214,170),pitch=1.18,volume=.32,hit=Color3.fromRGB(255,238,214)},
 finisher={shards=6, range=9,  color=Color3.fromRGB(255,186,120),pitch=0.94,volume=.42,hit=Color3.fromRGB(255,220,180)},
 launcher={shards=5, range=9,  color=Color3.fromRGB(196,226,255),pitch=0.86,volume=.40,hit=Color3.fromRGB(226,240,255)},
 air     ={shards=6, range=8,  color=Color3.fromRGB(212,232,255),pitch=1.06,volume=.34,hit=Color3.fromRGB(232,244,255)},
 slam    ={shards=9,range=13, color=Color3.fromRGB(255,158,96),pitch=0.72,volume=.52,hit=Color3.fromRGB(255,206,168)},
 block   ={shards=8, range=9,  color=Color3.fromRGB(226,206,150),pitch=1.32,volume=.34,hit=Color3.fromRGB(240,228,190)},
 parry   ={shards=7,range=11, color=Color3.fromRGB(255,244,168),pitch=1.42,volume=.46,hit=Color3.fromRGB(255,250,214)},
 jutsu   ={shards=6,range=11, color=Color3.fromRGB(255,146,92),pitch=0.9, volume=.44,hit=Color3.fromRGB(255,196,150)},
 kunai   ={shards=4, range=6,  color=Color3.fromRGB(206,216,226),pitch=1.34,volume=.26,hit=Color3.fromRGB(230,236,242)},
 shuriken={shards=4, range=6,  color=Color3.fromRGB(198,210,224),pitch=1.5, volume=.24,hit=Color3.fromRGB(230,236,242)},
 dodge   ={shards=5, range=6,  color=Color3.fromRGB(168,206,238),pitch=1.26,volume=.22,hit=Color3.fromRGB(206,226,242)},
 substitute={shards=7,range=8, color=Color3.fromRGB(196,196,214),pitch=1.0, volume=.30,hit=Color3.fromRGB(226,226,240)},
 whiff   ={shards=2, range=4,  color=Color3.fromRGB(176,188,200),pitch=1.6, volume=.14,hit=Color3.fromRGB(200,208,218)},
 landing ={shards=6, range=7,  color=Color3.fromRGB(170,158,132),pitch=0.8, volume=.26,hit=Color3.fromRGB(206,196,172)},
 wall    ={shards=5, range=8,  color=Color3.fromRGB(184,178,158),pitch=0.86,volume=.30,hit=Color3.fromRGB(214,208,186)},
 wallbounce={shards=8,range=12,color=Color3.fromRGB(255,206,150),pitch=0.74,volume=.48,hit=Color3.fromRGB(255,224,190)},
 clash   ={shards=9, range=12, color=Color3.fromRGB(255,240,190),pitch=1.25,volume=.5, hit=Color3.fromRGB(255,250,224)},
 walltech={shards=4, range=6,  color=Color3.fromRGB(206,222,255),pitch=1.3, volume=.22,hit=Color3.fromRGB(226,236,255)},
 pin     ={shards=3, range=5,  color=Color3.fromRGB(220,224,232),pitch=1.5, volume=.22,hit=Color3.fromRGB(236,240,246)},
 ember   ={shards=4, range=7,  color=Color3.fromRGB(255,170,90),pitch=1.1, volume=.26,hit=Color3.fromRGB(255,214,170)},
 palm    ={shards=3, range=6,  color=Color3.fromRGB(196,212,255),pitch=1.3, volume=.26,hit=Color3.fromRGB(226,234,255)},
 flow    ={shards=4, range=7,  color=Color3.fromRGB(214,232,255),pitch=1.45,volume=.3, hit=Color3.fromRGB(236,244,255)},
 awaken  ={shards=8, range=14, color=Color3.fromRGB(255,236,190),pitch=0.7, volume=.5, hit=Color3.fromRGB(255,244,220)},
 palmburst={shards=6,range=10, color=Color3.fromRGB(214,226,255),pitch=0.9, volume=.38,hit=Color3.fromRGB(232,238,255)},
 deflect ={shards=4, range=6,  color=Color3.fromRGB(226,236,255),pitch=1.5, volume=.22,hit=Color3.fromRGB(240,244,255)},
 repel   ={shards=7, range=11, color=Color3.fromRGB(200,216,255),pitch=0.84,volume=.44,hit=Color3.fromRGB(228,236,255)},
 rotation={shards=2, range=10, color=Color3.fromRGB(200,216,255),pitch=0.7, volume=.2, hit=Color3.fromRGB(228,236,255)},
 trigram ={shards=0, range=9,  color=Color3.fromRGB(200,216,255),pitch=0.8, volume=.16,hit=Color3.fromRGB(228,236,255)},
}
local function anchorAt(position)
	local anchor=Instance.new("Part")
	anchor.Name="LocalImpact";anchor.Anchored=true;anchor.CanCollide=false;anchor.CanQuery=false
	anchor.Transparency=1;anchor.Size=Vector3.one;anchor.Position=position;anchor.Parent=workspace
	return anchor
end
local function playSound(parent,id,pitch,volume)
	if not id then return end
	local sound=Instance.new("Sound")
	sound.SoundId=id;sound.Volume=volume or .3;sound.PlaybackSpeed=pitch or 1
	sound.RollOffMaxDistance=120;sound.Parent=parent
	sound:Play()
	Debris:AddItem(sound,2)
end
function Feedback.burst(position,color,damage,blocked)
	local anchor=anchorAt(position)
	local light=Instance.new("PointLight");light.Color=color;light.Brightness=(if blocked then 5 else 3);light.Range=(if blocked then 11 else 8);light.Parent=anchor
	TweenService:Create(light,TweenInfo.new(.2),{Brightness=0}):Play()
	for i=1,(if blocked then 10 else 7) do
		local shard=Instance.new("Part");shard.Anchored=true;shard.CanCollide=false;shard.CanQuery=false;shard.Material=Enum.Material.Neon;shard.Color=color;shard.Size=Vector3.new(.08,.08,math.random(5,11)/10);shard.CFrame=CFrame.lookAt(position,position+Vector3.new(math.random()-0.5,math.random()-0.5,math.random()-0.5));shard.Parent=workspace
		TweenService:Create(shard,TweenInfo.new(.18,Enum.EasingStyle.Quad),{CFrame=shard.CFrame*CFrame.new(0,0,-math.random(2,5)),Transparency=1}):Play();Debris:AddItem(shard,.22)
	end
	if damage and damage&gt;0 then
		local bill=Instance.new("BillboardGui");bill.Size=UDim2.fromOffset(80,40);bill.StudsOffset=Vector3.new(0,2.5,0);bill.AlwaysOnTop=true;bill.Parent=anchor
		local label=Instance.new("TextLabel");label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=1;label.Text=string.format("-%d",math.floor(damage+.5));label.TextColor3=color;label.TextStrokeTransparency=.15;label.Font=Enum.Font.GothamBlack;label.TextScaled=true;label.Parent=bill
		TweenService:Create(bill,TweenInfo.new(.45),{StudsOffset=Vector3.new(0,4.5,0)}):Play();TweenService:Create(label,TweenInfo.new(.45),{TextTransparency=1,TextStrokeTransparency=1}):Play()
	end
	Debris:AddItem(anchor,.55)
end
-- One contact, one coherent reaction. Only the layers the style warrants.
-- Moves that are not a body contact (a dodge, a substitution, a wall tech, a
-- spin) sound like air, never like a punch; flow rides on its "light" entry.
local AIR_CUE={whiff=true,dodge=true,substitute=true,walltech=true,rotation=true,deflect=true}
-- Real contacts without a look of their own keep the generic hit layer.
local CONTACT_FALLBACK={fire=true,fireball=true,chidori=true,groundbounce=true,sandhit=true,sandburst=true,sandburial=true,sandshield=true}
-- Body contacts drawn with the project's own textures (Client/VfxKit): the
-- flash where the blow met the body, a crescent across the strike, streaks
-- thrown along it, a ring, and for the heavy ones the floor answering.
-- weight 0..1: how much of each layer.
local WEIGHT={light=.32,air=.42,flow=.3,kunai=.22,shuriken=.2,pin=.2,palm=.3,block=.45,parry=.8,clash=.9,
	finisher=.75,launcher=.8,slam=1,wallbounce=.9,jutsu=.6,awaken=.6,repel=.7,palmburst=.6}
local SLASH={light=true,air=true,finisher=true,launcher=true,slam=true,flow=true,clash=true}
local function strikeLayers(style,position,impact,spec)
	local w=WEIGHT[style]
	if not w or not Kit.has("star") then return false end
	local folder=workspace:FindFirstChild("NinjaDuelFX") or workspace
	local dir=impact and impact.direction
	if not dir or dir.Magnitude&lt;.05 then dir=Vector3.new(math.random()-.5,0,math.random()-.5) end
	if dir.Magnitude&lt;.05 then dir=Vector3.zAxis end
	dir=dir.Unit
	local guard=style=="block" or style=="parry"
	local color=if guard then Color3.fromRGB(255,226,140) else Color3.fromRGB(255,250,236)
	local hot=if style=="slam" or style=="finisher" or style=="launcher" then Color3.fromRGB(255,190,120) else color
	Kit.star(folder,position,2.2+4.6*w,color,.07+.07*w)
	Kit.streaks(folder,position,dir,math.floor(5+12*w),hot,45+50*w,if guard then 70 else 38)
	local camera=workspace.CurrentCamera
	local toCamera=if camera then (camera.CFrame.Position-position) else -dir
	if toCamera.Magnitude&lt;.05 then toCamera=Vector3.zAxis end
	toCamera=toCamera.Unit
	-- The ring stands across the strike, tilted toward the viewer so it reads.
	local ringNormal=(dir+toCamera*.6).Unit
	local up=if math.abs(ringNormal.Y)&gt;.95 then Vector3.xAxis else Vector3.yAxis
	local ringCF=CFrame.lookAt(position,position+ringNormal,up)
	Kit.plane(folder,ringCF,"ring",Vector2.new(1.2,1.2)*(1+w),Vector2.new(5,5)*(1+w*1.6),.12+.1*w,hot,0)
	if SLASH[style] then
		-- A crescent drawn across the blow, facing the camera.
		local across=dir:Cross(toCamera)
		local roll=math.atan2(across.Y,math.sqrt(across.X^2+across.Z^2))+(math.random()-.5)*.9
		local slashCF=CFrame.lookAt(position,position+toCamera)*CFrame.Angles(0,0,roll)
		Kit.plane(folder,slashCF,"slash",Vector2.new(4,2)*(.8+w),Vector2.new(6.5,3.2)*(.8+w),.1+.06*w,color,0)
	end
	if style=="slam" or style=="wallbounce" or style=="launcher" then
		local me=game:GetService("Players").LocalPlayer.Character
		local floor=Kit.floorUnder(position,{folder,if me and me.Parent then me.Parent else folder},9)
		if floor then
			Kit.dust(folder,floor.Position,math.floor(6+10*w),2.2+1.6*w,Color3.fromRGB(214,200,172),12+10*w)
		end
	end
	return true
end
function Feedback.impact(style,position,impact)
	-- Only styles with a contact look get shards and a hit sound. Casts, chases,
	-- fades, sticks and afterimages have their own effects (FX:impact).
	local spec=look[style] or (CONTACT_FALLBACK[style] and look.light)
	if not spec then return end
	local anchor=anchorAt(position)
	local cue=(if style=="light" then "light" elseif AIR_CUE[style] then "whiff" else "heavy")
	if style~="flow" then playSound(anchor,AUDIO[cue],spec.pitch,spec.volume) end
	if LAYERED[style] then
		playSound(anchor,AUDIO.punch,.95+math.random()*.1,.45)
		playSound(anchor,AUDIO.body,1.1,.35)
	end
	local light=Instance.new("PointLight")
	light.Color=spec.color;light.Brightness=(if style=="parry" or style=="slam" then 8 else 4)
	light.Range=spec.range;light.Parent=anchor
	TweenService:Create(light,TweenInfo.new(if style=="slam" then .28 else .17),{Brightness=0}):Play()
	Debris:AddItem(anchor,2)
	local ok,drawn=pcall(strikeLayers,style,position,impact,spec)
	if ok and drawn then return spec end
	local spread=if style=="slam" then 1.1 elseif style=="whiff" then 2.4 else .7
	local distance=if style=="whiff" then 2 else math.max(1.4,spec.range*.32)
	for _=1,spec.shards do
		local direction=Vector3.new(math.random()-0.5,math.random()-0.5,math.random()-0.5)
		if direction.Magnitude&lt;.01 then direction=Vector3.yAxis end
		local shard=Instance.new("Part")
		shard.Anchored=true;shard.CanCollide=false;shard.CanQuery=false;shard.Material=Enum.Material.Neon
		shard.Color=spec.color;shard.Size=Vector3.new(.08,.08,math.random(5,12)/10)
		shard.CFrame=CFrame.lookAt(position,position+direction.Unit)*CFrame.Angles(0,0,math.random()*math.pi)
		shard.Parent=workspace
		local travel=CFrame.new(direction.Unit*(distance*(0.6+math.random()*.8)*spread))
		TweenService:Create(shard,TweenInfo.new(if style=="slam" then .26 else .18,Enum.EasingStyle.Quad),{CFrame=shard.CFrame*travel,Transparency=1}):Play()
		Debris:AddItem(shard,.3)
	end
	if style=="wall" then
		-- Wall dust: a flat puff pushed away from the surface, no screen shake.
		for i=1,7 do
			local puff=Instance.new("Part")
			puff.Anchored=true;puff.CanCollide=false;puff.CanQuery=false
			puff.Material=Enum.Material.Slate;puff.Color=Color3.fromRGB(176,170,152)
			puff.Size=Vector3.new(.3,.3,.3);puff.Transparency=.35
			puff.CFrame=CFrame.new(position+Vector3.new((math.random()-.5)*2,(math.random()-.5)*2,(math.random()-.5)*2))
			puff.Parent=workspace
			TweenService:Create(puff,TweenInfo.new(.32,Enum.EasingStyle.Quad),
				{Size=Vector3.new(1.6,1.6,1.6),Transparency=1}):Play()
			Debris:AddItem(puff,.38)
		end
	end
	if style=="slam" or style=="landing" then
		local ring=Instance.new("Part")
		ring.Anchored=true;ring.CanCollide=false;ring.CanQuery=false;ring.Material=Enum.Material.Neon
		ring.Color=spec.color;ring.Shape=Enum.PartType.Cylinder;ring.Size=Vector3.new(.12,3,3)
		ring.CFrame=CFrame.new(position-Vector3.new(0,2.4,0))*CFrame.Angles(0,0,math.pi/2)
		ring.Transparency=.25;ring.Parent=workspace
		TweenService:Create(ring,TweenInfo.new(.28,Enum.EasingStyle.Quad),{Size=Vector3.new(.12,13,13),Transparency=1}):Play()
		Debris:AddItem(ring,.34)
	end
	return spec
end
-- Hitstop-scaled impulse; the camera reads this instead of re-deriving it.
function Feedback.impulse(style)
	local spec=look[style] or look.light
	return {shake=spec.range/26, fov=(spec.range-6)*.42}
end
return Feedback
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND145">
          <Properties>
            <string name="Name">VelmoraMotionEngine</string>
            <ProtectedString name="Source">-- Ninja Duel body animation. Started from Velmora's additive R15 layer (MIT) and
-- rebuilt into a full-body authored animation system:
--
--  * the presentation owns every joint it animates (it keeps its own pose state
--    instead of blending against whatever the Animator wrote this frame);
--  * grounded poses place the feet with two-bone leg IK, so stances crouch,
--    lunge and land with planted feet instead of floating or sliding;
--  * attacks, throws, hand signs and reactions are multi-key clips authored with
--    anatomical controls (raise / out / twist / elbow ...), so elbows and knees
--    bend the right way;
--  * locomotion is a real gait: stride, foot lift, pelvis/torso counter-twist,
--    arm swing, and the anime "ninja run" when sprinting or chasing.
--
-- Every joint is damped towards its target with an angular speed limit, so no
-- state change can snap the body. Presentation only: combat authority stays on
-- the server.
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Attacks=require(Shared.Attacks)
local Fighters=require(Shared.Fighters)
-- Weapon models come from the VFX module; required lazily so headless tools
-- that only pose skeletons do not need its services.
local Effects=nil
-- Blender-authored clips (Client/AuthoredMotion): where one exists for a
-- strike or a technique, it replaces the procedural pose below.
local Authored=nil
do
	local okA,mod=pcall(function() return require(script.Parent.AuthoredMotion) end)
	if okA then Authored=mod end
end
local Motion={}
Motion.Authored=Authored
local rad=math.rad
local CF=CFrame.new
local ANG=CFrame.Angles
local IDENTITY=CFrame.identity

local JOINTS={
	Root={"HumanoidRootPart","Root"},Waist={"LowerTorso","Waist"},Neck={"UpperTorso","Neck"},
	Right={"UpperTorso","RightShoulder"},Left={"UpperTorso","LeftShoulder"},
	RightElbow={"RightUpperArm","RightElbow"},LeftElbow={"LeftUpperArm","LeftElbow"},
	RightWrist={"RightLowerArm","RightWrist"},LeftWrist={"LeftLowerArm","LeftWrist"},
	RightHip={"LowerTorso","RightHip"},LeftHip={"LowerTorso","LeftHip"},
	RightKnee={"RightUpperLeg","RightKnee"},LeftKnee={"LeftUpperLeg","LeftKnee"},
	RightAnkle={"RightLowerLeg","RightAnkle"},LeftAnkle={"LeftLowerLeg","LeftAnkle"},
}
local UPPER={Waist=true,Neck=true,Right=true,Left=true,RightElbow=true,LeftElbow=true,RightWrist=true,LeftWrist=true}

-- ------------------------------------------------------------------ state
local states=setmetatable({},{__mode="k"})
local function stateOf(char)
	local s=states[char]
	if not s then s={motors={},pose={},phase=0,clock=0,inert={},vel={}};states[char]=s end
	return s
end
local function motor(char,key)
	local s=stateOf(char)
	local cached=s.motors[key]
	if cached~=nil then return cached or nil end
	local d=JOINTS[key];local part=char and char:FindFirstChild(d[1]);local m=part and part:FindFirstChild(d[2])
	local found=if m and m:IsA("Motor6D") then m else nil
	-- Only cache a positive lookup: a rig can still be assembling.
	if found then s.motors[key]=found end
	return found
end
-- A simulated presentation clock advanced once per rendered frame: identical on
-- 30 Hz and 120 Hz clients, deterministic in tests.
local elapsedTime=0
function Motion.tick(dt)
	if dt and dt&gt;0 then elapsedTime+=math.min(dt,.1) end
	return elapsedTime
end
function Motion.now() return elapsedTime end

-- Damping rate per layer, and a hard angular speed limit (deg/s) so a sudden
-- target change still travels instead of teleporting.
local RATE={attack=42,throw=32,cast=24,recoil=36,guard=26,defense=26,locomotion=22,air=14,ground=12,wall=16,chase=22,chainIn=26,kick=43,
	-- Blender-authored body motion is already the final curve: played almost
	-- as is (a frame of smoothing only to join one clip to the next).
	authored=48}
local KICK_SPEED=1600 -- deg/s cap for a free (kicking) leg during a strike
local CHAIN_IN=.08 -- seconds of a chained strike during which the upper body eases in
local CHAIN_IN_SPEED=800 -- deg/s cap per upper-body joint meanwhile (a strike may whip at 2280)
local MAX_SPEED=1750
-- deg/s: the fastest any authored joint turns (a sprint thigh peaks ~1200,
-- a kick ~1500). The reference footage never moves a limb more than ~25 deg
-- between two 60 Hz frames outside a speed smear. The kunai string (ANIM-005)
-- whips a slash over 2-3 frames and turns a somersault in 9: up to ~35 deg
-- per frame on the arm and the pelvis, so the cap sits above that (a real
-- flip is still drawn over its own frames, a 180 deg pop is still split).
local AUTHORED_SPEED=2200
local function angleBetween(a,b)
	local _,angle=(a:Inverse()*b):ToAxisAngle()
	return math.abs(angle)
end
-- (ANIM-002) Inertialization: when the body changes clip (a strike out of
-- the run, the next blow of a string, a landing, a hit), the new clip plays
-- at its own authored spacing at once and the difference with the body as it
-- was drawn - its pose and its velocity - is carried as an offset that decays
-- on a critically damped spring. Nothing snaps and nothing lags: the old
-- motion flows into the new one (Bollo, "High Performance Animation in Gears
-- of War 4", SIGGRAPH 2017; Holden's spring formulation).
local LN2=0.69314718
local function damper(x,v,half,dt)
	local y=(4*LN2/math.max(half,1e-3))*.5
	local j1=v+x*y
	local e=math.exp(-y*dt)
	return (x+j1*dt)*e,(v-j1*y*dt)*e
end
local function rotVec(cf)
	local axis,angle=cf:ToAxisAngle()
	if angle&gt;math.pi then angle-=2*math.pi end
	if angle~=angle or axis~=axis then return Vector3.zero end
	return axis*angle
end
local function fromRot(v)
	local m=v.Magnitude
	if m&lt;1e-6 then return IDENTITY end
	return CFrame.fromAxisAngle(v/m,m)
end
Motion._damper=damper
-- Write one joint: damp the owned pose towards the target, limit the angular
-- step, then publish it as the Motor6D transform.
local function write(char,key,target,rate,dt)
	local joint=motor(char,key)
	if not joint then return end
	local s=stateOf(char)
	if not dt then s.pose[key]=target;joint.Transform=target;return end
	local current=s.pose[key] or joint.Transform
	local inert=s.inert[key]
	if s.capture and rate==RATE.authored then
		-- A new clip: carry the body's drawn pose and velocity as an offset.
		local off=target:Inverse()*current
		local vel=s.vel[key]
		inert={r=rotVec(off),p=off.Position,vr=vel and vel.w or Vector3.zero,vp=vel and vel.v or Vector3.zero,half=s.capture,t0=target}
		if inert.vr.Magnitude&gt;25 then inert.vr=inert.vr.Unit*25 end
		s.inert[key]=inert
	elseif inert and inert.t0 then
		-- Second frame: the offset's velocity is the old motion minus the new one.
		local tv=rotVec(inert.t0:Inverse()*target)/dt
		inert.vr-=tv;inert.vp-=(target.Position-inert.t0.Position)/dt
		inert.t0=nil
	end
	local desired=target
	if inert then
		inert.r,inert.vr=damper(inert.r,inert.vr,inert.half,dt)
		inert.p,inert.vp=damper(inert.p,inert.vp,inert.half,dt)
		if inert.r.Magnitude&lt;1e-3 and inert.vr.Magnitude&lt;1e-2 and inert.p.Magnitude&lt;1e-3 and inert.vp.Magnitude&lt;1e-2 then
			s.inert[key]=nil
		else
			desired=target*(CF(inert.p)*fromRot(inert.r))
		end
	end
	local nextCF
	if rate==RATE.authored then
		-- Authored motion is the final curve: drawn as is (with its transition
		-- offset). (Fluidity pass, reference: no limb ever jumps.) A joint
		-- turns at most AUTHORED_SPEED: a whip is drawn over two or three
		-- frames instead of one, the eye reads motion, not a pop.
		nextCF=desired
		local step=angleBetween(current,nextCF)
		-- (The Root is the whole body turning in the air - a salto, a spin -
		-- not a limb: it may turn up to 60 deg a frame.)
		local limit=rad(if key=="Root" then 3600 else AUTHORED_SPEED)*dt
		if step&gt;limit and step&gt;1e-6 then nextCF=current:Lerp(nextCF,limit/step) end
	else
		local alpha=1-math.exp(-(rate or RATE.locomotion)*dt)
		nextCF=current:Lerp(desired,alpha)
		local step=angleBetween(current,nextCF)
		-- Strikes may whip faster than ordinary motion so their shape reads.
		local limit=rad(if rate==RATE.chainIn then CHAIN_IN_SPEED elseif rate==RATE.kick then KICK_SPEED elseif (rate or 0)&gt;=RATE.attack then 2280 else MAX_SPEED)*dt
		if step&gt;limit and step&gt;1e-6 then nextCF=current:Lerp(nextCF,limit/step) end
	end
	-- Translation (only the Root carries any) is speed-limited too.
	local move=nextCF.Position-current.Position
	-- (The salto drops the hips ~1 stud a frame onto its landing: authored
	-- motion may carry the Root that fast, or the feet land late.)
	local maxMove=(if rate==RATE.authored then 90 else 14)*dt
	if move.Magnitude&gt;maxMove then nextCF=CF(current.Position+move.Unit*maxMove)*nextCF.Rotation end
	-- The drawn velocity (joint space), for the next transition.
	local vel=s.vel[key] or {}
	vel.w=rotVec(current:Inverse()*nextCF)/dt;vel.v=(nextCF.Position-current.Position)/dt
	s.vel[key]=vel
	s.pose[key]=nextCF
	joint.Transform=nextCF
end
local LEG_SIDE={RightHip="R",RightKnee="R",RightAnkle="R",LeftHip="L",LeftKnee="L",LeftAnkle="L"}
local legIK
-- Name the clip the next apply() draws: a change of name is a transition
-- (inertialized over `half` seconds when the new clip is authored).
local function mark(char,key,half)
	local s=stateOf(char)
	s.markKey=key;s.markHalf=half or .1
end
Motion._mark=mark
local KUNAI_ARM={Right=true,RightElbow=true,RightWrist=true}
local function apply(char,targets,rate,dt,upperRate,legRate)
	local s=stateOf(char)
	local key=s.markKey or ("proc:"..tostring(rate))
	if key~=s.lastMarkKey then
		if s.lastMarkKey~=nil and dt then s.capture=if s.markKey then s.markHalf or .1 else .06 end
		s.lastMarkKey=key
	end
	s.markKey=nil
	local feet=targets.__feet
	-- Global kunai (DEC-030): the drawn blade's arm, laid over any body pose.
	local held=s.armOverlay
	for key in JOINTS do
		local side=LEG_SIDE[key]
		if not (feet and side and feet[side]) then
			local r=if upperRate and UPPER[key] then upperRate elseif legRate and side then legRate else rate
			local target=targets[key] or IDENTITY
			if held and KUNAI_ARM[key] and held.pose[key] then target=target:Lerp(held.pose[key],held.w) end
			write(char,key,target,r,dt)
		end
	end
	s.capture=nil
	if feet then
		-- The hips are damped; a planted foot must not be. Solve each planted leg
		-- against the hips as drawn this frame and set it almost at once.
		local hips=s.pose.Root or targets.Root
		s.ikOn=s.ikOn or {};s.ikEnter=s.ikEnter or {}
		for side,f in feet do
			local prefix=if side=="R" then "Right" else "Left"
			local target=f.ankle
			-- (ANIM-005) A leg handed from a drawn pose (a get-up, an air pose,
			-- a reaction) to the feet solver starts from where its ankle was and
			-- reaches the solver's spot over 0.1 s; it jumped there in one frame.
			if not s.ikOn[side] and dt and s.pose[prefix.."Hip"] then
				local sg=if side=="R" then 1 else -1
				local from=(s.pose.Root or IDENTITY)*CF(.5*sg,-.55,0)*(s.pose[prefix.."Hip"] or IDENTITY)*CF(0,-1.05,0)
					*(s.pose[prefix.."Knee"] or IDENTITY)*CF(0,-1,0)
				local rootPart=char:FindFirstChild("HumanoidRootPart")
				-- (held in the world: a lerp in root space crept with the body)
				if rootPart and (from.Position-target).Magnitude&gt;.3 then
					s.ikEnter[side]={from=rootPart.CFrame:PointToWorldSpace(from.Position),at=elapsedTime}
				end
			end
			-- (An authored clip's planted foot is exact; the hand-over blend only
			-- carries a foot that is still on its way.)
			if f.planted and rate==RATE.authored then s.ikEnter[side]=nil end
			local enter=s.ikEnter[side]
			if enter then
				local u=(elapsedTime-enter.at)/.1
				local rootPart=char:FindFirstChild("HumanoidRootPart")
				if u&gt;=1 or not rootPart then s.ikEnter[side]=nil else
					u=math.max(u,0);target=rootPart.CFrame:PointToObjectSpace(enter.from):Lerp(target,u*u*(3-2*u))
				end
			end
			local hip,knee,ankle=legIK(hips,if side=="R" then 1 else -1,target,f.yaw,f.toe)
			for _,j in {prefix.."Hip",prefix.."Knee",prefix.."Ankle"} do s.inert[j]=nil end
			-- (Authored: exact, a damped leg lets the foot creep with the body.)
			local legRate2=if rate==RATE.authored then RATE.authored else 60
			-- (A foot planted by an authored clip is exact: its knee and hip go
			-- where the hips take them this frame. Speed-capped, the leg lagged
			-- behind a landing and the "planted" foot slid down onto the floor.)
			local legDt=if rate==RATE.authored and f.planted and not enter then nil else dt
			write(char,prefix.."Hip",hip,legRate2,legDt);write(char,prefix.."Knee",knee,legRate2,legDt);write(char,prefix.."Ankle",ankle,legRate2,legDt)
		end
	end
	s.ikOn=s.ikOn or {}
	s.ikOn.R=feet~=nil and feet.R~=nil;s.ikOn.L=feet~=nil and feet.L~=nil
end

-- ------------------------------------------------------------- pose builder
-- Anatomical controls, degrees / studs:
--   root  {x,y,z,pitch,yaw,roll}  pitch + leans forward, yaw + turns right,
--         roll + tilts the top to the right; y &lt; 0 crouches.
--   torso {pitch,yaw,roll}         same conventions, upper body on the hips.
--   head  {pitch,yaw,roll}
--   ra/la {raise,out,twist,elbow,wrist,wroll}  raise + lifts the arm forward,
--         out + away from the body, twist + rotates it inward, elbow + flexes.
--   rf/lf {x,y,z,yaw,toe}  IK foot target offset from the rest ankle (x right,
--         z backwards, y up) for planted feet;
--   rl/ll {lift,out,twist,knee,ankle}  free leg (air, kicks): lift + raises the
--         thigh forward, knee + flexes.
local L1,L2=1.05,1.0
local ANKLE_Y=-2.6 -- rest ankle height relative to HumanoidRootPart centre
local function ori(o)
	if not o then return IDENTITY end
	return ANG(rad(-(o.pitch or 0)),rad(-(o.yaw or 0)),rad(-(o.roll or 0)))
end
local function armCF(side,a)
	a=a or {}
	local shoulder=ANG(rad(a.raise or 0),0,0)*ANG(0,0,rad((a.out or 0)*side))*ANG(0,rad((a.twist or 0)*side),0)
	return shoulder,ANG(rad(a.elbow or 0),0,0),ANG(rad(a.wrist or 0),0,rad((a.wroll or 0)*side))
end
local function legFK(side,l)
	l=l or {}
	return ANG(rad(l.lift or 0),0,0)*ANG(0,0,rad((l.out or 0)*side))*ANG(0,rad((l.twist or 0)*side),0),ANG(rad(-(l.knee or 0)),0,0),ANG(rad(l.ankle or 0),0,0)
end
-- Two-bone IK in the LowerTorso frame: thigh/shin lengths are the rig's real
-- joint spacing; knees point forward (and a little out); the foot stays flat.
function legIK(rootCF,side,ankle,footYaw,toe)
	local hip=rootCF*Vector3.new(.5*side,-.55,0)
	local inv=rootCF.Rotation:Inverse()
	local d=inv*(ankle-hip)
	local u=if d.Magnitude&gt;1e-4 then d.Unit else Vector3.new(0,-1,0)
	local D=math.clamp(d.Magnitude,.45,L1+L2-1e-3)
	local bend=math.pi-math.acos(math.clamp((L1*L1+L2*L2-D*D)/(2*L1*L2),-1,1))
	local a=math.acos(math.clamp((L1*L1+D*D-L2*L2)/(2*L1*D),-1,1))
	local hint=Vector3.new(side*.18,0,-1).Unit
	local w=hint-u*hint:Dot(u)
	if w.Magnitude&lt;1e-3 then w=Vector3.new(0,0,-1) end
	w=w.Unit
	local up=-(u*math.cos(a)+w*math.sin(a))
	local x=w:Cross(up)
	if x.Magnitude&lt;1e-3 then x=Vector3.xAxis end
	x=x.Unit
	local z=x:Cross(up).Unit
	local hipCF=CFrame.fromMatrix(Vector3.zero,x,up,z)
	local kneeCF=ANG(-bend,0,0)
	local foot=(hipCF*kneeCF):Inverse()*inv*ANG(0,rad(-(footYaw or 0)),0)*ANG(rad(toe or 0),0,0)
	return hipCF,kneeCF,foot
end
local function rootCFOf(spec)
	local r=spec.root or {}
	return CF(r.x or 0,r.y or 0,r.z or 0)*ori(r)
end
-- Spec -&gt; joint transforms. Unspecified parts stay at rest.
local function build(spec)
	local out={}
	local rootCF=rootCFOf(spec)
	out.Root=rootCF
	out.Waist=ori(spec.torso)
	out.Neck=ori(spec.head)
	out.Right,out.RightElbow,out.RightWrist=armCF(1,spec.ra)
	out.Left,out.LeftElbow,out.LeftWrist=armCF(-1,spec.la)
	for _,side in {1,-1} do
		local prefix=if side==1 then "Right" else "Left"
		local free=if side==1 then spec.rl else spec.ll
		if free then
			-- A free leg (air, kicks) is posed directly.
			out[prefix.."Hip"],out[prefix.."Knee"],out[prefix.."Ankle"]=legFK(side,free)
		else
			-- Otherwise the foot is planted (at rest unless told where) and the
			-- leg is solved to reach it, whatever the hips are doing.
			local foot=(if side==1 then spec.rf else spec.lf) or {}
			local ankle=Vector3.new(.5*side+(foot.x or 0),ANKLE_Y+(foot.y or 0),foot.z or 0)
			out[prefix.."Hip"],out[prefix.."Knee"],out[prefix.."Ankle"]=legIK(rootCF,side,ankle,foot.yaw,foot.toe)
			-- Remember the planted foot: apply() re-solves the leg against the
			-- hips actually drawn this frame, so the foot stays where it was put.
			out.__feet=out.__feet or {}
			out.__feet[if side==1 then "R" else "L"]={ankle=ankle,yaw=foot.yaw or 0,toe=foot.toe or 0}
		end
	end
	return out
end
local cache=setmetatable({},{__mode="k"})
local function built(spec)
	local c=cache[spec]
	if not c then c=build(spec);cache[spec]=c end
	return c
end
local function blend(a,b,t)
	if t&lt;=0 then return a end
	if t&gt;=1 then return b end
	local out={}
	for key in JOINTS do out[key]=(a[key] or IDENTITY):Lerp(b[key] or IDENTITY,t) end
	local fa,fb=a.__feet,b.__feet
	if fa and fb then
		for _,side in {"R","L"} do
			local x,y=fa[side],fb[side]
			if x and y then
				out.__feet=out.__feet or {}
				out.__feet[side]={ankle=x.ankle:Lerp(y.ankle,t),yaw=x.yaw+(y.yaw-x.yaw)*t,toe=x.toe+(y.toe-x.toe)*t}
			end
		end
	end
	return out
end
-- Deep merge: `over` replaces numeric fields of `base`; tables are merged.
local function merge(base,over)
	local out={}
	for k,v in base do out[k]=if type(v)=="table" then table.clone(v) else v end
	for k,v in over or {} do
		if type(v)=="table" and type(out[k])=="table" and not v.replace then
			for kk,vv in v do out[k][kk]=vv end
		else
			out[k]=if type(v)=="table" then table.clone(v) else v
		end
	end
	return out
end
local function smooth(t) t=math.clamp(t,0,1);return t*t*(3-2*t) end
local function easeOut(t) t=math.clamp(t,0,1);return 1-(1-t)*(1-t)*(1-t) end
local function easeIn(t) t=math.clamp(t,0,1);return t*t*t end
local EASE={smooth=smooth,out=easeOut,["in"]=easeIn,linear=function(t) return math.clamp(t,0,1) end}

-- ---------------------------------------------------------------- stances
-- Minato: light and coiled, lead foot forward, kunai hand low in reverse grip,
-- lead hand open. Itachi: upright and square, economical, left hand ready.
local STANCE={
	Flashstep={root={y=-.42,pitch=9,yaw=24},torso={pitch=5,yaw=-14},head={pitch=-6,yaw=-11},
		ra={raise=34,out=14,twist=24,elbow=98,wrist=-22},la={raise=58,out=2,twist=12,elbow=78,wrist=8},
		rf={x=.22,z=.78,yaw=32},lf={x=-.08,z=-.72,yaw=-4},breath=1.6,tempo=7.5},
	Mirage={root={y=-.2,pitch=3,yaw=14},torso={pitch=2,yaw=-8},head={pitch=1,yaw=-7},
		ra={raise=14,out=9,twist=8,elbow=32,wrist=0},la={raise=42,out=-6,twist=24,elbow=84,wrist=10},
		rf={x=.12,z=.5,yaw=22},lf={x=0,z=-.46,yaw=-2},breath=.7,tempo=5},
}
-- Neji: the Gentle Fist stance. Side-on and low, lead palm extended toward the
-- opponent, rear palm guarding the centre line.
STANCE.GentleFist={root={y=-.62,pitch=6,yaw=38},torso={pitch=4,yaw=-14},head={pitch=-2,yaw=-22},
	la={raise=80,out=-6,twist=-40,elbow=26,wrist=-46},ra={raise=56,out=-30,twist=40,elbow=96,wrist=-36},
	rf={x=.32,z=.92,yaw=64},lf={x=-.18,z=-.95,yaw=-6},breath=.8,tempo=5.5}
-- Sasuke: low and forward, lead hand out, rear hand by the chin, coiled to kick.
STANCE.Lion={root={y=-.5,pitch=10,yaw=30},torso={pitch=6,yaw=-14},head={pitch=-6,yaw=-14},
	la={raise=66,out=6,twist=10,elbow=64,wrist=0},ra={raise=52,out=-16,twist=24,elbow=118,wrist=0},
	rf={x=.26,z=.84,yaw=38},lf={x=-.1,z=-.76,yaw=-6},breath=1.3,tempo=7}
-- Motion families: the character production framework (DEC-015). A fighter
-- names the body language it is built from (stance, gait, clip set), its
-- weapon family and its intro; a new fighter declares `Motion = {body=...,
-- weapons=..., clips=...}` in Fighters instead of silently inheriting Minato.
-- Bespoke stance/clips by its own id still win over the family.
-- Identity traits are declared, never inferred from the body: `awakenPosture`
-- ("curse": Sasuke's hunched Curse Mark guard) does not follow his kicks into
-- another fighter's family (Rock Lee is built on them).
local FAMILY={
	Flashstep={body="Flashstep",weapons="kunai",springy=true},
	Mirage={body="Mirage",weapons="shuriken",springy=false},
	GentleFist={body="GentleFist",weapons="palms",springy=false},
	Lion={body="Lion",weapons="wire",springy=true,awakenPosture="curse"},
	Sand={body="Sand",weapons="none",springy=false},
}
local function familyOf(id)
	local f=FAMILY[id]
	if f then return f end
	local def=Fighters[id]
	if def and def.Motion then return def.Motion end
	return FAMILY.Flashstep
end
Motion.familyOf=familyOf
-- Gaara: upright and still, arms folded across the chest, feet close. He does
-- not fight with his body: the sand moves, he barely does.
STANCE.Sand={root={y=-.06,pitch=0,yaw=6},torso={pitch=-2,yaw=-2},head={pitch=6,yaw=-4},
	ra={raise=62,out=-42,twist=44,elbow=122,wrist=0},la={raise=58,out=-46,twist=40,elbow=118,wrist=0},
	rf={x=.06,z=.22,yaw=8},lf={x=-.06,z=-.2,yaw=-4},breath=.35,tempo=3.6}
-- Rock Lee (stress-test wave, DEC-015): the Strong Fist stance. Side-on, low
-- and springy, the lead hand open and held out at the opponent, the rear hand
-- folded behind the small of the back. His family (Fighters.Leaf.Motion) is
-- Sasuke's kicks; this stance and a few clips (CLIPS.Leaf) are his own.
STANCE.Leaf={root={y=-.58,pitch=8,yaw=36},torso={pitch=5,yaw=-16},head={pitch=-4,yaw=-22},
	la={raise=92,out=-8,twist=-24,elbow=24,wrist=-30},ra={raise=-48,out=-4,twist=96,elbow=68,wrist=0},
	rf={x=.3,z=.92,yaw=46},lf={x=-.12,z=-.88,yaw=-8},breath=1.5,tempo=8.5}
-- A breadth-pass fighter may carry its own stance in data (Motion.stance).
local function stance(id) return STANCE[id] or familyOf(id).stance or STANCE[familyOf(id).body] or STANCE.Flashstep end
-- Gait families: springy (Minato, Sasuke) or controlled (Itachi, Neji).
local SPRINGY={Flashstep=true,Lion=true}
local function springy(id)
	local f=familyOf(id)
	if f.springy~=nil then return f.springy end
	return SPRINGY[f.body]==true
end

-- ---------------------------------------------------------- attack clips
-- Keys are placed on the move's own timeline: 0 = start, 1 = end of startup
-- (contact), 2 = end of active, 3 = end of recovery. `w` fades the clip out
-- over the tail of recovery so the body returns into its stance.
local function K(at,pose,ease) return {at=at,pose=pose,ease=ease or "smooth"} end
local M=STANCE.Flashstep
local I=STANCE.Mirage
local function m(over) return merge(M,over) end
local function i(over) return merge(I,over) end
local N=STANCE.GentleFist
local function n(over) return merge(N,over) end
local CLIPS={Flashstep={},Mirage={},GentleFist={},Lion={},Sand={}}
-- Read-only view for the headless suites (which clips a fighter authors).
Motion.CLIPS=CLIPS
-- Gaara ---------------------------------------------------------------
-- He barely moves: one hand unfolds and flicks the sand out, then folds back.
local G=STANCE.Sand
local function g(over) return merge(G,over) end
CLIPS.Sand.Light1={ -- right hand flicks the sand out, palm open
	K(0,g({torso={yaw=6},ra={raise=72,out=-14,twist=10,elbow=94,wrist=0}})),
	K(1,g({torso={yaw=-12},head={yaw=4},ra={raise=94,out=8,twist=-6,elbow=8,wrist=-42}}),"out"),
	K(2,g({torso={yaw=-12},ra={raise=92,out=8,twist=-6,elbow=12,wrist=-40}})),
	K(3,G),
}
CLIPS.Sand.Light2={ -- the left hand answers
	K(0,g({torso={yaw=-6},la={raise=72,out=-14,twist=10,elbow=94,wrist=0}})),
	K(1,g({torso={yaw=12},head={yaw=-4},la={raise=94,out=8,twist=-6,elbow=8,wrist=-42}}),"out"),
	K(2,g({torso={yaw=12},la={raise=92,out=8,twist=-6,elbow=12,wrist=-40}})),
	K(3,G),
}
CLIPS.Sand.Light3={ -- both palms push: the sand wave throws the body back
	K(0,g({root={z=.15},ra={raise=66,out=-6,elbow=100},la={raise=66,out=-6,elbow=100}})),
	K(1,g({root={z=.25,pitch=-3},torso={pitch=-4},ra={raise=90,out=10,elbow=10,wrist=-44},la={raise=90,out=10,elbow=10,wrist=-44}}),"out"),
	K(2,g({root={z=.25,pitch=-3},ra={raise=88,out=10,elbow=14,wrist=-40},la={raise=88,out=10,elbow=14,wrist=-40}})),
	K(3,G),
}
CLIPS.Sand.SandPillar={ -- the hand rises palm up: sand erupts under the opponent
	K(0,g({root={y=-.12},head={pitch=12},ra={raise=40,out=10,twist=-30,elbow=100,wrist=30}})),
	K(1,g({root={y=.02,pitch=-4},torso={pitch=-6},head={pitch=-14},ra={raise=152,out=18,twist=-30,elbow=36,wrist=40}}),"out"),
	K(2,g({root={pitch=-4},torso={pitch=-6},head={pitch=-14},ra={raise=150,out=18,twist=-30,elbow=38,wrist=40}})),
	K(3,G),
}
CLIPS.Sand.Sweep={ -- the arm sweeps low: sand reaps the legs
	K(0,g({root={y=-.15},ra={raise=30,out=62,twist=0,elbow=40,wrist=0}})),
	K(1,g({root={y=-.2},torso={yaw=-20},ra={raise=16,out=-34,twist=0,elbow=24,wrist=-30}}),"out"),
	K(2,g({root={y=-.2},torso={yaw=-22},ra={raise=16,out=-36,elbow=26,wrist=-30}})),
	K(3,G),
}
