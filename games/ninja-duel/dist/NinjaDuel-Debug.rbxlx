			Moves = { Light1 = true, Light2 = true, Light3 = true, Heavy = true, Launcher = true, Sweep = true, FeintStep = true, DashAttack = true, Air1 = true, Air2 = true, AirSpike = true } },
		-- (Stage 6, 13:42 decision) The Sharingan only while awakened (SharinganAwake).
		Sharingan = { ParryWindow = 0.26, PerfectDodge = 0.2, Counter = 0.8 }, SharinganAwake = true,
		-- Awakening: the Sharingan uncovered. Wider read windows, jutsu at a
		-- fraction of their cost, and his hounds hold half as long again.
		Awakening = { Name = "SHARINGAN UNCOVERED", Speed = 1.08, Regen = 1.4, Cooldown = 0.5, CostScale = 0.6, Windows = 1.4, BindScale = 1.5, Color = { 230, 50, 60 } },
		-- (06/11, « le Sharingan qui copie ») The Copy Ninja (Server/Copy): a jutsu
		-- cast in front of him takes his first slot (the Water Dragon, his first
		-- copy) for Life seconds or Uses casts; uncovered, from any angle.
		Copy = { Slot = 1, Life = 15, Uses = 1 },
		-- (06/11, « les chiens ninja qui sortent du sol ») His ninken (Server/Hounds):
		-- a Pack that digs at Dig studs/s to the legs, bites in Reach (the
		-- technique's Bind, ChaseBite after a chase), or runs him down at Run for
		-- Chase seconds when he dodged.
		Bodies = { hound = { Pack = 4, Dig = 46, Run = 30, Chase = 2.2, Reach = 2.4, ChaseBite = .7 } },
		Motion = { body = "Mirage", weapons = "kunai", springy = false,
			-- Slouched and relaxed, one hand low by the holster.
			stance = {root={y=-.32,pitch=4,yaw=24},torso={pitch=8,yaw=-10},head={pitch=6,yaw=-14},
				ra={raise=20,out=6,twist=10,elbow=50,wrist=0},la={raise=56,out=-20,twist=-30,elbow=80,wrist=-10},
				rf={x=.2,z=.55,yaw=30},lf={x=-.1,z=-.55,yaw=-6},breath=.8,tempo=5} },
		AttackProfile = {
			Light1={startup=.92,recovery=.92,travel=1.04},Light2={startup=.94,recovery=.9,travel=1.04,kind="kick"},
			Light3={startup=1.0,recovery=.96,impulseZ=54},Heavy={startup=.98},
			Launcher={startup=.96,impulseY=56},DashAttack={startup=.92,travel=1.08},Air1={startup=.94},Air2={startup=.94},
		},
		Skin = { 226, 200, 178 }, Hair = { 214, 218, 222 }, Outfit = { 40, 50, 72 },
		Techniques = {
			{ Id = "WaterDragon", Name = "Water Dragon", Family = "Projectile", Kind = "waterdragon", Element = "Water", Cost = 28, Channel = 0.55, Active = 0.3, Recovery = 0.36, Cooldown = 7, Interruptible = true, Feintable = true,
				Range = 52, Speed = 60, Damage = 14, Radius = 2.4, Knock = 46, Lift = 18, Hint = "A copied dragon of water that throws the body far • a jutsu cast in front of him is copied here (15 s, one cast)" },
			{ Id = "LightningBlade", Name = "Lightning Blade", Family = "Strike", Move = "ChidoriThrust", Element = "Lightning", Cost = 32, Channel = 0.5, Active = 0.05, Recovery = 0.12, Cooldown = 9, Interruptible = true,
				-- (User 28/10) Like Sasuke's Chidori: formed, it stays in the hand.
				State = { Time = 2.6, Drain = 6, Strike = "ChidoriThrust", Air = "ChidoriThrust", Damage = 22, World = { contact = "energy", element = "lightning" }, Style = "chidori", Name = "Lightning Blade" },
				Range = 20, Damage = 22, Hint = "Charge, then a lightning thrust • a miss leaves him open", AI = { Min = 4, Max = 16, Punish = true } },
			{ Id = "TrackingFang", Name = "Summoning: Tracking Fang", CardName = "Tracking Fang", Family = "Projectile", Kind = "hounds", Ground = true, Cost = 22, Channel = 0.3, Active = 0.08, Recovery = 0.3, Cooldown = 8, Interruptible = true,
				Range = 30, Speed = 50, Damage = 4, Radius = 1.6, Bind = 1.1, Hint = "Four hounds dig to his legs, burst out and hold him • dodged, they chase him • one blow sends a hound away" },
			{ Id = "LightningCut", Name = "Lightning Cut", Family = "Teleport", To = "Behind", Distance = 3.2, Move = "DashAttack", Armed = true, Element = "Lightning", Cost = 18, Channel = 0.08, Active = 0.02, Recovery = 0.16, Cooldown = 6, Interruptible = true, Range = 22, Damage = 14, Invuln = 0.12, Kind = "lightning", Hint = "Tantô drawn: through the body in one cut, out behind it" },
		},
	},
}
-- (DEC-032) The hand-seal jutsu of the eight, beyond their four quick slots.
for id,list in require(script.Parent.SealJutsu) do
	if type(list)=="table" and Fighters[id] and list[1] and list[1].Signs then Fighters[id].SealJutsu=list end
end
-- Roster 20 batches keep their fighters in their own data modules.
for _,wave in {require(script.Parent.Wave1),require(script.Parent.Wave2),require(script.Parent.Wave3),require(script.Parent.Wave4)} do
	for id,def in wave.fighters or {} do Fighters[id]=def end
end
return Fighters
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND16">
        <Properties>
          <string name="Name">FirstMinute</string>
          <ProtectedString name="Source">-- The first minute (B1 lot 2, DEC-034; Codex's audit 26f8623 §3: a first
-- input in under 15 s, a first spectacular action in under 45 s, a first duel
-- within 3 minutes, few buttons at first, the full tutorial kept but not
-- imposed). From the roster's PLAY: four prompts on the field with a partner
-- who waits (move, strike, dodge, the fighter's signature), then straight into
-- a real duel against the easy AI. The full tutorial stays as TRAINING.
--
-- Shared: the server runs the steps (Server/Tutorial.firstPlan), the client
-- names them and keeps the HUD to these few controls in the first duel.
local FirstMinute={}

-- Each prodigy's signature is his second jutsu (one key: 2, □ + R1's second
-- glyph on the pad, the second jutsu button on a phone).
FirstMinute.SignatureSlot=2
-- His partner and first opponent: the story's pair of the tournament's
-- quarter-finals (Server/Tournament.Seats).
FirstMinute.Rival={
	Lion="Sand",Sand="Lion",Legion="GentleFist",GentleFist="Legion",
	Leaf="Flashstep",Flashstep="Leaf",Mirage="Copycat",Copycat="Mirage",
}
-- What a touch player presses (the TouchControls buttons).
FirstMinute.Touch={
	move="Drag on the left of the screen",
	string="Tap ATTACK three times",
	dodge="Hold a direction, tap DODGE",
	signature="Tap the second jutsu button",
}
function FirstMinute.signature(def)
	return def and def.Techniques and def.Techniques[FirstMinute.SignatureSlot]
end
function FirstMinute.rival(fighterId)
	return FirstMinute.Rival[fighterId]
end
return FirstMinute
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND17">
        <Properties>
          <string name="Name">LobbyProtocol</string>
          <ProtectedString name="Source">-- Players online and challenges (Server/Lobby, Client/LobbyPanel): tunables
-- and the vocabulary between them. Authority stays in Server/Lobby; nothing in
-- here is ever read back from a client.
--
-- Client -&gt; server (RemoteEvent NinjaDuel.Lobby), every field checked there:
--   {op="open"} / {op="close"}           the list is on screen / closed
--   {op="fighter", fighter=id}           the fighter picked on the roster
--   {op="dnd", on=bool}                  do not disturb
--   {op="challenge", to=userId, fighter=id}
--   {op="answer", id=challengeId, accept=bool, fighter=id}
--   {op="cancel", id=challengeId}
--   {op="home"}                          from a duel server: back to the lobby
-- Server -&gt; client:
--   {kind="list", players={...}, dnd=bool, duelServer=bool}
--   {kind="invite", id, from, fromId, fighter, remaining}
--   {kind="sent", id, to, remaining} / {kind="closed", id, text?}
--   {kind="status", text, tone="info"|"bad"} / {kind="dnd", on}
return table.freeze({
	Tune=table.freeze({
		-- Presence: published every Publish s, gone after Life s without a refresh,
		-- the map read back every Read s (up to Page entries), ListMax shown.
		Publish=15,Life=45,Read=10,Page=200,ListMax=60,
		-- A challenge lasts ChallengeLife s; one every Gap s per player, MaxOut
		-- waiting per challenger, MaxIn waiting per challenged player.
		ChallengeLife=20,Gap=10,MaxOut=3,MaxIn=3,
		-- Requests of one player: one every OpGap s.
		OpGap=0.25,
		-- Duel server: both players within Arrival s, its record kept DuelRecordLife s.
		Arrival=45,DuelRecordLife=600,
		PresenceMap="ND_Presence_v1",DuelMap="ND_DuelServers_v1",Topic="ND_Lobby_v1",
	}),
})
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND18">
        <Properties>
          <string name="Name">Looks</string>
          <ProtectedString name="Source">-- How a family object looks (Families.luau, client FamilyFX): one entry per
-- projectile/zone kind, shared by server (launch point, radius, contact
-- style) and client (shape, colours, light, trail, contact burst).
--
-- shape: orb | needle | blade | wave | beast | serpent | swarm | shadow | boulder
-- color/color2: core and edge (RGB); size: {width, height, length} in studs;
-- light: PointLight brightness (0 = none); trail: trail width (0 = none);
-- hit: contact burst (splash | shatter | burst | smoke | sparks | crush);
-- zone: how a zone of that kind is drawn (mist | swarm | water | scorch | shadow | spikes).
local function rgb(r,g,b) return {r,g,b} end
return {
	-- Plain moulded chakra: the neutral fallback, never a kunai.
	chakra={shape="orb",color=rgb(150,210,255),color2=rgb(70,140,255),size={1.2,1.2,1.2},light=2,trail=.8,hit="burst",launch="Palm"},
	water={shape="orb",color=rgb(150,214,255),color2=rgb(40,120,210),size={1.4,1.4,1.8},light=.6,trail=1,hit="splash",zone="water",launch="Palm"},
	waterdragon={shape="serpent",color=rgb(120,196,255),color2=rgb(30,96,190),size={3,3,18},light=1,trail=2.4,hit="splash",zone="water",launch="Fireball",radius=2.4},
	shark={shape="beast",color=rgb(92,140,196),color2=rgb(222,236,248),size={2.4,2.2,5.4},light=.4,trail=1.8,hit="splash",zone="water",launch="Fireball",radius=2.2},
	ice={shape="blade",color=rgb(214,240,255),color2=rgb(150,206,240),size={.5,.5,3.2},light=.8,trail=.4,hit="shatter",zone="ice",launch="Palm"},
	senbon={shape="needle",color=rgb(220,226,236),color2=rgb(170,180,196),size={.08,.08,1.6},light=0,trail=.15,hit="sparks",launch="Shuriken",radius=.45},
	bone={shape="needle",color=rgb(240,234,214),color2=rgb(208,196,170),size={.22,.22,1.4},light=0,trail=.25,hit="sparks",launch="Palm",radius=.5},
	shadow={shape="shadow",color=rgb(16,14,22),color2=rgb(40,34,56),size={1.6,.06,1},light=0,trail=0,hit="smoke",zone="shadow",launch="Ground",radius=1.4},
	insects={shape="swarm",color=rgb(30,32,26),color2=rgb(70,84,50),size={3,2.4,3},light=0,trail=0,hit="smoke",zone="swarm",launch="Palm",radius=1.8},
	hounds={shape="beast",color=rgb(150,120,90),color2=rgb(60,52,46),size={1.4,1.6,2.8},light=0,trail=.6,hit="crush",launch="Ground",radius=1.6},
	dog={shape="beast",color=rgb(244,240,230),color2=rgb(200,170,150),size={1.3,1.5,2.4},light=0,trail=.6,hit="crush",launch="Ground",radius=1.5},
	snakes={shape="serpent",color=rgb(96,70,120),color2=rgb(176,150,96),size={.8,.8,6},light=0,trail=.5,hit="crush",launch="Palm",radius=1},
	tag={shape="blade",color=rgb(232,222,190),color2=rgb(190,40,36),size={.5,.04,1.1},light=0,trail=.2,hit="burst",zone="scorch",launch="Kunai",radius=.6},
	mud={shape="wave",color=rgb(120,92,64),color2=rgb(84,64,46),size={6,3,2},light=0,trail=0,hit="crush",zone="mud",launch="Ground",radius=2.4},
	boulder={shape="boulder",color=rgb(200,150,110),color2=rgb(150,104,72),size={5,5,5},light=0,trail=0,hit="crush",launch="Ground",radius=2.4},
	-- Roster 20, remaining ten (DEC-022).
	-- Shisui: the Katon fireball (drawn by Effects' own fireball builder).
	fireball={shape="orb",color=rgb(255,160,60),color2=rgb(255,90,30),size={3,3,3},light=3,trail=1,hit="burst",zone="scorch",launch="Fireball",radius=2.2},
	-- Orochimaru: one long shadow snake shot from the sleeve.
	snake={shape="serpent",color=rgb(70,60,86),color2=rgb(150,132,90),size={.7,.7,7},light=0,trail=.4,hit="crush",launch="Palm",radius=1.1},
	-- Kimimaro: a long bone drawn from the shoulder, the larch of spikes.
	bonespear={shape="needle",color=rgb(244,238,220),color2=rgb(214,200,172),size={.45,.45,3.2},light=0,trail=.3,hit="shatter",launch="Palm",radius=.8},
	bones={shape="needle",color=rgb(244,238,220),color2=rgb(214,200,172),size={.3,.3,2},light=0,trail=0,hit="shatter",zone="spikes",radius=1},
	-- Nagato: the Rinnegan's pull, a ripple of bent air, and the push.
	gravity={shape="orb",color=rgb(196,170,230),color2=rgb(120,96,170),size={1.6,1.6,1.6},light=1.2,trail=1.4,hit="burst",launch="Palm",radius=1.6},
	repulsion={shape="orb",color=rgb(214,200,240),color2=rgb(150,126,200),size={1,1,1},light=0,trail=0,hit="burst"},
	-- Sasori: the puppet on its threads, its poisoned needles.
	puppet={shape="beast",color=rgb(150,110,74),color2=rgb(86,64,46),size={1.6,2.4,2.6},light=0,trail=.4,hit="crush",launch="Palm",radius=1.6},
	poisonneedle={shape="needle",color=rgb(150,200,120),color2=rgb(80,120,60),size={.1,.1,1.4},light=0,trail=.2,hit="sparks",launch="Shuriken",radius=.5},
	-- Deidara: moulded explosive clay.
	claybird={shape="beast",color=rgb(240,236,222),color2=rgb(204,196,176),size={2.2,1,2.4},light=0,trail=.5,hit="burst",zone="scorch",launch="Palm",radius=1.6},
	clayspider={shape="beast",color=rgb(236,232,218),color2=rgb(196,188,168),size={.9,.5,1},light=0,trail=0,hit="burst",zone="scorch",launch="Ground",radius=1.2},
	-- A charge laid on the floor (a missed bird or spider, a buried mine).
	claycharge={shape="orb",color=rgb(240,236,222),color2=rgb(255,120,60),size={.9,.6,.9},light=0,trail=0,hit="burst",zone="charge",radius=1},
	clay={shape="orb",color=rgb(240,236,222),color2=rgb(255,190,90),size={1,1,1},light=0,trail=0,hit="burst",zone="scorch"},
	-- Killer Bee: the Eight-Tails' ink and a tentacle.
	ink={shape="orb",color=rgb(30,28,40),color2=rgb(60,56,80),size={1,1,1},light=0,trail=0,hit="smoke",zone="mist"},
	tentacle={shape="serpent",color=rgb(170,96,80),color2=rgb(220,170,150),size={1.4,1.4,8},light=0,trail=.6,hit="crush",launch="Palm",radius=1.6},
	-- Haku: a mirror of ice (the dome is drawn by Wave1FX).
	mirror={shape="blade",color=rgb(214,240,255),color2=rgb(150,206,240),size={.2,3,2},light=.8,trail=0,hit="shatter",zone="ice"},
	-- Kabuto: the scalpel of chakra.
	scalpel={shape="blade",color=rgb(140,240,200),color2=rgb(60,200,150),size={.3,.06,1.2},light=1,trail=.3,hit="sparks"},
	flicker={shape="orb",color=rgb(40,40,48),color2=rgb(230,60,60),size={1,1,1},light=0,trail=0,hit="smoke"},
	-- Zones that are not thrown.
	mist={shape="orb",color=rgb(226,232,238),color2=rgb(190,200,210),size={1,1,1},light=0,trail=0,hit="smoke",zone="mist"},
	fist={shape="orb",color=rgb(255,190,190),color2=rgb(255,120,140),size={1.6,1.6,1.6},light=2.5,trail=0,hit="crush",zone="crater"},
	-- DEC-026 newcomers (Wave4). Hashirama's contact root runs the floor from
	-- his hand; the short Katon breath of Madara and Hiruzen (a cone drawn by
	-- Wave4FX); the stances: Madara's read (the blade turned flat), the young
	-- wood guard, Hiruzen's lever.
	root={shape="serpent",color=rgb(120,84,50),color2=rgb(150,190,90),size={.9,.9,4},light=0,trail=0,hit="crush",launch="Ground",radius=1.5},
	firebreath={shape="orb",color=rgb(255,170,70),color2=rgb(255,90,30),size={2,2,2},light=3,trail=0,hit="burst",zone="scorch"},
	swordread={shape="blade",color=rgb(220,60,60),color2=rgb(200,206,214),size={.2,.06,2.4},light=0,trail=0,hit="sparks"},
	woodguard={shape="blade",color=rgb(150,110,70),color2=rgb(110,160,80),size={.6,.6,1.6},light=0,trail=0,hit="crush"},
	-- (Stage 6) the eight main fighters' new jutsu: Minato's flash cut,
	-- Kakashi's white-chakra cut, Lee's entry kick, Neji's sight, Gaara's
	-- armour and Lee's weights (bodies and buffs: no thrown object).
	flash={shape="blade",color=rgb(255,236,120),color2=rgb(255,200,40),size={.3,.06,1.6},light=2,trail=.6,hit="sparks"},
	lightning={shape="blade",color=rgb(236,246,255),color2=rgb(130,190,255),size={.3,.06,2.2},light=2.5,trail=.5,hit="sparks"},
	leaf={shape="orb",color=rgb(120,200,90),color2=rgb(60,140,50),size={1.2,1.2,1.2},light=0,trail=.6,hit="crush"},
	byakugan={shape="orb",color=rgb(236,232,255),color2=rgb(170,160,230),size={1,1,1},light=1,trail=0,hit="burst"},
	sandarmor={shape="orb",color=rgb(214,186,130),color2=rgb(170,140,90),size={1,1,1},light=0,trail=0,hit="crush"},
	weights={shape="boulder",color=rgb(150,140,130),color2=rgb(90,84,78),size={1,1,1},light=0,trail=0,hit="crush"},
	staffread={shape="blade",color=rgb(232,200,120),color2=rgb(90,64,40),size={.2,.2,4},light=0,trail=0,hit="sparks"},
	-- (DEC-032) the hand-seal jutsu of the eight (Shared/SealJutsu).
	windmill={shape="blade",color=rgb(196,204,214),color2=rgb(90,96,110),size={1.1,.08,1.1},light=0,trail=.3,hit="sparks",launch="Shuriken",radius=.7},
	fuma={shape="blade",color=rgb(170,178,190),color2=rgb(60,64,76),size={2.6,.12,2.6},light=0,trail=.6,hit="sparks",launch="Shuriken",radius=1.3},
	firedragon={shape="serpent",color=rgb(255,170,60),color2=rgb(255,80,20),size={2.6,2.6,14},light=3,trail=2,hit="burst",zone="scorch",launch="Fireball",radius=2.2},
	foxchakra={shape="orb",color=rgb(255,120,40),color2=rgb(200,30,20),size={1.4,1.4,1.4},light=2,trail=0,hit="burst"},
	sandgrab={shape="wave",color=rgb(222,194,136),color2=rgb(176,146,96),size={3,1.4,2.4},light=0,trail=0,hit="crush",zone="mud",launch="Ground",radius=1.6},
	sandspike={shape="needle",color=rgb(226,198,140),color2=rgb(180,150,100),size={.6,.6,3},light=0,trail=0,hit="crush",zone="spikes",launch="Ground",radius=1.2},
	quicksand={shape="wave",color=rgb(214,184,124),color2=rgb(170,140,90),size={6,1,2},light=0,trail=0,hit="crush",zone="mud",launch="Ground",radius=2.4},
	thirdeye={shape="orb",color=rgb(226,198,140),color2=rgb(120,90,50),size={.9,.9,.9},light=.6,trail=0,hit="burst"},
	crows={shape="swarm",color=rgb(18,16,24),color2=rgb(150,30,40),size={3.4,2.6,3.4},light=0,trail=0,hit="smoke",zone="swarm",launch="Palm",radius=2},
	airpalm={shape="orb",color=rgb(236,240,255),color2=rgb(176,190,240),size={1.6,1.6,1.6},light=.8,trail=1.2,hit="burst",launch="Palm",radius=1.2},
	-- (04/11) Minato: a sealing formula written on the floor (Families zone Trap),
	-- the space-time barrier (a warping stance) and its seal.
	-- (04/11) The replaced seal jutsu: Gamakichi's water bullet (and the toad
	-- itself), Shukaku's arm of sand, Neji's mountain crusher, the Sharingan's
	-- hold, the smoke of a shadow clone popping out.
	toadwater={shape="orb",color=rgb(170,222,255),color2=rgb(60,140,220),size={2.2,2.2,2.8},light=.8,trail=1.4,hit="splash",zone="water",launch="Palm",radius=1.6},
	toad={shape="beast",color=rgb(236,120,50),color2=rgb(90,60,120),size={2.4,1.8,2.6},light=0,trail=0,hit="smoke"},
	sandarm={shape="wave",color=rgb(214,184,124),color2=rgb(150,118,78),size={12,3,2},light=0,trail=0,hit="crush",launch="Ground",radius=3},
	hasangeki={shape="wave",color=rgb(220,232,255),color2=rgb(150,176,240),size={7,5,2},light=1.2,trail=1.6,hit="burst",launch="Palm",radius=3.4},
	sharingan={shape="orb",color=rgb(230,30,40),color2=rgb(20,10,12),size={.6,.6,.6},light=1.6,trail=0,hit="burst"},
	clonepop={shape="orb",color=rgb(244,240,236),color2=rgb(255,150,40),size={1,1,1},light=0,trail=0,hit="smoke"},
	sealtrap={shape="orb",color=rgb(244,236,214),color2=rgb(40,34,30),size={1,1,1},light=0,trail=0,hit="burst",zone="seal",launch="Ground",radius=4.2},
	barrier={shape="orb",color=rgb(255,222,120),color2=rgb(40,34,30),size={1,1,1},light=1.4,trail=0,hit="burst"},
	trigram={shape="orb",color=rgb(214,220,255),color2=rgb(150,160,230),size={1,1,1},light=0,trail=0,hit="burst",zone="shadow"},
	markedkunai={shape="needle",color=rgb(206,212,222),color2=rgb(255,214,92),size={.14,.14,1.3},light=.6,trail=.3,hit="sparks",launch="Kunai",radius=.6},
	earthwall={shape="boulder",color=rgb(150,120,88),color2=rgb(104,82,60),size={6,5,1.4},light=0,trail=0,hit="crush",zone="spikes",launch="Ground",radius=3},
	earthhand={shape="beast",color=rgb(142,112,82),color2=rgb(96,76,56),size={1.4,1.8,1.8},light=0,trail=0,hit="crush",zone="mud",launch="Ground",radius=1.6},
	earthdragon={shape="serpent",color=rgb(150,118,84),color2=rgb(96,74,52),size={3,3,18},light=0,trail=1.6,hit="crush",zone="crater",launch="Ground",radius=2.4},
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND19">
        <Properties>
          <string name="Name">MoveGraphs</string>
          <ProtectedString name="Source">-- Character move graphs: the data half of each fighter's combat identity.
-- Shared fundamentals (strings, launcher, chase, air route, defence) live in
-- Brawler/Combat; what a fighter does *differently* inside them is declared
-- here, so a new prodigy adds a table entry plus only the bespoke code its kit
-- really needs.
--
-- Directional combo grammar (shared by every fighter, interpreted by each).
-- Hits are CONFIRMED hits (a whiff or a blocked strike restarts the string);
-- the stick is read relative to the opponent through a short memory
-- (Config.Combo), so a push released a moment before the press still counts.
--   routes.up      stick toward the opponent + strike, 2+ hits in: launcher
--   routes.down    stick away + strike, 2+ hits in: low route (sweep)
--   routes.side    stick left/right + strike, 1+ hit in: lateral route
--   routes.airUp / airDown / airSide   the same grammar after an air hit:
--                  drive away, spike down, switch sides
--   disengage      stick away + tool inside a string: hop out behind a throw
--   onRoute[name]  what that fighter's version of a route adds (a seal, blades)
--   heavyAfterOne  heavy after one clean hit, and the heavy on a re-engage
--                  arrival (chase or chakra dash)
--   stringCancels[techniqueId] techniques that may cancel a clean string
--                              (with a shortened wind-up)
--   blockCancels[action]       actions still allowed out of a blocked light
--   readCounter                move started by the next press after a Read
--   reengage       how the prodigy re-enters (Combat:reengage / chase / rush):
--                  speed (x Config.Rush.Speed), arrive (studs short of the
--                  body), angle (degrees off the line he arrives on), chase
--                  (seconds of a chase), recovery (an unanswered arrival),
--                  minRange, and the style's own rules: sealAngle/sealPull
--                  (a planted seal near the target), afterimage + feint (guard
--                  or dodge aborts the dash), commit + past (the line is fixed
--                  after `commit` s and aims `past` studs through the body),
--                  dashDamage (the arrival strike). `name` reaches the client.
local Graphs = {
	Flashstep={
		routes={up="Launcher",down="Sweep",side="AngleStep",airUp="AirDrive",airDown="AirSpike",airSide="AirSwitch"},
		disengage="Kunai",
		-- The rising kick leaves a seal on the body (2 follows it up); the leg
		-- sweep plants a marked kunai where the opponent fell.
		onRoute={Launcher="bodySeal",Sweep="floorSeal"},
		-- Heavy after one clean cut: a rising knee that pops the opponent up.
		heavyAfterOne="KneeStrike",
		-- (Stage 6) at 13 he has no Rasengan: a clean string is spent on the
		-- Lightning Strike (the shunshin cut) instead.
		stringCancels={LightningStrike=true},
		blockCancels={},
		-- Surgical: the fastest re-entry, onto an angle beside the body; a seal
		-- planted near the target pulls him onto its side, wider and quicker.
		reengage={name="flash",speed=1.3,arrive=3.2,angle=32,sealAngle=58,sealPull=1.12,chase=.24,recovery=.14},
	},
	Mirage={
		routes={up="Launcher",down="Sweep",side="FeintStep",airUp="AirDrive",airDown="AirSpike",airSide="AirSwitch"},
		disengage="Shuriken",
		-- The rising palm is covered by two shuriken thrown up after the body;
		-- the feint step leaves an afterimage where he stood.
		onRoute={Launcher="coverBlades",AirDrive="coverBlades"},
		-- Heavy after one clean strike: the palm that drives the opponent away
		-- (toward a wall when one is near) instead of the launcher.
		heavyAfterOne="CounterPalm",
		-- Body attack -&gt; projectile cover: a clean string ends in Shadow Shuriken.
		stringCancels={NeedleFan=true},
		blockCancels={Tool=true},
		readCounter="CounterPalm",
		-- Calm and deceptive: a slower approach that leaves an afterimage where
		-- he started, arrives a little aside, and can be aborted (guard or dodge).
		reengage={name="mirage",speed=.8,arrive=3.8,angle=18,afterimage=true,feint=true,chase=.34,recovery=.2},
	},
	GentleFist={
		routes={up="Launcher",down="Sweep",side="CircleStep",airUp="AirDrive",airDown="AirSpike",airSide="AirSwitch"},
		disengage="Kunai",
		-- Every Gentle Fist route closes chakra points; the low routes (the sweep
		-- and the descending air palm) close two.
		onRoute={Sweep="tenketsu",AirSpike="tenketsu"},
		-- Heavy after a single clean palm: a twin-palm thrust that drives the
		-- opponent away (into a wall when one is near) instead of the launcher.
		heavyAfterOne="PalmThrust",
		stringCancels={VacuumPalm=true},
		blockCancels={},
		-- After Rotation repels an attack, the next press is the palm thrust.
		readCounter="PalmThrust",
		-- Compact and direct: straight down the centre line, tighter, and from
		-- closer than anyone else.
		reengage={name="palm",speed=1.02,arrive=2.9,angle=0,minRange=5,chase=.3,recovery=.18},
	},
	Lion={
		-- Out of a full sprint: the flying kick (Brawler running taijutsu).
		runStrike="FlyingKick",
		routes={up="LionKick",down="Sweep",side="VaultKick",airUp="AirDrive",airDown="AirSpike",airSide="AirSwitch"},
		disengage="Shuriken",
		-- The rising kick is followed into the air at once (Shadow of the
		-- Dancing Leaf); a heavy there is the Lion Combo.
		onRoute={LionKick="shadowLeaf"},
		heavyAfterOne="KneeStrike",
		stringCancels={Chidori=true},
		blockCancels={},
		-- Explosive and committed: fast, his line is fixed almost at once and aims
		-- through the body (a side-step makes him overshoot), the arrival strike
		-- hits harder, an unanswered arrival recovers longest.
		reengage={name="lion",speed=1.15,arrive=2.8,angle=0,commit=.06,past=2.6,dashDamage=1.15,chase=.28,recovery=.3},
	},
	Sand={
		-- (Stage 6) away: the low wave; sideways: the sand glide.
		routes={up="SandPillar",down="SandLowWave",side="SandGlide"},
		-- A controller, not a rushdown: the re-engage is a glide on the sand that
		-- stops at lash range (the arrival strike is a lash), slower than a dash.
		reengage={name="sand",speed=.85,arrive=7.5,angle=0,minRange=11,chase=.3,recovery=.22},
		-- One lash, then the pillar: sand erupts under the opponent.
		heavyAfterOne="SandFist",
		stringCancels={SandCoffin=true},
		blockCancels={Tool=true},
	},
	-- Rock Lee (stress-test wave, DEC-015): kicks all the way, no blade, so no
	-- disengage. Toward after two hits: the Leaf Rising Wind, followed into the
	-- air at once (the shared Shadow of the Dancing Leaf; Sasuke copied it from
	-- him); a heavy up there is his own finisher (airFinisher) instead of the
	-- Lion Combo. Away: the Leaf Hurricane, a low spinning kick that keeps the
	-- string going instead of ending it. Sideways: the Leaf Whirlwind, a wide
	-- spinning kick that catches a side step instead of taking an angle.
	Leaf={
		-- Out of a full sprint: the flying kick (Brawler running taijutsu).
		runStrike="FlyingKick",
		routes={up="LeafRising",down="LeafHurricane",side="LeafWhirlwind",airUp="AirDrive",airDown="AirSpike",airSide="AirSwitch"},
		onRoute={LeafRising="shadowLeaf"},
		heavyAfterOne="KneeStrike",
		stringCancels={LeafGreatWhirlwind=true},
		blockCancels={},
		--   airFinisher   the heavy inside the Shadow of the Dancing Leaf window
		--                 (Brawler.airFinisher): name (the client clip), cue,
		--                 event, damage, impulse, reaction, stun; healthCost is
		--                 paid from his own health (never to a KO) and refused
		--                 at or under minHealth (then `fallback`); `awakened`
		--                 replaces it, free, while the awakening burns.
		-- Primary Lotus: the body driven head first into the floor. In the Fifth
		-- Gate, the Hidden Lotus: harder, free, and the body bounces back up for
		-- one more strike.
		airFinisher={name="PrimaryLotus",cue="PRIMARY LOTUS",event="PrimaryLotus",damage=22,impulse=Vector3.new(0,-96,6),healthCost=10,minHealth=26,
			fallback={name="LeafHeel",cue="LEAF HEEL • NO STRENGTH LEFT FOR THE LOTUS",event="LeafHeel",damage=14},
			awakened={name="HiddenLotus",cue="FIFTH GATE • HIDDEN LOTUS",event="HiddenLotus",damage=26,reaction="Spiked",impulse=Vector3.new(0,-104,4),stun=.9}},
		-- Relentless: the fastest re-entry of all, straight down the line, from
		-- closer than most, and the shortest recovery after an arrival.
		reengage={name="leaf",speed=1.4,arrive=3,angle=0,minRange=6,chase=.24,recovery=.16},
	},
	-- Naruto (roster wave, several bodies): his routes are carried out by his
	-- shadow clones (Server/Bodies).
	--   proxy[move]   a strike another body carries out: `move` with a free
	--                 `body` of that kind; with none, a route that may `summon`
	--                 one pays its cost; in the awakening its `awake` form;
	--                 otherwise `solo`. Attacks[move].proxy: where it stands.
	-- The third hit comes from a clone already out, from behind the opponent
	-- (no clone: his own push kick). Toward: the Uzumaki Barrage (a clone
	-- kicks the body up under it, two more keep it there; E, then heavy in the
	-- air is NARUTO RENDAN). Away: a tackle into the legs (his own). Sideways:
	-- a clone strikes from the flank the stick points at, the string goes on.
	Legion={
		routes={up="UzumakiKick",down="Tackle",side="MirrorClone",airUp="AirDrive",airDown="AirSpike",airSide="AirSwitch"},
		disengage="Kunai",
		onRoute={UzumakiKick="uzumaki"},
		heavyAfterOne="Headbutt",
		-- Out of a full run, the heavy: he dives head first into the body.
		runStrike="HeadDive",
		-- The air string's heavy: two clones drive the body down (Legion.airDrive).
		airCloneDrive=true,
		stringCancels={CloneRasengan=true},
		blockCancels={},
		proxy={
			Light3={move="CloneKick",body="clone"},
			UzumakiKick={move="UzumakiKick",body="clone",summon=true,solo="Launcher",awake="ClawRise"},
			MirrorClone={move="MirrorClone",body="clone",summon=true,solo="Light2",awake="ClawSwipe"},
		},
		-- (É7: his strikes hit at × 0.82 now; his signature finisher keeps its weight)
		airFinisher={name="NarutoRendan",cue="NARUTO UZUMAKI RENDAN",event="NarutoRendan",damage=21,impulse=Vector3.new(0,-92,8)},
		-- Unpredictable: a quick re-entry on an angle whose side does not simply
		-- alternate (shuffle), and a clone out on a flank rushes the other side.
		reengage={name="legion",speed=1.2,arrive=3.2,angle=30,shuffle=true,chase=.28,recovery=.22},
	},
	-- Temari (roster wave): the fan strikes make distance. Toward after two
	-- hits: the Updraft, a scoop into a column of rising air (onRoute "updraft",
	-- Gale.updraft): the body comes down slowly, in reach of the wind, not of a
	-- chase. Away: the closed fan slammed down. Sideways after one: a full turn,
	-- the gust throws the body aside (Attacks lateral). In the air, the drive
	-- and the Fan Dive; no switch (she does not vault over anyone).
	--   reengage.reposition  the wind step (Gale.reposition): E outside a chase
	--                        window takes her back to `keep` studs (out at an
	--                        `angle` when close, in when far, aside at range),
	--                        never into melee.
	Gale={
		routes={up="Updraft",down="FanSlam",side="FanPirouette",airUp="AirDrive",airDown="FanDive"},
		onRoute={Updraft="updraft"},
		heavyAfterOne="FanBackhand",
		stringCancels={Kamaitachi=true},
		blockCancels={Tool=true},
		reengage={name="gale",reposition=true,keep=17,speed=1.0,reach=22,angle=30,side=10,chase=.26,recovery=.16},
	},
	-- Roster 20 breadth pass (Tier A on the shared grammar).
	Lavender={
		routes={up="Launcher",down="Sweep",side="CircleStep",airUp="AirDrive",airDown="AirSpike",airSide="AirSwitch"},
		disengage="Kunai",
		onRoute={Sweep="tenketsu",AirSpike="tenketsu"},
		heavyAfterOne="PalmThrust",
		stringCancels={VacuumPalm=true},
		blockCancels={},
		-- Gentle and close: down the line, slower than Neji, from very near.
		reengage={name="palm",speed=.95,arrive=2.8,angle=0,minRange=5,chase=.3,recovery=.2},
	},
	Copycat={
		routes={up="Launcher",down="Sweep",side="FeintStep",airUp="AirDrive",airDown="AirSpike",airSide="AirSwitch"},
		disengage="Kunai",
		heavyAfterOne="KneeStrike",
		stringCancels={LightningBlade=true},
		blockCancels={Tool=true},
		-- Measured: a quick re-entry a little off the line.
		reengage={name="copy",speed=1.1,arrive=3.2,angle=20,chase=.28,recovery=.2},
	},
}
-- Roster 20 batches keep their move graphs in their own data modules.
for _,wave in {require(script.Parent.Wave1),require(script.Parent.Wave2),require(script.Parent.Wave3),require(script.Parent.Wave4)} do
	for id,graph in wave.graphs or {} do Graphs[id]=graph end
end
return Graphs
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND20">
        <Properties>
          <string name="Name">OnlineProtocol</string>
          <ProtectedString name="Source">-- Online 1v1 (NET-001): shared tunables and the request vocabulary of the
-- online flow. Authority stays in Server/Online and Server/Matches; nothing in
-- here is ever read back from a client.
return table.freeze({
	-- Seconds both players get to confirm (or change) their fighter once paired;
	-- the duel starts when both confirm or when the time runs out.
	PickTime=15,
	-- Private duel codes: short, upper case, no look-alike characters (0/O, 1/I/L).
	CodeLength=5,
	CodeAlphabet="ABCDEFGHJKMNPQRSTUVWXYZ23456789",
	-- Minimum gap between two lobby requests of one player (same as the local duel).
	LifecycleGap=0.8,
	-- Requests that enter or leave the online flow from the roster / waiting screen.
	Lifecycle=table.freeze({Queue=true,Host=true,Join=true,Cancel=true}),
	-- The only requests an online fighter may send during a fight. Anything else
	-- is ignored before it reaches Combat.
	Combat=table.freeze({Move=true,Arm=true,ChakraLoad=true,Attack=true,Heavy=true,Jump=true,JumpOff=true,Dodge=true,Guard=true,GuardOff=true,
		Grab=true,Tool=true,Pursuit=true,Substitute=true,Feint=true,WallDetach=true,Ultimate=true,Awaken=true,
		Technique1=true,Technique2=true,Technique3=true,Technique4=true,Technique5=true,SealRelease=true,PadJump=true,Seals=true,
		Seal1=true,Seal2=true,Seal3=true,Seal4=true,Seal5=true}),
})
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND21">
        <Properties>
          <string name="Name">ReactionSides</string>
          <ProtectedString name="Source">-- Back and side reaction clips. Feel audit of 07/11, M3 "victimes retournées
-- d'un coup" (docs/reports/feel-audit-2026-11-07/AUDIT.md).
--
-- The CLIENT picks them by itself as soon as they exist (Client/
-- VelmoraMotionEngine, authoredReaction: from the hit's angle, the back clip
-- for a blow from behind, the side clip for one from the side, the frontal one
-- otherwise or while the variant is missing). Nothing to switch on. Throws
-- are shared reactions (AuthoredMotion borrows Sasuke's when a fighter has
-- none of his own), so since PR #58 every fighter gets their back and side
-- variants; a hold is each fighter's own.
--
-- The SERVER only has to know for a hold: until the held body has its own back
-- and side clips, it is hauled round to face the grabber (Brawler, GRAB_TURN,
-- ~0.2 s). Grabbed lists the fighters whose hold has them (Grabbed,
-- Grabbed.Back, Grabbed.Side; the ANIMATEUR adds a fighter when he delivers
-- them, tests/ReactionSides.spec checks each one); a listed held body keeps
-- its facing.
--
-- Clips per fighter F (".L" = the other side, optional; mirrored otherwise):
--   HitStun   F.Hit.Back, F.Hit.Side             in since ANIM-005
--   Launched  F.Launched.Back, F.Launched.Side   (also played for Juggled)
--   Knockback F.Knockback.Back, F.Knockback.Side
--   Grabbed   F.Grabbed (front), F.Grabbed.Back, F.Grabbed.Side
local ReactionSides={
	-- (12/11, ANIMATEUR PR #58) the 8 fighters of the beta.
	Grabbed={Copycat=true,Flashstep=true,GentleFist=true,Leaf=true,Legion=true,Lion=true,Mirage=true,Sand=true},
}
ReactionSides.Clips={
	HitStun={"Hit.Back","Hit.Side"},
	Launched={"Launched.Back","Launched.Side"},
	Knockback={"Knockback.Back","Knockback.Side"},
	Grabbed={"Grabbed.Back","Grabbed.Side"},
}
-- A held body of this fighter keeps its facing (its hold has back/side clips).
function ReactionSides.keepsFacing(kind,fighterId)
	local set=ReactionSides[kind]
	return type(set)=="table" and set[fighterId]==true
end
return ReactionSides
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND22">
        <Properties>
          <string name="Name">Roster</string>
          <ProtectedString name="Source">-- The playable roster, in menu order: the select screen, the AI soaks and the
-- roster-wide Tier A suite (tests/Roster.spec.luau) all read this list. A
-- fighter is listed only once it is selectable and plays (Tier A in
-- docs/characters/ROSTER_20.md); Fighters may hold a definition before that.
-- DEC-026 target roster (17 kept + 3 newcomers). Hinata (Lavender), Temari
-- (Gale) and Kabuto (Medic) leave the menu; their code and suites stay.
return {
	-- CORE4 (the first prototypes).
	"Flashstep","Mirage","GentleFist","Lion",
	-- The stress-test wave (DEC-015).
	"Sand","Leaf",
	-- Roster 20 breadth pass.
	"Legion","Copycat",
	"Mirror","Mist","Bone",
	"Flicker","Serpent",
	"Clay","Puppet","Rinnegan","Ink",
	-- DEC-026 newcomers: Madara, Hashirama, Hiruzen as children (Shared/Wave4).
	"Rival","Sapling","Professor",
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND23">
        <Properties>
          <string name="Name">RosterMoves</string>
          <ProtectedString name="Source">-- Roster 20 batches (Shared/WaveN): a fighter's own strike, added to Attacks
-- with the fields every strike carries (Animation.spec: side/twist/lean/arm/
-- step; Combat: animation/feedback/chain/air/depth/offset), so a batch only
-- writes its timing and its shape.
--   timing  {startup, active, recovery, damage, travel, reaction, impulse, stun}
--   shape   reach, body and tags (range, contact, width, height, zone, kind,
--           chain, air, lateral, orbit, riders, breaksShield...)
-- A new strike has no clip of its own: the fighter's Motion.borrow names the
-- clip it plays (VelmoraMotionEngine), otherwise its family's Light1.
local RosterMoves={}
function RosterMoves.add(move,attacks,list)
	for name,entry in list do
		assert(not attacks[name],"strike "..name.." already exists")
		local m=move(table.unpack(entry[1]))
		m.animation=name;m.feedback=m.reaction;m.chain=false;m.air=false
		m.side=1;m.twist=30;m.lean=10;m.arm=90;m.step=1.1
		m.zone="body";m.kind="strike"
		for key,value in entry[2] do m[key]=value end
		m.depth=entry[2].depth or m.range*.8
		m.offset=entry[2].offset or m.range*.4
		attacks[name]=m
	end
end
return RosterMoves
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND24">
        <Properties>
          <string name="Name">RosterStaging</string>
          <ProtectedString name="Source">-- DEC-026 newcomers (Madara, Hashirama, Hiruzen as children, Shared/Wave4).
-- In the menu since the 17+3 migration (Shared/Roster); this list stays the
-- set the native gate (Server/DevGateCheck, group NEW) runs its body checks on.
return {"Rival","Sapling","Professor"}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND25">
        <Properties>
          <string name="Name">Rules</string>
          <ProtectedString name="Source">-- Pure policy shared by server combat and headless tests. Authority lives on server.
local Rules = {}
local free = { Neutral = true, Guarding = true }
function Rules.finite(n)
	return type(n) == "number" and n == n and math.abs(n) &lt; 1e6
end
function Rules.canAct(a, now)
	return a.health &gt; 0 and free[a.state] == true and now &gt;= (a.lockUntil or 0)
end
-- `why`: the refusal a technique's own check gave (its second return value).
function Rules.technique(a, spec, now, prerequisites, why)
	if not Rules.canAct(a, now) then return false, "Committed" end
	if (a.cooldowns[spec.Id] or 0) &gt; now then return false, "Cooldown" end
	if a.chakra &lt; spec.Cost then return false, "Need chakra" end
	if not prerequisites then return false, why or "Condition missing" end
	return true
end
function Rules.reserve(a, spec, now)
	a.chakra -= spec.Cost
	a.cooldowns[spec.Id] = now + spec.Cooldown
	a.state = "TechniqueChannel"
	a.untilTime = now + spec.Channel
end
function Rules.consumeToken(bucket, now, rate, burst)
	bucket.tokens = math.min(burst, bucket.tokens + math.max(0, now - bucket.time) * rate)
	bucket.time = now
	if bucket.tokens &lt; 1 then return false end
	bucket.tokens -= 1
	return true
end
function Rules.interruptible(a)
	return a.state == "TechniqueChannel" and a.pending ~= nil and a.pending.spec.Interruptible == true
end
function Rules.isGuard(a, frontal)
	return a.state == "Guarding" and frontal and a.chakra &gt; 0
end
return Rules
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND26">
        <Properties>
          <string name="Name">SealJutsu</string>
          <ProtectedString name="Source">-- Hand-seal jutsu (DEC-032 §3, user 03/11: « plus de variété que 4 cases
-- comme Storm » ; « Kakashi jeune est un expert du Doton, Gaara a du sable de
-- partout et devrait pouvoir faire ce qu'il veut avec, Naruto a la
-- métamorphose »). Beyond the four quick slots, each prodigy weaves two seals
-- to call a technique of his story (Combat:seal). The seals are the four jutsu
-- buttons: keyboard C (off a wall) then two of 1-4; pad R1 + L3 then two of
-- R1 + □ △ ○ ×. The jutsu goes on the second seal.
--
-- The same four sequences for everyone, so a player learns them once:
--   1-2  TIGER, SNAKE      2-3  SNAKE, RAM      3-4  RAM, RAT      4-1  RAT, TIGER
-- (Gaara has a fifth: 3-1, RAM, TIGER.)
-- Every entry is an ordinary technique spec run by its Family (Server/
-- Families) with its Looks kind (Shared/Looks); Signs is its sequence.
local SealJutsu={}
SealJutsu.Names={"TIGER","SNAKE","RAM","RAT"}
SealJutsu.Glyphs={"寅","巳","未","子"}
SealJutsu.Length=2

SealJutsu.Lion={ -- Sasuke, 12: the Uchiha's fire, the Sharingan, shuriken at every angle
	{ Id = "Soshuha", Name = "Sōshūha: Wired Shuriken", Signs = {1,2}, Family = "Projectile", Kind = "windmill", Cost = 12, Channel = 0.16, Active = 0.04, Recovery = 0.24, Cooldown = 6, Interruptible = true,
		Range = 34, Speed = 92, Damage = 4, Count = 2, Spread = 0.9, Radius = .7, Return = true,
