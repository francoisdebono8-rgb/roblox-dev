	self.resultTitle=text(resultBox,"",UDim2.fromOffset(30,18),UDim2.fromOffset(540,70),72,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
	inkTitle(self.resultTitle)
	self.resultName=text(resultBox,"",UDim2.fromOffset(30,92),UDim2.fromOffset(540,36),30,palette.gold,TITLE_FONT,Enum.TextXAlignment.Center)
	self.resultNote=text(resultBox,"",UDim2.fromOffset(30,132),UDim2.fromOffset(540,44),15,palette.muted,BODY_FONT,Enum.TextXAlignment.Center)
	-- In a tournament the card continues the bracket instead of a rematch.
	self.rematchButton=button(resultBox,"REMATCH",UDim2.fromOffset(30,196),UDim2.fromOffset(540,52),function() send(if self.inCup then "CupBracket" else "Rematch") end,palette.red)
	self.rosterButton=button(resultBox,"RETURN TO THE ROSTER",UDim2.fromOffset(30,260),UDim2.fromOffset(540,52),function() send(if self.inCup then "CupLeave" else "Selection") end)
	-- ------------------------------------------------------------ controls
	-- (User 03/11: "the keys should be in a menu rather than on the screen
	-- all the time".) TAB (pad: START) opens the controls sheet over any
	-- screen: the moves grouped by what they are for, then the fighter's own
	-- strings and jutsu. A small chip on the HUD and a button on the roster say
	-- where it is; nothing else lists keys during a fight.
	self.controls=frame(self.gui,UDim2.fromScale(0,0),UDim2.fromScale(1,1),Color3.fromRGB(6,5,8),.25)
	-- (UI review 04/11, finding 11) over the bracket (40-52) and the players
	-- list (70), under an invitation (80).
	self.controls.ZIndex=75;self.controls.Visible=false
	-- (Audit 04/11) the sheet takes the clicks (they went through to the roster).
	self.controls.Active=true
	local sheet=inkCard(frame(self.controls,UDim2.fromScale(.5,.5),UDim2.fromOffset(1120,640),CARD,0))
	sheet.AnchorPoint=Vector2.new(.5,.5);sheet.ZIndex=76
	local sheetScale=create("UIScale",sheet,{Scale=1})
	local function fitSheet() local v=workspace.CurrentCamera.ViewportSize;sheetScale.Scale=math.clamp(math.min(v.X/1220,v.Y/720),.5,1.2) end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fitSheet);fitSheet()
	local sheetTitle=text(sheet,"CONTROLS",UDim2.fromOffset(36,20),UDim2.fromOffset(600,52),48,palette.paper,TITLE_FONT)
	sheetTitle.ZIndex=42
	self.controlsClose=text(sheet,"",UDim2.fromOffset(1120-900,30),UDim2.fromOffset(400,30),16,palette.muted,BODY_FONT,Enum.TextXAlignment.Right)
	self.controlsClose.ZIndex=77
	-- (UI review 04/11, finding 1) a phone had no TAB: the sheet could not be
	-- closed. A real button, which the pad's focus takes when the sheet opens.
	self.controlsCloseButton=button(sheet,"CLOSE",UDim2.fromOffset(1120-236,14),UDim2.fromOffset(200,64),function() if self.controls.Visible then self:toggleControls() end end,palette.red)
	self.controlsCloseButton.ZIndex=78
	-- (B1 lot 3, B0 defect 8) EFFECTS FULL / LOW: fewer particles, no screen
	-- tint, a calmer lens (lighter phones; a duel judged with and without).
	self.effectsButton=button(sheet,"EFFECTS: FULL",UDim2.fromOffset(1120-476,14),UDim2.fromOffset(228,64),function()
		local low=not (FXKit and FXKit.calm)
		if FXKit then FXKit.setLow(low) end
		self.effectsButton.Text=if low then "EFFECTS: LOW" else "EFFECTS: FULL"
		if self.onEffects then self.onEffects(low) end
	end)
	self.effectsButton.ZIndex=78;self.effectsButton.TextSize=22
	frame(sheet,UDim2.fromOffset(36,78),UDim2.fromOffset(1048,3),palette.red,0).ZIndex=42
	self.controlsBody=frame(sheet,UDim2.fromOffset(36,96),UDim2.fromOffset(1048,520),palette.ink,1)
	self.controlsBody.ZIndex=42
	-- The HUD chip that says where the sheet is.
	self.controlsChip=text(self.hud,"",UDim2.new(0,24,1,-48),UDim2.fromOffset(260,26),15,palette.paper,TITLE_FONT)
	self.controlsChip.BackgroundColor3=Color3.fromRGB(16,14,19);self.controlsChip.BackgroundTransparency=.25;corner(self.controlsChip,6)
	create("UIPadding",self.controlsChip,{PaddingLeft=UDim.new(0,10)})
	pcall(function()
		UIS.InputBegan:Connect(function(input,processed)
			if processed then return end
			if input.KeyCode==Enum.KeyCode.Tab or input.KeyCode==Enum.KeyCode.ButtonStart then self:toggleControls() end
		end)
	end)
	-- ---------------------------------------------------------------- wipe
	-- Between screens an ink brush stroke sweeps across (UI:wipe), the same
	-- angle as the menu's stroke, its leading edge vermilion.
	self.wipe=frame(self.gui,UDim2.fromScale(-1.6,.5),UDim2.fromScale(1.6,3),Color3.fromRGB(10,9,12),0)
	self.wipe.AnchorPoint=Vector2.new(.5,.5);self.wipe.Rotation=-9;self.wipe.ZIndex=60;self.wipe.Visible=false
	local edge=frame(self.wipe,UDim2.new(1,-10,0,0),UDim2.new(0,14,1,0),palette.red,0);edge.ZIndex=61
	-- ---------------------------------------------------------- online queue
	self.queue=frame(self.gui,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.ink,.25)
	local queueBox=inkCard(frame(self.queue,UDim2.new(.5,-300,.5,-150),UDim2.fromOffset(600,300),CARD,0))
	self.queueTitle=text(queueBox,"",UDim2.fromOffset(30,18),UDim2.fromOffset(540,56),48,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
	inkTitle(self.queueTitle)
	self.queueCode=text(queueBox,"",UDim2.fromOffset(30,80),UDim2.fromOffset(540,70),72,palette.gold,TITLE_FONT,Enum.TextXAlignment.Center)
	self.queueNote=text(queueBox,"",UDim2.fromOffset(30,154),UDim2.fromOffset(540,44),15,palette.muted,BODY_FONT,Enum.TextXAlignment.Center)
	self.cancelButton=button(queueBox,"CANCEL",UDim2.fromOffset(30,222),UDim2.fromOffset(540,52),function() send("Cancel") end)
	self.queue.Visible=false
	-- The genjutsu image carries no label: the world shows it (Presentation:illusion).
	-- (UI review 04/11, finding 7; seen in Studio v37) at the centre (84) it hid
	-- the inner ends of both health bars, under them (160) the partner's head:
	-- on the left, under the player's own plate, the middle stays the fight's.
	self.tutorialPanel=inkCard(frame(self.hud,UDim2.new(0,24,0,170),UDim2.fromOffset(520,90),CARD,0),10)
	self.tutorialTitle=text(self.tutorialPanel,"",UDim2.fromOffset(16,9),UDim2.fromOffset(490,30),24,palette.paper,TITLE_FONT)
	self.tutorialPrompt=text(self.tutorialPanel,"",UDim2.fromOffset(16,40),UDim2.fromOffset(490,40),14,palette.muted)
	GuiService.AutoSelectGuiEnabled=true
	-- HUD scale follows the viewport so plates and slots never leave the screen.
	local function fitHud()
		local size=workspace.CurrentCamera.ViewportSize
		local s=math.clamp(math.min(size.X/1500,size.Y/860),.55,1.25)
		-- Studio capture aid (see Camera): shrink the HUD into the visible region.
		if game:GetService("RunService"):IsStudio() and workspace:GetAttribute("NinjaDuelCaptureShift") then s*=.66 end
		hudScale.Scale=s
		-- A UIScale also shrinks the frame it scales: size the HUD up by the
		-- same factor so its bottom row sits at the bottom of the screen (the
		-- slots and help used to float mid-screen on a small viewport).
		self.hud.Size=UDim2.fromScale(1/s,1/s)
		-- (Studio 03/11) The player's plate starts after Roblox's own buttons
		-- in the top-left corner (they covered his medallion and name).
		local inset=0
		pcall(function() inset=GuiService.TopbarInset.Min.X end)
		if self.hp and self.hp.box then self.hp.box.Position=UDim2.fromOffset(math.max(20,(inset+8)/s),16) end
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fitHud);fitHud()
	pcall(function() GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(fitHud) end)
	self:refreshSelection(); self:render({phase="Selection"})
	return self
end
function UI:refreshSelection()
	-- During an online pick the right stage shows the opponent's live choice.
	local other=if self.picking and Fighters[self.opponentPick or ""] then self.opponentPick else self.bot
	if self.picking then self.side="player" end
	for id,t in self.tablets or {} do
		t.mine,t.theirs=id==self.player,id==other
		local picked=t.mine or t.theirs
		t.edge.Color=if t.mine then palette.red elseif t.theirs then palette.paper else t.accent
		t.edge.Thickness=if picked then 3 else 1.5
		t.edge.Transparency=if picked then 0 else .45
		t.seal.Text=if t.mine and t.theirs then "YOU • CPU" elseif t.mine then "YOU" elseif t.theirs then (if self.picking then "P2" else "CPU") else ""
		t.seal.BackgroundColor3=if t.mine then palette.red else palette.paper
		t.seal.TextColor3=if t.mine then palette.paper else palette.ink
		t.seal.BackgroundTransparency=if picked then 0 else 1
		t.tablet.BackgroundColor3=if picked then Color3.fromRGB(44,38,48) else Color3.fromRGB(22,19,25)
		self:liftTablet(t)
	end
	local p,o=Fighters[self.player],Fighters[other]
	for side,id in {player=self.player,bot=other} do
		local st=self.stages and self.stages[side]
		local def=Fighters[id]
		if st and def then
			st.name.Text=Text.upper(def.FullName or def.Name)
			st.name.TextColor3=accentOf(def):Lerp(palette.paper,.3)
			st.sub.Text=string.format("AGE %d  •  %s",def.Age or 13,Text.upper(def.Title or ""))
			st.note.Text=def.Description or ""
			st.choosing.Visible=self.side==side and not self.picking
			local accent=accentOf(def)
			st.underline.BackgroundColor3=accent
			st.tag.BackgroundColor3=if self.side==side and not self.picking then palette.gold else palette.paper
			local model=self.portraits and self.portraits:FindFirstChild(id)
			if model and st.shown~=id and #model:GetDescendants()&gt;=(model:GetAttribute("Descendants") or 0) then
				local first=st.shown==nil
				st.shown=id
				if self.menuStage then pcall(self.menuStage.show,self.menuStage,side,model,accent,not first) end
				if not first then self:enterStage(st) end
			end
		end
	end
	self.matchup.Text=Text.upper((p.Name).."  VS  "..(o.Name))
	self.routeNote.Text=if p.Routes then Text.upper(p.Name).." STRINGS  "..Controls.localize(p.Routes) else ""
end
-- The controls sheet: opened over any screen, built for the device in hand
-- and the fighter being played.
local GROUPS={
	{"MOVE",{{"Move","WASD","L stick"},{"Sprint","Sprint"},{"Jump","Jump"},{"Lock / unlock","Lock"},{"Wall run: into a wall","—","—"},{"Off the wall","WallDetach"}}},
	{"ATTACK",{{"Light strike (string)","Light"},{"Heavy strike","Heavy"},{"Grab, then throw","Grab"},{"Tool","Tool"},{"Kunai: draw / sheathe","Arm"},{"Chase / chakra dash","Pursuit"}}},
	{"DEFEND",{{"Guard (hold)","Guard"},{"Dodge","Dodge"},{"Escape when hit (substitution)","Substitute"},{"Feint a heavy","Feint"},{"Break a grab","Grab"}}},
	{"NINJA ARTS",{{"Jutsu 1-4","1  2  3  4","R1 + □ △ ○ ×"},{"Seal jutsu (hold the 2nd page)","hold C + 1-5","hold L2 + R1 + □△○× / D↑"},{"Jutsu 5","Technique5"},{"Chakra-infuse (hold + action)","Chakra"},{"Awaken (low health)","Awaken"},{"Ultimate (bar full)","Ultimate"}}},
}
function UI:buildControls(pad)
	local body=self.controlsBody
	body:ClearAllChildren()
	local K,P=Controls.KeyLabel,Controls.PadLabel
	local function key(entry)
		if entry[3] then return if pad then entry[3] else entry[2] end
		local label=if pad then P[entry[2]] else K[entry[2]]
		return label or entry[2]
	end
	for g,group in GROUPS do
		local x=(g-1)%2*530;local y=math.floor((g-1)/2)*200
		local head=text(body,group[1],UDim2.fromOffset(x,y),UDim2.fromOffset(500,28),24,palette.gold,TITLE_FONT);head.ZIndex=43
		for r,entry in group[2] do
			local row=y+30+(r-1)*27
			local chip=text(body,key(entry),UDim2.fromOffset(x,row),UDim2.fromOffset(150,23),15,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
			chip.BackgroundColor3=palette.red;chip.BackgroundTransparency=.1;chip.ZIndex=43;corner(chip,4)
			chip.TextScaled=true;create("UITextSizeConstraint",chip,{MaxTextSize=15})
			local label=text(body,entry[1],UDim2.fromOffset(x+162,row),UDim2.fromOffset(350,23),15,palette.text,BODY_FONT);label.ZIndex=43
		end
	end
	-- The fighter in play (on the roster: the one picked): his strings, his jutsu.
	local h=self.lastHuman
	-- (Audit 04/11) his own fighter: in his own duel the one he plays, else
	-- the one picked (a watched match or the bracket showed someone else's).
	local own=h~=nil and not self.lastSpectate and (self.lastPhaseSeen=="Duel" or self.lastPhaseSeen=="Result")
	local id=if self.selection.Visible or not own then self.player else h.fighterId
	local def=Fighters[id or ""]
	local y=410
	local head=text(body,if def then Text.upper(def.FullName or def.Name) else "YOUR FIGHTER",UDim2.fromOffset(0,y),UDim2.fromOffset(1048,28),24,palette.gold,TITLE_FONT);head.ZIndex=43
	local combo=Controls.comboHelp(MoveGraphs[id or ""] or {},pad)
	local strings=text(body,combo,UDim2.fromOffset(0,y+32),UDim2.fromOffset(1048,40),15,palette.text,BODY_FONT);strings.ZIndex=43
	if def and def.Techniques then
		local names={}
		for i,spec in def.Techniques do if i&lt;=5 then table.insert(names,(if pad then Controls.TechniquePad[i] else tostring(i)).."  "..Text.upper(spec.Name or spec.Id or "")) end end
		local jutsu=text(body,table.concat(names,"     "),UDim2.fromOffset(0,y+78),UDim2.fromOffset(1048,22),15,palette.paper,TITLE_FONT);jutsu.ZIndex=43
		jutsu.TextScaled=true;create("UITextSizeConstraint",jutsu,{MaxTextSize=15})
		if def.SealJutsu then
			local key=if pad then {"□","△","○","×","D↑"} else {"1","2","3","4","5"}
			local seals={}
			for i,spec in def.SealJutsu do table.insert(seals,key[i].."  "..Text.upper(spec.Name)) end
			local sealRow=text(body,(if pad then "HOLD L2 + R1  " else "HOLD C  ")..table.concat(seals,"     "),UDim2.fromOffset(0,y+104),UDim2.fromOffset(1048,22),15,palette.gold,BODY_FONT);sealRow.ZIndex=43
			sealRow.TextScaled=true;create("UITextSizeConstraint",sealRow,{MaxTextSize=15})
		end
	end
	self.controlsClose.Text=(if pad then "START" else "TAB").." to close"
end
-- (DEC-032) The seal slip. (04/11, user: « une 2e page de jutsu ») The seal
-- jutsu are a second page of the four jutsu keys: keyboard C held + 1-5, pad
-- L2 + R1 held + □ △ ○ × (D-pad ↑ for a fifth; 05/11: it was R1 + L1, which
-- is the ultimate alone now). The slip lights up while the page is held; the
-- signs themselves are woven by the cast.
local function pageHeld(pad,flag)
	-- (Audit 04/11) The client's own page state (Input:sealPage) when it is
	-- sent; else the pad's L2 + R1 read here.
	if flag~=nil then return flag==true end
	local ok,held=pcall(function()
		if pad then
			local pressed={}
			for _,input in UIS:GetGamepadState(Enum.UserInputType.Gamepad1) do
				if input.UserInputState==Enum.UserInputState.Begin or input.Position.Z&gt;.5 then pressed[input.KeyCode]=true end
			end
			return pressed[Controls.Gamepad.Modifier]==true and pressed[Controls.Gamepad.Chakra]==true
		end
		return UIS:IsKeyDown(Controls.Keyboard.WallDetach)
	end)
	return ok and held==true
end
function UI:sealHud(h,pad,page)
	local def=Fighters[h.fighterId or ""]
	local list=def and def.SealJutsu
	self.sealPanel.Visible=list~=nil
	if not list then self.sealWeave.Text="";return end
	local held=not h.wall and pageHeld(pad,page)
	local key=if pad then {"□","△","○","×","D↑"} else {"1","2","3","4","5"}
	self.sealHead.Text="HAND SEALS  •  "..(if pad then "HOLD L2 + R1" else "HOLD "..(Controls.KeyLabel.WallDetach or "C"))
	self.sealPanel.BackgroundTransparency=if held then .02 else .35
	local sealed=(h.sealed or 0)&gt;0
	for i,row in self.sealRows do
		local spec=list[i]
		row.Visible=spec~=nil
		if spec then
			local state=h.sealReady and h.sealReady[i]
			local remaining=state and state.remaining or 0
			local glyphs={}
			for _,v in spec.Signs do table.insert(glyphs,SealJutsu.Glyphs[v]) end
			local ready=remaining==0 and h.chakra&gt;=spec.Cost and not sealed
			row.Text=key[i].."   "..Text.upper(spec.Name).."  "..table.concat(glyphs,"")..(if remaining&gt;0 then string.format("   %.1fs",remaining) elseif h.chakra&lt;spec.Cost then "   NEED CHAKRA" else "")
			row.TextColor3=if ready and held then palette.gold elseif ready then palette.paper else palette.muted
		end
	end
	self.sealWeave.Text=""
end
function UI:toggleControls()
	local open=not self.controls.Visible
	if open then
		local pad=false
		pcall(function() pad=Controls.isGamepad(UIS:GetLastInputType()) end)
		self:buildControls(pad)
	end
	self.controls.Visible=open
	if open then pcall(function() GuiService.SelectedObject=self.controlsCloseButton end)
	elseif GuiService.SelectedObject==self.controlsCloseButton then pcall(function() GuiService.SelectedObject=nil end) end
end
-- The ink stroke crosses the screen (0.5 s): the new screen is already under
-- it, uncovered by its trailing edge.
function UI:sweep()
	pcall(function()
		local w=self.wipe
		w.Visible=true
		w.Position=UDim2.fromScale(-.9,.5)
		local tween=Tween:Create(w,TweenInfo.new(.55,Enum.EasingStyle.Quint,Enum.EasingDirection.InOut),{Position=UDim2.fromScale(1.9,.5)})
		tween.Completed:Connect(function() w.Visible=false end)
		tween:Play()
	end)
end
-- The result card drops in and the judges' seal is stamped on it.
function UI:stampResult()
	pcall(function()
		self.resultScale.Scale=1.12
		Tween:Create(self.resultScale,TweenInfo.new(.35,Enum.EasingStyle.Back,Enum.EasingDirection.Out,0,false,.2),{Scale=1}):Play()
		self.resultSealScale.Scale=2.6
		Tween:Create(self.resultSealScale,TweenInfo.new(.22,Enum.EasingStyle.Quad,Enum.EasingDirection.In,0,false,.55),{Scale=1}):Play()
	end)
end
-- A roster tile under the pointer rises; a picked one stands higher.
function UI:liftTablet(t)
	local rise=if t.mine or t.theirs then 10 elseif t.hover then 6 else 0
	local ok=pcall(function()
		Tween:Create(t.tablet,TweenInfo.new(.16,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Position=UDim2.fromOffset(t.x,t.y-rise)}):Play()
		Tween:Create(t.seal,TweenInfo.new(.16,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Position=UDim2.fromOffset(t.x+t.w-52,t.y-7-rise)}):Play()
	end)
	if not ok then t.tablet.Position=UDim2.fromOffset(t.x,t.y-rise) end
	t.glow.Size=UDim2.new(0,if t.mine or t.theirs then 10 elseif t.hover then 8 else 6,1,0)
	if t.label then t.label.TextColor3=if t.hover and not (t.mine or t.theirs) then palette.gold else palette.paper end
end
-- A new prodigy steps onto a stage: he slides in from the outer edge out of a
-- white flash, his name lands a beat later.
function UI:enterStage(st)
	pcall(function()
		st.flash.BackgroundTransparency=.55
		Tween:Create(st.flash,TweenInfo.new(.3,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{BackgroundTransparency=1}):Play()
		st.nameScale.Scale=1.3
		Tween:Create(st.nameScale,TweenInfo.new(.3,Enum.EasingStyle.Back,Enum.EasingDirection.Out,0,false,.08),{Scale=1}):Play()
	end)
end
-- A tablet chosen for a stage (side "player" or "bot"). In an online pick
-- your stage is the only one you fill; the other is the opponent's choice.
function UI:pick(side,id)
	if not Fighters[id] or not table.find(Roster,id) then return end
	if self.picking then
		if side=="player" then self:choose(id) end
		return
	end
	if self.simple then side="player";self.side="player" end
	if side=="bot" then self.bot=id
	else
		self.player=id
		if self.simple then self.bot=FirstMinute.rival(id) or self.bot end
		if self.bot==id then
			local roster=Roster
			for i,other in roster do if other==id then self.bot=roster[i%#roster+1] break end end
		end
	end
	self:refreshSelection()
end
-- Online pick: your fighter changes until you confirm; the server echoes it.
function UI:choose(id)
	if self.onlineInfo and self.onlineInfo.ready then return end
	self.player=id;self:refreshSelection();self.send("Pick",{player=id})
end
-- Roster, online waiting screen and online pick (the roster in versus mode).
function UI:lobby(data)
	local online=data.online
	self.picking=data.phase=="Pick" and online~=nil
	if self.picking then
		if Fighters[online.me or ""] then self.player=online.me end
		self.opponentPick=online.them
		self.opponentLabel.Text="OPPONENT  •  "..Text.upper(online.opponent or "")..(if online.theirReady then "  •  READY" else "")
		self.startButton.Text=if online.ready then "READY  •  WAITING FOR OPPONENT" else "READY"
		self.tutorialButton.Text="LEAVE"
		self.notice.Text=string.format("ONLINE 1v1  •  THE DUEL STARTS IN %d s",math.ceil(online.remaining or 0))
	else
		self.opponentPick=nil
		self.opponentLabel.Text=if self.simple then "YOUR RIVAL" else "OPPONENT (AI)"
		self.startButton.Text=if self.simple then "PLAY" else "ENTER THE STAGE"
		self.tutorialButton.Text=if self.simple then "ALL MODES" else "TRAINING"
		self.notice.Text=data.notice or (if self.simple then "PICK YOUR NINJA, THEN PLAY  •  30 SECONDS ON THE FIELD, THEN YOUR FIRST DUEL" else "")
	end
	self.lastLobby=data
	local full=data.phase=="Selection" and not self.simple
	-- the strings' notes are for the full roster (jargon on a first look)
	self.routeNote.Visible=not self.simple
	self.onlineRow.Visible=full
	-- (Audit 04/11) not during the online pick (it did nothing there).
	self.cupButton.Visible=full
	self.levelButton.Visible=full
	if data.phase=="Queue" then
		local private=online~=nil and online.mode=="private"
		self.queueTitle.Text=if private then "PRIVATE DUEL" else "SEARCHING FOR AN OPPONENT"
		self.queueCode.Text=if private then (online.code or "") else ""
		self.queueNote.Text=if private then "Share this code: your friend types it next to JOIN on the roster screen."
			else "Casual 1v1  •  you meet the next player who searches."
		-- (Lobby, 04/11) a challenge: on the way to the duel server, then waiting there.
		local mode=online and online.mode
		if mode=="travel" or mode=="challenge" then
			self.queueTitle.Text=if mode=="travel" then "LEAVING FOR THE DUEL" else "CHALLENGE"
			self.queueCode.Text=""
			self.queueNote.Text=if mode=="travel" then "Both of you are on the way to the same arena…" else "Waiting for your opponent to arrive…"
		end
	end
	self:refreshSelection()
end
local function fullName(actor)
	local def=Fighters[actor.fighterId]
	return Text.upper(def and def.FullName or actor.fighter or "")
end
local function subtitle(actor)
	local def=Fighters[actor.fighterId]
	if not def then return "" end
	return string.format("AGE %d  •  %s",def.Age or 13,def.Title or "")
end
-- Server cues name keyboard keys; a pad player reads the pad button instead
-- (labels from Controls, so the copy cannot drift from the bindings).
function UI.padCue(cue)
	local P=Controls.PadLabel
	cue=cue:gsub("SPACE REBOUND",P.Jump.." REBOUND"):gsub("C DETACH",P.WallDetach.." DETACH")
	cue=cue:gsub("• E ","• "..P.Pursuit.." "):gsub("X TO ESCAPE",P.Substitute.." TO ESCAPE")
	cue=cue:gsub("• 1 = ","• "..Controls.TechniquePad[1].." = ")
	-- (05/11) "SEALED • 2 TO FOLLOW UP": a jutsu key is its pad chord.
	cue=cue:gsub("%f[%w]([1-5]) TO ",function(d) return (Controls.TechniquePad[tonumber(d)] or d).." TO " end)
	-- (Audit 04/11) the keyboard keys the server's cues name, on the pad.
	cue=cue:gsub("%f[%w]E TO ",P.Pursuit.." TO "):gsub("%f[%w]E PURSUE",P.Pursuit.." PURSUE"):gsub("%f[%w]E CHASE",P.Pursuit.." CHASE")
	cue=cue:gsub("%f[%w]Q ON ",P.Dodge.." ON "):gsub("%f[%w]Q TO ",P.Dodge.." TO ")
	cue=cue:gsub("HEAVY: ",P.Heavy..": ")
	return cue
end
-- (FEEL 05/11) The server's refusal reasons, in the player's words.
local QUIET={BUSY="BUSY — STILL IN YOUR MOVE",REACTING="STILL HIT",COOLDOWN="RECHARGING",["NEED CHAKRA"]="NOT ENOUGH CHAKRA",
	["NO TARGET"]="NO TARGET",["OUT OF RANGE"]="TOO FAR",["TOO FAR"]="TOO FAR",["NO LINE OF SIGHT"]="NOT IN SIGHT",
	["TOOL RECOVERING"]="TOOL RECOVERING",["SUBSTITUTION RECOVERING"]="SUBSTITUTION RECHARGING",["NOT YET"]="NOT YET",["TOO SOON"]="TOO SOON",
	["ULTIMATE NOT READY"]="ULTIMATE NOT READY",["NO SUBSTITUTION"]="NO SUBSTITUTION LEFT"}
function UI.quietText(reason)
	return QUIET[reason] or reason
end
-- Whether the cue on screen already tells the player to chase.
function UI.cueNamesChase(cue)
	return type(cue)=="string" and (string.find(cue,"CHASE",1,true)~=nil or string.find(cue,"PURSUE",1,true)~=nil)
end
-- A plate's chakra network (Neji): four pips, lit per closed point (a fresh one
-- pops), shown whenever the opponent fights with the Gentle Fist; the chakra
-- bar dims with the recovery the points cost.
local HYUGA=Color3.fromRGB(190,208,255)
function UI.network(widget,actor,foe)
	local count=#(actor.tenketsuPoints or {})
	if count==0 then count=actor.tenketsu or 0 end
	local shown=(foe and foe.fighterId=="GentleFist") or count&gt;0
	local severe=actor.tenketsuSevere==true
	for k,pip in widget.points do
		pip.Visible=shown
		pip.BackgroundColor3=if k&lt;=count then (if severe then palette.paper else HYUGA) else palette.track
		if k&lt;=count and k&gt;widget.pointsShown then
			pip.Size=UDim2.fromOffset(15,15)
			Tween:Create(pip,TweenInfo.new(.22,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=UDim2.fromOffset(9,9)}):Play()
		end
	end
	widget.pointsShown=count
	local regen=math.clamp(actor.chakraRegen or 1,0,1)
	widget.chakra.BackgroundColor3=if regen&lt;1 then palette.blue:Lerp(Color3.fromRGB(112,118,138),math.min(1,(1-regen)*1.4)) else palette.blue
end
-- What each CORE4 awakening changes in the fight, said while it burns (a
-- fighter without a line here shows its name and time only).
local AWAKENED={
	Flashstep="EACH JUMP LEAVES A RETURN SEAL  •  FLASH ONTO A LAUNCHED BODY",
	GentleFist="NO BLIND SPOT  •  ONE PALM CLOSES TWO POINTS",
	Mirage="HIS GUARD READS  •  A MISS NEAR HIM IS READ",
	Lion="KICKS DO NOT LET GO  •  LAUNCHERS BECOME THE DANCING LEAF",
}
UI.AWAKENED=AWAKENED
function UI.awakening(actor)
	if (actor.awaken or 0)&lt;=0 or (actor.health or 1)&lt;=0 then return "" end
	local def=Fighters[actor.fighterId]
	local name=def and def.Awakening and def.Awakening.Name or "AWAKENED"
	local line=string.format("%s  %.1fs",name,actor.awaken)
	if actor.curseHunger then return line.."  •  HUNGRY: LAND A BLOW" end
	return if AWAKENED[actor.fighterId] then line.."  •  "..AWAKENED[actor.fighterId] else line
end
-- The counter a read, a repel or a caught image opened: named, with the time
-- it stays open (it closes fast; the HUD says how fast).
local COUNTER_NAME={CounterPalm="COUNTER PALM",PalmThrust="TWIN PALM"}
function UI.counterPrompt(h,pad)
	local move=(MoveGraphs[h.fighterId] or {}).readCounter
	local name=COUNTER_NAME[move or ""] or "COUNTER"
	return string.format("%s — %s  %.1fs",if pad then Controls.PadLabel.Light else Controls.KeyLabel.Light,name,h.counter or 0)
end
-- Contextual prompts for a conversion that is open right now (nil: none):
-- after a teleport the arrival strike or Rasengan, after the Dancing Leaf the
-- air finisher.
function UI.conversion(h,pad)
	local light=if pad then Controls.PadLabel.Light else Controls.KeyLabel.Light
	local heavy=if pad then Controls.PadLabel.Heavy else Controls.KeyLabel.Heavy
	if h.flash then
		local line=light.." — ARRIVAL STRIKE  •  "..heavy..(if h.airborne then " — SLAM" else " — LAUNCH")
		for i,tech in h.techniques or {} do
			-- (Stage 6) at 13 the arrival is cashed in with the Lightning Strike.
			local label=if tech.id=="BurstStrike" then "RASENGAN" elseif tech.id=="LightningStrike" then "LIGHTNING STRIKE" else nil
			if label and tech.remaining==0 and h.chakra&gt;=tech.cost and (h.sealed or 0)&lt;=0 then
				line..="  •  "..(if pad then Controls.TechniquePad[i] else tostring(i)).." — "..label
			end
		end
		return line
	end
	if (h.lion or 0)&gt;0 and h.airborne then
		local finisher=(MoveGraphs[h.fighterId] or {}).airFinisher
		return heavy.." — "..(if finisher then finisher.cue else "LION COMBO")
	end
	return nil
end
-- (Stage 6) the ultimate bar on a plate; full, it burns gold and (on the
-- player's own plate) says which buttons fire it.
function UI.ultimate(widget,actor,pad,mine)
	if not widget.ultimate then return end
	local level=math.clamp((actor.ultimate or 0)/100,0,1)
	widget.ultimate.Size=UDim2.fromScale(level,1)
	local ready=actor.ultimateReady==true
	local pulse=.5+.5*math.sin(os.clock()*8)
	widget.ultimate.BackgroundColor3=if ready then Color3.fromRGB(255,190+math.floor(50*pulse),60) else Color3.fromRGB(255,150,40)
	-- (UI pass 02/11) Ready was only a word in the plate's smallest text.
	widget.status.TextColor3=if ready then Color3.fromRGB(255,200,90) else palette.muted
	if ready then
		widget.status.Text..="   •   ULTIMATE READY"..(if mine then " ("..(if pad then Controls.PadLabel.Ultimate else Controls.KeyLabel.Ultimate)..")" else "")
	end
end
function UI:render(data)
	self.lastSpectate=data.spectate==true;self.lastPhaseSeen=data.phase
	local pad=if data.gamepad~=nil then data.gamepad else Controls.isGamepad(UIS:GetLastInputType())
	self.tutorialPanel.Visible=data.tutorial~=nil and data.phase=="Duel"
	-- (User 02/11, tutorial on screen) The cue band (124) and the hint (200)
	-- sat on the tutorial panel (84-174): "SPACE REBOUND / C DETACH" was printed
	-- across the step's own instruction. Under the panel while it shows.
	self.cue.Position=UDim2.new(.5,-300,0,124)
	self.hint.Position=UDim2.new(.5,-260,0,200)
	if data.tutorial then
		self.tutorialTitle.Text=data.tutorial.index.." / "..data.tutorial.total.."  "..data.tutorial.title
		-- (B1; UI review 04/11: a phone was told "WASD" and "BACKSPACE")
		local tut=data.tutorial
		local keys=if data.touch then (tut.touch or tut.pad) elseif pad then tut.pad else Controls.localize(tut.key)
		local skip=if data.touch then "SKIP STEP" elseif pad then "TOUCHPAD" else "BACKSPACE"
		self.tutorialPrompt.Text=keys.."  •  "..skip..(if tut.first then " skips (hold: straight to the duel)" else " skips the step (hold: leave)")
	end
	local introActive=data.phase=="Duel" and (data.intro or 0)&gt;0
	self.onlineInfo=data.online
	self.selection.Visible=data.phase=="Selection" or data.phase=="Pick"; self.hud.Visible=data.phase=="Duel" and not introActive; self.result.Visible=data.phase=="Result"
	self.queue.Visible=data.phase=="Queue"
	if self.screenFx then self.screenFx.Visible=data.phase=="Duel" and not introActive and not (FXKit and FXKit.calm) end
	self.intro.Visible=introActive
	-- Gamepad focus moves only after the matching screen is visible.
	if self.lastPhase~=data.phase then
		-- A change of screen passes under the ink stroke.
		if self.lastPhase~=nil then self:sweep() end
		if data.phase=="Result" then self:stampResult();self.simple=false end
		-- (UI review 04/11) a new screen closes the controls sheet.
		if self.controls.Visible then self:toggleControls() end
		local target=if data.phase=="Selection" or data.phase=="Pick" then self.startButton elseif data.phase=="Result" then self.rematchButton
			elseif data.phase=="Queue" then self.cancelButton else nil
		-- Only a button that is on screen can take the focus (the engine warns
		-- "invalid GuiObject" otherwise): wait the frame the screen appears in.
		local phase=data.phase
		local function shown()
			if not target then return false end
			local node=target
			while node and not node:IsA("LayerCollector") do
				if node:IsA("GuiObject") and not node.Visible then return false end
				node=node.Parent
			end
			-- Laid out too (the very first screen is not, the frame it is made).
			return node~=nil and node:IsA("ScreenGui") and node.Enabled and target.AbsoluteSize.X&gt;0
		end
		task.defer(function()
			for _=1,20 do
				if self.lastPhase~=phase then return end
				local ok,on=pcall(shown)
				if ok and on then pcall(function() GuiService.SelectedObject=target end);return end
				if not target then break end
				task.wait(.1)
			end
			pcall(function() GuiService.SelectedObject=nil end)
		end)
		self.lastPhase=data.phase
	end
	if data.phase~="Duel" and data.phase~="Result" then self:lobby(data);return end
	local h,b=data.human,data.bot
	if not h or not b then return end
	if introActive then
		self.introLeftName.Text=fullName(h);self.introLeftTitle.Text=subtitle(h)
		self.introRightName.Text=fullName(b);self.introRightTitle.Text=subtitle(b)
		self.introLeftName.TextColor3=accentOf(Fighters[h.fighterId]);self.introRightName.TextColor3=accentOf(Fighters[b.fighterId])
		self.introRound.Text="PRODIGY TOURNAMENT  —  ROUND "..(data.round or 1)..(if (data.round or 1)&gt;1 and (data.wins and (data.wins.human==1 and data.wins.bot==1)) then "  •  FINAL ROUND" else "")
		self.introBegin.Text=if data.intro&lt;(Config.IntroBegin or .75) then "始め!  BEGIN" else ""
		if self.introShown~=data.epoch then
			self.introShown=data.epoch
			self.introLeft.Position=UDim2.new(-.5,0,1,-118);self.introRight.Position=UDim2.new(1,0,1,-118)
			Tween:Create(self.introLeft,TweenInfo.new(.45,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Position=UDim2.new(0,0,1,-118)}):Play()
			Tween:Create(self.introRight,TweenInfo.new(.45,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Position=UDim2.new(.5,0,1,-118)}):Play()
		end
		return
	end
	if data.ko and not self.ko.Visible then
		-- The knockout whitens the screen for an instant.
		pcall(function()
			self.koFlash=self.koFlash or frame(self.hud,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.paper,1)
			self.koFlash.ZIndex=0;self.koFlash.BackgroundTransparency=.35
			Tween:Create(self.koFlash,TweenInfo.new(.4,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{BackgroundTransparency=1}):Play()
		end)
		self.ko.TextSize=170
		Tween:Create(self.ko,TweenInfo.new(.35,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{TextSize=120}):Play()
	end
	self.ko.Visible=data.ko==true
	self.round.Text=if data.matchPoint and data.ko then "MATCH" else "ROUND "..(data.round or 1)
	-- (in the tournament, the stage of the bracket under the round)
	self.roundSub.Text=if data.cup and data.cup.next and data.cup.next.roundName then data.cup.next.roundName else "PRODIGY TOURNAMENT"
	-- (a match watched in the tournament: neither fighter is the player)
	self.hp.name.Text=fullName(h);self.hp.title.Text=if data.spectate then "AI  •  "..subtitle(h) else subtitle(h).."  •  YOU"
	self.enemy.name.Text=fullName(b);self.enemy.title.Text=(if data.online then Text.upper(data.online.opponent or "OPPONENT") else "AI").."  •  "..subtitle(b)
	for _,pair in {{self.hp,h},{self.enemy,b}} do
		local widget,actor=pair[1],pair[2]
		-- The fighter's initial in the medallion, his colour on its ring.
		if widget.faceFor~=actor.fighterId and Fighters[actor.fighterId or ""] then
			local def=Fighters[actor.fighterId]
			local accent=accentOf(def)
			widget.faceFor=actor.fighterId
			widget.ring.Color=accent;widget.glow.BackgroundColor3=accent
			widget.initial.Text=string.sub(string.upper(def.Name or "?"),1,1)
		end
		local ratio=math.clamp(actor.health/actor.maxHealth,0,1)
		widget.fill.Size=UDim2.fromScale(ratio,1)
		widget.fill.BackgroundColor3=if ratio&gt;.5 then palette.gold elseif ratio&gt;.25 then Color3.fromRGB(236,134,60) else palette.red
		-- In danger the bar throbs; with the ultimate full the medallion's ring burns.
		local t=os.clock()
		if ratio&lt;=.25 and ratio&gt;0 then widget.fill.BackgroundColor3=palette.red:Lerp(Color3.fromRGB(255,120,110),.5+.5*math.sin(t*9)) end
		if actor.ultimateReady then
			widget.ring.Color=Color3.fromRGB(255,200,80):Lerp(Color3.fromRGB(255,120,40),.5+.5*math.sin(t*6))
			widget.ring.Thickness=4
		elseif Fighters[actor.fighterId or ""] then
			widget.ring.Color=accentOf(Fighters[actor.fighterId]);widget.ring.Thickness=3
		end
		-- (UI pass 02/11) The damage trail was re-tweened every frame with a
		-- 0.25 s delay: each new tween cancelled the last before it started, so
		-- the trail never drained and the lost health stayed drawn as a full
		-- light bar. Started once per change of health.
		if widget.lagTarget~=ratio then
			local healed=ratio&gt;=(widget.lagTarget or 1)
			widget.lagTarget=ratio
			if widget.lagTween and widget.lagTween.Cancel then widget.lagTween:Cancel() end
			if healed then widget.lag.Size=UDim2.fromScale(ratio,1)
			else
				widget.lagTween=Tween:Create(widget.lag,TweenInfo.new(.6,Enum.EasingStyle.Quad,Enum.EasingDirection.In,0,false,.25),{Size=UDim2.fromScale(ratio,1)})
				widget.lagTween:Play()
			end
		end
		widget.chakra.Size=UDim2.fromScale(math.clamp(actor.chakra/actor.maxChakra,0,1),1)
		widget.status.Text=string.format("%d / %d",math.ceil(actor.health),actor.maxHealth)
		UI.ultimate(widget,actor,pad,actor==h and not data.spectate)
		-- Gentle Fist effects on this fighter: the closed points (pips), what
		-- they cost (the chakra bar dims, its recovery is spelled out) and the
		-- jutsu the 64 Palms sealed.
		UI.network(widget,actor,if actor==h then b else h)
		widget.awake.Text=UI.awakening(actor)
		local tone=Fighters[actor.fighterId] and Fighters[actor.fighterId].Awakening and Fighters[actor.fighterId].Awakening.Color
		widget.awake.TextColor3=if tone then Color3.fromRGB(table.unpack(tone)) else palette.gold
		if (actor.sealed or 0)&gt;0 then widget.status.Text..=string.format("   •   JUTSU SEALED %.1fs",actor.sealed)
		elseif (actor.chakraRegen or 1)&lt;1 then widget.status.Text..=string.format("   •   CHAKRA REGEN -%d%%%s",math.floor((1-actor.chakraRegen)*100+.5),if actor.tenketsuSevere then "  •  NETWORK SEALED" else "") end
		-- Naruto: his shadow clones out (a route's own clone is not counted).
		local clones=0
		for _,body in data.bodies or {} do if body.owner==actor.id and body.kind=="clone" and not body.ephemeral then clones+=1 end end
		if clones&gt;0 then widget.status.Text..="   •   CLONES "..clones end
		local won=if actor==h then (data.wins and data.wins.human or 0) else (data.wins and data.wins.bot or 0)
		for k,m in widget.medals do
			m.Visible=(data.roundsToWin or 1)&gt;1 and k&lt;=(data.roundsToWin or 1)
			m.BackgroundColor3=if k&lt;=won then palette.gold else palette.track
		end
		local charges=actor.subCharges or 0
		for k,pip in widget.pips do
			local level=if k&lt;=charges then 1 elseif k==charges+1 and (actor.subRegen or 0)&gt;0 then 1-math.clamp((actor.subRegen or 0)/9,0,1) else 0
			pip.fill.Size=UDim2.fromScale(1,level)
			pip.fill.BackgroundColor3=if k&lt;=charges then palette.paper else palette.muted
		end
	end
	-- Screen grade: the danger edges throb under a quarter of health.
	pcall(function()
		local t=os.clock()
		local ratio=math.clamp(h.health/math.max(h.maxHealth,1),0,1)
		-- (not on a match the player only watches: the danger is no one's)
		self.danger.GroupTransparency=if not data.spectate and ratio&lt;=.25 and ratio&gt;0 then .45+.35*(.5+.5*math.sin(t*5)) else 1
	end)
	-- Combo counters with the damage scale of the next hit.
	for _,pair in {{self.comboMine,b},{self.comboTheirs,h}} do
		local widget,victim=pair[1],pair[2]
		local hits=victim.comboHits or 0
		if hits&gt;=2 then
			local scale=math.max(.35,1-.12*math.max(0,hits-1))
			widget.hits.Text=hits.." HITS"
			-- Paper, then gold, then vermilion as the string grows.
			widget.hits.TextColor3=if hits&gt;=8 then Color3.fromRGB(255,96,80) elseif hits&gt;=5 then palette.gold else palette.paper
			widget.hits.Rotation=-4
			widget.detail.Text=string.format("%d DMG  •  NEXT x%.2f",math.floor((victim.comboDamage or 0)+.5),scale)
			widget.box.Visible=true
			if hits~=widget.shown then
				widget.shown=hits
				widget.hits.TextSize=64
				Tween:Create(widget.hits,TweenInfo.new(.18,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{TextSize=54}):Play()
			end
		else
			widget.box.Visible=false;widget.shown=0
		end
	end
	self.statusLine.Text=string.format("STAMINA %d   •   SUBSTITUTION %d   •   %s   •   %s",math.floor(h.stamina or 100),h.subCharges or 0,
		if h.wall then "WALL RUN" elseif h.dodge&gt;0 then string.format("DASH %.1fs",h.dodge) else "DASH READY",
		-- Global kunai (DEC-030): whether a blade is drawn, and how to use it.
		(function()
			local weapon=Fighters[h.fighterId or ""] and Fighters[h.fighterId].Weapon
			local arm=if pad then Controls.PadLabel.Arm else Controls.KeyLabel.Arm
			local tool=if pad then Controls.PadLabel.Tool else Controls.KeyLabel.Tool
			if weapon then return if h.armed then weapon.Name.." DRAWN ("..arm.." sheathes it)" else arm..": draw "..string.lower(weapon.Name) end
			return if h.armed then "KUNAI DRAWN ("..tool.." throws it)" else arm..": draw kunai"
		end)())
	-- Only decisive moments speak; routine cues stay silent.
	-- (05/11) The server writes its cues with QWERTY keys: a pad reads the
	-- pad's buttons (UI.padCue), a keyboard its own letters. The two used to
	-- stack on a French Mac with a pad: "Q TO ESCAPE" became "A TO ESCAPE"
	-- before the pad's translation could find it.
	local cue=h.cue or ""
	local loud=cue:find("READ") or cue:find("PARRY") or cue:find("PERFECT") or cue:find("FLYING THUNDER") or cue:find("GUARD BREAK") or cue:find("WALL ")
		or cue:find("CLASH") or cue:find("SUBSTITUTION •") or cue:find("SEAL") or cue:find("COMBO LIMIT") or cue:find("GENJUTSU")
		or cue:find("PALMS") or cue:find("ROTATION") or cue:find("BYAKUGAN") or cue:find("SHARINGAN")
		or cue:find("FLOW") or cue:find("AWAKEN") or cue:find("THROW BREAK") or cue:find("KNOCK AWAY") or cue:find("RIPOSTE")
		-- Caught in wire or sand: the way out must be on screen.
		or cue:find("WIRED") or cue:find("BOUND")
		-- Sasuke's (and Lee's) continuations and risks must be read too: the
		-- Dancing Leaf, the Lion Combo, the curse, a Chidori and its miss.
		or cue:find("DANCING LEAF") or cue:find("LION") or cue:find("CURSE") or cue:find("CHIDORI") or cue:find("PUNISH") or cue:find("LOTUS")
		-- Naruto's clones (made, broken, swapped) and the barrage's instruction.
		or cue:find("CLONE") or cue:find("U-ZU-MA-KI")
		-- (05/11) how to get out of a blow (Combat.escapeOpen)
		or cue:find("TO ESCAPE")
		-- (06/11, Studio) the jutsu that meet (Interactions) and the steps of an
		-- awakening said nothing: steam, the water carrying lightning, the fire
		-- running the wire, Lee's gates, a summoning, a body switch.
		or cue:find("STEAM") or cue:find("WATER") or cue:find("SOAKED") or cue:find("DRAGON FLAME")
		or cue:find("GATE") or cue:find("SUMMONING") or cue:find("BODY SWITCH")
	cue=if pad then UI.padCue(cue) else Controls.localize(cue)
	self.cue.Text=if loud then cue else ""
	-- (FEEL 05/11, AVANT defect 3) The quiet line: why the last button did
	-- nothing (the server's own reason, Combat:quiet), small and grey under the
	-- band, gone in half a second. Never over a loud cue.
	self.channel.Text=if h.quiet and not loud then UI.quietText(h.quiet) else ""
	-- (05/11, user on the pad: L2 pressed alone 26 times) The chakra button
	-- held: the row shows what it infuses, the fighter's own moves.
	local chakraPage=data.chakraPage==true and not data.first and not data.touch and not data.spectate
	local K0,P0=Controls.KeyLabel,Controls.PadLabel
	if chakraPage then
		local keys=if pad then {P0.Light,P0.Heavy,P0.Jump,P0.Dodge,P0.Tool} else {K0.Light,K0.Heavy,K0.Jump,K0.Dodge,K0.Tool}
		for i,slot in ChakraMoves.Slots do
			local ui=self.techniqueButtons[i]
			ui.box.Visible=true;ui.box.Position=UDim2.new(1,-24-(5-i+1)*150+6,1,-84)
			ui.key.Text=keys[i];ui.key.TextColor3=palette.gold
			ui.title.Text=ChakraMoves.name(h.fighterId,slot);ui.title.TextColor3=palette.gold
			ui.status.Text="CHAKRA";ui.box.BackgroundTransparency=0
			ui.cool.Size=UDim2.fromScale(1,0);ui.wasReady=nil
		end
	end
	for i,tech in (if chakraPage then {} else h.techniques) do
		local ui=self.techniqueButtons[i]
		ui.box.Visible=true
		-- The row ends at the right edge whatever the kit's size.
		ui.box.Position=UDim2.new(1,-24-(#h.techniques-i+1)*150+6,1,-84)
		ui.key.Text=if pad then PAD_FACE[i] else string.format("%d",i)
		-- (QA 12/11: « NARUTO UZUMAKI RENDAN » went small on two lines) the
		-- card takes the jutsu's short name when it has one (Fighters `CardName`).
		ui.title.Text=Text.upper(tech.card or tech.name)
		-- Sealed by the 64 Palms: every jutsu greys out and says why.
		local sealed=(h.sealed or 0)&gt;0
		local ready=tech.remaining==0 and tech.condition and h.chakra&gt;=tech.cost and not sealed
		-- (05/11, "NEEDS A SEAL /" cut in its 150 px box) says which one.
		local missing=if tech.requires=="Anchor" then "NEEDS A SEAL" elseif tech.requires=="Target" then "OUT OF RANGE" else "NOT NOW"
		ui.status.Text=if sealed then string.format("SEALED  •  %.1fs",h.sealed) elseif tech.remaining&gt;0 then string.format("%.1fs",tech.remaining) elseif not tech.condition then missing elseif h.chakra&lt;tech.cost then "NEED CHAKRA" else tech.cost.." CHAKRA"
		-- (06/11) Kakashi's copy slot: the jutsu his Sharingan copied, in red.
		if tech.copied then ui.status.Text="COPY • "..ui.status.Text end
		if tech.id=="Flashstep" and #(h.seals or {})&gt;0 and tech.remaining==0 and not sealed then
			local count=#(h.seals or {})
			ui.status.Text=count.." SEAL"..(if count&gt;1 then "S" else "").."  •  "..ui.status.Text
		end
		ui.box.BackgroundTransparency=if ready then .05 else .35
		-- (05/11) R1 held on a pad: the row it opens is lit, the buttons in gold.
		ui.key.TextColor3=if data.jutsuPage then palette.gold else palette.paper
		if data.jutsuPage then ui.box.BackgroundTransparency=0 end
		if ready and ui.wasReady==false then
			pcall(function()
				ui.flash=ui.flash or (function() local f=Instance.new("Frame");f.BackgroundColor3=palette.paper;f.BorderSizePixel=0;f.Size=UDim2.fromScale(1,1);f.ZIndex=5;local c=Instance.new("UICorner");c.CornerRadius=UDim.new(0,8);c.Parent=f;f.Parent=ui.box;return f end)()
				ui.flash.BackgroundTransparency=.3
				Tween:Create(ui.flash,TweenInfo.new(.35,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{BackgroundTransparency=1}):Play()
			end)
		end
		ui.wasReady=ready
		ui.title.TextColor3=if tech.copied then (if ready then Color3.fromRGB(255,86,86) else Color3.fromRGB(150,60,60)) elseif ready then palette.paper else palette.muted
		ui.cool.Size=UDim2.fromScale(1,math.clamp(math.max(tech.remaining/6,if sealed then h.sealed/5 else 0),0,1))
	end
	if not chakraPage then for i=#h.techniques+1,5 do self.techniqueButtons[i].box.Visible=false end end
	self:sealHud(h,pad,data.sealPage)
	local caption=self.jutsuCaption
	caption.Text=if chakraPage then (if pad then P0.Chakra else K0.Chakra).." +" else "R1 +"
	caption.TextColor3=if data.jutsuPage or chakraPage then palette.gold else palette.paper
	-- (B0, 04/11, seen on an emulated phone) on a touch screen the touch
	-- controls carry the jutsu and the seal page: the keyboard slots and the
	-- "HOLD C" slip sat under the buttons.
	if data.touch then
		for _,b in self.techniqueButtons do b.box.Visible=false end
		self.sealPanel.Visible=false
	end
	-- (B1 lot 2) the first minute and its duel: the signature's slot only,
	-- no seal page; the rest shows from the next duel on.
	if data.first then
		for i,b in self.techniqueButtons do if i~=FirstMinute.SignatureSlot then b.box.Visible=false end end
		self.sealPanel.Visible=false;self.sealWeave.Text=""
	end
	-- (Tournament) watching a match: none of these are the player's.
	if data.spectate then
		for _,b in self.techniqueButtons do b.box.Visible=false end
		self.sealPanel.Visible=false;self.sealWeave.Text=""
	end
	-- The caption sits left of the first card still shown (pad only).
	local leftmost=nil
	for i,b in self.techniqueButtons do if b.box.Visible then leftmost=leftmost or i end end
	caption.Visible=(pad or chakraPage) and leftmost~=nil
	local count=if chakraPage then 5 else #h.techniques
	if leftmost then caption.Position=UDim2.new(1,-24-(count-leftmost+1)*150+6-62,1,-74) end
	local techOpen=h.reaction=="WallSplat" and (h.splatElapsed or 9)&lt;.34
	local conversion=UI.conversion(h,pad)
	local K,P=Controls.KeyLabel,Controls.PadLabel
	self.hint.Text=if techOpen then (if pad then P.Dodge.." — WALL TECH" else K.Dodge.." — WALL TECH")
		elseif conversion then conversion
		elseif b.reaction=="WallSplat" and h.pursuit&gt;0 then (if pad then "× — PURSUE  •  △ — WALL BOUNCE" else Controls.KeyLabel.Pursuit.." — PURSUE  •  RMB — WALL BOUNCE")
		elseif (h.counter or 0)&gt;0 then UI.counterPrompt(h,pad)
		-- The Chidori's risk, from the other side: its charge can be broken.
		elseif b.castId=="Chidori" and b.state=="TechniqueChannel" then (if pad then Controls.PadLabel.Light else Controls.KeyLabel.Light).." — BREAK THE CHIDORI CHARGE"
		elseif h.awakenReady then (if pad then "D-PAD ↓ — AWAKEN" else K.Awaken.." — AWAKEN")
		elseif h.wall then (if pad then "× — REBOUND  •  "..P.WallDetach.." — DETACH" else "SPACE — REBOUND  •  "..K.WallDetach.." — DETACH")
		-- (Audit 04/11) the pad's feint is R1 + R2 and its throw break L1 + □.
		elseif h.state=="Startup" and h.attackName=="Heavy" then (if pad then P.Feint.." — FEINT" else K.Feint.." — FEINT")
		elseif h.reaction=="Grabbed" then (if pad then P.Grab.." — THROW BREAK" else K.Grab.." — THROW BREAK")
		-- (QA 12/11: « KNOCK AWAY • E TO CHASE » and « E / SPACE – CHASE » at
		-- once) the chase is said once: the cue says it, the hint stays quiet.
		elseif h.pursuit&gt;0 and not UI.cueNamesChase(self.cue.Text) then (if pad then "× — CHASE" else Controls.KeyLabel.Pursuit.." / SPACE — CHASE")
		elseif (h.combo or 0)&gt;=2 and h.state=="Recovery" and not h.airborne and (h.comboHits or 0)==0 and b.reaction then Controls.comboHelp(MoveGraphs[h.fighterId] or {},pad)
		else ""
	-- (Tournament, audit 04/11) watching an AI match: its prompts are not his.
	if data.spectate then self.hint.Text="";self.cue.Text="" end
	self.help.Text=if pad then Controls.HelpPad else Controls.Help
	self.grammar.Text=Controls.comboHelp(MoveGraphs[h.fighterId] or {},pad)
	-- (Reference quality) The control sheet is for the first seconds of a duel
	-- (and the tutorial), not a permanent band across the fight.
	if self.helpEpoch~=data.epoch then self.helpEpoch=data.epoch;self.helpUntil=os.clock()+10 end
	local helping=data.tutorial~=nil or os.clock()&lt;(self.helpUntil or 0)
	-- (User 03/11) The keys live in the controls sheet (TAB), not on screen.
	self.help.Visible=false;self.grammar.Visible=false
	local _=helping
	self.lastHuman=h
	self.controlsChip.Text=(if pad then "START" else "TAB").."   CONTROLS"
	self.controlsChip.Visible=(os.clock()&lt;(self.helpUntil or 0) or data.tutorial~=nil) and not data.touch
	local won=data.winner=="PlayerFighter"
	local winner=if won then h else b
	self.resultTitle.Text=(if won then "VICTORY" else "DEFEAT")..(if (data.roundsToWin or 1)&gt;1 and data.wins then string.format("  %d–%d",data.wins.human or 0,data.wins.bot or 0) else "")
	self.resultTitle.TextColor3=if won then palette.gold else palette.crimson
	self.resultSeal.Text=if won then "勝" else "敗"
	self.resultSeal.BackgroundColor3=if won then palette.red else Color3.fromRGB(60,56,64)
	self.resultName.Text=fullName(winner).."  ADVANCES"
	if Fighters[winner.fighterId or ""] then self.resultName.TextColor3=accentOf(Fighters[winner.fighterId]):Lerp(palette.paper,.25) end
	self.resultNote.Text=if won then "The judges saw it too. The bracket waits for no one." else "Read the commitment. Find a better opening — prodigies learn fastest from defeat."
	-- Online: a rematch needs both players; a forfeit says so.
	local online=data.online
	self.rematchButton.Text=if not online then "REMATCH" elseif online.opponentLeft then "OPPONENT LEFT" elseif online.rematch then "WAITING FOR OPPONENT…"
		elseif online.theirRematch then "REMATCH  •  OPPONENT IS READY" else "REMATCH"
	if online and online.forfeit then
		self.resultTitle.Text=(if won then "VICTORY" else "DEFEAT").."  •  FORFEIT"
		self.resultNote.Text="Your opponent left the duel. The win is yours."
	end
	-- (Tournament) continue the bracket; a match watched names its winner.
	self.inCup=data.cup~=nil
	self.rosterButton.Text=if self.inCup then "LEAVE THE TOURNAMENT" else "RETURN TO THE ROSTER"
	if self.inCup then
		self.rematchButton.Text=if data.cup.out and not data.spectate then "SEE WHO WINS IT  •  THE BRACKET" else "CONTINUE  •  THE BRACKET"
		if data.spectate then
			local def=Fighters[winner.fighterId or ""]
			self.resultTitle.Text=Text.upper(def and def.Name or "")..(if (data.roundsToWin or 1)&gt;1 and data.wins then string.format("  %d–%d",math.max(data.wins.human or 0,data.wins.bot or 0),math.min(data.wins.human or 0,data.wins.bot or 0)) else "")
			self.resultTitle.TextColor3=palette.gold
			self.resultSeal.Text="勝";self.resultSeal.BackgroundColor3=palette.red
			self.resultNote.Text="One more name moves up the bracket."
		elseif won then
			self.resultNote.Text="Your name moves up the bracket."
		else
			self.resultNote.Text="Your tournament ends here. The bracket plays out without you."
		end
	end
end
return UI
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND230">
          <Properties>
            <string name="Name">UltimateFX</string>
            <ProtectedString name="Source">-- The ultimates on the client (stage 6, the approved move list, "Ultimes"):
-- Server/Ultimates pushes the contacts, this layer draws them. One identity
-- layer installed into Effects (like LeeFX): Effects offers the registry and
-- its helpers; the lens is Camera:cinema (the same "ultimate" contact).
--   ultimateStart  the press: a flash of the fighter's colour, his ultimate's name
--   ultimate       caught: letterbox, the name, the sequence drawn for its time
--   ultimateTick   each blow of the sequence
--   ultimateEnd    the last blow
--   ultimateMiss   the opener whiffed (the opening is the opponent's)
-- and three awakening moments: Itachi's Tsukuyomi (the world turns red and
-- black for the held body), a gate of Lee's opening, the Byakugan's reveal.
-- Presentation only: nothing here can change gameplay.
local Debris=game:GetService("Debris")

local UltimateFX={}
local Scripts=require(game:GetService("ReplicatedStorage").NinjaDuel.UltimateScripts)
local K -- Effects' helpers, handed over by install()
UltimateFX.clock=os.clock -- (headless tests drive time)

local function rgb(r,g,b) return Color3.fromRGB(r,g,b) end
-- Per sequence: the core colour, its edge, the world's grade while it plays.
UltimateFX.LOOK={
	clones={core=rgb(255,150,40),edge=rgb(255,226,170),grade={tint=rgb(255,236,214),saturation=.15,contrast=.12}},
	lion={core=rgb(150,200,255),edge=rgb(236,246,255),grade={tint=rgb(214,226,255),saturation=-.2,contrast=.25}},
	pyramid={core=rgb(214,176,112),edge=rgb(150,112,70),grade={tint=rgb(255,232,196),saturation=-.1,contrast=.15}},
	lotus={core=rgb(120,230,140),edge=rgb(226,255,226),grade={tint=rgb(226,255,226),saturation=.1,contrast=.15}},
	palms={core=rgb(190,200,255),edge=rgb(250,250,255),grade={tint=rgb(226,230,255),saturation=-.35,contrast=.2}},
	tsukuyomi={core=rgb(200,20,30),edge=rgb(20,10,12),grade={tint=rgb(255,70,70),saturation=-1,contrast=.7,brightness=-.12}},
	flash={core=rgb(255,220,80),edge=rgb(255,250,220),grade={tint=rgb(255,246,214),saturation=0,contrast=.2}},
	raikiri={core=rgb(220,236,255),edge=rgb(120,170,255),grade={tint=rgb(220,230,255),saturation=-.3,contrast=.3}},
}
local function lookOf(kind) return UltimateFX.LOOK[kind or ""] or UltimateFX.LOOK.clones end

-- The screen side (letterbox and title) lives in the local player's GUI; a
-- headless scene has none and simply skips it.
local function playerGui()
	local ok,gui=pcall(function()
		local player=game:GetService("Players").LocalPlayer
		return player and player:FindFirstChildOfClass("PlayerGui")
	end)
	return ok and gui or nil
end
function UltimateFX.banner(fx,name,color,time,subtitle)
	local gui=playerGui()
	if not gui then return nil end
	local old=gui:FindFirstChild("NinjaUltimate")
	if old then old:Destroy() end
	local screen=K.new("ScreenGui",{Name="NinjaUltimate",IgnoreGuiInset=true,ResetOnSpawn=false,DisplayOrder=40},gui)
	local top=K.new("Frame",{BackgroundColor3=Color3.new(),BorderSizePixel=0,Size=UDim2.new(1,0,0,0),Position=UDim2.fromScale(0,0)},screen)
	local bottom=K.new("Frame",{BackgroundColor3=Color3.new(),BorderSizePixel=0,Size=UDim2.new(1,0,0,0),AnchorPoint=Vector2.new(0,1),Position=UDim2.fromScale(0,1)},screen)
	K.tween(top,.22,{Size=UDim2.new(1,0,.11,0)});K.tween(bottom,.22,{Size=UDim2.new(1,0,.11,0)})
	local title=K.new("TextLabel",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,64),AnchorPoint=Vector2.new(.5,1),Position=UDim2.new(.5,0,1,-18),
		Font=Enum.Font.GothamBlack,Text=name or "",TextColor3=color,TextSize=46,TextTransparency=1,TextStrokeTransparency=.2,TextStrokeColor3=Color3.new()},screen)
	K.tween(title,.2,{TextTransparency=0})
	local sub=nil
	if subtitle then
		sub=K.new("TextLabel",{Name="Count",BackgroundTransparency=1,Size=UDim2.new(1,0,0,30),AnchorPoint=Vector2.new(.5,0),Position=UDim2.new(.5,0,0,22),
			Font=Enum.Font.GothamBold,Text=subtitle,TextColor3=Color3.new(1,1,1),TextSize=26,TextStrokeTransparency=.3},screen)
	end
	fx.ultimateScreen={screen=screen,top=top,bottom=bottom,title=title,sub=sub,ends=UltimateFX.clock()+(time or 3.4)}
	task.delay(time or 3.4,function() UltimateFX.closeBanner(fx,screen) end)
	return screen
end
function UltimateFX.closeBanner(fx,screen)
	local open=fx.ultimateScreen
	if not open or (screen and open.screen~=screen) then return end
	fx.ultimateScreen=nil
	if open.screen.Parent then
		K.tween(open.top,.2,{Size=UDim2.new(1,0,0,0)});K.tween(open.bottom,.2,{Size=UDim2.new(1,0,0,0)})
		K.tween(open.title,.2,{TextTransparency=1})
		Debris:AddItem(open.screen,.3)
	end
end
-- The world's grade for the sequence (one at a time).
function UltimateFX.grade(fx,look,time)
	if fx.ultimateGrade and fx.ultimateGrade.Parent then fx.ultimateGrade:Destroy() end
	local ok,cc=pcall(function()
		local Lighting=game:GetService("Lighting") -- (asked late: a headless scene has none)
		return K.new("ColorCorrectionEffect",{Name="NinjaUltimateGrade",TintColor=look.grade.tint,Saturation=look.grade.saturation,Contrast=look.grade.contrast,Brightness=look.grade.brightness or 0},Lighting)
	end)
	if not ok or not cc then return end
	fx.ultimateGrade=cc
	task.delay(time,function()
		if cc.Parent then K.tween(cc,.3,{TintColor=Color3.new(1,1,1),Saturation=0,Contrast=0});Debris:AddItem(cc,.35) end
	end)
end

local function modelFor(folder,id) return folder and folder:FindFirstChild(id or "") end
local function rootOf(model) return model and model:FindFirstChild("HumanoidRootPart") end
local function around(position,radius,rng)
	local a=rng:NextNumber()*math.pi*2
	return position+Vector3.new(math.cos(a)*radius,rng:NextNumber()*2-.5,math.sin(a)*radius)
end

-- (Redone 02/11) Each sequence draws its own moments, on its own timeline
-- (Shared/UltimateScripts cues), round the bodies where they are drawn: no
-- shared "beat" any more. A clone of the caster's drawn body (afterimages,
-- Lee's ghosts) is copied part by part.
local function copyBody(fx,model,cf,life)
	if not model then return nil end
	local root=model:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	local holder=K.new("Model",{Name="UltimateClone"},fx.folder)
	local base=root.CFrame
	for _,d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Name~="HumanoidRootPart" and d.Transparency&lt;.9 and d.Size.Magnitude&lt;8 then
			local ok,g=pcall(function() local was=d.Archivable;d.Archivable=true;local x=d:Clone();d.Archivable=was;return x end)
			if ok and g then
				for _,ch in g:GetChildren() do
					if not (ch:IsA("SpecialMesh") or ch:IsA("Decal") or ch:IsA("SurfaceAppearance") or ch:IsA("SurfaceGui") or ch:IsA("Texture")) then ch:Destroy() end
				end
				g.Anchored=true;g.CanCollide=false;g.CanQuery=false;g.CanTouch=false;g.CastShadow=false
				g.CFrame=cf*base:ToObjectSpace(d.CFrame)
				g.Parent=holder
			end
		end
	end
	Debris:AddItem(holder,life)
	return holder
end
UltimateFX.copyBody=copyBody
-- An afterimage: the body as drawn now, in one flat colour, fading.
local function ghost(fx,model,color,life)
	local root=model and model:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local g=copyBody(fx,model,root.CFrame,life+.05)
	if not g then return end
	for _,part in g:GetDescendants() do
		if part:IsA("BasePart") then
			part.Color=color;part.Material=Enum.Material.Neon;part.Transparency=.45
			for _,d in part:GetChildren() do if d:IsA("Decal") then d:Destroy() end end
			K.tween(part,life,{Transparency=1})
		end
	end
end
UltimateFX.ghost=ghost

local function screen(fx)
	local gui=playerGui()
	if not gui then return nil end
	local s=gui:FindFirstChild("NinjaUltimateFX")
	if not s then s=K.new("ScreenGui",{Name="NinjaUltimateFX",IgnoreGuiInset=true,ResetOnSpawn=false,DisplayOrder=41},gui) end
	return s
end
-- A word on the screen (U! ZU! the palm count, the hours): it slams in big
-- and settles, then goes.
function UltimateFX.textPop(fx,text,color,size,hold)
	local s=screen(fx)
	if not s then return nil end
	local label=K.new("TextLabel",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,(size or 70)*1.4),AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.38),
		Font=Enum.Font.GothamBlack,Text=text,TextColor3=color,TextSize=(size or 70)*1.7,TextStrokeTransparency=0,TextStrokeColor3=Color3.new(),TextTransparency=0},s)
	K.tween(label,.12,{TextSize=size or 70})
	task.delay(hold or .5,function() if label.Parent then K.tween(label,.2,{TextTransparency=1,TextStrokeTransparency=1}) end end)
	Debris:AddItem(label,(hold or .5)+.3)
	return label
end
-- The impact frame: two frames of the world in black and white, hard
-- contrast, a white flash on top (the anime's "frame" on a decisive blow).
function UltimateFX.impactFrame(fx)
	pcall(function()
		local Lighting=game:GetService("Lighting")
		local cc=K.new("ColorCorrectionEffect",{Name="NinjaImpactFrame",Saturation=-1,Contrast=2.4,Brightness=.08},Lighting)
		task.delay(.05,function() if cc.Parent then cc.Contrast=-1.6;cc.Brightness=.25 end end)
		task.delay(.1,function() if cc.Parent then cc:Destroy() end end)
	end)
	local s=screen(fx)
	if s then
		local white=K.new("Frame",{BackgroundColor3=Color3.new(1,1,1),BackgroundTransparency=.35,BorderSizePixel=0,Size=UDim2.fromScale(1,1)},s)
		K.tween(white,.14,{BackgroundTransparency=1})
		Debris:AddItem(white,.2)
	end
end
-- A crater where a body is driven into the floor: a ring of thrown rock, the
-- crack, the dust.
function UltimateFX.crater(fx,p,color,size)
	size=size or 1
	local floor=Vector3.new(p.X,p.Y-2.9,p.Z)
	K.shockRing(fx.folder,floor+Vector3.new(0,.15,0),color,2,18*size,.45)
	K.smokePuff(fx.folder,floor+Vector3.new(0,.5,0),rgb(196,184,160),14,2.4*size)
	local rng=Random.new(math.floor(p.X*7+p.Z*13))
	for k=1,10 do
		local a=k/10*math.pi*2+rng:NextNumber()*.4
		local rock=K.block(fx.folder,Vector3.one*(.5+rng:NextNumber()*.9)*size,CFrame.new(floor+Vector3.new(math.cos(a)*1.6,.3,math.sin(a)*1.6))*CFrame.Angles(rng:NextNumber()*3,rng:NextNumber()*3,0),rgb(120,112,100),Enum.Material.Slate)
		local out=floor+Vector3.new(math.cos(a)*(4+rng:NextNumber()*3)*size,.2,math.sin(a)*(4+rng:NextNumber()*3)*size)
		K.tween(rock,.35,{CFrame=CFrame.new(out+Vector3.new(0,1.5,0))*CFrame.Angles(rng:NextNumber()*6,rng:NextNumber()*6,0)},Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
		task.delay(.35,function() if rock.Parent then K.tween(rock,.3,{CFrame=CFrame.new(out),Transparency=.2},Enum.EasingStyle.Quad,Enum.EasingDirection.In) end end)
		task.delay(1.6,function() if rock.Parent then K.tween(rock,.4,{Transparency=1}) end end)
		Debris:AddItem(rock,2.1)
	end
	-- the crack: a dark star of grooves
	for k=1,7 do
		local a=k/7*math.pi*2
		local len=(3+k%3)*size
		local c=K.block(fx.folder,Vector3.new(.25,.06,len),CFrame.new(floor+Vector3.new(math.cos(a)*len/2,.06,math.sin(a)*len/2))*CFrame.Angles(0,-a+math.pi/2,0),rgb(40,34,30),Enum.Material.Slate)
		task.delay(2,function() if c.Parent then K.tween(c,.5,{Transparency=1}) end end)
		Debris:AddItem(c,2.6)
	end
	K.sound(K.anchorPart(fx.folder,p),K.SOUND.boom,.8,.8)
	K.sound(K.anchorPart(fx.folder,p),K.SOUND.debris,.6,1,1.2)
end

-- The sequence's context: the frame of the catch, the bodies as drawn.
local function context(fx,impact,folder,look)
	local victimModel=modelFor(folder,impact.victim)
	local casterModel=modelFor(folder,impact.owner)
	local ctx={fx=fx,impact=impact,look=look,kind=impact.kind,time=impact.time or 3.4,started=UltimateFX.clock(),
		victimModel=victimModel,casterModel=casterModel,victim=rootOf(victimModel),caster=rootOf(casterModel),token={}}
	ctx.frame=if impact.origin and impact.line then Scripts.frame(impact.origin,impact.line) else Scripts.frame(impact.position or Vector3.zero,Vector3.new(0,0,-1))
	function ctx.vpos() return (ctx.victim and ctx.victim.Parent and ctx.victim.Position) or impact.position or ctx.frame.origin end
	function ctx.cpos() return (ctx.caster and ctx.caster.Parent and ctx.caster.Position) or ctx.frame.origin-ctx.frame.f*4 end
	function ctx.t() return UltimateFX.clock()-ctx.started end
	function ctx.live() return fx.ultimateRun==ctx.token end
	function ctx.floor(p) p=p or ctx.vpos();return Vector3.new(p.X,ctx.frame.origin.Y-2.9,p.Z) end
	-- Run fn every frame until `untilT` (sequence time) or the end.
	function ctx.loop(untilT,fn)
		task.spawn(function()
			while ctx.live() and ctx.t()&lt;untilT do
				local ok=pcall(fn,ctx.t())
				if not ok then break end
				task.wait()
			end
		end)
	end
	function ctx.hand(model,side)
		model=model or ctx.casterModel
		return model and (model:FindFirstChild((side or "Right").."Hand") or model:FindFirstChild("HumanoidRootPart"))
	end
	return ctx
end

-- ------------------------------------------------------------------- cues
local CUE={}
UltimateFX.CUE=CUE
CUE.impactFrame=function(ctx) UltimateFX.impactFrame(ctx.fx) end
CUE.crater=function(ctx) UltimateFX.crater(ctx.fx,ctx.vpos(),ctx.look.core,1.2) end

-- Naruto -----------------------------------------------------------------
CUE.punch=function(ctx)
	local p=ctx.vpos()
	K.flash(ctx.fx.folder,p+Vector3.new(0,.3,0),ctx.look.edge,.6,4,.12,.2)
	K.shockRing(ctx.fx.folder,p,ctx.look.core,1,6,.25,ctx.frame.f)
	K.sound(K.anchorPart(ctx.fx.folder,p),K.SOUND.punch,.7,.9)
end
CUE.sign=function(ctx)
	-- The chakra pours out of him: an orange flare, the floor dust thrown out.
	local p=ctx.cpos()
	K.flash(ctx.fx.folder,p,ctx.look.core,2,9,.3,.3)
	K.shockRing(ctx.fx.folder,ctx.floor(p)+Vector3.new(0,.2,0),ctx.look.core,2,22,.5)
	K.smokePuff(ctx.fx.folder,ctx.floor(ctx.vpos())+Vector3.new(0,1,0),rgb(240,236,226),16,3)
	K.sound(K.anchorPart(ctx.fx.folder,p),K.SOUND.whoosh,.7,.8)
end

-- Sasuke ---------------------------------------------------------------
-- A groove torn in the floor behind a hand dragged low (the Chidori run,
-- the Raikiri run), glowing then cooling.
local function scar(ctx,model,untilT,color)
	local last=nil
	ctx.loop(untilT,function()
		local hand=ctx.hand(model)
		if not hand then return end
		local at=ctx.floor(hand.Position)+Vector3.new(0,.08,0)
		if last and (at-last).Magnitude&gt;.8 then
			local mid=(at+last)/2
			local g=K.block(ctx.fx.folder,Vector3.new(.45,.12,(at-last).Magnitude+.2),CFrame.lookAt(mid,at),color,Enum.Material.Neon)
			K.tween(g,1.4,{Color=rgb(40,40,50),Size=Vector3.new(.3,.06,(at-last).Magnitude+.2)})
			task.delay(2.4,function() if g.Parent then K.tween(g,.5,{Transparency=1}) end end)
			Debris:AddItem(g,3)
			if K.sparks and math.random()&lt;.5 then K.sparks(ctx.fx.folder,at,color,3,16) end
			last=at
		elseif not last then last=at end
	end)
end
CUE.chidoriRun=function(ctx)
	UltimateFX.handCharge(ctx.fx,ctx.casterModel,ctx.look,.8,false)
	scar(ctx,ctx.casterModel,.4,ctx.look.core)
	K.sound(K.anchorPart(ctx.fx.folder,ctx.cpos()),K.SOUND.electric,.8,1.1)
end
CUE.impale=function(ctx)
	-- Through the body: a burst out of the back, the current running for a while.
	local p=ctx.vpos()
	K.flash(ctx.fx.folder,p+ctx.frame.f*.8,ctx.look.edge,1.2,7,.18,.1)
	K.shockRing(ctx.fx.folder,p+ctx.frame.f*1.2,ctx.look.core,1,9,.3,ctx.frame.f)
	if K.sparks then K.sparks(ctx.fx.folder,p+ctx.frame.f*1.2,ctx.look.core,20,40) end
	local t0=ctx.t()
	ctx.loop(t0+.45,function()
		if K.sparks and math.random()&lt;.35 then K.sparks(ctx.fx.folder,ctx.vpos()+Vector3.new(0,math.random()-.3,0),ctx.look.edge,4,22) end
	end)
	K.sound(K.anchorPart(ctx.fx.folder,p),K.SOUND.electric,.9,.85)
	K.sound(K.anchorPart(ctx.fx.folder,p),K.SOUND.heavy,.6,.8)
end
CUE.throwUp=function(ctx)
	local p=ctx.vpos()
	K.shockRing(ctx.fx.folder,ctx.floor(p)+Vector3.new(0,.2,0),ctx.look.edge,2,14,.35)
	K.smokePuff(ctx.fx.folder,ctx.floor(p)+Vector3.new(0,.6,0),rgb(200,190,170),8,1.8)
	K.sound(K.anchorPart(ctx.fx.folder,p),K.SOUND.whooshBy,.6,.9)
end
CUE.airHit=function(ctx)
	local p=ctx.vpos()
	local d=(p-ctx.cpos())
	d=if d.Magnitude&gt;.1 then d.Unit else ctx.frame.f
	K.shockRing(ctx.fx.folder,p,ctx.look.edge,1.5,10,.25,d)
	K.flash(ctx.fx.folder,p,ctx.look.core,.6,4.5,.12,.2)
end

-- Gaara: one sand mass, start to end --------------------------------------
-- ~110 grains that are never replaced: they pour out of the floor under him,
-- run to the body, climb it, close round it into a cocoon (with its shell),
-- rise with it on a column, tighten, crush, and fly apart. Each grain keeps
-- an offset in the held body's space once it has reached it.
local SAND=rgb(214,176,112)
local SAND_DARK=rgb(170,132,82)
local function sandMass(ctx)
	local fx=ctx.fx
	local rng=Random.new(ctx.impact.serial or 7)
	local mass={grains={},phase="flood",scale=1,shellSize=0}
	ctx.sand=mass
	local from=ctx.floor(ctx.cpos())+ctx.frame.f*1.2
	local N=110
	for i=1,N do
		local s=.45+rng:NextNumber()*.85
		local g=K.block(fx.folder,Vector3.new(s,s*.8,s),CFrame.new(from),if i%3==0 then SAND_DARK else SAND,Enum.Material.Sand)
		g.Name="SandGrain"
		-- Its place on the body: a shell round it, low first (the legs), up to the head.
		local h=(i/N)
		local a=rng:NextNumber()*math.pi*2
		local r=1.05+rng:NextNumber()*.45
		local body=Vector3.new(math.cos(a)*r,-2.6+h*5.0,math.sin(a)*r*.8)
		-- Where it waits on the floor first (a pool round the feet).
		local pool=Vector3.new(math.cos(a)*(1.4+rng:NextNumber()*2.4),-2.75,math.sin(a)*(1.4+rng:NextNumber()*2.4))
		mass.grains[i]={part=g,body=body,pool=pool,spin=CFrame.Angles(rng:NextNumber()*6,rng:NextNumber()*6,rng:NextNumber()*6),
			delay=rng:NextNumber()*.55,arrive=nil,from=from+Vector3.new(rng:NextNumber()-.5,0,rng:NextNumber()-.5)}
	end
	-- The floor stain spreading under the body, the cocoon's shell, the column.
	local stain=K.block(fx.folder,Vector3.new(.08,1,1),CFrame.new(ctx.floor(ctx.vpos())+Vector3.new(0,.05,0))*CFrame.Angles(0,0,math.rad(90)),SAND,Enum.Material.Sand)
	stain.Shape=Enum.PartType.Cylinder;stain.Name="SandStain"
	K.tween(stain,.8,{Size=Vector3.new(.08,9,9)})
	local shell=K.block(fx.folder,Vector3.new(.1,.1,.1),CFrame.new(ctx.vpos()),SAND,Enum.Material.Sand)
	shell.Shape=Enum.PartType.Ball;shell.Name="SandCocoon";shell.Transparency=1
	local column=K.block(fx.folder,Vector3.new(.1,2.2,2.2),CFrame.new(ctx.floor()),SAND_DARK,Enum.Material.Sand)
	column.Shape=Enum.PartType.Cylinder;column.Name="SandColumn";column.Transparency=1
	mass.stain,mass.shell,mass.column=stain,shell,column
	local t0=ctx.t()
	ctx.loop(ctx.time+.5,function(t)
		local v=ctx.victim
		local vcf=if v and v.Parent then v.CFrame else CFrame.new(ctx.vpos())
		local floorY=ctx.frame.origin.Y-2.9
		for i,g in mass.grains do
			local cf
			if mass.phase=="flood" or (mass.phase=="grip" and g.body.Y&gt;-1.2) then
				-- run along the floor from his feet to the pool round the body
				local k=math.clamp((t-t0-g.delay)/.45,0,1)
				local to=Vector3.new(vcf.Position.X,0,vcf.Position.Z)+Vector3.new(g.pool.X,floorY+.3,g.pool.Z)
				local p=g.from:Lerp(to,k*k*(3-2*k))+Vector3.new(0,math.sin(k*math.pi)*.6,0)
				cf=CFrame.new(p)*g.spin
			elseif mass.phase=="burst" then
				cf=nil
			else
				-- on the body: from the pool up to its place on the shell
				g.arrive=g.arrive or t
				local k=math.clamp((t-g.arrive)/.35,0,1)
				local place=vcf*(g.body*mass.scale)
				local pool=Vector3.new(vcf.Position.X+g.pool.X,floorY+.3,vcf.Position.Z+g.pool.Z)
				local p=pool:Lerp(place,k*k*(3-2*k))
				if mass.phase=="tighten" then p+=Vector3.new(math.sin(t*60+i)*.06,0,math.cos(t*55+i)*.06) end
				cf=CFrame.new(p)*g.spin
			end
			if cf then g.part.CFrame=cf end
		end
		if mass.shellSize&gt;0 then
			shell.CFrame=vcf
			shell.Size=Vector3.new(2.5,5.4,2.5)*mass.shellSize*mass.scale
		end
		if mass.columnOn then
			local top=vcf.Position.Y-2.6*mass.scale
			local h=math.max(.2,top-floorY)
			column.CFrame=CFrame.new(vcf.Position.X,floorY+h/2,vcf.Position.Z)*CFrame.Angles(0,0,math.rad(90))
			column.Size=Vector3.new(h,2.4*mass.scale,2.4*mass.scale)
		end
	end)
	return mass
end
CUE.sandFlood=function(ctx)
	sandMass(ctx)
	K.sound(K.anchorPart(ctx.fx.folder,ctx.cpos()),K.SOUND.whoosh,.6,.6)
	K.smokePuff(ctx.fx.folder,ctx.floor(ctx.cpos())+Vector3.new(0,.4,0),SAND,6,1.6)
end
CUE.sandGrip=function(ctx)
	local m=ctx.sand;if not m then return end
	m.phase="grip"
	K.smokePuff(ctx.fx.folder,ctx.floor()+Vector3.new(0,.5,0),SAND,8,1.6)
	K.sound(K.anchorPart(ctx.fx.folder,ctx.vpos()),K.SOUND.debris,.5,1.3,.8)
end
CUE.sandCocoon=function(ctx)
	local m=ctx.sand;if not m then return end
	m.phase="cocoon"
	m.shell.Transparency=0
	-- the shell grows over the body once the grains are on it
	task.spawn(function()
		local s=UltimateFX.clock()
		while ctx.live() and UltimateFX.clock()-s&lt;.45 do m.shellSize=math.clamp((UltimateFX.clock()-s)/.45,0,1);task.wait() end
		m.shellSize=1
	end)
end
CUE.sandLift=function(ctx)
	local m=ctx.sand;if not m then return end
	m.columnOn=true;m.column.Transparency=0
	K.shockRing(ctx.fx.folder,ctx.floor()+Vector3.new(0,.2,0),SAND,2,14,.4)
	K.sound(K.anchorPart(ctx.fx.folder,ctx.vpos()),K.SOUND.debris,.6,.8,1)
end
CUE.sandTighten=function(ctx)
	local m=ctx.sand;if not m then return end
	m.phase="tighten"
	task.spawn(function()
		local s=UltimateFX.clock()
		while ctx.live() and UltimateFX.clock()-s&lt;.3 do m.scale=1-.12*math.clamp((UltimateFX.clock()-s)/.3,0,1);task.wait() end
	end)
end
CUE.sandCrush=function(ctx)
	local m=ctx.sand;if not m then return end
	m.scale=.72
	K.flash(ctx.fx.folder,ctx.vpos(),SAND,2,8,.2,.2)
	K.shockRing(ctx.fx.folder,ctx.vpos(),SAND,2,12,.3)
	UltimateFX.textPop(ctx.fx,"SABAKU SOSO",rgb(255,214,150),64,.8)
	K.sound(K.anchorPart(ctx.fx.folder,ctx.vpos()),K.SOUND.boom,.7,1.2)
end
CUE.sandBurst=function(ctx)
	local m=ctx.sand;if not m then return end
	m.phase="burst"
	local center=ctx.vpos()
	local rng=Random.new(11)
	for _,g in m.grains do
		local d=g.part.Position-center
		d=if d.Magnitude&gt;.1 then d.Unit else Vector3.yAxis
		local out=g.part.Position+d*(6+rng:NextNumber()*8)+Vector3.new(0,rng:NextNumber()*3,0)
		K.tween(g.part,.5,{CFrame=CFrame.new(out)*g.spin,Transparency=1})
		Debris:AddItem(g.part,.6)
	end
	K.tween(m.shell,.25,{Size=m.shell.Size*1.6,Transparency=1});Debris:AddItem(m.shell,.3)
	K.tween(m.column,.5,{Transparency=1});Debris:AddItem(m.column,.55)
	K.tween(m.stain,1.2,{Transparency=1});Debris:AddItem(m.stain,1.3)
	K.smokePuff(ctx.fx.folder,center,SAND,22,3.4)
	K.shockRing(ctx.fx.folder,center,SAND,3,26,.5)
	K.sound(K.anchorPart(ctx.fx.folder,center),K.SOUND.boom,.9,.7)
end

-- Lee ----------------------------------------------------------------------
CUE.gates=function(ctx)
	local p=ctx.cpos()
	for k=0,2 do
		task.delay(k*.1,function()
			K.shockRing(ctx.fx.folder,ctx.floor(p)+Vector3.new(0,.2,0),ctx.look.core,2,10+k*6,.35)
			K.flash(ctx.fx.folder,p,ctx.look.edge,1.5,5+k*2,.15,.3)
		end)
	end
	-- the floor breaks under him and the stones rise round him
	local rng=Random.new(5)
	for k=1,8 do
		local a=k/8*math.pi*2
		local at=ctx.floor(p)+Vector3.new(math.cos(a)*2.2,.2,math.sin(a)*2.2)
		local rock=K.block(ctx.fx.folder,Vector3.one*(.4+rng:NextNumber()*.5),CFrame.new(at),rgb(130,120,104),Enum.Material.Slate)
		K.tween(rock,.6,{CFrame=CFrame.new(at+Vector3.new(0,2+rng:NextNumber()*2,0))*CFrame.Angles(rng:NextNumber()*4,rng:NextNumber()*4,0)},Enum.EasingStyle.Sine)
		task.delay(.7,function() if rock.Parent then K.tween(rock,.3,{CFrame=CFrame.new(at),Transparency=1},Enum.EasingStyle.Quad,Enum.EasingDirection.In) end end)
		Debris:AddItem(rock,1.1)
	end
	UltimateFX.textPop(ctx.fx,"GATE OF LIMIT: OPEN",rgb(150,255,160),44,.6)
	K.sound(K.anchorPart(ctx.fx.folder,p),K.SOUND.boom,.6,1.3)
end
CUE.airTrail=function(ctx)
	-- he is everywhere: green afterimages of his body at every place he was
	local last=0
	ctx.loop(2.3,function(t)
		if t-last&gt;=.075 then last=t;ghost(ctx.fx,ctx.casterModel,ctx.look.core,.3) end
	end)
end
CUE.bandage=function(ctx)
	local fx=ctx.fx
	local strip=K.block(fx.folder,Vector3.new(.2,.06,1),CFrame.new(ctx.cpos()),rgb(240,236,226),Enum.Material.Fabric)
	strip.Name="Bandage"
	local wraps={}
	ctx.loop(3.12,function(t)
		local hand=ctx.hand()
		local from=if hand then hand.Position else ctx.cpos()
		local to=ctx.vpos()
		local d=to-from
		if d.Magnitude&gt;.1 then strip.Size=Vector3.new(.22,.06,d.Magnitude);strip.CFrame=CFrame.lookAt(from:Lerp(to,.5),to) end
		if #wraps&lt;5 and t&gt;2.36+#wraps*.05 then
			local w=K.block(fx.folder,Vector3.new(.25,2.3,2.3),CFrame.new(to),rgb(240,236,226),Enum.Material.Fabric)
			w.Shape=Enum.PartType.Cylinder;w.Transparency=.15
			table.insert(wraps,w)
		end
		for i,w in wraps do
			w.CFrame=CFrame.new(to+Vector3.new(0,-1.6+i*.65,0))*CFrame.Angles(0,t*9+i,math.rad(90))
			w.Size=Vector3.new(.25,1.9,1.9)
		end
	end)
	task.delay(math.max(0,3.15-ctx.t()),function()
		strip:Destroy()
		for _,w in wraps do w:Destroy() end
	end)
end
CUE.spin=function(ctx)
	-- the fall: rings of wind spiral round the pair all the way down
	ctx.loop(3.1,function(t)
		if math.random()&lt;.5 then
			local p=ctx.vpos()
			K.shockRing(ctx.fx.folder,p+Vector3.new(0,1,0),ctx.look.edge,2,6,.2)
		end
	end)
	K.sound(K.anchorPart(ctx.fx.folder,ctx.vpos()),K.SOUND.whooshBy,.8,.7)
end

-- Neji -----------------------------------------------------------------
CUE.trigrams=function(ctx)
	local mid=ctx.cpos():Lerp(ctx.vpos(),.5)
	UltimateFX.trigrams(ctx.fx,ctx.floor(mid)+Vector3.new(0,.06,0),ctx.look,ctx.time)
	K.shockRing(ctx.fx.folder,ctx.floor(mid)+Vector3.new(0,.1,0),ctx.look.edge,2,18,.5)
	K.sound(K.anchorPart(ctx.fx.folder,mid),K.SOUND.whoosh,.5,1.4)
end
CUE.palmRain=function(ctx)
	-- every palm a point of light closing on the body; the points stay lit
	local times=Scripts.palmTimes()
	local i=1
	local rng=Random.new(3)
	local points={}
	ctx.loop(3.0,function(t)
		while times[i] and t&gt;=times[i] do
			local v=ctx.victim
			if v then
				local off=Vector3.new((rng:NextNumber()-.5)*1.4,(rng:NextNumber()-.3)*2.4,-.55)
				local dot=K.block(ctx.fx.folder,Vector3.one*.22,v.CFrame*CFrame.new(off),ctx.look.edge,Enum.Material.Neon)
				dot.Shape=Enum.PartType.Ball
				table.insert(points,{part=dot,off=off})
				K.flash(ctx.fx.folder,(v.CFrame*CFrame.new(off)).Position,ctx.look.edge,.3,1.8,.07,.2)
				if i%3==0 then K.sound(K.anchorPart(ctx.fx.folder,v.Position),K.SOUND.hit,.25,1.2+(i%5)*.05) end
			end
			i+=1
		end
		local v=ctx.victim
		if v then for _,pt in points do pt.part.CFrame=v.CFrame*CFrame.new(pt.off) end end
	end)
	task.delay(ctx.time,function() for _,pt in points do if pt.part.Parent then pt.part:Destroy() end end end)
end
CUE.silence=function(ctx)
	-- a breath: the colour drains, the sound stops
	pcall(function()
		local Lighting=game:GetService("Lighting")
		local cc=K.new("ColorCorrectionEffect",{Name="NinjaSilence",Saturation=-.9,Contrast=.3},Lighting)
		task.delay(.32,function() if cc.Parent then cc:Destroy() end end)
	end)
end
CUE.lastPalm=function(ctx)
	local p=ctx.vpos()
	K.shockRing(ctx.fx.folder,p,ctx.look.edge,2,16,.35,ctx.frame.f)
	K.shockRing(ctx.fx.folder,p+ctx.frame.f*2,ctx.look.core,1,10,.3,ctx.frame.f)
	K.flash(ctx.fx.folder,p,ctx.look.edge,1.4,7,.2,.1)
	UltimateFX.textPop(ctx.fx,"HAKKE ROKUJUYON SHO",rgb(220,226,255),46,.8)
	K.sound(K.anchorPart(ctx.fx.folder,p),K.SOUND.boom,.7,1.3)
end

-- Itachi -----------------------------------------------------------------
CUE.eye=function(ctx)
	-- the Mangekyo fills the screen for a moment
	local s=screen(ctx.fx)
	if s then
		local eye=K.new("Frame",{BackgroundColor3=rgb(200,16,24),Size=UDim2.fromOffset(40,40),AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),BorderSizePixel=0},s)
		K.new("UICorner",{CornerRadius=UDim.new(1,0)},eye)
		K.new("UIAspectRatioConstraint",{},eye)
		local pupil=K.new("Frame",{BackgroundColor3=Color3.new(),Size=UDim2.fromScale(.24,.24),AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),BorderSizePixel=0},eye)
		K.new("UICorner",{CornerRadius=UDim.new(1,0)},pupil)
		for k=0,2 do
			local a=k*math.pi*2/3
			local blade=K.new("Frame",{BackgroundColor3=Color3.new(),Size=UDim2.fromScale(.12,.42),AnchorPoint=Vector2.new(.5,1),
				Position=UDim2.fromScale(.5,.5),Rotation=math.deg(a),BorderSizePixel=0},eye)
			K.new("UICorner",{CornerRadius=UDim.new(1,0)},blade)
		end
		K.tween(eye,.35,{Size=UDim2.fromScale(.9,.9),Rotation=120},Enum.EasingStyle.Quint)
		task.delay(.35,function() if eye.Parent then K.tween(eye,.15,{BackgroundTransparency=1});for _,d in eye:GetChildren() do if d:IsA("Frame") then K.tween(d,.15,{BackgroundTransparency=1}) end end end end)
		Debris:AddItem(eye,.6)
	end
	K.sound(K.anchorPart(ctx.fx.folder,ctx.cpos()),K.SOUND.whoosh,.5,.5)
end
CUE.redWorld=function(ctx)
	local p=ctx.vpos()
	UltimateFX.grade(ctx.fx,UltimateFX.LOOK.tsukuyomi,3.0-ctx.t())
	local moon=K.block(ctx.fx.folder,Vector3.new(34,34,34),CFrame.new(p+ctx.frame.f*90+Vector3.new(0,55,0)),rgb(190,10,20),Enum.Material.Neon)
	moon.Shape=Enum.PartType.Ball;moon.Name="RedMoon";moon.Transparency=1
	K.tween(moon,.4,{Transparency=0})
	task.delay(2.9,function() if moon.Parent then moon:Destroy() end end)
	-- the floor goes black under the body (a dark disc to the horizon)
	local floor=K.block(ctx.fx.folder,Vector3.new(.1,120,120),CFrame.new(ctx.floor(p)+Vector3.new(0,.04,0))*CFrame.Angles(0,0,math.rad(90)),rgb(18,6,8),Enum.Material.SmoothPlastic)
	floor.Shape=Enum.PartType.Cylinder;floor.Transparency=1;floor.Name="TsukuyomiFloor"
	K.tween(floor,.3,{Transparency=.05})
	task.delay(2.9,function() if floor.Parent then floor:Destroy() end end)
end
CUE.cross=function(ctx)
	local p=ctx.vpos()
	local back=ctx.frame.f*.75
	local cf=CFrame.lookAt(ctx.floor(p)+back,ctx.floor(p)+back-ctx.frame.f)
	local post=K.block(ctx.fx.folder,Vector3.new(.7,9,.5),cf*CFrame.new(0,4.5,0),rgb(30,18,18),Enum.Material.Wood)
	local bar=K.block(ctx.fx.folder,Vector3.new(6,.6,.5),cf*CFrame.new(0,5.4,0),rgb(30,18,18),Enum.Material.Wood)
	post.Name="TsukuyomiCross";bar.Name="TsukuyomiCross"
	for _,x in {post,bar} do x.Transparency=1;K.tween(x,.25,{Transparency=0}) end
	task.delay(math.max(0,3.3-ctx.t()),function() post:Destroy();bar:Destroy() end)
end
CUE.swords=function(ctx)
	-- the swords, again: from every side into the body, held, gone
	local p=ctx.vpos()
	local rng=Random.new(math.floor(ctx.t()*100))
	for k=1,6 do
		local a=rng:NextNumber()*math.pi*2
		local dir=Vector3.new(math.cos(a),(rng:NextNumber()-.3)*.6,math.sin(a)).Unit
		local tip=p+Vector3.new(0,rng:NextNumber()*1.6-.4,0)
		local blade=K.block(ctx.fx.folder,Vector3.new(.12,.3,3.6),CFrame.lookAt(tip+dir*5,tip),rgb(30,30,34),Enum.Material.Metal)
		K.tween(blade,.08,{CFrame=CFrame.lookAt(tip+dir*1.4,tip)},Enum.EasingStyle.Linear)
		task.delay(.35,function() if blade.Parent then K.tween(blade,.1,{Transparency=1}) end end)
		Debris:AddItem(blade,.5)
	end
	K.flash(ctx.fx.folder,p,ctx.look.core,.8,4,.15,.3)
	K.sound(K.anchorPart(ctx.fx.folder,p),K.SOUND.swish,.6,.8)
end
CUE.worldBack=function(ctx)
	local g=ctx.fx.ultimateGrade
	if g and g.Parent then g:Destroy() end
	K.flash(ctx.fx.folder,ctx.vpos(),Color3.new(1,1,1),2,10,.15,.2)
	for _,d in ctx.fx.folder:GetChildren() do if d.Name=="RedMoon" or d.Name=="TsukuyomiFloor" or d.Name=="TsukuyomiCross" then d:Destroy() end end
end

-- Minato -----------------------------------------------------------------
UltimateFX.kunai=function(fx,from,to,look)
	local k=K.block(fx.folder,Vector3.new(.16,.16,1.1),CFrame.lookAt(from,to),rgb(60,60,66),Enum.Material.Metal)
	k.Name="FlashKunai"
	local mark=K.block(fx.folder,Vector3.new(.06,.06,.5),CFrame.lookAt(from,to)*CFrame.new(0,0,.55),look.core,Enum.Material.Neon)
	local stuck=CFrame.lookAt(to+Vector3.new(0,.4,0),to+Vector3.new(0,-1,0))
	K.tween(k,.2,{CFrame=stuck},Enum.EasingStyle.Linear)
	K.tween(mark,.2,{CFrame=stuck*CFrame.new(0,0,-.55)},Enum.EasingStyle.Linear)
	task.delay(.22,function() if k.Parent then K.shockRing(fx.folder,to+Vector3.new(0,.1,0),look.core,.5,3,.3) end end)
	Debris:AddItem(k,3.6);Debris:AddItem(mark,3.6)
end
CUE.kunaiFan=function(ctx)
	K.sound(K.anchorPart(ctx.fx.folder,ctx.cpos()),K.SOUND.swish,.6,1.3)
end
CUE.timeStop=function(ctx)
	-- time stops: the world grey; every place he appears leaves its yellow
	-- streak hanging in the air until time starts again
	pcall(function()
		local Lighting=game:GetService("Lighting")
		local cc=K.new("ColorCorrectionEffect",{Name="NinjaTimeStop",Saturation=-1,Contrast=.35,TintColor=rgb(230,236,255)},Lighting)
		ctx.timeStop=cc
		task.delay(math.max(0,2.95-ctx.t()),function() if cc.Parent then cc:Destroy() end end)
	end)
	K.shockRing(ctx.fx.folder,ctx.vpos(),ctx.look.edge,1,30,.4)
	local streaks={}
	ctx.streaks=streaks
	local last=ctx.cpos()
	ctx.loop(2.9,function()
		local now=ctx.cpos()
		if (now-last).Magnitude&gt;2 then
			local s=K.block(ctx.fx.folder,Vector3.new(.3,.3,(now-last).Magnitude),CFrame.lookAt(last:Lerp(now,.5),now),ctx.look.core,Enum.Material.Neon)
			s.Transparency=.1;table.insert(streaks,s)
			local cut=K.block(ctx.fx.folder,Vector3.new(.08,2.4,.08),CFrame.new(ctx.vpos())*CFrame.Angles(math.random()*3,math.random()*3,math.random()*3),Color3.new(1,1,1),Enum.Material.Neon)
			cut.Transparency=.2;table.insert(streaks,cut)
		end
		last=now
	end)
	K.sound(K.anchorPart(ctx.fx.folder,ctx.vpos()),K.SOUND.whoosh,.7,.4)
end
CUE.timeStart=function(ctx)
	if ctx.timeStop and ctx.timeStop.Parent then ctx.timeStop:Destroy() end
	for _,s in ctx.streaks or {} do
		if s.Parent then K.tween(s,.25,{Transparency=1,Size=s.Size*Vector3.new(.2,.2,1)});Debris:AddItem(s,.3) end
	end
	for _,d in ctx.fx.folder:GetChildren() do if d.Name=="FlashKunai" then K.tween(d,.2,{Transparency=1}) end end
end
CUE.cutsLand=function(ctx)
	local p=ctx.vpos()
	for k=1,8 do
		local cut=K.block(ctx.fx.folder,Vector3.new(.1,4,.1),CFrame.new(p)*CFrame.Angles(k*.7,k*1.3,k*.4),ctx.look.edge,Enum.Material.Neon)
		K.tween(cut,.25,{Size=Vector3.new(.02,5,.02),Transparency=1})
		Debris:AddItem(cut,.3)
	end
	K.flash(ctx.fx.folder,p,ctx.look.core,1.5,8,.2,.1)
	K.sound(K.anchorPart(ctx.fx.folder,p),K.SOUND.swish,.9,1.1)
	K.sound(K.anchorPart(ctx.fx.folder,p),K.SOUND.heavy,.6,1)
end

-- Kakashi --------------------------------------------------------------
CUE.hounds=function(ctx)
	-- Kuchiyose: eight hounds burst out of the floor and pin the body
	local p=ctx.vpos()
	local rng=Random.new(9)
	local hounds={}
	for k=0,7 do
		local a=k/8*math.pi*2+.2
		local spot=ctx.floor(p)+Vector3.new(math.cos(a)*1.5,0,math.sin(a)*1.5)
		local look=CFrame.lookAt(spot,Vector3.new(p.X,spot.Y,p.Z))
		local dog=K.new("Model",{Name="Hound"},ctx.fx.folder)
		local tone=if k%3==0 then rgb(120,96,70) else rgb(70,70,80)
		local body=K.block(dog,Vector3.new(.9,.9,1.8),look*CFrame.new(0,-1.4,0),tone,Enum.Material.SmoothPlastic)
		local head=K.block(dog,Vector3.new(.7,.7,.8),look*CFrame.new(0,-1.1,-1.1),tone,Enum.Material.SmoothPlastic)
		local band=K.block(dog,Vector3.new(.72,.2,.82),look*CFrame.new(0,-.85,-1.1),rgb(40,50,90),Enum.Material.Fabric)
		local up=CFrame.new(0,1.4+rng:NextNumber()*.4,0)
		K.tween(body,.15,{CFrame=up*body.CFrame});K.tween(head,.15,{CFrame=up*head.CFrame});K.tween(band,.15,{CFrame=up*band.CFrame})
		K.smokePuff(ctx.fx.folder,spot+Vector3.new(0,.5,0),rgb(196,184,160),3,1)
		table.insert(hounds,dog)
	end
	task.delay(math.max(0,2.42-ctx.t()),function()
		for _,dog in hounds do
			local c=dog:GetPivot().Position
			K.smokePuff(ctx.fx.folder,c,rgb(236,236,240),3,1)
			dog:Destroy()
		end
	end)
	K.sound(K.anchorPart(ctx.fx.folder,p),K.SOUND.debris,.6,1.1,.8)
end
CUE.raikiriCharge=function(ctx)
	UltimateFX.handCharge(ctx.fx,ctx.casterModel,ctx.look,2.2,true)
	ctx.loop(2.45,function()
		if math.random()&lt;.3 then
			local hand=ctx.hand()
			if hand and K.sparks then K.sparks(ctx.fx.folder,hand.Position,ctx.look.edge,4,26) end
			if hand and math.random()&lt;.3 then K.shockRing(ctx.fx.folder,ctx.floor(hand.Position)+Vector3.new(0,.1,0),ctx.look.core,1,5,.2) end
		end
	end)
	K.sound(K.anchorPart(ctx.fx.folder,ctx.cpos()),K.SOUND.electric,.9,.7)
end
CUE.raikiriRun=function(ctx)
	scar(ctx,ctx.casterModel,2.45,ctx.look.edge)
	K.sound(K.anchorPart(ctx.fx.folder,ctx.cpos()),K.SOUND.electric,.9,1.2)
end

local function sequence(fx,impact,folder)
	local look=lookOf(impact.kind)
	local ctx=context(fx,impact,folder,look)
	fx.ultimateRun=ctx.token
	UltimateFX.banner(fx,impact.name,look.core,ctx.time)
	-- the world's grade, unless the sequence changes the world itself
	if impact.kind~="tsukuyomi" and impact.kind~="flash" then UltimateFX.grade(fx,look,ctx.time) end
	local spec=Scripts.KINDS[impact.kind or ""]
	for _,cue in (spec and spec.cues) or {} do
		local t,name=cue[1],cue[2]
		local function run()
			if not ctx.live() then return end
			if string.sub(name,1,5)=="text:" then UltimateFX.textPop(fx,string.sub(name,6),look.edge,42,.9);return end
			local fn=CUE[name]
			if fn then pcall(fn,ctx) end
		end
		if t&lt;=0 then run() else task.delay(t,run) end
	end
	fx.ultimateCtx=ctx
	K.sound(K.anchorPart(fx.folder,impact.position),K.SOUND.whoosh,.6,.7)
	return ctx
end
UltimateFX.sequence=sequence
UltimateFX.context=context

-- A ball of lightning held in the caster's right hand for `time` seconds
-- (white and long for the Raikiri).
function UltimateFX.handCharge(fx,model,look,time,big)
	local hand=model:FindFirstChild("RightHand") or model:FindFirstChild("Right Arm") or model:FindFirstChild("HumanoidRootPart")
	if not hand then return end
	local ball=K.block(fx.folder,Vector3.new(1,1,1)*(if big then 1.6 else 1.2),hand.CFrame,look.edge,Enum.Material.Neon)
	ball.Shape=Enum.PartType.Ball;ball.Name="HandCharge";ball.Transparency=.15
	local started=UltimateFX.clock()
	task.spawn(function()
		while ball.Parent and UltimateFX.clock()-started&lt;time do
			if hand.Parent then ball.CFrame=hand.CFrame*CFrame.new(0,-.6,0) end
			if math.random()&lt;.5 and K.sparks then K.sparks(fx.folder,ball.Position,look.core,3,18) end
			task.wait(.03)
		end
		if ball.Parent then ball:Destroy() end
	end)
	Debris:AddItem(ball,time+.2)
end
-- The eight trigrams: a ring on the floor with its eight marks.
function UltimateFX.trigrams(fx,center,look,time)
	local disc=K.block(fx.folder,Vector3.new(.06,16,16),CFrame.new(center)*CFrame.Angles(0,0,math.rad(90)),look.core,Enum.Material.Neon,"Part")
	disc.Name="Trigrams";disc.Shape=Enum.PartType.Cylinder;disc.Transparency=.75
	for k=0,7 do
		local angle=k*math.pi/4
		local mark=K.block(fx.folder,Vector3.new(1.6,.08,.3),CFrame.new(center+Vector3.new(math.cos(angle)*6.2,.05,math.sin(angle)*6.2))*CFrame.Angles(0,-angle,0),look.edge,Enum.Material.Neon)
		mark.Name="Trigram"
		Debris:AddItem(mark,time)
	end
	Debris:AddItem(disc,time)
end
-- (07/11, Studio: the clash was a white ring on the floor, over at once)
-- Rasengan into Chidori, the grind: for `duration` seconds the spinning blue
-- sphere and the crackling lightning press into each other between the two
-- held bodies, sparks thrown off where they meet; the burst follows (the
-- server's second "jutsuclash" contact).
local RASEN=rgb(120,190,255)
local RASEN_CORE=rgb(226,244,255)
local VOLT=rgb(176,214,255)
local function grind(fx,impact,folder)
	local mid=impact.position
	local line=impact.direction or Vector3.zAxis
	line=Vector3.new(line.X,0,line.Z)
	line=if line.Magnitude&gt;.05 then line.Unit else Vector3.zAxis
	local life=math.max(.15,impact.duration or .4)
	-- the Rasengan side: toward its holder (owner or victim of the contact)
	local towardRasen=if impact.rasengan==impact.victim then line else -line
	local holder=K.new("Model",{Name="JutsuGrind"},fx.folder)
	local sphere=K.block(holder,Vector3.one*1.9,CFrame.new(mid+towardRasen*1),RASEN,Enum.Material.Neon)
	sphere.Shape=Enum.PartType.Ball;sphere.Transparency=.35
	local core=K.block(holder,Vector3.one*1.1,CFrame.new(mid+towardRasen*1),RASEN_CORE,Enum.Material.Neon)
	core.Shape=Enum.PartType.Ball;core.Transparency=.1
	local rings={}
	for k=1,2 do
		local ring=K.block(holder,Vector3.new(.08,2.6,2.6),CFrame.new(mid+towardRasen*1),RASEN_CORE,Enum.Material.Neon)
		ring.Shape=Enum.PartType.Cylinder;ring.Transparency=.45;rings[k]=ring
	end
	local arcs=K.new("Model",{Name="Volt"},holder)
	local born=os.clock()
	local rng=Random.new()
	K.sound(K.anchorPart(fx.folder,mid),K.SOUND.electric,.55,1.1)
	K.sound(K.anchorPart(fx.folder,mid),K.SOUND.whoosh,.4,.6)
	task.spawn(function()
		local nextSpark=0
		while holder.Parent and os.clock()-born&lt;life do
			local t=os.clock()-born
			local swell=1+t/life*.5
			local at=mid+towardRasen*1
			sphere.Size=Vector3.one*1.9*swell;core.Size=Vector3.one*1.1*swell
			sphere.CFrame=CFrame.new(at);core.CFrame=CFrame.new(at)
			for k,ring in rings do ring.CFrame=CFrame.new(at)*CFrame.Angles(t*24*(if k==1 then 1 else -1),t*9,math.rad(90)*(k-1)) end
			-- the lightning: jagged arcs out of the other side into the sphere
			arcs:ClearAllChildren()
			local from=mid-towardRasen*1.2
			for _=1,7 do
				local a=from+Vector3.new(rng:NextNumber(-1,1),rng:NextNumber(-1,1),rng:NextNumber(-1,1))*.9
				local b=mid+Vector3.new(rng:NextNumber(-.6,.6),rng:NextNumber(-.6,.6),rng:NextNumber(-.6,.6))
				local last=a
				for k=1,3 do
					local q=if k==3 then b else a:Lerp(b,k/3)+Vector3.new(rng:NextNumber(-.3,.3),rng:NextNumber(-.3,.3),rng:NextNumber(-.3,.3))
					local len=(q-last).Magnitude
					if len&gt;.03 then K.block(arcs,Vector3.new(.08,.08,len),CFrame.lookAt(last:Lerp(q,.5),q),if rng:NextNumber()&lt;.35 then RASEN_CORE else VOLT,Enum.Material.Neon) end
					last=q
				end
			end
			if t&gt;=nextSpark then
				nextSpark=t+.08
				if K.sparks then K.sparks(fx.folder,mid,RASEN_CORE,6,24) end
			end
			task.wait(.03)
		end
		if holder.Parent then holder:Destroy() end
	end)
end
local function impact(fx,impact,folder)
	local style=impact.style
	local p=impact.position
	if style=="ultimateStart" then
		local look=lookOf(impact.kind)
		-- The Chidori and the Raikiri are formed at the press.
		if impact.kind=="lion" or impact.kind=="raikiri" then
			local caster=modelFor(folder,impact.owner)
			if caster then UltimateFX.handCharge(fx,caster,look,.5,impact.kind=="raikiri") end
		end
		K.flash(fx.folder,p,look.core,1,6,.18,.2)
		K.shockRing(fx.folder,p-Vector3.new(0,2.6,0),look.edge,2,12,.35)
		K.sound(K.anchorPart(fx.folder,p),K.SOUND.whoosh,.55,1.15)
		return true
	elseif style=="ultimate" then
		sequence(fx,impact,folder)
		return true
	elseif style=="ultimateTick" then
		-- A blow of the sequence: its own sound per fighter, the heavy ones
		-- louder, and the words that go with it (U! ZU! MA! KI!, the count).
		local look=lookOf(impact.kind)
		local quiet=impact.kind=="tsukuyomi" or impact.kind=="palms" or impact.kind=="pyramid"
		if not quiet then K.flash(fx.folder,p,look.edge,.4,if impact.heavy then 3.6 else 2.2,.08,.25) end
		local SND={clones=K.SOUND.punch,lion=K.SOUND.electric,pyramid=K.SOUND.debris,lotus=K.SOUND.punch,palms=K.SOUND.hit,tsukuyomi=K.SOUND.swish,flash=K.SOUND.swish,raikiri=K.SOUND.electric}
		K.sound(K.anchorPart(fx.folder,p),SND[impact.kind or ""] or K.SOUND.hit,if impact.heavy then .7 else .4,1+((impact.index or 0)%4)*.06,.6)
		if impact.heavy then K.sound(K.anchorPart(fx.folder,p),K.SOUND.heavy,.55,.9) end
		if impact.text and impact.kind~="pyramid" then
			local big=impact.kind=="clones" and #impact.text&lt;=2
			UltimateFX.textPop(fx,impact.text..(if big then "!" else ""),if impact.kind=="tsukuyomi" then rgb(255,60,60) else look.edge,if big then 110 else 54,if big then .32 else .55)
		end
		return true
	elseif style=="ultimateKunai" then
		local caster=rootOf(modelFor(folder,impact.owner))
		local from=if caster then caster.Position else p
		for i,point in impact.points or {} do task.delay((i-1)*.02,function() UltimateFX.kunai(fx,from,point,UltimateFX.LOOK.flash) end) end
		return true
	elseif style=="ultimateEnd" then
		local look=lookOf(impact.kind)
		-- (the sequence's own cues keep running to its end: a burst, a crater)
		task.delay(.35,function() if fx.ultimateCtx and fx.ultimateCtx.kind==impact.kind then fx.ultimateRun=nil end end)
		K.flash(fx.folder,p,look.core,1.2,9,.25,.15)
		K.shockRing(fx.folder,p-Vector3.new(0,2.4,0),look.core,3,18,.5)
		K.smokePuff(fx.folder,p-Vector3.new(0,2.4,0),rgb(206,194,168),12,2)
		K.sound(K.anchorPart(fx.folder,p),K.SOUND.boom,.7,.9)
		UltimateFX.closeBanner(fx)
		return true
	elseif style=="ultimateMiss" then
		fx.ultimateRun=nil
		K.smokePuff(fx.folder,p-Vector3.new(0,2.4,0),rgb(200,190,170),6,1.4)
		UltimateFX.closeBanner(fx)
		return true
	elseif style=="tsukuyomi" then
		local look=UltimateFX.LOOK.tsukuyomi
		K.shockRing(fx.folder,p,look.core,1,10,.6)
		-- The held body's player sees the red world; the caster only the ring.
		local mine=false
		pcall(function()
			local character=game:GetService("Players").LocalPlayer.Character
			mine=character~=nil and character.Name==impact.victim
		end)
		if mine then UltimateFX.grade(fx,look,impact.time or 1.5) end
		return true
	elseif style=="gate" then
		local tone=rgb(120,230,140)
		K.flash(fx.folder,p,tone,.8,4+(impact.gate or 1),.18,.25)
		K.shockRing(fx.folder,p-Vector3.new(0,2.6,0),tone,2,8+(impact.gate or 1)*2,.4)
		return true
	elseif style=="reveal" then
		K.flash(fx.folder,p,rgb(236,232,255),.6,3.2,.15,.3)
		return true
	-- (Stage 6) the interactions of Server/Interactions.
	elseif style=="steam" then
		-- A white cloud that holds for its time, puff after puff.
		local radius=impact.radius or 10
		local rng=Random.new(impact.serial or 3)
		for k=0,math.floor((impact.time or 3)/.3) do
			task.delay(k*.3,function()
				for _=1,3 do K.smokePuff(fx.folder,around(p,radius*.55,rng),rgb(238,240,244),5,radius*.35) end
			end)
		end
		K.flash(fx.folder,p,rgb(255,255,255),1,radius*.6,.2,.3)
		K.sound(K.anchorPart(fx.folder,p),K.SOUND.whoosh,.5,.6)
		return true
	elseif style=="puddle" then
		-- (Jutsu pass 05/11, user: « la flaque d'eau de Kakashi ») The water
		-- used to be one flat blue disc, 18 studs wide, drawn at the impact:
		-- where the dragon broke on a body that is chest height, so it hung in
		-- the air. Now it lies ON the floor under the impact: a wet patch of
		-- overlapping ovals (dark, glossy, see-through), spreading in, a few
		-- ripples while it lasts, soaking away at the end. Same area as the
		-- server's (Interactions.PUDDLE): lightning into it still conducts.
		local radius=impact.radius or 9
		local life=impact.time or 6
		local hit=K.floorUnder and K.floorUnder(fx,p,2,16)
		local ground=if hit then hit.Position else p-Vector3.new(0,2.9,0)
		local rng=Random.new(impact.serial or math.floor(p.X*7+p.Z*13))
		local holder=K.new("Model",{Name="Puddle"},fx.folder)
		local patches={}
		-- (06/11, user: « la flaque est mieux mais pas très belle ») It read
		-- as a flat sheet of blue plastic laid on the sand. Water over sand is
		-- mostly the sand, darker and glossy: three layers now -
		--   soaked ground: the floor's own colour darkened, ragged, wider
		--     than the water (the sand drank the edge);
		--   the water: barely blue, see-through over the soaked ground, very
		--     reflective (it mirrors the sky);
		--   a few bright glints of sky on it.
		local floorColor=if hit and hit.Instance and hit.Instance:IsA("BasePart") then hit.Instance.Color else rgb(196,168,120)
		local SOAK=floorColor:Lerp(rgb(40,34,30),.45)
		local WATER=rgb(78,110,132)
		local function patch(at,w,d,color,transparency,material,reflect,yaw)
			local part=K.block(holder,Vector3.new(w,.06,d),CFrame.new(at)*CFrame.Angles(0,yaw or rng:NextNumber(0,math.pi*2),0),color,material,"Part")
			K.new("SpecialMesh",{MeshType=Enum.MeshType.Sphere,Scale=Vector3.new(1,.4,1)},part)
			part.Reflectance=reflect or 0;part.Transparency=1;part.CastShadow=false
			table.insert(patches,{part=part,size=part.Size,transparency=transparency})
			return part
		end
		-- soaked ground: one body, lobes round it (opaque, one colour: no seams)
		patch(ground+Vector3.new(0,.02,0),radius*1.75,radius*1.5,SOAK,0,Enum.Material.SmoothPlastic)
		for k=1,8 do
			local a=k/8*math.pi*2+rng:NextNumber(-.3,.3)
			local off=Vector3.new(math.cos(a),0,math.sin(a))*radius*rng:NextNumber(.55,.85)
			local sz=radius*rng:NextNumber(.45,.75)
			patch(ground+off+Vector3.new(0,.018-k*.001,0),sz,sz*rng:NextNumber(.6,.9),SOAK,0,Enum.Material.SmoothPlastic)
		end
		-- the water: smaller than the soaked ground, see-through, glossy
		patch(ground+Vector3.new(0,.05,0),radius*1.35,radius*1.1,WATER,.45,Enum.Material.Glass,.45)
		for k=1,4 do
			local a=k/4*math.pi*2+rng:NextNumber(-.4,.4)
			local off=Vector3.new(math.cos(a),0,math.sin(a))*radius*rng:NextNumber(.3,.5)
			local sz=radius*rng:NextNumber(.45,.65)
			patch(ground+off+Vector3.new(0,.048,0),sz,sz*rng:NextNumber(.6,.85),WATER,.45,Enum.Material.Glass,.45)
		end
		-- glints of sky
		for k=1,3 do
			local off=Vector3.new(rng:NextNumber(-1,1),0,rng:NextNumber(-1,1))*radius*.4
			patch(ground+off+Vector3.new(0,.07,0),radius*rng:NextNumber(.12,.22),radius*rng:NextNumber(.04,.07),rgb(230,244,255),.35,Enum.Material.SmoothPlastic,0)
		end
		for _,entry in patches do
			entry.part.Size=entry.size*Vector3.new(.35,1,.35)
			K.tween(entry.part,.28,{Size=entry.size,Transparency=entry.transparency},Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
		end
		-- the splash where it lands (VFX Studio's water burst and droplets),
		-- then rings spreading on the water now and then (its ripple flipbook,
		-- laid flat on the surface)
		K.shockRing(fx.folder,ground+Vector3.new(0,.12,0),rgb(200,230,255),1,radius*1.6,.4)
		if K.SOUND and K.SOUND.splash then K.sound(K.anchorPart(fx.folder,ground),K.SOUND.splash,.7,.9) end
		local TEX=K.TEX or {}
		local water=K.new("Part",{Name="PuddleWater",Size=Vector3.new(.2,.2,.2),CFrame=CFrame.new(ground+Vector3.new(0,.12,0)),Transparency=1,
			Anchored=true,CanCollide=false,CanQuery=false,CanTouch=false},holder)
		local at=K.new("Attachment",{},water)
		if TEX.splash then
			local splash=K.new("ParticleEmitter",{Texture=TEX.splash,FlipbookLayout=Enum.ParticleFlipbookLayout.Grid8x8,FlipbookMode=Enum.ParticleFlipbookMode.OneShot,
				Rate=0,Lifetime=NumberRange.new(.55,.65),Speed=NumberRange.new(0,0),Color=ColorSequence.new(rgb(190,225,255)),LightEmission=.25,
				Size=K.num({{0,radius*.6},{1,radius*.9}}),Transparency=K.num({{0,.05},{1,.4}}),Rotation=NumberRange.new(0,360)},at)
			splash:Emit(2)
		end
		if TEX.droplets then
			local drops=K.new("ParticleEmitter",{Texture=TEX.droplets,FlipbookLayout=Enum.ParticleFlipbookLayout.Grid4x4,FlipbookMode=Enum.ParticleFlipbookMode.OneShot,
				Rate=0,Lifetime=NumberRange.new(.5,.8),Speed=NumberRange.new(8,16),SpreadAngle=Vector2.new(50,50),EmissionDirection=Enum.NormalId.Top,
				Acceleration=Vector3.new(0,-40,0),Color=ColorSequence.new(rgb(200,232,255)),LightEmission=.2,Size=K.num({{0,1.2},{1,.8}}),
				Transparency=K.num({{0,0},{1,.6}})},at)
			drops:Emit(10)
		end
		local ripples=TEX.ripple and K.new("ParticleEmitter",{Texture=TEX.ripple,FlipbookLayout=Enum.ParticleFlipbookLayout.Grid4x4,
			FlipbookMode=Enum.ParticleFlipbookMode.OneShot,Orientation=Enum.ParticleOrientation.VelocityPerpendicular,EmissionDirection=Enum.NormalId.Top,
			Rate=0,Lifetime=NumberRange.new(.9,1.1),Speed=NumberRange.new(.01,.01),Color=ColorSequence.new(rgb(205,232,255)),LightEmission=.15,
			Size=K.num({{0,1.5},{1,3.4}}),Transparency=K.num({{0,.25},{1,1}}),Rotation=NumberRange.new(0,360)},at)
		for k=1,math.floor((life-1)/.7) do
			task.delay(k*.7,function()
				if not holder.Parent then return end
				local a=rng:NextNumber(0,math.pi*2)
				local spot=Vector3.new(math.cos(a),0,math.sin(a))*radius*rng:NextNumber(0,.6)
				if ripples then
					at.Position=spot
					ripples:Emit(1)
				else
					K.shockRing(fx.folder,ground+spot+Vector3.new(0,.1,0),rgb(190,222,250),.4,2.6,.7)
				end
			end)
		end
		task.delay(math.max(0,life-.9),function()
			if not holder.Parent then return end
			for _,entry in patches do K.tween(entry.part,.9,{Transparency=1,Size=entry.size*Vector3.new(.8,1,.8)}) end
		end)
		Debris:AddItem(holder,life+.2)
		return true
	elseif style=="conduct" then
		local at=impact.position or p
		K.shockRing(fx.folder,at+Vector3.new(0,.2,0),rgb(170,210,255),1,(impact.radius or 9)*2,.35)
		if K.sparks then K.sparks(fx.folder,p,rgb(220,236,255),14,26) end
		K.sound(K.anchorPart(fx.folder,p),K.SOUND.electric,.6,1)
		return true
	elseif style=="sandmelt" then
		K.flash(fx.folder,p,rgb(255,150,60),.5,3,.18,.3)
		K.smokePuff(fx.folder,p-Vector3.new(0,1.6,0),rgb(214,176,112),5,1.2)
		return true
	elseif style=="jutsuclash" and impact.phase=="grind" then
		grind(fx,impact,folder)
		return true
	elseif style=="jutsuclash" then
		K.flash(fx.folder,p,rgb(236,246,255),1.5,12,.3,.1)
		K.shockRing(fx.folder,p,rgb(150,200,255),2,22,.5)
		K.shockRing(fx.folder,p-Vector3.new(0,2.4,0),rgb(255,255,255),2,16,.45)
		if K.sparks then K.sparks(fx.folder,p,rgb(200,226,255),24,34) end
		K.sound(K.anchorPart(fx.folder,p),K.SOUND.boom,.8,1.1)
		return true
	end
	return false
end
UltimateFX.impact=impact

function UltimateFX.install(FX,kit)
	K=kit
	table.insert(FX.layers,{name="Ultimate",impact=impact})
end
return UltimateFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND231">
          <Properties>
            <string name="Name">VelmoraHitFeedback</string>
            <ProtectedString name="Source">-- Impact presentation. Adapted from Velmora src/client/Combat/HitFeedback.luau
-- (Copyright (c) 2026 Yashveer Singh, MIT), extended with a style hierarchy so
-- small hits, finishers, launchers and slams do not feel identical.
-- Every effect is driven by a server-reported contact, never by a button press.
local Debris=game:GetService("Debris")
local TweenService=game:GetService("TweenService")
local Kit=require(script.Parent.VfxKit)
local Feedback={}
-- Audio stays on assets already imported and verified by this project; extra
-- cues are declared here so adding one later is a one-line change.
local AUDIO={light="rbxassetid://8595980577",heavy="rbxassetid://9117969717",whiff="rbxassetid://9126284094",
	-- (Reference quality) a crack and a body thud under the heavy blows.
	punch="rbxassetid://9117971636",body="rbxassetid://9113524242"}
local LAYERED={finisher=true,launcher=true,slam=true,wallbounce=true,clash=true}
local LOOPED={}
-- style -&gt; shard count, light range, colour, pitch, volume, tint of the target
local look={
 light   ={shards=5, range=7,  color=Color3.fromRGB(255,214,170),pitch=1.18,volume=.42,hit=Color3.fromRGB(255,238,214)},
 finisher={shards=6, range=9,  color=Color3.fromRGB(255,186,120),pitch=0.94,volume=.42,hit=Color3.fromRGB(255,220,180)},
 launcher={shards=5, range=9,  color=Color3.fromRGB(196,226,255),pitch=0.86,volume=.40,hit=Color3.fromRGB(226,240,255)},
 air     ={shards=6, range=8,  color=Color3.fromRGB(212,232,255),pitch=1.06,volume=.34,hit=Color3.fromRGB(232,244,255)},
 slam    ={shards=9,range=13, color=Color3.fromRGB(255,158,96),pitch=0.72,volume=.52,hit=Color3.fromRGB(255,206,168)},
 block   ={shards=8, range=9,  color=Color3.fromRGB(226,206,150),pitch=1.32,volume=.34,hit=Color3.fromRGB(240,228,190)},
 parry   ={shards=7,range=11, color=Color3.fromRGB(255,244,168),pitch=1.42,volume=.46,hit=Color3.fromRGB(255,250,214)},
 jutsu   ={shards=6,range=11, color=Color3.fromRGB(255,146,92),pitch=0.9, volume=.44,hit=Color3.fromRGB(255,196,150)},
 kunai   ={shards=4, range=6,  color=Color3.fromRGB(206,216,226),pitch=1.34,volume=.26,hit=Color3.fromRGB(230,236,242)},
 shuriken={shards=4, range=6,  color=Color3.fromRGB(198,210,224),pitch=1.5, volume=.24,hit=Color3.fromRGB(230,236,242)},
 dodge   ={shards=5, range=6,  color=Color3.fromRGB(168,206,238),pitch=1.26,volume=.22,hit=Color3.fromRGB(206,226,242)},
 substitute={shards=7,range=8, color=Color3.fromRGB(196,196,214),pitch=1.0, volume=.30,hit=Color3.fromRGB(226,226,240)},
 whiff   ={shards=2, range=4,  color=Color3.fromRGB(176,188,200),pitch=1.6, volume=.14,hit=Color3.fromRGB(200,208,218)},
 landing ={shards=6, range=7,  color=Color3.fromRGB(170,158,132),pitch=0.8, volume=.26,hit=Color3.fromRGB(206,196,172)},
 wall    ={shards=5, range=8,  color=Color3.fromRGB(184,178,158),pitch=0.86,volume=.30,hit=Color3.fromRGB(214,208,186)},
 wallbounce={shards=8,range=12,color=Color3.fromRGB(255,206,150),pitch=0.74,volume=.48,hit=Color3.fromRGB(255,224,190)},
 clash   ={shards=9, range=12, color=Color3.fromRGB(255,240,190),pitch=1.25,volume=.5, hit=Color3.fromRGB(255,250,224)},
 walltech={shards=4, range=6,  color=Color3.fromRGB(206,222,255),pitch=1.3, volume=.22,hit=Color3.fromRGB(226,236,255)},
 pin     ={shards=3, range=5,  color=Color3.fromRGB(220,224,232),pitch=1.5, volume=.22,hit=Color3.fromRGB(236,240,246)},
 ember   ={shards=4, range=7,  color=Color3.fromRGB(255,170,90),pitch=1.1, volume=.26,hit=Color3.fromRGB(255,214,170)},
 palm    ={shards=3, range=6,  color=Color3.fromRGB(196,212,255),pitch=1.3, volume=.26,hit=Color3.fromRGB(226,234,255)},
 flow    ={shards=4, range=7,  color=Color3.fromRGB(214,232,255),pitch=1.45,volume=.3, hit=Color3.fromRGB(236,244,255)},
 awaken  ={shards=8, range=14, color=Color3.fromRGB(255,236,190),pitch=0.7, volume=.5, hit=Color3.fromRGB(255,244,220)},
 palmburst={shards=6,range=10, color=Color3.fromRGB(214,226,255),pitch=0.9, volume=.38,hit=Color3.fromRGB(232,238,255)},
 deflect ={shards=4, range=6,  color=Color3.fromRGB(226,236,255),pitch=1.5, volume=.22,hit=Color3.fromRGB(240,244,255)},
 repel   ={shards=7, range=11, color=Color3.fromRGB(200,216,255),pitch=0.84,volume=.44,hit=Color3.fromRGB(228,236,255)},
 rotation={shards=2, range=10, color=Color3.fromRGB(200,216,255),pitch=0.7, volume=.2, hit=Color3.fromRGB(228,236,255)},
 trigram ={shards=0, range=9,  color=Color3.fromRGB(200,216,255),pitch=0.8, volume=.16,hit=Color3.fromRGB(228,236,255)},
}
local function anchorAt(position)
	local anchor=Instance.new("Part")
	anchor.Name="LocalImpact";anchor.Anchored=true;anchor.CanCollide=false;anchor.CanQuery=false
	anchor.Transparency=1;anchor.Size=Vector3.one;anchor.Position=position;anchor.Parent=workspace
	return anchor
end
local function playSound(parent,id,pitch,volume)
	if not id then return end
	local sound=Instance.new("Sound")
	sound.SoundId=id;sound.Volume=volume or .3;sound.PlaybackSpeed=pitch or 1
	sound.RollOffMaxDistance=120;sound.Parent=parent
	sound:Play()
	Debris:AddItem(sound,2)
end
function Feedback.burst(position,color,damage,blocked)
	local anchor=anchorAt(position)
	local light=Instance.new("PointLight");light.Color=color;light.Brightness=(if blocked then 5 else 3);light.Range=(if blocked then 11 else 8);light.Parent=anchor
	TweenService:Create(light,TweenInfo.new(.2),{Brightness=0}):Play()
	for i=1,(if blocked then 10 else 7) do
		local shard=Instance.new("Part");shard.Anchored=true;shard.CanCollide=false;shard.CanQuery=false;shard.Material=Enum.Material.Neon;shard.Color=color;shard.Size=Vector3.new(.08,.08,math.random(5,11)/10);shard.CFrame=CFrame.lookAt(position,position+Vector3.new(math.random()-0.5,math.random()-0.5,math.random()-0.5));shard.Parent=workspace
		TweenService:Create(shard,TweenInfo.new(.18,Enum.EasingStyle.Quad),{CFrame=shard.CFrame*CFrame.new(0,0,-math.random(2,5)),Transparency=1}):Play();Debris:AddItem(shard,.22)
	end
	if damage and damage&gt;0 then
		local bill=Instance.new("BillboardGui");bill.Size=UDim2.fromOffset(80,40);bill.StudsOffset=Vector3.new(0,2.5,0);bill.AlwaysOnTop=true;bill.Parent=anchor
		local label=Instance.new("TextLabel");label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=1;label.Text=string.format("-%d",math.floor(damage+.5));label.TextColor3=color;label.TextStrokeTransparency=.15;label.Font=Enum.Font.GothamBlack;label.TextScaled=true;label.Parent=bill
		TweenService:Create(bill,TweenInfo.new(.45),{StudsOffset=Vector3.new(0,4.5,0)}):Play();TweenService:Create(label,TweenInfo.new(.45),{TextTransparency=1,TextStrokeTransparency=1}):Play()
	end
	Debris:AddItem(anchor,.55)
end
-- One contact, one coherent reaction. Only the layers the style warrants.
-- Moves that are not a body contact (a dodge, a substitution, a wall tech, a
-- spin) sound like air, never like a punch; flow rides on its "light" entry.
local AIR_CUE={whiff=true,dodge=true,substitute=true,walltech=true,rotation=true,deflect=true}
-- Real contacts without a look of their own keep the generic hit layer.
local CONTACT_FALLBACK={fire=true,fireball=true,chidori=true,groundbounce=true,sandhit=true,sandburst=true,sandburial=true,sandshield=true}
-- Body contacts drawn with the project's own textures (Client/VfxKit): the
-- flash where the blow met the body, a crescent across the strike, streaks
-- thrown along it, a ring, and for the heavy ones the floor answering.
-- weight 0..1: how much of each layer.
local WEIGHT={light=.32,air=.42,flow=.3,kunai=.22,shuriken=.2,pin=.2,palm=.3,block=.45,parry=.8,clash=.9,
	finisher=.75,launcher=.8,slam=1,wallbounce=.9,jutsu=.6,awaken=.6,repel=.7,palmburst=.6}
local SLASH={light=true,air=true,finisher=true,launcher=true,slam=true,flow=true,clash=true}
local function strikeLayers(style,position,impact,spec)
	local w=WEIGHT[style]
	if not w or not Kit.has("star") then return false end
	local folder=workspace:FindFirstChild("NinjaDuelFX") or workspace
	local dir=impact and impact.direction
	if not dir or dir.Magnitude&lt;.05 then dir=Vector3.new(math.random()-.5,0,math.random()-.5) end
	if dir.Magnitude&lt;.05 then dir=Vector3.zAxis end
	dir=dir.Unit
	local guard=style=="block" or style=="parry"
	local color=if guard then Color3.fromRGB(255,226,140) else Color3.fromRGB(255,250,236)
	local hot=if style=="slam" or style=="finisher" or style=="launcher" then Color3.fromRGB(255,190,120) else color
	Kit.star(folder,position,2.2+4.6*w,color,.07+.07*w)
	Kit.streaks(folder,position,dir,math.floor(5+12*w),hot,45+50*w,if guard then 70 else 38)
	local camera=workspace.CurrentCamera
	local toCamera=if camera then (camera.CFrame.Position-position) else -dir
	if toCamera.Magnitude&lt;.05 then toCamera=Vector3.zAxis end
	toCamera=toCamera.Unit
	-- The ring stands across the strike, tilted toward the viewer so it reads.
	local ringNormal=(dir+toCamera*.6).Unit
	local up=if math.abs(ringNormal.Y)&gt;.95 then Vector3.xAxis else Vector3.yAxis
	local ringCF=CFrame.lookAt(position,position+ringNormal,up)
	Kit.plane(folder,ringCF,"ring",Vector2.new(1.2,1.2)*(1+w),Vector2.new(5,5)*(1+w*1.6),.12+.1*w,hot,0)
	if SLASH[style] then
		-- A crescent drawn across the blow, facing the camera.
		local across=dir:Cross(toCamera)
		local roll=math.atan2(across.Y,math.sqrt(across.X^2+across.Z^2))+(math.random()-.5)*.9
		local slashCF=CFrame.lookAt(position,position+toCamera)*CFrame.Angles(0,0,roll)
		Kit.plane(folder,slashCF,"slash",Vector2.new(4,2)*(.8+w),Vector2.new(6.5,3.2)*(.8+w),.1+.06*w,color,0)
	end
	if style=="slam" or style=="wallbounce" or style=="launcher" then
		local me=game:GetService("Players").LocalPlayer.Character
		local floor=Kit.floorUnder(position,{folder,if me and me.Parent then me.Parent else folder},9)
		if floor then
			Kit.dust(folder,floor.Position,math.floor(6+10*w),2.2+1.6*w,Color3.fromRGB(214,200,172),12+10*w)
		end
	end
	return true
end
function Feedback.impact(style,position,impact)
	-- Only styles with a contact look get shards and a hit sound. Casts, chases,
	-- fades, sticks and afterimages have their own effects (FX:impact).
	local spec=look[style] or (CONTACT_FALLBACK[style] and look.light)
	if not spec then return end
	local anchor=anchorAt(position)
	local cue=(if style=="light" then "light" elseif AIR_CUE[style] then "whiff" else "heavy")
	-- (FEEL 05/11) never twice the same pitch: a string of lights was one
	-- sample repeated.
	if style~="flow" then playSound(anchor,AUDIO[cue],spec.pitch*(.94+math.random()*.12),spec.volume) end
	-- and a light or air blow lands in a body: a soft thud under it.
	if style=="light" or style=="air" then playSound(anchor,AUDIO.body,1.2+math.random()*.15,.22) end
	if LAYERED[style] then
		playSound(anchor,AUDIO.punch,.95+math.random()*.1,.45)
		playSound(anchor,AUDIO.body,1.1,.35)
	end
	local light=Instance.new("PointLight")
	light.Color=spec.color;light.Brightness=(if style=="parry" or style=="slam" then 8 else 4)
	light.Range=spec.range;light.Parent=anchor
	TweenService:Create(light,TweenInfo.new(if style=="slam" then .28 else .17),{Brightness=0}):Play()
	Debris:AddItem(anchor,2)
	local ok,drawn=pcall(strikeLayers,style,position,impact,spec)
	if ok and drawn then return spec end
	local spread=if style=="slam" then 1.1 elseif style=="whiff" then 2.4 else .7
	local distance=if style=="whiff" then 2 else math.max(1.4,spec.range*.32)
	for _=1,spec.shards do
		local direction=Vector3.new(math.random()-0.5,math.random()-0.5,math.random()-0.5)
		if direction.Magnitude&lt;.01 then direction=Vector3.yAxis end
		local shard=Instance.new("Part")
		shard.Anchored=true;shard.CanCollide=false;shard.CanQuery=false;shard.Material=Enum.Material.Neon
		shard.Color=spec.color;shard.Size=Vector3.new(.08,.08,math.random(5,12)/10)
		shard.CFrame=CFrame.lookAt(position,position+direction.Unit)*CFrame.Angles(0,0,math.random()*math.pi)
		shard.Parent=workspace
		local travel=CFrame.new(direction.Unit*(distance*(0.6+math.random()*.8)*spread))
		TweenService:Create(shard,TweenInfo.new(if style=="slam" then .26 else .18,Enum.EasingStyle.Quad),{CFrame=shard.CFrame*travel,Transparency=1}):Play()
		Debris:AddItem(shard,.3)
	end
	if style=="wall" then
		-- Wall dust: a flat puff pushed away from the surface, no screen shake.
		for i=1,7 do
			local puff=Instance.new("Part")
			puff.Anchored=true;puff.CanCollide=false;puff.CanQuery=false
			puff.Material=Enum.Material.Slate;puff.Color=Color3.fromRGB(176,170,152)
			puff.Size=Vector3.new(.3,.3,.3);puff.Transparency=.35
			puff.CFrame=CFrame.new(position+Vector3.new((math.random()-.5)*2,(math.random()-.5)*2,(math.random()-.5)*2))
			puff.Parent=workspace
			TweenService:Create(puff,TweenInfo.new(.32,Enum.EasingStyle.Quad),
				{Size=Vector3.new(1.6,1.6,1.6),Transparency=1}):Play()
			Debris:AddItem(puff,.38)
		end
	end
	if style=="slam" or style=="landing" then
		local ring=Instance.new("Part")
		ring.Anchored=true;ring.CanCollide=false;ring.CanQuery=false;ring.Material=Enum.Material.Neon
		ring.Color=spec.color;ring.Shape=Enum.PartType.Cylinder;ring.Size=Vector3.new(.12,3,3)
		ring.CFrame=CFrame.new(position-Vector3.new(0,2.4,0))*CFrame.Angles(0,0,math.pi/2)
		ring.Transparency=.25;ring.Parent=workspace
		TweenService:Create(ring,TweenInfo.new(.28,Enum.EasingStyle.Quad),{Size=Vector3.new(.12,13,13),Transparency=1}):Play()
		Debris:AddItem(ring,.34)
	end
	return spec
end
-- Hitstop-scaled impulse; the camera reads this instead of re-deriving it.
function Feedback.impulse(style)
	local spec=look[style] or look.light
	return {shake=spec.range/26, fov=(spec.range-6)*.42}
end
return Feedback
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND232">
          <Properties>
            <string name="Name">VelmoraMotionEngine</string>
            <ProtectedString name="Source">-- Ninja Duel body animation. Started from Velmora's additive R15 layer (MIT) and
-- rebuilt into a full-body authored animation system:
--
--  * the presentation owns every joint it animates (it keeps its own pose state
--    instead of blending against whatever the Animator wrote this frame);
--  * grounded poses place the feet with two-bone leg IK, so stances crouch,
--    lunge and land with planted feet instead of floating or sliding;
--  * attacks, throws, hand signs and reactions are multi-key clips authored with
--    anatomical controls (raise / out / twist / elbow ...), so elbows and knees
--    bend the right way;
--  * locomotion is a real gait: stride, foot lift, pelvis/torso counter-twist,
--    arm swing, and the anime "ninja run" when sprinting or chasing.
--
-- Every joint is damped towards its target with an angular speed limit, so no
-- state change can snap the body. Presentation only: combat authority stays on
-- the server.
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Attacks=require(Shared.Attacks)
local Fighters=require(Shared.Fighters)
local SealJutsu=require(game:GetService("ReplicatedStorage").NinjaDuel.SealJutsu)
-- Weapon models come from the VFX module; required lazily so headless tools
-- that only pose skeletons do not need its services.
local Effects=nil
-- Blender-authored clips (Client/AuthoredMotion): where one exists for a
-- strike or a technique, it replaces the procedural pose below.
local Authored=nil
local guardStep -- (feel audit 07/11) defined with guardTargets
do
	local okA,mod=pcall(function() return require(script.Parent.AuthoredMotion) end)
	if okA then Authored=mod end
end
local Motion={}
Motion.Authored=Authored
local rad=math.rad
local CF=CFrame.new
local ANG=CFrame.Angles
local IDENTITY=CFrame.identity

local JOINTS={
	Root={"HumanoidRootPart","Root"},Waist={"LowerTorso","Waist"},Neck={"UpperTorso","Neck"},
	Right={"UpperTorso","RightShoulder"},Left={"UpperTorso","LeftShoulder"},
	RightElbow={"RightUpperArm","RightElbow"},LeftElbow={"LeftUpperArm","LeftElbow"},
	RightWrist={"RightLowerArm","RightWrist"},LeftWrist={"LeftLowerArm","LeftWrist"},
	RightHip={"LowerTorso","RightHip"},LeftHip={"LowerTorso","LeftHip"},
	RightKnee={"RightUpperLeg","RightKnee"},LeftKnee={"LeftUpperLeg","LeftKnee"},
	RightAnkle={"RightLowerLeg","RightAnkle"},LeftAnkle={"LeftLowerLeg","LeftAnkle"},
}
local UPPER={Waist=true,Neck=true,Right=true,Left=true,RightElbow=true,LeftElbow=true,RightWrist=true,LeftWrist=true}

-- ------------------------------------------------------------------ state
local states=setmetatable({},{__mode="k"})
local function stateOf(char)
	local s=states[char]
	if not s then s={motors={},pose={},phase=0,clock=0,inert={},vel={}};states[char]=s end
	return s
end
local function motor(char,key)
	local s=stateOf(char)
	local cached=s.motors[key]
	if cached~=nil then return cached or nil end
	local d=JOINTS[key];local part=char and char:FindFirstChild(d[1]);local m=part and part:FindFirstChild(d[2])
	local found=if m and m:IsA("Motor6D") then m else nil
	-- Only cache a positive lookup: a rig can still be assembling.
	if found then s.motors[key]=found end
	return found
end
-- A simulated presentation clock advanced once per rendered frame: identical on
-- 30 Hz and 120 Hz clients, deterministic in tests.
local elapsedTime=0
function Motion.tick(dt)
	if dt and dt&gt;0 then elapsedTime+=math.min(dt,.1) end
	return elapsedTime
end
function Motion.now() return elapsedTime end
-- Tests: two poses compared at the same moment of a captured idle (DEC-032).
function Motion._setClock(t) elapsedTime=t end

-- Damping rate per layer, and a hard angular speed limit (deg/s) so a sudden
-- target change still travels instead of teleporting.
local RATE={attack=42,throw=32,cast=24,recoil=36,guard=26,defense=26,locomotion=22,air=14,ground=12,wall=16,chase=22,chainIn=26,kick=43,
	-- Blender-authored body motion is already the final curve: played almost
	-- as is (a frame of smoothing only to join one clip to the next).
	authored=48}
local KICK_SPEED=1600 -- deg/s cap for a free (kicking) leg during a strike
local CHAIN_IN=.08 -- seconds of a chained strike during which the upper body eases in
local CHAIN_IN_SPEED=800 -- deg/s cap per upper-body joint meanwhile (a strike may whip at 2280)
local MAX_SPEED=1750
-- deg/s: the fastest any authored joint turns (a sprint thigh peaks ~1200,
-- a kick ~1500). The reference footage never moves a limb more than ~25 deg
-- between two 60 Hz frames outside a speed smear. The kunai string (ANIM-005)
-- whips a slash over 2-3 frames and turns a somersault in 9: up to ~35 deg
-- per frame on the arm and the pelvis, so the cap sits above that (a real
-- flip is still drawn over its own frames, a 180 deg pop is still split).
local AUTHORED_SPEED=2200
local function angleBetween(a,b)
	local _,angle=(a:Inverse()*b):ToAxisAngle()
	return math.abs(angle)
end
-- Above this a planted leg's turn in one frame is a hand-over between two
-- poses, not the body's own motion (see apply, the feet).
local LEG_HANDOVER=math.rad(50)
-- (ANIM-002) Inertialization: when the body changes clip (a strike out of
-- the run, the next blow of a string, a landing, a hit), the new clip plays
-- at its own authored spacing at once and the difference with the body as it
-- was drawn - its pose and its velocity - is carried as an offset that decays
-- on a critically damped spring. Nothing snaps and nothing lags: the old
-- motion flows into the new one (Bollo, "High Performance Animation in Gears
-- of War 4", SIGGRAPH 2017; Holden's spring formulation).
local LN2=0.69314718
local function damper(x,v,half,dt)
	local y=(4*LN2/math.max(half,1e-3))*.5
	local j1=v+x*y
	local e=math.exp(-y*dt)
	return (x+j1*dt)*e,(v-j1*y*dt)*e
end
local function rotVec(cf)
	local axis,angle=cf:ToAxisAngle()
	if angle&gt;math.pi then angle-=2*math.pi end
	if angle~=angle or axis~=axis then return Vector3.zero end
	return axis*angle
end
local function fromRot(v)
	local m=v.Magnitude
	if m&lt;1e-6 then return IDENTITY end
	return CFrame.fromAxisAngle(v/m,m)
end
Motion._damper=damper
-- Write one joint: damp the owned pose towards the target, limit the angular
-- step, then publish it as the Motor6D transform.
local function write(char,key,target,rate,dt)
	local joint=motor(char,key)
	if not joint then return end
	local s=stateOf(char)
	if not dt then s.pose[key]=target;joint.Transform=target;return end
	local current=s.pose[key] or joint.Transform
	local inert=s.inert[key]
	if s.capture and rate==RATE.authored then
		-- A new clip: carry the body's drawn pose and velocity as an offset.
		local off=target:Inverse()*current
		local vel=s.vel[key]
		inert={r=rotVec(off),p=off.Position,vr=vel and vel.w or Vector3.zero,vp=vel and vel.v or Vector3.zero,half=s.capture,t0=target}
		if inert.vr.Magnitude&gt;25 then inert.vr=inert.vr.Unit*25 end
		s.inert[key]=inert
	elseif inert and inert.t0 then
		-- Second frame: the offset's velocity is the old motion minus the new one.
		local tv=rotVec(inert.t0:Inverse()*target)/dt
		inert.vr-=tv;inert.vp-=(target.Position-inert.t0.Position)/dt
		inert.t0=nil
	end
	local desired=target
	if inert then
		inert.r,inert.vr=damper(inert.r,inert.vr,inert.half,dt)
		inert.p,inert.vp=damper(inert.p,inert.vp,inert.half,dt)
		if inert.r.Magnitude&lt;1e-3 and inert.vr.Magnitude&lt;1e-2 and inert.p.Magnitude&lt;1e-3 and inert.vp.Magnitude&lt;1e-2 then
			s.inert[key]=nil
		else
			desired=target*(CF(inert.p)*fromRot(inert.r))
		end
	end
	local nextCF
	if rate==RATE.authored then
		-- Authored motion is the final curve: drawn as is (with its transition
		-- offset). (Fluidity pass, reference: no limb ever jumps.) A joint
		-- turns at most AUTHORED_SPEED: a whip is drawn over two or three
		-- frames instead of one, the eye reads motion, not a pop.
		nextCF=desired
		local step=angleBetween(current,nextCF)
		-- (The Root is the whole body turning in the air - a salto, a spin -
		-- not a limb: it may turn up to 60 deg a frame.)
		local limit=rad(if key=="Root" then 3600 else AUTHORED_SPEED)*dt
		if step&gt;limit and step&gt;1e-6 then nextCF=current:Lerp(nextCF,limit/step) end
	else
		local alpha=1-math.exp(-(rate or RATE.locomotion)*dt)
		nextCF=current:Lerp(desired,alpha)
		local step=angleBetween(current,nextCF)
		-- Strikes may whip faster than ordinary motion so their shape reads.
		local limit=rad(if rate==RATE.chainIn then CHAIN_IN_SPEED elseif rate==RATE.kick then KICK_SPEED elseif (rate or 0)&gt;=RATE.attack then 2280 else MAX_SPEED)*dt
		if step&gt;limit and step&gt;1e-6 then nextCF=current:Lerp(nextCF,limit/step) end
	end
	-- Translation (only the Root carries any) is speed-limited too.
	local move=nextCF.Position-current.Position
	-- (The salto drops the hips ~1 stud a frame onto its landing: authored
	-- motion may carry the Root that fast, or the feet land late.)
	local maxMove=(if rate==RATE.authored then 90 else 14)*dt
	if move.Magnitude&gt;maxMove then nextCF=CF(current.Position+move.Unit*maxMove)*nextCF.Rotation end
	-- The drawn velocity (joint space), for the next transition.
	local vel=s.vel[key] or {}
	vel.w=rotVec(current:Inverse()*nextCF)/dt;vel.v=(nextCF.Position-current.Position)/dt
	s.vel[key]=vel
	s.pose[key]=nextCF
	joint.Transform=nextCF
end
local LEG_SIDE={RightHip="R",RightKnee="R",RightAnkle="R",LeftHip="L",LeftKnee="L",LeftAnkle="L"}
local legIK
-- Name the clip the next apply() draws: a change of name is a transition
-- (inertialized over `half` seconds when the new clip is authored).
local function mark(char,key,half)
	local s=stateOf(char)
	s.markKey=key;s.markHalf=half or .1
end
Motion._mark=mark
local KUNAI_ARM={Right=true,RightElbow=true,RightWrist=true}
local function apply(char,targets,rate,dt,upperRate,legRate)
	local s=stateOf(char)
	local key=s.markKey or ("proc:"..tostring(rate))
	if key~=s.lastMarkKey then
		if s.lastMarkKey~=nil and dt then s.capture=if s.markKey then s.markHalf or .1 else .06 end
		s.lastMarkKey=key
	end
	s.markKey=nil
	local feet=targets.__feet
	-- Global kunai (DEC-030): the drawn blade's arm, laid over any body pose.
	local held=s.armOverlay
	for key in JOINTS do
		local side=LEG_SIDE[key]
		if not (feet and side and feet[side]) then
			local r=if upperRate and UPPER[key] then upperRate elseif legRate and side then legRate else rate
			local target=targets[key] or IDENTITY
			if held and KUNAI_ARM[key] and held.pose[key] then target=target:Lerp(held.pose[key],held.w) end
			write(char,key,target,r,dt)
		end
	end
	s.capture=nil
	if feet then
		-- The hips are damped; a planted foot must not be. Solve each planted leg
		-- against the hips as drawn this frame and set it almost at once.
		local hips=s.pose.Root or targets.Root
		s.ikOn=s.ikOn or {};s.ikEnter=s.ikEnter or {}
		for side,f in feet do
			local prefix=if side=="R" then "Right" else "Left"
			local target=f.ankle
			-- (ANIM-005) A leg handed from a drawn pose (a get-up, an air pose,
			-- a reaction) to the feet solver starts from where its ankle was and
			-- reaches the solver's spot over 0.1 s; it jumped there in one frame.
			if not s.ikOn[side] and dt and s.pose[prefix.."Hip"] then
				local sg=if side=="R" then 1 else -1
				local from=(s.pose.Root or IDENTITY)*CF(.5*sg,-.55,0)*(s.pose[prefix.."Hip"] or IDENTITY)*CF(0,-1.05,0)
					*(s.pose[prefix.."Knee"] or IDENTITY)*CF(0,-1,0)
				local rootPart=char:FindFirstChild("HumanoidRootPart")
				-- (held in the world: a lerp in root space crept with the body)
				if rootPart and (from.Position-target).Magnitude&gt;.3 then
					s.ikEnter[side]={from=rootPart.CFrame:PointToWorldSpace(from.Position),at=elapsedTime}
				end
			end
			-- (An authored clip's planted foot is exact; the hand-over blend only
			-- carries a foot that is still on its way.)
			if f.planted and rate==RATE.authored then s.ikEnter[side]=nil end
			local enter=s.ikEnter[side]
			if enter then
				local u=(elapsedTime-enter.at)/.1
				local rootPart=char:FindFirstChild("HumanoidRootPart")
				if u&gt;=1 or not rootPart then s.ikEnter[side]=nil else
					u=math.max(u,0);target=rootPart.CFrame:PointToObjectSpace(enter.from):Lerp(target,u*u*(3-2*u))
				end
			end
			local hip,knee,ankle=legIK(hips,if side=="R" then 1 else -1,target,f.yaw,f.toe)
			for _,j in {prefix.."Hip",prefix.."Knee",prefix.."Ankle"} do s.inert[j]=nil end
			-- (Authored: exact, a damped leg lets the foot creep with the body.)
			local legRate2=if rate==RATE.authored then RATE.authored else 60
			-- (A foot planted by an authored clip is exact: its knee and hip go
			-- where the hips take them this frame. Speed-capped, the leg lagged
			-- behind a landing and the "planted" foot slid down onto the floor.)
			-- (Fluidity audit 05/11) ...unless the leg would turn more than
			-- LEG_HANDOVER in one frame: a new clip, a reaction or the end of a
			-- dodge hands the planted leg a new pose (Studio: knee 141 deg and
			-- hip 170 deg on the first frame of Lee's DashAttack; headless:
			-- 113-116 deg on every DashAttack start, 101 on the KneeStrike, 81-94
			-- on a Grab, a Knockback, the end of a Dodging). That hand-over is
			-- speed-capped like every other joint; a landing's fold stays exact.
			local legDt=dt
			if rate==RATE.authored and f.planted and not enter then
				local jump=0
				for j,cf in {[prefix.."Hip"]=hip,[prefix.."Knee"]=knee,[prefix.."Ankle"]=ankle} do
					local was=s.pose[j]
					if was then jump=math.max(jump,angleBetween(was,cf)) end
				end
				if jump&lt;=LEG_HANDOVER then legDt=nil end
			end
			write(char,prefix.."Hip",hip,legRate2,legDt);write(char,prefix.."Knee",knee,legRate2,legDt);write(char,prefix.."Ankle",ankle,legRate2,legDt)
		end
	end
	s.ikOn=s.ikOn or {}
	s.ikOn.R=feet~=nil and feet.R~=nil;s.ikOn.L=feet~=nil and feet.L~=nil
end

-- ------------------------------------------------------------- pose builder
-- Anatomical controls, degrees / studs:
--   root  {x,y,z,pitch,yaw,roll}  pitch + leans forward, yaw + turns right,
--         roll + tilts the top to the right; y &lt; 0 crouches.
--   torso {pitch,yaw,roll}         same conventions, upper body on the hips.
--   head  {pitch,yaw,roll}
--   ra/la {raise,out,twist,elbow,wrist,wroll}  raise + lifts the arm forward,
--         out + away from the body, twist + rotates it inward, elbow + flexes.
--   rf/lf {x,y,z,yaw,toe}  IK foot target offset from the rest ankle (x right,
--         z backwards, y up) for planted feet;
--   rl/ll {lift,out,twist,knee,ankle}  free leg (air, kicks): lift + raises the
--         thigh forward, knee + flexes.
local L1,L2=1.05,1.0
local ANKLE_Y=-2.6 -- rest ankle height relative to HumanoidRootPart centre
local function ori(o)
	if not o then return IDENTITY end
	return ANG(rad(-(o.pitch or 0)),rad(-(o.yaw or 0)),rad(-(o.roll or 0)))
end
local function armCF(side,a)
	a=a or {}
	local shoulder=ANG(rad(a.raise or 0),0,0)*ANG(0,0,rad((a.out or 0)*side))*ANG(0,rad((a.twist or 0)*side),0)
	return shoulder,ANG(rad(a.elbow or 0),0,0),ANG(rad(a.wrist or 0),0,rad((a.wroll or 0)*side))
end
local function legFK(side,l)
	l=l or {}
	return ANG(rad(l.lift or 0),0,0)*ANG(0,0,rad((l.out or 0)*side))*ANG(0,rad((l.twist or 0)*side),0),ANG(rad(-(l.knee or 0)),0,0),ANG(rad(l.ankle or 0),0,0)
end
-- Two-bone IK in the LowerTorso frame: thigh/shin lengths are the rig's real
-- joint spacing; knees point forward (and a little out); the foot stays flat.
function legIK(rootCF,side,ankle,footYaw,toe)
	local hip=rootCF*Vector3.new(.5*side,-.55,0)
	local inv=rootCF.Rotation:Inverse()
	local d=inv*(ankle-hip)
	local u=if d.Magnitude&gt;1e-4 then d.Unit else Vector3.new(0,-1,0)
	local D=math.clamp(d.Magnitude,.45,L1+L2-1e-3)
	local bend=math.pi-math.acos(math.clamp((L1*L1+L2*L2-D*D)/(2*L1*L2),-1,1))
	local a=math.acos(math.clamp((L1*L1+D*D-L2*L2)/(2*L1*D),-1,1))
	local hint=Vector3.new(side*.18,0,-1).Unit
	local w=hint-u*hint:Dot(u)
	if w.Magnitude&lt;1e-3 then w=Vector3.new(0,0,-1) end
	w=w.Unit
	local up=-(u*math.cos(a)+w*math.sin(a))
	local x=w:Cross(up)
	if x.Magnitude&lt;1e-3 then x=Vector3.xAxis end
	x=x.Unit
	local z=x:Cross(up).Unit
	local hipCF=CFrame.fromMatrix(Vector3.zero,x,up,z)
	local kneeCF=ANG(-bend,0,0)
	local foot=(hipCF*kneeCF):Inverse()*inv*ANG(0,rad(-(footYaw or 0)),0)*ANG(rad(toe or 0),0,0)
	return hipCF,kneeCF,foot
end
local function rootCFOf(spec)
	local r=spec.root or {}
	return CF(r.x or 0,r.y or 0,r.z or 0)*ori(r)
end
-- Spec -&gt; joint transforms. Unspecified parts stay at rest.
local function build(spec)
	local out={}
	local rootCF=rootCFOf(spec)
	out.Root=rootCF
	out.Waist=ori(spec.torso)
	out.Neck=ori(spec.head)
	out.Right,out.RightElbow,out.RightWrist=armCF(1,spec.ra)
	out.Left,out.LeftElbow,out.LeftWrist=armCF(-1,spec.la)
	for _,side in {1,-1} do
		local prefix=if side==1 then "Right" else "Left"
		local free=if side==1 then spec.rl else spec.ll
		if free then
			-- A free leg (air, kicks) is posed directly.
			out[prefix.."Hip"],out[prefix.."Knee"],out[prefix.."Ankle"]=legFK(side,free)
		else
			-- Otherwise the foot is planted (at rest unless told where) and the
			-- leg is solved to reach it, whatever the hips are doing.
			local foot=(if side==1 then spec.rf else spec.lf) or {}
			local ankle=Vector3.new(.5*side+(foot.x or 0),ANKLE_Y+(foot.y or 0),foot.z or 0)
			out[prefix.."Hip"],out[prefix.."Knee"],out[prefix.."Ankle"]=legIK(rootCF,side,ankle,foot.yaw,foot.toe)
			-- Remember the planted foot: apply() re-solves the leg against the
			-- hips actually drawn this frame, so the foot stays where it was put.
			out.__feet=out.__feet or {}
			out.__feet[if side==1 then "R" else "L"]={ankle=ankle,yaw=foot.yaw or 0,toe=foot.toe or 0}
		end
	end
	return out
end
local cache=setmetatable({},{__mode="k"})
local function built(spec)
	local c=cache[spec]
	if not c then c=build(spec);cache[spec]=c end
	return c
end
local function blend(a,b,t)
	if t&lt;=0 then return a end
	if t&gt;=1 then return b end
	local out={}
	for key in JOINTS do out[key]=(a[key] or IDENTITY):Lerp(b[key] or IDENTITY,t) end
	local fa,fb=a.__feet,b.__feet
	if fa and fb then
		for _,side in {"R","L"} do
			local x,y=fa[side],fb[side]
			if x and y then
				out.__feet=out.__feet or {}
				out.__feet[side]={ankle=x.ankle:Lerp(y.ankle,t),yaw=x.yaw+(y.yaw-x.yaw)*t,toe=x.toe+(y.toe-x.toe)*t}
			end
		end
	end
	return out
end
-- Deep merge: `over` replaces numeric fields of `base`; tables are merged.
local function merge(base,over)
	local out={}
	for k,v in base do out[k]=if type(v)=="table" then table.clone(v) else v end
	for k,v in over or {} do
		if type(v)=="table" and type(out[k])=="table" and not v.replace then
			for kk,vv in v do out[k][kk]=vv end
		else
			out[k]=if type(v)=="table" then table.clone(v) else v
		end
	end
	return out
end
local function smooth(t) t=math.clamp(t,0,1);return t*t*(3-2*t) end
local function easeOut(t) t=math.clamp(t,0,1);return 1-(1-t)*(1-t)*(1-t) end
local function easeIn(t) t=math.clamp(t,0,1);return t*t*t end
local EASE={smooth=smooth,out=easeOut,["in"]=easeIn,linear=function(t) return math.clamp(t,0,1) end}

-- ---------------------------------------------------------------- stances
-- Minato: light and coiled, lead foot forward, kunai hand low in reverse grip,
-- lead hand open. Itachi: upright and square, economical, left hand ready.
local STANCE={
	Flashstep={root={y=-.42,pitch=9,yaw=24},torso={pitch=5,yaw=-14},head={pitch=-6,yaw=-11},
		ra={raise=34,out=14,twist=24,elbow=98,wrist=-22},la={raise=58,out=2,twist=12,elbow=78,wrist=8},
		rf={x=.22,z=.78,yaw=32},lf={x=-.08,z=-.72,yaw=-4},breath=1.6,tempo=7.5},
	Mirage={root={y=-.2,pitch=3,yaw=14},torso={pitch=2,yaw=-8},head={pitch=1,yaw=-7},
		ra={raise=14,out=9,twist=8,elbow=32,wrist=0},la={raise=42,out=-6,twist=24,elbow=84,wrist=10},
		rf={x=.12,z=.5,yaw=22},lf={x=0,z=-.46,yaw=-2},breath=.7,tempo=5},
}
-- Neji: the Gentle Fist stance. Side-on and low, lead palm extended toward the
-- opponent, rear palm guarding the centre line.
STANCE.GentleFist={root={y=-.62,pitch=6,yaw=38},torso={pitch=4,yaw=-14},head={pitch=-2,yaw=-22},
	la={raise=80,out=-6,twist=-40,elbow=26,wrist=-46},ra={raise=56,out=-30,twist=40,elbow=96,wrist=-36},
	rf={x=.32,z=.92,yaw=64},lf={x=-.18,z=-.95,yaw=-6},breath=.8,tempo=5.5}
-- Sasuke: low and forward, lead hand out, rear hand by the chin, coiled to kick.
STANCE.Lion={root={y=-.5,pitch=10,yaw=30},torso={pitch=6,yaw=-14},head={pitch=-6,yaw=-14},
	la={raise=66,out=6,twist=10,elbow=64,wrist=0},ra={raise=52,out=-16,twist=24,elbow=118,wrist=0},
	rf={x=.26,z=.84,yaw=38},lf={x=-.1,z=-.76,yaw=-6},breath=1.3,tempo=7}
-- Motion families: the character production framework (DEC-015). A fighter
-- names the body language it is built from (stance, gait, clip set), its
-- weapon family and its intro; a new fighter declares `Motion = {body=...,
-- weapons=..., clips=...}` in Fighters instead of silently inheriting Minato.
-- Bespoke stance/clips by its own id still win over the family.
-- Identity traits are declared, never inferred from the body: `awakenPosture`
-- ("curse": Sasuke's hunched Curse Mark guard) does not follow his kicks into
-- another fighter's family (Rock Lee is built on them).
local FAMILY={
	Flashstep={body="Flashstep",weapons="kunai",springy=true},
	Mirage={body="Mirage",weapons="shuriken",springy=false},
	GentleFist={body="GentleFist",weapons="palms",springy=false},
	Lion={body="Lion",weapons="wire",springy=true,awakenPosture="curse"},
	Sand={body="Sand",weapons="none",springy=false},
}
local function familyOf(id)
	local f=FAMILY[id]
	if f then return f end
	local def=Fighters[id]
	if def and def.Motion then return def.Motion end
	return FAMILY.Flashstep
end
Motion.familyOf=familyOf
-- Gaara: upright and still, arms folded across the chest, feet close. He does
-- not fight with his body: the sand moves, he barely does.
STANCE.Sand={root={y=-.06,pitch=0,yaw=6},torso={pitch=-2,yaw=-2},head={pitch=6,yaw=-4},
	ra={raise=62,out=-42,twist=44,elbow=122,wrist=0},la={raise=58,out=-46,twist=40,elbow=118,wrist=0},
	rf={x=.06,z=.22,yaw=8},lf={x=-.06,z=-.2,yaw=-4},breath=.35,tempo=3.6}
-- Rock Lee (stress-test wave, DEC-015): the Strong Fist stance. Side-on, low
-- and springy, the lead hand open and held out at the opponent, the rear hand
-- folded behind the small of the back. His family (Fighters.Leaf.Motion) is
-- Sasuke's kicks; this stance and a few clips (CLIPS.Leaf) are his own.
STANCE.Leaf={root={y=-.58,pitch=8,yaw=36},torso={pitch=5,yaw=-16},head={pitch=-4,yaw=-22},
	la={raise=92,out=-8,twist=-24,elbow=24,wrist=-30},ra={raise=-48,out=-4,twist=96,elbow=68,wrist=0},
	rf={x=.3,z=.92,yaw=46},lf={x=-.12,z=-.88,yaw=-8},breath=1.5,tempo=8.5}
-- A breadth-pass fighter may carry its own stance in data (Motion.stance).
local function stance(id) return STANCE[id] or familyOf(id).stance or STANCE[familyOf(id).body] or STANCE.Flashstep end
-- Gait families: springy (Minato, Sasuke) or controlled (Itachi, Neji).
local SPRINGY={Flashstep=true,Lion=true}
local function springy(id)
	local f=familyOf(id)
	if f.springy~=nil then return f.springy end
	return SPRINGY[f.body]==true
end

-- ---------------------------------------------------------- attack clips
-- Keys are placed on the move's own timeline: 0 = start, 1 = end of startup
-- (contact), 2 = end of active, 3 = end of recovery. `w` fades the clip out
-- over the tail of recovery so the body returns into its stance.
local function K(at,pose,ease) return {at=at,pose=pose,ease=ease or "smooth"} end
local M=STANCE.Flashstep
local I=STANCE.Mirage
local function m(over) return merge(M,over) end
local function i(over) return merge(I,over) end
local N=STANCE.GentleFist
local function n(over) return merge(N,over) end
local CLIPS={Flashstep={},Mirage={},GentleFist={},Lion={},Sand={}}
-- Read-only view for the headless suites (which clips a fighter authors).
Motion.CLIPS=CLIPS
