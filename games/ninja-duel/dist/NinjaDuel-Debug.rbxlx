<roblox version="4">
  <Item class="Workspace" referent="ND1">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">140</float>
      <float name="FallenPartsDestroyHeight">-100</float>
    </Properties>
  </Item>
  <Item class="ReplicatedStorage" referent="ND2">
