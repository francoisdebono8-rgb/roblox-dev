			Effects = { { "graph.onRoute.CircleStep", "set", "tenketsu" } },
			Shows = "The circular step strikes a second chakra point.", Counter = "The step must land: guard the side.", Lore = "PLAUSIBLE_YOUNG" },
		{ Id = "KaitenCancel", Name = "Kaiten Cancel", Branch = "Gentle Fist", Kind = "route", Major = true, Cost = 11, Requires = { "PrecisePalms" }, Exclusive = "StringEnder",
