        <Item class="ModuleScript" referent="ND128">
          <Properties>
            <string name="Name">AuthoredClips1</string>
            <ProtectedString name="Source">-- GENERATED by tools/blender/clips_to_luau.py from the Blender pipeline
-- (tools/blender, Documents/NinjaDuelBlender). Do not edit by hand:
-- re-author in Blender and re-export. Rows: Root = x,y,z,qx,qy,qz,qw;
-- other joints = qx,qy,qz,qw; Roblox axes (Motor6D.Transform).
return {
	["Copycat.Air1"]={fps=30,frames=10,length=0.3,loop=false,markers={contact=0.0833,recover=0.1833},meta={},joints={
