        <Item class="ModuleScript" referent="ND207">
          <Properties>
            <string name="Name">ElementFX</string>
            <ProtectedString name="Source">-- (06/11, user: « c'est faux, la foudre ne va pas dans l'eau ») Water and
-- lightning on screen (Server/Interactions). A soaked body drips while it is
-- wet; the current shows where it runs: jagged arcs crawling over the whole
-- puddle (everyone in it is shocked), arcs over a soaked body that lightning
-- reached. One identity layer installed into Effects ahead of the others (it
-- takes the "conduct" contact). Presentation only.
local ElementFX={}
local K -- Effects' helpers, handed over by install()
ElementFX.clock=os.clock -- (headless tests drive time)
local ARC=Color3.fromRGB(170,214,255)
local CORE=Color3.fromRGB(244,250,255)
local DROP=Color3.fromRGB(150,190,220)
-- One jagged arc from a to b: a few segments, the middle points thrown aside.
local function arc(holder,a,b,rng,width,color)
	local points={a}
	local n=4
	for k=1,n-1 do
		local p=a:Lerp(b,k/n)
		table.insert(points,p+Vector3.new(rng:NextNumber(-.5,.5),rng:NextNumber(-.15,.35),rng:NextNumber(-.5,.5)))
	end
	table.insert(points,b)
	for k=1,#points-1 do
		local p,q=points[k],points[k+1]
		local length=(q-p).Magnitude
		if length&gt;.05 then
			K.block(holder,Vector3.new(width,width,length),CFrame.lookAt((p+q)/2,q),color,Enum.Material.Neon)
		end
	end
end
-- The current: re-drawn every few hundredths of a second for `life` seconds.
local function current(fx,draw,life,anchor)
	local holder=K.new("Model",{Name="Current"},fx.folder)
	local rng=Random.new()
	local born=ElementFX.clock()
	local function redraw()
		holder:ClearAllChildren()
		draw(holder,rng)
	end
	redraw()
	task.spawn(function()
		while holder.Parent and ElementFX.clock()-born&lt;life do
			task.wait(.05)
			if holder.Parent then redraw() end
		end
		if holder.Parent then holder:Destroy() end
	end)
	K.sound(K.anchorPart(fx.folder,anchor),K.SOUND.electric,.6,1)
end
local function conduct(fx,impact,folder)
	local at=impact.position
	if impact.body then
		-- Over the soaked body: arcs between its parts.
		local victim=folder and folder:FindFirstChild(impact.victim or "")
		current(fx,function(holder,rng)
			local parts={}
			if victim then for _,d in victim:GetChildren() do if d:IsA("BasePart") and d.Transparency&lt;1 then table.insert(parts,d) end end end
			for _=1,7 do
				local a=if #parts&gt;0 then parts[rng:NextInteger(1,#parts)].Position else at+Vector3.new(rng:NextNumber(-1,1),rng:NextNumber(-2,2),rng:NextNumber(-1,1))
				local b=a+Vector3.new(rng:NextNumber(-1.6,1.6),rng:NextNumber(-1.6,1.6),rng:NextNumber(-1.6,1.6))
				arc(holder,a,b,rng,.07,if rng:NextNumber()&lt;.3 then CORE else ARC)
			end
		end,.5,at)
		K.flash(fx.folder,at,ARC,.6,3.4,.14,.3)
		return true
	end
	-- Over the whole puddle, on the floor.
	local radius=impact.radius or 9
	local hit=K.floorUnder and K.floorUnder(fx,at,2,16)
	local floor=(if hit then hit.Position else at-Vector3.new(0,2.9,0))+Vector3.new(0,.18,0)
	current(fx,function(holder,rng)
		for _=1,16 do
			local angle=rng:NextNumber(0,math.pi*2)
			local r=radius*math.sqrt(rng:NextNumber())
			local a=floor+Vector3.new(math.cos(angle)*r,0,math.sin(angle)*r)
			local turn=angle+rng:NextNumber(-1.2,1.2)
			local length=rng:NextNumber(1.5,3.5)
			local b=a+Vector3.new(math.cos(turn)*length,0,math.sin(turn)*length)
			if (Vector3.new(b.X,0,b.Z)-Vector3.new(floor.X,0,floor.Z)).Magnitude&gt;radius then b=a:Lerp(b,.3) end
			arc(holder,a,Vector3.new(b.X,floor.Y,b.Z),rng,.09,if rng:NextNumber()&lt;.25 then CORE else ARC)
		end
	end,.6,floor)
	K.shockRing(fx.folder,floor,ARC,1,radius*2,.3)
	return true
end
-- A soaked body drips.
local drips=setmetatable({},{__mode="k"})
local function fighter(fx,model,actor,dt)
	local wet=actor.wet==true and (actor.health or 1)&gt;0
	local st=drips[model]
	if wet and not st then
		local torso=model:FindFirstChild("UpperTorso") or model:FindFirstChild("HumanoidRootPart")
		if not torso then return end
		local at=Instance.new("Attachment");at.Name="Soaked";at.Parent=torso
		local e=Instance.new("ParticleEmitter")
		e.Texture="rbxasset://textures/particles/sparkles_main.dds";e.Rate=26;e.Lifetime=NumberRange.new(.35,.6)
		e.Speed=NumberRange.new(0,1);e.Acceleration=Vector3.new(0,-40,0);e.SpreadAngle=Vector2.new(60,60)
		e.Shape=Enum.ParticleEmitterShape.Box;e.ShapeStyle=Enum.ParticleEmitterShapeStyle.Volume
		e.Color=ColorSequence.new(DROP);e.LightEmission=.3;e.LightInfluence=.6
		e.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,.16),NumberSequenceKeypoint.new(1,.08)})
		e.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.2),NumberSequenceKeypoint.new(1,.8)})
		e.Parent=at
		drips[model]={attachment=at,emitter=e}
	elseif not wet and st then
		st.emitter.Enabled=false
		game:GetService("Debris"):AddItem(st.attachment,1)
		drips[model]=nil
	end
end
-- (06/11, Studio) Sasuke's lightning down his wire read as a white-hot wire:
-- the current crawls the wire now, jagged arcs from his hand to the bound
-- body for half a second (the contact's own drawing still runs after).
local function alongWire(fx,impact)
	local from,to=impact.from,impact.to
	if not (from and to) or (to-from).Magnitude&lt;1 then return end
	current(fx,function(holder,rng)
		local steps=math.clamp(math.floor((to-from).Magnitude/2.2),3,12)
		for k=0,steps-1 do
			if rng:NextNumber()&lt;.75 then
				local a=from:Lerp(to,k/steps)
				local b=from:Lerp(to,(k+1)/steps)
				arc(holder,a,b,rng,.07,if rng:NextNumber()&lt;.3 then CORE else ARC)
			end
		end
	end,.5,to)
end
local function impact(fx,data,folder)
	if data.style=="conduct" then return conduct(fx,data,folder) end
	if data.style=="chidori" and data.chakra=="conduct" then alongWire(fx,data) end
	return false
end
function ElementFX.install(Effects,kit)
	K=kit
	table.insert(Effects.layers,1,{name="Elements",impact=impact,fighter=fighter})
end
return ElementFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND208">
          <Properties>
            <string name="Name">FamilyFX</string>
            <ProtectedString name="Source">-- Family objects seen in play (roster breadth pass): every projectile kind of
-- Shared/Looks gets a real model (never the kunai fallback), its flight pose,
-- its contact burst and, for zones, a ground look; buffs, counter stances,
-- drains and slows show on the bodies. Installed by Effects like SandFX.
local Debris=game:GetService("Debris")
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Looks=require(Shared.Looks)
local SealJutsu=require(game:GetService("ReplicatedStorage").NinjaDuel.SealJutsu)
local Fighters=require(Shared.Fighters)
local FamilyFX={}
-- Studio/test switch: drawing errors surface instead of being swallowed.
FamilyFX.strict=false

local function c3(t) return Color3.fromRGB(t[1],t[2],t[3]) end

function FamilyFX.install(FX,kit)
	local new,block,tween,sound,flash,shockRing,burst,smokePuff,sparks=kit.new,kit.block,kit.tween,kit.sound,kit.flash,kit.shockRing,kit.burst,kit.smokePuff,kit.sparks
	local num,seq,TEX,SOUND,BUILD,weldAll,floorUnder,anchorPart=kit.num,kit.seq,kit.TEX,kit.SOUND,kit.BUILD,kit.weldAll,kit.floorUnder,kit.anchorPart

	-- An ellipsoid of the given size (a Ball part stays round at its smallest
	-- side, which turned every beast into a small brown ball in Studio).
	local function ball(model,size,cf,color,material,transparency)
		local p=block(model,size,cf,color,material or Enum.Material.SmoothPlastic)
		p.Transparency=transparency or 0
		new("SpecialMesh",{MeshType=Enum.MeshType.Sphere},p)
		return p
	end
	local function trail(root,width,color,lifetime)
		if width&lt;=0 then return end
		local a0=new("Attachment",{Position=Vector3.new(0,width*.5,.2)},root)
		local a1=new("Attachment",{Position=Vector3.new(0,-width*.5,.2)},root)
		new("Trail",{Attachment0=a0,Attachment1=a1,Color=ColorSequence.new(color),Lifetime=lifetime or .18,LightEmission=.4,
			Transparency=num({{0,.35},{1,1}}),WidthScale=num({{0,1},{1,.2}}),FaceCamera=true},root)
	end
	local function glow(root,color,brightness,range)
		if brightness&gt;0 then new("PointLight",{Color=color,Brightness=brightness,Range=range or 9,Shadows=false},root) end
	end
	local function spray(root,color,rate,size,speed)
		local at=new("Attachment",{},root)
		return new("ParticleEmitter",{Texture=TEX.smoke,Rate=rate,Lifetime=NumberRange.new(.25,.5),Speed=NumberRange.new(speed or 2,(speed or 2)*2),
			SpreadAngle=Vector2.new(40,40),EmissionDirection=Enum.NormalId.Back,Color=ColorSequence.new(color),LightInfluence=.4,
			Size=num({{0,size},{1,size*2.4}}),Transparency=num({{0,.35},{1,1}}),Drag=4,Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-60,60)},at)
	end

	-- One builder per shape. Every model is welded to an anchored root that the
	-- flight pose moves; sizes come from the look ({width, height, length}).
	local SHAPES={}
	SHAPES.orb=function(look)
		local m=new("Model",{Name="FamilyOrb"})
		local s=look.size
		local core=ball(m,Vector3.new(s[1]*.55,s[2]*.55,s[3]*.55),CFrame.new(),c3(look.color2),Enum.Material.Neon,.05)
		local shell=ball(m,Vector3.new(s[1],s[2],s[3]),CFrame.new(),c3(look.color),Enum.Material.Glass,.45)
		weldAll(core,{shell});m.PrimaryPart=core
		glow(core,c3(look.color),look.light)
		trail(core,look.trail,c3(look.color))
		spray(core,c3(look.color),30,s[1]*.35)
		return m
	end
	SHAPES.needle=function(look)
		local m=new("Model",{Name="FamilyNeedle"})
		local s=look.size
		local shaft=block(m,Vector3.new(s[1],s[2],s[3]),CFrame.new(),c3(look.color),Enum.Material.Metal)
		local tip=block(m,Vector3.new(s[1]*.6,s[2]*.6,s[3]*.25),CFrame.new(0,0,-s[3]*.6),c3(look.color2),Enum.Material.Metal)
		weldAll(shaft,{tip});m.PrimaryPart=shaft
		trail(shaft,math.max(look.trail,.08),c3(look.color),.08)
		return m
	end
	SHAPES.blade=function(look)
		local m=new("Model",{Name="FamilyBlade"})
		local s=look.size
		local glass=look.hit=="shatter"
		local body=block(m,Vector3.new(s[1],s[2],s[3]),CFrame.new(),c3(look.color),if glass then Enum.Material.Glass else Enum.Material.SmoothPlastic)
		body.Transparency=if glass then .25 else 0
		local edge=block(m,Vector3.new(s[1]*.5,s[2]*.5,s[3]*.4),CFrame.new(0,0,-s[3]*.55),c3(look.color2),if glass then Enum.Material.Ice else Enum.Material.SmoothPlastic,"WedgePart")
		edge.CFrame=CFrame.new(0,0,-s[3]*.6)*CFrame.Angles(math.rad(90),0,0)
		weldAll(body,{edge});m.PrimaryPart=body
		glow(body,c3(look.color),look.light,6)
		trail(body,math.max(look.trail,.1),c3(look.color),.12)
		return m
	end
	SHAPES.wave=function(look)
		local m=new("Model",{Name="FamilyWave"})
		local s=look.size
		local root=block(m,Vector3.new(s[1]*.4,s[2]*.4,s[3]*.4),CFrame.new(),c3(look.color),Enum.Material.SmoothPlastic)
		root.Transparency=1
		local parts={}
		for i=-2,2 do
			local h=s[2]*(1-math.abs(i)*.18)
			-- (Audit 04/11) a wave of air (a look with light: Hasangeki) is not
			-- stone: it flew as five pale rocks with no glow and no trail.
			local air=(look.light or 0)&gt;0
			local p=ball(m,Vector3.new(s[1]*.32,h,s[3]),CFrame.new(i*s[1]*.18,h*.5-s[2]*.2,math.abs(i)*.35),c3(if math.abs(i)==2 then look.color2 else look.color),if air then Enum.Material.ForceField else Enum.Material.Slate)
			if air then p.Transparency=.15 end
			table.insert(parts,p)
		end
		weldAll(root,parts);m.PrimaryPart=root
		local e=spray(root,c3(look.color),50,s[1]*.25,4)
		e.EmissionDirection=Enum.NormalId.Top
		if (look.light or 0)&gt;0 then
			glow(parts[3],c3(look.color2),look.light)
			if (look.trail or 0)&gt;0 then trail(parts[3],look.trail,c3(look.color),.4) end
		end
		return m
	end
	SHAPES.beast=function(look)
		-- A creature read from its silhouette: a long body, the head raised
		-- forward with a pale snout and a dark nose, ears up, four legs and a
		-- tail for a hound; a dorsal and a tail fin, no legs, for a shark.
		local m=new("Model",{Name="FamilyBeast"})
		local s=look.size
		local w,h,l=s[1],s[2],s[3]
		local color,pale=c3(look.color),c3(look.color2)
		local dark=Color3.fromRGB(26,22,24)
		local water=look.zone=="water"
		local body=ball(m,Vector3.new(w*.8,h*.6,l*.64),CFrame.new(0,h*.08,0),color)
		local parts={}
		local function add(p) table.insert(parts,p);return p end
		add(ball(m,Vector3.new(w*.64,h*.34,l*.5),CFrame.new(0,-h*.1,-l*.02),pale))
		add(ball(m,Vector3.new(w*.62,h*.5,l*.3),CFrame.new(0,h*.34,-l*.4),color))
		add(ball(m,Vector3.new(w*.36,h*.24,l*.22),CFrame.new(0,h*.26,-l*.56),pale))
		add(ball(m,Vector3.new(w*.12,w*.1,w*.1),CFrame.new(0,h*.3,-l*.67),dark))
		for _,side in {-1,1} do
			add(ball(m,Vector3.new(w*.09,w*.09,w*.06),CFrame.new(side*w*.19,h*.46,-l*.52),dark))
		end
		if water then
			add(block(m,Vector3.new(w*.1,h*.55,l*.26),CFrame.new(0,h*.5,l*.02)*CFrame.Angles(0,math.pi,0),color,Enum.Material.SmoothPlastic,"WedgePart"))
			add(block(m,Vector3.new(w*.1,h*.7,l*.22),CFrame.new(0,h*.05,l*.46)*CFrame.Angles(0,math.pi,0),color,Enum.Material.SmoothPlastic,"WedgePart"))
			for _,side in {-1,1} do
				add(block(m,Vector3.new(w*.4,h*.06,l*.16),CFrame.new(side*w*.45,-h*.1,-l*.1)*CFrame.Angles(0,0,math.rad(side*-20)),color,Enum.Material.SmoothPlastic))
			end
		else
			for _,side in {-1,1} do
				add(block(m,Vector3.new(w*.12,h*.28,l*.08),CFrame.new(side*w*.17,h*.68,-l*.38),color,Enum.Material.SmoothPlastic,"WedgePart"))
				for _,z in {-.22,.22} do
					add(block(m,Vector3.new(w*.16,h*.46,w*.16),CFrame.new(side*w*.24,-h*.32,z*l),color,Enum.Material.SmoothPlastic))
				end
			end
			add(block(m,Vector3.new(w*.1,h*.12,l*.34),CFrame.new(0,h*.3,l*.42)*CFrame.Angles(math.rad(30),0,0),color,Enum.Material.SmoothPlastic))
		end
		weldAll(body,parts);m.PrimaryPart=body
		trail(body,look.trail,color,.2)
		if water then spray(body,color,40,w*.4,3) else spray(body,Color3.fromRGB(150,130,110),14,w*.3,2) end
		return m
	end
	-- (Studio film 28/10: Kakashi's Water Dragon read as one blue ball.) A
	-- serpent is a long body: the head, then one segment per ~1.1 stud of its
	-- length, each following the path the head really took (a snake, not a
	-- stiff rod waving); the water dragon also has horns and a jaw.
	local function segmentsFor(look) return math.clamp(math.floor(look.size[3]/1.1),6,18) end
	SHAPES.serpent=function(look)
		local m=new("Model",{Name="FamilySerpent"})
		local s=look.size
		local water=look.zone=="water"
		local head=ball(m,Vector3.new(s[1]*1.3,s[2]*1.1,s[1]*1.8),CFrame.new(),c3(look.color),Enum.Material.SmoothPlastic)
		local parts={}
		local n=segmentsFor(look)
		for i=1,n do
			local w=s[1]*(1-(i/n)*.72)
			local seg=ball(m,Vector3.new(w,w,w*1.7),CFrame.new(0,0,i*s[3]/(n+1)),c3(if i%3==0 then look.color2 else look.color),Enum.Material.SmoothPlastic,if water then .12 else 0)
			seg.Name="Segment"..i;seg.Anchored=true
			table.insert(parts,seg)
		end
		local attach={}
		for _,side in {-1,1} do
			table.insert(attach,ball(m,Vector3.new(s[1]*.22,s[1]*.22,s[1]*.12),CFrame.new(side*s[1]*.4,s[2]*.25,-s[1]*.6),Color3.fromRGB(250,220,80),Enum.Material.Neon))
			if water then
				-- horns swept back, and the open lower jaw
				table.insert(attach,block(m,Vector3.new(s[1]*.12,s[1]*.16,s[1]*1.1),CFrame.new(side*s[1]*.35,s[2]*.55,s[1]*.55)*CFrame.Angles(math.rad(25),math.rad(side*12),0),c3(look.color2),Enum.Material.SmoothPlastic))
			end
		end
		if water then
			table.insert(attach,ball(m,Vector3.new(s[1]*.9,s[2]*.3,s[1]*1.2),CFrame.new(0,-s[2]*.45,-s[1]*.35)*CFrame.Angles(math.rad(-18),0,0),c3(look.color2),Enum.Material.SmoothPlastic))
		end
		for _,a in attach do
			a.Anchored=false;a.Massless=true
			new("WeldConstraint",{Part0=head,Part1=a},head)
		end
		m.PrimaryPart=head
		glow(head,c3(look.color),look.light)
		if water then spray(head,c3(look.color),70,s[1]*.6,4) end
		return m
	end
	SHAPES.swarm=function(look)
		local m=new("Model",{Name="FamilySwarm"})
		local s=look.size
		local root=block(m,Vector3.new(.4,.4,.4),CFrame.new(),c3(look.color),Enum.Material.SmoothPlastic)
		root.Transparency=1
		local at=new("Attachment",{},root)
		new("ParticleEmitter",{Texture=TEX.spark,Rate=180,Lifetime=NumberRange.new(.25,.5),Speed=NumberRange.new(2,5),SpreadAngle=Vector2.new(180,180),
			Color=ColorSequence.new(c3(look.color),c3(look.color2)),LightEmission=0,LightInfluence=1,Size=num({{0,.22},{1,.12}}),
			Transparency=num({{0,0},{1,.6}}),Acceleration=Vector3.zero,Drag=2,Shape=Enum.ParticleEmitterShape.Sphere},at).ShapeStyle=Enum.ParticleEmitterShapeStyle.Volume
		local cloud=new("ParticleEmitter",{Texture=TEX.smoke,Rate=24,Lifetime=NumberRange.new(.3,.6),Speed=NumberRange.new(1,2),SpreadAngle=Vector2.new(180,180),
			Color=ColorSequence.new(c3(look.color)),LightInfluence=1,Size=num({{0,s[1]*.5},{1,s[1]*.9}}),Transparency=num({{0,.6},{1,1}})},at)
		cloud.Name="Cloud"
		m.PrimaryPart=root
		return m
	end
	SHAPES.shadow=function(look)
		-- A flat dark tongue running over the floor: its tip is the object, the
		-- strip back to where it left is a beam laid on the ground.
		local m=new("Model",{Name="FamilyShadow"})
		local s=look.size
		local tip=block(m,Vector3.new(s[1],s[2],s[1]*1.4),CFrame.new(),c3(look.color),Enum.Material.SmoothPlastic)
		tip.Shape=Enum.PartType.Cylinder;tip.Size=Vector3.new(s[2],s[1]*1.2,s[1]*1.2)
		tip.Transparency=.1
		m.PrimaryPart=tip
		return m
	end
	SHAPES.boulder=function(look)
		local m=new("Model",{Name="FamilyBoulder"})
		local s=look.size
		local body=ball(m,Vector3.new(s[1],s[2],s[3]),CFrame.new(),c3(look.color),Enum.Material.SmoothPlastic)
		local band=block(m,Vector3.new(s[1]*1.02,s[2]*.2,s[3]*1.02),CFrame.new(),c3(look.color2),Enum.Material.SmoothPlastic)
		band.Shape=Enum.PartType.Cylinder;band.Size=Vector3.new(s[2]*.22,s[1]*1.02,s[3]*1.02)
		weldAll(body,{band});m.PrimaryPart=body
		spray(body,Color3.fromRGB(170,150,120),30,s[1]*.3,3)
		return m
	end
	FamilyFX.SHAPES=SHAPES

	for kind,look in Looks do
		if not BUILD[kind] and SHAPES[look.shape] then
			BUILD[kind]=function() return SHAPES[look.shape](look) end
		end
	end

	-- (Jutsu pass 05/11, the reel: « le Fuma et le Moulin volent comme une
	-- boîte grise ») The windmill and fuma shuriken were the generic blade: a
	-- flat box with a wedge, rolled about its flight line. Now a real giant
	-- shuriken lying flat: a dark hub with its hole, four blades whose tips
	-- sweep back (the fuma's curve), a pale edge on each, a faint spin ring at
	-- the blade tips, and it spins flat about the vertical, fast.
	local function giantShuriken(look)
		local m=new("Model",{Name="FamilyFuma"})
		local d=look.size[1]
		local t=math.max(look.size[2],.08)
		local steel,dark=c3(look.color),c3(look.color2)
		local edgeTone=Color3.fromRGB(236,240,246)
		local root=block(m,Vector3.new(.1,.1,.1),CFrame.new(),dark);root.Transparency=1
		local parts={}
		local hub=block(m,Vector3.new(t*1.5,d*.27,d*.27),CFrame.Angles(0,0,math.pi/2),dark,Enum.Material.Metal);hub.Shape=Enum.PartType.Cylinder
		local hole=block(m,Vector3.new(t*1.7,d*.09,d*.09),CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(14,14,18),Enum.Material.SmoothPlastic);hole.Shape=Enum.PartType.Cylinder
		table.insert(parts,hub);table.insert(parts,hole)
		for k=0,3 do
			local base=CFrame.Angles(0,k*math.pi/2,0)
			table.insert(parts,block(m,Vector3.new(d*.16,t,d*.26),base*CFrame.new(0,0,-d*.2),steel,Enum.Material.Metal))
			-- the tip: a flat triangle (a wedge laid on its side), swept back
			local tipCF=base*CFrame.new(-d*.045,0,-d*.39)*CFrame.Angles(0,math.rad(26),0)*CFrame.Angles(0,0,math.pi/2)
			table.insert(parts,block(m,Vector3.new(t,d*.15,d*.24),tipCF,steel,Enum.Material.Metal,"WedgePart"))
			table.insert(parts,block(m,Vector3.new(d*.018,t*1.15,d*.42),base*CFrame.new(d*.075,0,-d*.27)*CFrame.Angles(0,math.rad(-6),0),edgeTone,Enum.Material.Metal))
		end
		local ring=block(m,Vector3.new(t*.6,d*.9,d*.9),CFrame.Angles(0,0,math.pi/2),edgeTone,Enum.Material.Neon);ring.Shape=Enum.PartType.Cylinder
		ring.Transparency=.82
		table.insert(parts,ring)
		weldAll(root,parts);m.PrimaryPart=root
		-- two trail points on the tips: as it spins they draw a blurred disc
		local a0=new("Attachment",{Position=Vector3.new(-d*.45,0,0)},root)
		local a1=new("Attachment",{Position=Vector3.new(d*.45,0,0)},root)
		new("Trail",{Attachment0=a0,Attachment1=a1,Color=ColorSequence.new(edgeTone),Lifetime=.09,LightEmission=.3,FaceCamera=false,
			Transparency=num({{0,.55},{1,1}})},root)
		return m
	end
	for _,kind in {"fuma","windmill"} do
		local look=Looks[kind]
		if look then
			BUILD[kind]=function() return giantShuriken(look) end
			FX.poses[kind]=function(_,entry,p,age,cf,dt)
				entry.spin+=dt*24
				return cf*CFrame.Angles(0,entry.spin,0)
			end
		end
	end

	-- Flight poses (FX.poses): orient, roll and animate by shape.
	for kind,look in Looks do
		if FX.poses[kind] then continue end
		local shape=look.shape
		if shape=="needle" or shape=="blade" then
			FX.poses[kind]=function(_,entry,p,age,cf,dt)
				entry.spin+=dt*(if shape=="needle" then 6 else 2)
				return cf*CFrame.Angles(0,0,entry.spin)
			end
		elseif shape=="beast" then
			FX.poses[kind]=function(_,entry,p,age,cf)
				local bob=math.abs(math.sin(age*14))*.5
				local flatLook=Vector3.new(p.direction.X,0,p.direction.Z)
				local at=cf.Position+Vector3.new(0,bob,0)
				return if flatLook.Magnitude&gt;.05 then CFrame.lookAt(at,at+flatLook) else cf
			end
		elseif shape=="serpent" then
			local n=segmentsFor(look)
			local spacing=look.size[3]/(n+1)
			local rises=look.zone=="water"
			FX.poses[kind]=function(_,entry,p,age,cf)
				local side=p.direction:Cross(Vector3.yAxis)
				side=if side.Magnitude&gt;.05 then side.Unit else Vector3.xAxis
				-- the head swims (side to side) and, for the dragon, rears up
				-- out of the cast and dives onto the target
				local travelled=math.min(age*(p.speed or 40),p.range or 40)
				local share=math.clamp(travelled/math.max(p.range or 40,1),0,1)
				local lift=if rises then math.sin(share*math.pi)*4.5*(1-share*.35) else 0
				local at=cf.Position+side*math.sin(age*9)*look.size[1]*.45+Vector3.new(0,lift,0)
				-- path history, newest first
				local hist=entry.serpentPath or {}
				entry.serpentPath=hist
				if #hist==0 or (hist[1]-at).Magnitude&gt;.12 then table.insert(hist,1,at) end
				if #hist&gt;200 then table.remove(hist) end
				local function along(d)
					local walked=0
					for k=1,#hist-1 do
						local a,b=hist[k],hist[k+1]
						local l=(b-a).Magnitude
						if walked+l&gt;=d then return a:Lerp(b,(d-walked)/math.max(l,1e-3)) end
						walked+=l
					end
					-- not enough path yet: the body still coming out behind
					-- not enough path yet: the rest of the body is still coming
					-- up out of the ground under where it was cast
					local rest=d-walked
					return (hist[#hist] or at)-p.direction*rest*.3-Vector3.new(0,rest*.55,0)
				end
				local prev=at
				for i=1,n do
					local seg=entry.model:FindFirstChild("Segment"..i)
					if seg then
						local here=along(i*spacing)
						seg.CFrame=CFrame.lookAt(here,if (prev-here).Magnitude&gt;1e-3 then prev else here+p.direction)
						prev=here
					end
				end
				local ahead=at+p.direction*2+Vector3.new(0,if rises then math.cos(share*math.pi)*1.6 else 0,0)
				return CFrame.lookAt(at,ahead)
			end
		elseif shape=="swarm" then
			FX.poses[kind]=function(_,entry,p,age,cf)
				return cf*CFrame.new(math.sin(age*9)*.4,math.cos(age*7)*.3,0)
			end
		elseif shape=="shadow" then
			FX.poses[kind]=function(fx,entry,p,age,cf)
				-- Laid on the floor under the flight line; the strip follows.
				local floor=floorUnder(fx,cf.Position,3,10)
				local at=if floor then floor.Position+Vector3.new(0,.04,0) else cf.Position
				if not entry.strip then
					local start=anchorPart(entry.model,if floor then Vector3.new(p.origin.X,at.Y,p.origin.Z) else p.origin)
					local a0=new("Attachment",{CFrame=CFrame.Angles(0,0,math.rad(90))},start)
					local a1=new("Attachment",{CFrame=CFrame.Angles(0,0,math.rad(90))},entry.root)
					entry.strip=new("Beam",{Attachment0=a0,Attachment1=a1,Width0=look.size[1]*.7,Width1=look.size[1]*1.1,Color=ColorSequence.new(c3(look.color)),
						Transparency=num({{0,.25},{1,.05}}),FaceCamera=false,LightInfluence=1,Segments=1},entry.root)
				end
				return CFrame.new(at)*CFrame.Angles(0,0,math.rad(90))
			end
		elseif shape=="boulder" then
			FX.poses[kind]=function(_,entry,p,age,cf,dt)
				entry.spin+=dt*10
				return cf*CFrame.Angles(-entry.spin,0,0)
			end
		end
	end

	-- Contact bursts by look.
	local function hit(fx,look,position,heavy,normal)
		local color,edge=c3(look.color),c3(look.color2)
		local kind=look.hit
		local scale=if heavy then 1.4 else 1
		if kind=="splash" then
			burst(fx.folder,position,{Texture=TEX.smoke,Lifetime=NumberRange.new(.35,.7),Speed=NumberRange.new(12,22),SpreadAngle=Vector2.new(70,70),
				EmissionDirection=Enum.NormalId.Top,Acceleration=Vector3.new(0,-50,0),Color=seq({{0,Color3.fromRGB(235,248,255)},{1,color}}),LightEmission=.2,
				Size=num({{0,.9*scale},{1,2.2*scale}}),Transparency=num({{0,.1},{1,1}}),Drag=2},28)
			shockRing(fx.folder,position-Vector3.new(0,1.5,0),edge,2,9*scale,.35)
			sound(anchorPart(fx.folder,position),SOUND.land,.5,.7)
		elseif kind=="shatter" then
			burst(fx.folder,position,{Texture=TEX.spark,Lifetime=NumberRange.new(.3,.6),Speed=NumberRange.new(14,26),SpreadAngle=Vector2.new(180,180),
				Acceleration=Vector3.new(0,-40,0),Color=ColorSequence.new(color),LightEmission=.6,Size=num({{0,.6},{1,.1}}),Drag=3},24)
			flash(fx.folder,position,color,.6,3*scale,.18,.3)
		elseif kind=="sparks" then
			sparks(fx.folder,position,edge,10,16)
		elseif kind=="smoke" then
			smokePuff(fx.folder,position,color,16,1.8*scale)
		elseif kind=="crush" then
			smokePuff(fx.folder,position-Vector3.new(0,1.5,0),Color3.fromRGB(176,160,138),18,2.2*scale)
			shockRing(fx.folder,position-Vector3.new(0,2,0),edge,2,10*scale,.4)
			sound(anchorPart(fx.folder,position),SOUND.heavy,.5,.9)
		else
			flash(fx.folder,position,color,.8,4*scale,.2,.2)
			burst(fx.folder,position,{Texture=TEX.spark,Lifetime=NumberRange.new(.2,.4),Speed=NumberRange.new(10,20),SpreadAngle=Vector2.new(180,180),
				Color=ColorSequence.new(edge),LightEmission=1,Size=num({{0,.6},{1,0}}),Drag=4},16)
		end
	end

	-- Zones on the ground (hazards with a look): drawn while they last.
	local ZONES={}
	ZONES.mist=function(holder,h,look)
		return new("ParticleEmitter",{Texture=TEX.smoke,Rate=26,Lifetime=NumberRange.new(2.4,3.6),Speed=NumberRange.new(.5,1.5),SpreadAngle=Vector2.new(30,30),
			EmissionDirection=Enum.NormalId.Top,Shape=Enum.ParticleEmitterShape.Box,Color=ColorSequence.new(c3(look.color)),LightInfluence=1,
			Size=num({{0,8},{1,14}}),Transparency=num({{0,1},{.25,.45},{.75,.5},{1,1}}),Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-10,10)},holder)
	end
	ZONES.swarm=function(holder,h,look)
		return new("ParticleEmitter",{Texture=TEX.spark,Rate=140,Lifetime=NumberRange.new(.4,.9),Speed=NumberRange.new(2,6),SpreadAngle=Vector2.new(180,180),
			Shape=Enum.ParticleEmitterShape.Box,Color=ColorSequence.new(c3(look.color),c3(look.color2)),LightInfluence=1,
			Size=num({{0,.2},{1,.12}}),Transparency=num({{0,0},{1,.5}}),Drag=2},holder)
	end
	local function decal(holder,h,color,transparency,material)
		local disc=block(holder.Parent,Vector3.new(.08,h.radius*2,h.radius*2),CFrame.new(holder.Position)*CFrame.Angles(0,0,math.rad(90)),color,material or Enum.Material.SmoothPlastic)
		disc.Shape=Enum.PartType.Cylinder;disc.Transparency=1
		tween(disc,.3,{Transparency=transparency})
		return disc
	end
	ZONES.water=function(holder,h,look) local d=decal(holder,h,c3(look.color),.35,Enum.Material.Glass);d.Reflectance=.2;return nil,d end
	ZONES.ice=function(holder,h,look) local d=decal(holder,h,c3(look.color),.55,Enum.Material.Ice);return nil,d end
	ZONES.shadow=function(holder,h,look) local d=decal(holder,h,c3(look.color),.15);return nil,d end
	ZONES.mud=function(holder,h,look) local d=decal(holder,h,c3(look.color),.1,Enum.Material.Mud);return nil,d end
	ZONES.crater=function(holder,h,look) local d=decal(holder,h,Color3.fromRGB(96,78,60),.2,Enum.Material.Slate);return nil,d end
	ZONES.scorch=function(holder,h,look)
		local d=decal(holder,h,Color3.fromRGB(30,24,20),.3)
		local e=new("ParticleEmitter",{Texture=TEX.fire,Rate=30,Lifetime=NumberRange.new(.3,.6),Speed=NumberRange.new(2,5),EmissionDirection=Enum.NormalId.Top,
			Shape=Enum.ParticleEmitterShape.Box,Color=seq({{0,Color3.fromRGB(255,220,140)},{1,Color3.fromRGB(150,40,16)}}),LightEmission=1,LightInfluence=0,
			Size=num({{0,1},{1,.3}}),Transparency=num({{0,.2},{1,1}})},holder)
		return e,d
	end
	-- Bones out of the floor (Kimimaro's Dance of the Larch): a ring of spikes.
	ZONES.spikes=function(holder,h,look)
		local d=decal(holder,h,c3(look.color2),.6)
		for i=1,10 do
			local angle=i/10*math.pi*2
			local r=h.radius*(.45+.45*((i*7)%3)/2)
			local spike=block(holder.Parent,Vector3.new(.5,2.8,.5),CFrame.new(holder.Position+Vector3.new(math.cos(angle)*r,1.2,math.sin(angle)*r))*CFrame.Angles(math.rad(12*math.sin(angle)),0,math.rad(12*math.cos(angle))),c3(look.color),Enum.Material.SmoothPlastic)
			spike.Parent=d
		end
		return nil,d
	end
	-- (04/11) Minato's sealing formula (Families zone Trap): ink on the floor,
	-- a double ring, eight strokes of script round the seal's kanji, faintly
	-- lit so it reads as a trap without shouting.
	ZONES.seal=function(holder,h,look)
		local ink,paper=c3(look.color2),c3(look.color)
		local at=holder.Position
		local d=decal(holder,h,paper,.82)
		local function ring(radius,width)
			local r=block(d,Vector3.new(.05,radius*2,radius*2),CFrame.new(at+Vector3.new(0,.03,0))*CFrame.Angles(0,0,math.rad(90)),ink,Enum.Material.SmoothPlastic)
			r.Shape=Enum.PartType.Cylinder;r.Transparency=1;tween(r,.4,{Transparency=.15})
			local inner=block(d,Vector3.new(.06,(radius-width)*2,(radius-width)*2),CFrame.new(at+Vector3.new(0,.035,0))*CFrame.Angles(0,0,math.rad(90)),paper,Enum.Material.SmoothPlastic)
			inner.Shape=Enum.PartType.Cylinder;inner.Transparency=1;tween(inner,.4,{Transparency=.3})
		end
		ring(h.radius,.18);ring(h.radius*.62,.12)
		for i=1,8 do
			local angle=i/8*math.pi*2
			local r=h.radius*.81
			local stroke=block(d,Vector3.new(.9,.04,.16),CFrame.new(at+Vector3.new(math.cos(angle)*r,.05,math.sin(angle)*r))*CFrame.Angles(0,-angle+math.pi/2,0),ink,Enum.Material.SmoothPlastic)
			stroke.Transparency=1;tween(stroke,.5,{Transparency=.1})
		end
		local plate=block(d,Vector3.new(h.radius*1.1,.04,h.radius*1.1),CFrame.new(at+Vector3.new(0,.06,0)),paper,Enum.Material.SmoothPlastic)
		plate.Transparency=1
		local gui=new("SurfaceGui",{Face=Enum.NormalId.Top,LightInfluence=0,Brightness=1.4,SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud,PixelsPerStud=40},plate)
		new("TextLabel",{BackgroundTransparency=1,Size=UDim2.fromScale(1,1),Text="封",TextScaled=true,Font=Enum.Font.GothamBold,TextColor3=ink,TextTransparency=.1},gui)
		local glow=new("PointLight",{Color=Color3.fromRGB(255,230,170),Brightness=.6,Range=h.radius*1.6,Shadows=false},plate)
		local _=glow
		return nil,d
	end
	-- A charge on the floor: a small lump of clay whose fuse glows, brighter
	-- once armed (Families.plant).
	-- A buried clay charge (QA-004 M5): posed, the fuse is dark; armed (the
	-- server's armedAt), it glows and a thin ring shows the trigger radius;
	-- consumed or expired, it goes with the hazard (detonation draws its blast).
	ZONES.charge=function(holder,h,look)
		local lump=block(holder.Parent,Vector3.new(.9,.5,.9),CFrame.new(holder.Position+Vector3.new(0,.25,0)),c3(look.color),Enum.Material.SmoothPlastic)
		new("SpecialMesh",{MeshType=Enum.MeshType.Sphere},lump)
		local fuse=block(lump,Vector3.new(.25,.25,.25),CFrame.new(holder.Position+Vector3.new(0,.6,0)),Color3.fromRGB(70,60,52),Enum.Material.SmoothPlastic)
		fuse.Name="Fuse"
		local light=new("PointLight",{Color=c3(look.color2),Brightness=0,Range=5,Shadows=false},fuse)
		local ring=block(lump,Vector3.new(.06,h.radius*2,h.radius*2),CFrame.new(holder.Position+Vector3.new(0,.05,0))*CFrame.Angles(0,0,math.rad(90)),c3(look.color2),Enum.Material.Neon)
		ring.Shape=Enum.PartType.Cylinder;ring.Transparency=1;ring.Name="TriggerRing"
		return nil,lump
	end
	FX.hazardUpdate=function(entry,h)
		if not h.charge or not entry.disc then return end
		local lump=entry.disc
		entry.chargeState=entry.chargeState or "posed"
		if h.charge=="armed" and entry.chargeState~="armed" then
			entry.chargeState="armed"
			local fuse=lump:FindFirstChild("Fuse")
			if fuse then fuse.Material=Enum.Material.Neon;fuse.Color=Color3.fromRGB(255,120,60);local l=fuse:FindFirstChildOfClass("PointLight");if l then l.Brightness=1.6 end end
			local ring=lump:FindFirstChild("TriggerRing")
			if ring then ring.Transparency=.85 end
		end
		-- Armed: a slow pulse (readable without F8, never a flashing light).
		if h.charge=="armed" then
			local fuse=lump:FindFirstChild("Fuse")
			local l=fuse and fuse:FindFirstChildOfClass("PointLight")
			if l then l.Brightness=1.2+math.sin(os.clock()*6)*.5 end
		end
	end
	FX.hazardBuild=function(fx,h)
		local look=Looks[h.look or ""]
		if not look then return nil end
		local draw=ZONES[look.zone or ""]
		if not draw then return nil end
		local floor=floorUnder(fx,h.position,3,14)
		local at=if floor then floor.Position+Vector3.new(0,.06,0) else h.position
		local holder=anchorPart(fx.folder,at);holder.Size=Vector3.new(h.radius*1.7,.2,h.radius*1.7)
		local e,disc=draw(holder,h,look)
		return {holder=holder,emitter=e,disc=disc,family=true}
	end
	FX.hazardFinish=function(entry)
		if entry.emitter then entry.emitter.Enabled=false end
		if entry.disc then tween(entry.disc,.4,{Transparency=1});Debris:AddItem(entry.disc,.5) end
		Debris:AddItem(entry.holder,3)
	end

	-- A body held by a family bind shows what holds it: beasts biting at the
	-- legs, coils round the torso, a pool of shadow, a swarm, or a sphere of
	-- the jutsu's substance (water prison). Anchored parts placed each frame.
	function FamilyFX.bindVisual(fx,model,root,look)
		local m=new("Model",{Name="FamilyBind"},fx.folder)
		local color,edge=c3(look.color),c3(look.color2)
		local feet=root.CFrame*CFrame.new(0,-2.5,0)
		if look.shape=="beast" then
			for _,side in {-1,1} do
				local b=SHAPES.beast(look)
				b.Name="BindBeast"
				-- Full size, flanking the legs, turned a little inward so each
				-- head reaches the shin from the front (facing the centre put the
				-- heads inside the legs in Studio).
				local cf=feet*CFrame.new(side*(.95+look.size[1]*.45),look.size[2]*.55-.3,.35)*CFrame.Angles(0,math.rad(side*-28),0)
				b.Parent=m;b:PivotTo(cf)
			end
		elseif look.shape=="serpent" then
			for k=1,3 do
				local ring=block(m,Vector3.new(.45,3.2,3.2),root.CFrame,if k%2==0 then edge else color,Enum.Material.SmoothPlastic)
				ring.Shape=Enum.PartType.Cylinder;ring.Name="BindCoil"
				ring:SetAttribute("Spin",1.5+k*.4);ring:SetAttribute("Y",-1.6+k*.9)
			end
		elseif look.shape=="shadow" then
			local pool=block(m,Vector3.new(.06,5.2,5.2),feet*CFrame.new(0,.05,0)*CFrame.Angles(0,0,math.rad(90)),color,Enum.Material.SmoothPlastic)
			pool.Shape=Enum.PartType.Cylinder;pool.Transparency=.15;pool.Name="BindShadow"
			for _,side in {-1,1} do
				local tendril=block(m,Vector3.new(.35,2.6,.35),feet*CFrame.new(side*.5,1.3,0),color,Enum.Material.SmoothPlastic)
				tendril.Transparency=.25;tendril.Name="BindShadow"
			end
		elseif look.shape=="swarm" then
			local core=block(m,Vector3.new(.2,.2,.2),root.CFrame,color,Enum.Material.SmoothPlastic);core.Transparency=1
			new("ParticleEmitter",{Texture=TEX.spark,Rate=200,Lifetime=NumberRange.new(.3,.6),Speed=NumberRange.new(3,6),SpreadAngle=Vector2.new(180,180),
				Shape=Enum.ParticleEmitterShape.Sphere,Color=ColorSequence.new(color,edge),LightInfluence=1,Size=num({{0,.2},{1,.12}})},new("Attachment",{},core))
		else
			local shell=block(m,Vector3.new(6,7,6),root.CFrame,color,Enum.Material.Glass);shell.Shape=Enum.PartType.Ball;shell.Transparency=.55;shell.Name="BindShell"
		end
		return m
	end
	-- Bodies: buff aura, counter stance ring, the dark of a slow.
	local auras=setmetatable({},{__mode="k"})
	local function auraOf(model)
		local st=auras[model]
		if st then return st end
		st={}
		auras[model]=st
		return st
	end
	local function fighterColor(actor)
		local def=Fighters[actor.fighterId or ""]
		return if def and def.Color then c3(def.Color) else Color3.fromRGB(220,220,255)
	end
	table.insert(FX.layers,{
		impact=function(fx,impact,folder)
			local style=impact.style
			-- A family relocation drawn in its own look (a mirror of ice, a swirl
			-- of mist, a body flicker), never Minato's yellow flash.
			if style=="teleport" and impact.kind and Looks[impact.kind] then
				local look=Looks[impact.kind]
				local color,edge=c3(look.color),c3(look.color2)
				local from,to=impact.from or impact.position,impact.to or impact.position
				if impact.kind=="leaf" then
					-- (Jutsu pass 06/11, the reel: « l'entrée dynamique fait un pouf,
					-- pas un coup de pied volant ») Lee does not vanish: he flies. No
					-- smoke; the dust he tears off the ground where he leaves, a trail
					-- of green afterimages of his kick strung along the line he flew,
					-- wind streaks along it, and the dust ring where he lands.
					local model=folder and folder:FindFirstChild(impact.owner or "")
					local line=to-from
					local GREEN=Color3.fromRGB(70,190,90)
					shockRing(fx.folder,from-Vector3.new(0,2.6,0),c3({206,194,168}),2,8,.3)
					burst(fx.folder,from-Vector3.new(0,2.4,0),{Texture=TEX.smoke,Lifetime=NumberRange.new(.3,.6),Speed=NumberRange.new(6,12),SpreadAngle=Vector2.new(60,60),
						Color=ColorSequence.new(Color3.fromRGB(206,194,168)),LightInfluence=1,Size=num({{0,1},{1,2.4}}),Transparency=num({{0,.3},{1,1}}),Drag=4},10)
					if model and line.Magnitude&gt;1 then
						-- (Studio 06/11: copied on the relocation frame they stood
						-- upright in the stance) a beat later, once the kick is drawn,
						-- strung back along the flight on an arc, leaning into it
						task.delay(.05,function()
							if not model.Parent then return end
							local flatDir=Vector3.new(line.X,0,line.Z)
							local lean=if flatDir.Magnitude&gt;.1 then flatDir.Unit:Cross(Vector3.yAxis) else Vector3.xAxis
							for k=1,5 do
								local u=1-k/6
								local ghost=fx:ghost(model,GREEN,.16+k*.04,.45+k*.07)
								if ghost then
									local pivot=ghost:GetPivot()
									local at=pivot.Position-line*u+Vector3.new(0,math.sin(u*math.pi)*1.6,0)
									pcall(function() ghost:PivotTo(CFrame.fromAxisAngle(lean,math.rad(-14))*(pivot-pivot.Position)+at) end)
								end
							end
						end)
					end
					if line.Magnitude&gt;1 then
						local dir=line.Unit
						local mid=(from+to)/2+Vector3.new(0,.6,0)
						for k=-1,1 do
							local streak=block(fx.folder,Vector3.new(.06,.06,line.Magnitude*.8),CFrame.lookAt(mid+Vector3.new(0,k*.7,0),mid+Vector3.new(0,k*.7,0)+dir),Color3.fromRGB(236,255,236),Enum.Material.Neon)
							streak.Transparency=.35
							tween(streak,.22,{Transparency=1,Size=Vector3.new(.02,.02,line.Magnitude*.3),CFrame=streak.CFrame+dir*line.Magnitude*.3})
							Debris:AddItem(streak,.25)
						end
					end
					shockRing(fx.folder,to-Vector3.new(0,2.6,0),color,2,11,.3)
					sound(anchorPart(fx.folder,to),SOUND.whooshBy or SOUND.whoosh,.5,1.1)
					return true
				end
				smokePuff(fx.folder,from,color,14,2)
				flash(fx.folder,from,edge,1,4,.18,.3)
				smokePuff(fx.folder,to,color,10,1.6)
				flash(fx.folder,to,edge,1.5,6,.2,.2)
				shockRing(fx.folder,to-Vector3.new(0,2.6,0),color,2,10,.3)
				return true
			end
			if style=="look" and impact.kind=="crows" then
				-- (Jutsu pass 05/11, the reel: « on ne voit aucun corbeau ») Itachi's
				-- crow genjutsu drew only the look's puff of smoke. Now a flock pours
				-- out of his sleeve and floods the cone in front of him, wings
				-- beating, black feathers trailing, and scatters past the target.
				local owner=folder and folder:FindFirstChild(impact.owner or "")
				local root=owner and owner:FindFirstChild("HumanoidRootPart")
				local dir=impact.direction or (root and root.CFrame.LookVector) or Vector3.new(0,0,-1)
				dir=Vector3.new(dir.X,0,dir.Z)
				dir=if dir.Magnitude&gt;.1 then dir.Unit else Vector3.new(0,0,-1)
				local side=dir:Cross(Vector3.yAxis)
				local origin=(if root then root.Position else impact.position)+side*.9+Vector3.new(0,.8,0)+dir*1.2
				local reach=impact.radius or 8
				local black,wingTone=Color3.fromRGB(12,12,16),Color3.fromRGB(8,8,12)
				local RunService=game:GetService("RunService")
				for i=1,16 do
					local bird=new("Model",{Name="Crow"},fx.folder)
					local s=.8+math.random()*.5
					local body=block(bird,Vector3.new(.4,.34,.9)*s,CFrame.new(origin),black,Enum.Material.SmoothPlastic)
					local head=block(bird,Vector3.new(.26,.26,.28)*s,CFrame.new(origin),black,Enum.Material.SmoothPlastic)
					local beak=block(bird,Vector3.new(.08,.08,.22)*s,CFrame.new(origin),Color3.fromRGB(40,36,30),Enum.Material.SmoothPlastic)
					local eye=block(bird,Vector3.new(.06,.06,.06)*s,CFrame.new(origin),Color3.fromRGB(200,20,30),Enum.Material.Neon)
					local wingL=block(bird,Vector3.new(1.1,.05,.5)*s,CFrame.new(origin),wingTone,Enum.Material.SmoothPlastic,"WedgePart")
					local wingR=block(bird,Vector3.new(1.1,.05,.5)*s,CFrame.new(origin),wingTone,Enum.Material.SmoothPlastic,"WedgePart")
					local spread=math.rad((math.random()-.5)*70)
					local heading=CFrame.fromAxisAngle(Vector3.yAxis,spread):VectorToWorldSpace(dir)
					local rise=(math.random()-.35)*.5
					local course=(heading+Vector3.new(0,rise,0)).Unit
					local distance=reach*(.8+math.random()*.7)
					local start=origin+Vector3.new((math.random()-.5)*.6,(math.random()-.5)*.8,(math.random()-.5)*.6)
					local delay=i*.024
					local life=.65+math.random()*.35
					local t0=os.clock()+delay
					local phase=math.random()*6
					local conn
					conn=RunService.RenderStepped:Connect(function()
						local k=(os.clock()-t0)/life
						if k&lt;0 then return end
						if k&gt;=1 or not bird.Parent then conn:Disconnect();bird:Destroy();return end
						local at=start:Lerp(start+course*distance,1-(1-k)^1.6)+Vector3.new(0,math.sin(k*math.pi)*.8,0)
						local cf=CFrame.lookAt(at,at+course)
						local flap=math.sin(os.clock()*30+phase)*1.0
						body.CFrame=cf
						head.CFrame=cf*CFrame.new(0,.08*s,-.52*s)
						beak.CFrame=cf*CFrame.new(0,.06*s,-.74*s)
						eye.CFrame=cf*CFrame.new(.1*s,.14*s,-.6*s)
						wingL.CFrame=cf*CFrame.new(-.55*s,.05,0)*CFrame.Angles(0,0,flap)
						wingR.CFrame=cf*CFrame.new(.55*s,.05,0)*CFrame.Angles(0,0,-flap)
						local fade=math.clamp((k-.75)/.25,0,1)
						for _,p in bird:GetChildren() do if p:IsA("BasePart") then p.Transparency=fade end end
					end)
				end
				-- feathers and a dark smoke at the sleeve
				burst(fx.folder,origin,{Texture=TEX.smoke,Lifetime=NumberRange.new(.4,.8),Speed=NumberRange.new(6,12),SpreadAngle=Vector2.new(45,45),
					Color=ColorSequence.new(Color3.fromRGB(30,26,34)),LightInfluence=1,Size=num({{0,1},{1,2.6}}),Transparency=num({{0,.35},{1,1}}),Drag=3},10)
				burst(fx.folder,origin+dir*2,{Texture=TEX.spark,Lifetime=NumberRange.new(.6,1.1),Speed=NumberRange.new(4,10),SpreadAngle=Vector2.new(70,70),
					Color=ColorSequence.new(Color3.fromRGB(14,14,18)),LightEmission=0,LightInfluence=1,Size=num({{0,.3},{1,.18}}),
					Acceleration=Vector3.new(0,-4,0),Drag=2,Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-200,200)},18)
				sound(anchorPart(fx.folder,origin),SOUND.whoosh,.5,.8)
				return true
			end
			if style=="look" and impact.kind=="sandarm" then
				-- (04/11) Gaara's Shukaku arm: a huge arm of sand grows out of his
				-- shoulder and sweeps the arc in front of him, then crumbles.
				local look=Looks.sandarm
				local owner=folder and folder:FindFirstChild(impact.owner or "")
				local root=owner and owner:FindFirstChild("HumanoidRootPart")
				local dir=impact.direction or (root and root.CFrame.LookVector) or Vector3.new(0,0,-1)
				dir=Vector3.new(dir.X,0,dir.Z)
				if dir.Magnitude&lt;.1 then dir=Vector3.new(0,0,-1) end
				dir=dir.Unit
				local origin=(if root then root.Position else impact.position)+Vector3.new(0,1.2,0)
				local reach=impact.radius or 13
				-- (Jutsu pass 05/11, the reel: « juste une bouffée de sable ») The arm
				-- was five sand boxes and a box claw, gone in under half a second.
				-- Now a rounded arm that thickens to the hand (overlapping lumps of
				-- sand), a hand with three hooked fingers and a thumb, sand pouring
				-- off it, and a slower sweep (≈ .7 s) that can be seen.
				local arm=new("Model",{Name="ShukakuArm"},fx.folder)
				local sandTone,dark=c3(look.color),c3(look.color2)
				local function lump(size,tone)
					-- (Studio 06/11: the Sand material read olive green in the arena's
					-- light) plain smooth sand colour
					local p=block(arm,size,CFrame.new(origin),tone,Enum.Material.SmoothPlastic)
					new("SpecialMesh",{MeshType=Enum.MeshType.Sphere},p)
					return p
				end
				local segs={}
				for i=1,7 do
					local k=i/7
					local w=1.5+k*2.1
					table.insert(segs,{part=lump(Vector3.new(w,w*.9,reach/6+1.4),if i%2==0 then dark else sandTone),k=k})
				end
				local palm=lump(Vector3.new(4.2,1.6,3.2),sandTone)
				local fingers={}
				for f=-1,1 do table.insert(fingers,{part=lump(Vector3.new(.9,.8,2.4),dark),x=f*1.25,curl=0}) end
				local thumb={part=lump(Vector3.new(.8,.8,1.8),dark),x=-2.1,curl=0}
				local pour=new("Attachment",{},palm)
				local spill=new("ParticleEmitter",{Texture=TEX.smoke,Rate=60,Lifetime=NumberRange.new(.4,.8),Speed=NumberRange.new(1,3),SpreadAngle=Vector2.new(30,30),
					EmissionDirection=Enum.NormalId.Bottom,Color=ColorSequence.new(sandTone),LightInfluence=1,Size=num({{0,.8},{1,2}}),
					Transparency=num({{0,.3},{1,1}}),Acceleration=Vector3.new(0,-18,0),Drag=1},pour)
				local SPAN=.42 -- seconds per unit of t below (was .3)
				local t0=os.clock()
				local sweep
				sweep=game:GetService("RunService").RenderStepped:Connect(function()
					local t=(os.clock()-t0)/SPAN
					if t&gt;1.7 or not arm.Parent then
						sweep:Disconnect()
						if arm.Parent then
							spill.Enabled=false
							for _,e in segs do smokePuff(fx.folder,e.part.Position,sandTone,6,1.8) end
							smokePuff(fx.folder,palm.Position,sandTone,10,2.4)
							arm:Destroy()
						end
						return
					end
					-- grows over the first third, sweeps from his right to his left,
					-- the hand closing as it crosses
					local grow=math.clamp(t*2.2,0,1)
					local swing=math.clamp((t-.15)/.85,0,1)
					local eased=swing*swing*(3-2*swing)
					local angle=math.rad(70-140*eased)
					local along=(CFrame.fromAxisAngle(Vector3.yAxis,angle):VectorToWorldSpace(dir))
					for _,e in segs do
						local d=reach*e.k*grow
						local at=origin+along*d+Vector3.new(0,-1.3*e.k+math.sin(e.k*math.pi)*.8,0)
						e.part.CFrame=CFrame.lookAt(at,at+along)
					end
					local tip=origin+along*reach*grow+Vector3.new(0,-1.4,0)
					local hand=CFrame.lookAt(tip,tip+along)
					palm.CFrame=hand
					local close=math.rad(25+70*eased)
					for _,f in fingers do
						f.part.CFrame=hand*CFrame.new(f.x,0,-1.4)*CFrame.Angles(-close,0,0)*CFrame.new(0,0,-1)
					end
					thumb.part.CFrame=hand*CFrame.new(thumb.x,0,-.4)*CFrame.Angles(0,math.rad(50),0)*CFrame.Angles(-close*.6,0,0)*CFrame.new(0,0,-.8)
				end)
				burst(fx.folder,origin,{Texture=TEX.smoke,Lifetime=NumberRange.new(.5,1),Speed=NumberRange.new(6,14),SpreadAngle=Vector2.new(80,80),
					Color=ColorSequence.new(c3(look.color)),LightInfluence=1,Size=num({{0,1.2},{1,3}}),Transparency=num({{0,.2},{1,1}}),Drag=2},24)
				return true
			end
			if style=="look" then
				local look=Looks[impact.kind or ""] or Looks.chakra
				hit(fx,look,impact.position,impact.heavy,impact.normal)
				if impact.radius then shockRing(fx.folder,impact.position-Vector3.new(0,2.4,0),c3(look.color),2,impact.radius*2,.45) end
				return true
			elseif style=="zone" then
				local look=Looks[impact.kind or ""] or Looks.chakra
				shockRing(fx.folder,impact.position,c3(look.color2),2,(impact.radius or 8)*2,.5)
				smokePuff(fx.folder,impact.position+Vector3.new(0,1,0),c3(look.color),14,2.6)
				return true
			elseif style=="buff" then
				local model=folder and folder:FindFirstChild(impact.owner or "")
				local root=model and model:FindFirstChild("HumanoidRootPart")
				local color=Looks[impact.kind or ""] and c3(Looks[impact.kind].color) or Color3.fromRGB(255,240,200)
				flash(fx.folder,impact.position,color,2,9,.3,.4)
				shockRing(fx.folder,impact.position-Vector3.new(0,2.6,0),color,3,14,.5)
				if root then sound(root,SOUND.boom,.25,1.3) end
				return true
			elseif style=="stance" then
				local color=Looks[impact.kind or ""] and c3(Looks[impact.kind].color) or Color3.fromRGB(255,255,255)
				shockRing(fx.folder,impact.position-Vector3.new(0,2.6,0),color,7,3,impact.time or .6)
				-- (04/11) Minato's space-time barrier: a sphere of bent space round him
				-- and the formula hanging in front of his palms while it lasts.
				if impact.kind=="barrier" then
					local owner=folder and folder:FindFirstChild(impact.owner or "")
					local root=owner and owner:FindFirstChild("HumanoidRootPart")
					local time=impact.time or .9
					local at=if root then root.CFrame else CFrame.new(impact.position)
					local sphere=block(fx.folder,Vector3.new(1,1,1),at,color,Enum.Material.ForceField)
					new("SpecialMesh",{MeshType=Enum.MeshType.Sphere},sphere)
					sphere.Transparency=.2
					tween(sphere,.12,{Size=Vector3.new(9,9,9)})
					task.delay(math.max(.1,time-.2),function() if sphere.Parent then tween(sphere,.2,{Size=Vector3.new(1,1,1),Transparency=1}) end end)
					Debris:AddItem(sphere,time+.3)
					local card=block(fx.folder,Vector3.new(3.4,3.4,.05),at*CFrame.new(0,.4,-2.6),Color3.fromRGB(250,244,226),Enum.Material.SmoothPlastic)
					card.Transparency=1
					local gui=new("SurfaceGui",{Face=Enum.NormalId.Back,LightInfluence=0,Brightness=2,SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud,PixelsPerStud=40},card)
					local label=new("TextLabel",{BackgroundTransparency=1,Size=UDim2.fromScale(1,1),Text="時空",TextScaled=true,Font=Enum.Font.GothamBold,TextColor3=Color3.fromRGB(255,214,92),TextTransparency=1},gui)
					tween(label,.1,{TextTransparency=.05})
					task.delay(math.max(.1,time-.2),function() if label.Parent then tween(label,.2,{TextTransparency=1}) end end)
					Debris:AddItem(card,time+.3)
					if root then
						local follow
						follow=game:GetService("RunService").RenderStepped:Connect(function()
							if not sphere.Parent or not root.Parent then follow:Disconnect();return end
							sphere.CFrame=root.CFrame;card.CFrame=root.CFrame*CFrame.new(0,.4,-2.6)
						end)
					end
				end
				return true
			elseif style=="summon" then
				-- (04/11) Naruto's Gamakichi: out of a puff of smoke, a small orange
				-- toad squats in front of him, puffs its cheeks and is gone again.
				local look=Looks[impact.kind or ""] or Looks.toad
				local at=impact.position
				-- (Audit 04/11) on the floor under the summoning point (it floated
				-- 1.6 studs up: the point is the water bullet's origin)
				local ok,floor=pcall(floorUnder,fx,at,3,10)
				if ok and floor then at=Vector3.new(at.X,floor.Position.Y,at.Z) end
				local dir=impact.direction or Vector3.new(0,0,-1)
				local frame=CFrame.lookAt(at,at+Vector3.new(dir.X,0,dir.Z))
				smokePuff(fx.folder,at+Vector3.new(0,.6,0),Color3.fromRGB(240,236,230),22,3.4)
				local m=new("Model",{Name="Gamakichi"},fx.folder)
				local skin,vest=c3(look.color),c3(look.color2)
				local body=block(m,Vector3.new(2.4,1.7,2.6),frame*CFrame.new(0,.85,0),skin,Enum.Material.SmoothPlastic)
				new("SpecialMesh",{MeshType=Enum.MeshType.Sphere},body)
				local belly=block(m,Vector3.new(1.9,1.2,.5),frame*CFrame.new(0,.7,-1.15),Color3.fromRGB(252,214,160),Enum.Material.SmoothPlastic)
				new("SpecialMesh",{MeshType=Enum.MeshType.Sphere},belly)
				local cape=block(m,Vector3.new(2.5,.9,1.6),frame*CFrame.new(0,1.35,.5),vest,Enum.Material.Fabric)
				new("SpecialMesh",{MeshType=Enum.MeshType.Sphere},cape)
				for _,side in {-1,1} do
					local eye=block(m,Vector3.new(.7,.7,.7),frame*CFrame.new(side*.62,1.75,-.7),Color3.fromRGB(250,246,230),Enum.Material.SmoothPlastic)
					new("SpecialMesh",{MeshType=Enum.MeshType.Sphere},eye)
					local pupil=block(m,Vector3.new(.32,.44,.2),frame*CFrame.new(side*.62,1.75,-1.02),Color3.fromRGB(20,16,14),Enum.Material.SmoothPlastic)
					new("SpecialMesh",{MeshType=Enum.MeshType.Sphere},pupil)
					local leg=block(m,Vector3.new(.7,.5,1.2),frame*CFrame.new(side*1.1,.25,-.3),skin,Enum.Material.SmoothPlastic)
					new("SpecialMesh",{MeshType=Enum.MeshType.Sphere},leg)
				end
				local parts={}
				for _,p in m:GetChildren() do if p:IsA("BasePart") then table.insert(parts,{p,p.Size}) ;p.Size=p.Size*.2 end end
				for _,e in parts do tween(e[1],.16,{Size=e[2]}) end
				-- the cheeks puff as it spits
				task.delay(.1,function() if body.Parent then tween(body,.08,{Size=Vector3.new(2.7,1.9,2.6)}) end end)
				task.delay(.22,function() if body.Parent then tween(body,.12,{Size=Vector3.new(2.4,1.7,2.6)}) end end)
				local life=impact.time or 1.4
				task.delay(life,function()
					if not m.Parent then return end
					smokePuff(fx.folder,at+Vector3.new(0,.8,0),Color3.fromRGB(240,236,230),16,2.6)
					m:Destroy()
				end)
				return true
			elseif style=="drain" then
				local owner=folder and folder:FindFirstChild(impact.owner or "")
				local to=owner and owner:FindFirstChild("HumanoidRootPart")
				burst(fx.folder,impact.position,{Texture=TEX.glow,Lifetime=NumberRange.new(.3,.5),Speed=NumberRange.new(4,8),SpreadAngle=Vector2.new(60,60),
					Acceleration=if to then (to.Position-impact.position).Unit*30 else Vector3.zero,Color=ColorSequence.new(Color3.fromRGB(120,190,255)),
					LightEmission=1,Size=num({{0,.8},{1,.1}}),Transparency=num({{0,.2},{1,1}})},10)
				-- An object swallowed by an absorbing window: the reward reads on him.
				if impact.projectile and to then
					flash(fx.folder,to.Position,Color3.fromRGB(196,170,230),1,5,.25,.3)
					shockRing(fx.folder,to.Position-Vector3.new(0,2.6,0),Color3.fromRGB(196,170,230),1.5,7,.3)
				end
				return true
			end
			return false
		end,
		fighter=function(fx,model,actor,dt)
			if not model then return end
			local st=auraOf(model)
			local fam=actor.family
			local root=model:FindFirstChild("HumanoidRootPart")
			if not root then return end
			-- (04/11) Lee's nunchaku: out of his belt for the blow (attack
			-- "Nunchaku"), two sticks on a chain whirling from the right hand.
			local nun=actor.attackName=="Nunchaku" and (actor.state=="Startup" or actor.state=="Active" or actor.state=="Recovery")
			if nun and not st.nunchaku then
				local hand=model:FindFirstChild("RightHand")
				if hand then
					local m=new("Model",{Name="Nunchaku"},fx.folder)
					local wood=Color3.fromRGB(120,74,40)
					local s1=block(m,Vector3.new(.22,1.3,.22),hand.CFrame,wood,Enum.Material.Wood)
					local s2=block(m,Vector3.new(.22,1.3,.22),hand.CFrame,wood,Enum.Material.Wood)
					local link=block(m,Vector3.new(.06,.5,.06),hand.CFrame,Color3.fromRGB(150,150,156),Enum.Material.Metal)
					st.nunchaku={model=m,a=s1,b=s2,link=link,hand=hand,t0=os.clock()}
				end
			elseif not nun and st.nunchaku then
				st.nunchaku.model:Destroy();st.nunchaku=nil
			end
			if st.nunchaku and st.nunchaku.hand.Parent then
				local n=st.nunchaku
				local spin=(os.clock()-n.t0)*30
				local grip=n.hand.CFrame*CFrame.new(0,-.7,0)
				n.a.CFrame=grip*CFrame.new(0,-.3,0)
				n.link.CFrame=grip*CFrame.new(0,-1.1,0)
				n.b.CFrame=grip*CFrame.new(0,-1.2,0)*CFrame.Angles(spin,0,0)*CFrame.new(0,-.7,0)
			end
			local buffed=fam and fam.buff~=nil
			-- An absorbing window (a Buff with Absorb: Nagato's seal), QA-004 M5:
			-- open, a faint sphere of its radius round him; closed, it folds in
			-- with a ring, so the end of the window reads without F8.
			local absorbSpec=nil
			if buffed then
				local def=Fighters[actor.fighterId or ""]
				for _,spec in SealJutsu.all(def) do if spec.Id==fam.buff and spec.Absorb then absorbSpec=spec end end
			end
			if absorbSpec and not st.absorb then
				local look=Looks[absorbSpec.Kind or "chakra"] or Looks.chakra
				local r=(absorbSpec.Absorb.Radius or 6)
				local sphere=block(fx.folder,Vector3.new(r*2,r*2,r*2),root.CFrame,c3(look.color),Enum.Material.ForceField)
				new("SpecialMesh",{MeshType=Enum.MeshType.Sphere},sphere)
				sphere.Name="AbsorbWindow";sphere.Transparency=.55
				st.absorb=sphere;st.absorbColor=c3(look.color)
			elseif not absorbSpec and st.absorb then
				local sphere=st.absorb;st.absorb=nil
				tween(sphere,.25,{Size=Vector3.new(.5,.5,.5),Transparency=1});Debris:AddItem(sphere,.3)
				shockRing(fx.folder,root.Position-Vector3.new(0,2.6,0),st.absorbColor,6,1,.25)
			end
			if st.absorb then st.absorb.CFrame=root.CFrame end
			-- A buff that draws a weapon (its Kind is a blade/needle look: the
			-- Camellia's bone sword, the chakra scalpel) holds it in the right hand.
			local held=nil
			if buffed then
				local def=Fighters[actor.fighterId or ""]
				for _,spec in SealJutsu.all(def) do
					if spec.Id==fam.buff and spec.Kind and Looks[spec.Kind] and (Looks[spec.Kind].shape=="blade" or Looks[spec.Kind].shape=="needle") then held=spec.Kind end
				end
			end
			if held~=st.weaponKind then
				if st.weapon then st.weapon:Destroy();st.weapon=nil end
				st.weaponKind=held
				local hand=model:FindFirstChild("RightHand")
				if held and hand then
					local look=Looks[held]
					local length=math.max(look.size[3]*1.6,2.2)
					local w=block(model,Vector3.new(math.max(look.size[1],.18),math.max(look.size[2],.18),length),hand.CFrame*CFrame.new(0,-.4,-length*.5),c3(look.color),Enum.Material.Neon)
					w.Name="FamilyWeapon";w.Anchored=false;w.CanCollide=false;w.Massless=true;w.Transparency=.1
					new("WeldConstraint",{Part0=hand,Part1=w},w)
					glow(w,c3(look.color2),look.light)
					st.weapon=w
				end
			end
			if buffed and not st.aura then
				local at=new("Attachment",{Name="FamilyAura"},root)
				local color=fighterColor(actor)
				st.aura=new("ParticleEmitter",{Texture=TEX.glow,Rate=26,Lifetime=NumberRange.new(.35,.6),Speed=NumberRange.new(2,4),SpreadAngle=Vector2.new(25,25),
					EmissionDirection=Enum.NormalId.Top,Shape=Enum.ParticleEmitterShape.Cylinder,Color=ColorSequence.new(color),LightEmission=.8,LightInfluence=0,
					Size=num({{0,1.4},{1,.2}}),Transparency=num({{0,.45},{1,1}})},at)
				st.aura.ShapeStyle=Enum.ParticleEmitterShapeStyle.Surface
				st.auraAt=at
			elseif not buffed and st.aura then
				st.aura.Enabled=false;Debris:AddItem(st.auraAt,1);st.aura=nil;st.auraAt=nil
			end
			-- Held by a family bind: what holds the body shows on it.
			local held=actor.boundKind
			if held~=st.heldKind then
				if st.held then st.held:Destroy();st.held=nil end
				st.heldKind=held
				if held and Looks[held] then st.held=FamilyFX.bindVisual(fx,model,root,Looks[held]) end
			end
			if st.held and st.held.Parent then
				local t=os.clock()
				for _,p in st.held:GetChildren() do
					local spin=p:GetAttribute("Spin")
					if spin then p.CFrame=root.CFrame*CFrame.new(0,p:GetAttribute("Y") or 0,0)*CFrame.Angles(0,t*spin,0)*CFrame.Angles(0,0,math.rad(90)) end
				end
			end
			local slowed=fam and (fam.slowed or 0)&gt;0
			if slowed and not st.slow then
				local at=new("Attachment",{Name="FamilySlow",Position=Vector3.new(0,-2.6,0)},root)
				st.slow=new("ParticleEmitter",{Texture=TEX.smoke,Rate=14,Lifetime=NumberRange.new(.4,.7),Speed=NumberRange.new(.5,1.5),
					Color=ColorSequence.new(Color3.fromRGB(40,36,52)),LightInfluence=1,Size=num({{0,1.2},{1,2}}),Transparency=num({{0,.5},{1,1}})},at)
				st.slowAt=at
			elseif not slowed and st.slow then
				st.slow.Enabled=false;Debris:AddItem(st.slowAt,1);st.slow=nil;st.slowAt=nil
			end
		end,
	})
end
return FamilyFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND209">
          <Properties>
            <string name="Name">GaleFX</string>
            <ProtectedString name="Source">-- Temari on the client (roster wave): the iron fan (closed on her back at rest,
-- a heavy club in the hand for her strikes, opened moon by moon for the wind,
-- planted beside her at the intro), the Kamaitachi scythe and Kamatari in
-- flight, the zones (Zones.luau: wind lanes stream along their direction,
-- updraft columns rise; never fire), her gusts, the whirlwind and her contacts
-- in the wind's colours. One identity layer installed into Effects (like
-- SandFX and LeeFX), plus a `frame` step that draws the snapshot's zones.
-- Presentation only: nothing here can change gameplay.
local Debris=game:GetService("Debris")

local GaleFX={}
local K -- Effects' helpers, handed over by install()
GaleFX.clock=os.clock -- (headless tests drive time)
local GALE="Gale"

local WIND=Color3.fromRGB(196,255,232)
local WIND_CORE=Color3.fromRGB(242,255,250)
local WIND_DEEP=Color3.fromRGB(116,204,170)
local MOON=Color3.fromRGB(146,108,204)
local IRON=Color3.fromRGB(60,62,72)
local IRON_EDGE=Color3.fromRGB(150,152,166)
local PAPER=Color3.fromRGB(230,226,214)
local DUST=Color3.fromRGB(214,206,186)
local FIRE=Color3.fromRGB(255,150,60)

local function flatUnit(v,fallback)
	local f=Vector3.new(v.X,0,v.Z)
	return if f.Magnitude&gt;.05 then f.Unit else (fallback or Vector3.zAxis)
end
local function ground(fx,position,fallback)
	local ok,hit=pcall(K.floorUnder,fx,position,3,12)
	return if ok and hit then hit.Position.Y else fallback
end
-- Thin streaks of air: the readable unit of every wind effect here.
local function streak(parent,from,to,color,width,time,transparency)
	local d=to-from
	if d.Magnitude&lt;.05 then return nil end
	local s=K.block(parent,Vector3.new(width or .1,width or .1,d.Magnitude),CFrame.lookAt(from:Lerp(to,.5),to),color or WIND,Enum.Material.Neon)
	s.Name="WindStreak";s.Transparency=transparency or .3
	if time then K.tween(s,time,{Transparency=1,Size=Vector3.new(.02,.02,d.Magnitude*1.2)});Debris:AddItem(s,time+.05) end
	return s
end
-- A fan of streaks blown from `at` along `direction` (a cone of half angle `spread`).
local function gustCone(fx,name,at,direction,range,spread,count,color,time)
	local holder=K.new("Model",{Name=name},fx.folder)
	local look=flatUnit(direction)
	for k=1,count do
		local a=((k-1)/math.max(1,count-1)-.5)*2*spread+(math.random()-.5)*.08
		local dir=CFrame.fromAxisAngle(Vector3.yAxis,a):VectorToWorldSpace(look)
		local from=at+dir*(1+math.random()*2)+Vector3.new(0,(math.random()-.5)*2.4,0)
		streak(holder,from,from+dir*(range*(.55+math.random()*.45)),color or WIND,.12,time or .3,.25)
	end
	Debris:AddItem(holder,(time or .3)+.2)
	return holder
end

-- ------------------------------------------------------------------ the fan
-- Nine slats on one pivot (the grip), along -Y: folded onto one bar it is a
-- heavy iron club, spread over half a circle it is the open fan with its three
-- moons painted on the face.
local SLATS,LENGTH=9,4.4
local function buildFan()
	local model=K.new("Model",{Name="TemariFan"})
	local grip=K.block(model,Vector3.new(.3,.3,.3),CFrame.new(),IRON);grip.Name="Grip";grip.Transparency=1;grip.Anchored=false;grip.Massless=true
	model.PrimaryPart=grip
	local function hinge(part,c0)
		part.Anchored=false;part.Massless=true
		return K.new("Weld",{Name="Hinge",Part0=grip,Part1=part,C0=c0},part)
	end
	local slats={}
	for i=1,SLATS do
		local slat=K.block(model,Vector3.new(.95,LENGTH,.1),CFrame.new(),if i%2==0 then PAPER else Color3.fromRGB(238,234,224))
		slat.Name="FanSlat"
		table.insert(slats,{part=slat,weld=hinge(slat,CFrame.new(0,-LENGTH/2,0)),spread=(i-(SLATS+1)/2)/((SLATS-1)/2)})
	end
	-- Closed: the iron spine that makes it a weapon; two bands and a cap.
	local bar=K.block(model,Vector3.new(1.05,LENGTH+.1,.42),CFrame.new(),IRON,Enum.Material.Metal);bar.Name="FanBar"
	hinge(bar,CFrame.new(0,-LENGTH/2,0))
	local bands={}
	for k,y in {-.5,-LENGTH+.6} do
		local band=K.block(model,Vector3.new(1.12,.16,.5),CFrame.new(),IRON_EDGE,Enum.Material.Metal);band.Name="FanBand"
		hinge(band,CFrame.new(0,y,0));bands[k]=band
	end
	local moons={}
	for k=1,3 do
		local moon=K.block(model,Vector3.new(.04,1.05,1.05),CFrame.new(),MOON);moon.Name="FanMoon";moon.Shape=Enum.PartType.Cylinder;moon.Transparency=1
		moons[k]={part=moon,weld=hinge(moon,CFrame.new()),angle=({-46,0,46})[k]}
	end
	return {model=model,grip=grip,slats=slats,bar=bar,bands=bands,moons=moons,open=0,moonsShown=0}
end
-- Open fraction 0 (closed club) .. 1 (half circle), `moons` painted moons shown.
local function shapeFan(fan,open,moons,lit)
	fan.open=open;fan.moonsShown=moons
	for _,s in fan.slats do s.weld.C0=CFrame.Angles(0,0,math.rad(s.spread*82*open))*CFrame.new(0,-LENGTH/2,0) end
	local closed=open&lt;.25
	fan.bar.Transparency=if closed then 0 else 1
	for _,band in fan.bands do band.Transparency=if closed then 0 else 1 end
	for k,m in fan.moons do
		m.weld.C0=CFrame.Angles(0,0,math.rad(m.angle*open))*CFrame.new(0,-LENGTH*.62,-.08)*CFrame.Angles(0,math.rad(90),0)
		-- One moon per third of the opening.
		m.part.Transparency=if k&lt;=moons and open&gt;=k/3-.02 then 0 else 1
		m.part.Material=if lit then Enum.Material.Neon else Enum.Material.SmoothPlastic
	end
end
-- Where it sits: on the back (grip over the right shoulder, across to the left
-- hip), in the right hand (closed along the forearm, open with its face to the
-- swing), planted beside her (the intro).
local MOUNT={
	back={"UpperTorso",CFrame.new(.72,1.25,.72)*CFrame.Angles(0,0,math.rad(-30))},
	hand={"RightHand",CFrame.new(0,-.22,0)},
	open={"RightHand",CFrame.new(0,-.22,0)*CFrame.Angles(0,math.rad(90),0)},
	planted={"HumanoidRootPart",CFrame.new(2.4,-2.9,.2)*CFrame.Angles(0,math.rad(70),math.pi)},
}
GaleFX.MOUNT=MOUNT
local CAST_MOONS={Kamaitachi=1,Cyclone=2,GreatGust=3}
local CHANNEL={Kamaitachi=.3,Cyclone=.24,GreatGust=.5}
-- The fan opens for the strikes that blow (the third, the pirouette, the dive, the scoop).
local OPEN_STRIKE={Light3=1,FanPirouette=1,FanDive=1,Updraft=.6}
local SWINGING={Startup=true,Active=true,Recovery=true}
local CASTING={TechniqueChannel=true,TechniqueActive=true,TechniqueRecovery=true}
-- Mount, open fraction and moons for this frame, from the snapshot alone.
function GaleFX.fanPose(actor)
	if (actor.health or 1)&lt;=0 then return "back",0,0 end
	if (actor.intro or 0)&gt;0 and actor.state=="Neutral" then return "planted",1,3 end
	local awake=(actor.awaken or 0)&gt;0
	local cast=actor.castId
	if cast and CAST_MOONS[cast] and CASTING[actor.state] then
		local open=if actor.state=="TechniqueChannel" then math.clamp((actor.castElapsed or 0)/CHANNEL[cast],.15,1) else 1
		local moons=math.max(1,math.ceil(CAST_MOONS[cast]*open-.01))
		return "open",open,if awake then 3 else moons
	end
	if actor.throwKind=="Gust" and (actor.throwElapsed or 99)&gt;=0 and (actor.throwElapsed or 99)&lt;.45 then return "open",1,if awake then 3 else 1 end
	local name=actor.attackName
	-- (late in a recovery the arm is back on the hip: the fan is put away)
	if name and SWINGING[actor.state] and not (actor.state=="Recovery" and (actor.attackElapsed or 0)&gt;.45) then
		local open=OPEN_STRIKE[name] or 0
		return if open&gt;0 then "open" else "hand",open,if open&gt;0 then 1 else 0
	end
	if actor.glide then return "open",1,0 end
	return "back",0,if awake then 3 else 0
end
local function fanFor(fx,model)
	fx.galeFans=fx.galeFans or setmetatable({},{__mode="k"})
	local fan=fx.galeFans[model]
	if fan and fan.model.Parent==model then return fan end
	fan=buildFan()
	fan.model.Parent=model
	fan.carry=K.new("Weld",{Name="FanCarry",Part1=fan.grip},fan.grip)
	fx.galeFans[model]=fan
	return fan
end
local function holdFan(fx,model,actor)
	local fan=fanFor(fx,model)
	local mount,open,moons=GaleFX.fanPose(actor)
	local spec=MOUNT[mount]
	local part=model:FindFirstChild(spec[1]) or model:FindFirstChild("HumanoidRootPart")
	if part and (fan.carry.Part0~=part or fan.mount~=mount) then
		fan.carry.Part0=part;fan.carry.C0=spec[2]
		-- Drawn or put away: a small gust where the fan moves.
		if fan.mount and (mount=="back")~=(fan.mount=="back") then
			local at=(part.CFrame*spec[2]).Position
			K.shockRing(fx.folder,at,WIND,.4,3.2,.18)
		end
		fan.mount=mount
	end
	if math.abs(fan.open-open)&gt;.01 or fan.moonsShown~=moons or fan.lit~=((actor.awaken or 0)&gt;0) then
		fan.lit=(actor.awaken or 0)&gt;0
		shapeFan(fan,open,moons,fan.lit)
	end
	return fan
end

-- ------------------------------------------------------------------ flights
-- Kamaitachi: a wide crescent of cutting air, as big as the server's swept
-- radius at every moment (it grows as it flies), streaming a pale trail.
local ARC=9
local function buildScythe(name,color)
	return function()
		local model=K.new("Model",{Name=name})
		local root=K.block(model,Vector3.new(.1,.1,.1),CFrame.new(),Color3.new());root.Name="Root";root.Transparency=1
		for k=1,ARC do
			local seg=K.block(model,Vector3.new(1,.08,.4),CFrame.new(),color or WIND,Enum.Material.Neon)
			seg.Name="ScytheArc";seg.Transparency=.25+math.abs(k-(ARC+1)/2)*.07
		end
		local a0=K.new("Attachment",{Position=Vector3.new(-2.6,0,0)},root)
		local a1=K.new("Attachment",{Position=Vector3.new(2.6,0,0)},root)
		K.new("Trail",{Attachment0=a0,Attachment1=a1,Color=ColorSequence.new(color or WIND),LightEmission=.6,Transparency=K.num({{0,.5},{1,1}}),
			Lifetime=.22,FaceCamera=true},root)
		model.PrimaryPart=root
		return model
	end
end
local function scythePose(_,entry,p,age,look,dt)
	local radius=(p.radius or 2)+(p.growth or 0)*math.max(0,age)
	entry.spin=(entry.spin or 0)+dt*2
	local i=0
	for _,seg in entry.model:GetChildren() do
		if seg.Name=="ScytheArc" then
			i+=1
			local a=math.rad(-62+(i-1)*124/(ARC-1))
			local tilt=math.sin(entry.spin+i)*.06
			seg.Size=Vector3.new(radius*.48,.08+radius*.02,.42)
			seg.CFrame=look*CFrame.Angles(0,a,tilt)*CFrame.new(0,0,-radius*.85)
		end
	end
	return look
end
-- Kamatari: the one-eyed weasel riding a giant crescent, its sickle out.
local function buildKamatari()
	local model=buildScythe("Kamatari",WIND_CORE)()
	local root=model.PrimaryPart
	local fur=Color3.fromRGB(240,236,226)
	local parts={}
	local body=K.block(model,Vector3.new(1.1,1,2.2),CFrame.new(0,.9,.4),fur);body.Shape=Enum.PartType.Ball;body.Name="KamatariBody";table.insert(parts,body)
	local head=K.block(model,Vector3.new(.9,.85,.9),CFrame.new(0,1.5,-.7),fur);head.Shape=Enum.PartType.Ball;head.Name="KamatariHead";table.insert(parts,head)
	for _,x in {-.3,.3} do table.insert(parts,K.block(model,Vector3.new(.2,.3,.12),CFrame.new(x,1.95,-.75),fur)) end
	table.insert(parts,K.block(model,Vector3.new(.24,.06,.04),CFrame.new(-.18,1.58,-1.14),Color3.fromRGB(30,26,30))) -- the scarred eye
	local tail=K.block(model,Vector3.new(.35,.35,1.6),CFrame.new(0,1.1,1.8)*CFrame.Angles(math.rad(-25),0,0),fur);tail.Name="KamatariTail";table.insert(parts,tail)
	local blade=K.block(model,Vector3.new(.08,.5,2.6),CFrame.new(.9,1.3,-.6)*CFrame.Angles(0,math.rad(20),math.rad(-30)),IRON_EDGE,Enum.Material.Metal)
	blade.Name="KamatariSickle";table.insert(parts,blade)
	K.weldAll(root,parts)
	return model
end

-- ------------------------------------------------------------------ zones
-- A lane: a faint band on the floor and streaks of air running along it,
-- downwind, at body height (the kind of zone is read at a glance: no flame).
local LANE_STREAKS=12
local function laneVisual(fx,z)
	local holder=K.new("Model",{Name="WindLane"},fx.folder)
	local y=ground(fx,z.origin+Vector3.new(0,1,0),z.origin.Y)
	-- The band itself stays almost invisible (seen in Studio: a translucent slab
	-- on the floor read as a placeholder block); the ground shows the wind by
	-- the dust it drags along the lane.
	local band=K.block(holder,Vector3.new(1,.06,1),CFrame.new(),if z.reflect then MOON else WIND_DEEP);band.Name="WindBand";band.Transparency=1
	K.new("ParticleEmitter",{Name="LaneDust",Texture=K.TEX.smoke,Rate=26,Lifetime=NumberRange.new(.45,.8),Speed=NumberRange.new(7,12),
		SpreadAngle=Vector2.new(6,4),EmissionDirection=Enum.NormalId.Front,Shape=Enum.ParticleEmitterShape.Box,
		Color=ColorSequence.new(if z.reflect then MOON else Color3.fromRGB(214,226,218)),LightInfluence=1,
		Size=K.num({{0,.9},{1,2.4}}),Transparency=K.num({{0,1},{.25,.78},{1,1}}),Drag=2,Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-40,40)},band)
	local streaks={}
	for k=1,LANE_STREAKS do
		local s=K.block(holder,Vector3.new(.09,.09,2.6),CFrame.new(),if z.reflect and k%3==0 then MOON else WIND,Enum.Material.Neon)
		s.Name="WindStreak";s.Transparency=.4
		table.insert(streaks,{part=s,phase=math.random(),across=(math.random()*2-1),height=.5+math.random()*4,speed=.75+math.random()*.5})
	end
	Debris:AddItem(holder,(z.remaining or 4)+1)
	return {holder=holder,band=band,streaks=streaks,floor=y,shown=0}
end
local function laneStep(fx,v,z,dt)
	-- The lane grows with the scythe that lays it: ease toward the reported length.
	v.shown=v.shown+(z.length-v.shown)*math.min(1,dt*18)
	local length=math.max(.5,v.shown)
	local dir=flatUnit(z.direction)
	local across=dir:Cross(Vector3.yAxis)
	local base=Vector3.new(z.origin.X,v.floor,z.origin.Z)
	local fade=math.clamp((z.remaining or 1)/.5,0,1)
	v.band.Size=Vector3.new(z.width*2,.06,length)
	v.band.CFrame=CFrame.lookAt(base+dir*length/2+Vector3.new(0,.04,0),base+dir*length/2+Vector3.new(0,.04,0)+dir)
	local dust=v.band:FindFirstChild("LaneDust")
	if dust then dust.Rate=26*fade*math.clamp(length/12,.4,2) end
	local t=GaleFX.clock()
	for _,s in v.streaks do
		local along=((t*s.speed*1.4+s.phase)%1)*length
		local at=base+dir*along+across*s.across*z.width*.9+Vector3.new(0,s.height,0)
		s.part.CFrame=CFrame.lookAt(at,at+dir)
		-- Bright mid-lane, fading at both ends and as the lane dies.
		local edge=math.min(along,length-along)/math.max(1,length*.2)
		s.part.Transparency=1-(.6*math.clamp(edge,0,1)*fade)
	end
end
-- A column of rising air: rings climbing and turning, streaks spiralling up.
local function columnVisual(fx,z)
	local holder=K.new("Model",{Name="Updraft"},fx.folder)
	local y=ground(fx,z.origin+Vector3.new(0,1,0),z.origin.Y)
	local rings={}
	for k=1,3 do
		local r=K.block(holder,Vector3.new(.08,z.radius*2,z.radius*2),CFrame.new(),WIND,Enum.Material.Neon);r.Name="UpdraftRing";r.Shape=Enum.PartType.Cylinder;r.Transparency=.6
		table.insert(rings,{part=r,phase=k/3})
	end
	local spirals={}
	for k=1,6 do
		local s=K.block(holder,Vector3.new(.1,1.8,.1),CFrame.new(),WIND_CORE,Enum.Material.Neon);s.Name="WindStreak";s.Transparency=.4
		table.insert(spirals,{part=s,phase=k/6})
	end
	K.smokePuff(fx.folder,Vector3.new(z.origin.X,y+.6,z.origin.Z),DUST,14,1.8)
	Debris:AddItem(holder,(z.remaining or 2)+1)
	return {holder=holder,rings=rings,spirals=spirals,floor=y}
end
local function columnStep(fx,v,z,dt)
	local t=GaleFX.clock()
	local base=Vector3.new(z.origin.X,v.floor,z.origin.Z)
	local fade=math.clamp((z.remaining or 1)/.4,0,1)
	local h=math.min(z.height or 16,16)
	for _,r in v.rings do
		local u=(t*.8+r.phase)%1
		r.part.Size=Vector3.new(.08,z.radius*2*(1-u*.3),z.radius*2*(1-u*.3))
		r.part.CFrame=CFrame.new(base+Vector3.new(0,.2+u*h,0))*CFrame.Angles(0,t*3,math.pi/2)
		r.part.Transparency=1-(.4*(1-u)*fade)
	end
	for _,s in v.spirals do
		local u=(t*.9+s.phase)%1
		local a=s.phase*math.pi*2+t*5
		local at=base+Vector3.new(math.cos(a)*z.radius*.8,.5+u*h,math.sin(a)*z.radius*.8)
		s.part.CFrame=CFrame.new(at)*CFrame.Angles(0,-a,math.rad(18))
		s.part.Transparency=1-(.55*(1-u)*fade)
	end
end
local function frame(fx,data,dt)
	local st=fx.galeZones
	if not st or st.epoch~=data.epoch then
		if st then for _,v in st.list do v.holder:Destroy() end end
		st={epoch=data.epoch,list={}};fx.galeZones=st
	end
	local live={}
	for _,z in data.zones or {} do
		live[z.id]=true
		local v=st.list[z.id]
		if not v then
			v=if z.kind=="Updraft" then columnVisual(fx,z) else laneVisual(fx,z)
			v.kind=z.kind;st.list[z.id]=v
		end
		if z.kind=="Updraft" then columnStep(fx,v,z,dt) else laneStep(fx,v,z,dt) end
	end
	for id,v in st.list do
		if not live[id] then
			for _,d in v.holder:GetDescendants() do if d:IsA("BasePart") then K.tween(d,.25,{Transparency=1}) end end
			Debris:AddItem(v.holder,.3)
			st.list[id]=nil
		end
	end
end

-- ------------------------------------------------------------------ contacts
local function windBurst(fx,at,direction,size,color)
	local holder=K.new("Model",{Name="WindBurst"},fx.folder)
	local look=flatUnit(direction or Vector3.zAxis)
	for k=1,7 do
		local a=math.rad(-70+(k-1)*140/6)
		local dir=CFrame.fromAxisAngle(Vector3.yAxis,a):VectorToWorldSpace(look)
		streak(holder,at+dir*.6,at+dir*(size*(1+math.random()*.5)),color or WIND,.12,.22,.2)
	end
	K.shockRing(holder,at,color or WIND,.6,size*2.4,.24,look)
	Debris:AddItem(holder,.4)
	K.sound(K.anchorPart(fx.folder,at),K.SOUND.whoosh,.4,.8+math.random()*.2)
end
local function impact(fx,data,folder)
	local style=data.style
	local at=data.position
	if data.kind=="gale" or data.kind=="kamatari" then
		-- The scythe (or Kamatari) ends: on a body, on a wall, on a guard, or in the air.
		local big=data.kind=="kamatari"
		local size=if style=="fade" then 1.4 elseif style=="spent" then 2 else 3
		windBurst(fx,at,data.direction,size*(if big then 1.6 else 1),if big then WIND_CORE else WIND)
		if style~="fade" then K.smokePuff(fx.folder,at,DUST,if big then 16 else 8,if big then 2.2 else 1.4) end
		if style~="fade" and style~="spent" then fx:cheer(if big then 1 else .5) end
		return true
	end
	if style=="gust" then
		local reach=data.range or 18
		gustCone(fx,"FanGust",at,data.direction or Vector3.zAxis,reach,math.rad(34),if data.heavy then 14 else 9,if data.infusion then WIND_CORE else WIND,.32)
		K.smokePuff(fx.folder,at-Vector3.new(0,2.2,0)+flatUnit(data.direction or Vector3.zAxis)*3,DUST,8,1.3)
		K.sound(K.anchorPart(fx.folder,at),K.SOUND.whoosh,.45,.7)
		return true
	elseif style=="greatgust" then
		local look=flatUnit(data.direction or Vector3.zAxis)
		gustCone(fx,"GreatGust",at,look,data.range or 30,math.rad(42),22,WIND,.45)
		K.shockRing(fx.folder,at-Vector3.new(0,2.4,0),WIND,3,(data.range or 30)*.9,.45)
		K.smokePuff(fx.folder,at-Vector3.new(0,2.2,0)+look*6,DUST,24,2.6)
		K.sound(K.anchorPart(fx.folder,at),K.SOUND.boom,.4,1.4)
		fx:cheer(.8)
		return true
	elseif style=="cyclone" then
		local radius=data.radius or 3.4
		if data.phase=="mark" then
			-- The spot is marked a beat before it rises: a swirl on the floor.
			local y=ground(fx,at,at.Y-.3)
			local holder=K.new("Model",{Name="CycloneMark"},fx.folder)
			local disc=K.block(holder,Vector3.new(.05,radius*2,radius*2),CFrame.new(at.X,y+.05,at.Z)*CFrame.Angles(0,0,math.pi/2),WIND_DEEP);disc.Shape=Enum.PartType.Cylinder;disc.Transparency=.6
			for k=0,5 do
				local a=k/6*math.pi*2
				streak(holder,Vector3.new(at.X+math.cos(a)*radius,y+.1,at.Z+math.sin(a)*radius),Vector3.new(at.X+math.cos(a+1)*radius*.4,y+.1,at.Z+math.sin(a+1)*radius*.4),WIND,.1,data.delay or .45,.3)
			end
			K.tween(disc,data.delay or .45,{Transparency=.3})
			Debris:AddItem(holder,(data.delay or .45)+.1)
		else
			-- It rises (or holds the scooped body): a burst of air straight up.
			local holder=K.new("Model",{Name="CycloneRise"},fx.folder)
			for k=0,7 do
				local a=k/8*math.pi*2
				local from=at+Vector3.new(math.cos(a)*radius*.7,.2,math.sin(a)*radius*.7)
				streak(holder,from,from+Vector3.new(math.cos(a+.6),8,math.sin(a+.6)),WIND,.14,.4,.2)
			end
			K.shockRing(holder,at,WIND,1,radius*3,.3)
			Debris:AddItem(holder,.5)
			K.smokePuff(fx.folder,at,DUST,if data.phase=="rise" then 16 else 6,1.6)
			K.sound(K.anchorPart(fx.folder,at),K.SOUND.whoosh,.5,.6)
		end
		return true
	elseif style=="windfeed" then
		-- Fire crossing her wind flares up.
		K.flash(fx.folder,at,FIRE,1,5,.25,.2)
		K.shockRing(fx.folder,at,WIND,.8,5,.25,data.direction)
		return true
	elseif style=="winddeflect" then
		-- A blade turned aside by a lane: a swirl, the blade tumbles out of it.
		K.shockRing(fx.folder,at,WIND,.5,3.6,.2,data.direction)
		pcall(fx.tumble,fx,data.kind,at,data.direction,WIND)
		return true
	end
	if data.fighter~=GALE then return false end
	if style=="awaken" then
		-- Kirikiri Mai: the fan fully open, the moons lit, the wind around her.
		local model=folder and folder:FindFirstChild(data.owner or "")
		if model then fx:ghost(model,WIND,.4,.4) end
		K.flash(fx.folder,at,WIND_CORE,2,12,.3,.15)
		K.shockRing(fx.folder,at-Vector3.new(0,2.6,0),MOON,3,22,.45)
		K.shockRing(fx.folder,at-Vector3.new(0,2.4,0),WIND,3,28,.55)
		gustCone(fx,"KirikiriMai",at,Vector3.xAxis,14,math.pi,16,WIND,.5)
		K.sound(K.anchorPart(fx.folder,at),K.SOUND.boom,.45,1.2)
		fx:cheer(1)
		return true
	elseif style=="chase" then
		-- Her wind step (or a chase): a pale copy left behind, streaks along the way.
		local model=folder and folder:FindFirstChild(data.owner or "")
		if model then fx:ghost(model,WIND,.25,.55) end
		if data.to then
			for k=1,4 do
				local off=Vector3.new((math.random()-.5)*1.6,(math.random()-.2)*2,(math.random()-.5)*1.6)
				streak(fx.folder,at+off,data.to+off,WIND,.1,.25,.35)
			end
		end
		K.smokePuff(fx.folder,at-Vector3.new(0,2.6,0),DUST,6,1.2)
		K.sound(K.anchorPart(fx.folder,at),K.SOUND.whoosh,.35,1.05)
		return true
	elseif style=="afterimage" then
		local model=folder and folder:FindFirstChild(data.owner or "")
		if model then fx:ghost(model,WIND,.3,.5) end
		return true
	elseif style=="cast" then
		-- The fan opens: air gathers round the hand.
		local model=folder and folder:FindFirstChild(data.owner or "")
		local hand=model and model:FindFirstChild("RightHand")
		local where=if hand then hand.Position else at
		K.shockRing(fx.folder,where,WIND,.4,4,.25)
		return true
	end
	return false
end

-- ------------------------------------------------------------------ per frame
local function fighter(fx,model,actor,_dt)
	if not model or not actor or actor.fighterId~=GALE then return end
	holdFan(fx,model,actor)
	-- Her awakening mantle and speed trail take the wind's colour.
	local aura=fx.auras and fx.auras[model]
	if aura and aura.mantle and aura.galeMantle~=aura.mantle then
		aura.mantle.emitter.Color=ColorSequence.new(WIND)
		aura.mantle.light.Color=WIND
		aura.galeMantle=aura.mantle
	end
	if aura and aura.trail and not aura.galeTrail then aura.trail.Color=ColorSequence.new(WIND);aura.galeTrail=true end
end

function GaleFX.install(FX,kit)
	K=kit
	kit.BUILD.gale=buildScythe("Kamaitachi",WIND)
	kit.BUILD.kamatari=buildKamatari
	FX.poses.gale=scythePose
	FX.poses.kamatari=scythePose
	table.insert(FX.layers,{name="Gale",impact=impact,fighter=fighter,frame=frame})
end
return GaleFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND210">
          <Properties>
            <string name="Name">GaleMotion</string>
            <ProtectedString name="Source">-- Temari's motion family (roster wave, DEC-015): her stance, gait, clips,
-- throw overlay (the fan gust), cast poses and intro, added to the motion
-- engine's tables by install(E) (VelmoraMotionEngine passes its STANCE, GAIT,
-- CLIPS, THROWS, CAST, INTRO and builders). No clip of another fighter for her
-- string, routes, heavy or air: the right hand always carries the iron fan
-- (GaleFX draws it), so every strike is a thrust, a sweep or a chop with a
-- long, heavy weapon, the third and the routes open it into a gust. Grabs and
-- throws fall back to Itachi's (listed in TEMARI.md). Presentation only.
local GaleMotion={}
function GaleMotion.install(E)
	local K,merge,smooth=E.K,E.merge,E.smooth
	-- Upright and composed, weight on the back foot, left side to the opponent,
	-- chin up; the right hand rests on the hip (the fan is on her back), the
	-- left hand low and open in front.
	local T={root={y=-.22,pitch=-2,yaw=26},torso={pitch=-3,yaw=-12},head={pitch=-6,yaw=-14},
		ra={raise=-8,out=38,twist=-50,elbow=104,wrist=10},la={raise=46,out=6,twist=-14,elbow=40,wrist=-20},
		rf={x=.18,z=.66,yaw=34},lf={x=-.06,z=-.5,yaw=-4},breath=.6,tempo=4.4}
	E.STANCE.Gale=T
	-- Measured steps, little bounce, no guard carried; the hand stays on the
	-- hip until she breaks into a full run (holdRear).
	E.GAIT.Gale={stride=.98,cadence=.92,arm=16,lean=-1,bob=.65,guard=0,holdRear=true}
	local function t(over) return merge(T,over) end
	local AIR={root={pitch=4},torso={pitch=6},head={pitch=-6},ra={raise=60,out=30,elbow=70},la={raise=40,out=30,elbow=60},rl={lift=50,knee=86,ankle=-10},ll={lift=30,knee=64,ankle=-10}}
	local function air(over) return merge(AIR,over) end
	local C={}
	C.Light1={ -- the closed fan driven straight out like a spear
		K(0,t({root={y=-.34,yaw=40,pitch=2},torso={yaw=18,pitch=2},ra={raise=50,out=24,twist=10,elbow=118,wrist=0},la={raise=40,out=10,elbow=50}})),
		K(1,t({root={y=-.36,z=-.28,yaw=8,pitch=8},torso={yaw=-18,pitch=6},head={yaw=-6},ra={raise=88,out=-4,twist=0,elbow=4,wrist=0},la={raise=20,out=30,elbow=40},lf={z=-.82},rf={z=.72}}),"out"),
		K(2,t({root={y=-.36,z=-.3,yaw=6,pitch=8},torso={yaw=-20,pitch=6},ra={raise=86,out=-6,elbow=8},la={raise=20,out=30,elbow=40},lf={z=-.82},rf={z=.72}})),
		K(3,T),
	}
	C.Light2={ -- a flat sweep from the right across her front, the whole body turning
		K(0,t({root={y=-.32,yaw=52},torso={yaw=30},ra={raise=80,out=76,twist=-6,elbow=16},la={raise=50,out=-10,elbow=70}})),
		K(1,t({root={y=-.36,yaw=-6,pitch=6},torso={yaw=-30,pitch=4},head={yaw=8},ra={raise=86,out=-34,twist=6,elbow=10},la={raise=26,out=30,elbow=40},lf={z=-.7,x=-.1}}),"out"),
		K(2,t({root={y=-.36,yaw=-12,pitch=6},torso={yaw=-38,pitch=4},ra={raise=84,out=-48,elbow=14},la={raise=26,out=30,elbow=40},lf={z=-.7,x=-.1}})),
		K(3,T),
	}
	C.Light3={ -- both hands: the fan raised overhead opens and comes down in a gust
		K(0,t({root={y=-.2,pitch=-8,yaw=12},torso={pitch=-14,yaw=6},head={pitch=-10},ra={raise=168,out=14,elbow=40},la={raise=160,out=-6,elbow=60}})),
		K(1,t({root={y=-.62,z=-.4,pitch=14,yaw=0},torso={pitch=18},head={pitch=4},ra={raise=74,out=-6,elbow=8},la={raise=70,out=-14,elbow=20},lf={z=-1.1},rf={z=.9}}),"out"),
		K(2,t({root={y=-.62,z=-.42,pitch=14},torso={pitch=20},ra={raise=68,out=-6,elbow=10},la={raise=64,out=-14,elbow=22},lf={z=-1.1},rf={z=.9}})),
		K(3,T),
	}
	C.Heavy={ -- the closed fan chopped down from overhead, one hand
		K(0,t({root={y=-.3,pitch=-6,yaw=24},torso={pitch=-10,yaw=14},ra={raise=172,out=22,elbow=46},la={raise=60,out=16,elbow=60}})),
		K(.75,t({root={y=-.36,pitch=-8,yaw=26},torso={pitch=-12,yaw=16},ra={raise=176,out=24,elbow=52},la={raise=62,out=16,elbow=60}})),
		K(1,t({root={y=-.8,z=-.5,pitch=22,yaw=4},torso={pitch=24,yaw=-8},head={pitch=8},ra={raise=46,out=-4,elbow=4},la={raise=10,out=40,elbow=30},lf={z=-1.2},rf={z=1.0}}),"out"),
		K(2,t({root={y=-.8,z=-.52,pitch=22,yaw=2},torso={pitch=24,yaw=-10},ra={raise=42,out=-4,elbow=6},la={raise=10,out=40,elbow=30},lf={z=-1.2},rf={z=1.0}})),
		K(3,T),
	}
	C.Updraft={ -- low, then the half-open fan scoops the body up into the rising air
		K(0,t({root={y=-1.0,pitch=20,yaw=20},torso={pitch=14,yaw=10},ra={raise=-20,out=24,twist=-10,elbow=20},la={raise=40,out=20,elbow=50},lf={z=-.6},rf={z=.6}})),
		K(1,t({root={y=.08,pitch=-14,yaw=-4},torso={pitch=-16,yaw=-6},head={pitch=-22},ra={raise=168,out=8,elbow=10},la={raise=-10,out=36,elbow=24},rf={toe=-20},lf={z=-.3}}),"out"),
		K(2,t({root={y=.06,pitch=-16},torso={pitch=-18},head={pitch=-22},ra={raise=172,out=8,elbow=14},la={raise=-10,out=36,elbow=24},rf={toe=-18},lf={z=-.3}})),
		K(3,T),
	}
	C.FanSlam={ -- both hands: the closed fan brought down like a beam
		K(0,t({root={y=-.16,pitch=-10},torso={pitch=-18},head={pitch=-12},ra={raise=170,out=6,elbow=40},la={raise=166,out=-4,elbow=50}})),
		K(1,t({root={y=-.95,z=-.3,pitch=28},torso={pitch=26},head={pitch=10},ra={raise=34,out=-8,elbow=8},la={raise=30,out=-12,elbow=14},lf={z=-1.0},rf={z=.9}}),"out"),
		K(2,t({root={y=-.95,z=-.32,pitch=28},torso={pitch=26},ra={raise=32,out=-8,elbow=10},la={raise=28,out=-12,elbow=16},lf={z=-1.0},rf={z=.9}})),
		K(3,T),
	}
	local Y=T.root.yaw
	-- A full turn on the lead foot, the open fan held out at arm's length (each
	-- key under half a turn from the next, so the body turns the right way).
	local turn={
		K(0,t({root={y=-.4,yaw=Y-30},torso={yaw=-20},ra={raise=84,out=70,elbow=14},la={raise=60,out=40,elbow=30}})),
		K(1,t({root={y=-.48,yaw=Y+90,roll=-6},torso={yaw=10},head={yaw=-60},ra={raise=88,out=86,elbow=8},la={raise=70,out=60,elbow=20},lf={x=.3,yaw=90}}),"out"),
		K(2,t({root={y=-.48,yaw=Y+200,roll=-6},torso={yaw=10},head={yaw=-60},ra={raise=88,out=86,elbow=8},la={raise=70,out=60,elbow=20},lf={x=.3,yaw=200}})),
		K(2.5,t({root={y=-.36,yaw=Y+290},ra={raise=70,out=50,elbow=30},lf={x=.2,yaw=290}})),
		K(3,merge(T,{root={yaw=Y+360}})),
	}
	C.FanPirouette=turn
	C.FanBackhand={ -- the backhand: from across her body out to the right
		K(0,t({root={y=-.32,yaw=-10},torso={yaw=-34},ra={raise=80,out=-54,twist=40,elbow=74},la={raise=40,out=24,elbow=50}})),
		K(1,t({root={y=-.38,z=-.3,yaw=48,pitch=6},torso={yaw=30},head={yaw=-10},ra={raise=86,out=66,twist=-10,elbow=10},la={raise=30,out=-10,elbow=80},lf={z=-.8},rf={z=.8,yaw=40}}),"out"),
		K(2,t({root={y=-.38,z=-.32,yaw=54,pitch=6},torso={yaw=34},ra={raise=84,out=70,elbow=12},la={raise=30,out=-10,elbow=80},lf={z=-.8},rf={z=.8,yaw=40}})),
		K(3,T),
	}
	C.DashAttack={ -- a running thrust, the fan leading
		K(0,t({root={y=-.7,z=.2,pitch=26,yaw=20},torso={pitch=6},ra={raise=40,out=24,twist=10,elbow=110},la={raise=70,out=-6,elbow=30},lf={z=-1.1},rf={z=1.2}})),
		K(1,t({root={y=-.66,z=-.95,pitch=26,yaw=-6},torso={yaw=-12},head={pitch=-14},ra={raise=94,out=-4,elbow=0},la={raise=-26,out=24,elbow=30},lf={z=-1.6},rf={z=1.45,y=.2,toe=-20}}),"out"),
		K(2,t({root={y=-.64,z=-.98,pitch=24,yaw=-8},torso={yaw=-14},ra={raise=92,out=-4,elbow=4},la={raise=-24,out=24,elbow=30},lf={z=-1.6},rf={z=1.45,y=.2,toe=-20}})),
		K(3,T),
	}
	C.Riposte=C.Light1
	C.FlyingKick={ -- out of a full run: a leaping thrust
		K(0,t({root={y=-.5,pitch=18},ra={raise=40,out=20,elbow=110},la={raise=60,out=20,elbow=40},lf={z=-.9},rf={z=1.0}})),
		K(1,t({root={y=-.1,z=-.8,pitch=10},torso={pitch=8},ra={raise=96,out=-4,elbow=2},la={raise=-20,out=30,elbow=20},rl={lift=40,knee=80},lf={z=-1.2,toe=-20}}),"out"),
		K(2,t({root={y=-.12,z=-.82,pitch=10},torso={pitch=8},ra={raise=94,out=-4,elbow=4},la={raise=-20,out=30,elbow=20},rl={lift=36,knee=76},lf={z=-1.2,toe=-18}})),
		K(3,T),
	}
	C.SlideSweep={ -- out of a full run: dropped low, the closed fan reaps the ankles
		K(0,t({root={y=-.9,pitch=20,yaw=30},torso={yaw=20},ra={raise=30,out=70,elbow=20},la={raise=30,out=20,elbow=40},lf={z=-1.0},rf={z=1.1}})),
		K(1,t({root={y=-1.15,pitch=24,yaw=-20},torso={yaw=-30,pitch=10},ra={raise=24,out=-40,elbow=10},la={raise=-10,out=40,elbow=20},lf={z=-1.3},rf={z=1.3}}),"out"),
		K(2,t({root={y=-1.15,pitch=24,yaw=-24},torso={yaw=-34,pitch=10},ra={raise=22,out=-48,elbow=12},la={raise=-10,out=40,elbow=20},lf={z=-1.3},rf={z=1.3}})),
		K(3,T),
	}
	C.WallDive={ -- off the wall: the fan first, the body behind it
		K(0,air({root={pitch=-10},ra={raise=150,out=20,elbow=60},la={raise=100,out=30,elbow=40},rl={lift=80,knee=110},ll={lift=70,knee=100}})),
		K(1,air({root={pitch=36},torso={pitch=20},ra={raise=100,out=-4,elbow=2},la={raise=20,out=40,elbow=30},rl={lift=10,knee=30},ll={lift=30,knee=50}}),"out"),
		K(2,air({root={pitch=38},torso={pitch=22},ra={raise=98,out=-4,elbow=4},la={raise=20,out=40,elbow=30},rl={lift=10,knee=30},ll={lift=30,knee=50}})),
		K(3,T),
	}
	C.Air1={ -- in the air: a sweep from the right
		K(0,air({torso={yaw=-24},ra={raise=100,out=70,elbow=30}})),
		K(1,air({torso={yaw=26,pitch=12},ra={raise=80,out=-30,elbow=10},la={raise=20,out=40,elbow=40}}),"out"),
		K(2,air({torso={yaw=30,pitch=12},ra={raise=78,out=-40,elbow=12},la={raise=20,out=40,elbow=40}})),
		K(3,AIR),
	}
	C.Air2={ -- in the air: the backhand
		K(0,air({torso={yaw=26},ra={raise=80,out=-40,twist=30,elbow=70}})),
		K(1,air({torso={yaw=-28,pitch=10},ra={raise=86,out=64,elbow=10},rl={lift=70,knee=60}}),"out"),
		K(2,air({torso={yaw=-32,pitch=10},ra={raise=84,out=70,elbow=12},rl={lift=66,knee=62}})),
		K(3,AIR),
	}
	C.AirDrive={ -- in the air: the fan driven straight through the body
		K(0,air({root={pitch=-6},ra={raise=50,out=20,elbow=110},la={raise=60,out=10,elbow=60}})),
		K(1,air({root={pitch=14},torso={pitch=12},ra={raise=92,out=-4,elbow=2},la={raise=10,out=40,elbow=30},rl={lift=20,knee=40},ll={lift=70,knee=90}}),"out"),
		K(2,air({root={pitch=14},torso={pitch=12},ra={raise=90,out=-4,elbow=4},la={raise=10,out=40,elbow=30},rl={lift=20,knee=40},ll={lift=70,knee=90}})),
		K(3,AIR),
	}
	C.FanDive={ -- in the air: the open fan beats down, the body under it is driven into the floor
		K(0,air({root={pitch=-14},torso={pitch=-18},ra={raise=172,out=8,elbow=40},la={raise=168,out=-4,elbow=44},rl={lift=70,knee=100},ll={lift=60,knee=96}})),
		K(1,air({root={pitch=34},torso={pitch=30},head={pitch=10},ra={raise=30,out=-6,elbow=8},la={raise=26,out=-10,elbow=12},rl={lift=10,knee=40},ll={lift=20,knee=60}}),"out"),
		K(2,air({root={pitch=36},torso={pitch=30},ra={raise=28,out=-6,elbow=10},la={raise=24,out=-10,elbow=14},rl={lift=10,knee=40},ll={lift=20,knee=60}})),
		K(3,AIR),
	}
	C.Slam={ -- the air heavy: an overhead chop that carries her down
		K(0,air({root={pitch=-10},torso={pitch=-16},ra={raise=176,out=10,elbow=42},la={raise=80,out=30,elbow=50},rl={lift=64,knee=110},ll={lift=58,knee=100}})),
		K(1,air({root={pitch=28},torso={pitch=40},head={pitch=12},ra={raise=40,out=-6,elbow=6},la={raise=40,out=30,elbow=30},rl={lift=-10,knee=40},ll={lift=14,knee=60}}),"out"),
		K(2,air({root={pitch=30},torso={pitch=42},ra={raise=36,out=-6,elbow=8},la={raise=40,out=30,elbow=30},rl={lift=-10,knee=40},ll={lift=14,knee=60}})),
		K(3,t({root={y=-.9,pitch=22},torso={pitch=18}})),
	}
	E.CLIPS.Gale=C
	setmetatable(C,{__index=E.CLIPS.Mirage})
	-- The tool: the fan flicked open from the right and swept across her front.
	E.THROWS.Gust=function(time,release)
		local wind={torso={yaw=34,pitch=-2},head={yaw=-16},ra={raise=86,out=74,twist=-10,elbow=30,wrist=0},la={raise=40,out=10,elbow=60}}
		local snap={torso={yaw=-26,pitch=6},head={yaw=6},ra={raise=88,out=-30,twist=10,elbow=8,wrist=0},la={raise=30,out=30,elbow=50}}
		if time&lt;release then return wind,smooth(time/math.max(release*.7,.02)) end
		if time&lt;release+.28 then return snap,1 end
		return snap,1-smooth((time-release-.28)/.17)
	end
	-- Casts: the fan drawn and opened (one moon, two, all three), then swung.
	local channel={Kamaitachi=.3,GreatGust=.5,Cyclone=.24}
	E.CAST.Kamaitachi=function(actor,base,time,state)
		if state=="TechniqueChannel" then
			local u=smooth(time/channel.Kamaitachi)
			return merge(base,{root={y=-.4,yaw=30+16*u},torso={yaw=30+10*u,pitch=-4},head={yaw=-30},ra={raise=120+30*u,out=50+10*u,twist=-20,elbow=70-10*u},la={raise=60,out=-10,elbow=60},lf={z=-.7},rf={z=.8}})
		end
		return merge(base,{root={y=-.46,yaw=-10,pitch=8},torso={yaw=-34,pitch=6},head={yaw=4},ra={raise=88,out=-50,elbow=8},la={raise=30,out=30,elbow=40},lf={z=-.9},rf={z=.8}})
	end
	E.CAST.GreatGust=function(actor,base,time,state)
		if state=="TechniqueChannel" then
			local u=smooth(time/channel.GreatGust)
			return merge(base,{root={y=-.5-.2*u,yaw=40+14*u},torso={yaw=36+8*u,pitch=-6},head={yaw=-36},ra={raise=140+20*u,out=40,elbow=40},la={raise=130+20*u,out=10,elbow=70},lf={z=-1.1,x=-.2},rf={z=1.0,x=.3,yaw=50}})
		end
		return merge(base,{root={y=-.72,z=-.3,yaw=-20,pitch=14},torso={yaw=-40,pitch=14},head={yaw=8},ra={raise=90,out=-40,elbow=8},la={raise=84,out=-20,elbow=16},lf={z=-1.2},rf={z=1.0}})
	end
	E.CAST.Cyclone=function(actor,base,time,state)
		if state=="TechniqueChannel" then
			-- The open fan held up in front, turned in the wrist: the air starts to spin.
			return merge(base,{root={y=-.5,yaw=10},torso={yaw=-6,pitch=4},head={pitch=-6},ra={raise=110,out=10,elbow=30,wroll=(time*900)%360},la={raise=50,out=20,elbow=60},lf={z=-.8},rf={z=.7}})
		end
		return merge(base,{root={y=-.3,pitch=-4},torso={pitch=-8},head={pitch=-10},ra={raise=150,out=10,elbow=10},la={raise=40,out=30,elbow=50}})
	end
	-- The intro: the fan planted open beside her (GaleFX), her right hand on its
	-- edge, the left on her hip, chin up.
	E.INTRO.Gale=function(base)
		return merge(base,{root={y=-.1,pitch=-3,yaw=10},torso={pitch=-5,yaw=-4},head={pitch=-12,yaw=-10},
			ra={raise=72,out=60,twist=0,elbow=26,wrist=20},la={raise=-8,out=38,twist=-50,elbow=104,wrist=10},rf={x=.14,z=.3},lf={x=-.1,z=-.3}})
	end
end
return GaleMotion
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND211">
          <Properties>
            <string name="Name">GroundFX</string>
            <ProtectedString name="Source">-- The ground answering the fight, on the client (06/11, user: « applique-toi
-- plus sur les dégâts au sol… beaucoup d'attaques restent dans le ciel et pas
-- sur le sol… c'est pas encore des vrais blocs de pierre qui se cassent »).
--
-- Two things, presentation only:
--   * the floor breaks for real: when the server leaves a crater, a crack, a
--     trench, a gouge or a skid in the arena (Server/WorldReaction, the parts
--     named "Scar &lt;kind&gt;" in a WorldMemory folder), blocks of that ground are
--     torn out of it: they fly up and out, tumble, bounce once, settle round
--     the scar and crumble away; dust bursts out of the hole; stone cracks.
--   * the big blows reach the ground: a heavy contact, a launcher, a slam, a
--     wall or ground bounce, a Rasengan or a Chidori landing on a body push a
--     ring of dust along the floor under it and kick up grit, whatever the
--     height of the contact (they used to happen in the air only).
-- Installed into Effects as one layer (it never claims a contact: Effects
-- still draws its own).
local Debris=game:GetService("Debris")
local RunService=game:GetService("RunService")
local GroundFX={}
local K -- Effects' helpers, handed over by install()

-- Blocks thrown per scar kind: {count, size, speed}.
GroundFX.BREAK={crater={10,.9,26},gouge={7,.7,20},trench={8,.7,18},crack={6,.6,15},skid={1,.35,7}}
-- Contact styles whose blow reaches the ground (a dust ring under them).
GroundFX.HEAVY={heavy=.8,launcher=.9,slam=1.2,finisher=1,groundbounce=1.2,wall=.6,wallbounce=.8,worldbreak=1.3,
	chidori=1,rasengan=1.1,fire=1,palmburst=.8,clash=.7,awaken=1.1}
local MAX_LIVE=60 -- blocks in flight at once (the oldest settle early)

local live={}
local function floorBelow(position,depth,exclude)
	local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances=exclude or {}
	return workspace:Raycast(position+Vector3.new(0,1,0),Vector3.new(0,-(depth or 12),0),params)
end
-- What the torn ground is made of: the scar's own chunks say it (relief), else
-- the floor under it.
local function groundOf(scar)
	for _,c in scar:GetChildren() do
		if c:IsA("BasePart") and c.Name=="Scar chunk" and c.Material~=Enum.Material.SmoothPlastic then return c.Material,c.Color end
	end
	local hit=floorBelow(scar.Position,6,{scar})
	if hit and hit.Instance:IsA("BasePart") then
		-- the arena's flat earth breaks into blocks of stony earth (as WorldReaction's slabs)
		local m=hit.Instance.Material
		if m==Enum.Material.SmoothPlastic or m==Enum.Material.Plastic then m=Enum.Material.Sandstone end
		return m,hit.Instance.Color
	end
	return Enum.Material.Ground,Color3.fromRGB(150,120,86)
end
local step
local function ensureStep()
	if step then return end
	step=RunService.RenderStepped:Connect(function(dt)
		dt=math.min(dt,1/20)
		local any=false
		for block,b in live do
			any=true
			if not block.Parent then live[block]=nil;continue end
			b.age+=dt
			if not b.rest then
				b.vel+=Vector3.new(0,-95*dt,0)
				local pos=block.Position+b.vel*dt
				if pos.Y-b.half&lt;=b.floor then
					pos=Vector3.new(pos.X,b.floor+b.half,pos.Z)
					if b.bounced or math.abs(b.vel.Y)&lt;8 then
						b.rest=true
					else
						b.bounced=true
						b.vel=Vector3.new(b.vel.X*.45,-b.vel.Y*.32,b.vel.Z*.45)
						b.spin*=.5
					end
				end
				b.rot=b.rot*CFrame.Angles(b.spin.X*dt,b.spin.Y*dt,b.spin.Z*dt)
				block.CFrame=CFrame.new(pos)*b.rot
			end
			if b.age&gt;=b.life then
				live[block]=nil
				K.tween(block,.5,{Transparency=1,Size=block.Size*.6})
				Debris:AddItem(block,.55)
			end
		end
		if not any then step:Disconnect();step=nil end
	end)
end
local function count() local n=0;for _ in live do n+=1 end;return n end
-- Blocks of ground torn out at `at` (the floor point), thrown up and out.
function GroundFX.tear(fx,at,kind,material,color,along)
	local spec=GroundFX.BREAK[kind] or GroundFX.BREAK.crack
	local n,size,speed=spec[1],spec[2],spec[3]
	if count()+n&gt;MAX_LIVE then
		-- the oldest blocks settle now
		for block,b in live do if b.age&gt;.3 then b.age=b.life end end
	end
	local floorY=at.Y
	for k=1,n do
		local a=(k/n)*math.pi*2+math.random()*.6
		local out=Vector3.new(math.cos(a),0,math.sin(a))
		if along then
			-- a crack or a skid throws its blocks to both sides of its line
			local side=along:Cross(Vector3.yAxis)
			out=(side*(if k%2==0 then 1 else -1)+along*(math.random()-.5)*.6).Unit
		end
		local s=size*(.6+math.random()*.8)
		local block=K.block(fx.folder,Vector3.new(s*1.3,s*.7,s),CFrame.new(at+out*s*.8+Vector3.new(0,s*.3,0))*CFrame.Angles(math.random()*6,math.random()*6,math.random()*6),
			color:Lerp(Color3.new(0,0,0),math.random()*.18),material)
		block.Name="GroundBlock";block.CastShadow=true
		live[block]={vel=out*speed*(.45+math.random()*.6)+Vector3.new(0,speed*(.7+math.random()*.6),0),
			spin=Vector3.new(math.random()-.5,math.random()-.5,math.random()-.5)*14,rot=block.CFrame.Rotation,
			floor=floorY,half=s*.35,age=0,life=2.6+math.random()*1.4}
	end
	ensureStep()
	-- the dust of the broken ground
	K.burst(fx.folder,at+Vector3.new(0,.6,0),{Texture=K.TEX.smoke,Lifetime=NumberRange.new(.5,1),Speed=NumberRange.new(6,14),SpreadAngle=Vector2.new(70,70),
		EmissionDirection=Enum.NormalId.Top,Color=ColorSequence.new(color:Lerp(Color3.fromRGB(230,220,200),.35)),LightInfluence=1,
		Size=K.num({{0,1.4},{1,3.6}}),Transparency=K.num({{0,.25},{1,1}}),Drag=4,Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-40,40)},math.floor(n*1.6))
	local anchor=K.anchorPart(fx.folder,at)
	K.sound(anchor,K.SOUND.rock,.4+n*.03,.75+math.random()*.25)
	K.sound(anchor,K.SOUND.debris,.4+n*.03,.85+math.random()*.2,1.1)
	if kind=="crater" or kind=="gouge" then K.sound(anchor,K.SOUND.heavy,.45,.6) end
end
-- A blow that reaches the ground: a ring of dust along the floor, grit.
function GroundFX.reach(fx,position,strength)
	local hit=floorBelow(position,9,{fx.folder,fx.fighters})
	if not hit or hit.Normal.Y&lt;.6 then return end
	local at=hit.Position
	local color=if hit.Instance:IsA("BasePart") then hit.Instance.Color else Color3.fromRGB(196,168,120)
	local dust=color:Lerp(Color3.fromRGB(236,226,206),.45)
	K.shockRing(fx.folder,at+Vector3.new(0,.15,0),dust,2,10+strength*8,.35+strength*.1)
	K.burst(fx.folder,at+Vector3.new(0,.3,0),{Texture=K.TEX.smoke,Lifetime=NumberRange.new(.35,.7),Speed=NumberRange.new(8,16*strength),SpreadAngle=Vector2.new(85,10),
		EmissionDirection=Enum.NormalId.Top,Color=ColorSequence.new(dust),LightInfluence=1,Size=K.num({{0,1},{1,2.6}}),
		Transparency=K.num({{0,.35},{1,1}}),Drag=5,Rotation=NumberRange.new(0,360)},math.floor(8+strength*8))
	K.burst(fx.folder,at+Vector3.new(0,.2,0),{Texture=K.TEX.spark,Lifetime=NumberRange.new(.4,.8),Speed=NumberRange.new(6,12),SpreadAngle=Vector2.new(60,60),
		EmissionDirection=Enum.NormalId.Top,Acceleration=Vector3.new(0,-40,0),Color=ColorSequence.new(color:Lerp(Color3.new(0,0,0),.3)),
		LightEmission=0,LightInfluence=1,Size=K.num({{0,.22},{1,.16}}),Drag=1},math.floor(6+strength*6))
end
local function impact(fx,data,folder)
	local strength=GroundFX.HEAVY[data.style or ""]
	if strength and data.position then
		local ok=pcall(GroundFX.reach,fx,data.position,strength*(if data.heavy then 1.2 else 1))
		if not ok and GroundFX.strict then error("GroundFX.reach") end
	end
	return false
end
-- Watch the server's scars appear.
local watched=setmetatable({},{__mode="k"})
local function watch(fx,memory)
	if watched[memory] then return end
	watched[memory]=true
	memory.ChildAdded:Connect(function(scar)
		if not scar:IsA("BasePart") then return end
		local kind=scar:GetAttribute("WorldScar") or string.match(scar.Name,"^Scar (%a+)")
		if not kind or not GroundFX.BREAK[kind] then return end
		task.defer(function()
			if not scar.Parent then return end
			local material,color=groundOf(scar)
			-- the scar's frame: X is the surface normal, Z runs along a line mark
			local along=if kind=="crater" or kind=="gouge" then nil else scar.CFrame.LookVector*Vector3.new(1,0,1)
			if along and along.Magnitude&lt;.1 then along=nil end
			pcall(GroundFX.tear,fx,scar.Position,kind,material,color,along and along.Unit)
		end)
	end)
end
function GroundFX.install(FX,kit)
	K=kit
	table.insert(FX.layers,{name="Ground",impact=impact})
	local function scan(d)
		if d:IsA("Folder") and d.Name=="WorldMemory" then
			-- the effects layer needs an Effects instance: the first one made
			task.spawn(function()
				local fx
				for _=1,600 do fx=FX.current;if fx then break end;task.wait(.1) end
				if fx then watch(fx,d) end
			end)
		end
	end
	-- (Headless specs hand the effects a stub workspace with no tree to watch.)
	if type(workspace.GetDescendants)~="function" or not workspace.DescendantAdded then return end
	for _,d in workspace:GetDescendants() do scan(d) end
	workspace.DescendantAdded:Connect(scan)
end
return GroundFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND212">
          <Properties>
            <string name="Name">HoundFX</string>
            <ProtectedString name="Source">-- (06/11, « les chiens ninja qui sortent du sol ») Kakashi's ninken on screen
-- (Server/Hounds). The dogs: a small rig built here (a body, a chest, a head
-- with its snout and ears, the Konoha headband, four legs on joints, a tail),
-- four of them, Pakkun the small tan one first; posed by Client/BodyViews
-- every frame: under the floor while they dig (only a dust trail runs along
-- the ground), out with a jump, running (legs and bob), biting (braced, the
-- head shaking at his legs). The contacts: diving in at Kakashi's feet, the
-- burst out of the floor, the bite, the puff when one is sent away. One
-- identity layer installed into Effects. Presentation only.
local HoundFX={}
local K -- Effects' helpers, handed over by install()
HoundFX.clock=os.clock -- (headless tests drive time)
local SMOKE=Color3.fromRGB(236,236,240)
local DUST=Color3.fromRGB(196,176,140)
local BAND=Color3.fromRGB(40,52,96)
local PLATE=Color3.fromRGB(190,196,206)
local DARK=Color3.fromRGB(26,22,24)
-- {coat, pale, scale}: Pakkun, then the pack.
HoundFX.COATS={
	-- (Studio 06/11: at knee height they vanished under his legs.)
	{Color3.fromRGB(204,168,118),Color3.fromRGB(236,214,180),.85},
	{Color3.fromRGB(104,104,116),Color3.fromRGB(196,196,204),1.35},
	{Color3.fromRGB(122,90,62),Color3.fromRGB(206,184,150),1.45},
	{Color3.fromRGB(58,56,62),Color3.fromRGB(214,210,206),1.6},
}
local function part(model,name,size,color,shape)
	local p=Instance.new("Part")
	p.Name=name;p.Size=size;p.Color=color;p.Material=Enum.Material.SmoothPlastic
	p.CanCollide=false;p.CanQuery=false;p.CanTouch=false;p.Massless=true;p.CastShadow=true
	p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth
	if shape then p.Shape=shape end
	p.Parent=model
	return p
end
local function weld(root,p,offset)
	p.CFrame=root.CFrame*offset
	local w=Instance.new("WeldConstraint");w.Part0=root;w.Part1=p;w.Parent=p
end
-- One dog (index picks the coat). Its pivot is its root, at mid-body height
-- `model:GetAttribute("Lift")` above the floor.
function HoundFX.build(index)
	local coat=HoundFX.COATS[(index-1)%#HoundFX.COATS+1]
	local color,pale,s=coat[1],coat[2],coat[3]
	local m=Instance.new("Model");m.Name="Ninken"
	local root=part(m,"HoundRoot",Vector3.one*.2,color);root.Transparency=1;root.Anchored=true
	m.PrimaryPart=root
	local function v(x,y,z) return Vector3.new(x,y,z)*s end
	local function at(x,y,z) return CFrame.new(x*s,y*s,z*s) end
	weld(root,part(m,"Body",v(1,.85,1.6),color,Enum.PartType.Ball),at(0,0,.1))
	weld(root,part(m,"Belly",v(.78,.5,1.2),pale,Enum.PartType.Ball),at(0,-.18,.1))
	weld(root,part(m,"Chest",v(.92,.9,.85),color,Enum.PartType.Ball),at(0,.12,-.5))
	weld(root,part(m,"Head",v(.74,.68,.76),color,Enum.PartType.Ball),at(0,.5,-.95))
	weld(root,part(m,"Snout",v(.4,.32,.46),pale,Enum.PartType.Ball),at(0,.38,-1.32))
	weld(root,part(m,"Nose",v(.16,.13,.13),DARK,Enum.PartType.Ball),at(0,.46,-1.55))
	for _,side in {-1,1} do
		weld(root,part(m,"Eye",v(.1,.1,.08),DARK,Enum.PartType.Ball),at(side*.18,.62,-1.27))
		local ear=Instance.new("WedgePart");ear.Name="Ear";ear.Size=v(.12,.32,.2);ear.Color=color;ear.Material=Enum.Material.SmoothPlastic
		ear.CanCollide=false;ear.CanQuery=false;ear.CanTouch=false;ear.Massless=true;ear.Parent=m
		weld(root,ear,at(side*.22,.9,-.9))
	end
	-- The Konoha headband round the forehead (Studio 06/11: on top it read as a hat).
	-- (and at eye level it read as a blindfold: above the eyes, round the head)
	weld(root,part(m,"Headband",v(.7,.11,.68),BAND),at(0,.7,-.95))
	weld(root,part(m,"Plate",v(.3,.1,.05),PLATE),at(0,.7,-1.3))
	local tail=part(m,"Tail",v(.13,.13,.6),color)
	weld(root,tail,at(0,.35,.95)*CFrame.Angles(math.rad(35),0,0))
	-- Legs on joints (Motor6D) so the stride can swing them.
	local legs={}
	for _,side in {-1,1} do
		for _,z in {-.5,.55} do
			local leg=part(m,"Leg",v(.2,.7,.2),color)
			local j=Instance.new("Motor6D");j.Name="Hip";j.Part0=root;j.Part1=leg
			j.C0=at(side*.3,-.15,z);j.C1=CFrame.new(0,.33*s,0)
			j.Parent=root
			table.insert(legs,{joint=j,phase=(if z&lt;0 then 0 else math.pi)+(if side&lt;0 then 0 else math.pi)})
		end
	end
	-- The dust it raises under the floor (a separate anchor at floor level).
	local dust=part(m,"Dust",Vector3.one*.2,DUST);dust.Transparency=1;dust.Anchored=true
	local e=Instance.new("ParticleEmitter")
	e.Texture="rbxasset://textures/particles/smoke_main.dds";e.Rate=0;e.Lifetime=NumberRange.new(.45,.8)
	e.Speed=NumberRange.new(2,5);e.SpreadAngle=Vector2.new(40,40);e.EmissionDirection=Enum.NormalId.Top
	e.Color=ColorSequence.new(DUST);e.LightInfluence=1
	e.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,.6),NumberSequenceKeypoint.new(1,1.8)})
	e.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.3),NumberSequenceKeypoint.new(1,1)})
	e.Parent=dust
	m:SetAttribute("Lift",.8*s)
	return m,{legs=legs,dust=dust,emitter=e,scale=s,rise=-2.4}
end
-- Every frame (BodyViews): the dog where the server has it, posed by state.
function HoundFX.pose(view,entry,dt)
	local rig=view.rig
	local now=HoundFX.clock()
	local s=rig.scale
	local floor=view.pos.Y-3
	local buried=entry.buried==true
	-- Under the floor, out with a jump, then on its legs.
	local want=if buried then -2.4*s else 0
	rig.rise=if want&lt;rig.rise then want else rig.rise+(want-rig.rise)*math.min(1,dt*16)
	local speed=Vector3.new(entry.velocity and entry.velocity.X or 0,0,entry.velocity and entry.velocity.Z or 0).Magnitude
	local biting=entry.state=="Active"
	local bob=if biting then 0 else math.abs(math.sin(now*16))*.22*math.min(1,speed/8)
	local look=view.look or Vector3.new(0,0,-1)
	local at=Vector3.new(view.pos.X,floor+view.model:GetAttribute("Lift")+rig.rise+bob,view.pos.Z)
	local frame=CFrame.lookAt(at,at+look)
	if biting then
		-- Braced, the head down at his legs, a shake.
		frame*=CFrame.Angles(math.rad(-14),math.rad(math.sin(now*38)*7),0)
	elseif rig.rise&lt;-.05 then
		frame*=CFrame.Angles(math.rad(30),0,0) -- the jump out
	end
	view.model:PivotTo(frame)
	for _,leg in rig.legs do
		local swing=if biting then math.rad(18)*(if leg.phase&lt;1 then -1 else 1) else math.sin(now*16+leg.phase)*math.rad(40)*math.min(1,speed/8)
		leg.joint.Transform=CFrame.Angles(swing,0,0)
	end
	-- The dust trail along the floor while it digs.
	rig.dust.CFrame=CFrame.new(view.pos.X,floor+.15,view.pos.Z)
	rig.emitter.Rate=if buried and speed&gt;2 then 70 else 0
end

-- ------------------------------------------------------------------ contacts
local function puff(fx,at,count,size,color) K.smokePuff(fx.folder,at,color or SMOKE,count,size) end
local function body(fx,impact)
	if impact.kind~="hound" then return false end
	local at=impact.position
	local floor=at-Vector3.new(0,2.6,0)
	if impact.phase=="appear" then
		-- Diving into the floor at his feet.
		puff(fx,floor,6,1.2,DUST)
	elseif impact.phase=="hit" or impact.phase=="blade" or impact.phase=="area" then
		puff(fx,floor+Vector3.new(0,.8,0),16,2)
		K.sound(K.anchorPart(fx.folder,at),K.SOUND.hit,.3,1.7)
	else
		-- The summoning ends: each in its puff of smoke.
		puff(fx,floor+Vector3.new(0,.8,0),10,1.6)
	end
	return true
end
local function burst(fx,impact)
	local floor=impact.position-Vector3.new(0,2.8,0)
	puff(fx,floor,10,1.6,DUST)
	K.burst(fx.folder,floor,{Texture=K.TEX.smoke,Lifetime=NumberRange.new(.3,.6),Speed=NumberRange.new(8,14),SpreadAngle=Vector2.new(35,35),
		EmissionDirection=Enum.NormalId.Top,Color=ColorSequence.new(DUST),LightInfluence=1,Size=K.num({{0,.5},{1,1.1}}),Acceleration=Vector3.new(0,-30,0)},8)
	if (impact.body or 0)%2==0 then K.sound(K.anchorPart(fx.folder,floor),K.SOUND.debris,.35,1.4,.4) end
	return true
end
local function bite(fx,impact)
	local at=impact.position-Vector3.new(0,1.6,0)
	K.flash(fx.folder,at,SMOKE,.3,2.2,.12,.4)
	K.sound(K.anchorPart(fx.folder,at),K.SOUND.punch,.45,1.25)
	return true
end
local function impact(fx,data)
	if data.style=="body" then return body(fx,data) end
	if data.style=="houndburst" then return burst(fx,data) end
	if data.style=="houndbite" then return bite(fx,data) end
	return false
end
function HoundFX.install(Effects,kit)
	K=kit
	-- Before Naruto's layer: his answers "body" contacts of his clones only.
	table.insert(Effects.layers,1,{name="Hounds",impact=impact})
end
return HoundFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND213">
          <Properties>
            <string name="Name">IdentityFX</string>
            <ProtectedString name="Source">-- CORE4 identity on the client (mission NEXT_VALIDATION_ROSTER_SCALE §5): what
-- each of the four prodigies does differently must be seen, not read in numbers.
-- Every cue answers a server fact (the contact feed and the snapshot).
--   Neji    the palm lands on the very chakra point it closes (an open palm
--           printed there, not a fist burst at the body's centre); a blocked
--           palm still shows the chakra it drained; the closed points keep a
--           marker readable at any distance; 64 Palms counts 2-4-8-16-32-64 over
--           the victim for both players and the last palm throws the body; the
--           palms stay lit while the Rotation counter is open; a body a Vacuum
--           Palm drives into a wall leaves the air's palm print on the stone.
--   Minato  a planted kunai, a floor formula and a body mark look apart; the
--           arrival window rings under him; an arrival strike that carries the
--           combo through the jump links in gold; the Rasengan grinds where it
--           lands; Yellow Flash draws its thread back to the return seal.
--   Itachi  the Read stance turns its tomoe at his feet; a read draws the line
--           from his eyes to the swing and the counter window closes under him;
--           a caught image lights the real body; ricochet and Geometry paths
--           flash; his fire lane is one scorched strip across the field.
--   Sasuke  the curse spreads from the neck as it takes him (across the face
--           when it starves); the Dancing Leaf's shadow and the vault's arc; the
--           Phoenix Flower's hidden steel glints out of the flames; a Chidori
--           bursts along its line, or fizzles when it finds nothing.
-- One identity layer installed into Effects (like SandFX and LeeFX): Effects
-- only offers the registry and its helpers. Presentation only: nothing here can
-- change gameplay.
local Debris=game:GetService("Debris")

local IdentityFX={}
local K -- Effects' helpers, handed over by install()
local Kit=require(script.Parent.VfxKit)
IdentityFX.clock=os.clock -- (headless tests drive time)

local HYUGA=Color3.fromRGB(190,208,255)
local HYUGA_CORE=Color3.fromRGB(240,246,255)
local HYUGA_DEEP=Color3.fromRGB(110,140,230)

local function find(folder,id) return folder and id and folder:FindFirstChild(id) end
local function rootOf(model) return model and model:FindFirstChild("HumanoidRootPart") end
local function flatUnit(v,fallback)
	local f=Vector3.new(v.X,0,v.Z)
	return if f.Magnitude&gt;.05 then f.Unit else (fallback or Vector3.zAxis)
end
local function stateOf(fx,model)
	fx.identityState=fx.identityState or setmetatable({},{__mode="k"})
	local st=fx.identityState[model]
	if not st then st={};fx.identityState[model]=st end
	return st
end
local function fade(part,time,grow)
	K.tween(part,time,{Transparency=1,Size=part.Size*(grow or 1)})
end
-- A straight line of light from one point to another that fades at once: a
-- path shown for a beat (a prediction, a ricochet, the body behind an image).
local function streak(fx,from,to,color,width,life,name)
	local delta=to-from
	if delta.Magnitude&lt;.3 then return nil end
	local line=K.block(fx.folder,Vector3.new(width,width,delta.Magnitude),CFrame.lookAt(from:Lerp(to,.5),to),color,Enum.Material.Neon)
	line.Name=name or "Streak";line.Transparency=.15
	K.tween(line,life,{Transparency=1,Size=Vector3.new(width*.2,width*.2,delta.Magnitude)})
	Debris:AddItem(line,life+.05)
	return line
end

-- ------------------------------------------------------------------- Neji
-- An open palm laid on a point, facing `normal` (out of the body, toward the
-- striker): the heel of the hand, four fingers and the thumb. It flares, then
-- sinks into the body: the strike reaches the network, it does not shatter.
local FINGERS={{-.21,.34},{-.07,.42},{.07,.44},{.21,.36}}
local function palmPrint(fx,at,normal,scale,transparency,life)
	local base=CFrame.lookAt(at,at+normal)
	local model=K.new("Model",{Name="PalmPrint"},fx.folder)
	local function piece(size,offset)
		local p=K.block(model,size*scale,base*offset,HYUGA_CORE,Enum.Material.Neon)
		p.Transparency=transparency
		fade(p,life,1.3)
	end
	piece(Vector3.new(.62,.56,.03),CFrame.new(0,-.06*scale,0))
	for _,f in FINGERS do piece(Vector3.new(.11,f[2],.03),CFrame.new(f[1]*scale,(.22+f[2]/2)*scale,0)) end
	piece(Vector3.new(.12,.32,.03),CFrame.new(-.4*scale,-.02*scale,0)*CFrame.Angles(0,0,math.rad(42)))
	Debris:AddItem(model,life+.05)
	return model,base
end
-- The point that took the palm: the chakra point it closed, else the chest
-- facing the striker. Returns the point and the outward normal.
local function struckPoint(fx,data,folder)
	local victim=find(folder,data.victim)
	local striker=rootOf(find(folder,data.owner))
	local at=nil
	if victim and data.point then at=fx.tenketsuWorld(victim,data.point) end
	local center=rootOf(victim)
	local from=if striker then striker.Position elseif data.direction then (data.position-data.direction*4) else nil
	local normal=if from then flatUnit(from-(at or data.position)) else Vector3.zAxis
	if not at then at=(if center then center.Position else data.position)+normal*.6+Vector3.new(0,.35,0) end
	return at,normal
end
-- The striking hand flares with the chakra it just released.
local function handFlare(fx,folder,owner,at,color)
	local model=find(folder,owner)
	local best,gap=nil,math.huge
	for _,name in {"RightHand","LeftHand"} do
		local hand=model and model:FindFirstChild(name)
		if hand then
			local d=(hand.Position-at).Magnitude
			if d&lt;gap then best,gap=hand,d end
		end
	end
	if best then K.flash(fx.folder,best.Position,color,.2,1.3,.14,.1) end
	return best
end
-- A palm on the network (the melee palms, the 64 Palms, the chakra palm).
local function palmCue(fx,data,folder)
	local at,normal=struckPoint(fx,data,folder)
	local heavy=data.heavy==true
	palmPrint(fx,at,normal,if heavy then 1.6 else 1,if heavy then 0 else .1,if heavy then .32 else .22)
	K.flash(fx.folder,at,HYUGA_CORE,.15,if heavy then 2.4 else 1.3,.12,0)
	-- Through the body: the chakra goes in, it does not bounce off.
	local line=K.block(fx.folder,Vector3.new(.07,.07,1.5),CFrame.lookAt(at,at+normal)*CFrame.new(0,0,.75),HYUGA,Enum.Material.Neon)
	line.Name="PalmThrough";line.Transparency=.2
	fade(line,.18)
	Debris:AddItem(line,.22)
	K.shockRing(fx.folder,at,HYUGA,.3,if heavy then 6 else 2.6,.2,normal)
	handFlare(fx,folder,data.owner,at,HYUGA)
	if heavy then
		-- The palm that throws the body: the air in front of it bursts the way it flies.
		local along=flatUnit(data.direction or -normal,-normal)
		K.shockRing(fx.folder,at+along*1.2,HYUGA_CORE,2,12,.3,along)
		K.sound(K.anchorPart(fx.folder,at),K.SOUND.heavy,.4,.7)
	end
	return at,normal
end
-- A palm stopped by a guard still drains: a faint print on the guard and the
-- chakra pulled out of the body into the striking hand.
local function drainCue(fx,data,folder)
	local victim=rootOf(find(folder,data.victim))
	local striker=find(folder,data.owner)
	if not victim then return end
	local normal=flatUnit((rootOf(striker) or victim).Position-victim.Position)
	local at=victim.Position+normal*1.1+Vector3.new(0,.3,0)
	palmPrint(fx,at,normal,1.15,.55,.2)
	local hand=handFlare(fx,folder,data.owner,at,HYUGA_DEEP)
	local target=if hand then hand.Position else at+normal*2
	local holder=K.new("Model",{Name="ChakraDrain"},fx.folder)
	for k=1,math.clamp(math.floor((data.drain or 3)+.5),2,6) do
		local start=victim.Position+Vector3.new((k%3-1)*.5,.2+(k%2)*.4,0)
		local wisp=K.block(holder,Vector3.one*.18,CFrame.new(start),HYUGA,Enum.Material.Neon)
		wisp.Shape=Enum.PartType.Ball;wisp.Transparency=.15
		K.tween(wisp,.28,{CFrame=CFrame.new(target),Transparency=1,Size=Vector3.one*.06})
	end
	Debris:AddItem(holder,.35)
end
-- 64 Palms: each call (2, 4, 8 ... 64) is a ring under Neji, wider at each
-- call, the last one white. (06/11) No number over the victim any more
-- (user: « des 1, 2, 3 pop sur le truc, c'est super moche »): the count reads
-- in the rings and, through the Byakugan, in the network going dark.
local function countCue(fx,data,folder)
	local victim=find(folder,data.victim)
	if not victim then return end
	local st=stateOf(fx,victim)
	local count=data.count or 0
	if count==(st.palmShown or 0) and not data.final then return end
	st.palmShown=if data.final then 0 else count
	local neji=rootOf(find(folder,data.owner))
	if neji then
		local floor=K.floorUnder(fx,neji.Position,2,10)
		local y=if floor then floor.Position.Y+.06 else neji.Position.Y-2.9
		local size=3+math.log(math.max(count,2),2)*1.6
		K.shockRing(fx.folder,Vector3.new(neji.Position.X,y,neji.Position.Z),if data.final then HYUGA_CORE else HYUGA,size*.6,size*2,.28)
	end
end
-- Wall hit: what drove the body into the stone. Neji's air pressure (a Vacuum
-- Palm, the twin palm, the throwing 64th) leaves a big palm print on the wall.
local PRESSURE={VacuumPalm=true,PalmThrust=true,SixtyFourPalms=true,Light3=true,AirDrive=true}
local function wallCue(fx,data)
	if data.by~="GentleFist" or not PRESSURE[data.cause or ""] then return end
	local normal=data.normal or Vector3.zAxis
	local at=data.position+normal*.1+Vector3.new(0,.6,0)
	palmPrint(fx,at,normal,4,.05,.45)
	for k=1,3 do K.shockRing(fx.folder,data.position+normal*.12,HYUGA,1+k,6+k*4,.25+k*.08,normal) end
	K.smokePuff(fx.folder,data.position+normal,Color3.fromRGB(226,232,246),14,2)
end
-- The twin palm out of Rotation releases the dome's chakra the palms held: a
-- ring the size of the dome closes onto the palm and bursts out of the body.
local function trigramRelease(fx,data,folder,at,normal)
	local neji=rootOf(find(folder,data.owner))
	if neji then K.shockRing(fx.folder,neji.Position-Vector3.new(0,.6,0),HYUGA,12,3,.2) end
	K.shockRing(fx.folder,at,HYUGA_CORE,1,9,.3,normal)
	local burst=K.new("Model",{Name="TrigramRelease"},fx.folder)
	for k=0,7 do
		local a=k/8*math.pi*2
		local ray=K.block(burst,Vector3.new(.08,.08,1.4),CFrame.lookAt(at,at-normal)*CFrame.Angles(0,0,a)*CFrame.Angles(math.rad(70),0,0)*CFrame.new(0,0,-.9),HYUGA,Enum.Material.Neon)
		ray.Transparency=.15
		fade(ray,.22,1.5)
	end
	Debris:AddItem(burst,.3)
end
local function nejiImpact(fx,data,folder)
	local style=data.style
	if style=="palm" then
		local at,normal=palmCue(fx,data,folder)
		if data.variant=="TrigramCounter" then trigramRelease(fx,data,folder,at,normal) end
		if data.count then countCue(fx,data,folder) end
		-- A chakra palm (ChakraCombat) keeps its own layer on top.
		return data.chakra==nil
	end
	if style=="block" and data.drain and data.fighter=="GentleFist" then drainCue(fx,data,folder);return false end
	if style=="wall" then wallCue(fx,data);return false end
	return false
end
-- (06/11) The closed points no longer get a flat disc drawn over everything
-- (user: « c'est super moche »): Effects lights them on the body itself, and
-- the Byakugan (Client/ByakuganFX) shows them as dark nodes of the network.
-- Rotation repelled a strike: until the counter is spent, Neji's palms hold the
-- dome's chakra (the twin palm that glides out of the spin releases it).
local function counterGlow(fx,model,actor,st)
	local open=actor.fighterId=="GentleFist" and (actor.counter or 0)&gt;0 and (actor.health or 1)&gt;0
	if open and not st.counterGlow then
		local glow={}
		for _,name in {"RightHand","LeftHand"} do
			local hand=model:FindFirstChild(name)
			if hand then
				local at=K.new("Attachment",{Name="CounterPalmGlow"},hand)
				K.new("PointLight",{Color=HYUGA,Brightness=2.4,Range=6,Shadows=false},at)
				K.new("ParticleEmitter",{Texture=K.TEX.glow,Rate=24,Lifetime=NumberRange.new(.12,.2),Speed=NumberRange.new(0,.5),LockedToPart=true,
					Color=ColorSequence.new(HYUGA),LightEmission=1,LightInfluence=0,Size=K.num({{0,1},{1,.3}}),Transparency=K.num({{0,.3},{1,1}})},at)
				table.insert(glow,at)
			end
		end
		st.counterGlow=glow
		local root=rootOf(model)
		if root then K.shockRing(fx.folder,root.Position-Vector3.new(0,2.6,0),HYUGA,12,2,.25) end
	elseif not open and st.counterGlow then
		for _,at in st.counterGlow do at:Destroy() end
		st.counterGlow=nil
	end
end
-- Any body can carry closed points and a 64 Palms count; only Neji glows.
local function networkFrame(fx,model,actor,st)
	counterGlow(fx,model,actor,st)
end

-- ----------------------------------------------------------------- Minato
local MINATO=Color3.fromRGB(255,214,92)
local MINATO_CORE=Color3.fromRGB(255,248,214)
local WIND=Color3.fromRGB(190,255,226)
local RASENGAN=Color3.fromRGB(150,210,255)
local RASENGAN_CORE=Color3.fromRGB(235,250,255)
-- Three kinds of Flying Thunder God seal, three looks (Effects draws the kunai
-- and its disc; this adds what tells them apart):
--   planted kunai  a thrown marked kunai stuck in a surface: a gold beacon
--                  stands over it, seen across the stadium;
--   floor formula  the Yellow Flash return seal written where he stood (no
--                  kunai): the formula drawn on the floor, white-gold, turning;
--   body mark      a seal riding on the opponent (a marked kunai that hit, the
--                  rising kick, a wind cut): a ring of formula round the body,
--                  seen from the front as from the back, tightening as it expires.
local function segmentRing(parent,count,radius,size,color)
	local parts={}
	for _=1,count do
		local p=K.block(parent,size,CFrame.new(),color,Enum.Material.Neon)
		p.Transparency=.25
		table.insert(parts,p)
	end
	return parts
end
local function placeRing(parts,center,radius,spin,tilt)
	for i,p in parts do
		local a=(i-1)/#parts*math.pi*2+spin
		p.CFrame=center*CFrame.Angles(tilt or 0,a,0)*CFrame.new(0,0,-radius)
	end
end
-- (06/11, user: « les kunai de Minato… quand ils sont marqués, c'est super
-- moche… un cercle bizarre ») No neon rings any more. Effects writes the
-- formula's characters on the ground round a planted kunai (and a Yellow Flash
-- floor seal); here: a kunai's beacon is a soft shaft of light fading upward
-- (a Beam, not a solid stick), and a seal on a body is the same three
-- characters turning round his waist, always facing the camera, drawing in
-- as it expires.
local FORMULA={"飛","雷","神"}
local function bodyGlyphs(parent,color)
	local parts={}
	for _,ch in FORMULA do
		local p=K.block(parent,Vector3.new(.2,.2,.2),CFrame.new(),color,Enum.Material.SmoothPlastic)
		p.Transparency=1
		local gui=K.new("BillboardGui",{Size=UDim2.fromScale(1.05,1.05),LightInfluence=0,Brightness=1.6,AlwaysOnTop=false},p)
		K.new("TextLabel",{BackgroundTransparency=1,Size=UDim2.fromScale(1,1),Text=ch,TextScaled=true,Font=Enum.Font.GothamBlack,
			TextColor3=color,TextStrokeColor3=Color3.fromRGB(110,60,0),TextStrokeTransparency=.35},gui)
		table.insert(parts,p)
	end
	return parts
end
local function buildSeal(fx,info)
	local model=K.new("Model",{Name="SealMark"},fx.folder)
	local look={model=model}
	if info.body then
		look.kind="body"
		look.ring=bodyGlyphs(model,if info.wind then WIND else MINATO)
	elseif info.wake then
		look.kind="floor"
		K.flash(fx.folder,info.surface,MINATO_CORE,.5,4,.22,.2)
	else
		look.kind="kunai"
		local base=K.block(model,Vector3.new(.2,.2,.2),CFrame.new(),MINATO,Enum.Material.SmoothPlastic)
		base.Name="SealBeacon";base.Transparency=1
		local a0=K.new("Attachment",{Position=Vector3.zero},base)
		local a1=K.new("Attachment",{Position=Vector3.new(0,6,0)},base)
		local beam=K.new("Beam",{Attachment0=a0,Attachment1=a1,Width0=.32,Width1=.06,FaceCamera=true,LightEmission=1,LightInfluence=0,
			Color=ColorSequence.new(MINATO_CORE,MINATO),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.35),NumberSequenceKeypoint.new(1,1)}),
			Segments=1},base)
		look.beacon=base;look.beam=beam
	end
	return look
end
local function stepSeal(fx,folder,look,info,clock)
	local remaining=info.remaining or 12
	local ending=remaining&lt;1 and math.sin(clock*30)&gt;0
	if look.kind=="body" then
		local body=folder and folder:FindFirstChild(info.body or "")
		local torso=body and (body:FindFirstChild("UpperTorso") or rootOf(body))
		if not torso then return end
		-- Round the waist, turning: wherever the camera stands it crosses the body.
		local center=CFrame.new(torso.Position-Vector3.new(0,.35,0))
		local radius=1.15+.4*math.clamp(remaining/1.5,0,1)
		placeRing(look.ring,center,radius,clock*1.6)
		for _,p in look.ring do
			local gui=p:FindFirstChildOfClass("BillboardGui")
			if gui then gui.Enabled=not ending end
		end
	elseif look.kind=="floor" then
		-- Effects writes the formula on the floor.
	else
		-- The beacon stands up from the kunai, whatever surface holds it.
		local at=info.surface+(info.normal or Vector3.yAxis)*.3
		look.beacon.CFrame=CFrame.new(at)
		look.beam.Enabled=not ending
		local glow=.35+.12*math.sin(clock*4)
		look.beam.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,glow),NumberSequenceKeypoint.new(1,1)})
	end
end
local function sealFrame(fx,model,actor,clock)
	fx.identitySeals=fx.identitySeals or {}
	local folder=model.Parent
	local live={}
	for _,info in actor.seals or {} do
		local key=tostring(actor.id)..":"..tostring(info.id)
		live[key]=true
		local look=fx.identitySeals[key]
		if not look or not look.model.Parent then look=buildSeal(fx,info);fx.identitySeals[key]=look end
		stepSeal(fx,folder,look,info,clock)
	end
	local prefix=tostring(actor.id)..":"
	for key,look in fx.identitySeals do
		if string.sub(key,1,#prefix)==prefix and not live[key] then look.model:Destroy();fx.identitySeals[key]=nil end
	end
end
-- After a teleport the arrival window is open (a strike or Rasengan cancels the
-- recovery): a gold ring under him shrinks to nothing as it closes.
local function arrivalRing(fx,model,actor,st,clock)
	local root=rootOf(model)
	if actor.flash and root and (actor.health or 1)&gt;0 then
		if not st.arrival or not st.arrival.ring.Parent then
			local ring=K.block(fx.folder,Vector3.new(.06,5,5),CFrame.new(),MINATO,Enum.Material.Neon)
			ring.Name="ArrivalWindow";ring.Shape=Enum.PartType.Cylinder;ring.Transparency=.35
			st.arrival={ring=ring,born=clock,window=if (actor.awaken or 0)&gt;0 then .8 else .55}
		end
		local left=1-math.clamp((clock-st.arrival.born)/st.arrival.window,0,1)
		local size=1+4*left
		st.arrival.ring.Size=Vector3.new(.06,size,size)
		st.arrival.ring.CFrame=CFrame.new(root.Position-Vector3.new(0,2.85,0))*CFrame.Angles(0,0,math.pi/2)
	elseif st.arrival then
		st.arrival.ring:Destroy();st.arrival=nil
	end
end
-- Yellow Flash: a thin gold thread from him to his newest return seal, the way
-- back the next jump takes (A -&gt; B -&gt; A).
local function returnThread(fx,model,actor,st)
	local awake=(actor.awaken or 0)&gt;0 and (actor.health or 1)&gt;0
	local newest=nil
	if awake then
		for _,info in actor.seals or {} do
			if info.wake and info.surface and (not newest or info.id&gt;newest.id) then newest=info end
		end
	end
	local torso=model:FindFirstChild("UpperTorso") or rootOf(model)
	if newest and torso then
		local thread=st.thread
		if not thread or not thread.anchor.Parent then
			if thread then thread.a0:Destroy() end
			local anchor=K.anchorPart(fx.folder,newest.surface);anchor.Name="ReturnSeal"
			local a0=K.new("Attachment",{Name="ReturnThread"},torso)
			local a1=K.new("Attachment",{},anchor)
			local beam=K.new("Beam",{Name="ReturnThread",Attachment0=a0,Attachment1=a1,Width0=.12,Width1=.3,FaceCamera=true,Segments=1,
				Color=ColorSequence.new(MINATO),LightEmission=1,Transparency=K.num({{0,.35},{1,.55}})},anchor)
			thread={anchor=anchor,a0=a0,beam=beam,id=newest.id}
			st.thread=thread
		end
		if thread.id~=newest.id then thread.anchor.CFrame=CFrame.new(newest.surface+Vector3.new(0,.3,0));thread.id=newest.id end
	elseif st.thread then
		st.thread.anchor:Destroy();st.thread.a0:Destroy();st.thread=nil
	end
end
-- The arrival strike landed on a body still inside the combo that led to the
-- jump: a gold link where it lands, the chain visibly goes on.
local function chainCue(fx,data,folder)
	local at=data.position
	local striker=rootOf(find(folder,data.owner))
	local along=if striker then flatUnit(at-striker.Position) else Vector3.zAxis
	K.shockRing(fx.folder,at,MINATO_CORE,1.5,7,.24,along)
	K.shockRing(fx.folder,at,MINATO,3,11,.32,along)
	K.sparks(fx.folder,at,MINATO,16,22)
	if striker then streak(fx,striker.Position,at,MINATO,.25,.18,"ChainLink") end
end
-- Rasengan where it lands: the sphere grinds into the body (rings turning on
-- every axis), not a punch flash.
local function grindCue(fx,data)
	local at=data.position
	local model=K.new("Model",{Name="RasenganGrind"},fx.folder)
	for k=1,3 do
		local ring=K.block(model,Vector3.new(.08,1.6,1.6),CFrame.new(at)*CFrame.Angles(k*1.1,k*.7,k*1.9),if k==1 then RASENGAN_CORE else RASENGAN,Enum.Material.Neon)
		ring.Shape=Enum.PartType.Cylinder;ring.Transparency=.2
		K.tween(ring,.32,{Size=Vector3.new(.03,5.5,5.5),Transparency=1,CFrame=ring.CFrame*CFrame.Angles(math.pi,0,0)})
	end
	K.flash(fx.folder,at,RASENGAN_CORE,1,5,.2,0)
	K.sparks(fx.folder,at,RASENGAN,24,26)
	Debris:AddItem(model,.4)
	if Kit.has("slash") then
		-- (Reference quality) the sphere grinds: crescents of wind whirl round
		-- the contact, a star, and the floor under it cracks and blows out.
		Kit.star(fx.folder,at,8,RASENGAN_CORE,.12)
		for k=1,4 do
			local cf=CFrame.new(at)*CFrame.Angles(math.rad(70+k*8),k*math.pi/2,0)
			Kit.plane(fx.folder,cf,"slash",Vector2.new(3,1.5),Vector2.new(9,4.5),.22+k*.03,if k%2==0 then RASENGAN_CORE else RASENGAN,0)
		end
		Kit.streaks(fx.folder,at,data.direction or Vector3.zAxis,12,RASENGAN_CORE,70,60)
		local floor=Kit.floorUnder(at,{fx.folder},8)
		if floor then
			Kit.ground(fx.folder,floor.Position,floor.Normal,"crack",8,2,1,Color3.new(1,1,1),.1)
			Kit.dust(fx.folder,floor.Position,7,2.6,Color3.fromRGB(222,214,196),16)
		end
	end
end
local function minatoImpact(fx,data,folder)
	if data.arrival then chainCue(fx,data,folder) end
	if data.variant=="Rasengan" or data.variant=="RasenganDrop" then grindCue(fx,data) end
	return false
end
local function minatoFrame(fx,model,actor,st,clock)
	sealFrame(fx,model,actor,clock)
	arrivalRing(fx,model,actor,st,clock)
	returnThread(fx,model,actor,st)
end

-- ----------------------------------------------------------------- Itachi
local SHARINGAN=Color3.fromRGB(230,36,44)
local SHARINGAN_DEEP=Color3.fromRGB(150,16,26)
local EMBER=Color3.fromRGB(255,128,44)
-- Read stance: three tomoe turn round his feet while the eye waits for the
-- blow. The attacker sees it too: swinging into it is his choice.
local function tomoeRing(fx,model,actor,st,clock)
	local root=rootOf(model)
	if (actor.read or 0)&gt;0 and root and (actor.health or 1)&gt;0 then
		if not st.tomoe or not st.tomoe.model.Parent then
			local holder=K.new("Model",{Name="ReadTomoe"},fx.folder)
			local ring=K.block(holder,Vector3.new(.05,4.6,4.6),CFrame.new(),SHARINGAN,Enum.Material.Neon)
			ring.Shape=Enum.PartType.Cylinder;ring.Transparency=.7
			local marks={}
			for _=1,3 do
				local head=K.block(holder,Vector3.one*.42,CFrame.new(),SHARINGAN_DEEP,Enum.Material.Neon);head.Shape=Enum.PartType.Ball
				local tail=K.block(holder,Vector3.new(.14,.06,.5),CFrame.new(),SHARINGAN_DEEP,Enum.Material.Neon)
				table.insert(marks,{head=head,tail=tail})
			end
			st.tomoe={model=holder,ring=ring,marks=marks}
		end
		local base=CFrame.new(root.Position-Vector3.new(0,2.85,0))
		st.tomoe.ring.CFrame=base*CFrame.Angles(0,0,math.pi/2)
		for k,m in st.tomoe.marks do
			local at=base*CFrame.Angles(0,clock*3+k*2*math.pi/3,0)*CFrame.new(0,.05,-1.75)
			m.head.CFrame=at;m.tail.CFrame=at*CFrame.new(.28,0,.12)*CFrame.Angles(0,math.rad(-50),0)
		end
	elseif st.tomoe then
		st.tomoe.model:Destroy();st.tomoe=nil
	end
end
-- A read paid off: a red ring under him shrinks with the counter window (the
-- snapshot's counter is the time left), the punish is now.
local function counterWindow(fx,model,actor,st)
	local root=rootOf(model)
	local left=actor.counter or 0
	if left&gt;0 and root and (actor.health or 1)&gt;0 then
		if not st.window or not st.window.Parent then
			local ring=K.block(fx.folder,Vector3.new(.06,5,5),CFrame.new(),SHARINGAN,Enum.Material.Neon)
			ring.Name="CounterWindow";ring.Shape=Enum.PartType.Cylinder;ring.Transparency=.35
			st.window=ring
		end
		local size=1+4*math.clamp(left,0,1)
		st.window.Size=Vector3.new(.06,size,size)
		st.window.CFrame=CFrame.new(root.Position-Vector3.new(0,2.85,0))*CFrame.Angles(0,0,math.pi/2)
	elseif st.window then
		st.window:Destroy();st.window=nil
	end
end
local function itachiImpact(fx,data,folder)
	local style=data.style
	if style=="read" and data.phase~="whiff" then
		-- He saw it coming: a line from his eyes to the body that swung.
		local reader=find(folder,data.owner)
		local head=reader and reader:FindFirstChild("Head")
		local swing=rootOf(find(folder,data.victim))
		if head and swing then
			streak(fx,head.Position,swing.Position+Vector3.new(0,.6,0),SHARINGAN,.07,.3,"ReadLine")
			K.flash(fx.folder,swing.Position+Vector3.new(0,.6,0),SHARINGAN,.3,2.2,.16,.25)
		end
	elseif style=="mirage" and data.phase=="catch" then
		-- The image breaks: the real body behind it lights for a beat.
		local caster=rootOf(find(folder,data.owner))
		if caster then
			streak(fx,data.position,caster.Position,SHARINGAN,.12,.3,"MirageReveal")
			K.flash(fx.folder,caster.Position,SHARINGAN,.5,3.5,.2,.2)
		end
	elseif style=="deflect" and data.ricochet and data.to then
		-- A ricochet: its new path flashes from the bounce to the body it seeks.
		streak(fx,data.position,data.to,Color3.fromRGB(255,236,236),.1,.25,"RicochetPath")
		K.shockRing(fx.folder,data.position,SHARINGAN,.5,3.2,.18,data.direction)
	elseif style=="clash" and data.geometry and data.to then
		-- Shuriken Geometry: the two blades' meeting sends them into the flank.
		for _,side in {-.6,.6} do
			local across=flatUnit(data.to-data.position):Cross(Vector3.yAxis)*side
			streak(fx,data.position,data.to+across,Color3.fromRGB(255,236,236),.08,.25,"GeometryPath")
		end
	end
	return false
end
-- Itachi's burning lane (Elements.burnLane): the patches of one lane share a
-- scorched strip from the first to the last, so it reads as a line across the
-- field, not as scattered fires.
-- (Integration 07/11) Itachi's burning lane is drawn by Effects (FX:lanePatch,
-- the jutsu pass of 06/11: ragged burn marks chained patch to patch, low
-- flames, embers). The strip this layer drew on top since 17/10 (a slate
-- plank with two neon edges, the « planche » and « bande jaune » the user
-- asked to be rid of) doubled every lane; it is gone.
local function itachiFrame(fx,model,actor,st,clock)
	tomoeRing(fx,model,actor,st,clock)
	if actor.fighterId=="Mirage" then counterWindow(fx,model,actor,st) end
end

-- ----------------------------------------------------------------- Sasuke
local CURSE=Color3.fromRGB(120,60,200)
local CURSE_INK=Color3.fromRGB(14,10,18)
local SHADOW=Color3.fromRGB(40,44,74)
local CHIDORI=Color3.fromRGB(190,220,255)
local CHIDORI_CORE=Color3.fromRGB(236,244,255)
-- The cursed seal spreads out of the neck as the awakening takes him, one
-- flame mark after another (the dress keeps three at the seal itself), and on
-- across the face while it starves. {part, offset}: the offset's Z axis is the
-- surface normal (front faces -Z, the left side turned a quarter).
local SIDE=CFrame.Angles(0,math.pi/2,0)
local CURSE_SPREAD={
	{"Head",CFrame.new(-.77,-.12,-.3)*SIDE*CFrame.Angles(0,0,math.rad(20))},
	{"Head",CFrame.new(-.77,.16,-.5)*SIDE*CFrame.Angles(0,0,math.rad(40))},
	{"UpperTorso",CFrame.new(-.75,.6,-.51)*CFrame.Angles(0,0,math.rad(-15))},
	{"Head",CFrame.new(-.5,.32,-.77)*CFrame.Angles(0,0,math.rad(55))},
	{"UpperTorso",CFrame.new(-1.01,.35,-.15)*SIDE},
	{"UpperTorso",CFrame.new(-.45,.25,-.51)*CFrame.Angles(0,0,math.rad(25))},
	{"LeftUpperArm",CFrame.new(-.05,.3,-.41)},
	{"LeftUpperArm",CFrame.new(-.41,0,-.05)*SIDE*CFrame.Angles(0,0,math.rad(15))},
	{"LeftUpperArm",CFrame.new(-.05,-.32,-.41)},
	-- Hunger: the curse reaches across the face.
	{"Head",CFrame.new(-.2,.48,-.77)*CFrame.Angles(0,0,math.rad(70)),hunger=true},
	{"Head",CFrame.new(.12,-.36,-.77)*CFrame.Angles(0,0,math.rad(-30)),hunger=true},
}
IdentityFX.CURSE_SPREAD=CURSE_SPREAD
local SPREAD_STEP=.09
local function curseSpread(fx,model,actor,st,clock)
	local awake=(actor.awaken or 0)&gt;0 and (actor.health or 1)&gt;0
	if not awake then
		if st.curse then for _,mark in st.curse.marks do mark:Destroy() end;st.curse=nil end
		return
	end
	if not st.curse then
		local marks={}
		for i,spec in CURSE_SPREAD do
			local body=model:FindFirstChild(spec[1])
			if body then
				local mark=K.block(model,Vector3.new(.12,.34,.04),body.CFrame*spec[2],CURSE_INK,Enum.Material.SmoothPlastic)
				mark.Name="CurseSpread";mark.Anchored=false;mark.Massless=true;mark.Transparency=1
				K.new("WeldConstraint",{Part0=body,Part1=mark},mark)
				marks[i]=mark
			end
		end
		st.curse={marks=marks,born=clock}
	end
	local hungry=actor.curseHunger==true
	local pulse=math.sin(clock*18)&gt;0
	for i,mark in st.curse.marks do
		local spec=CURSE_SPREAD[i]
		local shown=clock-st.curse.born&gt;=(i-1)*SPREAD_STEP and (not spec.hunger or hungry)
		mark.Transparency=if shown then 0 else 1
		mark.Material=if hungry and pulse then Enum.Material.Neon else Enum.Material.SmoothPlastic
		mark.Color=if hungry and pulse then CURSE else CURSE_INK
	end
end
-- Shadow of the Dancing Leaf: a dark shadow chain glued under the rising body
-- while he follows it up (the heavy up there is the Lion Combo); the vault kick
-- draws its arc over the opponent.
local function shadowLeaf(fx,model,actor,st,clock)
	if actor.state=="Pursuit" and (actor.lion or 0)&gt;0 then
		if clock-(st.shadowAt or -1)&gt;=.07 then st.shadowAt=clock;fx:ghost(model,SHADOW,.3,.45) end
	end
	local aura=fx.auras and fx.auras[model]
	if aura and aura.trail and actor.attackName=="VaultKick" and (actor.state=="Startup" or actor.state=="Active") then aura.trail.Enabled=true end
end
-- Chidori: a thrust that lands bursts in lightning along its line; one that
-- finds nothing fizzles out in front of him (the opening is his).
local function chidoriCue(fx,data,folder)
	local at=data.position
	local striker=rootOf(find(folder,data.owner))
	if striker then streak(fx,striker.Position,at,CHIDORI,.3,.22,"ChidoriLine") end
	for k=1,4 do
		local a=k*math.pi/2+math.random()*.6
		fx:bolt(at,at+Vector3.new(math.cos(a)*3.2,(math.random()-.3)*2.4,math.sin(a)*3.2),CHIDORI_CORE)
	end
	K.flash(fx.folder,at,CHIDORI_CORE,1,7,.2,0)
	K.shockRing(fx.folder,at,CHIDORI,2,12,.26,data.direction)
	if Kit.has("lightning") then
		-- (Reference quality) the bolt sheet bursts out of the contact, the star
		-- flashes white-blue and the floor under him is scored.
		Kit.star(fx.folder,at,9,CHIDORI_CORE,.12)
		Kit.burst(fx.folder,at,"lightning",6,{Lifetime=NumberRange.new(.08,.16),Speed=NumberRange.new(0,4),SpreadAngle=Vector2.new(180,180),
			Color=ColorSequence.new(CHIDORI),LightEmission=1,Size=Kit.num({{0,4},{1,7}}),Transparency=Kit.num({{0,0},{1,.4}}),
			Rotation=NumberRange.new(0,360),zoffset=2})
		Kit.streaks(fx.folder,at,data.direction or Vector3.zAxis,16,CHIDORI_CORE,70,40)
		local floor=Kit.floorUnder(at,{fx.folder},8)
		if floor then
			Kit.ground(fx.folder,floor.Position,floor.Normal,"crack",7,2,1,Color3.new(1,1,1),.1)
			Kit.ground(fx.folder,floor.Position,floor.Normal,"scorch",6,2,1,Color3.fromRGB(120,150,220),.3)
		end
	end
end
local function chidoriFizzle(fx,data)
	local holder=K.new("Model",{Name="ChidoriFizzle"},fx.folder)
	K.burst(holder,data.position,{Texture=K.TEX.spark,Lifetime=NumberRange.new(.2,.5),Speed=NumberRange.new(2,6),SpreadAngle=Vector2.new(60,60),
		Color=ColorSequence.new(CHIDORI),LightEmission=1,Size=K.num({{0,.5},{1,0}}),Acceleration=Vector3.new(0,-40,0),Drag=2},18)
	K.flash(holder,data.position,Color3.fromRGB(120,140,170),.4,2.2,.25,.4)
	K.sound(K.anchorPart(fx.folder,data.position),K.SOUND.whoosh,.3,.5)
	Debris:AddItem(holder,.6)
end
-- The steel hidden in the Phoenix Flower glints once as it leaves the flames.
local function hiddenGlint(fx,data)
	fx.identityGlints=fx.identityGlints or {}
	local now=fx:visualTime()
	for _,p in data.projectiles or {} do
		local entry=fx.projectiles[p.id]
		if p.hidden and entry and not fx.identityGlints[p.id] and now-p.born&gt;=.1 then
			fx.identityGlints[p.id]=true
			local at=entry.root.Position
			local glint=K.new("Model",{Name="HiddenGlint"},fx.folder)
			for _,roll in {0,math.pi/2} do
				local ray=K.block(glint,Vector3.new(.06,1.6,.06),CFrame.new(at)*CFrame.Angles(0,0,roll+math.pi/4),Color3.fromRGB(255,255,255),Enum.Material.Neon)
				fade(ray,.18,1.6)
			end
			K.flash(glint,at,Color3.fromRGB(255,250,236),.2,1.4,.12,0)
			K.sound(K.anchorPart(fx.folder,at),K.SOUND.whoosh,.25,2.4)
			Debris:AddItem(glint,.25)
		end
	end
end
local function sasukeImpact(fx,data,folder)
	if data.move=="ChidoriThrust" then
		if data.style=="whiff" then chidoriFizzle(fx,data) elseif data.style~="block" then chidoriCue(fx,data,folder) end
	end
	return false
end
local function sasukeFrame(fx,model,actor,st,clock)
	if actor.fighterId~="Lion" then return end
	curseSpread(fx,model,actor,st,clock)
	shadowLeaf(fx,model,actor,st,clock)
end

-- ------------------------------------------------------------------ layer
local function impact(fx,data,folder)
	if minatoImpact(fx,data,folder) then return true end
	if itachiImpact(fx,data,folder) then return true end
	if sasukeImpact(fx,data,folder) then return true end
	return nejiImpact(fx,data,folder)
end
local function fighter(fx,model,actor,dt)
	if not model or not actor then return end
	local st=stateOf(fx,model)
	local clock=IdentityFX.clock()
	networkFrame(fx,model,actor,st)
	if actor.fighterId=="Flashstep" or #(actor.seals or {})&gt;0 then minatoFrame(fx,model,actor,st,clock) end
	itachiFrame(fx,model,actor,st,clock)
	sasukeFrame(fx,model,actor,st,clock)
end
local function frame(fx,data,dt,folder)
	-- A new duel numbers its projectiles from one again.
	if fx.identityEpoch~=data.epoch then fx.identityEpoch=data.epoch;fx.identityGlints={} end
	hiddenGlint(fx,data)
end
function IdentityFX.install(FX,kit)
	K=kit
	table.insert(FX.layers,{name="Identity",impact=impact,fighter=fighter,frame=frame})
end
IdentityFX.palmPrint=function(fx,at,normal) return palmPrint(fx,at,normal,1,.1,.22) end
return IdentityFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND214">
          <Properties>
            <string name="Name">Input</string>
            <ProtectedString name="Source">local CAS=game:GetService("ContextActionService")
local UIS=game:GetService("UserInputService")
local Controls=require(game:GetService("ReplicatedStorage").NinjaDuel.Controls)
local Input={};Input.__index=Input
-- Chakra chord: a modifier released this long before the tool still counts
-- (Z then R rolled quickly); the clock is a field so specs can drive it.
Input.ChakraChord=.3
-- The modifier held alone this long loads chakra into the next action
-- (server ChakraFlow): pad R1, keyboard Z.
Input.ChakraHold=.28
-- (Audit 29/10) On the pad R1 is also the jutsu shift: a player holding it
-- while choosing the face button loaded chakra by accident (and the next ○
-- became a dash). The pad's load needs a deliberate hold.
Input.ChakraHoldPad=.5
Input.now=os.clock
local KEYBOARD,GAMEPAD=Controls.Keyboard,Controls.Gamepad
local function key(code) return {code} end
local function both(action) return {KEYBOARD[action],GAMEPAD[action]} end
local function padObject(object)
 return Controls.isGamepad(object.UserInputType) or object.KeyCode.Name:match("^Button")~=nil
  or object.KeyCode.Name:match("^DPad")~=nil or object.KeyCode.Name:match("^Thumbstick")~=nil
end
local function released(state) return state==Enum.UserInputState.End or state==Enum.UserInputState.Cancel end
-- The plain throw's aim (the client's send only computes it without extras):
-- the opponent on the pad, the mouse point on keyboard, within reach.
local function toolAim(state,pad)
 local ok,hit=pcall(function()
  local player=game:GetService("Players").LocalPlayer
  local point=if pad then state.bot and state.bot.position else player:GetMouse().Hit.Position
  local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
  if point and root and (point-root.Position).Magnitude&lt;=140 then return point end
  return nil
 end)
 return if ok then hit else nil
end
function Input.new(send,getState,toggleLock,camera)
 local self=setmetatable({send=send,getState=getState,keys={},stick=Vector2.zero,look=Vector2.zero,
  sprinting=false,modifier=false,camera=camera,pad=Controls.isGamepad(UIS:GetLastInputType()),held={},guards={},jumps={},seals={}},Input)
 local function bind(name,keys,callback)
  local list={};for _,code in keys do if code then table.insert(list,code) end end
  CAS:BindActionAtPriority("Ninja"..name,function(_,state,object)
   if UIS:GetFocusedTextBox() or getState().phase~="Duel" or (name=="Skip" and not getState().tutorial) then
    -- (Flight recorder, Debug) a press the client itself let go of.
    if Input.dropped and state==Enum.UserInputState.Begin and name~="MoveStick" and name~="LookStick" then
     table.insert(Input.dropped,{t=os.clock(),name=name,why=if UIS:GetFocusedTextBox() then "textbox" else "phase "..tostring(getState().phase)})
     while #Input.dropped&gt;60 do table.remove(Input.dropped,1) end
    end
    return Enum.ContextActionResult.Pass
   end
   local stick=object.KeyCode==Enum.KeyCode.Thumbstick1 or object.KeyCode==Enum.KeyCode.Thumbstick2
   if not released(state) and (not stick or object.Position.Magnitude&gt;.15) then self.pad=padObject(object) end
   callback(state,object)
   return Enum.ContextActionResult.Sink
  end,false,3000,table.unpack(list))
 end
 local function begin(state) return state==Enum.UserInputState.Begin end
 -- Schmitt thresholds: an analog trigger crossing its press threshold emits
 -- once. Change events while it is held never become repeated attacks.
 local function pressed(state,object)
  local code=object.KeyCode
  local id=if object.UserInputType==Enum.UserInputType.MouseButton1 or object.UserInputType==Enum.UserInputType.MouseButton2 then object.UserInputType.Name else code.Name
  if code==GAMEPAD.Grab or code==GAMEPAD.Tool then
   if released(state) or object.Position.Z&lt;=.25 then self.held[id]=nil;return false end
   if object.Position.Z&gt;=.55 and not self.held[id] then self.held[id]=true;return true end
   return false
  end
  if released(state) then self.held[id]=nil;return false end
  if begin(state) and not self.held[id] then self.held[id]=true;return true end
  return false
 end
 for _,code in {Enum.KeyCode.W,Enum.KeyCode.A,Enum.KeyCode.S,Enum.KeyCode.D} do
  bind(code.Name,key(code),function(state)
   if begin(state) then self.keys[code.Name]=true elseif released(state) then self.keys[code.Name]=nil end
  end)
 end
 bind("MoveStick",key(Enum.KeyCode.Thumbstick1),function(state,obj)
  self.stick=if released(state) then Vector2.zero else Vector2.new(obj.Position.X,obj.Position.Y)
 end)
 bind("LookStick",key(Enum.KeyCode.Thumbstick2),function(state,obj)
  self.look=if released(state) then Vector2.zero else Vector2.new(obj.Position.X,obj.Position.Y)
  camera.look=self.look
 end)
 -- (05/11, user on the pad: « l'ergonomie des touches c'est pas encore ça »)
 -- R1 + L1 was three things: the seal page held, the ultimate on a short tap
 -- of it, the wall's detach; opening the page let the guard go, and a page
 -- closed without a seal could burn the bar. Now R1 + L1 is the ultimate
 -- alone, on the chord's press, in either order (the server makes it the
 -- detach on a wall); the seal jutsu are L2 + R1 + □ △ ○ × (the chakra
 -- button with the jutsu one: a jutsu woven with its signs).
 -- The guard L1 raised is let go only when the chord can do something (the
 -- bar full, a wall to leave) and comes back if L1 is still held when R1 goes.
 local function ultimate()
  self.modifierSpent=true
  local h=getState().human
  if h and (h.ultimateReady or h.wall) and next(self.guards)~=nil then
   table.clear(self.guards);send("GuardOff");self.guardTaken=true
  end
  send("Ultimate")
 end
 bind("Modifier",key(GAMEPAD.Modifier),function(state)
  if begin(state) then
   self.modifier=true;self.modifierAt=Input.now();self.modifierSpent=false
   if self.padL1 then ultimate() end
  elseif released(state) then
   self.modifier=false
   if self.guardTaken and self.padL1 then
    local already=next(self.guards)~=nil;self.guards[GAMEPAD.Guard.Name]=true
    if not already then send("Guard") end
   end
   self.guardTaken=nil
  end
 end)
 local function face(state,object,normal,slot)
  if pressed(state,object) then
   local modified=padObject(object) and self.modifier
   if modified then self.modifierSpent=true;self.seals[object.KeyCode.Name]=true end
   -- (05/11) L2 held with R1: the second page, the seal jutsu.
   if modified and self.chakraPad then send("Seal"..slot);return false end
   -- (User 29/10) Pad L1 + □ is the grab (the guard held, the light pressed).
   if not modified and normal=="Attack" and padObject(object) and next(self.guards)~=nil then send("Grab");return false end
   -- The chakra button held (pad L2, keyboard Z): the press goes out infused.
   if modified then send("Technique"..slot)
   elseif self:chakraOn(padObject(object)) then send(normal,{chakra=true})
   else send(normal) end
   return not modified
  end
  -- (Audit 29/10) The face button let go after R1+face lets a held technique
  -- go, as keys 1-4 do (a pad Katon always charged to the end).
  if released(state) and self.seals[object.KeyCode.Name] then self.seals[object.KeyCode.Name]=nil;send("SealRelease") end
  return false
 end
 bind("Light",both("Light"),function(state,obj) face(state,obj,"Attack",1) end)
 bind("Heavy",both("Heavy"),function(state,obj) face(state,obj,"Heavy",2) end)
 bind("Dodge",both("Dodge"),function(state,obj) face(state,obj,"Dodge",3) end)
 bind("Jump",both("Jump"),function(state,obj)
  local id=if padObject(obj) then obj.KeyCode.Name else obj.UserInputType.Name..obj.KeyCode.Name
  if released(state) then
   if self.jumps[id] then self.jumps[id]=nil;send("JumpOff") end
   face(state,obj,"Jump",4)
  else
   -- (User 29/10: a jump pressed after a launch flew the body up after the
   -- other one.) On a pad × doubles as the chase inside its window (no
   -- spare button); on a keyboard the chase has its own key (E) and Space
   -- always jumps.
   -- (Audit 29/10) The pad sends PadJump: the server picks the chase if its
   -- own window is open, else the jump (Matches:act).
   local action=if padObject(obj) then "PadJump" else "Jump"
   if face(state,obj,action,4) then self.jumps[id]=true end
  end
 end)
 bind("Guard",both("Guard"),function(state,obj)
  local id=obj.KeyCode.Name
  if released(state) then
   if padObject(obj) then self.padL1=false;self.guardTaken=nil end
   if self.guards[id] then
    self.guards[id]=nil
    if next(self.guards)==nil then send("GuardOff") end
   end
   pressed(state,obj)
  elseif pressed(state,obj) then
   if padObject(obj) then self.padL1=true end
   -- R1 held, then L1: the ultimate (Modifier above for L1 first).
   if padObject(obj) and self.modifier then ultimate()
   else
    local already=next(self.guards)~=nil;self.guards[id]=true
    if not already then send("Guard") end
   end
  end
 end)
 -- Chakra modifier + tool: keyboard Z (held, or just pressed), pad R1 + R2.
 -- Only a boolean leaves the client; the server picks what the chakra does.
 bind("ChakraPad",key(GAMEPAD.Chakra),function(state,obj)
  if released(state) or (obj.Position and obj.Position.Z&lt;=.25 and state~=Enum.UserInputState.Begin) then self.chakraPad=false;self.chakraPadAt=Input.now()
  elseif state==Enum.UserInputState.Begin or (obj.Position and obj.Position.Z&gt;=.45) then self.chakraPad=true end
 end)
 bind("ChakraKey",key(KEYBOARD.Chakra),function(state)
  if begin(state) then self.chakra=true;self.chakraAt=Input.now();self.chakraDownAt=self.chakraAt;self.chakraSpent=false elseif released(state) then self.chakra=false;self.chakraAt=Input.now() end
 end)
 bind("Tool",both("Tool"),function(state,obj)
  if pressed(state,obj) then
   -- R1 + R2 on the pad is the feint now (R1 is the jutsu shift, L2 the chakra).
   if padObject(obj) and self.modifier then self.modifierSpent=true;send("Feint");return end
   local chakra=self:chakraOn(padObject(obj))
   if chakra then self.chakraSpent=true end
   if chakra then send("Tool",{chakra=true,aim=toolAim(getState(),padObject(obj))}) else send("Tool") end
  end
 end)
 bind("Grab",both("Grab"),function(state,obj)
  if pressed(state,obj) then
   if padObject(obj) and self.modifier then self.modifierSpent=true end
   send(if padObject(obj) and self.modifier then "Feint" else "Grab")
  end
 end)
 bind("Lock",both("Lock"),function(state,obj) if pressed(state,obj) then toggleLock() end end)
 bind("Sprint",both("Sprint"),function(state,obj)
  if obj.KeyCode==GAMEPAD.Sprint then if pressed(state,obj) then self.sprinting=not self.sprinting end
  elseif begin(state) then self.sprinting=true elseif released(state) then self.sprinting=false end
 end)
 -- Keyboard C: held, the second page of jutsu (1-5 cast the seal jutsu); on a
 -- wall the press still lets go of it.
 bind("SealKey",key(KEYBOARD.WallDetach),function(state,obj)
  if pressed(state,obj) then self.sealKey=true;send("WallDetach")
  elseif released(state) then self.sealKey=false end
 end)
 for _,action in {"Substitute","Feint","Pursuit","Ultimate"} do
  bind(action.."Key",key(KEYBOARD[action]),function(state,obj) if pressed(state,obj) then send(action) end end)
 end
 for _,action in {"Awaken","Arm"} do
  bind(action,both(action),function(state,obj) if pressed(state,obj) then send(action) end end)
 end
 -- Jutsu 5 (keyboard 5, D-pad ↑); on the seal page the fifth seal jutsu
 -- (keyboard C held, pad L2 + R1 held).
 bind("Technique5",both("Technique5"),function(state,obj)
  if pressed(state,obj) then
   local page=if padObject(obj) then self:sealPage() else self.sealKey
   if page then send("Seal5") else send("Technique5") end
  end
 end)
 -- Pad re-engage has no button of its own: × in a chase window (Jump above),
 -- else ○ toward a locked opponent while sprinting. The Dodge packet already
 -- carries the stick and the sprint toggle; the server turns it into the dash.
 bind("SubstitutePad",key(GAMEPAD.Substitute),function(state,obj) if pressed(state,obj) then send("Substitute") end end)
 -- (Audit 04/11) The tutorial: a tap skips the step, held a second it leaves
 -- (BACKSPACE / touchpad; Escape is the Roblox menu and never arrives).
 bind("Skip",both("Skip"),function(state,obj)
  if not getState().tutorial then return end
  if pressed(state,obj) then self.skipAt=Input.now()
  elseif released(state) and self.skipAt then
   local held=Input.now()-self.skipAt;self.skipAt=nil
   send(if held&gt;=1 then "TutorialSkip" else "TutorialStep")
  end
 end)
 for index,code in {Enum.KeyCode.One,Enum.KeyCode.Two,Enum.KeyCode.Three,Enum.KeyCode.Four} do
  bind("Technique"..index,key(code),function(state,obj)
   -- C held: the second page, the seal jutsu (one press, the cast weaves the signs).
   if pressed(state,obj) then send(if self.sealKey then "Seal"..index else "Technique"..index)
   -- The release lets a held technique go (a charged Katon).
   elseif released(state) then send("SealRelease") end
  end)
 end
 local function blur()
  local jumping=next(self.jumps)~=nil
  self:reset();send("GuardOff");if jumping then send("JumpOff") end;send("Move",Vector3.zero)
 end
 UIS.WindowFocusReleased:Connect(blur)
 -- (Freeze 02/11) Back in the window: the keys still held count again.
 UIS.WindowFocused:Connect(function() self:resync() end)
 UIS.TextBoxFocused:Connect(blur)
 UIS.GamepadDisconnected:Connect(function() if self.pad then blur();self.pad=false end end)
 UIS.LastInputTypeChanged:Connect(function(kind)
  -- Moving the cursor while using the pad must not erase the PS5 prompts.
  if kind~=Enum.UserInputType.MouseMovement then self.pad=Controls.isGamepad(kind) end
 end)
 return self
end
function Input:reset()
 table.clear(self.keys);table.clear(self.held);table.clear(self.guards);table.clear(self.jumps);table.clear(self.seals)
 self.sealKey=false;self.padL1=false;self.guardTaken=nil
 self.stick=Vector2.zero;self.look=Vector2.zero;self.modifier=false;self.sprinting=false;self.camera.look=Vector2.zero
 self.chakra=false;self.chakraAt=nil;self.modifierSpent=true;self.chakraSpent=true;self.chakraPad=false;self.chakraPadAt=nil
end
-- (Audit 29/10) A new round (or phase) clears the presses but not the hand:
-- a direction held through the round change was forgotten until the key was
-- pressed again, so the body stood still at the start of every round.
function Input:resync()
 self:reset()
 pcall(function()
  for _,code in {Enum.KeyCode.W,Enum.KeyCode.A,Enum.KeyCode.S,Enum.KeyCode.D} do
   if UIS:IsKeyDown(code) then self.keys[code.Name]=true end
  end
  if not self.pad and UIS:IsKeyDown(KEYBOARD.Sprint) then self.sprinting=true end
  for _,input in UIS:GetGamepadState(Enum.UserInputType.Gamepad1) do
   if input.KeyCode==Enum.KeyCode.Thumbstick1 and input.Position.Magnitude&gt;.15 then self.stick=Vector2.new(input.Position.X,input.Position.Y) end
  end
 end)
end
-- The seal page held: keyboard C, pad L2 + R1 (05/11) — the HUD's slip.
function Input:sealPage()
 if self.pad then return self.modifier==true and self.chakraPad==true end
 return self.sealKey==true
end
-- (Freedom) The modifier held alone: once per hold, the next action is
-- loaded with chakra. Polled every frame (Input:direction).
function Input:chakraHold()
 local now=Input.now()
 -- (User 29/10) Nothing loads on a hold alone any more: the chakra button
 -- infuses the press it is held with (Input:chakraOn).
 local _=now
end
-- The chakra button: held (or released a moment before, a rolled chord).
function Input:chakraOn(pad)
 local now=Input.now()
 if pad then return self.chakraPad==true or now-(self.chakraPadAt or -math.huge)&lt;=Input.ChakraChord end
 return self.chakra==true or now-(self.chakraAt or -math.huge)&lt;=Input.ChakraChord
end
function Input:direction(camera)
 self:chakraHold()
 -- The current device owns movement; a resting controller cannot steer WASD.
 local stick=if self.pad and self.stick.Magnitude&gt;.15 then self.stick else Vector2.zero
 -- (04/11) a phone's stick (Client/TouchControls)
 if stick.Magnitude==0 and self.touchStick and self.touchStick.Magnitude&gt;.15 then stick=self.touchStick end
 -- (Freeze 02/11) The keys drive whenever the stick does not. A connected pad
 -- (a drifting stick, any pad event is enough) switched to "pad" and WASD was
 -- ignored, even held: the body stood still until the key was pressed again.
 -- A stick really pushed still owns the route alone (no stale key mixed in).
 local keys=stick.Magnitude==0
 -- (User 28/10) The pad's sprint is a toggle (L3); it ends when the stick
 -- rests a moment, so a stop always gives the walk / string back (it stayed on
 -- and every light became the running strike).
 if self.pad and self.sprinting then
  if stick.Magnitude&lt;.2 then
   self.restAt=self.restAt or Input.now()
   if Input.now()-self.restAt&gt;.18 then self.sprinting=false;self.restAt=nil end
  else self.restAt=nil end
 end
 local x=stick.X+(if self.keys.D and keys then 1 else 0)-(if self.keys.A and keys then 1 else 0)
 local z=stick.Y+(if self.keys.W and keys then 1 else 0)-(if self.keys.S and keys then 1 else 0)
 local look=camera.CFrame.LookVector*Vector3.new(1,0,1)
 if look.Magnitude&lt;.01 then look=-Vector3.zAxis end
 local right=Vector3.new(-look.Unit.Z,0,look.Unit.X)
 local v=right*x+look.Unit*z
 return if v.Magnitude&gt;1 then v.Unit else v
end
return Input
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND215">
          <Properties>
            <string name="Name">LeeFX</string>
            <ProtectedString name="Source">-- Rock Lee on the client (stress-test wave, DEC-015): the Fifth Gate (a green
-- chakra mantle and a flushed, burning body), his lotuses (the spin drawn
-- round the body, the crater where it lands), the crescent of the deflecting
-- kick, the Rupture's ring, and his speed (green afterimages, dust kicked up)
-- instead of the shared colours. One identity layer installed into Effects
-- (like SandFX): Effects only offers the registry and its helpers.
-- Presentation only: nothing here can change gameplay.
local Debris=game:GetService("Debris")

local LeeFX={}
local K -- Effects' helpers, handed over by install()
LeeFX.clock=os.clock -- (headless tests drive time)
local LEE="Leaf"

local GATE=Color3.fromRGB(120,230,140) -- the gates' chakra
local GATE_CORE=Color3.fromRGB(226,255,226)
local FLUSH=Color3.fromRGB(226,92,72) -- the body burning in the gates
local DUST=Color3.fromRGB(206,194,168)
local LOTUS={PrimaryLotus=true,HiddenLotus=true,LeafHeel=true}

local function stateOf(fx,model)
	fx.leeState=fx.leeState or setmetatable({},{__mode="k"})
	local st=fx.leeState[model]
	if not st then st={};fx.leeState[model]=st end
	return st
end
local function ground(fx,position,fallback)
	local ok,hit=pcall(K.floorUnder,fx,position,3,12)
	return if ok and hit then hit.Position.Y else fallback
end
local function kickDust(fx,position,count,size)
	K.smokePuff(fx.folder,position,DUST,count,size)
end
-- Cracks and a ring of dust where a body was driven into the floor.
local function crater(fx,at,size)
	local y=ground(fx,at,at.Y-2.8)
	local holder=K.new("Model",{Name="LotusCrater"},fx.folder)
	local disc=K.block(holder,Vector3.new(.06,size,size),CFrame.new(at.X,y+.04,at.Z)*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(70,62,54),Enum.Material.Slate)
	disc.Shape=Enum.PartType.Cylinder;disc.Transparency=.35
	for k=0,5 do
		local a=k/6*math.pi*2+math.random()*.4
		local crack=K.block(holder,Vector3.new(.08,.05,size*.45),CFrame.new(at.X,y+.06,at.Z)*CFrame.Angles(0,a,0)*CFrame.new(0,0,-size*.3),Color3.fromRGB(40,36,32),Enum.Material.Slate)
		crack.Transparency=.2
	end
	task.delay(1.2,function() for _,d in holder:GetChildren() do K.tween(d,.6,{Transparency=1}) end end)
	Debris:AddItem(holder,2)
	K.shockRing(fx.folder,Vector3.new(at.X,y+.1,at.Z),DUST,2,size*2.2,.35)
	kickDust(fx,Vector3.new(at.X,y+.8,at.Z),22,2.4)
end

-- ------------------------------------------------------------------ contacts
local function awaken(fx,impact,folder)
	-- The Fifth Gate opens: a green burst, the floor cracked under him.
	local at=impact.position
	local model=folder and folder:FindFirstChild(impact.owner or "")
	if model then fx:ghost(model,GATE,.4,.35) end
	local burst=K.new("Model",{Name="GateBurst"},fx.folder)
	K.flash(burst,at,GATE_CORE,2,10,.3,.1)
	K.flash(burst,at,GATE,4,16,.45,.35)
	Debris:AddItem(burst,.6)
	crater(fx,at,7)
	K.shockRing(fx.folder,at-Vector3.new(0,2.6,0),GATE,3,26,.5)
	K.sound(K.anchorPart(fx.folder,at),K.SOUND.boom,.5,1.3)
	fx:cheer(1)
end
local function speed(fx,impact,folder)
	-- His dash and the shadow under a rising body: a green afterimage and the
	-- dust his feet tear up.
	local model=folder and folder:FindFirstChild(impact.owner or "")
	if model then fx:ghost(model,GATE,.2,.6) end
	kickDust(fx,impact.position-Vector3.new(0,2.6,0),10,1.5)
	K.sound(K.anchorPart(fx.folder,impact.position),K.SOUND.whoosh,.4,1.25)
end
local function rupture(fx,impact)
	-- The Rupture: a spinning kick on the spot that throws the attacker off.
	local at=impact.position
	local holder=K.new("Model",{Name="RuptureRing"},fx.folder)
	K.shockRing(holder,at-Vector3.new(0,.6,0),GATE_CORE,2,13,.25)
	K.shockRing(holder,at-Vector3.new(0,2.5,0),DUST,2,10,.3)
	Debris:AddItem(holder,.4)
	kickDust(fx,at-Vector3.new(0,2.5,0),12,1.6)
	K.sound(K.anchorPart(fx.folder,at),K.SOUND.whoosh,.5,.9)
end
local function windUp(fx,impact)
	-- The Leaf Great Whirlwind needs no seal: the dust spins up round his feet.
	local at=impact.position
	K.shockRing(fx.folder,at-Vector3.new(0,2.6,0),DUST,2,9,.3)
	kickDust(fx,at-Vector3.new(0,2.4,0),10,1.4)
end
-- (06/11) A gate opening (Server Techniques.gateStep): a green burst off his
-- body, the floor cracking under him from the third on.
local function gateOpens(fx,impact)
	local at=impact.position
	local gate=impact.gate or 2
	K.shockRing(fx.folder,at,GATE,1.5,8+gate*3,.35)
	K.flash(fx.folder,at,GATE_CORE,.6,3+gate*.6,.2,.3)
	if gate&gt;=3 then crater(fx,at,3+gate) end
	K.sound(K.anchorPart(fx.folder,at),K.SOUND.boom,.25+gate*.05,1.6-gate*.08)
end
local function impact(fx,data,folder)
	if data.fighter~=LEE then return false end
	local style=data.style
	if style=="awaken" then awaken(fx,data,folder);return true end
	if style=="gate" then gateOpens(fx,data);return true end
	if style=="chase" or style=="afterimage" then speed(fx,data,folder);return true end
	if style=="repel" then rupture(fx,data);return true end
	if style=="cast" and data.technique=="LeafGreatWhirlwind" then windUp(fx,data);return true end
	return false
end

-- ------------------------------------------------------------------ per frame
-- The Fifth Gate: the shared mantle burns green and the body itself burns.
-- (04/11, the user: "sur l'éveil de Lee, les poids sur sa tête, c'est moche,
-- c'est bizarre": the red ball that sat round his head is gone.) The gates show
-- on him: every skin-coloured part flushes red (given back as they close) and
-- the steam of the burning body rises off his shoulders.
local STEAM=Color3.fromRGB(232,255,234)
local function skinLike(a,b) return math.abs(a.R-b.R)+math.abs(a.G-b.G)+math.abs(a.B-b.B)&lt;.07 end
local function gate(fx,model,actor,st)
	local aura=fx.auras and fx.auras[model]
	local open=(actor.awaken or 0)&gt;0 and (actor.health or 1)&gt;0
	if aura and aura.mantle and aura.leeMantle~=aura.mantle then
		aura.mantle.emitter.Color=ColorSequence.new(GATE)
		aura.mantle.light.Color=GATE
		aura.leeMantle=aura.mantle
	end
	if aura and aura.trail and not aura.leeTrail then aura.trail.Color=ColorSequence.new(GATE);aura.leeTrail=true end
	local head=model:FindFirstChild("Head")
	-- (06/11) the flush and the steam grow with the gate that is open.
	local gateNow=if open then (actor.gate or 1) else 0
	if open and st.flush and st.gate~=gateNow then
		st.gate=gateNow
		for _,p in st.flush do if p.Parent then K.tintLayer(p,"flush",math.min(.85,.3+gateNow*.11)) end end
		local e=st.steam and st.steam:FindFirstChildOfClass("ParticleEmitter")
		if e then e.Rate=10+gateNow*8 end
	end
	if open and head and not st.flush then
		-- (the original colours come from Effects' one record, shared with the
		-- battle wear: each layer adds itself, nothing is restored blindly)
		st.flush={}
		local skin=head.Color and K.baseColor(head)
		for _,p in model:GetDescendants() do
			if skin and p:IsA("BasePart") and p.Name~="HumanoidRootPart" and p.Color and skinLike(K.baseColor(p),skin) then
				table.insert(st.flush,p)
				K.tintLayer(p,"flush",math.min(.85,.3+(actor.gate or 1)*.11))
			end
		end
		local torso=model:FindFirstChild("UpperTorso") or head
		local at=K.new("Attachment",{Name="GateSteam",Position=Vector3.new(0,.7,0)},torso)
		K.new("ParticleEmitter",{Texture=K.TEX.smoke,Rate=18,Lifetime=NumberRange.new(.7,1.2),Speed=NumberRange.new(1.4,3),SpreadAngle=Vector2.new(35,35),
			EmissionDirection=Enum.NormalId.Top,Acceleration=Vector3.new(0,2.5,0),Color=ColorSequence.new(STEAM),LightEmission=.25,LightInfluence=.3,
			Size=K.num({{0,.7},{1,2.4}}),Transparency=K.num({{0,.62},{.4,.7},{1,1}}),Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-45,45)},at)
		st.steam=at;st.gate=nil
	elseif not open and st.flush then
		for _,p in st.flush do if p.Parent then K.tintLayer(p,"flush",nil) end end
		st.flush=nil
		if st.steam then
			local e=st.steam:FindFirstChildOfClass("ParticleEmitter")
			if e then e.Enabled=false end
			st.steam.Name="GateSteamFading"
			Debris:AddItem(st.steam,1.3)
			st.steam=nil
		end
	end
end
-- The lotuses: a spiral of chakra round the falling body, a crater where it lands.
local function lotus(fx,model,actor,st)
	local root=model:FindFirstChild("HumanoidRootPart")
	local variant=actor.attackVariant
	local falling=root and LOTUS[variant or ""] and actor.attackName=="Slam" and (actor.state=="Startup" or actor.state=="Active")
	if falling then
		st.lotus=variant
		st.spin=(st.spin or 0)+.9
		local hidden=variant=="HiddenLotus"
		for k=0,1 do
			local a=st.spin+k*math.pi
			local at=root.Position+Vector3.new(math.cos(a)*2.2,(k-.5)*1.2,math.sin(a)*2.2)
			local streak=K.block(fx.folder,Vector3.new(.18,.18,1.6),CFrame.lookAt(at,at+Vector3.new(-math.sin(a),0,math.cos(a))),if hidden then FLUSH else GATE_CORE,Enum.Material.Neon)
			streak.Name="LotusSpiral";streak.Transparency=.25
			K.tween(streak,.22,{Transparency=1,Size=Vector3.new(.04,.04,2.2)})
			Debris:AddItem(streak,.25)
		end
	elseif st.lotus and root then
		-- Landed (or cut short): the floor takes it.
		crater(fx,root.Position,if st.lotus=="HiddenLotus" then 10 else 7)
		if st.lotus=="HiddenLotus" then K.shockRing(fx.folder,root.Position-Vector3.new(0,2.5,0),FLUSH,3,20,.4) end
		st.lotus=nil
	end
end
-- The deflecting kick: a crescent of air swept across his front.
local function crescent(fx,model,actor,st)
	if actor.attackName~="DeflectKick" or actor.state~="Startup" then return end
	local serial=actor.attackSerial or 0
	if st.kick==serial then return end
	st.kick=serial
	local root=model:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local holder=K.new("Model",{Name="DeflectArc"},fx.folder)
	for k=-3,3 do
		local a=math.rad(k*20)
		local cf=root.CFrame*CFrame.new(0,.6,0)*CFrame.Angles(0,a,0)*CFrame.new(0,0,-3.2)
		local piece=K.block(holder,Vector3.new(1.15,.1,.22),cf,Color3.fromRGB(236,244,255),Enum.Material.Neon)
		piece.Transparency=.35+math.abs(k)*.08
		K.tween(piece,.24,{Transparency=1})
	end
	Debris:AddItem(holder,.3)
end
local function fighter(fx,model,actor,dt)
	if not model or not actor or actor.fighterId~=LEE then return end
	local st=stateOf(fx,model)
	gate(fx,model,actor,st)
	lotus(fx,model,actor,st)
	crescent(fx,model,actor,st)
end

function LeeFX.install(FX,kit)
	K=kit
	table.insert(FX.layers,{name="Lee",impact=impact,fighter=fighter})
end
return LeeFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND216">
          <Properties>
            <string name="Name">LightBudgetFX</string>
            <ProtectedString name="Source">-- The effect lights, kept to a budget (OUTILLEUR, F7 tool, 08/11).
--
-- In a Sasuke-Minato AI duel the F7 tool counted 17 to 19 effect lights lit at
-- once (fire, chakra, awakenings): a cost on every machine and a washed-out
-- image. Every module that lights an effect keeps doing it its own way; this
-- layer watches the lights that appear under the duel's effects and bodies,
-- keeps the MAX that matter most lit (bright, wide, near the camera) and
-- switches the others off until a place frees up. It never lets an effect
-- light cast a shadow. Decor lights (the courtyard, the menu stage) are not
-- touched.
--
-- It owns the lights' Enabled: a module that wants a light out sets its
-- Brightness to 0 (a light at 0 does not take a place).
local RunService=game:GetService("RunService")

local LightBudgetFX={}
LightBudgetFX.MAX=8
LightBudgetFX.PERIOD=.1
LightBudgetFX.enabled=true

-- Where effect lights live; and what is decor inside those places.
local ROOTS={"NinjaDuelFX","NinjaDuels","NinjaDuelBodies"}
local DECOR={Courtyard=true,NinjaDuelMenuStage=true,NinjaDuelArenaDress=true}

local function isEffectLight(light)
	if not light:IsA("Light") then return false end
	local node=light.Parent
	local underRoot=false
	while node and node~=workspace do
		if DECOR[node.Name] then return false end
		if node.Parent==workspace and table.find(ROOTS,node.Name) then underRoot=true end
		node=node.Parent
	end
	return underRoot
end
LightBudgetFX.isEffectLight=isEffectLight

-- Pure: which of these lights stay lit. `lights` are {light=, brightness=,
-- range=, distance=}; returns a set of the kept `light` values.
function LightBudgetFX.choose(lights,max)
	local lit={}
	for _,l in lights do if l.brightness&gt;.01 and l.range&gt;.1 then table.insert(lit,l) end end
	for _,l in lit do l.score=l.brightness*l.range/(1+(l.distance or 0)/30) end
	table.sort(lit,function(a,b) return a.score&gt;b.score end)
	local keep={}
	for i=1,math.min(max,#lit) do keep[lit[i].light]=true end
	return keep
end

local tracked=setmetatable({},{__mode="k"}) -- every effect light seen
local off=setmetatable({},{__mode="k"})     -- the ones this layer switched off
LightBudgetFX.tracked=tracked
LightBudgetFX.off=off

local function track(light)
	if tracked[light] then return end
	if not isEffectLight(light) then return end
	tracked[light]=true
	light.Shadows=false
end
LightBudgetFX.track=track

function LightBudgetFX.step(cameraPosition)
	local list={}
	for light in tracked do
		if light.Parent==nil then tracked[light]=nil;off[light]=nil
		elseif light.Enabled or off[light] then
			light.Shadows=false
			local position
			local parent=light.Parent
			if parent:IsA("Attachment") then position=parent.WorldPosition
			elseif parent:IsA("BasePart") then position=parent.Position end
			table.insert(list,{light=light,brightness=light.Brightness,range=(light::any).Range or 8,
				distance=if position and cameraPosition then (position-cameraPosition).Magnitude else 0})
		end
	end
	local keep=LightBudgetFX.choose(list,LightBudgetFX.MAX)
	local lit=0
	for _,l in list do
		local light=l.light
		if keep[light] then
			if off[light] then off[light]=nil;light.Enabled=true end
			lit+=1
		elseif light.Enabled and l.brightness&gt;.01 then
			off[light]=true;light.Enabled=false
		end
	end
	return lit
end

local started=false
local function start()
	for _,root in ROOTS do
		local folder=workspace:FindFirstChild(root)
		if folder then for _,d in folder:GetDescendants() do if d:IsA("Light") then track(d) end end end
	end
	workspace.DescendantAdded:Connect(function(d)
		if d:IsA("Light") then task.defer(track,d) end -- (its parent chain is set by then)
	end)
	local wait=0
	RunService.Heartbeat:Connect(function(dt)
		if not LightBudgetFX.enabled then return end
		wait-=dt
		if wait&gt;0 then return end
		wait=LightBudgetFX.PERIOD
		local camera=workspace.CurrentCamera
		LightBudgetFX.step(camera and camera.CFrame.Position)
	end)
end
function LightBudgetFX.start()
	if started then return end
	started=true
	-- (headless specs load Effects without a real workspace: nothing to watch)
	local ok,err=pcall(start)
	if not ok and RunService:IsStudio() then warn("[LightBudgetFX] "..tostring(err)) end
end
return LightBudgetFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND217">
          <Properties>
            <string name="Name">LightningBoltFX</string>
            <ProtectedString name="Source">--[[
	Procedural lightning, adapted from "Lightning Beams" by Quasiduck (Samy),
	https://github.com/SamyBlue/Lightning-Beams (MIT, copyright (c) 2020 Samy;
	the licence text is at the bottom of this file).

	What is kept: the bolt itself, the original's maths - control points along
	a cubic Bezier between two attachments, moved by layered Perlin noise
	(radius picked on a disk, so the zigzag is even all round the line), the
	thickness noise, the pulse that runs the bolt from Attachment0 to
	Attachment1 (a bolt can be drawn as it travels) and the dissipating end.

	What changes for Ninja Duel (VFX bible 06/11: anime, few layers, a little
	colour, never plain Neon parts):
	  * drawn with Beams, not Neon cylinders: one invisible anchor per bolt,
	    one attachment per point, two beams per segment - a thin white-hot core
	    and a coloured glow round it (the anime line: a pure stroke with its
	    colour bleeding out), both LightEmission 1, no part to light up flat;
	  * no 1000-part cache built at require: nothing exists before the first
	    bolt, and the frame loop disconnects itself when the last bolt is gone;
	  * a budget (MAX_BOLTS): past it the oldest bolt is dissipated, so a
	    Chidori held for seconds cannot pile up instances;
	  * each bolt is updated under pcall: a broken bolt is dropped, the frame
	    goes on (Effects must never stop drawing for an effect).
	The API stays the original's: LightningBolt.new(a0, a1, count), the same
	properties (CurveSize0/1, MinRadius/MaxRadius, Frequency, AnimationSpeed,
	Thickness, Min/MaxThicknessMultiplier, Min/MaxTransparency, PulseSpeed,
	PulseLength, FadeLength, Color = Color3 or ColorSequence), :Destroy(),
	:DestroyDissipate(time, strength). Attachments may be "fake" tables with
	WorldPosition and WorldAxis, as in the original. Added: GlowColor,
	GlowWidth (x Thickness), and LightningBolt.folder (where bolts are put).
]]
local LightningBolt={}
LightningBolt.__index=LightningBolt
LightningBolt.MAX_BOLTS=24
LightningBolt.folder=nil -- set by the user (Effects' FX folder); Terrain otherwise
LightningBolt.clock=os.clock -- (headless tests drive time)
local RunService=game:GetService("RunService")

local function CubicBezier(p,p0,p1,p2,p3)
	return p0*(1-p)^3+p1*3*p*(1-p)^2+p2*3*(1-p)*p^2+p3*p^3
end
-- See https://www.desmos.com/calculator/hg5h4fpfim (the original's pulse).
local function DiscretePulse(p,t,s,k,f,min,max)
	return math.clamp(k/(2*f)-math.abs((p-t*s+.5*k)/f),min,max)
end
local function ExtrudeCenter(p)
	return math.exp(-5000*(p-.5)^10)
end
local function NoiseBetween(x,y,z,min,max)
	return min+(max-min)*(math.noise(x,y,z)+.5)
end
LightningBolt.CubicBezier,LightningBolt.DiscretePulse,LightningBolt.ExtrudeCenter=CubicBezier,DiscretePulse,ExtrudeCenter
local offsetAngle=math.cos(math.rad(90))
local active={} -- the bolts alive, oldest first
local conn

local function seq(v) return NumberSequence.new(v) end
local function build(self,count)
	local anchor=Instance.new("Part")
	anchor.Name="LightningBolt";anchor.Anchored=true;anchor.CanCollide=false;anchor.CanQuery=false;anchor.CanTouch=false
	anchor.CastShadow=false;anchor.Transparency=1;anchor.Size=Vector3.new(.05,.05,.05);anchor.CFrame=CFrame.new()
	self._Atts={}
	self._Core={}
	self._Glow={}
	for i=0,count do
		local a=Instance.new("Attachment");a.Parent=anchor
		self._Atts[i]=a
	end
	for i=1,count do
		local core=Instance.new("Beam")
		core.Attachment0,core.Attachment1=self._Atts[i-1],self._Atts[i]
		core.FaceCamera=true;core.Segments=1;core.LightEmission=1;core.LightInfluence=0;core.Transparency=seq(1)
		core.Parent=anchor
		local glow=core:Clone();glow.Attachment0,glow.Attachment1=self._Atts[i-1],self._Atts[i];glow.Parent=anchor
		self._Core[i],self._Glow[i]=core,glow
	end
	anchor.Parent=LightningBolt.folder or workspace.Terrain
	self._Anchor=anchor
end

local step -- forward
function LightningBolt.new(Attachment0,Attachment1,PartCount)
	local self=setmetatable({},LightningBolt)
	PartCount=PartCount or 30
	self.Enabled=true
	self.Attachment0,self.Attachment1=Attachment0,Attachment1
	self.CurveSize0,self.CurveSize1=0,0
	self.MinRadius,self.MaxRadius=0,2.4
	self.Frequency=1
	self.AnimationSpeed=7
	self.Thickness=1
	self.MinThicknessMultiplier,self.MaxThicknessMultiplier=.2,1
	self.MinTransparency,self.MaxTransparency=0,1
	self.PulseSpeed=2
	self.PulseLength=1000000
	self.FadeLength=.2
	self.Color=Color3.new(1,1,1)
	self.ColorOffsetSpeed=3
	self.GlowColor=Color3.fromRGB(120,180,255)
	self.GlowWidth=3.2
	self.SpaceCurveFunction=CubicBezier
	self.OpacityProfileFunction=DiscretePulse
	self.RadialProfileFunction=ExtrudeCenter
	self._N=PartCount
	self._StartT=LightningBolt.clock()
	self._RanNum=math.random()*100
	build(self,PartCount)
	table.insert(active,self)
	while #active&gt;LightningBolt.MAX_BOLTS do
		local old=table.remove(active,1)
		old:_Free()
	end
	if not conn then conn=RunService.RenderStepped:Connect(function() step() end) end
	return self
end

function LightningBolt:_Free()
	self._Dead=true
	if self._Anchor then self._Anchor:Destroy();self._Anchor=nil end
end
function LightningBolt:Destroy()
	for i,b in active do if b==self then table.remove(active,i) break end end
	self:_Free()
end
-- Destroy after TimeLength seconds, the bolt thinning and spreading out.
function LightningBolt:DestroyDissipate(TimeLength,Strength)
	TimeLength=TimeLength or .2
	Strength=Strength or .5
	self._Dissipate={t0=LightningBolt.clock(),len=TimeLength,strength=Strength,
		start=self.MinTransparency,radius=self.MaxRadius,minRadius=self.MinRadius,minThick=self.MinThicknessMultiplier}
end

local function colorAt(self,p,t)
	if typeof(self.Color)=="Color3" then return self.Color end
	local t1=(self._RanNum+p-t*self.ColorOffsetSpeed)%1
	local kp=self.Color.Keypoints
	for i=1,#kp-1 do
		if kp[i].Time&lt;=t1 and t1&lt;=kp[i+1].Time then
			return kp[i].Value:Lerp(kp[i+1].Value,(t1-kp[i].Time)/math.max(1e-6,kp[i+1].Time-kp[i].Time))
		end
	end
	return kp[1].Value
end

local function update(self,now)
	local d=self._Dissipate
	if d then
		local k=(now-d.t0)/d.len
		if k&gt;=1 then return false end
		self.MinThicknessMultiplier=d.minThick+(-2-d.minThick)*k
		self.MinTransparency=d.start+(1-d.start)*k
		self.MaxRadius=d.radius*(1+d.strength*k)
		self.MinRadius=d.minRadius+(self.MaxRadius-d.minRadius)*k
	end
	local t=now-self._StartT
	if t&gt;=(self.PulseLength+1)/self.PulseSpeed then return false end
	local N=self._N
	if not self.Enabled then
		for i=1,N do self._Core[i].Transparency=seq(1);self._Glow[i].Transparency=seq(1) end
		return true
	end
	local a0,a1=self.Attachment0,self.Attachment1
	local p0,p3=a0.WorldPosition,a1.WorldPosition
	local p1,p2=p0+a0.WorldAxis*self.CurveSize0,p3-a1.WorldAxis*self.CurveSize1
	local spd,freq,ran=self.AnimationSpeed,self.Frequency,self._RanNum
	local minO,maxO=1-self.MaxTransparency,1-self.MinTransparency
	local prev=self.SpaceCurveFunction(0,p0,p1,p2,p3)
	local bez0=prev
	self._Atts[0].WorldPosition=prev
	for i=1,N do
		local p=i/N
		local input=(spd*-t)+freq*10*p-.2+ran*4
		local input2=5*((spd*.01*-t)/10+freq*p)+ran*4
		local noise0=NoiseBetween(5*input,1.5,5*.2*input2,0,.1*2*math.pi)+NoiseBetween(.5*input,1.5,.5*.2*input2,0,.9*2*math.pi)
		local noise1=NoiseBetween(3.4,input2,input,self.MinRadius,self.MaxRadius)*self.RadialProfileFunction(p)
		local thick=NoiseBetween(2.3,input2,input,self.MinThicknessMultiplier,self.MaxThicknessMultiplier)
		local bez1=self.SpaceCurveFunction(p,p0,p1,p2,p3)
		local nxt=bez1
		if i~=N and (bez1-bez0).Magnitude&gt;1e-4 then
			nxt=(CFrame.lookAt(bez0,bez1)*CFrame.Angles(0,0,noise0)
				*CFrame.Angles(math.acos(math.clamp(NoiseBetween(input2,input,2.7,offsetAngle,1),-1,1)),0,0)*CFrame.new(0,0,-noise1)).Position
		end
		self._Atts[i].WorldPosition=nxt
		local opacity=self.OpacityProfileFunction(p,t,self.PulseSpeed,self.PulseLength,self.FadeLength,minO,maxO)
		local w=math.max(0,self.Thickness*thick*opacity)
		local core,glow=self._Core[i],self._Glow[i]
		if w&lt;=0 or opacity&lt;=0 then
			core.Transparency=seq(1);glow.Transparency=seq(1)
		else
			core.Width0,core.Width1=w,w
			core.Color=ColorSequence.new(colorAt(self,p,t))
			core.Transparency=seq(1-opacity)
			glow.Width0,glow.Width1=w*self.GlowWidth,w*self.GlowWidth
			glow.Color=ColorSequence.new(self.GlowColor)
			glow.Transparency=seq(math.min(1,.55+.45*(1-opacity)))
		end
		prev,bez0=nxt,bez1
	end
	return true
end

step=function()
	local now=LightningBolt.clock()
	for i=#active,1,-1 do
		local b=active[i]
		local ok,alive=pcall(update,b,now)
		if not ok or not alive or b._Dead then
			table.remove(active,i)
			b:_Free()
		end
	end
	if #active==0 and conn then conn:Disconnect();conn=nil end
end
LightningBolt.step=step
function LightningBolt.count() return #active end

-- A fake attachment (the original's tip): a point and an axis.
function LightningBolt.point(position,axis)
	return {WorldPosition=position,WorldAxis=axis or Vector3.yAxis}
end

return LightningBolt
--[[
