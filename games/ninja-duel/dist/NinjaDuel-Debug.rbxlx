		end
	end,
	entry=function(fx,model,root,floor)
		burst(fx.folder,Vector3.new(root.Position.X,floor+.4,root.Position.Z),"dust",22,{Lifetime=range(.5,.8),Speed=range(16,24),SpreadAngle=Vector2.new(180,6),
			EmissionDirection=Enum.NormalId.Top,Drag=5,Color=ColorSequence.new(Color3.fromRGB(214,204,180)),LightInfluence=.7,Size=seq({{0,1.2},{1,3}}),
			Transparency=seq({{0,0},{1,1}}),Rotation=range(0,360)})
		burst(fx.folder,root.Position,"smoke",14,{Lifetime=range(.5,.8),Speed=range(8,14),SpreadAngle=Vector2.new(180,180),Drag=3,
			Color=ColorSequence.new(GATE_STEAM),LightEmission=.4,Size=seq({{0,1.5},{1,3.2}}),Transparency=seq({{0,.2},{1,1}}),Rotation=range(0,360)})
		burst(fx.folder,root.Position,"leaf",16,{Lifetime=range(.8,1.3),Speed=range(10,18),SpreadAngle=Vector2.new(180,40),Acceleration=Vector3.new(0,-8,0),
			LightInfluence=.6,Size=range(.4,.6),Rotation=range(0,360),RotSpeed=range(-300,300)})
	end,
	light=Color3.fromRGB(120,230,140),
}

-- Neji: the chakra burns in both palms (the Gentle Fist ready), and the full
-- field sweeps the floor around him, a pulse every 1.3 s.
local HYUGA=Color3.fromRGB(200,218,255)
R.GentleFist={
	hold=function(model,st)
		st.pulseAt=AwakenFX.clock()+.4
		return eachLimb(model,{"LeftHand","RightHand"},function(p)
			local a=surface(p,"smoke",{Rate=14,Lifetime=range(.25,.4),Speed=range(1,2.2),EmissionDirection=Enum.NormalId.Top,Acceleration=Vector3.new(0,5,0),
				Color=ColorSequence.new(HYUGA),LightEmission=.7,Size=seq({{0,.35},{.5,.7},{1,.2}}),Transparency=seq({{0,.15},{1,1}}),Rotation=range(0,360)})
			local b=emitter(p,"glow",{Rate=8,Lifetime=range(.12,.18),Speed=range(0),Color=ColorSequence.new(HYUGA),LightEmission=1,
				Size=seq({{0,1.1},{1,.8}}),Transparency=seq({{0,.35},{1,1}})})
			return {a,b}
		end)
	end,
	step=function(model,actor,st,dt,fx)
		local now=AwakenFX.clock()
		if now&lt;(st.pulseAt or 0) then return end
		st.pulseAt=now+1.3
		local root=model:FindFirstChild("HumanoidRootPart")
		if root then floorSprite(fx.folder,Vector3.new(root.Position.X,floorY(fx,root),root.Position.Z),"ring",HYUGA,2,22,.75,.45) end
	end,
	entry=function(fx,model,root,floor)
		floorSprite(fx.folder,Vector3.new(root.Position.X,floor,root.Position.Z),"ring",HYUGA,2,28,.5,.05)
		burst(fx.folder,root.Position,"glow",1,{Lifetime=range(.18),Speed=range(0),Color=ColorSequence.new(HYUGA),LightEmission=1,Size=seq({{0,3},{1,8}}),Transparency=seq({{0,.2},{1,1}})})
	end,
	light=Color3.fromRGB(190,210,255),
}

-- Itachi: feathers come off his shoulders and fall; a red mist lies at his feet.
local MIST=Color3.fromRGB(96,10,20)
R.Mirage={
	hold=function(model)
		local out=eachLimb(model,{"UpperTorso","LeftUpperArm","RightUpperArm"},function(p)
			return surface(p,"feather",{Rate=2.5,Lifetime=range(1.2,1.8),Speed=range(1,2.5),EmissionDirection=Enum.NormalId.Top,SpreadAngle=Vector2.new(80,80),
				Acceleration=Vector3.new(0,-2.2,0),Drag=1,Color=ColorSequence.new(Color3.fromRGB(200,200,215)),LightInfluence=.7,
				Size=range(.45,.7),Transparency=seq({{0,0},{.8,0},{1,1}}),Rotation=range(0,360),RotSpeed=range(-120,120)})
		end)
		local root=model:FindFirstChild("HumanoidRootPart")
		if root then
			local a=attach(root,"RedMist",Vector3.new(0,-2.6,0))
			emitter(a,"smoke",{Rate=7,Lifetime=range(.9,1.4),Speed=range(1,2.4),SpreadAngle=Vector2.new(180,4),EmissionDirection=Enum.NormalId.Top,Drag=1.5,
				Color=ColorSequence.new(MIST),LightEmission=.05,Size=seq({{0,1.2},{1,3.4}}),Transparency=seq({{0,.45},{.5,.6},{1,1}}),Rotation=range(0,360),RotSpeed=range(-30,30)})
			table.insert(out,a)
		end
		return out
	end,
	entry=function(fx,model,root,floor)
		burst(fx.folder,root.Position+Vector3.new(0,.6,0),"feather",34,{Lifetime=range(.9,1.5),Speed=range(8,16),SpreadAngle=Vector2.new(180,180),Drag=3,
			Acceleration=Vector3.new(0,-3,0),Color=ColorSequence.new(Color3.fromRGB(200,200,215)),LightInfluence=.7,Size=range(.6,.9),Rotation=range(0,360),RotSpeed=range(-300,300)})
		floorSprite(fx.folder,Vector3.new(root.Position.X,floor,root.Position.Z),"ring",Color3.fromRGB(200,30,40),3,14,.45,.2)
	end,
	light=Color3.fromRGB(230,40,50),
}

-- Kakashi: the lightning lives in his hand while the eye is uncovered.
local BOLT=Color3.fromRGB(176,214,255)
R.Copycat={
	hold=function(model)
		local out=eachLimb(model,{"RightHand","RightLowerArm"},function(p,name)
			return surface(p,"lightning",{Rate=if name=="RightHand" then 10 else 4,Lifetime=range(.08,.14),Speed=range(.5,2),SpreadAngle=Vector2.new(180,180),
				Color=ColorSequence.new(BOLT),LightEmission=1,Size=seq({{0,.9},{1,.6}}),Transparency=seq({{0,0},{1,.4}}),Rotation=range(0,360)})
		end)
		local torso=model:FindFirstChild("UpperTorso")
		if torso then
			table.insert(out,surface(torso,"lightning",{Rate=2.5,Lifetime=range(.06,.1),Speed=range(.2),Color=ColorSequence.new(BOLT),LightEmission=1,
				Size=range(1.1,1.6),Transparency=range(.1),Rotation=range(0,360)}))
		end
		return out
	end,
	entry=function(fx,model,root,floor)
		burst(fx.folder,root.Position,"lightning",12,{Lifetime=range(.1,.2),Speed=range(10,20),SpreadAngle=Vector2.new(180,180),Color=ColorSequence.new(BOLT),
			LightEmission=1,Size=range(2,3),Rotation=range(0,360)})
		floorSprite(fx.folder,Vector3.new(root.Position.X,floor,root.Position.Z),"ring",Color3.fromRGB(226,40,50),3,14,.4,.2)
	end,
	light=Color3.fromRGB(176,214,255),
}

-- Minato: golden sparks are torn off him as he moves (more the faster he
-- goes); the formula opens under him at the entry.
local FLASH=Color3.fromRGB(255,222,120)
R.Flashstep={
	hold=function(model,st)
		st.sparks=eachLimb(model,{"UpperTorso","LowerTorso","LeftUpperLeg","RightUpperLeg","Head"},function(p)
			return surface(p,"spark",{Rate=2,Lifetime=range(.18,.3),Speed=range(.5,1.5),Orientation=Enum.ParticleOrientation.VelocityParallel,
				SpreadAngle=Vector2.new(30,30),EmissionDirection=Enum.NormalId.Back,Color=ColorSequence.new(FLASH),LightEmission=.8,
				Size=seq({{0,.6},{1,.1}}),Transparency=seq({{0,.05},{1,1}})})
		end)
		return table.clone(st.sparks)
	end,
	step=function(model,actor,st)
		local speed=actor.speed or 0
		local rate=2+math.clamp(speed/45,0,1)*22
		for _,e in st.sparks or {} do e.Rate=rate end
	end,
	entry=function(fx,model,root,floor)
		floorSprite(fx.folder,Vector3.new(root.Position.X,floor,root.Position.Z),"glyph",FLASH,2,9,.7,.05)
		burst(fx.folder,root.Position,"spark",26,{Lifetime=range(.2,.35),Speed=range(20,36),SpreadAngle=Vector2.new(180,180),
			Orientation=Enum.ParticleOrientation.VelocityParallel,Color=ColorSequence.new(FLASH),LightEmission=.9,Size=seq({{0,1.2},{1,.2}}),Transparency=seq({{0,0},{1,1}})})
	end,
	light=Color3.fromRGB(255,214,92),
}

-- ------------------------------------------------------------------ per frame
local function stateOf(fx,model)
	fx.awakenState=fx.awakenState or setmetatable({},{__mode="k"})
	local st=fx.awakenState[model]
	if not st then st={};fx.awakenState[model]=st end
	return st
end
local function clear(st,fade)
	for _,item in st.items or {} do
		if typeof(item)=="Instance" and item.Parent then
			if item:IsA("ParticleEmitter") then item.Enabled=false;Debris:AddItem(item,fade and 1.5 or 0)
			else
				for _,d in item:GetDescendants() do if d:IsA("ParticleEmitter") then d.Enabled=false end end
				Debris:AddItem(item,fade and 1.5 or 0)
			end
		elseif type(item)=="table" then
			for _,sub in item do if typeof(sub)=="Instance" and sub:IsA("ParticleEmitter") then sub.Enabled=false;Debris:AddItem(sub,fade and 1.5 or 0) end end
		end
	end
	st.items=nil;st.open=nil;st.orbit=nil;st.steam=nil;st.sparks=nil
end
-- (Studio 08/11) a duel restarted while awake left the old state's records on
-- the reused model: the next awakening drew nothing. A held state whose
-- instances have left the body is rebuilt.
local function alive(st)
	for _,item in st.items or {} do
		if typeof(item)=="Instance" then return item.Parent~=nil end
		if type(item)=="table" and typeof(item[1])=="Instance" then return item[1].Parent~=nil end
	end
	return st.items~=nil
end
local function fighter(fx,model,actor,dt)
	if not AwakenFX.enabled or not model or not actor then return end
	local recipe=R[actor.fighterId or ""]
	if not recipe then return end
	local st=stateOf(fx,model)
	local open=(actor.awaken or 0)&gt;0 and (actor.health or 1)&gt;0
	if open and not (st.open and alive(st)) then
		if st.items then clear(st,false) end
		st.open=true
		st.items=recipe.hold(model,st) or {}
		local root=model:FindFirstChild("HumanoidRootPart")
		local torso=model:FindFirstChild("UpperTorso")
		-- (Studio 08/11) at a low graphics quality Roblox thins the particles
		-- out (Automatic on a busy machine: the eight awakenings looked
		-- empty). The light is not thinned: it carries the colour there. (No
		-- Highlight: the body's ink line is one already, a second would hide it.)
		if recipe.light and torso then
			local light=Instance.new("PointLight")
			light.Name="AwakenLight";light.Color=recipe.light;light.Brightness=2;light.Range=12;light.Shadows=false;light.Parent=torso
			table.insert(st.items,light)
		end
		-- The entry plays once per awakening (not on a rebuild late in the state).
		local wakes=actor.events and actor.events.Awaken or 0
		if root and recipe.entry and st.wakes~=wakes then
			st.wakes=wakes
			pcall(function() recipe.entry(fx,model,root,floorY(fx,root)) end)
		end
		-- The shared mantle (Effects) is replaced by this layer's own.
		local aura=fx.auras and fx.auras[model]
		if aura and aura.mantle and aura.mantle.emitter then aura.mantle.emitter.Enabled=false;aura.mantle.light.Brightness=0 end -- (the light budget owns Enabled)
	elseif not open and st.open then
		clear(st,true)
	end
	if st.open and recipe.step then recipe.step(model,actor,st,dt,fx) end
end
AwakenFX.fighter=fighter

-- (Studio 08/11) a fault here must never stop Effects' frame (every layer
-- after this one, and the next frames): it is caught, reported once, and the
-- state that failed is not rebuilt every frame.
local reported=false
local function safe(fx,model,actor,dt)
	local ok,err=pcall(fighter,fx,model,actor,dt)
	if not ok then
		if model and fx.awakenState and fx.awakenState[model] then local st=fx.awakenState[model];st.open=true;st.items=st.items or {} end
		if not reported then reported=true;warn("[AwakenFX] "..tostring(err)) end
	end
end
-- (OUTILLEUR, F7, 08/11) Four of these images came out empty the first
-- times: Roblox answered "Asset content representation is being generated"
-- and only served them seconds later. They are fetched as soon as the client
-- starts (the menu, the intro), not the first time an awakening opens.
function AwakenFX.preloadList()
	local list={}
	for _,id in ID do if string.sub(id,1,13)=="rbxassetid://" then table.insert(list,id) end end
	table.sort(list)
	return list
end
function AwakenFX.preload(provider)
	provider=provider or game:GetService("ContentProvider")
	local failed={}
	local ok=pcall(function()
		provider:PreloadAsync(AwakenFX.preloadList(),function(id,status)
			if status~=Enum.AssetFetchStatus.Success then table.insert(failed,id) end
		end)
	end)
	-- One more pass for the ones still being generated on Roblox's side.
	if ok and #failed&gt;0 then
		task.wait(3)
		local still={}
		pcall(function() provider:PreloadAsync(failed,function(id,status)
			if status~=Enum.AssetFetchStatus.Success then table.insert(still,id) end
		end) end)
		failed=still
		for _,id in still do AwakenFX.failed[id]=true end
		if #still&gt;0 then warn("[AwakenFX] images Roblox does not serve, built-in stand-ins used: "..table.concat(still," ")) end
	end
	return failed
end
function AwakenFX.install(FX,kit)
	K=kit
	table.insert(FX.layers,{name="Awaken",fighter=safe})
	task.spawn(AwakenFX.preload)
end
return AwakenFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND194">
          <Properties>
            <string name="Name">BodyViews</string>
            <ProtectedString name="Source">-- Bodies that are not fighters (Server/Bodies: Naruto's shadow clones), drawn
-- from the snapshot's `bodies`. A clone is a copy of its owner's own model
-- (rig and costume, so it looks exactly like him), anchored at its root,
-- carried on a smoothed track of the server positions and posed by the motion
-- engine like a fighter (its run, its jab, its side of a carried route, the
-- Rasengan it shapes). Copies are pooled per owner model; the puffs of smoke
-- come from the contact feed (Client/NarutoFX). Presentation only.
local Motion=require(script.Parent.VelmoraMotionEngine)
-- (06/11) Kakashi's ninken are dogs, not copies of him (Client/HoundFX).
local HoundFX=require(script.Parent.HoundFX)
local BodyViews={};BodyViews.__index=BodyViews
BodyViews.clock=os.clock -- (headless tests drive time)
-- A body never lags its server position by more than this before it snaps.
local SNAP=12
-- (06/11) Copies kept per owner: Naruto's crowd is ten at once. A fighter
-- whose kit makes a crowd (Fighters[id].Bodies.clone.Crowd) has its copies
-- made ahead, one a frame, so the crowd does not stall the frame it appears.
BodyViews.POOL=12
local Fighters=nil
local function crowdSize(fighterId)
	if not Fighters then
		local ok,mod=pcall(function() return require(game:GetService("ReplicatedStorage").NinjaDuel.Fighters) end)
		Fighters=if ok then mod else {}
	end
	local def=Fighters[fighterId or ""]
	local tune=def and def.Bodies and def.Bodies.clone
	return tune and tune.Crowd or 0
end
function BodyViews.new()
	local folder=Instance.new("Folder");folder.Name="NinjaDuelBodies";folder.Parent=workspace
	return setmetatable({folder=folder,views={},pools={},epoch=nil},BodyViews)
end
-- A copy of `source` that can be posed but never collides, never blocks the
-- camera, carries no Humanoid, script, sound, light or held weapon.
function BodyViews.copy(source)
	local archivable=source.Archivable
	source.Archivable=true
	local ok,copy=pcall(function() return source:Clone() end)
	source.Archivable=archivable
	if not ok or not copy then return nil end
	copy.Name="ShadowClone"
	for _,d in copy:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide=false;d.CanQuery=false;d.CanTouch=false;d.Massless=true;d.Anchored=false
			d.LocalTransparencyModifier=0
			-- The quiet tell (the deception is where blows come from, not which
			-- body is real): a chakra copy casts no shadow, the real one does.
			d.CastShadow=false
		elseif d:IsA("Humanoid") or d:IsA("Sound") or d:IsA("BaseScript") or d:IsA("Highlight") or d:IsA("ParticleEmitter")
			or d:IsA("Trail") or d:IsA("Light") or d:IsA("Beam") then
			d:Destroy()
		elseif d:IsA("Model") and d.Parent and d.Parent:IsA("BasePart") then
			-- A weapon held in a hand (Motion.weapon) stays with its owner.
			d:Destroy()
		end
	end
	local root=copy:FindFirstChild("HumanoidRootPart")
	if not root then copy:Destroy();return nil end
	root.Anchored=true;copy.PrimaryPart=root
	-- (Audit 04/11) a copy made in the Nine-Tails cloak kept its red slit eyes
	-- (and a blink) for the rest of the round: the copy's face starts calm.
	pcall(function()
		local Face=require(game:GetService("ReplicatedStorage").NinjaDuel.Face)
		local face=Face.find(copy)
		if face then Face.tint(face,nil);Face.set(face,"calm") end
		for _,d in copy:GetDescendants() do
			if d.Name=="Iris" and d:IsA("BasePart") then
				local color,material=d:GetAttribute("NDIrisColor"),d:GetAttribute("NDIrisMaterial")
				if typeof(color)=="Color3" then d.Color=color end
				if type(material)=="string" and Enum.Material[material] then d.Material=Enum.Material[material] end
			end
		end
	end)
	return copy
end
function BodyViews:take(owner)
	local pool=self.pools[owner]
	local model=pool and table.remove(pool)
	if not model then model=BodyViews.copy(owner) end
	if not model then return nil end
	Motion.reset(model)
	model.Parent=self.folder
	return model
end
function BodyViews:release(view)
	local model=view.model
	if view.hound then model:Destroy();return end
	model.Parent=nil
	if view.fadeSet and view.fadeSet~=0 then for _,part in view.parts or BodyViews.parts(model) do part.LocalTransparencyModifier=0 end end
	local pool=self.pools[view.owner] or {}
	self.pools[view.owner]=pool
	if #pool&lt;BodyViews.POOL then table.insert(pool,model) else model:Destroy() end
end
function BodyViews:reset()
	for id,view in self.views do view.model:Destroy();self.views[id]=nil end
	for owner,pool in self.pools do for _,model in pool do model:Destroy() end;self.pools[owner]=nil end
end
local function flat(v) return Vector3.new(v.X,0,v.Z) end
-- One body this frame: the track, then the pose.
function BodyViews:step(view,entry,dt)
	local now=BodyViews.clock()
	if view.entry~=entry then
		view.entry=entry;view.seenAt=now
		-- A flicker across the stage (Bodies.warp) snaps instead of sliding.
		if entry.warp~=view.warp then view.warp=entry.warp;view.pos=entry.position end
	end
	local velocity=entry.velocity or Vector3.zero
	-- A short lead only: a clone dashing to its strike (90 studs/s) stops dead,
	-- and a long extrapolation would carry it past the spot between packets.
	local ahead=entry.position+velocity*math.min(.05,now-(view.seenAt or now))
	if (ahead-view.pos).Magnitude&gt;SNAP then view.pos=ahead
	else view.pos=view.pos:Lerp(ahead,1-math.exp(-18*math.max(dt,1/240))) end
	local look=flat(entry.look or Vector3.new(0,0,-1))
	look=if look.Magnitude&gt;.05 then look.Unit else Vector3.new(0,0,-1)
	local drawn=view.look or look
	drawn=drawn:Lerp(look,1-math.exp(-14*math.max(dt,1/240)))
	view.look=if drawn.Magnitude&gt;.05 then drawn.Unit else look
	if view.hound then HoundFX.pose(view,entry,dt);return end
	view.model:PivotTo(CFrame.lookAt(view.pos,view.pos+view.look))
	-- Its own clock: an action animates from the frame it was first seen.
	local clock=view.clock
	local serial=entry.actionSerial or 0
	if serial~=clock.serial then clock.serial=serial;clock.at=now-math.clamp(entry.actionElapsed or 0,0,.12) end
	if entry.cast~=clock.cast then clock.cast=entry.cast;clock.castAt=now end
	local acting=entry.action~=nil and (entry.state=="Startup" or entry.state=="Active" or entry.state=="Recovery")
	local visual={fighterId=entry.fighterId,health=1,airborne=entry.airborne==true,velocity=velocity,speed=flat(velocity).Magnitude,
		state=if acting then entry.state elseif entry.cast then "TechniqueChannel" else "Neutral",
		attackName=if acting then entry.action else nil,attackVariant=if acting then entry.variant else nil,attackSerial=serial,
		castId=if acting then nil else entry.cast,castElapsed=now-(clock.castAt or now)}
	view.phase=Motion.present(view.model,visual,{attackElapsed=if acting then now-clock.at else 0,reactionElapsed=0},dt)
	self:fade(view,dt)
end
-- (06/11) A crowd round the opponent stands between the lens and the player's
-- own body: a clone in that line, or right against the lens, fades to a ghost
-- (as an obstacle near the camera would) so the player still sees himself
-- and the fight.
BodyViews.FADE=.7
function BodyViews:fade(view,dt)
	local camera=workspace.CurrentCamera
	local me=self.focus
	local want=0
	if camera and me then
		local lens=camera.CFrame.Position
		local root=view.model.PrimaryPart
		local p=if root then root.Position else view.pos
		local line=me-lens
		local length=line.Magnitude
		if length&gt;.5 then
			local along=(p-lens):Dot(line/length)
			local off=((p-lens)-line/length*along).Magnitude
			if (along&gt;0 and along&lt;length-1 and off&lt;2.6) or (p-lens).Magnitude&lt;4 then want=BodyViews.FADE end
		end
	end
	local now=view.fadeNow or 0
	now+=(want-now)*(1-math.exp(-14*math.max(dt,1/240)))
	if want==0 and now&lt;.02 then now=0 end
	view.fadeNow=now
	local set=view.fadeSet or 0
	if math.abs(now-set)&lt;.02 and not (now==0 and set~=0) then return end
	view.fadeSet=now
	view.parts=view.parts or BodyViews.parts(view.model)
	for _,part in view.parts do part.LocalTransparencyModifier=now end
end
function BodyViews.parts(model)
	local list={}
	for _,d in model:GetDescendants() do if d:IsA("BasePart") then table.insert(list,d) end end
	return list
end
-- A puppet (Sasori's marionette) is a copy of its owner turned to wood: the
-- body parts lacquered brown, the costume and hair hidden, a pale mask, and
-- glowing chakra threads from the owner's fingers to its wrists.
local BODY={Head=true,UpperTorso=true,LowerTorso=true,LeftUpperArm=true,RightUpperArm=true,LeftLowerArm=true,RightLowerArm=true,
	LeftHand=true,RightHand=true,LeftUpperLeg=true,RightUpperLeg=true,LeftLowerLeg=true,RightLowerLeg=true,LeftFoot=true,RightFoot=true}
function BodyViews.puppetize(model,owner)
	if model:GetAttribute("Puppet") then return end
	model:SetAttribute("Puppet",true)
	model.Name="Puppet"
	for _,d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Name~="HumanoidRootPart" then
			if BODY[d.Name] then d.Color=Color3.fromRGB(150,110,74);d.Material=Enum.Material.Wood
			else d.Transparency=1 end
		elseif d:IsA("Decal") then d.Transparency=1 end
	end
	local head=model:FindFirstChild("Head")
	if head then
		local mask=Instance.new("Part");mask.Name="PuppetMask";mask.Size=Vector3.new(1.1,1.2,.1);mask.Color=Color3.fromRGB(236,226,206)
		mask.CanCollide=false;mask.CanQuery=false;mask.Massless=true;mask.CFrame=head.CFrame*CFrame.new(0,0,-.62);mask.Parent=model
		local weld=Instance.new("WeldConstraint");weld.Part0=head;weld.Part1=mask;weld.Parent=mask
	end
	-- Threads: owner's hands to the puppet's wrists.
	for _,side in {"Left","Right"} do
		local from=owner:FindFirstChild(side.."Hand");local to=model:FindFirstChild(side.."Hand")
		if from and to then
			local a0=Instance.new("Attachment");a0.Name="PuppetThread";a0.Parent=from
			local a1=Instance.new("Attachment");a1.Parent=to
			local beam=Instance.new("Beam");beam.Attachment0=a0;beam.Attachment1=a1;beam.Width0=.06;beam.Width1=.06
			beam.Color=ColorSequence.new(Color3.fromRGB(140,200,255));beam.LightEmission=1;beam.Transparency=NumberSequence.new(.35);beam.FaceCamera=true
			beam.Parent=to
		end
	end
end
-- Every frame (Presentation:update): draw the live bodies, put away the rest.
function BodyViews:update(data,dt,folder)
	if not data or data.phase~="Duel" then
		for id,view in self.views do self:release(view);self.views[id]=nil end
		return
	end
	if data.epoch~=self.epoch then self:reset();self.epoch=data.epoch end
	-- The player's own body (what the lens must keep in sight).
	local mine=data.human and folder and folder:FindFirstChild(data.human.id or "")
	local mineRoot=mine and mine:FindFirstChild("HumanoidRootPart")
	self.focus=if mineRoot then mineRoot.Position else nil
	-- Copies made ahead for a crowd (one a frame, out of the workspace).
	for _,actor in {data.human,data.bot} do
		local want=actor and crowdSize(actor.fighterId) or 0
		local owner=want&gt;0 and folder and folder:FindFirstChild(actor.id or "")
		if owner then
			local pool=self.pools[owner] or {}
			self.pools[owner]=pool
			local live=0
			for _,view in self.views do if view.owner==owner then live+=1 end end
			if #pool+live&lt;math.min(want,BodyViews.POOL) then
				local model=BodyViews.copy(owner)
				if model then model.Parent=nil;table.insert(pool,model) end
			end
		end
	end
	local live={}
	for _,entry in data.bodies or {} do
		live[entry.id]=true
		local view=self.views[entry.id]
		if not view and entry.kind=="hound" then
			local model,rig=HoundFX.build(entry.slot or entry.id)
			model.Parent=self.folder
			view={model=model,rig=rig,hound=true,pos=entry.position,look=nil,warp=entry.warp,clock={}}
			self.views[entry.id]=view
		end
		if not view then
			local owner=folder and folder:FindFirstChild(entry.owner or "")
			local model=owner and self:take(owner)
			if model and entry.kind=="puppet" then BodyViews.puppetize(model,owner) end
			if model then
				view={model=model,owner=owner,pos=entry.position,look=nil,warp=entry.warp,clock={}}
				self.views[entry.id]=view
			end
		end
		if view then self:step(view,entry,dt) end
	end
	for id,view in self.views do
		if not live[id] then self:release(view);self.views[id]=nil end
	end
end
return BodyViews
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND195">
          <Properties>
            <string name="Name">ByakuganFX</string>
            <ProtectedString name="Source">-- (06/11, « nous, pour le Byakugan, on voit des 1, 2, 3 pop sur le truc,
-- c'est super moche ; lui, on voit vraiment les vaisseaux du chakra ») The
-- Byakugan's sight, drawn for the eyes that have it (Shared/Sight decides
-- when: Neji's Perception, a Byakugan awakening).
--
-- The world loses some of its colour and the opponent's body turns to glass:
-- inside it, his chakra network (two veins along the spine, each arm and each
-- leg, dotted with beads), chakra pulsing along it from the core outward.
-- What it tells:
--   how much chakra he has   the veins burn bright and the pulses run fast
--                            when he is full; they dim and slow as he empties;
--   the points closed in it  Neji's eight points are nodes on the network: a
--                            closed one goes dark and so does the channel it
--                            feeds (the arm behind a shoulder, the leg behind
--                            a hip, the spine behind the heart);
--   a jutsu coming           while he moulds chakra (seals, a channel, a
--                            loaded strike) the network flares and the pulses
--                            rush into the hands;
--   where he is              his outline shows through walls and trees;
--   what is real             a clone or an image has no network: only the
--                            real body lights up.
-- Only the opponent's body is read (data.bot). In Studio, workspace attribute
-- NDSight = "byakugan" opens it for filming.
local RunService=game:GetService("RunService")
local TweenService=game:GetService("TweenService")
local Sight=require(game:GetService("ReplicatedStorage").NinjaDuel.Sight)

local ByakuganFX={}
local K,FX

local VEIN=Color3.fromRGB(40,110,255)
local VEIN_CORE=Color3.fromRGB(150,205,255)
local VEIN_BRIGHT=Color3.fromRGB(80,160,255)
local DOTS=10
local CLOSED=Color3.fromRGB(16,20,36)
local PULSES=16

-- The network: chains of nodes, each node a part of the rig and a point on
-- it (in fractions of the part's size; -Z is the front). Chakra runs from the
-- first node of a chain to its last.
local CHAINS={
	spine={{"LowerTorso",0,-.4,0},{"LowerTorso",0,.42,-.1},{"UpperTorso",0,-.42,-.15},{"UpperTorso",-.08,.1,-.3},{"UpperTorso",0,.46,-.1},{"Head",0,-.42,0},{"Head",0,.1,-.1}},
	armL={{"UpperTorso",-.42,.36,0},{"LeftUpperArm",0,.42,0},{"LeftUpperArm",0,-.42,0},{"LeftLowerArm",0,.42,0},{"LeftLowerArm",0,-.42,0},{"LeftHand",0,-.1,0}},
	armR={{"UpperTorso",.42,.36,0},{"RightUpperArm",0,.42,0},{"RightUpperArm",0,-.42,0},{"RightLowerArm",0,.42,0},{"RightLowerArm",0,-.42,0},{"RightHand",0,-.1,0}},
	legL={{"LowerTorso",-.26,-.36,0},{"LeftUpperLeg",0,.42,0},{"LeftUpperLeg",0,-.42,0},{"LeftLowerLeg",0,.42,0},{"LeftLowerLeg",0,-.42,0},{"LeftFoot",0,0,-.25}},
	legR={{"LowerTorso",.26,-.36,0},{"RightUpperLeg",0,.42,0},{"RightUpperLeg",0,-.42,0},{"RightLowerLeg",0,.42,0},{"RightLowerLeg",0,-.42,0},{"RightFoot",0,0,-.25}},
}
-- Which channel each of Neji's points (FX.TENKETSU) feeds.
local FEEDS={throat="spine",heart="spine",solar="spine",navel="spine",leftShoulder="armL",rightShoulder="armR",leftHip="legL",rightHip="legR"}

local S=nil

local function forced()
	if not RunService:IsStudio() then return nil end
	local value=workspace:GetAttribute("NDSight")
	return if type(value)=="string" and value~="" then value else nil
end

-- --------------------------------------------------------------- the world
local function grade(on)
	local ok,Lighting=pcall(function() return game:GetService("Lighting") end)
	if not ok or not Lighting then return end
	local cc=Lighting:FindFirstChild("ByakuganSight")
	if on and not cc then
		cc=Instance.new("ColorCorrectionEffect");cc.Name="ByakuganSight";cc.Parent=Lighting
	end
	if not cc then return end
	-- A quarter of the colour out of the world (the grade tints the veins too:
	-- more would turn them grey), a cool cast, a touch darker.
	local goal=if on then {Saturation=-.25,Contrast=.1,Brightness=-.05,TintColor=Color3.fromRGB(226,232,255)} else {Saturation=0,Contrast=0,Brightness=0,TintColor=Color3.new(1,1,1)}
	TweenService:Create(cc,TweenInfo.new(if on then .25 else .35),goal):Play()
	if not on then task.delay(.4,function() if cc.Parent and cc.Saturation&gt;-.05 then cc:Destroy() end end) end
end

-- ----------------------------------------------------------- the network
local function build(fx,model)
	local holder=Instance.new("Folder");holder.Name="ByakuganNetwork";holder.Parent=fx.folder
	local net={holder=holder,chains={},beams={},nodes={},pulses={},attachments={}}
	for name,chain in CHAINS do
		local list={}
		for i,spec in chain do
			local part=model:FindFirstChild(spec[1])
			if not part or not part:IsA("BasePart") then list=nil;break end
			local size=part.Size
			local main=Instance.new("Attachment");main.Name="ChakraNode";main.Position=Vector3.new(spec[2]*size.X,spec[3]*size.Y,spec[4]*size.Z);main.Parent=part
			-- A second vein beside the first (the network is a mesh, not a wire).
			local side=Instance.new("Attachment");side.Name="ChakraNode";side.Position=main.Position+Vector3.new(.14,0,.1);side.Parent=part
			table.insert(net.attachments,main);table.insert(net.attachments,side)
			list[i]={main=main,side=side}
		end
		if list then
			net.chains[name]=list
			local beams={}
			for i=1,#list-1 do
				for k,key in {"main","side"} do
					local beam=Instance.new("Beam")
					beam.Attachment0=list[i][key];beam.Attachment1=list[i+1][key]
					beam.FaceCamera=true;beam.Segments=8;beam.LightEmission=.5;beam.LightInfluence=0
					beam.Width0=if k==1 then .17 else .1;beam.Width1=beam.Width0
					beam.CurveSize0=(if k==1 then .18 else -.22)*(if i%2==0 then 1 else -1);beam.CurveSize1=-beam.CurveSize0*.6
					beam.Color=ColorSequence.new(VEIN);beam.Transparency=NumberSequence.new(.2)
					beam.Parent=holder
					table.insert(beams,{beam=beam,main=k==1})
				end
			end
			net.beams[name]=beams
		end
	end
	-- Neji's eight points, as nodes of the network.
	for id in FX.TENKETSU do
		local node=K.block(holder,Vector3.one*.24,CFrame.new(),VEIN_CORE,Enum.Material.Neon)
		node.Shape=Enum.PartType.Ball;node.Name="Tenketsu";node.Transparency=1
		net.nodes[id]=node
	end
	-- The dotted look of a network seen through the skin: small beads along
	-- every channel, fixed on the body.
	net.dots={}
	for name in net.chains do
		for k=1,DOTS do
			local d=K.block(holder,Vector3.one*.13,CFrame.new(),VEIN,Enum.Material.Neon)
			d.Shape=Enum.PartType.Ball;d.Name="ChakraDot";d.Transparency=1
			table.insert(net.dots,{part=d,chain=name,along=(k-.5)/DOTS})
		end
	end
	for i=1,PULSES do
		local p=K.block(holder,Vector3.one*.22,CFrame.new(),VEIN_CORE,Enum.Material.Neon)
		p.Shape=Enum.PartType.Ball;p.Name="ChakraPulse";p.Transparency=1
		local names={"spine","armL","armR","legL","legR"}
		net.pulses[i]={part=p,chain=names[(i-1)%#names+1],along=(i*.37)%1}
	end
	-- His outline through walls and trees.
	local outline=Instance.new("Highlight");outline.Name="ByakuganOutline";outline.Adornee=model
	outline.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop;outline.FillColor=VEIN;outline.FillTransparency=1
	-- (An always-on-top fill would wash out the veins inside the body.)
	outline.OutlineColor=VEIN_CORE;outline.OutlineTransparency=.15;outline.Parent=holder
	net.outline=outline
	-- The body itself turns to glass: the network runs inside it, and an
	-- opaque body would hide it.
	net.glass={}
	for _,d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Name~="HumanoidRootPart" and d.Transparency&lt;.9 then table.insert(net.glass,d) end
	end
	return net
end

-- A point along a chain (0 = its first node, 1 = its last), on the bodies'
-- current pose.
local function world(a) return a.Parent.CFrame*a.Position end
local function along(chain,t)
	local count=#chain
	local x=math.clamp(t,0,1)*(count-1)
	local i=math.min(count-1,math.floor(x)+1)
	local f=x-(i-1)
	return world(chain[i].main):Lerp(world(chain[i+1].main),f)
end
local function move(parts,cfs)
	if #parts==0 then return end
	if workspace.BulkMoveTo then workspace:BulkMoveTo(parts,cfs,Enum.BulkMoveMode.FireCFrameChanged)
	else for i,p in parts do p.CFrame=cfs[i] end end
end

local function release()
	if not S then return end
	if S.net then
		S.net.holder:Destroy()
		for _,a in S.net.attachments do a:Destroy() end
	end
	for dot in S.dots or {} do if dot.Parent then dot.LocalTransparencyModifier=0 end end
	for _,part in (S.net and S.net.glass) or {} do if part.Parent then part.LocalTransparencyModifier=0 end end
	if S.graded then grade(false) end
	S=nil
end

local function draw(fx,actor,dt)
	local net=S.net
	local chakra=math.clamp((actor.chakra or 0)/math.max(1,actor.maxChakra or 100),0,1)
	local moulding=actor.state=="TechniqueChannel" or actor.sealing~=nil or actor.chakraLoad~=nil or actor.infused~=nil
	-- Closed points: which channels they cut.
	local closed,cut={},{}
	for _,id in actor.tenketsuPoints or {} do closed[id]=true;cut[FEEDS[id] or ""]=true end
	local severe=actor.tenketsuSevere==true
	local base=.05+(1-chakra)*.5
	local flare=if moulding then 1.6 else 1
	local t=os.clock()
	for name,beams in net.beams do
		local dead=cut[name] or severe
		for _,entry in beams do
			local beam=entry.beam
			local flicker=.06*math.sin(t*9+(beam.CurveSize0*20))
			beam.Transparency=NumberSequence.new(math.clamp((if dead then .8 else base)+flicker,0,.95))
			beam.Color=ColorSequence.new(if dead then CLOSED elseif moulding then VEIN_CORE elseif entry.main then VEIN_BRIGHT else VEIN)
			local w=(if entry.main then .17 else .1)*flare
			beam.Width0=w;beam.Width1=w
		end
	end
	-- The points: bright and open, or dark and shut.
	local parts,cfs={},{}
	for id,node in net.nodes do
		local at=FX.tenketsuWorld(S.model,id)
		if at then
			table.insert(parts,node);table.insert(cfs,CFrame.new(at))
			node.Color=if closed[id] then CLOSED else VEIN_CORE
			node.Size=Vector3.one*(if closed[id] then .36 else .28)
			node.Transparency=if closed[id] then .05 else .2+.15*math.sin(t*6)
		else
			node.Transparency=1
		end
	end
	-- The flow: faster and fuller with more chakra, a rush to the hands while
	-- he moulds a jutsu; none through a channel that is cut.
	local live=math.floor(PULSES*(.25+.75*chakra)+.5)
	local speed=(.35+.9*chakra)*(if moulding then 2.4 else 1)
	for i,pulse in net.pulses do
		local chain=net.chains[pulse.chain]
		local on=chain~=nil and i&lt;=live and not cut[pulse.chain] and not severe
		if on then
			pulse.along=(pulse.along+dt*speed)%1
			table.insert(parts,pulse.part);table.insert(cfs,CFrame.new(along(chain,pulse.along)))
			pulse.part.Transparency=.1
		else
			pulse.part.Transparency=1
		end
	end
	for _,dot in net.dots do
		table.insert(parts,dot.part);table.insert(cfs,CFrame.new(along(net.chains[dot.chain],dot.along)))
		local dead=cut[dot.chain] or severe
		dot.part.Color=if dead then CLOSED else VEIN
		dot.part.Transparency=if dead then .35 else .15
	end
	move(parts,cfs)
	-- (A body the speed has turned to ink stays ink: the Byakugan sees chakra,
	-- it does not read speed; that is the Sharingan's.)
	for _,part in net.glass do if part.LocalTransparencyModifier&lt;.99 then part.LocalTransparencyModifier=.72 end end
	-- Effects' own markers of the closed points would sit on top of ours.
	local aura=fx.auras and fx.auras[S.model]
	S.dots=S.dots or {}
	for _,entry in (aura and aura.points) or {} do
		if entry.dot and entry.dot.Parent then entry.dot.LocalTransparencyModifier=1;S.dots[entry.dot]=true end
	end
end

local function step(fx,data,dt,folder)
	local mode=forced()
	local duel=data and data.phase=="Duel" and mode~="off"
	local target=duel and data.bot or nil
	local viewer=duel and data.human or nil
	local model=target and folder and folder:FindFirstChild(target.id or "")
	local open=model~=nil and (mode=="byakugan" or (mode==nil and Sight.viewChakraSight(viewer)))
	if not open then release();return end
	if S and (S.model~=model or S.fx~=fx or not S.net or not S.net.holder.Parent) then release() end
	if not S then
		S={model=model,fx=fx,net=build(fx,model),graded=true}
		grade(true)
		local root=model:FindFirstChild("HumanoidRootPart")
		if root and K.SOUND then pcall(function() K.sound(K.anchorPart(fx.folder,root.Position),K.SOUND.whoosh,.3,.7) end) end
	end
	draw(fx,target,dt)
end

function ByakuganFX.install(Effects,kit)
	K=kit;FX=Effects
	table.insert(Effects.layers,{name="Byakugan",step=step})
end
ByakuganFX.release=release
return ByakuganFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND196">
          <Properties>
            <string name="Name">Camera</string>
            <ProtectedString name="Source">-- Duel camera. A locked third-person rig that keeps both fighters readable:
--  * it sits behind the player on the line to the opponent, a little over the
--    shoulder, and *orbits* (speed-limited) when the fighters swap sides, so a
--    Minato teleport behind the opponent turns the view around instead of
--    leaving the camera on the wrong side of the fight;
--  * distance and height grow with separation and vertical gap, so launchers,
--    chases and slams stay in frame;
--  * framing modes blend over several frames; impact shake and FOV kicks are
--    reserved for heavy moments.
local Camera={}; Camera.__index=Camera
local Config=require(game:GetService("ReplicatedStorage").NinjaDuel.Config)
local framing={
 -- (Fluidity pass, user reference 28/10) close behind the shoulder: the
 -- body fills the frame, every motion of it reads; the opponent ahead.
 Ground={distance=12.5,height=3.6,fov=64,lift=1.8,side=.55},
 -- (05/11, user on the pad: "on sent qu'elle bascule entre 2") The air,
 -- chase, slam and wall framings were 6 to 10 studs further and 8 to 14
 -- degrees wider than the ground one, and a string with a launcher went in,
 -- out and in again. Closer to the ground frame now (the gap and the height
 -- between the bodies still pull the lens back on their own), and every
 -- change of framing is eased over a third of a second (Camera:update).
 Launcher={distance=15.5,height=4,fov=68,lift=3.5,side=.5},
 Pursuit={distance=17,height=5,fov=70,lift=3,side=.5},
 AirCombo={distance=15.5,height=3.5,fov=68,lift=2.5,side=.5},
 Slam={distance=16.5,height=7.5,fov=70,lift=-1,side=.45},
 Wall={distance=17,height=6,fov=70,lift=3,side=.5},
}
local function mode(h,b)
 if h.attackName=="Slam" or b.attackName=="Slam" then return "Slam" end
 if h.state=="Pursuit" or b.state=="Pursuit" then return "Pursuit" end
 if h.wall or b.wall or h.reaction=="WallSplat" or b.reaction=="WallSplat" then return "Wall" end
 if h.reaction=="Launched" or b.reaction=="Launched" then return "Launcher" end
 -- Air combo framing is for fighting in the air, not for every jump: an
 -- ordinary ninja jump keeps the ground rig and its vertical tracking.
 local function airFight(x) return x.airborne and (x.attackName~=nil or x.reaction~=nil) end
 if airFight(h) or airFight(b) then return "AirCombo" end
 return "Ground"
end
local function wrap(angle)
 return (angle+math.pi)%(2*math.pi)-math.pi
end
-- What stops the lens (it never goes into these): the floor, the stadium
-- wall in every piece (the wall, its cap: a lens lifted over a fight along the
-- wall used to slip through the cap into the stands), anything marked as a
-- wall, and any very large part. Smaller fighting-space props fade instead.
local function solid(part)
	return part.Name=="Training floor" or string.sub(part.Name,1,8)=="Boundary" or part:GetAttribute("NinjaWall")==true or part.Size.Magnitude&gt;40
end
Camera.solid=solid
-- (08/11, F7 tool: the lens behind a field tree hid the player) A field tree
-- is an invisible box (World: cover, line of sight, breakable) carrying the
-- Blender tree. The lens's ray stops on the box, and fading the box alone
-- changed nothing on screen: an invisible part in the way fades what it
-- carries.
local function fadeHit(part,faded)
	faded[part]=true
	if part.Transparency&gt;=.95 and part.GetDescendants then
		for _,d in part:GetDescendants() do if d:IsA("BasePart") then faded[d]=true end end
	end
end
Camera.fadeHit=fadeHit
function Camera.new()
	-- (DEC-031, user 03/11: "on est sur du Storm total") Free by default:
	-- the mouse turns the lens, SHIFT locks on.
	local self=setmetatable({locked=false,look=Vector2.zero,yaw=0,pitch=.22,lastEpoch=-1,lastHealth=nil,lastEnemyHealth=nil,
		shakeUntil=0,shakeSize=0,fovKick=0,focus=nil,boomAngle=nil,distance=nil,rng=Random.new(),zoom=0,mode=nil},Camera)
 local UIS=game:GetService("UserInputService")
 -- Right mouse owns the heavy attack, so orbit and zoom are always live
 -- instead of needing a held modifier. Free-look only applies unlocked.
 UIS.InputChanged:Connect(function(input)
  if input.UserInputType==Enum.UserInputType.MouseMovement and not self.locked then
   self.yaw+=input.Delta.X*.004;self.pitch=math.clamp(self.pitch-input.Delta.Y*.003,.04,.9)
   if input.Delta.Magnitude&gt;.5 then self.lastLookInput=os.clock() end
  elseif input.UserInputType==Enum.UserInputType.MouseWheel then
   self.zoom=math.clamp(self.zoom-input.Position.Z*1.4,-6,12)
  end
 end)
 return self
end
-- Locked, yaw is an offset from "behind the player"; unlocked it is an
-- absolute heading. Convert on toggle so the lens stays where it is instead of
-- swinging to world north (and dragging the movement axes with it).
function Camera:setLocked(locked)
 if locked==self.locked then return end
 if locked then self.yaw=0 else self.yaw=self.boomAngle or self.yaw end
 self.locked=locked
end
-- Impact-driven impulse. Small events must not make the camera twitch: only a
-- finisher, launcher, parry, slam, teleport or big jutsu earns a reaction.
local IMPULSE={
 whiff={0,0},spent={0,0},seals={0,0},kunai={0,0},shuriken={0,0},stick={0,0},fade={0,0},cast={0,0},chase={.02,1.2},dodge={.01,.25},substitute={.02,.4},
 -- (FEEL 05/11) a landed light blow is felt in the lens too (was .02/.3).
 light={.05,.7},air={.055,.8},landing={.04,.6},block={.04,.6},quickstep={.015,.8},teleport={.03,2.2},mirage={0,0},burst={.02,1},
 -- (Stage 6) the ultimates and the awakenings' moments.
 jutsuclash={.26,3.2},conduct={.08,1},steam={.03,.8},puddle={0,0},sandmelt={0,0},
 ultimateStart={.08,2},ultimate={.12,1.2},ultimateTick={.05,.6},ultimateEnd={.3,3.2},ultimateMiss={0,0},tsukuyomi={.06,1.6},gate={.04,.8},reveal={0,0},
 launcher={.1,1.3},finisher={.13,1.6},parry={.14,1.7},jutsu={.15,1.8},fire={.32,3.2},
 slam={.26,2.6},wall={.14,1.1},wallbounce={.2,2.0},clash={.12,1.6},walltech={.02,.4},pin={.02,.25},ember={.02,.35},palm={.015,.2},palmburst={.06,.9},flow={.03,.6},awaken={.12,2.4},groundbounce={.18,1.8},worldbreak={.2,2.2},chidori={.1,2.2},afterimage={0,0},deflect={.01,.2},repel={.1,1.3},rotation={.04,.9},trigram={0,0},
}
-- (Stage 6) an ultimate takes the lens for its sequence (Server/Ultimates:
-- the "ultimate" contact carries kind, time, and the frame of the catch).
-- (Redone 02/11) Each sequence is filmed from its own shot list
-- (Shared/UltimateScripts: cuts, framings that follow a body, the fov of
-- each shot) instead of one orbit for all; it hands back where it stops.
local Scripts=require(game:GetService("ReplicatedStorage").NinjaDuel.UltimateScripts)
local CINEMA={
	clones={dist=14,height=4,rate=.5,fov=58},lion={dist=16,height=1.5,rate=.7,fov=62,follow=true},pyramid={dist=22,height=12,rate=.25,fov=60},
	lotus={dist=16,height=1.5,rate=.9,fov=62,follow=true},palms={dist=9,height=2.2,rate=.35,fov=48},tsukuyomi={dist=8,height=2,rate=.12,fov=42},
	flash={dist=15,height=5,rate=1.1,fov=60},raikiri={dist=15,height=3,rate=.35,fov=54},
}
Camera.CINEMA=CINEMA
function Camera:cinema(impact,now)
	local look=CINEMA[impact and impact.kind or ""] or CINEMA.clones
	local frame=nil
	if impact and impact.origin and impact.line and Scripts.KINDS[impact.kind or ""] then frame=Scripts.frame(impact.origin,impact.line) end
	self.cinematic={from=now,untilT=now+((impact and impact.time) or 3.4),look=look,sign=if math.random()&lt;.5 then 1 else -1,
		kind=impact and impact.kind,frame=frame,owner=impact and impact.owner,victim=impact and impact.victim}
end
function Camera:impulse(style,role,impact)
	if style=="ultimate" then self:cinema(impact,os.clock())
	elseif (style=="ultimateEnd" or style=="ultimateMiss") and self.cinematic then self.cinematic.untilT=math.min(self.cinematic.untilT,os.clock()+.3) end
	local spec=IMPULSE[style] or IMPULSE.light
	if not spec or (spec[1]&lt;=0 and spec[2]&lt;=0) then return end
	local weight=if role=="victim" then 1.25 elseif role=="neutral" then .6 else .85
	-- (B1 lot 3) effects LOW: a calmer lens (a little shake, a small kick).
	if self.calm then weight*=.4 end
	local now=os.clock()
	self.shakeSize=math.max(self.shakeSize or 0,spec[1]*weight)
	self.fovKick=math.max(self.fovKick or 0,spec[2]*weight)
	self.shakeUntil=math.max(self.shakeUntil or 0,now+(if style=="slam" or style=="fire" then .18 else .07))
	-- A decisive blow gets a beat of space: the lens eases back, then settles.
	local SETTLE={finisher=1.6,launcher=1.2,slam=2.4,wallbounce=2.4,wall=1.4,clash=1.4,repel=1.8,parry=1.4,fire=2}
	if SETTLE[style] then self.settleSize=math.max(if now&lt;(self.settleUntil or 0) then self.settleSize or 0 else 0,SETTLE[style]);self.settleUntil=now+.75 end
end
function Camera:mouse(data)
	local UIS=game:GetService("UserInputService")
	-- (Audit 04/11) watching a match: the cursor stays free for SKIP.
	local free=data~=nil and data.phase=="Duel" and not self.locked and not data.gamepad and not data.touch and not self.menuOpen and not data.spectate
	local want=if free then Enum.MouseBehavior.LockCenter else Enum.MouseBehavior.Default
	if UIS.MouseBehavior~=want then UIS.MouseBehavior=want end
end
-- (B1) The player's own body fades when the lens comes close to his head (a
-- wall behind him): see-through from 5.5 studs, at most 0.85. Only parts no
-- one else hid (an effect's hidden part stays at 1), and only parts it faded
-- itself are given back. The part list is kept per character.
local partsOf=setmetatable({},{__mode="k"})
function Camera:fadeSelf(character,lens,at)
	local amount=0
	if character and lens and at then
		amount=math.clamp((5.5-(lens-(at+Vector3.new(0,1.5,0))).Magnitude)/2.2,0,.85)
	end
	local faded=self.selfFaded
	if amount&lt;=.01 then
		if faded then
			for part,value in faded do if part.Parent and math.abs(part.LocalTransparencyModifier-value)&lt;1e-3 then part.LocalTransparencyModifier=0 end end
			self.selfFaded=nil
		end
		return
	end
	local parts=partsOf[character]
	if not parts or #parts==0 or not parts[1].Parent then
		parts={}
		local ok,list=pcall(function() return character:GetDescendants() end)
		for _,d in if ok then list else {} do if d:IsA("BasePart") and d.Name~="HumanoidRootPart" then table.insert(parts,d) end end
		partsOf[character]=parts
	end
	faded=faded or {}
	for _,part in parts do
		local now=part.LocalTransparencyModifier
		if now&lt;.99 and (faded[part]==nil and now&lt;.01 or faded[part]~=nil) then part.LocalTransparencyModifier=amount;faded[part]=amount end
	end
	self.selfFaded=faded
end
-- (FEEL 05/11) How much to tilt the lens up (radians) and widen it (degrees)
-- so `top` (the higher body's head) is inside the frame without pushing
-- `bottom` (the player's feet) out of it. A margin of 5 degrees inside the
-- vertical field of view. Pure: Camera.spec checks it.
function Camera.keepInFrame(cf,fov,top,bottom)
	local half=math.rad(fov*.5)-math.rad(5)
	local function pitchOf(p)
		local v=cf:PointToObjectSpace(p)
		return math.atan2(v.Y,math.max(-v.Z,.1))
	end
	local need=pitchOf(top)-half
	if need&lt;=0 then return 0,0 end
	-- Room under the feet before they leave the bottom edge.
	local room=math.max(0,pitchOf(bottom)+half)
	local tilt=math.min(need,room,.6)
	local widen=math.min(math.deg(need-tilt)*2,16)
	return tilt,widen
end
-- (FEEL 05/11, AVANT defect 1) The lens squeezed by a solid (the stadium
-- wall, the floor) looks for the nearest clear heading around the player:
-- tries half a radian, then one, then one and a half, on both sides, and
-- prefers what is closest to the swing it already has. Back at zero once the
-- plain heading has been clear for 0.6 s. Only solids count: props fade.
local WALL_TRIES={0,.5,-.5,1,-1,1.5,-1.5}
function Camera:steerAroundWall(focus,distance,height,squeeze,ray,dt,clock)
	local base=self.baseAngle
	if not base or not distance then return end
	local current=self.wallGoal or 0
	local function clear(off)
		local angle=base+off
		local spot=focus+Vector3.new(math.sin(angle),0,math.cos(angle))*distance+Vector3.new(0,height,0)
		local reach=spot-focus
		local hit=workspace:Raycast(focus,reach,ray)
		return not (hit and solid(hit.Instance) and hit.Distance&lt;reach.Magnitude*.75)
	end
	if squeeze&gt;.3 then
		self.wallClearSince=nil
		local best,score=nil,math.huge
		for _,step in WALL_TRIES do
			local off=current+step
			if math.abs(off)&lt;=1.6 and clear(off) then
				local s=math.abs(step)+.25*math.abs(off)
				if s&lt;score then best,score=off,s end
			end
		end
		if best then self.wallGoal=best end
	elseif current~=0 then
		if clear(0) then
			self.wallClearSince=self.wallClearSince or clock
			if clock-self.wallClearSince&gt;.6 then self.wallGoal=0;self.wallClearSince=nil end
		else
			self.wallClearSince=nil
		end
	end
	local goal=self.wallGoal or 0
	local yaw=self.wallYaw or 0
	yaw+=(goal-yaw)*(1-math.exp(-dt*4))
	self.wallYaw=if math.abs(yaw)&lt;1e-3 and goal==0 then nil else yaw
end
-- (FEEL 05/11, AVANT defect 5) The bushes along the wall and the field
-- trees' crowns are decor: no collision, no query (World/ArenaMeshes), so
-- the lens never faded them and a body that ran into one vanished inside it
-- (Studio, take 1: both fighters in a bush at the wall). Pieces close to a
-- fighter, or across the line from the lens to the player, fade; the list is
-- read once per arena.
local DECOR_FADE=.7
function Camera:fadeDecor(folder,a,target,lens,clock)
	local yard=folder and folder:FindFirstChild("Courtyard")
	local list=self.decorList
	if yard~=self.decorYard then
		-- (QA 12/11) A stadium still arriving (Server/Stage) is read once
		-- it is whole, not half.
		if yard and yard:GetAttribute("Building") then return end
		list={}
		if yard then
			local center=nil
			for _,d in yard:GetDescendants() do
				if d:IsA("BasePart") and (string.sub(d.Name,1,5)=="Bush_" or string.sub(d.Name,1,5)=="Tree_") then
					table.insert(list,{part=d,center=d.Position,radius=math.max(d.Size.X,d.Size.Z)*.5,top=d.Position.Y+d.Size.Y*.5,bottom=d.Position.Y-d.Size.Y*.5})
				end
				if d.Name=="Training floor" then center=d.Position end
			end
			-- The forest beyond the wall stays as it is.
			if center then
				for i=#list,1,-1 do
					local flat=Vector3.new(list[i].center.X-center.X,0,list[i].center.Z-center.Z)
					if flat.Magnitude&gt;(150) then table.remove(list,i) end
				end
			end
		end
		self.decorYard=yard;self.decorList=list
	end
	if not list or #list==0 then return end
	-- Ten times a second is enough for decor.
	if clock&lt;(self.decorNext or 0) then return end
	self.decorNext=clock+.1
	local faded=self.decorFaded or {}
	local now={}
	local function near(item,p)
		local flat=Vector3.new(p.X-item.center.X,0,p.Z-item.center.Z).Magnitude
		return flat&lt;item.radius+2.5 and p.Y-3&lt;item.top
	end
	-- (08/11, F7 tool) Across the line over the piece's whole height, not
	-- near its centre: a trunk's centre stands 7 to 9 studs up, and a line at
	-- body height through the trunk passed "too far" from it - the trunk hid
	-- the player and stayed opaque.
	local function across(item)
		if not lens then return false end
		local seg=a-lens
		if seg.Magnitude&lt;.1 then return false end
		local flat=Vector3.new(seg.X,0,seg.Z)
		local len2=flat:Dot(flat)
		local t=if len2&gt;1e-4 then math.clamp(Vector3.new(item.center.X-lens.X,0,item.center.Z-lens.Z):Dot(flat)/len2,0,1) else 0
		local p=lens+seg*t
		return Vector3.new(p.X-item.center.X,0,p.Z-item.center.Z).Magnitude&lt;item.radius*.9 and p.Y&gt;item.bottom-1 and p.Y&lt;item.top+1
	end
	for _,item in list do
		local part=item.part
		if part.Parent and (near(item,a) or (target and near(item,target)) or across(item)) then
			now[part]=true
			if part.LocalTransparencyModifier&lt;DECOR_FADE then part.LocalTransparencyModifier=DECOR_FADE end
		end
	end
	for part in faded do
		if not now[part] and part.Parent and math.abs(part.LocalTransparencyModifier-DECOR_FADE)&lt;1e-3 then part.LocalTransparencyModifier=0 end
	end
	self.decorFaded=now
end
-- (B1, B0 defect 4) Whether the lens on screen is the player's own: not the
-- round's intro, a K.O., an ultimate's sequence or a watched match. Only then
-- does a free mouse lens turn the body (Main sends `look`): during the intro
-- the body followed the intro's lens and turned its back to the opponent.
function Camera:steers(data)
	if not data or data.phase~="Duel" or data.spectate or data.ko or (data.intro or 0)&gt;0 then return false end
	if self.cinematic and os.clock()&lt;self.cinematic.untilT then return false end
	return true
end
function Camera:update(data,dt)
	local camera=workspace.CurrentCamera
	pcall(self.mouse,self,data)
	-- Roster, online queue and fighter pick: no duel on screen yet.
	if not data or (data.phase~="Duel" and data.phase~="Result") or not data.human or not data.bot then
		self.lastHealth=nil; self.lastEnemyHealth=nil; camera.FieldOfView=70
		camera.CameraType=Enum.CameraType.Scriptable
		-- The roster and the online pick film the fighters' set (Client/MenuStage).
		if self.menuShot and data and (data.phase=="Selection" or data.phase=="Pick") then
			local shot,fov=self.menuShot()
			if shot then camera.CFrame=shot;camera.FieldOfView=fov or 70;return end
		end
		-- Slow establishing orbit over the training ground behind the menu.
		local t=os.clock()*.06
		camera.CFrame=CFrame.lookAt(Vector3.new(math.sin(t)*88,38,math.cos(t)*88),Vector3.new(0,8,0)); return
	end
	local character=game:GetService("Players").LocalPlayer.Character
	local root=character and character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	camera.CameraType=Enum.CameraType.Scriptable
	local fresh=self.lastEpoch~=data.epoch
	if fresh then self.faceOpponent=true end
	if fresh then self.lastHealth=data.human.health; self.lastEnemyHealth=data.bot.health;self.yaw=0;self.pitch=.22;self.focus=nil;self.boomAngle=nil;self.distance=nil;self.sprint=0;self.wasSprinting=false;self.lastImpactSerial=data.human.impactSerial or 0 end
	-- Fallback only: the impact-style impulse above owns normal reactions.
	-- Only a new contact counts: a health drain (curse mark) carries a stale
	-- impactHeavy and must not shake the lens every snapshot.
	local serial=data.human.impactSerial or 0
	if self.lastHealth and data.human.health&lt;self.lastHealth and serial~=self.lastImpactSerial then
		local damage=self.lastHealth-data.human.health
		if data.human.impactHeavy or damage&gt;=12 then
			self.shakeSize=math.max(self.shakeSize or 0,.2);self.fovKick=math.max(self.fovKick or 0,2);self.shakeUntil=math.max(self.shakeUntil or 0,os.clock()+.12)
		end
	end
	self.lastImpactSerial=serial
	self.lastHealth=data.human.health
	self.lastEnemyHealth=data.bot.health
	-- Frame the bodies where they are drawn (smoothed), not the stepping roots.
	local presentation=self.presentation
	local a=(presentation and presentation:visualRoot("human")) or root.Position
	local folder=root.Parent and root.Parent.Parent
	-- The opponent's model is named by its id (AIFighter locally, a duelist online).
	local bot=folder and folder:FindFirstChild(data.bot.id or "AIFighter")
	local b=bot and bot:FindFirstChild("HumanoidRootPart")
	local target=(presentation and presentation:visualRoot("bot")) or (if b then b.Position else data.bot.position)
	-- Lost in the opponent's shroud (snapshot family.shrouded, QA-004 M3): the
	-- lens stops following him. It keeps the last place it saw him for its
	-- framing and turns like an unlocked camera; the lock preference itself
	-- (self.locked) is untouched and comes back as soon as he is seen again.
	local lost=data.human.family~=nil and data.human.family.shrouded==true
	if lost then
		if not self.lostFrom then self.lostFrom=self.lastSeen or target;self.fogYaw=self.boomAngle end
		target=self.lostFrom
	else
		self.lostFrom=nil;self.fogYaw=nil;self.lastSeen=target
	end
	local follow=self.locked and not lost
	local flat=Vector3.new(target.X-a.X,0,target.Z-a.Z)
	if flat.Magnitude&lt;.01 then flat=-Vector3.zAxis end
	local separation=flat.Magnitude
	local vertical=math.abs(target.Y-a.Y)
	local aerial=data.human.airborne or data.bot.airborne or vertical&gt;5
	local pursuit=data.human.state=="Pursuit" or data.bot.state=="Pursuit"
	local slam=data.human.attackName=="Slam" or data.bot.attackName=="Slam"
	local selected=mode(data.human,data.bot)
	-- (Audit 29/10) A mode is kept at least 0.4 s: the air-combo flags drop
	-- between two blows, and the lens swung 12 degrees and dollied in and out
	-- in the middle of a string.
	local clock=os.clock()
	if self.mode and selected~=self.mode and clock&lt;(self.modeSince or 0)+.4 and selected~="Slam" and selected~="Pursuit" then selected=self.mode end
	if selected~=self.mode then self.modeSince=clock end
	self.mode=selected
	-- (User 03/11, free lens: "sometimes the camera switches from free to the
	-- character and back") The framing modes (chase 21 studs, wall 22, slam
	-- 19 and 10 up, against 12.5 on the ground) frame the pair when locked
	-- on; free, they jumped the lens in and out. Free keeps the ground frame.
	local goal=if follow then framing[selected] else framing.Ground
	-- (05/11) The framing in use slides toward the selected one (a third of a
	-- second) instead of switching tables.
	local frame=self.frameNow
	if fresh or not frame then frame=table.clone(goal)
	else
		local k=1-math.exp(-dt*3)
		for key,value in goal do frame[key]+=(value-frame[key])*k end
	end
	self.frameNow=frame
	-- (05/11) How locked the rig is, eased from 0 (free) to 1 (locked): the
	-- R3 / SHIFT toggle, or the shroud taking the opponent away, slides the
	-- focus, the distance and the height from one rig to the other instead of
	-- cutting between two cameras.
	local lockGoal=if follow then 1 else 0
	self.lockT=if fresh or self.lockT==nil then lockGoal else self.lockT+(lockGoal-self.lockT)*(1-math.exp(-dt*5))
	local lockT=self.lockT
	-- A pad or a phone: the right thumb also strikes (Camera:update below).
	local auto=data.gamepad==true or data.touch==true
	-- Look-stick / unlocked mouse orbit.
	self.yaw+=(self.look.X or 0)*dt*2.4;self.pitch=math.clamp(self.pitch-(self.look.Y or 0)*dt,.04,.9)
	if (self.look.Magnitude or 0)&gt;.05 then self.lastLookInput=clock end
	-- (Audit 29/10) Locked, a nudge of the right stick is a glance: it eases
	-- back behind the shoulder once the stick rests (it stayed off for good).
	if follow and not data.ko and math.abs(self.look.X or 0)&lt;.05 then self.yaw*=math.exp(-dt*1.6) end
	-- Boom heading: behind the player on the player-&gt;opponent line, offset over
	-- the shoulder. When the fighters swap sides the heading orbits around at a
	-- bounded angular speed rather than staying on the old side.
	local behind=-flat.Unit
	local desiredAngle
	if follow then
		-- (Audit 29/10) Bodies on top of each other (a cross-up, a vault, a
		-- grab): the line between them is noise, the heading holds instead of
		-- whipping at up to 420 deg/s.
		if separation&lt;3.2 and self.heldBehind then behind=self.heldBehind else self.heldBehind=behind end
		-- (FEEL 05/11, AVANT defect 1) the wall swing (Camera:steerAroundWall) is
		-- added on top of the heading, so the boom's own rate limits ease it.
		self.baseAngle=math.atan2(behind.X,behind.Z)+self.yaw+frame.side
		desiredAngle=self.baseAngle+(self.wallYaw or 0)
	elseif lost and self.locked then
		desiredAngle=self.fogYaw or self.boomAngle or 0
	else
		if self.faceOpponent then self.yaw=math.atan2(behind.X,behind.Z);self.boomAngle=nil;self.faceOpponent=nil end
		-- (B1, B0 defect 4 and Studio 04/11 v37: free, the opponent was often off
		-- screen, at the wall above all) The free lens brings the opponent back
		-- toward the frame.
		-- (05/11, user on the pad: "on sent qu'elle bascule entre 2") It used to
		-- switch on after 0.9 s without the stick and without a move, then off
		-- at the first step: the lens kept changing hands. Now:
		--  * pad or phone (the right thumb also strikes): the follow is always
		--    on, a dead zone of 22 degrees around the centre and a spring past
		--    it, run or not; the stick only borrows the lens and, let go, the
		--    follow comes back over 0.6 s. The body stays free (only a lock
		--    turns it toward the opponent, DEC-031);
		--  * mouse: the player steers the body with the lens, so it only helps
		--    a player who stands and leaves it alone, eased in, never switched.
		local idle=clock-(self.lastLookInput or -math.huge)
		if not lost and not data.ko and separation&gt;3.2 then
			local weight,edge,rate
			if auto then weight=math.clamp((idle-.6)/.6,0,1);edge=math.rad(22);rate=3.2
			else
				local still=presentation==nil or presentation.inputDir==nil or presentation.inputDir.Magnitude&lt;.1
				weight=if still then math.clamp((idle-.9)/.6,0,1) else 0;edge=math.rad(32);rate=2.4
			end
			local off=wrap(self.yaw-math.atan2(behind.X,behind.Z))
			if weight&gt;0 and math.abs(off)&gt;edge then
				local turn=math.min((math.abs(off)-edge)*(1-math.exp(-dt*rate)),math.rad(150)*dt)*weight
				self.yaw=wrap(self.yaw-math.sign(off)*turn)
			end
		end
		-- (FEEL 05/11, Studio: free with a pad, backed into the wall, the player
		-- was off screen for 100 % of the frames) A pad's free lens swings
		-- along the wall too; a mouse lens stays the player's (it turns the body).
		self.baseAngle=self.yaw
		desiredAngle=self.yaw+(if auto then (self.wallYaw or 0) else 0)
	end
	if not self.boomAngle then self.boomAngle=desiredAngle end
	local delta=wrap(desiredAngle-self.boomAngle)
	-- A large swing (teleport behind, cross-up) turns faster than a small drift.
	local maxRate=if math.abs(delta)&gt;1.4 then math.rad(420) else math.rad(240)
	local step=delta*(1-math.exp(-dt*(if math.abs(delta)&gt;1.4 then 7 else 5)))
	step=math.clamp(step,-maxRate*dt,maxRate*dt)
	self.boomAngle=wrap(self.boomAngle+step)
	local boom=Vector3.new(math.sin(self.boomAngle),0,math.cos(self.boomAngle))
	-- Focus: between the fighters, biased towards the player, raised for air.
	local bias=if separation&lt;=26 then .42 else math.max(.3,.42-(separation-26)*.003)
	local targetFocus=a:Lerp(target,bias)+Vector3.new(0,frame.lift,0)
	-- (FEEL 05/11, AVANT defect 2) A body far above (a chakra launcher at 66
	-- studs): the pair's focus rises to their middle, so the lens looks level
	-- at both instead of up from under one of them.
	if vertical&gt;8 then
		local mid=a.Y+(target.Y-a.Y)*.5
		local k=math.clamp((vertical-8)/10,0,1)
		targetFocus=Vector3.new(targetFocus.X,targetFocus.Y+(mid+frame.lift-targetFocus.Y)*k,targetFocus.Z)
	end
	-- Sprint feel: only the player's own sprint (never the opponent's) eases
	-- in a wider lens, a slightly tighter and lower boom and a longer lead, so
	-- the floor streams past without the camera falling behind the body.
	local sprintTarget=if data.human.sprinting and (data.human.speed or 0)&gt;24 then 1 else 0
	local sprint=self.sprint or 0
	sprint+=(sprintTarget-sprint)*(1-math.exp(-dt*(if sprintTarget&gt;sprint then 6 else 3)))
	if sprintTarget==1 and not self.wasSprinting then self.fovKick=math.max(self.fovKick or 0,2.5) end
	self.sprint=sprint;self.wasSprinting=sprintTarget==1
	-- Lead a little where the player is going so a run is framed ahead of it.
	local moving=presentation and presentation:visualVelocity("human")
	if moving then
		local lead=Vector3.new(moving.X,0,moving.Z)*.11
		-- (B1, B0 defect 3: backing toward the lens, the body slid out of the
		-- bottom of the frame) No lead toward the lens: there is nothing to
		-- show "ahead" behind the camera, it only pulled the aim onto him.
		local back=lead:Dot(boom)
		if back&gt;0 then lead-=boom*back end
		local leadCap=2.6+sprint*2.4
		if lead.Magnitude&gt;leadCap then lead=lead.Unit*leadCap end
		self.lead=(self.lead or Vector3.zero):Lerp(lead,1-math.exp(-dt*4))
		targetFocus+=self.lead
	end
	-- Free, the lens follows the player (over the shoulder); locked, the pair.
	-- (05/11) Blended by lockT, so the toggle slides; on a pad the free lens
	-- leans a little toward the fight it keeps in view.
	-- (FEEL 05/11) A pad's free lens swung along the wall (steerAroundWall)
	-- frames the pair while it is swung, as a lock would: seen from the side,
	-- the player alone left the opponent out (Studio: 209 of 240 frames).
	local pairT=lockT
	if auto and not lost then pairT=math.max(lockT,math.clamp(math.abs(self.wallYaw or 0)/.6,0,1)) end
	if pairT&lt;.999 then
		local look=Vector3.new(-boom.X,0,-boom.Z)
		local freeFocus=a+Vector3.new(0,1.6,0)+(if look.Magnitude&gt;.05 then look.Unit:Cross(Vector3.yAxis)*1.7 else Vector3.zero)
		if auto and not lost then
			freeFocus+=flat.Unit*math.min(separation*.1,2.5)
			-- (FEEL 05/11) and climbs with a body launched far above.
			if vertical&gt;8 then
				local k=math.clamp((vertical-8)/10,0,1)
				freeFocus=Vector3.new(freeFocus.X,freeFocus.Y+(targetFocus.Y-freeFocus.Y)*k,freeFocus.Z)
			end
		end
		targetFocus=freeFocus:Lerp(targetFocus,pairT)
	end
	-- (FEEL 05/11) a body shooting far up is followed faster (AVANT defect 2).
	local focusRate=if vertical&gt;8 then 20 elseif aerial or pursuit then 13 else 9
	self.focus=if self.focus then self.focus:Lerp(targetFocus,1-math.exp(-dt*focusRate)) else targetFocus
	local focus=self.focus
	local settle=math.max(0,(self.settleUntil or 0)-os.clock())/.75
	-- K.O.: a slow drift around the finish while the lens eases out.
	if data.ko then self.yaw+=dt*.3 end
	local spread=math.min(math.max(0,separation-7),19)*.42+math.max(0,separation-26)*.22
	-- Free, the lens follows the player, not the pair: no pull-back for the gap
	-- to the opponent (a wall run 40 studs from him filmed the player tiny).
	-- (05/11) A pad's free lens keeps half of it (the opponent it keeps in view
	-- stays readable); the share slides with lockT.
	local freeShare=if auto and not lost then .5 else 0
	local share=freeShare+(1-freeShare)*pairT
	spread*=share
	local pairVertical=vertical*share
	-- (FEEL 05/11, AVANT defect 2) The distance that holds the whole height of
	-- the pair inside the vertical field of view (a launch of 60 studs needs a
	-- wide shot for its 2 seconds); ordinary jumps are under the threshold.
	-- A pad's free lens keeps the opponent in view by itself: for this it
	-- holds the whole height too (Studio 05/11: free, the lens still lost him
	-- for 1.1 s at half weight).
	local holdShare=if auto and not lost then 1 else share
	local verticalNeed=0
	if vertical*holdShare&gt;8 then
		local halfV=math.rad(math.max(20,frame.fov*.5-6))
		verticalNeed=math.max(0,(vertical+6)*.5/math.tan(halfV)-(frame.distance+spread))*holdShare
	end
	local wantDistance=math.clamp(frame.distance-sprint*1.5+spread+pairVertical*.3+verticalNeed+self.zoom+(self.settleSize or 0)*math.sin(settle*math.pi*.5)+(if data.ko then 6 else 0),8.5,if verticalNeed&gt;0 then 66 else 48)
	local distanceRate=if verticalNeed&gt;0 and self.distance and wantDistance&gt;self.distance then 12 else 4
	self.distance=if self.distance then self.distance+(wantDistance-self.distance)*(1-math.exp(-dt*distanceRate)) else wantDistance
	-- The lens rises with the gap up to 12 studs; past that the focus climbs
	-- to the pair's middle instead (above) and the lens stays level with it.
	local height=frame.height-sprint*.6+self.pitch*9+(math.min(vertical,12)*.28+math.min(math.max(0,separation-10)*.1,4))*share
	if slam then height+=math.clamp(-(data.human.velocity and data.human.velocity.Y or 0)*.04,0,4) end
	local desired=focus+boom*self.distance+Vector3.new(0,height,0)
	-- Match intro: a slow orbit that presents both fighters, then the normal
	-- rig takes over from wherever the orbit ended.
	-- (Partie 1 feedback: "I don't really see the opening pose".) The old
	-- orbit framed both bodies from 20+ studs, so an entrance pose was a few
	-- pixels. Fighting-game entrance instead (Storm 4, Tekken 8): each
	-- fighter in turn, three-quarter front, close enough that the pose reads,
	-- a slow dolly across; then, at BEGIN, a cut to the duel frame.
	if (data.intro or 0)&gt;0 then
		self.introTotal=math.max(self.introTotal or 0,data.intro)
		local total,left=self.introTotal,data.intro
		local shown=total-left
		local split=total*.5
		local first=shown&lt;split
		local subject=if first then a else target
		local other=if first then target else a
		local toward=Vector3.new(other.X-subject.X,0,other.Z-subject.Z)
		toward=if toward.Magnitude&gt;.1 then toward.Unit else Vector3.zAxis
		local across=toward:Cross(Vector3.yAxis)
		local u=if first then shown/split else (shown-split)/math.max(total-split,1e-3)
		local sign=if first then 1 else -1
		local closeFocus=subject+Vector3.new(0,1.3-u*.3,0)
		local close=closeFocus+toward*(6.2+u*1.2)+across*sign*(2.6-u*1.6)+Vector3.new(0,.4+u*.3,0)
		-- (QA 12/11: at BEGIN only the opponent was in the frame, far, the
		-- player behind the lens) BEGIN cuts to the duel frame, as a fighting
		-- game cuts to play: the old ease crossed the whole gap between the two
		-- (some 50 studs) and found the player only after the fight had begun.
		-- The rig's own focus keeps following the player during the shots (it
		-- was set to each shot's focus), so the cut lands on a settled frame.
		local begun=left&lt;(Config.IntroBegin or .75)
		if not begun then focus=closeFocus;desired=close end
		-- Each change of shot is a cut (the follow below glided it across the
		-- gap, through the bodies).
		local shot=if begun then "duel" elseif first then "first" else "second"
		if self.introShot and self.introShot~=shot then self.cutNow=true end
		self.introShot=shot
	else
		self.introTotal=nil;self.introShot=nil
	end
	self.fovKick*=math.exp(-dt*9)
	local speed=data.human.speed or 0
	local targetFov=frame.fov+math.clamp(separation*.08,0,5)+math.clamp(speed*.05,0,2)+sprint*5+self.fovKick+(self.keepWiden or 0)
	camera.FieldOfView+=(targetFov-camera.FieldOfView)*(1-math.exp(-dt*(if pursuit or slam or (self.keepWiden or 0)&gt;.5 then 8 else 5)))
	-- Keep the lens out of walls and cover; effects and fighters never block it.
	local ray=RaycastParams.new(); ray.FilterType=Enum.RaycastFilterType.Exclude
	local exclude={character};if bot then table.insert(exclude,bot) end
	local effects=folder and folder:FindFirstChild("Effects");if effects then table.insert(exclude,effects) end
	local fx=workspace:FindFirstChild("NinjaDuelFX");if fx then table.insert(exclude,fx) end
	ray.FilterDescendantsInstances=exclude
	-- Fighting-space props (slabs, cover, posts, platforms) never shove the lens
	-- into the player's back: the camera looks through them and they fade.
	-- Only the floor and the bowl's boundary still stop the lens.
	local faded={}
	-- (Studio 03/11, v26: a Naruto clone between the lens and the player hid
	-- him entirely) A body in the way (a clone, a puppet, a summon, the
	-- opponent's double) fades whole, and a body brushing the line counts
	-- too (a sphere, not a thin ray, from the player to the lens).
	local function fadeBody(part)
		local model=part:FindFirstAncestorOfClass("Model")
		if model and model~=workspace and model:FindFirstChildOfClass("Humanoid") then
			for _,d in model:GetDescendants() do if d:IsA("BasePart") then faded[d]=true end end
			table.insert(exclude,model)
			return true
		end
		return false
	end
	local function cast()
		local ok,result=pcall(workspace.Spherecast,workspace,focus,.9,desired-focus,ray)
		local sphere=if ok then result else nil
		if sphere and not solid(sphere.Instance) and sphere.Instance:FindFirstAncestorOfClass("Model") and sphere.Instance:FindFirstAncestorOfClass("Model"):FindFirstChildOfClass("Humanoid") then return sphere end
		return workspace:Raycast(focus,desired-focus,ray)
	end
	local hit=cast()
	for _=1,6 do
		if not hit or solid(hit.Instance) then break end
		if not fadeBody(hit.Instance) then
			fadeHit(hit.Instance,faded)
			table.insert(exclude,hit.Instance)
		end
		ray.FilterDescendantsInstances=exclude
		hit=cast()
	end
	for part in self.faded or {} do if not faded[part] and part.Parent then part.LocalTransparencyModifier=if self.decorFaded and self.decorFaded[part] then DECOR_FADE else 0 end end
	for part in faded do part.LocalTransparencyModifier=.72 end
	self.faded=faded
	local squeeze=0
	if hit then
		local offset=desired-focus
		local full=offset.Magnitude
		local allowed=math.max(0,hit.Distance-1.2)
		local lost=math.clamp(full-allowed,0,full)
		squeeze=lost/math.max(full,1e-3)
		-- (B1, B0 defect 2: backed into the arena's wall, the lens sat on his
		-- head and looked down at it, the screen full of hair and the hedge,
		-- the opponent out of frame) The wall brings the lens in and only a
		-- little higher; the lens then looks ahead over the shoulder (below)
		-- and the player's own body fades, as Roblox's own close camera does.
		desired=focus+offset.Unit*math.max(allowed,3)+Vector3.new(0,lost*.2,0)
		local check=workspace:Raycast(focus,desired-focus,ray)
		if check then desired=check.Position+check.Normal*1.2 end
	end
	-- (FEEL 05/11, AVANT defect 1) Locked with his back to the wall, the
	-- squeezed lens sat on his head and looked past him: the player was off
	-- screen for 100 % of a wall run (Studio, take 2). The boom swings along
	-- the wall to the nearest clear side, so the body is seen three-quarter
	-- with the opponent; the squeeze above stays the last resort.
	if (follow or (auto and not lost)) and (data.intro or 0)&lt;=0 and not data.ko then
		self:steerAroundWall(focus,self.distance,height,squeeze,ray,dt,clock)
	else
		self.wallYaw=nil;self.wallGoal=nil;self.wallClearSince=nil
	end
	-- (FEEL 05/11, AVANT defect 5) Bushes and tree crowns are decor (no query,
	-- no collision): a body that ran into one was hidden inside it.
	self:fadeDecor(folder,a,target,desired,clock)
	-- In at once (never into the wall), out over a third of a second: the push
	-- of a body against the wall no longer shakes the lens frame to frame.
	self.squeeze=if squeeze&gt;=(self.squeeze or 0) then squeeze else (self.squeeze or 0)+(squeeze-(self.squeeze or 0))*(1-math.exp(-dt*3))
	local aim=focus
	if self.squeeze&gt;.02 then
		local ahead=Vector3.new(focus.X-desired.X,0,focus.Z-desired.Z)
		-- (FEEL 05/11) swung along the wall, the lens sees him from the side:
		-- it looks at the pair again instead of past him.
		local swung=math.clamp(math.abs(self.wallYaw or 0)/.5,0,1)
		if ahead.Magnitude&gt;.05 then aim=focus+ahead.Unit*(16*self.squeeze*(1-swung)) end
	end
	local filming=(data.intro or 0)&gt;0 or data.spectate or (self.cinematic~=nil and os.clock()&lt;self.cinematic.untilT)
	self:fadeSelf(if self.squeeze&gt;.02 and not filming then character else nil,desired,a)
	local cf=CFrame.lookAt(desired,aim)
	-- (FEEL 05/11, AVANT defect 2) Neji's chakra launcher threw the opponent 66
	-- studs up and the lens lost him for 1.8 s. Whenever the pair is framed
	-- (locked, or a pad's free lens that keeps the fight in view), the lens
	-- tilts up to keep the higher body in frame, and widens for what the tilt
	-- cannot take without dropping the player's feet out of the bottom.
	local pairShare=if follow or (auto and not lost) then 1 else 0
	local tilt,widen=0,0
	if pairShare&gt;0 and not filming and not data.ko then
		tilt,widen=Camera.keepInFrame(cf,camera.FieldOfView,target+Vector3.new(0,2.6,0),a-Vector3.new(0,2.8,0))
	end
	local keep=self.keepTilt or 0
	keep+=(tilt*pairShare-keep)*(1-math.exp(-dt*(if tilt*pairShare&gt;keep then 12 else 3)))
	self.keepTilt=keep
	local wide=self.keepWiden or 0
	wide+=(widen*pairShare-wide)*(1-math.exp(-dt*(if widen*pairShare&gt;wide then 10 else 2.5)))
	self.keepWiden=wide
	if keep&gt;1e-3 then cf=cf*CFrame.Angles(keep,0,0) end
	-- Shake is an offset on top of the smoothed rig (applied last, never fed
	-- back into the follow), so it is neither damped away nor left behind.
	-- A continuous, decaying oscillation (~7-10 Hz) rather than a fresh random
	-- offset every frame: random per-frame offsets read as the whole image
	-- jumping (measured natively), an oscillation reads as an impact.
	local shake=CFrame.identity
	local clock=os.clock()
	if clock&lt;self.shakeUntil then
		local amp=self.shakeSize*math.clamp((self.shakeUntil-clock)/.18,0,1)
		shake=CFrame.new(math.sin(clock*47)*amp,math.sin(clock*61+1.3)*amp*.8,0)
	end
	-- Studio capture aid: on high-DPI Windows the Studio window only shows the
	-- top-left two thirds of the play viewport, so tooling can ask for the view
	-- to be re-aimed at that visible region. Never active outside Studio.
	local studio=game:GetService("RunService"):IsStudio()
	-- (Stage 6) the ultimate's own lens: it orbits the two bodies for the
	-- sequence; the rig picks up from where it stops.
	local cine=self.cinematic
	if cine and clock&lt;cine.untilT and data.phase=="Duel" then
		local look=cine.look
		local mid=a:Lerp(target,.5)
		local t=clock-cine.from
		if cine.frame then
			-- The script's shot at t: the bodies where they are drawn.
			local frame=cine.frame
			local casterIsHuman=cine.owner~=nil and cine.owner==data.human.id
			local live={caster=frame.anchor(if casterIsHuman then a else target),victim=frame.anchor(if casterIsHuman then target else a)}
			local eye,at,fov,index=Scripts.shot(cine.kind,t,function(name) return live[name] or live.victim end)
			if eye then
				local weye,wat=frame.world(eye),frame.world(at)
				weye=Vector3.new(weye.X,math.max(weye.Y,frame.origin.Y-2.4),weye.Z)
				if (wat-weye).Magnitude&lt;.2 then wat=weye+frame.f end
				local cf=CFrame.lookAt(weye,wat)*shake
				-- The first shot eases in from the fight's lens; every later
				-- cut is a cut (the script decides).
				local ease=if index==1 then math.clamp(t/.25,0,1) else 1
				camera.CFrame=(self.rigCF or camera.CFrame):Lerp(cf,ease)
				camera.FieldOfView=if index==1 then camera.FieldOfView+(fov-camera.FieldOfView)*math.clamp(dt*10,0,1) else fov
				if ease&gt;=1 then self.rigCF=camera.CFrame end
				return
			end
		end
		local line=Vector3.new(target.X-a.X,0,target.Z-a.Z)
		if line.Magnitude&lt;.1 then line=Vector3.xAxis end
		local base=math.atan2(line.Unit.X,line.Unit.Z)+math.pi/2
		local angle=base+cine.sign*t*look.rate
		-- An aerial sequence (Sasuke, Lee): the lens stays down near the floor
		-- and looks up at the bodies, so the height reads.
		cine.floorY=cine.floorY or math.min(a.Y,target.Y)
		local eye=mid+Vector3.new(math.sin(angle)*look.dist,look.height,math.cos(angle)*look.dist)
		if look.follow then eye=Vector3.new(eye.X,cine.floorY+look.height,eye.Z) end
		local cf=CFrame.lookAt(eye,mid+Vector3.new(0,1,0))*shake
		local ease=math.clamp(t/.3,0,1)
		camera.CFrame=(self.rigCF or camera.CFrame):Lerp(cf,ease)
		camera.FieldOfView=camera.FieldOfView+(look.fov-camera.FieldOfView)*math.clamp(dt*6,0,1)
		if ease&gt;=1 then self.rigCF=camera.CFrame end
		return
	elseif cine then
		self.cinematic=nil;self.rigCF=camera.CFrame
	end
	-- (Tournament, 04/11) A match the player watches: the stands' lens, high
	-- on the side of the pair, drifting slowly along the arena, both bodies in
	-- frame whatever they do.
	if data.spectate then
		local mid=a:Lerp(target,.5)
		local line=Vector3.new(target.X-a.X,0,target.Z-a.Z)
		if line.Magnitude&lt;.1 then line=self.spectateLine or Vector3.xAxis end
		self.spectateLine=line
		local side=line.Unit:Cross(Vector3.yAxis)
		if self.spectateSide and side:Dot(self.spectateSide)&lt;0 then side=-side end
		self.spectateSide=side
		local drift=math.sin(clock*.12)*.35
		local dir=(side*math.cos(drift)+line.Unit*math.sin(drift)).Unit
		local dist=math.max(30,line.Magnitude*.9+22)
		local eye=mid+dir*dist+Vector3.new(0,13+line.Magnitude*.15,0)
		local look=mid+Vector3.new(0,2,0)
		-- (Studio 04/11: one of the arena's trees stood between the stands' lens
		-- and the pair) Props in the way fade, as for the player's own lens; the
		-- floor and the bowl's wall bring the lens in, a little higher.
		local ray=RaycastParams.new();ray.FilterType=Enum.RaycastFilterType.Exclude
		local exclude={character};if bot then table.insert(exclude,bot) end
		local effects=folder and folder:FindFirstChild("Effects");if effects then table.insert(exclude,effects) end
		local fx=workspace:FindFirstChild("NinjaDuelFX");if fx then table.insert(exclude,fx) end
		local faded={}
		local hit
		for _=1,8 do
			ray.FilterDescendantsInstances=exclude
			hit=workspace:Raycast(look,eye-look,ray)
			if not hit or solid(hit.Instance) then break end
			local model=hit.Instance:FindFirstAncestorOfClass("Model")
			if model and model~=workspace and model:FindFirstChildOfClass("Humanoid") then
				for _,d in model:GetDescendants() do if d:IsA("BasePart") then faded[d]=true end end
				table.insert(exclude,model)
			else
				fadeHit(hit.Instance,faded);table.insert(exclude,hit.Instance)
			end
		end
		if hit then eye=hit.Position+hit.Normal*1.2+Vector3.new(0,math.max(0,(eye-look).Magnitude-hit.Distance)*.4,0) end
		for part in self.faded or {} do if not faded[part] and part.Parent then part.LocalTransparencyModifier=if self.decorFaded and self.decorFaded[part] then DECOR_FADE else 0 end end
		for part in faded do part.LocalTransparencyModifier=.72 end
		self.faded=faded
		local cf=CFrame.lookAt(eye,look)*shake
		self.spectateCF=if self.spectateCF then self.spectateCF:Lerp(cf,math.clamp(dt*3,0,1)) else cf
		camera.CFrame=self.spectateCF
		camera.FieldOfView=camera.FieldOfView+(55-camera.FieldOfView)*math.clamp(dt*4,0,1)
		self.rigCF=camera.CFrame
		return
	end
	self.spectateCF=nil;self.spectateSide=nil
	-- Studio film camera (tooling only): a low side view of both fighters, the
	-- way a fighting-game camera shows feet, ground contact and body mechanics.
	local film=studio and workspace:GetAttribute("NinjaDuelFilmCam")
	if film then
		local mid=a:Lerp(target,.5)
		local line=Vector3.new(target.X-a.X,0,target.Z-a.Z)
		if line.Magnitude&lt;.1 then line=Vector3.xAxis end
		local side=line.Unit:Cross(Vector3.yAxis)
		local dist=(if type(film)=="number" then film else 0)+math.max(11,separation*.75+8)
		local look=mid+Vector3.new(0,-.4,0)
		cf=CFrame.lookAt(look+side*dist+Vector3.new(0,1.2,0),look)
		camera.FieldOfView=50
	end
	if studio and workspace:GetAttribute("NinjaDuelCaptureShift") then
		-- Turn about the world vertical, then pitch, and rebuild with a world up
		-- so the horizon never rolls.
		local look=CFrame.fromAxisAngle(Vector3.yAxis,math.rad(-21)):VectorToWorldSpace(cf.LookVector)
		look=(look-Vector3.yAxis*math.tan(math.rad(12))).Unit
		cf=CFrame.lookAt(cf.Position,cf.Position+look)
	end
	if film then camera.CFrame=cf;self.rigCF=nil;return end
	if fresh or not self.rigCF or self.cutNow then self.rigCF=cf; self.lastEpoch=data.epoch;self.cutNow=nil
	else
		-- Follow tightly enough for teleports, but never jump more than a few
		-- studs in one frame.
		local base=self.rigCF
		local nextCF=base:Lerp(cf,1-math.exp(-dt*(if vertical&gt;8 then 20 elseif aerial or pursuit or slam then 15 else 11)))
		local move=nextCF.Position-base.Position
		local limit=math.max(3.5,520*dt)
		if move.Magnitude&gt;limit then nextCF=CFrame.new(base.Position+move.Unit*limit)*nextCF.Rotation end
		self.rigCF=nextCF
	end
	-- (Continuity blocker) The smoothed lens and its shake are checked last:
	-- the follow lags behind a pushed-in target and the shake adds an offset,
	-- either could carry the lens through the wall. Whatever stops the lens
	-- now holds it on this side, without a lerp back through.
	local final=self.rigCF*shake
	local reach=final.Position-focus
	if reach.Magnitude&gt;.05 then
		local block=workspace:Raycast(focus,reach,ray)
		for _=1,4 do
			if not block or solid(block.Instance) then break end
			table.insert(exclude,block.Instance);ray.FilterDescendantsInstances=exclude
			block=workspace:Raycast(focus,reach,ray)
		end
		if block then
			-- Off the surface along its normal (a ray grazing the wall puts a
			-- point "1.2 back along the ray" still on the wall's face).
			local safe=block.Position+block.Normal*1.2-reach.Unit*.4
			self.rigCF=CFrame.new(safe)*self.rigCF.Rotation
			final=self.rigCF*shake
		end
	end
	-- And never closer than the near plane allows to a solid surface the ray
	-- did not cross (a lens sliding along the wall, just short of it).
	local around=OverlapParams.new();around.FilterType=Enum.RaycastFilterType.Exclude;around.FilterDescendantsInstances=exclude
	for _,part in workspace:GetPartBoundsInRadius(final.Position,1.1,around) do
		if solid(part) then
			local p=part.CFrame:PointToObjectSpace(final.Position)
			local half=part.Size/2
			local closest=part.CFrame:PointToWorldSpace(Vector3.new(math.clamp(p.X,-half.X,half.X),math.clamp(p.Y,-half.Y,half.Y),math.clamp(p.Z,-half.Z,half.Z)))
			local away=final.Position-closest
			local gap=away.Magnitude
			if gap&lt;1.1 then
				local push=(if gap&gt;.01 then away.Unit else (focus-final.Position).Unit)*(1.1-gap)
				self.rigCF=self.rigCF+push;final=final+push
			end
		end
	end
	camera.CFrame=final
end
return Camera
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND197">
          <Properties>
            <string name="Name">ChakraFX</string>
            <ProtectedString name="Source">-- Systemic chakra on the client, the player-facing layer (convergence 3,
-- mission §4): what a planted tool is for and how long it lasts, the wire as
-- one readable object (its two ends, the line, the body it holds, its tension
-- and its charge), which projectile won a meeting and why, lightning jumping
-- into metal, the Dragon Flame running the wire, a body locked by lightning or
-- standing in fire, a burning zone's edge, and a look of its own for each
-- infused flight. One layer installed into Effects (like SandFX / LeeFX):
-- Effects keeps the base chakra drawing (sheath, trail, the planted blade,
-- the contact flashes); this layer adds what makes it readable.
-- Presentation only: nothing here can change gameplay.
--
-- (06/11, user: « Tout ce qui est chargé au chakra, on comprend pas bien,
-- c'est similaire pour beaucoup. [...] Et il faut qu'il y ait des bruits
-- pour tout ça aussi. ») Every infused flight wore the same glowing tube
-- (Effects' sheath) and flew silent; chakra contacts were silent too. The
-- sheath now takes its nature's character (lightning: a white core that
-- flickers; fire and wind: thinned so the flames / the cutting edges carry
-- the look; reinforced steel: denser), a fire blade throws embers behind
-- it, each flight is heard leaving the hand (FlightSound), every chakra
-- contact is heard in its nature (ContactSound), a wind contact sends
-- streaks of air on along its line, a fire one scatters embers, and a live
-- lightning trap, wire or locked body buzzes now and then. Sounds come only
-- from the game's own set (Effects SOUND).
local Debris=game:GetService("Debris")
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Fighters=require(Shared.Fighters)

local ChakraFX={}
local K -- Effects' helpers, handed over by install()
local FX -- the Effects class: infusion looks (FX.Infusion), models, FX:bolt
ChakraFX.clock=os.clock -- (headless tests drive time)
-- Headless tests turn this on so a drawing error fails the test; in play an
-- error is reported once and never breaks the frame or the contact feed.
ChakraFX.strict=false

local NEON=Enum.Material.Neon
local STEEL=Color3.fromRGB(214,220,230)
local SLACK=Color3.fromRGB(112,116,124)
local EMBER=Color3.fromRGB(255,138,52)
local TICKS=8 -- a planted object's life: eight ticks, one goes out per eighth
local SEGMENTS=6 -- pieces of a held wire's line (it sags as the bind runs out)

local function guard(fn,...)
	if ChakraFX.strict then return fn(...) end
	local ok,err=pcall(fn,...)
	if not ok and not ChakraFX.reported then
		ChakraFX.reported=true
		local report=warn or print
		report("[ChakraFX] "..tostring(err))
	end
	return nil
end
local function stateOf(fx)
	local st=fx.chakraLayer
	if not st then
		st={marks={},holds={},seals={},zones={},sealLife={},zoneLife={},bodies=setmetatable({},{__mode="k"})}
		fx.chakraLayer=st
	end
	return st
end
local function infusion(nature) return FX.Infusion[nature or ""] end
local function natureColor(nature)
	local look=infusion(nature)
	return if look then look.color else STEEL
end
local function lightning() return FX.Infusion.Lightning end
local function actorOf(data,id)
	if data.human and data.human.id==id then return data.human end
	if data.bot and data.bot.id==id then return data.bot end
	return nil
end
-- The owner's colour (his fighter's), so whose object it is reads at a glance.
local function ownerColor(data,id)
	local actor=actorOf(data,id)
	local def=actor and Fighters[actor.fighterId or ""]
	return if def and def.Color then Color3.fromRGB(table.unpack(def.Color)) else STEEL
end
local function find(folder,id) return folder and id and folder:FindFirstChild(id) end
-- (06/11) {sound (Effects SOUND), volume, pitch, fade}: pitch and layering
-- keep the natures apart where two share a recording.
ChakraFX.FlightSound={
	Lightning={{"electric",.3,1.45}},              -- a buzz flying with it
	Fire={{"fireLoop",.32,1.2,.45},{"whoosh",.2,.7}}, -- a burning fwoosh
	Wind={{"whooshBy",.32,1.85}},                  -- a high whistle
	Reinforce={{"swish",.3,.62}},                  -- heavy steel humming through
}
ChakraFX.ContactSound={
	shock={{"electric",.45,1}},pointshock={{"electric",.45,1.1}},wirecharge={{"electric",.4,1.2}},
	surge={{"electric",.4,1.25}},conduct={{"electric",.35,1.35}},arc={{"electric",.22,1.7}},
	ignite={{"fireLoop",.35,1.15,.45},{"boom",.2,1.7}},burn={{"fireLoop",.3,1.25,.35}},absorb={{"fireLoop",.35,1,.5},{"boom",.18,1.5}},
	wireburn={{"fireLoop",.4,.9,.6},{"whoosh",.3,.55}},dragonflame={{"fireLoop",.4,.85,.7}},dragonrun={{"fireLoop",.35,1.1,.5}},
	gust={{"whooshBy",.42,1.5}},blown={{"whooshBy",.35,1.7}},
	cut={{"swish",.45,1.75}},wirecut={{"swish",.35,1.9}},
	crush={{"heavy",.45,.85},{"rock",.3,1.2}},
	deflect={{"hit",.25,1.9}},knock={{"hit",.25,1.8}},intercept={{"hit",.28,1.7}},
	swat={{"hit",.3,1.5},{"whoosh",.2,.5}},throughguard={{"hit",.35,1.4},{"whoosh",.25,.45}},tenketsu={{"hit",.22,1.8}},
	plant={{"rock",.2,1.5}},stretch={{"swish",.2,1.2}},recover={{"swish",.18,1.5}},fizzle={{"whoosh",.15,1.8}},
}
local BUZZ={{"electric",.1,1.7}} -- a live trap, wire or locked body, now and then
-- A cue's sounds on a part (they follow it), each a hair off pitch.
local function play(parent,cue,scale)
	if not (cue and parent) then return end
	for _,s in cue do
		local id=K.SOUND[s[1]]
		if id then K.sound(parent,id,s[2]*(scale or 1),s[3]*(.96+math.random()*.08),s[4]) end
	end
end
local function emberRamp()
	return K.seq({{0,Color3.fromRGB(255,232,150)},{1,Color3.fromRGB(255,96,30)}})
end
-- (06/11) Effects' sheath is the same glowing tube on every nature: each one
-- wears it its own way. Lightning: a white core (returned, a flight flickers
-- it); fire and wind: thinned so the flames / the cutting edges carry the
-- look; reinforced steel: denser.
local function restyle(model,nature)
	local sheath=model and model:FindFirstChild("ChakraSheath")
	local look=infusion(nature)
	if not (sheath and look) then return nil end
	if nature=="Lightning" then sheath.Color=look.core;return sheath end
	if nature=="Fire" or nature=="Wind" then sheath.Transparency=.82
	elseif nature=="Reinforce" then sheath.Transparency=.42 end
	return nil
end
local function piece(parent,name,size,cf,color,transparency,shape)
	local p=K.block(parent,size,cf,color,NEON)
	p.Name=name;p.Transparency=transparency or 0
	if shape then p.Shape=shape end
	return p
end
-- A frame on a surface whose look vector is the normal: offsets in its X/Y
-- lie on the surface, -Z stands off it.
local function surfaceFrame(at,normal)
	local n=if normal and normal.Magnitude&gt;.5 then normal.Unit else Vector3.yAxis
	local ref=if math.abs(n.Y)&lt;.9 then Vector3.yAxis else Vector3.xAxis
	local r=ref:Cross(n).Unit
	return CFrame.fromMatrix(at,r,(-n):Cross(r),-n)
end
-- A short jagged arc between two points: three neon segments that fade.
local function arc(fx,name,from,to,color,width,life)
	local delta=to-from
	if delta.Magnitude&lt;.05 then return end
	local side=delta:Cross(Vector3.yAxis)
	if side.Magnitude&lt;.05 then side=Vector3.xAxis end
	side=side.Unit
	local points={from}
	for k=1,2 do table.insert(points,from+delta*(k/3)+side*(math.random()-.5)*.6+Vector3.new(0,(math.random()-.5)*.6,0)) end
	table.insert(points,to)
	for k=1,#points-1 do
		local a,b=points[k],points[k+1]
		local length=(b-a).Magnitude
		if length&gt;.02 then
			local seg=piece(fx.folder,name,Vector3.new(width,width,length),CFrame.lookAt(a:Lerp(b,.5),b),color,.1)
			K.tween(seg,life,{Transparency=1})
			Debris:AddItem(seg,life+.03)
		end
	end
end
-- Eight ticks round a point, lying on its surface.
local function tickRing(parent,name,frame,radius,color,count)
	local ticks={}
	for i=1,count do
		local cf=frame*CFrame.Angles(0,0,(i-1)/count*math.pi*2)*CFrame.new(0,radius,0)
		table.insert(ticks,piece(parent,name,Vector3.new(radius*.5,.08,.05),cf,color,.3))
	end
	return ticks
end
-- One tick goes out per share of the life gone; the last second blinks.
local function showLife(ticks,fraction,remaining,clock,on)
	local lit=math.clamp(math.ceil(fraction*#ticks-1e-6),0,#ticks)
	local blink=remaining&lt;1 and math.sin(clock*24)&lt;0
	for i,t in ticks do t.Transparency=if i&lt;=lit and not blink then on or .3 else 1 end
end
local function fadeAway(model,time)
	if not model then return end
	for _,d in model:GetDescendants() do
		if d:IsA("BasePart") then K.tween(d,time,{Transparency=1}) end
	end
	Debris:AddItem(model,time+.05)
end

-- ------------------------------------------------------------------ marks
-- A planted blade's mark. Meanings, as this player sees them: his own blade
-- (walk over it for chakra: a floating diamond), the other fighter's blade
-- (trample it to deny it: a cross), a live charge (a shock trap: a bolt, in
-- the lightning's colour, whoever planted it). Ticks in the owner's colour
-- count its life down. A stretched wire gets a ring at each end (its stake and
-- its blade), and crackles along its length while charged.
local function setGlyph(fx,mark,meaning,color)
	if mark.glyph then mark.glyph:Destroy() end
	local holder=K.new("Model",{Name="MarkGlyph"},mark.model)
	local frame=mark.frame
	mark.meaning=meaning;mark.glyph=holder;mark.glyphParts={}
	if meaning=="pickup" then
		local gem=piece(holder,"MarkPickup",Vector3.one*.32,frame*CFrame.new(0,0,-1.2)*CFrame.Angles(math.rad(45),math.rad(35),0),color,.15)
		table.insert(mark.glyphParts,gem)
	elseif meaning=="deny" then
		for _,angle in {45,-45} do
			table.insert(mark.glyphParts,piece(holder,"MarkDeny",Vector3.new(.75,.09,.06),frame*CFrame.new(0,0,-.9)*CFrame.Angles(0,0,math.rad(angle)),color,.25))
		end
	elseif meaning=="shock" then
		local core=lightning().core
		local zig={Vector3.new(-.16,0,-.7),Vector3.new(.14,0,-1.05),Vector3.new(-.1,0,-1.3),Vector3.new(.16,0,-1.7)}
		for k=1,#zig-1 do
			local a=(frame*CFrame.new(zig[k])).Position
			local b=(frame*CFrame.new(zig[k+1])).Position
			table.insert(mark.glyphParts,piece(holder,"MarkShock",Vector3.new(.09,.09,(b-a).Magnitude),CFrame.lookAt(a:Lerp(b,.5),b),core,.1))
		end
	end
end
local function buildMark(fx,data,p)
	local color=ownerColor(data,p.owner)
	local model=K.new("Model",{Name="ChakraMark"},fx.folder)
	if p.planted=="wire" then
		local tip=p.origin+p.direction*(p.range or 0)
		local mark={model=model,wire=true,color=color,origin=p.origin,tip=tip,frame=surfaceFrame(p.origin,Vector3.yAxis)}
		mark.ticks=tickRing(model,"WireEnd",mark.frame,.8,color,TICKS)
		mark.tipTicks=tickRing(model,"WireEnd",surfaceFrame(tip,Vector3.yAxis),.6,color,TICKS)
		return mark
	end
	local frame=surfaceFrame(p.origin,p.normal)
	local mark={model=model,color=color,frame=frame,born=ChakraFX.clock()}
	mark.ticks=tickRing(model,"LifeTick",frame,1.05,color,TICKS)
	return mark
end
local function stepMarks(fx,st,data,now,clock,dt)
	local live={}
	local viewer=data.human and data.human.id
	for _,p in data.projectiles or {} do
		if p.planted and p.planted~="held" and p.expires and p.origin then
			live[p.id]=true
			local mark=st.marks[p.id]
			if not mark then
				mark=buildMark(fx,data,p);st.marks[p.id]=mark
				-- (06/11) a planted infused blade wears its nature's sheath too
				local entry=p.infusion and fx.projectiles and fx.projectiles[p.id]
				if entry then restyle(entry.model,p.infusion) end
			end
			local charged=(p.charged or 0)&gt;now
			local life=math.max(.05,p.expires-(p.born or now))
			local remaining=math.max(0,p.expires-now)
			showLife(mark.ticks,remaining/life,remaining,clock)
			if mark.wire then
				showLife(mark.tipTicks,remaining/life,remaining,clock)
				-- A live wire crackles along its length (Effects lights the line).
				if charged and clock&gt;=(mark.nextArc or 0) then
					mark.nextArc=clock+.07
					local at=mark.origin:Lerp(mark.tip,math.random())
					local side=(mark.tip-mark.origin):Cross(Vector3.yAxis)
					side=if side.Magnitude&gt;.05 then side.Unit*.45 else Vector3.xAxis*.45
					arc(fx,"WireCrackle",at-side,at+side+Vector3.new(0,.4,0),lightning().core,.06,.08)
				end
				-- (06/11) and is heard
				if charged and clock&gt;=(mark.nextBuzz or 0) then
					mark.nextBuzz=clock+.7+math.random()*.4
					play(mark.ticks[1],BUZZ)
				end
			else
				local meaning=if charged or p.mark=="shock" then "shock" elseif p.owner==viewer then "pickup" else "deny"
				if meaning~=mark.meaning then setGlyph(fx,mark,meaning,mark.color) end
				local t=clock-mark.born
				if meaning=="pickup" then
					-- His chakra waiting for him: the diamond bobs and turns.
					local gem=mark.glyphParts[1]
					if gem then gem.CFrame=mark.frame*CFrame.new(0,0,-1.2-math.sin(t*3)*.15)*CFrame.Angles(math.rad(45),t*2,0) end
				elseif meaning=="shock" then
					for _,part in mark.glyphParts do part.Transparency=if math.random()&lt;.3 then .6 else .05 end
					if clock&gt;=(mark.nextArc or 0) then
						mark.nextArc=clock+.12
						local a=(mark.frame*CFrame.Angles(0,0,math.random()*math.pi*2)*CFrame.new(0,1.05,0)).Position
						arc(fx,"MarkArc",a,mark.frame.Position,lightning().core,.05,.08)
					end
					-- (06/11) a live trap buzzes now and then
					if clock&gt;=(mark.nextBuzz or 0) then
						mark.nextBuzz=clock+.8+math.random()*.5
						play(mark.glyphParts[1] or mark.ticks[1],BUZZ)
					end
				end
			end
		end
	end
	for id,mark in st.marks do
		if not live[id] then fadeAway(mark.model,.15);st.marks[id]=nil end
	end
end

-- ------------------------------------------------------------------ the held wire
-- A wire holding a body (row planted "held"): from the thrower's hand (or the
-- stake of the stretched wire that caught it, then on to its blade) to the
-- body. Taut while the bind is fresh, it sags and dims as the bind runs out
-- (a current tightens it again); charged, it turns to lightning and crackles.
local function buildHold(fx,p)
	local model=K.new("Model",{Name="HeldWire"},fx.folder)
	local hold={model=model,segments={}}
	for k=1,(if p.anchored then SEGMENTS*2 else SEGMENTS) do
		table.insert(hold.segments,piece(model,"HeldWireSegment",Vector3.new(.07,.07,.5),CFrame.new(p.origin),STEEL,0))
	end
	hold.knot=piece(model,"HeldWireEnd",Vector3.one*.3,CFrame.new(p.origin),STEEL,.2,Enum.PartType.Ball)
	if p.anchored then
		-- Still tied to its stake and its blade: the body pulled the line into a V.
		local stake=FX.buildKunai(false);stake.Name="WireStake";stake.Parent=model
		stake:PivotTo(CFrame.lookAt(p.origin+Vector3.new(0,.35,0),p.origin-Vector3.new(0,1,0)))
		local tip=p.origin+p.direction*(p.range or 0)
		local blade=FX.buildShuriken();blade.Name="WireBlade";blade.Parent=model
		blade:PivotTo(CFrame.lookAt(tip,tip+p.direction)*CFrame.Angles(math.rad(80),0,0))
	end
	return hold
end
local function curve(segments,first,last,from,to,sag,color,width,transparency)
	local count=last-first+1
	for k=first,last do
		local u0,u1=(k-first)/count,(k-first+1)/count
		local a=from:Lerp(to,u0)-Vector3.new(0,sag*4*u0*(1-u0),0)
		local b=from:Lerp(to,u1)-Vector3.new(0,sag*4*u1*(1-u1),0)
		local seg=segments[k]
		local length=(b-a).Magnitude
		if length&gt;.02 then
			seg.Size=Vector3.new(width,width,length)
			seg.CFrame=CFrame.lookAt(a:Lerp(b,.5),b)
		end
		seg.Color=color;seg.Transparency=transparency
	end
end
local function stepHolds(fx,st,data,now,clock,folder)
	local live={}
	for _,p in data.projectiles or {} do
		if p.planted=="held" and p.origin then
			live[p.id]=true
			local hold=st.holds[p.id]
			if not hold then hold=buildHold(fx,p);st.holds[p.id]=hold end
			local victim=find(folder,p.holds)
			local chest=victim and (victim:FindFirstChild("UpperTorso") or victim:FindFirstChild("HumanoidRootPart"))
			local tip=p.origin+p.direction*(p.range or 0)
			local body=if chest then chest.Position elseif p.anchored then p.origin:Lerp(tip,.5) else tip
			local start=p.origin
			if not p.anchored then
				local owner=find(folder,p.owner)
				local hand=owner and owner:FindFirstChild("RightHand")
				if hand then start=hand.Position end
			end
			-- Tension: the share of the bind still to come (its life is the bind).
			local total=math.max(.05,(p.expires or now)-(p.born or now))
			local tension=math.clamp(((p.expires or now)-now)/total,0,1)
			local charged=(p.charged or 0)&gt;now
			local color=if charged then lightning().core else SLACK:Lerp(STEEL,tension)
			local width=if charged then .1+math.random()*.06 else .05+.03*tension
			local transparency=if charged then 0 else .1+(1-tension)*.35
			local slack=(1-tension)*.12
			curve(hold.segments,1,SEGMENTS,start,body,(start-body).Magnitude*slack,color,width,transparency)
			if p.anchored then curve(hold.segments,SEGMENTS+1,SEGMENTS*2,body,tip,(body-tip).Magnitude*slack,color,width,transparency) end
			hold.knot.CFrame=CFrame.new(start);hold.knot.Color=ownerColor(data,p.owner)
			if charged and clock&gt;=(hold.nextArc or 0) then
				hold.nextArc=clock+.05
				local at=start:Lerp(body,math.random())
				arc(fx,"WireCurrent",at,at+Vector3.new(math.random()-.5,math.random()-.5,math.random()-.5),lightning().core,.05,.07)
			end
			-- (06/11) the current is heard along the line
			if charged and clock&gt;=(hold.nextBuzz or 0) then
				hold.nextBuzz=clock+.6
				play(hold.knot,BUZZ,1.4)
			end
		end
	end
	for id,hold in st.holds do
		if not live[id] then fadeAway(hold.model,.12);st.holds[id]=nil end
	end
end

-- ------------------------------------------------------------------ seals and zones
-- Minato's planted seal kunai: ticks round the seal in his colour count its
-- life down (the seal's own glyph is Effects'). A burning zone: ember ticks
-- on its exact edge, going out as it burns down.
local function stepSeals(fx,st,data,now,clock)
	local live={}
	for _,key in {"human","bot"} do
		local actor=data[key]
		for _,info in (actor and actor.seals) or {} do
			-- (06/11, user: « les kunai marqués de Minato, il y a un cercle
			-- bizarre ») The ring of ticks round a planted seal read as a
			-- strange halo; the seal's life now shows on its own glyph
			-- (Effects), no ring. ChakraFX.SealTicks=true brings it back.
			if ChakraFX.SealTicks and info.surface and not info.body then
				local id=tostring(actor.id)..":"..tostring(info.id)
				live[id]=true
				local ring=st.seals[id]
				if not ring then
					local model=K.new("Model",{Name="SealLife"},fx.folder)
					ring={model=model,ticks=tickRing(model,"SealTick",surfaceFrame(info.surface,info.normal),2.1,ownerColor(data,actor.id),TICKS)}
					st.seals[id]=ring
				end
				-- The full life is the longest remaining time seen for this seal.
				st.sealLife[id]=math.max(st.sealLife[id] or 0,info.remaining or 0)
				showLife(ring.ticks,(info.remaining or 0)/math.max(.05,st.sealLife[id]),info.remaining or 0,clock)
			end
		end
	end
	for id,ring in st.seals do
		if not live[id] then fadeAway(ring.model,.15);st.seals[id]=nil;st.sealLife[id]=nil end
	end
end
local function stepZones(fx,st,data,clock)
	local live={}
	for _,h in data.hazards or {} do
		-- (06/11, user: « le feu, la bande avec un contour jaune ») The ember
		-- ticks on every burning patch's edge strung Itachi's lane into a band
		-- outlined in yellow; the fire and its charred ground (Effects) show
		-- the zone now. ChakraFX.BurnTicks=true brings the ring back.
		if ChakraFX.BurnTicks and h.kind=="Fire" and h.position then
			local key=string.format("%.1f:%.1f:%.1f",h.position.X,h.position.Y,h.position.Z)
			live[key]=true
			local zone=st.zones[key]
			if not zone then
				local ok,floor=pcall(K.floorUnder,fx,h.position,3,14)
				local at=if ok and floor then floor.Position+Vector3.new(0,.06,0) else h.position
				local model=K.new("Model",{Name="BurnZone"},fx.folder)
				zone={model=model,ticks=tickRing(model,"BurnEdge",surfaceFrame(at,Vector3.yAxis),h.radius,EMBER,12)}
				st.zones[key]=zone
			end
			st.zoneLife[key]=math.max(st.zoneLife[key] or 0,h.remaining or 0)
			showLife(zone.ticks,(h.remaining or 0)/math.max(.05,st.zoneLife[key]),h.remaining or 0,clock,.5)
		end
	end
	for key,zone in st.zones do
		if not live[key] then fadeAway(zone.model,.2);st.zones[key]=nil;st.zoneLife[key]=nil end
	end
end

-- ------------------------------------------------------------------ flights
-- Each infused flight reads apart from the plain throw: the wind kunai grows
-- two thin edges of cutting air past its point, reinforced steel a dense
-- outer shell, a lightning blade throws small arcs behind it (Effects adds
-- the sheath, the trail and the flames).
local function decorate(fx,entry)
	entry.chakraLook=true
	local nature=entry.data.infusion
	local kind=entry.data.kind
	local root=entry.root
	local made={}
	local blade=kind=="kunai" or kind=="marked"
	if nature=="Wind" and blade then
		local core=infusion("Wind").core
		for _,side in {-1,1} do
			table.insert(made,piece(entry.model,"WindEdge",Vector3.new(.03,.12,1.5),root.CFrame*CFrame.new(side*.17,0,-.75)*CFrame.Angles(0,side*math.rad(7),0),core,.35))
		end
	elseif nature=="Reinforce" and (blade or kind=="shuriken") then
		-- A sleeve round a kunai, a disc round a shuriken (Gaara's sand keeps its own look).
		local shell=if blade then piece(entry.model,"SteelWeight",Vector3.new(1.6,.52,.52),root.CFrame*CFrame.new(0,0,-.2)*CFrame.Angles(0,math.pi/2,0),infusion("Reinforce").color,.78)
			else piece(entry.model,"SteelWeight",Vector3.new(.26,1.45,1.45),root.CFrame*CFrame.Angles(0,0,math.pi/2),infusion("Reinforce").color,.8)
		shell.Shape=Enum.PartType.Cylinder
		table.insert(made,shell)
	end
	if #made&gt;0 then
		K.weldAll(root,made)
		for _,part in made do part.LocalTransparencyModifier=if entry.hidden then 1 else 0 end
	end
	-- (06/11) its sheath in its nature's way (lightning's flickers in flight)
	entry.chakraSheath=restyle(entry.model,nature)
	if nature=="Fire" then
		-- embers shed behind the burning blade, left hanging in its wake
		local at=K.new("Attachment",{Name="ChakraEmbers",Position=Vector3.new(0,0,.3)},root)
		entry.chakraEmbers=K.new("ParticleEmitter",{Name="Embers",Enabled=false,Texture=K.TEX.fireSpark,Rate=40,Lifetime=NumberRange.new(.3,.55),
			Speed=NumberRange.new(1,3),SpreadAngle=Vector2.new(180,180),Acceleration=Vector3.new(0,5,0),Drag=2,LightEmission=1,LightInfluence=0,
			Color=emberRamp(),Size=K.num({{0,.3},{1,.05}}),ZOffset=.5},at)
	end
end
local function stepFlights(fx,clock)
	for _,entry in fx.projectiles do
		local p=entry.data
		if not entry.static and p and p.infusion and entry.root and entry.model then
			if not entry.chakraLook then decorate(fx,entry) end
			-- (06/11) heard as it leaves the hand, the sound flying with it
			if not entry.hidden and not entry.chakraHeard then
				entry.chakraHeard=true
				play(entry.root,ChakraFX.FlightSound[p.infusion])
			end
			if entry.chakraEmbers then entry.chakraEmbers.Enabled=not entry.hidden end
			if entry.chakraSheath and not entry.hidden then entry.chakraSheath.Transparency=if math.random()&lt;.35 then .85 else .3 end
			if p.infusion=="Lightning" and not entry.hidden and clock&gt;=(entry.nextArc or 0) then
				entry.nextArc=clock+.05
				local back=entry.root.CFrame.LookVector*-1.4
				local at=entry.root.Position
				arc(fx,"FlightArc",at,at+back+Vector3.new(math.random()-.5,math.random()-.5,math.random()-.5)*.6,lightning().core,.05,.06)
			end
		end
	end
end

-- ------------------------------------------------------------------ contacts
-- Who won a meeting, and why (ChakraCombat sends it with the loser's impact):
-- the winner flashes in its nature's colour where it flies on; a nature
-- advantage shows the winning colour closing over the losing one; a cut blade
-- falls in two halves; weight shows as a short hard ring.
local function halves(fx,impact)
	local at=impact.position
	local across=(impact.direction or Vector3.zAxis):Cross(Vector3.yAxis)
	across=if across.Magnitude&gt;.05 then across.Unit else Vector3.xAxis
	for _,side in {-1,1} do
		local half=K.block(fx.folder,Vector3.new(.1,.08,.42),CFrame.lookAt(at,at+across*side),Color3.fromRGB(150,158,170),Enum.Material.Metal)
		half.Name="CutHalf"
		K.tween(half,.4,{CFrame=CFrame.new(at+across*side*1.6+Vector3.new(0,-1.8,0))*CFrame.Angles(math.random()*6,math.random()*6,0),Transparency=1})
		Debris:AddItem(half,.45)
	end
end
local function explain(fx,impact)
	local at=impact.position
	local color=natureColor(impact.winnerNature)
	local entry=impact.winner and fx.projectiles[impact.winner]
	if entry and entry.root and entry.model then
		local glow=piece(entry.model,"WinnerFlash",Vector3.one*1.1,entry.root.CFrame,color,.15,Enum.PartType.Ball)
		K.weldAll(entry.root,{glow})
		K.tween(glow,.24,{Size=Vector3.one*2.6,Transparency=1})
		Debris:AddItem(glow,.3)
	elseif impact.winner then
		-- Not drawn yet on this client: the flash where it won.
		local glow=piece(fx.folder,"WinnerFlash",Vector3.one*1.1,CFrame.new(at),color,.15,Enum.PartType.Ball)
		K.tween(glow,.2,{Size=Vector3.one*2.6,Transparency=1})
		Debris:AddItem(glow,.25)
	end
	local reason=impact.reason
	if reason=="nature" then
		K.shockRing(fx.folder,at,color,1,8,.26,impact.direction)
		local lost=piece(fx.folder,"NatureVersus",Vector3.one*1.4,CFrame.new(at),natureColor(impact.loserNature),.1,Enum.PartType.Ball)
		K.tween(lost,.22,{Size=Vector3.one*.1,Transparency=1})
		Debris:AddItem(lost,.26)
	elseif reason=="cut" then
		halves(fx,impact)
	elseif reason=="weight" or reason=="steel" then
		K.shockRing(fx.folder,at,color,.6,4,.16,impact.direction)
	end
end
-- Lightning jumping into metal (ChakraCombat charge / spread).
local function arcInto(fx,impact)
	local from,to=impact.from or impact.position,impact.to or impact.position
	if (to-from).Magnitude&gt;.1 then FX.bolt(fx,from,to,lightning().core) end
	local spark=piece(fx.folder,"ArcFlash",Vector3.one*.5,CFrame.new(to),lightning().color,.1,Enum.PartType.Ball)
	K.tween(spark,.16,{Size=Vector3.one*2.2,Transparency=1})
	Debris:AddItem(spark,.2)
end
-- The Dragon Flame runs the wire from the hand (or its stake) to the body;
-- Effects draws the blast on the body.
local function dragonFlame(fx,impact)
	local from,to=impact.from or impact.position,impact.to or impact.position
	local length=(to-from).Magnitude
	if length&lt;.1 then return end
	local line=piece(fx.folder,"DragonFlameRun",Vector3.new(.35,.35,length),CFrame.lookAt(from:Lerp(to,.5),to),EMBER,.15)
	K.tween(line,.35,{Size=Vector3.new(.05,.05,length),Transparency=1})
	Debris:AddItem(line,.4)
	local fire=infusion("Fire")
	for k=0,5 do
		local at=from:Lerp(to,k/5)
		task.delay(k*.025,function()
			if not fx.folder.Parent then return end
			K.burst(fx.folder,at,{Texture=K.TEX.fire,Lifetime=NumberRange.new(.18,.32),Speed=NumberRange.new(2,5),SpreadAngle=Vector2.new(180,180),
				Color=K.seq({{0,fire.core},{.5,fire.color},{1,Color3.fromRGB(90,24,10)}}),LightEmission=1,Size=K.num({{0,1.6},{1,.4}}),
				Transparency=K.num({{0,.15},{1,1}})},6)
		end)
	end
end
-- (06/11, user: « le katon ne suit pas les fils de Sasuke ») The flame runs
-- the wire: a head of fire travels from his mouth to the body in `travel`
-- seconds, the wire behind it glowing and burning away, fire shed along it.
local FLAME_HOT=Color3.fromRGB(255,176,64)
local FLAME=Color3.fromRGB(240,84,24)
local FLAME_END=Color3.fromRGB(70,22,10)
local WIRE_HOT=Color3.fromRGB(226,92,30)
local WIRE_ASH=Color3.fromRGB(52,34,28)
-- The held wire as stepHolds draws it this frame (its sagging segments, hand
-- to chest), as a list of points; nil when no drawn wire starts near `near`.
local function drawnWire(fx,near)
	for _,model in fx.folder:GetChildren() do
		if model.Name=="HeldWire" then
			local points={}
			local count=0
			for _,seg in model:GetChildren() do
				if seg.Name=="HeldWireSegment" then
					count+=1
					if count&gt;SEGMENTS then break end
					local half=seg.CFrame.LookVector*seg.Size.Z/2
					if #points==0 then table.insert(points,seg.Position-half) end
					table.insert(points,seg.Position+half)
				end
			end
			if #points&gt;=2 and (points[1]-near).Magnitude&lt;2.5 then return points end
		end
	end
	return nil
end
-- The point at share k (0..1) of a polyline's length, and the index of the
-- piece it lies on.
local function alongLine(points,k)
	local total=0
	for n=1,#points-1 do total+=(points[n+1]-points[n]).Magnitude end
	local left=total*k
	for n=1,#points-1 do
		local piece=(points[n+1]-points[n]).Magnitude
		if left&lt;=piece or n==#points-1 then return points[n]:Lerp(points[n+1],if piece&gt;0 then math.clamp(left/piece,0,1) else 1),n end
		left-=piece
	end
	return points[#points],#points-1
end
local function dragonRun(fx,impact,folder)
	local from,to=impact.from or impact.position,impact.to or impact.position
	-- (Studio 06/11: the fire ran mouth -&gt; hips, beside the wire drawn hand -&gt;
	-- chest) The run follows the wire as stepHolds draws it, sag included:
	-- from his right hand (or the stake the wire is tied to) to the chest.
	local owner=find(folder,impact.owner)
	local hand=owner and owner:FindFirstChild("RightHand")
	if hand and (hand.Position-from).Magnitude&lt;4 then from=hand.Position else hand=nil end
	local victim=find(folder,impact.victim)
	local chest=victim and (victim:FindFirstChild("UpperTorso") or victim:FindFirstChild("HumanoidRootPart"))
	if chest then to=chest.Position end
	local length=(to-from).Magnitude
	if length&lt;.1 then return end
	local travel=math.max(.1,impact.travel or .3)
	local holder=K.new("Model",{Name="DragonFlameRun"},fx.folder)
	-- (Studio 06/11: a white neon ball and a yellow bar read as a laser) The
	-- head is flame (a running emitter, an orange light), the wire behind it
	-- red-hot, cooling to ash.
	local head=piece(holder,"Head",Vector3.one*.2,CFrame.new(from),FLAME,1)
	K.new("ParticleEmitter",{Texture=K.TEX.fire,Rate=200,Lifetime=NumberRange.new(.16,.34),Speed=NumberRange.new(1,3),SpreadAngle=Vector2.new(180,180),
		-- (07/11, Studio, daylight: the head faded through dark brown and read as
		-- smoke) it stays flame-coloured and fades out instead.
		Color=K.seq({{0,FLAME_HOT},{.6,FLAME},{1,FLAME}}),LightEmission=.8,LightInfluence=0,Size=K.num({{0,2.4},{1,.5}}),
		Transparency=K.num({{0,.1},{1,1}}),RotSpeed=NumberRange.new(-120,120),Rotation=NumberRange.new(0,360)},head)
	-- (07/11, Studio, mid-run: the front read as dark smoke, the head was lost
	-- in its own trail) a hot core at the front, the eye goes to it.
	K.new("ParticleEmitter",{Texture=K.TEX.glow,Rate=70,Lifetime=NumberRange.new(.08,.14),Speed=NumberRange.new(0,.5),
		Color=ColorSequence.new(FLAME_HOT,FLAME),LightEmission=1,LightInfluence=0,Size=K.num({{0,1.8},{1,1.1}}),
		Transparency=K.num({{0,.15},{1,.8}})},head)
	K.new("PointLight",{Color=FLAME,Brightness=3,Range=12,Shadows=false},head)
	local burnt={}
	for n=1,SEGMENTS do
		local b=piece(holder,"Burnt",Vector3.new(.09,.09,.05),CFrame.new(from),WIRE_HOT,1)
		burnt[n]=b
	end
	local born=os.clock()
	local shed=0
	task.spawn(function()
		while holder.Parent do
			local k=math.clamp((os.clock()-born)/travel,0,1)
			-- (both ends live: the wire is drawn from where the hand is now)
			if chest and chest.Parent then to=chest.Position end
			if hand and hand.Parent then from=hand.Position end
			local points=drawnWire(fx,from) or {from,to}
			local at,on=alongLine(points,k)
			head.CFrame=CFrame.new(at)
			-- the wire burnt up to the head
			for n=1,SEGMENTS do
				local b=burnt[n]
				local a0=points[n]
				local a1=if n&lt;on then points[n+1] elseif n==on then at else nil
				if a0 and a1 and (a1-a0).Magnitude&gt;.03 then
					b.Size=Vector3.new(.09,.09,(a1-a0).Magnitude);b.CFrame=CFrame.lookAt(a0:Lerp(a1,.5),a1);b.Transparency=.05
				else b.Transparency=1 end
			end
			-- fire shed along the wire as the head passes
			while shed&lt;k do
				local p=alongLine(points,shed)
				K.burst(fx.folder,p,{Texture=K.TEX.fire,Lifetime=NumberRange.new(.25,.45),Speed=NumberRange.new(1,3),SpreadAngle=Vector2.new(180,180),
					Acceleration=Vector3.new(0,6,0),Color=K.seq({{0,FLAME_HOT},{.5,FLAME},{1,FLAME_END}}),LightEmission=.6,LightInfluence=0,
					Size=K.num({{0,1.1},{1,.3}}),Transparency=K.num({{0,.1},{1,1}})},3)
				shed+=1/math.max(4,math.floor(length/1.6))
			end
			if k&gt;=1 then break end
			task.wait()
		end
		if holder.Parent then
			local e=head:FindFirstChildOfClass("ParticleEmitter")
			if e then e.Enabled=false end
			for _,b in burnt do
				if b.Transparency&lt;1 then b.Material=Enum.Material.SmoothPlastic;K.tween(b,.5,{Color=WIRE_ASH,Transparency=1}) end
			end
			Debris:AddItem(holder,.6)
		end
	end)
end
-- (06/11) A wind contact: streaks of air carried on along its line.
local function windPast(fx,impact)
	local at=impact.position
	local dir=impact.direction or Vector3.zAxis
	if dir.Magnitude&lt;.05 then return end
	dir=dir.Unit
	local holder=K.anchorPart(fx.folder,at)
	if math.abs(dir.Y)&lt;.95 then holder.CFrame=CFrame.lookAt(at,at+dir)*CFrame.Angles(-math.pi/2,0,0) end
	local wind=infusion("Wind")
	local e=K.new("ParticleEmitter",{Enabled=false,LightInfluence=0,ZOffset=1,Texture=K.TEX.spark,Orientation=Enum.ParticleOrientation.VelocityParallel,
		Lifetime=NumberRange.new(.1,.16),Speed=NumberRange.new(30,46),SpreadAngle=Vector2.new(16,16),
		Color=ColorSequence.new(if wind then wind.core else STEEL),LightEmission=1,Size=K.num({{0,.45},{1,.1}}),
		Squash=K.num({{0,-1.4},{1,-1.8}}),Transparency=K.num({{0,0},{1,.6}}),Drag=8},K.new("Attachment",{},holder))
	e:Emit(8)
	Debris:AddItem(holder,1)
end
-- (06/11) A fire contact: embers scattered off the body.
local function embersAt(fx,at)
	K.burst(fx.folder,at,{Texture=K.TEX.fireSpark,Lifetime=NumberRange.new(.5,.9),Speed=NumberRange.new(5,10),SpreadAngle=Vector2.new(180,180),
		Acceleration=Vector3.new(0,6,0),Drag=2.5,LightEmission=1,Color=emberRamp(),Size=K.num({{0,.35},{1,.05}})},10)
end
local function drawImpact(fx,impact,folder)
	if impact.reason then explain(fx,impact) end
	local kind=impact.chakra
	if kind=="arc" then arcInto(fx,impact)
	elseif kind=="dragonflame" then dragonFlame(fx,impact)
	elseif kind=="dragonrun" then dragonRun(fx,impact,folder)
	elseif kind=="gust" or kind=="blown" then windPast(fx,impact)
	elseif kind=="ignite" or kind=="absorb" then embersAt(fx,impact.position) end
	-- (06/11) every chakra contact is heard in its nature
	local cue=kind and ChakraFX.ContactSound[kind]
	if cue and impact.position then play(K.anchorPart(fx.folder,impact.position),cue,if impact.heavy then 1.15 else 1) end
end
local function impact(fx,data,folder)
	if data.chakra or data.reason then guard(drawImpact,fx,data,folder) end
	return false -- Effects still draws its own part of the contact
end

-- ------------------------------------------------------------------ bodies
-- Locked by lightning (snapshot `shocked`: exactly the lengthened stun or the
-- bind the current extended): arcs crawl over the body. Standing in fire
-- (`burning`: while burn ticks land): small flames at the legs. Restrained:
-- one light and a few arcs, a handful of flames.
local function body(fx,model,actor)
	local st=stateOf(fx)
	local b=st.bodies[model]
	if not b then b={};st.bodies[model]=b end
	local torso=model:FindFirstChild("UpperTorso") or model:FindFirstChild("HumanoidRootPart")
	if not torso then return end
	local clock=ChakraFX.clock()
	local alive=(actor.health or 1)&gt;0
	if alive and (actor.shocked or 0)&gt;0 then
		if not (b.shock and b.shock.Parent) then
			b.shock=K.new("PointLight",{Name="ShockLight",Color=lightning().color,Brightness=2,Range=8,Shadows=false},torso)
		end
		b.shock.Brightness=1+math.random()*2.5
		if clock&gt;=(b.nextArc or 0) then
			b.nextArc=clock+.06
			local center=torso.Position
			local offset=Vector3.new(math.random()-.5,math.random()-.5,math.random()-.5)*2.4
			arc(fx,"ShockArc",center+offset,center-offset*.6,lightning().core,.06,.08)
		end
		-- (06/11) the locked body buzzes
		if clock&gt;=(b.nextBuzz or 0) then
			b.nextBuzz=clock+.5+math.random()*.3
			play(torso,BUZZ,1.3)
		end
	elseif b.shock then
		b.shock:Destroy();b.shock=nil
	end
	local feet=model:FindFirstChild("LowerTorso") or torso
	if alive and (actor.burning or 0)&gt;0 then
		if not (b.burn and b.burn.Parent) then
			local at=K.new("Attachment",{Name="BurnFlames",Position=Vector3.new(0,-.7,0)},feet)
			local fire=infusion("Fire")
			K.new("ParticleEmitter",{Texture=K.TEX.fire,Rate=16,Lifetime=NumberRange.new(.2,.4),Speed=NumberRange.new(2,4),SpreadAngle=Vector2.new(25,25),
				EmissionDirection=Enum.NormalId.Top,Color=K.seq({{0,fire.core},{.6,fire.color},{1,Color3.fromRGB(90,24,10)}}),LightEmission=1,LightInfluence=0,
				Size=K.num({{0,.9},{1,.2}}),Transparency=K.num({{0,.25},{1,1}})},at)
			K.new("PointLight",{Color=fire.color,Brightness=1.4,Range=7,Shadows=false},at)
			b.burn=at
			-- (06/11) the flames catch with a crackle
			play(feet,{{"fireLoop",.22,1.1,.6}})
		end
	elseif b.burn then
		b.burn:Destroy();b.burn=nil
	end
end
local function fighter(fx,model,actor,_dt)
	if not model or not actor then return end
	guard(body,fx,model,actor)
end

-- ------------------------------------------------------------------ per frame
local function clear(st)
	for _,list in {st.marks,st.holds,st.seals,st.zones} do
		for key,entry in list do
			if entry.model then entry.model:Destroy() end
			list[key]=nil
		end
	end
	table.clear(st.sealLife);table.clear(st.zoneLife)
	for model,b in st.bodies do
		if b.shock then b.shock:Destroy() end
		if b.burn then b.burn:Destroy() end
		st.bodies[model]=nil
	end
end
local function frame(fx,data,dt,folder)
	local st=stateOf(fx)
	if not data or data.phase~="Duel" then clear(st);st.epoch=nil;return end
	if st.epoch~=data.epoch then clear(st);st.epoch=data.epoch end
	local now=workspace:GetServerTimeNow()
	local clock=ChakraFX.clock()
	stepMarks(fx,st,data,now,clock,dt)
	stepHolds(fx,st,data,now,clock,folder)
	stepSeals(fx,st,data,now,clock)
	stepZones(fx,st,data,clock)
	stepFlights(fx,clock)
end
local function step(fx,data,dt,folder)
	guard(frame,fx,data,dt,folder)
end

function ChakraFX.install(EffectsFX,kit)
	K=kit;FX=EffectsFX
	table.insert(FX.layers,{name="Chakra",impact=impact,fighter=fighter,step=step})
end
return ChakraFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND198">
          <Properties>
            <string name="Name">ChakraFlowFX</string>
            <ProtectedString name="Source">-- ChakraFlow on the client (Freedom, user 28/10: chakra infusions): the load
-- (the body glows in its nature, chakra rising off it), the infused limbs
-- while the strike is out, the nature on contact, the leap and the dash.
-- Presentation only: the server (Server/ChakraFlow) decides everything.
-- One layer installed into Effects (like LeeFX): Effects only offers helpers.
--
-- (06/11, user: « Tout ce qui est chargé au chakra, on comprend pas bien,
-- c'est similaire pour beaucoup. Il faut vraiment qu'il y ait des
-- différences. Et il faut qu'il y ait des bruits pour tout ça aussi. ») Every
-- nature rose off the body as the same flame texture, poured off the four
-- limbs as the same particles and flashed the same way on contact: only the
-- colour changed, and only lightning's contact made a sound. Each nature now
-- has its own shapes and its own sounds, at the load, on the limbs while the
-- strike is out, on contact, at the leap and at the dash:
--   Lightning   sparks crackling off the body, jagged arcs jumping across it,
--               a strobing light; electric crackle, a buzz while loaded
--   Fire        flames licking off the torso, embers drifting up, firelight
--               flicker; a crackle loop while lit, a fiery whump on contact
--   Wind        pale rings of air climbing the body, a spiral at the feet,
--               cutting trails on the limbs, an X of air cuts on contact;
--               high whistles
--   Sand        matte grains pouring off the shoulders, a dusty shell, dust
--               drifting at the feet (no glow); a grinding hiss
--   GentleFist  the chakra in the palms only, veins of light down the arms,
--               points twinkling on the body, a needle of chakra through the
--               body on contact; a deep hum and a crisp tap
--   Strength    (Lee cannot mould chakra) no glow at all: steam off the
--               body, sweat flicked off, the feet stamping dust; heavy thumps
--   Chakra      a clean blue glow hugging the body, smooth wisps (Minato and
--               any fighter without a nature); a clean resonant whoosh
--   Earth       (Kakashi's Doton spike) pebbles, rock dust, a crack; rock
--               and rumble
-- Restrained like look pass 2: the body and its colours stay readable inside.
-- Sounds come only from the game's own set (Effects SOUND), told apart by
-- pitch and layering.
local Debris=game:GetService("Debris")
local Kit=require(script.Parent.VfxKit)

local ChakraFlowFX={}
local K -- Effects' helpers, handed over by install()

ChakraFlowFX.Color={
	Lightning=Color3.fromRGB(150,205,255),Fire=Color3.fromRGB(255,124,44),Wind=Color3.fromRGB(176,255,226),
	Sand=Color3.fromRGB(218,184,116),GentleFist=Color3.fromRGB(196,216,255),Strength=Color3.fromRGB(255,196,90),
	Chakra=Color3.fromRGB(110,172,255),Earth=Color3.fromRGB(138,112,84),
}
local CORE=Color3.fromRGB(250,252,255)
local NEON=Enum.Material.Neon
local DUST=Color3.fromRGB(206,194,168)
local LIMBS={"RightHand","LeftHand","RightFoot","LeftFoot"}
local HANDS={"RightHand","LeftHand"}
-- Where a lightning arc may jump from on a loaded body.
local ARC_FROM={"UpperTorso","LowerTorso","RightUpperArm","LeftUpperArm","RightLowerLeg","LeftLowerLeg","Head"}
-- (06/11) Where each nature's aura sits on the root: lightning at the chest,
-- the wind at the feet (its rings climb the body), sand at the shoulders (it
-- pours down), Lee's steam at the chest; the rest at the hips.
local AURA_AT={Lightning=Vector3.new(0,.4,0),Wind=Vector3.new(0,-2.4,0),Sand=Vector3.new(0,1.1,0),Earth=Vector3.new(0,1.1,0),Strength=Vector3.new(0,.6,0)}
-- (06/11) Each nature's sounds: {sound (Effects SOUND), volume, pitch, fade}.
-- load: the chakra comes up; swing: the infused strike leaves; hit: contact;
-- leap / dash: the chakra jump and dash.
ChakraFlowFX.Sound={
	Lightning={load={{"electric",.45,1.15}},swing={{"electric",.28,1.5}},hit={{"electric",.5,1},{"hit",.3,1.45}},
		leap={{"electric",.35,1.3},{"whoosh",.22,.95}},dash={{"electric",.35,1.6}}},
	Fire={load={{"fireLoop",.45,1,.6},{"whoosh",.3,.5}},swing={{"fireLoop",.3,1.25,.35},{"whoosh",.22,.75}},
		hit={{"boom",.28,1.55},{"fireLoop",.35,1.1,.45}},leap={{"whoosh",.35,.6},{"fireLoop",.3,1,.5}},
		dash={{"whoosh",.35,.7},{"fireLoop",.25,1.2,.35}}},
	Wind={load={{"whooshBy",.45,1.7},{"swish",.25,1.35}},swing={{"swish",.35,1.65}},hit={{"swish",.45,1.3},{"whooshBy",.32,1.9}},
		leap={{"whooshBy",.42,1.35}},dash={{"whooshBy",.45,1.6}}},
	Sand={load={{"debris",.32,1.55,.5},{"land",.2,1.25}},swing={{"debris",.22,1.9,.3}},hit={{"debris",.42,1.3,.6},{"body",.35,.8}},
		leap={{"debris",.32,1.25,.5},{"land",.25,.9}},dash={{"debris",.28,1.7,.35}}},
	GentleFist={load={{"whoosh",.4,.42},{"swish",.18,.55}},swing={{"whoosh",.25,.62}},hit={{"hit",.4,1.55},{"whoosh",.3,.48}},
		leap={{"whoosh",.32,.5}},dash={{"whoosh",.35,.55}}},
	Strength={load={{"heavy",.4,.7},{"land",.35,.75}},swing={{"swish",.3,.75}},hit={{"heavy",.55,.8},{"punch",.4,.7}},
		leap={{"land",.5,.6},{"heavy",.35,.6}},dash={{"land",.3,.85},{"whooshBy",.28,.9}}},
	Chakra={load={{"whoosh",.32,.9},{"swish",.2,.6}},swing={{"swish",.28,1}},hit={{"hit",.35,1.15},{"whoosh",.25,1.2}},
		leap={{"whoosh",.4,.75}},dash={{"whoosh",.35,1.1}}},
	Earth={load={{"rock",.4,.8},{"debris",.25,.8,.5}},swing={{"swish",.3,.8}},hit={{"rock",.55,.8},{"debris",.4,.7,.8}},
		leap={{"rock",.4,.7},{"land",.35,.7}},dash={{"debris",.25,1.2,.35}}},
}

local function colorOf(nature) return ChakraFlowFX.Color[nature or ""] or ChakraFlowFX.Color.Chakra end
-- The look a nature is drawn with: an unknown nature is plain chakra.
local function lookOf(nature) return if ChakraFlowFX.Color[nature or ""] then nature else "Chakra" end
local function cueOf(look,moment)
	local set=ChakraFlowFX.Sound[look]
	return set and set[moment]
end
-- A cue's sounds on a part (they follow it), each a hair off pitch so a
-- repeated one never sounds machine-made.
local function play(parent,cue,scale)
	if not (cue and parent) then return end
	for _,s in cue do
		local id=K.SOUND[s[1]]
		if id then K.sound(parent,id,s[2]*(scale or 1),s[3]*(.96+math.random()*.08),s[4]) end
	end
end
local function playAt(fx,at,cue,scale)
	if cue then play(K.anchorPart(fx.folder,at),cue,scale) end
end
local function stateOf(fx,model)
	fx.flowState=fx.flowState or setmetatable({},{__mode="k"})
	local st=fx.flowState[model]
	if not st then st={};fx.flowState[model]=st end
	return st
end
local function particles(parent,props)
	local e=K.new("ParticleEmitter",{Enabled=false,LightInfluence=0,ZOffset=.6},parent)
	for k,v in props do e[k]=v end
	return e
end
local function add(list,parent,props)
	local e=particles(parent,props)
	table.insert(list,e)
	return e
end

-- ------------------------------------------------------------------ one-shot shapes
local function scatter()
	local v=Vector3.new(math.random()-.5,math.random()-.5,math.random()-.5)
	return if v.Magnitude&gt;.05 then v.Unit else Vector3.yAxis
end
-- A jagged lightning line: four neon kinks that fade.
local function jag(fx,from,to,color,width,life)
	local delta=to-from
	local length=delta.Magnitude
	if length&lt;.1 then return end
	local side=delta:Cross(Vector3.yAxis)
	if side.Magnitude&lt;.05 then side=Vector3.xAxis end
	side=side.Unit
	local up=side:Cross(delta).Unit
	local last=from
	for k=1,4 do
		local b=if k==4 then to else from+delta*(k/4)+side*(math.random()-.5)*length*.35+up*(math.random()-.5)*length*.25
		local piece=(b-last).Magnitude
		if piece&gt;.02 then
			local seg=K.block(fx.folder,Vector3.new(width,width,piece),CFrame.lookAt(last:Lerp(b,.5),b),color,NEON)
			seg.Name="ChakraArc"
			K.tween(seg,life,{Transparency=1})
			Debris:AddItem(seg,life+.03)
		end
		last=b
	end
end
-- A one-shot burst whose emission points along `dir` (up when none).
local function aimed(fx,at,dir,props,count)
	local holder=K.anchorPart(fx.folder,at)
	if dir and dir.Magnitude&gt;.05 and math.abs(dir.Unit.Y)&lt;.95 then
		holder.CFrame=CFrame.lookAt(at,at+dir)*CFrame.Angles(-math.pi/2,0,0)
	end
	local e=particles(K.new("Attachment",{},holder),props)
	e:Emit(math.max(1,math.floor(count*(Kit.amount or 1)+.5)))
	Debris:AddItem(holder,2)
end
local function fireRamp(color)
	return K.seq({{0,Color3.fromRGB(255,240,180)},{.35,color},{1,Color3.fromRGB(150,36,12)}})
end
local function emberRamp()
	return K.seq({{0,Color3.fromRGB(255,232,150)},{1,Color3.fromRGB(255,96,30)}})
end
local function flames(fx,at,dir,count,size,spread)
	aimed(fx,at,dir,{Texture=K.TEX.fire,Lifetime=NumberRange.new(.22,.42),Speed=NumberRange.new(5,11),SpreadAngle=Vector2.new(spread,spread),
		Acceleration=Vector3.new(0,12,0),Drag=4,Color=fireRamp(ChakraFlowFX.Color.Fire),LightEmission=1,
		Size=K.num({{0,size*.8},{.35,size},{1,size*.3}}),Transparency=K.num({{0,.1},{.6,.35},{1,1}}),
		Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-90,90)},count)
end
local function embers(fx,at,count)
	K.burst(fx.folder,at,{Texture=K.TEX.fireSpark,Lifetime=NumberRange.new(.5,.9),Speed=NumberRange.new(6,12),SpreadAngle=Vector2.new(180,180),
		Acceleration=Vector3.new(0,6,0),Drag=2.5,Color=emberRamp(),LightEmission=1,Size=K.num({{0,.35},{1,.05}})},count)
end
-- Matte grains (lit by the scene, no glow) thrown out, then falling.
local function grains(fx,at,dir,color,count,speed)
	aimed(fx,at,dir,{Texture=K.TEX.smoke,Lifetime=NumberRange.new(.45,.75),Speed=NumberRange.new(speed*.6,speed),SpreadAngle=Vector2.new(55,55),
		Acceleration=Vector3.new(0,-38,0),Drag=1.5,Color=ColorSequence.new(color,color:Lerp(Color3.new(0,0,0),.25)),LightEmission=0,LightInfluence=1,
		Size=K.num({{0,.22},{1,.15}}),Transparency=K.num({{0,0},{.8,0},{1,1}})},count)
end
-- A ring of light that swells (the halo texture).
local function halo(fx,at,color,from,to,time)
	K.burst(fx.folder,at,{Texture=K.TEX.halo,Lifetime=NumberRange.new(time),Speed=NumberRange.new(0),Color=ColorSequence.new(color),LightEmission=1,
		Size=K.num({{0,from},{1,to}}),Transparency=K.num({{0,.2},{1,1}}),Rotation=NumberRange.new(0,360),ZOffset=1},1)
end
-- A spiral of air lying flat, spinning as it opens.
local function whirl(fx,at,color,from,to,time)
	K.burst(fx.folder,at,{Texture=K.TEX.swirl,Orientation=Enum.ParticleOrientation.VelocityPerpendicular,Lifetime=NumberRange.new(time),
		Speed=NumberRange.new(.4),Color=ColorSequence.new(CORE,color),LightEmission=.6,Size=K.num({{0,from},{1,to}}),
		Transparency=K.num({{0,.3},{1,1}}),Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-760,-620)},1)
end
-- A thin blade of air laid across the line, tilted, carried on past the body.
local function slash(fx,at,dir,color,length,tilt,life)
	local across=dir:Cross(Vector3.yAxis)
	across=if across.Magnitude&gt;.05 then across.Unit else Vector3.xAxis
	local t=math.rad(tilt)
	local along=across*math.cos(t)+Vector3.yAxis*math.sin(t)
	local cf=CFrame.lookAt(at,at+along)
	local bar=K.block(fx.folder,Vector3.new(.12,.12,length),cf,color,NEON)
	bar.Name="ChakraCut";bar.Transparency=.05
	K.tween(bar,life,{Size=Vector3.new(.02,.02,length*1.35),Transparency=1,CFrame=cf+dir*1.8})
	Debris:AddItem(bar,life+.05)
end
-- The gentle fist's chakra going clean through the body: a needle of light.
local function needle(fx,at,dir,color,length,life)
	local from=at-dir*length*.35
	local to=from+dir*length
	local bar=K.block(fx.folder,Vector3.new(.16,.16,length*.4),CFrame.lookAt(from:Lerp(to,.5),to),color,NEON)
	bar.Name="ChakraNeedle";bar.Transparency=.05
	K.tween(bar,life,{Size=Vector3.new(.03,.03,length),Transparency=1})
	Debris:AddItem(bar,life+.05)
end
-- Small stones thrown up and falling back (earth).
local function pebbles(fx,at,color,count)
	for _=1,count do
		local size=.25+math.random()*.3
		local rock=K.block(fx.folder,Vector3.one*size,CFrame.new(at)*CFrame.Angles(math.random()*6,math.random()*6,0),color,Enum.Material.Slate)
		rock.Name="ChakraPebble"
		local a=math.random()*math.pi*2
		local out=Vector3.new(math.cos(a),0,math.sin(a))*(1.5+math.random()*2)
		K.tween(rock,.22,{CFrame=CFrame.new(at+out*.6+Vector3.new(0,1.4+math.random(),0))})
		task.delay(.22,function()
			if rock.Parent then K.tween(rock,.3,{CFrame=CFrame.new(at+out-Vector3.new(0,.3,0)),Transparency=1},Enum.EasingStyle.Quad,Enum.EasingDirection.In) end
		end)
		Debris:AddItem(rock,.6)
	end
end
-- A short-lived mark on the floor under a point (crack, scorch): the push
-- leaves a trace, held briefly so the arena never fills up with them.
local function groundMark(fx,at,texture,size,hold)
	local ok,floor=pcall(K.floorUnder,fx,at+Vector3.new(0,.5,0),2,6)
	if ok and floor then Kit.ground(fx.folder,floor.Position,floor.Normal,texture,size,hold,1,Color3.new(1,1,1),.1) end
end

-- ------------------------------------------------------------------ the aura
-- Built once per nature (an attachment on the root, a light, and the
-- nature's own pieces). `emitters` show while the body is loaded; `both` also
-- stay on through the infused strike that spends the load (the gentle fist's
-- palms and veins, the chakra sheath). The main emitter is always "Rise".
local BUILD={}
BUILD.Lightning=function(a,model,root,color)
	-- sparks crackling off the chest, static on the torso; arcs in TICK
	a.rise=add(a.emitters,a.at,{Name="Rise",Texture=K.TEX.spark,Rate=26,Lifetime=NumberRange.new(.05,.12),Speed=NumberRange.new(4,10),
		SpreadAngle=Vector2.new(180,180),Color=K.seq({{0,CORE},{1,color}}),LightEmission=1,Size=K.num({{0,.7},{1,0}}),
		Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-600,600),Drag=6})
	local torso=model:FindFirstChild("UpperTorso")
	if torso then
		table.insert(a.extras,add(a.emitters,torso,{Name="ChakraFlowStatic",Texture=K.TEX.spark,Rate=16,Lifetime=NumberRange.new(.04,.08),
			Speed=NumberRange.new(0,1),Color=ColorSequence.new(CORE),LightEmission=1,Size=K.num({{0,.55},{1,0}}),Rotation=NumberRange.new(0,360),LockedToPart=true}))
	end
	a.light.Range=14
end
BUILD.Fire=function(a,model,root,color)
	local ramp=fireRamp(color)
	a.rise=add(a.emitters,a.at,{Name="Rise",Texture=K.TEX.fire,Rate=20,Lifetime=NumberRange.new(.3,.5),Speed=NumberRange.new(4,7),
		SpreadAngle=Vector2.new(16,16),EmissionDirection=Enum.NormalId.Top,Acceleration=Vector3.new(0,9,0),Color=ramp,LightEmission=.9,
		Size=K.num({{0,.9},{.4,1.3},{1,.2}}),Transparency=K.num({{0,.5},{.5,.62},{1,1}}),Rotation=NumberRange.new(0,360),
		RotSpeed=NumberRange.new(-60,60),Drag=1})
	add(a.emitters,a.at,{Name="Embers",Texture=K.TEX.fireSpark,Rate=12,Lifetime=NumberRange.new(.6,1.1),Speed=NumberRange.new(2,5),
		SpreadAngle=Vector2.new(50,50),EmissionDirection=Enum.NormalId.Top,Acceleration=Vector3.new(0,5,0),Drag=1.5,Color=emberRamp(),
		LightEmission=1,Size=K.num({{0,.3},{1,.08}}),Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-200,200)})
	local torso=model:FindFirstChild("UpperTorso")
	if torso then
		-- small tongues licking off the torso itself, not a column over it
		table.insert(a.extras,add(a.emitters,torso,{Name="ChakraFlowLick",Texture=K.TEX.fire,Rate=12,Lifetime=NumberRange.new(.2,.35),
			Speed=NumberRange.new(2,4),SpreadAngle=Vector2.new(20,20),Acceleration=Vector3.new(0,10,0),Color=ramp,LightEmission=.9,
			Size=K.num({{0,.6},{.4,.9},{1,.1}}),Transparency=K.num({{0,.45},{1,1}}),Rotation=NumberRange.new(0,360)}))
	end
	a.loop=K.new("Sound",{Name="ChakraFlowCrackle",SoundId=K.SOUND.fireLoop,Volume=0,Looped=true,PlaybackSpeed=1.05,
		RollOffMaxDistance=70,RollOffMinDistance=10},root)
	table.insert(a.extras,a.loop)
	a.seed=math.random()*100
end
BUILD.Wind=function(a,model,root,color)
	-- rings of air climbing the body from the feet, a spiral spinning under it
	-- (07/11, Studio: Naruto loaded, seen from behind: no ring at all. A low
	-- Rate is cut down by the graphics quality, to nothing here; pale mint
	-- added onto bright sand added nothing either) the rings are emitted by
	-- hand (TICK.Wind), a deeper teal lit by the scene.
	local deep=color:Lerp(Color3.fromRGB(30,150,130),.45)
	a.rise=add(a.emitters,a.at,{Name="Rise",Texture=K.TEX.halo,Orientation=Enum.ParticleOrientation.VelocityPerpendicular,
		EmissionDirection=Enum.NormalId.Top,Rate=0,Lifetime=NumberRange.new(.55,.7),Speed=NumberRange.new(5,6.5),SpreadAngle=Vector2.new(0,0),
		Color=K.seq({{0,color},{1,deep}}),LightEmission=.15,LightInfluence=.4,Size=K.num({{0,2.4},{1,3.4}}),Transparency=K.num({{0,1},{.15,.35},{.7,.5},{1,1}}),
		Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(120,260),LockedToPart=true})
	a.spiral=add(a.emitters,a.at,{Name="Spiral",Texture=K.TEX.swirl,Orientation=Enum.ParticleOrientation.VelocityPerpendicular,
		EmissionDirection=Enum.NormalId.Top,Rate=0,Lifetime=NumberRange.new(.3,.4),Speed=NumberRange.new(.4,.6),Color=ColorSequence.new(color,deep),
		LightEmission=.15,LightInfluence=.4,Size=K.num({{0,2.6},{1,4.2}}),Transparency=K.num({{0,.38},{1,1}}),Rotation=NumberRange.new(0,360),
		RotSpeed=NumberRange.new(-900,-700),LockedToPart=true})
end
-- Sand (and earth): matte, lit by the scene, never glowing.
local function dusty(a,model,root,color)
	local dark=color:Lerp(Color3.fromRGB(90,70,40),.35)
	a.rise=add(a.emitters,a.at,{Name="Rise",Texture=K.TEX.smoke,Rate=40,Lifetime=NumberRange.new(.5,.75),Speed=NumberRange.new(2,4),
		SpreadAngle=Vector2.new(60,60),EmissionDirection=Enum.NormalId.Top,Acceleration=Vector3.new(0,-34,0),Drag=.5,
		Color=ColorSequence.new(color,dark),LightEmission=0,LightInfluence=1,Size=K.num({{0,.2},{1,.14}}),Transparency=K.num({{0,0},{.85,0},{1,1}})})
	local torso=model:FindFirstChild("UpperTorso")
	if torso then
		-- grains sliding off the torso, and a faint shell of dust round it
		table.insert(a.extras,add(a.emitters,torso,{Name="ChakraFlowPour",Texture=K.TEX.smoke,Rate=26,Lifetime=NumberRange.new(.4,.6),
			Speed=NumberRange.new(0,1),Acceleration=Vector3.new(0,-30,0),Color=ColorSequence.new(color,dark),LightEmission=0,LightInfluence=1,
			Size=K.num({{0,.18},{1,.12}}),Transparency=K.num({{0,0},{.85,0},{1,1}})}))
		table.insert(a.extras,add(a.emitters,torso,{Name="ChakraFlowShell",Texture=K.TEX.smoke,Rate=7,Lifetime=NumberRange.new(.6,.9),
			Speed=NumberRange.new(0,.4),Color=ColorSequence.new(color),LightEmission=0,LightInfluence=1,Size=K.num({{0,1.6},{1,2.4}}),
			Transparency=K.num({{0,1},{.3,.84},{.7,.88},{1,1}}),Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-30,30),LockedToPart=true}))
	end
	local feet=K.new("Attachment",{Name="ChakraFlowFeet",Position=Vector3.new(0,-2.6,0)},root)
	table.insert(a.extras,feet)
	add(a.emitters,feet,{Name="Drift",Texture=K.TEX.smoke,Rate=5,Lifetime=NumberRange.new(.5,.8),Speed=NumberRange.new(1.5,3),
		SpreadAngle=Vector2.new(80,80),Acceleration=Vector3.new(0,.5,0),Drag=2,Color=ColorSequence.new(color),LightEmission=0,LightInfluence=1,
		Size=K.num({{0,1},{1,2.2}}),Transparency=K.num({{0,.7},{1,1}}),Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-40,40)})
end
BUILD.Sand=dusty
BUILD.Earth=dusty
BUILD.GentleFist=function(a,model,root,color)
	-- (07/11: a Rate of 6 is cut to nothing at low graphics quality, see Wind)
	a.rise=add(a.emitters,a.at,{Name="Rise",Texture=K.TEX.glow,Rate=16,Lifetime=NumberRange.new(.5,.8),Speed=NumberRange.new(1,2),
		SpreadAngle=Vector2.new(30,30),EmissionDirection=Enum.NormalId.Top,Color=K.seq({{0,CORE},{1,color}}),LightEmission=1,
		Size=K.num({{0,.6},{1,.1}}),Transparency=K.num({{0,.55},{1,1}})})
	local torso=model:FindFirstChild("UpperTorso")
	if torso then
		-- the chakra points twinkling on the body
		table.insert(a.extras,add(a.emitters,torso,{Name="ChakraFlowPoints",Texture=K.TEX.spark,Rate=10,Lifetime=NumberRange.new(.15,.3),
			Speed=NumberRange.new(0,0),Color=ColorSequence.new(CORE),LightEmission=1,Size=K.num({{0,0},{.3,.32},{1,0}}),LockedToPart=true}))
	end
	-- the chakra gathered in the palms
	for _,name in HANDS do
		local hand=model:FindFirstChild(name)
		if hand then
			local at=K.new("Attachment",{Name="ChakraFlowPalm"},hand)
			table.insert(a.extras,at)
			add(a.both,at,{Name="Palm",Texture=K.TEX.glow,Rate=16,Lifetime=NumberRange.new(.18,.28),Speed=NumberRange.new(0,.3),
				Color=K.seq({{0,CORE},{1,color}}),LightEmission=1,Size=K.num({{0,1.1},{.5,1.4},{1,.6}}),Transparency=K.num({{0,.35},{1,1}}),LockedToPart=true})
		end
	end
	-- veins of light down each arm, pulsing (TICK)
	for _,side in {"Right","Left"} do
		local chain={}
		for _,name in {side.."UpperArm",side.."LowerArm",side.."Hand"} do
			local part=model:FindFirstChild(name)
			if part then
				local at=K.new("Attachment",{Name="ChakraFlowVein"},part)
				table.insert(a.extras,at);table.insert(chain,at)
			end
		end
		for k=1,#chain-1 do
			table.insert(a.beams,K.new("Beam",{Name="ChakraFlowVein",Enabled=false,Attachment0=chain[k],Attachment1=chain[k+1],Width0=.08,Width1=.05,
				CurveSize0=if k==1 then .35 else .2,CurveSize1=if k==1 then -.3 else -.15,Color=ColorSequence.new(CORE,color),LightEmission=1,
				LightInfluence=0,Transparency=K.num({{0,.15},{1,.35}}),FaceCamera=true,Segments=8,ZOffset=.6},chain[k]))
		end
	end
end
BUILD.Strength=function(a,model,root,color)
	-- no chakra glow: steam off a straining body
	-- (07/11, Studio: Lee loaded looked exactly like Lee unloaded; the steam
	-- at .84 vanished on the sand) thicker steam, bigger drops, harder stamps.
	a.rise=add(a.emitters,a.at,{Name="Rise",Texture=K.TEX.smoke,Rate=18,Lifetime=NumberRange.new(.6,1),Speed=NumberRange.new(2.5,4.5),
		SpreadAngle=Vector2.new(25,25),EmissionDirection=Enum.NormalId.Top,Acceleration=Vector3.new(0,2,0),Drag=1,
		Color=ColorSequence.new(Color3.fromRGB(255,250,244)),LightEmission=.25,LightInfluence=.4,Size=K.num({{0,1.4},{1,3.2}}),
		Transparency=K.num({{0,1},{.2,.48},{.6,.58},{1,1}}),Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-40,40)})
	-- sweat flicked off the head
	local head=model:FindFirstChild("Head")
	local sweat=a.at
	if head then
		sweat=K.new("Attachment",{Name="ChakraFlowSweat",Position=Vector3.new(0,.3,0)},head)
		table.insert(a.extras,sweat)
	end
	add(a.emitters,sweat,{Name="Sweat",Texture=K.TEX.droplets,FlipbookLayout=Enum.ParticleFlipbookLayout.Grid4x4,
		FlipbookMode=Enum.ParticleFlipbookMode.OneShot,Rate=12,Lifetime=NumberRange.new(.3,.5),Speed=NumberRange.new(5,8),
		SpreadAngle=Vector2.new(70,70),EmissionDirection=Enum.NormalId.Top,Acceleration=Vector3.new(0,-45,0),
		Color=ColorSequence.new(Color3.fromRGB(220,236,255)),LightEmission=.35,Size=K.num({{0,.6},{1,.45}}),Transparency=K.num({{0,0},{.7,.2},{1,1}})})
	-- the feet stamping the floor (pulsed in TICK, with a low thump)
	local feet=K.new("Attachment",{Name="ChakraFlowFeet",Position=Vector3.new(0,-2.6,0)},root)
	table.insert(a.extras,feet)
	a.stomp=particles(feet,{Name="Stomp",Texture=K.TEX.smoke,Lifetime=NumberRange.new(.35,.55),Speed=NumberRange.new(6,10),
		SpreadAngle=Vector2.new(85,85),EmissionDirection=Enum.NormalId.Top,Acceleration=Vector3.new(0,2,0),Drag=5,Color=ColorSequence.new(DUST),
		LightEmission=0,LightInfluence=1,Size=K.num({{0,1.3},{1,2.6}}),Transparency=K.num({{0,.25},{1,1}}),Rotation=NumberRange.new(0,360)})
end
BUILD.Chakra=function(a,model,root,color)
	-- clean, smooth wisps (no flame texture) and a glow hugging the body
	a.rise=add(a.emitters,a.at,{Name="Rise",Texture=K.TEX.glow,Rate=22,Lifetime=NumberRange.new(.35,.55),Speed=NumberRange.new(3,5),
		SpreadAngle=Vector2.new(14,14),EmissionDirection=Enum.NormalId.Top,Acceleration=Vector3.new(0,4,0),Color=K.seq({{0,CORE},{.4,color},{1,color}}),
		LightEmission=1,Size=K.num({{0,1},{.5,1.2},{1,.2}}),Transparency=K.num({{0,.6},{.6,.7},{1,1}}),Drag=1})
	for _,name in {"UpperTorso","LowerTorso"} do
		local part=model:FindFirstChild(name)
		if part then
			table.insert(a.extras,add(a.both,part,{Name="ChakraFlowSheath",Texture=K.TEX.glow,Rate=8,Lifetime=NumberRange.new(.25,.4),
				Speed=NumberRange.new(0,0),Color=ColorSequence.new(color),LightEmission=.8,Size=K.num({{0,1.4},{1,1.9}}),
				Transparency=K.num({{0,1},{.3,.8},{1,1}}),LockedToPart=true}))
		end
	end
end
local function drop(a)
	for _,x in a.extras do x:Destroy() end
	a.at:Destroy();a.light:Destroy()
end
local function aura(st,model,nature)
	local root=model:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	if st.aura and st.aura.nature==nature and st.aura.at.Parent then return st.aura end
	if st.aura then drop(st.aura) end
	local look=lookOf(nature)
	local color=colorOf(nature)
	local a={nature=nature,look=look,color=color,root=root,emitters={},both={},beams={},extras={}}
	a.at=K.new("Attachment",{Name="ChakraFlowAura",Position=AURA_AT[look] or Vector3.new(0,-.4,0)},root)
	a.light=K.new("PointLight",{Color=color,Brightness=0,Range=12,Shadows=false},root)
	-- (07/11, Studio: loaded and standing, the body looked the same: a spark
	-- now and then) The loaded body is outlined in its nature's colour.
	-- (Studio: Neji's pale blue on his white clothes did not show) a deeper rim
	local rimColor=if look=="GentleFist" then Color3.fromRGB(96,140,255) else color
	a.rim=K.new("Highlight",{Name="ChakraFlowRim",Adornee=model,FillColor=rimColor,FillTransparency=1,OutlineColor=rimColor,OutlineTransparency=1,
		DepthMode=Enum.HighlightDepthMode.Occluded,Enabled=false},model)
	table.insert(a.extras,a.rim)
	BUILD[look](a,model,root,color)
	st.aura=a
	return a
end
-- The light and the nature's own beat, every frame. `on`: loaded; `keep`:
-- loaded or out on the strike that spent the load.
local function ease(a,target,dt)
	a.light.Brightness+=(target-a.light.Brightness)*math.min(1,dt*14)
end
local TICK={}
TICK.Lightning=function(fx,a,model,now,dt,on,keep)
	if not keep then ease(a,0,dt) return end
	-- a strobe, not a breath
	a.light.Brightness=(if math.random()&lt;.22 then 2.6 else .3+math.random()*.7)*(if on then 1 else .6)
	if not on then return end
	if now&gt;=(a.nextArc or 0) then
		-- (07/11) two arcs at a time, oftener: the body crackles while loaded
		a.nextArc=now+.04+math.random()*.05
		for _=1,2 do
			local from=model:FindFirstChild(ARC_FROM[math.random(1,#ARC_FROM)]) or a.root
			local at=from.Position+scatter()*.5
			jag(fx,at,at+scatter()*(1.2+math.random()*1.3),if math.random()&lt;.5 then CORE else a.color,.08,.1)
		end
	end
	if now&gt;=(a.nextBuzz or 0) then
		a.nextBuzz=now+.5+math.random()*.35
		play(a.root,{{"electric",.12,1.6}})
	end
end
TICK.Fire=function(fx,a,model,now,dt,on,keep)
	-- firelight: a fast, uneven flicker
	ease(a,if keep then (1.2+math.noise(now*6,a.seed or 0)*.9)*(if on then 1 else .6) else 0,dt*2)
end
TICK.Wind=function(fx,a,model,now,dt,on,keep)
	ease(a,if on then .55 elseif keep then .3 else 0,dt)
	if on and now&gt;=(a.nextRing or 0) then
		a.nextRing=now+.13
		a.rise:Emit(1)
		a.ringCount=(a.ringCount or 0)+1
		if a.spiral and a.ringCount%2==0 then a.spiral:Emit(1) end
	end
end
TICK.Sand=function(fx,a,model,now,dt,on,keep)
	ease(a,if on then .25 else 0,dt)
end
TICK.Earth=TICK.Sand
TICK.GentleFist=function(fx,a,model,now,dt,on,keep)
	ease(a,if not keep then 0 elseif on then .55+.3*math.sin(now*4) else .9,dt)
	if keep then
		for k,beam in a.beams do
			local w=.05+.06*(.5+.5*math.sin(now*7+k*1.7))
			beam.Width0=w;beam.Width1=w*.6
		end
	end
end
TICK.Strength=function(fx,a,model,now,dt,on,keep)
	ease(a,0,dt)
	if on and a.stomp and now&gt;=(a.nextStomp or 0) then
		a.nextStomp=now+.5
		a.stomp:Emit(9)
		play(a.root,{{"heavy",.1,.5}})
	end
end
TICK.Chakra=function(fx,a,model,now,dt,on,keep)
	ease(a,if on then 1+.2*math.sin(now*5) elseif keep then .6 else 0,dt)
end

-- ------------------------------------------------------------------ infused limbs
-- Each hand and foot pours its nature while the strike is out (the gentle
-- fist: the palms only); the limb that moves fastest (the one striking)
-- pours the most, the others barely.
local function trail(limb,part,list,color,width,life,alpha,light)
	local a0=K.new("Attachment",{Name="ChakraFlowTrail0",Position=Vector3.new(0,width*.5,0)},part)
	local a1=K.new("Attachment",{Name="ChakraFlowTrail1",Position=Vector3.new(0,-width*.5,0)},part)
	local t=K.new("Trail",{Name="ChakraFlowTrail",Enabled=false,Attachment0=a0,Attachment1=a1,Lifetime=life,MinLength=.05,FaceCamera=true,
		LightEmission=light,LightInfluence=0,Color=ColorSequence.new(CORE,color),Transparency=K.num({{0,alpha},{1,1}}),WidthScale=K.num({{0,1},{1,.1}})},part)
	table.insert(list,a0);table.insert(list,a1);table.insert(list,t)
	table.insert(limb.trails,t)
end
local LIMB={}
LIMB.Lightning=function(limb,at,part,color,list)
	add(limb.emitters,at,{Name="Infused",Texture=K.TEX.spark,Rate=70,Lifetime=NumberRange.new(.04,.1),Speed=NumberRange.new(4,10),
		SpreadAngle=Vector2.new(180,180),Color=K.seq({{0,CORE},{1,color}}),LightEmission=1,Size=K.num({{0,.8},{1,0}}),
		Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-600,600),Drag=6})
end
LIMB.Fire=function(limb,at,part,color,list)
	add(limb.emitters,at,{Name="Infused",Texture=K.TEX.fire,Rate=80,Lifetime=NumberRange.new(.14,.26),Speed=NumberRange.new(1,3),
		SpreadAngle=Vector2.new(180,180),Acceleration=Vector3.new(0,10,0),Color=fireRamp(color),LightEmission=1,
		Size=K.num({{0,1},{1,.15}}),Transparency=K.num({{0,.2},{1,1}}),Rotation=NumberRange.new(0,360),Drag=3})
	add(limb.emitters,at,{Name="Embers",Texture=K.TEX.fireSpark,Rate=18,Lifetime=NumberRange.new(.35,.6),Speed=NumberRange.new(2,5),
		SpreadAngle=Vector2.new(180,180),Acceleration=Vector3.new(0,4,0),Drag=2,Color=emberRamp(),LightEmission=1,Size=K.num({{0,.28},{1,.05}})})
end
LIMB.Wind=function(limb,at,part,color,list)
	-- a small spiral spun at the fist or the foot, and a cutting trail
	add(limb.emitters,at,{Name="Infused",Texture=K.TEX.swirl,Rate=18,Lifetime=NumberRange.new(.14,.2),Speed=NumberRange.new(0,0),
		Color=ColorSequence.new(CORE,color),LightEmission=.7,Size=K.num({{0,.8},{1,1.8}}),Transparency=K.num({{0,.45},{1,1}}),
		Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-1000,-800),LockedToPart=true})
	trail(limb,part,list,color,.9,.14,.25,.8)
end
LIMB.Sand=function(limb,at,part,color,list)
	add(limb.emitters,at,{Name="Infused",Texture=K.TEX.smoke,Rate=60,Lifetime=NumberRange.new(.4,.6),Speed=NumberRange.new(1,3),
		SpreadAngle=Vector2.new(180,180),Acceleration=Vector3.new(0,-30,0),Drag=1,Color=ColorSequence.new(color,color:Lerp(Color3.new(0,0,0),.25)),
		LightEmission=0,LightInfluence=1,Size=K.num({{0,.2},{1,.14}}),Transparency=K.num({{0,0},{.85,0},{1,1}})})
	add(limb.emitters,at,{Name="Dust",Texture=K.TEX.smoke,Rate=14,Lifetime=NumberRange.new(.3,.45),Speed=NumberRange.new(.5,1.5),
		SpreadAngle=Vector2.new(180,180),Color=ColorSequence.new(color),LightEmission=0,LightInfluence=1,
		Size=K.num({{0,.6},{1,1.4}}),Transparency=K.num({{0,.55},{1,1}}),Rotation=NumberRange.new(0,360),Drag=3})
end
LIMB.Earth=LIMB.Sand
LIMB.GentleFist=function(limb,at,part,color,list)
	add(limb.emitters,at,{Name="Infused",Texture=K.TEX.glow,Rate=40,Lifetime=NumberRange.new(.1,.18),Speed=NumberRange.new(0,.5),
		Color=K.seq({{0,CORE},{1,color}}),LightEmission=1,Size=K.num({{0,1.3},{1,.5}}),Transparency=K.num({{0,.2},{1,1}}),LockedToPart=true})
	add(limb.emitters,at,{Name="Points",Texture=K.TEX.spark,Rate=16,Lifetime=NumberRange.new(.1,.2),Speed=NumberRange.new(2,4),
		SpreadAngle=Vector2.new(40,40),Color=ColorSequence.new(CORE),LightEmission=1,Size=K.num({{0,.3},{1,0}}),Drag=4})
end
LIMB.Strength=function(limb,at,part,color,list)
	-- no glow: the air the limb shoves, and a pale pressure streak
	add(limb.emitters,at,{Name="Infused",Texture=K.TEX.smoke,Rate=30,Lifetime=NumberRange.new(.12,.2),Speed=NumberRange.new(0,1),
		Color=ColorSequence.new(Color3.fromRGB(246,242,232)),LightEmission=0,LightInfluence=.5,Size=K.num({{0,.5},{1,1.2}}),
		Transparency=K.num({{0,.6},{1,1}}),Rotation=NumberRange.new(0,360),Drag=4})
	trail(limb,part,list,Color3.fromRGB(255,248,236),.6,.1,.45,.3)
end
LIMB.Chakra=function(limb,at,part,color,list)
	add(limb.emitters,at,{Name="Infused",Texture=K.TEX.glow,Rate=70,Lifetime=NumberRange.new(.15,.28),Speed=NumberRange.new(1,2),
		SpreadAngle=Vector2.new(180,180),Color=K.seq({{0,CORE},{.4,color},{1,color}}),LightEmission=1,
		Size=K.num({{0,.9},{1,.1}}),Transparency=K.num({{0,.25},{1,1}}),Drag=4})
	trail(limb,part,list,color,.45,.1,.35,.9)
end
local function limbs(st,model,nature)
	if st.limbs and st.limbs.nature==nature then return st.limbs end
	if st.limbs then for _,x in st.limbs.list do x:Destroy() end end
	local look=lookOf(nature)
	local color=colorOf(nature)
	local l={nature=nature,look=look,color=color,list={},limbs={},root=model:FindFirstChild("HumanoidRootPart")}
	for _,name in (if look=="GentleFist" then HANDS else LIMBS) do
		local part=model:FindFirstChild(name)
		if part then
			local at=K.new("Attachment",{Name="ChakraFlowLimb"},part)
			table.insert(l.list,at)
			local limb={part=part,emitters={},rates={},trails={}}
			LIMB[look](limb,at,part,color,l.list)
			for i,e in limb.emitters do limb.rates[i]=e.Rate end
			table.insert(l.limbs,limb)
		end
	end
	st.limbs=l
	return l
end
local function stepLimbs(fx,l,on,now,dt)
	local fastest,best=nil,0
	-- (measured against the root, so a running body does not make every limb
	-- read as the striking one)
	local base=if l.root and l.root.Parent then l.root.Position else Vector3.zero
	for _,limb in l.limbs do
		local pos=limb.part.Position-base
		local speed=if limb.last then (pos-limb.last).Magnitude/math.max(dt,1/240) else 0
		limb.last=pos
		if on then
			local k=math.clamp(.25+speed/28,.25,1)
			for i,e in limb.emitters do e.Rate=limb.rates[i]*k;e.Enabled=true end
			if speed&gt;best then best=speed;fastest=limb end
		else
			for _,e in limb.emitters do e.Enabled=false end
		end
		for _,t in limb.trails do t.Enabled=on end
	end
	-- lightning: arcs jump off the striking limb
	if on and fastest and l.look=="Lightning" and now&gt;=(l.nextArc or 0) then
		l.nextArc=now+.05
		local p=fastest.part.Position
		jag(fx,p,p+scatter()*(.8+math.random()*.8),if math.random()&lt;.5 then CORE else l.color,.06,.07)
	end
end
local function fighter(fx,model,actor,dt)
	if not model or not actor then return end
	dt=dt or 1/60
	local st=stateOf(fx,model)
	local loaded=actor.chakraLoad
	-- (07/11, Studio: the Chidori Nagashi's current showed for ~0.2 s) the
	-- follow-through keeps it too.
	local strike=(actor.infused and actor.attackName and (actor.state=="Startup" or actor.state=="Active" or actor.state=="Recovery"))==true
	local now=os.clock()
	if loaded or st.aura then
		local a=if loaded then aura(st,model,loaded) else st.aura
		if a then
			local on=loaded~=nil
			local keep=on or (strike and actor.infused==a.nature)
			if on and not a.wasOn then a.nextBuzz=now+.45;a.nextStomp=now+.6;a.nextArc=now end
			a.wasOn=on
			if a.rim then
				-- a soft pulse: the outline breathes, the fill barely tints
				a.rim.Enabled=keep
				a.rim.OutlineTransparency=if on then .15+.2*math.sin(now*9) else .55
				a.rim.FillTransparency=if on then .8+.04*math.sin(now*9) else .92
			end
			for _,e in a.emitters do e.Enabled=on end
			for _,e in a.both do e.Enabled=keep end
			for _,b in a.beams do b.Enabled=keep end
			if a.loop and a.looping~=on then
				a.looping=on
				if on then a.loop.Volume=.13;a.loop:Play() else a.loop:Stop() end
			end
			local tick=TICK[a.look]
			if tick then tick(fx,a,model,now,dt,on,keep) else ease(a,if on then 1 else 0,dt) end
		end
	end
	if strike or st.limbs then
		local l=if strike then limbs(st,model,actor.infused) else st.limbs
		stepLimbs(fx,l,strike,now,dt)
	end
end

-- ------------------------------------------------------------------ contacts
local function modelOf(folder,id)
	return folder and id and folder:FindFirstChild(id)
end
-- The load: the chakra comes up, each nature its own way.
local function drawLoad(fx,i,look,color,model)
	local p=i.position
	local feet=p-Vector3.new(0,2.6,0)
	if look=="Lightning" then
		-- bolts climb from the floor round the feet into the body
		for k=1,4 do
			local a=k*math.pi/2+math.random()*.8
			local out=Vector3.new(math.cos(a),0,math.sin(a))
			jag(fx,feet+out*1.7,p+out*.4+Vector3.new(0,(math.random()-.3)*1.6,0),if k%2==0 then CORE else color,.09,.12)
		end
		K.sparks(fx.folder,p,CORE,14,20)
		K.flash(fx.folder,p,CORE,.6,4,.1,.3)
	elseif look=="Fire" then
		-- a ring of flame flares out of the floor and climbs
		flames(fx,feet+Vector3.new(0,.3,0),Vector3.yAxis,16,1.6,80)
		embers(fx,p,12)
		K.flash(fx.folder,p,color,.8,4,.16,.35)
	elseif look=="Wind" then
		-- rings of air open flat round the feet and the waist, a spiral under him
		K.shockRing(fx.folder,feet+Vector3.new(0,.15,0),color,2,11,.32)
		K.shockRing(fx.folder,p,CORE,1.5,7,.24)
		whirl(fx,feet+Vector3.new(0,.2,0),color,2,6,.35)
		K.smokePuff(fx.folder,feet+Vector3.new(0,.3,0),Color3.fromRGB(226,240,236),6,1.1)
	elseif look=="Sand" or look=="Earth" then
		-- the floor's sand rises round him and pours back
		K.smokePuff(fx.folder,feet+Vector3.new(0,.4,0),color,12,1.6)
		grains(fx,feet+Vector3.new(0,.3,0),Vector3.yAxis,color,26,9)
		if look=="Earth" then pebbles(fx,feet+Vector3.new(0,.3,0),color,5) end
	elseif look=="GentleFist" then
		-- no ground ring: the chakra gathers in the palms
		local any=false
		for _,name in HANDS do
			local hand=model and model:FindFirstChild(name)
			if hand then any=true;halo(fx,hand.Position,color,.4,2.6,.28) end
		end
		if not any then halo(fx,p,color,.6,3.5,.28) end
		K.shockRing(fx.folder,p+Vector3.new(0,.6,0),CORE,.8,5,.3)
	elseif look=="Strength" then
		-- a stamp: dust thrown out along the floor, a hard pale ring, no glow
		K.smokePuff(fx.folder,feet+Vector3.new(0,.3,0),DUST,14,1.6)
		K.shockRing(fx.folder,feet+Vector3.new(0,.1,0),Color3.fromRGB(255,240,214),2,12,.22)
	else
		-- the chakra comes up out of the ground round the feet
		K.shockRing(fx.folder,feet,color,2,9,.3)
		K.flash(fx.folder,p,color,1,5,.18,.35)
	end
	local root=model and model:FindFirstChild("HumanoidRootPart")
	if root then play(root,cueOf(look,"load")) else playAt(fx,p,cueOf(look,"load")) end
end
-- The infused strike leaves: a touch at the hand, and its sound on the hand.
local function drawStrike(fx,i,look,color,model)
	local hand=model and model:FindFirstChild("RightHand")
	local at=if hand then hand.Position else i.position
	if look=="Lightning" then
		K.sparks(fx.folder,at,CORE,8,14)
		for _=1,2 do jag(fx,at,at+scatter()*1.4,CORE,.06,.08) end
	elseif look=="Fire" then
		flames(fx,at,Vector3.yAxis,6,1,180)
	elseif look=="Wind" then
		local root=model and model:FindFirstChild("HumanoidRootPart")
		K.shockRing(fx.folder,at,CORE,.5,3.5,.14,root and root.CFrame.LookVector)
	elseif look=="Sand" or look=="Earth" then
		grains(fx,at,Vector3.yAxis,color,10,5)
	elseif look=="GentleFist" then
		for _,name in HANDS do
			local h=model and model:FindFirstChild(name)
			if h then halo(fx,h.Position,color,.3,1.8,.2) end
		end
	elseif look=="Strength" then
		-- (no glow: the swing is heard, the limbs show the shoved air)
	else
		K.flash(fx.folder,at,color,.6,3,.12,.3)
	end
	if hand then play(hand,cueOf(look,"swing")) else playAt(fx,at,cueOf(look,"swing")) end
end
-- Contact: each nature's own shape, never the same flash in another colour.
local function drawHit(fx,i,look,color)
	local p=i.position
	local big=i.heavy
	local dir=i.direction or Vector3.zAxis
	dir=if dir.Magnitude&gt;.05 then dir.Unit else Vector3.zAxis
	if look=="Lightning" then
		-- bolts burst out of the contact, and flicker once more
		for k=1,(if big then 5 else 4) do jag(fx,p,p+scatter()*(1.8+math.random()*1.6),if k%2==1 then CORE else color,.1,.12) end
		-- (07/11, Studio: the current lasted one flash, .12 s, while the server
		-- holds the body .2-.45 s longer) it crackles over the body while held.
		task.spawn(function()
			local born=os.clock()
			while os.clock()-born&lt;(if big then .5 else .4) do
				task.wait(.05)
				if not fx.folder.Parent then return end
				-- (Studio: .08 wide arcs were lost on the body) two, thicker
				for k=1,2 do
					local from=p+scatter()*(.4+math.random()*.8)
					jag(fx,from,from+scatter()*(1.4+math.random()*1.4),if k==1 then CORE else color,.13,.1)
				end
			end
		end)
		K.sparks(fx.folder,p,CORE,if big then 24 else 16,30)
		K.flash(fx.folder,p,CORE,1,if big then 6 else 4.5,.12,.1)
	elseif look=="Fire" then
		-- a bloom of flame thrown through the body, embers, a little dark smoke
		flames(fx,p,dir,if big then 22 else 14,if big then 2 else 1.5,55)
		embers(fx,p,if big then 16 else 10)
		K.flash(fx.folder,p,color,1,if big then 6 else 4.5,.18,.2)
		K.smokePuff(fx.folder,p+Vector3.new(0,.8,0),Color3.fromRGB(70,54,46),6,1.4)
	elseif look=="Wind" then
		-- an X of air cuts carried past the body, streaks of air along the line
		slash(fx,p,dir,CORE,if big then 4.6 else 3.6,35,.2)
		slash(fx,p,dir,color,if big then 4.2 else 3.2,-35,.22)
		K.shockRing(fx.folder,p+dir*1.2,color,1.5,if big then 13 else 9,.22,dir)
		aimed(fx,p,dir,{Texture=K.TEX.spark,Orientation=Enum.ParticleOrientation.VelocityParallel,Lifetime=NumberRange.new(.1,.16),
			Speed=NumberRange.new(30,46),SpreadAngle=Vector2.new(16,16),Color=K.seq({{0,CORE},{1,color}}),LightEmission=1,
			Size=K.num({{0,.45},{1,.1}}),Squash=K.num({{0,-1.4},{1,-1.8}}),Transparency=K.num({{0,0},{1,.6}}),Drag=8,ZOffset=1},if big then 12 else 8)
		K.smokePuff(fx.folder,p+dir*1.5,Color3.fromRGB(226,240,236),6,1.3)
	elseif look=="Sand" then
		-- a burst of matte sand and grains sprayed through
		K.smokePuff(fx.folder,p,color,if big then 18 else 12,2)
		grains(fx,p,dir+Vector3.new(0,.4,0),color,if big then 34 else 22,14)
		K.shockRing(fx.folder,p,color:Lerp(Color3.new(0,0,0),.2),2,if big then 11 else 8,.26,dir)
	elseif look=="Earth" then
		pebbles(fx,p,color,if big then 8 else 5)
		K.smokePuff(fx.folder,p,Color3.fromRGB(120,104,86),if big then 16 else 10,2)
		K.shockRing(fx.folder,p,color,2,if big then 12 else 9,.28,dir)
	elseif look=="GentleFist" then
		-- small and exact: the chakra goes in and out through the back
		needle(fx,p,dir,CORE,if big then 5 else 3.8,.16)
		K.shockRing(fx.folder,p+dir*1.6,color,.6,if big then 5 else 3.5,.18,dir)
		halo(fx,p,color,.5,if big then 3.4 else 2.4,.2)
	elseif look=="Strength" then
		-- raw pressure: pale rings, dust, no chakra colour
		K.shockRing(fx.folder,p,CORE,2,if big then 20 else 13,.28,dir)
		if big then K.shockRing(fx.folder,p+dir*1.5,Color3.fromRGB(255,236,200),1.5,12,.22,dir) end
		K.flash(fx.folder,p,CORE,1,if big then 6 else 4,.12,.15)
		K.smokePuff(fx.folder,p,Color3.fromRGB(214,204,180),if big then 14 else 8,if big then 2 else 1.5)
	else
		K.flash(fx.folder,p,color,1,5,.16,.2)
		K.shockRing(fx.folder,p,color,1.5,10,.22,dir)
		halo(fx,p,color,.6,3.6,.22)
	end
	playAt(fx,p,cueOf(look,"hit"),if big then 1.15 else .9)
end
-- The chakra leap: the floor takes the push, each nature its own way.
local function drawLeap(fx,i,look,color)
	local p=i.position
	if look=="Lightning" then
		K.shockRing(fx.folder,p,CORE,2,11,.24)
		for k=1,3 do
			local a=k*2.1+math.random()
			jag(fx,p+Vector3.new(math.cos(a)*1.4,0,math.sin(a)*1.4),p+Vector3.new(0,2.4+math.random(),0),if k==2 then color else CORE,.08,.12)
		end
		K.sparks(fx.folder,p+Vector3.new(0,.3,0),CORE,12,18)
	elseif look=="Fire" then
		flames(fx,p+Vector3.new(0,.3,0),Vector3.yAxis,14,1.5,85)
		K.smokePuff(fx.folder,p+Vector3.new(0,.4,0),Color3.fromRGB(90,74,62),6,1.4)
		groundMark(fx,p,"scorch",5,.9)
	elseif look=="Wind" then
		K.shockRing(fx.folder,p+Vector3.new(0,.1,0),color,2,14,.3)
		K.shockRing(fx.folder,p+Vector3.new(0,1.2,0),CORE,1.5,8,.24)
		whirl(fx,p+Vector3.new(0,.2,0),color,3,8,.4)
		K.smokePuff(fx.folder,p+Vector3.new(0,.4,0),Color3.fromRGB(226,240,236),8,1.4)
	elseif look=="Sand" or look=="Earth" then
		K.smokePuff(fx.folder,p+Vector3.new(0,.4,0),color,16,2)
		grains(fx,p+Vector3.new(0,.3,0),Vector3.yAxis,color,24,12)
		if look=="Earth" then pebbles(fx,p,color,6) end
	elseif look=="GentleFist" then
		K.shockRing(fx.folder,p+Vector3.new(0,.1,0),color,1.5,10,.3)
		halo(fx,p+Vector3.new(0,.3,0),CORE,1,5,.25)
		K.smokePuff(fx.folder,p+Vector3.new(0,.4,0),DUST,6,1.2)
	elseif look=="Strength" then
		-- Lee's leap cracks the floor
		K.shockRing(fx.folder,p+Vector3.new(0,.1,0),Color3.fromRGB(255,240,214),2.5,16,.3)
		K.smokePuff(fx.folder,p+Vector3.new(0,.4,0),DUST,18,2.2)
		groundMark(fx,p,"crack",7,1.4)
	else
		-- the ground takes the push: a ring flat on it and the dust thrown out
		K.shockRing(fx.folder,p,color,2,13,.3)
		K.smokePuff(fx.folder,p+Vector3.new(0,.4,0),DUST,14,1.8)
	end
	playAt(fx,p,cueOf(look,"leap"))
end
local function drawDash(fx,i,look,color,model)
	local p=i.position
	local feet=p-Vector3.new(0,if i.air then 0 else 2.5,0)
	if model and fx.ghost then
		fx:ghost(model,if look=="Strength" then Color3.fromRGB(255,244,226) else color,.25,if look=="Sand" or look=="Strength" then .6 else .45)
	end
	if look=="Lightning" then
		for _=1,3 do jag(fx,p,p+scatter()*2,CORE,.07,.1) end
		K.sparks(fx.folder,p,CORE,12,20)
	elseif look=="Fire" then
		flames(fx,p,Vector3.yAxis,10,1.4,180)
		embers(fx,p,8)
	elseif look=="Wind" then
		K.shockRing(fx.folder,p,CORE,1.5,9,.22)
		whirl(fx,feet+Vector3.new(0,.2,0),color,2,5,.3)
	elseif look=="Sand" or look=="Earth" then
		grains(fx,p,Vector3.yAxis,color,14,8)
		K.smokePuff(fx.folder,p,color,8,1.5)
	elseif look=="GentleFist" then
		halo(fx,p,color,.6,4,.22)
	elseif look=="Strength" then
		-- (no glow: the floor takes the push)
	else
		K.flash(fx.folder,p,color,1,6,.16,.3)
	end
	K.smokePuff(fx.folder,feet,DUST,if i.air then 4 elseif look=="Strength" then 14 else 10,1.5)
	playAt(fx,p,cueOf(look,"dash"))
end
local function impact(fx,i,folder)
	local style=i.style
	if style~="chakraload" and style~="chakrastrike" and style~="chakrahit" and style~="chakraleap" and style~="chakradash" then return false end
	local look=lookOf(i.nature)
	local color=colorOf(i.nature)
	local p=i.position
	if style=="chakraload" then
		drawLoad(fx,i,look,color,modelOf(folder,i.owner))
	elseif style=="chakrastrike" then
		drawStrike(fx,i,look,color,modelOf(folder,i.owner))
	elseif style=="chakrahit" then
		-- (Neji's Rotation draws its dome, not a palm through his own body)
		if i.sig~="Rotation" then drawHit(fx,i,look,color) end
		if i.guarded then K.flash(fx.folder,p,Color3.fromRGB(255,214,120),.5,3,.1,.3) end
		-- (DEC-032) a signature's own mark: Kakashi's spike of earth, Neji's
		-- Rotation dome
		if i.sig=="EarthSpike" then
			local ok=pcall(function()
				local spike=Instance.new("Part");spike.Name="EarthSpike";spike.Anchored=true;spike.CanCollide=false;spike.CanQuery=false
				spike.Material=Enum.Material.Slate;spike.Color=color;spike.Size=Vector3.new(1.5,.2,1.5)
				local base=CFrame.new(p)*CFrame.Angles(0,math.rad(45),math.rad(4))
				spike.CFrame=base;spike.Parent=fx.folder
				local TS=game:GetService("TweenService")
				TS:Create(spike,TweenInfo.new(.12,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=Vector3.new(1.5,6.5,1.5),CFrame=base*CFrame.new(0,3.2,0)}):Play()
				task.delay(.55,function() if spike.Parent then TS:Create(spike,TweenInfo.new(.35),{Transparency=1,Size=Vector3.new(1.2,4,1.2)}):Play() end end)
				game:GetService("Debris"):AddItem(spike,1)
			end)
			K.smokePuff(fx.folder,p,Color3.fromRGB(120,104,86),18,2.2)
			if not ok then K.shockRing(fx.folder,p,color,2,12,.3,Vector3.yAxis) end
			-- (06/11) the floor it burst out of cracks, briefly
			groundMark(fx,p+Vector3.new(0,.3,0),"crack",6,1.2)
		elseif i.sig=="Rotation" then
			K.shockRing(fx.folder,p,color,3,14,.36,Vector3.yAxis)
			K.flash(fx.folder,p,CORE,1,8,.2,.2)
			-- (06/11) the spin is heard: a deep turn of air
			playAt(fx,p,{{"whoosh",.45,.6},{"swish",.3,.8}})
		end
	elseif style=="chakraleap" then
		drawLeap(fx,i,look,color)
	elseif style=="chakradash" then
		drawDash(fx,i,look,color,modelOf(folder,i.owner))
	end
	-- the other layers still draw their own on a chakra hit (a fist burst...)
	return style~="chakrahit"
end

function ChakraFlowFX.install(FX,kit)
	K=kit
	table.insert(FX.layers,{name="ChakraFlow",impact=impact,fighter=fighter})
end
return ChakraFlowFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="ND199">
          <Properties>
            <string name="Name">CombatDebug</string>
            <ProtectedString name="Source">-- Optional debug-build display, outbound server data only; no combat input.
local RunService=game:GetService("RunService")
if not RunService:IsStudio() then return end
local Players=game:GetService("Players")
local remote=game:GetService("ReplicatedStorage"):WaitForChild("NinjaDuelCombatDebug",10)
if not remote then return end
local gui=Instance.new("ScreenGui");gui.Name="NinjaDuelCombatInspector";gui.ResetOnSpawn=false;gui.DisplayOrder=100
-- (Studio 03/11) Hidden until F8: open by default it covered the player's
-- plate and a third of the fight.
gui.Enabled=false
local panel=Instance.new("TextLabel");panel.Size=UDim2.fromOffset(590,340);panel.Position=UDim2.fromOffset(12,12)
panel.BackgroundColor3=Color3.fromRGB(18,20,28);panel.BackgroundTransparency=.15;panel.TextColor3=Color3.fromRGB(220,237,245)
panel.Font=Enum.Font.Code;panel.TextSize=13;panel.TextXAlignment=Enum.TextXAlignment.Left;panel.TextYAlignment=Enum.TextYAlignment.Top
panel.Text="Ninja Duel debug — waiting for a duel (F8: show/hide)";panel.Parent=gui;gui.Parent=Players.LocalPlayer:WaitForChild("PlayerGui")
game:GetService("UserInputService").InputBegan:Connect(function(input,processed)
 if not processed and input.KeyCode==Enum.KeyCode.F8 then gui.Enabled=not gui.Enabled end
end)
remote.OnClientEvent:Connect(function(data)
 local lines={"NINJA DUEL — READ-ONLY DEBUG  /  F8 hide/show",string.format("%s  t=%.2f  projectiles=%d hazards=%d",data.phase,data.now,data.projectileCount,data.hazardCount)}
 for _,a in data.actors do
  local tools={};for _,p in a.projectiles do table.insert(tools,p.kind.."#"..p.id) end
  table.insert(lines,string.format("\n%s [%s]  HP %.0f  chakra %.0f",a.name,a.fighterId,a.health,a.chakra))
  table.insert(lines,string.format("%s / %s  move=%s variant=%s",a.state,a.reaction,a.move,a.attackVariant))
  table.insert(lines,string.format("phase=%s %.3fs  combo=%d hits=%d chain=%s",a.phase,a.phaseRemaining,a.combo,a.comboHits,tostring(a.chainOpen)))
  table.insert(lines,string.format("%s / %s  lock=%s target=%s",a.terrain,a.movement,tostring(a.locked),a.target))
  table.insert(lines,string.format("guard=%s stam=%.0f parryCD=%.2f dodge=%.2f counter=%.2f",tostring(a.guard),a.stamina,a.parryCooldown,a.dodge,a.counter))
  table.insert(lines,string.format("grab=%s bound=%s throw=%s tools=%s",a.grabbedBy,tostring(a.bound),a.throw and a.throw.kind or "none",table.concat(tools,",")))
  table.insert(lines,string.format("clashes=%d riposte=%.2f awaken=%.2f",a.clashes,a.riposte,a.awakening))
 end
 panel.Text=table.concat(lines,"\n")
end)
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND200">
          <Properties>
            <string name="Name">CopyFX</string>
            <ProtectedString name="Source">-- (06/11, « le Sharingan qui copie ») Kakashi's copy on screen (Server/Copy).
-- The read: while the opponent weaves the jutsu in front of him, a thin red
-- line runs from Kakashi's left eye to the hands that make it, and three
-- tomoe turn round that eye; when it is his, a red glint. The copied cast:
-- the same glint and red sparks from his hand. His left eye stays lit while he
-- holds a copy (Effects, the Copycat face). One identity layer installed into
-- Effects. Presentation only.
local CopyFX={}
local K -- Effects' helpers, handed over by install()
CopyFX.clock=os.clock -- (headless tests drive time)
local RED=Color3.fromRGB(235,30,40)
local CORE=Color3.fromRGB(255,170,160)
local DARK=Color3.fromRGB(40,6,10)
-- The left eye of a head (its front is -Z, the body's left is -X).
local function eyeOf(model)
	local head=model and model:FindFirstChild("Head")
	if not head then return nil end
	local s=head.Size
	return head.CFrame*CFrame.new(-s.X*.2,s.Y*.08,-s.Z*.5)
end
local function handOf(model)
	local hand=model and (model:FindFirstChild("RightHand") or model:FindFirstChild("Right Arm"))
	return if hand then hand.Position else (model and model:GetPivot().Position)
end
-- The reads in progress: {holder, line, from, to, tomoe, ring, kakashi, caster, untilT, born}.
local reads={}
local function read(fx,impact,folder)
	local kakashi=folder and folder:FindFirstChild(impact.owner or "")
	local caster=folder and folder:FindFirstChild(impact.from or "")
	local eye=eyeOf(kakashi)
	if not eye then return true end
	local now=CopyFX.clock()
	local holder=K.new("Model",{Name="SharinganCopy"},fx.folder)
	-- The gaze: a thin beam, bright at the eye, fading toward the hands.
	local from=K.block(holder,Vector3.one*.05,eye,RED,Enum.Material.Neon);from.Transparency=1
	local to=K.block(holder,Vector3.one*.05,eye,RED,Enum.Material.Neon);to.Transparency=1
	local a0=K.new("Attachment",{},from);local a1=K.new("Attachment",{},to)
	local line=K.new("Beam",{Attachment0=a0,Attachment1=a1,Width0=.09,Width1=.025,FaceCamera=true,Segments=1,LightEmission=1,LightInfluence=0,
		Color=ColorSequence.new(RED),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.1),NumberSequenceKeypoint.new(.6,.65),NumberSequenceKeypoint.new(1,.92)})},holder)
	local tomoe={}
	for k=1,3 do
		local ball=K.block(holder,Vector3.one*.11,eye,DARK,Enum.Material.Neon)
		ball.Shape=Enum.PartType.Ball
		tomoe[k]=ball
	end
	local ring=K.block(holder,Vector3.new(.03,.4,.4),eye,RED,Enum.Material.Neon,"Part")
	ring.Shape=Enum.PartType.Cylinder;ring.Transparency=.5
	-- (Studio only, for filming: workspace.NDCopyHold = seconds holds the read.)
	local ok,hold=pcall(function() return workspace:GetAttribute("NDCopyHold") end)
	local last=if ok and type(hold)=="number" then hold else math.clamp(impact.channel or .3,.35,.7)
	table.insert(reads,{holder=holder,line=line,from=from,to=to,tomoe=tomoe,ring=ring,kakashi=kakashi,caster=caster,born=now,untilT=now+last})
	-- The moment it is his: a red glint at the eye.
	K.flash(holder,eye.Position,RED,.3,1.6,.18,.4)
	K.sound(K.anchorPart(fx.folder,eye.Position),K.SOUND.whoosh,.25,2.2)
	return true
end
local function frame(fx,data,dt,folder)
	if #reads==0 then return end
	local now=CopyFX.clock()
	for i=#reads,1,-1 do
		local r=reads[i]
		local eye=eyeOf(r.kakashi)
		local gone=not eye or not r.holder.Parent
		local t=now-r.born
		local fade=math.clamp((now-r.untilT)/.2,0,1)
		if gone or fade&gt;=1 then
			if r.holder.Parent then r.holder:Destroy() end
			table.remove(reads,i)
		else
			r.from.CFrame=eye;r.to.CFrame=CFrame.new(handOf(r.caster) or eye.Position)
			r.line.Enabled=fade&lt;.95
			-- Three tomoe turning round the eye, in the plane of the face.
			for k,ball in r.tomoe do
				local a=t*14+k*2*math.pi/3
				ball.CFrame=eye*CFrame.new(math.cos(a)*.24,math.sin(a)*.24,-.04)
				ball.Transparency=fade
			end
			r.ring.CFrame=eye*CFrame.Angles(0,math.rad(90),0)*CFrame.new(.03,0,0)
			r.ring.Transparency=.5+.5*fade
		end
	end
end
-- He casts the jutsu he copied: the glint again, red sparks from his hand.
local function cast(fx,impact,folder)
	local kakashi=folder and folder:FindFirstChild(impact.owner or "")
	local eye=eyeOf(kakashi)
	local hand=handOf(kakashi)
	if eye then K.flash(fx.folder,eye.Position,RED,.3,1.4,.16,.4) end
	if hand then
		K.burst(fx.folder,hand,{Texture=K.TEX.spark,Lifetime=NumberRange.new(.15,.35),Speed=NumberRange.new(8,16),SpreadAngle=Vector2.new(180,180),
			Color=ColorSequence.new(RED,CORE),LightEmission=1,Size=K.num({{0,.4},{1,0}}),Drag=5},14)
	end
	return true
end
local function impact(fx,data,folder)
	if data.style=="copy" then return read(fx,data,folder) end
	if data.style=="copycast" then return cast(fx,data,folder) end
	return false
end
function CopyFX.install(Effects,kit)
	K=kit
	table.insert(Effects.layers,{name="Copy",impact=impact,frame=frame})
end
return CopyFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND201">
          <Properties>
            <string name="Name">CupScreen</string>
            <ProtectedString name="Source">-- The Prodigy Tournament on screen (Server/Tournament): the bracket between
-- matches, the spectator banner on a match the player watches, the champion's
-- card. House ink cards (UI.kit); the server decides every result and every
-- next match, the buttons only send CupFight / CupSkip / CupStart / CupLeave.
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
-- (QA 12/11) capitals that keep the long vowels and accents.
local Text=require(Shared.Text)
local Fighters=require(Shared.Fighters)
local Cup={};Cup.__index=Cup

local W,H=300,44
local QF_Y={150,202,302,354,454,506,606,658}
local SF_Y={176,328,480,632}
local F_Y={252,556}
local CHAMP_Y=404
local COLS={110,500,890,1240}

function Cup.new(ui,send,kit)
	local K,P=kit,kit.palette
	local self=setmetatable({ui=ui,send=send,kit=K,plates={}},Cup)
	local root=K.frame(ui.gui,UDim2.fromScale(0,0),UDim2.fromScale(1,1),Color3.fromRGB(8,7,10),.08)
	root.ZIndex=40;root.Visible=false
	self.root=root
	local shell=K.frame(root,UDim2.fromScale(.5,.5),UDim2.fromOffset(1600,900),P.ink,1)
	shell.AnchorPoint=Vector2.new(.5,.5);shell.ZIndex=41
	local scale=K.create("UIScale",shell,{Scale=1})
	local function fit()
		local size=workspace.CurrentCamera.ViewportSize
		scale.Scale=math.min(1.25,size.X/1600,size.Y/900)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit);fit()
	self.shell=shell
	local title=K.inkTitle(K.text(shell,"PRODIGY TOURNAMENT",UDim2.fromOffset(110,30),UDim2.fromOffset(900,64),60,P.paper,K.TITLE_FONT))
	title.ZIndex=42
	self.subtitle=K.text(shell,"",UDim2.fromOffset(112,92),UDim2.fromOffset(1100,22),16,P.gold,K.BODY_FONT);self.subtitle.ZIndex=42
	for i,name in {"QUARTER-FINALS","SEMI-FINALS","FINAL","CHAMPION"} do
		local head=K.text(shell,name,UDim2.fromOffset(COLS[i],118),UDim2.fromOffset(W,24),18,P.muted,K.TITLE_FONT,Enum.TextXAlignment.Center)
		head.ZIndex=42
	end
	-- 8 + 4 + 2 + 1 plates: a seat's fighter, lit as it advances.
	local function plate(x,y)
		local f=K.frame(shell,UDim2.fromOffset(x,y),UDim2.fromOffset(W,H),Color3.fromRGB(26,23,30),.05)
		K.corner(f,6);f.ZIndex=42
		local edge=K.create("UIStroke",f,{Color=P.paper,Thickness=1.5,Transparency=.75,ApplyStrokeMode=Enum.ApplyStrokeMode.Border})
		local bar=K.frame(f,UDim2.fromOffset(0,0),UDim2.new(0,6,1,0),P.muted,0);bar.ZIndex=43
		local label=K.text(f,"",UDim2.fromOffset(16,0),UDim2.fromOffset(W-70,H),24,P.paper,K.TITLE_FONT);label.ZIndex=43
		local tag=K.text(f,"",UDim2.fromOffset(W-60,0),UDim2.fromOffset(52,H),14,P.gold,K.TITLE_FONT,Enum.TextXAlignment.Right);tag.ZIndex=43
		return {frame=f,edge=edge,bar=bar,label=label,tag=tag}
	end
	self.qf,self.sf,self.f={},{},{}
	for i,y in QF_Y do self.qf[i]=plate(COLS[1],y) end
	for i,y in SF_Y do self.sf[i]=plate(COLS[2],y) end
	for i,y in F_Y do self.f[i]=plate(COLS[3],y) end
	self.champ=plate(COLS[4],CHAMP_Y)
	-- The bracket's lines: each match joins its two plates and runs to the
	-- plate its winner moves to (lit gold along the winner's path, red on the
	-- next match).
	local function seg(x,y,w,h)
		local l=K.frame(shell,UDim2.fromOffset(x,y),UDim2.fromOffset(w,h),P.muted,.55)
		l.BorderSizePixel=0;l.ZIndex=41
		return l
	end
	self.links={}
	local function link(m,x0,ya,yb,x1,yc)
		local mid=x0+math.floor((x1-x0)/2)
		local ca,cb,cc=ya+H/2-1,yb+H/2-1,yc+H/2-1
		self.links[m]={a=seg(x0,ca,mid-x0,2),b=seg(x0,cb,mid-x0,2),
			upA=seg(mid-1,ca,2,cc-ca+2),upB=seg(mid-1,cc,2,cb-cc+2),out=seg(mid,cc,x1-mid,2)}
	end
	for i=1,4 do link(i,COLS[1]+W,QF_Y[2*i-1],QF_Y[2*i],COLS[2],SF_Y[i]) end
	link(5,COLS[2]+W,SF_Y[1],SF_Y[2],COLS[3],F_Y[1])
	link(6,COLS[2]+W,SF_Y[3],SF_Y[4],COLS[3],F_Y[2])
	link(7,COLS[3]+W,F_Y[1],F_Y[2],COLS[4],CHAMP_Y)
	-- The next match: who, the words before it, the buttons.
	local panel=K.inkCard(K.frame(shell,UDim2.fromOffset(110,722),UDim2.fromOffset(1430,150),K.CARD,0),10)
	panel.ZIndex=42
	self.nextTitle=K.inkTitle(K.text(panel,"",UDim2.fromOffset(24,12),UDim2.fromOffset(820,40),34,P.paper,K.TITLE_FONT));self.nextTitle.ZIndex=43
	self.lineA=K.text(panel,"",UDim2.fromOffset(26,58),UDim2.fromOffset(820,36),15,P.text,K.BODY_FONT);self.lineA.ZIndex=43
	self.lineB=K.text(panel,"",UDim2.fromOffset(26,96),UDim2.fromOffset(820,36),15,P.muted,K.BODY_FONT);self.lineB.ZIndex=43
	self.primary=K.button(panel,"FIGHT",UDim2.fromOffset(880,18),UDim2.fromOffset(526,56),function() self:press("primary") end,P.red)
	self.primary.ZIndex=43;self.primary.TextSize=32
	self.secondary=K.button(panel,"SKIP",UDim2.fromOffset(880,84),UDim2.fromOffset(256,48),function() self:press("secondary") end)
	self.secondary.ZIndex=43
	self.leave=K.button(panel,"LEAVE",UDim2.fromOffset(1150,84),UDim2.fromOffset(256,48),function() self:press("leave") end)
	self.leave.ZIndex=43
	-- The champion's card.
	local champion=K.inkCard(K.frame(root,UDim2.fromScale(.5,.5),UDim2.fromOffset(700,420),K.CARD,0))
	champion.AnchorPoint=Vector2.new(.5,.5);champion.ZIndex=50;champion.Visible=false
	-- (Studio 04/11: unscaled, the card filled most of a laptop's play window
	-- and would overflow a phone) fitted to the screen like the banner.
	local championScale=K.create("UIScale",champion,{Scale=1})
	local function fitChampion()
		local size=workspace.CurrentCamera.ViewportSize
		championScale.Scale=math.clamp(math.min(size.X/1100,size.Y/640),.5,1.2)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fitChampion);fitChampion()
	self.championCard=champion
	local seal=K.text(champion,"勝",UDim2.fromOffset(700-90,-40),UDim2.fromOffset(120,120),84,P.paper,K.BODY_FONT,Enum.TextXAlignment.Center)
	seal.BackgroundColor3=P.red;seal.BackgroundTransparency=0;seal.Rotation=12;seal.ZIndex=52;K.corner(seal,12)
	K.create("UIStroke",seal,{Color=P.paper,Thickness=3,ApplyStrokeMode=Enum.ApplyStrokeMode.Border})
	local ct=K.inkTitle(K.text(champion,"CHAMPION",UDim2.fromOffset(30,40),UDim2.fromOffset(640,90),88,P.gold,K.TITLE_FONT,Enum.TextXAlignment.Center));ct.ZIndex=51
	self.championName=K.text(champion,"",UDim2.fromOffset(30,140),UDim2.fromOffset(640,44),36,P.paper,K.TITLE_FONT,Enum.TextXAlignment.Center);self.championName.ZIndex=51
	local cn=K.text(champion,"Eight prodigies entered the arena. One walks out with the tournament.",UDim2.fromOffset(40,190),UDim2.fromOffset(620,44),16,P.muted,K.BODY_FONT,Enum.TextXAlignment.Center);cn.ZIndex=51
	local again=K.button(champion,"NEW TOURNAMENT",UDim2.fromOffset(40,262),UDim2.fromOffset(620,56),function() self.send("CupStart",{player=self.lastFighter}) end,P.red)
	again.ZIndex=51
	local back=K.button(champion,"BACK TO THE ROSTER",UDim2.fromOffset(40,330),UDim2.fromOffset(620,56),function() self.send("CupLeave") end)
	back.ZIndex=51
	self.championAgain=again
	-- The spectator's banner over a watched match.
	local banner=K.inkCard(K.frame(ui.gui,UDim2.new(.5,0,1,-118),UDim2.fromOffset(640,70),K.CARD,0),10)
	banner.AnchorPoint=Vector2.new(.5,0);banner.ZIndex=45;banner.Visible=false
	local bannerScale=K.create("UIScale",banner,{Scale=1})
	local function fitBanner()
		local size=workspace.CurrentCamera.ViewportSize
		bannerScale.Scale=math.clamp(math.min(size.X/1500,size.Y/860),.55,1.2)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fitBanner);fitBanner()
	self.banner=banner
	self.bannerText=K.text(banner,"",UDim2.fromOffset(18,8),UDim2.fromOffset(440,54),20,P.paper,K.TITLE_FONT);self.bannerText.ZIndex=46
	local skip=K.button(banner,"SKIP",UDim2.fromOffset(474,12),UDim2.fromOffset(148,46),function() self.send("CupSkip") end,P.red)
	skip.ZIndex=46
	self.skip=skip
	return self
end
local function nameOf(id)
	local def=Fighters[id or ""]
	return if def then Text.upper(def.Name) else "?"
end
function Cup:press(which)
	local cup=self.cup
	if not cup then return end
	if which=="leave" then self.send("CupLeave");return end
	if cup.over or cup.out then
		if which=="primary" then self.send("CupStart",{player=cup.seats[cup.me]}) else self.send("CupLeave") end
		return
	end
	local n=cup.next
	if not n then return end
	if which=="primary" then self.send("CupFight") elseif not n.mine then self.send("CupSkip") end
end
function Cup:fill(p,seat,cup,alive)
	local P=self.kit.palette
	if not seat then
		p.label.Text="—";p.tag.Text="";p.bar.BackgroundColor3=P.muted;p.label.TextColor3=P.muted;p.edge.Transparency=.85
		return
	end
	local id=cup.seats[seat]
	local def=Fighters[id or ""]
	p.label.Text=nameOf(id)
	p.bar.BackgroundColor3=if def then Color3.fromRGB(table.unpack(def.Color)) else P.muted
	local mine=seat==cup.me
	p.tag.Text=if mine then "YOU" else ""
	p.label.TextColor3=if alive then P.paper else P.muted
	p.frame.BackgroundTransparency=if alive then .05 else .45
	p.edge.Color=if mine then P.gold else P.paper
	p.edge.Transparency=if mine then .1 else .75
end
function Cup:draw(cup)
	self.cup=cup
	self.lastFighter=cup.seats[cup.me]
	local w=cup.winners
	-- A seat is alive until a match it played was lost.
	local lost={}
	local Pair={[1]={1,2},[2]={3,4},[3]={5,6},[4]={7,8}}
	for m=1,4 do if w[m] then for _,seat in Pair[m] do if seat~=w[m] then lost[seat]=true end end end end
	local function sfSeats(m) if m==5 then return w[1],w[2] else return w[3],w[4] end end
	for _,m in {5,6} do if w[m] then local a,b=sfSeats(m);for _,seat in {a,b} do if seat and seat~=w[m] then lost[seat]=true end end end end
	if w[7] then for _,seat in {w[5],w[6]} do if seat and seat~=w[7] then lost[seat]=true end end end
	for i=1,8 do self:fill(self.qf[i],i,cup,not lost[i]) end
	for i=1,4 do self:fill(self.sf[i],w[i],cup,w[i]~=nil and not lost[w[i]]) end
	self:fill(self.f[1],w[5],cup,w[5]~=nil and not lost[w[5]])
	self:fill(self.f[2],w[6],cup,w[6]~=nil and not lost[w[6]])
	self:fill(self.champ,w[7],cup,w[7]~=nil)
	local P=self.kit.palette
	-- (the tournament's winner in gold)
	if w[7] then self.champ.label.TextColor3=P.gold;self.champ.edge.Color=P.gold;self.champ.edge.Transparency=0 end
	local n=cup.next
	-- The lines: the winner's side and the run to the next plate in gold, the
	-- match about to be played in red, the rest faint.
	local function seatsOf(m)
		if m&lt;=4 then return 2*m-1,2*m elseif m==5 then return w[1],w[2] elseif m==6 then return w[3],w[4] end
		return w[5],w[6]
	end
	local live=n and not cup.over and not cup.out and n.match
	for m,l in self.links do
		local a,b=seatsOf(m)
		local won=w[m]
		local function paint(segment,lit)
			local hot=live==m
			segment.BackgroundColor3=if hot then P.red elseif lit then P.gold else P.muted
			segment.BackgroundTransparency=if hot or lit then 0 else .55
		end
		paint(l.a,won~=nil and won==a);paint(l.upA,won~=nil and won==a)
		paint(l.b,won~=nil and won==b);paint(l.upB,won~=nil and won==b)
		paint(l.out,won~=nil)
	end
	if cup.over or cup.out then
		local champion=cup.champion and nameOf(cup.seats[cup.champion]) or "?"
		self.subtitle.Text=if cup.out then "ELIMINATED IN THE "..tostring(cup.eliminatedIn or "").."  •  THE REST OF THE BRACKET WAS PLAYED OUT" else "THE TOURNAMENT IS OVER"
		self.nextTitle.Text="CHAMPION  •  "..champion
		self.lineA.Text=if cup.out then "Even prodigies lose. Learn the opening you missed, then come back to the arena." else ""
		self.lineB.Text=""
		self.primary.Text="NEW TOURNAMENT"
		self.secondary.Text="BACK TO THE ROSTER";self.secondary.Visible=true
		self.leave.Visible=false
	elseif n then
		local a,b=nameOf(cup.seats[n.a]),nameOf(cup.seats[n.b])
		self.subtitle.Text=string.format("%s  •  MATCH %d OF 7  •  FIRST TO TWO ROUNDS",n.roundName or "",n.match or 0)
		self.nextTitle.Text=string.format("%s  •  %s  VS  %s",n.roundName or "",a,b)
		self.lineA.Text=a..":  “"..tostring(n.lineA or "").."”"
		self.lineB.Text=b..":  “"..tostring(n.lineB or "").."”"
		self.primary.Text=if n.mine then "FIGHT" else "WATCH"
		self.secondary.Text="SKIP";self.secondary.Visible=not n.mine
		self.leave.Text="LEAVE";self.leave.Visible=true
		self.primary.BackgroundColor3=P.red
	end
	local nextMatch=n and n.match
	for _,p in {self.qf,self.sf,self.f} do for _,pl in p do pl.frame.Size=UDim2.fromOffset(W,H) end end
	-- The two plates of the next match stand out.
	if n and not cup.over and not cup.out then
		local plates={}
		if nextMatch&lt;=4 then plates={self.qf[n.a],self.qf[n.b]}
		elseif nextMatch==5 then plates={self.sf[1],self.sf[2]} elseif nextMatch==6 then plates={self.sf[3],self.sf[4]}
		else plates={self.f[1],self.f[2]} end
		for _,pl in plates do pl.edge.Color=P.red;pl.edge.Transparency=0 end
	end
end
-- Called with every game packet.
function Cup:render(data)
	local phase=data.phase
	self.root.Visible=phase=="Bracket" or phase=="Champion"
	self.championCard.Visible=phase=="Champion"
	self.shell.Visible=phase=="Bracket"
	if data.cup and (phase=="Bracket" or phase=="Champion") then self:draw(data.cup) end
	-- (pad focus after the UI's own screen change has settled)
	local function focus(target) task.delay(.25,function() pcall(function() game:GetService("GuiService").SelectedObject=target end) end) end
	if phase=="Champion" and data.cup and data.cup.champion then
		self.championName.Text=Text.upper((Fighters[data.cup.seats[data.cup.champion]] or {}).FullName or "")
		if self.lastPhase~="Champion" then focus(self.championAgain) end
	elseif phase=="Bracket" and self.lastPhase~="Bracket" then
		focus(self.primary)
	end
	-- Watching a match: whose, which round, SKIP.
	local watching=phase=="Duel" and data.spectate==true and data.cup~=nil
	-- (Audit 04/11) not over the intro's VS and names, not over the K.O. (the
	-- result on screen is the result); on a pad SKIP takes the focus.
	self.banner.Visible=watching and not data.ko and (data.intro or 0)&lt;=0
	if self.banner.Visible and not self.bannerShown and data.gamepad then focus(self.skip) end
	self.bannerShown=self.banner.Visible
	if watching then
		local n=data.cup.next
		local a,b=nameOf(data.human and data.human.fighterId),nameOf(data.bot and data.bot.fighterId)
		self.bannerText.Text=string.format("SPECTATING  •  %s\n%s  VS  %s",n and n.roundName or "",a,b)
	end
	self.lastPhase=phase
end
return Cup
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND202">
          <Properties>
            <string name="Name">DashTrailFX</string>
            <ProtectedString name="Source">-- (Feel audit 07/11, need 4: « les jutsu de déplacement ») Minato's Lightning
-- Strike moves him 11-14 studs in ONE frame, Kakashi's Lightning Cut 18: on
-- the screen the body was here, then there, with a puff at each end and
-- nothing between (FamilyFX draws a family relocation as two puffs). The eye
-- has to be told where he went. This layer draws the path itself, before
-- FamilyFX sees the impact:
--   * the line he went along: a bright beam at chest height that is drawn
--     from the departure to the arrival (it is not there at once: it runs, in
--     .06 s, the speed of the jutsu made visible) and thins out behind him;
--     a scorch on the floor along the same line, slower to go;
--   * afterimages of his arrival pose strung back along the line (the body
--     seen at three or four instants of a move too fast to see), the nearest
--     to the arrival the brightest;
--   * Minato's: yellow, clean (one straight line, the Flying Thunder God);
--     Kakashi's: white-blue lightning, the line broken into a zigzag that
--     re-forks twice while it fades (it crackles), sparks where it lands -
--     drawn with LightningBoltFX (SamyBlue/Lightning-Beams, MIT, adapted).
-- The arrival pose is the clip's (Flashstep.LightningStrike.Arrive,
-- Copycat.LightningCut.Arrive, AuthoredClips50). No plain Neon parts (VFX
-- bible 06/11): beams on invisible anchors, ForceField afterimages.
-- Presentation only; every call is guarded (a failure costs this frame's
-- trail, never Effects).
local DashTrailFX={}
local K -- Effects' helpers (install)
DashTrailFX.KINDS={
	flash={core=Color3.fromRGB(255,250,214),edge=Color3.fromRGB(255,206,60),zig=0,ghosts=4,width=.55},
	lightning={core=Color3.fromRGB(240,248,255),edge=Color3.fromRGB(120,180,255),zig=.9,ghosts=3,width=.45},
}
DashTrailFX.RUN=.06   -- seconds for the line to reach the arrival
DashTrailFX.LIFE=.32  -- seconds the line lasts
DashTrailFX.MIN=3     -- studs: a shorter move has no trail
local Debris=game:GetService("Debris")
local Bolt=require(script.Parent.LightningBoltFX)
local function anchor(parent,position)
	local p=K.new("Part",{Name="TrailAnchor",Anchored=true,CanCollide=false,CanQuery=false,CanTouch=false,CastShadow=false,
		Transparency=1,Size=Vector3.new(.05,.05,.05),CFrame=CFrame.new(position)},parent)
	return p,K.new("Attachment",{},p)
end
local function seq(a,b) return NumberSequence.new({NumberSequenceKeypoint.new(0,a),NumberSequenceKeypoint.new(1,b)}) end
-- One beam from a to b (attachments), fading with the line.
local function beam(holder,a0,a1,color,width0,width1,transparency)
	return K.new("Beam",{Attachment0=a0,Attachment1=a1,Width0=width0,Width1=width1,FaceCamera=true,Segments=1,
		LightEmission=1,LightInfluence=0,Color=ColorSequence.new(color),Transparency=seq(transparency,transparency)},holder)
end
-- The points of the line: straight for Minato, a zigzag for Kakashi.
function DashTrailFX.points(from,to,zig,rng)
	local line=to-from
	local n=if zig&gt;0 then math.max(4,math.floor(line.Magnitude/2.2)) else 1
	local side=line:Cross(Vector3.yAxis)
	side=if side.Magnitude&gt;1e-3 then side.Unit else Vector3.xAxis
	local out={from}
	for i=1,n-1 do
		local u=i/n
		local j=zig*(rng:NextNumber()*2-1)
		table.insert(out,from+line*u+side*j+Vector3.new(0,zig*.6*(rng:NextNumber()*2-1),0))
	end
	table.insert(out,to)
	return out
end
local function draw(fx,impact,folder,look)
	local from,to=impact.from or impact.position,impact.to or impact.position
	local line=Vector3.new(to.X-from.X,0,to.Z-from.Z)
	if line.Magnitude&lt;DashTrailFX.MIN then return false end
	local holder=K.new("Model",{Name="DashTrail"},fx.folder)
	Debris:AddItem(holder,DashTrailFX.LIFE+.5)
	local chest=Vector3.new(0,.4,0)
	local rng=Random.new()
	-- The line, drawn from the departure: each segment appears in turn.
	local function bolt(width,transparency,lifeK)
		local pts=DashTrailFX.points(from+chest,to+chest,look.zig,rng)
		local atts={}
		for i,p in pts do local _,a=anchor(holder,p);atts[i]=a end
		local beams={}
		for i=1,#atts-1 do
			local u=(i-1)/(#atts-1)
			task.delay(DashTrailFX.RUN*u,function()
				if not holder.Parent then return end
				-- the tail (departure) thinner than the head (arrival)
				local b=beam(holder,atts[i],atts[i+1],look.core,width*(.35+.65*u),width*(.35+.65*(i/(#atts-1))),transparency)
				local glow=beam(holder,atts[i],atts[i+1],look.edge,width*2.4*(.35+.65*u),width*2.4*(.35+.65*(i/(#atts-1))),math.min(.9,transparency+.35))
				table.insert(beams,b);table.insert(beams,glow)
			end)
		end
		task.delay(DashTrailFX.LIFE*lifeK,function()
			for _,b in beams do if b.Parent then b:Destroy() end end
		end)
	end
	if look.zig&gt;0 then
		-- Kakashi: real lightning along the line (LightningBoltFX, the
		-- Lightning-Beams maths): it runs from the departure to the arrival in
		-- RUN seconds (the pulse), then two more forks of the same line crackle
		-- while the first fades.
		Bolt.folder=fx.folder
		local function fork(width,radius,delay)
			task.delay(delay,function()
				local a,b=from+chest,to+chest
				local axis=(b-a).Unit
				local bolt=Bolt.new(Bolt.point(a,axis),Bolt.point(b,axis),math.clamp(math.floor((b-a).Magnitude*1.6),10,30))
				bolt.Color=look.core;bolt.GlowColor=look.edge
				bolt.Thickness=width;bolt.MinRadius=.1;bolt.MaxRadius=radius
				bolt.Frequency=1.4;bolt.AnimationSpeed=9
				bolt.PulseSpeed=1/DashTrailFX.RUN;bolt.PulseLength=DashTrailFX.LIFE/DashTrailFX.RUN;bolt.FadeLength=.15
				task.delay(DashTrailFX.RUN+DashTrailFX.LIFE*.5,function() pcall(bolt.DestroyDissipate,bolt,.15,.6) end)
			end)
		end
		fork(look.width*.7,look.zig,0)
		fork(look.width*.45,look.zig*1.4,.08)
		fork(look.width*.3,look.zig*1.8,.16)
	else
		bolt(look.width,.05,1)
	end
	-- The scorch on the floor, under the line, slower to go.
	local floor=K.floorUnder and K.floorUnder(fx,from,1,6)
	local y=if floor then floor.Position.Y+.08 else from.Y-2.5
	local _,g0=anchor(holder,Vector3.new(from.X,y,from.Z))
	local _,g1=anchor(holder,Vector3.new(to.X,y,to.Z))
	local scorch=K.new("Beam",{Attachment0=g0,Attachment1=g1,Width0=.25,Width1=.9,FaceCamera=false,Segments=1,LightEmission=.6,LightInfluence=.4,
		Color=ColorSequence.new(look.edge),Transparency=seq(.6,.25)},holder)
	g0.Axis=Vector3.yAxis;g1.Axis=Vector3.yAxis
	local t0=os.clock()
	task.spawn(function()
		while scorch.Parent and os.clock()-t0&lt;DashTrailFX.LIFE+.4 do
			local k=(os.clock()-t0)/(DashTrailFX.LIFE+.4)
			scorch.Transparency=seq(.6+.4*k,.25+.75*k)
			task.wait()
		end
	end)
	-- Afterimages of the arrival pose strung back along the line.
	local model=folder and folder:FindFirstChild(impact.owner or "")
	if model and fx.ghost then
		task.delay(.04,function()
			if not model.Parent then return end
			for k=1,look.ghosts do
				local u=k/(look.ghosts+1)
				local ghost=fx:ghost(model,look.edge,.12+(1-u)*.16,.42+u*.3)
				if ghost then
					local pivot=ghost:GetPivot()
					pcall(function() ghost:PivotTo(pivot-line*u) end)
				end
			end
		end)
	end
	-- The arrival: the light thrown out along the line; sparks for the blade.
	if K.flash then K.flash(fx.folder,to,look.core,1.2,6,.16,.1) end
	if K.shockRing then K.shockRing(fx.folder,Vector3.new(to.X,y+.1,to.Z),look.edge,1.5,9,.25) end
	if K.burst and look.zig&gt;0 then
		K.burst(fx.folder,to,{Texture=K.TEX and K.TEX.spark,Lifetime=NumberRange.new(.1,.25),Speed=NumberRange.new(12,22),SpreadAngle=Vector2.new(70,70),
			Color=ColorSequence.new(look.core,look.edge),LightEmission=1,Size=NumberSequence.new(.35,0),Drag=6,
			EmissionDirection=Enum.NormalId.Front},16)
	end
	if K.sound and K.SOUND and K.anchorPart then
		K.sound(K.anchorPart(fx.folder,to),K.SOUND.whooshBy or K.SOUND.whoosh,.5,if look.zig&gt;0 then 1.9 else 1.6)
	end
	return true
end
local function impact(fx,data,folder)
	if data.style~="teleport" then return false end
	local look=DashTrailFX.KINDS[data.kind or ""]
	if not look then return false end
	pcall(draw,fx,data,folder,look)
	-- false: the trail is drawn on top of the family's own puffs (FamilyFX),
	-- which still mark the departure and the arrival.
	return false
end
DashTrailFX.impact=impact
function DashTrailFX.install(FX,kit)
	K=kit
	table.insert(FX.layers,{name="DashTrail",impact=impact})
end
return DashTrailFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND203">
          <Properties>
            <string name="Name">DevClient</string>
            <ProtectedString name="Source">-- Studio dev panel (F6) and bounded client measurements (Codex 33028b2, ported).
-- Hidden at start. While it is open the fighter's combat input is held:
-- Main.client hands Input a non-Duel state (`blocked`), so every binding
-- passes to the panel, and held keys are released as on a window blur.
-- Closed, input is exactly the game's. Main.client's existing Studio probe,
-- info and log forwarding are left alone: this module only answers the
-- profiler ("profile", "report") and the command-bar fallback ("panel").
-- Debug/QA places only (build.py DEBUG_SOURCES); Main.client requires it only
-- when the module is present.
local Dev={}
local CORE={"Flashstep","Mirage","GentleFist","Lion"}
local SCENARIOS={"neutral","launcher","air","wall","substitution","grab","whiff","projectile"}
function Dev.install(ctx)
	local rs=game:GetService("RunService");if not rs:IsStudio() then return nil end
	local RS=game:GetService("ReplicatedStorage")
	local Shared=RS:WaitForChild("NinjaDuel")
	local Metrics=require(Shared.DevMetrics)
	local Fighters=require(Shared.Fighters)
	local volumes=require(script.Parent.DevVolumes).new(ctx.player)
	-- The tutorial as a test of the game: per-step fluidity measures (Client/TutorialProbe).
	local probeModule=script.Parent:FindFirstChild("TutorialProbe")
	if probeModule then pcall(function() require(probeModule).install(ctx) end) end
	local m=Metrics.new()
	local self={panelOpen=false,f6Open=false,metrics=m,blocked={phase="DevPanel"}}
	local track={};local lastPacket=nil;local packetAt=0;local epoch=nil
	local control=nil;local busy=false;local profile=false
	local gui=Instance.new("ScreenGui");gui.Name="NinjaDuelDevPanel";gui.ResetOnSpawn=false;gui.DisplayOrder=110;gui.Enabled=false
	gui.Parent=ctx.player:WaitForChild("PlayerGui")
	-- Right edge: the F8 inspector keeps the top-left corner.
	local frame=Instance.new("Frame");frame.Size=UDim2.fromOffset(360,530);frame.Position=UDim2.new(1,-376,0,16)
	frame.BackgroundColor3=Color3.fromRGB(20,24,30);frame.BackgroundTransparency=.05;frame.Parent=gui
	local title=Instance.new("TextLabel");title.Size=UDim2.new(1,-16,0,40);title.Position=UDim2.fromOffset(8,4);title.BackgroundTransparency=1
	title.TextColor3=Color3.new(1,1,1);title.TextSize=16;title.Font=Enum.Font.GothamBold;title.Text="DEV / F6 — Studio uniquement";title.Parent=frame
	local status=title:Clone();status.Position=UDim2.fromOffset(8,478);status.Size=UDim2.new(1,-16,0,46);status.TextSize=13;status.Font=Enum.Font.Gotham
	status.TextWrapped=true;status.Text="Mesures OFF · aucun scénario actif";status.Parent=frame
	local firstButton,selectedBefore
	local function run(op,arg)
		if busy then return end
		if not control then status.Text="Outils serveur absents (place Debug/QA ?)";return end
		busy=true;status.Text=op.." …"
		task.spawn(function()
			local ok,result=pcall(function() return control:InvokeServer(op,arg or {}) end)
			if ok and type(result)=="table" and result.ok then
				status.Text=op.." : OK"
				if op=="profile" then profile=result.enabled==true end
			else status.Text=op.." : "..tostring(if ok and type(result)=="table" then result.error else result) end
			busy=false
		end)
	end
	local index=0
	local function button(text,callback)
		local b=Instance.new("TextButton");local row=math.floor(index/2);local col=index%2;index+=1
		b.Position=UDim2.fromOffset(8+col*174,48+row*32);b.Size=UDim2.fromOffset(168,28);b.BackgroundColor3=Color3.fromRGB(43,51,65)
		b.TextColor3=Color3.new(1,1,1);b.TextSize=13;b.Font=Enum.Font.Gotham;b.Text=text;b.Parent=frame;b.Activated:Connect(callback)
		firstButton=firstButton or b
	end
	-- CORE4 ids from the active data; nothing new is registered.
	for _,id in CORE do
		local def=Fighters[id]
		if def then
			button("Joueur : "..def.Name,function() run("character",{first=id}) end)
			button("Adversaire : "..def.Name,function() run("character",{second=id}) end)
		end
	end
	button("Reset immédiat",function() run("reset") end);button("Chakra / sub pleins",function() run("refill") end)
	button("Éveil joueur",function() run("awaken") end);button("KO adversaire",function() run("ko",{actor="bot"}) end)
	button("Ultime pleine",function() run("ultimate") end)
	button("Dummy",function() run("dummy",{enabled=true}) end);button("IA",function() run("dummy",{enabled=false}) end)
	for _,name in SCENARIOS do button("Situation : "..name,function() run("scenario",{name=name}) end) end
	button("Répéter situation",function() run("repeat") end)
	button("Mesures ON / OFF",function() run("profile",{enabled=not profile}) end)
	button("Rapport → Output",function() run("report") end)
	button("Volumes ON / OFF",function()
		volumes:set(not volumes.enabled)
		status.Text=if volumes.enabled then "Volumes : racines bleues / hitboxes rouges" else "Volumes OFF"
	end)
	-- Combat input is held while F6's panel or F7's panel (DevVisual) is open.
	function self:refreshBlocking()
		self.panelOpen=self.f6Open==true or (self.visual~=nil and self.visual.blocking==true)
	end
	function self:toggle(open)
		if open==nil then open=not self.f6Open end
		if open==self.f6Open then return end
		self.f6Open=open;gui.Enabled=open;self:refreshBlocking()
		local gs=game:GetService("GuiService")
		if open then
			selectedBefore=gs.SelectedObject
			-- The same release as a window blur: no key stays held behind the panel.
			local jumping=next(ctx.input.jumps)~=nil
			ctx.input:reset();ctx.send("GuardOff");if jumping then ctx.send("JumpOff") end;ctx.send("Move",Vector3.zero)
			-- Controller navigation starts on the first button; mouse users get no highlight.
			if ctx.input.pad then gs.SelectedObject=firstButton end
		else
			gs.SelectedObject=if selectedBefore and selectedBefore.Parent then selectedBefore else nil
		end
	end
	game:GetService("UserInputService").InputBegan:Connect(function(key,processed)
		if not processed and key.KeyCode==Enum.KeyCode.F6 then self:toggle() end
	end)
	local function setProfile(enabled)
		m:stop();track={};lastPacket=nil
		if not enabled then return end
		m:start()
		for _,key in {"smoothStep","update","impacts"} do m:wrap(ctx.presentation,key,"client.presentation."..key) end
		m:wrap(ctx.camera,"update","client.camera");m:wrap(ctx.ui,"render","client.hud")
		m:wrap(ctx.presentation.fx,"update","client.fx")
	end
	rs:BindToRenderStep("NinjaDuelDevMeasure",Enum.RenderPriority.Camera.Value+2,function(dt)
		local data=ctx.state()
		volumes:update(data)
		if not m.enabled or not data or data.phase~="Duel" or dt&lt;=0 then return end
		m:sample("client.frame.ms",dt*1000)
		if dt&gt;.05 then m:event("frame-spike",{ms=dt*1000,state=data.human and data.human.state}) end
		if epoch~=data.epoch then track={};epoch=data.epoch;m:event("epoch",{epoch=epoch}) end
		if data~=lastPacket then
			local at=os.clock();if lastPacket then m:sample("client.snapshot.gap.ms",(at-packetAt)*1000) end
			packetAt=at;lastPacket=data
			if data.serverNow then m:sample("client.snapshot.age.ms",math.max(0,workspace:GetServerTimeNow()-data.serverNow)*1000) end
		end
		for _,key in {"human","bot"} do
			local actor=data[key];local st=ctx.presentation.smooth[key];local draw=ctx.presentation:visualRoot(key)
			if actor and st and st.replicatedCF and draw then
				-- Includes the intended ~45 ms smoothing delay of Presentation.
				m:sample("client."..key..".presentationGap.studs",(draw-st.replicatedCF.Position).Magnitude)
				local old=track[key];local delta=old and (draw-old.p).Magnitude or 0
				m:sample("client."..key..".frameTravel.studs",delta)
				if old and delta&gt;math.max(6,dt*160) then
					m:event("visual-position-jump",{actor=key,state=actor.state,reaction=actor.reaction,attack=actor.attackName,studs=delta,warp=actor.warpSerial,previousWarp=old.warp,ms=dt*1000})
				end
				track[key]={p=draw,warp=actor.warpSerial}
			end
		end
	end)
	-- F7: light, shadows, effect visibility and the live problem list (DevVisual).
	local visualModule=script.Parent:FindFirstChild("DevVisual")
	if visualModule then
		local ok,err=pcall(function() self.visual=require(visualModule).install(ctx,self) end)
		if not ok then warn("[NinjaDuel] F7 visual tool unavailable: "..tostring(err)) end
	end
	task.spawn(function()
		-- Both channels are created by the server's DevHooks at ReplicatedStorage root.
		control=RS:WaitForChild("NinjaDuelDevControl",15)
		if not control then status.Text="Outils serveur absents (place Debug/QA ?)" end
		local log=RS:WaitForChild("NinjaDuelDevLog",15)
		if not log then return end
		log.OnClientEvent:Connect(function(kind,value)
			if kind=="profile" then
				profile=value==true;setProfile(profile);status.Text="Mesures "..(if profile then "ON" else "OFF")
			elseif kind=="report" then
				local report=m:report();report.build=Shared.BuildFingerprint.Value;log:FireServer("report",report)
			elseif kind=="panel" then
				self:toggle()
			end
		end)
	end)
	return self
end
return Dev
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND204">
          <Properties>
            <string name="Name">DevVisual</string>
            <ProtectedString name="Source">-- Studio visual tool (F7): light, shadows, how visible every effect is, and a
-- live list of everything that breaks during a fight (requested 08/11/2026:
-- « un outil sur la visibilité des effets, lumières, ombres du jeu et tout ce
-- qui bug »).
--
-- F7 cycles: closed → panel (combat input held, like F6) → small HUD that
-- leaves the fight playable → closed.
--   * Lumière : the game's look (Client/WorldLook) or a test preset, hour,
--     exposure, global shadows, post-effects; live readout of the lighting.
--   * Effets  : hide or show each family of effects on this screen only
--     (particles, beams and trails, lights, highlights, 2D sprites, effect
--     shapes, ground marks, post-effects), outlines round every live effect,
--     particles frozen or slowed, live counters against the engine's limits.
--   * Problèmes : script errors and warnings (client and server), images that
--     do not load, effects that cast shadows, never disappear or float, too
--     many lights or highlights, the camera inside an effect, bodies left
--     invisible, animations not loaded, frame spikes. Click a line to see the
--     object in the world; « Rapport » prints everything to Output.
-- Nothing here changes the game: lighting and visibility are changed on this
-- client only and « Remettre le jeu » (or closing the tool) puts them back.
-- Debug/QA places only (build.py DEBUG_SOURCES), loaded by DevClient.
local Visual={}

local RunService=game:GetService("RunService")
local Lighting=game:GetService("Lighting")
local Players=game:GetService("Players")
local HttpService=game:GetService("HttpService")
local LogService=game:GetService("LogService")
local ContentProvider=game:GetService("ContentProvider")
local Stats=game:GetService("Stats")
local UserInputService=game:GetService("UserInputService")

local TAG="[NinjaDuelVisual]"
local OWN="DevVisual"
local HIGHLIGHT_LIMIT=31
-- Containers the game draws its effects in. WorldMemory holds the arena's
-- ground marks (Server/WorldReaction); "Effects" is the match folder the
-- server uses for hitboxes and contact markers (Combat:effect).
local FX_ROOTS={NinjaDuelFX=true,VfxMesh=true,NinjaUltimateFX=true,Effects=true,LocalImpact=true}
local MARK_ROOTS={WorldMemory=true}
local MARK_NAMES={"Scar","Mark","Crater","Crack","Scorch","Burn","Rubble","Furrow","Trench","Slab"}
local HITBOX={BanglaHitbox=true}
-- The menu's 3D sets are lit and filmed only in the menu: not the duel's picture.
local SKIP_ROOTS={NinjaDuelMenuStage=true,NinjaDuelPortraitStage=true}
-- Solid pieces of broken ground (Client/GroundFX) belong with the ground marks.
local GROUND_PIECES={GroundBlock=true}

local function rgb(r,g,b) return Color3.fromRGB(r,g,b) end
-- Lighting.Technology is not readable by game scripts (Studio sets it); kept
-- behind a pcall so the readout says so instead of breaking.
local function techName()
	local ok,name=pcall(function() return Lighting.Technology.Name end)
	return if ok then name else "non lisible en jeu"
end
local SEV={erreur={order=1,color=rgb(255,96,86),label="ERREUR"},voir={order=2,color=rgb(255,190,80),label="À VOIR"},info={order=3,color=rgb(170,180,196),label="INFO"}}

-- Test lighting. Values for « Fin d'après-midi » are the filming setup of
-- 06/11 (claude/prepa-tournage-lee-itachi). Post-effects are left to the toggle.
local PRESETS={
	{key="jeu",name="Jeu (d'origine)"},
	{key="film",name="Fin d'après-midi (film)",light={ClockTime=16.8,GeographicLatitude=35,Brightness=3.4,ExposureCompensation=-.1,Ambient=rgb(96,90,100),OutdoorAmbient=rgb(140,124,112),EnvironmentDiffuseScale=.8,EnvironmentSpecularScale=.4}},
	{key="midi",name="Midi plein soleil",light={ClockTime=12.5,GeographicLatitude=30,Brightness=3,ExposureCompensation=0,Ambient=rgb(120,120,126),OutdoorAmbient=rgb(150,150,156),ColorShift_Top=rgb(255,255,255),ColorShift_Bottom=rgb(120,120,140)}},
	{key="contre",name="Contre-jour",light={ClockTime=17.7,GeographicLatitude=36,Brightness=3.8,ExposureCompensation=0,Ambient=rgb(70,66,84),OutdoorAmbient=rgb(100,94,116)}},
	{key="nuit",name="Nuit",light={ClockTime=0.5,GeographicLatitude=36,Brightness=1,ExposureCompensation=0,Ambient=rgb(36,40,58),OutdoorAmbient=rgb(54,60,86),ColorShift_Top=rgb(150,170,255),ColorShift_Bottom=rgb(40,44,70)}},
	{key="gris",name="Gris neutre (juger un effet)",light={ClockTime=14,GeographicLatitude=30,Brightness=2,ExposureCompensation=0,Ambient=rgb(128,128,128),OutdoorAmbient=rgb(128,128,128),EnvironmentDiffuseScale=0,EnvironmentSpecularScale=0,ColorShift_Top=rgb(0,0,0),ColorShift_Bottom=rgb(0,0,0)},post=false},
}
local FAMILIES={
	{key="particles",name="Particules"},
	{key="beams",name="Faisceaux / traînées"},
	{key="lights",name="Lumières"},
	{key="highlights",name="Surbrillances (contours)"},
	{key="sprites",name="Sprites 2D"},
	{key="shapes",name="Formes d'effet"},
	{key="marks",name="Marques au sol"},
	{key="post",name="Post-effets"},
}

local function path(inst)
	if not inst then return "?" end
	local ok,full=pcall(function() return inst:GetFullName() end)
	return if ok then full else inst.Name
end
local function isOwn(inst)
	local node=inst
	while node do
		if string.sub(node.Name,1,#OWN)==OWN or node.Name=="DevObservedVolume" or node.Name=="NinjaDuelDevPanel" then return true end
		node=node.Parent
	end
	return false
end
local function rootOf(inst,set)
	local node=inst.Parent
	while node and node~=game do
		if set[node.Name] then return node end
		node=node.Parent
	end
	return nil
end
local function fighterOf(inst)
	local node=inst.Parent
	while node and node~=workspace do
		if node:IsA("Model") and node:FindFirstChildOfClass("Humanoid") then return node end
		node=node.Parent
	end
	return nil
end
local function isMarkName(name)
	if string.find(name,"Marked",1,true) then return false end -- Minato's marked kunai is a weapon, not a mark
	for _,prefix in MARK_NAMES do if string.find(name,prefix,1,true) then return true end end
	return false
end
-- Marks drawn flat on the ground or a wall (server ground damage, scars,
-- craters, scorches): only these must touch a surface. Seals, glyphs and
-- burning pieces can stand or float by design.
local FLAT_MARKS={"Scar","Crater","Crack","Scorch","FXGround"}
local function flatMark(inst)
	local node=inst
	while node and node~=workspace do
		if MARK_ROOTS[node.Name] then return true end
		if FX_ROOTS[node.Name] then return false end
		for _,word in FLAT_MARKS do if string.find(node.Name,word,1,true) then return true end end
		node=node.Parent
	end
	return false
end
-- Highlights that are meant to stay (ink outline, chakra rims, auras).
local function deliberate(name)
	for _,word in {"Ink","Rim","Aura","Outline","Line","Mode"} do if string.find(name,word,1,true) then return true end end
	return false
end
-- A ground mark is often a model of plain parts (FireScorch made of Wedges):
-- the name that says « mark » can be on any ancestor below the effect folder.
local function markAncestor(inst)
	local node=inst
	while node and node~=workspace and not FX_ROOTS[node.Name] do
		if isMarkName(node.Name) or node.Name=="FXGround" or GROUND_PIECES[node.Name] then return true end
		node=node.Parent
	end
	return false
end
local function visiblePart(p)
	return p.Transparency&lt;.9 and p.LocalTransparencyModifier&lt;.9 and p.Size.Magnitude&gt;.15
end

function Visual.install(ctx,dev)
	if not RunService:IsStudio() then return nil end
	local player=ctx.player
	local playerGui=player:WaitForChild("PlayerGui")
	local camera=workspace.CurrentCamera
	local okLook,WorldLook=pcall(require,script.Parent.WorldLook)
	if not okLook then WorldLook=nil end
	local self={mode=0,blocking=false,tab="problemes"}

	-- ------------------------------------------------------------ tracking
	-- Every effect-like object is followed from its birth (age, family, where).
	local tracked=setmetatable({},{__mode="k"})
	local function classify(inst)
		if isOwn(inst) or rootOf(inst,SKIP_ROOTS) then return nil end
		if inst:IsA("ParticleEmitter") then return "particles"
		elseif inst:IsA("Beam") or inst:IsA("Trail") then return "beams"
		elseif inst:IsA("Light") then return "lights"
		elseif inst:IsA("Highlight") then return "highlights"
		elseif inst:IsA("BillboardGui") or (inst:IsA("SurfaceGui") and inst.Adornee) then return "sprites"
		elseif inst:IsA("Decal") then
			if rootOf(inst,MARK_ROOTS) or markAncestor(inst) then return "marks" end
			if rootOf(inst,FX_ROOTS) then return "shapes" end
			return nil
		elseif inst:IsA("BasePart") then
			if HITBOX[inst.Name] or inst:IsA("Terrain") then return nil end
			if rootOf(inst,MARK_ROOTS) or (markAncestor(inst) and not fighterOf(inst)) then return "marks" end
			if rootOf(inst,FX_ROOTS) or inst.Name=="LocalImpact" then return "shapes" end
			return nil
		end
		return nil
	end
	local function track(inst)
		if tracked[inst] then return end
		local family=classify(inst)
		if family then
			local body=fighterOf(inst)
			tracked[inst]={family=family,born=os.clock(),body=body,fx=body~=nil or rootOf(inst,FX_ROOTS)~=nil or inst.Parent==workspace.Terrain or (inst.Parent~=nil and inst.Parent.Parent==workspace.Terrain)}
		end
	end

	-- ------------------------------------------------------------ issues
	local issues={}
	local order={}
	local dirty=true
	local showInfo=true
	local function report(sev,title,detail,inst,key)
		key=key or (title.."|"..(if inst then path(inst) else detail or ""))
		local now=os.clock()
		local entry=issues[key]
		if entry then
			entry.count+=1;entry.last=now;entry.clock=os.date("%H:%M:%S");entry.detail=detail or entry.detail
			if inst then entry.inst=inst end
		else
			if #order&gt;=240 then
				local oldest=table.remove(order,#order);issues[oldest.key]=nil
			end
			entry={key=key,sev=sev,title=title,detail=detail or "",path=if inst then path(inst) else "",count=1,first=now,last=now,clock=os.date("%H:%M:%S"),inst=inst}
			setmetatable(entry,{__mode="v"})
			issues[key]=entry
			table.insert(order,1,entry)
		end
		dirty=true
		return entry
	end

	-- Script errors and warnings of this client, and of the server (DevHooks
	-- relays them on NinjaDuelDevLog as "serverlog").
	LogService.MessageOut:Connect(function(message,kind)
		if string.find(message,TAG,1,true) then return end
		if kind==Enum.MessageType.MessageError then
			report("erreur","Erreur de script (client)",string.sub(message,1,300),nil,"errc|"..string.sub(message,1,160))
		elseif kind==Enum.MessageType.MessageWarning then
			report("info","Avertissement (client)",string.sub(message,1,300),nil,"warnc|"..string.sub(message,1,160))
		end
	end)
	task.spawn(function()
		local log=game:GetService("ReplicatedStorage"):WaitForChild("NinjaDuelDevLog",15)
		if not log then return end
		log.OnClientEvent:Connect(function(kind,value)
			if kind~="serverlog" or type(value)~="table" or type(value.m)~="string" then return end
			if string.find(value.m,TAG,1,true) then return end
			if value.k=="error" then
				report("erreur","Erreur de script (serveur)",string.sub(value.m,1,300),nil,"errs|"..string.sub(value.m,1,160))
			else
				report("info","Avertissement (serveur)",string.sub(value.m,1,300),nil,"warns|"..string.sub(value.m,1,160))
			end
		end)
	end)

	-- Images and meshes: a texture that fails to load draws nothing (or a
	-- white square for an emitter without a texture).
	local assetSeen={}
	local function assetOf(inst)
		if inst:IsA("ParticleEmitter") or inst:IsA("Beam") or inst:IsA("Trail") or inst:IsA("Decal") then return inst.Texture
		elseif inst:IsA("MeshPart") then return inst.TextureID ~= "" and inst.TextureID or inst.MeshId
		end
		return nil
	end
	local function checkAsset(inst)
		local id=assetOf(inst)
		if id==nil then return end
		if id=="" then
			if inst:IsA("ParticleEmitter") then report("voir","Particules sans image (carré blanc)",inst.Name,inst) end
			return
		end
		local seen=assetSeen[id]
		if seen and seen.ok then return end
		local now=os.clock()
		if seen and now-seen.at&lt;4 then
			report("erreur","Image ou maillage qui ne charge pas",id,inst,"asset|"..id)
			return
		end
		local ok,status=pcall(function() return ContentProvider:GetAssetFetchStatus(id) end)
		if not ok then return end
		if status==Enum.AssetFetchStatus.Success then
			assetSeen[id]={ok=true,at=now}
			-- Failed first, loaded later (Roblox « content representation is
			-- being generated »): the effect was invisible the first times only.
			local entry=issues["asset|"..id]
			if entry and entry.sev=="erreur" then
				entry.sev="voir";entry.title="Image qui a d'abord échoué, puis s'est chargée";entry.detail=id.." (l'effet était invisible au début)";dirty=true
			end
		elseif status==Enum.AssetFetchStatus.Failure or status==Enum.AssetFetchStatus.TimedOut then
			assetSeen[id]={ok=false,at=now}
			report("erreur","Image ou maillage qui ne charge pas",id,inst,"asset|"..id)
		end
	end

	-- ------------------------------------------------------------ visibility
	-- Hidden families: each object's own value is kept and given back.
	local hidden={}
	local saved=setmetatable({},{__mode="k"})
	local INVISIBLE=NumberSequence.new(1)
	local postSaved={}
	local function postEffects()
		local list={}
		for _,e in Lighting:GetChildren() do
			if e:IsA("PostEffect") or e:IsA("Atmosphere") then table.insert(list,e) end
		end
		if camera then for _,e in camera:GetChildren() do if e:IsA("PostEffect") then table.insert(list,e) end end end
		return list
	end
	local function hide(inst,family)
		if saved[inst]~=nil then return end
		pcall(function()
			if family=="particles" then saved[inst]=inst.Transparency;inst.Transparency=INVISIBLE
			elseif family=="beams" or family=="lights" or family=="highlights" or family=="sprites" then saved[inst]=inst.Enabled;inst.Enabled=false
			elseif inst:IsA("BasePart") or inst:IsA("Decal") then saved[inst]=inst.LocalTransparencyModifier;inst.LocalTransparencyModifier=1 end
		end)
	end
	local function show(inst,family)
		local value=saved[inst]
		if value==nil then return end
		saved[inst]=nil
		pcall(function()
			if family=="particles" then inst.Transparency=value
			elseif family=="beams" or family=="lights" or family=="highlights" or family=="sprites" then inst.Enabled=value
			else inst.LocalTransparencyModifier=value end
		end)
	end
	local function setFamily(family,isHidden)
		hidden[family]=isHidden or nil
		if family=="post" then
			if isHidden then
				for _,e in postEffects() do
					if postSaved[e]==nil then
						if e:IsA("Atmosphere") then postSaved[e]=e.Parent;e.Parent=nil else postSaved[e]=e.Enabled;e.Enabled=false end
					end
				end
			else
				for e,value in postSaved do
					pcall(function() if e:IsA("Atmosphere") then e.Parent=value else e.Enabled=value end end)
				end
				table.clear(postSaved)
			end
			return
		end
		for inst,info in tracked do
			if info.family==family and inst.Parent then
				if isHidden then hide(inst,family) else show(inst,family) end
			end
		end
	end

	-- Lighting: the game's look lives in Client/WorldLook, which re-applies it
	-- every second unless it is « borrowed » (Client/MenuStage does the same).
	local preset="jeu"
	local function applyPreset(key)
		preset=key
		if key=="jeu" then
			if WorldLook then WorldLook.borrowed=false;pcall(WorldLook.apply) end
			if hidden.post then setFamily("post",false) end
			return
		end
		local def
		for _,p in PRESETS do if p.key==key then def=p end end
		if not def then return end
		if WorldLook then WorldLook.borrowed=true end
		for k,v in def.light do pcall(function() (Lighting::any)[k]=v end) end
		if def.post==false then setFamily("post",true) end
	end
	local function nudge(prop,delta,lo,hi)
		if WorldLook then WorldLook.borrowed=true end
		if preset=="jeu" then preset="perso" end
		local value=(Lighting::any)[prop]+delta
		if prop=="ClockTime" then value=value%24 else value=math.clamp(value,lo,hi) end
		pcall(function() (Lighting::any)[prop]=value end)
	end

	-- Outlines round every live effect (and in red round the ones in trouble).
	local outlines={}
	local outlinesOn=false
	local flagged=setmetatable({},{__mode="k"})
	local function clearOutlines() for _,b in outlines do b:Destroy() end;table.clear(outlines) end
	local function updateOutlines()
		if not outlinesOn then if next(outlines) then clearOutlines() end return end
		local wanted={}
		local n=0
		for inst,info in tracked do
			if n&gt;=80 then break end
			local part=if inst:IsA("BasePart") then inst elseif inst.Parent and inst.Parent:IsA("BasePart") then inst.Parent elseif inst.Parent and inst.Parent:IsA("Attachment") and inst.Parent.Parent and inst.Parent.Parent:IsA("BasePart") then inst.Parent.Parent else nil
			if part and part.Parent and not wanted[part] then wanted[part]=flagged[inst] or flagged[part] or false;n+=1 end
		end
		for part,box in outlines do if wanted[part]==nil or not part.Parent then box:Destroy();outlines[part]=nil end end
		for part,bad in wanted do
			local box=outlines[part]
			if not box then
				box=Instance.new("SelectionBox");box.Name="DevVisualOutline";box.Adornee=part;box.LineThickness=.04;box.Parent=playerGui;outlines[part]=box
			end
			box.Color3=if bad then rgb(255,70,60) else rgb(80,220,255)
		end
	end
	local function focus(inst)
		if not inst or not inst.Parent then print(TAG,"objet disparu");return end
		local part=if inst:IsA("BasePart") then inst else inst:FindFirstAncestorWhichIsA("BasePart")
		if inst:IsA("Model") then part=inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart") end
		print(TAG,"objet :",path(inst),inst.ClassName)
		if part then
			local box=Instance.new("SelectionBox");box.Name="DevVisualFocus";box.Adornee=part;box.Color3=rgb(255,240,80);box.LineThickness=.08;box.Parent=playerGui
			task.delay(3,function() box:Destroy() end)
		end
	end

	-- ------------------------------------------------------------ scan
	local counters={}
	local fps=60
	local frameSpikes=0
	local worstFrame=0
	local bodySince=setmetatable({},{__mode="k"})
	local highlightSince=setmetatable({},{__mode="k"})
	local trackSince=setmetatable({},{__mode="k"})
	local markChecked=setmetatable({},{__mode="k"})
	local blockedSince=nil
	local rayParams=RaycastParams.new();rayParams.FilterType=Enum.RaycastFilterType.Exclude
	local function floorUnder(position,exclude)
		rayParams.FilterDescendantsInstances=exclude
		return workspace:Raycast(position+Vector3.new(0,3,0),Vector3.new(0,-40,0),rayParams)
	end
	local function fighters()
		local list={}
		local me=player.Character
		if me then table.insert(list,me) end
		local data=ctx.state and ctx.state()
		local folder=me and me.Parent
		local other=folder and data and data.bot and folder:FindFirstChild(data.bot.id or "")
		if other then table.insert(list,other) end
		return list,folder
	end
	local function scan()
		local now=os.clock()
		table.clear(flagged)
		local c={particles=0,particlesOn=0,beams=0,lights=0,fxLights=0,lightsShadow=0,highlights=0,sprites=0,shapes=0,marks=0,total=0}
		local bodies=fighters()
		-- The floor probe skips bodies, effects and the marks themselves.
		local exclude={}
		for _,b in bodies do table.insert(exclude,b) end
		for _,name in {"NinjaDuelFX","VfxMesh","NinjaUltimateFX"} do local f=workspace:FindFirstChild(name);if f then table.insert(exclude,f) end end
		for inst,info in tracked do
			if info.family=="marks" then
				local r=rootOf(inst,MARK_ROOTS)
				if r and not table.find(exclude,r) then table.insert(exclude,r) end
			end
		end
		local camPos=camera and camera.CFrame.Position
		local neonArea=0
		for inst,info in tracked do
			if not inst.Parent then tracked[inst]=nil;continue end
			if isOwn(inst) then tracked[inst]=nil;continue end
			c.total+=1
			if info.family=="shapes" and markAncestor(inst) then info.family="marks" end
			local family=info.family
			local age=now-info.born
			if hidden[family] then hide(inst,family) end
			if family=="particles" then
				c.particles+=1
				if inst.Enabled and inst.Rate&gt;0 then
					c.particlesOn+=1
					if not info.body and age&gt;12 and rootOf(inst,FX_ROOTS) then flagged[inst]=true;report("voir","Émetteur resté allumé",string.format("%s, %.0f s",inst.Name,age),inst) end
				end
				checkAsset(inst)
			elseif family=="beams" then c.beams+=1;checkAsset(inst)
			elseif family=="lights" then
				if inst.Enabled then
					c.lights+=1
					if info.fx then
						c.fxLights+=1
						if inst.Shadows then c.lightsShadow+=1;flagged[inst]=true;report("voir","Lumière d'effet avec ombres (coûteux, ombres qui tremblent)",inst.Name,inst) end
						if inst.Brightness&gt;10 then flagged[inst]=true;report("voir","Lumière très forte (éblouit)",string.format("%s, luminosité %.0f",inst.Name,inst.Brightness),inst) end
					end
				end
			elseif family=="highlights" then
				if inst.Enabled then
					c.highlights+=1
					if not deliberate(inst.Name) and inst.FillTransparency&lt;.95 then
						local since=highlightSince[inst] or now;highlightSince[inst]=since
						if now-since&gt;4 then flagged[inst]=true;report("voir","Surbrillance restée allumée",string.format("%s sur %s, %.0f s",inst.Name,inst.Parent and inst.Parent.Name or "?",now-since),inst) end
					else
						highlightSince[inst]=nil
					end
				end
			elseif family=="sprites" then
				if inst.Enabled then c.sprites+=1 end
				if inst:IsA("BillboardGui") and inst.Enabled and not inst.Adornee and not inst.Parent:IsA("BasePart") and not inst.Parent:IsA("Attachment") then
					report("info","Sprite 2D sans support (ne s'affiche nulle part)",inst.Name,inst)
				end
			elseif family=="shapes" or family=="marks" then
				if family=="shapes" then c.shapes+=1 else c.marks+=1 end
				if inst:IsA("BasePart") then
					local p=inst.Position
					if p~=p or p.Magnitude&gt;20000 then report("voir","Effet perdu (position folle)",inst.Name,inst);continue end
					local vis=visiblePart(inst)
					if family=="shapes" then
						if inst.CanCollide and not inst:FindFirstAncestorWhichIsA("Model") then flagged[inst]=true;report("erreur","Effet qui bloque les corps (CanCollide)",inst.Name,inst) end
						local glowing=inst.Material==Enum.Material.Neon or inst.Material==Enum.Material.ForceField or inst.Material==Enum.Material.Glass
						if vis and inst.CastShadow and glowing then flagged[inst]=true;report("voir","Effet lumineux qui projette une ombre",string.format("%s (%s)",inst.Name,inst.Material.Name),inst)
						elseif vis and inst.CastShadow and inst.Transparency&gt;.2 then report("info","Objet qui s'efface en gardant toute son ombre",string.format("%s (%s, transparence %.2f)",inst.Name,inst.Material.Name,inst.Transparency),inst) end
						if vis and inst.Material==Enum.Material.Neon then
							local s=inst.Size;local dims={s.X,s.Y,s.Z};table.sort(dims)
							local area=dims[2]*dims[3]*(1-inst.Transparency)
							neonArea+=area
							if area&gt;80 then flagged[inst]=true;report("voir","Grande surface Néon (éblouit)",string.format("%s, %.0f studs²",inst.Name,area),inst) end
						end
						if vis and age&gt;20 and not inst:GetAttribute("Persistent") then flagged[inst]=true;report("voir","Effet qui ne disparaît pas",string.format("%s, %.0f s",inst.Name,age),inst) end
						if vis and camPos and inst.Size.Magnitude&gt;4 then
							local rel=inst.CFrame:PointToObjectSpace(camPos);local h=inst.Size/2
							if math.abs(rel.X)&lt;h.X and math.abs(rel.Y)&lt;h.Y and math.abs(rel.Z)&lt;h.Z then report("voir","La caméra est dans un effet (écran couvert)",inst.Name,inst) end
						end
					elseif vis and (not markChecked[inst] or now-markChecked[inst]&gt;5) and age&gt;.5 and not GROUND_PIECES[inst.Name] then
						markChecked[inst]=now
						local probe=table.clone(exclude);table.insert(probe,inst)
						local hit=floorUnder(p,probe)
						-- Thin axis = the side the mark is drawn on (floor or wall):
						-- it has to touch a surface there, within half a stud.
						local s=inst.Size;local cf=inst.CFrame
						local axis,thick=cf.RightVector,s.X
						if s.Y&lt;thick then axis,thick=cf.UpVector,s.Y end
						if s.Z&lt;thick then axis,thick=cf.LookVector,s.Z end
						rayParams.FilterDescendantsInstances=probe
						local reach=thick/2+.6
						local touch=workspace:Raycast(p,axis*reach,rayParams) or workspace:Raycast(p,-axis*reach,rayParams)
						if not touch and hit and p.Y-hit.Position.Y&gt;.6 and flatMark(inst) then
							flagged[inst]=true
							report("voir","Marque au sol en l'air",string.format("%s, %.1f studs au-dessus du sol, aucune surface sous sa face",inst.Name,p.Y-hit.Position.Y),inst)
						end
						if hit then
							local half=.5*(math.abs(cf.RightVector.Y)*s.X+math.abs(cf.UpVector.Y)*s.Y+math.abs(cf.LookVector.Y)*s.Z)
							if p.Y+half&lt;hit.Position.Y-.4 then report("info","Marque enterrée (invisible)",inst.Name,inst) end
						end
					end
				end
				checkAsset(inst)
			end
		end
		if c.highlights&gt;HIGHLIGHT_LIMIT-6 then
			report("erreur","Trop de surbrillances",string.format("%d sur %d : au-delà, Roblox n'en dessine plus (les contours des corps disparaissent)",c.highlights,HIGHLIGHT_LIMIT),nil,"highlight-limit")
		end
		if c.fxLights&gt;10 then report("voir","Trop de lumières d'effet en même temps",tostring(c.fxLights),nil,"light-count") end
		if c.total&gt;800 then report("voir","Trop d'objets d'effet en même temps",tostring(c.total),nil,"fx-count") end
		c.neonArea=neonArea
		-- Bodies: invisible for long, or an animation that never loaded.
		for _,body in bodies do
			local sum,n=0,0
			for _,part in body:GetChildren() do
				if part:IsA("BasePart") and part.Name~="HumanoidRootPart" then sum+=math.max(part.Transparency,part.LocalTransparencyModifier);n+=1 end
			end
			local faded=n&gt;0 and sum/n&gt;.6
			if faded then
				local since=bodySince[body] or now;bodySince[body]=since
				if now-since&gt;3 then report("info","Corps presque invisible depuis plus de 3 s",body.Name,body,"faded|"..body.Name) end
			else bodySince[body]=nil end
			local hum=body:FindFirstChildOfClass("Humanoid")
			local animator=hum and hum:FindFirstChildOfClass("Animator")
			if animator then
				for _,t in animator:GetPlayingAnimationTracks() do
					if t.Length==0 then
						local since=trackSince[t] or now;trackSince[t]=since
						if now-since&gt;.6 then report("voir","Animation pas chargée",t.Animation and t.Animation.AnimationId or t.Name,body,"anim|"..(t.Animation and t.Animation.AnimationId or t.Name)) end
					end
				end
			end
		end
		-- Decor between the camera and the player's fighter (a trunk, a wall):
		-- the player loses sight of himself.
		local me=player.Character
		local head=me and (me:FindFirstChild("Head") or me:FindFirstChild("HumanoidRootPart"))
		if head and camPos then
			rayParams.FilterDescendantsInstances=exclude
			local hitCam=workspace:Raycast(camPos,head.Position-camPos,rayParams)
			if hitCam and hitCam.Instance.Transparency&lt;.5 and not fighterOf(hitCam.Instance) then
				blockedSince=blockedSince or now
				if now-blockedSince&gt;.8 then report("voir","Le décor cache le joueur",string.format("%s, depuis %.1f s",hitCam.Instance.Name,now-blockedSince),hitCam.Instance,"occlusion|"..hitCam.Instance.Name) end
			else
				blockedSince=nil
			end
		end
		-- Lighting the tool did not set.
		if preset=="jeu" then
			if not Lighting.GlobalShadows then report("voir","Ombres globales coupées (Lighting.GlobalShadows)","",nil,"light-globalshadows") end
			if math.abs(Lighting.ExposureCompensation)&gt;1 then report("info","Exposition inhabituelle",string.format("%.2f",Lighting.ExposureCompensation),nil,"light-exposure") end
		end
		local tech=techName()
		if tech=="Voxel" or tech=="Compatibility" then report("info","Ombres grossières : technologie "..tech,"",nil,"light-tech") end
		counters=c
	end

	-- ------------------------------------------------------------ interface
	local gui=Instance.new("ScreenGui");gui.Name="DevVisualPanel";gui.ResetOnSpawn=false;gui.DisplayOrder=111;gui.Enabled=false;gui.IgnoreGuiInset=false
	gui.Parent=playerGui
	-- Fits small Studio viewports: as tall as the screen allows, 590 px at most.
	local panel=Instance.new("Frame");panel.Name="DevVisualFrame";panel.AnchorPoint=Vector2.new(0,.5);panel.Size=UDim2.new(0,420,1,-48);panel.Position=UDim2.new(0,16,.5,0)
	local cap=Instance.new("UISizeConstraint");cap.MaxSize=Vector2.new(420,590);cap.Parent=panel
	panel.BackgroundColor3=rgb(18,22,28);panel.BackgroundTransparency=.04;panel.BorderSizePixel=0;panel.Parent=gui
	local function label(parent,text,size,pos,textSize,bold)
		local l=Instance.new("TextLabel");l.BackgroundTransparency=1;l.Size=size;l.Position=pos;l.TextColor3=rgb(236,238,244);l.TextSize=textSize or 13
		l.Font=if bold then Enum.Font.GothamBold else Enum.Font.Gotham;l.TextXAlignment=Enum.TextXAlignment.Left;l.TextYAlignment=Enum.TextYAlignment.Top
		l.TextWrapped=true;l.RichText=true;l.Text=text;l.Parent=parent
		return l
	end
	local function button(parent,text,pos,size,callback)
		local b=Instance.new("TextButton");b.Position=pos;b.Size=size;b.BackgroundColor3=rgb(43,51,65);b.BorderSizePixel=0
		b.TextColor3=rgb(240,240,245);b.TextSize=12;b.Font=Enum.Font.Gotham;b.TextWrapped=true;b.Text=text;b.AutoButtonColor=true;b.Parent=parent
		b.Activated:Connect(callback)
		return b
	end
	label(panel,"VISUEL / F7 — lumière, ombres, effets, bugs",UDim2.new(1,-16,0,20),UDim2.fromOffset(8,6),15,true)
	local hint=label(panel,"F7 : panneau → bandeau (on peut jouer) → fermé",UDim2.new(1,-16,0,16),UDim2.fromOffset(8,26),11)
	hint.TextColor3=rgb(150,160,176)
	local pages={}
	local tabButtons={}
	local function page(key)
		local f=Instance.new("Frame");f.Name="Page_"..key;f.BackgroundTransparency=1;f.Size=UDim2.new(1,-16,1,-84);f.Position=UDim2.fromOffset(8,80);f.Visible=false;f.Parent=panel
		pages[key]=f
		return f
	end
	local function selectTab(key)
		self.tab=key
		for k,f in pages do f.Visible=k==key end
		for k,b in tabButtons do b.BackgroundColor3=if k==key then rgb(70,96,140) else rgb(43,51,65) end
		dirty=true
	end
	for i,t in {{"lumiere","Lumière"},{"effets","Effets"},{"problemes","Problèmes"}} do
		tabButtons[t[1]]=button(panel,t[2],UDim2.fromOffset(8+(i-1)*136,46),UDim2.fromOffset(130,28),function() selectTab(t[1]) end)
	end

	-- Lumière
	local light=page("lumiere")
	local lightText=label(light,"",UDim2.new(1,0,0,170),UDim2.fromOffset(0,0),12)
	local presetButtons={}
	for i,p in PRESETS do
		local col=(i-1)%2;local row=math.floor((i-1)/2)
		presetButtons[p.key]=button(light,p.name,UDim2.fromOffset(col*204,176+row*32),UDim2.fromOffset(198,28),function() applyPreset(p.key) end)
	end
	local y=176+math.ceil(#PRESETS/2)*32+6
	local tools={
		{"Heure −1 h",function() nudge("ClockTime",-1) end},{"Heure +1 h",function() nudge("ClockTime",1) end},
		{"Exposition −",function() nudge("ExposureCompensation",-.25,-3,3) end},{"Exposition +",function() nudge("ExposureCompensation",.25,-3,3) end},
		{"Luminosité −",function() nudge("Brightness",-.5,0,10) end},{"Luminosité +",function() nudge("Brightness",.5,0,10) end},
		{"Ombres globales ON / OFF",function() if WorldLook then WorldLook.borrowed=true end;if preset=="jeu" then preset="perso" end;Lighting.GlobalShadows=not Lighting.GlobalShadows end},
		{"Post-effets ON / OFF",function() setFamily("post",not hidden.post) end},
	}
	for i,t in tools do
		local col=(i-1)%2;local row=math.floor((i-1)/2)
		button(light,t[1],UDim2.fromOffset(col*204,y+row*32),UDim2.fromOffset(198,28),t[2])
	end

	-- Effets
	local fx=page("effets")
	local fxText=label(fx,"",UDim2.new(1,0,0,150),UDim2.fromOffset(0,0),12)
	local familyButtons={}
	for i,f in FAMILIES do
		local col=(i-1)%2;local row=math.floor((i-1)/2)
		familyButtons[f.key]=button(fx,"",UDim2.fromOffset(col*204,156+row*32),UDim2.fromOffset(198,28),function()
			setFamily(f.key,not hidden[f.key]);dirty=true
		end)
	end
	local frozen=nil
	local function particleTime(scale)
		frozen=scale
		for inst,info in tracked do if info.family=="particles" and inst.Parent then pcall(function() inst.TimeScale=scale or 1 end) end end
	end
	local y2=156+math.ceil(#FAMILIES/2)*32+6
	local fxTools={
		{"Contours des effets ON / OFF",function() outlinesOn=not outlinesOn;updateOutlines() end},
		{"Tout afficher",function() for _,f in FAMILIES do setFamily(f.key,false) end end},
		{"Particules figées",function() particleTime(if frozen==0 then nil else 0) end},
		{"Particules au ralenti ×0,2",function() particleTime(if frozen==.2 then nil else .2) end},
		{"Couper les ombres des effets",function()
			for inst,info in tracked do if info.family=="shapes" and inst:IsA("BasePart") then pcall(function() inst.CastShadow=false end) end end
			print(TAG,"ombres des effets coupées sur cet écran (essai seulement : la correction se fait dans src/)")
		end},
		{"Remettre le jeu",function() Visual.restore(self) end},
	}
	for i,t in fxTools do
		local col=(i-1)%2;local row=math.floor((i-1)/2)
		button(fx,t[1],UDim2.fromOffset(col*204,y2+row*32),UDim2.fromOffset(198,28),t[2])
	end

	-- Problèmes
	local probs=page("problemes")
	local probSummary=label(probs,"",UDim2.new(1,0,0,34),UDim2.fromOffset(0,0),12)
	local list=Instance.new("ScrollingFrame");list.Name="DevVisualList";list.Size=UDim2.new(1,0,1,-80);list.Position=UDim2.fromOffset(0,38)
	list.BackgroundColor3=rgb(12,15,20);list.BorderSizePixel=0;list.ScrollBarThickness=6;list.CanvasSize=UDim2.new();list.AutomaticCanvasSize=Enum.AutomaticSize.Y;list.Parent=probs
	local layout=Instance.new("UIListLayout");layout.Padding=UDim.new(0,2);layout.SortOrder=Enum.SortOrder.LayoutOrder;layout.Parent=list
	local rows={}
	local function rebuildList()
		for _,r in rows do r:Destroy() end;table.clear(rows)
		local sorted={}
		for _,e in order do if showInfo or e.sev~="info" then table.insert(sorted,e) end end
		table.sort(sorted,function(a,b)
			if SEV[a.sev].order~=SEV[b.sev].order then return SEV[a.sev].order&lt;SEV[b.sev].order end
			return a.last&gt;b.last
		end)
		for i,e in sorted do
			if i&gt;120 then break end
			local r=Instance.new("TextButton");r.LayoutOrder=i;r.Size=UDim2.new(1,-8,0,0);r.AutomaticSize=Enum.AutomaticSize.Y
			r.BackgroundColor3=rgb(26,31,40);r.BorderSizePixel=0;r.TextXAlignment=Enum.TextXAlignment.Left;r.TextWrapped=true;r.RichText=true
			r.Font=Enum.Font.Gotham;r.TextSize=12;r.TextColor3=rgb(225,228,235)
			local c=SEV[e.sev].color
			r.Text=string.format('&lt;font color="#%s"&gt;&lt;b&gt;%s&lt;/b&gt;&lt;/font&gt; %s ×%d  &lt;b&gt;%s&lt;/b&gt;%s',c:ToHex(),SEV[e.sev].label,e.clock,e.count,e.title,
				if e.detail~="" then "&lt;br/&gt;"..string.gsub(string.gsub(e.detail,"&lt;","‹"),"&gt;","›") else "")
			local pad=Instance.new("UIPadding");pad.PaddingLeft=UDim.new(0,6);pad.PaddingTop=UDim.new(0,3);pad.PaddingBottom=UDim.new(0,3);pad.Parent=r
			r.Activated:Connect(function()
				print(TAG,SEV[e.sev].label,e.title,"|",e.detail,"|",e.path,"| ×"..e.count)
				focus(e.inst)
			end)
			r.Parent=list
			table.insert(rows,r)
		end
	end
	local probTools={
		{"Effacer la liste",function() table.clear(issues);table.clear(order);dirty=true end},
		{"Rapport → Output",function() Visual.report(self) end},
		{"Infos ON / OFF",function() showInfo=not showInfo;dirty=true end},
	}
	for i,t in probTools do
		button(probs,t[1],UDim2.new(0,(i-1)*136,1,-36),UDim2.fromOffset(130,30),t[2])
	end

	-- Small HUD (mode 2): counters and the latest problems, never in the way of input.
	local hud=Instance.new("ScreenGui");hud.Name="DevVisualHud";hud.ResetOnSpawn=false;hud.DisplayOrder=111;hud.Enabled=false;hud.Parent=playerGui
	local hudText=label(hud,"",UDim2.fromOffset(470,20),UDim2.new(0,16,0,64),12)
	hudText.AutomaticSize=Enum.AutomaticSize.Y
	hudText.BackgroundTransparency=.35;hudText.BackgroundColor3=rgb(10,12,16);hudText.TextStrokeTransparency=.6
	local hudPad=Instance.new("UIPadding");hudPad.PaddingLeft=UDim.new(0,6);hudPad.PaddingTop=UDim.new(0,4);hudPad.Parent=hudText

	local function color(n,warn,bad) return if n&gt;=bad then "#ff6056" elseif n&gt;=warn then "#ffbe50" else "#9be29b" end
	local function refresh()
		local c=counters
		if not c.total then return end
		local nErr,nVoir,nInfo=0,0,0
		for _,e in order do if e.sev=="erreur" then nErr+=1 elseif e.sev=="voir" then nVoir+=1 else nInfo+=1 end end
		local partMem=0
		pcall(function() partMem=Stats:GetMemoryUsageMbForTag(Enum.DeveloperMemoryTag.GraphicsParticles) end)
		local line=string.format('FPS &lt;font color="%s"&gt;%d&lt;/font&gt; · effets %d · particules %d (%d allumés) · lumières d’effet &lt;font color="%s"&gt;%d&lt;/font&gt; · surbrillances &lt;font color="%s"&gt;%d/%d&lt;/font&gt;',
			color(60-fps,15,30),fps,c.total,c.particles,c.particlesOn,color(c.fxLights,8,11),c.fxLights,color(c.highlights,20,25),c.highlights,HIGHLIGHT_LIMIT)
		local problems=string.format('&lt;font color="#ff6056"&gt;%d erreur(s)&lt;/font&gt; · &lt;font color="#ffbe50"&gt;%d à voir&lt;/font&gt; · %d info',nErr,nVoir,nInfo)
		if self.mode==2 then
			local recent={}
			for i,e in order do if i&gt;3 then break end;table.insert(recent,string.format('&lt;font color="#%s"&gt;%s&lt;/font&gt; %s',SEV[e.sev].color:ToHex(),e.clock,e.title)) end
			hudText.Text="&lt;b&gt;F7&lt;/b&gt; "..line.."&lt;br/&gt;"..problems..(if #recent&gt;0 then "&lt;br/&gt;"..table.concat(recent,"&lt;br/&gt;") else "")
			return
		end
		if self.tab=="lumiere" then
			local post={}
			for _,e in postEffects() do
				local state=if e:IsA("Atmosphere") then "air" elseif e.Enabled then "ON" else "off"
				table.insert(post,e.Name.." "..state)
			end
			lightText.Text=string.format(
				"&lt;b&gt;Éclairage %s&lt;/b&gt;%s&lt;br/&gt;Heure %.1f h · latitude %.0f° · luminosité %.2f · exposition %.2f&lt;br/&gt;Ombres globales &lt;b&gt;%s&lt;/b&gt; · douceur %.2f · technologie &lt;b&gt;%s&lt;/b&gt;&lt;br/&gt;Ambiance %s · extérieur %s&lt;br/&gt;Diffus %.2f · spéculaire %.2f&lt;br/&gt;Post-effets : %s&lt;br/&gt;Lumières allumées : %d, dont %d d'effet (%d avec ombres) · surface Néon visible %.0f studs²",
				if preset=="jeu" then "du jeu (Client/WorldLook)" else "de test : "..preset,
				if WorldLook and WorldLook.borrowed then " — &lt;font color=\"#ffbe50\"&gt;le jeu ne le réimpose pas tant que l'outil le tient&lt;/font&gt;" else "",
				Lighting.ClockTime,Lighting.GeographicLatitude,Lighting.Brightness,Lighting.ExposureCompensation,
				if Lighting.GlobalShadows then "ON" else "OFF",Lighting.ShadowSoftness,techName(),
				Lighting.Ambient:ToHex(),Lighting.OutdoorAmbient:ToHex(),Lighting.EnvironmentDiffuseScale,Lighting.EnvironmentSpecularScale,
				if #post&gt;0 then table.concat(post,", ") else "aucun",c.lights,c.fxLights,c.lightsShadow,c.neonArea or 0)
			for k,b in presetButtons do b.BackgroundColor3=if k==preset then rgb(70,96,140) else rgb(43,51,65) end
		elseif self.tab=="effets" then
			fxText.Text=string.format("%s&lt;br/&gt;Émetteurs de particules %d (%d allumés) · mémoire particules %.1f Mo&lt;br/&gt;Faisceaux / traînées %d · sprites 2D %d&lt;br/&gt;Formes d'effet %d · marques au sol %d&lt;br/&gt;Instances du jeu %d · saccades (&amp;gt;60 ms) %d, pire %.0f ms%s",
				line,c.particles,c.particlesOn,partMem,c.beams,c.sprites,c.shapes,c.marks,Stats.InstanceCount,frameSpikes,worstFrame*1000,
				if frozen then string.format('&lt;br/&gt;&lt;font color="#ffbe50"&gt;Particules à ×%.1f&lt;/font&gt;',frozen) else "")
			for _,f in FAMILIES do
				local b=familyButtons[f.key]
				b.Text=f.name.." : "..(if hidden[f.key] then "CACHÉ" else "visible")
				b.BackgroundColor3=if hidden[f.key] then rgb(120,60,50) else rgb(43,51,65)
			end
		elseif self.tab=="problemes" then
			probSummary.Text=problems.."&lt;br/&gt;Cliquer une ligne : l'objet s'entoure en jaune 3 s et son chemin part dans Output."..(if showInfo then "" else " (infos cachées)")
			if dirty then rebuildList();dirty=false end
		end
	end

	-- Input: the panel holds combat input like F6 (DevClient computes
	-- panelOpen from both); the HUD does not.
	local function release()
		pcall(function()
			local jumping=next(ctx.input.jumps)~=nil
			ctx.input:reset();ctx.send("GuardOff");if jumping then ctx.send("JumpOff") end;ctx.send("Move",Vector3.zero)
		end)
	end
	function self:setMode(mode)
		self.mode=mode
		gui.Enabled=mode==1
		hud.Enabled=mode==2
		self.blocking=mode==1
		if dev and dev.refreshBlocking then dev:refreshBlocking() end
		if mode==1 then release();selectTab(self.tab) end
		if mode==0 then outlinesOn=false;clearOutlines() end
	end
	UserInputService.InputBegan:Connect(function(key,processed)
		if not processed and key.KeyCode==Enum.KeyCode.F7 then self:setMode((self.mode+1)%3) end
	end)

	self.hidden=hidden;self.issues=order;self.setFamily=setFamily;self.applyPreset=applyPreset;self.particleTime=particleTime
	self.counters=function() return counters end
	self.lightingState=function()
		return {preset=preset,borrowed=WorldLook and WorldLook.borrowed or false,clock=Lighting.ClockTime,latitude=Lighting.GeographicLatitude,brightness=Lighting.Brightness,
			exposure=Lighting.ExposureCompensation,globalShadows=Lighting.GlobalShadows,technology=techName(),ambient=Lighting.Ambient:ToHex(),outdoor=Lighting.OutdoorAmbient:ToHex()}
	end

	-- Agents read the same report from Studio (execute_luau on the client):
	-- PlayerGui.DevVisualPanel.Report:Invoke() → JSON.
	local bindable=Instance.new("BindableFunction");bindable.Name="Report";bindable.Parent=gui
	bindable.OnInvoke=function(op,arg)
		if op=="preset" then applyPreset(arg) elseif op=="hide" then setFamily(arg,true) elseif op=="show" then setFamily(arg,false)
		elseif op=="mode" then self:setMode(tonumber(arg) or 0) elseif op=="restore" then Visual.restore(self) elseif op=="clear" then table.clear(issues);table.clear(order)
		elseif op=="tab" and pages[arg] then selectTab(arg) end
		return HttpService:JSONEncode(Visual.snapshot(self))
	end

	-- Follow every effect from now on.
	-- (QA 12/11, gel au BEGIN) What arrives is queued and classified at most
	-- TRACK_BUDGET a frame: a duel's start brought some two thousand objects
	-- in one frame, each walked up to the workspace several times (60,000
	-- reads in one frame in the micro-profiler).
	local TRACK_BUDGET=150
	local queue,head,tail={},1,0
	for _,root in {workspace,playerGui} do
		for _,d in root:GetDescendants() do track(d) end
		root.DescendantAdded:Connect(function(d) tail+=1;queue[tail]=d end)
	end
	local function drain()
		local budget=TRACK_BUDGET
		while head&lt;=tail and budget&gt;0 do
			local d=queue[head];queue[head]=nil;head+=1;budget-=1
			-- A frame later at least: the game names and places what it creates after parenting it.
			if d.Parent then
				track(d)
				local info=tracked[d]
				if info then
					if hidden[info.family] then hide(d,info.family) end
					if info.family=="particles" and frozen then pcall(function() d.TimeScale=frozen end) end
				end
			end
		end
		if head&gt;tail then head,tail=1,0 end
	end
	Lighting.ChildAdded:Connect(function(e) if hidden.post and (e:IsA("PostEffect") or e:IsA("Atmosphere")) then task.defer(setFamily,"post",true) end end)
	local acc,last=0,0
	local installedAt=os.clock()
	local frames,frameClock=0,os.clock()
	RunService.RenderStepped:Connect(function(dt)
		pcall(drain)
		frames+=1
		if dt&gt;.06 and dt&lt;2 and os.clock()-installedAt&gt;10 then
			frameSpikes+=1;worstFrame=math.max(worstFrame,dt)
			if dt&gt;.12 then report("info","Saccade : une image a duré "..math.floor(dt*1000).." ms",string.format("%d objets d'effet vivants",counters.total or 0),nil,"spike") end
		end
		local t=os.clock()
		if t-frameClock&gt;=1 then fps=math.floor(frames/(t-frameClock)+.5);frames=0;frameClock=t end
		acc+=dt
		if acc&lt;.5 then return end
		acc=0
		local ok,err=pcall(scan)
		if not ok and t-last&gt;10 then last=t;warn(TAG.." scan: "..tostring(err)) end
		if self.mode~=0 then pcall(refresh);pcall(updateOutlines) end
	end)
	self.gui=gui
	print(TAG,"F7 : outil visuel prêt (lumière, ombres, effets, problèmes)")
	return self
end

-- Everything back as the game set it: the game's lighting, every hidden family,
-- particle time.
function Visual.restore(self)
	for _,f in FAMILIES do if self.hidden[f.key] then self.setFamily(f.key,false) end end
	self.particleTime(nil)
	self.applyPreset("jeu")
end

function Visual.snapshot(self)
	local list={}
	for i,e in self.issues do
		if i&gt;150 then break end
		table.insert(list,{sev=e.sev,title=e.title,detail=e.detail,path=e.path,count=e.count,at=e.clock})
	end
	local hiddenList={}
	for k in self.hidden do table.insert(hiddenList,k) end
	return {counters=self.counters(),lighting=self.lightingState(),hidden=hiddenList,issues=list}
end

function Visual.report(self)
	local snap=Visual.snapshot(self)
	print(TAG,"begin",HttpService:JSONEncode({counters=snap.counters,lighting=snap.lighting,hidden=snap.hidden}))
	for _,e in snap.issues do print(TAG,HttpService:JSONEncode(e)) end
	print(TAG,"end",#snap.issues.." problème(s)")
end

return Visual
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND205">
          <Properties>
            <string name="Name">DevVolumes</string>
            <ProtectedString name="Source">-- Read-only Studio adornments (Codex 33028b2, ported): fighter roots in blue,
-- the live BanglaHitbox Parts of the viewer's duel in red. Never creates a
-- collision Part, never changes a property or a query. A startup box is not a
-- confirmed active window; projectiles and hazards do not use this Part.
-- Debug/QA places only (build.py DEBUG_SOURCES).
local Volumes={};Volumes.__index=Volumes
function Volumes.new(player) return setmetatable({player=player,enabled=false,boxes={},last=0},Volumes) end
function Volumes:clear()
	for _,box in self.boxes do box:Destroy() end;self.boxes={}
end
function Volumes:set(enabled) self.enabled=enabled;if not enabled then self:clear() end end
-- `data` is the latest duel snapshot: the opponent's model is named data.bot.id
-- ("AIFighter" against the AI, a duelist online).
function Volumes:update(data)
	if not self.enabled or os.clock()-self.last&lt;.1 then return end;self.last=os.clock()
	local model=self.player.Character;local folder=model and model.Parent;local effects=folder and folder:FindFirstChild("Effects")
	local wanted={}
	if effects then
		for _,part in effects:GetChildren() do
			if part:IsA("BasePart") and part.Name=="BanglaHitbox" then wanted[part]=Color3.fromRGB(255,100,85) end
		end
	end
	local opponent=folder and folder:FindFirstChild(data and data.bot and data.bot.id or "AIFighter")
	for _,fighter in {model,opponent} do
		local root=fighter and fighter:FindFirstChild("HumanoidRootPart");if root then wanted[root]=Color3.fromRGB(70,170,255) end
	end
	for part,box in self.boxes do if not wanted[part] or not part.Parent then box:Destroy();self.boxes[part]=nil end end
	local count=0
	for part,color in wanted do
		count+=1;if count&gt;40 then break end
		local box=self.boxes[part]
		if not box then
			box=Instance.new("BoxHandleAdornment");box.Name="DevObservedVolume";box.Adornee=part;box.AlwaysOnTop=true;box.ZIndex=4;box.Transparency=.7;box.Parent=self.player.PlayerGui;self.boxes[part]=box
		end
		box.Size=part.Size;box.Color3=color
	end
end
return Volumes
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND206">
          <Properties>
            <string name="Name">Effects</string>
            <ProtectedString name="Source">-- Client-side combat VFX. Everything here is presentation driven by the server
-- snapshot and contact feed: real 3D kunai and shuriken flying on the exact
-- server path, planted Flying Thunder God seals, the Katon fireball, teleport
-- flashes, substitution logs, Itachi's crows, Rasengan and burning ground.
-- Nothing in this module can change gameplay.
local Debris=game:GetService("Debris")
local TweenService=game:GetService("TweenService")
local Kit=require(script.Parent.VfxKit)
local Face=require(game:GetService("ReplicatedStorage").NinjaDuel.Face)
local FX={};FX.__index=FX
-- Cel flame streams of the fireballs in flight (VfxKit), by model.
FX.fireStreams=setmetatable({},{__mode="k"})
-- Identity layers: a fighter whose look lives in its own module (SandFX)
-- registers projectile builders and poses, contact styles and a per-frame step.
FX.layers={}
FX.poses={}

local TEX={
	fire="rbxasset://textures/particles/fire_main.dds",
	smoke="rbxasset://textures/particles/smoke_main.dds",
	spark="rbxasset://textures/particles/sparkles_main.dds",
	fireSpark="rbxasset://textures/particles/fire_sparks_main.dds",
	core="rbxasset://textures/particles/explosion01_core_main.dds",
	shock="rbxasset://textures/particles/explosion01_shockwave_main.dds",
	glow="rbxasset://textures/particles/forcefield_glow_main.dds",
	vortex="rbxasset://textures/particles/forcefield_vortex_main.dds",
	-- (Jutsu pass 06/11) From the VFX Studio library (public Roblox assets,
	-- ids read in its browser): flipbooks need FlipbookLayout set.
	swirl="rbxassetid://14186707980",      -- "Air2", a white spiral (Rasengan)
	energy="rbxassetid://12402864591",     -- "29", a spiky ball of energy
	halo="rbxassetid://12386390257",       -- "11", a bright ring halo
	ripple="rbxassetid://13189665112",     -- water rings, 4x4 flipbook
	splash="rbxassetid://12390096354",     -- water burst, 8x8 flipbook
	droplets="rbxassetid://72264530299648", -- water droplets, 4x4 flipbook
	bubbles="rbxassetid://79998832137235",  -- bubbles, 4x4 flipbook
}
local SOUND={
	whoosh="rbxassetid://5835032207",
	hit="rbxassetid://8595980577",
	heavy="rbxassetid://9117969717",
	boom="rbxasset://sounds/impact_explosion_03.mp3",
	land="rbxasset://sounds/action_jump_land.mp3",
	jump="rbxasset://sounds/action_jump.mp3",
	getUp="rbxasset://sounds/action_get_up.mp3",
	-- (Reference quality) Roblox's licensed Pro Sound Effects library.
	electric={"rbxassetid://9116279560","rbxassetid://9116276961","rbxassetid://9116275998"},
	swish="rbxassetid://9126284094",
	whooshBy="rbxassetid://9120711172",
	punch="rbxassetid://9117971636",
	body="rbxassetid://9113524242",
	bodyfall="rbxassetid://9113482032",
	debris="rbxassetid://9114221862",
	-- (06/11) a fire's crackle loop and stone breaking (Pro Sound Effects;
	-- Studio 06/11: the built-in sounds/fire.mp3 does not exist), water
	-- (built-in, loads).
	fireLoop="rbxassetid://9112780462",
	rock={"rbxassetid://9118588165","rbxassetid://9118587494"},
	splash="rbxasset://sounds/impact_water.mp3",
}
FX.SOUND=SOUND
-- Contacts that bring the crowd to its feet, by strength.
local CHEER={chidori=1,groundbounce=.8,slam=1,launcher=.7,finisher=.8,fire=1,teleport=.9,parry=.8,substitute=.4,burst=.8,clash=.9,wall=.6,wallbounce=1,worldbreak=1,walltech=.5,repel=.9,trigram=.7}
local HYUGA=Color3.fromRGB(190,208,255)
-- Visual time runs a hair behind the server clock, like the bodies, so a blade
-- leaves the throwing hand on the frame the arm releases it.
FX.DELAY=.06
local STEEL=Color3.fromRGB(64,68,76)
local STEEL_EDGE=Color3.fromRGB(150,158,170)
local MINATO=Color3.fromRGB(255,214,92)
local LION=Color3.fromRGB(150,180,255)
local CURSE=Color3.fromRGB(120,60,200)
local MINATO_CORE=Color3.fromRGB(255,248,214)
local SHARINGAN=Color3.fromRGB(230,36,44)
local WIND=Color3.fromRGB(190,255,226)

local function new(class,props,parent)
	local x=Instance.new(class)
	for k,v in props do x[k]=v end
	if parent then x.Parent=parent end
	return x
end
local function block(parent,size,cf,color,material,class)
	local p=new(class or "Part",{Size=size,CFrame=cf,Color=color,Material=material or Enum.Material.SmoothPlastic,
		Anchored=true,CanCollide=false,CanQuery=false,CanTouch=false,CastShadow=false,
		TopSurface=Enum.SurfaceType.Smooth,BottomSurface=Enum.SurfaceType.Smooth},parent)
	return p
end
local function tween(object,time,goal,style,direction)
	local t=TweenService:Create(object,TweenInfo.new(time,style or Enum.EasingStyle.Quad,direction or Enum.EasingDirection.Out),goal)
	t:Play();return t
end
local function sound(parent,id,volume,speed,cut)
	if type(id)=="table" then id=id[math.random(1,#id)] end
	local s=new("Sound",{SoundId=id,Volume=volume or .4,PlaybackSpeed=speed or 1,RollOffMaxDistance=160,RollOffMinDistance=12},parent)
	s:Play();Debris:AddItem(s,3)
	-- A long take (debris, a body fall) is cut short with a fade.
	if cut then task.delay(cut,function() if s.Parent then tween(s,.35,{Volume=0}) end end) end
	-- A bare anchor made for this sound goes with it.
	if parent.Name=="SoundAnchor" then Debris:AddItem(parent,3) end
	return s
end
local function seq(points)
	local keys={}
	for _,p in points do table.insert(keys,ColorSequenceKeypoint.new(p[1],p[2])) end
	return ColorSequence.new(keys)
end
local function num(points)
	local keys={}
	for _,p in points do table.insert(keys,NumberSequenceKeypoint.new(p[1],p[2],p[3] or 0)) end
	return NumberSequence.new(keys)
end
local function emitter(parent,props)
	local e=new("ParticleEmitter",{Enabled=false,LightInfluence=0,ZOffset=.5},parent)
	for k,v in props do e[k]=v end
	return e
end
-- An invisible point to hang a sound, light or emitter on (it used to be a
-- visible black cube left behind at every contact for the rest of the duel).
local function anchorPart(parent,position)
	local p=block(parent,Vector3.new(.2,.2,.2),CFrame.new(position),Color3.new(),Enum.Material.SmoothPlastic)
	p.Name="SoundAnchor";p.Transparency=1
	return p
end
-- Weld every piece of a model to its (anchored) root so one CFrame write moves
-- the whole object.
local function weldAll(root,parts)
	for _,p in parts do
		if p~=root then
			p.Anchored=false;p.Massless=true
			local w=new("WeldConstraint",{Part0=root,Part1=p},root)
			w.Name="Hold"
		end
	end
end
-- One half of a tapered leaf. Wedge local Y is the width axis (full at the back,
-- zero at the front edge), X the thickness. `tip` = -1 puts the point towards
-- -Z, +1 towards +Z; `side` picks the half.
local function taper(parent,center,width,length,thick,side,tip,color,material)
	local rot=CFrame.Angles(0,0,-side*math.pi/2)
	if tip&gt;0 then rot=rot*CFrame.Angles(0,math.pi,0) end
	local cf=center*CFrame.new(side*width*.25,0,0)*rot
	return block(parent,Vector3.new(thick,width*.5,length),cf,color,material or Enum.Material.Metal,"WedgePart")
end
local function leaf(parent,center,width,front,back,thick,color,material)
	local list={}
	for _,side in {-1,1} do
		table.insert(list,taper(parent,center*CFrame.new(0,0,-front*.5),width,front,thick,side,-1,color,material))
		table.insert(list,taper(parent,center*CFrame.new(0,0,back*.5),width,back,thick,side,1,color,material))
	end
	return list
end
local function ring(parent,center,radius,count,size,color,material)
	local list={}
	for i=0,count-1 do
		local a=i/count*math.pi*2
		local cf=center*CFrame.Angles(a,0,0)*CFrame.new(0,radius,0)
		table.insert(list,block(parent,Vector3.new(size,size*.9,radius*2*math.pi/count*1.15),cf,color,material or Enum.Material.Metal))
	end
	return list
end

-- ------------------------------------------------------------------ models
-- Kunai built along -Z (point first). The grip centre is the origin, so the
-- same model sits correctly in a hand and flies point-first.
function FX.buildKunai(marked)
	local model=new("Model",{Name=if marked then "MarkedKunai" else "Kunai"})
	local root=block(model,Vector3.new(.1,.1,.1),CFrame.new(),Color3.new(),nil);root.Name="Root";root.Transparency=1
	local parts={}
	local handle=block(model,Vector3.new(.62,.12,.12),CFrame.new(0,0,.1)*CFrame.Angles(0,math.pi/2,0),Color3.fromRGB(36,34,38),Enum.Material.Fabric)
	handle.Shape=Enum.PartType.Cylinder;table.insert(parts,handle)
	for i=-1,1 do
		local band=block(model,Vector3.new(.045,.145,.145),CFrame.new(0,0,.1+i*.19)*CFrame.Angles(0,math.pi/2,0),Color3.fromRGB(122,108,88),Enum.Material.Fabric)
		band.Shape=Enum.PartType.Cylinder;table.insert(parts,band)
	end
	for _,p in ring(model,CFrame.new(0,0,.55),.13,8,.05,STEEL) do table.insert(parts,p) end
	local guard=block(model,Vector3.new(.22,.06,.08),CFrame.new(0,0,-.22),STEEL,Enum.Material.Metal);table.insert(parts,guard)
	-- Leaf blade: widest a third of the way up, long point.
	for _,p in leaf(model,CFrame.new(0,0,-.46),.34,.66,.22,.05,STEEL) do table.insert(parts,p) end
	-- Bright edge along the centre line so the blade reads at combat speed.
	table.insert(parts,block(model,Vector3.new(.02,.055,.82),CFrame.new(0,0,-.5),STEEL_EDGE,Enum.Material.Metal))
	if marked then
		-- Minato's three-pronged kunai: two swept side prongs, and the sealing
		-- formula tag wrapped on the grip.
		for _,side in {-1,1} do
			local base=CFrame.new(side*.12,0,-.3)*CFrame.Angles(0,side*math.rad(28),0)
			for _,p in leaf(model,base*CFrame.new(0,0,-.08),.14,.3,.06,.04,STEEL) do table.insert(parts,p) end
		end
		local tag=block(model,Vector3.new(.2,.02,.42),CFrame.new(0,.075,.12),Color3.fromRGB(236,226,196),Enum.Material.SmoothPlastic)
		tag.Name="SealTag";table.insert(parts,tag)
		for i=-1,1 do
			table.insert(parts,block(model,Vector3.new(.012,.024,.3-math.abs(i)*.08),CFrame.new(i*.05,.088,.12),Color3.fromRGB(30,32,40),Enum.Material.SmoothPlastic))
		end
	end
	weldAll(root,parts)
	model.PrimaryPart=root
	return model
end
-- Four-point shuriken, flat in the XZ plane, spun about its own Y axis.
-- Kakashi's White Light Chakra Sabre (user 29/10): a straight tanto built
-- along -Z like the kunai (grip centre at the origin). White-wrapped grip,
-- small round guard, a long straight blade with a pale chakra edge.
function FX.buildTanto()
	local model=new("Model",{Name="Tanto"})
	local root=block(model,Vector3.new(.1,.1,.1),CFrame.new(),Color3.new(),nil);root.Name="Root";root.Transparency=1
	local grip=block(model,Vector3.new(.62,.15,.15),CFrame.new(0,0,.18)*CFrame.Angles(0,math.pi/2,0),Color3.fromRGB(232,230,222),Enum.Material.Fabric)
	grip.Shape=Enum.PartType.Cylinder
	for i=-1,1 do
		local wrap=block(model,Vector3.new(.04,.165,.165),CFrame.new(0,0,.18+i*.17)*CFrame.Angles(0,math.pi/2,0),Color3.fromRGB(40,42,52),Enum.Material.Fabric)
		wrap.Shape=Enum.PartType.Cylinder
	end
	local pommel=block(model,Vector3.new(.06,.18,.18),CFrame.new(0,0,.5)*CFrame.Angles(0,math.pi/2,0),Color3.fromRGB(70,72,80),Enum.Material.Metal)
	pommel.Shape=Enum.PartType.Cylinder
	local guard=block(model,Vector3.new(.05,.34,.34),CFrame.new(0,0,-.15)*CFrame.Angles(0,math.pi/2,0),Color3.fromRGB(46,46,54),Enum.Material.Metal)
	guard.Shape=Enum.PartType.Cylinder
	-- The blade: a flat bar, the back thicker than the edge, a short point.
	block(model,Vector3.new(.05,.17,1.55),CFrame.new(0,0,-.95),Color3.fromRGB(196,202,212),Enum.Material.Metal)
	block(model,Vector3.new(.03,.05,1.55),CFrame.new(0,-.08,-.95),Color3.fromRGB(236,244,255),Enum.Material.Neon).Transparency=.35
	local tip=block(model,Vector3.new(.05,.17,.24),CFrame.new(0,.03,-1.78)*CFrame.Angles(math.rad(-28),0,0),Color3.fromRGB(196,202,212),Enum.Material.Metal,"WedgePart")
	tip.Name="Tip"
	model.PrimaryPart=root
	return model
end
function FX.buildShuriken()
	local model=new("Model",{Name="Shuriken"})
	local root=block(model,Vector3.new(.1,.1,.1),CFrame.new(),Color3.new());root.Name="Root";root.Transparency=1
	local parts={}
	local disc=block(model,Vector3.new(.07,.46,.46),CFrame.Angles(0,0,math.pi/2),STEEL,Enum.Material.Metal)
	disc.Shape=Enum.PartType.Cylinder;table.insert(parts,disc)
	local hole=block(model,Vector3.new(.08,.13,.13),CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(18,18,22),Enum.Material.SmoothPlastic)
	hole.Shape=Enum.PartType.Cylinder;table.insert(parts,hole)
	for i=0,3 do
		local base=CFrame.Angles(0,i*math.pi/2,0)*CFrame.new(0,0,-.3)
		for _,p in leaf(model,base*CFrame.new(0,0,-.05),.2,.42,.1,.04,STEEL) do table.insert(parts,p) end
		table.insert(parts,block(model,Vector3.new(.015,.05,.38),base*CFrame.new(0,0,-.22),STEEL_EDGE,Enum.Material.Metal))
	end
	weldAll(root,parts)
	model.PrimaryPart=root
	return model
end
-- Per-fighter dash streak (movement overhaul, brief §12): Lee a short, wide
-- physical burst; Itachi barely a trace; Shisui a long faint false continuation;
-- Gaara a slow sand glide; Haku a thin ice line; Zabuza a heavy grey wake;
-- Nagato a short, controlled one. Unlisted fighters keep the default.
local DASH_STREAK={
	Leaf={color=Color3.fromRGB(70,170,80),life=.1,alpha=.5,width=1.25},
	Mirage={color=Color3.fromRGB(150,20,30),life=.06,alpha=.78,width=.7},
	Flicker={color=Color3.fromRGB(110,200,150),life=.24,alpha=.72,width=.9},
	Sand={color=Color3.fromRGB(205,175,115),life=.22,alpha=.55,width=1.35},
	Mirror={color=Color3.fromRGB(190,230,255),life=.18,alpha=.6,width=.75},
	Mist={color=Color3.fromRGB(150,160,175),life=.13,alpha=.5,width=1.45},
	Rinnegan={color=Color3.fromRGB(150,120,200),life=.09,alpha=.7,width=.8},
}
local function addTrail(root,a,b,color,lifetime,transparency,width)
	local a0=new("Attachment",{Position=a},root)
	local a1=new("Attachment",{Position=b},root)
	return new("Trail",{Attachment0=a0,Attachment1=a1,Color=ColorSequence.new(color),LightEmission=.7,
		Transparency=num({{0,transparency or .35},{1,1}}),Lifetime=lifetime or .12,FaceCamera=true,WidthScale=num({{0,width or 1},{1,.2}})},root)
end
-- Each caster's Katon has its own fire (user 28/10 "les animations de Katon,
-- c'est toutes les mêmes"). Sasuke: a tight, white-hot sphere that rolls
-- fast. Itachi: a deep crimson mass, heavier smoke, slow roll, a long tail.
local FIRE_LOOK={
	default={core=Color3.fromRGB(255,240,180),mid=Color3.fromRGB(255,150,40),outer=Color3.fromRGB(230,70,20),
		ramp={Color3.fromRGB(255,240,170),Color3.fromRGB(255,140,40),Color3.fromRGB(200,50,20),Color3.fromRGB(60,20,10)},smoke=26,smokeColor=Color3.fromRGB(60,48,44),roll=3,flames=140,embers=40,light=Color3.fromRGB(255,140,60)},
	Lion={core=Color3.fromRGB(255,252,225),mid=Color3.fromRGB(255,196,70),outer=Color3.fromRGB(255,112,24),
		ramp={Color3.fromRGB(255,250,210),Color3.fromRGB(255,180,50),Color3.fromRGB(235,80,20),Color3.fromRGB(70,26,10)},smoke=14,smokeColor=Color3.fromRGB(70,56,48),roll=7,flames=170,embers=60,light=Color3.fromRGB(255,176,80)},
	Mirage={core=Color3.fromRGB(255,214,150),mid=Color3.fromRGB(236,92,28),outer=Color3.fromRGB(160,22,14),
		ramp={Color3.fromRGB(255,214,140),Color3.fromRGB(230,80,24),Color3.fromRGB(150,24,14),Color3.fromRGB(34,12,10)},smoke=44,smokeColor=Color3.fromRGB(38,30,30),roll=1.6,flames=120,embers=24,light=Color3.fromRGB(235,80,40),tail=true},
}
FX.FIRE_LOOK=FIRE_LOOK
FX.fireRoll=setmetatable({},{__mode="k"})
function FX.buildFireball(caster)
	local look=FIRE_LOOK[caster or ""] or FIRE_LOOK.default
	local model=new("Model",{Name="GreatFireball"})
	FX.fireRoll[model]=look.roll
	local root=block(model,Vector3.new(1,1,1),CFrame.new(),look.core,Enum.Material.Neon);root.Name="Root"
	root.Shape=Enum.PartType.Ball;root.Transparency=.05
	local mid=block(model,Vector3.new(1,1,1),CFrame.new(),look.mid,Enum.Material.Neon);mid.Shape=Enum.PartType.Ball;mid.Transparency=.35;mid.Name="Mid"
	local outer=block(model,Vector3.new(1,1,1),CFrame.new(),look.outer,Enum.Material.Neon);outer.Shape=Enum.PartType.Ball;outer.Transparency=.62;outer.Name="Outer"
	weldAll(root,{mid,outer})
	local at=new("Attachment",{},root)
	if look.tail then
		-- Itachi's mass drags a long fire tail behind it.
		addTrail(root,Vector3.new(0,1.6,0),Vector3.new(0,-1.6,0),look.outer,.5,.3,3)
	end
	local flames=emitter(at,{Name="Flames",Enabled=true,Texture=TEX.fire,Rate=look.flames,Lifetime=NumberRange.new(.25,.5),Speed=NumberRange.new(2,7),SpreadAngle=Vector2.new(180,180),
		Color=seq({{0,look.ramp[1]},{.35,look.ramp[2]},{.75,look.ramp[3]},{1,look.ramp[4]}}),
		LightEmission=1,Size=num({{0,3},{.4,5},{1,1.5}}),Transparency=num({{0,.15},{.7,.4},{1,1}}),Drag=3,RotSpeed=NumberRange.new(-120,120),Rotation=NumberRange.new(0,360),ZOffset=1})
	if Kit.has("fire") then
		-- (Reference quality) cel flames: our own flipbook, colours baked in,
		-- left behind along the flight as it burns.
		flames.Rate=40
		FX.fireStreams[model]=Kit.stream(at,"fire",{Rate=55,Lifetime=NumberRange.new(.3,.5),Speed=NumberRange.new(1,4),SpreadAngle=Vector2.new(180,180),
			Color=ColorSequence.new(Color3.new(1,1,1)),LightEmission=.25,Size=num({{0,3},{.5,5},{1,4}}),Transparency=num({{0,0},{.85,0},{1,1}}),
			Drag=3,Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-60,60)})
	end
	emitter(at,{Name="Smoke",Enabled=true,Texture=TEX.smoke,Rate=look.smoke,Lifetime=NumberRange.new(.7,1.2),Speed=NumberRange.new(1,3),SpreadAngle=Vector2.new(180,180),
		Color=ColorSequence.new(look.smokeColor),LightEmission=0,Size=num({{0,3},{1,8}}),Transparency=num({{0,.55},{1,1}}),Drag=2})
	emitter(at,{Name="Embers",Enabled=true,Texture=TEX.fireSpark,Rate=look.embers,Lifetime=NumberRange.new(.4,.8),Speed=NumberRange.new(6,14),SpreadAngle=Vector2.new(180,180),
		Color=ColorSequence.new(Color3.fromRGB(255,190,90)),LightEmission=1,Size=num({{0,.35},{1,0}}),Acceleration=Vector3.new(0,6,0)})
	-- (Jutsu pass 05/11) was 4 over 28 studs: the caster went white behind it
	new("PointLight",{Color=look.light,Brightness=2,Range=20,Shadows=false},root)
	model.PrimaryPart=root
	return model
end
function FX.buildWind()
	local model=new("Model",{Name="WindBlade"})
	local root=block(model,Vector3.new(.1,.1,.1),CFrame.new(),Color3.new());root.Name="Root";root.Transparency=1
	local parts={}
	for i=-3,3 do
		local a=i*math.rad(16)
		local p=block(model,Vector3.new(1.3,.06,.35),CFrame.Angles(0,a,0)*CFrame.new(0,0,-1.6+math.abs(i)*.18),Color3.fromRGB(200,255,232),Enum.Material.Neon)
		p.Transparency=.35+math.abs(i)*.08;table.insert(parts,p)
	end
	weldAll(root,parts)
	addTrail(root,Vector3.new(-2.2,0,0),Vector3.new(2.2,0,0),Color3.fromRGB(190,255,226),.16,.55,1)
	model.PrimaryPart=root
	return model
end

-- ------------------------------------------------------------------ state
function FX.new()
	local folder=Instance.new("Folder");folder.Name="NinjaDuelFX";folder.Parent=workspace
	-- Decode the VFX textures now, before the first contact needs them.
	if task and task.defer then task.defer(function() pcall(Kit.warm) end) end
	-- (Reference quality) the world's marks (Server/WorldReaction scars) are
	-- drawn with our scorch and crack art instead of flat dark discs.
	if workspace.DescendantAdded then
		workspace.DescendantAdded:Connect(function(part) pcall(FX.dressScar,part) end)
	end
	local fx=setmetatable({folder=folder,projectiles={},stuck={},seals={},hazards={},auras={},rasengan={},epoch=nil,
		clock=0,cache={}},FX)
	-- (06/11) GroundFX watches the arena's scars with the live effects layer
	FX.current=fx
	return fx
end
function FX:reset()
	self.folder:ClearAllChildren()
	table.clear(self.projectiles);table.clear(self.stuck);table.clear(self.seals);table.clear(self.hazards);table.clear(self.rasengan)
	for _,aura in self.auras do if aura.trail then aura.trail.Enabled=false end end
	-- (Performance review 04/11, finding 1) every duel builds new rigs: the
	-- auras of the old ones (trail, face, part lists) were kept for good, and
	-- with them every weak per-model table of the identity layers.
	for model in table.clone(self.auras) do if typeof(model)~="Instance" or model.Parent==nil then self.auras[model]=nil end end
	-- The identity layers' per-model states (narutoState, leeState...): a
	-- value pointing back at its key (a face) would keep a dead rig alive.
	for name,states in self do
		if type(name)=="string" and string.sub(name,-5)=="State" and type(states)=="table" then
			for model in table.clone(states) do if typeof(model)=="Instance" and model.Parent==nil then states[model]=nil end end
		end
	end
end
local function serverNow() return workspace:GetServerTimeNow() end
function FX:visualTime() return serverNow()-FX.DELAY end
-- (Jutsu pass 05/11, the Itachi vs Kakashi film: « on voit à peine les
-- shuriken de l'ombre ») A flying shuriken is drawn 1.4 times its resting
-- size (a stuck one keeps the real size): at the duel camera's distance a
-- one-stud grey star over light sand was nearly invisible.
local FLYING_SHURIKEN=1.4
local function flyingShuriken()
	local m=FX.buildShuriken()
	pcall(function() m:ScaleTo(FLYING_SHURIKEN) end)
	return m
end
local BUILD={kunai=function() return FX.buildKunai(false) end,marked=function() return FX.buildKunai(true) end,wire=flyingShuriken,
	shuriken=flyingShuriken,fireball=function(p) return FX.buildFireball(p and p.caster) end,wind=FX.buildWind,
	-- Vacuum Palm: a pale ring of compressed air (sized by the flight radius).
	palm=function()
		local model=new("Model",{Name="VacuumPalm"})
		local root=block(model,Vector3.new(.1,.1,.1),CFrame.new(),Color3.new());root.Name="Root";root.Transparency=1
		local ring=block(model,Vector3.new(.3,3,3),CFrame.Angles(0,math.pi/2,0),Color3.fromRGB(214,228,255),Enum.Material.Neon);ring.Name="Ring"
		ring.Shape=Enum.PartType.Cylinder;ring.Transparency=.62
		local core=block(model,Vector3.new(.2,1.6,1.6),CFrame.Angles(0,math.pi/2,0)*CFrame.new(-.4,0,0),Color3.fromRGB(240,246,255),Enum.Material.Neon);core.Name="Core"
		core.Shape=Enum.PartType.Cylinder;core.Transparency=.45
		weldAll(root,{ring,core})
		addTrail(root,Vector3.new(0,1.2,0),Vector3.new(0,-1.2,0),Color3.fromRGB(206,222,255),.12,.6,1)
		model.PrimaryPart=root
		return model
	end,
	-- Phoenix Flower: the same fire build, shrunk and dimmer.
	phoenix=function(p)
		local model=FX.buildFireball(p and p.caster)
		local light=model.PrimaryPart:FindFirstChildOfClass("PointLight");if light then light.Range=12;light.Brightness=2.5 end
		local at=model.PrimaryPart:FindFirstChildOfClass("Attachment")
		local smoke=at and at:FindFirstChild("Smoke");if smoke then smoke.Rate=8 end
		local flames=at and at:FindFirstChild("Flames");if flames then flames.Rate=60 end
		return model
	end}
-- Snapshot sync: create visuals for newly announced projectiles, mark the ones
-- the server no longer reports.
function FX:sync(data)
	if data.epoch~=self.epoch then self.epoch=data.epoch;self:reset() end
	-- The two fighters' model names in this duel (online they are not the AI names).
	if data.human and data.bot then self.fighterIds={data.human.id,data.bot.id} end
	local live={}
	for _,p in data.projectiles or {} do
		live[p.id]=true
		local entry=self.projectiles[p.id]
		if not entry and p.planted then
			-- A chakra blade planted in a surface, or a stretched wire: drawn once
			-- where it rests (ChakraCombat points); an unknown kind is skipped.
			local ok,built=pcall(self.planted,self,p)
			if ok and built then self.projectiles[p.id]=built end
			entry=self.projectiles[p.id]
			if not entry then continue end
		elseif not entry then
			local build=BUILD[p.kind] or BUILD.kunai
			local model=build(p)
			model.Parent=self.folder
			local root=model.PrimaryPart
			-- Chakra infusion: the object itself looks reinforced / windy / burning /
			-- charged (decorations only; the flight is the server's).
			local decor=p.infusion and select(2,pcall(self.infuse,self,model,root,p.infusion,p.kind))
			if p.infusion then
				-- the infusion owns the trail
			elseif p.kind=="kunai" or p.kind=="marked" then
				addTrail(root,Vector3.new(0,.06,.2),Vector3.new(0,-.06,.2),if p.kind=="marked" then MINATO else Color3.fromRGB(220,226,236),.1,.5,1)
			elseif p.kind=="shuriken" or p.kind=="wire" then
				-- Two layers so the line reads on the pale sand and on the sky:
				-- a wide light wake and a narrow dark core inside it.
				addTrail(root,Vector3.new(-.55,0,0),Vector3.new(.55,0,0),Color3.fromRGB(236,242,252),.14,.42,1)
				local core=addTrail(root,Vector3.new(-.14,0,0),Vector3.new(.14,0,0),Color3.fromRGB(44,50,66),.1,.18,1)
				core.LightEmission=0
			end
			if p.kind=="wire" then
				-- Ninja wire: a thin line from the thrower's hand to the blade.
				local owner=self.fighters and self.fighters:FindFirstChild(p.owner or "")
				local hand=owner and owner:FindFirstChild("RightHand")
				if hand then
					local a0=new("Attachment",{Name="WireStart"},hand)
					local a1=new("Attachment",{Name="WireEnd"},root)
					new("Beam",{Attachment0=a0,Attachment1=a1,Width0=.06,Width1=.06,Color=ColorSequence.new(Color3.fromRGB(210,214,220)),LightEmission=.3,FaceCamera=true,Segments=2},root)
					Debris:AddItem(a0,1.2)
				end
			end
			entry={data=p,model=model,root=root,spin=math.random()*math.pi*2,hidden=true,decor=if type(decor)=="table" then decor else nil}
			self.projectiles[p.id]=entry
			for _,d in model:GetDescendants() do if d:IsA("BasePart") then d.LocalTransparencyModifier=1 end end
			if p.kind=="fireball" then
				local owner=self.fighters and self.fighters:FindFirstChild(p.owner or "")
				local head=owner and owner:FindFirstChild("Head")
				if head then
					local look=FIRE_LOOK[p.caster or ""] or FIRE_LOOK.default
					local a0=new("Attachment",{Name="Breath",Position=Vector3.new(0,-.25,-.55)},head)
					local a1=new("Attachment",{Name="BreathEnd"},root)
					entry.breath={beam=new("Beam",{Attachment0=a0,Attachment1=a1,Width0=.5,Width1=(p.radius or 2.4)*1.6,Texture=TEX.fire,TextureSpeed=4,TextureLength=3,
						Color=seq({{0,look.ramp[1]},{.5,look.ramp[2]},{1,look.ramp[3]}}),LightEmission=1,FaceCamera=true,Segments=8,
						Transparency=num({{0,.2},{1,.35}})},root),a0=a0}
					Debris:AddItem(a0,1)
				end
				sound(root,SOUND.boom,.35,.55)
			elseif p.kind=="phoenix" then
				sound(root,SOUND.whoosh,.25,.7)
			elseif p.kind=="palm" then
				sound(root,SOUND.whoosh,.45,.6)
			elseif p.kind=="kunai" or p.kind=="marked" or p.kind=="shuriken" or p.kind=="wire" then
				sound(root,SOUND.whoosh,.28,if p.kind=="shuriken" then 1.5 else 1.25)
			end
		elseif not p.planted and entry.data.born~=p.born then
			-- Re-based in the air (Combat:redirect: a wind lane turned it aside or
			-- sped it up): the old leg is drawn until the visual clock reaches the
			-- new one, so the flight bends where it bent instead of vanishing and
			-- jumping ahead.
			entry.previous=entry.data
		end
		entry.data=p;entry.missingSince=nil
	end
	for id,entry in self.projectiles do
		if not live[id] and not entry.missingSince then entry.missingSince=os.clock() end
	end
end
function FX:finishProjectile(id)
	local entry=self.projectiles[id]
	if not entry then return nil end
	self.projectiles[id]=nil
	local root=entry.root
	Kit.stop(FX.fireStreams[entry.model])
	-- Let a trail finish fading instead of cutting it.
	for _,d in entry.model:GetDescendants() do
		if d:IsA("BasePart") then d.Transparency=1 elseif d:IsA("ParticleEmitter") or d:IsA("Beam") then d.Enabled=false elseif d:IsA("PointLight") then d.Enabled=false end
	end
	Debris:AddItem(entry.model,.6)
	return entry,root
end
function FX:stepProjectiles(dt)
	local t=self:visualTime()
	for id,entry in self.projectiles do
		local p=entry.data
		if entry.previous then
			if t&lt;p.born then p=entry.previous else entry.previous=nil end
		end
		local age=t-p.born
		if entry.missingSince and os.clock()-entry.missingSince&gt;.35 then
			self:finishProjectile(id)
			continue
		end
		if entry.static then
			pcall(self.restStep,self,entry)
			continue
		end
		-- Combat convergence (Studio, 60 fps probe): the held kunai vanished one
		-- frame before the thrown one appeared, and that one appeared ~2 studs
		-- ahead of the hand and 1.5 lower (the server origin). A thrown object
		-- now shows from the frame the hand lets go and leaves from the hand,
		-- easing onto the server flight in its first tenth of a second.
		local thrown=p.kind=="kunai" or p.kind=="marked" or p.kind=="shuriken" or p.kind=="wire"
		local hidden=age&lt;(if thrown then -1/30 else 0)
		if thrown and not hidden and not entry.release then
			local owner=self.fighters and self.fighters:FindFirstChild(p.owner or "")
			local hand=owner and (owner:FindFirstChild(if p.kind=="shuriken" then "LeftHand" else "RightHand") or owner:FindFirstChild("RightHand"))
			entry.release=if hand then hand.Position else false
		end
		if hidden~=entry.hidden then
			entry.hidden=hidden
			for _,d in entry.model:GetDescendants() do if d:IsA("BasePart") then d.LocalTransparencyModifier=if hidden then 1 else 0 end end
			if entry.decor then for _,e in entry.decor.emitters do e.Enabled=not hidden end end
			local stream=FX.fireStreams[entry.model]
			if stream then stream.Enabled=not hidden end
		end
		if entry.breath then
			-- The breath thins and goes out over its first third of a second.
			local u=math.clamp(age/.35,0,1)
			if u&gt;=1 then entry.breath.beam:Destroy();entry.breath.a0:Destroy();entry.breath=nil
			else entry.breath.beam.Transparency=num({{0,.2+.8*u},{1,.35+.65*u}}) end
		end
		if entry.decor and entry.decor.light then
			local look=entry.decor.look
			entry.decor.light.Brightness=if look.spark then look.light*(.4+math.random()*1.2) else look.light*(.85+math.sin(os.clock()*18)*.15)
		end
		local travel=if (p.speed or 0)&lt;=0 then 0 else math.clamp(age,0,p.range/p.speed)*p.speed
		local position=p.origin+p.direction*travel
		if entry.release and age&lt;.1 then
			local u=math.clamp((age+1/30)/(.1+1/30),0,1)
			position=entry.release:Lerp(position,u*u*(3-2*u))
		end
		local look=CFrame.lookAt(position,position+p.direction)
		local cf
		if entry.decor and entry.decor.ring then
			entry.decor.ring.CFrame=look*CFrame.Angles(0,0,os.clock()*20)*CFrame.Angles(0,math.pi/2,0)
		end
		if p.kind=="kunai" or p.kind=="marked" then
			-- Point first, with a slow roll so the blade catches the light.
			entry.spin+=dt*14
			cf=look*CFrame.Angles(0,0,entry.spin)
		elseif p.kind=="shuriken" or p.kind=="wire" then
			entry.spin+=dt*42
			cf=look*CFrame.Angles(0,entry.spin,0)*CFrame.Angles(0,0,math.rad(8))
		elseif p.kind=="fireball" or p.kind=="phoenix" then
			local radius=(p.radius or 2.4)+(p.growth or 0)*math.max(0,age)
			local wobble=1+math.sin(os.clock()*31)*.05
			entry.root.Size=Vector3.one*radius*1.15*wobble
			local mid=entry.model:FindFirstChild("Mid");local outer=entry.model:FindFirstChild("Outer")
			if mid then mid.Size=Vector3.one*radius*1.7 end
			if outer then outer.Size=Vector3.one*radius*2.25*wobble end
			local flames=entry.root:FindFirstChildOfClass("Attachment")
			if flames then
				local f=flames:FindFirstChild("Flames");if f then f.Size=num({{0,radius*1.1},{.4,radius*1.9},{1,radius*.6}}) end
				Kit.setSize(FX.fireStreams[entry.model],num({{0,radius*1.3},{.5,radius*2.3},{1,radius*2}}))
			end
			cf=look*CFrame.Angles(0,0,os.clock()*(FX.fireRoll[entry.model] or 3))
		elseif p.kind=="palm" then
			local radius=(p.radius or 1.5)+(p.growth or 0)*math.max(0,age)
			local ring=entry.model:FindFirstChild("Ring");local core=entry.model:FindFirstChild("Core")
			if ring then ring.Size=Vector3.new(.3,radius*2.2,radius*2.2) end
			if core then core.Size=Vector3.new(.2,radius*1.2,radius*1.2) end
			cf=look
		elseif FX.poses[p.kind] then
			cf=FX.poses[p.kind](self,entry,p,age,look,dt)
		else
			cf=look
		end
		entry.root.CFrame=cf
	end
end

-- ------------------------------------------------------------------ helpers
local function flash(parent,position,color,from,to,time,transparency,keepBall)
	if not keepBall and Kit.has("star") then
		-- (Reference quality) a flat cel flash (our star) and a short hot core,
		-- instead of a growing translucent bubble.
		Kit.star(parent,position,to*.95,color,math.max(.07,time*.8))
		local core=block(parent,Vector3.one*from*.6,CFrame.new(position),color,Enum.Material.Neon)
		core.Shape=Enum.PartType.Ball;core.Transparency=transparency or .15
		tween(core,time*.45,{Size=Vector3.one*from*1.1,Transparency=1})
		Debris:AddItem(core,time*.45+.05)
		return core
	end
	local ball=block(parent,Vector3.one*from,CFrame.new(position),color,Enum.Material.Neon)
	ball.Shape=Enum.PartType.Ball;ball.Transparency=transparency or .15
	tween(ball,time,{Size=Vector3.one*to,Transparency=1})
	Debris:AddItem(ball,time+.05)
	return ball
end
-- The floor under a point, ignoring bodies and effects: marks laid on the
-- ground (scorch, trigrams, burning lanes) must never land on a fighter.
local function floorUnder(fx,position,up,depth)
	local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
	local exclude={fx.folder}
	if fx.fighters then table.insert(exclude,fx.fighters) end
	params.FilterDescendantsInstances=exclude
	return workspace:Raycast(position+Vector3.new(0,up,0),Vector3.new(0,-depth,0),params)
end
local function shockRing(parent,position,color,from,to,time,normal)
	local up=normal or Vector3.yAxis
	if Kit.has("ring") and up.Magnitude&gt;.01 then
		-- (Reference quality) a soft-edged pressure ring (our texture).
		up=up.Unit
		local side=if math.abs(up.Y)&gt;.95 then Vector3.xAxis else Vector3.yAxis
		Kit.plane(parent,CFrame.lookAt(position,position+up,side),"ring",Vector2.new(from,from),Vector2.new(to,to),time,color,0)
		return
	end
	local cf=CFrame.lookAt(position,position+up)*CFrame.Angles(0,math.pi/2,0)
	local ring=block(parent,Vector3.new(.12,from,from),cf,color,Enum.Material.Neon)
	ring.Shape=Enum.PartType.Cylinder;ring.Transparency=.3
	tween(ring,time,{Size=Vector3.new(.04,to,to),Transparency=1})
	Debris:AddItem(ring,time+.05)
end
local function burst(parent,position,props,count)
	local holder=anchorPart(parent,position);holder.Transparency=1
	local at=new("Attachment",{},holder)
	local e=emitter(at,props)
	e:Emit(math.max(1,math.floor((count or 1)*Kit.amount+.5)))
	Debris:AddItem(holder,3)
	return holder
end
local function smokePuff(parent,position,color,count,size)
	if Kit.has("smoke") then
		-- (Reference quality) cel puffs: fewer, rounder, they swell and break up.
		size=size or 2.2
		Kit.burst(parent,position,"smoke",math.max(3,math.floor((count or 18)*.5)),{
			Lifetime=NumberRange.new(.45,.8),Speed=NumberRange.new(5,11),SpreadAngle=Vector2.new(180,180),
			Color=ColorSequence.new(color or Color3.fromRGB(236,236,240)),
			Size=num({{0,size*.9},{.4,size*1.8},{1,size*2.2}}),Transparency=num({{0,0},{.7,.1},{1,1}}),
			Drag=6,Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-40,40)})
		return
	end
	burst(parent,position,{Texture=TEX.smoke,Lifetime=NumberRange.new(.5,.9),Speed=NumberRange.new(4,9),SpreadAngle=Vector2.new(180,180),
		Color=ColorSequence.new(color or Color3.fromRGB(236,236,240)),LightEmission=0,Size=num({{0,size or 2.2},{1,(size or 2.2)*2.6}}),
		Transparency=num({{0,.15},{1,1}}),Drag=6,RotSpeed=NumberRange.new(-60,60),Rotation=NumberRange.new(0,360)},count or 18)
end
local function sparks(parent,position,color,count,speed)
	if Kit.has("streak") then
		Kit.streaks(parent,position,Vector3.yAxis,math.max(3,math.floor((count or 14)*.6)),color,(speed or 18)*1.6,180)
		return
	end
	burst(parent,position,{Texture=TEX.spark,Lifetime=NumberRange.new(.15,.35),Speed=NumberRange.new(speed or 18,(speed or 18)*1.8),SpreadAngle=Vector2.new(180,180),
		Color=ColorSequence.new(color),LightEmission=1,Size=num({{0,.45},{1,0}}),Drag=5},count or 14)
end
-- A translucent copy of a fighter's current pose: afterimages for teleports,
-- dodges and substitutions.
-- (Jutsu pass 05/11, the Itachi vs Kakashi film: « la lecture du Sharingan
-- fait une silhouette rouge pleine ») The copy was flat Neon at 35-60 %
-- transparency: a solid coloured mannequin. Now it is a chakra shell: the
-- body parts in ForceField (bright at the edges, see-through in the middle,
-- so the silhouette reads as an image, not a body), over a faint Neon fill
-- that fades first; the shell swells a little as it goes.
FX.GHOST_FILL=.82
function FX:ghost(model,color,time,transparency)
	if not model then return end
	local holder=new("Model",{Name="Afterimage"},self.folder)
	local edge=math.clamp((transparency or .45)-.05,.3,.7)
	for _,d in model:GetChildren() do
		if d:IsA("BasePart") and d.Name~="HumanoidRootPart" and d.Transparency&lt;.9 then
			local class=if d:IsA("WedgePart") then "WedgePart" else "Part"
			local g=block(holder,d.Size,d.CFrame,color,Enum.Material.ForceField,class)
			if d:IsA("Part") then g.Shape=d.Shape end
			g.Transparency=edge
			tween(g,time,{Transparency=1,Size=d.Size*1.1})
			-- the faint fill only on the body's big volumes (fewer parts to draw)
			if d.Size.X*d.Size.Y*d.Size.Z&gt;.3 then
				local fill=block(holder,d.Size*.96,d.CFrame,color,Enum.Material.Neon,class)
				if d:IsA("Part") then fill.Shape=d.Shape end
				fill.Transparency=FX.GHOST_FILL
				tween(fill,time*.6,{Transparency=1})
			end
		end
	end
	Debris:AddItem(holder,time+.1)
	return holder
end
local function crows(parent,position,count,spread)
	for i=1,count do
		local bird=new("Model",{Name="Crow"},parent)
		local body=block(bird,Vector3.new(.35,.3,.8),CFrame.new(position),Color3.fromRGB(14,14,18),Enum.Material.SmoothPlastic)
		local wingL=block(bird,Vector3.new(.9,.05,.4),CFrame.new(position),Color3.fromRGB(10,10,14),Enum.Material.SmoothPlastic,"WedgePart")
		local wingR=block(bird,Vector3.new(.9,.05,.4),CFrame.new(position),Color3.fromRGB(10,10,14),Enum.Material.SmoothPlastic,"WedgePart")
		local direction=Vector3.new(math.random()-.5,.35+math.random()*.6,math.random()-.5).Unit
		local distance=(spread or 9)*(0.6+math.random()*.7)
		local start=position+Vector3.new((math.random()-.5)*1.5,(math.random()-.5)*2,(math.random()-.5)*1.5)
		local finish=start+direction*distance
		local life=.55+math.random()*.35
		local t0=os.clock()
		task.spawn(function()
			while bird.Parent and os.clock()-t0&lt;life do
				local k=(os.clock()-t0)/life
				local at=start:Lerp(finish,1-(1-k)^2)
				local cf=CFrame.lookAt(at,at+direction)
				local flap=math.sin(os.clock()*34+i)*.9
				body.CFrame=cf
				wingL.CFrame=cf*CFrame.new(-.45,0,0)*CFrame.Angles(0,0,flap)
				wingR.CFrame=cf*CFrame.new(.45,0,0)*CFrame.Angles(0,0,-flap)
				local fade=math.clamp((k-.6)/.4,0,1)
				body.Transparency=fade;wingL.Transparency=fade;wingR.Transparency=fade
				task.wait()
			end
			bird:Destroy()
		end)
	end
	smokePuff(parent,position,Color3.fromRGB(40,36,44),10,1.6)
end
FX.crows=crows

-- ----------------------------------------------------------------- identity
-- Restrained per-fighter feedback for the identity rules (all server-driven):
-- Itachi's read (eye glint, the afterimage the swing bites) and genjutsu image,
-- Neji's closed chakra points, Minato's wind seal and Yellow Flash, Sasuke's
-- curse. Nothing here can change gameplay.
-- Where each chakra point Neji can close sits on the body (bone, offset from
-- its centre; -Z is the front). Ids: Brawler.TENKETSU_ORDER on the server.
local TENKETSU={
	throat={"Head",CFrame.new(0,-.5,-.42)},heart={"UpperTorso",CFrame.new(-.32,.22,-.52)},solar={"UpperTorso",CFrame.new(0,-.3,-.52)},
	navel={"LowerTorso",CFrame.new(0,.08,-.52)},leftShoulder={"LeftUpperArm",CFrame.new(0,.3,-.3)},rightShoulder={"RightUpperArm",CFrame.new(0,.3,-.3)},
	leftHip={"LowerTorso",CFrame.new(-.52,-.12,-.46)},rightHip={"LowerTorso",CFrame.new(.52,-.12,-.46)},
}
FX.TENKETSU=TENKETSU
local function find(folder,id) return folder and id and folder:FindFirstChild(id) end
function FX.tenketsuWorld(model,id)
	local spec=TENKETSU[id or ""]
	local part=spec and model and model:FindFirstChild(spec[1])
	if not part then return nil,nil end
	return (part.CFrame*spec[2]).Position,part
end
-- Two red points and a thin glint across the eyes: the Sharingan reading.
local function eyeGlint(parent,model)
	local head=model and model:FindFirstChild("Head")
	if not head then return end
	for _,x in {-.22,.22} do flash(parent,(head.CFrame*CFrame.new(x,.1,-.62)).Position,SHARINGAN,.12,.55,.22,0) end
	local streak=block(parent,Vector3.new(1,.05,.05),head.CFrame*CFrame.new(0,.1,-.64),SHARINGAN,Enum.Material.Neon)
	streak.Transparency=.1
	tween(streak,.26,{Size=Vector3.new(2.4,.02,.02),Transparency=1})
	Debris:AddItem(streak,.3)
	local light=new("PointLight",{Color=SHARINGAN,Brightness=4,Range=8,Shadows=false},head)
	tween(light,.3,{Brightness=0})
	Debris:AddItem(light,.35)
end
FX.eyeGlint=eyeGlint
-- Sharingan Read / Focus read: the eyes, the afterimage where he stood that
-- the swing bites, a dry cut. A whiff read is the eyes and a ring only.
function FX:readCue(impact,folder)
	local reader=find(folder,impact.owner)
	eyeGlint(self.folder,reader)
	local at=impact.position
	if impact.phase=="whiff" then
		local victim=find(folder,impact.victim)
		local root=victim and victim:FindFirstChild("HumanoidRootPart")
		if root then shockRing(self.folder,root.Position-Vector3.new(0,2.6,0),SHARINGAN,1,5,.25) end
		sound(anchorPart(self.folder,at),SOUND.whoosh,.22,2.6)
		return
	end
	if reader then
		local ghost=self:ghost(reader,SHARINGAN,.34,.35)
		local root=reader:FindFirstChild("HumanoidRootPart")
		if ghost and root then
			-- The body may already be drawn at its new spot: leave the copy where he stood.
			local shift=at-root.Position
			ghost:PivotTo(ghost:GetPivot()+Vector3.new(shift.X,0,shift.Z))
		end
	end
	flash(self.folder,at+Vector3.new(0,.5,0),Color3.fromRGB(255,240,236),.3,2.8,.14,.2)
	sparks(self.folder,at+Vector3.new(0,.5,0),Color3.fromRGB(255,220,220),8,16)
	sound(anchorPart(self.folder,at),SOUND.whoosh,.34,2.3)
	sound(anchorPart(self.folder,at),SOUND.hit,.18,.6)
	self:cheer(.6)
end
-- Genjutsu: Mirage. cast = a red ripple under the deceived body as the image
-- takes; catch = the image breaks where the swing bit it; touch/break = it
-- dissolves; seen = the Byakugan shrugs it off. A skill-build echo: red smoke.
function FX:mirageCue(impact,folder)
	local at=impact.position
	local caster=find(folder,impact.owner)
	local phase=impact.phase
	if phase=="cast" then
		local victim=find(folder,impact.victim)
		local root=victim and victim:FindFirstChild("HumanoidRootPart")
		if root then shockRing(self.folder,root.Position-Vector3.new(0,2.6,0),SHARINGAN,2,9,.45) end
		flash(self.folder,at,Color3.fromRGB(150,24,34),1,4,.3,.55)
		eyeGlint(self.folder,caster)
		sound(anchorPart(self.folder,at),SOUND.whoosh,.3,.55)
	elseif phase=="catch" then
		for _=1,12 do
			local dir=Vector3.new(math.random()-.5,math.random()*.8,math.random()-.5)
			dir=if dir.Magnitude&gt;.01 then dir.Unit else Vector3.yAxis
			local shard=block(self.folder,Vector3.new(.3,.5,.06),CFrame.lookAt(at,at+dir)*CFrame.new(0,(math.random()-.5)*3,0),SHARINGAN,Enum.Material.Neon)
			shard.Transparency=.25
			tween(shard,.4,{CFrame=shard.CFrame+dir*(2+math.random()*3),Transparency=1,Size=Vector3.new(.05,.2,.02)})
			Debris:AddItem(shard,.45)
		end
		flash(self.folder,at,SHARINGAN,1,6,.22,.15)
		smokePuff(self.folder,at,Color3.fromRGB(60,24,30),12,1.6)
		eyeGlint(self.folder,caster)
		sound(anchorPart(self.folder,at),SOUND.hit,.4,.7)
		self:cheer(.8)
	elseif phase=="seen" then
		-- (07/11) the image forms and shatters before the white eye
		local victim=find(folder,impact.victim)
		local head=victim and victim:FindFirstChild("Head")
		if head then flash(self.folder,head.Position,HYUGA,.6,3.4,.25,.2) end
		for _=1,10 do
			local dir=Vector3.new(math.random()-.5,math.random()*.8,math.random()-.5)
			dir=if dir.Magnitude&gt;.01 then dir.Unit else Vector3.yAxis
			local shard=block(self.folder,Vector3.new(.3,.5,.06),CFrame.lookAt(at,at+dir)*CFrame.new(0,(math.random()-.5)*3,0),SHARINGAN,Enum.Material.Neon)
			shard.Transparency=.35
			tween(shard,.45,{CFrame=shard.CFrame+dir*(2+math.random()*3),Transparency=1,Size=Vector3.new(.05,.2,.02)})
			Debris:AddItem(shard,.5)
		end
		smokePuff(self.folder,at,Color3.fromRGB(60,24,30),8,1.3)
		sound(anchorPart(self.folder,at),SOUND.whoosh,.3,.7)
	elseif phase=="touch" or phase=="break" then
		smokePuff(self.folder,at,Color3.fromRGB(70,40,46),6,1.2)
	else
		smokePuff(self.folder,at+Vector3.new(0,1,0),Color3.fromRGB(60,24,30),10,1.6)
		if impact.to then smokePuff(self.folder,impact.to+Vector3.new(0,1,0),Color3.fromRGB(60,24,30),6,1.2) end
	end
end
-- Gentle Fist: a pinpoint flash on the exact point that closed, a short chakra
-- pulse and a dry tick; a sealed network (every point) rings once, deeper.
function FX:tenketsuCue(impact,folder)
	local victim=find(folder,impact.victim)
	local at,part=FX.tenketsuWorld(victim,impact.point)
	at=at or impact.position
	local severe=impact.severe==true
	flash(self.folder,at,HYUGA,.12,if severe then 1.6 else 1.05,.14,0)
	shockRing(self.folder,at,HYUGA,.3,if severe then 4.6 else 3,.22,part and part.CFrame.LookVector or nil)
	sparks(self.folder,at,HYUGA,if severe then 10 else 5,8)
	sound(anchorPart(self.folder,at),SOUND.hit,.26,1.95)
	if severe then
		sound(anchorPart(self.folder,at),SOUND.heavy,.32,.6)
		local torso=victim and victim:FindFirstChild("UpperTorso")
		if torso then shockRing(self.folder,torso.Position,HYUGA,1,7,.4) end
	end
end
-- Wind Cut: a pale crescent where the cut throws the body aside; the wind seal
-- then rides on it (FX:seal draws it in the wind's colour).
function FX:windSealCue(impact)
	local at=impact.position
	local across=impact.direction or Vector3.xAxis
	local slash=block(self.folder,Vector3.new(.1,3.2,.25),CFrame.lookAt(at,at+across)*CFrame.Angles(0,0,math.rad(35)),WIND,Enum.Material.Neon)
	slash.Transparency=.2
	tween(slash,.22,{Size=Vector3.new(.04,4.2,.08),Transparency=1})
	Debris:AddItem(slash,.25)
	flash(self.folder,at,MINATO,.3,2,.16,.3)
	sound(anchorPart(self.folder,at),SOUND.whoosh,.34,1.9)
end
-- Curse Mark: the kick that does not let go flares purple on the body.
function FX:curseCue(impact)
	local at=impact.position
	flash(self.folder,at,CURSE,.4,3.2,.2,.2)
	sparks(self.folder,at,Color3.fromRGB(170,120,255),10,18)
	sound(anchorPart(self.folder,at),SOUND.heavy,.28,1.4)
end
-- The genjutsu image (Presentation:illusion): a frozen copy of `source` in its
-- current pose. "deceived": exactly the fighter, with a faint red outline that
-- pulses now and then (the tell); "caster": a red translucent afterimage, so
-- Itachi's player sees the trap he left. Its pivot is the copied root.
function FX:image(source,mode)
	if not source then return nil end
	local archivable=source.Archivable
	source.Archivable=true
	local ok,copy=pcall(function() return source:Clone() end)
	source.Archivable=archivable
	if not ok or not copy then return nil end
	copy.Name="GenjutsuImage"
	for _,d in copy:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored=true;d.CanCollide=false;d.CanQuery=false;d.CanTouch=false;d.CastShadow=false
			d.LocalTransparencyModifier=0
			if mode=="caster" and d.Transparency&lt;.95 then d.Color=SHARINGAN;d.Material=Enum.Material.SmoothPlastic;d.Transparency=math.max(d.Transparency,.62) end
		elseif d:IsA("Humanoid") or d:IsA("Sound") or d:IsA("Trail") or d:IsA("ParticleEmitter") or d:IsA("Light") or d:IsA("Beam") or d:IsA("BaseScript") or d:IsA("Highlight") then
			d:Destroy()
		end
	end
	if mode=="deceived" then
		new("Highlight",{Name="Tell",FillTransparency=1,OutlineColor=SHARINGAN,OutlineTransparency=1,DepthMode=Enum.HighlightDepthMode.Occluded},copy)
	end
	copy.Parent=self.folder
	return copy
end
-- Persistent identity cues, every frame (FX:fighter): Neji's closed points stay
-- lit on the body that carries them (pulsing fast once the network is sealed,
-- chakra leaking), Byakugan Full Field lays its field, a hungry Curse Mark
-- flickers.
function FX:identity(model,actor,aura)
	local root=model:FindFirstChild("HumanoidRootPart")
	local alive=(actor.health or 1)&gt;0
	local severe=actor.tenketsuSevere==true and alive
	aura.points=aura.points or {}
	local live={}
	for _,id in (if alive then actor.tenketsuPoints else nil) or {} do
		live[id]=true
		local entry=aura.points[id]
		if not entry or not entry.dot.Parent then
			local dot=block(self.folder,Vector3.one*.18,CFrame.new(),HYUGA,Enum.Material.Neon);dot.Shape=Enum.PartType.Ball
			entry={dot=dot,born=os.clock()};aura.points[id]=entry
		end
		local at=FX.tenketsuWorld(model,id)
		if at then entry.dot.CFrame=CFrame.new(at) end
		local pulse=.5+.5*math.sin((os.clock()-entry.born)*(if severe then 14 else 5))
		entry.dot.Transparency=(if severe then .05 else .3)+pulse*.35
		entry.dot.Size=Vector3.one*(if severe then .26 else .18)
	end
	for id,entry in aura.points do if not live[id] then entry.dot:Destroy();aura.points[id]=nil end end
	local torso=model:FindFirstChild("UpperTorso") or root
	if severe and not aura.leak and torso then
		local at=new("Attachment",{Name="ChakraLeak"},torso)
		aura.leak=new("ParticleEmitter",{Texture=TEX.glow,Rate=10,Lifetime=NumberRange.new(.4,.7),Speed=NumberRange.new(1,2.5),SpreadAngle=Vector2.new(180,180),
			Color=ColorSequence.new(HYUGA),LightEmission=.6,LightInfluence=0,Size=num({{0,.35},{1,0}}),Transparency=num({{0,.4},{1,1}})},at)
	elseif not severe and aura.leak then
		aura.leak.Enabled=false;Debris:AddItem(aura.leak.Parent,.8);aura.leak=nil
	end
	if actor.fighterId=="GentleFist" and root then
		local full=(actor.awaken or 0)&gt;0 and alive
		if full and (not aura.field or not aura.field.Parent) then
			local ring=block(self.folder,Vector3.new(.06,16,16),root.CFrame,HYUGA,Enum.Material.Neon);ring.Shape=Enum.PartType.Cylinder;ring.Transparency=.9
			aura.field=ring
		elseif not full and aura.field then
			tween(aura.field,.3,{Transparency=1});Debris:AddItem(aura.field,.35);aura.field=nil
		end
		if aura.field then aura.field.CFrame=CFrame.new(root.Position-Vector3.new(0,2.9,0))*CFrame.Angles(0,0,math.pi/2) end
	end
	if actor.fighterId=="Lion" and (actor.awaken or 0)&gt;0 and actor.curseHunger and alive then
		local on=math.sin(os.clock()*18)&gt;0
		for _,mark in aura.marks or {} do mark.Transparency=if on then .5 else 0 end
	end
end

-- ------------------------------------------------------------------ contacts
local function modelFor(folder,id)
	return folder and folder:FindFirstChild(id or "")
end
function FX:impact(impact,folder)
	local style=impact.style
	local position=impact.position
	if not position then return end
	if impact.other then self:finishProjectile(impact.other) end
	if impact.projectile then
		local entry=self.projectiles[impact.projectile]
		local direction=impact.direction or (entry and entry.data.direction) or Vector3.zAxis
		if entry then self:finishProjectile(impact.projectile) end
		if style=="stick" and not impact.chakra and (impact.kind=="kunai" or impact.kind=="marked" or impact.kind=="shuriken") then
			self:stick(impact.kind,position,impact.normal or Vector3.yAxis,direction,impact.owner)
		end
	end
	if CHEER[style] then self:cheer(CHEER[style]) end
	-- (Reference quality) the struck body flashes: red on a blow, gold on a
	-- guard, longer and stronger the harder it was.
	-- (FEEL 05/11) brighter and a beat longer: a light blow read as nothing.
	-- Not twice for a blow the client already flashed when it guessed it.
	if impact.victim and impact.amount and not impact.tinted then
		local weight=math.clamp(impact.amount/20,.25,1)
		pcall(Kit.tint,modelFor(folder,impact.victim),if impact.guarded then Color3.fromRGB(255,214,120) else Color3.fromRGB(255,244,236),
			.09+.08*weight,if impact.guarded then .35 else .5+.35*weight)
	end
	for _,layer in FX.layers do if layer.impact and layer.impact(self,impact,folder) then return end end
	if style=="fire" then
		self:explosion(position,impact.normal,1+.7*(impact.charge or 0))
	elseif style=="teleport" then
		self:teleport(impact.from or position,impact.to or position,modelFor(folder,impact.owner),impact.awake)
	elseif style=="substitute" then
		self:substitute(position,impact.to,impact.fighter,modelFor(folder,impact.owner))
	elseif style=="mirage" then
		self:mirageCue(impact,folder)
	elseif style=="read" then
		self:readCue(impact,folder)
	elseif style=="tenketsu" then
		self:tenketsuCue(impact,folder)
	elseif style=="windseal" then
		self:windSealCue(impact)
	elseif style=="curse" then
		self:curseCue(impact)
	elseif style=="chase" then
		local model=modelFor(folder,impact.owner)
		-- Each prodigy's re-entry reads differently (server: MoveGraphs reengage):
		-- Minato a clean flash, Itachi a lingering copy, Neji a small chakra
		-- pulse, Sasuke an explosive kick-off. Unknown variants keep the plain look.
		local variant=impact.variant
		local tone=if impact.fighter=="Flashstep" then MINATO elseif impact.fighter=="GentleFist" then HYUGA elseif impact.fighter=="Lion" then LION else Color3.fromRGB(150,40,60)
		self:ghost(model,tone,if variant=="mirage" then .45 else .22,if variant=="mirage" then .4 else .55)
		if variant=="flash" then flash(self.folder,position,MINATO,1,4,.14,.3)
		elseif variant=="palm" then flash(self.folder,position,HYUGA,.5,3,.12,.25)
		elseif variant=="lion" then sparks(self.folder,position-Vector3.new(0,2.4,0),LION,10,18) end
		smokePuff(self.folder,position-Vector3.new(0,2.6,0),Color3.fromRGB(200,190,170),if variant=="lion" then 14 elseif variant=="flash" then 4 else 8,if variant=="lion" then 1.9 else 1.4)
		sound(anchorPart(self.folder,position),SOUND.whoosh,.35,if variant=="flash" then 1.15 elseif variant=="lion" then .7 else .8)
	elseif style=="dodge" then
		local nearest
		for _,name in self.fighterIds or {"PlayerFighter","AIFighter"} do
			local m=modelFor(folder,name);local r=m and m:FindFirstChild("HumanoidRootPart")
			if r and (r.Position-position).Magnitude&lt;4 then nearest=m end
		end
		if nearest then self:ghost(nearest,Color3.fromRGB(200,220,255),.2,.6) end
		smokePuff(self.folder,position-Vector3.new(0,2.6,0),Color3.fromRGB(196,186,166),6,1.2)
	elseif style=="quickstep" then
		local model=modelFor(folder,impact.owner)
		flash(self.folder,position,MINATO,1,4,.16,.3)
		if model then self:ghost(model,MINATO,.2,.5) end
	elseif style=="cast" then
		local model=modelFor(folder,impact.owner)
		local hands=model and model:FindFirstChild("RightHand")
		if hands then
			local color=if impact.technique=="FireBloom" or impact.technique=="PhoenixFlower" then Color3.fromRGB(255,120,50) elseif impact.technique=="MirageCast" or impact.technique=="Read" then Color3.fromRGB(220,30,40)
				elseif impact.technique=="WindCut" then Color3.fromRGB(170,255,220) else Color3.fromRGB(140,200,255)
			sparks(self.folder,hands.Position,color,10,8)
		end
	elseif style=="landing" then
		smokePuff(self.folder,position-Vector3.new(0,2.7,0),Color3.fromRGB(190,178,150),6,1.1)
		sound(anchorPart(self.folder,position),SOUND.land,.35,1.05)
	elseif style=="slam" then
		smokePuff(self.folder,position-Vector3.new(0,2.4,0),Color3.fromRGB(176,160,130),22,2.6)
		-- (06/11) no black crack decal: the server breaks the floor there now
		-- (WorldReaction, a crater), and both read as the same print every time
		shockRing(self.folder,position-Vector3.new(0,2.6,0),Color3.fromRGB(255,214,160),3,22,.32)
	elseif style=="launcher" or style=="finisher" then
		shockRing(self.folder,position,Color3.fromRGB(255,236,200),2,9,.2,impact.direction)
	elseif style=="kunai" or style=="shuriken" then
		sparks(self.folder,position,Color3.fromRGB(255,236,200),10,20)
	elseif style=="parry" then
		sparks(self.folder,position,Color3.fromRGB(255,246,180),22,26)
		flash(self.folder,position,Color3.fromRGB(255,250,220),1,6,.14,.2)
	elseif style=="burst" then
		-- (Jutsu pass 06/11, Studio: « les corps deviennent blancs » at the
		-- Rasengan) A chakra copy laid over a body that does not move covers
		-- it: Minato and Naruto turned white for a quarter second. The release
		-- is now a ring of chakra round him and sparks at the hand.
		local model=modelFor(folder,impact.owner)
		local hand=model and model:FindFirstChild("RightHand")
		shockRing(self.folder,position-Vector3.new(0,2.5,0),Color3.fromRGB(120,190,255),2,10,.3)
		if hand then sparks(self.folder,hand.Position,Color3.fromRGB(170,215,255),10,14) end
	elseif style=="clash" then
		-- Two strikes meeting: a hard white-gold flash and a ring across the line
		-- between the fighters, nothing else. It has to read instantly.
		local across=impact.direction or Vector3.zAxis
		sparks(self.folder,position,Color3.fromRGB(255,244,200),28,34)
		flash(self.folder,position,Color3.fromRGB(255,252,232),1,7,.16,.1)
		shockRing(self.folder,position,Color3.fromRGB(255,232,170),2,14,.26,across)
		sound(anchorPart(self.folder,position),SOUND.whoosh,.5,2.2)
	elseif style=="wall" or style=="wallbounce" then
		-- Impact on the wall: a ring flat on the surface, dust pushed out of it and
		-- a few chips of stone.
		local normal=impact.normal or Vector3.zAxis
		local big=style=="wallbounce"
		shockRing(self.folder,position+normal*.15,Color3.fromRGB(236,226,200),2,if big then 16 else 11,if big then .34 else .26,normal)
		smokePuff(self.folder,position+normal*.8,Color3.fromRGB(196,188,168),if big then 22 else 14,if big then 2.6 else 2)
		for k=1,(if big then 7 else 4) do
			local chip=block(self.folder,Vector3.new(.4,.3,.35),CFrame.new(position+normal*.5)*CFrame.Angles(math.random()*6,math.random()*6,0),Color3.fromRGB(186,178,160),Enum.Material.Concrete)
			local out=(normal+Vector3.new((math.random()-.5)*1.4,math.random()*.9,(math.random()-.5)*1.4)).Unit
			tween(chip,.45,{CFrame=chip.CFrame+out*(2.5+math.random()*3)+Vector3.new(0,-1.5,0),Transparency=1},Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
			Debris:AddItem(chip,.5)
		end
		if big then sparks(self.folder,position+normal,Color3.fromRGB(255,226,170),14,22) end
		-- (Reference quality) the surface cracks where the body met it.
		-- (06/11, user: « des fois pas au sol ») only on a surface there to
		-- hold it, at most its own size: a crack the size of a door on a thin
		-- trunk, or on the arena's invisible edge, hung in the air.
		local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances={self.folder,workspace:FindFirstChild("NinjaDuels")}
		local hit=workspace:Raycast(position+normal*1.5,-normal*3,params)
		local surface=hit and hit.Instance
		if surface and surface:IsA("BasePart") and surface.Transparency&lt;.9 then
			local dims={surface.Size.X,surface.Size.Y,surface.Size.Z};table.sort(dims)
			local size=math.min(if big then 9 else 6,dims[2]*.85)
			if size&gt;=2 then Kit.ground(self.folder,hit.Position,hit.Normal,"crack",size,2.2,1.2,Color3.new(1,1,1),.1) end
		end
	elseif style=="worldbreak" then
		-- (EMB-004) A tree going down or a boulder bursting: the server already
		-- changed the arena; this is the dust and the pieces flying off it.
		local wood=impact.material=="wood"
		local tone=if wood then Color3.fromRGB(120,88,58) else Color3.fromRGB(150,144,132)
		local out=impact.direction or Vector3.xAxis
		smokePuff(self.folder,position,if wood then Color3.fromRGB(176,156,124) else Color3.fromRGB(190,184,170),20,2.8)
		shockRing(self.folder,position,Color3.fromRGB(236,226,200),2,14,.3,-out)
		for k=1,8 do
			local piece=block(self.folder,if wood then Vector3.new(.25,.25,1.3) else Vector3.new(.6,.45,.5),CFrame.new(position)*CFrame.Angles(math.random()*6,math.random()*6,0),tone,if wood then Enum.Material.Wood else Enum.Material.Slate)
			local fly=(out+Vector3.new((math.random()-.5)*1.6,math.random()*1.2,(math.random()-.5)*1.6)).Unit
			tween(piece,.6,{CFrame=piece.CFrame+fly*(4+math.random()*5)+Vector3.new(0,-2,0),Transparency=1},Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
			Debris:AddItem(piece,.65)
		end
		sound(anchorPart(self.folder,position),SOUND.whoosh,.6,.6)
	elseif style=="walltech" then
		local model=modelFor(folder,impact.owner)
		if model then self:ghost(model,Color3.fromRGB(220,230,255),.2,.55) end
		local normal=impact.normal or Vector3.zAxis
		smokePuff(self.folder,position,Color3.fromRGB(226,222,210),12,1.8)
		shockRing(self.folder,position,Color3.fromRGB(220,232,255),1.5,8,.22,normal)
		sound(anchorPart(self.folder,position),SOUND.whoosh,.4,1.3)
	elseif style=="pin" then
		sparks(self.folder,position,Color3.fromRGB(255,236,200),8,16)
	elseif style=="flow" then
		-- On the beat: a crisp white-blue ring at the contact, nothing heavy.
		local count=impact.count or 1
		flash(self.folder,position,Color3.fromRGB(220,236,255),.6,3+math.min(count,4),.12,.15)
		shockRing(self.folder,position,Color3.fromRGB(200,226,255),1,6+math.min(count,4)*1.5,.18)
	elseif style=="awaken" then
		local model=modelFor(folder,impact.owner)
		local tone=if impact.fighter=="Flashstep" then MINATO elseif impact.fighter=="GentleFist" then HYUGA elseif impact.fighter=="Lion" then CURSE else Color3.fromRGB(230,40,50)
		if model then self:ghost(model,tone,.35,.4) end
		flash(self.folder,position,tone,2,14,.35,.2)
		shockRing(self.folder,position-Vector3.new(0,2.6,0),tone,3,24,.45)
		smokePuff(self.folder,position-Vector3.new(0,2.4,0),Color3.fromRGB(214,206,190),20,2.6)
		self:cheer(1)
	elseif style=="palmburst" then
		local along=impact.direction or Vector3.zAxis
		shockRing(self.folder,position,Color3.fromRGB(220,232,255),2,12,.24,along)
		smokePuff(self.folder,position,Color3.fromRGB(226,230,240),10,1.8)
	elseif style=="palm" then
		-- A Gentle Fist palm: a small, sharp chakra flash; no debris.
		flash(self.folder,position,HYUGA,.5,impact.heavy and 6 or 3,.12,.25)
		sparks(self.folder,position,HYUGA,impact.heavy and 16 or 6,impact.heavy and 22 or 12)
	elseif style=="deflect" then
		sparks(self.folder,position,Color3.fromRGB(230,240,255),12,24)
	elseif style=="repel" then
		shockRing(self.folder,position,HYUGA,3,16,.3,impact.direction)
		smokePuff(self.folder,position-Vector3.new(0,2.4,0),Color3.fromRGB(214,206,190),14,2)
	elseif style=="rotation" then
		shockRing(self.folder,position-Vector3.new(0,2.6,0),HYUGA,4,18,.5)
		smokePuff(self.folder,position-Vector3.new(0,2.6,0),Color3.fromRGB(214,206,190),18,2.4)
	elseif style=="trigram" then
		self:trigram(position)
	elseif style=="ember" then
		if Kit.has("fire") then self:explosion(position,impact.normal,.32) end
		flash(self.folder,position,Color3.fromRGB(255,170,80),.8,4.5,.18,.2)
		sparks(self.folder,position,Color3.fromRGB(255,170,80),10,14)
	elseif style=="afterimage" then
		-- A lateral route: the body leaves a fading copy where it stood.
		local model=modelFor(folder,impact.owner)
		if model then self:ghost(model,if impact.fighter=="GentleFist" then HYUGA elseif impact.fighter=="Lion" then LION else Color3.fromRGB(150,40,60),.3,.45) end
		smokePuff(self.folder,position-Vector3.new(0,2.6,0),Color3.fromRGB(196,186,166),5,1)
	elseif style=="chidori" then
		flash(self.folder,position,Color3.fromRGB(170,200,255),1,6,.18,.25)
		sparks(self.folder,position,Color3.fromRGB(200,225,255),24,30)
	elseif style=="groundbounce" then
		-- A spiked body hits the floor and pops back up: dust ring and cracks.
		smokePuff(self.folder,position,Color3.fromRGB(176,160,130),16,2.2)
		shockRing(self.folder,position+Vector3.new(0,.1,0),Color3.fromRGB(255,226,180),2,13,.26)
		sound(anchorPart(self.folder,position),SOUND.land,.6,.7)
		sound(anchorPart(self.folder,position),SOUND.bodyfall,.5,1.05,.7)
		local floor=floorUnder(self,position,2,6)
		if floor then Kit.ground(self.folder,floor.Position,floor.Normal,"crack",8,2.4,1.2,Color3.new(1,1,1),.1) end
	end
	-- Chakra interactions (infusion contacts, meetings in flight, planted
	-- points, wire). Presentation only, and never allowed to break the feed.
	if impact.chakra then pcall(self.chakraImpact,self,impact,folder) end
end
-- Eight trigrams drawn on the ground around Neji for the sixty-four palms.
function FX:trigram(position)
	local floor=floorUnder(self,position,2,10)
	local at=if floor then floor.Position+Vector3.new(0,.05,0) else position-Vector3.new(0,2.9,0)
	local glyph=new("Model",{Name="Trigrams"},self.folder)
	local base=CFrame.new(at)*CFrame.Angles(0,0,math.pi/2)
	local disc=block(glyph,Vector3.new(.04,15,15),base,HYUGA,Enum.Material.SmoothPlastic);disc.Shape=Enum.PartType.Cylinder;disc.Transparency=.9
	local inner=block(glyph,Vector3.new(.05,3.4,3.4),base,Color3.fromRGB(236,240,255),Enum.Material.Neon);inner.Shape=Enum.PartType.Cylinder;inner.Transparency=.5
	for k=0,7 do
		local a=k/8*math.pi*2
		for line=0,2 do
			local broken=(k+line)%3==0
			local radius=5+line*.55
			local cf=CFrame.new(at+Vector3.new(math.sin(a)*radius,.02,math.cos(a)*radius))*CFrame.Angles(0,a,0)
			if broken then
				for _,side in {-1,1} do block(glyph,Vector3.new(.55,.05,.16),cf*CFrame.new(side*.42,0,0),HYUGA,Enum.Material.Neon) end
			else
				block(glyph,Vector3.new(1.4,.05,.16),cf,HYUGA,Enum.Material.Neon)
			end
		end
	end
	for _,d in glyph:GetDescendants() do if d:IsA("BasePart") then d.Transparency=math.max(d.Transparency,.35) end end
	flash(self.folder,at+Vector3.new(0,1,0),HYUGA,1,8,.25,.4)
	task.delay(1.6,function()
		for _,d in glyph:GetDescendants() do if d:IsA("BasePart") then tween(d,.4,{Transparency=1}) end end
	end)
	Debris:AddItem(glyph,2.1)
end
-- A thrown blade that missed stays embedded where it landed for a moment.
function FX:stick(kind,position,normal,direction,owner)
	if kind=="marked" then return end -- the seal renderer owns planted marked kunai
	local model=if kind=="shuriken" then FX.buildShuriken() else FX.buildKunai(false)
	model.Parent=self.folder
	local into=direction.Unit
	if into:Dot(normal)&gt;-.2 then into=(into-normal*1.2).Unit end
	local depth=if kind=="shuriken" then .25 else .45
	local cf=CFrame.lookAt(position-into*depth,position-into*depth+into)
	if kind=="shuriken" then cf=cf*CFrame.Angles(math.rad(80),0,0) end
	model:PivotTo(cf)
	sparks(self.folder,position,Color3.fromRGB(255,226,170),6,12)
	task.delay(2.6,function()
		for _,d in model:GetDescendants() do if d:IsA("BasePart") then tween(d,.4,{Transparency=1}) end end
		Debris:AddItem(model,.5)
	end)
end
function FX:explosion(position,normal,scale)
	scale=scale or 1
	local holder=anchorPart(self.folder,position);holder.Transparency=1
	sound(holder,SOUND.boom,.8,.9)
	sound(holder,SOUND.debris,.32*scale,1.15,1.1)
	-- (Jutsu pass 05/11, the reel: the bodies near a fireball's blast turned
	-- pure white) Brightness 10 over 46 studs blew every surface out; the
	-- blast still lights the arena, without erasing the fighters' colours.
	local light=new("PointLight",{Color=Color3.fromRGB(255,150,70),Brightness=3.5,Range=30*scale,Shadows=false},holder)
	tween(light,.9,{Brightness=0})
	if not Kit.has("fire") then
		-- Built-in look (no texture available).
		flash(self.folder,position,Color3.fromRGB(255,236,170),3,15,.35,.05)
		flash(self.folder,position,Color3.fromRGB(255,120,40),5,19,.5,.35)
		shockRing(self.folder,position,Color3.fromRGB(255,170,90),4,26,.38,normal)
		burst(self.folder,position,{Texture=TEX.fire,Lifetime=NumberRange.new(.45,.9),Speed=NumberRange.new(14,30),SpreadAngle=Vector2.new(180,180),
			Color=seq({{0,Color3.fromRGB(255,240,170)},{.4,Color3.fromRGB(255,130,40)},{1,Color3.fromRGB(80,24,10)}}),LightEmission=1,
			Size=num({{0,4},{.5,7},{1,2}}),Transparency=num({{0,.1},{1,1}}),Drag=4,RotSpeed=NumberRange.new(-90,90),Rotation=NumberRange.new(0,360)},34)
	else
		-- (Reference quality) a cel-shaded blast: a white core flash, billows of
		-- fire that swell, darken and break into smoke, a dome of pressure, the
		-- ground scorched in streaks, cracked under it, and debris thrown out.
		local folder=self.folder
		flash(folder,position,Color3.fromRGB(255,252,226),2*scale,13*scale,.16,0)
		local dome=flash(folder,position,Color3.fromRGB(255,244,226),4*scale,22*scale,.3,.5,true)
		dome.Material=Enum.Material.SmoothPlastic
		Kit.star(folder,position,16*scale,Color3.fromRGB(255,240,190),.14)
		Kit.burst(folder,position,"fire",math.floor(16*scale),{
			Lifetime=NumberRange.new(.8,1.25),Speed=NumberRange.new(10*scale,24*scale),SpreadAngle=Vector2.new(180,180),
			Color=ColorSequence.new(Color3.new(1,1,1)),LightEmission=.15,
			Size=num({{0,5*scale},{.35,9*scale},{1,11*scale}}),Transparency=num({{0,0},{.85,0},{1,1}}),
			Drag=5,Acceleration=Vector3.new(0,4,0),RotSpeed=NumberRange.new(-30,30),Rotation=NumberRange.new(0,360),zoffset=1})
		Kit.burst(folder,position,"fire",math.floor(8*scale),{
			Lifetime=NumberRange.new(.5,.75),Speed=NumberRange.new(2,6),SpreadAngle=Vector2.new(180,180),
			Color=ColorSequence.new(Color3.new(1,1,1)),LightEmission=.35,
			Size=num({{0,6*scale},{.4,10*scale},{1,8*scale}}),Transparency=num({{0,0},{.8,0},{1,1}}),
			Drag=3,Rotation=NumberRange.new(0,360),zoffset=1.5})
		task.delay(.22,function()
			Kit.burst(folder,position+Vector3.new(0,2.5,0),"smoke",math.floor(9*scale),{
				Lifetime=NumberRange.new(.9,1.4),Speed=NumberRange.new(8,16),SpreadAngle=Vector2.new(70,70),
				Color=ColorSequence.new(Color3.fromRGB(58,54,58)),LightEmission=0,
				Size=num({{0,5*scale},{1,11*scale}}),Transparency=num({{0,.1},{.5,.25},{1,1}}),
				Drag=2.5,Acceleration=Vector3.new(0,9,0),RotSpeed=NumberRange.new(-20,20),Rotation=NumberRange.new(0,360),zoffset=-.5})
		end)
		burst(folder,position,{Texture=TEX.fireSpark,Lifetime=NumberRange.new(.6,1.3),Speed=NumberRange.new(24,50),SpreadAngle=Vector2.new(180,180),
			Color=ColorSequence.new(Color3.fromRGB(255,196,110)),LightEmission=1,Size=num({{0,.6},{1,0}}),Drag=2,Acceleration=Vector3.new(0,-34,0)},40)
		-- Debris: dark chips thrown out and falling.
		for k=1,math.floor(9*scale) do
			local chip=block(folder,Vector3.new(.5,.4,.45)*(.6+math.random()*.8),CFrame.new(position)*CFrame.Angles(math.random()*6,math.random()*6,0),
				Color3.fromRGB(46,34,30),Enum.Material.Slate)
			local out=Vector3.new(math.random()-.5,.4+math.random()*.8,math.random()-.5).Unit
			local reach=(6+math.random()*9)*scale
			tween(chip,.55,{CFrame=chip.CFrame*CFrame.Angles(3,2,0)+out*reach},Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
			task.delay(.55,function() if chip.Parent then tween(chip,.35,{CFrame=chip.CFrame-Vector3.new(0,4,0),Transparency=1},Enum.EasingStyle.Quad,Enum.EasingDirection.In) end end)
			Debris:AddItem(chip,1)
		end
	end
	-- Scorched ground under the blast: radial burn streaks and cracks.
	local floor=floorUnder(self,position,2,14)
	if floor then
		if Kit.has("scorch") then
			-- (06/11, user: « la boule de feu laisse les mêmes traces ») the
			-- burn varies (size, shape, strength) and the black crack decal is
			-- gone: the server's crater under it is the broken ground now.
			Kit.ground(self.folder,floor.Position,floor.Normal,"scorch",(12+math.random()*8)*scale,3.5+math.random()*2,2,Color3.new(1,1,1),.08+math.random()*.2)
			local flat=CFrame.lookAt(floor.Position+floor.Normal*.2,floor.Position+floor.Normal*1.2,Vector3.xAxis)
			Kit.plane(self.folder,flat,"ring",Vector2.new(4,4)*scale,Vector2.new(30,30)*scale,.42,Color3.fromRGB(255,200,140),0)
			Kit.dust(self.folder,floor.Position,math.floor(10*scale),3.2*scale,Color3.fromRGB(200,180,150),18)
		else
			local scorch=block(self.folder,Vector3.new(.05,9,9),CFrame.new(floor.Position+floor.Normal*.04)*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(24,18,16),Enum.Material.Slate)
			scorch.Shape=Enum.PartType.Cylinder;scorch.Transparency=.25
			task.delay(3.5,function() tween(scorch,1.5,{Transparency=1}) end)
			Debris:AddItem(scorch,5.2)
		end
	end
end
function FX:teleport(from,to,model,awake)
	-- Yellow flash: a body-shaped afterimage where he stood, a single bright
	-- streak along the path, and a flash + shockwave where he reappears.
	if model then self:ghost(model,MINATO,.28,.25) end
	flash(self.folder,from,MINATO_CORE,1.5,7,.2,.05)
	local delta=to-from
	if delta.Magnitude&gt;1 then
		local streak=block(self.folder,Vector3.new(.35,.35,delta.Magnitude),CFrame.lookAt(from:Lerp(to,.5),to),MINATO,Enum.Material.Neon)
		streak.Transparency=.15
		tween(streak,.16,{Size=Vector3.new(.02,.02,delta.Magnitude),Transparency=1})
		Debris:AddItem(streak,.2)
	end
	flash(self.folder,to,MINATO_CORE,2,9,.22,0)
	flash(self.folder,to,MINATO,4,12,.32,.4)
	if Kit.has("star") then
		-- (Reference quality) the Yellow Flash: a star where he lands, light
		-- thrown out along his line, the floor dust kicked up under him.
		Kit.star(self.folder,to,9,MINATO_CORE,.12)
		Kit.star(self.folder,from,5,MINATO,.08)
		if delta.Magnitude&gt;1 then Kit.streaks(self.folder,to,delta.Unit,10,MINATO,80,30) end
		local floor=floorUnder(self,to,1,6)
		if floor then
			Kit.dust(self.folder,floor.Position,5,2,Color3.fromRGB(226,214,186),14)
			local flat=CFrame.lookAt(floor.Position+floor.Normal*.2,floor.Position+floor.Normal*1.2,Vector3.xAxis)
			Kit.plane(self.folder,flat,"ring",Vector2.new(2,2),Vector2.new(14,14),.3,MINATO,0)
		end
	end
	shockRing(self.folder,to-Vector3.new(0,2.6,0),MINATO,2,16,.3)
	sparks(self.folder,to,MINATO,18,24)
	if awake then
		-- Yellow Flash: a second, wider ring at the arrival and a flash left at
		-- the departure (the seal he leaves there): the chain has a rhythm.
		shockRing(self.folder,to-Vector3.new(0,2.6,0),MINATO_CORE,3,22,.4)
		flash(self.folder,from,MINATO,1,5,.3,.3)
	end
	local holder=anchorPart(self.folder,to);holder.Transparency=1
	sound(holder,SOUND.whoosh,.55,1.6)
	sound(holder,SOUND.whooshBy,.45,1.7)
	local light=new("PointLight",{Color=MINATO,Brightness=8,Range=24,Shadows=false},holder)
	tween(light,.35,{Brightness=0})
	Debris:AddItem(holder,1)
end
function FX:substitute(position,to,fighter,model)
	-- (Jutsu pass 05/11, from the Itachi vs Kakashi film: « le rondin fait un
	-- fantôme blanc ») No white copy of the body any more: the swap is hidden
	-- in a thick poof of smoke the size of the body, and the log is found
	-- standing in it where he stood (bark, two pale cut ends), then it topples.
	smokePuff(self.folder,position,Color3.fromRGB(242,242,246),26,2.8)
	smokePuff(self.folder,position-Vector3.new(0,1.8,0),Color3.fromRGB(232,232,236),14,2.2)
	if fighter=="Mirage" then
		crows(self.folder,position,10,11)
	else
		-- The classic: a wooden log takes the hit in his place.
		local holder=new("Model",{Name="SubstitutionLog"},self.folder)
		local stand=CFrame.new(position-Vector3.new(0,.6,0))*CFrame.Angles(0,math.random()*math.pi*2,0)*CFrame.Angles(0,0,math.rad(84))
		local log=block(holder,Vector3.new(3.6,1.25,1.25),stand,Color3.fromRGB(110,74,44),Enum.Material.Wood)
		log.Shape=Enum.PartType.Cylinder;log.Anchored=false;log.CanCollide=true;log.Massless=false;log.CastShadow=true
		for _,x in {-1.81,1.81} do
			local cut=block(holder,Vector3.new(.04,1.12,1.12),stand*CFrame.new(x,0,0),Color3.fromRGB(214,180,128),Enum.Material.Wood)
			cut.Shape=Enum.PartType.Cylinder;cut.Anchored=false;cut.Massless=true
			new("WeldConstraint",{Part0=log,Part1=cut},cut)
		end
		holder.PrimaryPart=log
		-- a nudge so it tips over instead of balancing on its end
		log.AssemblyLinearVelocity=Vector3.new(0,2,0)
		log.AssemblyAngularVelocity=stand.LookVector*2.2
		task.delay(1.7,function()
			if not holder.Parent then return end
			for _,d in holder:GetChildren() do if d:IsA("BasePart") then tween(d,.4,{Transparency=1}) end end
		end)
		Debris:AddItem(holder,2.2)
	end
	if to then smokePuff(self.folder,to,Color3.fromRGB(236,236,240),8,1.4) end
	sound(anchorPart(self.folder,position),SOUND.whoosh,.4,.9)
end

-- ------------------------------------------------------------------ chakra
-- What an infusion looks like on the object, read from the snapshot's
-- `infusion` (ChakraCombat). Unknown natures fall back to plain reinforcement.
local INFUSION={
	Reinforce={color=Color3.fromRGB(150,205,255),core=Color3.fromRGB(232,246,255),light=2.6,trail=.2,width=1.8},
	Wind={color=Color3.fromRGB(150,255,214),core=Color3.fromRGB(232,255,246),light=2.2,trail=.36,width=2.8,ring=true},
	Fire={color=Color3.fromRGB(255,128,44),core=Color3.fromRGB(255,226,150),light=4,trail=.24,width=2,flame=true},
	Lightning={color=Color3.fromRGB(140,186,255),core=Color3.fromRGB(236,244,255),light=4,trail=.13,width=1.6,spark=true},
	GentleFist={color=HYUGA,core=Color3.fromRGB(236,242,255),light=2.6,trail=.14,width=1.4},
}
FX.Infusion=INFUSION
local function lookOf(infusion) return INFUSION[infusion or ""] or INFUSION.Reinforce end
-- Decorate a projectile model: a chakra sheath around the steel, a coloured
-- trail sized by the nature, a light, flames or sparks, a wind ring.
function FX:infuse(model,root,infusion,kind,planted)
	local look=lookOf(infusion)
	local decor={look=look,emitters={}}
	local flatBlade=kind=="shuriken" or kind=="wire"
	-- A translucent chakra sheath: a disc round a shuriken, a sleeve along a kunai.
	local sheath=if flatBlade then block(model,Vector3.new(.2,1.05,1.05),root.CFrame*CFrame.Angles(0,0,math.pi/2),look.color,Enum.Material.Neon)
		else block(model,Vector3.new(1.35,.34,.34),root.CFrame*CFrame.new(0,0,-.25)*CFrame.Angles(0,math.pi/2,0),look.color,Enum.Material.Neon)
	sheath.Shape=Enum.PartType.Cylinder;sheath.Transparency=.55;sheath.Name="ChakraSheath"
	weldAll(root,{sheath})
	if not planted then
		if flatBlade then addTrail(root,Vector3.new(-.5,0,0),Vector3.new(.5,0,0),look.color,look.trail,.3,look.width)
		else addTrail(root,Vector3.new(0,.12,.25),Vector3.new(0,-.12,.25),look.color,look.trail,.3,look.width) end
	end
	decor.light=new("PointLight",{Color=look.color,Brightness=look.light,Range=if planted then 7 else 10,Shadows=false},root)
	local at=new("Attachment",{},root)
	if look.flame then
		table.insert(decor.emitters,emitter(at,{Name="ChakraFlame",Enabled=false,Texture=TEX.fire,Rate=70,Lifetime=NumberRange.new(.12,.26),Speed=NumberRange.new(1,3),SpreadAngle=Vector2.new(40,40),
			Color=seq({{0,Color3.fromRGB(255,232,150)},{.5,look.color},{1,Color3.fromRGB(120,30,10)}}),LightEmission=1,Size=num({{0,.9},{1,.2}}),Transparency=num({{0,.2},{1,1}})}))
	elseif look.spark then
		table.insert(decor.emitters,emitter(at,{Name="ChakraSpark",Enabled=false,Texture=TEX.spark,Rate=90,Lifetime=NumberRange.new(.05,.12),Speed=NumberRange.new(3,9),SpreadAngle=Vector2.new(180,180),
			Color=ColorSequence.new(look.core),LightEmission=1,Size=num({{0,.7},{1,0}}),Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-400,400)}))
	end
	if look.ring and not planted then
		-- The wind blade cuts with a thin spinning ring around its line.
		local ring=block(self.folder,Vector3.new(.06,1.5,1.5),root.CFrame,look.core,Enum.Material.Neon)
		ring.Shape=Enum.PartType.Cylinder;ring.Transparency=.45;ring.Name="WindRing";ring.Parent=model
		decor.ring=ring
	end
	if planted then for _,e in decor.emitters do e.Enabled=true end end
	return decor
end
-- A planted chakra blade (kind "point") or a stretched wire (kind
-- "tripwire"): built once where it rests.
function FX:planted(p)
	local tool=p.planted
	local origin=p.origin
	if tool=="wire" then
		local far=origin+p.direction*(p.range or 0)
		local model=new("Model",{Name="Tripwire"},self.folder)
		local root=block(model,Vector3.new(.15,.15,.15),CFrame.new(origin),STEEL,Enum.Material.Metal);root.Name="Root"
		local tip=block(model,Vector3.new(.15,.15,.15),CFrame.new(far),STEEL,Enum.Material.Metal);tip.Transparency=1
		local stake=FX.buildKunai(false);stake.Parent=model
		stake:PivotTo(CFrame.lookAt(origin+Vector3.new(0,.35,0),origin-Vector3.new(0,1,0)))
		local blade=FX.buildShuriken();blade.Parent=model
		blade:PivotTo(CFrame.lookAt(far,far+p.direction)*CFrame.Angles(math.rad(80),0,0))
		local a0=new("Attachment",{},root);local a1=new("Attachment",{},tip)
		local beam=new("Beam",{Attachment0=a0,Attachment1=a1,Width0=.1,Width1=.1,Color=ColorSequence.new(Color3.fromRGB(226,230,238)),LightEmission=.6,FaceCamera=true,Segments=2},root)
		local light=new("PointLight",{Color=INFUSION.Lightning.color,Brightness=0,Range=8,Shadows=false},tip)
		model.PrimaryPart=root
		sparks(self.folder,far,Color3.fromRGB(255,236,200),6,10)
		return {data=p,model=model,root=root,static=true,hidden=false,beam=beam,light=light,wire=true,born=os.clock()}
	end
	local model=if tool=="shuriken" then FX.buildShuriken() elseif tool=="kunai" or tool=="marked" then FX.buildKunai(tool=="marked") else nil
	if not model then return nil end
	model.Parent=self.folder
	local root=model.PrimaryPart
	local into=p.direction
	local depth=if tool=="shuriken" then .25 else .45
	local cf=CFrame.lookAt(origin-into*depth,origin-into*depth+into)
	if tool=="shuriken" then cf=cf*CFrame.Angles(math.rad(80),0,0) end
	root.CFrame=cf
	local decor=if p.infusion then self:infuse(model,root,p.infusion,tool,true) else nil
	flash(self.folder,origin,lookOf(p.infusion).color,.5,3,.18,.2)
	return {data=p,model=model,root=root,static=true,hidden=false,decor=decor,born=os.clock()}
end
-- A planted object at rest: a slow chakra pulse; a wire crackles while charged.
function FX:restStep(entry)
	local p=entry.data
	if entry.wire then
		local charged=p.infusion=="Lightning"
		entry.beam.Color=ColorSequence.new(if charged then INFUSION.Lightning.core else Color3.fromRGB(214,218,226))
		entry.beam.Width0=if charged then .13+math.random()*.08 else .1;entry.beam.Width1=entry.beam.Width0
		entry.light.Brightness=if charged then 1+math.random()*2.5 else 0
		return
	end
	local decor=entry.decor
	if decor and decor.light then
		local pulse=.5+.5*math.sin((os.clock()-entry.born)*5)
		decor.light.Brightness=if decor.look.spark then decor.look.light*(.3+math.random()) else decor.look.light*(.35+pulse*.5)
	end
end
-- A blade knocked out of the air spins away and drops.
function FX:tumble(kind,position,direction,color)
	local model=if kind=="shuriken" or kind=="wire" then FX.buildShuriken() elseif kind=="kunai" or kind=="marked" or kind=="point" then FX.buildKunai(kind=="marked") else nil
	if not model then return end
	model.Parent=self.folder
	local root=model.PrimaryPart
	local away=(direction or Vector3.yAxis)
	if away.Magnitude&lt;.05 then away=Vector3.yAxis end
	away=away.Unit
	root.CFrame=CFrame.lookAt(position,position+away)
	local finish=CFrame.new(position+away*5+Vector3.new(0,-2.5,0))*CFrame.Angles(math.random()*6,math.random()*6,math.random()*6)
	tween(root,.45,{CFrame=finish},Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
	if color then sparks(self.folder,position,color,8,14) end
	task.delay(.35,function()
		for _,d in model:GetDescendants() do if d:IsA("BasePart") then tween(d,.2,{Transparency=1}) end end
	end)
	Debris:AddItem(model,.7)
end
-- A jagged lightning line between two points, flickering twice.
function FX:bolt(from,to,color)
	if not from or not to then return end
	local function strike()
		local points={from}
		local delta=to-from
		local side=delta:Cross(Vector3.yAxis)
		if side.Magnitude&lt;.05 then side=Vector3.xAxis end
		side=side.Unit
		for k=1,4 do
			local jitter=side*(math.random()-.5)*1.2+Vector3.new(0,(math.random()-.5)*1.2,0)
			table.insert(points,from+delta*(k/5)+jitter)
		end
		table.insert(points,to)
		for k=1,#points-1 do
			local a,b=points[k],points[k+1]
			local length=(b-a).Magnitude
			if length&gt;.05 then
				local seg=block(self.folder,Vector3.new(.12,.12,length),CFrame.lookAt(a:Lerp(b,.5),b),color,Enum.Material.Neon)
				seg.Transparency=.1
				tween(seg,.14,{Transparency=1,Size=Vector3.new(.03,.03,length)})
				Debris:AddItem(seg,.18)
			end
		end
	end
	strike()
	task.delay(.07,strike)
	sparks(self.folder,to,color,14,22)
end
-- Hands lit with chakra for the palm (Neji's body infusion).
function FX:handGlow(model,color,time)
	if not model then return end
	for _,name in {"RightHand","LeftHand"} do
		local hand=model:FindFirstChild(name)
		if hand then
			local at=new("Attachment",{Name="ChakraPalm"},hand)
			local e=emitter(at,{Texture=TEX.glow,Rate=0,Lifetime=NumberRange.new(.12,.2),Speed=NumberRange.new(0,1),
				Color=ColorSequence.new(color),LightEmission=1,Size=num({{0,1.4},{1,.4}}),Transparency=num({{0,.25},{1,1}}),LockedToPart=true})
			e:Emit(10)
			local light=new("PointLight",{Color=color,Brightness=3,Range=6,Shadows=false},at)
			tween(light,time,{Brightness=0})
			Debris:AddItem(at,time+.1)
		end
	end
end
-- Every chakra contact the server reports (impact.chakra); unknown kinds do
-- nothing. Called inside pcall from FX:impact.
function FX:chakraImpact(impact,folder)
	local kind=impact.chakra
	local at=impact.position
	local look=lookOf(impact.infusion)
	local color=look.color
	if kind=="cut" then
		-- The wind kunai cuts the blade in its lane: a bright slash across it.
		local across=(impact.direction or Vector3.zAxis):Cross(Vector3.yAxis)
		if across.Magnitude&lt;.05 then across=Vector3.xAxis end
		local slash=block(self.folder,Vector3.new(.08,.08,3.2),CFrame.lookAt(at,at+across.Unit),look.core,Enum.Material.Neon)
		tween(slash,.18,{Transparency=1,Size=Vector3.new(.02,.02,4.2)});Debris:AddItem(slash,.22)
		sparks(self.folder,at,color,12,24)
		self:tumble(impact.kind,at,impact.tumble,nil)
	elseif kind=="deflect" or kind=="knock" then
		sparks(self.folder,at,color,10,22)
		self:tumble(if kind=="knock" then impact.tool or "kunai" else impact.kind,at,impact.tumble,nil)
	elseif kind=="swat" then
		flash(self.folder,at,HYUGA,.6,3.5,.14,.25)
		self:tumble(impact.kind,at,impact.tumble,HYUGA)
	elseif kind=="blown" then
		shockRing(self.folder,at,Color3.fromRGB(220,232,255),1,6,.2,impact.direction)
		self:tumble(impact.kind,at,impact.tumble,nil)
	elseif kind=="burn" or kind=="absorb" then
		flash(self.folder,at,INFUSION.Fire.color,.8,if kind=="absorb" then 6 else 3.5,.2,.2)
		sparks(self.folder,at,INFUSION.Fire.core,12,16)
		if kind=="absorb" then shockRing(self.folder,at,INFUSION.Fire.color,1.5,9,.25,impact.direction) end
	elseif kind=="intercept" then
		-- Both blades drop out of the meeting, to either side.
		self:tumble(impact.kind,at,impact.tumble,nil)
		if impact.tumble then self:tumble(impact.otherKind,at,Vector3.new(-impact.tumble.X,impact.tumble.Y,-impact.tumble.Z),nil) end
	elseif kind=="crush" then
		-- Reinforced steel leaning on a guard: a hard ring and chips off the guard.
		shockRing(self.folder,at,INFUSION.Reinforce.core,1.5,if impact.heavy then 12 else 7,.24,impact.direction)
		flash(self.folder,at,INFUSION.Reinforce.color,.8,if impact.heavy then 6 else 3.5,.16,.2)
		sparks(self.folder,at,INFUSION.Reinforce.core,impact.heavy and 18 or 10,20)
	elseif kind=="shock" or kind=="pointshock" or kind=="wirecharge" then
		local victim=modelFor(folder,impact.victim)
		local root=victim and victim:FindFirstChild("HumanoidRootPart")
		local center=if root then root.Position else at
		for k=1,3 do
			local offset=Vector3.new(math.random()-.5,math.random()-.5,math.random()-.5)*3
			self:bolt(center+offset,center-offset,INFUSION.Lightning.core)
		end
		flash(self.folder,center,INFUSION.Lightning.color,.8,4.5,.14,.2)
	elseif kind=="surge" or kind=="conduct" then
		self:bolt(impact.from or at,impact.to or at,INFUSION.Lightning.core)
		flash(self.folder,impact.to or at,INFUSION.Lightning.color,1,5,.16,.2)
	elseif kind=="ignite" then
		burst(self.folder,at,{Texture=TEX.fire,Lifetime=NumberRange.new(.25,.5),Speed=NumberRange.new(4,9),SpreadAngle=Vector2.new(180,180),
			Color=seq({{0,Color3.fromRGB(255,232,150)},{.5,INFUSION.Fire.color},{1,Color3.fromRGB(80,24,10)}}),LightEmission=1,Size=num({{0,1.6},{1,.4}}),Transparency=num({{0,.2},{1,1}})},14)
	elseif kind=="gust" then
		shockRing(self.folder,at,INFUSION.Wind.core,1.5,9,.22,impact.direction)
		smokePuff(self.folder,at-Vector3.new(0,2.4,0),Color3.fromRGB(214,236,226),6,1.2)
	elseif kind=="plant" or kind=="stretch" then
		flash(self.folder,at,color,.4,2.4,.14,.3)
	elseif kind=="recover" then
		flash(self.folder,at+Vector3.new(0,1,0),color,.4,2.5,.2,.3)
		sparks(self.folder,at+Vector3.new(0,1,0),look.core,8,8)
	elseif kind=="deny" or kind=="expire" or kind=="fizzle" then
		smokePuff(self.folder,at,if kind=="fizzle" then Color3.fromRGB(176,184,198) else Color3.fromRGB(206,206,214),if kind=="fizzle" then 6 else 4,.7)
	elseif kind=="palm" then
		self:handGlow(modelFor(folder,impact.owner),HYUGA,.35)
	elseif kind=="throughguard" then
		shockRing(self.folder,at,HYUGA,1.5,10,.24,impact.direction)
		flash(self.folder,at,HYUGA,.6,5,.16,.2)
	elseif kind=="tenketsu" then
		flash(self.folder,at,HYUGA,.3,2,.12,.2)
	elseif kind=="tripwire" or kind=="wirecut" then
		sparks(self.folder,at,Color3.fromRGB(230,234,240),10,14)
	elseif kind=="wireburn" then
		local from,to=impact.from or at,impact.to or at
		for k=0,4 do flash(self.folder,from:Lerp(to,k/4),INFUSION.Fire.color,.6,3,.2,.25) end
	end
end
-- ------------------------------------------------------------------ persistent
-- The Flying Thunder God formula written on a surface: its three characters
-- round a point, facing out, on an invisible plate (a SurfaceGui, unlit).
FX.FORMULA={"飛","雷","神"}
function FX.formulaGround(parent,surface,normal,radius,tone)
	normal=(normal or Vector3.yAxis).Unit
	local side=if math.abs(normal.Y)&gt;.9 then Vector3.xAxis else Vector3.yAxis
	local right=side:Cross(normal).Unit
	local size=radius*2+1.4
	local plate=block(parent,Vector3.new(size,.05,size),CFrame.fromMatrix(surface+normal*.05,right,normal),tone,Enum.Material.SmoothPlastic)
	plate.Transparency=1;plate.CanQuery=false;plate.CastShadow=false
	local gui=new("SurfaceGui",{Face=Enum.NormalId.Top,SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud,PixelsPerStud=60,
		LightInfluence=0,Brightness=1.8,ZIndexBehavior=Enum.ZIndexBehavior.Sibling},plate)
	local labels={}
	local turn=math.random()*math.pi*2
	for i,ch in FX.FORMULA do
		local a=turn+(i-1)/#FX.FORMULA*math.pi*2
		local l=new("TextLabel",{BackgroundTransparency=1,Size=UDim2.fromScale(.7/size*1.4,.7/size*1.4),AnchorPoint=Vector2.new(.5,.5),
			Position=UDim2.fromScale(.5+math.sin(a)*radius/size,.5-math.cos(a)*radius/size),Rotation=math.deg(a),Text=ch,TextScaled=true,
			Font=Enum.Font.GothamBlack,TextColor3=tone,TextStrokeColor3=Color3.fromRGB(110,60,0),TextStrokeTransparency=.35,TextTransparency=1},gui)
		table.insert(labels,l)
	end
	return plate,labels
end
-- Planted Flying Thunder God seals: a real three-pronged kunai in the surface
-- and a slowly pulsing seal formula around it.
function FX:seal(owner,actor,folder)
	local live={}
	for _,info in (actor and actor.seals) or {} do
		local key=tostring(owner)..":"..tostring(info.id)
		live[key]=true
		local entry=self.seals[key]
		if info.body then
			-- A seal riding on the opponent: a small glowing formula on the back.
			local model=folder and folder:FindFirstChild(info.body)
			local torso=model and (model:FindFirstChild("UpperTorso") or model:FindFirstChild("HumanoidRootPart"))
			if torso then
				-- (06/11) no glowing disc on the back any more: IdentityFX writes
				-- the formula round the body; here, its light on him.
				if not entry then
					local glyph=new("Model",{Name="Body seal"},self.folder)
					local tone=if info.wind then WIND else MINATO
					local anchor=block(glyph,Vector3.new(.2,.2,.2),torso.CFrame,tone,Enum.Material.SmoothPlastic);anchor.Transparency=1
					local light=new("PointLight",{Color=tone,Brightness=1.4,Range=6,Shadows=false},anchor)
					entry={glyph=glyph,anchor=anchor,light=light,body=true,born=os.clock()}
					self.seals[key]=entry
					flash(self.folder,torso.Position,tone,.5,3,.18,.2)
				end
				entry.anchor.CFrame=torso.CFrame
				local pulse=.5+.5*math.sin((os.clock()-entry.born)*7)
				entry.light.Brightness=1+pulse*1.2
			end
		elseif info.surface then
			local surface=info.surface
			local normal=info.normal or Vector3.yAxis
			if not entry then
				-- A Yellow Flash return seal is written where he stood: no kunai
				-- was thrown there (IdentityFX draws its floor formula).
				local model=if info.wake then nil else FX.buildKunai(true)
				if model then
					model.Parent=self.folder
					local into=-normal
					local tilt=(if math.abs(normal.Y)&gt;.7 then Vector3.xAxis else Vector3.yAxis)*.35
					local axis=(into+tilt).Unit
					model:PivotTo(CFrame.lookAt(surface-axis*.55,surface-axis*.55+axis))
				end
				-- (06/11, user: « les kunai de Minato… quand ils sont marqués,
				-- c'est super moche… un cercle bizarre ») No flat neon disc and
				-- spokes: the seal is its formula, the three characters of the
				-- Flying Thunder God written round the kunai, gold, glowing softly.
				local glyph=new("Model",{Name="Seal"},self.folder)
				local plate,labels=FX.formulaGround(glyph,surface,normal,if info.wake then 1.6 else 1.05,MINATO)
				local light=new("PointLight",{Color=MINATO,Brightness=1.2,Range=7,Shadows=false},plate)
				entry={model=model,glyph=glyph,labels=labels,light=light,surface=surface,born=os.clock()}
				self.seals[key]=entry
				flash(self.folder,surface,MINATO,.5,2.6,.18,.25)
			end
			local pulse=.5+.5*math.sin((os.clock()-entry.born)*4)
			-- The last seconds of a seal flicker so its expiry is readable.
			local fading=(info.remaining or 12)&lt;2 and math.sin(os.clock()*30)&gt;0
			local born=math.clamp((os.clock()-entry.born)/.25,0,1)
			for _,l in entry.labels do l.TextTransparency=if fading then .9 else 1-born*(.85-pulse*.25) end
			entry.light.Brightness=if fading then .3 else .8+pulse*.9
		end
	end
	for key,entry in self.seals do
		if string.sub(key,1,#tostring(owner)+1)==tostring(owner)..":" and not live[key] then
			if entry.model then
				for _,d in entry.model:GetDescendants() do if d:IsA("BasePart") then tween(d,.15,{Transparency=1}) end end
				Debris:AddItem(entry.model,.2)
			end
			Debris:AddItem(entry.glyph,.2)
			self.seals[key]=nil
		end
	end
end
-- Built-in Roblox sounds (shipped with every client, Mac and PC).
function FX:jumpSound(position) sound(anchorPart(self.folder,position),SOUND.jump,.28,1.1) end
function FX:getUpSound(position) sound(anchorPart(self.folder,position),SOUND.getUp,.25,1.15) end
-- (Studio check 28/10) the crater is drawn in relief by the server now; the
-- black star decal over it read as an ink print.
-- Burns are a soft blackening that fades out at its edge (Studio: the spiky
-- scorch star read as ink too), not a stamped shape.
local SCAR_ART={scorch={"soft",1.9,Color3.fromRGB(18,14,10)},char={"soft",1.7,Color3.fromRGB(20,22,34)},
	splinter={"crack",1.2,Color3.new(1,1,1)}}
function FX.dressScar(part)
	if not part:IsA("BasePart") or string.sub(part.Name,1,5)~="Scar " then return end
	local art=SCAR_ART[string.sub(part.Name,6)]
	if not art or (art[1]~="soft" and not Kit.has(art[1])) then return end
	task.defer(function()
		if not part.Parent then return end
		local holder=Instance.new("Part")
		holder.Name="ScarArt";holder.Anchored=true;holder.CanCollide=false;holder.CanQuery=false;holder.CanTouch=false
		holder.CastShadow=false;holder.Transparency=1;holder.Parent=part
		local decal=Instance.new("Decal");decal.Face=Enum.NormalId.Top
		if art[1]=="soft" then decal.Texture=TEX.glow;decal.Transparency=.08 else decal.TextureContent=Kit.content(art[1]) end
		decal.Color3=art[3];decal.Parent=holder
		local spin=math.random()*math.pi*2
		-- (06/11) each burn its own oval and size: a round soft disc was the
		-- same mark under every fireball
		local sx,sz=.8+math.random()*.5,.8+math.random()*.5
		local function fit()
			-- The scar's X axis is the surface normal (a flat cylinder).
			local cf=part.CFrame
			local normal=cf.RightVector
			local side=if math.abs(normal.Y)&gt;.9 then Vector3.xAxis else Vector3.yAxis
			local right=side:Cross(normal).Unit
			local size=math.max(part.Size.Y,part.Size.Z)*art[2]
			holder.Size=Vector3.new(size*sx,.05,size*sz)
			holder.CFrame=CFrame.fromMatrix(cf.Position+normal*.03,right,normal)*CFrame.Angles(0,spin,0)
			part.Transparency=1
		end
		fit()
		part:GetPropertyChangedSignal("Size"):Connect(fit)
		part:GetPropertyChangedSignal("Transparency"):Connect(function() if part.Transparency&lt;1 then part.Transparency=1 end end)
	end)
end
-- (Jutsu pass 06/11, user: « la traînée que laisse la boule de feu, c'est
-- super moche… j'espère que tu as retiré la bande… avec un contour jaune »)
-- Itachi's burning lane (Server/Elements.burnLane) is a row of patches 5
-- studs apart. Each patch now draws the piece of ground from the previous
-- patch of the same lane to itself, with nothing straight in it: scorch marks
-- (VfxKit's radial burn streaks, ragged by nature) overlapping along the
-- segment and each turned at random, so the burnt ground has no edge and no
-- outline; embers (glowing sparks) crawling and lifting off the burnt ground
-- instead of drawn lines; low flames licking over the whole segment (a box
-- emitter the segment's length) and a thin smoke. When the fire is out the
-- embers die first and the scorched ground stays a few seconds more.
FX.LANE={Char=Color3.fromRGB(46,34,26),Ember=Color3.fromRGB(255,120,40),Linger=4}
local lanePrev=setmetatable({},{__mode="k"})
-- Scorch marks laid on the floor, held for `hold` then faded.
local function scorchMarks(parent,at,normal,frame,length,radius,count,hold,fade,rng)
	local marks={}
	if not Kit.has("scorch") then return marks end
	for k=1,count do
		local u=if count==1 then 0 else (k-1)/(count-1)-.5
		local p=frame*CFrame.new(rng:NextNumber(-.5,.5)*radius*.3,0,u*length*.75)
		local m=Kit.ground(parent,p.Position,normal,"scorch",radius*(2.3+rng:NextNumber(0,.7)),hold,fade,FX.LANE.Char,rng:NextNumber(0,.12))
		if m then table.insert(marks,m) end
	end
	return marks
end
local function emberEmitter(parent,rate)
	return new("ParticleEmitter",{Name="Embers",Texture=TEX.spark,Rate=rate,Lifetime=NumberRange.new(.7,1.4),Speed=NumberRange.new(.4,2.2),
		SpreadAngle=Vector2.new(40,40),EmissionDirection=Enum.NormalId.Top,Shape=Enum.ParticleEmitterShape.Box,
		Color=seq({{0,Color3.fromRGB(255,214,120)},{.4,FX.LANE.Ember},{1,Color3.fromRGB(120,30,10)}}),LightEmission=1,LightInfluence=0,
		Size=num({{0,.2},{.6,.14},{1,0}}),Transparency=num({{0,0},{.8,.2},{1,1}}),Acceleration=Vector3.new(0,1.6,0),Drag=1.2,
		RotSpeed=NumberRange.new(-60,60),Rotation=NumberRange.new(0,360),ZOffset=.3},parent)
end
function FX:lanePatch(h)
	local floor=floorUnder(self,h.position,3,14)
	local at=(if floor then floor.Position else h.position-Vector3.new(0,.5,0))
	local normal=if floor and floor.Normal.Y&gt;.6 then floor.Normal else Vector3.yAxis
	lanePrev[self]=lanePrev[self] or {}
	local prev=lanePrev[self][h.lane]
	lanePrev[self][h.lane]=at
	local from=if prev and (prev-at).Magnitude&lt;9 then prev else nil
	local dir=if from then (at-from)*Vector3.new(1,0,1) else Vector3.zero
	dir=if dir.Magnitude&gt;.05 then dir.Unit else Vector3.zAxis
	local length=if from then (at-from).Magnitude+h.radius*1.4 else h.radius*2.2
	local mid=if from then (from+at)/2 else at
	local frame=CFrame.lookAt(mid,mid+dir)
	local holder=new("Model",{Name="FireLane"},self.folder)
	local rng=Random.new(math.floor(at.X*31+at.Z*17))
	local linger=FX.LANE.Linger
	-- the scorched ground
	local marks=scorchMarks(holder,mid,normal,frame,length,h.radius,if from then 3 else 2,(h.remaining or 2.6)+linger*.6,linger*.4,rng)
	-- the flames: low, many, over the whole segment
	local box=anchorPart(holder,mid+Vector3.new(0,.3,0));box.Transparency=1;box.Size=Vector3.new(h.radius*1.3,.2,length*.9)
	box.CFrame=frame+Vector3.new(0,.3,0)
	local flames=new("ParticleEmitter",{Texture=TEX.fire,Rate=70,Lifetime=NumberRange.new(.35,.65),Speed=NumberRange.new(2.5,5),
		SpreadAngle=Vector2.new(10,10),EmissionDirection=Enum.NormalId.Top,Shape=Enum.ParticleEmitterShape.Box,
		Color=seq({{0,Color3.fromRGB(255,232,160)},{.35,Color3.fromRGB(255,128,40)},{1,Color3.fromRGB(110,34,14)}}),LightEmission=.9,LightInfluence=0,
		Size=num({{0,.6},{.3,1.5},{1,.2}}),Transparency=num({{0,.15},{.7,.4},{1,1}}),Acceleration=Vector3.new(0,2,0),
		RotSpeed=NumberRange.new(-90,90),Rotation=NumberRange.new(0,360),ZOffset=.2},box)
	-- the embers: sparks crawling and lifting off the burnt ground
	local ground=anchorPart(holder,mid+Vector3.new(0,.15,0));ground.Transparency=1;ground.Size=Vector3.new(h.radius*1.6,.1,length)
	ground.CFrame=frame+Vector3.new(0,.15,0)
	local embers=emberEmitter(ground,28)
	local smoke=new("ParticleEmitter",{Texture=TEX.smoke,Rate=6,Lifetime=NumberRange.new(.9,1.4),Speed=NumberRange.new(2,4),
		SpreadAngle=Vector2.new(15,15),EmissionDirection=Enum.NormalId.Top,Shape=Enum.ParticleEmitterShape.Box,
		Color=ColorSequence.new(Color3.fromRGB(70,58,52)),LightInfluence=1,Size=num({{0,1.2},{1,3.4}}),Transparency=num({{0,.6},{1,1}}),
		RotSpeed=NumberRange.new(-30,30),Rotation=NumberRange.new(0,360)},box)
	local light=new("PointLight",{Color=Color3.fromRGB(255,130,60),Brightness=1.6,Range=h.radius*3,Shadows=false},box)
	local crackle=new("Sound",{SoundId=SOUND.fireLoop,Volume=.14,Looped=true,PlaybackSpeed=.85+rng:NextNumber()*.3,RollOffMaxDistance=60},box)
	pcall(function() crackle:Play() end)
	return {lane=true,holder=holder,marks=marks,embers=embers,flames=flames,smoke=smoke,light=light,crackle=crackle,born=os.clock()}
end
function FX.laneUpdate(entry,h)
	local t=os.clock()
	entry.light.Brightness=1.3+math.sin(t*19+entry.born)*.35+math.sin(t*7)*.25
	if h.remaining&lt;.5 then entry.flames.Rate=30 end
end
function FX.laneFinish(entry)
	entry.flames.Enabled=false;entry.smoke.Rate=3
	entry.embers.Rate=8
	tween(entry.light,.4,{Brightness=0})
	if entry.crackle then tween(entry.crackle,.6,{Volume=0}) end
	local linger=FX.LANE.Linger
	task.delay(1.2,function() if entry.embers.Parent then entry.embers.Enabled=false end end)
	task.delay(linger*.6,function() if entry.smoke.Parent then entry.smoke.Enabled=false end end)
	Debris:AddItem(entry.holder,linger+.2)
end
function FX:hazardsStep(data)
	local live={}
	for _,h in data.hazards or {} do
		local key=string.format("%s:%.1f:%.1f:%.1f",tostring(h.kind),h.position.X,h.position.Y,h.position.Z)
		live[key]=true
		local entry=self.hazards[key]
		-- A family zone (mist, insects, water, shadow...) has its own ground
		-- look (FamilyFX); every other hazard is fire.
		if not entry and h.look and FX.hazardBuild then
			entry=FX.hazardBuild(self,h)
			if entry then self.hazards[key]=entry end
		end
		if entry and entry.family then
			if FX.hazardUpdate then FX.hazardUpdate(entry,h) end
			continue
		end
		if not entry and h.lane then
			entry=self:lanePatch(h)
			self.hazards[key]=entry
		end
		if entry and entry.lane then
			FX.laneUpdate(entry,h)
			continue
		end
		if not entry then
			local floor=floorUnder(self,h.position,3,14)
			local at=if floor then floor.Position else h.position
			local holder=anchorPart(self.folder,at);holder.Transparency=1;holder.Size=Vector3.new(h.radius*1.6,.2,h.radius*1.6)
			-- (06/11) the ground under a burning patch is scorched (ragged burn
			-- marks, no outline), embers crawl on it, the flames lick low over it
			local normal=if floor and floor.Normal.Y&gt;.6 then floor.Normal else Vector3.yAxis
			local charHolder=new("Model",{Name="FireScorch"},self.folder)
			scorchMarks(charHolder,at,normal,CFrame.new(at)*CFrame.Angles(0,math.random()*6.28,0),h.radius*.8,h.radius*.85,2,
				(h.remaining or 3)+FX.LANE.Linger*.6,FX.LANE.Linger*.4,Random.new())
			Debris:AddItem(charHolder,(h.remaining or 3)+FX.LANE.Linger+.3)
			local embers=emberEmitter(holder,math.floor(10+h.radius*3))
			local e=new("ParticleEmitter",{Texture=TEX.fire,Rate=60,Lifetime=NumberRange.new(.35,.65),Speed=NumberRange.new(2.5,5),
				SpreadAngle=Vector2.new(10,10),EmissionDirection=Enum.NormalId.Top,Shape=Enum.ParticleEmitterShape.Box,
				Color=seq({{0,Color3.fromRGB(255,232,160)},{.35,Color3.fromRGB(255,128,40)},{1,Color3.fromRGB(110,34,14)}}),LightEmission=.9,LightInfluence=0,
				Size=num({{0,.7},{.3,1.6},{1,.2}}),Transparency=num({{0,.15},{.7,.4},{1,1}}),Acceleration=Vector3.new(0,2,0),RotSpeed=NumberRange.new(-90,90),Rotation=NumberRange.new(0,360)},holder)
			local light=new("PointLight",{Color=Color3.fromRGB(255,130,60),Brightness=1.8,Range=h.radius*3,Shadows=false},holder)
			local crackle=new("Sound",{SoundId=SOUND.fireLoop,Volume=.18,Looped=true,PlaybackSpeed=.9+math.random()*.2,RollOffMaxDistance=60},holder)
			pcall(function() crackle:Play() end)
			entry={holder=holder,emitter=e,light=light,embers=embers}
			self.hazards[key]=entry
		end
		-- Readable, not noisy: a small burning patch (a chakra blade's) flickers
		-- with fewer flames than a Great Fireball's lane (ChakraFX marks its edge).
		local scale=math.clamp(h.radius/4.5,.4,1)
		entry.light.Brightness=(2.4+math.sin(os.clock()*22)*.6+math.sin(os.clock()*9)*.5)*scale
		entry.emitter.Rate=(if h.remaining&lt;.4 then 25 else 60)*scale
	end
	for key,entry in self.hazards do
		if not live[key] and entry.lane then
			FX.laneFinish(entry);self.hazards[key]=nil
		elseif not live[key] and entry.family then
			FX.hazardFinish(entry);self.hazards[key]=nil
		elseif not live[key] then
			entry.emitter.Enabled=false;tween(entry.light,.3,{Brightness=0})
			if entry.embers then entry.embers.Rate=4 end
			Debris:AddItem(entry.holder,1.2);self.hazards[key]=nil
		end
	end
end
-- Battle wear: as health drops (75 / 50 / 25 %), dirt, scuffs, small grazes
-- and darkened cloth accumulate on the body. Feedback, not gore.
local WEAR={
	-- {body part, size, offset, kind}
	{ {"UpperTorso",Vector3.new(.7,.5,.05),CFrame.new(.35,-.2,-.53),"dirt"},{"RightUpperLeg",Vector3.new(.5,.6,.05),CFrame.new(0,-.1,-.5),"dirt"},{"LeftLowerArm",Vector3.new(.45,.4,.05),CFrame.new(0,0,-.43),"dirt"} },
	{ {"UpperTorso",Vector3.new(.55,.35,.05),CFrame.new(-.4,.35,.53),"dirt"},{"LeftUpperLeg",Vector3.new(.55,.45,.05),CFrame.new(.1,.2,-.5),"tear"},{"Head",Vector3.new(.18,.06,.03),CFrame.new(.42,-.18,-.78),"graze"},{"RightUpperArm",Vector3.new(.5,.12,.05),CFrame.new(0,-.35,-.45),"tear"} },
	{ {"LowerTorso",Vector3.new(.8,.3,.05),CFrame.new(-.2,0,-.53),"dirt"},{"RightLowerArm",Vector3.new(.2,.08,.03),CFrame.new(.05,.1,-.44),"graze"},{"LeftLowerLeg",Vector3.new(.5,.5,.05),CFrame.new(0,.2,-.45),"dirt"},{"UpperTorso",Vector3.new(.3,.5,.05),CFrame.new(.1,.1,-.535),"tear"} },
}
local WEAR_LOOK={dirt={Color3.fromRGB(96,78,58),.35},tear={Color3.fromRGB(40,34,32),.25},graze={Color3.fromRGB(150,46,40),.2}}
-- (Audit 04/11) One record of a body part's own colour for every layer that
-- tints it (the battle wear's dust, Lee's gates' flush): each says what it
-- adds, the colour is rebuilt from the original. Two layers that each kept
-- their own "original" left Lee red, or browner, for the next round.
local DUST=Color3.fromRGB(110,92,74)
local LEE_FLUSH=Color3.fromRGB(226,92,72)
local BASE=setmetatable({},{__mode="k"})
local WORN=setmetatable({},{__mode="k"})
local FLUSHED=setmetatable({},{__mode="k"})
local function baseColor(p)
	local base=BASE[p]
	if not base then base=p.Color;BASE[p]=base end
	return base
end
local function recolor(p)
	local color=baseColor(p)
	if WORN[p] then color=color:Lerp(DUST,.14) end
	if FLUSHED[p] then color=color:Lerp(LEE_FLUSH,FLUSHED[p]) end
	p.Color=color
end
-- layer: "wear" (true / nil) or "flush" (an amount / nil)
local function tintLayer(p,layer,value)
	baseColor(p)
	if layer=="wear" then WORN[p]=value elseif layer=="flush" then FLUSHED[p]=value end
	recolor(p)
end
FX.baseColor=baseColor;FX.recolor=recolor;FX.tintLayer=tintLayer
function FX:wear(model,actor,aura)
	local ratio=(actor.health or 1)/math.max(1,actor.maxHealth or 1)
	local level=if ratio&lt;=.25 then 3 elseif ratio&lt;=.5 then 2 elseif ratio&lt;=.75 then 1 else 0
	aura.wear=aura.wear or 0
	-- A new round restores health on the same bodies: the wear starts over
	-- instead of opening round two fully worn (and unable to build again).
	if aura.wear&gt;0 and level==0 and ratio&gt;=.99 then
		for _,p in model:GetDescendants() do if p.Name=="BattleWear" then p:Destroy() end end
		for part in aura.cloth or {} do if part.Parent then tintLayer(part,"wear",nil) end end
		aura.cloth=nil;aura.wear=0
	end
	while aura.wear&lt;level do
		aura.wear+=1
		for _,spec in WEAR[aura.wear] do
			local body=model:FindFirstChild(spec[1])
			if body and body:IsA("BasePart") then
				local look=WEAR_LOOK[spec[4]]
				local mark=block(model,spec[2],body.CFrame*spec[3],look[1],Enum.Material.SmoothPlastic)
				mark.Name="BattleWear";mark.Anchored=false;mark.Massless=true;mark.Transparency=look[2];mark.CastShadow=false
				new("WeldConstraint",{Part0=body,Part1=mark},mark)
			end
		end
		if aura.wear==3 then
			-- Low health: cloth looks dusty and darker.
			for _,p in model:GetChildren() do
				if p:IsA("BasePart") and p.Name~="HumanoidRootPart" and p.Name~="BattleWear" and p.Transparency&lt;1 and p.Material~=Enum.Material.Neon then
					aura.cloth=aura.cloth or {};aura.cloth[p]=true
					tintLayer(p,"wear",true)
				end
			end
		end
	end
end
-- Faces (user 29/10: "il manque une expression faciale"): what the body is
-- doing picks the expression; a transient one is held a moment so a light
-- string does not flicker the face; the eyes blink every few seconds.
local function moodOf(actor)
	if (actor.health or 1)&lt;=0 then return "ko",1 end
	local reaction=actor.reaction
	if reaction=="Bound" then return "stun",.35 end
	if reaction~=nil then return "hurt",.4 end
	local state=actor.state
	if state=="Stunned" then return "hurt",.4 end
	if state=="TechniqueChannel" then return "focus",.25 end
	if state=="TechniqueActive" then return "shout",.4 end
	if state=="Startup" or state=="Active" then
		local name=actor.attackName or ""
		if string.find(name,"Heavy") or string.find(name,"Launcher") or string.find(name,"Spike") or string.find(name,"Sweep") or string.find(name,"Finisher") then return "shout",.35 end
		return "fight",.3
	end
	if state=="Guarding" then return "fight",.25 end
	if state=="Dodging" or state=="Rush" or state=="Pursuit" then return "focus",.25 end
	if (actor.awaken or 0)&gt;0 then return "fight",.3 end
	if actor.won then return "win",1 end
	return nil,0
end
FX.moodOf=moodOf
function FX:expression(model,actor,aura)
	local face=aura.face
	if not face then return end
	local now=os.clock()
	local mood,hold=moodOf(actor)
	if mood then
		aura.mood=mood;aura.moodUntil=now+hold
	elseif not aura.moodUntil or now&gt;aura.moodUntil then
		aura.mood=model:GetAttribute("FaceMood") or "calm"
	end
	local blink=false
	if aura.blinkAt and now&gt;=aura.blinkAt then
		blink=now&lt;aura.blinkAt+.12
		if not blink then aura.blinkAt=now+2.4+math.random()*2.8 end
	end
	if aura.mood~=face.current or blink~=(face.blinking==true) then Face.set(face,aura.mood,blink) end
end
-- Per-fighter identity layer: Minato's speed trail and Rasengan, Itachi's
-- Sharingan glow and fire breath. Restrained: it switches on only for the
-- moments it describes.
function FX:fighter(model,actor,dt)
	if not model or not actor then return end
	local aura=self.auras[model]
	local root=model:FindFirstChild("HumanoidRootPart")
	if not root then return end
	if not aura then
		aura={}
		self.auras[model]=aura
		local minato=actor.fighterId=="Flashstep"
		local color=if minato then MINATO elseif actor.fighterId=="GentleFist" then HYUGA elseif actor.fighterId=="Lion" then LION else Color3.fromRGB(170,30,48)
		local veins={}
		for _,p in model:GetChildren() do if p.Name=="ByakuganVein" then table.insert(veins,p) end end
		aura.veins=veins
		-- The dash streak is each fighter's (movement overhaul, brief §12), not
