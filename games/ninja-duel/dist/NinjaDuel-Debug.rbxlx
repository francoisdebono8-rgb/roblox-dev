        <Item class="ModuleScript" referent="ND218">
          <Properties>
            <string name="Name">LightningFX</string>
            <ProtectedString name="Source">-- (12/11) The lightning of the Chidori (Sasuke) and the Raikiri / Lightning
-- Blade (Kakashi), drawn with real bolts (LightningBoltFX, adapted from
-- SamyBlue/Lightning-Beams, MIT) on top of the hand's sparks and glow
-- (Effects, the Chidori aura):
--   * held: the "birds" - three to five arcs thrown out of the palm to points
--     round the hand, each living a few hundredths of a second and replaced,
--     so the hand never shows the same shape twice; one longer arc licks the
--     floor now and then;
--   * at a run: an arc from the hand to the floor behind it, dragged along;
--   * the blow (impact "chidori"): the lightning goes THROUGH the body, in the
--     direction of the thrust (VFX bible: the impact crosses the target), four
--     bolts out of the back, run from the contact outward (pulse);
--   * Kakashi's Lightning Cut relocation is DashTrailFX's (it uses the same
--     bolts for its line).
-- Bible: a white-hot core stroke, the colour in the glow (blue-white; the
-- Raikiri whiter), few layers, never plain Neon. Presentation only.
local LightningFX={}
local Bolt=require(script.Parent.LightningBoltFX)
local K
LightningFX.clock=os.clock
LightningFX.LOOKS={
	Chidori={core=Color3.fromRGB(236,244,255),glow=Color3.fromRGB(96,150,255),birds=4,reach=2.6},
	Raikiri={core=Color3.fromRGB(250,252,255),glow=Color3.fromRGB(150,200,255),birds=5,reach=3.0},
}
-- Same reading as Effects' Chidori aura (the hand that holds it).
function LightningFX.holding(actor)
	if not actor or (actor.health or 1)&lt;=0 then return nil end
	local st=actor.state
	local body=actor.bodyState and actor.bodyState.id
	if body=="LightningBlade" then return "Raikiri" end
	if body=="Chidori" then return if actor.fighterId=="Copycat" then "Raikiri" else "Chidori" end
	if actor.castId=="Chidori" and (st=="TechniqueChannel" or st=="TechniqueActive") then return if actor.fighterId=="Copycat" then "Raikiri" else "Chidori" end
	if actor.castId=="LightningBlade" and (st=="TechniqueChannel" or st=="TechniqueActive") then return "Raikiri" end
	if actor.attackName=="ChidoriThrust" and (st=="Startup" or st=="Active") then return "Chidori" end
	if (actor.attackVariant=="Chidori" or actor.attackVariant=="ChidoriDive") and (st=="Startup" or st=="Active") then return "Chidori" end
	return nil
end
local function arc(from,to,look,width,life,radius)
	local b=Bolt.new(Bolt.point(from,(to-from).Unit),Bolt.point(to,(to-from).Unit),math.clamp(math.floor((to-from).Magnitude*3),6,18))
	b.Color=look.core;b.GlowColor=look.glow
	b.Thickness=width;b.MinRadius=0;b.MaxRadius=radius or .35
	b.Frequency=2.2;b.AnimationSpeed=12
	b.PulseSpeed=1/life;b.PulseLength=.9;b.FadeLength=.25
	b.MinThicknessMultiplier,b.MaxThicknessMultiplier=.35,1
	return b
end
LightningFX.arc=arc
local held=setmetatable({},{__mode="k"}) -- model -&gt; {next, floorAt}
local function random(rng) return Vector3.new(rng:NextNumber()-.5,rng:NextNumber()-.5,rng:NextNumber()-.5).Unit end
local rng=Random.new()
local function fighter(fx,model,actor,dt)
	local kind=LightningFX.holding(actor)
	if not model then return end
	if not kind then held[model]=nil return end
	local hand=model:FindFirstChild("RightHand")
	if not hand then return end
	Bolt.folder=fx.folder
	local look=LightningFX.LOOKS[kind]
	local st=held[model]
	if not st then st={next=0,floorAt=0};held[model]=st end
	local now=LightningFX.clock()
	local palm=hand.Position-hand.CFrame.UpVector*.35
	if now&gt;=st.next then
		st.next=now+.06+rng:NextNumber()*.04
		local n=math.max(1,look.birds-2+rng:NextInteger(0,2))
		for _=1,n do
			local dir=random(rng)
			arc(palm,palm+dir*look.reach*(.5+rng:NextNumber()*.6),look,.09+rng:NextNumber()*.05,.08+rng:NextNumber()*.06,.4)
		end
	end
	local root=model:FindFirstChild("HumanoidRootPart")
	local v=root and root.AssemblyLinearVelocity or Vector3.zero
	local speed=Vector3.new(v.X,0,v.Z).Magnitude
	if now&gt;=st.floorAt and (speed&gt;10 or rng:NextNumber()&lt;.25) then
		st.floorAt=now+(if speed&gt;10 then .07 else .35)
		local floor=K.floorUnder and K.floorUnder(fx,palm,1,7)
		if floor then
			local back=if speed&gt;1 then -Vector3.new(v.X,0,v.Z).Unit*1.4 else random(rng)*Vector3.new(1,0,1)
			arc(palm,floor.Position+back,look,.12,.12,.55)
		end
	end
end
local function impact(fx,data,folder)
	if data.style~="chidori" then return false end
	pcall(function()
		Bolt.folder=fx.folder
		local at=data.position
		local dir=data.direction
		if not dir or dir.Magnitude&lt;.1 then
			local owner=folder and folder:FindFirstChild(data.owner or "")
			local root=owner and owner:FindFirstChild("HumanoidRootPart")
			dir=if root then root.CFrame.LookVector else Vector3.new(0,0,-1)
		end
		dir=dir.Unit
		local owner=folder and folder:FindFirstChild(data.owner or "")
		local fid=data.fighter or (owner and owner:GetAttribute("FighterId"))
		local look=LightningFX.LOOKS[if fid=="Copycat" then "Raikiri" else "Chidori"]
		for i=1,4 do
			local spread=(random(rng)*.45+dir).Unit
			arc(at-dir*.4,at+spread*(4+i),look,.22-i*.03,.16+i*.03,.6)
		end
	end)
	return false -- Effects' flash and sparks still mark the contact
end
function LightningFX.install(FX,kit)
	K=kit
	table.insert(FX.layers,{name="Lightning",impact=impact,fighter=function(fx,model,actor,dt)
		local ok=pcall(fighter,fx,model,actor,dt)
		if not ok and model then held[model]=nil end
	end})
end
return LightningFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND219">
          <Properties>
            <string name="Name">LobbyPanel</string>
            <ProtectedString name="Source">-- Players online and challenges, the client's half (Server/Lobby, user 04/11:
-- see who is connected, challenge one, the other gets a notification and
-- accepts or declines). Three pieces, all in the house ink card:
--  * PLAYERS ONLINE on the roster, with the count, opens the list: each
--    player's name, fighter and state, a CHALLENGE button; friends first;
--    do not disturb at the bottom.
--  * The invitation: a card at the top of the screen on every screen (the
--    roster, a duel against the AI, the result), ACCEPT / DECLINE and the time
--    left. Keyboard: Enter accepts, Backspace declines.
--  * The status line under it: challenge sent (cancel), declined, no answer,
--    leaving for the duel.
-- The client sends ids and booleans only; players the user blocked on Roblox
-- are hidden and their invitations declined unseen.
local Players=game:GetService("Players")
local UIS=game:GetService("UserInputService")
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
-- (QA 12/11) capitals that keep the long vowels and accents.
local Text=require(Shared.Text)
local Fighters=require(Shared.Fighters)
local Panel={};Panel.__index=Panel

local STATE={free="ON THE ROSTER",training="VS THE AI",queue="SEARCHING",duel="IN A DUEL",cup="IN A TOURNAMENT"}
local function blocked()
	local set={}
	pcall(function()
		for _,id in game:GetService("StarterGui"):GetCore("GetBlockedUserIds") or {} do set[id]=true end
	end)
	return set
end

function Panel.new(ui,remote,kit)
	local K=kit
	local P=K.palette
	local self=setmetatable({ui=ui,remote=remote,kit=K,players={},invites={},rows={},sentId=nil,dnd=false,blocked=blocked(),
		lastFighter=nil,open=false,phase="Selection"},Panel)
	-- PLAYERS ONLINE, on the roster above ENTER THE STAGE.
	self.button=K.button(ui.shell,"PLAYERS ONLINE",UDim2.fromOffset(1140,712),UDim2.fromOffset(400,52),function() self:toggle(true) end)
	self.button.TextSize=26
	-- The list.
	local overlay=K.frame(ui.gui,UDim2.fromScale(0,0),UDim2.fromScale(1,1),P.ink,.35)
	overlay.ZIndex=70;overlay.Visible=false;overlay.Active=true
	self.overlay=overlay
	-- (Studio 04/11) a little under the middle: an invitation at the top of
	-- the screen never covers the list's title.
	local card=K.inkCard(K.frame(overlay,UDim2.fromScale(.5,.57),UDim2.fromOffset(760,620),K.CARD,0))
	card.AnchorPoint=Vector2.new(.5,.5);card.ZIndex=71
	local scale=K.create("UIScale",card,{Scale=1})
	local function fit()
		local size=workspace.CurrentCamera.ViewportSize
		scale.Scale=math.clamp(math.min(size.X/1500,size.Y/860),.5,1.2)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit);fit()
	local title=K.inkTitle(K.text(card,"PLAYERS ONLINE",UDim2.fromOffset(28,16),UDim2.fromOffset(704,50),44,P.paper,K.TITLE_FONT))
	title.ZIndex=72
	self.subtitle=K.text(card,"",UDim2.fromOffset(30,66),UDim2.fromOffset(700,20),14,P.muted,K.BODY_FONT);self.subtitle.ZIndex=72
	local list=K.create("ScrollingFrame",card,{Position=UDim2.fromOffset(24,96),Size=UDim2.fromOffset(712,420),BackgroundTransparency=1,BorderSizePixel=0,
		ScrollBarThickness=6,CanvasSize=UDim2.fromOffset(0,0),ZIndex=72})
	self.list=list
	self.empty=K.text(list,"Nobody else is online right now. Train against the AI — the list refreshes by itself.",UDim2.fromOffset(20,30),UDim2.fromOffset(660,60),18,P.muted,K.BODY_FONT,Enum.TextXAlignment.Center)
	self.empty.ZIndex=73
	self.dndButton=K.button(card,"DO NOT DISTURB: OFF",UDim2.fromOffset(24,540),UDim2.fromOffset(340,56),function()
		self:send({op="dnd",on=not self.dnd})
	end)
	self.dndButton.ZIndex=72
	local close=K.button(card,"CLOSE",UDim2.fromOffset(396,540),UDim2.fromOffset(340,56),function() self:toggle(false) end)
	close.ZIndex=72
	self.closeButton=close
	-- The invitation and the status line, above every screen.
	local top=K.frame(ui.gui,UDim2.new(.5,0,0,8),UDim2.fromOffset(620,150),P.ink,1)
	top.AnchorPoint=Vector2.new(.5,0);top.ZIndex=80
	local topScale=K.create("UIScale",top,{Scale=1})
	local function fitTop()
		local size=workspace.CurrentCamera.ViewportSize
		topScale.Scale=math.clamp(math.min(size.X/1500,size.Y/860),.55,1.2)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fitTop);fitTop()
	local invite=K.inkCard(K.frame(top,UDim2.fromOffset(0,0),UDim2.fromOffset(620,112),K.CARD,0),10)
	invite.ZIndex=81;invite.Visible=false
	self.inviteCard=invite
	self.inviteText=K.inkTitle(K.text(invite,"",UDim2.fromOffset(18,10),UDim2.fromOffset(584,34),30,P.paper,K.TITLE_FONT,Enum.TextXAlignment.Center))
	self.inviteText.ZIndex=82
	self.inviteSub=K.text(invite,"",UDim2.fromOffset(18,42),UDim2.fromOffset(584,18),13,P.muted,K.BODY_FONT,Enum.TextXAlignment.Center)
	self.inviteSub.ZIndex=82
	self.acceptButton=K.button(invite,"ACCEPT",UDim2.fromOffset(18,64),UDim2.fromOffset(284,38),function() self:answer(true) end,P.red)
	self.acceptButton.ZIndex=82
	self.declineButton=K.button(invite,"DECLINE",UDim2.fromOffset(318,64),UDim2.fromOffset(284,38),function() self:answer(false) end)
	self.declineButton.ZIndex=82
	self.timer=K.frame(invite,UDim2.new(0,0,1,-4),UDim2.new(1,0,0,4),P.gold,0);self.timer.ZIndex=83
	local status=K.frame(top,UDim2.fromOffset(60,118),UDim2.fromOffset(500,30),K.CARD,.1)
	K.corner(status,6);status.ZIndex=81;status.Visible=false
	self.statusBox=status
	self.statusText=K.text(status,"",UDim2.fromOffset(12,0),UDim2.fromOffset(380,30),14,P.paper,K.BODY_FONT,Enum.TextXAlignment.Center)
	self.statusText.ZIndex=82
	self.cancelButton=K.button(status,"CANCEL",UDim2.fromOffset(398,3),UDim2.fromOffset(98,24),function()
		if self.sentId then self:send({op="cancel",id=self.sentId}) end
	end)
	self.cancelButton.TextSize=16;self.cancelButton.ZIndex=82
	-- Keyboard answers (the cursor may be held by the duel camera).
	-- (Audit 04/11) and the pad's: off a duel the gamepad selection sits on
	-- ACCEPT (A) and B declines; in a duel (A, B are the jump and the dodge)
	-- SELECT accepts and the invitation runs out on its own.
	UIS.InputBegan:Connect(function(input,processed)
		if not self.invite then return end
		local code=input.KeyCode
		if code==Enum.KeyCode.ButtonSelect then self:answer(true);return end
		if code==Enum.KeyCode.ButtonB and self.phase~="Duel" then self:answer(false);return end
		if processed then return end
		if code==Enum.KeyCode.Return then self:answer(true)
		elseif code==Enum.KeyCode.Backspace then self:answer(false) end
	end)
	remote.OnClientEvent:Connect(function(data) self:receive(data) end)
	-- The fighter picked on the roster is what the others see next to the name.
	task.spawn(function()
		while true do
			task.wait(1)
			local id=ui.player
			if id and id~=self.lastFighter and Fighters[id] then self.lastFighter=id;self:send({op="fighter",fighter=id}) end
			self:tickTimer()
			-- (B1 lot 2) not on the first, simple roster (ALL MODES shows it).
			self.button.Visible=self.phase=="Selection" and not ui.simple
			if self.open then self:send({op="open"}) end
		end
	end)
	return self
end
function Panel:send(payload) pcall(function() self.remote:FireServer(payload) end) end
function Panel:toggle(open)
	self.open=open
	self.overlay.Visible=open
	self:send({op=if open then "open" else "close"})
	pcall(function() game:GetService("GuiService").SelectedObject=if open then self.closeButton else nil end)
end
function Panel:status(text,tone,cancellable)
	self.statusText.Text=text or ""
	self.statusText.TextColor3=if tone=="bad" then self.kit.palette.gold else self.kit.palette.paper
	self.statusBox.Visible=text~=nil and text~=""
	self.cancelButton.Visible=cancellable==true
	self.statusSerial=(self.statusSerial or 0)+1
	local serial=self.statusSerial
	if not cancellable then
		task.delay(6,function() if self.statusSerial==serial then self.statusBox.Visible=false end end)
	end
end
function Panel:receive(data)
	if type(data)~="table" then return end
	if data.kind=="list" then
		self.players=data.players or {}
		self.dnd=data.dnd==true
		self:drawList()
	elseif data.kind=="dnd" then
		self.dnd=data.on==true
		self:drawList()
	elseif data.kind=="invite" then
		if self.blocked[data.fromId] then self:send({op="answer",id=data.id,accept=false});return end
		self.invite={id=data.id,from=data.from,fighter=data.fighter,until_=os.clock()+(data.remaining or 20),length=data.remaining or 20}
		self:drawInvite()
	elseif data.kind=="closed" then
		if self.invite and self.invite.id==data.id then self.invite=nil;self:drawInvite() end
		if self.sentId==data.id then self.sentId=nil end
		if data.text then self:status(data.text,"bad") end
	elseif data.kind=="sent" then
		self.sentId=data.id
		self:status("CHALLENGE SENT TO "..Text.upper(tostring(data.to)).."  •  WAITING…","info",true)
	elseif data.kind=="status" then
		if self.sentId and data.tone=="bad" then self.sentId=nil end
		self:status(data.text,data.tone,false)
		if string.find(tostring(data.text),"LEAVING FOR THE DUEL",1,true) or string.find(tostring(data.text),"ACCEPTED",1,true) then
			self.sentId=nil;self:toggle(false)
		end
	end
end
function Panel:answer(accept)
	local invite=self.invite
	if not invite then return end
	self.invite=nil
	self:drawInvite()
	self:send({op="answer",id=invite.id,accept=accept,fighter=self.ui.player})
end
function Panel:drawInvite()
	local invite=self.invite
	self.inviteCard.Visible=invite~=nil
	if not invite then return end
	local def=Fighters[invite.fighter or ""]
	self.inviteText.Text=Text.upper(invite.from).." CHALLENGES YOU"
	local pad=false
	pcall(function() pad=UIS:GetLastInputType().Name:match("^Gamepad")~=nil end)
	local keys=if not pad then "ENTER ACCEPTS  •  BACKSPACE DECLINES" elseif self.phase=="Duel" then "SELECT ACCEPTS" else "A ACCEPTS  •  B DECLINES"
	self.inviteSub.Text=(if def then "WITH "..Text.upper(def.Name).."  •  " else "")..keys
	if pad and self.phase~="Duel" then
		pcall(function() game:GetService("GuiService").SelectedObject=self.acceptButton end)
	end
	self:tickTimer()
end
function Panel:tickTimer()
	local invite=self.invite
	if not invite then return end
	local left=invite.until_-os.clock()
	if left&lt;=0 then self.invite=nil;self:drawInvite();return end
	self.timer.Size=UDim2.new(math.clamp(left/invite.length,0,1),0,0,4)
end
function Panel:drawList()
	local K,P=self.kit,self.kit.palette
	-- (Audit 04/11) the list refreshes every second: rebuilt only when it
	-- changed, else the pad's selected CHALLENGE button was destroyed under it.
	local parts={tostring(self.dnd)}
	for _,e in self.players do
		table.insert(parts,table.concat({tostring(e.id),tostring(e.name),tostring(e.state),tostring(e.fighter),tostring(e.dnd),tostring(e.pending),tostring(e.friend),tostring(e.here),tostring(self.blocked[e.id])},"|"))
	end
	local signature=table.concat(parts,";")
	if signature==self.listSignature and #self.rows&gt;0 then return end
	self.listSignature=signature
	local GuiService=game:GetService("GuiService")
	local selectedIndex
	pcall(function()
		local selected=GuiService.SelectedObject
		for i,b in self.rowButtons or {} do if b==selected then selectedIndex=i end end
	end)
	for _,row in self.rows do row:Destroy() end
	table.clear(self.rows)
	self.rowButtons={}
	local shown=0
	local free=0
	for _,e in self.players do
		if self.blocked[e.id] then continue end
		shown+=1
		local available=(e.state=="free" or e.state=="training" or e.state=="queue" or e.state=="cup") and not e.dnd
		if available then free+=1 end
		local row=K.frame(self.list,UDim2.fromOffset(0,(shown-1)*64),UDim2.fromOffset(696,58),P.panel,.15)
		K.corner(row,6);row.ZIndex=73
		local def=Fighters[e.fighter or ""]
		local accent=if def then Color3.fromRGB(table.unpack(def.Color)) else P.muted
		local bar=K.frame(row,UDim2.fromOffset(0,0),UDim2.new(0,6,1,0),accent,0);bar.ZIndex=74
		local name=K.text(row,(if e.friend then "★ " else "")..Text.upper(e.name),UDim2.fromOffset(18,6),UDim2.fromOffset(340,28),24,P.paper,K.TITLE_FONT)
		name.ZIndex=74;name.TextScaled=true;K.create("UITextSizeConstraint",name,{MaxTextSize=24})
		local info=(if def then Text.upper(def.Name).."  •  " else "")..(if e.dnd then "DO NOT DISTURB" else STATE[e.state] or "")..(if e.here then "  •  THIS SERVER" else "")
		local sub=K.text(row,info,UDim2.fromOffset(18,34),UDim2.fromOffset(440,18),12,P.muted,K.BODY_FONT);sub.ZIndex=74
		local label=if e.pending then "SENT…" elseif available then "CHALLENGE" else "BUSY"
		local b=K.button(row,label,UDim2.fromOffset(500,8),UDim2.fromOffset(186,42),function()
			if available and not e.pending then self:send({op="challenge",to=e.id,fighter=self.ui.player}) end
		end,if available and not e.pending then P.red else nil)
		b.ZIndex=74;b.AutoButtonColor=available
		if not available or e.pending then b.TextColor3=P.muted end
		table.insert(self.rows,row)
		table.insert(self.rowButtons,b)
	end
	-- the pad's selection back on the same row (or the last one)
	if selectedIndex then
		local b=self.rowButtons[math.min(selectedIndex,#self.rowButtons)]
		pcall(function() GuiService.SelectedObject=b or self.closeButton end)
	end
	self.list.CanvasSize=UDim2.fromOffset(0,shown*64)
	self.empty.Visible=shown==0
	self.subtitle.Text=if shown==0 then "" else string.format("%d ONLINE  •  %d READY FOR A DUEL  •  FRIENDS FIRST",shown,free)
	self.dndButton.Text="DO NOT DISTURB: "..(if self.dnd then "ON" else "OFF")
	self.button.Text=if shown&gt;0 then string.format("PLAYERS ONLINE  •  %d",shown) else "PLAYERS ONLINE"
end
-- Called with every game packet: the button lives on the roster only; the
-- list closes when a duel or a pick starts.
function Panel:render(data)
	self.phase=data.phase
	self.button.Visible=data.phase=="Selection" and not self.ui.simple
	if self.open and data.phase~="Selection" then self:toggle(false) end
end
return Panel
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="ND220">
          <Properties>
            <string name="Name">Main</string>
            <ProtectedString name="Source">local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local player=Players.LocalPlayer
local shared=game:GetService("ReplicatedStorage"):WaitForChild("NinjaDuel")
local remote=shared:WaitForChild("Action")
pcall(function() game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Health,false); game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Chat,false); game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList,false) end)
-- (Audit B01) Key names as printed on this keyboard (AZERTY: ZQSD to move,
-- A to dodge), before any text that names a key is built.
pcall(function()
	local UIS=game:GetService("UserInputService")
	require(shared:WaitForChild("Controls")).useLayout(function(code) return UIS:GetStringForKeyCode(code) end)
end)
local UI=require(script.Parent.UI)
local Input=require(script.Parent.Input)
local TouchControls=require(script.Parent.TouchControls)
local Camera=require(script.Parent.Camera)
local Presentation=require(script.Parent.Presentation)
local presentation=Presentation.new()
local camera=Camera.new(); local current={phase="Selection",epoch=0}; local ui; local input
camera.presentation=presentation
local mouse=player:GetMouse()
-- (Debug places) Flight recorder, client half: every packet sent, the
-- presses the client itself let go of (Input.dropped) and slow frames, kept
-- on the player as the attribute NdFlightClient (JSON, refreshed each second).
local flight=nil
if workspace:GetAttribute("NinjaDuelDebug")==true then
	flight={sent={},frames={},started=os.clock()}
	Input.dropped={}
	local HttpService=game:GetService("HttpService")
	local worst,count,sum,since=0,0,0,os.clock()
	RunService.Heartbeat:Connect(function(dt)
		worst=math.max(worst,dt);count+=1;sum+=dt
		local now=os.clock()
		if now-since&gt;=1 then
			table.insert(flight.frames,{t=math.floor((now-flight.started)*10)/10,fps=math.floor(count/(now-since)),worst=math.floor(worst*1000)})
			while #flight.frames&gt;90 do table.remove(flight.frames,1) end
			worst,count,sum,since=0,0,0,now
			local dropped={}
			for _,d in Input.dropped do table.insert(dropped,{t=math.floor((d.t-flight.started)*100)/100,name=d.name,why=d.why}) end
			pcall(function() player:SetAttribute("NdFlightClient",HttpService:JSONEncode({sent=flight.sent,frames=flight.frames,dropped=dropped,now=math.floor((now-flight.started)*100)/100})) end)
		end
	end)
end
local function send(action,extra)
	if flight and action~="Move" then
		table.insert(flight.sent,{t=math.floor((os.clock()-flight.started)*100)/100,a=action,phase=current.phase})
		while #flight.sent&gt;120 do table.remove(flight.sent,1) end
	end
	local payload={action=action,epoch=current.epoch}
	if current.phase=="Duel" and action~="Move" then
  payload.clientTime=workspace:GetServerTimeNow()
  -- Sample intent at the press, not at the previous 80 ms movement tick.
  if input then payload.direction=input:direction(workspace.CurrentCamera);payload.sprint=input.sprinting end
 end
	if action=="Move" then payload.direction=extra; payload.locked=camera.locked; payload.sprint=input and input.sprinting or false
		-- (DEC-031) Free with the mouse: the body faces where the player looks
		-- (shift lock). Free with the pad (user 03/11, his own play: strikes
		-- thrown at the air behind him): the body faces where it goes, and the
		-- blows turn to the opponent (Combat soft lock).
		-- (B1) only the player's own lens: not the round's intro, a K.O. or an
		-- ultimate's sequence (the body turned its back to follow the intro).
		if not camera.locked and not (input and (input.pad or input.touch)) and camera:steers(current) then
			local look=workspace.CurrentCamera.CFrame.LookVector*Vector3.new(1,0,1)
			if look.Magnitude&gt;.05 then payload.look=look.Unit end
		elseif not camera.locked then payload.look=false end
	elseif type(extra)=="table" then for k,v in extra do payload[k]=v end
	-- (Audit 04/11) the seal jutsu aim too (Minato's trap goes where he points).
	elseif action=="Tool" or string.match(action,"^Technique") or string.match(action,"^Seal%d") then
		local gamepad=input and (input.pad or input.touch)
		mouse.TargetFilter=player.Character
		local hit=if gamepad and current.bot then current.bot.position else mouse.Hit.Position
		if gamepad and action=="Technique1" and current.human and current.human.fighterId=="Flashstep" then hit-=Vector3.new(0,2.8,0) end
		local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and (hit-root.Position).Magnitude&lt;=140 then payload.aim=hit end
	end
	remote:FireServer(payload)
	-- (Audit 04/11) watching a tournament match: the body is the AI's, no guess.
	if current.phase=="Duel" and not current.spectate and (action=="Attack" or action=="Heavy") then presentation:predictStrike(action,current) end
	if current.phase=="Duel" and not current.spectate and (action=="Dodge" or action=="Jump" or action=="PadJump") then presentation:predictMove(action,current) end
end
ui=UI.new(player:WaitForChild("PlayerGui"),send)
-- (04/11) Players online and challenges between them (Server/Lobby).
local lobbyPanel=nil
pcall(function() lobbyPanel=require(script.Parent.LobbyPanel).new(ui,shared:WaitForChild("Lobby",20),UI.kit) end)
-- (04/11) The Prodigy Tournament: bracket, spectator banner, champion (Server/Tournament).
local cupScreen=require(script.Parent.CupScreen).new(ui,send,UI.kit)
-- (B1 lot 3) the controls sheet's EFFECTS switch also calms the lens.
ui.onEffects=function(low) camera.calm=low end
-- The roster's fighters stand in a 3D set the menu camera films (Client/MenuStage).
if ui.menuStage then camera.menuShot=function() return ui.menuStage:shot() end end
-- Debug/QA places only: the Studio dev panel (F6, DevClient). While it is open
-- Input sees a non-Duel state, so no combat binding fires behind the panel.
local dev
input=Input.new(send,function() return if dev and dev.panelOpen then dev.blocked else current end,function() camera:setLocked(not camera.locked);send("Move",input:direction(workspace.CurrentCamera)) end,camera)
-- (Audit 04/11) phones and tablets: their own controls (none existed).
local touch=nil
pcall(function()
	touch=TouchControls.new(input,send,function() return current end,function() camera:setLocked(not camera.locked);send("Move",input:direction(workspace.CurrentCamera)) end,camera)
end)
-- Disable the default movement controller; server receives finite normalized intent.
local playerModule=player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")
require(playerModule):GetControls():Disable()
remote.OnClientEvent:Connect(function(data)
	if data.epoch&lt;(current.epoch or 0) then return end
	if data.epoch~=current.epoch or data.phase~=current.phase then input:resync() end
	-- (05/11, user on the pad) The lock is the player's choice: it used to drop
	-- back to free at every round (each round is a new epoch), and the lens
	-- swapped rigs under him until he pressed R3 again.
	data.gamepad=input.pad
	data.touch=input.touch==true
	data.sealPage=input:sealPage()
	-- (05/11) R1 held on a pad: the jutsu row lights up (what □ △ ○ × will cast).
	data.jutsuPage=input.pad==true and input.modifier==true and not data.sealPage
	-- (05/11) the chakra button held alone (pad L2, keyboard Z): the row names
	-- what it infuses (UI, Shared/ChakraMoves).
	data.chakraPage=if input.pad then input.chakraPad==true and not input.modifier else input.chakra==true and not input.sealKey
	current=data; presentation.receivedAt=os.clock(); presentation:impacts(data,camera); ui:render(data)
	if lobbyPanel then lobbyPanel:render(data) end
	cupScreen:render(data)
	if touch then touch:render(data) end
	if data.phase=="Duel" and data.serverNow then presentation:noteSnapshot(workspace:GetServerTimeNow()-data.serverNow) end
end)
local nextMove=0
local lastDir,lastSprint,lastLook=nil,nil,nil
local lastSentAt=0
RunService:BindToRenderStep("NinjaDuelCamera",Enum.RenderPriority.Camera.Value,function(dt)
	-- Last moment before the frame is drawn: the replicated roots have their
	-- final positions for this frame, so the smoothed bodies and the camera agree.
	presentation:smoothStep(current,dt)
	presentation:update(current,dt)
	camera.menuOpen=(dev~=nil and dev.panelOpen==true)
	mouse.TargetFilter=player.Character
	camera:update(current,dt)
	-- (DEC-030 Partie 1, responsiveness) The stick goes out the frame it
	-- changes, not on the next 80 ms tick (that alone cost up to 80 ms on every
	-- start, stop and turn); the tick stays as a heartbeat.
	if current.phase=="Duel" and current.spectate then
		presentation.inputDir=Vector3.zero;presentation.lead=nil;presentation.prediction=nil
	elseif current.phase=="Duel" then
		local dir=input:direction(workspace.CurrentCamera)
		presentation.inputDir=dir;presentation.inputSprint=input.sprinting
		presentation:observeStick(os.clock())
		local flatLook=workspace.CurrentCamera.CFrame.LookVector*Vector3.new(1,0,1)
		local turned=not camera.locked and camera:steers(current) and flatLook.Magnitude&gt;.05 and (lastLook==nil or (flatLook.Unit-lastLook).Magnitude&gt;.06)
		local changed=lastDir==nil or (dir-lastDir).Magnitude&gt;.15 or input.sprinting~=lastSprint or turned
		if (changed and os.clock()-lastSentAt&gt;=1/30) or os.clock()&gt;=nextMove then
			lastSentAt=os.clock()
			nextMove=os.clock()+0.08;lastDir=dir;lastSprint=input.sprinting
			if flatLook.Magnitude&gt;.05 then lastLook=flatLook.Unit end
			send("Move",dir)
		end
	end
end)
-- Studio-only diagnostics channel (created by the server's DevHooks).
if RunService:IsStudio() then
	task.spawn(function()
		local log=shared:WaitForChild("NinjaDuelDevLog",10) or game:GetService("ReplicatedStorage"):WaitForChild("NinjaDuelDevLog",10)
		if not log then return end
		game:GetService("LogService").MessageOut:Connect(function(message,kind)
			if kind==Enum.MessageType.MessageError or kind==Enum.MessageType.MessageWarning then log:FireServer("log",string.sub(message,1,400)) end
		end)
		-- Smoothness probe: per rendered frame, the apparent acceleration of each
		-- fighter's head (what the eye follows) and root. A visual jump shows up
		-- as an acceleration spike.
		local probe={frames=0,headSpikes=0,rootSpikes=0,headMax=0,rootMax=0}
		local track={}
		local trace={}
		RunService:BindToRenderStep("NinjaDuelProbe",Enum.RenderPriority.Camera.Value+1,function(dt)
			if current.phase~="Duel" or dt&lt;=0 then return end
			local folder=player.Character and player.Character.Parent
			for _,model in {player.Character,Presentation.opponent(current,folder)} do
				for _,partName in {"Head","HumanoidRootPart"} do
					local part=model and model:FindFirstChild(partName)
					if part then
						local key=model.Name..partName
						local st=track[key] or {}
						local p=part.Position
						if model==player.Character and #trace&lt;90 and partName=="Head" then
							local vr=presentation:visualRoot("human")
							local root=model:FindFirstChild("HumanoidRootPart")
							local lt=model:FindFirstChild("LowerTorso")
							local joint=lt and lt:FindFirstChild("Root") or (root and root:FindFirstChild("Root"))
							table.insert(trace,string.format("H%.2f off%.2f lt%.2f tf%.2f",(p-(st.p or p)).Magnitude,vr and root and (vr-root.Position).Magnitude or -1,
								lt and root and (lt.Position-root.Position).Magnitude or -1,joint and joint.Transform.Position.Magnitude or -1))
						end
						if st.p then
							local v=(p-st.p)/dt
							if st.v then
								local acc=(v-st.v).Magnitude/dt
								local head=partName=="Head"
								if head then probe.frames+=1 end
								if acc&gt;900 and v.Magnitude&lt;150 then
									if head then probe.headSpikes+=1 else probe.rootSpikes+=1 end
								end
								if head then probe.headMax=math.max(probe.headMax,acc) else probe.rootMax=math.max(probe.rootMax,acc) end
							end
							st.v=v
						end
						st.p=p;track[key]=st
					end
				end
			end
		end)
		log.OnClientEvent:Connect(function(kind)
			if kind=="probe" then
				local out=table.clone(probe);out.trace=table.concat(trace," ")
				log:FireServer("info",{probe=out})
				probe={frames=0,headSpikes=0,rootSpikes=0,headMax=0,rootMax=0};trace={}
				return
			end
			if kind=="info" then
				local cam=workspace.CurrentCamera
				local gui={}
				local hud=player.PlayerGui:FindFirstChild("NinjaDuelHUD")
				if hud then
					for _,g in hud:GetDescendants() do
						if g:IsA("GuiObject") and #gui&lt;40 and (g.Parent==hud or (g.Parent and g.Parent.Parent==hud)) then
							table.insert(gui,string.format("%s vis=%s pos=%s size=%s",g:GetFullName():sub(-40),tostring(g.Visible),tostring(g.AbsolutePosition),tostring(g.AbsoluteSize)))
						end
					end
				end
				log:FireServer("info",{presented=presentation.presented,camera=cam.CFrame,fov=cam.FieldOfView,focus=camera.focus,mode=camera.mode,boomAngle=camera.boomAngle,distance=camera.distance,viewport=cam.ViewportSize,gui=table.concat(gui," || ")})
			end
		end)
	end)
end
-- The normal build has no DevClient module, so this stays inert there.
local devModule=RunService:IsStudio() and script.Parent:FindFirstChild("DevClient")
if devModule then
	task.spawn(function()
		local ok,err=pcall(function()
			dev=require(devModule).install({player=player,input=input,presentation=presentation,camera=camera,ui=ui,state=function() return current end,send=send})
		end)
		if not ok then warn("[NinjaDuel] dev panel unavailable: "..tostring(err)) end
	end)
end
send("Ready")
print("[NinjaDuel] Client ready")
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND221">
          <Properties>
            <string name="Name">MenuStage</string>
            <ProtectedString name="Source">-- The select screen's two prodigies, in a real 3D set (user 02/11, "everything
-- about the faces is to redo"): a ViewportFrame neither draws the faces
-- (SurfaceGuis, Shared/Face) nor takes more than one light, so the fighters
-- stand in a small closed studio far above the arena, built on this client
-- only: an ink backdrop, the vermilion brush stroke, a key light from each
-- fighter's outer side and a back light in his colour. The menu camera
-- (Client/Camera) films it while the roster shows; Client/UI places the names
-- over it. Presentation only.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local TweenService=game:GetService("TweenService")
local MenuStage={}
MenuStage.__index=MenuStage

local ORIGIN=Vector3.new(0,4200,0)
local INK=Color3.fromRGB(14,12,17)
local FOV=34
local DISTANCE=21
-- The screen fractions where the two stages are (Client/UI's 1600-wide board).
MenuStage.SCREEN_X={player=.21,bot=.79}

local function part(parent,props)
	local p=Instance.new("Part")
	p.Anchored=true;p.CanCollide=false;p.CanQuery=false;p.CanTouch=false;p.CastShadow=false
	p.Material=Enum.Material.SmoothPlastic;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth
	for k,v in props do (p::any)[k]=v end
	p.Parent=parent
	return p
end
local function light(parent,class,at,props)
	local anchor=part(parent,{Name="Light",Size=Vector3.new(.2,.2,.2),Transparency=1,CFrame=at})
	local l=Instance.new(class)
	for k,v in props do (l::any)[k]=v end
	l.Parent=anchor
	return l,anchor
end

function MenuStage.new()
	local self=setmetatable({slots={},visible=false},MenuStage)
	local folder=Instance.new("Folder");folder.Name="NinjaDuelMenuStage";folder.Parent=workspace
	self.folder=folder
	local O=ORIGIN
	-- A closed box: the sun and sky never reach the set.
	part(folder,{Name="Backdrop",Size=Vector3.new(160,70,2),CFrame=CFrame.new(O+Vector3.new(0,10,9)),Color=INK})
	part(folder,{Name="Floor",Size=Vector3.new(160,2,60),CFrame=CFrame.new(O+Vector3.new(0,-3.4,-10)),Color=Color3.fromRGB(20,17,22),Reflectance=.04})
	part(folder,{Name="Roof",Size=Vector3.new(160,2,60),CFrame=CFrame.new(O+Vector3.new(0,30,-10)),Color=INK})
	part(folder,{Name="Back",Size=Vector3.new(160,70,2),CFrame=CFrame.new(O+Vector3.new(0,10,-40)),Color=INK})
	for _,s in {-1,1} do part(folder,{Name="Side",Size=Vector3.new(2,70,60),CFrame=CFrame.new(O+Vector3.new(s*80,10,-10)),Color=INK}) end
	-- The brush stroke behind the two fighters (the menu's red band).
	local band=part(folder,{Name="Stroke",Size=Vector3.new(120,4.2,.2),CFrame=CFrame.new(O+Vector3.new(0,3.2,7.6))*CFrame.Angles(0,0,math.rad(9)),
		Color=Color3.fromRGB(150,30,28),Material=Enum.Material.SmoothPlastic,Transparency=.1})
	part(folder,{Name="StrokeEdge",Size=Vector3.new(120,.6,.2),CFrame=band.CFrame*CFrame.new(0,-1.6,-.05),Color=INK,Transparency=.4})
	self.band=band
	-- One slot per stage: where the fighter stands, his lights. The lights
	-- follow the fighter (MenuStage:placeLights) wherever the screen's shape
	-- puts him.
	for _,side in {"player","bot"} do
		local outer=if side=="player" then -1 else 1
		local slot={side=side,outer=outer,x=-outer*6}
		slot.key,slot.keyAnchor=light(folder,"SpotLight",CFrame.new(O),
			{Brightness=3.6,Range=28,Angle=45,Color=Color3.fromRGB(255,236,214),Shadows=true,Face=Enum.NormalId.Front})
		slot.rim,slot.rimAnchor=light(folder,"SpotLight",CFrame.new(O),
			{Brightness=5,Range=14,Angle=42,Color=Color3.new(1,1,1),Shadows=false,Face=Enum.NormalId.Front})
		slot.fill,slot.fillAnchor=light(folder,"PointLight",CFrame.new(O),{Brightness=.3,Range=10,Color=Color3.fromRGB(150,140,160),Shadows=false})
		slot.glow,slot.glowAnchor=light(folder,"PointLight",CFrame.new(O),{Brightness=.8,Range=7,Color=Color3.new(1,1,1),Shadows=false})
		self.slots[side]=slot
		self:placeLights(slot)
	end
	return self
end

-- A fighter's lights around where he stands: the key from his outer side
-- (away from the middle of the screen), the back light behind him and a
-- little inside, so his inner edge burns in his colour.
function MenuStage:placeLights(slot)
	local at=ORIGIN+Vector3.new(slot.x,0,0)
	local out=if slot.x&gt;=0 then 1 else -1
	slot.keyAnchor.CFrame=CFrame.lookAt(at+Vector3.new(out*7,7,-9),at+Vector3.new(0,2.5,0))
	slot.rimAnchor.CFrame=CFrame.lookAt(at+Vector3.new(-out*2.4,5.5,4.2),at+Vector3.new(0,2.2,-.5))
	slot.fillAnchor.CFrame=CFrame.new(at+Vector3.new(0,1,-6))
	slot.glowAnchor.CFrame=CFrame.new(at+Vector3.new(0,3.5,3))
end
-- The camera's shot of the set (Client/Camera reads it while the roster shows).
function MenuStage:shot()
	-- Aimed low: the heads sit in the upper third, the names under the chests.
	local d=self.distance or DISTANCE
	return CFrame.lookAt(ORIGIN+Vector3.new(0,.55+1.05*d/DISTANCE,-d),ORIGIN+Vector3.new(0,.55,0)),FOV
end
-- Each fighter stands where its stage is on this screen, whatever its shape.
function MenuStage:layout()
	local view=workspace.CurrentCamera.ViewportSize
	local aspect=if view.Y&gt;0 then view.X/view.Y else 16/9
	-- The board (Client/UI) is a 1600x900 canvas scaled to fit and centred:
	-- on a screen narrower than 16:9 it shrinks with the width while the 3D
	-- set would keep its height, and the fighters would cover the names. The
	-- camera steps back by the same factor, so the set scales with the board.
	local scale=math.min(view.X/1600,view.Y/900)
	local fit=if view.Y&gt;0 then math.clamp(scale*900/view.Y,.4,1) else 1
	self.distance=DISTANCE/fit
	local boardShare=if view.X&gt;0 then math.min(1,1600*scale/view.X) else 1
	local halfWidth=self.distance*math.tan(math.rad(FOV)/2)*aspect
	for side,slot in self.slots do
		local f=.5+(MenuStage.SCREEN_X[side]-.5)*boardShare
		-- Screen right is world -X for a camera looking along +Z.
		slot.x=-(f-.5)*2*halfWidth
		self:placeLights(slot)
		if slot.model and not slot.moving then slot.model:PivotTo(self:stand(slot)) end
	end
end
function MenuStage:stand(slot)
	-- Facing the camera (-Z), turned a little toward the middle.
	return CFrame.new(ORIGIN+Vector3.new(slot.x,0,0))*CFrame.Angles(0,math.rad(slot.outer*-18),0)
end

-- `source` (a Server/Portraits model) steps onto the side's stage: he slides
-- in from the outer edge; the back light takes his colour.
function MenuStage:show(side,source,accent,animate)
	local slot=self.slots[side]
	if not slot or not source then return end
	if slot.model then slot.model:Destroy() end
	local model=source:Clone()
	if not model then return end
	model.Parent=self.folder
	slot.model=model
	slot.rim.Color=accent;slot.glow.Color=accent
	local final=self:stand(slot)
	if animate then
		slot.moving=true
		local from=final*CFrame.new(slot.outer*-4,0,0)
		local started=os.clock()
		model:PivotTo(from)
		local token={}
		slot.token=token
		local connection
		connection=RunService.RenderStepped:Connect(function()
			if slot.token~=token or not model.Parent then connection:Disconnect();return end
			local t=math.min(1,(os.clock()-started)/.34)
			local k=1-(1-t)^4
			model:PivotTo(from:Lerp(self:stand(slot),k))
			if t&gt;=1 then slot.moving=false;connection:Disconnect() end
		end)
		-- The back light flares, then settles.
		slot.rim.Brightness=14
		TweenService:Create(slot.rim,TweenInfo.new(.45,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Brightness=5}):Play()
	else
		model:PivotTo(final)
	end
end
-- While the set is filmed the world's ambient is the studio's: low, so the
-- key and the coloured back lights model the bodies; the duel's own lighting
-- comes back the moment the board hides.
-- (Look pass 2) The sky's own light (environment diffuse and specular, the
-- colour shifts) reaches inside the box too and turned every fighter blue:
-- in the studio there is no sky.
local LIGHTING={Ambient=Color3.fromRGB(40,36,46),OutdoorAmbient=Color3.fromRGB(40,36,46),ExposureCompensation=0,Brightness=0,
	EnvironmentDiffuseScale=0,EnvironmentSpecularScale=0,ColorShift_Top=Color3.new(0,0,0),ColorShift_Bottom=Color3.new(0,0,0)}
function MenuStage:filmed(on)
	if on==self.isFilmed then return end
	self.isFilmed=on
	local Lighting=game:GetService("Lighting")
	if on then
		self.savedLighting={}
		for k,v in LIGHTING do self.savedLighting[k]=Lighting[k];Lighting[k]=v end
	elseif self.savedLighting then
		for k,v in self.savedLighting do Lighting[k]=v end
		self.savedLighting=nil
	end
end
-- Idle life: the back lights breathe out of step, the stroke shimmers.
function MenuStage:step(t)
	for side,slot in self.slots do
		if not slot.moving then slot.glow.Brightness=.8+.3*math.sin(t*1.3+(if side=="bot" then 1.6 else 0)) end
	end
	self.band.Transparency=.1+.06*math.sin(t*.9)
end
return MenuStage
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND222">
          <Properties>
            <string name="Name">MotionSmear</string>
            <ProtectedString name="Source">-- Speed smear (fluidity pass, user reference 28/10). What the eye cannot
-- follow is drawn as motion: a body moving faster than a sprint leaves dark
-- translucent copies of its pose along its path and thin speed streaks around
-- it; a body that jumps several studs in one frame (a teleport, a substitution,
-- a flash step) leaves copies interpolated along the line it crossed, so the
-- jump reads as a very fast move, not a cut. Presentation only.
local TweenService=game:GetService("TweenService")
local Debris=game:GetService("Debris")

local Smear={}

local LIMBS={"Head","UpperTorso","LowerTorso","LeftUpperArm","LeftLowerArm","LeftHand","RightUpperArm","RightLowerArm","RightHand",
	"LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperLeg","RightLowerLeg","RightFoot","HairCap"}
local GHOST=Color3.fromRGB(26,26,36)
local SPEED=55 -- studs/s: above a sprint (45); dodge 61, pursuit 74, rush 90
local JUMP=6 -- studs in one frame: a teleport
local CADENCE=1/20
local LIFE=.12
local STREAK_LIFE=.12

type State={pos:Vector3?,at:number?,pose:{[string]:CFrame}?}

local function folder():Instance
	local f=workspace:FindFirstChild("NinjaDuelFX")
	if not f then
		f=Instance.new("Folder");f.Name="NinjaDuelFX";f.Parent=workspace
	end
	return f
end

local function snapshot(model:Model):{[string]:CFrame}
	local out={}
	for _,name in LIMBS do
		local p=model:FindFirstChild(name)
		if p and p:IsA("BasePart") and p.Transparency&lt;.9 then out[name]=p.CFrame end
	end
	return out
end

local function ghost(model:Model,pose:{[string]:CFrame},shift:Vector3,transparency:number,life:number)
	local holder=Instance.new("Model");holder.Name="Smear"
	for name,cf in pose do
		local src=model:FindFirstChild(name)
		if src and src:IsA("BasePart") then
			local g=Instance.new("Part")
			g.Anchored=true;g.CanCollide=false;g.CanQuery=false;g.CanTouch=false;g.CastShadow=false
			g.Material=Enum.Material.SmoothPlastic;g.Color=GHOST
			g.Size=src.Size;g.CFrame=cf+shift
			g.Transparency=transparency
			g.Parent=holder
			TweenService:Create(g,TweenInfo.new(life,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Transparency=1}):Play()
		end
	end
	holder.Parent=folder()
	Debris:AddItem(holder,life+.05)
end

local function streaks(at:Vector3,count:number,direction:Vector3)
	local f=folder()
	for _=1,count do
		local s=Instance.new("Part")
		s.Anchored=true;s.CanCollide=false;s.CanQuery=false;s.CanTouch=false;s.CastShadow=false
		s.Material=Enum.Material.SmoothPlastic;s.Color=GHOST
		local length=2+math.random()*2.2
		s.Size=Vector3.new(.05,length,.05)
		local side=direction:Cross(Vector3.yAxis)
		if side.Magnitude&lt;1e-3 then side=Vector3.xAxis end
		side=side.Unit
		local offset=side*((math.random()-.5)*3.4)+Vector3.new(0,(math.random()-.3)*2.4,0)-direction*(math.random()*1.5)
		s.CFrame=CFrame.new(at+offset)
		s.Transparency=.35
		s.Parent=f
		TweenService:Create(s,TweenInfo.new(STREAK_LIFE,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Transparency=1,Size=Vector3.new(.03,length*1.4,.03)}):Play()
		Debris:AddItem(s,STREAK_LIFE+.05)
	end
end

-- One rendered frame of one body. `st` is the caller's per-body table.
function Smear.step(st:State,model:Model?,dt:number)
	if not model then return end
	local root=model:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) then return end
	local now=os.clock()
	local pos=root.Position
	local pose=snapshot(model)
	if st.pos and st.pose then
		local delta=pos-(st.pos::Vector3)
		local flat=Vector3.new(delta.X,0,delta.Z)
		if delta.Magnitude&gt;JUMP and delta.Magnitude&lt;80 then
			-- A teleport: copies across the gap, fading the farther back they are.
			-- (Partie 0: four dense copies read as a cloud of dark cubes; three
			-- light ones read as a body that crossed the gap.)
			for k=1,3 do
				local u=k/4
				ghost(model,pose,-delta*(1-u),.6+.15*(1-u),LIFE*1.3)
			end
			streaks(pos-delta*.5,6,if flat.Magnitude&gt;.1 then flat.Unit else Vector3.zAxis)
			st.at=now
		elseif delta.Magnitude/math.max(dt,1e-3)&gt;SPEED and now-(st.at or 0)&gt;=CADENCE then
			ghost(model,st.pose::{[string]:CFrame},Vector3.zero,.68,LIFE)
			streaks(pos,2,if flat.Magnitude&gt;.1 then flat.Unit else Vector3.zAxis)
			st.at=now
		end
	end
	st.pos=pos;st.pose=pose
end

-- Thin arcs behind the hands and feet while a strike is out (the reference's
-- fine swing lines): built once per body, lit only during the swing; they
-- only show where a limb moves fast, so a still hand leaves nothing.
local ENDS={RightHand=Vector3.new(0,-.35,0),LeftHand=Vector3.new(0,-.35,0),RightFoot=Vector3.new(0,-.1,-.35),LeftFoot=Vector3.new(0,-.1,-.35)}
function Smear.limbs(st:any,model:Model?,active:boolean)
	if not model then return end
	if st.trailModel~=model then
		st.trailModel=model;st.trails={}
		for name,tip in ENDS do
			local part=model:FindFirstChild(name)
			if part and part:IsA("BasePart") then
				local a0=Instance.new("Attachment");a0.Name="SmearA";a0.Position=tip*.3;a0.Parent=part
				local a1=Instance.new("Attachment");a1.Name="SmearB";a1.Position=tip;a1.Parent=part
				local t=Instance.new("Trail")
				t.Name="SwingArc";t.Attachment0=a0;t.Attachment1=a1
				t.Color=ColorSequence.new(Color3.fromRGB(235,238,245))
				t.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.45),NumberSequenceKeypoint.new(1,1)})
				t.WidthScale=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,.1)})
				t.Lifetime=.11;t.MinLength=.15;t.FaceCamera=true;t.LightEmission=.2
				t.Enabled=false;t.Parent=part
				table.insert(st.trails,t)
			end
		end
	end
	for _,t in st.trails do
		if t.Parent and t.Enabled~=active then t.Enabled=active end
	end
end

return Smear
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND223">
          <Properties>
            <string name="Name">NarutoFX</string>
            <ProtectedString name="Source">-- Naruto on the client (roster wave, several bodies): the puffs of smoke of
-- his shadow clones (appearing, dispelled by one blow, spent after a route,
-- swapped in a substitution, a kunai turning back into one, burnt away by the
-- red chakra), the Rasengan forming between his palm and the clone that
-- shapes it, the Uzumaki Barrage called out (U-ZU-MA-KI), his orange dash,
-- and the Nine-Tails cloak (red chakra, one tail, slit eyes). The clones'
-- bodies themselves are Client/BodyViews. One identity layer installed into
-- Effects (like SandFX and LeeFX). Presentation only.
local Debris=game:GetService("Debris")
local NarutoFX={}
local K -- Effects' helpers, handed over by install()
local Face=require(game:GetService("ReplicatedStorage").NinjaDuel.Face)
local AwakenFX=require(script.Parent.AwakenFX)
NarutoFX.clock=os.clock -- (headless tests drive time)
local NARUTO="Legion"
local SMOKE=Color3.fromRGB(240,240,244)
local CHAKRA=Color3.fromRGB(255,160,70) -- his orange
local BLUE=Color3.fromRGB(110,190,255)
local DEEP=Color3.fromRGB(40,120,255) -- the Rasengan's body (05/11)
local CORE=Color3.fromRGB(235,250,255)
local FOX=Color3.fromRGB(232,64,30) -- the Nine-Tails' red chakra
local FOX_CORE=Color3.fromRGB(255,176,96)
local DUST=Color3.fromRGB(206,194,168)
local function stateOf(fx,model)
	fx.narutoState=fx.narutoState or setmetatable({},{__mode="k"})
	local st=fx.narutoState[model]
	if not st then st={};fx.narutoState[model]=st end
	return st
end
local function puff(fx,at,count,size,color) K.smokePuff(fx.folder,at,color or SMOKE,count,size) end
local function sparks(fx,at,color,count,speed)
	K.burst(fx.folder,at,{Texture=K.TEX.spark,Lifetime=NumberRange.new(.15,.35),Speed=NumberRange.new(speed or 10,(speed or 10)*1.8),SpreadAngle=Vector2.new(180,180),
		Color=ColorSequence.new(color),LightEmission=1,Size=K.num({{0,.45},{1,0}}),Drag=5},count or 10)
end
-- A word called out over the fight (the barrage's syllables).
local function call(fx,at,text,size)
	local holder=K.anchorPart(fx.folder,at)
	holder.Name="UzumakiCall"
	local gui=K.new("BillboardGui",{Size=UDim2.fromOffset(size or 110,(size or 110)*.6),AlwaysOnTop=true,LightInfluence=0},holder)
	K.new("TextLabel",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text=text,TextColor3=CHAKRA,TextStrokeTransparency=0,TextScaled=true,Font=Enum.Font.GothamBlack},gui)
	Debris:AddItem(holder,.8)
	return holder
end

-- ------------------------------------------------------------------ contacts
-- A shadow clone comes or goes: always in a puff of smoke.
local function body(fx,impact)
	if impact.kind~="clone" then return false end
	local at=impact.position
	local phase=impact.phase
	local holder=K.new("Model",{Name="ClonePuff"},fx.folder)
	-- (06/11) A crowd comes and goes in ripples of ten: one puff in three is
	-- heard, the others only seen.
	local heard=not impact.crowd or (impact.body or 0)%3==0
	if phase=="appear" then
		K.flash(holder,at,SMOKE,.6,3.2,.14,.35)
		puff(fx,at,14,2)
		if heard then K.sound(K.anchorPart(fx.folder,at),K.SOUND.whoosh,.3,1.4) end
	elseif phase=="hit" or phase=="blade" or phase=="area" then
		-- One blow and it is gone: a bigger puff and a dry pop.
		K.flash(holder,at,SMOKE,.8,4.4,.16,.25)
		K.shockRing(holder,at,SMOKE,1,7,.22)
		puff(fx,at,22,2.6)
		K.sound(K.anchorPart(fx.folder,at),K.SOUND.hit,.35,1.6)
		fx:cheer(.4)
	elseif phase=="cloak" then
		-- The red chakra burns the clones away.
		K.flash(holder,at,FOX,.8,4,.2,.3)
		puff(fx,at,14,2.2,Color3.fromRGB(255,190,170))
	elseif phase=="transform" then
		-- The kunai was a clone all along.
		K.flash(holder,at,CHAKRA,.4,2.6,.14,.3)
		puff(fx,at,14,2)
		if fx.tumble then fx:tumble("kunai",at,Vector3.yAxis,nil) end
	else
		-- Its time is up, its strike is over, a swap, a flicker.
		puff(fx,at,12,2)
	end
	Debris:AddItem(holder,.5)
	return true
end
-- "It was a clone!": smoke where he was hit, smoke where he comes back (no log).
local function swap(fx,impact)
	puff(fx,impact.position,22,2.4)
	if impact.to then puff(fx,impact.to,8,1.4) end
	K.sound(K.anchorPart(fx.folder,impact.position),K.SOUND.whoosh,.4,1.1)
	return true
end
local function cast(fx,impact,folder)
	local model=folder and folder:FindFirstChild(impact.owner or "")
	local hand=model and model:FindFirstChild("RightHand")
	if impact.technique=="ShadowClone" or impact.technique=="MassShadowClone" then
		-- The cross seal: his chakra flares in his hands.
		if hand then sparks(fx,hand.Position,CHAKRA,if impact.technique=="MassShadowClone" then 18 else 10,8) end
		return true
	elseif impact.technique=="CloneRasengan" then
		if hand then sparks(fx,hand.Position,BLUE,10,6) end
		return true
	end
	return false
end
-- (Jutsu pass 06/11) The fan of cosmetic copies that stood a beat round him
-- is gone: the crowd is real now (Server/Legion massClone), drawn by
-- Client/BodyViews like any clone.
-- (06/11) Taking a clone's body: a streak of his chakra from the body he
-- leaves to the one he takes, a glint at both ends, a quick whoosh. No smoke:
-- nothing puffs away, the two bodies only trade places.
local function bodySwitch(fx,impact)
	local from,to=impact.position,impact.to
	if typeof(to)~="Vector3" then return true end
	local holder=K.new("Model",{Name="BodySwitch"},fx.folder)
	local lift=Vector3.new(0,.6,0)
	local a,b=from+lift,to+lift
	local length=(b-a).Magnitude
	if length&gt;.5 then
		local frame=CFrame.lookAt((a+b)/2,b)
		local core=K.block(holder,Vector3.new(.16,.16,length),frame,CORE,Enum.Material.Neon)
		local glow=K.block(holder,Vector3.new(.55,.55,length),frame,BLUE,Enum.Material.Neon)
		glow.Transparency=.55
		K.tween(core,.22,{Size=Vector3.new(.02,.02,length),Transparency=1})
		K.tween(glow,.26,{Size=Vector3.new(.05,.05,length),Transparency=1})
	end
	K.flash(holder,a,BLUE,.5,2.4,.16,.35)
	K.flash(holder,b,CORE,.35,3,.18,.3)
	sparks(fx,b,BLUE,10,9)
	K.sound(K.anchorPart(fx.folder,b),K.SOUND.whoosh,.35,1.5)
	Debris:AddItem(holder,.5)
	return true
end
-- The Rasengan comes apart: the clone shaping it was struck.
local function broken(fx,impact,folder)
	local model=folder and folder:FindFirstChild(impact.owner or "")
	local hand=model and model:FindFirstChild("RightHand")
	local at=if hand then hand.Position else impact.position
	local holder=K.new("Model",{Name="RasenganBroken"},fx.folder)
	K.flash(holder,at,BLUE,1,3.6,.18,.3)
	sparks(fx,at,BLUE,16,14)
	puff(fx,at,6,1,Color3.fromRGB(200,220,240))
	Debris:AddItem(holder,.4)
	return true
end
-- The release: the sphere bursts forward with him (red in the cloak).
local function release(fx,impact,folder)
	local model=folder and folder:FindFirstChild(impact.owner or "")
	local tone=if impact.cloak then FOX else BLUE
	if model then fx:ghost(model,tone,.25,.5) end
	K.flash(fx.folder,impact.position,tone,1,4,.16,.3)
	return true
end
local function speed(fx,impact,folder)
	-- His dash: an orange afterimage and the dust his feet throw up.
	local model=folder and folder:FindFirstChild(impact.owner or "")
	if model then fx:ghost(model,CHAKRA,.22,.55) end
	puff(fx,impact.position-Vector3.new(0,2.6,0),10,1.5,DUST)
	K.sound(K.anchorPart(fx.folder,impact.position),K.SOUND.whoosh,.4,1.05)
	return true
end
local function awaken(fx,impact,folder)
	-- The Nine-Tails chakra boils out of him (04/11, the user: "l'éveil de
	-- Naruto, c'est un peu léger"): a column of red chakra tears up out of the
	-- floor through the top of the frame, tongues of it lash out round him,
	-- the floor cracks red, two rings (the second a beat after the first) and
	-- a roar under the blast.
	local at=impact.position
	local floorY=at.Y-2.6
	local model=folder and folder:FindFirstChild(impact.owner or "")
	if model then fx:ghost(model,FOX,.55,.25) end
	local burstModel=K.new("Model",{Name="FoxBurst"},fx.folder)
	K.flash(burstModel,at,FOX_CORE,2,12,.32,.05)
	K.flash(burstModel,at,FOX,4,22,.55,.3)
	-- The column: an outer red shell and a hot core, rising and thinning out.
	for _,layer in {{FOX,5.2,8,.2},{FOX_CORE,2.4,3.6,.05}} do
		local col=K.block(burstModel,Vector3.new(2,layer[2],layer[2]),CFrame.new(at.X,floorY+1,at.Z)*CFrame.Angles(0,0,math.pi/2),layer[1],Enum.Material.Neon)
		col.Shape=Enum.PartType.Cylinder;col.Name="FoxPillar";col.Transparency=layer[4]
		K.tween(col,.55,{Size=Vector3.new(30,layer[3],layer[3]),CFrame=CFrame.new(at.X,floorY+15,at.Z)*CFrame.Angles(0,0,math.pi/2),Transparency=1})
	end
	-- Tongues of chakra whipped out round him, curling up.
	for k=0,7 do
		local a=k/8*math.pi*2+math.random()*.3
		local out=Vector3.new(math.cos(a),0,math.sin(a))
		local from=at+out*.8
		local tongue=K.block(burstModel,Vector3.new(.5,.5,2.6),CFrame.lookAt(from,from+out+Vector3.new(0,.3,0)),FOX,Enum.Material.Neon)
		tongue.Name="FoxTongue";tongue.Transparency=.15
		local to=at+out*(7+math.random()*2.5)+Vector3.new(0,2.5+math.random()*3,0)
		K.tween(tongue,.42,{CFrame=CFrame.lookAt(to,to+out+Vector3.new(0,1,0)),Size=Vector3.new(.12,.12,4.2),Transparency=1})
	end
	Debris:AddItem(burstModel,.8)
	-- The floor cracked red under him.
	local crack=K.new("Model",{Name="FoxCrack"},fx.folder)
	for k=0,6 do
		local a=k/7*math.pi*2+math.random()*.5
		local line=K.block(crack,Vector3.new(.16,.06,3.4+math.random()*1.6),CFrame.new(at.X,floorY+.05,at.Z)*CFrame.Angles(0,a,0)*CFrame.new(0,0,-2.2),FOX,Enum.Material.Neon)
		line.Transparency=.1
	end
	task.delay(.6,function() for _,d in crack:GetChildren() do K.tween(d,.7,{Transparency=1}) end end)
	Debris:AddItem(crack,1.5)
	K.shockRing(fx.folder,Vector3.new(at.X,floorY,at.Z),FOX,3,28,.5)
	task.delay(.14,function() K.shockRing(fx.folder,Vector3.new(at.X,floorY+.4,at.Z),FOX_CORE,4,36,.55) end)
	puff(fx,Vector3.new(at.X,floorY+.4,at.Z),28,3,Color3.fromRGB(214,180,170))
	sparks(fx,at,FOX_CORE,26,26)
	local anchor=K.anchorPart(fx.folder,at)
	K.sound(anchor,K.SOUND.boom,.6,.7)
	K.sound(anchor,K.SOUND.heavy,.55,.5)
	Debris:AddItem(anchor,3)
	fx:cheer(1)
	return true
end
local function impact(fx,data,folder)
	local style=data.style
	if style=="body" then return body(fx,data) end
	if data.fighter~=NARUTO then return false end
	if style=="substitute" and data.mode=="clone" then return swap(fx,data) end
	if style=="bodyswitch" then return bodySwitch(fx,data) end
	if style=="cast" then return cast(fx,data,folder) end
	if style=="rasengan" then return broken(fx,data,folder) end
	if style=="burst" then return release(fx,data,folder) end
	if style=="uzumaki" then
		call(fx,data.position+Vector3.new(0,2.6,0),data.syllable or "U")
		K.shockRing(fx.folder,data.position,CHAKRA,1,8,.2)
		return true
	end
	if style=="chase" or style=="afterimage" then return speed(fx,data,folder) end
	if style=="awaken" then return awaken(fx,data,folder) end
	return false
end

-- ------------------------------------------------------------------ per frame
-- The Rasengan forming in his palm through the channel, chakra drawn in from
-- the clone at his right side; the thrust itself is Effects' sphere (red in
-- the cloak).
local function rasengan(fx,model,actor,st)
	local forming=actor.castId=="CloneRasengan" and (actor.state=="TechniqueChannel" or actor.state=="TechniqueActive") and (actor.health or 1)&gt;0
	local hand=model:FindFirstChild("RightHand")
	local cloak=(actor.awaken or 0)&gt;0
	if forming and hand then
		if not (st.orb and st.orb.Parent) then
			-- (Jutsu pass 05/11, the reel: a white blob) A small pale core, a
			-- deep blue glass body and a ForceField churn over it: the sphere
			-- reads blue at the duel camera's distance (two neon balls bloomed
			-- into white).
			local holder=K.new("Model",{Name="RasenganForming"},fx.folder)
			local core=K.block(holder,Vector3.one*.3,hand.CFrame,CORE,Enum.Material.Neon);core.Shape=Enum.PartType.Ball
			local shell=K.block(holder,Vector3.one,hand.CFrame,DEEP,Enum.Material.Glass);shell.Shape=Enum.PartType.Ball;shell.Transparency=.35;shell.Reflectance=.2
			local churn=K.block(holder,Vector3.one,hand.CFrame,BLUE,Enum.Material.ForceField);churn.Shape=Enum.PartType.Ball
			-- the VFX Studio spiral turning inside it (as Effects' sphere)
			local at=K.new("Attachment",{},core)
			if K.TEX and K.TEX.swirl then
				K.new("ParticleEmitter",{Name="Spiral",Texture=K.TEX.swirl,Rate=24,Lifetime=NumberRange.new(.18,.26),Speed=NumberRange.new(0,0),
					Color=ColorSequence.new(Color3.fromRGB(170,215,255),Color3.fromRGB(70,140,255)),LightEmission=.7,LightInfluence=0,
					Size=K.num({{0,1.1},{1,1.6}}),Transparency=K.num({{0,.15},{.6,.35},{1,1}}),Rotation=NumberRange.new(0,360),
					RotSpeed=NumberRange.new(-1100,-800),LockedToPart=true,ZOffset=.6},at)
			end
			st.orb=holder;st.core=core;st.shell=shell;st.churn=churn;st.born=NarutoFX.clock();st.wisp=nil
		end
		local t=NarutoFX.clock()-st.born
		local grow=math.clamp(t/.45,.25,1)
		local center=hand.CFrame*CFrame.new(0,-.7,-.35)
		st.core.CFrame=center;st.core.Size=Vector3.one*.36*grow;st.core.Color=if cloak then FOX_CORE else CORE
		st.shell.CFrame=center;st.shell.Size=Vector3.one*1.1*grow;st.shell.Color=if cloak then FOX else DEEP
		st.churn.CFrame=center*CFrame.Angles(t*6,t*9,0);st.churn.Size=Vector3.one*1.55*grow*(1+math.sin(t*40)*.05);st.churn.Color=if cloak then FOX else BLUE
		local root=model:FindFirstChild("HumanoidRootPart")
		local beat=math.floor(t*30)
		if not cloak and root and beat~=st.wisp then
			st.wisp=beat
			local from=(root.CFrame*CFrame.new(1.6,.4,-.9)).Position
			local wisp=K.block(fx.folder,Vector3.new(.08,.08,1.2),CFrame.lookAt(from,center.Position),BLUE,Enum.Material.Neon)
			wisp.Name="RasenganWisp";wisp.Transparency=.3
			K.tween(wisp,.14,{CFrame=CFrame.lookAt(center.Position,center.Position+(center.Position-from)),Transparency=1,Size=Vector3.new(.03,.03,.4)})
			Debris:AddItem(wisp,.16)
		end
	elseif st.orb then
		st.orb:Destroy();st.orb=nil
	end
	local sphere=fx.rasengan and fx.rasengan[model]
	if sphere and cloak then
		-- (Jutsu pass 05/11) Effects' sphere has no bands since its 05/11 rework
		-- (streaks instead): iterating sphere.bands raised in the cloak.
		sphere.core.Color=FOX_CORE;sphere.shell.Color=FOX
		if sphere.glow then sphere.glow.Color=FOX end
		for _,band in sphere.bands or {} do band.Color=FOX_CORE end
	end
end
-- The Nine-Tails cloak: the shared mantle burns red and the version-one cloak
-- covers him (04/11, "un peu léger" before: four small balls for a tail). A
-- shroud of red chakra a size up on every limb (a ForceField shell: it boils),
-- two pointed ears on the head, one long tail lashing from the hips, bubbles
-- of chakra rising off him, the eyes red; his dash trail is his orange.
local SHROUD={"Head","UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm","LeftLowerArm","RightLowerArm","LeftHand","RightHand",
	"LeftUpperLeg","RightUpperLeg","LeftLowerLeg","RightLowerLeg","LeftFoot","RightFoot"}
local TAIL=10
local function shroud(fx,model)
	local holder=K.new("Model",{Name="FoxShroud"},fx.folder)
	local torsoShell
	for _,name in SHROUD do
		local p=model:FindFirstChild(name)
		if p and p:IsA("BasePart") then
			local head=name=="Head"
			local size=if head then Vector3.one*math.max(p.Size.X,p.Size.Y,p.Size.Z)*1.3 else p.Size*1.14+Vector3.one*.12
			local s=K.block(holder,size,p.CFrame,FOX,Enum.Material.ForceField)
			if head then s.Shape=Enum.PartType.Ball end
			s.Name="FoxShell";s.Anchored=false;s.Massless=true
			K.new("WeldConstraint",{Part0=p,Part1=s},s)
			if name=="UpperTorso" then torsoShell=s end
		end
	end
	local head=model:FindFirstChild("Head")
	if head then
		local r=math.max(head.Size.X,head.Size.Y)*.5
		for _,side in {-1,1} do
			-- (a wedge's sharp corner is its top back: the ear points up and back)
			local ear=K.block(holder,Vector3.new(.18,.8,.5),head.CFrame*CFrame.new(side*r*.62,r*1.12,.1)*CFrame.Angles(math.rad(-8),0,math.rad(-side*18)),FOX,Enum.Material.ForceField,"WedgePart")
			ear.Name="FoxEar";ear.Transparency=0;ear.Anchored=false;ear.Massless=true -- (lot 3: the shell's boiling chakra, not plain Neon)
			K.new("WeldConstraint",{Part0=head,Part1=ear},ear)
		end
	end
	if torsoShell then
		K.new("ParticleEmitter",{Name="FoxBubbles",Texture=K.TEX.glow,Rate=36,Lifetime=NumberRange.new(.45,.85),Speed=NumberRange.new(.8,2.4),SpreadAngle=Vector2.new(180,180),
			Acceleration=Vector3.new(0,6,0),Color=ColorSequence.new(FOX_CORE,FOX),LightEmission=.8,LightInfluence=0,
			Size=K.num({{0,.2},{.4,.65},{1,0}}),Transparency=K.num({{0,.3},{1,1}})},torsoShell)
	end
	return holder
end
local function cloak(fx,model,actor,st)
	local aura=fx.auras and fx.auras[model]
	local open=(actor.awaken or 0)&gt;0 and (actor.health or 1)&gt;0
	if aura and aura.mantle and aura.foxMantle~=aura.mantle then
		aura.mantle.emitter.Color=ColorSequence.new(FOX);aura.mantle.light.Color=FOX;aura.foxMantle=aura.mantle
	end
	if aura and aura.trail and not aura.foxTrail then aura.trail.Color=ColorSequence.new(CHAKRA);aura.foxTrail=true end
	local hips=model:FindFirstChild("LowerTorso") or model:FindFirstChild("HumanoidRootPart")
	if open and hips and not (st.tail and st.tail.Parent) then
		local tail=K.new("Model",{Name="FoxTail"},fx.folder)
		local parts={}
		for k=1,TAIL do
			local u=(k-1)/(TAIL-1)
			local p=K.block(tail,Vector3.one*(1.05-u*.7),hips.CFrame,if k==TAIL then FOX_CORE else FOX,Enum.Material.Neon)
			p.Shape=Enum.PartType.Ball;p.Transparency=.1+u*.35
			-- (Lot 3, 08/11: a row of plain Neon balls read as an old Roblox
			-- game, VFX bible) the tail is drawn as red chakra burning along
			-- the same line; the balls only carry the flame.
			p.Transparency=1
			AwakenFX.emitter(p,"flame",{Rate=14-u*6,Lifetime=NumberRange.new(.22,.36),Speed=NumberRange.new(.2,.8),Acceleration=Vector3.new(0,3,0),
				Color=ColorSequence.new(Color3.fromRGB(255,120,70)),LightEmission=.45,
				Size=NumberSequence.new({NumberSequenceKeypoint.new(0,2.6-u*1.4),NumberSequenceKeypoint.new(1,.5)}),
				Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.2),NumberSequenceKeypoint.new(1,1)})})
			table.insert(parts,p)
		end
		st.tail=tail;st.tailParts=parts
		st.shroud=shroud(fx,model)
		st.irises={}
		for _,p in model:GetChildren() do
			if p.Name=="Iris" then
				table.insert(st.irises,{part=p,color=p.Color,material=p.Material})
				-- (the clones copied from him read these to start with his own eyes)
				pcall(function() p:SetAttribute("NDIrisColor",p.Color);p:SetAttribute("NDIrisMaterial",p.Material.Name) end)
				p.Color=FOX;p.Material=Enum.Material.Neon
			end
		end
		-- The drawn face: red slit eyes.
		st.face=st.face or Face.find(model)
		Face.tint(st.face,FOX,"fox")
	elseif not open and st.tail then
		st.tail:Destroy();st.tail=nil
		if st.shroud then
			-- the shroud burns off rather than vanishing
			for _,d in st.shroud:GetDescendants() do
				if d:IsA("BasePart") then K.tween(d,.3,{Transparency=1}) elseif d:IsA("ParticleEmitter") then d.Enabled=false end
			end
			st.shroud.Name="FoxShroudFading"
			Debris:AddItem(st.shroud,.6)
			st.shroud=nil
		end
		for _,iris in st.irises or {} do iris.part.Color=iris.color;iris.part.Material=iris.material end
		st.irises=nil
		if st.face then Face.tint(st.face,nil) end
		-- (Performance review 04/11) the face points back at its model: kept
		-- in the weak table, it kept the model alive after the duel.
		st.face=nil
	end
	if st.tail and hips then
		-- One long tail: thick at the hips, rising behind him, a wave running
		-- down it from the root to the tip (the tip lashes widest).
		local t=NarutoFX.clock()
		for k,p in st.tailParts do
			local u=(k-1)/(TAIL-1)
			local side=math.sin(t*5.2-k*.55)*(.15+u*1.25)
			local lift=.1+u^1.35*3.1+math.sin(t*3.1-k*.4)*.3*u
			local back=.55+u*3.0-u^2*.6
			p.CFrame=hips.CFrame*CFrame.new(side,lift,back)
		end
	end
end
-- Naruto Rendan: the last syllable called as the heel comes down.
local function rendan(fx,model,actor,st)
	if actor.attackVariant~="NarutoRendan" or actor.state~="Startup" then return end
	local serial=actor.attackSerial or 0
	if st.rendan==serial then return end
	st.rendan=serial
	local root=model:FindFirstChild("HumanoidRootPart")
	if root then call(fx,root.Position+Vector3.new(0,3.4,0),"KI!",150) end
end
local function fighter(fx,model,actor,dt)
	if not model or not actor or actor.fighterId~=NARUTO then return end
	local st=stateOf(fx,model)
	rasengan(fx,model,actor,st)
	cloak(fx,model,actor,st)
	rendan(fx,model,actor,st)
end

function NarutoFX.install(FX,kit)
	K=kit
	table.insert(FX.layers,{name="Naruto",impact=impact,fighter=fighter})
end
return NarutoFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND224">
          <Properties>
            <string name="Name">PerceptionFX</string>
            <ProtectedString name="Source">-- (06/11, « leur Sharingan sert à quelque chose ; un truc qui va trop vite,
-- on le voit avec le Sharingan ») What the viewer's eyes make of a fighter
-- under a speed jutsu (Shared/Sight decides who is fast and who reads it).
--
--   Ordinary eyes: the fast body is not drawn at all while it moves or
--   strikes. In its place, a scrawl of black ink lines that boils twenty
--   times a second around where it is and where it just was. The wind-up of
--   a strike is invisible: that is the point, the guard has to be guessed.
--
--   Sharingan eyes: the body stays sharp; its last positions trail behind it
--   as translucent afterimages (crimson to violet), and the strike to come
--   shows as a red ghost where it will land, from its wind-up.
--
-- Only the opponent's body is read this way (data.bot); a viewer sees his own
-- body as usual. Cosmetic on this client only: the server rule is the AI's
-- (Server/AI reads Sight too). In Studio, workspace attribute NDSight forces
-- the eyes for filming: "normal", "sharingan" or "off".
local RunService=game:GetService("RunService")
local Sight=require(game:GetService("ReplicatedStorage").NinjaDuel.Sight)

local PerceptionFX={}
local K

local INK=Color3.fromRGB(0,0,0)
local NEAR=Color3.fromRGB(128,24,38)
local FAR=Color3.fromRGB(58,52,112)
local FORESIGHT=Color3.fromRGB(176,18,30)
local STROKES=56
local BOIL=1/20
local GHOSTS=4
local SPACING=.075
local HISTORY=.45
local MAX_GHOST_PARTS=26

-- The one body being read, and everything drawn for it.
local S=nil

local function forced()
	if not RunService:IsStudio() then return nil end
	local value=workspace:GetAttribute("NDSight")
	return if type(value)=="string" and value~="" then value else nil
end

-- Hide (1) or restore (0) one drawable piece of the body. The face and the
-- emblems are SurfaceGuis, which a part's transparency does not hide: they
-- are switched off and given back their own setting.
local guiWas=setmetatable({},{__mode="k"})
local function setLocal(object,value)
	if object:IsA("LayerCollector") then
		if value&gt;0 then
			if guiWas[object]==nil then guiWas[object]=object.Enabled end
			object.Enabled=false
		elseif guiWas[object]~=nil then
			object.Enabled=guiWas[object];guiWas[object]=nil
		end
		return
	end
	pcall(function() object.LocalTransparencyModifier=value end)
end

-- The body's drawable pieces: parts (the root excluded) and what is drawn on
-- or from them (face decals, aura emitters, trails, beams).
local function collect(model)
	local parts,others={},{}
	for _,d in model:GetDescendants() do
		if d:IsA("BasePart") then
			if d.Name~="HumanoidRootPart" then table.insert(parts,d) end
		elseif d:IsA("Decal") or d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") or d:IsA("SurfaceGui") or d:IsA("BillboardGui") then
			table.insert(others,d)
		end
	end
	return parts,others
end
-- The pieces an afterimage copies: the solid ones that make the silhouette.
local function silhouette(parts)
	local list={}
	for _,p in parts do
		if p.Transparency&lt;.85 and p.Size.Magnitude&gt;.35 then table.insert(list,p) end
	end
	table.sort(list,function(a,b) return a.Size.Magnitude&gt;b.Size.Magnitude end)
	while #list&gt;MAX_GHOST_PARTS do table.remove(list) end
	return list
end

local function release()
	if not S then return end
	for object in S.hidden do if object.Parent then setLocal(object,0) end end
	if S.holder then S.holder:Destroy() end
	S=nil
end

local function holderOf(fx)
	if S.holder and S.holder.Parent then return S.holder end
	local holder=Instance.new("Folder");holder.Name="Sight";holder.Parent=fx.folder
	S.holder=holder;S.strokes=nil;S.ghosts=nil;S.foresight=nil
	return holder
end

-- ---------------------------------------------------------------- the body
local function hideBody()
	for _,list in {S.parts,S.others} do
		for _,object in list do
			if not S.hidden[object] and object.Parent then S.hidden[object]=true end
			setLocal(object,1)
		end
	end
end
local function showBody()
	for object in S.hidden do if object.Parent then setLocal(object,0) end end
	table.clear(S.hidden)
end

-- --------------------------------------------------------------- the ink
local function strokes(fx)
	local holder=holderOf(fx)
	if S.strokes then return S.strokes end
	local list={}
	for i=1,STROKES do
		-- Neon black: pure ink whatever the light (a lit plastic stick turns grey).
		local p=K.block(holder,Vector3.new(.08,.08,1),CFrame.new(),INK,Enum.Material.Neon)
		p.Name="Ink";p.Transparency=1
		list[i]=p
	end
	S.strokes=list
	return list
end
local function hideInk()
	for _,p in S.strokes or {} do p.Transparency=1 end
end
local function sample(age)
	local want=os.clock()-age
	local best=nil
	for i=#S.history,1,-1 do
		best=S.history[i]
		if best.t&lt;=want then break end
	end
	return best
end
local function drawInk(fx,velocity,dt)
	local list=strokes(fx)
	S.boil=(S.boil or 0)-dt
	if S.boil&gt;0 then return end
	S.boil=BOIL
	local rng=S.rng
	local flat=Vector3.new(velocity.X,0,velocity.Z)
	local moving=flat.Magnitude&gt;6
	local along=if moving then flat.Unit else Vector3.xAxis
	local n=#S.ghostSrc
	if n==0 then hideInk();return end
	for i,p in list do
		-- Two in three on the body as it is, the rest on where it just was.
		local past=i&gt;STROKES*.74
		local frame=if past then sample(.04+rng:NextNumber()*.18) else nil
		-- Bigger pieces of the body get more lines (the torso, not a lock of hair).
		local roll,index=rng:NextNumber()*S.weight[n],n
		for k=1,n do if roll&lt;=S.weight[k] then index=k;break end end
		local src=S.ghostSrc[index]
		local cf=if frame and frame.cf[index] then frame.cf[index] else src.CFrame
		local size=src.Size
		local center=cf*Vector3.new((rng:NextNumber()-.5)*size.X,(rng:NextNumber()-.5)*size.Y,(rng:NextNumber()-.5)*size.Z)
		-- Mostly upright hatching (a pen scrawling the body over and over),
		-- some lines dragged along the motion.
		local dir
		if moving and rng:NextNumber()&lt;.3 then
			dir=(along+Vector3.new(0,(rng:NextNumber()-.5)*.5,0)).Unit
		else
			dir=CFrame.Angles((rng:NextNumber()-.5)*.55,rng:NextNumber()*math.pi*2,(rng:NextNumber()-.5)*.55):VectorToWorldSpace(Vector3.yAxis)
		end
		local length=(if past then .5 else .7)+rng:NextNumber()*(if past then 1.2 else 1.7)
		local thick=(if past then .04 else .05)+rng:NextNumber()*.06
		p.Size=Vector3.new(thick,thick,length)
		p.CFrame=CFrame.lookAt(center,center+dir)
		p.Transparency=if past then .35+rng:NextNumber()*.35 else rng:NextNumber()*.15
	end
end

-- ------------------------------------------------------------ afterimages
local function ghost(fx,color)
	local holder=holderOf(fx)
	local copy={}
	for i,src in S.ghostSrc do
		local archivable=src.Archivable
		src.Archivable=true
		local ok,g=pcall(function() return src:Clone() end)
		src.Archivable=archivable
		if ok and g then
			for _,child in g:GetChildren() do
				if child:IsA("SpecialMesh") then child.TextureId=""
				elseif not child:IsA("DataModelMesh") then child:Destroy() end
			end
			g.Name="Afterimage";g.Anchored=true;g.CanCollide=false;g.CanQuery=false;g.CanTouch=false;g.CastShadow=false;g.Massless=true
			g.Material=Enum.Material.SmoothPlastic;g.Reflectance=0;g.Color=color;g.Transparency=1;g.LocalTransparencyModifier=0
			if g:IsA("MeshPart") then pcall(function() g.TextureID="" end) end
			g.Parent=holder
			copy[i]=g
		end
	end
	return copy
end
local function ghosts(fx)
	holderOf(fx)
	if S.ghosts then return S.ghosts end
	local list={}
	for k=1,GHOSTS do list[k]=ghost(fx,NEAR:Lerp(FAR,(k-1)/math.max(1,GHOSTS-1))) end
	S.ghosts=list
	S.foresight=ghost(fx,FORESIGHT)
	return list
end
local function place(copy,frame,offset,transparency)
	local parts,cfs={},{}
	for i,g in copy do
		local cf=frame and frame.cf[i] or S.ghostSrc[i].CFrame
		table.insert(parts,g);table.insert(cfs,if offset then offset*cf else cf)
		g.Transparency=transparency
	end
	if #parts==0 then return end
	if workspace.BulkMoveTo then workspace:BulkMoveTo(parts,cfs,Enum.BulkMoveMode.FireCFrameChanged)
	else for i,p in parts do p.CFrame=cfs[i] end end
end
local function hideCopy(copy)
	for _,g in copy or {} do g.Transparency=1 end
end
local function hideGhosts()
	for _,copy in S.ghosts or {} do hideCopy(copy) end
	hideCopy(S.foresight)
end
local function drawGhosts(fx,actor,viewer)
	local list=ghosts(fx)
	local root=S.root
	local here=root and root.Position or Vector3.zero
	for k,copy in list do
		local frame=sample(k*SPACING)
		local there=frame and frame.root or here
		-- No afterimage stacked on a body that has not gone anywhere.
		if frame and (there-here).Magnitude&gt;.8 then place(copy,frame,nil,.56+k*.09) else hideCopy(copy) end
	end
	-- The strike to come: from its wind-up, a red ghost where it will land.
	local striking=actor.state=="Startup" or actor.state=="TechniqueChannel"
	if striking and S.lastStrike~=actor.attackSerial then
		S.lastStrike=actor.attackSerial;S.foreAt=os.clock()
		local toward=Vector3.zero
		if viewer and viewer.position and root then
			local d=viewer.position-here;d=Vector3.new(d.X,0,d.Z)
			if d.Magnitude&gt;.1 then toward=d.Unit*math.clamp(d.Magnitude-2.6,0,7) end
		end
		S.foreOffset=toward
	end
	local age=os.clock()-(S.foreAt or -9)
	if age&lt;.45 and S.foreOffset then
		place(S.foresight,nil,CFrame.new(S.foreOffset),.35+math.max(0,age-.2)*2.4)
	else
		hideCopy(S.foresight)
	end
end

-- ------------------------------------------------------------------ frame
local function step(fx,data,dt,folder)
	local mode=forced()
	local duel=data and data.phase=="Duel" and mode~="off"
	local target=duel and data.bot or nil
	local model=target and folder and folder:FindFirstChild(target.id or "")
	if not model or not model.Parent then release();return end
	if not S or S.model~=model or S.fx~=fx then
		release()
		S={model=model,fx=fx,hidden={},history={},lastFast=-9,refresh=0,rng=Random.new(),episode=false}
	end
	local now=os.clock()
	-- The pieces of the body (an awakening adds a cloak, a tail, steam).
	S.refresh-=dt
	if S.refresh&lt;=0 or not S.parts then
		S.refresh=.4
		S.parts,S.others=collect(model)
		local src=silhouette(S.parts)
		if not S.ghostSrc or #src~=#S.ghostSrc then
			S.ghostSrc=src
			local total=0;S.weight={}
			for k,part in src do total+=part.Size.Magnitude;S.weight[k]=total end
			-- The afterimages copy these: rebuilt with them.
			if S.ghosts then for _,copy in S.ghosts do for _,g in copy do g:Destroy() end end;S.ghosts=nil end
			if S.foresight then for _,g in S.foresight do g:Destroy() end;S.foresight=nil end
			table.clear(S.history)
		end
		S.root=model:FindFirstChild("HumanoidRootPart")
	end
	-- Where the body was, a few tenths of a second back.
	local cfs={}
	for i,src in S.ghostSrc do cfs[i]=src.CFrame end
	table.insert(S.history,{t=now,cf=cfs,root=S.root and S.root.Position})
	while #S.history&gt;2 and now-S.history[1].t&gt;HISTORY do table.remove(S.history,1) end

	if Sight.viewUnreadable(target) then S.lastFast=now end
	local active=Sight.viewFast(target) and now-S.lastFast&lt;=Sight.LINGER
	if not active then
		if S.episode then showBody();hideInk();hideGhosts();S.episode=false end
		return
	end
	local viewer=data.human
	local reads=if mode=="sharingan" then true elseif mode=="normal" then false else Sight.viewReads(viewer)
	if not S.episode or S.reads~=reads then
		S.episode=true;S.reads=reads
		-- The moment the eyes meet the speed: a glint in the reader's eyes,
		-- a dry rush of air for the others.
		local viewerModel=viewer and folder:FindFirstChild(viewer.id or "")
		if reads and viewerModel and fx.eyeGlint then pcall(fx.eyeGlint,fx.folder,viewerModel)
		elseif not reads and S.root then pcall(K.sound,K.anchorPart(fx.folder,S.root.Position),K.SOUND.whoosh,.35,1.6) end
	end
	local velocity=target.velocity or Vector3.zero
	if reads then
		showBody();hideInk()
		drawGhosts(fx,target,viewer)
	else
		hideGhosts()
		hideBody()
		drawInk(fx,velocity,dt)
	end
end

function PerceptionFX.install(FX,kit)
	K=kit
	table.insert(FX.layers,{name="Perception",step=step})
end
PerceptionFX.release=release
return PerceptionFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND225">
          <Properties>
            <string name="Name">Presentation</string>
            <ProtectedString name="Source">-- Velmora's additive combat motion and hit feedback, retaining Ninja Duel's
-- deception visual. Rendering is continuous: bodies are drawn on a smoothed
-- track of their replicated roots instead of jumping once per network packet.
local Motion=require(script.Parent.VelmoraMotionEngine)
local Feedback=require(script.Parent.VelmoraHitFeedback)
local Effects=require(script.Parent.Effects)
-- Bodies that are not fighters (Naruto's shadow clones).
local BodyViews=require(script.Parent.BodyViews)
local Smear=require(script.Parent.MotionSmear)
local Kit=require(script.Parent.VfxKit)
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Fighters=require(Shared.Fighters)
local Config=require(Shared.Config)
local Attacks=require(Shared.Attacks)
local MoveGraphs=require(Shared.MoveGraphs)
local ActionContext=require(Shared.ActionContext)
local Presentation={};Presentation.__index=Presentation
local LOCOMOTION_POSE_SPEED=26
function Presentation.new()
	return setmetatable({last={},recoil={},impactSerial=0,impactEpoch=nil,clocks={},landings={},botModel=nil,fx=Effects.new(),bodies=BodyViews.new(),smooth={},freeze={}},Presentation)
end
-- (FEEL 05/11, user: « les coups qui touchent » are what feels the least fun:
-- no impact, no weight, the opponent barely reacts) Hit stop, drawn only:
-- on a contact both bodies hold their pose for a few frames, the struck one
-- shakes along the blow and its drawn track holds still, then everything
-- resumes from where it stopped. The server keeps its own clock (no change to
-- any timing of the fight): the drawn poses run that much behind for the rest
-- of the move, the drawn track catches up at its normal cap.
-- Seconds of stop per contact style.
Presentation.STOP={light=.07,air=.07,flow=.06,palm=.06,kunai=.035,shuriken=.03,block=.05,finisher=.11,launcher=.12,
	slam=.15,parry=.13,clash=.12,wallbounce=.13,jutsu=.09,repel=.1,palmburst=.1,chidori=.12,groundbounce=.12}
-- How hard the struck body is flashed (strength, seconds) per style.
local FLASH={light={.62,.11},air={.62,.11},flow={.55,.1},finisher={.8,.16},launcher={.85,.17},slam={.9,.2},
	jutsu={.75,.15},wallbounce={.85,.18},palm={.6,.11},palmburst={.8,.16}}
Presentation.FLASH=FLASH
function Presentation:hitstop(keys,style,direction,now)
	local stop=Presentation.STOP[style or ""]
	if not stop then return 0 end
	now=now or os.clock()
	for key,struck in keys do
		local f=self.freeze[key]
		-- A second contact inside a stop does not stack: it only extends it.
		if f and now&lt;f.untilT then f.untilT=math.max(f.untilT,now+stop)
		else self.freeze[key]={from=now,untilT=now+stop,struck=struck,dir=direction,amp=math.clamp(stop*2.4,.12,.32)} end
	end
	return stop
end
-- The struck body's flash on a guessed contact (the server's own contact,
-- when it comes, does not flash it a second time: Effects reads `tinted`).
function Presentation.flash(model,strength,time)
	Kit.tint(model,Color3.fromRGB(255,244,236),time,strength)
end
function Presentation:frozen(key,now)
	local f=self.freeze[key]
	return f~=nil and now&lt;f.untilT,f
end
-- The opponent's body in the viewer's duel folder: the server names it by the
-- id it sends as data.bot.id ("AIFighter" against the AI, a duelist online).
function Presentation.opponent(data,folder)
	return folder and folder:FindFirstChild(data and data.bot and data.bot.id or "AIFighter")
end
-- The replicated root of a server-owned fighter only moves every other
-- rendered frame (physics replication at ~30 Hz against a 60 Hz render), so a
-- body drawn on it advances in jerks. Each fighter is instead drawn on a short
-- interpolated track of its replicated positions, a fixed ~45 ms behind: the
-- motion is continuous every frame. A real teleport still snaps.
local TRACK_DELAY,TRACK_SNAP,TRACK_MAX,TRACK_SAMPLES=.045,45,12,8
-- The drawn body's fastest turn (rad/s): the server's own fastest, a rush.
local ROT_CAP=math.rad(2400)
local LOCAL_EXTRAPOLATE=1/30
local function yawOf(cf)
	local look=cf.LookVector
	return math.atan2(-look.X,-look.Z)
end
local function lerpAngle(a,b,t)
	local d=(b-a+math.pi)%(2*math.pi)-math.pi
	return a+d*t
end
function Presentation:smoothRoot(key,actualCF,dt,warp)
	local now=os.clock()
	local st=self.smooth[key]
	if not st then st={samples={},vel=Vector3.zero};self.smooth[key]=st end
	local samples=st.samples
	local actual=actualCF.Position
	local newest=samples[#samples]
	if (warp and warp~=st.warp) or (newest and (actual-newest.p).Magnitude&gt;TRACK_SNAP) then
		table.clear(samples);newest=nil;st.vel=Vector3.zero;st.pos=nil
	end
	st.warp=warp
	local yaw=yawOf(actualCF)
	if not newest or (actual-newest.p).Magnitude&gt;1e-4 or math.abs(lerpAngle(newest.yaw,yaw,1)-newest.yaw)&gt;1e-4 then
		table.insert(samples,{t=now,p=actual,yaw=yaw})
		while #samples&gt;TRACK_SAMPLES do table.remove(samples,1) end
	elseif now-newest.t&gt;.1 then
		-- Standing still: keep the track anchored to the present.
		newest.t=now
	end
	-- (É7, the player's own body) The opponent is drawn 45 ms behind on the
	-- interpolated track; the player's own body is drawn on the PRESENT: past
	-- the newest packet it carries on along the last segment, for at most one
	-- packet's gap (the 45 ms were a quarter of the lag he felt).
	local at=now-(if key=="human" then 0 else TRACK_DELAY)
	local pos,face=samples[#samples].p,samples[#samples].yaw
	if key=="human" and #samples&gt;=2 and at&gt;samples[#samples].t then
		local a,b=samples[#samples-1],samples[#samples]
		local span=b.t-a.t
		if span&gt;1e-3 and span&lt;.12 then
			local ahead=math.min(at-b.t,LOCAL_EXTRAPOLATE)
			pos=b.p+(b.p-a.p)*(ahead/span);face=b.yaw
		end
	elseif at&lt;=samples[1].t then pos,face=samples[1].p,samples[1].yaw
	else
		for i=#samples-1,1,-1 do
			local a,b=samples[i],samples[i+1]
			if at&gt;=a.t then
				local span=b.t-a.t
				local t=if span&gt;1e-4 then math.clamp((at-a.t)/span,0,1) else 1
				pos=a.p:Lerp(b.p,t);face=lerpAngle(a.yaw,b.yaw,t)
				break
			end
		end
	end
	local offset=pos-actual
	if offset.Magnitude&gt;TRACK_MAX then pos=actual+offset.Unit*TRACK_MAX end
	-- Velocity of the drawn body: what the legs and lean must match.
	if st.pos then
		local v=(pos-st.pos)/math.max(dt,1/240)
		st.vel=st.vel:Lerp(v,math.min(1,dt*18))
	end
	st.pos=pos;st.yaw=face
	return CFrame.new(pos)*CFrame.Angles(0,face,0)
end
function Presentation:visualRoot(key)
	local st=self.smooth[key]
	return st and st.pos
end
function Presentation:visualVelocity(key)
	-- (The player's own body: the velocity it is drawn with, lead included.)
	if key=="human" and self.lead and self.lead.vel then return self.lead.vel end
	local st=self.smooth[key]
	return st and st.vel
end
-- (DEC-030 Partie 1, responsiveness) The player's own body answers the stick
-- at once. The server still moves it (authority), but its track arrives
-- 100-170 ms after the press; the body is drawn ahead of that track by what a
-- body obeying the stick would have run since - an offset that fades as the
-- track catches up (it is zero at any steady speed), never more than 3 studs,
-- never into the opponent. Outside free movement it follows the track.
local LEAD_TAU,LEAD_MAX,LEAD_GUESS_MAX=.13,3,5
function Presentation:leadLocal(actor,drawn,dt)
	local st=self.lead
	if not st then st={off=Vector3.zero,v=Vector3.zero};self.lead=st end
	local track=self.smooth.human and self.smooth.human.vel or Vector3.zero
	local trackFlat=Vector3.new(track.X,0,track.Z)
	local free=actor.state=="Neutral" and not actor.reaction and not actor.airborne and not actor.wall and actor.groundPose==nil
	local want=trackFlat
	local guess=self:movement(actor)
	if guess then
		-- (É7) A dodge or a jump pressed: the body goes at once, on the same
		-- curve the server will run ~80 ms later; the offset holds while the
		-- track catches up, then fades.
		want=Vector3.new(guess.X,0,guess.Z)
		st.v=want
		st.vy=guess.Y
		local g=self.movePrediction
		if g then g.covered=(g.covered or 0)+want.Magnitude*dt end
	elseif free then
		local dir=self.inputDir or Vector3.zero
		dir=Vector3.new(dir.X,0,dir.Z)
		if dir.Magnitude&gt;1 then dir=dir.Unit end
		local def=Fighters[actor.fighterId]
		local move=Config.Movement or {}
		local speed=if self.inputSprint then (move.SprintSpeed or 45)*(def and def.SprintScale or 1) else (def and def.Speed or 18)
		want=dir*speed
	end
	st.v=st.v:Lerp(want,math.min(1,dt*28))
	st.off+=(st.v-trackFlat)*dt
	-- (É7) the jump's rise: ahead of the track while the server's jump is on its way
	st.offY=(st.offY or 0)+((if guess then st.vy or 0 else track.Y)-track.Y)*dt
	st.offY*=math.exp(-dt/(if guess then LEAD_TAU else .06))
	st.offY=math.clamp(st.offY,-.5,LEAD_MAX)
	-- (É7, audit 02/11) A strike out of a run used to pull the body back onto
	-- the track in 70 ms (a visible yank as the blow starts): the run's lead now
	-- fades through the strike; a reaction still snaps it back fast.
	local striking=actor.attackName~=nil and (actor.state=="Startup" or actor.state=="Active" or actor.state=="Recovery") and not actor.reaction
	st.off*=math.exp(-dt/(if free or guess then LEAD_TAU elseif striking then .18 else .07))
	local cap=if guess then LEAD_GUESS_MAX else LEAD_MAX
	if st.off.Magnitude&gt;cap then st.off=st.off.Unit*cap end
	local other=self:visualRoot("bot")
	if other and st.off.Magnitude&gt;1e-3 then
		-- (Studio 03/11: Minato pushed into Gaara and the two bodies merged)
		-- The lead never draws him closer to the opponent than the server
		-- keeps him (Motor.SURFACE 3.4 root to root): pushing into him, the
		-- part of the lead that goes toward him is dropped.
		local function gap(k)
			local at=drawn.Position+st.off*k
			return Vector3.new(at.X-other.X,0,at.Z-other.Z).Magnitude
		end
		local floor=math.min(3.2,gap(0))
		if gap(1)&lt;floor then
			local lo,hi=0,1
			for _=1,6 do local mid=(lo+hi)/2;if gap(mid)&lt;floor then hi=mid else lo=mid end end
			st.off*=lo
		end
	end
	local out=drawn+st.off+Vector3.new(0,st.offY,0)
	if st.prev then
		local v=(out.Position-st.prev)/math.max(dt,1/240)
		st.vel=(st.vel or v):Lerp(v,math.min(1,dt*18))
	end
	st.prev=out.Position
	return out
end
-- (Responsiveness) A light or heavy pressed starts moving the body on the
-- press: the strike the server will start is guessed (the next light of the
-- string, or a heavy from neutral) and drawn from the press; when the server's
-- strike arrives it continues from the same instant if the guess was right,
-- otherwise the server's strike takes over (through the transition). A guess
-- the server never confirms fades after 0.25 s.
-- (Stage 6) The string's light for its confirmed hits (Brawler.request: the
-- index after `combo` hits, by the fighter's StringLength; the last is Light3).
local function lightName(combo,fighterId)
	local f=Fighters[fighterId]
	local length=(f and f.StringLength) or 4
	local index=(combo or 0)+1
	return if index&gt;=length then "Light3" elseif index&lt;=2 then "Light"..index else "Light"..(index+1)
end
-- (É7, the most felt lag) A dodge and a jump start at the press. The server
-- still decides (cooldowns, cost, a hit in between); its state confirms the
-- guess within ~0.1 s, or the guess is dropped and the body eases back.
local DODGE_TIME,DODGE_DISTANCE=.32,14
local WALL_ONLY={wall=true}
-- (É7) The body as the server will read it when a press made now lands, `dt`
-- seconds after the snapshot: Brawler.guessView's windows run out, a
-- recovery or a dodge ends. (The opponent can still change it: a hit.)
function Presentation.viewAt(h,dt)
	local g=h.guess or {}
	local state=h.state
	local left=g.left or 0
	if dt&gt;0 and (state=="Recovery" or state=="Dodging" or state=="TechniqueRecovery") and left&lt;=dt then state="Neutral" end
	local chainReady=state=="Recovery" and g.chainOpen==true and (g.chainIn or 0)&lt;=dt
	local combo,airCombo=g.combo or 0,g.airCombo or 0
	local arrival
	if h.state=="Dodging" then arrival=state=="Dodging" and dt&gt;=left-.23
	elseif h.state=="Rush" or h.state=="Pursuit" then arrival=g.arrival==true
	else arrival=dt&lt;(g.rushArriveLeft or 0) and (state=="Neutral" or (state=="Recovery" and g.arrivalRecovery==true)) end
	local cancel=g.cancelAt
	-- a blow taken: stepped out of by a dodge once its share has run
	-- (Brawler.recoverable "stand"); ending on its own first: unknown state
	local reaction=h.reaction
	local stand=reaction~=nil and g.standIn~=nil and g.standIn&lt;=dt
	if reaction and not stand and dt&gt;0 and (g.reactionLeft or math.huge)&lt;=dt then reaction="?" end
	return {state=state,airborne=h.airborne,fighterId=h.fighterId,awaken=h.awaken,reaction=reaction,stand=stand,
		chainReady=chainReady,combo=combo,airCombo=airCombo,
		stringAlive=not h.airborne and combo&gt;=1 and not g.stringHurt and ((chainReady and not g.chainAir) or dt&lt;=(g.stringLeft or 0)),
		airAlive=h.airborne==true and airCombo&gt;=1 and not g.airHurt and ((chainReady and g.chainAir==true) or dt&lt;=(g.airLeft or 0)),
		arrival=arrival,riposte=(g.riposteLeft or 0)&gt;dt or (g.counterLeft or 0)&gt;dt,counter=math.max(0,(g.counterLeft or 0)-dt),
		lion=(g.lionLeft or 0)&gt;dt,airRecent=(g.airRecentLeft or 0)&gt;dt,
		cancelReady=(state=="Recovery" or state=="TechniqueRecovery") and cancel~=nil and cancel&lt;=dt,
		jumpCancel=state=="Recovery" and (cancel==nil or cancel&lt;=dt),
		dodge=math.max(0,(h.dodge or 0)-dt),pursuit=math.max(0,(h.pursuit or 0)-dt)}
end
-- How long after the snapshot a press made now lands on the server: the
-- snapshot's age plus the trip back (the lowest age seen, noteSnapshot).
function Presentation:noteSnapshot(age)
	if type(age)~="number" then return end
	local w=self.oneWay
	if not w or age&lt;w then self.oneWay=math.max(0,age) else self.oneWay=w+(age-w)*.02 end
end
function Presentation:pressAhead(data)
	local w=self.oneWay
	if not w or not data or not data.serverNow then return 0 end
	local age=0
	pcall(function() age=workspace:GetServerTimeNow()-data.serverNow end)
	return math.clamp(age+w,0,.35)
end
-- A guess is drawn only when it holds across the trip's uncertainty: read at
-- the landing time and half a trip either side, the same answer three times
-- (a window closing, a body crossing a reach as the press lands: no guess).
local STEADY={.5,1.5}
function Presentation:steady(ahead,read)
	local mid=read(ahead)
	if ahead&lt;=0 then return mid end
	for _,k in STEADY do if read(ahead*k)~=mid then return nil end end
	return mid
end
-- (É7) Sprint + dodge toward a locked opponent at mid range is the re-engage
-- (Brawler.dashIntent): the chase in a pursuit window, else the chakra dash
-- (Combat:rush); only when neither is there does it stay a dodge. true: a
-- re-engage, false: a dodge, "?": the client cannot tell.
function Presentation:dashes(h,v,data,dt)
	local g=h.guess or {}
	if not self.inputSprint or g.locked~=true or h.airborne then return false end
	local me,them=self:guessRoots()
	local bot=data and data.bot
	if not me or not them or not bot or (bot.health or 1)&lt;=0 then return false end
	local to=Vector3.new(them.X-me.X,0,them.Z-me.Z)
	if to.Magnitude&lt;=.05 or ActionContext.stick(self.inputDir or Vector3.zero,to.Unit,Config.Combo)~="forward" then return false end
	local style=(MoveGraphs[h.fighterId] or {}).reengage or {}
	local tune=Config.Rush or {}
	if to.Magnitude&lt;(style.minRange or tune.MinRange or 7) then return false end
	local gap=(them-me).Magnitude
	local cost=Config.PursuitCost or 8
	if v.pursuit&gt;0 then return (h.chakra or 0)&gt;=cost and gap&lt;=(Config.PursuitRange or 46) end
	if style.reposition then return "?" end
	if (h.chakra or 0)&lt;cost and (g.freeRushLeft or 0)&lt;=dt then return false end
	if (g.rushReadyLeft or 0)&gt;dt then return false end
	if gap&gt;(tune.Range or 48) then return false end
	return true
end
function Presentation:predictMove(action,data,ahead)
	local h=data and data.human
	if not h or h.wall or h.groundPose or (h.health or 1)&lt;=0 or (h.guess and h.guess.held) then return end
	if h.reaction and action~="Dodge" then return end
	local now=os.clock()
	ahead=ahead or self:pressAhead(data)
	local def=Fighters[h.fighterId]
	local root=nil
	pcall(function()
		local character=game:GetService("Players").LocalPlayer.Character
		root=character and character:FindFirstChild("HumanoidRootPart")
	end)
	-- (Audit 04/11) A press the server turns into a string route (Brawler
	-- .buttonRoute: ○ around, × rising after two hits, the stick not pushed
	-- away) is a strike, not a dash or a hop: no guess (the body dashed, then
	-- snapped back into the route).
	if not h.airborne and (action=="Dodge" or action=="Jump" or action=="PadJump") then
		local v=Presentation.viewAt(h,ahead)
		local routes=(MoveGraphs[h.fighterId] or {}).routes or {}
		local route=if action=="Dodge" then routes.side else routes.up
		local away=false
		local dir,b=self.inputDir,data.bot
		if dir and root and b and b.position then
			local flat=Vector3.new(dir.X,0,dir.Z)
			local to=Vector3.new(b.position.X-root.Position.X,0,b.position.Z-root.Position.Z)
			away=to.Magnitude&gt;.1 and ActionContext.stick(flat,to.Unit,Config.Combo)=="back"
		end
		if route and Attacks[route] and v.combo&gt;=2 and (v.stringAlive or v.chainReady) and not away then return end
	end
	if action=="Dodge" then
		-- The server's own rules (Combat:requestInner): chakra for it, off
		-- cooldown (snapshot `dodge`), not Gaara's sand flicker (a teleport),
		-- not loaded (the chakra dash), not the sprinting re-engage at him.
		-- (a recovery past its cancel point is left by a dodge, as on the server)
		if h.airborne or (def and def.SandFlicker) then return end
		if h.chakraLoad then return end
		local g=h.guess or {}
		local free=self:steady(ahead,function(dt)
			-- a press already waiting may fire before this one lands
			if g.buffered and dt&gt;0 then return "?" end
			local v=Presentation.viewAt(h,dt)
			local cost=Config.DodgeCost or 10
			if v.reaction=="?" then return "?" end
			if v.reaction then
				-- (EMB-003) past its share the blow is stepped out of, then
				-- the dodge goes as usual; earlier the dodge is a substitution
				if not v.stand then return false end
				cost+=(Config.Agency and Config.Agency.StepCost or 6)
				v.state="Neutral"
			end
			if (h.chakra or 0)&lt;cost then return false end
			if not ((v.state=="Neutral" or v.state=="Guarding" or v.cancelReady) and v.dodge&lt;=0) then return false end
			-- (Combat: sprint + dodge at him is the re-engage when one is there)
			self.ahead=dt
			local dash=self:dashes(h,v,data,dt)
			self.ahead=nil
			if dash=="?" then return "?" end
			return not dash
		end)
		if free~=true then return end
		if now-(self.lastDodgeGuess or -10)&lt;(Config.DodgeCooldown or .8) then return end
		local dir=self.inputDir or Vector3.zero
		dir=Vector3.new(dir.X,0,dir.Z)
		if dir.Magnitude&lt;.1 then dir=if root then root.CFrame.RightVector else Vector3.xAxis end
		self.lastDodgeGuess=now
		-- (waits a round trip for the server's dodge; out of a blow the body
		-- is still reacting until then)
		self.movePrediction={kind="Dodge",at=now,dir=dir.Unit,distance=DODGE_DISTANCE*(def and def.DashScale or 1),time=DODGE_TIME,serial=h.warpSerial,
			wait=math.max(.16,ahead+.1),fromReaction=h.reaction~=nil}
	elseif action=="Jump" or action=="PadJump" then
		-- (a pad jump in a chase window is the chase: the server's call)
		if h.airborne then return end
		local free=self:steady(ahead,function(dt)
			local v=Presentation.viewAt(h,dt)
			return (v.state=="Neutral" or v.jumpCancel) and v.pursuit&lt;=0
		end)
		if not free then return end
		local move=Config.Movement or {}
		local v0=(move.JumpVelocity or 58)*(def and def.JumpScale or 1)
		self.movePrediction={kind="Jump",at=now,v0=v0,g=workspace.Gravity,time=math.max(.18,ahead+.1)}
	end
end
-- The guessed velocity of the body now (nil when there is no live guess).
function Presentation:movement(actor)
	local g=self.movePrediction
	if not g then return nil end
	local t=os.clock()-g.at
	if g.kind=="Dodge" then
		if actor.state=="Dodging" then g.confirmed=true end
		if t&gt;g.time or (not g.confirmed and (t&gt;(g.wait or .16) or (actor.reaction and not g.fromReaction))) then self.movePrediction=nil;return nil end
		local k=t/g.time
		return g.dir*(g.distance*2*(1-k)/g.time)
	elseif g.kind=="Strike" then
		if actor.attackName==g.name and (actor.state=="Startup" or actor.state=="Active") then g.confirmed=true end
		if t&gt;g.time or actor.reaction or (not g.confirmed and t&gt;(g.wait or .16)) then self.movePrediction=nil;return nil end
		-- Combat's drive: .32 + 1.18 sin(pi p) of the full step; stopped at the reach.
		local done=g.covered or 0
		local speed=g.full*(.32+1.18*math.sin(math.clamp(t/g.time,0,1)*math.pi))/g.time
		if done&gt;=g.distance then return Vector3.zero end
		return g.dir*speed
	elseif g.kind=="Jump" then
		if actor.airborne then g.confirmed=true end
		if t&gt;g.time or actor.reaction then self.movePrediction=nil;return nil end
		return Vector3.new(0,g.v0-g.g*t,0)
	end
	return nil
end
-- (É7) Where the two bodies will be when a press lands (`self.ahead` seconds
-- on): each drawn root carried on by its velocity. The guess reads these.
function Presentation:guessRoots()
	local me,them=self:visualRoot("human"),self:visualRoot("bot")
	local dt=self.ahead or 0
	if dt&gt;0 and me and them then
		local mv=self.lead and self.lead.v or Vector3.zero
		local tv=self.smooth.bot and self.smooth.bot.vel or Vector3.zero
		me+=Vector3.new(mv.X,0,mv.Z)*dt;them+=Vector3.new(tv.X,0,tv.Z)*dt
	end
	return me,them
end
-- (É7) The stick as Brawler.intent reads it at the press: the strong push
-- now, else the latest one inside Config.Combo.IntentWindow (observeStick
-- keeps it every frame, as Brawler.observe does on the server).
function Presentation:lineToOpponent()
	local me,them=self:guessRoots()
	if not me or not them then return nil end
	local to=Vector3.new(them.X-me.X,0,them.Z-me.Z)
	return if to.Magnitude&gt;.05 then to.Unit else nil
end
function Presentation:observeStick(now)
	local line=self:lineToOpponent()
	if not line then return end
	local dir,side=ActionContext.stick(self.inputDir or Vector3.zero,line,Config.Combo)
	if dir then self.stickMemory={dir=dir,side=side,at=now} end
end
function Presentation:stickIntent(now)
	local line=self:lineToOpponent() or (self.myLook and Vector3.new(self.myLook.X,0,self.myLook.Z).Unit) or Vector3.new(0,0,-1)
	local dir=ActionContext.stick(self.inputDir or Vector3.zero,line,Config.Combo)
	if dir then return dir end
	local m=self.stickMemory
	if m and now-m.at&lt;=(Config.Combo.IntentWindow or .22) then return m.dir end
	return "neutral"
end
-- The world only (fighters and effects excluded), as the server's rays see it.
local function worldRay(data,from,delta)
	local exclude={}
	pcall(function()
		local character=game:GetService("Players").LocalPlayer.Character
		if character then table.insert(exclude,character) end
		local folder=character and character.Parent
		local bot=Presentation.opponent(data,folder);if bot then table.insert(exclude,bot) end
		local effects=folder and folder:FindFirstChild("Effects");if effects then table.insert(exclude,effects) end
		local fx=workspace:FindFirstChild("NinjaDuelFX");if fx then table.insert(exclude,fx) end
	end)
	local ok,hit=pcall(function()
		local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances=exclude
		return workspace:Raycast(from,delta,params)
	end)
	return if ok then hit else nil
end
-- A surface at the opponent's back on this body's line (Server/Perception's
-- behindTarget): the same ray, from his root along the line.
function Presentation:wallBehind(me,them,data)
	local line=Vector3.new(them.X-me.X,0,them.Z-me.Z)
	if line.Magnitude&lt;=.05 then return nil end
	local hit=worldRay(data,them,line.Unit*((Config.Perception and Config.Perception.Behind) or 14))
	if hit and math.abs(hit.Normal.Y)&lt;.5 and ActionContext.surface(hit.Instance) then return hit.Distance end
	return nil
end
-- (É7) When the airborne body touches down (a ballistic fall from its height
-- over the floor below and its vertical speed): an air press landing after
-- that is a ground press.
local STAND_HEIGHT=3
function Presentation:landIn(data)
	local h=data.human
	if not h.airborne then return 0 end
	local me=self:visualRoot("human")
	if not me then return math.huge end
	local hit=worldRay(data,me,Vector3.new(0,-80,0))
	if not hit then return math.huge end
	local height=math.max(0,me.Y-(hit.Position.Y+STAND_HEIGHT))
	local vy=h.velocity and h.velocity.Y or 0
	local g=workspace.Gravity or 196.2
	-- (an air string holds the body up first: it falls from where it hangs)
	local hold=h.guess and h.guess.airHoldLeft or 0
	if hold&gt;0 then vy=0 end
	return hold+(vy+math.sqrt(vy*vy+2*g*height))/g
end
-- (É7) The opener the server will pick from the body's situation: the same
-- shared reader (ActionContext) fed with what this client draws. Returns
-- (move or nil, known): known=false when the client cannot read it (no
-- opponent drawn).
function Presentation:situational(data,def,graph,now,only)
	local me,them=self:guessRoots()
	local bot=data and data.bot
	local h=data and data.human
	if not me or not them or not bot then return nil,false end
	-- Under an illusion the server reads the image the body believes in.
	local fooled=h and (h.illusion or 0)&gt;0 and h.decoy
	if fooled then them=h.decoy end
	local to=Vector3.new(them.X-me.X,0,them.Z-me.Z)
	local line=if to.Magnitude&gt;.05 then to.Unit else Vector3.new(0,0,-1)
	local lead=self.lead and self.lead.v or Vector3.zero
	local vy=h and h.velocity and h.velocity.Y or 0
	local x=ActionContext.read({pos=me,look=self.myLook or line,vel=Vector3.new(lead.X,vy,lead.Z),airborne=h and h.airborne,
		target={pos=them,look=if fooled then me-them else (bot.lookVector or -line),airborne=bot.airborne and not fooled,
			down=bot.reaction=="Knockdown" or bot.reaction=="Wakeup" or bot.groundPose~=nil,guarding=bot.state=="Guarding"}})
	local light=Attacks.Light1
	local profile=def and def.AttackProfile and def.AttackProfile.Light1
	x.plainReach=light.travel*(def and def.CombatTravel or 1)*(profile and profile.travel or 1)+(profile and profile.contact or light.contact or 3.6)+1
	x.stick=self:stickIntent(now or os.clock())
	if not fooled then x.wallBehind=self:wallBehind(me,them,data) end
	return (ActionContext.resolve(x,graph,Attacks,only)),true
end
-- (É7) The strike a press will start, read the way Brawler.request reads it,
-- in the same order, from the body as it will be when the press lands
-- (viewAt) and what this client draws. nil: no strike, a buffered press, or
-- a branch the client cannot read (a counter stance, an awakened riposte...).
function Presentation:guessGround(action,v,def,graph,data,now)
	local bot=data.bot or {}
	if action=="Attack" and v.riposte then
		-- a riposte (not a counter stance's answer, not an awakened one)
		if v.counter&gt;0 or (v.awaken or 0)&gt;0 then return nil end
		if v.state=="Guarding" or v.state=="Neutral" or v.state=="Dodging" or v.state=="Recovery" then return graph.riposte or "Riposte" end
	end
	local canChain,arrival=v.chainReady,v.arrival
	-- committed: the press waits (buffered) and starts nothing now
	if v.state~="Neutral" and v.state~="Guarding" and not canChain and not arrival then return nil end
	if action=="Attack" and graph.readCounter and v.counter&gt;0 and not canChain then return nil end
	local alive=v.stringAlive
	local inChain=canChain and alive
	local reentry=arrival and v.state~="Dodging"
	local vel=self.lead and self.lead.v or Vector3.zero
	local speed=Vector3.new(vel.X,0,vel.Z).Magnitude
	local running=not canChain and not arrival and v.state=="Neutral" and self.inputSprint and speed&gt;28
	-- (a run still building or fading as the press lands: the server may read
	-- either side of its threshold)
	if not canChain and not arrival and v.state=="Neutral" and self.inputSprint and (self.ahead or 0)&gt;0 then
		local pushing=Vector3.new((self.inputDir or Vector3.zero).X,0,(self.inputDir or Vector3.zero).Z).Magnitude&gt;=.45
		if running~=(pushing and speed&gt;28) or (pushing and speed&lt;=28) or (not pushing and speed&gt;8) then return "?" end
	end
	if running then
		if action=="Attack" then return "Light1" end
		local m=graph.runStrike or "DashAttack"
		return if Attacks[m] then m else "FlyingKick"
	end
	local combo=v.combo
	if action=="Heavy" then
		if inChain and combo==1 and graph.heavyAfterOne then return graph.heavyAfterOne end
		if inChain and combo&gt;=2 then return def and def.LauncherMove or "Launcher" end
		if reentry and graph.heavyAfterOne and bot.reaction~="WallSplat" then return graph.heavyAfterOne end
		return def and def.HeavyMove or "Heavy"
	end
	local routes=graph.routes or {}
	if inChain or (alive and v.state=="Neutral") then
		local dir=self:stickIntent(now)
		local route=if combo&lt;2 then nil elseif dir=="forward" then routes.up elseif dir=="back" then routes.down elseif dir=="side" then routes.side else nil
		if route and Attacks[route] then return route end
	end
	-- (EMB-002) inside a string a surface at his back is the drive into it
	if inChain and combo&gt;=1 then
		local move,known=self:situational(data,def,graph,now,WALL_ONLY)
		if not known then return nil end
		if move then return move end
	end
	if not alive then combo=0 end
	if not inChain and not arrival then
		local move,known=self:situational(data,def,graph,now)
		if not known then return nil end
		if move then return move end
	end
	local name=lightName(combo,v.fighterId)
	if name=="Light3" and def and def.GentleFist and (bot.tenketsu or 0)&gt;=3 then return "PalmThrust" end
	if arrival then return "DashAttack" end
	return name
end
function Presentation:guessAir(action,v,def,graph,data,now)
	local bot=data.bot or {}
	local canChain,arrival=v.chainReady,v.arrival
	if v.state~="Neutral" and v.state~="Guarding" and not canChain and not arrival then return nil end
	if action=="Attack" and graph.readCounter and v.counter&gt;0 and not canChain then return nil end
	local airCombo=v.airCombo
	local targetUp=(bot.health or 1)&gt;0
	if action=="Heavy" then
		if v.lion and targetUp then return "Slam" end
		if airCombo&gt;=1 or v.airRecent then return "Slam" end
		return def and def.AirHeavy or "AirFlip"
	end
	local routes=graph.routes or {}
	if (canChain or v.state=="Neutral") and v.airAlive and airCombo&gt;=1 then
		local dir=self:stickIntent(now)
		local route=if dir=="forward" then routes.airUp elseif dir=="back" then routes.airDown elseif dir=="side" then routes.airSide else nil
		if route then return route end
	end
	if not v.airAlive then
		airCombo=0
		local me,them=self:guessRoots()
		if not me or not them then return nil end
		-- (Audit 03/11) Only the flat motion is read ahead, and the body falls
		-- through the trip: near the edge of the dive's height (a few studs
		-- lower changes the answer), the server decides alone.
		local dive=ActionContext.airDive(me,them)
		if targetUp and not bot.airborne and dive~=ActionContext.airDive(me-Vector3.new(0,3,0),them) then return nil end
		if targetUp and not bot.airborne and dive then return "WallDive" end
		local move,known=self:situational(data,def,graph,now)
		if not known then return nil end
		if move and Attacks[move] and move==(((graph.context or {}).drop) or "DropStrike") then return move end
	end
	return if airCombo%2==0 then "Air1" else "Air2"
end
function Presentation:predictStrike(action,data,now,ahead)
	local h=data and data.human
	if not h or h.reaction or h.wall or h.groundPose or (h.health or 1)&lt;=0 or (h.guess and h.guess.held) then return end
	local g=h.guess or {}
	-- (É7) branches ahead of the strike the client leaves to the server: a
	-- held body state, a teleport's arrival strike, a grab's throw, a blade
	-- still leaving the hand, a counter stance.
	if h.bodyState or g.flash or g.grab or (action=="Attack" and g.stance) then return end
	if h.throwKind and (h.throwElapsed or 99)&lt;(h.throwRelease or .1) then return end
	now=now or os.clock()
	ahead=ahead or self:pressAhead(data)
	local def=Fighters[h.fighterId]
	local graph=MoveGraphs[h.fighterId] or {}
	local land=if h.airborne and ahead&gt;0 then self:landIn(data) else math.huge
	local guess=self:steady(ahead,function(dt)
		if dt&gt;=land then return "?" end
		-- a press already waiting may fire first: this one would land behind it
		if g.buffered and dt&gt;0 then return "?" end
		self.ahead=dt
		local v=Presentation.viewAt(h,dt)
		local m=if h.airborne then self:guessAir(action,v,def,graph,data,now) else self:guessGround(action,v,def,graph,data,now)
		return m or false
	end)
	self.ahead=nil
	if not guess or not Attacks[guess] then return end
	self.prediction={name=guess,at=os.clock(),serial=h.attackSerial or 0,wait=math.max(.25,ahead+.15)}
	local spec=Attacks[guess]
	local prof=Fighters[h.fighterId] and Fighters[h.fighterId].AttackProfile
	prof=prof and (prof[guess] or prof[spec.clip or ""]) or {}
	self.strikeGuess={name=guess,at=os.clock(),contact=spec.startup*(prof.startup or 1),reach=(prof.contact or spec.contact or 3.6)+1.1}
	-- (É7) its step-in too, on the ground: the body closes on the opponent from
	-- the press, on the server's own drive curve, stopping at the strike's reach.
	local me,them=self:visualRoot("human"),self:visualRoot("bot")
	if not h.airborne and me and them and (spec.travel or 0)&gt;0 then
		local to=Vector3.new(them.X-me.X,0,them.Z-me.Z)
		local room=to.Magnitude-(prof.contact or spec.contact or 3.6)
		local travel=math.min(spec.travel*(prof.travel or 1),math.max(0,room))
		local time=spec.startup*(prof.startup or 1)+spec.active*(prof.active or 1)
		if travel&gt;.2 and to.Magnitude&lt;11 and time&gt;0 then
			self.movePrediction={kind="Strike",name=guess,at=os.clock(),dir=to.Unit,distance=travel,full=spec.travel*(prof.travel or 1),time=time,wait=math.max(.16,ahead+.1)}
		end
	end
end
-- (É7) The blow lands for the player when his drawn fist reaches the drawn
-- body, not ~1.5 ping later when the server's contact arrives: at the guessed
-- strike's contact time, if the opponent is in reach and open (not dodging,
-- guarding, down, spinning or out of the fight), the hit sound, shards and lens
-- kick play at once. The server's contact for that blow then plays its world
-- effects only (no second sound). A guarded or dodged blow is never guessed.
local CONTACT_STYLE={light=true,launcher=true,slam=true,finisher=true}
function Presentation.contactOpen(bot,myPos,theirPos,reach)
	if not bot or not myPos or not theirPos then return false end
	if (bot.health or 1)&lt;=0 or bot.state=="Dodging" or bot.state=="Guarding" or bot.rotation or bot.counter and bot.counter&gt;0 then return false end
	if bot.groundPose~=nil or bot.reaction=="Knockdown" or bot.reaction=="Wakeup" or bot.reaction=="Down" then return false end
	local d=theirPos-myPos
	if math.abs(d.Y)&gt;3 then return false end
	return Vector3.new(d.X,0,d.Z).Magnitude&lt;=reach
end
function Presentation:localContact(data,myPos,theirPos,now)
	local g=self.strikeGuess
	if not g or g.checked or now-g.at&lt;g.contact then return nil end
	g.checked=true
	if now-g.at&gt;g.contact+.2 then return nil end
	if not Presentation.contactOpen(data and data.bot,myPos,theirPos,g.reach) then return nil end
	local style=if g.name=="Heavy" then "launcher" else "light"
	local at=myPos:Lerp(theirPos,.7)+Vector3.new(0,.6,0)
	self.localHit={at=now,style=style,position=at}
	return self.localHit
end
function Presentation:applyPrediction(actor,now)
	local g=self.movePrediction
	if g and g.kind=="Dodge" and not g.confirmed and actor.state~="Dodging" and now-g.at&lt;=(g.wait or .16) then
		-- The dodge's body from the press (the server's Dodging follows); out
		-- of a blow it has already stepped out of it.
		local v=table.clone(actor)
		v.state="Dodging";v.velocity=g.dir*35;v.dodge=math.max(0,g.time-(now-g.at))
		if g.fromReaction then v.reaction=nil;v.reactionElapsed=nil end
		return v
	end
	local p=self.prediction
	if not p then return actor end
	if (actor.attackSerial or 0)~=p.serial then
		self.prediction=nil
		if actor.attackName==p.name then
			local clock=self.clocks.human
			if not clock then clock={};self.clocks.human=clock end
			clock.attackName=actor.attackName;clock.attackSerial=actor.attackSerial or 0;clock.attackAt=p.at
		end
		return actor
	end
	if now-p.at&gt;(p.wait or .25) or actor.reaction then self.prediction=nil;return actor end
	local v=table.clone(actor)
	v.attackName=p.name;v.state="Startup";v.attackSerial=-1-p.serial;v.attackElapsed=now-p.at
	return v
end
-- The server's root for this frame from the snapshot: its position when the
-- snapshot was taken, carried forward by its velocity over the snapshot's age
-- (at most 0.1 s: a late packet is not extrapolated into a wall). Facing from
-- the snapshot's look vector, carried by its turn rate the same way (fluidity
-- audit 05/11: held for a whole packet, a turn at 1440-2400 deg/s was drawn
-- in steps of 48-80 deg). A turn faster than TURN_MAX is a facing written at
-- once (a reaction, a teleport): not carried. Falls back to the replicated
-- root. `at` (server time) defaults to now.
local TURN_MAX=45
function Presentation.snapshotRoot(data,actor,fallback,at)
	if not actor.position or not data.serverNow then return fallback end
	local age=math.clamp((at or workspace:GetServerTimeNow())-data.serverNow,0,.1)
	local v=actor.velocity
	local p=actor.position
	if typeof(v)=="Vector3" and v.Magnitude&lt;200 then
		-- (Probe 03/11: a landing drawn 4 studs under the floor, then popped
		-- up) Carried on flat; in the air the fall bends with gravity and
		-- stops at the floor under it; on the ground, no vertical guess.
		p+=Vector3.new(v.X,0,v.Z)*age
		if actor.airborne then
			local y=v.Y*age-.5*(workspace.Gravity or 196.2)*age*age
			if y&lt;0 then
				local floor=nil
				pcall(function()
					local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
					local exclude={}
					local character=game:GetService("Players").LocalPlayer.Character
					if character then table.insert(exclude,character) end
					local folder=character and character.Parent
					local bot=Presentation.opponent(data,folder);if bot then table.insert(exclude,bot) end
					local effects=folder and folder:FindFirstChild("Effects");if effects then table.insert(exclude,effects) end
					params.FilterDescendantsInstances=exclude
					local hit=workspace:Raycast(actor.position,Vector3.new(0,y-3,0),params)
					floor=hit and hit.Position.Y+2.9
				end)
				if floor then y=math.max(y,math.min(0,floor-actor.position.Y)) end
			end
			p+=Vector3.new(0,y,0)
		end
	end
	local look=actor.lookVector
	local flatLook=if typeof(look)=="Vector3" then Vector3.new(look.X,0,look.Z) else Vector3.zero
	if flatLook.Magnitude&lt;.05 then return fallback.Rotation+p end
	local yaw=math.atan2(-flatLook.X,-flatLook.Z)
	local turn=actor.turn
	if type(turn)=="number" and math.abs(turn)&lt;=TURN_MAX then yaw+=turn*age end
	return CFrame.new(p)*CFrame.Angles(0,yaw,0)
end
-- The velocity and turn rate the snapshot carries the body with at `at`
-- (what snapshotRoot adds per second; none once the packet is 0.1 s old).
local function anchorMotion(data,actor,at)
	if not data.serverNow then return Vector3.zero,0 end
	local age=math.clamp(at-data.serverNow,0,.1)
	if age&gt;=.1 then return Vector3.zero,0 end
	local v=actor.velocity
	local out=Vector3.zero
	if typeof(v)=="Vector3" and v.Magnitude&lt;200 then
		out=Vector3.new(v.X,0,v.Z)
		if actor.airborne then out+=Vector3.new(0,v.Y-(workspace.Gravity or 196.2)*age,0) end
	end
	local turn=actor.turn
	return out,if type(turn)=="number" and math.abs(turn)&lt;=TURN_MAX then turn else 0
end
-- (Fluidity audit 05/11: 38-46 % of the packets moved the drawn body more than
-- 0.18 stud in a single frame, p90 0.44, up to 6; the screen showed 4-7 times
-- the velocity breaks of the server's own path, 85 % of them in plain neutral)
-- A new packet no longer moves the body by itself. From the frame it arrives,
-- the body leaves the course it was drawn on (its position and velocity) and
-- joins the new packet's course over BLEND_T, its velocity blending into the
-- packet's as its position does (projective velocity blending: C. Murphy,
-- "Believable Dead Reckoning for Networked Games", Game Engine Gems 2). Once
-- joined it is exactly on the packet's course: no lag piles up. The facing
-- joins the same way, at most BLEND_YAW_RATE: a 159 deg facing written at
-- once by the server (a hit reaction) turns over ~0.1 s, ~25 deg a frame. A
-- teleport (warp), a new duel or a gap over SETTLE_MAX studs still cuts.
local BLEND_T,BLEND_YAW_RATE,SETTLE_MAX=.066,math.rad(1500),8
local function wrapAngle(a) return (a+math.pi)%(2*math.pi)-math.pi end
local function yawOfCF(cf) local look=cf.LookVector;return math.atan2(-look.X,-look.Z) end
function Presentation:settleAnchor(key,data,actor,cf,dt,at)
	local all=self.settled
	if not all then all={};self.settled=all end
	local st=all[key]
	if not st then st={};all[key]=st end
	at=at or workspace:GetServerTimeNow()
	local pos,yaw=cf.Position,yawOfCF(cf)
	-- (A body on a wall can face up it: no yaw to blend, its rotation is kept.)
	local look=cf.LookVector
	local hasYaw=Vector3.new(look.X,0,look.Z).Magnitude&gt;.05
	if data.serverNow~=st.serverNow then
		local same=st.data~=nil and st.epoch==data.epoch and st.warp==(actor.warpSerial or 0) and st.drawn~=nil
		if same and (st.drawn-pos).Magnitude&lt;=SETTLE_MAX then
			-- The velocity the body was being carried with (not its drawn
			-- velocity: that one holds the last blend's own correction, and
			-- feeding it back made the course oscillate).
			local v0,w0=anchorMotion(st.data,st.actor,at)
			local old=st.blend
			if old then
				local e=math.max(0,at-old.t0)
				local tau=math.clamp(e/BLEND_T,0,1)
				local tauY=math.clamp(e/old.ty,0,1)
				v0=old.v0+(v0-old.v0)*tau
				w0=old.w0+(w0-old.w0)*tauY
			end
			-- (From the last drawn frame: on this one the body already moves on.)
			st.blend={t0=at-dt,p0=st.drawn,v0=v0,y0=st.drawnYaw,w0=w0,
				ty=if st.drawnYaw then math.max(BLEND_T,math.abs(wrapAngle(yaw-st.drawnYaw))/BLEND_YAW_RATE) else BLEND_T}
		else
			-- A cut: drawn where the packet is.
			st.blend=nil
		end
		st.serverNow=data.serverNow;st.data=data;st.actor=actor;st.epoch=data.epoch;st.warp=actor.warpSerial or 0
	end
	local outPos,outYaw=pos,yaw
	local b=st.blend
	if b then
		local e=math.max(0,at-b.t0)
		local vNew,wNew=anchorMotion(data,actor,at)
		local tau=math.clamp(e/BLEND_T,0,1)
		if tau&lt;1 then
			local vb=b.v0+(vNew-b.v0)*tau
			local course=b.p0+vb*e
			outPos=course+(pos-course)*tau
			-- (A fall caught by a landing between two packets: the old course
			-- still goes down, the packet's is on the floor; never under both.)
			outPos=Vector3.new(outPos.X,math.max(outPos.Y,math.min(pos.Y,b.p0.Y)),outPos.Z)
		end
		local tauY=math.clamp(e/b.ty,0,1)
		if tauY&lt;1 and hasYaw and b.y0 then
			local wb=b.w0+(wNew-b.w0)*tauY
			local course=b.y0+wb*e
			outYaw=course+wrapAngle(yaw-course)*tauY
		end
		if tau&gt;=1 and tauY&gt;=1 then st.blend=nil end
	end
	st.drawn=outPos;st.drawnYaw=if hasYaw then outYaw else nil
	if outPos==pos and outYaw==yaw then return cf end
	-- The packet's own rotation turned about the vertical: a lean or a pitch
	-- it carries is kept.
	return CFrame.new(outPos)*CFrame.fromAxisAngle(Vector3.yAxis,wrapAngle(outYaw-yaw))*cf.Rotation
end
-- Just before rendering: the replicated roots have their positions for this
-- frame; advance each track and draw the body on it (position and facing).
function Presentation:smoothStep(data,dt)
	if not data or data.phase~="Duel" then return end
	local character=game:GetService("Players").LocalPlayer.Character
	local folder=character and character.Parent
	for key,model in {human=character,bot=Presentation.opponent(data,folder)} do
		local root=model and model:FindFirstChild("HumanoidRootPart")
		local actor=data[key]
		-- (Audit 29/10) Anchored roots too: the final blow's flight moves an
		-- anchored root, and an untracked one froze the camera (and the look)
		-- on the impact point while the body flew off.
		if root and actor then
			-- The true replicated pose: if the root still sits exactly where we
			-- drew it last frame, no new packet arrived since.
			local st=self.smooth[key]
			local actualCF=root.CFrame
			if st and st.drawnCF and st.replicatedCF and (actualCF.Position-st.drawnCF.Position).Magnitude&lt;1e-3
				and actualCF.LookVector:Dot(st.drawnCF.LookVector)&gt;.99999 then actualCF=st.replicatedCF end
			-- (Tutorial probe 02/11, Lion run) Roblox's replicated root ran 370 ms
			-- (10 studs, up to 18) behind the server through a jump, 60-130 ms in
			-- a chase or a run: the body was drawn late, then caught up in jumps.
			-- The snapshot carries the server's own root and the time it was
			-- taken (30 Hz): the track follows that, carried to the present by
			-- its velocity.
			actualCF=Presentation.snapshotRoot(data,actor,actualCF)
			-- (Fluidity audit 05/11) and a new packet settles in instead of
			-- moving the body in one frame.
			actualCF=self:settleAnchor(key,data,actor,actualCF,math.max(dt,1/240))
			local drawn=self:smoothRoot(key,actualCF,math.max(dt,1/240),actor.warpSerial)
			-- (Audit 04/11) a watched tournament match: the body is the AI's own.
			if key=="human" and not data.spectate then drawn=self:leadLocal(actor,drawn,math.max(dt,1/240)) end
			st=self.smooth[key]
			st.replicatedCF=actualCF
			-- (Tutorial probe 03/11: 12-19 pops per fighter, 3-9 studs in one
			-- frame) A packet that disagrees with where the body was drawn (an
			-- extrapolation past a landing, a dive or a dash started between two
			-- packets) moved the body in a single frame. The drawn root now
			-- covers at most a body's top speed per frame; the rest is caught up
			-- over the next frames. A declared warp still snaps.
			local step=math.max(dt,1/240)
			if st.drawnCF and st.capWarp==actor.warpSerial then
				local v=actor.velocity
				local speed=math.max(actor.speed or 0,if typeof(v)=="Vector3" then v.Magnitude else 0)
				local cap=math.max(80,speed*1.4)*step
				local d=drawn.Position-st.drawnCF.Position
				if d.Magnitude&gt;cap and d.Magnitude&lt;TRACK_SNAP then drawn=drawn.Rotation+(st.drawnCF.Position+d.Unit*cap) end
				-- (Studio 06/11, after the packet blend) A body leaving a wall for
				-- its dive still turned 51-64 deg in one frame: the wall pose has no
				-- yaw to blend. The drawn rotation turns at most ROT_CAP a second,
				-- the server's own fastest turn (a rush, 2400 deg/s); the rest
				-- follows over the next frames.
				local _,turned=(st.drawnCF.Rotation:Inverse()*drawn.Rotation):ToAxisAngle()
				turned=math.abs(turned)
				local most=ROT_CAP*step
				if turned&gt;most then drawn=CFrame.new(drawn.Position)*st.drawnCF.Rotation:Lerp(drawn.Rotation,most/turned) end
			end
			st.capWarp=actor.warpSerial
			-- Draw the whole body on the track for this frame only; the next
			-- replication packet overwrites the client copy, never the server.
			local target=drawn
			-- (FEEL 05/11) Hit stop: the struck body holds where the blow met it
			-- and shakes along the blow (a few studs-tenths, 30 Hz), then its
			-- track catches up. Only a body this client does not simulate (the
			-- opponent): the player's own root is his physics.
			local now=os.clock()
			local isFrozen,f=self:frozen(key,now)
			if isFrozen and f.struck and key~="human" and st.drawnCF then
				f.hold=f.hold or st.drawnCF.Position
				local dir=f.dir
				if typeof(dir)~="Vector3" or dir.Magnitude&lt;.05 then dir=target.RightVector end
				local fade=math.clamp((f.untilT-now)/math.max(f.untilT-f.from,1e-3),0,1)
				local wobble=math.sin((now-f.from)*2*math.pi*30)*f.amp*fade
				target=target.Rotation+(f.hold+Vector3.new(dir.X,0,dir.Z).Unit*wobble)
			elseif f and not isFrozen then f.hold=nil end
			if (target.Position-root.Position).Magnitude&gt;1e-4 or target.LookVector:Dot(root.CFrame.LookVector)&lt;.99999 then
				model:PivotTo(target*root.CFrame:Inverse()*model:GetPivot())
			end
			st.drawnCF=root.CFrame
		end
	end
end
-- Contact feed straight from the server: play the impact on the frame the hit
-- happened, so sound and VFX never lead or lag the animation.
function Presentation:impacts(data,camera)
 self.camera=camera or self.camera
 -- Projectiles first, so a contact in the same packet can finish its blade.
 if data.phase=="Duel" then self.fx:sync(data) end
 if not data.impacts then return end
 -- The server restarts its contact serial with every duel.
 if self.impactEpoch~=data.epoch then self.impactEpoch=data.epoch;self.impactSerial=0 end
 local serial=data.impactSerial or 0
 if serial&lt;=self.impactSerial then return end
 local character=game:GetService("Players").LocalPlayer.Character
 local folder=character and character.Parent
 for _,impact in data.impacts do
  if impact.serial==nil or impact.serial&gt;self.impactSerial then
   local lh=self.localHit
   local played=lh and not lh.used and data.bot and impact.victim==data.bot.id and CONTACT_STYLE[impact.style or ""] and os.clock()-lh.at&lt;.4
   if played then lh.used=true;impact.tinted=true
   else
    Feedback.impact(impact.style or "light",impact.position,impact)
    if camera and camera.impulse then camera:impulse(impact.style,impact.role,impact) end
    -- (FEEL 05/11) the hit stop for a contact the client did not guess: both
    -- bodies hold, the struck one shakes (not on a guard: a guard is a stop
    -- for the attacker's arm only).
    if impact.victim and not impact.guarded and data.human and data.bot then
     local struck=if impact.victim==data.human.id then "human" elseif impact.victim==data.bot.id then "bot" else nil
     if struck then self:hitstop({human=struck=="human",bot=struck=="bot"},impact.style,impact.direction) end
    elseif impact.guarded then
     self:hitstop({human=false,bot=false},"block",impact.direction)
    end
   end
   self.fx:impact(impact,folder)
  end
 end
 self.impactSerial=serial
end
-- Genjutsu image. The server says who is deceived (illusion + decoy on that
-- actor). Seen by the deceived player, the image IS Itachi: a frozen copy in
-- his stance facing them, with a faint red outline pulsing now and then (the
-- tell), and the real body behind it drawn faint. Seen by Itachi's player, the
-- image is a red translucent afterimage of himself: he sees the trap he left.
function Presentation.fade(model,amount)
 if not model then return end
 for _,d in model:GetDescendants() do if d:IsA("BasePart") then d.LocalTransparencyModifier=amount end end
end
function Presentation:clearEcho()
 local echo=self.echo
 if not echo then return end
 if echo.model then echo.model:Destroy() end
 if echo.mode=="deceived" then Presentation.fade(echo.source,0) end
 self.echo=nil
end
-- Which view of the genjutsu this client draws: "deceived" (my fighter is
-- under it), "caster" (the opponent is under mine) or nil.
function Presentation.illusionView(data)
 if not data or data.phase~="Duel" then return nil end
 if data.human and (data.human.illusion or 0)&gt;0 and data.human.decoy then return "deceived",data.human.decoy end
 if data.bot and (data.bot.illusion or 0)&gt;0 and data.bot.decoy then return "caster",data.bot.decoy end
 return nil
end
function Presentation:illusion(data,model)
 local folder=model and model.Parent
 local opponent=Presentation.opponent(data,folder)
 local mode,decoy=Presentation.illusionView(data)
 local source=if mode=="deceived" then opponent elseif mode=="caster" then model else nil
 local watcher=if mode=="deceived" then model else opponent
 if not source then mode=nil end
 local echo=self.echo
 if echo and (echo.mode~=mode or echo.epoch~=data.epoch or echo.source~=source) then self:clearEcho();echo=nil end
 if not mode then return end
 if not echo then
  echo={mode=mode,epoch=data.epoch,source=source,model=self.fx:image(source,mode),born=os.clock()}
  self.echo=echo
 end
 -- (07/11, Studio: two Itachi, one solid and one ghost; the ghost read as
 -- the fake) the real body is a faint shimmer behind the image.
 if mode=="deceived" then Presentation.fade(source,.82) end
 local image=echo.model
 if not image then return end
 local root=watcher and watcher:FindFirstChild("HumanoidRootPart")
 local look=if root then Vector3.new(root.Position.X-decoy.X,0,root.Position.Z-decoy.Z) else Vector3.zero
 if look.Magnitude&lt;.1 then look=Vector3.zAxis end
 local t=os.clock()-echo.born
 local at=decoy+Vector3.new(0,math.sin(t*5)*.03,0)
 image:PivotTo(CFrame.lookAt(at,at+look.Unit))
 local tell=image:FindFirstChild("Tell")
 if tell then tell.OutlineTransparency=1-.45*math.max(0,math.sin(t*7))^8 end
end
-- Local presentation clocks: an attack animates from the frame it was first
-- seen, so a late or jittery packet cannot make the body jump backwards.
local function clockFor(self,key,actor,now)
 local clock=self.clocks[key]
 if not clock then clock={};self.clocks[key]=clock end
 -- (FEEL 05/11) Hit stop: the clips hold on the contact frame, then resume
 -- from it (their start moves forward by the time they were held).
 local frozen=self:frozen(key,now)
 if frozen then
  clock.heldFrom=clock.heldFrom or now
 elseif clock.heldFrom then
  local held=now-clock.heldFrom
  clock.heldFrom=nil
  if clock.attackAt then clock.attackAt+=held end
  if clock.reactionAt then clock.reactionAt+=held end
 end
 local at=clock.heldFrom or now
 -- A new swing restarts the clock even when it repeats the same move name.
 if actor.attackName~=clock.attackName or (actor.attackSerial or 0)~=clock.attackSerial then
  -- Start the clip where the server already is: a snapshot arrives up to an
  -- interval late, and a clip restarted at 0 trailed the real contact (the
  -- launcher's kick was cut off by the chase before it ever showed).
  clock.attackName=actor.attackName;clock.attackSerial=actor.attackSerial or 0
  clock.attackAt=now-math.clamp(actor.attackElapsed or 0,0,.12)
 end
 -- A fresh contact restarts the recoil even when it repeats the same reaction
 -- kind (Light1 -&gt; Light2 are both HitStun), so every hit reads as a hit.
 if actor.reaction~=clock.reaction or (actor.reaction and (actor.impactSerial or 0)~=clock.impactSerial) then
  clock.reaction=actor.reaction;clock.reactionAt=now
 end
 clock.impactSerial=actor.impactSerial or 0
 clock.attackElapsed=if actor.attackName then math.max(0,at-clock.attackAt) else 0
 clock.reactionElapsed=if actor.reaction then math.max(0,at-clock.reactionAt) else 0
 return clock
end
-- A landing belongs to one body. Opponent landings must never bend the
-- player's knees; keep a local phase so compression releases before neutral.
function Presentation:landing(key,actor,previous,now)
 if previous and previous.airborne and not actor.airborne then
  self.landings[key]={at=now,duration=if actor.landStrong then .22 else .1,strong=actor.landStrong==true,pending=true}
 end
 local landing=self.landings[key]
 if not landing then return false,0,false end
 -- (Audit 29/10) The server says "landed" before the drawn body gets there
 -- (it is drawn ~45 ms behind its replicated root): at a fall's speed the
 -- crouch began two studs up in the air. It starts when the drawn body
 -- reaches the floor it landed on (or after 0.12 s at most).
 if landing.pending then
  local drawn=self.visualRoot and self:visualRoot(key)
  local floor=actor.position and actor.position.Y
  if drawn and floor and drawn.Y-floor&gt;.35 and now-landing.at&lt;.12 then return false,0,false end
  landing.pending=nil;landing.at=now
 end
 if actor.airborne or now&gt;=landing.at+landing.duration then
  self.landings[key]=nil
  return false,0,false
 end
 return true,math.clamp((now-landing.at)/landing.duration,0,1),landing.strong
end
function Presentation:update(data,dt)
 dt=math.max(dt or 1/60,.001)
 -- One presentation tick per rendered frame; every pose below reads this clock.
 Motion.tick(dt)
 local players=game:GetService("Players")
 if not data.human then
  self:clearEcho()
  self.fx:update(data,dt,nil)
  self.bodies:update(data,dt,nil)
  return
 end
 if self.epoch~=data.epoch then
  -- Character switch, rematch or a fresh duel: the only place a hard reset is
  -- right. Normal presentation never snaps the skeleton.
  self.epoch=data.epoch
  table.clear(self.clocks);table.clear(self.last);table.clear(self.smooth);table.clear(self.landings)
  self.lead=nil;self.prediction=nil;self.movePrediction=nil;self.strikeGuess=nil;self.localHit=nil;table.clear(self.freeze)
  self.smears={}
  if players.LocalPlayer.Character then Motion.reset(players.LocalPlayer.Character) end
  if self.botModel then Motion.reset(self.botModel) end
 end
 local now=os.clock()
 local character=players.LocalPlayer.Character
 self:illusion(data,character)
 local folder=character and character.Parent
 local bot=Presentation.opponent(data,folder)
 self.botModel=bot
 local models={human=character,bot=bot}
 for key,model in models do
  local actor=data[key];local previous=self.last[key]
  if model and actor then
   -- The motion engine owns every joint. A Humanoid Animator (run locally for
   -- the player's own character) resets the joints between our write and the
   -- render, which left the body in its rest pose; remove it on this client.
   local humanoid=model:FindFirstChildOfClass("Humanoid")
   local animator=humanoid and humanoid:FindFirstChildOfClass("Animator")
   if animator then animator:Destroy() end
   if key=="human" then
    actor=self:applyPrediction(actor,now)
    local me=model:FindFirstChild("HumanoidRootPart")
    if me then self.myLook=me.CFrame.LookVector end
    local them=bot and bot:FindFirstChild("HumanoidRootPart")
    local hit=self:localContact(data,me and me.Position,them and them.Position,now)
    if hit then
     Feedback.impact(hit.style,hit.position,{victim=data.bot and data.bot.id,predicted=true})
     if self.camera and self.camera.impulse then self.camera:impulse(hit.style,"attacker",{predicted=true}) end
     -- (FEEL 05/11) the blow lands on the frame the fist arrives: both bodies
     -- hold, the struck one flashes and shakes along the strike.
     local dir=if me and them then Vector3.new(them.Position.X-me.Position.X,0,them.Position.Z-me.Position.Z) else nil
     self:hitstop({human=false,bot=true},hit.style,dir,now)
     local flash=FLASH[hit.style]
     if flash and bot then pcall(Presentation.flash,bot,flash[1],flash[2]) end
    end
   end
   local clock=clockFor(self,key,actor,now)
   local root=model:FindFirstChild("HumanoidRootPart")
   -- The body is drawn on a smoothed track of the replicated root (see
   -- Presentation:smoothStep, run just before each frame is rendered).
   -- Take-off and get-up sounds, from the state change itself.
   if previous and not previous.airborne and actor.airborne and root and root.AssemblyLinearVelocity.Y&gt;15 and not actor.reaction then self.fx:jumpSound(root.Position) end
   if previous and previous.reaction=="Wakeup" and actor.reaction~="Wakeup" and root then self.fx:getUpSound(root.Position) end
   local landing,landingPhase,landingStrong=self:landing(key,actor,previous,now)
   -- Health lost without a new contact (burn, sand): a slow drain such as the
   -- curse mark (~0.1 HP per snapshot) is not a hit and spawns nothing.
   if previous and actor.health&lt;=previous.health-1 and actor.impactSerial==(previous.impactSerial or -1) then
    local damage=previous.health-actor.health
    if root then Feedback.burst(root.Position,if actor.cue=="GUARDED" then Color3.fromRGB(255,235,160) else Color3.fromRGB(255,91,74),damage,actor.cue=="GUARDED") end
   end
   if actor.events and previous and actor.events.Parry and actor.events.Parry&gt;(previous.parry or 0) then
    if root then Feedback.burst(root.Position,Color3.fromRGB(255,245,176),0,true) end
   end
   -- Locomotion is posed from the rig's live velocity, not a 10 Hz value.
   local tracked=self:visualVelocity(key)
   local velocity=if root then root.AssemblyLinearVelocity else actor.velocity
   if tracked and velocity then
    -- Wall motion is positioned by the server with zero assembly velocity.
    -- Its vertical cadence must follow the drawn track as well as its X/Z.
    velocity=Vector3.new(tracked.X,if actor.wall then tracked.Y else velocity.Y,tracked.Z)
   end
   local planar=if velocity then Vector3.new(velocity.X,0,velocity.Z).Magnitude else 0
   local speed=if key=="human" and self.lead then planar else math.max(actor.speed or 0,planar)
   -- Everything the presentation contract needs, with locally measured clocks so
   -- a late packet cannot make the body replay its wind-up.
   local visual=table.clone(actor)
   -- A dash is server-driven translation: pose it from its declared direction.
   visual.velocity=if actor.state=="Dodging" then actor.velocity else velocity
   visual.speed=speed
   visual.reactionElapsed=clock.reactionElapsed
   visual.attackElapsed=clock.attackElapsed
   visual.landing=landing;visual.landingPhase=landingPhase;visual.landStrong=landingStrong
   visual.intro=data.intro
   -- (Partie 2) The winner's pose after the K.O. and on the result screen.
   visual.victory=data.winner~=nil and (data.ko==true or data.phase=="Result") and (actor.health or 0)&gt;0
    and ((key=="human")==(data.winner=="PlayerFighter"))
   local other=if key=="human" then "bot" else "human"
   visual.lookAt=self:visualRoot(other) or (data[other] and data[other].position)
   -- Throws and casts run on the shared server clock (slightly behind, like the
   -- projectiles), so the blade leaves the hand on the frame it starts flying.
   if data.serverNow then
    local visualNow=workspace:GetServerTimeNow()-Effects.DELAY
    if actor.throwElapsed then visual.throwElapsed=visualNow-(data.serverNow-actor.throwElapsed) end
    if actor.castElapsed then visual.castElapsed=workspace:GetServerTimeNow()-(data.serverNow-actor.castElapsed) end
    if actor.channel then visual.channel=math.max(0,actor.channel-(workspace:GetServerTimeNow()-data.serverNow)) end
   end
   Motion.weapon(model,visual)
   self.presented=self.presented or {}
   self.presented[key]=string.format("%s hp=%s state=%s",tostring(Motion.present(model,visual,clock,dt)),tostring(visual.health),tostring(visual.state))
   -- Speed smear (fluidity pass): faster than a sprint, or a teleport, is
   -- drawn as motion. Not during an intro or between rounds (repositioning).
   self.smears=self.smears or {}
   self.smears[key]=self.smears[key] or {}
   if data.phase=="Duel" and (data.intro or 0)&lt;=0 then Smear.step(self.smears[key],model,dt) else self.smears[key]={} end
   self.arcs=self.arcs or {}
   self.arcs[key]=self.arcs[key] or {}
   Smear.limbs(self.arcs[key],model,actor.attackName~=nil and (actor.state=="Startup" or actor.state=="Active"))
   self.last[key]={health=actor.health,attackName=actor.attackName,parry=actor.events and actor.events.Parry or 0,
    impactSerial=actor.impactSerial or 0,airborne=actor.airborne,reaction=actor.reaction}
  end
 end
 self.fx:update(data,dt,folder)
 self.bodies:update(data,dt,folder)
end
return Presentation
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND226">
          <Properties>
            <string name="Name">SandFX</string>
            <ProtectedString name="Source">-- Gaara's sand on the client: the sand bullet and Sand Shuriken in flight, the
-- Sand Coffin wave and the body it holds, the automatic shield and its charges,
-- the body-flicker, the burial, the Desert Wave, the glide, and the lashes and
-- pillar of his strings. One identity layer installed into Effects (DEC-015: a
-- fighter's look lives in its own module, Effects only offers the registry and
-- helpers). Presentation only: nothing here can change gameplay.
--
-- Sand is one medium: moving sand is drawn as streams (two Beams with a
-- scrolling dust texture, a pale loose layer over a dense darker core) carried
-- by invisible handles, with grains and dust thrown off them. The first pass
-- used solid balls and cylinders, which read as blobs and planks (V1 directive).
local Debris=game:GetService("Debris")
local Tween=game:GetService("TweenService")
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Attacks=require(Shared.Attacks)
local Fighters=require(Shared.Fighters)

local SandFX={}
local K -- Effects' helpers, handed over by install()
SandFX.clock=os.clock -- (headless tests drive time)

local SAND=Color3.fromRGB(212,176,118)
local SAND_DARK=Color3.fromRGB(176,136,82)
local SAND_PALE=Color3.fromRGB(238,218,176)
local SHUKAKU=Color3.fromRGB(222,176,112)
local GRAIN=Enum.Material.Sand

local function smooth(x) x=math.clamp(x,0,1) return x*x*(3-2*x) end
local function flatUnit(v,fallback)
	local f=Vector3.new(v.X,0,v.Z)
	return if f.Magnitude&gt;.05 then f.Unit else (fallback or Vector3.zAxis)
end
local function ground(fx,position,fallback)
	local ok,hit=pcall(K.floorUnder,fx,position,3,12)
	return if ok and hit then hit.Position.Y else fallback
end
-- Grains thrown out and falling back: what makes it read as sand, not smoke.
local function grains(fx,position,count,speed,up)
	K.burst(fx.folder,position,{Texture=K.TEX.smoke,Lifetime=NumberRange.new(.35,.7),Speed=NumberRange.new(speed*.5,speed),
		SpreadAngle=if up then Vector2.new(40,40) else Vector2.new(180,180),EmissionDirection=Enum.NormalId.Top,
		Color=ColorSequence.new(SAND),LightEmission=0,LightInfluence=1,Size=K.num({{0,.4},{1,.15}}),
		Transparency=K.num({{0,.05},{.7,.25},{1,1}}),Acceleration=Vector3.new(0,-60,0),Drag=1.5,Rotation=NumberRange.new(0,360)},count)
end
local function dust(fx,position,count,size) K.smokePuff(fx.folder,position,SAND_PALE,count,size) end
local function thud(fx,position,volume,speed) K.sound(K.anchorPart(fx.folder,position),K.SOUND.land,volume,speed) end

-- ------------------------------------------------------------------ streams
-- An invisible handle whose X axis is the stream's direction there (a Beam
-- curves along its attachments' axes: CurveSize0/1).
local function frame(pos,dir)
	dir=if dir.Magnitude&gt;.01 then dir.Unit else Vector3.yAxis
	local up=Vector3.yAxis-dir*dir.Y
	if up.Magnitude&lt;.05 then up=Vector3.xAxis-dir*dir.X end
	return CFrame.fromMatrix(pos,dir,up.Unit)
end
local function handle(parent,pos,dir)
	local p=K.block(parent,Vector3.new(.2,.2,.2),frame(pos,dir or Vector3.yAxis),SAND,Enum.Material.SmoothPlastic)
	p.Name="Handle";p.Transparency=1
	return p,K.new("Attachment",{},p)
end
local function ribbon(parent,a0,a1,w0,w1,core)
	return K.new("Beam",{Attachment0=a0,Attachment1=a1,Width0=w0,Width1=w1,Texture=K.TEX.smoke,TextureMode=Enum.TextureMode.Wrap,
		TextureLength=if core then 2 else 3,TextureSpeed=if core then 2.4 else 1.5,Color=ColorSequence.new(if core then SAND_DARK else SAND_PALE),
		Transparency=K.num(if core then {{0,0},{1,.04}} else {{0,.12},{1,.25}}),LightEmission=0,LightInfluence=1,FaceCamera=true,
		Segments=14,ZOffset=if core then .1 else 0},parent)
end
-- A stream: loose dust over a dense core, both between the same two handles.
local function stream(parent,a0,a1,w0,w1)
	return {ribbon(parent,a0,a1,w0*1.6,w1*1.6,false),ribbon(parent,a0,a1,w0,w1,true)}
end
local function widths(beams,w0,w1) beams[1].Width0=w0*1.6;beams[1].Width1=w1*1.6;beams[2].Width0=w0;beams[2].Width1=w1 end
local function curves(beams,c0,c1) for _,b in beams do b.CurveSize0=c0;b.CurveSize1=c1 end end
local function fadeWidths(beams,time) for _,b in beams do K.tween(b,time,{Width0=0,Width1=0}) end end
-- A one-off upright stream from `foot`, rising to `height` over `rise` s.
local function column(parent,foot,height,w0,w1,rise,lean)
	local h0,a0=handle(parent,foot,Vector3.yAxis)
	local h1,a1=handle(parent,foot+Vector3.new(0,.3,0),Vector3.yAxis)
	local beams=stream(parent,a0,a1,w0,w1)
	local top=foot+Vector3.new(0,height,0)+(lean or Vector3.zero)
	K.tween(h1,rise,{CFrame=frame(top,top-foot)})
	return {base=h0,top=h1,beams=beams,foot=foot}
end
-- A burst of sand that stays together as a curtain: emitted inside a box.
local function curtain(fx,cf,size,count,up)
	local box=K.block(fx.folder,size,cf,SAND,Enum.Material.SmoothPlastic);box.Transparency=1
	local e=K.new("ParticleEmitter",{Enabled=false,Texture=K.TEX.smoke,Shape=Enum.ParticleEmitterShape.Box,ShapeStyle=Enum.ParticleEmitterShapeStyle.Volume,
		EmissionDirection=Enum.NormalId.Top,Speed=NumberRange.new(up*.5,up),Lifetime=NumberRange.new(.4,.75),SpreadAngle=Vector2.new(15,15),
		Color=ColorSequence.new(SAND),LightEmission=0,LightInfluence=1,Size=K.num({{0,1.2},{.5,2},{1,1.4}}),Transparency=K.num({{0,.15},{.7,.35},{1,1}}),
		Acceleration=Vector3.new(0,-30,0),Drag=1,Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-40,40)},box)
	e:Emit(count)
	Debris:AddItem(box,1.2)
	return box
end
-- A body pours to the floor: each visible part sheds its volume as sand.
local function sandBody(fx,model,at)
	local root=model:FindFirstChild("HumanoidRootPart")
	if not root then return end
	-- The impact may arrive after the body already reappeared elsewhere.
	local shift=at-root.Position
	if shift.Magnitude&lt;1.5 then shift=Vector3.zero end
	local holder=K.new("Model",{Name="SandBody"},fx.folder)
	for _,d in model:GetChildren() do
		if d:IsA("BasePart") and d.Name~="HumanoidRootPart" and d.Transparency&lt;.9 then
			local box=K.block(holder,d.Size,d.CFrame+shift,SAND,Enum.Material.SmoothPlastic);box.Transparency=1
			local e=K.new("ParticleEmitter",{Enabled=false,Texture=K.TEX.smoke,Shape=Enum.ParticleEmitterShape.Box,ShapeStyle=Enum.ParticleEmitterShapeStyle.Volume,
				Speed=NumberRange.new(0,1.5),Lifetime=NumberRange.new(.45,.75),Color=ColorSequence.new(SAND),LightEmission=0,LightInfluence=1,
				Size=K.num({{0,.9},{1,.5}}),Transparency=K.num({{0,.1},{.6,.3},{1,1}}),Acceleration=Vector3.new(0,-45,0),Rotation=NumberRange.new(0,360)},box)
			e:Emit(math.clamp(math.floor(d.Size.X*d.Size.Y*d.Size.Z*4),4,18))
		end
	end
	grains(fx,at,20,8,true)
	Debris:AddItem(holder,1)
end

-- ------------------------------------------------------------------ flights
-- Sand bullet / Sand Shuriken: a small hardened clump tumbling, shedding dust.
local function buildBullet()
	local model=K.new("Model",{Name="SandBullet"})
	local root=K.block(model,Vector3.one*.8,CFrame.new(),SAND,GRAIN);root.Name="Root";root.Shape=Enum.PartType.Ball
	local tail=K.block(model,Vector3.one*.5,CFrame.new(0,.1,.32),SAND_DARK,GRAIN);tail.Name="Tail";tail.Shape=Enum.PartType.Ball
	K.weldAll(root,{tail})
	local at=K.new("Attachment",{},root)
	K.new("ParticleEmitter",{Texture=K.TEX.smoke,Rate=80,Lifetime=NumberRange.new(.25,.45),Speed=NumberRange.new(0,1.5),SpreadAngle=Vector2.new(25,25),
		Color=ColorSequence.new(SAND_PALE),LightEmission=0,LightInfluence=1,Size=K.num({{0,.8},{1,1.8}}),Transparency=K.num({{0,.3},{1,1}}),
		Drag=3,Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-60,60)},at)
	model.PrimaryPart=root
	return model
end
local function bulletPose(_,entry,_,_,look,dt)
	entry.spin+=dt*9
	return look*CFrame.Angles(entry.spin,entry.spin*.6,0)
end
-- Sand Coffin: a wave of sand running along the floor — a churning crest that
-- grows as it travels and lays dust down behind it.
local function buildWave()
	local model=K.new("Model",{Name="SandWave"})
	local root=K.block(model,Vector3.new(3,.4,3),CFrame.new(),SAND,Enum.Material.SmoothPlastic);root.Name="Root";root.Transparency=1
	local at=K.new("Attachment",{Name="Spray"},root)
	K.new("ParticleEmitter",{Name="Crest",Texture=K.TEX.smoke,Shape=Enum.ParticleEmitterShape.Box,ShapeStyle=Enum.ParticleEmitterShapeStyle.Volume,
		EmissionDirection=Enum.NormalId.Top,Rate=170,Lifetime=NumberRange.new(.3,.6),Speed=NumberRange.new(5,11),SpreadAngle=Vector2.new(25,25),
		Color=ColorSequence.new(SAND),LightEmission=0,LightInfluence=1,Size=K.num({{0,1.4},{.5,2.4},{1,1.6}}),Transparency=K.num({{0,.12},{.7,.3},{1,1}}),
		Acceleration=Vector3.new(0,-38,0),Drag=1,Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-60,60)},root)
	K.new("ParticleEmitter",{Name="Spray",Texture=K.TEX.smoke,Rate=60,Lifetime=NumberRange.new(.35,.7),Speed=NumberRange.new(3,7),SpreadAngle=Vector2.new(55,55),
		EmissionDirection=Enum.NormalId.Top,Color=ColorSequence.new(SAND_PALE),LightEmission=0,LightInfluence=1,Size=K.num({{0,1.2},{1,3}}),
		Transparency=K.num({{0,.3},{1,1}}),Drag=3,Acceleration=Vector3.new(0,-6,0),Rotation=NumberRange.new(0,360)},at)
	K.new("ParticleEmitter",{Name="Settle",Texture=K.TEX.smoke,Rate=40,Lifetime=NumberRange.new(.9,1.3),Speed=NumberRange.new(0,.6),SpreadAngle=Vector2.new(180,180),
		Color=ColorSequence.new(SAND_DARK),LightEmission=0,LightInfluence=1,Size=K.num({{0,2.2},{1,3.4}}),Transparency=K.num({{0,.55},{1,1}}),
		Rotation=NumberRange.new(0,360)},at)
	model.PrimaryPart=root
	return model
end
local function wavePose(fx,entry,p,age,look,dt)
	local radius=((p.radius or 1.8)+(p.growth or 0)*math.max(0,age))*1.2
	local pos=look.Position
	entry.groundIn=(entry.groundIn or 0)-dt
	if entry.groundIn&lt;=0 then entry.groundIn=.1;entry.ground=ground(fx,pos,entry.ground or pos.Y-1.6) end
	local y=entry.ground or pos.Y-1.6
	local at=Vector3.new(pos.X,y+.3,pos.Z)
	-- The crest box grows with the wave (the emitter fills the root's volume).
	entry.root.Size=Vector3.new(radius*1.7,.4,radius*1.1)
	return CFrame.lookAt(at,at+flatUnit(p.direction))
end

-- ------------------------------------------------------------------ contacts
local STYLES={}
STYLES.sandhit=function(fx,impact)
	dust(fx,impact.position,8,1.3)
	grains(fx,impact.position,12,14,false)
	thud(fx,impact.position,.3,1.4)
end
STYLES.sandburst=function(fx,impact)
	local y=ground(fx,impact.position,impact.position.Y-2.6)
	dust(fx,impact.position,18,2.4)
	grains(fx,impact.position,26,22,true)
	curtain(fx,CFrame.new(impact.position.X,y+1,impact.position.Z),Vector3.new(5,1.5,5),40,14)
	thud(fx,impact.position,.45,.8)
end
-- The shield: an arc of sand streams snaps up between him and the blow with a
-- curtain of sand in front, then pours back down; a breaking blow bursts it.
STYLES.sandshield=function(fx,impact)
	local at=impact.position
	local face=flatUnit(impact.direction or Vector3.zAxis)
	local breaking=impact.heavy==true
	local centre=at-face*1.6
	local y=ground(fx,centre,centre.Y-3)
	local holder=K.new("Model",{Name="SandShield"},fx.folder)
	local cols={}
	for k=-2,2 do
		local dir=CFrame.fromAxisAngle(Vector3.yAxis,math.rad(k*22)):VectorToWorldSpace(face)
		local foot=Vector3.new(centre.X,y+.2,centre.Z)+dir*2.4
		local c=column(holder,foot,5.6-math.abs(k)*.45,2.6,2.1,.07,dir*.35)
		c.dir=dir
		table.insert(cols,c)
	end
	curtain(fx,CFrame.lookAt(Vector3.new(centre.X,y+2.4,centre.Z)+face*2.3,Vector3.new(centre.X,y+2.4,centre.Z)+face*4),Vector3.new(4.5,4,.8),if breaking then 70 else 45,6)
	dust(fx,at,if breaking then 22 else 10,if breaking then 2.4 else 1.6)
	grains(fx,at,if breaking then 30 else 14,if breaking then 26 else 14,false)
	thud(fx,at,if breaking then .7 else .45,if breaking then .55 else .9)
	if breaking then
		fx:cheer(.6)
		task.delay(.06,function()
			for _,c in cols do
				if c.top.Parent then
					local fly=c.foot+c.dir*4+Vector3.new((math.random()-.5)*2,2+math.random()*2,(math.random()-.5)*2)
					K.tween(c.top,.35,{CFrame=frame(fly,fly-c.foot)});fadeWidths(c.beams,.35)
				end
			end
		end)
		Debris:AddItem(holder,.5)
	else
		task.delay(.24,function()
			for _,c in cols do
				if c.top.Parent then K.tween(c.top,.35,{CFrame=frame(c.foot+Vector3.new(0,.4,0),Vector3.yAxis)},Enum.EasingStyle.Quad,Enum.EasingDirection.In);fadeWidths(c.beams,.35) end
			end
		end)
		Debris:AddItem(holder,.7)
	end
end
-- Sand body-flicker: the body pours to the floor where he stood and a column
-- of sand gathers into him where he reappears.
STYLES.sandflicker=function(fx,impact,folder)
	local from=impact.position
	local to=impact.to or from
	local model=folder and folder:FindFirstChild(impact.owner or "")
	if model then sandBody(fx,model,from) end
	local y=ground(fx,to,to.Y-3)
	local holder=K.new("Model",{Name="SandGather"},fx.folder)
	local c=column(holder,Vector3.new(to.X,y,to.Z),5.5,1.8,1,.12)
	task.delay(.12,function() if c.top.Parent then fadeWidths(c.beams,.22) end end)
	Debris:AddItem(holder,.4)
	dust(fx,to-Vector3.new(0,2.4,0),10,1.5)
	if (to-from).Magnitude&gt;1 then
		for k=1,4 do grains(fx,from:Lerp(to,k/5)-Vector3.new(0,1,0),5,6,true) end
	end
	K.sound(K.anchorPart(fx.folder,from),K.SOUND.whoosh,.35,.6)
end
-- Sand Burial: the sand closes in on the body and bursts.
STYLES.sandburial=function(fx,impact)
	local at=impact.position
	local shell=K.block(fx.folder,Vector3.one*.4,CFrame.new(at),SAND,Enum.Material.SmoothPlastic);shell.Transparency=1
	local e=K.new("ParticleEmitter",{Enabled=false,Texture=K.TEX.smoke,Shape=Enum.ParticleEmitterShape.Sphere,ShapeInOut=Enum.ParticleEmitterShapeInOut.Inward,
		Speed=NumberRange.new(14,20),Lifetime=NumberRange.new(.18,.26),Color=ColorSequence.new(SAND),LightEmission=0,LightInfluence=1,
		Size=K.num({{0,2.4},{1,1.4}}),Transparency=K.num({{0,.1},{1,.4}}),Rotation=NumberRange.new(0,360)},shell)
	shell.Size=Vector3.one*8
	e:Emit(70)
	Debris:AddItem(shell,.6)
	task.delay(.16,function()
		dust(fx,at,30,3)
		grains(fx,at+Vector3.new(0,1,0),40,30,false)
		local y=ground(fx,at,at.Y-3)
		curtain(fx,CFrame.new(at.X,y+1,at.Z),Vector3.new(6,1.5,6),50,18)
		K.sound(K.anchorPart(fx.folder,at),K.SOUND.boom,.55,.6)
	end)
	fx:cheer(1)
end
-- Desert Wave: a wall of sand streams rises in front of him, then its crest
-- falls forward onto whoever stood there.
STYLES.sandwall=function(fx,impact)
	local at=impact.position
	local look=flatUnit(impact.direction or Vector3.zAxis)
	local y=ground(fx,at,at.Y-3)
	local across=Vector3.new(-look.Z,0,look.X)
	local holder=K.new("Model",{Name="DesertWave"},fx.folder)
	for k=-3,3 do
		local foot=Vector3.new(at.X,y,at.Z)+across*k*1.6-look*math.abs(k)*.3
		local height=6.8-math.abs(k)*.5+math.random()*.6
		local c=column(holder,foot,height,2.8,2.1,.12+math.abs(k)*.02,look*.6)
		task.delay(.42,function()
			if not c.top.Parent then return end
			-- The crest tips forward and pours down in front of the wall.
			local fall=foot+look*4.5+Vector3.new(0,1,0)
			K.tween(c.top,.4,{CFrame=frame(fall,fall-foot)},Enum.EasingStyle.Quad,Enum.EasingDirection.In)
			fadeWidths(c.beams,.45)
		end)
	end
	Debris:AddItem(holder,1.1)
	local foot=Vector3.new(at.X,y,at.Z)
	curtain(fx,CFrame.lookAt(foot+Vector3.new(0,1.5,0),foot+Vector3.new(0,1.5,0)+look),Vector3.new(11,2.5,1.4),80,16)
	dust(fx,foot+Vector3.new(0,1,0),26,3)
	grains(fx,foot+Vector3.new(0,.5,0),40,30,true)
	K.sound(K.anchorPart(fx.folder,at),K.SOUND.whoosh,.55,.5)
	thud(fx,at,.5,.6)
	fx:cheer(.6)
end
-- Shukaku's Sand (awakening): sand spirals up around him.
local function awaken(fx,impact,folder)
	local at=impact.position
	local model=folder and folder:FindFirstChild(impact.owner or "")
	if model then fx:ghost(model,SHUKAKU,.35,.45) end
	local y=ground(fx,at,at.Y-3)
	local holder=K.new("Model",{Name="ShukakuSand"},fx.folder)
	for k=0,3 do
		local a=k/4*math.pi*2
		local foot=Vector3.new(at.X,y,at.Z)+Vector3.new(math.cos(a),0,math.sin(a))*2.4
		local c=column(holder,foot,7,1.4,.9,.18,Vector3.new(math.cos(a+1.4),0,math.sin(a+1.4))*2)
		task.delay(.3,function() if c.top.Parent then fadeWidths(c.beams,.3) end end)
	end
	Debris:AddItem(holder,.8)
	dust(fx,Vector3.new(at.X,y+1,at.Z),26,2.8)
	grains(fx,at,40,26,true)
	curtain(fx,CFrame.new(at.X,y+1,at.Z),Vector3.new(7,2,7),60,18)
	fx:cheer(1)
end
local function impact(fx,data,folder)
	local style=data.style
	local handler=STYLES[style]
	if handler then handler(fx,data,folder);return true end
	if data.fighter~="Sand" then return false end
	-- Shared contact styles drawn in sand instead of another fighter's colours.
	if style=="awaken" then awaken(fx,data,folder);return true end
	if style=="chase" or style=="afterimage" then
		local model=folder and folder:FindFirstChild(data.owner or "")
		if model then sandBody(fx,model,data.position) end
		dust(fx,data.position-Vector3.new(0,2.6,0),8,1.4)
		K.sound(K.anchorPart(fx.folder,data.position),K.SOUND.whoosh,.35,.7)
		return true
	end
	return false
end

-- ------------------------------------------------------------------ per frame
-- Lashes: a stream of sand from the hand that strikes, out on the clip's
-- contact key, held through the active frames, drawn back in the recovery.
local LASH={
	Light1={{"RightHand",1}},Light2={{"LeftHand",-1}},Light3={{"RightHand",.7},{"LeftHand",-.7}},
	Air1={{"RightHand",1}},Air2={{"LeftHand",-1}},Riposte={{"RightHand",1}},
	DashAttack={{"RightHand",.45},{"LeftHand",-.45}},Sweep={{"RightHand",1.3,low=true}},
	Slam={{"RightHand",.25,down=true},{"LeftHand",-.25,down=true}},
	Light4={{"RightHand",1}},Light5={{"LeftHand",-1}},
	SandHand={{"RightHand",.15},{"LeftHand",-.15}},SandLowWave={{"RightHand",.6,down=true},{"LeftHand",-.6,down=true}},SandGlide={{"RightHand",.8}},SandFist={{"RightHand",.5},{"LeftHand",-.5}},
}
-- The move's own timeline as the motion engine plays it (same per-fighter
-- timings and lead), so the sand leaves the hand on the clip's contact key.
local LEAD=.03
local function timing(name)
	local spec=Attacks[name] or Attacks.Light1
	local profile=Fighters.Sand.AttackProfile and (Fighters.Sand.AttackProfile[name] or Fighters.Sand.AttackProfile[spec.clip or ""])
	return spec.startup*(profile and profile.startup or 1),spec.active*(profile and profile.active or 1),spec.recovery*(profile and profile.recovery or 1)
end
local function reachOf(name)
	local clip=Attacks[name] and Attacks[name].clip or ""
	local profile=Fighters.Sand.AttackProfile and (Fighters.Sand.AttackProfile[name] or Fighters.Sand.AttackProfile[clip])
	return (profile and profile.range) or (Attacks[name] and Attacks[name].range) or 8
end
local function stateOf(fx,model)
	fx.sandState=fx.sandState or setmetatable({},{__mode="k"})
	local st=fx.sandState[model]
	if not st then st={};fx.sandState[model]=st end
	return st
end
local function newLash(fx,spec)
	local holder=K.new("Model",{Name="SandLash"},fx.folder)
	local h0,a0=handle(holder,Vector3.zero)
	local h1,a1=handle(holder,Vector3.zero)
	h1.Name="Tip"
	local beams=stream(holder,a0,a1,0,0)
	local spray=K.new("ParticleEmitter",{Texture=K.TEX.smoke,Rate=0,Lifetime=NumberRange.new(.2,.4),Speed=NumberRange.new(1,3),SpreadAngle=Vector2.new(180,180),
		Color=ColorSequence.new(SAND),LightEmission=0,LightInfluence=1,Size=K.num({{0,1.4},{1,2.2}}),Transparency=K.num({{0,.2},{1,1}}),Drag=4,
		Rotation=NumberRange.new(0,360)},a1)
	return {holder=holder,h0=h0,h1=h1,beams=beams,spray=spray,hand=spec[1],arc=spec[2],low=spec.low,down=spec.down}
end
local function dropLashes(st)
	for _,l in st.lashes or {} do l.holder:Destroy() end
	st.lashes=nil
end
-- Sand Pillar: sand erupts under the opponent when he stands in the volume,
-- otherwise where the volume ends: twisting streams, a crown that bursts open
-- and a geyser of sand.
local function pillar(fx,model,root)
	local look=flatUnit(root.CFrame.LookVector)
	local spot=root.Position+look*7
	for _,id in fx.fighterIds or {} do
		local other=fx.fighters and fx.fighters:FindFirstChild(id)
		local r=other and other~=model and other:FindFirstChild("HumanoidRootPart")
		if r then
			local d=r.Position-root.Position
			local f=Vector3.new(d.X,0,d.Z)
			if f.Magnitude&lt;13 and (f.Magnitude&lt;1 or look:Dot(f.Unit)&gt;.25) then spot=r.Position end
		end
	end
	local base=Vector3.new(spot.X,ground(fx,spot,root.Position.Y-3),spot.Z)
	local holder=K.new("Model",{Name="SandPillar"},fx.folder)
	local cols={}
	for k=0,2 do
		local a=k/3*math.pi*2
		local off=Vector3.new(math.cos(a),0,math.sin(a))*.9
		local twist=Vector3.new(math.cos(a+1.2),0,math.sin(a+1.2))*.9-off
		table.insert(cols,column(holder,base+off,10,4.2,2.4,.1+k*.02,twist))
	end
	local top=base+Vector3.new(0,10,0)
	task.delay(.08,function()
		K.burst(fx.folder,top,{Texture=K.TEX.smoke,Lifetime=NumberRange.new(.5,.9),Speed=NumberRange.new(14,26),SpreadAngle=Vector2.new(45,45),
			EmissionDirection=Enum.NormalId.Top,Color=ColorSequence.new(SAND),LightEmission=0,LightInfluence=1,Size=K.num({{0,1.8},{1,3.6}}),
			Transparency=K.num({{0,.2},{1,1}}),Acceleration=Vector3.new(0,-40,0),Drag=1,Rotation=NumberRange.new(0,360)},34)
	end)
	task.delay(.3,function()
		for _,c in cols do
			if c.top.Parent then K.tween(c.top,.45,{CFrame=frame(c.foot+Vector3.new(0,2,0),Vector3.yAxis)},Enum.EasingStyle.Quad,Enum.EasingDirection.In);fadeWidths(c.beams,.45) end
		end
	end)
	Debris:AddItem(holder,.9)
	curtain(fx,CFrame.new(base+Vector3.new(0,1,0)),Vector3.new(5,1.5,5),40,22)
	dust(fx,base+Vector3.new(0,1,0),22,2.4)
	grains(fx,base+Vector3.new(0,1.5,0),34,34,true)
	thud(fx,base,.6,.55)
end
local function stepStrike(fx,model,actor,st)
	local root=model:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local name=actor.attackName
	local swinging=name~=nil and (actor.state=="Startup" or actor.state=="Active" or actor.state=="Recovery")
	local serial=actor.attackSerial or 0
	if swinging and serial~=st.serial then
		-- A new swing: its clock starts where the server's is, like the clip's.
		st.serial=serial
		dropLashes(st)
		st.name=name;st.cut=nil;st.landed=false;st.pillarDone=name~="SandPillar"
		st.startedAt=SandFX.clock()-math.clamp(actor.attackElapsed or 0,0,.12)
		if LASH[name] then
			st.lashes={}
			for _,spec in LASH[name] do table.insert(st.lashes,newLash(fx,spec)) end
		end
	end
	if not st.name then return end
	local startup,active,recovery=timing(st.name)
	local t=SandFX.clock()-st.startedAt+LEAD
	if not st.pillarDone and t&gt;=startup*.9 then st.pillarDone=true;pillar(fx,model,root) end
	if not st.lashes then
		if t&gt;startup+active+recovery then st.name=nil end
		return
	end
	local out0=startup*.45
	local ext=if t&lt;out0 then 0 elseif t&lt;startup then smooth((t-out0)/math.max(startup-out0,1e-3))
		elseif t&lt;startup+active then 1 else 1-smooth((t-startup-active)/math.max(recovery*.55,1e-3))
	-- Hit out of the swing: the sand collapses at once.
	if actor.reaction or actor.state=="Stunned" then st.cut=st.cut or SandFX.clock() end
	if st.cut then ext=math.min(ext,1-(SandFX.clock()-st.cut)/.12) end
	if ext&lt;=0 and (t&gt;startup or st.cut) then dropLashes(st);st.name=nil;return end
	local reach=reachOf(st.name)
	local base=root.CFrame
	for _,l in st.lashes do
		local hand=model:FindFirstChild(l.hand)
		local from=if hand then hand.Position else base.Position
		local tipLocal=if l.down then Vector3.new(l.arc*.8,-2.6,-reach*.75) elseif l.low then Vector3.new(l.arc*.6,-2.5,-reach) else Vector3.new(l.arc*.5,.2,-reach)
		local tip=base:PointToWorldSpace(tipLocal)
		local mid=from:Lerp(tip,.45)+base.RightVector*l.arc*reach*.22+Vector3.new(0,if l.down then 2.2 else .9,0)
		-- The part of the curve already out: a quadratic Bezier cut at `ext`,
		-- drawn as the Beam's cubic (CurveSize along each handle's axis).
		local u=math.max(ext,.02)
		local c1=from:Lerp(mid,u)
		local p1=c1:Lerp(mid:Lerp(tip,u),u)
		local q1=from+(c1-from)*(2/3)
		local q2=p1+(c1-p1)*(2/3)
		l.h0.CFrame=frame(from,q1-from)
		l.h1.CFrame=frame(p1,p1-q2)
		curves(l.beams,(q1-from).Magnitude,(p1-q2).Magnitude)
		widths(l.beams,.45*ext,1.5*ext)
		l.spray.Rate=if ext&gt;.6 then 60 else 0
	end
	if not st.landed and t&gt;=startup and not st.cut then
		st.landed=true
		for _,l in st.lashes do
			local at=l.h1.Position
			grains(fx,at,12,12,false)
			dust(fx,at,6,1.2)
		end
	end
end
-- Shield charges: one cluster of sand circling his hips per charge. They dim
-- while he swings or is hurt, the moments the shield does not answer.
local function stepCharges(fx,model,actor,st,dt)
	local max=actor.shieldMax or 0
	local root=model:FindFirstChild("HumanoidRootPart")
	if max&lt;=0 or not root or (actor.health or 1)&lt;=0 then
		if st.charges then st.charges.holder:Destroy();st.charges=nil end
		return
	end
	if not st.charges or not st.charges.holder.Parent then
		local holder=K.new("Model",{Name="SandShieldCharges"},fx.folder)
		local list={}
		for i=1,max do
			local orb=K.block(holder,Vector3.one*.5,root.CFrame,SAND,GRAIN);orb.Shape=Enum.PartType.Ball
			K.new("ParticleEmitter",{Texture=K.TEX.smoke,Rate=14,Lifetime=NumberRange.new(.3,.5),Speed=NumberRange.new(0,.5),Color=ColorSequence.new(SAND_PALE),
				LightEmission=0,LightInfluence=1,Size=K.num({{0,.6},{1,1}}),Transparency=K.num({{0,.5},{1,1}}),Rotation=NumberRange.new(0,360)},orb)
			list[i]={part=orb,shown=0}
		end
		st.charges={holder=holder,list=list,spin=0,count=actor.shield or 0}
	end
	local o=st.charges
	local count=actor.shield or 0
	for i=count+1,o.count do local e=o.list[i];if e then grains(fx,e.part.Position,6,6,false) end end
	o.count=count
	o.spin+=dt*(if (actor.awaken or 0)&gt;0 then 2.6 else 1.5)
	local open=actor.state=="Startup" or actor.state=="Active" or actor.state=="Recovery" or actor.state=="Stunned" or actor.reaction~=nil
	for i,e in o.list do
		local want=if i&lt;=count then (if open then .3 else 1) else 0
		e.shown+=(want-e.shown)*math.min(1,dt*10)
		local a=o.spin+(i-1)/#o.list*math.pi*2
		e.part.CFrame=CFrame.new(root.Position+Vector3.new(math.cos(a)*2.1,-.5+math.sin(o.spin*2+i)*.18,math.sin(a)*2.1))
		e.part.Size=Vector3.one*(.18+.3*e.shown)
		e.part.Transparency=1-e.shown*.95
	end
end
-- Bound in Sand Coffin (any fighter whose opponent is Gaara): streams of sand
-- wind up the body from the feet and hold it.
local function stepCoffin(fx,model,actor,st)
	local held=actor.bound==true and actor.opponentFighter=="Sand" and (actor.health or 1)&gt;0
	local root=model:FindFirstChild("HumanoidRootPart")
	if held and root and not (st.coffin and st.coffin.holder.Parent) then
		local holder=K.new("Model",{Name="SandCoffin"},fx.folder)
		local winds={}
		for k=0,2 do
			local h0,a0=handle(holder,root.Position)
			local h1,a1=handle(holder,root.Position)
			table.insert(winds,{h0=h0,h1=h1,beams=stream(holder,a0,a1,1.4,1),phase=k/3*math.pi*2})
		end
		local swirl=K.new("ParticleEmitter",{Texture=K.TEX.smoke,Rate=50,Lifetime=NumberRange.new(.4,.8),Speed=NumberRange.new(1,3),SpreadAngle=Vector2.new(180,180),
			Color=ColorSequence.new(SAND),LightEmission=0,LightInfluence=1,Size=K.num({{0,1.2},{1,2.4}}),Transparency=K.num({{0,.35},{1,1}}),
			Drag=2,Acceleration=Vector3.new(0,-3,0),Rotation=NumberRange.new(0,360)},K.new("Attachment",{},winds[1].h0))
		-- (Studio film 28/10: the bind read as dust at the feet.) The coffin
		-- itself: bands of packed sand that climb the body from the feet and
		-- close round it up to the neck, each a little narrower, turning
		-- against the next, so the body is visibly encased (the series' shot).
		local bands={}
		for k=1,8 do
			local band=K.block(holder,Vector3.new(.7,2.9,2.9),root.CFrame,if k%2==0 then SAND_DARK else SAND,GRAIN)
			band.Shape=Enum.PartType.Cylinder;band.Transparency=1;band.CastShadow=true
			table.insert(bands,{part=band,k=k,turn=(if k%2==0 then 1 else -1)*(.8+k*.12)})
		end
		st.coffin={holder=holder,winds=winds,born=SandFX.clock(),swirl=swirl,bands=bands}
		thud(fx,root.Position,.5,.5)
	elseif not held and st.coffin then
		local c=st.coffin;st.coffin=nil
		c.swirl.Enabled=false
		for _,w in c.winds do fadeWidths(w.beams,.3) end
		-- released: the shell crumbles (bands drop and thin out)
		for _,b in c.bands or {} do
			Tween:Create(b.part,TweenInfo.new(.3,Enum.EasingStyle.Quad,Enum.EasingDirection.In),
				{Transparency=1,CFrame=b.part.CFrame*CFrame.new(-.8,0,0),Size=b.part.Size*Vector3.new(.4,1.15,1.15)}):Play()
		end
		Debris:AddItem(c.holder,.35)
	end
	local c=st.coffin
	if c and root then
		local grow=smooth((SandFX.clock()-c.born)/.35)
		local spin=SandFX.clock()*2.4
		for _,w in c.winds do
			local a=spin+w.phase
			local foot=root.Position+Vector3.new(math.cos(a)*1.7,-2.8,math.sin(a)*1.7)
			local b=a+2.2
			local top=root.Position+Vector3.new(math.cos(b)*1.5,-2.8+4.4*grow,math.sin(b)*1.5)
			w.h0.CFrame=frame(foot,top-foot)
			w.h1.CFrame=frame(top,top-foot)
		end
		local age=SandFX.clock()-c.born
		for _,b in c.bands or {} do
			-- band k reaches its height at (k-1)*.06 s and settles there
			local up=smooth((age-(b.k-1)*.055)/.2)
			local y=-2.75+(b.k-.5)*.66
			local r=(2.9-b.k*.12)*(.55+.45*up)
			local wob=math.sin(age*7+b.k)*.06
			b.part.Size=Vector3.new(.66,r,r)
			b.part.CFrame=CFrame.new(root.Position+Vector3.new(wob,y-(1-up)*1.2,-wob))*CFrame.Angles(0,age*b.turn,0)*CFrame.Angles(0,0,math.pi/2)
			b.part.Transparency=1-up
		end
	end
end
-- The shared speed trail and awakening mantle, in sand.
local function tint(fx,model)
	local aura=fx.auras and fx.auras[model]
	if not aura then return end
	if aura.trail and not aura.sandTrail then aura.trail.Color=ColorSequence.new(SAND);aura.sandTrail=true end
	if aura.mantle and aura.sandMantle~=aura.mantle then
		aura.mantle.emitter.Color=ColorSequence.new(SHUKAKU)
		aura.mantle.emitter.Texture=K.TEX.smoke
		aura.mantle.emitter.LightEmission=.2
		aura.mantle.light.Color=SHUKAKU
		aura.sandMantle=aura.mantle
	end
end
-- The re-engage is a glide on a wave of sand, not a run: sand pours under
-- his feet for as long as it lasts.
local function stepGlide(fx,model,actor,st)
	local root=model:FindFirstChild("HumanoidRootPart")
	local gliding=actor.state=="Rush" and (actor.health or 1)&gt;0
	if gliding and root and not (st.glide and st.glide.Parent) then
		local at=K.new("Attachment",{Name="SandGlide",Position=Vector3.new(0,-2.8,0)},root)
		K.new("ParticleEmitter",{Texture=K.TEX.smoke,Rate=90,Lifetime=NumberRange.new(.3,.6),Speed=NumberRange.new(2,5),SpreadAngle=Vector2.new(70,70),
			EmissionDirection=Enum.NormalId.Top,Color=ColorSequence.new(SAND),LightEmission=0,LightInfluence=1,Size=K.num({{0,1.4},{1,3.2}}),
			Transparency=K.num({{0,.2},{1,1}}),Drag=3,Acceleration=Vector3.new(0,-8,0),Rotation=NumberRange.new(0,360)},at)
		st.glide=at
	elseif not gliding and st.glide then
		local e=st.glide:FindFirstChildOfClass("ParticleEmitter");if e then e.Enabled=false end
		Debris:AddItem(st.glide,.7);st.glide=nil
	end
end
local function fighter(fx,model,actor,dt)
	if not model or not actor then return end
	local st=stateOf(fx,model)
	stepCoffin(fx,model,actor,st)
	if actor.fighterId~="Sand" then return end
	stepGlide(fx,model,actor,st)
	stepStrike(fx,model,actor,st)
	stepCharges(fx,model,actor,st,dt)
	tint(fx,model)
end

function SandFX.install(FX,kit)
	K=kit
	kit.BUILD.sand=buildBullet
	kit.BUILD.sandwave=buildWave
	FX.poses.sand=bulletPose
	FX.poses.sandwave=wavePose
	table.insert(FX.layers,{name="Sand",impact=impact,fighter=fighter})
end
SandFX.STYLES=STYLES
return SandFX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND227">
          <Properties>
            <string name="Name">TouchControls</string>
            <ProtectedString name="Source">-- Phone and tablet controls (audit 04/11: the experience is open to phones and
-- tablets, and a touch player reached a duel with no way to move or strike;
-- Roblox's own controls are off, Main.client).
--
-- Left half: a floating stick where the thumb lands (pushed to the edge it
-- runs). Right half, empty screen: drag to turn the camera. Bottom right, the
-- fight cluster (the pad's layout: □ strike, △ heavy, ○ dodge, × jump / chase,
-- guard held, grab, tool), above it the jutsu row (SEALS turns it to the
-- second page, the seal jutsu) and a row of the rest (substitution, kunai,
-- chakra held, lock, awaken, ultimate; the tutorial's step skip).
-- Every button sends the same packets as a key (Input); the server validates
-- them all. Shown only on a touch screen, in the player's own duel.
local UIS=game:GetService("UserInputService")
local RunService=game:GetService("RunService")
local Players=game:GetService("Players")
local Fighters=require(game:GetService("ReplicatedStorage").NinjaDuel.Fighters)
-- (QA 12/11) capitals that keep the long vowels and accents.
local Text=require(game:GetService("ReplicatedStorage").NinjaDuel.Text)

local Touch={};Touch.__index=Touch
Touch.REFERENCE=390 -- the design height (a phone held sideways)
local INK=Color3.fromRGB(14,12,18)
local PAPER=Color3.fromRGB(244,236,220)
local RED=Color3.fromRGB(196,40,46)
local GOLD=Color3.fromRGB(232,184,72)
local MUTED=Color3.fromRGB(120,112,104)

local function new(class,props,parent)
	local o=Instance.new(class)
	for k,v in props do o[k]=v end
	o.Parent=parent
	return o
end
local function round(o,r) new("UICorner",{CornerRadius=UDim.new(r or .5,0)},o) end
local function isPress(io)
	return io.UserInputType==Enum.UserInputType.Touch or io.UserInputType==Enum.UserInputType.MouseButton1
end

function Touch.new(input,send,getState,toggleLock,camera)
	local self=setmetatable({input=input,send=send,getState=getState,toggleLock=toggleLock,camera=camera,
		held={},page=false,chakra=false,buttons={},jutsu={}},Touch)
	if not UIS.TouchEnabled then return self end
	local gui=new("ScreenGui",{Name="NinjaTouch",ResetOnSpawn=false,IgnoreGuiInset=true,DisplayOrder=8,Enabled=false,
		ZIndexBehavior=Enum.ZIndexBehavior.Sibling},Players.LocalPlayer:WaitForChild("PlayerGui"))
	self.gui=gui
	-- (each group scales about its own corner; the rows are stacked by hand)
	local scale={Scale=1}
	self.scale=scale

	-- The stick (drawn where the thumb lands).
	local base=new("Frame",{Name="StickBase",Size=UDim2.fromOffset(116,116),AnchorPoint=Vector2.new(.5,.5),BackgroundColor3=INK,
		BackgroundTransparency=.55,Visible=false},gui)
	round(base);new("UIStroke",{Color=PAPER,Transparency=.6,Thickness=2},base)
	local knob=new("Frame",{Name="Knob",Size=UDim2.fromOffset(52,52),AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),
		BackgroundColor3=PAPER,BackgroundTransparency=.25},base)
	round(knob)
	self.base,self.knob=base,knob

	local function button(parent,name,label,center,size,color,down,up)
		local b=new("TextButton",{Name=name,Text=label,Size=UDim2.fromOffset(size,size),AnchorPoint=Vector2.new(.5,.5),
			Position=UDim2.fromOffset(center.X,center.Y),BackgroundColor3=color or INK,BackgroundTransparency=.3,AutoButtonColor=false,
			TextColor3=PAPER,Font=Enum.Font.GothamBlack,TextScaled=true,Active=true},parent)
		round(b);new("UIStroke",{Color=PAPER,Transparency=.45,Thickness=1.5,ApplyStrokeMode=Enum.ApplyStrokeMode.Border},b)
		new("UIPadding",{PaddingLeft=UDim.new(.16,0),PaddingRight=UDim.new(.16,0),PaddingTop=UDim.new(.2,0),PaddingBottom=UDim.new(.2,0)},b)
		b.InputBegan:Connect(function(io)
			if not isPress(io) or self.held[io] then return end
			self.held[io]={button=b,up=up}
			b.BackgroundTransparency=.05
			if down then down() end
		end)
		b.InputEnded:Connect(function(io) self:release(io) end)
		self.buttons[name]=b
		return b
	end
	self.button=button

	-- The fight cluster (bottom right).
	local cluster=new("Frame",{Name="Cluster",Size=UDim2.fromOffset(250,240),AnchorPoint=Vector2.new(1,1),Position=UDim2.new(1,-12,1,-12),
		BackgroundTransparency=1},gui)
	local function act(action) return function() self:press(action) end end
	button(cluster,"Attack","□",Vector2.new(185,175),86,RED,act("Attack"))
	button(cluster,"Heavy","△",Vector2.new(108,110),60,nil,act("Heavy"))
	button(cluster,"Dodge","○",Vector2.new(185,82),60,nil,act("Dodge"))
	button(cluster,"Jump","×",Vector2.new(92,198),60,nil,function() self.send("PadJump");self:used() end,function() self.send("JumpOff") end)
	button(cluster,"Guard","GUARD",Vector2.new(28,128),56,nil,function()
		self.guarding=true;self.send("Guard");self:used()
	end,function() self.guarding=false;self.send("GuardOff") end)
	button(cluster,"Grab","GRAB",Vector2.new(34,214),46,nil,act("Grab"))
	button(cluster,"Tool","TOOL",Vector2.new(236,26),46,nil,act("Tool"))

	-- The jutsu row (the quick slots; SEALS: the second page).
	local row=new("Frame",{Name="Jutsu",Size=UDim2.fromOffset(250,50),AnchorPoint=Vector2.new(1,1),Position=UDim2.new(1,-12,1,-258),
		BackgroundTransparency=1},gui)
	for i=1,5 do
		local b=button(row,"Jutsu"..i,tostring(i),Vector2.new(23+(i-1)*51,25),46,nil,function()
			if self.page then self.send("Seal"..i) else self:press("Technique"..i) end
			self:used()
		end,function() self.send("SealRelease") end)
		b.TextScaled=true
		self.jutsu[i]=b
	end
	local seals=button(row,"Seals","SEALS",Vector2.new(-32,25),52,nil,function()
		self.page=not self.page;self:refreshPage()
	end)
	self.sealsButton=seals

	-- The rest.
	local extras=new("Frame",{Name="Extras",Size=UDim2.fromOffset(250,40),AnchorPoint=Vector2.new(1,1),Position=UDim2.new(1,-12,1,-312),
		BackgroundTransparency=1},gui)
	local list={{"Substitute","SUB",act("Substitute")},{"Arm","KUNAI",act("Arm")},
		{"Chakra","CHAKRA",function() self.chakra=true end,function() self.chakra=false end},
		{"Lock","LOCK",function() self.toggleLock() end},{"Awaken","AWAKEN",act("Awaken")},{"Ultimate","ULT",act("Ultimate")}}
	for i,e in list do button(extras,e[1],e[2],Vector2.new(20+(i-1)*42,20),38,nil,e[3],e[4]) end
	self.extras=extras
	self.skipButton=button(gui,"SkipStep","SKIP STEP",Vector2.new(0,0),60,nil,function() self.skipAt=os.clock() end,function()
		local held=os.clock()-(self.skipAt or os.clock())
		self.send(if held&gt;=1 then "TutorialSkip" else "TutorialStep")
	end)
	self.skipButton.AnchorPoint=Vector2.new(0,0);self.skipButton.Position=UDim2.new(0,16,0,90);self.skipButton.Size=UDim2.fromOffset(96,40)
	round(self.skipButton,.25)
	local scales={}
	for _,group in {cluster,row,extras,base,self.skipButton} do table.insert(scales,new("UIScale",{Scale=1},group)) end
	local function fit()
		local size=workspace.CurrentCamera.ViewportSize
		-- (B0, 04/11) the stack (cluster, jutsu, extras: 352 tall) stays under
		-- the health plates: it covered the opponent's plate on a phone.
		local s=math.clamp(math.min((size.Y-110)/352,size.X/700),.6,1.6)
		scale.Scale=s
		for _,u in scales do u.Scale=s end
		row.Position=UDim2.new(1,-12,1,-(12+246*s))
		extras.Position=UDim2.new(1,-12,1,-(12+300*s))
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit);fit()

	-- The stick and the camera drag: touches that no button took.
	UIS.TouchStarted:Connect(function(io,processed)
		if processed or not gui.Enabled then return end
		local size=workspace.CurrentCamera.ViewportSize
		local p=io.Position
		if p.X&lt;size.X*.45 and not self.stickTouch then
			self.stickTouch=io;self.origin=Vector2.new(p.X,p.Y)
			base.Position=UDim2.fromOffset(p.X,p.Y);base.Visible=true
			knob.Position=UDim2.fromScale(.5,.5)
			self.input.touch=true
		elseif p.X&gt;=size.X*.45 and not self.camTouch then
			self.camTouch=io;self.camLast=Vector2.new(p.X,p.Y)
		end
	end)
	UIS.TouchMoved:Connect(function(io)
		if io==self.stickTouch and self.origin then
			local d=Vector2.new(io.Position.X,io.Position.Y)-self.origin
			local radius=52*scale.Scale
			local v=d/radius
			if v.Magnitude&gt;1 then v=v.Unit end
			self.input.touchStick=Vector2.new(v.X,-v.Y)
			-- pushed to the edge: the run
			self.input.sprinting=v.Magnitude&gt;.92
			knob.Position=UDim2.new(.5,v.X*52,.5,v.Y*52)
		elseif io==self.camTouch and self.camLast then
			local p=Vector2.new(io.Position.X,io.Position.Y)
			local d=p-self.camLast;self.camLast=p
			self.camera.look=Vector2.new(math.clamp(d.X/7,-1.6,1.6),math.clamp(-d.Y/9,-1.2,1.2))
			self.camDriven=os.clock()
		end
	end)
	UIS.TouchEnded:Connect(function(io)
		self:release(io)
		if io==self.stickTouch then
			self.stickTouch=nil;self.origin=nil;base.Visible=false
			self.input.touchStick=Vector2.zero;self.input.sprinting=false
		elseif io==self.camTouch then
			self.camTouch=nil;self.camera.look=Vector2.zero
		end
	end)
	-- A drag is a nudge, not a held stick: the turn eases out between moves.
	RunService.RenderStepped:Connect(function()
		if self.camTouch and self.camDriven and os.clock()-self.camDriven&gt;.05 then self.camera.look=self.camera.look*.5 end
	end)
	UIS.LastInputTypeChanged:Connect(function(kind)
		if kind==Enum.UserInputType.Touch then self.input.touch=true
		elseif kind~=Enum.UserInputType.MouseMovement and kind~=Enum.UserInputType.Focus then self.input.touch=false end
	end)
	self.input.touch=UIS:GetLastInputType()==Enum.UserInputType.Touch or not UIS.KeyboardEnabled
	return self
end
-- A press with the chakra button held goes out infused (Input: chakraOn).
function Touch:press(action)
	if self.chakra then self.send(action,{chakra=true}) else self.send(action) end
	self:used()
end
-- The page closes after one seal jutsu, like letting go of L2 + R1 on a pad.
function Touch:used()
	self.input.touch=true
end
function Touch:release(io)
	local h=self.held[io]
	if not h then return end
	self.held[io]=nil
	h.button.BackgroundTransparency=.3
	if h.up then h.up() end
	if self.page and h.button.Name:match("^Jutsu") then self.page=false;self:refreshPage() end
end
function Touch:releaseAll()
	for io in table.clone(self.held) do self:release(io) end
	if self.stickTouch then self.stickTouch=nil;self.origin=nil;if self.base then self.base.Visible=false end end
	self.input.touchStick=Vector2.zero
	if self.camTouch then self.camTouch=nil;self.camera.look=Vector2.zero end
	self.chakra=false
end
local function short(name)
	name=Text.upper(tostring(name or ""))
	-- the jutsu's own word: its last one, cut to fit a thumb-sized button
	local last=name:match("([%w%-]+)%s*$") or name
	return string.sub(last,1,9)
end
function Touch:refreshPage()
	if not self.gui then return end
	self.sealsButton.BackgroundColor3=if self.page then GOLD else INK
	self.sealsButton.TextColor3=if self.page then INK else PAPER
	self:labels(self.lastHuman)
end
function Touch:labels(h)
	if not h then return end
	local def=Fighters[h.fighterId or ""]
	local list=if self.page then (def and def.SealJutsu or {}) else (h.techniques or {})
	for i,b in self.jutsu do
		local spec=list[i]
		b.Visible=spec~=nil
		if spec then
			b.Text=short(spec.name or spec.Name)
			local ready=if self.page then true else (spec.remaining or 0)==0 and (h.chakra or 0)&gt;=(spec.cost or 0)
			b.BackgroundColor3=if self.page then Color3.fromRGB(70,52,20) else INK
			b.TextColor3=if ready then PAPER else MUTED
		end
	end
	self.sealsButton.Visible=def~=nil and def.SealJutsu~=nil
end
-- Every game packet.
function Touch:render(data)
	if not self.gui then return end
	local show=data.phase=="Duel" and not data.spectate and self.input.touch==true
	if self.gui.Enabled and not show then self:releaseAll() end
	self.gui.Enabled=show
	if not show then self.page=false;return end
	local h=data.human
	self.lastHuman=h
	self:labels(h)
	if h then
		self.buttons.Ultimate.BackgroundColor3=if h.ultimateReady then GOLD else INK
		self.buttons.Ultimate.TextColor3=if h.ultimateReady then INK else MUTED
		self.buttons.Awaken.BackgroundColor3=if h.awakenReady then RED else INK
		self.buttons.Awaken.TextColor3=if h.awakenReady then PAPER else MUTED
		self.buttons.Lock.BackgroundColor3=if self.camera.locked then RED else INK
		self.buttons.Chakra.BackgroundColor3=if self.chakra then Color3.fromRGB(60,120,220) else INK
	end
	self.skipButton.Visible=data.tutorial~=nil
	-- (B1 lot 2) the first minute and its duel: the core cluster and the
	-- signature only; grab, tool, the extras and the seal page come next duel.
	local first=data.first~=nil
	if first and self.page then self.page=false;self:refreshPage() end
	self.extras.Visible=not first
	self.buttons.Grab.Visible=not first
	self.buttons.Tool.Visible=not first
	if first then
		self.sealsButton.Visible=false
		for i,b in self.jutsu do if i~=2 then b.Visible=false end end
	end
end
return Touch
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND228">
          <Properties>
            <string name="Name">TutorialProbe</string>
            <ProtectedString name="Source">-- Debug/QA places only (build.py DEBUG_SOURCES). The tutorial as a test of the
-- game (user 02/11: "the tutorial must serve the game": find what keeps it
-- from being fluid). Every rendered frame of a tutorial step it measures what
-- the player sees, per fighter and per step, and keeps the worst examples:
--   pop       the drawn body jumps between two frames (not a declared warp)
--   freeze    the server wants the body to move, the drawn body does not
--   slide     the drawn body moves while the server says it stands, or runs
--             far slower/faster than the server's own speed
--   snap      the drawn velocity changes brutally out of a free move
--             (run -&gt; jump, wall -&gt; air, landing): the "cut" a player feels
--   camera    the camera jumps (position or angle) more than the body it follows
--   offscreen the fighter's head leaves the view
--   late      a strike or a jump reaches the screen late (server start -&gt; seen)
-- Read it with LocalPlayer.NinjaDuelProbe:Invoke("report") (or "totals") from
-- the Client command bar or the Studio MCP Client datamodel. Measures only: changes nothing in the game.
local RunService=game:GetService("RunService")
local Probe={}

local function flat(v) return Vector3.new(v.X,0,v.Z) end
local KINDS={"pop","freeze","slide","snap","camera","offscreen","late"}

function Probe.install(ctx)
	local data={} -- data[fighter][step]={kind={n=,worst=,example=}}
	local order={}
	local st={}
	local function bucket(fighter,step)
		local f=data[fighter];if not f then f={};data[fighter]=f;table.insert(order,fighter) end
		local b=f[step];if not b then b={frames=0};f[step]=b end
		return b
	end
	local function note(b,kind,value,example)
		local k=b[kind];if not k then k={n=0,worst=0};b[kind]=k end
		k.n+=1
		if value&gt;k.worst then k.worst=value;k.example=example end
	end
	local function context(h)
		return string.format("%s%s%s%s%s",h.state or "?",if h.attackName and h.state~="Neutral" then ":"..h.attackName else "",
			if h.reaction then " r:"..h.reaction else "",if h.airborne then " air" else "",if h.wall then " wall:"..tostring(h.wallMode) else "")
	end
	-- A bot run (Server/TutorialBot) publishes its stick on the body: the
	-- player's own body is drawn ahead by the stick (Presentation:leadLocal),
	-- so it gets the bot's stick, as if a player held it. Before the draw.
	RunService:BindToRenderStep("NinjaDuelTutorialStick",Enum.RenderPriority.Camera.Value-1,function()
		local model=ctx.player.Character
		local stick=model and model:GetAttribute("TutorialStick")
		if typeof(stick)=="Vector3" then ctx.presentation.inputDir=stick;ctx.presentation.inputSprint=model:GetAttribute("TutorialSprint")==true end
	end)
	RunService:BindToRenderStep("NinjaDuelTutorialProbe",Enum.RenderPriority.Camera.Value+3,function(dt)
		local cur=ctx.state()
		if not cur or cur.phase~="Duel" or not cur.tutorial or not cur.human or dt&lt;=0 or dt&gt;.1 then st.last=nil;return end
		local h=cur.human
		local model=ctx.player.Character
		local head=model and model:FindFirstChild("Head")
		local torso=model and (model:FindFirstChild("LowerTorso") or model:FindFirstChild("Torso"))
		if not head or not torso then return end
		local fighter=h.fighterId or "?"
		local step=cur.tutorial.id or "?"
		local b=bucket(fighter,step);b.frames+=1
		local cam=workspace.CurrentCamera
		local now=os.clock()
		local p=torso.Position
		local last=st.last
		-- A new step relocates both bodies (Tutorial.enter): not a defect.
		if last and (last.step~=step or last.fighter~=fighter or (h.warpSerial or 0)~=last.warp) then last=nil;st.settle=now+.35 end
		local settling=now&lt;(st.settle or 0)
		local ctxText=context(h)
		if last and not settling then
			local move=p-last.p
			local v=move/dt
			local vFlat=flat(v).Magnitude
			local serverSpeed=math.max(h.speed or 0,flat(h.velocity or Vector3.zero).Magnitude)
			-- pop: more travel in one frame than the fastest the body may go.
			local allowed=math.max(1.2,(math.max(serverSpeed,last.vFlat or 0,80))*dt*1.6)
			if move.Magnitude&gt;allowed then
				local server=h.position or p
				note(b,"pop",move.Magnitude,string.format("%.2f studs in %.0f ms (%s -&gt; %s) drawn %s -&gt; %s, server %s",move.Magnitude,dt*1000,last.ctx,ctxText,
					string.format("%.0f,%.0f,%.0f",last.p.X,last.p.Y,last.p.Z),string.format("%.0f,%.0f,%.0f",p.X,p.Y,p.Z),string.format("%.0f,%.0f,%.0f",server.X,server.Y,server.Z)))
			end
			local free=h.state=="Neutral" and not h.reaction and not h.wall and not h.airborne and (h.airHold or 0)==0
			-- freeze: the server runs, the screen stands.
			if free and (h.speed or 0)&gt;6 and vFlat&lt;.5 then st.stillFor=(st.stillFor or 0)+dt else st.stillFor=0 end
			if st.stillFor&gt;=.25 and not st.freezeOpen then st.freezeOpen=true;note(b,"freeze",st.stillFor,"server speed "..string.format("%.1f",h.speed or 0).." / drawn 0 ("..ctxText..")") end
			if st.stillFor==0 then st.freezeOpen=false end
			-- slide: drawn speed against the server's own, free on the ground.
			if free and h.state=="Neutral" then
				local gap=math.abs(vFlat-(h.speed or 0))
				if gap&gt;8 then st.slideFor=(st.slideFor or 0)+dt else st.slideFor=0 end
				if st.slideFor&gt;=.2 and not st.slideOpen then st.slideOpen=true;note(b,"slide",gap,string.format("drawn %.1f / server %.1f studs/s (%s)",vFlat,h.speed or 0,ctxText)) end
				if st.slideFor==0 then st.slideOpen=false end
			end
			-- snap: brutal change of the drawn velocity around a free move.
			if last.v then
				local acc=(v-last.v).Magnitude/dt
				local committed=(h.state~="Neutral" and h.state~="Guarding") or h.reaction~=nil
				if acc&gt;650 and not committed and v.Magnitude&lt;120 then
					note(b,"snap",acc,string.format("%.0f studs/s² (%s -&gt; %s)",acc,last.ctx,ctxText))
				end
			end
			-- camera: the view moves much more than the body it follows.
			local cf=cam.CFrame
			if last.cam then
				local camMove=(cf.Position-last.cam.Position).Magnitude
				local angle=math.deg(math.acos(math.clamp(cf.LookVector:Dot(last.cam.LookVector),-1,1)))
				if camMove&gt;move.Magnitude+2.5 then note(b,"camera",camMove,string.format("camera %.1f studs vs body %.1f (%s)",camMove,move.Magnitude,ctxText)) end
				if angle&gt;18 and not h.ultClip then note(b,"camera",angle,string.format("camera turned %.0f° in one frame (%s)",angle,ctxText)) end
			end
			-- offscreen: the head out of the view (or hidden by the HUD's bottom bar).
			local screen,visible=cam:WorldToViewportPoint(head.Position)
			local size=cam.ViewportSize
			if not visible or screen.X&lt;0 or screen.X&gt;size.X or screen.Y&lt;0 or screen.Y&gt;size.Y*.86 then
				st.offFor=(st.offFor or 0)+dt
				if st.offFor&gt;=.3 and not st.offOpen then st.offOpen=true;note(b,"offscreen",st.offFor,"head at "..string.format("%.0f,%.0f",screen.X,screen.Y).." ("..ctxText..")") end
			else st.offFor=0;st.offOpen=false end
			st.lastV=v
			last.v=v;last.vFlat=vFlat
		end
		-- late: how old a strike is when the screen first shows it.
		if (h.attackSerial or 0)~=(st.attackSerial or 0) then
			if st.attackSerial~=nil and h.attackElapsed and h.attackName then
				local ms=h.attackElapsed*1000
				if ms&gt;120 then note(b,"late",ms,string.format("%s seen %.0f ms after it began",h.attackName,ms)) end
			end
			st.attackSerial=h.attackSerial or 0
		end
		-- jump: server airborne -&gt; the drawn body leaves the ground.
		if h.airborne and not st.wasAir then st.airAt=now;st.airFrom=p.Y end
		if st.airAt and p.Y&gt;(st.airFrom or p.Y)+.4 then
			local ms=(now-st.airAt)*1000
			if ms&gt;120 then note(b,"late",ms,string.format("jump drawn %.0f ms after the server's take-off",ms)) end
			st.airAt=nil
		end
		if not h.airborne then st.airAt=nil end
		st.wasAir=h.airborne
		st.last={p=p,step=step,fighter=fighter,warp=h.warpSerial or 0,ctx=ctxText,cam=cam.CFrame,v=last and last.v,vFlat=last and last.vFlat}
	end)
	local api={}
	function api.reset() table.clear(data);table.clear(order) end
	-- One line per fighter and step that has a defect, worst first.
	function api.report(fighter)
		local lines={}
		for _,f in order do
			if not fighter or f==fighter then
				for step,b in data[f] do
					for _,kind in KINDS do
						local k=b[kind]
						if k then table.insert(lines,{score=k.n*(if kind=="freeze" or kind=="pop" then 4 else 1),text=string.format("%s %s %s x%d worst: %s",f,step,kind,k.n,tostring(k.example))}) end
					end
				end
			end
		end
		table.sort(lines,function(a,b) return a.score&gt;b.score end)
		local out={};for i,l in lines do out[i]=l.text end
		return table.concat(out,"\n")
	end
	-- Totals per kind and fighter (a table to compare fighters).
	function api.totals()
		local out={}
		for _,f in order do
			local row={f}
			for _,kind in KINDS do
				local n=0;for _,b in data[f] do if b[kind] then n+=b[kind].n end end
				if n&gt;0 then table.insert(row,kind.."="..n) end
			end
			table.insert(out,table.concat(row," "))
		end
		return table.concat(out,"\n")
	end
	api.data=data
	_G.NinjaDuelProbe=api
	-- Studio tools run in another script context (_G is not shared): a local
	-- BindableFunction answers them (op "report" | "totals" | "reset").
	local hook=Instance.new("BindableFunction");hook.Name="NinjaDuelProbe"
	hook.OnInvoke=function(op,arg) local f=api[op or "report"];return f and f(arg) end
	hook.Parent=ctx.player
	return api
end
return Probe
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND229">
          <Properties>
            <string name="Name">UI</string>
            <ProtectedString name="Source">-- Prodigy Tournament interface: roster/selection, online queue and fighter
-- pick, duel HUD, match intro and result framing. Presentation only; every
-- value comes from the snapshot.
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Fighters=require(Shared.Fighters)
-- (Beta 03/11) the select screen offers the beta's fighters only (Shared/BetaRoster).
local Roster=require(Shared.BetaRoster)
local Controls=require(Shared.Controls)
-- (QA 12/11) capitals that keep the long vowels and accents (Shared/Text).
local Text=require(Shared.Text)
local Config=require(Shared.Config)
-- (05/11) The face button of each jutsu slot on a pad (R1 is the row's).
local PAD_FACE={"□","△","○","×","D↑"}
local ChakraMoves=require(Shared.ChakraMoves)
local FirstMinute=require(Shared.FirstMinute)
-- (B1 lot 3) the effects switch lives in the VFX kit (absent in headless tests)
local okKit,FXKit=pcall(function() return require(script.Parent.VfxKit) end)
if not okKit then FXKit=nil end
local SealJutsu=require(Shared.SealJutsu)
local MoveGraphs=require(Shared.MoveGraphs)
local Protocol=require(Shared.OnlineProtocol)
local GuiService=game:GetService("GuiService")
local UIS=game:GetService("UserInputService")
local Tween=game:GetService("TweenService")
local UI={}; UI.__index=UI
local palette={
	ink=Color3.fromRGB(16,15,20),panel=Color3.fromRGB(28,26,32),paper=Color3.fromRGB(240,232,212),
	text=Color3.fromRGB(240,236,226),muted=Color3.fromRGB(170,164,150),red=Color3.fromRGB(190,40,36),
	gold=Color3.fromRGB(230,184,86),blue=Color3.fromRGB(82,177,244),crimson=Color3.fromRGB(222,70,80),
	track=Color3.fromRGB(46,42,48),locked=Color3.fromRGB(38,36,42),
}
local TITLE_FONT=Enum.Font.Bangers
local BODY_FONT=Enum.Font.GothamBold
local function create(class,parent,props)
	local x=Instance.new(class)
	for k,v in props do x[k]=v end
	x.Parent=parent; return x
end
local function frame(parent,position,size,color,transparency)
	return create("Frame",parent,{Position=position,Size=size,BackgroundColor3=color or palette.panel,BorderSizePixel=0,BackgroundTransparency=transparency or 0})
end
local function text(parent,value,position,size,fontSize,color,font,align)
	return create("TextLabel",parent,{Text=value,Position=position,Size=size,TextSize=fontSize or 16,Font=font or BODY_FONT,
		TextColor3=color or palette.text,BackgroundTransparency=1,TextXAlignment=align or Enum.TextXAlignment.Left,TextWrapped=true})
end
local function corner(parent,radius) return create("UICorner",parent,{CornerRadius=UDim.new(0,radius or 6)}) end
local function stroke(parent,color,thickness) return create("UIStroke",parent,{Color=color or palette.ink,Thickness=thickness or 2}) end
-- (User 03/11: "every banner and end screen needs one common identity".) The
-- house card: deep ink, rounded, a thin vermilion border and a vermilion
-- brush line along its top; the controls sheet, the result, the queue and
-- the tutorial panel are all this card.
local CARD=Color3.fromRGB(16,14,19)
local function inkCard(card,radius)
	card.BackgroundColor3=CARD;card.BackgroundTransparency=.04
	create("UICorner",card,{CornerRadius=UDim.new(0,radius or 12)})
	create("UIStroke",card,{Color=palette.red,Thickness=2,ApplyStrokeMode=Enum.ApplyStrokeMode.Border})
	local line=create("Frame",card,{Position=UDim2.fromOffset(0,0),Size=UDim2.new(1,0,0,5),BackgroundColor3=palette.red,BorderSizePixel=0})
	create("UICorner",line,{CornerRadius=UDim.new(0,radius or 12)})
	return card
end
local function inkTitle(label)
	create("UIStroke",label,{Color=palette.ink,Thickness=3,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
	return label
end
local function button(parent,value,position,size,callback,color)
	local b=create("TextButton",parent,{Text=value,Position=position,Size=size,TextSize=24,Font=TITLE_FONT,TextColor3=palette.text,
		BackgroundColor3=color or palette.panel,BorderSizePixel=0,AutoButtonColor=true})
	corner(b,6)
	-- (UI pass 02/11) A dark button on the dark menu read as disabled
	-- (TRAINING, ONLINE DUEL, HOST): a light edge says it can be pressed.
	if not color then create("UIStroke",b,{Color=palette.muted,Transparency=.55,Thickness=1.5,ApplyStrokeMode=Enum.ApplyStrokeMode.Border}) end
	b.Activated:Connect(callback); return b
end
-- (Lobby, 04/11) the same look for the players-online panel (Client/LobbyPanel).
UI.kit={palette=palette,create=create,frame=frame,text=text,corner=corner,inkCard=inkCard,inkTitle=inkTitle,button=button,
	TITLE_FONT=TITLE_FONT,BODY_FONT=BODY_FONT,CARD=CARD}
local function accentOf(def) return Color3.fromRGB(table.unpack(def.Color)) end
function UI.new(parent,send)
	-- (B1 lot 2) `simple`: the first roster a player sees is PLAY and the
	-- fighters, nothing else (ALL MODES opens the rest; any finished duel too).
	local self=setmetatable({player="Flashstep",bot=FirstMinute.rival("Flashstep") or "Mirage",send=send,selectionButtons={},introShown=nil,simple=true},UI)
	self.gui=create("ScreenGui",parent,{Name="NinjaDuelHUD",ResetOnSpawn=false,IgnoreGuiInset=true,ZIndexBehavior=Enum.ZIndexBehavior.Sibling})
	-- ------------------------------------------------------------ selection
	-- (UI redesign 02/11, user: "be original in everything, you can change
	-- everything".) The tournament's call-up board: two stages where the
	-- chosen prodigies stand as they fight (the duel's own rigs, posed:
	-- Server/Portraits), a vermilion brush stroke between them, one roster of
	-- name tablets underneath. A tablet goes to the stage being chosen (yours
	-- unless you pick the other stage). Canvas 1600x900, scaled to the screen.
	self.side="player"
	-- Keyboard and gamepad focus in the game's own hand: a gold brush frame,
	-- not the engine's blue glow.
	pcall(function()
		local focus=Instance.new("Frame")
		focus.Name="NinjaFocus";focus.BackgroundTransparency=1;focus.Size=UDim2.new(1,10,1,10);focus.Position=UDim2.fromOffset(-5,-5)
		create("UIStroke",focus,{Color=palette.gold or Color3.fromRGB(232,190,96),Thickness=3})
		create("UICorner",focus,{CornerRadius=UDim.new(0,8)})
		parent.SelectionImageObject=focus
	end)
	-- The fighters stand in a real 3D set (Client/MenuStage) the menu camera
	-- films: the board is drawn over it, transparent where they are.
	self.selection=frame(self.gui,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.ink,1)
	-- (Gradients only where the engine has them: the headless suites do not.)
	local hasSequences=ColorSequence~=nil and NumberSequence~=nil and NumberSequenceKeypoint~=nil
	pcall(function()
		-- The game's look on this screen (Client/WorldLook): light, grade, sky, ink lines.
		local lookModule=script.Parent:FindFirstChild("WorldLook")
		if lookModule then require(lookModule).start() end
		local stageModule=script.Parent:FindFirstChild("MenuStage")
		if stageModule then self.menuStage=require(stageModule).new() end
	end)
	local shell=frame(self.selection,UDim2.fromScale(.5,.5),UDim2.fromOffset(1600,900),palette.ink,1)
	shell.AnchorPoint=Vector2.new(.5,.5)
	self.shell=shell
	local scale=create("UIScale",shell,{Scale=1})
	local function resize() scale.Scale=math.min(1.25,workspace.CurrentCamera.ViewportSize.X/1600,workspace.CurrentCamera.ViewportSize.Y/900) end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(resize);resize()
	-- Ink at the bottom of the screen, under the roster and the actions.
	local base=frame(self.selection,UDim2.new(0,0,1,-300),UDim2.new(1,0,0,300),Color3.fromRGB(10,9,12),0)
	if hasSequences then create("UIGradient",base,{Rotation=-90,Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(.62,.08),NumberSequenceKeypoint.new(1,1)})}) end
	base.ZIndex=0
	-- Title, top left; the hanging banner, right edge.
	-- (B0, 04/11) clear of Roblox's own buttons (top left: they covered the P)
	local title=text(shell,"PRODIGY TOURNAMENT",UDim2.fromOffset(150,18),UDim2.fromOffset(900,70),62,palette.paper,TITLE_FONT)
	create("UIStroke",title,{Color=palette.ink,Thickness=3,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
	text(shell,"Eight future legends to start, more every update. Twelve to fourteen years old. One stage — before they become who they are meant to be.",
		UDim2.fromOffset(152,84),UDim2.fromOffset(1100,20),15,palette.muted,Enum.Font.GothamMedium)
	local banner=frame(shell,UDim2.fromOffset(1534,0),UDim2.fromOffset(44,280),palette.paper,0)
	create("UIStroke",banner,{Color=palette.red,Thickness=2})
	text(banner,"天\n才\n忍\n者\n大\n会",UDim2.fromOffset(0,12),UDim2.fromOffset(44,240),26,palette.red,BODY_FONT,Enum.TextXAlignment.Center).LineHeight=.95
	frame(shell,UDim2.fromOffset(1553,280),UDim2.fromOffset(6,40),palette.red,0)
	self.controlsButton=button(shell,"CONTROLS  (TAB)",UDim2.fromOffset(1290,30),UDim2.fromOffset(220,40),function() self:toggleControls() end)
	self.controlsButton.TextSize=20
	-- The two stages.
	local function stage(side)
		local right=side=="bot"
		local x=if right then 960 else 60
		local box=create("TextButton",shell,{Position=UDim2.fromOffset(x,104),Size=UDim2.fromOffset(550,500),BackgroundTransparency=1,Text="",AutoButtonColor=false})
		-- The fighter stands in the 3D set behind this area; a white flash
		-- greets a new pick, a line of his colour runs under his name.
		local flash=frame(box,UDim2.fromOffset(0,36),UDim2.fromOffset(550,384),palette.paper,1)
		corner(flash,10)
		local underline=frame(box,UDim2.fromOffset(if right then 550-300 else 0,420),UDim2.fromOffset(300,4),palette.red,0)
		local align=if right then Enum.TextXAlignment.Right else Enum.TextXAlignment.Left
		-- The tag over the stage: YOU / OPPONENT, and which stage takes the next tablet.
		local tag=frame(box,UDim2.fromOffset(if right then 550-190 else 0,0),UDim2.fromOffset(190,30),palette.paper,0)
		local tagText=text(tag,if right then "OPPONENT (AI)" else "YOU",UDim2.fromOffset(10,0),UDim2.fromOffset(170,30),20,palette.ink,TITLE_FONT,align)
		tagText.TextScaled=true;create("UITextSizeConstraint",tagText,{MaxTextSize=20})
		local choosing=text(box,"◀ CHOOSING",UDim2.fromOffset(if right then 550-190-130 else 200,0),UDim2.fromOffset(120,30),16,palette.gold,TITLE_FONT,align)
		if not right then choosing.Text="CHOOSING ▶" end
		local name=text(box,"",UDim2.fromOffset(if right then -14 else 14,368),UDim2.fromOffset(550,54),52,palette.paper,TITLE_FONT,align)
		local nameScale=create("UIScale",name,{Scale=1})
		create("UIStroke",name,{Color=palette.ink,Thickness=3,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
		local sub=text(box,"",UDim2.fromOffset(2,426),UDim2.fromOffset(546,18),14,palette.gold,BODY_FONT,align)
		local note=text(box,"",UDim2.fromOffset(2,446),UDim2.fromOffset(546,40),14,palette.text,Enum.Font.GothamMedium,align)
		note.TextYAlignment=Enum.TextYAlignment.Top
		box.Activated:Connect(function() if not self.picking or side=="player" then self.side=side;self:refreshSelection() end end)
		return {box=box,flash=flash,underline=underline,nameScale=nameScale,tag=tag,tagText=tagText,choosing=choosing,name=name,sub=sub,note=note,shown=nil,right=right}
	end
	self.stages={player=stage("player"),bot=stage("bot")}
	self.opponentLabel=self.stages.bot.tagText
	-- VS, and the matchup line under it.
	-- A vermilion copy a few pixels behind gives the VS depth.
	local vsShadow=text(shell,"VS",UDim2.fromOffset(808,308),UDim2.fromOffset(240,150),128,palette.red,TITLE_FONT,Enum.TextXAlignment.Center)
	vsShadow.AnchorPoint=Vector2.new(.5,.5);vsShadow.Rotation=-9
	local vs=text(shell,"VS",UDim2.fromOffset(800,300),UDim2.fromOffset(240,150),128,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
	local vsScale=create("UIScale",vs,{Scale=1})
	vs.AnchorPoint=Vector2.new(.5,.5);vs.Rotation=-9
	create("UIStroke",vs,{Color=palette.ink,Thickness=5,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
	self.matchup=text(shell,"",UDim2.fromOffset(800,392),UDim2.fromOffset(360,40),18,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
	self.matchup.AnchorPoint=Vector2.new(.5,0);self.matchup.Rotation=-9
	self.matchupNote=self.stages.player.note
	-- Idle life while the board shows: the VS breathes; the set's back lights
	-- and stroke (Client/MenuStage) live on their own; the fighters keep
	-- their places on any screen shape.
	pcall(function()
		local lastView=nil
		game:GetService("RunService").RenderStepped:Connect(function()
			if self.menuStage then self.menuStage:filmed(self.selection.Visible) end
			if not self.selection.Visible then return end
			local t=os.clock()
			vsScale.Scale=1+.035*math.sin(t*2.2)
			-- The stage button's edge breathes: the next thing to press.
			if self.startStroke then self.startStroke.Transparency=.15+.5*(.5+.5*math.sin(t*3)) end
			if self.menuStage then
				local view=workspace.CurrentCamera.ViewportSize
				if view~=lastView then lastView=view;self.menuStage:layout() end
				self.menuStage:step(t)
			end
		end)
	end)
	-- Your fighter's strings, over the roster.
	self.routeNote=text(shell,"",UDim2.fromOffset(60,602),UDim2.fromOffset(1480,18),14,palette.gold,BODY_FONT,Enum.TextXAlignment.Center)
	self.routeNote.TextScaled=true;create("UITextSizeConstraint",self.routeNote,{MaxTextSize=14})
	-- The roster (user 02/11: the top and the bottom repeated each other, the
	-- faces were wrong): name plates, two rows of ten, each with a cut of its
	-- fighter's colour; a plate rises under the pointer, the picks stand
	-- raised with their tag above them. The faces are on the stages.
	local playable=table.clone(Roster)
	self.tablets={}
	local W,H,GAP=132,38,8
	-- (Beta) one row when the roster fits in it, centred under the stages.
	local perRow=math.min(#playable,10)
	local left=(1600-(perRow*W+(perRow-1)*GAP))/2
	for index,id in playable do
		local def=Fighters[id]
		local accent=accentOf(def)
		local col=(index-1)%perRow;local row=math.floor((index-1)/perRow)
		local x,y=left+col*(W+GAP),664+row*(H+12)
		local tablet=create("TextButton",shell,{Name="Tablet"..id,Position=UDim2.fromOffset(x,y),Size=UDim2.fromOffset(W,H),
			BackgroundColor3=Color3.fromRGB(22,19,25),BorderSizePixel=0,AutoButtonColor=false,Text="",ClipsDescendants=true})
		corner(tablet,5)
		local edge=create("UIStroke",tablet,{Color=accent,Thickness=1.5,Transparency=.55,ApplyStrokeMode=Enum.ApplyStrokeMode.Border})
		local glow=frame(tablet,UDim2.fromOffset(0,0),UDim2.new(0,6,1,0),accent,0)
		local label=text(tablet,Text.upper(def.Name),UDim2.fromOffset(12,0),UDim2.fromOffset(W-16,H),22,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
		label.TextScaled=true;create("UITextSizeConstraint",label,{MaxTextSize=22})
		-- The pick's tag sits on the plate's top edge (above it, it covered the
		-- row above when a second-row plate was picked).
		local seal=text(shell,"",UDim2.fromOffset(x+W-52,y-7),UDim2.fromOffset(48,14),12,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
		seal.ZIndex=3
		seal.BackgroundColor3=palette.red;seal.BackgroundTransparency=1;corner(seal,4)
		tablet.Activated:Connect(function() self:pick(self.side,id) end)
		local t={tablet=tablet,edge=edge,glow=glow,label=label,seal=seal,other=seal,accent=accent,x=x,y=y,w=W,hover=false}
		pcall(function()
			tablet.MouseEnter:Connect(function() t.hover=true;self:liftTablet(t) end)
			tablet.MouseLeave:Connect(function() t.hover=false;self:liftTablet(t) end)
		end)
		self.selectionButtons["slot"..id]=tablet
		self.tablets[id]=t
	end
	-- The action row: training, online, private duel by code, and the stage.
	local below=800
	self.startButton=button(shell,"ENTER THE STAGE",UDim2.fromOffset(1140,below),UDim2.fromOffset(400,58),function()
		if self.picking then send("Confirm")
		elseif self.simple then send("First",{player=self.player})
		else send("Start",{player=self.player,bot=self.bot,level=self.aiLevel}) end
	end,palette.red)
	-- (B1, 04/11) The AI's level for a duel, opposite the tournament: easy
	-- first (B0: an idle player lost 107 of 125 health in 15 s), the server
	-- keeps the choice for the rematches. The tournament sets its own.
	self.aiLevel="easy"
	local LEVEL_NEXT={easy="normal",normal="hard",hard="easy"}
	self.levelButton=button(shell,"AI LEVEL  •  EASY",UDim2.fromOffset(600,712),UDim2.fromOffset(400,52),function()
		if self.picking then return end
		self.aiLevel=LEVEL_NEXT[self.aiLevel] or "easy"
		self.levelButton.Text="AI LEVEL  •  "..Text.upper(self.aiLevel)
	end)
	self.levelButton.TextSize=24
	self.startButton.TextSize=32
	self.startStroke=create("UIStroke",self.startButton,{Color=palette.paper,Thickness=2.5,Transparency=.2,ApplyStrokeMode=Enum.ApplyStrokeMode.Border})
	-- (04/11) The Prodigy Tournament against the AI (Server/Tournament).
	self.cupButton=button(shell,"TOURNAMENT  •  VS AI",UDim2.fromOffset(60,712),UDim2.fromOffset(400,52),function()
		if not self.picking then send("CupStart",{player=self.player}) end
	end,palette.red)
	self.cupButton.TextSize=26
	self.tutorialButton=button(shell,"TRAINING",UDim2.fromOffset(60,below),UDim2.fromOffset(230,58),function()
		if self.picking then send("Cancel")
		elseif self.simple then self.simple=false;self:refreshSelection();if self.lastLobby then self:lobby(self.lastLobby) end
		else send("Tutorial",{player=self.player,bot=self.bot}) end
	end)
	-- Online 1v1 with the fighter chosen above: casual queue, or a private duel
	-- by code (host one, or type a friend's code and join).
	self.onlineRow=frame(shell,UDim2.fromOffset(302,below),UDim2.fromOffset(826,58),palette.ink,1)
	self.queueButton=button(self.onlineRow,"ONLINE DUEL",UDim2.fromOffset(0,0),UDim2.fromOffset(230,58),function() send("Queue",{player=self.player}) end)
	self.hostButton=button(self.onlineRow,"HOST PRIVATE DUEL",UDim2.fromOffset(242,0),UDim2.fromOffset(250,58),function() send("Host",{player=self.player}) end)
	local codeBox=create("TextBox",self.onlineRow,{Position=UDim2.fromOffset(504,0),Size=UDim2.fromOffset(196,58),Text="",PlaceholderText="FRIEND'S CODE",
		TextSize=24,Font=TITLE_FONT,TextColor3=palette.ink,PlaceholderColor3=Color3.fromRGB(120,112,100),BackgroundColor3=palette.paper,BorderSizePixel=0,ClearTextOnFocus=false})
	corner(codeBox,6)
	codeBox:GetPropertyChangedSignal("Text"):Connect(function()
		local clean=string.sub(string.gsub(string.upper(codeBox.Text),"[^A-Z0-9]",""),1,Protocol.CodeLength)
		if clean~=codeBox.Text then codeBox.Text=clean end
	end)
	self.codeBox=codeBox
	self.joinButton=button(self.onlineRow,"JOIN",UDim2.fromOffset(712,0),UDim2.fromOffset(114,58),function() send("Join",{player=self.player,code=codeBox.Text}) end)
	self.notice=text(shell,"",UDim2.fromOffset(60,776),UDim2.fromOffset(1480,18),14,palette.gold,BODY_FONT,Enum.TextXAlignment.Center)
	-- The prodigies themselves (Server/Portraits): they arrive a few seconds
	-- after the server starts; the stages and tablets fill in then.
	pcall(task.spawn,function()
		pcall(function()
			local folder=game:GetService("ReplicatedStorage"):WaitForChild("NinjaDuelPortraits",60)
			if not folder then return end
			-- The folder arrives first and its fighters stream in after it: each
			-- is framed once all of it is here (Server/Portraits counts them).
			local function complete(model)
				return model~=nil and #model:GetDescendants()&gt;=(model:GetAttribute("Descendants") or 0)
			end
			local started=os.clock()
			while os.clock()-started&lt;30 do
				local done=0
				for id in self.tablets do if complete(folder:FindFirstChild(id)) then done+=1 end end
				self.portraits=folder
				self:refreshSelection()
				if done&gt;=#Roster then break end
				task.wait(.25)
			end
		end)
	end)
	-- ------------------------------------------------------------------ HUD
	self.hud=frame(self.gui,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.ink,1)
	local hudScale=create("UIScale",self.hud,{Scale=1})
	-- (Look pass 03/11) The fight screen's own grade, under every HUD element:
	-- a soft ink vignette at the edges; a red one that throbs in danger.
	-- (User 03/11: the speed lines streaming in from the screen edges at a
	-- run "drive me crazy". They showed while the dash recharged too, so
	-- nearly all the time: removed.)
	self.screenFx=frame(self.gui,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.ink,1)
	self.screenFx.ZIndex=0
	local function edges(color,parent,strength)
		local out={}
		for k,spec in {{UDim2.fromScale(0,0),UDim2.fromScale(1,.16),90},{UDim2.fromScale(0,.84),UDim2.fromScale(1,.16),-90},{UDim2.fromScale(0,0),UDim2.fromScale(.1,1),0},{UDim2.fromScale(.9,0),UDim2.fromScale(.1,1),180}} do
			local f=frame(parent,spec[1],spec[2],color,0)
			if hasSequences then create("UIGradient",f,{Rotation=spec[3],Transparency=NumberSequence.new(1-strength,1)}) else f.BackgroundTransparency=1 end
			out[k]=f
		end
		return out
	end
	self.vignette=frame(self.screenFx,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.ink,1)
	edges(Color3.fromRGB(10,8,14),self.vignette,.38)
	self.danger=create("CanvasGroup",self.screenFx,{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,GroupTransparency=1})
	edges(Color3.fromRGB(200,20,30),self.danger,.8)
	self.hudScale=hudScale
	-- (UI redesign 02/11) The duel plates in the menu's language: the fighter's
	-- face in an ink medallion with a ring of his colour at the outer corner,
	-- the name in brush capitals, a long health bar with an ink edge and a
	-- light cut along its top, chakra and the ultimate gauge (four notches)
	-- under it, the status line, the round seals under the medallion.
	local function plate(side)
		local right=side=="right"
		local box=frame(self.hud,if right then UDim2.new(1,-20,0,16) else UDim2.fromOffset(20,16),UDim2.fromOffset(560,124),palette.ink,1)
		box.AnchorPoint=Vector2.new(if right then 1 else 0,0)
		local align=if right then Enum.TextXAlignment.Right else Enum.TextXAlignment.Left
		local function X(x,w) return if right then 560-x-w else x end
		-- The medallion.
		local medallion=frame(box,UDim2.fromOffset(X(0,88),0),UDim2.fromOffset(88,88),Color3.fromRGB(14,12,17),0)
		create("UICorner",medallion,{CornerRadius=UDim.new(.5,0)})
		local ring=create("UIStroke",medallion,{Color=palette.paper,Thickness=3,ApplyStrokeMode=Enum.ApplyStrokeMode.Border})
		local glow=frame(medallion,UDim2.fromScale(.5,.45),UDim2.fromScale(.9,.9),palette.red,.7)
		glow.AnchorPoint=Vector2.new(.5,.5);create("UICorner",glow,{CornerRadius=UDim.new(.5,0)})
		-- The fighter's initial in brush capitals (a ViewportFrame cannot draw
		-- the faces: they are SurfaceGuis).
		local initial=text(medallion,"",UDim2.fromScale(0,.04),UDim2.fromScale(1,1),58,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
		create("UIStroke",initial,{Color=palette.ink,Thickness=2.5,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
		-- Name, title, substitution diamonds.
		local name=text(box,"",UDim2.fromOffset(X(100,360),0),UDim2.fromOffset(360,34),32,palette.paper,TITLE_FONT,align)
		create("UIStroke",name,{Color=palette.ink,Thickness=2.5,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
		local title=text(box,"",UDim2.fromOffset(X(102,400),32),UDim2.fromOffset(400,16),13,palette.paper,BODY_FONT,align)
		create("UIStroke",title,{Color=palette.ink,Thickness=1,Transparency=.3,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
		-- Health: ink edge, dark well, the trail of lost health, the fill.
		-- A soft ink shadow under the whole plate keeps it readable on the sky.
		local shade=frame(box,UDim2.fromOffset(X(84,480),-6),UDim2.fromOffset(480,128),Color3.fromRGB(8,7,10),.55)
		shade.ZIndex=0;corner(shade,14)
		if hasSequences then create("UIGradient",shade,{Rotation=if right then 180 else 0,Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(.7,.35),NumberSequenceKeypoint.new(1,1)})}) end
		local track=frame(box,UDim2.fromOffset(X(96,464),52),UDim2.fromOffset(464,22),Color3.fromRGB(20,18,24),0)
		corner(track,4)
		create("UIStroke",track,{Color=palette.ink,Thickness=3,ApplyStrokeMode=Enum.ApplyStrokeMode.Border})
		local lag=frame(track,UDim2.fromScale(0,0),UDim2.fromScale(1,1),Color3.fromRGB(240,220,190))
		corner(lag,3)
		local fill=frame(track,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.gold)
		corner(fill,3)
		local shine=frame(fill,UDim2.fromOffset(0,2),UDim2.new(1,0,0,5),Color3.new(1,1,1),.6)
		corner(shine,3)
		-- Light from above on the fill and the trail; a dark well under them.
		if hasSequences then
			create("UIGradient",fill,{Rotation=90,Color=ColorSequence.new(Color3.new(1,1,1),Color3.fromRGB(170,150,130))})
			create("UIGradient",lag,{Rotation=90,Color=ColorSequence.new(Color3.new(1,1,1),Color3.fromRGB(200,180,160))})
			create("UIGradient",track,{Rotation=90,Color=ColorSequence.new(Color3.fromRGB(60,54,66),Color3.fromRGB(20,18,24))})
		end
		if right then lag.AnchorPoint=Vector2.new(1,0);lag.Position=UDim2.fromScale(1,0);fill.AnchorPoint=Vector2.new(1,0);fill.Position=UDim2.fromScale(1,0) end
		local chakraTrack=frame(box,UDim2.fromOffset(X(96,400),78),UDim2.fromOffset(400,6),Color3.fromRGB(20,18,24))
		corner(chakraTrack,3)
		local chakra=frame(chakraTrack,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.blue)
		if right then chakra.AnchorPoint=Vector2.new(1,0);chakra.Position=UDim2.fromScale(1,0) end
		-- (Stage 6) the ultimate gauge: it fills by hitting and being hit; full,
		-- it burns and the plate says how to fire it.
		local ultimateTrack=frame(box,UDim2.fromOffset(X(96,400),87),UDim2.fromOffset(400,6),Color3.fromRGB(20,18,24))
		local ultimate=frame(ultimateTrack,UDim2.fromScale(0,0),UDim2.fromScale(0,1),Color3.fromRGB(255,150,40))
		if right then ultimate.AnchorPoint=Vector2.new(1,0);ultimate.Position=UDim2.fromScale(1,0) end
		for k=1,3 do frame(ultimateTrack,UDim2.fromScale(k/4,0),UDim2.new(0,2,1,0),palette.ink,0) end
		local status=text(box,"",UDim2.fromOffset(X(98,460),96),UDim2.fromOffset(460,16),13,palette.muted,BODY_FONT,align)
		create("UIStroke",status,{Color=palette.ink,Thickness=1,Transparency=.3,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
		-- Neji's chakra points closed on this fighter: four pips at the far end of
		-- the chakra bar (both players read them), each lit as it closes.
		local points={}
		for k=1,4 do
			local pip=frame(box,UDim2.fromOffset(X(506+(k-1)*13,9),79),UDim2.fromOffset(9,9),palette.track)
			pip.AnchorPoint=Vector2.new(.5,.5);pip.Visible=false
			corner(pip,5)
			points[k]=pip
		end
		-- Substitution charges: two diamonds at the far end of the name line.
		local pips={}
		for k=1,2 do
			local pip=frame(box,UDim2.fromOffset(X(526-(k-1)*24,16),12),UDim2.fromOffset(16,16),palette.track)
			pip.Rotation=45;pip.ClipsDescendants=true
			local pfill=frame(pip,UDim2.fromScale(0,1),UDim2.fromScale(1,1),palette.paper)
			pfill.AnchorPoint=Vector2.new(0,1)
			pips[k]={pip=pip,fill=pfill}
		end
		local subLabel=text(box,"SUB",UDim2.fromOffset(X(456,40),12),UDim2.fromOffset(40,14),12,palette.paper,BODY_FONT,
			if right then Enum.TextXAlignment.Left else Enum.TextXAlignment.Right)
		-- Round wins: seals under the medallion.
		local medals={}
		for k=1,2 do
			local m=frame(box,UDim2.fromOffset(X(26+(k-1)*22,14),94),UDim2.fromOffset(14,14),palette.track)
			m.Rotation=45;table.insert(medals,m)
		end
		-- The awakening while it burns: its name, the time left and what it
		-- changes in the fight (UI.awakening), under the plate.
		local awake=text(box,"",UDim2.fromOffset(X(96,460),112),UDim2.fromOffset(460,26),15,palette.gold,TITLE_FONT,align)
		create("UIStroke",awake,{Color=palette.ink,Thickness=1.5,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
		return {box=box,name=name,title=title,fill=fill,lag=lag,chakra=chakra,ultimate=ultimate,status=status,pips=pips,subLabel=subLabel,medals=medals,points=points,pointsShown=0,awake=awake,initial=initial,ring=ring,glow=glow,right=right}
	end
	self.hp=plate("left")
	self.enemy=plate("right")
	self.round=text(self.hud,"ROUND 1",UDim2.new(.5,-120,0,22),UDim2.fromOffset(240,30),26,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
	self.roundSub=text(self.hud,"PRODIGY TOURNAMENT",UDim2.new(.5,-120,0,55),UDim2.fromOffset(240,16),13,palette.paper,BODY_FONT,Enum.TextXAlignment.Center)
	-- (UI pass 02/11) Over the sky and the wall the grey subtitle disappeared.
	create("UIStroke",self.roundSub,{Color=palette.ink,Thickness=1.2,Transparency=.2,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
	create("UIStroke",self.round,{Color=palette.ink,Thickness=2,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
	frame(self.hud,UDim2.new(.5,-46,0,48),UDim2.fromOffset(92,3),palette.red,0)
	self.cue=text(self.hud,"",UDim2.new(.5,-300,0,124),UDim2.fromOffset(600,40),30,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
	create("UIStroke",self.cue,{Color=palette.ink,Thickness=2,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
	-- (QA 12/11: « BUSY — STILL IN YOUR MOVE » read too loud mid-screen) the
	-- quiet line is a whisper: smaller, half see-through (never in autopilot,
	-- Matches:view sends no quiet reason for a fighter the player does not drive).
	self.channel=text(self.hud,"",UDim2.new(.5,-250,0,166),UDim2.fromOffset(500,24),13,palette.muted,BODY_FONT,Enum.TextXAlignment.Center)
	self.channel.TextTransparency=.4
	self.statusLine=text(self.hud,"",UDim2.new(0,24,1,-44),UDim2.fromOffset(396,18),14,palette.paper)
	-- (User 03/11) No key list on the fight screen: the controls sheet has it.
	self.statusLine.Visible=false
	-- It ends before the jutsu slots (centre -440) and shrinks rather than run under them.
	self.statusLine.TextScaled=true;create("UITextSizeConstraint",self.statusLine,{MaxTextSize=14})
	-- (UI pass 02/11) Grey on the sand was unreadable: light text, ink outline.
	create("UIStroke",self.statusLine,{Color=palette.ink,Thickness=1.2,Transparency=.15,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
	-- Combo counters: yours on the left, the opponent's on you on the right.
	local function counter(side)
		local right=side=="right"
		local box=frame(self.hud,if right then UDim2.new(1,-40,.36,0) else UDim2.new(0,40,.36,0),UDim2.fromOffset(220,90),palette.ink,1)
		box.AnchorPoint=Vector2.new(if right then 1 else 0,0)
		local align=if right then Enum.TextXAlignment.Right else Enum.TextXAlignment.Left
		local hits=text(box,"",UDim2.fromOffset(0,0),UDim2.fromOffset(220,56),54,palette.paper,TITLE_FONT,align)
		create("UIStroke",hits,{Color=palette.ink,Thickness=3,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
		local detail=text(box,"",UDim2.fromOffset(0,56),UDim2.fromOffset(220,18),14,palette.gold,BODY_FONT,align)
		create("UIStroke",detail,{Color=palette.ink,Thickness=1.5,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
		return {box=box,hits=hits,detail=detail,shown=0}
	end
	self.comboMine=counter("left")
	self.comboTheirs=counter("right")
	self.techniqueButtons={}
	-- (UI redesign 02/11) The jutsu cards leave the middle of the screen, where
	-- the camera puts the fighter's own body: a row in the bottom right corner,
	-- each card an ink slip with its key on a vermilion seal.
	for i=1,5 do
		local box=frame(self.hud,UDim2.new(1,-24-(5-i+1)*150+6,1,-84),UDim2.fromOffset(144,60),Color3.fromRGB(22,19,26),.05)
		corner(box,8)
		create("UIStroke",box,{Color=palette.paper,Thickness=1.5,Transparency=.7,ApplyStrokeMode=Enum.ApplyStrokeMode.Border})
		if hasSequences then create("UIGradient",box,{Rotation=90,Color=ColorSequence.new(Color3.fromRGB(70,62,78),Color3.fromRGB(22,19,26))}) end
		local seal=frame(box,UDim2.fromOffset(-8,-8),UDim2.fromOffset(28,28),palette.red,0)
		seal.Rotation=-6;corner(seal,5)
		create("UIStroke",seal,{Color=palette.ink,Thickness=2,ApplyStrokeMode=Enum.ApplyStrokeMode.Border})
		local key=text(seal,"",UDim2.fromScale(0,0),UDim2.fromScale(1,1),18,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
		-- (05/11) a word fits too (the chakra page's LMB, SPACE)
		key.TextScaled=true;create("UITextSizeConstraint",key,{MaxTextSize=18})
		local title=text(box,"",UDim2.fromOffset(26,6),UDim2.fromOffset(112,28),17,palette.paper,TITLE_FONT)
		title.TextScaled=true;create("UITextSizeConstraint",title,{MaxTextSize=18})
		local status=text(box,"",UDim2.fromOffset(10,38),UDim2.fromOffset(126,16),12,Color3.fromRGB(140,190,250))
		local cool=frame(box,UDim2.fromScale(0,1),UDim2.fromScale(1,0),palette.ink,.3)
		cool.AnchorPoint=Vector2.new(0,1);corner(cool,8)
		self.techniqueButtons[i]={box=box,key=key,title=title,status=status,cool=cool}
	end
	-- (05/11, user on the pad) "R1 + □" did not fit the 28 px seal: on a pad
	-- each seal shows its face button and the row is prefixed by the R1 it
	-- needs, lit while R1 is held.
	self.jutsuCaption=text(self.hud,"R1 +",UDim2.new(1,-80,1,-74),UDim2.fromOffset(52,40),22,palette.paper,TITLE_FONT,Enum.TextXAlignment.Right)
