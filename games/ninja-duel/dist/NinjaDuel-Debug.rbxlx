<?xml version='1.0' encoding='utf-8'?>
<roblox version="4">
  <Item class="Workspace" referent="ND1">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">140</float>
      <float name="FallenPartsDestroyHeight">-100</float>
    </Properties>
  </Item>
  <Item class="ReplicatedStorage" referent="ND2">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="ND3">
      <Properties>
        <string name="Name">NinjaDuel</string>
      </Properties>
      <Item class="ModuleScript" referent="ND4">
        <Properties>
          <string name="Name">ActionContext</string>
          <ProtectedString name="Source">-- Ninja Embodiment (DEC-027, EMB-002): the strike input means "attack from
-- the body's current situation", not "advance the universal combo counter".
--
-- One shared reading of the situation (pure: positions, velocities, facings,
-- states), one ordered list of situations, and per fighter a declaration of
-- what its body does in each (MoveGraphs[id].context, else a default slot of
-- its own graph). Deterministic: the same situation always gives the same
-- strike; nothing is random and nothing is keyed on a fighter id here.
--
-- Situations (first match wins):
--   drop    falling onto a grounded body below and close
--   wall    his back is to a surface on this body's line (a drive puts him
--           into it); also read inside a string, where it ends the string
--   back    the opponent's back is turned to this body, within reach
--   aside   (the player's stick) pressed while moving round him: the
--           fighter's own lateral strike, which carries the body round
--   away    (the player's stick) pressed while backing off: a strike that
--           takes the step back with it (space, not a string)
--   run     carrying real speed toward the opponent (not a full sprint)
--   flank   at the opponent's side, within reach
--   close   inside arm's length: knees, elbows, hilts, palms
--   reach   standing at the edge of reach: a lunge across it
-- None of them: the plain strike (the light string still exists, it is just
-- no longer the only meaning of the button).
local Context={}

local function flat(v) return Vector3.new(v.X,0,v.Z) end

-- Tunables (studs, studs/s). Kept here so tests and tuning read one table.
Context.Tune={
	DropFall=-6,        -- vertical speed below which the body is falling
	DropHeight=6,       -- at most this far above the target's root
	DropReach=6.5,      -- horizontal distance for a drop strike
	BackDot=-.35,       -- target facing . (target -&gt; me) below this: his back
	FlankDot=.4,        -- |target facing . (target -&gt; me)| below this: his side
	Reach=5.5,          -- back / flank / close situations need this distance or less
	Close=2.9,          -- inside this: close-range body strikes
	RunSpeed=13,        -- speed toward the opponent for a running strike
	RunMin=3.5,RunMax=10,
	ReachMin=6.8,ReachSpan=3,ReachStill=4,
	Stick=7,            -- the stick's lateral opener (aside) within this distance
	StickAway=9,        -- backing off: the step-back strike (a body already moving away)
	WallBehind=12,      -- a surface at most this far behind the target (a
	                    -- finisher throws a body about that far)
}

-- s: {pos, look, vel, airborne, grounded, target={pos, look, airborne, down, guarding}}
-- (Brawler adds the world facts it perceives: x.wallBehind, x.plainReach.)
-- Returns a table describing the situation (pure, no Roblox services).
function Context.read(s)
	local t=s.target
	local to=flat(t.pos-s.pos)
	local dist=to.Magnitude
	local line=if dist&gt;.05 then to.Unit else flat(s.look).Unit
	local toward=flat(s.vel):Dot(line)
	-- Where this body stands relative to the opponent's facing.
	local fromTarget=-line
	local tlook=flat(t.look)
	local facingDot=if tlook.Magnitude&gt;.05 then tlook.Unit:Dot(fromTarget) else 1
	return {
		dist=dist,dy=s.pos.Y-t.pos.Y,toward=toward,speed=flat(s.vel).Magnitude,vy=s.vel.Y,
		airborne=s.airborne==true,targetAirborne=t.airborne==true,targetDown=t.down==true,
		targetGuarding=t.guarding==true,facingDot=facingDot,
	}
end

local T=Context.Tune
-- Ordered situations. Each test reads only the context table.
Context.Situations={
	{tag="drop",test=function(x) return x.airborne and not x.targetAirborne and not x.targetDown and x.vy&lt;T.DropFall and x.dy&gt;1.5 and x.dy&lt;=T.DropHeight and x.dist&lt;=T.DropReach end},
	{tag="wall",test=function(x) return not x.airborne and not x.targetAirborne and not x.targetDown and x.dist&lt;=T.Reach and x.wallBehind~=nil and x.wallBehind&lt;=T.WallBehind end},
	{tag="back",test=function(x) return not x.airborne and not x.targetAirborne and not x.targetDown and x.dist&lt;=T.Reach and x.facingDot&lt;T.BackDot end},
	{tag="aside",test=function(x) return not x.airborne and not x.targetAirborne and not x.targetDown and x.stick=="side" and x.dist&lt;=T.Stick end},
	{tag="away",test=function(x) return not x.airborne and not x.targetAirborne and not x.targetDown and x.stick=="back" and x.dist&lt;=T.StickAway end},
	{tag="run",test=function(x) return not x.airborne and x.toward&gt;=T.RunSpeed and x.dist&gt;=T.RunMin and x.dist&lt;=T.RunMax end},
	{tag="flank",test=function(x) return not x.airborne and not x.targetAirborne and not x.targetDown and x.dist&lt;=T.Reach and math.abs(x.facingDot)&lt;T.FlankDot end},
	{tag="close",test=function(x) return not x.airborne and not x.targetAirborne and x.dist&lt;T.Close end},
	-- Beyond what the plain strike's own step reaches (x.plainReach, the
	-- fighter's: a fan or a cleaver reaches further than a fist).
	{tag="reach",test=function(x) local from=x.plainReach or T.ReachMin return not x.airborne and not x.targetAirborne and not x.targetDown and x.speed&lt;T.ReachStill and x.dist&gt;from and x.dist&lt;=from+T.ReachSpan end},
}

-- What a fighter's body does in a situation when it declares nothing: a slot
-- of its own move graph (so the default already carries its identity), then a
-- shared strike.
Context.Defaults={
	drop=function(graph) return "DropStrike" end,
	-- The fighter's own string finisher (its Light3 throws the body away).
	wall=function(graph) return graph.wallStrike or "Light3" end,
	back=function(graph) return "BackStrike" end,
	aside=function(graph) return graph.routes and graph.routes.side or nil end,
	away=function(graph) return graph.stepBack or "StepBackStrike" end,
	-- (Studio 28/10) A light out of a run opens the string: a runStrike that
	-- throws the body away (Sasuke's and Lee's flying kick) stays on the
	-- sprint heavy, the run's light is the shared DashAttack.
	run=function(graph,attacks)
		local m=graph.runStrike
		if m and attacks and attacks[m] and attacks[m].reaction~="HitStun" then return "DashAttack" end
		return m or "DashAttack"
	end,
	flank=function(graph) return graph.routes and graph.routes.side or nil end,
	-- (Audit 29/10, user: "Gaara particulier") A light pressed at close range
	-- never launches by default: Gaara's heavyAfterOne is his Sand Pillar, so
	-- every light at arm's length was a launcher. A fighter may still declare
	-- a launching closeStrike on purpose.
	close=function(graph,attacks)
		if graph.closeStrike then return graph.closeStrike end
		local m=graph.heavyAfterOne
		if m and attacks and attacks[m] and attacks[m].reaction=="Launched" then return nil end
		return m
	end,
	reach=function(graph) return graph.reachStrike or "DashAttack" end,
}

-- A surface a body can be driven into (Server/Perception reads it; the
-- client's guess of its next strike too): the stadium wall, the field trees,
-- the boulders, anything declared NinjaWall or WorldBreakable. A broken one
-- (a stump, a mound) no longer is.
function Context.surface(part)
	if not part then return false end
	if part:GetAttribute("WorldState")=="Broken" then return false end
	return part:GetAttribute("NinjaWall")==true or part:GetAttribute("WorldBreakable")==true or part.Name=="Field tree" or part.Name=="Cover"
end
-- (É7) The stick against the line to the opponent: "forward", "back",
-- "side" (with the side's sign) or nil under the strong-push threshold.
-- Brawler.classify reads it on the server, the client's guess of its own
-- next strike reads the same. tune: Config.Combo.
function Context.stick(move,line,tune)
	local m=flat(move)
	if m.Magnitude&lt;tune.IntentStrong then return nil,0 end
	local u=m.Unit
	local along=u:Dot(line)
	if along&gt;=tune.Toward then return "forward",0 end
	if along&lt;=-tune.Away then return "back",0 end
	return "side",if u:Dot(line:Cross(Vector3.yAxis))&gt;=0 then 1 else -1
end
-- The air dive (Brawler.airDive): high above a grounded body and out of the
-- first air swing's reach, the air opener is the lunge down onto him.
-- (Audit 03/11, B02) Straight above his head (a jump in place next to him:
-- 15 studs up, 1-3 away) the air swing passed over him too: from Overhead
-- up, a body that close is dived on as well.
Context.AirDive={Above=3,AboveMax=26,Near=3.5,Far=18,Overhead=6}
function Context.airDive(myPos,targetPos)
	local d=targetPos-myPos
	local h=flat(d).Magnitude
	local above=-d.Y
	local T=Context.AirDive
	return above&gt;=T.Above and above&lt;=T.AboveMax and (h&gt;=T.Near or above&gt;=T.Overhead) and h&lt;=T.Far
end

-- graph: the fighter's MoveGraphs entry (may be nil); attacks: the Attacks
-- table (a slot naming a strike that does not exist is skipped).
-- Returns move name and situation tag, or nil for the plain strike.
function Context.resolve(x,graph,attacks,only)
	graph=graph or {}
	local declared=graph.context or {}
	for _,situation in Context.Situations do
		if (not only or only[situation.tag]) and situation.test(x) then
			local move=declared[situation.tag]
			if move==false then continue end
			if move==nil then move=Context.Defaults[situation.tag](graph,attacks) end
			if move and attacks[move] then return move,situation.tag end
		end
	end
	return nil,nil
end

return Context
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND5">
        <Properties>
          <string name="Name">AnimationBindings</string>
          <ProtectedString name="Source">-- After publishing the retargeted Bangla sequences under the experience owner,
-- replace these zeros with that owner's R15 animation IDs (not the original R6 IDs).
return {Punch=0,HardSmack=0,MegaPunch=0,Parry=0}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND6">
        <Properties>
          <string name="Name">Appearance</string>
          <ProtectedString name="Source">-- The body a fighter is drawn with, apart from the kit it fights with
-- (DEC-036, 12/11: the player's ninja wears a prodigy's kit).
--   * The KIT is the prodigy (Shared/Fighters): stats, moves, jutsu, seals,
--     ultimate, awakening, Blender animations, effects.
--   * The BODY is what the fighter looks like: the costume it is dressed in
--     (Server/Looks, Server/LookMeshes) and its colours. A body is
--     { look = &lt;a prodigy's Name&gt;, skin/hair/outfit/color/iris = optional
--     overrides {r,g,b} }. Every prodigy's own body is his kit's look, so a
--     prodigy is drawn exactly as before.
-- A body for a player's own ninja (the Ōtsutsuki first) comes with AVATAR-001
-- step 3; until then only the prodigies' looks exist.
local Appearance={}

-- The prodigy's own body.
function Appearance.of(def)
	return {look=def.Name}
end

Appearance.COLOURS={"Skin","Hair","Outfit","Color","Iris"}

-- The pieces of a prodigy's look that serve one of his techniques: they go
-- with the KIT, not the body (DEC-036). Matched on the piece's own name
-- (after the body part: "UpperTorso__Gourd" is "Gourd"), by prefix, and only
-- within that prodigy's look. Whether a ninja may use such an item at once or
-- through his build's tree is still to be defined (DEC-036): for now they
-- are only marked (attribute KitItem on the piece).
Appearance.KitItems={
	Sand={"Gourd","Strap"},          -- Gaara's sand comes out of the gourd (and its strap)
	Copycat={"Sheath"},              -- Kakashi's tanto (def.Weapon), sheathed on his back
	Lion={"CurseMark"},              -- Sasuke's curse mark (his awakening spreads it)
	GentleFist={"ByakuganVein"},     -- Neji's Byakugan veins (his eyes' jutsu)
}

local function short(name)
	local tail=string.match(name,"__(.+)$")
	return tail or name
end
function Appearance.isKitItem(kitId,pieceName)
	local list=Appearance.KitItems[kitId]
	if not list or type(pieceName)~="string" then return false end
	local own=short(pieceName)
	for _,prefix in list do
		if string.sub(own,1,#prefix)==prefix then return true end
	end
	return false
end

return Appearance
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND7">
        <Properties>
          <string name="Name">Attacks</string>
          <ProtectedString name="Source">-- Bangla three-strike M1 foundation; air/grab/launch branches are Ninja Duel glue.
local Combo=require(script.Parent.BanglaCombo)
local function move(startup,active,recovery,damage,travel,reaction,impulse,stun)
 return {startup=startup,active=active,recovery=recovery,damage=damage,travel=travel,
  travelTime=startup+active,reaction=reaction or "HitStun",impulse=impulse or Vector3.new(0,0,10),stun=stun or 0.27,
  range=7.8,width=5.5,height=6,blockable=true,
  -- Contact distance (root to root) where the step-in stops: an arm's length
  -- for hand strikes. Closer, the two bodies visibly merge mid-string
  -- (Studio 28/10: at 3.6 the client showed 3.3-4.0, torsos overlapping).
  contact=4.1}
end
local attacks={
 Light1=move(.09,.12,Combo.comboDelay-.22,Combo.Damage.Punch,3.2),
 Light2=move(.10,.12,Combo.comboDelay-.23,Combo.Damage.HardSmack,3.5),
 Light3=move(.12,.14,Combo.comboDelay-.26,Combo.Damage.MegaPunch,4.2,"Knockback",Vector3.new(0,14,50),.48),
 -- (Stage 6) The longer strings: 4 hits for everyone (5 for Lee and Naruto),
 -- the last one (Light3) throws. The middle hits play the fighter's first and
 -- second clips again until they get their own (clip).
 Light4=move(.09,.12,Combo.comboDelay-.22,Combo.Damage.Punch,3.2),
 Light5=move(.10,.12,Combo.comboDelay-.23,Combo.Damage.Punch,3.4),
 Heavy=move(.30,.17,.52,14,5.4,"Knockdown",Vector3.new(0,12,34),.68),
 Launcher=move(.17,.14,.28,8,3.2,"Launched",Vector3.new(0,58,13),1.18),
 DashAttack=move(.07,.15,.27,7,8.2,"HitStun",Vector3.new(0,3,13),.31),
 Air1=move(.08,.13,.18,6,2.8,"Juggled",Vector3.new(0,15,8),.62),
 Air2=move(.09,.14,.19,7,3.1,"Juggled",Vector3.new(0,10,12),.64),
 Slam=move(.15,.20,.38,11,2.8,"Knockdown",Vector3.new(0,-78,10),.86),
 Grab=move(.18,.14,.5,0,2,"Grabbed",Vector3.zero,.8),
 Throw=move(.12,.1,.34,10,0,"Knockdown",Vector3.new(0,18,48),.7),
 ThrowUp=move(.12,.1,.3,7,0,"Launched",Vector3.new(0,50,10),1.1),
 -- Character branches (directional input inside a confirmed string).
 -- Minato: a sidestep cut that swings him around the opponent's guard.
 AngleStep=move(.08,.1,.2,6,1.2,"HitStun",Vector3.new(0,0,9),.3),
 -- (04/11) Minato's Flying Thunder God level two: a palm laid on the body with
 -- the formula in it (the seal jutsu sends that body to his seal on contact).
 FlashTouch=move(.06,.1,.24,4,2.4,"HitStun",Vector3.new(0,0,4),.4),
 -- (04/11) Seal jutsu strikes: Lee's nunchaku and his rising whirlwind of
 -- three kicks, Neji's two fingers into the points of the legs.
 Nunchaku=move(.14,.2,.32,11,2.4,"Knockback",Vector3.new(0,10,40),.5),
 GorikiSenpu=move(.16,.26,.36,12,2.2,"Launched",Vector3.new(0,48,8),1.0),
 LowPalm=move(.08,.1,.26,6,2.2,"HitStun",Vector3.new(0,0,8),.35),
 -- Itachi: a low spinning sweep that trades the string for a knockdown,
 -- and the palm that answers a successful Read.
 Sweep=move(.12,.14,.34,7,1.6,"Knockdown",Vector3.new(0,6,12),.62),
 CounterPalm=move(.05,.12,.3,10,2.6,"Knockback",Vector3.new(0,14,46),.5),
 -- From a wall run: a diving strike at the opponent (active window sized to the flight).
 WallDive=move(.1,.3,.32,9,0,"Knockdown",Vector3.new(0,10,30),.62),
 -- Neji: twin palms driven from the hips (heavy after one clean palm, or the
 -- counter after Rotation).
 PalmThrust=move(.11,.14,.34,10,3.4,"Knockback",Vector3.new(0,12,62),.52),
 -- Minato: a knee driven up into the body after one clean cut. The opponent is
 -- popped to waist height: continue on the ground, jump after it, or chase.
 KneeStrike=move(.08,.12,.3,7,2.6,"Juggled",Vector3.new(0,26,4),.62),
 -- Running taijutsu: out of a full sprint, a flying kick (strike) and a
 -- sliding sweep (heavy). The run is the wind-up; a whiff overshoots.
 FlyingKick=move(.1,.16,.32,9,10,"Knockback",Vector3.new(0,14,48),.5),
 -- Riposte: out of a clean block or a perfect dodge, an instant strike that
 -- opens the string (block -&gt; riposte -&gt; combo).
 Riposte=move(.05,.12,.26,8,2.6,"HitStun",Vector3.new(0,5,12),.36),
 -- Gaara: sand erupts under the opponent at range and throws them up.
 SandPillar=move(.27,.14,.5,9,0,"Launched",Vector3.new(0,54,4),1.1),
 -- (Stage 6) Gaara's heavy no longer launches: a hand of sand seizes the body
 -- at range and slams it down; after one lash, the sand fist drives it away.
 SandHand=move(.24,.16,.48,10,0,"Knockdown",Vector3.new(0,-24,-14),.8),
 SandFist=move(.18,.14,.4,11,0,"Knockback",Vector3.new(0,10,64),.52),
 -- (Stage 6) Gaara's own routes: away, a low wave of sand along the floor;
 -- sideways, a glide on the sand that strikes while it slips aside.
 SandLowWave=move(.16,.16,.4,7,0,"Knockdown",Vector3.new(0,6,16),.62),
 SandGlide=move(.12,.12,.26,6,0,"HitStun",Vector3.new(0,3,8),.34),
 SlideSweep=move(.12,.18,.38,8,11,"Knockdown",Vector3.new(0,8,18),.62),
 -- Lateral routes: Itachi's feint step (an afterimage stays, he reappears at
 -- the flank) and Neji's circular step onto a chakra point. Both keep the string.
 FeintStep=move(.1,.12,.22,6,0,"HitStun",Vector3.new(0,4,9),.34),
 CircleStep=move(.09,.12,.22,6,0,"HitStun",Vector3.new(0,3,8),.34),
 -- Air routes after an air hit: drive the body away (toward a wall), spike it
 -- into the floor (it bounces once), or vault to its other side.
 AirDrive=move(.08,.13,.22,7,3,"Knockback",Vector3.new(0,8,48),.5),
 AirSpike=move(.09,.12,.24,7,2,"Spiked",Vector3.new(0,-72,6),.9),
 AirSwitch=move(.1,.14,.2,6,0,"Juggled",Vector3.new(0,13,9),.6),
 -- (User 28/10) Jump + heavy: a small front salto into a heel kick that
 -- sends the body away. Not a safe plunge: a long recovery that lands open.
 AirFlip=move(.17,.13,.38,11,2.4,"Knockback",Vector3.new(0,16,56),.55),
 -- Sasuke: an acrobatic rising kick he follows into the air, a vault over the
 -- opponent into a back kick, and the Chidori thrust (started by the jutsu).
 LionKick=move(.15,.14,.28,8,3,"Launched",Vector3.new(0,50,5),1.25),
 VaultKick=move(.12,.12,.24,7,0,"HitStun",Vector3.new(0,6,12),.36),
 ChidoriThrust=move(.04,.26,.62,22,15,"Knockback",Vector3.new(0,12,70),.7),
 -- Rock Lee (stress-test wave): the Leaf Rising Wind (a straight-leg kick out
 -- of a crouch, followed into the air), the Leaf Hurricane (a low spinning kick
 -- that keeps the string), the Leaf Whirlwind (a wide spinning kick that catches
 -- a side step), the Leaf Great Whirlwind (his technique: a spinning kick across
 -- the gap) and the deflecting crescent kick (his tool: no blade). Shapes and
 -- tags at the end of this file.
 LeafRising=move(.13,.14,.28,8,3.2,"Launched",Vector3.new(0,56,6),1.2),
 LeafHurricane=move(.11,.16,.24,6,1.8,"Juggled",Vector3.new(0,16,7),.55),
 LeafWhirlwind=move(.12,.16,.24,7,1.4,"HitStun",Vector3.new(0,5,14),.38),
 GreatWhirlwind=move(.06,.24,.36,9,14,"Knockback",Vector3.new(0,16,54),.55),
 DeflectKick=move(.05,.18,.3,4,0,"HitStun",Vector3.new(0,4,10),.3),
 -- Temari (roster wave): the iron fan. The Updraft scoops the body into
 -- rising air (Gale.updraft holds it there), the Fan Slam brings the closed fan
 -- down, the Fan Pirouette throws the body aside (lateral), the backhand pushes
 -- away, the Fan Dive blows a body in the air down into the floor. Shapes and
 -- tags at the end of this file.
 Updraft=move(.15,.15,.3,8,1.5,"Launched",Vector3.new(0,46,3),1.25),
 FanSlam=move(.16,.14,.36,9,1.4,"Knockdown",Vector3.new(0,6,12),.7),
 FanPirouette=move(.12,.18,.3,7,.8,"Knockback",Vector3.new(0,8,34),.42),
 FanBackhand=move(.1,.14,.32,9,1.6,"Knockback",Vector3.new(0,12,52),.5),
 FanDive=move(.1,.14,.26,7,1.5,"Spiked",Vector3.new(0,-70,4),.9),
}
-- Reach of the body that lands each strike (see `contact` in move()).
for name,gap in {Light3=4.3,Heavy=4.2,FlyingKick=4.2,PalmThrust=3.7,CounterPalm=3.7,FlashTouch=3.3,KneeStrike=3.2,Sweep=3.5,Grab=2.6,Throw=2.6,ThrowUp=2.6,Slam=3.0,WallDive=2.6} do
 if attacks[name] then attacks[name].contact=gap end
end

for name,spec in attacks do
 if not Combo.Actions[name] then spec.depth=spec.range*.8;spec.offset=spec.range*.4
 else
  -- The string's donor volume (1 to 3 studs ahead) stopped short of the
  -- contact distance: it now reaches a quarter stud past it.
  spec.depth=spec.contact+.25-1;spec.offset=(1+spec.contact+.25)/2
 end
 spec.animation=name;spec.feedback=spec.reaction;spec.chain=name=="Light1" or name=="Light2" or name=="Light4" or name=="Light5" or name=="Air1" or name=="Air2" or name=="DashAttack" or name=="AngleStep" or name=="Riposte"
  or name=="FeintStep" or name=="CircleStep" or name=="AirSwitch" or name=="VaultKick"
 spec.air=name=="Air1" or name=="Air2" or name=="AirDrive" or name=="AirSpike" or name=="AirSwitch" or name=="AirFlip"
end
-- Hitstop is not authored per move any more: weight comes from Combat.Hitstop so
-- a light jab cannot be given a heavy stop by accident.
local motion={
 Light1={side=1,twist=30,lean=8,arm=82,step=1.05},
 Light2={side=-1,twist=34,lean=10,arm=88,step=1.08},
 Light3={side=1,twist=72,lean=12,arm=102,step=1.2},
 Light4={side=1,twist=30,lean=8,arm=82,step=1.05},
 Light5={side=-1,twist=34,lean=10,arm=88,step=1.08},
 Heavy={side=-1,twist=48,lean=25,arm=116,step=1.3},
 Launcher={side=1,twist=20,lean=-24,arm=112,step=1.15},
 DashAttack={side=1,twist=36,lean=28,arm=96,step=1.35},
 Air1={side=1,twist=38,lean=12,arm=98,step=1.1},
 Air2={side=-1,twist=44,lean=18,arm=104,step=1.15},
 Slam={side=1,twist=12,lean=46,arm=128,step=1.2},
 Grab={side=1,twist=10,lean=18,arm=72,step=1.05},
 Throw={side=1,twist=70,lean=22,arm=92,step=1.1},
 ThrowUp={side=-1,twist=28,lean=-30,arm=110,step=1.1},
 AngleStep={side=1,twist=40,lean=10,arm=90,step=1.1},
 FlashTouch={side=1,twist=24,lean=14,arm=92,step=1.1},
 Nunchaku={side=1,twist=60,lean=12,arm=104,step=1.15},
 GorikiSenpu={side=1,twist=80,lean=-10,arm=70,step=1.1},
 LowPalm={side=1,twist=20,lean=30,arm=70,step=1.1},
 Sweep={side=-1,twist=60,lean=20,arm=60,step=1.0},
 CounterPalm={side=1,twist=30,lean=16,arm=100,step=1.2},
 WallDive={side=1,twist=24,lean=42,arm=80,step=1.2},
 PalmThrust={side=1,twist=20,lean=18,arm=100,step=1.25},
 KneeStrike={side=1,twist=16,lean=14,arm=70,step=1.15},
 FlyingKick={side=1,twist=10,lean=-12,arm=60,step=1.3},
 Riposte={side=1,twist=24,lean=12,arm=92,step=1.2},
 SandPillar={side=1,twist=10,lean=-6,arm=120,step=1},
 SlideSweep={side=1,twist=14,lean=-20,arm=40,step=1.3},
 FeintStep={side=-1,twist=30,lean=10,arm=90,step=1.1},
 CircleStep={side=1,twist=40,lean=8,arm=90,step=1.05},
 AirDrive={side=1,twist=20,lean=-10,arm=60,step=1},
 AirSpike={side=1,twist=10,lean=40,arm=120,step=1},
 AirSwitch={side=-1,twist=60,lean=10,arm=80,step=1},
 AirFlip={side=1,twist=20,lean=-20,arm=60,step=1},
 LionKick={side=1,twist=10,lean=-30,arm=100,step=1.15},
 VaultKick={side=-1,twist=70,lean=10,arm=60,step=1.1},
 ChidoriThrust={side=1,twist=20,lean=30,arm=110,step=1.4},
}
for name,pose in motion do for key,value in pose do attacks[name][key]=value end end
for _,name in {"Light1","Light2","Light3"} do attacks[name].width=5;attacks[name].height=5;attacks[name].range=6 end
attacks.AngleStep.width=5;attacks.AngleStep.range=6.5;attacks.AngleStep.orbit=17
attacks.Sweep.height=3.5;attacks.Sweep.width=6.5;attacks.Sweep.range=6.5
attacks.WallDive.width=6;attacks.WallDive.height=8;attacks.WallDive.range=7.5;attacks.WallDive.facing=-.45
attacks.FlyingKick.range=7.5;attacks.FlyingKick.width=5.5
attacks.SandPillar.range=12.5;attacks.SandPillar.width=6;attacks.SandPillar.height=8;attacks.SandPillar.depth=11;attacks.SandPillar.offset=6;attacks.SandPillar.facing=.25
attacks.SlideSweep.range=7.5;attacks.SlideSweep.height=3.5;attacks.SlideSweep.width=6.5
attacks.FeintStep.width=5;attacks.FeintStep.range=6.5;attacks.FeintStep.orbit=34
attacks.CircleStep.width=5;attacks.CircleStep.range=6;attacks.CircleStep.orbit=28
attacks.AirSwitch.orbit=40;attacks.AirSwitch.width=6;attacks.AirSwitch.height=7
attacks.AirSpike.height=7;attacks.AirDrive.height=7
attacks.VaultKick.width=5.5;attacks.VaultKick.range=6.5;attacks.VaultKick.orbit=50
attacks.ChidoriThrust.range=7;attacks.ChidoriThrust.width=4.5
-- Where a strike lands and what it is: the victim's body answers the blow it
-- actually took (head snaps, body folds, legs are taken away, ...).
local ZONE={Light1="head",Light2="body",Light3="body",Light4="body",Light5="head",Heavy="body",Launcher="chin",DashAttack="body",Air1="body",Air2="head",
 Slam="body",AngleStep="body",Sweep="legs",CounterPalm="body",WallDive="body",PalmThrust="body",KneeStrike="body",FlyingKick="head",
 Riposte="head",SlideSweep="legs",SandPillar="legs",FeintStep="body",CircleStep="body",AirDrive="body",AirSpike="head",AirSwitch="head",
 LionKick="chin",VaultKick="head",ChidoriThrust="body",AirFlip="head",
 Throw="body",ThrowUp="body",Grab="body"}
local KIND={Light3="kick",Heavy="heavy",Launcher="launch",Air2="kick",Slam="slam",Sweep="sweep",SlideSweep="sweep",KneeStrike="knee",
 FlyingKick="kick",WallDive="kick",SandPillar="launch",AirDrive="kick",AirSpike="spike",AirSwitch="kick",PalmThrust="palm",CounterPalm="palm",
 LionKick="launch",VaultKick="kick",ChidoriThrust="heavy",AirFlip="kick"}
for name,spec in attacks do spec.zone=ZONE[name] or "body";spec.kind=KIND[name] or "strike" end
attacks.Light4.clip="Light1";attacks.Light5.clip="Light2"
-- (Audit 04/11) the new seal-page strikes, until their own Blender clips: the
-- fighter's nearest clip (they played Sasuke's jab: Lee's own table is his).
attacks.Nunchaku.clip="LeafWhirlwind";attacks.GorikiSenpu.clip="LeafRising";attacks.LowPalm.clip="PalmThrust"
attacks.SandHand.range=12;attacks.SandHand.width=5;attacks.SandHand.height=6;attacks.SandHand.depth=11;attacks.SandHand.offset=6;attacks.SandHand.facing=.25;attacks.SandHand.clip="SandPillar";attacks.SandHand.kind="heavy";attacks.SandHand.zone="body"
attacks.SandFist.range=9;attacks.SandFist.width=5;attacks.SandFist.depth=8;attacks.SandFist.offset=4.5;attacks.SandFist.facing=.3;attacks.SandFist.clip="Light3";attacks.SandFist.kind="heavy"
attacks.SandLowWave.range=9.5;attacks.SandLowWave.width=7;attacks.SandLowWave.height=3.5;attacks.SandLowWave.depth=9;attacks.SandLowWave.offset=4.5;attacks.SandLowWave.clip="Sweep";attacks.SandLowWave.zone="legs";attacks.SandLowWave.kind="sweep"
attacks.SandGlide.range=8.5;attacks.SandGlide.width=5;attacks.SandGlide.depth=7;attacks.SandGlide.offset=4;attacks.SandGlide.orbit=34;attacks.SandGlide.clip="FeintStep";attacks.SandGlide.zone="body"
attacks.Grab.range=4.6;attacks.Grab.blockable=false;attacks.Throw.blockable=false;attacks.ThrowUp.blockable=false
-- Rock Lee's moves, kept together so the stress-test fighter stays additive:
-- reach, body, hit zone and kind, the two routes that keep the string, and the
-- two big kicks that crack Gaara's sand shield like a launcher does
-- (breaksShield, read by Combat:damage next to its name list).
for name,shape in {
 LeafRising={contact=3.4,range=6.5,width=5,height=7,zone="chin",kind="launch",side=1,twist=12,lean=-34,arm=40,step=1.15,breaksShield=true},
 LeafHurricane={contact=3.5,range=6.5,width=6.5,height=3.5,zone="legs",kind="sweep",side=-1,twist=70,lean=24,arm=50,step=1.0,chain=true},
 LeafWhirlwind={contact=3.8,range=7,width=9,height=6,zone="head",kind="kick",side=1,twist=80,lean=6,arm=60,step=1.05,chain=true},
 GreatWhirlwind={contact=3.6,range=7,width=7,height=6,zone="body",kind="kick",side=1,twist=90,lean=10,arm=60,step=1.4,breaksShield=true},
 DeflectKick={contact=3.6,range=6,width=7,height=7,zone="body",kind="kick",side=-1,twist=40,lean=-6,arm=50,step=1.0},
} do
 for key,value in shape do attacks[name][key]=value end
end
-- Naruto (roster wave, several bodies). His own: the headbutt (heavy after
-- one hit) and the tackle into the legs (low route). Carried out by a shadow
-- clone (`proxy`: where the clone stands, Server/Bodies; `proxyClip`: the
-- clone's own clip while Naruto plays the move's): the kick from behind (the
-- third hit with a clone out), the kick up under the body (the Uzumaki
-- Barrage) and the strike from the flank (side route, the string goes on).
-- The Nine-Tails cloak's claws (no clones there): a rising claw and a long
-- swipe. A clone's own jab and the barrage kick time the clients' clips.
for name,m in {
 Headbutt=move(.1,.1,.3,9,2.6,"HitStun",Vector3.new(0,4,14),.45),
 Tackle=move(.12,.16,.34,8,4.5,"Knockdown",Vector3.new(0,8,22),.7),
 CloneKick=move(.15,.14,.28,11,0,"Juggled",Vector3.new(0,26,6),.62),
 UzumakiKick=move(.16,.14,.3,8,0,"Launched",Vector3.new(0,56,4),1.2),
 MirrorClone=move(.11,.12,.22,6,0,"HitStun",Vector3.new(0,4,10),.36),
 ClawRise=move(.14,.14,.26,10,2.6,"Launched",Vector3.new(0,58,6),1.2),
 ClawSwipe=move(.1,.14,.22,8,1.6,"HitStun",Vector3.new(0,6,16),.4),
 CloneJab=move(.22,.1,.3,4,0,"HitStun",Vector3.new(0,3,10),.32),
 BarrageKick=move(.1,.1,.2,3,0,"Juggled",Vector3.new(0,22,2),.6),
 -- (Move list, "course + △ : plongée tête la première") out of a full run.
 HeadDive=move(.12,.16,.42,10,9,"Knockdown",Vector3.new(0,10,46),.7),
} do
 m.animation=name;m.feedback=m.reaction;m.chain=false;m.air=false
 m.depth=m.range*.8;m.offset=m.range*.4
 attacks[name]=m
end
for name,shape in {
 Headbutt={contact=3.0,range=5.5,zone="head",kind="heavy",side=1,twist=6,lean=26,arm=40,step=1.2},
 Tackle={contact=2.8,range=6.5,width=6,height=4,zone="legs",kind="sweep",side=1,twist=10,lean=40,arm=60,step=1.35},
 CloneKick={contact=2.6,range=6,width=5.5,height=6,zone="body",kind="kick",side=1,twist=40,lean=8,arm=60,step=1,proxy="behind",proxyClip="CloneKickStrike"},
 UzumakiKick={contact=2.4,range=6,width=5.5,height=7,zone="chin",kind="launch",side=1,twist=10,lean=-20,arm=60,step=1,proxy="under",proxyClip="UzumakiRise",breaksShield=true},
 MirrorClone={contact=2.8,range=6,width=5.5,height=6,zone="body",kind="strike",side=-1,twist=30,lean=10,arm=90,step=1,proxy="side",proxyClip="MirrorStrike",chain=true},
 ClawRise={contact=3.4,range=9.5,width=6,height=7,depth=8.5,offset=4.4,zone="chin",kind="launch",side=1,twist=16,lean=-24,arm=120,step=1.15,breaksShield=true},
 ClawSwipe={contact=3.6,range=10,width=9,height=6,depth=9,offset=4.6,zone="body",kind="slash",side=-1,twist=60,lean=12,arm=100,step=1.1,chain=true},
 CloneJab={contact=3,range=5.5,zone="head",kind="strike",side=1,twist=24,lean=10,arm=88,step=1},
 BarrageKick={contact=2.4,range=5,zone="body",kind="kick",side=1,twist=10,lean=-10,arm=60,step=1},
 HeadDive={contact=3.2,range=7.5,width=5.5,height=5,zone="body",kind="heavy",side=1,twist=4,lean=60,arm=40,step=1.35},
} do
 for key,value in shape do attacks[name][key]=value end
end
-- Temari's fan moves: a reach of their own (contact: she stays further out),
-- the zone and kind the body answers, the air flag of the Fan Dive and the
-- lateral push of the pirouette (Brawler.hit: thrown aside, not away).
for name,shape in {
 Updraft={contact=4.8,range=7.5,width=6,height=8,zone="chin",kind="launch",side=1,twist=12,lean=-28,arm=120,step=1.1,breaksShield=true},
 FanSlam={contact=4.8,range=7.6,width=5,height=7,zone="head",kind="heavy",side=1,twist=10,lean=30,arm=120,step=1.15},
 FanPirouette={contact=4.6,range=7.6,width=8.5,height=6,zone="body",kind="palm",side=1,twist=90,lean=6,arm=80,step=1.0,lateral=true},
 FanBackhand={contact=4.8,range=7.6,width=6,height=6,zone="body",kind="slash",side=-1,twist=50,lean=10,arm=96,step=1.15},
 FanDive={contact=4.2,range=7.5,width=6,height=8,zone="head",kind="spike",side=1,twist=10,lean=40,arm=120,step=1,air=true},
} do
 for key,value in shape do attacks[name][key]=value end
end
-- Ninja Embodiment (EMB-002, Shared/ActionContext): two shared strikes the
-- situation itself calls for. `clip` names the clip a fighter plays for it
-- when he has none of his own (his own kick from behind, his own air kick).
--   BackStrike  the opponent's back is turned: a full strike into it, no
--               turning needed; it throws the body away (a punish, not a string).
--   DropStrike  falling onto a grounded body: the weight comes down with the
--               strike; it does not hold the body in the air.
for name,m in {
 BackStrike=move(.08,.13,.3,10,2.4,"Knockback",Vector3.new(0,10,34),.46),
 -- (The stick backing off as he presses: a quick strike that takes the
 -- step back with it: it lands, and the body is already out of reach.)
 StepBackStrike=move(.07,.1,.26,5,0,"HitStun",Vector3.new(0,3,10),.34),
 DropStrike=move(.07,.15,.24,8,1.2,"HitStun",Vector3.new(0,-6,10),.4),
} do
 m.animation=name;m.feedback=m.reaction;m.chain=false;m.air=false
 m.depth=m.range*.8;m.offset=m.range*.4
 attacks[name]=m
end
for name,shape in {
 BackStrike={contact=3.6,range=6.5,width=5.5,height=6,zone="body",kind="kick",clip="Light3",side=1,twist=60,lean=14,arm=100,step=1.2},
 DropStrike={contact=3,range=6.5,width=6,height=10,zone="head",kind="kick",clip="Air2",side=-1,twist=40,lean=24,arm=100,step=1.1},
 StepBackStrike={contact=3.4,range=6,width=5,height=6,zone="body",kind="strike",clip="Light2",side=-1,twist=30,lean=-6,arm=90,step=.9,retreat=2.6},
} do
 for key,value in shape do attacks[name][key]=value end
end
-- Roster 20 batches add their strikes from their own data modules.
for _,wave in {require(script.Parent.Wave1),require(script.Parent.Wave2),require(script.Parent.Wave3),require(script.Parent.Wave4)} do
 if wave.attacks then wave.attacks(move,attacks) end
end
return attacks
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND8">
        <Properties>
          <string name="Name">BanglaCombo</string>
          <ProtectedString name="Source">-- Adapted from BanglaBattlegrounds StarterPack/Punch/PunchMoves (Dewan Mukto, MIT).
-- Input and cooldown authority moved to the server; no Tool or independent input loop.
local Combo={maxComboCount=3,comboDelay=.5,resetDelay=1.1}
function Combo.next(actor,now)
 local comboTimer=now-actor.lastAttack
 local comboCount=actor.combo
 local maxComboCount=Combo.maxComboCount
 local comboDelay=Combo.resetDelay
 -- Donor combo progression, retained verbatim with per-actor state.
 if comboTimer &lt;= comboDelay then
  comboCount = comboCount + 1
  if comboCount &gt; maxComboCount then
   comboCount = 1
  end
 else
  comboCount = 1
 end
 actor.combo=comboCount;actor.lastAttack=now
 return 'Light'..comboCount
end
-- (Stage 6) Longer strings: the fourth (and Lee's and Naruto's fifth) hit is
-- a quick blow between the second and the ender (Light3 always ends).
Combo.Actions={Light1='Punch',Light2='HardSmack',Light3='MegaPunch',Light4='Punch',Light5='Punch'}
-- Donor server damageValues and Animation objects, never supplied by clients.
-- MegaPunch tuned 25 -&gt; 18 for Ninja Duel pacing (a three-hit string is no
-- longer a third of a health bar); Punch and HardSmack keep the donor values.
Combo.Damage={Punch=5,HardSmack=10,MegaPunch=18}
Combo.AnimationIds={Punch=18342131933,HardSmack=18342045122,MegaPunch=18341956985,Parry=18341905406}
return Combo
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND9">
        <Properties>
          <string name="Name">BetaRoster</string>
          <ProtectedString name="Source">-- The fighters the published beta offers (user 03/11: « on ne peut pas
-- publier la bêta avec les 20 personnages, il n'y en a que 8 qui sont au
-- point »). The select screen, the portraits and the server's checks (a local
-- duel, the tutorial, an online pick) read this list; Shared/Roster keeps the
-- whole twenty for the suites and the dev tools. A prodigy joins the beta
-- when he is added here, one by one.
return {
	"Lion","Legion","Sand","Leaf",
	"GentleFist","Mirage","Copycat","Flashstep",
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND10">
        <Properties>
          <string name="Name">ChakraMoves</string>
          <ProtectedString name="Source">-- Each prodigy's chakra (DEC-032, user 03/11: "le chakra pour l'instant c'est
-- nul, tu frappes plus fort mais pas de trucs"): his nature, and what his
-- infused light, heavy, leap and dash BECOME (docs/characters/KITS_V2.md,
-- table 1). The server plays them (Server/ChakraFlow); (05/11, user on the
-- pad: L2 pressed alone 26 times in one evening) the HUD names them while the
-- chakra button is held, on the jutsu row (Client/UI).
local ChakraMoves={}
-- Unlisted: plain chakra.
ChakraMoves.Nature={
	Lion="Lightning",Copycat="Lightning",Mirage="Fire",Legion="Wind",Gale="Wind",
	Sand="Sand",GentleFist="GentleFist",Leaf="Strength",Flashstep="Chakra",
}
ChakraMoves.Label={Lightning="RAITON",Fire="KATON",Wind="FUTON",Sand="SAND",GentleFist="GENTLE FIST",Strength="STRENGTH",Chakra="CHAKRA"}
-- nil: the nature's common effect only.
ChakraMoves.Signature={
	Lion={light="Nagashi",heavy="FireJet"},             -- Chidori Nagashi through the guard; a jet of fire past the kick
	Legion={light="CloneStrike",heavy="Uzumaki"},       -- a clone pops beside him and follows up; U-ZU-MA-KI sends him up
	Sand={light="SandFist",heavy="SandGrip"},           -- the sand reaches far; the sand hand grips the legs
	Leaf={light="Flurry",heavy="GuardCrush",leap="Lotus",dash="AfterImage"}, -- the "patates"; the whirlwind through the guard
	GentleFist={heavy="Vacuum",dash="Rotation"},        -- (light: the Juken closes a point) the palm at range; a short Kaiten
	Mirage={light="Crows",heavy="FireJet",dash="CrowScatter"}, -- crows from the impact; he scatters into crows
	Flashstep={heavy="Rasengan",dash="FlyingThunder"},  -- (light: the seal) the Rasengan to the body; he flashes behind
	Copycat={heavy="EarthSpike",dash="Headhunter"},     -- Doton: a spike under him; under the ground and out behind
}
ChakraMoves.SigLabel={Nagashi="CHIDORI NAGASHI",FireJet="FIRE JET",CloneStrike="SHADOW CLONE",Uzumaki="U-ZU-MA-KI",
	SandFist="SAND FIST",SandGrip="SAND GRIP",Flurry="LEAF FLURRY",GuardCrush="GUARD CRUSH",Lotus="LOTUS LEAP",
	AfterImage="AFTERIMAGE",Vacuum="VACUUM PALM",Rotation="ROTATION",Crows="CROWS",CrowScatter="CROW SCATTER",
	Rasengan="RASENGAN",FlyingThunder="FLYING THUNDER GOD",EarthSpike="DOTON • EARTH SPIKE",Headhunter="DOTON • HEADHUNTER"}
-- The HUD's chakra page: the five presses the chakra button infuses, in the
-- order of the jutsu row (pad □ △ × ○ R2, keyboard LMB RMB SPACE Q R).
ChakraMoves.Slots={"light","heavy","leap","dash","tool"}
local PLAIN={light="STRIKE",heavy="HEAVY",leap="LEAP",dash="DASH",tool="KUNAI"}
-- Infused lights that are no signature move but do a thing of their own
-- (Server/ChakraFlow.hit: Minato seals the body, Neji closes a point).
local OWN={Flashstep={light="SEAL STRIKE"},GentleFist={light="CHAKRA POINT"}}
function ChakraMoves.name(fighterId,slot)
	local sig=ChakraMoves.Signature[fighterId] and ChakraMoves.Signature[fighterId][slot]
	if sig then return ChakraMoves.SigLabel[sig] end
	local own=OWN[fighterId] and OWN[fighterId][slot]
	if own then return own end
	return ChakraMoves.Label[ChakraMoves.Nature[fighterId] or "Chakra"].." "..PLAIN[slot]
end
return ChakraMoves
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND11">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">-- Tunable V0 values; no client-supplied balance values are accepted.
return {
	Version = "0.13.0-arena-combo",
	ArenaRadius = 143, ArenaHeight = 76, WalkSpeed = 19, JumpPower = 68, Chakra = 100,
	ChakraRegen = 9, GuardDrain = 19, GuardChip = 0.12,
	GuardBreak = 0.65, HitStun = 0.22, InterruptStun = 0.42,
	-- A thrown object's flinch (Combat:damage): Stun on the first blade, then
	-- nothing for Window seconds (a volley is one flinch); a thrown object
	-- hitting for Heavy damage or more is a real blow and stuns as one.
	ProjectileStun = {Stun = 0.18, Window = 0.9, Heavy = 8},
	-- Walking into a standing body pushes it (Motor.step): the walker keeps
	-- Share of the inward speed.
	Push = {Share = 0.45},
	ComboReset = 1.05, MeleeRange = 7.6, MeleeFacing = 0.18,
	DodgeCost = 10, DodgeCooldown = 0.8, DodgeTime = 0.32, DodgeIFrames = 0.22,
	DodgeSpeed = 61, GuardSpeed = 8, ChannelSpeed = 7,
	ToolCost = 4, PursuitCost = 8, PursuitWindow = 0.85, PursuitRange = 46, PursuitSpeed = 74,
	-- (PursuitCost is the one re-engage price: the chase and the chakra dash.)
	-- Kawarimi: a limited escape that recharges. Usable while being hit (or
	-- grabbed, juggled, pinned), never as a neutral dodge. The attacker gets a
	-- short window to track the reappearance.
	-- Grace (05/11): a dodge this soon after the contact is the substitution even
	-- past the share of the stun where the body could step out (Combat:request).
	Substitution = {Cost = 15, Charges = 2, Recharge = 9, Cooldown = 1.1, Window = 0.42, Distance = 8, Track = 0.75, Grace = 0.35},
	-- Damage scaling inside one combo: the first hits land in full, every later
	-- hit is worth less, and a combo that runs too long ends in a knockdown.
	ComboScaling = {Free = 2, Step = 0.12, Floor = 0.35, Reset = 0.45, MaxHits = 11},
	-- (User 03/11: "les combats trop courts") Every blow's damage is scaled by
	-- this as it lands (Combat:damage, Combat:chip): the HP of the story stay,
	-- the rounds last longer (AI against AI: 42 s average at 1.0). The
	-- impact's look still reads the blow's own weight (unscaled).
	DamageScale = 0.6,
	Clash = {Window = 0.07, Push = 4.5, JutsuWindow = 0.35},
	-- Re-engage (CORE_COMBAT_CONVERGENCE_2 §3): one contextual action (E; on a pad
	-- × inside a chase window, sprint + ○ toward outside one). Inside a window it
	-- is the chase, outside it is this chakra dash at a locked opponent; both cost
	-- PursuitCost. The arrival converts at once into a strike, a heavy or a grab;
	-- guard, dodge or jump only after CancelAfter, so a predictable dash is
	-- punished. Unlocked, the dash is a straight Reposition-stud burst. Each
	-- prodigy re-enters his own way (MoveGraphs[...].reengage).
	-- Carry: the speed a dash keeps past its arrival (it stops where it arrives).
	Rush = {Cost = 8, Speed = 90, Range = 48, MinRange = 7, MaxTime = 0.55, Cooldown = 0.9, Arrive = 0.3, Recovery = 0.22, CancelAfter = 0.1, Reposition = 18, Carry = 8},
	-- Combo model (§1): strings count confirmed hits only. Grace: a press from
	-- neutral this long after a chain window still continues the string.
	-- Buffer: a press made during a committed swing waits this long past its
	-- active window. Intent: a push stronger than IntentStrong is remembered for
	-- IntentWindow seconds; toward is within acos(Toward) of the line to the
	-- opponent, away within acos(Away) of the line away from him, side between.
	Combo = {Grace = 0.18, Buffer = 0.3, IntentStrong = 0.45, IntentWindow = 0.22, Toward = 0.64, Away = 0.57},
	-- Late presses (audit 29/10: 7% of a player's presses were refused in the
	-- last 0.25 s of a recovery, a dodge or a stun, and nothing came out). A
	-- press refused because the body is busy is kept this long and fires on
	-- the first free frame: Late after the fighter's own commitment, LateHit
	-- at the end of a reaction (shorter: a reversal, not a free mash-out).
	Late = {Own = 0.2, Hit = 0.12},
	-- Awakening: once per match, at low health, a fighter-specific power-up.
	Awaken = {Threshold = 0.35, Duration = 12},
	-- Rhythm: a chained strike pressed on the beat (not mashed early) is a Flow strike.
	Flow = {Early = 0.07, Late = 0.13, Damage = 1.15, Stop = 0.035},
	ThrowBreak = 0.35,
	-- Ninja Embodiment (EMB-003): an ordinary blow takes control for a moment,
	-- not for the attacker's whole string. Past a share of its stun (never before
	-- Min seconds) a standing body may recover into its guard (guard stamina)
	-- or step out of it (chakra); a body thrown into the air may right itself
	-- past its apex (chakra, once per air time; an earned launcher holds longer);
	-- a knocked-down body landing may roll out (Tech). The substitution stays the
	-- escape from anywhere, earlier, for its own price. An air string drops the
	-- body after AirHits blows in one air time.
	Agency = {Stand = 0.45, Min = 0.12, Air = 0.35, AirHits = 4, Launched = 0.72, GuardCost = 10, StepCost = 6, AirCost = 8,
		Tech = 0.3, TechDistance = 4.5, AirLift = 16, AirPush = 10},
	-- Ninja Embodiment (EMB-004, Server/WorldReaction): the reactive arena.
	-- Budgets (server parts, replicated): MaxScars marks (oldest out, a mark
	-- close to one of its kind deepens it), MaxRubble pieces, MaxEmbeds blade
	-- facts. Energies: a body (studs/s x BodyEnergy), a projectile (damage x
	-- ProjectileEnergy), a strike that met the world (damage x StrikeEnergy),
	-- a zone (radius x ZoneEnergy); below MinEnergy nothing is marked.
	World = {MaxScars = 48, MaxRubble = 24, RubblePerBreak = 4, MaxEmbeds = 16, MinEnergy = 8,
		CrackedShare = 0.5, StumpHeight = 2.2, MoundShare = 0.38,
		BodySpeed = 14, LandingSpeed = 26, BodyEnergy = 1.4, ProjectileEnergy = 5, StrikeEnergy = 4, ZoneEnergy = 5,
		BodyRepeat = 0.35, SmashCarry = 0.6, HeavyKinds = {heavy = true, spike = true, launch = true},
		-- (User 28/10: "the arena must not become a minefield where nobody
		-- understands anything".) Weight: the floor only keeps what weighed
		-- something - a slam, a spike, a Great Fireball - not every landing;
		-- GroundEnergy for a contact mark, GroundElement for a scorch. The
		-- marks fade (Fade seconds, Major once the energy passed MajorEnergy
		-- or a mark was deepened three times; Out: the fade itself) and the
		-- floor holds at most MaxFloorScars at once (oldest first out).
		-- (06/11, user: « les traces au sol et les dégâts sur l'arène sont très
		-- légers ») Was 75 / 34 / 10 floor marks / 22 s and 60 s: the floor kept
		-- almost nothing. Now a heavy blow marks it, the marks stay for the
		-- round, and the blows that throw a body leave the ground torn where
		-- it stood (Blow) and its skid ploughed (Skid, its own budget).
		GroundEnergy = 40, GroundElement = 18, MajorEnergy = 90, MaxFloorScars = 18,
		Fade = {Minor = 40, Major = 90, Out = 1.6},
		Blow = {Speed = 30, Energy = 1.6}, Skid = {Speed = 9, Every = 0.13, Max = 14, Fade = 16}},
	-- Ninja Embodiment (Server/Perception): the space a body reads around a
	-- fight. Behind: how far past the target (or behind itself) a surface
	-- counts; Scan: how far around the target the nearest surface is looked
	-- for; Cache: seconds a read is reused; Refresh: seconds the arena's
	-- surface list is reused.
	-- (Continuity blocker) How fast a strike still turns to the opponent,
	-- degrees/s: in its startup, and once it is out (was 900 / 420); the
	-- lock's own turn in neutral, and while moving away or sprinting (was
	-- 760 / 540).
	Facing = {Startup = 480, Active = 160, Neutral = 520, Committed = 420},
	-- Free lens: a blow starting this close turns to the opponent at Rate (deg/s).
	-- (900: the startup's bounded turn, CombatFeel; standing near him the free
	-- body already faces him, Combat.updateActor)
	SoftLock = {Reach = 13, Rate = 900, Face = 12},
	-- (07/11, mission game feel: Studio audit, free lens, Minato and Sasuke
	-- landing blows while facing 45-86 deg away from the body they hit; between
	-- the blows of a string the body swung back to the lens) Engaged: within
	-- SoftLock.Face of the opponent, during an exchange (Hold s after one's
	-- own strike or reaction, or while the opponent winds up a blow), the free
	-- body keeps its chest on him instead of the lens. Turn: a soft-locked
	-- strike's turn finishes inside its startup (at most Turn deg/s).
	Engaged = {Hold = 0.8, Turn = 1800},
	-- (07/11, same audit) A blow lands on what is in front of it: the brawl
	-- contact cone is +-acos(Contact.Facing) around the striker's facing (was
	-- +-87 deg: a fist going forward knocked down a body beside it).
	Contact = {Facing = 0.5},
	-- (12/11, feel audit M2: bodies inside each other, contact down to 2 studs,
	-- a fighter standing in one lying on the floor) Two standing bodies are
	-- eased toward Gap studs apart (root to root) and never left closer than
	-- Floor (every strike's step-in stops at 2.4 studs or more). A body lying on
	-- the floor is LyingHalf studs long each way along its facing; a standing
	-- body is kept LyingGap studs from that line. Passing through (a dodge, a
	-- rush line), a hold and an ultimate are left alone.
	Bodies = {Gap = 3, Floor = 2.5, LyingHalf = 2.8, LyingGap = 2.0},
	-- (12/11) A travel (Combat:travelStart: a teleport jutsu, a signature
	-- dash) stays in the duel state Show s after its arrival: the arrival pose.
	Travel = {Show = 1.0},
	-- (DEC-032 §3) Hand seals: the weave stays open Open s for the first seal,
	-- then Gap s between seals.
	Seals = {Open = 1.4, Gap = 0.9},
	-- (DEC-032 §2) Free combos: at most Links free links in a combo (links
	-- less than Reset s apart).
	FreeCombo = {Links = 3, Reset = 1.6},
	-- (Continuity blocker) A chase heads for the point the body was going to
	-- and lets it drift at Steer studs/s; it turns at Turn degrees/s.
	Chase = {Steer = 60, Turn = 720},
	Perception = {Behind = 14, Scan = 48, Cache = 0.12, Refresh = 10},
	RoundsToWin = 2,
	-- (Final blow) The round's last hit throws the body: Speed / Lift (studs/s)
	-- for a heavy finish (a light one at Light of it), the first SlowFor
	-- seconds at SlowScale speed, back to full over Ease; Settle caps the flight.
	FinalBlow = {Speed = 38, Lift = 24, Light = 0.8, SlowFor = 0.45, SlowScale = 0.3, Ease = 0.35, Settle = 3},
	-- Where each fighter starts (studs from the centre): far enough apart that
	-- the round opens on an approach, not on a punch.
	StartDistance = 24,
	-- (QA 12/11) The intro's « BEGIN » shows over the last IntroBegin seconds
	-- (Client/UI) and the camera eases from the close-ups into the duel frame
	-- over the same seconds (Client/Camera): the player is in the frame at BEGIN.
	IntroBegin = 0.75,
	-- Server-side Animator playback (donor clips, default locomotion). Off: the
	-- client motion engine animates every body.
	DonorAnimations = false,
	Wall = {Detect = 3.4, Clearance = 1.7, RiseSpeed = 23, SideSpeed = 30, MaxTime = 1.65,
		ReboundUp = 61, ReboundAway = 29, ReattachDelay = 0.4,
		-- Wall combat: splat state, pins, tech window and the dive from a wall run.
		SplatSpeed = 17, SplatTime = 0.62, SplatDamage = 3, PinTime = 0.42, PinMax = 2,
		TechFrom = 0.05, TechUntil = 0.34, TechCost = 12, DiveRange = 50},
	RequestRate = 40, RequestBurst = 48, SnapshotInterval = 0.033,
	Movement = { SprintSpeed = 45, GroundAcceleration = 170, GroundDeceleration = 290, TurnAcceleration = 360, AirAcceleration = 76,
		BurstAcceleration = 520, BurstWindow = 0.16,
		-- Ninja jump at Gravity 140, gravity integrated once: ~12 studs apex and
		-- ~0.83 s of flight at scale 1 (JumpScale stretches it per fighter).
		-- HardLandVelocity sits above every fighter's own jump landing (~67 max),
		-- so only a real drop (~25 studs) lands heavy.
		JumpVelocity = 58, JumpCooldown = 0.4, AttackWalkSpeed = 14, HardLandVelocity = 84, FallbackGravity = 140,
		HardLandRecovery = 0.14, SoftLandRecovery = 0.04, HardLandSpeed = 14,
		MeleeTravelTime = 0.28, PursuitRecovery = 0.22 },
	-- Neutral rhythm (convergence §8): jutsu are paced (Gap + Jitter seconds
	-- between two, punishes excepted), a fast approach into melee range is read
	-- before the strike (guard / sidestep / counter-poke, no reaction latency:
	-- a guess), probing at range uses tools and step-in feints, and a fighter
	-- that just got hit backs off to neutral instead of mashing back.
	AI = { Tick = 0.18, Reaction = 0.38, Aggression = 0.72, Defense = 0.58, Technique = 0.34,
		TechniqueGap = 2.6, TechniqueJitter = 2.6, ReadGuard = 0.3, ReadDodge = 0.16, ReadPoke = 0.22, GuardRead = 0.07,
		Feint = 0.1, ProbeTool = 2.4, Disengage = 0.45, WallRun = 0.35,
		-- Ninja Embodiment: the bot answers an ordinary blow (Recover: once per
		-- reaction) and comes in with a plan that makes the situation the
		-- strike reads (EMB-002): out of a run, over the top, from the side of a
		-- committed body; or straight in.
		-- It also reads the space (Server/Perception): with a surface within
		-- Herd studs of the opponent it circles to put him between itself and
		-- it (HerdTime per try, HerdGap between tries), and it steps out of a
		-- corner when its own back is within Corner studs of one.
		Recover = 0.5, Plan = 0.65, Herd = 40, HerdTime = 1.6, HerdGap = 2.5, Corner = 4.5,
		-- Spacing at range it drifts to scenery within Terrain studs.
		Terrain = 50, TerrainPull = 0.9,
		-- (Rupture) An ordinary string is short: after one confirmed hit
		-- (BreakOff1) or two (BreakOff2) it breaks off and moves for
		-- RepositionTime (+ jitter) instead of trading the next string.
		BreakOff1 = 0.3, BreakOff2 = 0.55, RepositionTime = 0.9, RepositionJitter = 0.6 },
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND12">
        <Properties>
          <string name="Name">Controls</string>
          <ProtectedString name="Source">-- Semantic bindings shared by client, HUD and QA.
-- Keyboard is grouped around WASD so combat never needs a reach across the board;
-- PS5: the face buttons keep the existing layout; R1 modifies jutsu.
local Controls = {
	Keyboard = {
		-- Home row first: the actions used constantly sit under the left hand and
		-- the mouse, and substitution stays deliberately out of the way on X.
		Light = Enum.UserInputType.MouseButton1,
		Heavy = Enum.UserInputType.MouseButton2,
		Jump = Enum.KeyCode.Space,
		Dodge = Enum.KeyCode.Q,
		Guard = Enum.KeyCode.F,
		Grab = Enum.KeyCode.V,
		Tool = Enum.KeyCode.R,
		-- Chakra button (user 29/10): held, the press it is held with is infused
		-- (a strike, a jump, a dodge, the tool). Pad: L2.
		Chakra = Enum.KeyCode.Z,
		Pursuit = Enum.KeyCode.E,
		Substitute = Enum.KeyCode.X,
		Feint = Enum.KeyCode.G,
		WallDetach = Enum.KeyCode.C,
		Lock = Enum.KeyCode.LeftShift,
		Sprint = Enum.KeyCode.LeftControl,
		Technique5 = Enum.KeyCode.Five,
		Awaken = Enum.KeyCode.T,
		-- The ultimate (stage 6): its bar full, one blow opens the sequence. Pad R1 + L1.
		Ultimate = Enum.KeyCode.Y,
		-- Draw / sheathe a kunai (any fighter, DEC-030); R then throws it.
		Arm = Enum.KeyCode.B,
		-- (Audit 04/11) Escape is Roblox's own menu: the game never receives it.
		Skip = Enum.KeyCode.Backspace,
	},
	Gamepad = {
		Light = Enum.KeyCode.ButtonX,
		Heavy = Enum.KeyCode.ButtonY,
		Jump = Enum.KeyCode.ButtonA,
		Dodge = Enum.KeyCode.ButtonB,
		Guard = Enum.KeyCode.ButtonL1,
		Tool = Enum.KeyCode.ButtonR2,
		-- (User 29/10) The chakra button: held, the next press is infused
		-- (ChakraFlow). Grab moved to L1 + □ as in Storm (Input).
		Chakra = Enum.KeyCode.ButtonL2,
		Lock = Enum.KeyCode.ButtonR3,
		Sprint = Enum.KeyCode.ButtonL3,
		Modifier = Enum.KeyCode.ButtonR1,
		Technique5 = Enum.KeyCode.DPadUp,
		Awaken = Enum.KeyCode.DPadDown,
		Arm = Enum.KeyCode.DPadLeft,
		-- Re-engage on a pad is never a D-pad press (CORE_COMBAT_CONVERGENCE_2 §3):
		-- × chases inside a chase window (Input), and outside one a dodge (○)
		-- toward a locked opponent while sprinting (L3) is the chakra dash (the
		-- server reads the sprint and the stick: Brawler.dashIntent).
		Substitute = Enum.KeyCode.DPadRight,
		Skip = Enum.KeyCode.ButtonSelect,
	},
	-- Human-readable key names so HUD and tutorial copy cannot drift from bindings.
	KeyLabel = {
		Light = "LMB", Heavy = "RMB", Jump = "SPACE", Dodge = "Q", Guard = "F",
		-- (05/11) The escape is taught on the dodge key (Q while hit, Combat:request);
		-- X still does it.
		Grab = "V", Tool = "R", Chakra = "Z", Pursuit = "E", Substitute = "Q", Feint = "G",
		WallDetach = "C", Seals = "C + 1-4", Lock = "SHIFT", Sprint = "CTRL", Technique5 = "5", Awaken = "T", Ultimate = "Y", Arm = "B", Skip = "BACKSPACE", ChakraLoad = "Z + action",
	},
	-- HUD copy for the keyboard layout, kept next to the bindings it documents.
	Hint = "LMB light \u{00B7} RMB heavy",
	Help = "WASD move   SPACE jump   Q dodge (hit: escape)   LMB light   RMB heavy   F guard   V grab / throw break   E re-engage (chase / chakra dash)   R tool   hold Z + any action: chakra-infused (strike, heavy, jump, dodge, tool)   G feint   T awaken   Y ultimate (bar full)   B kunai (draw / sheathe, R throws it)   CTRL sprint   SHIFT lock   1-4 jutsu   hold C + 1-4 (Gaara 1-5): seal jutsu",
	-- The directional combo grammar, shared by every fighter.
	-- The string's routes on buttons (04/11, user: « le plus simple à faire et
	-- à jouer, sans perdre de mouvement »; Brawler.buttonRoute): no direction.
	Grammar = "CLEAN HITS  1 hit → RMB: heavy  |  2 hits → RMB: launch · Q: around · SPACE: rising · R: retreat  |  3 hits → RMB: low  |  air hit → RMB: spike · Q: switch · SPACE: drive",
	GrammarPad = "CLEAN HITS  1 hit → △: heavy  |  2 hits → △: launch · ○: around · ×: rising · R2: retreat  |  3 hits → △: low  |  air hit → △: spike · ○: switch · ×: drive",
	-- (05/11, user on the pad) One meaning per chord: R1 + L1 is the ultimate,
	-- the seal jutsu are L2 + R1 (chakra + jutsu), the escape is ○ while hit.
	HelpPad = "L move · L3 sprint   R camera · R3 lock   □ light   △ heavy   ○ dodge (hit: escape)   × jump / chase   sprint + ○ toward: chakra dash   L1 guard   L1 + □ grab   R2 tool   hold L2 + any action: chakra-infused   R1 + □/△/○/×: jutsu 1-4   hold L2 + R1 + □/△/○/× (Gaara: D-pad ↑ too): seal jutsu   R1 + L1 ultimate (bar full)   R1 + R2 feint   D-pad ← kunai · ↓ awaken · ↑ jutsu 5",
	PadLabel = {Light="□",Heavy="△",Dodge="○",Jump="×",Guard="L1",Modifier="R1",Grab="L1 + □",Tool="R2",Chakra="L2",Sprint="L3",Lock="R3",Pursuit="×",Dash="L3 + ○",Substitute="○",Arm="D-pad ←",Feint="R1 + R2",WallDetach="R1 + L1",Ultimate="R1 + L1",ChakraLoad="L2 + action",Seals="L2 + R1 + □△○×",
		Technique5="D-pad ↑",Awaken="D-pad ↓",Skip="TOUCHPAD"},
	-- (Stage 6) One order for everyone: □ pressure, △ signature, ○ movement
	-- or defence, × control or combo.
	TechniquePad = {"R1 + □","R1 + △","R1 + ○","R1 + ×","D-pad ↑"},
}

function Controls.comboHelp(graph,pad)
 local K,P=Controls.KeyLabel,Controls.PadLabel
 local heavy=if pad then P.Heavy else K.Heavy
 local dodge=if pad then P.Dodge else K.Dodge
 local jump=if pad then P.Jump else K.Jump
 local tool=if pad then P.Tool else K.Tool
 local routes=graph.routes or {}
 local parts={"CLEAN HITS"}
 if graph.heavyAfterOne then table.insert(parts,"1 hit → "..heavy..": heavy") end
 local two={heavy..": launch"}
 if routes.side then table.insert(two,dodge..": around") end
 if routes.up then table.insert(two,jump..": rising") end
 if graph.disengage then table.insert(two,tool..": retreat") end
 table.insert(parts,"2 hits → "..table.concat(two," · "))
 if routes.down then table.insert(parts,"3 hits → "..heavy..": low") end
 local air={}
 if routes.airDown then table.insert(air,heavy..": spike") end
 if routes.airSide then table.insert(air,dodge..": switch") end
 if routes.airUp then table.insert(air,jump..": drive") end
 if #air&gt;0 then table.insert(parts,"air hit → "..table.concat(air," · ")) end
 return table.concat(parts,"  ·  ")
end

-- (Studio audit 03/11, a French Mac: bug B01) Roblox reads letter keys by
-- their place on the keyboard (KeyCode.W is the key left of E), so on an
-- AZERTY keyboard the dodge (KeyCode.Q) is the key labelled A and the
-- chakra (KeyCode.Z) the one labelled W, while the help, the HUD and the
-- tutorial said "Q dodge", "hold Z": the player pressed Q and moved left.
-- The client reads its own labels (UserInputService:GetStringForKeyCode)
-- and every text naming a key is shown with them.
local LETTERS={"W","A","S","D","Q","Z","E","F","V","R","X","G","T","Y","B","C"}
function Controls.localize(text,map)
	map=map or Controls.layout
	if not map or type(text)~="string" then return text end
	text=text:gsub("%f[%w]WASD%f[%W]",function() return (map.W or "W")..(map.A or "A")..(map.S or "S")..(map.D or "D") end)
	-- "A" alone is the article ("RASENGAN • A CLONE FOR IT"): no text names
	-- the left key by itself, only inside WASD.
	return (text:gsub("%f[%w](%u)%f[%W]",function(c) return if c=="A" then c else map[c] or c end))
end
-- stringFor(KeyCode) -&gt; the label on this keyboard. Returns true when the
-- layout differs from the one the texts are written for (QWERTY).
function Controls.useLayout(stringFor)
	local map,changed={},false
	for _,k in LETTERS do
		local ok,label=pcall(stringFor,Enum.KeyCode[k])
		if ok and type(label)=="string" and #label==1 then
			map[k]=string.upper(label)
			if map[k]~=k then changed=true end
		end
	end
	if not changed then return false end
	Controls.layout=map
	for action,label in Controls.KeyLabel do Controls.KeyLabel[action]=Controls.localize(label,map) end
	Controls.Help=Controls.localize(Controls.Help,map)
	Controls.Grammar=Controls.localize(Controls.Grammar,map)
	return true
end
function Controls.isGamepad(kind)
 return kind~=nil and kind.Name:match("^Gamepad")~=nil
end
return Controls
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND13">
        <Properties>
          <string name="Name">DevMetrics</string>
          <ProtectedString name="Source">-- Bounded, opt-in measurements for the Studio dev tools (Codex 33028b2, ported).
-- No instances, remotes or gameplay policy. Debug/QA places only: build.py
-- lists this module in DEBUG_SOURCES, so the normal build never contains it.
local MAX_LABELS=128
local Metrics={};Metrics.__index=Metrics
function Metrics.new(clock)
	return setmetatable({clock=clock or os.clock,enabled=false,stats={},counters={},events={},restores={},started=0,labels=0},Metrics)
end
function Metrics:start()
	self.stats={};self.counters={};self.events={};self.labels=0;self.started=self.clock();self.ended=nil;self.enabled=true
end
function Metrics:sample(name,value)
	if not self.enabled or type(value)~="number" or value~=value or math.abs(value)==math.huge then return end
	local s=self.stats[name]
	if not s then
		if self.labels&gt;=MAX_LABELS then return end
		self.labels+=1
		s={n=0,sum=0,max=0,values={},next=1};self.stats[name]=s
	end
	s.n+=1;s.sum+=value;s.max=math.max(s.max,value)
	s.values[s.next]=value;s.next=s.next%240+1
end
function Metrics:count(name,n)
	if not self.enabled then return end
	if self.counters[name]==nil then if self.labels&gt;=MAX_LABELS then name="overflow" else self.labels+=1 end end
	self.counters[name]=(self.counters[name] or 0)+(n or 1)
end
function Metrics:event(kind,context)
	if not self.enabled then return end
	table.insert(self.events,{at=self.clock()-self.started,kind=kind,context=context})
	if #self.events&gt;80 then table.remove(self.events,1) end
end
-- Wraps object[key] at instance level. The original keeps its arguments,
-- results (nil included) and errors; stop() puts back exactly what was there.
function Metrics:wrap(object,key,label,after,before)
	local original=object[key];local own=rawget(object,key)
	assert(type(original)=="function","No method "..key)
	local wrapper=function(...)
		if not self.enabled then return original(...) end
		if before then before(...) end
		local at=self.clock()
		if debug.profilebegin then debug.profilebegin("NinjaDuel/"..label) end
		local result=table.pack(pcall(original,...))
		if debug.profileend then debug.profileend() end
		self:sample(label..".ms",(self.clock()-at)*1000);self:count(label..".calls")
		if not result[1] then self:event("script-error",{scope=label,error=tostring(result[2])});error(result[2],0) end
		if after then after(...) end
		return table.unpack(result,2,result.n)
	end
	object[key]=wrapper
	self:addRestore(object,function() if rawget(object,key)==wrapper then object[key]=own end end)
end
function Metrics:addRestore(object,fn) table.insert(self.restores,{object=object,fn=fn}) end
function Metrics:restoreObject(object)
	for i=#self.restores,1,-1 do
		local entry=self.restores[i]
		if entry.object==object then entry.fn();table.remove(self.restores,i) end
	end
end
function Metrics:stop()
	if self.enabled then self.ended=self.clock() end
	self.enabled=false
	for i=#self.restores,1,-1 do self.restores[i].fn() end
	self.restores={}
end
-- Mean/max cover the whole capture; p50/p95 the last 240 samples of a label.
function Metrics:report()
	local out={seconds=math.max(0,(self.ended or self.clock())-self.started),enabled=self.enabled,stats={},counters=table.clone(self.counters),events=table.clone(self.events)}
	for name,s in self.stats do
		local sorted=table.clone(s.values);table.sort(sorted)
		out.stats[name]={count=s.n,mean=s.sum/s.n,max=s.max,p50=sorted[math.max(1,math.ceil(#sorted*.5))],p95=sorted[math.max(1,math.ceil(#sorted*.95))],window=#sorted}
	end
	return out
end
-- An estimate of application payload size, NOT wire bytes or Roblox bandwidth.
function Metrics.estimate(value,depth,budget)
	depth=depth or 0;budget=budget or {left=2048}
	if depth&gt;8 or budget.left&lt;=0 then return 0 end
	budget.left-=1
	local kind=typeof(value)
	if kind=="number" then return 8 elseif kind=="boolean" then return 1 elseif kind=="Vector3" then return 12
	elseif kind=="CFrame" then return 48 elseif kind=="string" then return #value+2 elseif kind=="table" then
		local size=2
		for k,v in value do
			size+=Metrics.estimate(k,depth+1,budget)+Metrics.estimate(v,depth+1,budget)
			if budget.left&lt;=0 then break end
		end
		return size
	end
	return 0
end
-- Telemetry stays small even for malformed clients in multi-client Studio
-- tests: finite numbers, booleans, strings up to 512 characters, string or
-- number keys, depth 8 and `budget` visited values (default 2048).
function Metrics.validPayload(value,budget)
	budget=budget or 2048
	local function visit(v,depth)
		budget-=1;if budget&lt;0 or depth&gt;8 then return false end
		local t=type(v)
		if t=="number" then return v==v and math.abs(v)&lt;math.huge
		elseif t=="boolean" then return true
		elseif t=="string" then return #v&lt;=512
		elseif t=="table" then
			for k,item in v do
				if (type(k)~="string" and type(k)~="number") or not visit(k,depth+1) or not visit(item,depth+1) then return false end
			end
			return true
		end
		return false
	end
	return visit(value,0)
end
return Metrics
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND14">
        <Properties>
          <string name="Name">Face</string>
          <ProtectedString name="Source">-- Cartoon faces drawn in 2D on the head (user 29/10 14:07: "il manque une
-- expression faciale énorme"). Each eye and the mouth is a SurfaceGui on its
-- own invisible plate laid tangent to the round head, so the drawing hugs the
-- curve. The server builds the face (Face.build); the client drives it
-- (Face.set with an expression name, Face.blink, Face.tint for the
-- Sharingan / fox eyes). Nothing here touches gameplay.
local Face={}

-- The head the looks are built on (Server/Looks.form): the classic rounded
-- Head mesh, upright and round in plan, 0.9 in radius, straight-sided from
-- STRAIGHT below to STRAIGHT above the centre, rounding off beyond.
Face.Head=Vector3.new(.9,.93,.9)
Face.Radius=Face.Head.X
local STRAIGHT=.5
local PPS=320

local function new(class,props,parent)
	local i=Instance.new(class)
	for k,v in props do (i::any)[k]=v end
	if parent then i.Parent=parent end
	return i
end
local function round(parent,radius)
	return new("UICorner",{CornerRadius=UDim.new(radius or .5,0)},parent)
end

-- A plate tangent to the head at `angle` (degrees, + toward the fighter's
-- right) and height `y` (head space), facing out.
-- The squarer head of the Blender looks (tools/blender/nd_look.HEAD_PROFILE,
-- same numbers): (y, half-width, half-depth, squareness).
Face.BoxProfile={{-.95,.55,.56,2.6},{-.82,.74,.74,2.8},{-.55,.86,.83,3.2},{-.2,.9,.86,3.4},
	{.25,.9,.86,3.4},{.6,.86,.83,3.2},{.84,.72,.72,2.8},{.95,.45,.46,2.4}}
local SHAPE="can"
function Face.useShape(shape) SHAPE=shape or "can" end
function Face.boxSection(y)
	local P=Face.BoxProfile
	if y&lt;=P[1][1] then return P[1][2],P[1][3],P[1][4] end
	for i=1,#P-1 do
		local a,b=P[i],P[i+1]
		if y&lt;=b[1] then
			local t=(y-a[1])/(b[1]-a[1])
			return a[2]+(b[2]-a[2])*t,a[3]+(b[3]-a[3])*t,a[4]+(b[4]-a[4])*t
		end
	end
	local l=P[#P];return l[2],l[3],l[4]
end
local function onBox(angle,y,out)
	local hx,hz,n=Face.boxSection(y)
	local x=math.sin(math.rad(angle))*hx
	local t=math.min(.999,math.abs(x)/hx)
	local z=-hz*(1-t^n)^(1/n)
	local gx=math.sign(x)*t^(n-1)/hx
	local gz=-((math.abs(z)/hz)^(n-1))/hz
	local _,hz2=Face.boxSection(y+.02)
	local _,hz1=Face.boxSection(y-.02)
	local dbdy=(hz2-hz1)/.04
	local nrm=Vector3.new(gx,-dbdy*math.abs(gz),gz).Unit
	local p=Vector3.new(x,y,z)+nrm*(out or .006)
	return CFrame.lookAt(p,p+nrm)
end
function Face.onHead(angle,y,out)
	if SHAPE=="box" then return onBox(angle,y,out) end
	local h=Face.Head
	local a=math.rad(angle)
	local over=math.max(0,math.abs(y)-STRAIGHT)/(h.Y-STRAIGHT)
	local k=math.sqrt(math.max(0,1-over*over))
	local p=Vector3.new(h.X*k*math.sin(a),y,-h.Z*k*math.cos(a))
	local tilt=math.sign(y)*over
	local n=(Vector3.new(math.sin(a)*k,0,-math.cos(a)*k)+Vector3.new(0,tilt,0)).Unit
	p+=n*(out or .006)
	return CFrame.lookAt(p,p+n)
end
-- The angle (degrees) at which the head's surface is `x` studs off centre at
-- height `y`.
function Face.angleAt(x,y)
	if SHAPE=="box" then
		local hx=Face.boxSection(y)
		return math.deg(math.asin(math.clamp(x/hx,-1,1)))
	end
	local h=Face.Head
	local over=math.max(0,math.abs(y)-STRAIGHT)/(h.Y-STRAIGHT)
	local k=math.sqrt(math.max(.05,1-over*over))
	return math.deg(math.asin(math.clamp(x/(h.X*k),-1,1)))
end

local function plate(model,name,size,cf)
	local head=model:FindFirstChild("Head")
	if not head then return nil,nil end
	local p=new("Part",{Name=name,Size=Vector3.new(size.X,size.Y,.02),Transparency=1,CanCollide=false,CanQuery=false,CanTouch=false,
		Massless=true,Anchored=false,CastShadow=false,CFrame=head.CFrame*cf})
	new("WeldConstraint",{Part0=head,Part1=p},p)
	p.Parent=model
	local gui=new("SurfaceGui",{Name="Drawing",Face=Enum.NormalId.Front,SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud,PixelsPerStud=PPS,
		LightInfluence=.55,Brightness=1.15,ZOffset=1,ClipsDescendants=false,ResetOnSpawn=false},p)
	return p,gui
end

-- Positions and sizes in studs on a plate of size `w` x `h`, origin at its
-- centre, y down.
local function at(w,h,x,y) return UDim2.fromScale(.5+x/w,.5+y/h) end
local function sz(w,h,x,y) return UDim2.fromScale(x/w,y/h) end

local EW,EH=.62,.82 -- eye plate
local MW,MH=.7,.42 -- mouth plate

-- spec fields (all optional): iris, irisDark, pupil (false = none), style
-- ("normal" | "round" | "pale" | "ringed"), sclera (Vector2 studs), eyeX,
-- eyeY, brow (Color3, false = none), browThick, lash, skin, mood (the idle
-- expression), mouth (false = hidden), cheeks ("whiskers"), lids (0-1 resting
-- droop).
function Face.build(model,spec)
	spec=spec or {}
	-- Headless tests have no UI classes: the face is cosmetic, skip it.
	if UDim==nil or UDim2==nil or ColorSequence==nil or Vector2==nil then model:SetAttribute("FaceMood",spec.mood or "calm");return nil end
	local eyes=model:FindFirstChild("Eyes");if eyes then eyes.Transparency=1 end
	local lash=spec.lash or Color3.fromRGB(28,24,30)
	local sclera=spec.sclera or Vector2.new(.34,.3)
	local face={spec=spec,eyes={},model=model}
	local ex=spec.eyeX or .32
	local ey=spec.eyeY or -.06
	local eyeAngle=Face.angleAt(ex,ey)
	for _,s in {-1,1} do
		local part,gui=plate(model,"FaceEye",Vector2.new(EW,EH),Face.onHead(s*eyeAngle,ey))
		if not gui then continue end
		local e={side=s,part=part,gui=gui}
		-- The white: clipped so the lids and the look can cut the iris.
		e.white=new("CanvasGroup",{Name="White",AnchorPoint=Vector2.new(.5,.5),Position=at(EW,EH,0,0),Size=sz(EW,EH,sclera.X,sclera.Y),
			BackgroundColor3=Color3.fromRGB(250,250,246),BorderSizePixel=0},gui)
		round(e.white,.5)
		local iw=sclera.X*(if spec.style=="round" then .5 else .56)
		local ih=sclera.Y*(if spec.style=="round" then .62 else .8)
		e.iris=new("Frame",{Name="Iris",AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.56),Size=UDim2.fromScale(iw/sclera.X,ih/sclera.Y),
			BackgroundColor3=spec.iris or Color3.fromRGB(70,110,200),BorderSizePixel=0},e.white)
		round(e.iris,.5)
		e.gradient=new("UIGradient",{Rotation=90,Color=ColorSequence.new(spec.irisDark or (spec.iris or Color3.fromRGB(70,110,200)):Lerp(Color3.new(),.45),spec.iris or Color3.fromRGB(70,110,200))},e.iris)
		if spec.style=="ringed" then new("UIStroke",{Thickness=3,Color=(spec.iris or Color3.new()):Lerp(Color3.new(),.5)},e.iris) end
		if spec.pupil~=false then
			e.pupil=new("Frame",{Name="Pupil",AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.52),Size=UDim2.fromScale(.42,.42),
				BackgroundColor3=Color3.fromRGB(16,14,20),BorderSizePixel=0},e.iris)
			round(e.pupil,.5)
		end
		-- Sharingan commas, shown by Face.tint(..., "sharingan").
		e.tomoe={}
		for k=0,2 do
			local a=math.rad(k*120-90)
			local t=new("Frame",{Name="Tomoe",AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5+.3*math.cos(a),.52+.3*math.sin(a)),Size=UDim2.fromScale(.2,.2),
				BackgroundColor3=Color3.fromRGB(16,10,12),BorderSizePixel=0,Visible=spec.sharingan==true},e.iris)
			round(t,.5)
			table.insert(e.tomoe,t)
		end
		e.shine=new("Frame",{Name="Shine",AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.34,.3),Size=UDim2.fromScale(.32,.26),
			BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0},e.iris)
		round(e.shine,.5)
		e.shine2=new("Frame",{Name="Shine",AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.66,.74),Size=UDim2.fromScale(.14,.12),
			BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,BackgroundTransparency=.2},e.iris)
		round(e.shine2,.5)
		if spec.style=="pale" then
			e.iris.BackgroundColor3=spec.iris or Color3.fromRGB(226,222,240)
			e.gradient.Color=ColorSequence.new(Color3.fromRGB(200,196,224),spec.iris or Color3.fromRGB(236,232,248))
			e.shine.Visible=false;e.shine2.Visible=false
		end
		-- The dark ring Gaara never sleeps off.
		if spec.ring then
			e.ring=new("Frame",{Name="Ring",AnchorPoint=Vector2.new(.5,.5),Position=at(EW,EH,0,0),Size=sz(EW,EH,sclera.X+.08,sclera.Y+.09),BackgroundTransparency=1,ZIndex=0},gui)
			round(e.ring,.5)
			new("UIStroke",{Thickness=12,Color=spec.ring,Transparency=.05},e.ring)
		end
		-- The upper lash line and its flick at the outer corner.
		e.lash=new("Frame",{Name="Lash",AnchorPoint=Vector2.new(.5,.5),Size=sz(EW,EH,sclera.X*1.06,spec.lashThick or .05),BackgroundColor3=lash,BorderSizePixel=0,ZIndex=3},gui)
		round(e.lash,.5)
		e.flick=new("Frame",{Name="Flick",AnchorPoint=Vector2.new(.5,.5),Size=sz(EW,EH,.09,.04),BackgroundColor3=lash,BorderSizePixel=0,ZIndex=3},gui)
		round(e.flick,.5)
		-- The upper lid: skin over the top of the white, lowered to narrow the
		-- eye. It lives inside the white so it is clipped to its round shape.
		e.lid=new("Frame",{Name="Lid",AnchorPoint=Vector2.new(.5,1),Position=UDim2.fromScale(.5,0),Size=UDim2.fromScale(1.3,1),
			Visible=false,BackgroundColor3=spec.skin or Color3.fromRGB(246,214,186),BorderSizePixel=0,ZIndex=2},e.white)
		-- Closed-eye strokes: a curve (blink, KO), a ^ (happy), a &gt; (hurt).
		e.closed={}
		for k=1,2 do
			local c=new("Frame",{Name="Closed",AnchorPoint=Vector2.new(.5,.5),Size=sz(EW,EH,sclera.X*.62,.05),BackgroundColor3=lash,BorderSizePixel=0,Visible=false,ZIndex=3},gui)
			round(c,.5)
			e.closed[k]=c
		end
		if spec.brow~=false then
			e.brow=new("Frame",{Name="Brow",AnchorPoint=Vector2.new(.5,.5),Size=sz(EW,EH,sclera.X*(spec.browWide or 1.05),spec.browThick or .055),
				BackgroundColor3=spec.brow or lash,BorderSizePixel=0,ZIndex=4},gui)
			round(e.brow,.5)
		end
		-- Whisker marks on the cheek, below and outside the eye.
		if spec.cheeks=="whiskers" then
			for k=0,2 do
				local w=new("Frame",{Name="Whisker",AnchorPoint=Vector2.new(.5,.5),Position=at(EW,EH,s*-.06,.24+k*.07),Size=sz(EW,EH,.26,.022),
					Rotation=s*-(8-k*8),BackgroundColor3=Color3.fromRGB(96,62,48),BorderSizePixel=0},gui)
				round(w,.5)
			end
		end
		table.insert(face.eyes,e)
	end
	if spec.mouth~=false then
		local part,gui=plate(model,"FaceMouth",Vector2.new(MW,MH),Face.onHead(0,spec.mouthY or -.42))
		if gui then
			local m={part=part,gui=gui}
			local lip=spec.lip or Color3.fromRGB(110,56,52)
			-- A short line (calm), its curved version (smile), an open mouth
			-- with a tongue (shout, hurt), teeth (grin, grit).
			m.line=new("Frame",{Name="Line",AnchorPoint=Vector2.new(.5,.5),Position=at(MW,MH,0,0),Size=sz(MW,MH,.16,.028),BackgroundColor3=lip,BorderSizePixel=0},gui)
			round(m.line,.5)
			m.curveBox=new("Frame",{Name="Curve",AnchorPoint=Vector2.new(.5,0),Position=at(MW,MH,0,-.01),Size=sz(MW,MH,.3,.12),BackgroundTransparency=1,ClipsDescendants=true},gui)
			m.curve=new("Frame",{Name="Arc",AnchorPoint=Vector2.new(.5,1),Position=UDim2.fromScale(.5,1),Size=UDim2.fromScale(.8,1.9),BackgroundTransparency=1},m.curveBox)
			round(m.curve,.5)
			m.curveStroke=new("UIStroke",{Thickness=8,Color=lip},m.curve)
			m.open=new("CanvasGroup",{Name="Open",AnchorPoint=Vector2.new(.5,.5),Position=at(MW,MH,0,.03),Size=sz(MW,MH,.22,.16),BackgroundColor3=Color3.fromRGB(86,26,32),BorderSizePixel=0},gui)
			round(m.open,.5)
			m.tongue=new("Frame",{Name="Tongue",AnchorPoint=Vector2.new(.5,0),Position=UDim2.fromScale(.5,.6),Size=UDim2.fromScale(.7,.6),BackgroundColor3=Color3.fromRGB(226,104,110),BorderSizePixel=0},m.open)
			round(m.tongue,.5)
			m.upper=new("Frame",{Name="Teeth",AnchorPoint=Vector2.new(.5,0),Position=UDim2.fromScale(.5,0),Size=UDim2.fromScale(1,.26),BackgroundColor3=Color3.fromRGB(250,248,242),BorderSizePixel=0},m.open)
			m.teeth=new("Frame",{Name="Grit",AnchorPoint=Vector2.new(.5,.5),Position=at(MW,MH,0,.02),Size=sz(MW,MH,.24,.085),BackgroundColor3=Color3.fromRGB(250,248,242),BorderSizePixel=0},gui)
			round(m.teeth,.35)
			new("UIStroke",{Thickness=5,Color=lip},m.teeth)
			new("Frame",{Name="Gap",AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.new(1,-4,0,3),BackgroundColor3=lip:Lerp(Color3.new(1,1,1),.35),BorderSizePixel=0},m.teeth)
			face.mouth=m
		end
	end
	model:SetAttribute("FaceMood",spec.mood or "calm")
	model:SetAttribute("FaceLids",spec.lids or 0)
	Face.set(face,spec.mood or "calm")
	return face
end

-- Expressions: eye shape, brow, mouth.
--   eye  open | narrow | wide | closed | happy | squeeze | ko
--   brow calm | angry | worry | up | flat
--   mouth line | smile | smirk | grin | open | shout | grit | o | frown
Face.Moods={
	calm={eye="open",brow="calm",mouth="line"},
	cool={eye="narrow",brow="flat",mouth="line"},
	lazy={eye="lazy",brow="flat",mouth="line"},
	cheer={eye="open",brow="up",mouth="grin"},
	gentle={eye="open",brow="calm",mouth="smile"},
	smirk={eye="narrow",brow="flat",mouth="smirk"},
	stare={eye="narrow",brow="flat",mouth="line"},
	fierce={eye="open",brow="angry",mouth="grit"},
	fight={eye="narrow",brow="angry",mouth="grit"},
	focus={eye="narrow",brow="angry",mouth="line"},
	shout={eye="narrow",brow="angry",mouth="shout"},
	hurt={eye="squeeze",brow="worry",mouth="open"},
	stun={eye="wide",brow="worry",mouth="o"},
	ko={eye="ko",brow="worry",mouth="o"},
	win={eye="happy",brow="up",mouth="grin"},
}
local function look(face) return face end

function Face.find(model)
	local face={model=model,eyes={},spec={}}
	for _,p in model:GetChildren() do
		if p.Name=="FaceEye" then
			local gui=p:FindFirstChild("Drawing")
			if gui then
				local white=gui:FindFirstChild("White")
				local iris=white and white:FindFirstChild("Iris")
				local e={part=p,gui=gui,white=white,iris=iris,pupil=iris and iris:FindFirstChild("Pupil"),lid=white and white:FindFirstChild("Lid"),
					lash=gui:FindFirstChild("Lash"),flick=gui:FindFirstChild("Flick"),brow=gui:FindFirstChild("Brow"),ring=gui:FindFirstChild("Ring"),
					gradient=iris and iris:FindFirstChildOfClass("UIGradient"),closed={},tomoe={}}
				for _,c in gui:GetChildren() do if c.Name=="Closed" then table.insert(e.closed,c) end end
				if iris then for _,t in iris:GetChildren() do if t.Name=="Tomoe" then table.insert(e.tomoe,t) end end end
				e.side=if (model:FindFirstChild("Head") and (model.Head.CFrame:PointToObjectSpace(p.Position).X&gt;0)) then 1 else -1
				table.insert(face.eyes,e)
			end
		elseif p.Name=="FaceMouth" then
			local gui=p:FindFirstChild("Drawing")
			if gui then
				local curveBox=gui:FindFirstChild("Curve")
				local open=gui:FindFirstChild("Open")
				face.mouth={part=p,gui=gui,line=gui:FindFirstChild("Line"),curveBox=curveBox,curve=curveBox and curveBox:FindFirstChild("Arc"),
					open=open,tongue=open and open:FindFirstChild("Tongue"),upper=open and open:FindFirstChild("Teeth"),teeth=gui:FindFirstChild("Grit")}
			end
		end
	end
	if #face.eyes==0 then return nil end
	return face
end

-- A frame's resting box, kept as attributes so a client that finds the face
-- (Face.find) reads the built size, not the narrowed one the server set.
local function restOf(obj)
	local size,pos=obj:GetAttribute("RestSize"),obj:GetAttribute("RestPos")
	if not size then
		size,pos=obj.Size,obj.Position
		obj:SetAttribute("RestSize",size);obj:SetAttribute("RestPos",pos)
	end
	return {size=size,pos=pos}
end
local function coverOf(eye,droop)
	return if eye=="narrow" then .3 elseif eye=="lazy" then .5 elseif eye=="wide" then 0 else droop
end
local function eyeShape(e,eye,brow,droop,browEye)
	local s=e.side
	local white=e.white
	if not white then return end
	-- The white's resting box, read back from its build size.
	e.base=e.base or restOf(white)
	local bx,by=e.base.size.X.Scale,e.base.size.Y.Scale
	local px,py=e.base.pos.X.Scale,e.base.pos.Y.Scale
	local open=eye=="open" or eye=="narrow" or eye=="wide" or eye=="lazy"
	white.Visible=open
	if e.ring then e.ring.Visible=true end
	-- Lid: how much of the white it covers (0 open .. 1 shut), and its slant.
	local cover=coverOf(eye,droop)
	local tilt=if brow=="angry" then 14 elseif brow=="worry" then -10 elseif brow=="flat" then 7 else 0
	local height=if eye=="wide" then by*1.12 else by
	-- A narrowed eye is a shorter white whose top edge comes down to the lash
	-- line (user 29/10 15:58: the skin-coloured lid drawn over the white is
	-- not clipped on a 3D face and showed as a pale box above the eye).
	local shown=height*(1-cover)
	white.Size=UDim2.fromScale(bx*(if eye=="wide" then 1.06 else 1),shown)
	white.Position=UDim2.fromScale(px,py+height*cover/2)
	if e.lid then e.lid.Visible=false end
	if e.ring then
		e.ringBase=e.ringBase or restOf(e.ring).size
		e.ring.Size=UDim2.fromScale(e.ringBase.X.Scale,e.ringBase.Y.Scale-height+shown)
		e.ring.Position=white.Position
	end
	if e.iris then
		e.irisBase=e.irisBase or restOf(e.iris)
		local ib=e.irisBase
		-- The iris keeps its size and place on the face; the shortened white
		-- trims its top (it slides down to sit inside).
		local ih=ib.size.Y.Scale*height
		local cy=py-height/2+ib.pos.Y.Scale*height
		local top=py-height/2+height*cover
		local h=math.min(ih,shown*.96)
		cy=math.max(cy,top+h/2)
		e.iris.Size=UDim2.fromScale(ib.size.X.Scale,h/math.max(shown,1e-3))
		e.iris.Position=UDim2.fromScale(.5,(cy-top)/math.max(shown,1e-3))
		-- (Audit 04/11) a fox tint keeps its slit through blinks and moods.
		if e.pupil then e.pupil.Size=if e.tintKind=="fox" then UDim2.fromScale(.16,.62) elseif eye=="wide" then UDim2.fromScale(.26,.26) else UDim2.fromScale(.42,math.min(.9,.42*ih/h)) end
	end
	-- Lash line rides the lid edge.
	local top=py-height/2+height*cover
	if e.lash then
		e.lash.Visible=open
		e.lash.Position=UDim2.fromScale(px,top+.008)
		e.lash.Rotation=s*tilt
		e.flick.Visible=open
		e.flick.Position=UDim2.fromScale(px-s*bx*.52,top+.02)
		e.flick.Rotation=s*-24
	end
	-- Closed strokes.
	local c1,c2=e.closed[1],e.closed[2]
	if c1 and c2 then
		c1.Visible=not open;c2.Visible=false
		local w=bx*.62
		if eye=="closed" or eye=="ko" then
			c1.Position=UDim2.fromScale(px,py+.03);c1.Rotation=0;c1.Size=UDim2.fromScale(w*1.2,c1.Size.Y.Scale)
		elseif eye=="happy" then
			-- ^ : two strokes meeting above the eye's centre.
			c2.Visible=true
			c1.Size=UDim2.fromScale(w*.62,c1.Size.Y.Scale);c2.Size=c1.Size
			c1.Position=UDim2.fromScale(px-bx*.17,py+.02);c1.Rotation=-34
			c2.Position=UDim2.fromScale(px+bx*.17,py+.02);c2.Rotation=34
		elseif eye=="squeeze" then
			-- &gt; &lt; : the point toward the nose.
			c2.Visible=true
			c1.Size=UDim2.fromScale(w*.66,c1.Size.Y.Scale);c2.Size=c1.Size
			c1.Position=UDim2.fromScale(px-s*bx*.02,py-.018);c1.Rotation=s*-26
			c2.Position=UDim2.fromScale(px-s*bx*.02,py+.05);c2.Rotation=s*26
		end
	end
	if e.brow then
		local up=if brow=="up" then -.045 elseif brow=="worry" then -.03 elseif brow=="angry" then .035 elseif brow=="flat" then .015 else .012
		local angle=if brow=="angry" then 20 elseif brow=="worry" then -16 elseif brow=="up" then -4 elseif brow=="flat" then 7 else -3
		-- The brow sits just above the lid edge (user 29/10: no gap between
		-- brows and narrowed eyes); a blink keeps it where the mood put it.
		local lidTop=py-height/2+height*coverOf(browEye or eye,droop)
		e.brow.Position=UDim2.fromScale(px+s*.012,lidTop-.1/EH+up)
		e.brow.Rotation=s*angle
	end
end

local function mouthShape(m,mouth)
	if not m or not m.line then return end
	m.line.Visible=mouth=="line" or mouth=="frown"
	m.line.Rotation=0
	m.curveBox.Visible=mouth=="smile" or mouth=="smirk"
	m.curve.Rotation=0
	if mouth=="smirk" then m.curveBox.Rotation=-10;m.curveBox.Size=sz(MW,MH,.22,.1) else m.curveBox.Rotation=0;m.curveBox.Size=sz(MW,MH,.3,.12) end
	local open=mouth=="open" or mouth=="shout" or mouth=="o" or mouth=="grin"
	m.open.Visible=open
	if mouth=="shout" then m.open.Size=sz(MW,MH,.26,.22)
	elseif mouth=="grin" then m.open.Size=sz(MW,MH,.34,.15)
	elseif mouth=="o" then m.open.Size=sz(MW,MH,.1,.11)
	else m.open.Size=sz(MW,MH,.24,.13) end
	if m.upper then m.upper.Visible=mouth=="grin" or mouth=="shout";m.upper.Size=UDim2.fromScale(1,if mouth=="grin" then .42 else .26) end
	if m.tongue then m.tongue.Visible=mouth~="o" end
	m.teeth.Visible=mouth=="grit"
end

-- Apply an expression by name (Face.Moods) to a face from Face.build or
-- Face.find. Returns the face.
function Face.set(face,name,blink)
	if not face then return end
	local mood=Face.Moods[name] or Face.Moods.calm
	local eye=mood.eye
	if blink and (eye=="open" or eye=="narrow" or eye=="lazy" or eye=="wide") then eye="closed" end
	local droop=(face.spec and face.spec.lids) or 0
	if face.model then droop=face.model:GetAttribute("FaceLids") or droop end
	for _,e in face.eyes do eyeShape(e,eye,mood.brow,droop,mood.eye) end
	mouthShape(face.mouth,mood.mouth)
	face.current=name;face.blinking=blink
	return face
end

-- Iris colour override (nil restores): "sharingan" shows the commas. `only`
-- (-1 his left, 1 his right) tints one eye: Kakashi's single Sharingan.
function Face.tint(face,color,kind,only)
	if not face then return end
	for _,e in face.eyes do
		if not e.iris then continue end
		if color and only and e.side~=only then continue end
		e.restore=e.restore or {color=e.iris.BackgroundColor3,gradient=e.gradient and e.gradient.Color}
		if color then
			e.iris.BackgroundColor3=color
			if e.gradient then e.gradient.Color=ColorSequence.new(color:Lerp(Color3.new(),.35),color) end
		else
			e.iris.BackgroundColor3=e.restore.color
			if e.gradient and e.restore.gradient then e.gradient.Color=e.restore.gradient end
		end
		for _,t in e.tomoe do t.Visible=color~=nil and kind=="sharingan" end
		e.tintKind=if color then kind else nil
		if e.pupil then e.pupil.Size=if kind=="fox" and color then UDim2.fromScale(.16,.62) else UDim2.fromScale(.42,.42) end
		e.gui.LightInfluence=if color then .1 else .55
	end
end
Face.look=look
return Face
