	final={reaction="Knockback",push=P(0,12,0),away=86,stun=1},
	shots={
		{0,P(.8,15,-5),P(0,0,-1),50},
		{.48,P(4.6,1.6,-1.2),P(0,1.3,-1),46,true},{1.4,P(3.2,1.4,1),P(0,1.3,-1),44},
		{1.45,{"caster",P(1.1,1.9,-2.3)},{"victim",P(0,1,0)},40,true},
		{2.33,P(-.9,1.5,2.7),P(0,1.2,0),36,true},
		{3.0,P(6.5,2,-1),P(0,1,-1),50,true},
	},
	cues={{0,"trigrams"},{.3,"palmRain"},{3.0,"silence"},{3.3,"impactFrame"},{3.3,"lastPalm"}},
}

-- ITACHI - TSUKUYOMI. No blow is seen. The eye, close: the world goes red
-- and black, the body is on a cross under a red moon, and seventy-two hours
-- pass in a second (the swords, again and again); then the world comes back
-- and the body falls to its knees.
S.tsukuyomi={
	opener="Gaze",
	caster={{0,"start"}},
	victim={{0,"start"},{.4,"start"},{.7,P(0,1.2,0)},{3.35,P(0,1.2,0)},{3.45,P(0,0,0),"in"}},
	blows={{1.0,false,"72:00:00"},{1.7,false,"48:00:00"},{2.4,false,"24:00:00"},{3.0,true,"00:00:01"}},
	final={reaction="Knockdown",push=P(0,2,0),away=2,stun=1.6},
	shots={
		{0,{"caster",P(0,1.55,1.5)},{"caster",P(0,1.5,0)},28},
		{.5,P(4.2,1,4.2),{"victim",P(0,1,0)},50,true},{1.45,P(-4,1.3,4.4),{"victim",P(0,1,0)},48},
		{1.5,{"victim",P(.4,1.7,2.4)},{"victim",P(0,1.3,0)},40,true},
		{2.38,P(2,10,5),{"victim",P(0,0,0)},50,true},
		{3.32,P(6,2,-1.5),"mid",55,true},
	},
	cues={{0,"eye"},{.4,"redWorld"},{.7,"cross"},{1.0,"swords"},{1.7,"swords"},{2.4,"swords"},{3.0,"swords"},{3.32,"worldBack"}},
}

-- MINATO - YELLOW FLASH. A fan of marked kunai round the body; then time
-- stops (the world grey, the body frozen): he is at one kunai, then another,
-- then another - eight places in two seconds, a yellow streak behind each -
-- and he is behind the body, his back to it. Time starts: every cut lands at
-- once.
do
	local caster={{0,"start"},{.45,"start"}}
	local order={0,3,6,1,4,7,2,5}
	for i,k in order do
		local a=math.rad(k*45+22.5)
		table.insert(caster,{.5+(i-1)*.24,P(math.sin(a)*3.2,0,math.cos(a)*3.2),"snap",face="other"})
	end
	table.insert(caster,{2.42,P(0,0,2.8),"snap",face="away"})
	local ring={}
	for k=0,7 do local a=math.rad(k*45+22.5);ring[k+1]=P(math.sin(a)*3.6,0,math.cos(a)*3.6) end
	S.flash={
		opener="Throw",
		caster=caster,
		victim={{0,"start"},{2.9,"start"},{3.1,P(0,0,-.4)}},
		blows={{2.92,true},{2.96,true},{3.0,true},{3.04,true,"HIRAISHIN"}},
		final={reaction="Knockdown",push=P(0,-6,0),away=40,stun=1.1},
		kunai=ring,
		shots={
			{0,P(6.5,7,-8),P(0,1,-1),58},
			{.48,P(7,2,0),{"victim",P(0,1,0)},55,true},{1.1,P(5,3,5),{"victim",P(0,1,0)},55},{1.7,P(-5,2.5,5),{"victim",P(0,1,0)},55},{2.38,P(-7,2,0),{"victim",P(0,1,0)},55},
			{2.42,P(4.4,1.4,1.4),P(0,1.2,1.4),46,true},
			{2.92,P(5,1.6,1),P(0,1.2,1),50},
		},
		cues={{0,"kunaiFan"},{.5,"timeStop"},{2.9,"timeStart"},{2.9,"impactFrame"},{2.92,"cutsLand"}},
	}
end

-- KAKASHI - CHIDORI: RAIKIRI. His hounds burst out of the floor and pin the
-- body. He steps back; the hand signs; the Raikiri screams in his hand,
-- white, while he waits; then the run - slow first, the floor torn open
-- behind his hand, then flat out - and one thrust through.
S.raikiri={
	opener="Hounds",
	caster={{0,"start"},{.3,P(0,0,-10),"smooth"},{1.25,P(0,0,-10)},{2.42,P(0,0,-1.5),"in"},{2.86,P(0,0,-1.1)},{2.92,P(0,.4,-1.0)}},
	victim={{0,"start"},{2.38,"start"},{2.42,P(0,0,.3)},{2.92,P(0,.6,.6)}},
	blows={{.15},{2.42,true,"RAIKIRI"},{2.54},{2.66},{2.78}},
	final={reaction="Knockback",push=P(0,16,0),away=90,stun=1},
	shots={
		{0,P(4,1.2,-1),{"victim",P(0,.4,0)},50},
		{.4,{"caster",P(1.3,1.1,1.6)},{"caster",P(.5,1,.4)},36,true},
		{1.25,{"caster",P(0,.9,5.2)},{"caster",P(0,1.3,0)},50,true},
		{1.95,{"caster",P(8.5,1.4,0)},{"caster",P(0,1,0)},42,true},
		{2.4,P(2.9,1.4,-1.3),P(0,1.2,-.5),42,true},
		{2.92,P(7,2,4),P(0,1,2),58,true},
	},
	cues={{0,"hounds"},{.4,"raikiriCharge"},{1.25,"raikiriRun"},{2.42,"impactFrame"},{2.42,"impale"}},
}

-- The camera at t (anchor-frame eye and target, fov); `live` resolves a body.
function Scripts.shot(kind,t,live)
	local spec=S[kind]
	if not spec or not spec.shots then return nil end
	local shots=spec.shots
	local function point(v)
		if typeof(v)=="Vector3" then return v end
		if v=="mid" then return (live("caster")+live("victim"))*.5+P(0,1,0) end
		if type(v)=="table" then return live(v[1])+v[2] end
		return live("victim")
	end
	local i=1
	for n=1,#shots do if shots[n][1]&lt;=t then i=n end end
	local a=shots[i]
	local b=shots[i+1]
	local eye,at,fov=point(a[2]),point(a[3]),a[4]
	if b and not b[5] then
		local k=math.clamp((t-a[1])/math.max(1e-3,b[1]-a[1]),0,1)
		k=k*k*(3-2*k)
		eye=eye:Lerp(point(b[2]),k);at=at:Lerp(point(b[3]),k);fov=fov+(b[4]-fov)*k
	end
	return eye,at,fov,i
end

return Scripts
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND31">
        <Properties>
          <string name="Name">VelmoraCombatConfig</string>
          <ProtectedString name="Source">-- Adapted from Velmora src/shared/config/CombatConfig.luau.
-- Copyright (c) 2026 Yashveer Singh, MIT.
return table.freeze({
	ParryWindow = 0.20,
	-- (Audit 03/11, the user's own play: "je pouvais plus bouger") Parried,
	-- the body is exposed 0.35 s (0.5 s read as a freeze, the counter landing
	-- every time).
	ParryStun = 0.35,
	ParryCost = 16,
	ParryCooldown = 0.60,
	BlockHitCost = 9,
	BlockDamageMultiplier = 0.24,
	DodgeIFrames = 0.19,
	BloodstepWindow = 0.13,
	History = 0.20,
	TimestampWindow = 0.10,
	-- (FEEL 05/11) a press up to 1 s old still counts, without its time
	-- (VelmoraAntiCheat.check); past it, it is dropped.
	LateAccept = 1.0,
	-- Minimum gap between two packets of one action (a flood guard, not a
	-- gameplay rule: the server state machine and the press buffer decide what
	-- a press does). Attack stays under a deliberate double tap (~0.1 s), or the
	-- second press of a buffered string was dropped before reaching the buffer.
	-- (Audit 29/10, tests/Control.sim: Heavy 0.24 / Dodge 0.42 / Grab 0.55
	-- dropped a person's second press silently, even when the first one had
	-- been refused by the fight, so a dodge pressed in a stun and again as it
	-- ended did nothing.) Every gap is now under what a hand can do on one
	-- button (~0.08 s); cooldowns stay the fight's business.
	Rates = table.freeze({Attack=0.05,Heavy=0.07,Guard=0.04,Dodge=0.07,Grab=0.07,Tool=0.07,Technique=0.07}),
})
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND32">
        <Properties>
          <string name="Name">Wave1</string>
          <ProtectedString name="Source">-- Roster 20, batch 1 (DEC-022): Haku, Zabuza, Kimimaro. This batch's shared
-- data, merged into Fighters, MoveGraphs and Attacks so batches never edit the
-- same tables (docs/characters/ROSTER_20.md).
--   fighters[id]  a Fighters entry (techniques naming a Family first)
--   graphs[id]    a MoveGraphs entry (the shared directional grammar)
--   attacks(move, attacks)  the batch's own strikes (Shared/RosterMoves)
-- Young versions only: what each of them could already do at that age.
local RosterMoves=require(script.Parent.RosterMoves)
local V=Vector3.new

local fighters={}
-- Haku (15, the Land of Waves): Ice Release. Fast and light, he fights from
-- the edge of the melee: senbon at the vital points (they slow), needles of
-- water, a step through a mirror, and the Demonic Ice Mirrors that close a
-- dome round the opponent. The dome is his network: inside it the mirror
-- step takes him from mirror to mirror round the body, a volley from each.
fighters.Mirror = {
	Name = "Haku", FullName = "Haku Yuki", Age = 15, Title = "THE ICE MIRROR", Color = { 150, 206, 240 },
	Routes = "↑ ice spike under the foot, the palm guides  ·  ↓ low senbon, backing off on ice  ·  ←→ ice slide and a senbon touch  ·  held guard: senbon to a vital point  ·  air: senbon / senbon dive / switch",
	Description = "Ice Release: senbon at the vital points, needles of water, the mirror step and the Demonic Ice Mirrors.",
	Health = 115, Chakra = 125, ChakraRegen = 8.4, Speed = 20, SprintScale = 1.12, JumpScale = 1.08, AirControlScale = 1.12, AccelerationScale = 1.12,
	CombatTravel = 1.06, CombatDamage = 0.9, DashScale = 1.12, GuardStrength = 0.1, PreferredRange = 11,
	ComboToolCancel = true, CombatStyle = "Angles", Tool = "Shuriken",
	-- Three senbon at once, fast and light; each one that lands slows a little.
	ToolMastery = { Kind = "shuriken", Projectile = "senbon", Count = 3, Speed = 112, Damage = 1.4, Recover = .6, Contact = { Slow = { Scale = .85, Time = 1 } } },
	-- Awakening: inside the mirrors. Faster legs, techniques back almost at
	-- once, cheaper ice.
	-- Rule: inside his dome, travel from mirror to mirror is free and comes
	-- back at once (a storm of volleys from every side).
	Awakening = { Name = "CRYSTAL ICE MIRRORS", Speed = 1.1, Regen = 1.3, Cooldown = 0.7, ZoneFree = true, Color = { 200, 236, 255 } },
	-- Bible HAKU.md (DEC-026): his own clips (Client/Wave1Motion); senbon
	-- held between the fingers and ice born at the wrist and under the feet
	-- in the transitions (Wave1FX). The dome stays his signature.
	Motion = { body = "Mirage", clips = "Mirror", weapons = "none", springy = false,
		-- Fingers on the senbon, arms close to the body, a light front foot,
		-- three-quarter on.
		stance = {root={y=-.34,pitch=4,yaw=32},torso={pitch=2,yaw=-10},head={pitch=-2,yaw=-16},
			ra={raise=70,out=-6,twist=30,elbow=104,wrist=-10},la={raise=36,out=-10,twist=-10,elbow=70,wrist=-10},
			rf={x=.22,z=.6,yaw=34},lf={x=-.08,z=-.58,yaw=-6},breath=.8,tempo=6},
		-- The guard: a forearm and the senbon turn the blow aside (no giant shield).
		guard = {root={y=-.46,pitch=4},torso={pitch=4,yaw=-12},head={pitch=4},
			ra={raise=96,out=-36,twist=50,elbow=96},la={raise=60,out=-10,twist=10,elbow=96}} },
	AttackProfile = {
		-- Bible §3/§5 A/C/R and contact distances: L1 senbon .11/.05/.18 at 3.1,
		-- L2 palm + wrist spike .16/.05/.17 at 3.3, L3 exiting senbon
		-- .19/.06/.28 at 3.5, Heavy forearm on a spike + senbon push .25/.06/.32 at 3.8.
		Light1={startup=1.22,active=.42,recovery=.64,travel=1.06,range=5.1,depth=3.5,offset=2.3,width=3.6,contact=3.1,zone="body",kind="strike"},
		Light2={startup=1.6,active=.42,recovery=.63,travel=1.06,range=5.3,depth=3.7,offset=2.4,width=4.2,contact=3.3,zone="body",kind="palm"},
		Light3={startup=1.58,active=.43,recovery=1.17,range=5.5,depth=3.9,offset=2.5,width=4.4,contact=3.5,zone="body",kind="strike",impulseZ=48},
		Heavy={startup=.83,active=.35,recovery=.62,range=5.8,depth=4.1,offset=2.7,width=4.4,contact=3.8,kind="heavy"},
		Launcher={startup=.94,impulseY=54},DashAttack={startup=.88,travel=1.1,contact=3.2,kind="strike"},Air1={contact=3.2,kind="strike"},Air2={contact=3.4,kind="strike"},
	},
	Skin = { 238, 220, 204 }, Hair = { 30, 30, 36 }, Outfit = { 110, 140, 112 },
	Techniques = {
		{ Id = "WaterNeedles", Name = "Thousand Flying Water Needles", Family = "Projectile", Kind = "ice", Element = "Water", Cost = 16, Channel = 0.3, Active = 0.05, Recovery = 0.3, Cooldown = 4.5, Interruptible = true,
			Range = 34, Speed = 86, Damage = 2.2, Count = 7, Spread = 0.5, Radius = .7, Slow = { Scale = .8, Time = 1.4 }, Hint = "A fan of ice needles • each one slows • hard to dodge sideways" },
		{ Id = "MirrorStep", Name = "Ice Mirror Step", Family = "Teleport", Kind = "mirror", To = "Side", Distance = 3.4, Move = "SenbonStab", Damage = 7, InZone = 1.4, ZoneName = "mirrors",
			Ring = { Look = "mirror", Volley = { Count = 3, Kind = "senbon", Damage = 2.4, Speed = 120, Slow = { Scale = .75, Time = 1.2 } } },
			Cost = 14, Channel = 0.1, Active = 0.04, Recovery = 0.2, Cooldown = 3.6, Interruptible = true, Range = 30, Invuln = .15,
			Hint = "Outside the dome: out of a mirror at his flank, senbon to a vital point • inside it: from mirror to mirror round the body, a volley from each", AI = { Min = 6, Max = 28 } },
		{ Id = "IceMirrors", Name = "Demonic Ice Mirrors", Family = "Zone", Kind = "mirror", ZoneKind = "Ice", At = "Target", Element = "Water", Cost = 28, Channel = 0.55, Active = 0.2, Recovery = 0.35, Cooldown = 12, Interruptible = true,
			Range = 30, Radius = 7.5, Time = 5.5, Damage = 3, Slow = { Scale = .72 }, Hint = "A dome of mirrors round the opponent • it slows and cuts • his mirror step strikes harder inside" },
	},
}

-- Zabuza (14, the Mist's young Swordsman): the cleaver. Slow, long, heavy
-- strikes with real reach; the Hidden Mist, the Silent Killing out of it
-- (much harder while the body stands in his mist) and the Water Prison.
fighters.Mist = {
	Name = "Zabuza", FullName = "Zabuza Momochi", Age = 14, Title = "THE DEMON OF THE MIST", Color = { 120, 150, 170 },
	Routes = "↑ cleaver rise from the hip  ·  ↓ low cut backing off  ·  ←→ arc covering the flank  ·  held guard: handle riposte  ·  air: flat strike / cleaver dive",
	Description = "Kubikiribōchō: slow, long and heavy. The Hidden Mist, the Silent Killing out of it, the Water Prison.",
	Health = 150, Chakra = 110, ChakraRegen = 7, Speed = 18.5, SprintScale = 1.1, JumpScale = 0.96, AirControlScale = 0.85, AccelerationScale = 0.86,
	CombatTravel = 0.92, CombatDamage = 1.12, DashScale = 1.0, StrikeTurnScale = 0.62, GuardStrength = 0.08, PreferredRange = 6.5,
	ComboToolCancel = true, CombatStyle = "Control", Tool = "Kunai",
	ToolMastery = { Kind = "kunai", Count = 1, Speed = 88, Damage = 3, Recover = .8 },
	-- Awakening: the Demon. Light blows do not stop him, the cleaver bites deeper.
	Awakening = { Name = "DEMON OF THE MIST", Speed = 1.06, Damage = 1.12, Regen = 1.2, Cooldown = 0.7, Buff = { Heavy = true }, Color = { 170, 210, 230 } },
	-- The closed-fan clips are a long heavy weapon swung two-handed: the
	-- cleaver's (GaleFX draws the fan for Temari only).
	-- Bible ZABUZA.md (DEC-026): his own clips (Client/Wave1Motion), the
	-- cleaver in both hands from the guard to the recovery (Wave1FX).
	Motion = { body = "Mirage", clips = "Mist", weapons = "none", springy = false,
		-- Feet wide, the pelvis carries the weight; the point low on the
		-- diagonal, the rear hand on the handle.
		stance = {root={y=-.58,pitch=6,yaw=26},torso={pitch=6,yaw=-10},head={pitch=-4,yaw=-14},
			ra={raise=46,out=-16,twist=-10,elbow=20,wrist=0},la={raise=52,out=-30,twist=-10,elbow=58,wrist=-10},
			rf={x=.34,z=.72,yaw=30},lf={x=-.22,z=-.7,yaw=-8},breath=.55,tempo=3.8},
		-- The guard: the blade held flat across, the face still readable.
		guard = {root={y=-.66,pitch=6},torso={pitch=4,yaw=-6},head={pitch=4},
			ra={raise=96,out=-30,twist=60,elbow=70,wrist=0},la={raise=100,out=-50,twist=50,elbow=84,wrist=-10}} },
	-- Bible §3/§5 A/C/R: L1 handle .12/.06/.23 at 3.2, L2 edge .28/.09/.30
	-- at 5.5, L3 reverse .32/.10/.40 at 5.8, Heavy .42/.10/.52 at 6 (the
	-- multipliers are those seconds over the base strike's).
	AttackProfile = {
		Light1={startup=1.33,active=.5,recovery=.82,travel=.9,range=5.4,depth=4,offset=2.6,width=4.5,contact=3.2,damage=.9,zone="body",kind="strike"},
		Light2={startup=2.8,active=.75,recovery=1.11,travel=.8,range=7.6,depth=5.8,offset=3.6,width=8.5,contact=5.5,damage=1.15,zone="body",kind="slash"},
		Light3={startup=2.67,active=.71,recovery=1.67,travel=.8,range=8,depth=6,offset=3.8,width=7,contact=5.8,impulseZ=64,damage=1.1,kind="slash"},
		Heavy={startup=1.4,active=.59,recovery=1.0,range=8.2,depth=6.2,offset=3.9,contact=6,kind="heavy"},
		DashAttack={travel=.9,range=6,contact=3.4,kind="strike"},Air1={range=7,contact=4.4,kind="strike"},Air2={range=7.2,contact=4.6,kind="slash"},
	},
	Skin = { 228, 204, 182 }, Hair = { 30, 30, 34 }, Outfit = { 120, 128, 130 },
	Techniques = {
		{ Id = "HiddenMist", Name = "Hidden Mist", Family = "Zone", Kind = "mist", ZoneKind = "Mist", At = "Self", Element = "Water", Cost = 20, Channel = 0.4, Active = 0.2, Recovery = 0.3, Cooldown = 14, Interruptible = true,
			Range = 16, Radius = 16, Time = 8, Damage = 0, Slow = { Scale = .86 }, Shroud = true,
			Hint = "A thick mist round him • inside it the opponent loses sight of him (he fades to a shadow, no lock) • the Silent Killing strikes far harder there" },
		{ Id = "SilentKilling", Name = "Silent Killing", Family = "Teleport", Kind = "mist", To = "Behind", Distance = 3.6, Move = "SilentCleave", InZone = 1.7, ZoneName = "mist",
			Cost = 22, Channel = 0.14, Active = 0.04, Recovery = 0.25, Cooldown = 6, Interruptible = true, Range = 32,
			Hint = "Gone, then the cleaver from behind • far harder in his mist", AI = { Min = 6, Max = 30 } },
		{ Id = "WaterPrison", Name = "Water Prison", Family = "Projectile", Kind = "water", Element = "Water", Cost = 24, Channel = 0.3, Active = 0.06, Recovery = 0.3, Cooldown = 10, Interruptible = true,
			Range = 16, Speed = 72, Damage = 2, Radius = 1.6, Bind = 1.6, Crush = 8, Hint = "Short range: a sphere of water holds the body • then it bursts" },
	},
}

-- Kimimaro (13, the last of the Kaguya): Shikotsumyaku. His bones are his
-- weapons and his armour: the finger bullets are his tool, the Camellia
-- draws a bone sword, the Larch bursts from his whole body and leaves the
-- floor spiked, the Willow is a lunge of bone blades. He takes less damage.
fighters.Bone = {
	Name = "Kimimaro", FullName = "Kimimaro Kaguya", Age = 13, Title = "THE LAST KAGUYA", Color = { 236, 230, 212 },
	Routes = "↑ bone forearm rises under the guard  ·  ↓ shin reap backing off  ·  ←→ flank elbow, hip arc  ·  held guard: the bone elbow  ·  air: knee / bone heel / switch",
	Description = "Shikotsumyaku: bones as blades and armour. Finger bullets, the Camellia sword, the Larch, the Willow.",
	Health = 140, Chakra = 105, ChakraRegen = 7.4, Speed = 19, SprintScale = 1.1, JumpScale = 1.04, AirControlScale = 1.0, AccelerationScale = 1.04,
	CombatTravel = 1.02, CombatDamage = 1.0, DashScale = 1.04, GuardStrength = 0.1, PreferredRange = 5,
	-- Bone under the skin: every blow that lands loses some of its weight.
	Armor = 0.12,
	ComboToolCancel = true, CombatStyle = "Angles", Tool = "Kunai",
	-- Teshi Sendan: bones fired from the fingertips, two at once.
	ToolMastery = { Kind = "kunai", Projectile = "bone", Count = 2, Speed = 100, Damage = 2.4, Recover = .7 },
	-- Awakening: the Kaguya bloodline unleashed. Bone armour over the body (a
	-- third of every blow, light blows do not stop him) and a deeper bite.
	Awakening = { Name = "DANCE OF THE CLEMATIS", Speed = 1.04, Damage = 1.1, Regen = 1.2, Cooldown = 0.7, Buff = { Armor = 0.3, Heavy = true }, Color = { 246, 240, 222 } },
	-- Bible KIMIMARO.md (DEC-026): his own clips (Client/Wave1Motion); the
	-- skeleton lives in the blows (Wave1FX): knuckles, elbow, shin and the
	-- forearm bones grow before the contact and retract after it. The long
	-- bone sword is the Camellia's only.
	Motion = { body = "Lion", clips = "Bone", weapons = "none", springy = false,
		-- Soft hands, elbows a little open, feet offset, the centre low and
		-- mobile (no blade held out: not a Jedi stance).
		stance = {root={y=-.5,pitch=6,yaw=24},torso={pitch=4,yaw=-8},head={pitch=-4,yaw=-12},
			ra={raise=50,out=10,twist=10,elbow=70,wrist=0},la={raise=42,out=14,twist=10,elbow=80,wrist=0},
			rf={x=.3,z=.55,yaw=30},lf={x=-.2,z=-.6,yaw=-8},breath=.7,tempo=5},
		-- The guard: the forearms up and crossed, radius and ulna out between
		-- the arms and the blow.
		guard = {root={y=-.6,pitch=6},torso={pitch=6,yaw=-4},head={pitch=6},
			ra={raise=84,out=-30,twist=40,elbow=112},la={raise=80,out=-30,twist=40,elbow=116}} },
	AttackProfile = {
		-- Bible §3/§5 A/C/R and contact distances: L1 knuckles .12/.05/.18 at
		-- 3.2, L2 bone elbow .18/.06/.21 at 3.3, L3 round kick with shin spurs
		-- .22/.07/.30 at 3.9, Heavy crossed forearms + shoulder .28/.08/.36 at 3.8.
		Light1={startup=1.33,active=.42,recovery=.64,range=5.2,depth=3.6,offset=2.4,width=4,contact=3.2,zone="body",kind="strike"},
		Light2={startup=1.8,active=.5,recovery=.78,range=5.3,depth=3.7,offset=2.4,width=4.5,contact=3.3,zone="body",kind="strike"},
		Light3={startup=1.83,active=.5,recovery=1.25,range=5.9,depth=4.2,offset=2.8,width=5.5,contact=3.9,zone="body",kind="kick",impulseZ=52},
		Heavy={startup=.93,active=.47,recovery=.69,range=5.8,depth=4.1,offset=2.7,width=5,contact=3.8,kind="heavy"},
		Launcher={startup=.98,impulseY=56},DashAttack={startup=.94,travel=1.06,contact=3.4,kind="strike"},Air1={contact=3.4,kind="kick"},Air2={contact=3.6,kind="kick"},
	},
	Skin = { 240, 226, 212 }, Hair = { 236, 234, 228 }, Outfit = { 236, 232, 224 },
	Techniques = {
		{ Id = "Camellia", Name = "Dance of the Camellia", Family = "Buff", Kind = "bonespear", Cost = 18, Channel = 0.3, Active = 0.05, Recovery = 0.2, Cooldown = 14, Interruptible = true,
			Time = 8, Damage = 1.22, Speed = 1.05, Range = 20, Hint = "A bone sword drawn from the palm: his blows hit harder for 8 s" },
		{ Id = "Larch", Name = "Dance of the Larch", Family = "Burst", Kind = "bones", Cost = 20, Channel = 0.1, Active = 0.25, Recovery = 0.32, Cooldown = 8, Interruptible = false,
			Radius = 6.5, Clear = true, Damage = 8, Knock = 36, Lift = 14, Range = 6.5, Leave = { Radius = 6, Time = 3, Damage = 3, Kind = "Bones", Look = "bones" },
			Hint = "Bones burst from his whole body • blades cut down, a close attacker thrown off • the floor stays spiked" },
		{ Id = "Willow", Name = "Dance of the Willow", Family = "Strike", Move = "WillowCut", Cost = 16, Channel = 0.18, Active = 0.05, Recovery = 0.1, Cooldown = 5, Interruptible = true,
			Range = 14, Damage = 10, Hint = "A lunge of bone blades across the gap", AI = { Min = 4, Max = 12 } },
	},
}

local graphs={
	Mirror={
		routes={up="FrostLift",down="SenbonLow",side="IceSlide",airUp="AirDrive",airDown="SenbonDive",airSide="AirSwitch"},
		disengage="Kunai",
		-- Bible §5/§6: the heavy after one is the same push; a held guard is
		-- answered by the senbon's angle (to a vital point).
		riposte="SenbonStab",
		stringCancels={MirrorStep=true,WaterNeedles=true},
		blockCancels={Tool=true},
		-- Never straight in: a quick re-entry at a wide angle.
		reengage={name="mirror",speed=1.2,arrive=3.4,angle=40,shuffle=true,chase=.26,recovery=.18},
	},
	Mist={
		routes={up="CleaverRise",down="CleaverDrop",side="CleaverArc",airUp="AirDrive",airDown="CleaverDive"},
		-- Bible §5/§6: the heavy after one is the same diagonal (no separate
		-- move); a held guard is answered with the handle.
		riposte="CleaverHilt",
		stringCancels={SilentKilling=true},
		blockCancels={},
		-- Unhurried: walks the body down, straight in, slower than most.
		reengage={name="mist",speed=.92,arrive=4.2,angle=0,minRange=6,chase=.3,recovery=.24},
	},
	Bone={
		routes={up="BoneRise",down="BoneReap",side="CamelliaArc",airUp="AirDrive",airDown="BoneHeel",airSide="AirSwitch"},
		disengage="Kunai",
		-- Bible §5/§6: the heavy after one is the same crossed forearms; a held
		-- guard is answered with the bone elbow.
		riposte="BoneElbow",
		stringCancels={Willow=true,Larch=true},
		blockCancels={},
		reengage={name="bone",speed=1.05,arrive=3,angle=12,chase=.28,recovery=.2},
	},
}

local function attacks(move,list)
	RosterMoves.add(move,list,{
		-- Haku: a senbon driven into a vital point (the body slows), and a
		-- low sliding cut on a skin of ice that keeps the string.
		SenbonStab={{.08,.1,.3,7,2.6,"HitStun",V(0,4,12),.44},{contact=3.4,range=6.4,zone="head",kind="strike",side=-1,twist=34,lean=12,arm=96,step=1.1,riders={Slow={Scale=.7,Time=1.8}}}},
		IceSlide={{.1,.14,.24,6,3.2,"HitStun",V(0,4,12),.38},{contact=3.3,range=5.6,width=5,zone="body",kind="strike",side=1,twist=40,lean=10,arm=80,step=1.1,orbit=30,chain=true}},
		-- Haku's routes (bible HAKU.md §4): one ice spike under the foot and
		-- the palm guides (a local launcher), a low senbon then a retreat on
		-- ice, the senbon driven down from the air.
		FrostLift={{.14,.14,.32,8,1.4,"Launched",V(0,52,6),1.2},{contact=3.4,range=5.8,width=5,height=8,zone="chin",kind="launch",side=1,twist=14,lean=-16,arm=110,step=1.1,breaksShield=true}},
		SenbonLow={{.12,.12,.34,7,.4,"Knockdown",V(0,6,14),.6},{contact=3.4,range=5.8,width=5,height=3.5,zone="legs",kind="sweep",side=1,twist=30,lean=18,arm=70,step=.9,retreat=1.5}},
		SenbonDive={{.1,.14,.26,7,1.5,"Spiked",V(0,-68,4),.9},{contact=3.4,range=6,width=5,height=8,zone="head",kind="spike",side=1,twist=10,lean=36,arm=120,step=1,air=true}},
		-- Zabuza: the cleaver. Long reach (he stops further out), slow, heavy.
		CleaverRise={{.17,.15,.32,9,1.4,"Launched",V(0,52,6),1.2},{contact=4.8,range=8,width=6,height=8,zone="chin",kind="launch",side=1,twist=14,lean=-26,arm=120,step=1.1,breaksShield=true}},
		CleaverDrop={{.16,.14,.38,9,.4,"Knockdown",V(0,6,16),.66},{contact=4.6,range=8,width=7,height=3.5,zone="legs",kind="sweep",side=1,twist=30,lean=20,arm=80,step=.9,retreat=1.4}},
		CleaverArc={{.13,.18,.3,7,.8,"HitStun",V(0,5,14),.4},{contact=4.6,range=8.2,width=9,height=6,zone="body",kind="slash",side=1,twist=60,lean=6,arm=84,step=1.0,chain=true,orbit=18}},
		CleaverHilt={{.1,.12,.32,9,1.6,"Knockback",V(0,12,50),.5},{contact=4.2,range=7,width=6,zone="body",kind="heavy",side=-1,twist=48,lean=12,arm=96,step=1.15}},
		CleaverDive={{.11,.14,.26,8,1.5,"Spiked",V(0,-72,4),.9},{contact=4.4,range=7.8,width=6,height=8,zone="head",kind="spike",side=1,twist=10,lean=42,arm=124,step=1,air=true}},
		SilentCleave={{.08,.16,.36,13,1.2,"Knockdown",V(0,10,30),.7},{contact=4.4,range=8,width=7,height=7,zone="body",kind="heavy",side=1,twist=60,lean=24,arm=120,step=1.2}},
		-- Kimimaro: bone through the guard's gap, the camellia's arc that
		-- keeps the string, and the willow's lunge.
		BoneThrust={{.1,.12,.32,10,3.2,"Knockback",V(0,10,58),.5},{contact=3.8,range=7,zone="body",kind="heavy",side=1,twist=24,lean=22,arm=110,step=1.25}},
		CamelliaArc={{.1,.14,.24,6,1.6,"HitStun",V(0,4,12),.38},{contact=3.4,range=5.6,width=6,zone="body",kind="strike",side=-1,twist=60,lean=8,arm=96,step=1.05,orbit=24,chain=true}},
		-- Kimimaro's routes (bible KIMIMARO.md §4/§6): the forearm bone that
		-- rises under the guard, the reaping shin that backs off, the bone
		-- elbow that answers a guard, the bone heel from the air.
		BoneRise={{.14,.14,.32,8,1.4,"Launched",V(0,54,6),1.2},{contact=3.4,range=5.8,width=5,height=8,zone="chin",kind="launch",side=1,twist=14,lean=-20,arm=120,step=1.1,breaksShield=true}},
		BoneReap={{.13,.14,.36,8,.4,"Knockdown",V(0,6,16),.66},{contact=3.8,range=6,width=6,height=3.5,zone="legs",kind="sweep",side=1,twist=40,lean=12,arm=80,step=.9,retreat=1.3}},
		BoneElbow={{.08,.12,.3,8,1.6,"Knockback",V(0,10,46),.5},{contact=3.2,range=5.4,width=5,zone="body",kind="strike",side=-1,twist=50,lean=12,arm=90,step=1.15}},
		BoneHeel={{.11,.14,.26,8,1.5,"Spiked",V(0,-70,4),.9},{contact=3.6,range=6.2,width=5,height=8,zone="head",kind="spike",side=1,twist=10,lean=40,arm=124,step=1,air=true}},
		WillowCut={{.05,.22,.42,12,10,"Knockback",V(0,12,52),.55},{contact=3.6,range=7,width=5,zone="body",kind="heavy",side=1,twist=20,lean=30,arm=110,step=1.4}},
	})
end

return {
	fighters=fighters,
	graphs=graphs,
	attacks=attacks,
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND33">
        <Properties>
          <string name="Name">Wave2</string>
          <ProtectedString name="Source">-- Roster 20, batch 2 (DEC-022): Shisui, Orochimaru, Kabuto. This batch's
-- shared data, merged into Fighters, MoveGraphs and Attacks (see Wave1).
-- Young versions only: what each of them could already do at that age.
local RosterMoves=require(script.Parent.RosterMoves)
local V=Vector3.new

local fighters={}
-- Shisui (13, "of the Body Flicker"): an Uchiha whose game is speed, not
-- reads or fire-lightning rushdown. The Body Flicker is cheap and fast and
-- strikes from the flank; a second flicker takes him out of reach; a Katon
-- fireball; a Sharingan genjutsu that seals jutsu for a moment. Narrow
-- Sharingan windows (not Itachi's). No Mangekyō: that comes later.
fighters.Flicker = {
	Name = "Shisui", FullName = "Shisui Uchiha", Age = 13, Title = "THE BODY FLICKER", Color = { 214, 120, 96 },
	Routes = "↑ launcher  ·  ↓ sweep  ·  ←→ flicker step (vanishes to the flank, the string goes on)  ·  heavy after one: flicker cut  ·  air: drive / spike / switch",
	Description = "The fastest Uchiha: the Body Flicker from the flank and out of reach, a Katon fireball, a genjutsu that seals jutsu.",
	Health = 122, Chakra = 120, ChakraRegen = 8.4, Speed = 20.5, SprintScale = 1.14, JumpScale = 1.1, AirControlScale = 1.15, AccelerationScale = 1.18,
	CombatTravel = 1.15, CombatDamage = 0.96, DashScale = 1.2, GuardStrength = 0.1, PreferredRange = 7,
	ComboToolCancel = true, CombatStyle = "Angles", Tool = "Kunai",
	ToolMastery = { Kind = "kunai", Count = 1, Speed = 100, Damage = 3, Recover = .5 },
	Sharingan = { ParryWindow = 0.22, PerfectDodge = 0.2, Counter = 0.7 },
	-- Awakening: the flicker becomes instant. Faster legs, the flickers back
	-- almost at once and for half their cost, wider read windows.
	-- Rule: a Body Flicker whose cut lands gives the flicker back at once,
	-- three times in a row (a chain of flank cuts no one else can do).
	Awakening = { Name = "SHUNSHIN NO SHISUI", Speed = 1.12, Regen = 1.3, Cooldown = 0.7, Windows = 1.2, ChainTeleport = 3, Color = { 230, 50, 60 } },
	Motion = { body = "Lion", weapons = "kunai", springy = true,
		borrow = { FlickerStep = "AngleStep", FlickerCut = "Light3" },
		-- Loose and forward, almost a runner's stance: weight on the balls of
		-- the feet, the kunai held low and back in the right hand.
		stance = {root={y=-.46,pitch=10,yaw=24},torso={pitch=8,yaw=-8},head={pitch=-6,yaw=-12},
			ra={raise=10,out=24,twist=20,elbow=40,wrist=0},la={raise=64,out=-12,twist=-30,elbow=86,wrist=-10},
			rf={x=.22,z=.6,yaw=28},lf={x=-.1,z=-.64,yaw=-6},breath=1.2,tempo=8} },
	AttackProfile = {
		Light1={startup=.86,recovery=.86,travel=1.12},Light2={startup=.86,recovery=.86,travel=1.12,kind="slash"},
		Light3={startup=.92,recovery=.92,impulseZ=50},Heavy={startup=.94},
		Launcher={startup=.9,impulseY=56},DashAttack={startup=.84,travel=1.2},Air1={startup=.88},Air2={startup=.9},
	},
	Skin = { 230, 206, 184 }, Hair = { 24, 24, 30 }, Outfit = { 40, 44, 60 },
	Techniques = {
		{ Id = "BodyFlicker", Name = "Body Flicker", Family = "Teleport", Kind = "flicker", To = "Side", Distance = 3, Move = "FlickerCut", Damage = 6,
			Cost = 10, Channel = 0.06, Active = 0.03, Recovery = 0.16, Cooldown = 1.8, Interruptible = true, Range = 34, Invuln = .12,
			Hint = "Gone and at his flank in a blink • a cut on arrival • cheap: chain it", AI = { Min = 5, Max = 30, Chance = .4 } },
		{ Id = "FlickerOut", Name = "Afterimage Retreat", Family = "Teleport", Kind = "flicker", To = "Back", Distance = 13,
			Cost = 8, Channel = 0.04, Active = 0.03, Recovery = 0.12, Cooldown = 3, Interruptible = true, Range = 13, Invuln = .25,
			Hint = "Out of reach in a blink • an afterimage takes the blow" },
		{ Id = "ShisuiFireball", Name = "Fire Release: Great Fireball", Family = "Projectile", Kind = "fireball", Element = "Fire", Cost = 22, Channel = 0.42, Active = 0.12, Recovery = 0.34, Cooldown = 6, Interruptible = true,
			Range = 40, Speed = 62, Damage = 11, Radius = 2.2, Knock = 30, Lift = 12, Hint = "A great fireball • throws the body back" },
		{ Id = "ShisuiGenjutsu", Name = "Genjutsu: Sharingan", Family = "Burst", Kind = "flicker", Cost = 18, Channel = 0.12, Active = 0.1, Recovery = 0.3, Cooldown = 10, Interruptible = true,
			Radius = 7, Arc = 0.4, Damage = 2, Seal = 2.5, Slow = { Scale = .75, Time = 2 }, Range = 7, Style = "look",
			Hint = "Eye contact up close: the opponent's jutsu sealed 2.5 s, his legs heavy" },
	},
}

-- Orochimaru (12, Hiruzen's genin, already a prodigy of ninjutsu): snakes
-- from the sleeves. A shadow snake that bites and drags the body in, a pair
-- that coil and hold it, a lunge with venom in it. Long, loose limbs (his
-- strikes reach a little further). No Kusanagi, no body transfer: adult.
fighters.Serpent = {
	Name = "Orochimaru", FullName = "Orochimaru", Age = 12, Title = "THE SNAKE PRODIGY", Color = { 130, 100, 160 },
	Routes = "↑ launcher  ·  ↓ sweep  ·  ←→ feint step  ·  heavy after one: venom fang (poisons)  ·  air: drive / spike / switch",
	Description = "Snakes from the sleeves: a shadow snake that drags the body in, coils that hold it, a venomous fang.",
	Health = 130, Chakra = 130, ChakraRegen = 8, Speed = 18.5, SprintScale = 1.08, JumpScale = 1.0, AirControlScale = 1.0, AccelerationScale = 1.0,
	CombatTravel = 0.98, CombatDamage = 0.98, DashScale = 1.0, GuardStrength = 0.1, PreferredRange = 9,
	ComboToolCancel = true, CombatStyle = "Control", Tool = "Kunai",
	ToolMastery = { Kind = "kunai", Count = 1, Speed = 90, Damage = 3, Recover = .7 },
	-- Awakening: the snake contract. Every blow carries venom, his coils hold
	-- longer, his chakra comes back faster.
	Awakening = { Name = "SNAKE CONTRACT", Speed = 1.05, Regen = 1.45, Cooldown = 0.6, BindScale = 1.4,
		OnHit = { Poison = { Damage = .6, Time = 2, Every = .5 } }, Color = { 170, 140, 220 } },
	Motion = { body = "Mirage", weapons = "none", springy = false,
		borrow = { VenomFang = "Heavy" },
		-- Low and loose, the head forward like a snake's, the arms hanging and
		-- ready to whip out.
		stance = {root={y=-.5,pitch=14,yaw=20},torso={pitch=12,yaw=-6},head={pitch=-14,yaw=-10},
			ra={raise=24,out=18,twist=30,elbow=30,wrist=-20},la={raise=40,out=-6,twist=-30,elbow=46,wrist=-20},
			rf={x=.26,z=.56,yaw=30},lf={x=-.14,z=-.62,yaw=-10},breath=.7,tempo=4} },
	AttackProfile = {
		Light1={startup=.96,recovery=.94,range=7,contact=4},Light2={startup=.96,recovery=.94,range=7,contact=4,kind="palm"},
		Light3={startup=1.0,recovery=.98,range=7.2,impulseZ=50,kind="kick"},Heavy={startup=1.0,range=7.2},
		Launcher={startup=.98,impulseY=54},DashAttack={startup=.95,travel=1.0},Air1={startup=.96},Air2={startup=.98},
	},
	Skin = { 236, 228, 222 }, Hair = { 24, 24, 30 }, Outfit = { 70, 78, 96 },
	Techniques = {
		{ Id = "ShadowSnake", Name = "Striking Shadow Snakes", Family = "Projectile", Kind = "snake", Cost = 16, Channel = 0.26, Active = 0.06, Recovery = 0.3, Cooldown = 4, Interruptible = true,
			Range = 26, Speed = 82, Damage = 5, Radius = 1.1, Pull = 46, PullTo = 3.5, Poison = { Damage = 1, Time = 3, Every = .5 },
			Hint = "A snake from the sleeve bites and drags the body to him • venom" },
		{ Id = "SnakeCoil", Name = "Hidden Shadow Snake Hands", Family = "Projectile", Kind = "snakes", Count = 2, Spread = 0.2, Cost = 22, Channel = 0.34, Active = 0.08, Recovery = 0.3, Cooldown = 9, Interruptible = true,
			Range = 20, Speed = 72, Damage = 3, Radius = 1.1, Bind = 1.3, Crush = 6, Hint = "Two snakes coil round the body and hold it • then they squeeze" },
		{ Id = "SnakeLunge", Name = "Snake Lunge", Family = "Strike", Move = "VenomFang", Cost = 14, Channel = 0.14, Active = 0.05, Recovery = 0.1, Cooldown = 5, Interruptible = true,
			Range = 12, Damage = 9, Poison = { Damage = 1.2, Time = 3, Every = .5 }, Hint = "A lunge with a fang in it: poison", AI = { Min = 3.5, Max = 10 } },
	},
}

-- Kabuto (13, the spy medic): medical ninjutsu turned on the body. The
-- chakra scalpel cuts muscles (the body slows) and drains; a scalpel strike
-- that cuts the legs; a body flicker back that mends him on the way.
fighters.Medic = {
	Name = "Kabuto", FullName = "Kabuto Yakushi", Age = 13, Title = "THE SPY MEDIC", Color = { 120, 110, 160 },
	Routes = "↑ launcher  ·  ↓ sweep  ·  ←→ circle step  ·  heavy after one: scalpel slice (slows)  ·  air: drive / spike / switch",
	Description = "Medical ninjutsu as a weapon: the chakra scalpel cuts muscles, he mends himself on the way out.",
	Health = 130, Chakra = 125, ChakraRegen = 9, Speed = 19, SprintScale = 1.08, JumpScale = 1.02, AirControlScale = 1.0, AccelerationScale = 1.04,
	CombatTravel = 1.02, CombatDamage = 0.92, DashScale = 1.04, GuardStrength = 0.12, PreferredRange = 4.5,
	ComboToolCancel = true, CombatStyle = "Control", Tool = "Kunai",
	ToolMastery = { Kind = "kunai", Count = 1, Speed = 90, Damage = 3, Recover = .7 },
	-- Awakening: the medical genius. Chakra back fast, every blow cuts a
	-- muscle (slows), techniques back sooner.
	Awakening = { Name = "MEDICAL GENIUS", Speed = 1.05, Regen = 1.6, Cooldown = 0.6, OnHit = { Slow = { Scale = .8, Time = 1.2 } }, Color = { 120, 240, 190 } },
	Motion = { body = "GentleFist", weapons = "palms", springy = false,
		borrow = { ScalpelSlice = "PalmThrust" },
		-- Calm and neat, glasses-level composure: upright, both hands open and
		-- low, ready to cut.
		stance = {root={y=-.26,pitch=4,yaw=22},torso={pitch=2,yaw=-8},head={pitch=0,yaw=-12},
			ra={raise=40,out=10,twist=20,elbow=70,wrist=-10},la={raise=50,out=-10,twist=-20,elbow=80,wrist=-10},
			rf={x=.2,z=.56,yaw=30},lf={x=-.08,z=-.56,yaw=-6},breath=.6,tempo=5} },
	AttackProfile = {
		Light1={startup=.92,recovery=.9,range=6.2,kind="palm"},Light2={startup=.92,recovery=.9,range=6.2,kind="palm"},
		Light3={startup=.98,recovery=.96,impulseZ=48,kind="palm"},Heavy={startup=1.0,kind="palm"},
		Launcher={startup=.98,impulseY=54},DashAttack={startup=.94},Air1={startup=.96},Air2={startup=.98},
	},
	Skin = { 236, 214, 196 }, Hair = { 200, 200, 206 }, Outfit = { 110, 84, 130 },
	Techniques = {
		{ Id = "ChakraScalpel", Name = "Chakra Scalpel", Family = "Buff", Kind = "scalpel", Cost = 18, Channel = 0.25, Active = 0.05, Recovery = 0.2, Cooldown = 12, Interruptible = true,
			Time = 8, Damage = 1.1, Range = 20, OnHit = { Slow = { Scale = .72, Time = 1.6 }, Drain = 3 },
			Hint = "Blades of chakra on his hands for 8 s: every blow cuts a muscle (slows) and drains" },
		{ Id = "TendonCut", Name = "Scalpel: Tendon Cut", Family = "Strike", Move = "ScalpelSlice", Cost = 12, Channel = 0.12, Active = 0.05, Recovery = 0.1, Cooldown = 4.5, Interruptible = true,
			Range = 10, Damage = 8, Slow = { Scale = .6, Time = 2.4 }, Hint = "A low cut at the legs: the body slows hard", AI = { Min = 3, Max = 9 } },
		{ Id = "MendingRetreat", Name = "Mystical Palm Retreat", Family = "Teleport", Kind = "scalpel", To = "Back", Distance = 11, Heal = 14,
			Cost = 20, Channel = 0.1, Active = 0.04, Recovery = 0.2, Cooldown = 11, Interruptible = true, Range = 11, Invuln = .2,
			Hint = "A flicker out of reach, the Mystical Palm closing his wounds" },
	},
}

local graphs={
	Flicker={
		routes={up="Launcher",down="Sweep",side="FlickerStep",airUp="AirDrive",airDown="AirSpike",airSide="AirSwitch"},
		disengage="Kunai",
		heavyAfterOne="FlickerCut",
		stringCancels={BodyFlicker=true,FlickerOut=true},
		blockCancels={Tool=true},
		-- The fastest re-entry on the widest angle, never twice the same side.
		reengage={name="flicker",speed=1.45,arrive=3,angle=55,shuffle=true,chase=.24,recovery=.14},
	},
	Serpent={
		routes={up="Launcher",down="Sweep",side="FeintStep",airUp="AirDrive",airDown="AirSpike",airSide="AirSwitch"},
		disengage="Kunai",
		heavyAfterOne="VenomFang",
		stringCancels={ShadowSnake=true},
		blockCancels={Tool=true},
		reengage={name="serpent",speed=1.0,arrive=3.6,angle=25,chase=.3,recovery=.2},
	},
	Medic={
		routes={up="Launcher",down="Sweep",side="CircleStep",airUp="AirDrive",airDown="AirSpike",airSide="AirSwitch"},
		disengage="Kunai",
		heavyAfterOne="ScalpelSlice",
		stringCancels={TendonCut=true,MendingRetreat=true},
		blockCancels={},
		reengage={name="medic",speed=1.0,arrive=3,angle=10,chase=.3,recovery=.2},
	},
}

local function attacks(move,list)
	RosterMoves.add(move,list,{
		-- Shisui: a flicker to the flank that keeps the string, the cut on arrival.
		FlickerStep={{.07,.1,.2,6,1.2,"HitStun",V(0,0,9),.3},{contact=3.4,range=6.5,width=5,zone="body",kind="slash",side=1,twist=40,lean=10,arm=90,step=1.1,orbit=40,chain=true}},
		-- (A stagger, not a knock-away: the body stays within a flicker's reach,
		-- so the awakening's chain flows from flank to flank.)
		FlickerCut={{.07,.12,.28,8,2.8,"HitStun",V(0,4,14),.5},{contact=3.6,range=6.8,zone="body",kind="slash",side=1,twist=60,lean=14,arm=100,step=1.2}},
		-- Orochimaru: a fang lunge (venom).
		VenomFang={{.09,.14,.32,8,3.4,"Knockback",V(0,8,40),.48},{contact=4,range=7.4,zone="body",kind="strike",side=1,twist=24,lean=26,arm=110,step=1.25,riders={Poison={Damage=1,Time=2.5,Every=.5}}}},
		-- Kabuto: a scalpel slice at the legs (slows).
		ScalpelSlice={{.1,.12,.32,9,3,"Knockback",V(0,8,42),.48},{contact=3.6,range=6.6,zone="legs",kind="palm",side=1,twist=20,lean=20,arm=100,step=1.2,riders={Slow={Scale=.7,Time=1.8}}}},
	})
end

return {
	fighters=fighters,
	graphs=graphs,
	attacks=attacks,
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND34">
        <Properties>
          <string name="Name">Wave3</string>
          <ProtectedString name="Source">-- Roster 20, batch 3 (DEC-022): Deidara, Sasori, Nagato, Killer Bee. This
-- batch's shared data, merged into Fighters, MoveGraphs and Attacks (see
-- Wave1). Young versions only: what each of them could already do then.
local RosterMoves=require(script.Parent.RosterMoves)
local V=Vector3.new

local fighters={}
-- Deidara (15, Iwa's Explosion Corps): moulded clay, C1 only. His loop is
-- set → threaten → detonate: birds and spiders that miss stay where they
-- stop as charges, a landmine is buried where he aims; a body that steps on
-- one is blasted, and "Katsu!" sets every one of them off from anywhere (and
-- pops the clay at his feet). Clay pellets as his tool.
-- No C2 dragon, no C4, no owl flight: later.
fighters.Clay = {
	Name = "Deidara", FullName = "Deidara", Age = 15, Title = "THE CLAY ARTIST", Color = { 236, 196, 90 },
	Routes = "↑ launcher  ·  ↓ sweep  ·  ←→ feint step  ·  heavy after one: clay pop (a blast that throws the body away)  ·  air: drive / spike / switch",
	Description = "Explosive clay, C1: birds, spiders, a landmine, a Katsu! burst. Art is an explosion — at range.",
	Health = 118, Chakra = 125, ChakraRegen = 8.2, Speed = 18.5, SprintScale = 1.1, JumpScale = 1.05, AirControlScale = 1.05, AccelerationScale = 1.0,
	CombatTravel = 0.95, CombatDamage = 0.9, DashScale = 1.0, GuardStrength = 0.1, PreferredRange = 16,
	ComboToolCancel = true, CombatStyle = "Control", Tool = "Kunai",
	-- Two clay pellets flicked from the palm; each one pops on contact.
	ToolMastery = { Kind = "kunai", Projectile = "clay", Count = 2, Speed = 80, Damage = 2.4, Recover = .7, Contact = { Knock = 18, Lift = 6 } },
	-- Awakening: art is an explosion. Every blast bites deeper, the clay comes
	-- cheaper and back sooner.
	-- Rule: his charges arm at once and a blast sets off every charge of his
	-- near it (a field of clay becomes a chain).
	Awakening = { Name = "ART IS AN EXPLOSION", Speed = 1.04, Damage = 1.1, Regen = 1.3, Cooldown = 0.7, ChainCharges = true, Color = { 255, 210, 120 } },
	Motion = { body = "Mirage", weapons = "none", springy = false,
		borrow = { ClayPop = "Heavy" },
		-- Cocky and side-on, one hand in the clay pouch at the hip, the other
		-- up with a bird already moulded in the palm.
		stance = {root={y=-.24,pitch=0,yaw=34},torso={pitch=-2,yaw=-14},head={pitch=-6,yaw=-20},
			ra={raise=-10,out=30,twist=-40,elbow=90,wrist=10},la={raise=70,out=-6,twist=-60,elbow=90,wrist=-20},
			rf={x=.22,z=.62,yaw=34},lf={x=-.08,z=-.56,yaw=-6},breath=.8,tempo=5} },
	AttackProfile = {
		Light1={startup=.96,recovery=.94,travel=.95},Light2={startup=.98,recovery=.94,travel=.95,kind="palm"},
		Light3={startup=1.02,recovery=1.0,impulseZ=58,kind="kick"},Heavy={startup=1.0},
		Launcher={startup=1.0,impulseY=54},DashAttack={startup=.96},Air1={startup=.96},Air2={startup=.98},
	},
	Skin = { 236, 214, 190 }, Hair = { 240, 210, 110 }, Outfit = { 60, 64, 80 },
	Techniques = {
