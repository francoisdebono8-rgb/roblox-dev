      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="ND3">
      <Properties>
        <string name="Name">NinjaDuel</string>
      </Properties>
      <Item class="ModuleScript" referent="ND4">
        <Properties>
          <string name="Name">AnimationBindings</string>
          <ProtectedString name="Source">-- After publishing the retargeted Bangla sequences under the experience owner,
-- replace these zeros with that owner's R15 animation IDs (not the original R6 IDs).
return {Punch=0,HardSmack=0,MegaPunch=0,Parry=0}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND5">
        <Properties>
          <string name="Name">Attacks</string>
          <ProtectedString name="Source">-- Bangla three-strike M1 foundation; air/grab/launch branches are Ninja Duel glue.
local Combo=require(script.Parent.BanglaCombo)
local function move(startup,active,recovery,damage,travel,reaction,impulse,stun)
 return {startup=startup,active=active,recovery=recovery,damage=damage,travel=travel,
  travelTime=startup+active,reaction=reaction or "HitStun",impulse=impulse or Vector3.new(0,0,7),stun=stun or 0.27,
  range=7.8,width=5.5,height=6,blockable=true}
end
local attacks={
 Light1=move(.09,.12,Combo.comboDelay-.22,Combo.Damage.Punch,3.2),
 Light2=move(.10,.12,Combo.comboDelay-.23,Combo.Damage.HardSmack,3.5),
 Light3=move(.12,.14,Combo.comboDelay-.26,Combo.Damage.MegaPunch,4.2,"Knockback",Vector3.new(0,14,50),.48),
 Heavy=move(.30,.17,.52,14,5.4,"Knockdown",Vector3.new(0,12,34),.68),
 Launcher=move(.17,.14,.28,8,3.2,"Launched",Vector3.new(0,58,13),1.18),
 DashAttack=move(.07,.15,.27,7,8.2,"HitStun",Vector3.new(0,3,13),.31),
 Air1=move(.08,.13,.18,6,2.8,"Juggled",Vector3.new(0,15,8),.62),
 Air2=move(.09,.14,.19,7,3.1,"Juggled",Vector3.new(0,10,12),.64),
 Slam=move(.15,.20,.38,11,2.8,"Knockdown",Vector3.new(0,-78,10),.86),
 Grab=move(.18,.14,.5,0,2,"Grabbed",Vector3.zero,.8),
 Throw=move(.12,.1,.34,10,0,"Knockdown",Vector3.new(0,18,48),.7),
 ThrowUp=move(.12,.1,.3,7,0,"Launched",Vector3.new(0,50,10),1.1),
 -- Character branches (directional input inside a confirmed string).
 -- Minato: a sidestep cut that swings him around the opponent's guard.
 AngleStep=move(.08,.1,.2,6,1.2,"HitStun",Vector3.new(0,0,9),.3),
 -- Itachi: a low spinning sweep that trades the string for a knockdown,
 -- and the palm that answers a successful Read.
 Sweep=move(.12,.14,.34,7,1.6,"Knockdown",Vector3.new(0,6,12),.62),
 CounterPalm=move(.05,.12,.3,10,2.6,"Knockback",Vector3.new(0,14,46),.5),
 -- From a wall run: a diving strike at the opponent (active window sized to the flight).
 WallDive=move(.1,.3,.32,9,0,"Knockdown",Vector3.new(0,10,30),.62),
 -- Neji: twin palms driven from the hips (heavy after one clean palm, or the
 -- counter after Rotation).
 PalmThrust=move(.11,.14,.34,10,3.4,"Knockback",Vector3.new(0,12,62),.52),
 -- Minato: a knee driven up into the body after one clean cut. The opponent is
 -- popped to waist height: continue on the ground, jump after it, or chase.
 KneeStrike=move(.08,.12,.3,7,2.6,"Juggled",Vector3.new(0,26,4),.62),
 -- Running taijutsu: out of a full sprint, a flying kick (strike) and a
 -- sliding sweep (heavy). The run is the wind-up; a whiff overshoots.
 FlyingKick=move(.1,.16,.32,9,10,"Knockback",Vector3.new(0,14,48),.5),
 -- Riposte: out of a clean block or a perfect dodge, an instant strike that
 -- opens the string (block -&gt; riposte -&gt; combo).
 Riposte=move(.05,.12,.26,8,2.6,"HitStun",Vector3.new(0,5,12),.36),
 -- Gaara: sand erupts under the opponent at range and throws them up.
 SandPillar=move(.27,.14,.5,9,0,"Launched",Vector3.new(0,54,4),1.1),
 SlideSweep=move(.12,.18,.38,8,11,"Knockdown",Vector3.new(0,8,18),.62),
 -- Lateral routes: Itachi's feint step (an afterimage stays, he reappears at
 -- the flank) and Neji's circular step onto a chakra point. Both keep the string.
 FeintStep=move(.1,.12,.22,6,0,"HitStun",Vector3.new(0,4,9),.34),
 CircleStep=move(.09,.12,.22,6,0,"HitStun",Vector3.new(0,3,8),.34),
 -- Air routes after an air hit: drive the body away (toward a wall), spike it
 -- into the floor (it bounces once), or vault to its other side.
 AirDrive=move(.08,.13,.22,7,3,"Knockback",Vector3.new(0,8,48),.5),
 AirSpike=move(.09,.12,.24,7,2,"Spiked",Vector3.new(0,-72,6),.9),
 AirSwitch=move(.1,.14,.2,6,0,"Juggled",Vector3.new(0,13,9),.6),
 -- Sasuke: an acrobatic rising kick he follows into the air, a vault over the
 -- opponent into a back kick, and the Chidori thrust (started by the jutsu).
 LionKick=move(.15,.14,.28,8,3,"Launched",Vector3.new(0,50,5),1.25),
 VaultKick=move(.12,.12,.24,7,0,"HitStun",Vector3.new(0,6,12),.36),
 ChidoriThrust=move(.04,.26,.62,22,15,"Knockback",Vector3.new(0,12,70),.7),
}

for name,spec in attacks do
 if not Combo.Actions[name] then spec.depth=spec.range*.8;spec.offset=spec.range*.4 end
 spec.animation=name;spec.feedback=spec.reaction;spec.chain=name=="Light1" or name=="Light2" or name=="Air1" or name=="Air2" or name=="DashAttack" or name=="AngleStep" or name=="Riposte"
  or name=="FeintStep" or name=="CircleStep" or name=="AirSwitch" or name=="VaultKick"
 spec.air=name=="Air1" or name=="Air2" or name=="AirDrive" or name=="AirSpike" or name=="AirSwitch"
end
-- Hitstop is not authored per move any more: weight comes from Combat.Hitstop so
-- a light jab cannot be given a heavy stop by accident.
local motion={
 Light1={side=1,twist=30,lean=8,arm=82,step=1.05},
 Light2={side=-1,twist=34,lean=10,arm=88,step=1.08},
 Light3={side=1,twist=72,lean=12,arm=102,step=1.2},
 Heavy={side=-1,twist=48,lean=25,arm=116,step=1.3},
 Launcher={side=1,twist=20,lean=-24,arm=112,step=1.15},
 DashAttack={side=1,twist=36,lean=28,arm=96,step=1.35},
 Air1={side=1,twist=38,lean=12,arm=98,step=1.1},
 Air2={side=-1,twist=44,lean=18,arm=104,step=1.15},
 Slam={side=1,twist=12,lean=46,arm=128,step=1.2},
 Grab={side=1,twist=10,lean=18,arm=72,step=1.05},
 Throw={side=1,twist=70,lean=22,arm=92,step=1.1},
 ThrowUp={side=-1,twist=28,lean=-30,arm=110,step=1.1},
 AngleStep={side=1,twist=40,lean=10,arm=90,step=1.1},
 Sweep={side=-1,twist=60,lean=20,arm=60,step=1.0},
 CounterPalm={side=1,twist=30,lean=16,arm=100,step=1.2},
 WallDive={side=1,twist=24,lean=42,arm=80,step=1.2},
 PalmThrust={side=1,twist=20,lean=18,arm=100,step=1.25},
 KneeStrike={side=1,twist=16,lean=14,arm=70,step=1.15},
 FlyingKick={side=1,twist=10,lean=-12,arm=60,step=1.3},
 Riposte={side=1,twist=24,lean=12,arm=92,step=1.2},
 SandPillar={side=1,twist=10,lean=-6,arm=120,step=1},
 SlideSweep={side=1,twist=14,lean=-20,arm=40,step=1.3},
 FeintStep={side=-1,twist=30,lean=10,arm=90,step=1.1},
 CircleStep={side=1,twist=40,lean=8,arm=90,step=1.05},
 AirDrive={side=1,twist=20,lean=-10,arm=60,step=1},
 AirSpike={side=1,twist=10,lean=40,arm=120,step=1},
 AirSwitch={side=-1,twist=60,lean=10,arm=80,step=1},
 LionKick={side=1,twist=10,lean=-30,arm=100,step=1.15},
 VaultKick={side=-1,twist=70,lean=10,arm=60,step=1.1},
 ChidoriThrust={side=1,twist=20,lean=30,arm=110,step=1.4},
}
for name,pose in motion do for key,value in pose do attacks[name][key]=value end end
for _,name in {"Light1","Light2","Light3"} do attacks[name].width=5;attacks[name].height=5;attacks[name].range=6 end
attacks.AngleStep.width=5;attacks.AngleStep.range=6.5;attacks.AngleStep.orbit=17
attacks.Sweep.height=3.5;attacks.Sweep.width=6.5;attacks.Sweep.range=6.5
attacks.WallDive.width=6;attacks.WallDive.height=8;attacks.WallDive.range=7.5;attacks.WallDive.facing=-.45
attacks.FlyingKick.range=7.5;attacks.FlyingKick.width=5.5
attacks.SandPillar.range=12.5;attacks.SandPillar.width=6;attacks.SandPillar.height=8;attacks.SandPillar.depth=11;attacks.SandPillar.offset=6;attacks.SandPillar.facing=.25
attacks.SlideSweep.range=7.5;attacks.SlideSweep.height=3.5;attacks.SlideSweep.width=6.5
attacks.FeintStep.width=5;attacks.FeintStep.range=6.5;attacks.FeintStep.orbit=34
attacks.CircleStep.width=5;attacks.CircleStep.range=6;attacks.CircleStep.orbit=28
attacks.AirSwitch.orbit=40;attacks.AirSwitch.width=6;attacks.AirSwitch.height=7
attacks.AirSpike.height=7;attacks.AirDrive.height=7
attacks.VaultKick.width=5.5;attacks.VaultKick.range=6.5;attacks.VaultKick.orbit=50
attacks.ChidoriThrust.range=7;attacks.ChidoriThrust.width=4.5
-- Where a strike lands and what it is: the victim's body answers the blow it
-- actually took (head snaps, body folds, legs are taken away, ...).
local ZONE={Light1="head",Light2="body",Light3="body",Heavy="body",Launcher="chin",DashAttack="body",Air1="body",Air2="head",
 Slam="body",AngleStep="body",Sweep="legs",CounterPalm="body",WallDive="body",PalmThrust="body",KneeStrike="body",FlyingKick="head",
 Riposte="head",SlideSweep="legs",SandPillar="legs",FeintStep="body",CircleStep="body",AirDrive="body",AirSpike="head",AirSwitch="head",
 LionKick="chin",VaultKick="head",ChidoriThrust="body",
 Throw="body",ThrowUp="body",Grab="body"}
local KIND={Light3="kick",Heavy="heavy",Launcher="launch",Air2="kick",Slam="slam",Sweep="sweep",SlideSweep="sweep",KneeStrike="knee",
 FlyingKick="kick",WallDive="kick",SandPillar="launch",AirDrive="kick",AirSpike="spike",AirSwitch="kick",PalmThrust="palm",CounterPalm="palm",
 LionKick="launch",VaultKick="kick",ChidoriThrust="heavy"}
for name,spec in attacks do spec.zone=ZONE[name] or "body";spec.kind=KIND[name] or "strike" end
attacks.Grab.range=4.6;attacks.Grab.blockable=false;attacks.Throw.blockable=false;attacks.ThrowUp.blockable=false
return attacks
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND6">
        <Properties>
          <string name="Name">BanglaCombo</string>
          <ProtectedString name="Source">-- Adapted from BanglaBattlegrounds StarterPack/Punch/PunchMoves (Dewan Mukto, MIT).
-- Input and cooldown authority moved to the server; no Tool or independent input loop.
local Combo={maxComboCount=3,comboDelay=.5,resetDelay=1.1}
function Combo.next(actor,now)
 local comboTimer=now-actor.lastAttack
 local comboCount=actor.combo
 local maxComboCount=Combo.maxComboCount
 local comboDelay=Combo.resetDelay
 -- Donor combo progression, retained verbatim with per-actor state.
 if comboTimer &lt;= comboDelay then
  comboCount = comboCount + 1
  if comboCount &gt; maxComboCount then
   comboCount = 1
  end
 else
  comboCount = 1
 end
 actor.combo=comboCount;actor.lastAttack=now
 return 'Light'..comboCount
end
Combo.Actions={Light1='Punch',Light2='HardSmack',Light3='MegaPunch'}
-- Donor server damageValues and Animation objects, never supplied by clients.
-- MegaPunch tuned 25 -&gt; 18 for Ninja Duel pacing (a three-hit string is no
-- longer a third of a health bar); Punch and HardSmack keep the donor values.
Combo.Damage={Punch=5,HardSmack=10,MegaPunch=18}
Combo.AnimationIds={Punch=18342131933,HardSmack=18342045122,MegaPunch=18341956985,Parry=18341905406}
return Combo
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND7">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">-- Tunable V0 values; no client-supplied balance values are accepted.
return {
	Version = "0.13.0-arena-combo",
	ArenaRadius = 101, ArenaHeight = 62, WalkSpeed = 19, JumpPower = 68, Chakra = 100,
	ChakraRegen = 9, GuardDrain = 19, GuardChip = 0.12,
	GuardBreak = 0.65, HitStun = 0.22, InterruptStun = 0.42,
	ComboReset = 1.05, MeleeRange = 7.6, MeleeFacing = 0.18,
	DodgeCost = 10, DodgeCooldown = 0.8, DodgeTime = 0.32, DodgeIFrames = 0.22,
	DodgeSpeed = 61, GuardSpeed = 8, ChannelSpeed = 7,
	ToolCost = 4, PursuitCost = 8, PursuitWindow = 0.85, PursuitRange = 46, PursuitSpeed = 74,
	-- Kawarimi: a limited escape that recharges. Usable while being hit (or
	-- grabbed, juggled, pinned), never as a neutral dodge. The attacker gets a
	-- short window to track the reappearance.
	Substitution = {Cost = 15, Charges = 2, Recharge = 9, Cooldown = 1.1, Window = 0.42, Distance = 8, Track = 0.75},
	-- Damage scaling inside one combo: the first hits land in full, every later
	-- hit is worth less, and a combo that runs too long ends in a knockdown.
	ComboScaling = {Free = 2, Step = 0.12, Floor = 0.35, Reset = 0.45, MaxHits = 11},
	Clash = {Window = 0.07, Push = 4.5},
	-- Chakra dash (E outside a chase window): a committed burst at the opponent.
	Rush = {Cost = 10, Speed = 90, Range = 48, MinRange = 7, MaxTime = 0.55, Cooldown = 0.9, Arrive = 0.3},
	-- Awakening: once per match, at low health, a fighter-specific power-up.
	Awaken = {Threshold = 0.35, Duration = 12},
	-- Rhythm: a chained strike pressed on the beat (not mashed early) is a Flow strike.
	Flow = {Early = 0.07, Late = 0.13, Damage = 1.15, Stop = 0.035},
	ThrowBreak = 0.35,
	RoundsToWin = 2,
	-- Where each fighter starts (studs from the centre): far enough apart that
	-- the round opens on an approach, not on a punch.
	StartDistance = 24,
	-- Server-side Animator playback (donor clips, default locomotion). Off: the
	-- client motion engine animates every body.
	DonorAnimations = false,
	Wall = {Detect = 3.4, Clearance = 1.7, RiseSpeed = 23, SideSpeed = 30, MaxTime = 1.65,
		ReboundUp = 61, ReboundAway = 29, ReattachDelay = 0.4,
		-- Wall combat: splat state, pins, tech window and the dive from a wall run.
		SplatSpeed = 17, SplatTime = 0.62, SplatDamage = 3, PinTime = 0.42, PinMax = 2,
		TechFrom = 0.05, TechUntil = 0.34, TechCost = 12, DiveRange = 50},
	RequestRate = 24, RequestBurst = 32, SnapshotInterval = 0.066,
	Movement = { SprintSpeed = 45, GroundAcceleration = 170, GroundDeceleration = 290, TurnAcceleration = 360, AirAcceleration = 76,
		BurstAcceleration = 520, BurstWindow = 0.16,
		JumpVelocity = 72, JumpCooldown = 0.4, AttackWalkSpeed = 12, HardLandVelocity = 56,
		HardLandRecovery = 0.14, SoftLandRecovery = 0.04, HardLandSpeed = 14,
		MeleeTravelTime = 0.28, PursuitRecovery = 0.22 },
	AI = { Tick = 0.18, Reaction = 0.38, Aggression = 0.72, Defense = 0.58, Technique = 0.34 },
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND8">
        <Properties>
          <string name="Name">Controls</string>
          <ProtectedString name="Source">-- Semantic bindings shared by client, HUD and QA.
-- Keyboard is grouped around WASD so combat never needs a reach across the board;
-- the face buttons keep the existing gamepad layout and RB remains the jutsu modifier.
return {
	Keyboard = {
		-- Home row first: the actions used constantly sit under the left hand and
		-- the mouse, and substitution stays deliberately out of the way on X.
		Light = Enum.UserInputType.MouseButton1,
		Heavy = Enum.UserInputType.MouseButton2,
		Jump = Enum.KeyCode.Space,
		Dodge = Enum.KeyCode.Q,
		Guard = Enum.KeyCode.F,
		Grab = Enum.KeyCode.V,
		Tool = Enum.KeyCode.R,
		Pursuit = Enum.KeyCode.E,
		Substitute = Enum.KeyCode.X,
		Feint = Enum.KeyCode.G,
		WallDetach = Enum.KeyCode.C,
		Lock = Enum.KeyCode.LeftShift,
		Sprint = Enum.KeyCode.LeftControl,
		Technique5 = Enum.KeyCode.Five,
		Awaken = Enum.KeyCode.T,
		Skip = Enum.KeyCode.Escape,
	},
	Gamepad = {
		Light = Enum.KeyCode.ButtonX,
		Heavy = Enum.KeyCode.ButtonY,
		Jump = Enum.KeyCode.ButtonA,
		Dodge = Enum.KeyCode.ButtonB,
		Guard = Enum.KeyCode.ButtonL1,
		Tool = Enum.KeyCode.ButtonR2,
		Grab = Enum.KeyCode.ButtonL2,
		Lock = Enum.KeyCode.ButtonR3,
		Sprint = Enum.KeyCode.ButtonL3,
		Modifier = Enum.KeyCode.ButtonR1,
		Technique5 = Enum.KeyCode.DPadUp,
		Awaken = Enum.KeyCode.DPadDown,
		Rush = Enum.KeyCode.DPadLeft,
		Skip = Enum.KeyCode.ButtonSelect,
	},
	-- Human-readable key names so HUD and tutorial copy cannot drift from bindings.
	KeyLabel = {
		Light = "LMB", Heavy = "RMB", Jump = "SPACE", Dodge = "Q", Guard = "F",
		Grab = "V", Tool = "R", Pursuit = "E", Substitute = "X", Feint = "G",
		WallDetach = "C", Lock = "SHIFT", Sprint = "CTRL", Technique5 = "5", Awaken = "T", Skip = "ESC",
	},
	-- HUD copy for the keyboard layout, kept next to the bindings it documents.
	Hint = "LMB light \u{00B7} RMB heavy",
	Help = "WASD move   SPACE jump   Q dodge   LMB light   RMB heavy   F guard   V grab / throw break   E chase / chakra dash   R tool   X substitute   G feint   T awaken   CTRL sprint   SHIFT lock   1-5 jutsu",
	-- The directional combo grammar, shared by every fighter.
	Grammar = "STRINGS  2 hits + W (toward) = launcher  ·  2 hits + S (away) = low sweep  ·  A/D = side route  ·  after an air hit: W drive · S spike · A/D switch  ·  S + R in a string = hop out",
	GrammarPad = "STRINGS  2 hits + ↑ (toward) = launcher  ·  2 hits + ↓ (away) = low sweep  ·  ← → = side route  ·  after an air hit: ↑ drive · ↓ spike · ← → switch  ·  ↓ + RT in a string = hop out",
	HelpPad = "LS move / sprint   RS camera / lock   X light   Y heavy   B dodge   A jump / chase   LB guard   LT grab   RT tool   RB + face jutsu   D-pad: up jutsu 5 · left chakra dash · down awaken",
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND9">
        <Properties>
          <string name="Name">Fighters</string>
          <ProtectedString name="Source">return {
	Flashstep = {
		Name = "Minato", FullName = "Minato Namikaze", Age = 13, Title = "THE FAST PRODIGY", Color = { 82, 177, 244 },
		Routes = "↑ rising kick (seals the body: 2 follows it up)  ·  ↓ spinning leg sweep (plants a marked kunai)  ·  ←→ angle step  ·  air: push kick / axe kick / flash switch",
		Description = "Decision speed. Kunai placement, angle changes and an unfinished teleport seal.",
		Health = 125, Chakra = 110, ChakraRegen = 8, Speed = 19.5, SprintScale = 1.12, JumpScale = 1.1, AirControlScale = 1.15, AccelerationScale = 1.15,
		CombatTravel = 1.18, CombatDamage = 1, DashScale = 1.15, GuardStrength = 0.10, PreferredRange = 6,
		ComboToolCancel = true, CombatStyle = "Angles", Tool = "Kunai",
		-- Shared ninja tools: everyone throws; mastery changes what a throw does.
		-- Minato: one fast kunai, the quickest recovery (the seals are his art).
		ToolMastery = { Kind = "kunai", Count = 1, Speed = 96, Damage = 3, Recover = .55 },
		-- Awakening: the Yellow Flash. Faster legs, techniques back almost at once.
		Awakening = { Name = "YELLOW FLASH", Speed = 1.18, Damage = 1.05, Regen = 1.5, Cooldown = 0.4, Color = { 255, 214, 92 } },
		AttackProfile = {
			Light1={startup=.82,recovery=.9,travel=1.08,angle=.24},Light2={startup=.84,recovery=.9,travel=1.12,angle=-.3},
			Light3={startup=.82,recovery=.88,travel=1.2,angle=.36,impulseZ=52},Launcher={startup=.72,travel=1.16,impulseY=62},
			DashAttack={startup=.78,travel=1.16,angle=-.18},Air1={startup=.8,angle=.24},Air2={startup=.82,angle=-.3},Slam={startup=.78,recovery=.86},
		},
		Skin = { 225, 196, 166 }, Hair = { 225, 228, 212 }, Outfit = { 45, 104, 156 },
		Techniques = {
			-- Thrown while running: the seal travels as a real kunai and can be
			-- reached mid-flight by Flying Thunder God.
			{ Id = "MarkedBlade", Name = "Marked Kunai", Mobile = true, Throw = "MarkedKunai", Cost = 10, Channel = 0.12, Active = 0.02, Recovery = 0, Cooldown = 2.2, Interruptible = true, Range = 66, Damage = 6, Hint = "Two seals planted at once • a hit seals the body" },
			{ Id = "Flashstep", Name = "Flying Thunder God", Cost = 16, Channel = 0.06, Active = 0.04, Recovery = 0.2, Cooldown = 1.5, Interruptible = true, Range = 90, Requires = "Anchor", Hint = "Stick picks the seal and the side • strike or 3 on arrival" },
			{ Id = "BurstStrike", Name = "Rasengan", Cost = 24, Channel = 0.3, Active = 0.08, Recovery = 0.5, Cooldown = 5.5, Interruptible = true, Range = 8, Damage = 20, Hint = "Instant after a teleport • plunges when airborne • ends a clean string" },
			{ Id = "Quickstep", Name = "Quickstep", Cost = 12, Channel = 0.11, Active = 0.08, Recovery = 0.21, Cooldown = 2.3, Interruptible = true, Range = 12, Hint = "Create an angle • no guaranteed hit" },
			{ Id = "WindCut", Name = "Wind Cut", Element = "Wind", Cost = 18, Channel = 0.32, Active = 0.1, Recovery = 0.34, Cooldown = 3.7, Interruptible = true, Range = 36, Damage = 7, Hint = "Displace with a cutting gust" },
		},
	},
	Mirage = {
		Name = "Itachi", FullName = "Itachi Uchiha", Age = 13, Title = "THE SHARINGAN PRODIGY", Color = { 222, 70, 80 },
		Routes = "↑ rising palm (shuriken cover the climb)  ·  ↓ reaping sweep  ·  ←→ feint step (an afterimage stays)  ·  air: side kick / hammer drop / hook switch",
		Description = "Sharingan already awakened. Reads, precise shuriken, deception and Katon fire.",
