      <Item class="ModuleScript" referent="ND50">
        <Properties>
          <string name="Name">ArenaMeshes</string>
          <ProtectedString name="Source">-- The stadium's scenery made in Blender (stage 5, user 29/10: the arena,
-- "stade Chûnin, original"). tools/blender/arena_assets.py models each asset
-- around its own origin; Studio's importer uploads them;
-- tools/blender/arena_to_luau.py writes Server/ArenaMeshData (per asset: the
-- pieces' mesh, offset from the asset's origin, size, colour, material).
-- Each mesh is made once at server start; World.arena places assets with
-- ArenaMeshes.place. Until they are ready (or headless) World keeps its
-- part-built decor. Gameplay never depends on these: they are visual only
-- (no collision, no queries); walls, balcony, cover and breakables stay parts.
local ArenaMeshes={templates={},state="idle"}
local ok,Data=pcall(require,script.Parent.ArenaMeshData)
if not ok then Data={} end
ArenaMeshes.Data=Data

local OPTIONS=nil
pcall(function() OPTIONS={RenderFidelity=Enum.RenderFidelity.Precise,CollisionFidelity=Enum.CollisionFidelity.Box} end)

function ArenaMeshes.preload()
	if ArenaMeshes.state~="idle" then return end
	local okService,AssetService=pcall(function() return game:GetService("AssetService") end)
	if not okService or not AssetService or not AssetService.CreateMeshPartAsync then return end
	local list={}
	for _,pieces in Data do for _,piece in pieces do table.insert(list,piece) end end
	if #list==0 then return end
	ArenaMeshes.state="loading"
	local left,failed=#list,false
	for _,piece in list do
		task.spawn(function()
			local good,part=pcall(function() return AssetService:CreateMeshPartAsync(piece.mesh,OPTIONS) end)
			if good and part then
				ArenaMeshes.templates[piece.mesh]=part
			else
				failed=true
				warn("[ArenaMeshes] "..piece.name..": "..tostring(part))
			end
			left-=1
			if left==0 then ArenaMeshes.state=if failed then "failed" else "ready" end
		end)
	end
end

function ArenaMeshes.ready()
	return ArenaMeshes.state=="ready"
end

-- Place one asset at cf (its origin), uniformly scaled; color/material
-- override every piece when given (one shape, several grounds). Returns the parts.
function ArenaMeshes.place(parent,asset,cf,scale,color,material)
	local pieces=Data[asset]
	if not pieces then return {} end
	scale=scale or 1
	local made={}
	for _,piece in pieces do
		local template=ArenaMeshes.templates[piece.mesh]
		if template then
			local p=template:Clone()
			p.Name=asset.."_"..piece.name
			p.Size=piece.size*scale
			p.CFrame=cf*CFrame.new(piece.offset*scale)
			p.Color=color or piece.color
			p.Material=material or Enum.Material[piece.material or "SmoothPlastic"] or Enum.Material.SmoothPlastic
			p.Anchored=true;p.CanCollide=false;p.CanQuery=false;p.CanTouch=false
			p.Parent=parent
			table.insert(made,p)
		end
	end
	return made
end

return ArenaMeshes
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND51">
        <Properties>
          <string name="Name">BanglaCombat</string>
          <ProtectedString name="Source">-- Adapted from BanglaBattlegrounds ServerScriptService/StarterCombat.
-- Copyright (c) 2024 Dewan Mukto, MIT (vendor/bangla/LICENSE).
-- Retained: forward hitbox, per-swing Hits, damage table, parry seam, hit counter,
-- BasicPunch emission and swing/contact sounds. Changes: one validated actor API,
-- deterministic broadphase for anchored hitboxes, active-window lifetime/cleanup,
-- collision occlusion, and Ninja Duel's guard/chakra/damage authority.
local Debris=game:GetService('Debris')
local assets=game:GetService('ReplicatedStorage').NinjaDuel:WaitForChild('BanglaAssets')
local Combo=require(game:GetService('ReplicatedStorage').NinjaDuel.BanglaCombo)
local Config=require(game:GetService('ReplicatedStorage').NinjaDuel.Config)
local Bangla={}
local function sound(parent,id)
 local s=Instance.new('Sound');s.SoundId=id;s.Volume=.5;s.Parent=parent
 s:Play();Debris:AddItem(s,1.5)
end
function Bangla.begin(c,a,p)
 local hitbox=Instance.new('Part')
 hitbox.Name='BanglaHitbox';hitbox.Anchored=true;hitbox.CanCollide=false
 hitbox.CanQuery=false;hitbox.CanTouch=false;hitbox.Transparency=1
 hitbox.Size=Vector3.new(5,5,2)
 hitbox.CFrame=a.root.CFrame*CFrame.new(0,0,-2)
 hitbox.Parent=c.match.effects
 p.donor={hitbox=hitbox,Hits={},action=Combo.Actions[p.name] or 'MegaPunch'}
 -- The donor used Debris for lifetime; c.effects also cleans interrupted swings.
 -- (13/11, #72: the Chidori dive off the wall missed a body 40 studs away)
 -- A sized window (the wall dive's flight, the slam's descent: p.slamWindow,
 -- Combat's Active) keeps the hitbox for the whole of it, not the authored
 -- active alone: the dive arrived after the box was gone.
 local window=math.max(p.spec.active,p.slamWindow or 0)
 table.insert(c.effects,{part=hitbox,expires=c.now+p.spec.startup+window+.05})
 sound(a.root,'rbxassetid://5835032207')
 a.model:SetAttribute('CombatBase','BanglaBattlegrounds')
end
function Bangla.close(p)
 if p and p.donor then p.donor.hitbox:Destroy() end
end
function Bangla.tryHit(c,a,p)
 local donor=p.donor;local target=a.target
 if not donor or not donor.hitbox.Parent or not target or target.health&lt;=0 then return false end
 -- Same donor forward volume; missing air/grab mechanics supply their bounded shape.
 local hitbox=donor.hitbox
 hitbox.Size=Vector3.new(p.spec.width or 5,p.spec.height or 5,p.spec.depth or 2)
 -- A strike carried out by another body (Ninja Duel Bodies: Naruto's clone)
 -- is thrown, validated and judged from that body's frame (p.from).
 local frame=p.from or a.root.CFrame
 hitbox.CFrame=frame*CFrame.new(0,0,-(p.spec.offset or 2))
 local params=OverlapParams.new();params.FilterType=Enum.RaycastFilterType.Include
 params.FilterDescendantsInstances={target.model}
 -- Touched on a teleported anchored part was unreliable; query the same volume.
 for _,hit in workspace:GetPartBoundsInBox(hitbox.CFrame,hitbox.Size,params) do
  if hit:IsDescendantOf(target.model) and not donor.Hits[target.id] then
   -- (07/11, game feel) only what is in front of the blow (Config.Contact).
   if not c:targetValid(a,target,p.spec.range,p.spec.facing or Config.Contact.Facing,p.from) then continue end
   -- (13/11, #72: the Chidori dive at a body getting up) The rising body's
   -- short protection lets a strike pass, it does not spend it: a strike
   -- still out when he is up lands (a dodge or a substitution still eats it).
   if target.reaction=="Wakeup" and (target.invulnerableUntil or 0)&gt;c.now then continue end
   donor.Hits[target.id]=true
   local delta=frame.Position-target.root.Position
   local frontal=delta.Magnitude&lt;.001 or target.root.CFrame.LookVector:Dot(delta.Unit)&gt;.15
   local guarded=target.state=='Guarding' and target.chakra&gt;0 and frontal
   local protected=target.state=='TechniqueChannel' and target.pending and not target.pending.spec.Interruptible
   local damage=if Combo.Actions[p.name] then Combo.Damage[donor.action] else p.spec.damage
   c.damageTag=if p.rasengan then "Rasengan" else p.name
   -- A Flow strike (chained on the beat) lands a little harder.
   local flow=if p.flow then require(game:GetService("ReplicatedStorage").NinjaDuel.Config).Flow.Damage else 1
   if p.from then c.hitOrigin=frame.Position end
   local success=c:damage(a,target,damage*(a.def.CombatDamage or 1)*flow*(p.spec.damageScale or 1),false,true)
   if p.from then c.hitOrigin=nil end
   c.damageTag=nil
   -- The defence resolution (guard, Byakugan sight, guard break) is the truth.
   if success then guarded=target.impactStyle=='block' end
   -- A Gentle Fist palm is not a punch: no donor fist burst on the body (the
   -- client strikes the chakra point itself, IdentityFX).
   if success and not a.def.GentleFist then
    -- Contact audio comes from the client's impact feed (VelmoraHitFeedback);
    -- a replicated server Sound here doubled every hit, out of sync.
    local vfx=if donor.action=='MegaPunch' then 'ComboPunch' else 'BasicPunch'
    local basicPunch=assets.VFX[vfx].Attachment:Clone()
    basicPunch.Parent=target.root
    for _,v in basicPunch:GetChildren() do
     if v:IsA('ParticleEmitter') then v:Emit(v:GetAttribute('EmitCount') or 1) end
    end
    Debris:AddItem(basicPunch,.25)
   end
   if success then
    if c.now-(a.donorLastHit or -10)&gt;2 then a.donorHitCount=0 end
    a.donorHitCount=(a.donorHitCount or 0)+1;a.donorLastHit=c.now
   end
   return success,guarded,protected
  end
 end
 return false
end
return Bangla
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND52">
        <Properties>
          <string name="Name">BanglaEvade</string>
          <ProtectedString name="Source">-- performEvade from Bangla WalkRunHandler (Dewan Mukto, MIT), adapted.
-- One finite server tick loop replaces leaked RenderStepped connections. No global
-- gravity change; swept travel preserves walls, lane boundaries and root facing.
local Evade={}
function Evade.begin(a,c)
 local direction=if a.move.Magnitude&gt;.1 then a.move.Unit else a.root.CFrame.RightVector
 local evadeDistance=14*(a.def.DashScale or 1)
 local evadeDuration=.32
 -- Movement overhaul (docs/movement/MOVEMENT_OVERHAUL_AUDIT.md): the speed the
 -- body had going in is handed back on the way out, so a dodge inside a run
 -- flows back into the run (or an attack) instead of stopping dead.
 local v=a.root.AssemblyLinearVelocity
 local entry=math.max(Vector3.new(v.X,0,v.Z).Magnitude,(a.locomotion or Vector3.zero).Magnitude)
 -- Locked near the opponent, a side or back dodge is a sidestep / hop away
 -- that keeps the chest on them (Studio: turning into it made every dodge read
 -- as a forward dash, and hid the acrobatic bodies' cartwheel / handspring).
 local keep=false
 if a.locked~=false and a.target and a.target.root then
  local to=a.target.root.Position-a.root.Position;to=Vector3.new(to.X,0,to.Z)
  -- Not out of a committed run away (sprint, or travel facing the way it goes,
  -- Combat:faceLocked): running off, the dodge stays a dash along the run.
  keep=to.Magnitude&lt;40 and to.Magnitude&gt;.1 and direction:Dot(to.Unit)&lt;.5 and not a.sprinting and not a.facingCommitted
 end
 a.evade={startPosition=a.root.Position,targetPosition=a.root.Position+direction*evadeDistance,startTime=c.now,duration=evadeDuration,direction=direction,entry=entry,keep=keep}
end
-- Exit with momentum: at least a running pace along the dodge, at most the
-- sprint, never more than it came in with plus a run (no free speed). Called
-- when the evade runs out and when the dodge state ends first.
function Evade.finish(a)
 local e=a.evade;if not e then return end
 a.evade=nil
 local walk=(a.def.Speed or 18)
 local carry=math.min(math.max(e.entry or 0,walk),walk+(e.entry or 0),45*(a.def.SprintScale or 1))
 local out=e.direction*carry
 a.evadeCarry=out
 local v=a.root.AssemblyLinearVelocity
 a.root.AssemblyLinearVelocity=Vector3.new(out.X,v.Y,out.Z)
end
function Evade.step(a,c,travel)
 local e=a.evade;if not e then return end
 local rootPart=a.root
 local targetPosition=e.targetPosition
 local evadeDuration=e.duration
 local startTime=e.startTime
 local elapsedTime=c.now-startTime
 if elapsedTime&lt;evadeDuration then
  local t=math.clamp(elapsedTime/evadeDuration,0,1)
  -- Fast launch, soft brake: distance stays deterministic without the donor's
  -- moving-origin snap near the end of the evade. Quadratic, not cubic: the
  -- cubic left at 3x the mean speed (~2 studs in the first frame), which read
  -- as a pop in Studio; same distance and duration.
  local eased=1-(1-t)^2
  local position=e.startPosition:Lerp(targetPosition,eased)
  local delta=position-rootPart.Position
  travel(a,c,delta,delta.Magnitude)
  -- Turn into the dash at a bounded rate instead of snapping 90 degrees in a frame.
  local dt=math.max(1/240,c.now-(e.lastAt or startTime));e.lastAt=c.now
  -- Only a forward-ish dodge turns the body into it (Studio, §20 route: a side
  -- dodge out of a sprint swung the root 90 degrees and back in 0.3 s, a
  -- pivot that also hid the cartwheel); sideways or back, the body keeps its
  -- facing and the dodge reads as a sidestep / hop back (or the acrobatics).
  local look=rootPart.CFrame.LookVector;look=Vector3.new(look.X,0,look.Z)
  local ahead=look.Magnitude&lt;.05 or e.direction:Dot(look.Unit)&gt;.3
  if e.direction.Magnitude&gt;.1 and not e.keep then if ahead then c:turnToward(a,e.direction,dt,900) end
  elseif e.keep and a.target and a.target.root then
   -- Chest held on them through the sidestep / hop away (small corrections).
   local to=a.target.root.Position-rootPart.Position
   to=Vector3.new(to.X,0,to.Z)
   if to.Magnitude&gt;.1 then c:turnToward(a,to,dt,900) end
  end
  rootPart.AssemblyLinearVelocity=Vector3.zero
 else Evade.finish(a) end
end
return Evade
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND53">
        <Properties>
          <string name="Name">Bodies</string>
          <ProtectedString name="Source">-- Light bodies that are not actors (roster hook H12): Naruto's shadow clones
-- first; Sasori's puppet and Kakashi's ninken (Server/Hounds) take the same
-- path. A body under the floor (`buried`: a hound digging) cannot be struck. A body is a
-- point on the stage with a small controller, a lifetime and a hit volume:
-- one blow from the other side (a strike, a blade, a dome) dispels it.
-- It never becomes a target, a lock-on or a camera subject: Combat keeps its
-- two actors. Bodies only add strike origins (a blow is judged from where the
-- body stands, through Combat hitOrigin, so a frontal guard does not cover a
-- clone behind) and volumes the opponent's strikes and blades reach first.
-- The client draws them from the snapshot (`bodies`, Client/BodyViews).
--
-- Data: Fighters[id].Bodies[kind] = {Max, Cost, Life, ...} (Max counts the
-- persistent bodies; a body made for one strike is `ephemeral`).
-- Persist=true: a body that carried a strike returns to its own controller
-- instead of being spent (a marionette, not a one-strike clone).
-- MoveGraphs[id].proxy[move] = {move, body, summon, solo, awake}: a strike
-- another body carries out (Bodies.route / Bodies.bind); Attacks[move].proxy
-- says where it stands ("behind", "side", "under").
local Bodies={}
Bodies.RADIUS=1.2 -- horizontal reach of a body's volume
Bodies.HALF=2.7 -- half height around its root (feet to head)
-- Kit hooks, filled by fighter modules (Server/Legion): a controller per
-- mode, what a dispel of a kind does, what a transforming tool becomes.
Bodies.controllers={}
Bodies.onDispel={}
Bodies.transforms={}
-- Jutsu volumes go through a body (it puffs away, the jutsu carries on);
-- blades stop in it.
local VOLUME={fireball=true,phoenix=true,palm=true,wind=true,sandwave=true}
local function flat(v) return Vector3.new(v.X,0,v.Z) end
local function brawler() return require(script.Parent.Brawler) end
local function list(c) c.bodies=c.bodies or {};return c.bodies end
Bodies.list=list
function Bodies.tuning(a,kind)
	-- (06/11) A jutsu Kakashi copied makes its owner's bodies (Server/Copy).
	return (a.def.Bodies and a.def.Bodies[kind]) or (a.borrowedBodies and a.borrowedBodies[kind]) or {}
end
-- An awakening that takes the bodies away (Naruto's Nine-Tails cloak).
function Bodies.blocked(c,a)
	local tune=a.def.Awakening
	return tune~=nil and tune.NoBodies==true and (a.awakenUntil or 0)&gt;c.now
end
-- Live bodies of `a` (of one kind), persistent ones only unless asked.
function Bodies.of(c,a,kind,ephemeral)
	local out={}
	for _,body in c.bodies or {} do
		if body.alive and body.owner==a and (not kind or body.kind==kind) and (ephemeral or not body.ephemeral) then table.insert(out,body) end
	end
	return out
end
function Bodies.count(c,a,kind) return #Bodies.of(c,a,kind) end
-- (06/11) A crowd (Naruto's Multi Shadow Clone): persistent bodies flagged
-- `crowd`, capped apart from Max (tuning Crowd).
function Bodies.crowd(c,a,kind)
	local out={}
	for _,body in c.bodies or {} do
		if body.alive and body.crowd and body.owner==a and (not kind or body.kind==kind) then table.insert(out,body) end
	end
	return out
end
-- A persistent body free for a job (not already carrying a strike or shaping
-- a jutsu): the one nearest the owner's target.
function Bodies.free(c,a,kind)
	local best,bestGap
	local t=a.target
	for _,body in Bodies.of(c,a,kind) do
		if not body.carry and body.mode~="shape" and body.mode~="spent" then
			local gap=if t then (body.position-t.root.Position).Magnitude else 0
			if not bestGap or gap&lt;bestGap then best,bestGap=body,gap end
		end
	end
	return best
end
function Bodies.face(body,point)
	local d=flat(point-body.position)
	if d.Magnitude&gt;.1 then body.look=d.Unit end
end
-- Kinematic motion toward a point (bodies do not collide with fighters).
function Bodies.move(c,body,goal,speed,dt)
	local to=goal-body.position
	local step=speed*dt
	body.position=c:clamp(if to.Magnitude&lt;=step then goal else body.position+to.Unit*step)
end
function Bodies.spawn(c,owner,spec)
	local kind=spec.kind or "clone"
	if spec.crowd then
		if #Bodies.crowd(c,owner,kind)&gt;=(Bodies.tuning(owner,kind).Crowd or 0) then return nil end
	elseif not spec.ephemeral and Bodies.count(c,owner,kind)&gt;=(Bodies.tuning(owner,kind).Max or 2) then return nil end
	c.bodySerial=(c.bodySerial or 0)+1
	local position=c:clamp(spec.position or owner.root.Position)
	local look=spec.look
	if not look then
		local t=owner.target
		look=flat(if t then t.root.Position-position else owner.root.CFrame.LookVector)
		look=if look.Magnitude&gt;.1 then look.Unit else Vector3.new(0,0,-1)
	end
	local body={id=c.bodySerial,owner=owner,kind=kind,position=position,look=look,born=c.now,expires=c.now+(spec.life or Bodies.tuning(owner,kind).Life or 6),
		alive=true,state=spec.state or "Neutral",action=spec.action,actionAt=c.now,actionSerial=if spec.action then 1 else 0,mode=spec.mode or "guard",
		ephemeral=spec.ephemeral==true,velocity=Vector3.zero,airborne=spec.airborne==true,side=spec.side or 1,nextStrike=c.now+(spec.delay or 1),warp=0,
		crowd=spec.crowd==true or nil}
	table.insert(list(c),body)
	-- (A crowd pops in a ripple: the client sounds one puff in three.)
	c:pushImpact(position,"body",false,{phase="appear",kind=kind,body=body.id,owner=owner.id,fighter=owner.fighterId,crowd=body.crowd})
	brawler().event(c,owner,"BodySpawned")
	return body
end
-- Gone in a puff of smoke. why: "hit", "blade", "area", "expire", "spent"
-- (its strike is over), "swap" (a substitution), "cloak", "owner".
function Bodies.dispel(c,body,why,by,extra)
	if not body.alive then return false end
	body.alive=false
	local all=c.bodies
	local index=all and table.find(all,body)
	if index then table.remove(all,index) end
	if body.carry then body.carry.lost=true;body.carry.from=nil;body.carry=nil end
	local entry={phase=why or "hit",kind=body.kind,body=body.id,owner=body.owner.id,fighter=body.owner.fighterId,by=by and by.id,crowd=body.crowd}
	for k,v in extra or {} do entry[k]=v end
	c:pushImpact(body.position,"body",why=="hit" or why=="blade",entry)
	local hook=Bodies.onDispel[body.kind]
	if hook then hook(c,body,why,by) end
	local Brawler=brawler()
	Brawler.event(c,body.owner,"BodyLost")
	if by and by~=body.owner then
		Brawler.event(c,by,"BodyDispelled")
		c:cue(by,string.upper(body.kind).." DISPELLED",.5)
	end
	return true
end
-- A real relocation (a body flickering across the stage): the client snaps.
function Bodies.warp(c,body,at)
	c:pushImpact(body.position,"body",false,{phase="vanish",kind=body.kind,body=body.id,owner=body.owner.id,fighter=body.owner.fighterId})
	body.position=c:clamp(at);body.warp+=1
	c:pushImpact(body.position,"body",false,{phase="appear",kind=body.kind,body=body.id,owner=body.owner.id,fighter=body.owner.fighterId})
end
-- Where a carried strike is thrown from (Attacks[move].proxy): "behind" the
-- target (the far side from its owner), "side" (the flank the stick asked
-- for), "under" (in close beside it, for a launcher). On the ground.
function Bodies.place(c,a,how,side)
	local b=a.target
	local at=b.root.Position
	local line=flat(at-a.root.Position)
	line=if line.Magnitude&gt;.1 then line.Unit else flat(a.root.CFrame.LookVector).Unit
	local right=line:Cross(Vector3.yAxis)
	local s=if side and side~=0 then side else 1
	local p
	if how=="behind" then p=at+line*2.7
	elseif how=="side" then p=at+right*s*2.9
	else p=at-line*1.9+right*s*1.3 end
	return c:clamp(Vector3.new(p.X,c.match.origin.Y+3,p.Z))
end
-- Which move a press actually starts (Brawler.start): the proxy move with
-- the body that carries it (a free one, or "summon" for its cost), its
-- awakened form, or the solo move when there is no body to carry it.
function Bodies.route(c,a,name)
	local graph=brawler().graph(a)
	local d=graph and graph.proxy and graph.proxy[name]
	if not d then return name end
	if (a.awakenUntil or 0)&gt;c.now and d.awake then return d.awake end
	if not Bodies.blocked(c,a) then
		local free=Bodies.free(c,a,d.body)
		if free then return d.move,free,d.body end
		if d.summon and a.chakra&gt;=(Bodies.tuning(a,d.body).Cost or 12) then return d.move,"summon",d.body end
	end
	return d.solo or name
end
-- The strike's body goes to its spot (a summoned one appears there in a
-- puff, an existing one runs, or flickers from far away) and the strike is
-- judged from it: `p.from` is its frame, kept current by Bodies.step.
function Bodies.bind(c,a,p,proxy,kind)
	local spec=p.spec
	p.side=if (a.angleSide or 0)~=0 then a.angleSide else 1
	local at=Bodies.place(c,a,spec.proxy,p.side)
	local body=proxy
	local span=spec.startup+spec.active+spec.recovery
	if proxy=="summon" then
		a.chakra=math.max(0,a.chakra-(Bodies.tuning(a,kind).Cost or 12))
		body=Bodies.spawn(c,a,{kind=kind,position=at,ephemeral=true,life=span+.6,mode="carry"})
		if not body then p.lost=true;return nil end
	elseif (at-body.position).Magnitude&gt;14 then
		Bodies.warp(c,body,at)
	end
	-- A persistent body that keeps its own job after the strike (tuning
	-- Persist: Sasori's marionette) goes back to it; others are spent.
	if proxy~="summon" and Bodies.tuning(a,body.kind).Persist and body.mode~="carry" then body.resume=body.mode end
	body.carry=p;body.mode="carry";body.goal=at
	body.action=p.name;body.variant=spec.proxyClip;body.actionAt=c.now;body.actionSerial+=1;body.state="Startup"
	body.expires=math.max(body.expires,c.now+span+.6)
	Bodies.face(body,a.target.root.Position)
	p.body=body;p.from=CFrame.lookAt(body.position,body.position+body.look)
	brawler().event(c,a,"BodyStrike")
	return body
end
local function carry(c,body,dt)
	local p=body.carry
	local a=body.owner
	local b=a.target
	if a.pending~=p or a.health&lt;=0 or not b or b.health&lt;=0 then
		-- The strike is over (landed, missed, or its owner was hit): spent,
		-- unless it is a persistent body back to its own job (Persist).
		body.carry=nil;body.state="Recovery"
		if body.resume and a.health&gt;0 and not body.ephemeral then
			body.mode=body.resume;body.resume=nil
			body.actionAt=c.now;body.nextStrike=math.max(body.nextStrike or 0,c.now+.6)
			c:schedule(c.now+.25,function() if body.alive and body.mode~="carry" and body.state=="Recovery" then body.state="Neutral" end end)
			return
		end
		body.resume=nil;body.mode="spent"
		body.expires=math.min(body.expires,c.now+.22)
		return
	end
	body.state=a.state
	if a.state=="Startup" then body.goal=Bodies.place(c,a,p.spec.proxy,p.side) end
	Bodies.move(c,body,body.goal or body.position,90,dt)
	Bodies.face(body,b.root.Position)
	p.from=CFrame.lookAt(body.position,body.position+body.look)
end
function Bodies.step(c,dt)
	local all=c.bodies
	if not all or #all==0 then return end
	for _,body in table.clone(all) do
		if body.alive then
			local owner=body.owner
			if owner.health&lt;=0 or c.match.phase~="Duel" then Bodies.dispel(c,body,"owner")
			elseif c.now&gt;=body.expires then Bodies.dispel(c,body,if body.mode=="spent" then "spent" else "expire")
			elseif Bodies.blocked(c,owner) then Bodies.dispel(c,body,"cloak")
			else
				local from=body.position
				if body.carry then carry(c,body,dt)
				else
					local control=Bodies.controllers[body.mode]
					if control then control(c,body,dt) end
				end
				if body.alive and dt&gt;0 then body.velocity=(body.position-from)/dt end
			end
		end
	end
end
-- A body's own blow (a clone's jab, a barrage kick), judged from where it
-- stands and paid to its owner's account; it never touches its owner's own
-- string (hitConfirmed) and cannot be read or parried into a stun of him.
-- spec: damage, reach, height, arc (cosine of the half angle in front of the
-- body), reaction, push, up, stun, tag. Returns whether it landed.
function Bodies.hitFrom(c,body,victim,spec)
	local owner=body.owner
	if c.match.phase~="Duel" or not body.alive or owner.health&lt;=0 or not victim or victim.health&lt;=0 then return false end
	local d=victim.root.Position-body.position
	local f=flat(d)
	if f.Magnitude&gt;(spec.reach or 5.5) or math.abs(d.Y)&gt;(spec.height or 4) then return false end
	if f.Magnitude&gt;.5 and body.look:Dot(f.Unit)&lt;(spec.arc or .2) then return false end
	local confirmed=owner.hitConfirmed
	c.hitOrigin=body.position;c.damageTag=spec.tag or "Body"
	local landed=c:damage(owner,victim,(spec.damage or 4)*(owner.def.CombatDamage or 1),false,false)
	c.hitOrigin=nil;c.damageTag=nil
	owner.hitConfirmed=confirmed
	if c.match.phase~="Duel" then return landed end
	if landed and victim.impactStyle~="block" and victim.health&gt;0 then
		local push=if f.Magnitude&gt;.1 then f.Unit else body.look
		brawler().react(c,victim,spec.reaction or "HitStun",push*(spec.push or 10)+Vector3.new(0,spec.up or 3,0),spec.stun or .32,owner)
	end
	return landed
end
local function inBox(box,size,point,margin)
	local q=box:PointToObjectSpace(point)
	return math.abs(q.X)&lt;=size.X/2+margin and math.abs(q.Y)&lt;=size.Y/2+Bodies.HALF-.7 and math.abs(q.Z)&lt;=size.Z/2+margin
end
-- A melee strike that reaches an enemy body first (Brawler.hit): the body is
-- dispelled and the strike is spent on it, like a blocked one (the string
-- starts over, the recovery stays short). The real fighter still takes the
-- blow when he stands nearer in the same swing, unless it was aimed at the
-- body (Bodies.aim). A wide swing (Bodies.WIDE: sweeps, spinning kicks,
-- claws) clears every enemy body it covers and still reaches the fighter.
-- Returns true when a body took the strike.
Bodies.WIDE=6.5
function Bodies.strike(c,a,p)
	local all=c.bodies
	if not all or #all==0 or p.lost then return false end
	local spec=p.spec
	local frame=p.from or a.root.CFrame
	local box=frame*CFrame.new(0,0,-(spec.offset or 2))
	local size=Vector3.new(spec.width or 5,spec.height or 5,spec.depth or 2)
	local covered={}
	local best,bestGap
	for _,body in all do
		if body.alive and not body.buried and body.owner~=a and inBox(box,size,body.position,1) then
			table.insert(covered,body)
			local gap=(body.position-frame.Position).Magnitude
			if not bestGap or gap&lt;bestGap then best,bestGap=body,gap end
		end
	end
	if not best then return false end
	local t=a.target
	local real=t~=nil and t.health&gt;0 and inBox(box,size,t.root.Position,1)
	if (spec.width or 5)&gt;=Bodies.WIDE then
		for _,body in covered do Bodies.dispel(c,body,"hit",a) end
		if real then return false end
		a.hitBlocked=true
		return true
	end
	if p.aim~=best and real and (t.root.Position-frame.Position).Magnitude&lt;bestGap then return false end
	a.hitBlocked=true
	Bodies.dispel(c,best,"hit",a)
	return true
end
local function closestOnSegment(a,b,point)
	local ab=b-a
	local length=ab:Dot(ab)
	if length&lt;1e-6 then return a end
	return a+ab*math.clamp((point-a):Dot(ab)/length,0,1)
end
-- A projectile's step through an enemy body (Combat:updateProjectiles): the
-- body puffs away; a blade stops in it (true: the projectile is spent), a
-- jutsu volume carries on (false).
function Bodies.projectile(c,p,step)
	local all=c.bodies
	if not all or #all==0 or not p.a then return false end
	local radius=(p.radius or 0)+(p.growth or 0)*math.max(0,c.now-(p.born or c.now))
	local from=p.position
	local hit,best
	for _,body in all do
		if body.alive and not body.buried and body.owner~=p.a then
			local close=closestOnSegment(from,from+step,body.position)
			local d=body.position-close
			if flat(d).Magnitude&lt;=Bodies.RADIUS+radius and math.abs(d.Y)&lt;=Bodies.HALF+radius then
				local along=(close-from).Magnitude
				if not best or along&lt;best then hit,best=body,along end
			end
		end
	end
	if not hit then return false end
	-- The real fighter nearer on the same step takes it (a clone behind him is
	-- no shield for the blade that reaches him first).
	local t=p.a.target
	if t and t.health&gt;0 then
		local close=closestOnSegment(from,from+step,t.root.Position)
		local d=t.root.Position-close
		if flat(d).Magnitude&lt;=Bodies.RADIUS+radius and math.abs(d.Y)&lt;=Bodies.HALF+radius and (close-from).Magnitude&lt;best then return false end
	end
	local volume=VOLUME[p.kind]==true
	Bodies.dispel(c,hit,"blade",p.a,if volume then {kind=hit.kind,through=p.kind} else {projectile=p.id,blade=p.kind,direction=p.direction})
	return not volume
end
-- Every enemy body of `a` within `radius` of `center` (a dome, a shockwave).
function Bodies.area(c,a,center,radius)
	local all=c.bodies
	if not all or #all==0 then return 0 end
	local count=0
	for _,body in table.clone(all) do
		local d=body.position-center
		if body.alive and not body.buried and body.owner~=a and flat(d).Magnitude&lt;=radius+Bodies.RADIUS and math.abs(d.Y)&lt;6 then
			Bodies.dispel(c,body,"area",a);count+=1
		end
	end
	return count
end
-- The enemy body a string opener is pushed at: the lock stays on the real
-- fighter, the stick picks the clone. nil when the stick points at none in
-- reach, or points closer to the locked target.
function Bodies.aim(c,a)
	local all=c.bodies
	if not all or #all==0 then return nil end
	local stick=flat(a.move or Vector3.zero)
	if stick.Magnitude&lt;.45 then return nil end
	stick=stick.Unit
	local best,bestDot
	for _,body in all do
		if body.alive and not body.buried and body.owner~=a and math.abs(body.position.Y-a.root.Position.Y)&lt;4 then
			local d=flat(body.position-a.root.Position)
			if d.Magnitude&gt;.5 and d.Magnitude&lt;=8 then
				local dot=stick:Dot(d.Unit)
				if dot&gt;=.7 and (not bestDot or dot&gt;bestDot) then best,bestDot=body,dot end
			end
		end
	end
	local t=a.target
	if best and t then
		local d=flat(t.root.Position-a.root.Position)
		if d.Magnitude&gt;.5 and stick:Dot(d.Unit)&gt;bestDot then return nil end
	end
	return best
end
-- The nearest enemy body within `reach` of `a` (the AI answers it).
function Bodies.threat(c,a,reach)
	local best,bestGap
	for _,body in c.bodies or {} do
		if body.alive and not body.buried and body.owner~=a then
			local gap=flat(body.position-a.root.Position).Magnitude
			if gap&lt;=reach and math.abs(body.position.Y-a.root.Position.Y)&lt;4 and (not bestGap or gap&lt;bestGap) then best,bestGap=body,gap end
		end
	end
	return best
end
-- Substitution by swap (Fighters[id].Substitution.Mode "clone"): the free
-- body he trades places with, and that body left where he was hit.
function Bodies.swapWith(c,a)
	local best,bestGap
	for _,body in Bodies.of(c,a) do
		if not body.carry and body.mode~="shape" and body.mode~="spent" then
			local gap=(body.position-a.root.Position).Magnitude
			if gap&lt;=45 and (not bestGap or gap&lt;bestGap) then best,bestGap=body,gap end
		end
	end
	return best
end
function Bodies.swapped(c,body,departure)
	body.position=departure
	return Bodies.dispel(c,body,"swap")
end
-- A tool that turns into a body (ToolMastery.Transform, the chakra chord):
-- the body's cost while one can still be made, else nil.
function Bodies.transformCost(c,a,mastery)
	local kind=mastery and mastery.Transform
	if not kind or not Bodies.transforms[kind] or Bodies.blocked(c,a) then return nil end
	local tune=Bodies.tuning(a,kind)
	if Bodies.count(c,a,kind)&gt;=(tune.Max or 2) then return nil end
	return tune.Cost or 12
end
-- The transforming tool in flight: close to its target, or at the end of its
-- flight, it becomes the body (Bodies.transforms[kind]). true: the
-- projectile is gone.
function Bodies.transform(c,p,step)
	local make=Bodies.transforms[p.transform]
	local b=p.a.target
	if not make or not b or b.health&lt;=0 or p.a.health&lt;=0 then return false end
	if (b.root.Position-p.position).Magnitude&gt;5.5 and p.remaining-step.Magnitude&gt;0 then return false end
	c:pushImpact(p.position,"body",false,{phase="transform",kind=p.transform,projectile=p.id,owner=p.a.id,fighter=p.a.fighterId})
	make(c,p)
	return true
end
-- Round over, KO, a new duel: every body goes without a puff.
function Bodies.clear(c)
	for _,body in c.bodies or {} do body.alive=false;body.carry=nil end
	if c.bodies then table.clear(c.bodies) end
end
-- The snapshot list the client draws (Matches:view).
function Bodies.view(c)
	local out={}
	for _,body in c.bodies or {} do
		if body.alive then
			table.insert(out,{id=body.id,owner=body.owner.id,fighterId=body.owner.fighterId,kind=body.kind,position=body.position,look=body.look,
				state=body.state,action=body.action,variant=body.variant,actionSerial=body.actionSerial,actionElapsed=c.now-(body.actionAt or c.now),
				airborne=body.airborne,velocity=body.velocity,remaining=math.max(0,body.expires-c.now),mode=body.mode,cast=body.cast,
				ephemeral=body.ephemeral,warp=body.warp,crowd=body.crowd,buried=body.buried,slot=body.slot})
		end
	end
	return out
end
return Bodies
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND54">
        <Properties>
          <string name="Name">BodyState</string>
          <ProtectedString name="Source">-- Ninja Embodiment (DEC-027, SYS-001 sustained chakra): a technique that is a
-- state of the body, not a packet that plays itself.
--
--   prepare (the technique's channel) -&gt; the state holds on the body (chakra
--   drains while it is kept) -&gt; the body moves freely with it -&gt; the next
--   strike releases it, shaped by the situation it is pressed in -&gt; the world
--   or the opponent takes the consequence.
--
-- A technique opts in with data: `State = {...}` on its spec.
--   Time     seconds the state can be held
--   Drain    chakra per second while held (it ends when the chakra runs out)
--   Strike   the strike it releases into on the ground
--   Air      the strike out of the air (default: the shared drop strike)
--   Wall     the strike off a wall run (default: the shared wall dive)
--   AirVariant / WallVariant   the clip the client draws for those strikes
--   Dive     the air / wall strike ends in the floor: it marks it, hit or miss
--   Teach    a second cue while it is held (how the situation shapes it)
--   Damage   the released strike's damage
--   World    {contact, element}: how the world takes it (Server/WorldReaction)
--   Style    the contact style pushed to the client on release
--   Name     the cue
-- The state ends on release, on a blow taken, on a guard, when its time or
-- the chakra runs out (a fizzle). Nothing here names a fighter.
local BodyState={}

local function brawler() return require(script.Parent.Brawler) end

function BodyState.active(a,now)
	local s=a.bodyState
	return s~=nil and now&lt;s.untilTime and s or nil
end

function BodyState.enter(c,a,spec,held)
	local st=held or spec.State
	a.bodyState={id=spec.Id,spec=spec,state=st,at=c.now,untilTime=c.now+(st.Time or 2)}
	c:cue(a,string.upper(st.Name or spec.Name or spec.Id).." • ATTACK TO RELEASE",.9)
	if st.Teach then
		local at=c.now
		c:schedule(c.now+.95,function()
			local s=a.bodyState
			if s and s.at==at and a.health&gt;0 then c:cue(a,string.upper(st.Name or spec.Id).." • "..st.Teach,1.1) end
		end)
	end
	brawler().event(c,a,"State:"..spec.Id)
	c:pushImpact(a.root.Position,st.Style or "chidori",false,{owner=a.id,state=spec.Id,phase="form"})
end

function BodyState.finish(c,a,why)
	local s=a.bodyState
	if not s then return end
	a.bodyState=nil
	if why~="release" then
		brawler().event(c,a,"StateEnd:"..why)
		if why=="fizzle" then c:cue(a,string.upper(s.state.Name or s.id).." • FADED",.6) end
	end
end

-- Per frame: the drain, the time limit, and what breaks the state.
function BodyState.step(c,a,dt)
	local s=a.bodyState
	if not s then return end
	if a.health&lt;=0 or c.match.phase~="Duel" then a.bodyState=nil;return end
	if a.reaction or a.state=="Stunned" then BodyState.finish(c,a,"broken");return end
	if a.state=="Guarding" then BodyState.finish(c,a,"guard");return end
	a.chakra=math.max(0,a.chakra-(s.state.Drain or 0)*dt)
	if c.now&gt;=s.untilTime or a.chakra&lt;=0 then BodyState.finish(c,a,"fizzle") end
end

-- The strike press while the state holds: the state's strike, shaped by the
-- situation (off a wall: a dive; out of the air: a drop; running: it carries
-- the run). Returns the request's result, or nil when the state does not
-- answer this press.
function BodyState.release(c,a,action)
	local s=BodyState.active(a,c.now)
	if not s or (action~="Attack" and action~="Heavy") then return nil end
	if a.state~="Neutral" and a.state~="Recovery" and a.state~="Dodging" and a.state~="TechniqueRecovery" and a.state~="TechniqueActive" then return nil end
	local Brawler=brawler()
	local st=s.state
	local Motor=require(script.Parent.Motor)
	local move,shape=st.Strike or "Light3","ground"
	if a.wall then
		Motor.detach(a,c.now,false)
		move,shape=st.Wall or "WallDive","wall"
	elseif a.airborne then
		move,shape=st.Air or "DropStrike","air"
	end
	local runSpeed=a.locomotion and a.locomotion.Magnitude or 0
	a.state="Neutral";a.untilTime=c.now;a.evade=nil
	Brawler.breakString(a,a.airborne==true)
	BodyState.finish(c,a,"release")
	local ok=Brawler.start(c,a,move)
	local p=a.pending
	if ok==false or not p then return ok end
	p.spec.damage=st.Damage or p.spec.damage
	p.spec.world=st.World
	p.state=s.id
	-- A held Rasengan releases as the Rasengan (its own reaction, impulse and
	-- look); a held Chidori as the thrust it names.
	if st.Reaction then p.spec.reaction=st.Reaction end
	if st.Impulse then p.spec.impulse=if shape=="air" then Vector3.new(0,-70,16) else st.Impulse end
	if st.Stun then p.spec.stun=st.Stun end
	if st.Rasengan then
		p.rasengan=true
		if shape=="ground" then p.spec.travel=math.max(p.spec.travel,10);a.travelRemaining=math.max(a.travelRemaining or 0,p.spec.travel) end
	end
	a.attackVariant=(shape=="air" and st.AirVariant) or (shape=="wall" and st.WallVariant) or st.Variant or s.id
	a.lastAttack=c.now
	if shape=="ground" and runSpeed&gt;8 then
		-- Released out of a run: the run is in the thrust.
		local need=runSpeed*(p.spec.travelTime or .3)*.9
		if need&gt;p.spec.travel then p.spec.travel=need;a.travelRemaining=need end
	end
	-- (05/11, lot 3) A dive ends in the floor: when the lunge is over the
	-- ground under the body takes it (a lightning crater), hit or miss.
	if st.Dive and shape~="ground" then
		local serial=a.attackSerial
		c:schedule(c.now+p.spec.startup+math.max(p.slamWindow or 0,.16)+.03,function()
			if a.health&lt;=0 or a.attackSerial~=serial then return end
			local hit=workspace:Raycast(a.root.Position,Vector3.new(0,-7,0),c:rayParams(true))
			if not hit then return end
			c:pushImpact(hit.Position+Vector3.new(0,.4,0),st.Style or "chidori",true,{owner=a.id,state=s.id,phase="land"})
			require(script.Parent.WorldReaction).impact(c,{part=hit.Instance,position=hit.Position,normal=hit.Normal,energy=(st.Damage or 20)*3,
				contact=(st.World and st.World.contact) or "energy",element=st.World and st.World.element,direction=Vector3.new(0,-1,0),source=a.id})
			Brawler.event(c,a,"Dive:"..s.id)
		end)
	end
	Brawler.event(c,a,"Release:"..s.id);Brawler.event(c,a,"Release:"..shape)
	if st.Event then Brawler.event(c,a,st.Event) end
	c:pushImpact(a.root.Position,st.Style or "chidori",true,{owner=a.id,state=s.id,phase="release",shape=shape})
	c:cue(a,string.upper(st.Name or s.id),.6)
	-- The risk, said to both: a release that touched nothing (not even a
	-- guard) leaves the body open for its whole recovery.
	local serial=a.attackSerial
	c:schedule(c.now+p.spec.startup+p.spec.active+.02,function()
		if a.health&lt;=0 or a.attackSerial~=serial or a.hitConfirmed or a.state~="Recovery" or (a.clashedAt or -10)&gt;c.now-1 then return end
		c:cue(a,string.upper(st.Name or s.id).." • MISSED • OPEN",.8)
		if a.target and a.target.health&gt;0 then c:cue(a.target,string.upper(st.Name or s.id).." MISSED • PUNISH",.8) end
		Brawler.event(c,a,"StateMissed:"..s.id)
	end)
	return ok
end

function BodyState.snapshot(a,now)
	local s=a.bodyState
	if not s or now&gt;=s.untilTime then return nil end
	return {id=s.id,remaining=s.untilTime-now}
end

return BodyState
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND55">
        <Properties>
          <string name="Name">Brawler</string>
          <ProtectedString name="Source">local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Attacks=require(Shared.Attacks)
local Motor=require(script.Parent.Motor)
local Bangla=require(script.Parent.BanglaCombat)
local MoveGraphs=require(Shared.MoveGraphs)
local ActionContext=require(Shared.ActionContext)
local WorldReaction=require(script.Parent.WorldReaction)
local Perception=require(script.Parent.Perception)
local BodyState=require(script.Parent.BodyState)
local Config=require(Shared.Config)
local Rules=require(Shared.Rules)
local ReactionSides=require(Shared.ReactionSides)
-- Bodies that are not actors (Naruto's shadow clones): strikes they carry
-- out, strikes they take first, strikes aimed at them.
local Bodies=require(script.Parent.Bodies)
-- Adapter: reaction/air/grab mechanics missing from the donor; all strike hit
-- volumes/damage/feedback run through Bangla. String progression is Ninja
-- Duel's own (confirmed hits, below), no longer the donor's press counter.
local Brawler={}
-- A fighter module's own route payoffs (MoveGraphs onRoute kinds), e.g.
-- Naruto's "uzumaki" (Server/Legion).
Brawler.payoffs={}
local airReactions={Launched=true,Juggled=true,Knockback=true,Knockdown=true,WallSplat=true,Spiked=true}
local TUNE=Config.Combo
local UP=Vector3.yAxis
local function flatUnit(v)
 local f=Vector3.new(v.X,0,v.Z)
 return if f.Magnitude&gt;.01 then f.Unit else nil
end
-- The move graph this actor fights with: its skill build's copy when it has
-- one (Combat:add), otherwise the canonical MoveGraphs entry.
function Brawler.graph(a)
 return a.graph or MoveGraphs[a.fighterId]
end
-- Ninja Embodiment (EMB-002): the body's situation for the strike input
-- (Shared/ActionContext reads it; this only gathers the server facts).
function Brawler.situation(c,a)
 local b=a.target
 if not b or not b.root or b.health&lt;=0 then return nil end
 local vel=a.root.AssemblyLinearVelocity
 local loco=a.locomotion or Vector3.zero
 if Vector3.new(loco.X,0,loco.Z).Magnitude&gt;Vector3.new(vel.X,0,vel.Z).Magnitude then vel=Vector3.new(loco.X,vel.Y,loco.Z) end
 -- Under an illusion the body reads the image it believes in (Itachi's
 -- Mirage): where it stands, facing this body.
 local fooled=a.decoyPosition and (a.illusionUntil or 0)&gt;c.now
 local seen=if fooled then a.decoyPosition else b.root.Position
 local look=if fooled then (a.root.Position-seen) else b.root.CFrame.LookVector
 local x=ActionContext.read({pos=a.root.Position,look=a.root.CFrame.LookVector,vel=vel,airborne=a.airborne,
  target={pos=seen,look=look,airborne=b.airborne and not fooled,
   down=b.reaction=="Knockdown" or b.reaction=="Wakeup" or b.groundPose~=nil,guarding=b.state=="Guarding"}})
 -- How far this fighter's plain strike already reaches (its step-in plus its
 -- contact): the reach situation starts beyond it.
 local light=Attacks.Light1
 local profile=a.def.AttackProfile and a.def.AttackProfile.Light1
 -- (+1: the strike's volume lands about a stud past the contact distance.)
 x.plainReach=light.travel*(a.def.CombatTravel or 1)*(profile and profile.travel or 1)+(profile and profile.contact or light.contact or 3.6)+1
 -- The stick: what the player (or the bot) is doing with the body as it
 -- presses (moving round him, backing off), so an opener follows the body.
 x.stick=(Brawler.intent(a,c.now))
 -- The space: a surface at the target's back on this body's line (a drive
 -- puts him into it). Not under an illusion (the image has no wall behind).
 if not fooled then
  local seen=Perception.read(c,a)
  x.wallBehind=seen and seen.behindTarget and seen.behindTarget.distance or nil
 end
 return x
end
-- The strike this situation calls for (nil: the plain strike). `only`
-- limits the situations read (inside a string only the wall counts).
function Brawler.contextual(c,a,only)
 local x=Brawler.situation(c,a)
 if not x then return nil end
 return ActionContext.resolve(x,Brawler.graph(a),Attacks,only)
end
local WALL_ONLY={wall=true}
-- The strike a riposte (or a counter stance's answer) comes out as: the
-- fighter's own gesture (MoveGraphs riposte: Madara's pommel, Hashirama's
-- shoulder, Hiruzen's point), and while awake the one Awakening.Riposte
-- names for the stick held now (forward/back/side, `any` otherwise).
function Brawler.riposteMove(c,a,base)
 local graph=Brawler.graph(a) or {}
 local move=base or graph.riposte or "Riposte"
 local aw=a.def.Awakening
 if aw and aw.Riposte and (a.awakenUntil or 0)&gt;c.now then
  local dir=Brawler.intent(a)
  local pick=(dir and aw.Riposte[dir]) or aw.Riposte.any
  if pick and Attacks[pick] then move=pick;Brawler.event(c,a,"AwakenedRiposte") end
 end
 return if Attacks[move] then move else "Riposte"
end
function Brawler.free(a,now)
 -- (Audit 29/10) A knockdown or a wall splat always becomes a wake-up
 -- (Brawler.step): a strike started at its last frame was never checked for
 -- a hit and always whiffed. The late press (Combat) fires it after.
 if a.reaction=="Knockdown" or a.reaction=="WallSplat" then return false end
 return a.reaction==nil or now&gt;=(a.reactionUntil or 0)
end
function Brawler.event(c,a,event)
 a.events=a.events or {};a.events[event]=(a.events[event] or 0)+1
 if c.match.onCombatEvent then c.match.onCombatEvent(a,event) end
end
-- Combo model (CORE_COMBAT_CONVERGENCE_2 §1). A string is counted in
-- CONFIRMED hits: a press, a startup, a buffered input or a whiff never
-- advances it.
--   a.combo / a.airCombo   confirmed hits of the current ground / air string
--   a.stringUntil / a.airStringUntil   until then a press from neutral still
--                          continues it (chain window plus Config.Combo.Grace)
--   a.stringAt             when its last hit was confirmed (a hit taken since
--                          breaks it)
--   pending.step           the count a chain move confirms if it connects
-- Light step = confirmed hits + 1 (third light ends the string); routes ask for
-- confirmed hits; a whiff, a blocked strike or a hit taken restarts at Light1.
function Brawler.chainWindow(c,a)
 return a.state=="Recovery" and a.chainOpen==true and c.now&gt;=(a.chainAt or 0)
end
function Brawler.stringAlive(c,a,air)
 local count=if air then a.airCombo else a.combo
 if (count or 0)&lt;1 then return false end
 if air and not a.airborne then return false end
 if (a.lastHurt or -10)&gt;((if air then a.airStringAt else a.stringAt) or -10) then return false end
 if Brawler.chainWindow(c,a) and (a.chainAir==true)==(air==true) then return true end
 return c.now&lt;=((if air then a.airStringUntil else a.stringUntil) or 0)
end
function Brawler.breakString(a,air)
 if air then a.airCombo=0;a.airStringUntil=0 else a.combo=0;a.stringUntil=0 end
end
function Brawler.resetStrings(a)
 Brawler.breakString(a,false);Brawler.breakString(a,true)
end
-- The swing connected (cleanly, or into armour or a sand shield): it is the
-- string's next confirmed hit.
function Brawler.confirm(c,a,p)
 if p.spec.air then a.airCombo=p.step;a.airStringAt=c.now else a.combo=p.step;a.stringAt=c.now end
end
-- The swing's outcome is known (end of its active window): a clean chain hit
-- keeps its string alive for the chain window plus the grace; a whiff or a
-- blocked hit ends it, so the next press is an opener again.
function Brawler.settle(c,a,p)
 local air=p.spec.air==true
 if a.chainOpen then
  a.chainAir=air
  if air then a.airStringUntil=a.untilTime+TUNE.Grace else a.stringUntil=a.untilTime+TUNE.Grace end
 elseif p.spec.chain then
  Brawler.breakString(a,air)
 end
end
-- Directional intent, relative to the opponent (CORE_COMBAT_CONVERGENCE_2 §1.6):
-- "forward" (toward him), "back" (away), "side" (+1 to the right of the line to
-- him, -1 to the left), or nil for a weak push. Toward and away are wide cones
-- (Config.Combo.Toward/Away), so a camera a few degrees off still reads the
-- route the player meant.
function Brawler.classify(a,stick)
 local line=a.target and a.target.root and flatUnit(a.target.root.Position-a.root.Position)
 line=line or flatUnit(a.root.CFrame.LookVector) or Vector3.new(0,0,-1)
 -- (É7) Shared: the client's guess of its next strike reads the stick the same way.
 return ActionContext.stick(stick,line,TUNE)
end
-- The directional memory: the latest strong push, sampled every frame and at
-- every packet, so a stick released (or crossing the threshold) a moment
-- before the press still picks the route it was pushed for.
function Brawler.observe(c,a)
 a.intentAt=c.now
 local dir,sideSign=Brawler.classify(a,a.move or Vector3.zero)
 if dir then a.intentMemory={dir=dir,side=sideSign,at=c.now} end
end
-- Movement intent read when a press lands: this is what turns one string into
-- a small move graph per character. The current strong push first, else the
-- latest strong push inside Config.Combo.IntentWindow, else neutral. A
-- buffered press replays its own intent (intentOverride); the AI sets one too.
function Brawler.intent(a,now)
 if a.intentOverride then return a.intentOverride[1],a.intentOverride[2] end
 local dir,sideSign=Brawler.classify(a,a.move or Vector3.zero)
 if dir then return dir,sideSign end
 local memory=a.intentMemory
 now=now or a.intentAt or 0
 if memory and now-memory.at&lt;=TUNE.IntentWindow then return memory.dir,memory.side end
 return "neutral",0
end
-- (04/11, user: the routes' « away, machin » were « pas facilement faisables
-- pour un humain » → « le plus simple à faire et à jouer, sans perdre de
-- mouvement ») The string's routes on buttons, no direction to hold. Inside a
-- confirmed ground string of 2 hits or more:
--   ○ (Dodge) the side route (on the stick's side when one is pushed),
--   × (Jump)  the rising route,
--   R (Tool)  hop out behind a throw;
-- after a confirmed air hit: ○ switches sides, × drives the body away.
-- (The heavy picks by the count itself, Brawler.request: 1 hit its heavy, 2
-- the launcher, 3+ the low route; in the air 1 the spike, 2+ the plunge.)
-- Returns the action the press becomes and the route intent it carries, read
-- by the same grammar as a stick (the AI and a held stick still work).
local function sideOf(a)
 local dir,sign=Brawler.classify(a,a.move or Vector3.zero)
 if dir=="side" and sign~=0 then return sign end
 return -(a.angleSide or -1)
end
function Brawler.buttonRoute(c,a,action)
 if action~="Dodge" and action~="Jump" and action~="Tool" then return nil end
 if a.reaction or a.ultimateHeld or a.wall or a.grabbing then return nil end
 -- (Audit 04/11, « sans perdre de mouvement ») the stick pushed away from him
 -- always gets out: ○ is the real dodge, × the real jump, even mid-string.
 -- (A player's stick: the bot picks its routes by their intent.)
 if action~="Tool" and a.playerInput and Brawler.classify(a,a.move or Vector3.zero)=="back" then return nil end
 -- A launched body: the jump stays a jump and the chase a chase.
 if (a.pursuitUntil or 0)&gt;c.now then return nil end
 local graph=Brawler.graph(a) or {}
 local routes=graph.routes or {}
 local open=Brawler.chainWindow(c,a) or a.state=="Neutral"
 if not open then return nil end
 if a.airborne then
  if action=="Tool" or (a.airCombo or 0)&lt;1 or not Brawler.stringAlive(c,a,true) then return nil end
  local route=if action=="Dodge" then routes.airSide else routes.airUp
  if not route or not Attacks[route] then return nil end
  return "Attack",(if action=="Dodge" then {"side",sideOf(a)} else {"forward",0})
 end
 if (a.combo or 0)&lt;2 or not Brawler.stringAlive(c,a,false) then return nil end
 if action=="Tool" then
  if not graph.disengage or not a.chainOpen then return nil end
  return "Tool",{"back",0}
 end
 local route=if action=="Dodge" then routes.side else routes.up
 if not route or not Attacks[route] then return nil end
 return "Attack",(if action=="Dodge" then {"side",sideOf(a)} else {"forward",0})
end
-- Presses made while the body is committed wait for its outcome: a swing
-- before its contact is known, a chase or a dash before the arrival, a
-- teleport before it lands.
local function bufferable(a)
 local p=a.pending
 if p and p.kind=="Brawl" and (a.state=="Startup" or a.state=="Active") then return true end
 -- (User 28/10, player agent: 23 presses refused "Committed" in 45 s) A
 -- press in the first frames of a strike's recovery, before its chain window
 -- opens, is what a player mashing does: it waits for the window (or for the
 -- end of the recovery) instead of being eaten.
 if a.state=="Recovery" and a.attackName~=nil then return true end
 if a.state=="Pursuit" or a.state=="Rush" then return true end
 return p~=nil and p.kind=="Technique" and p.spec.Id=="Flashstep" and (a.state=="TechniqueChannel" or a.state=="TechniqueActive")
end
local function bufferExpiry(a)
 local p=a.pending
 local active=0
 if p and a.state=="Startup" and p.kind=="Brawl" then active=p.spec.active
 elseif p and a.state=="TechniqueChannel" then active=p.spec.Active or 0 end
 return a.untilTime+active+TUNE.Buffer
end
-- Re-engage (CORE_COMBAT_CONVERGENCE_2 §3) -----------------------------------
local REENTRY={name="dash",speed=1,arrive=3.6,angle=0,chase=.3}
function Brawler.reentry(a)
 local graph=Brawler.graph(a)
 return (graph and graph.reengage) or REENTRY
end
-- A chase is over once the body is within reach and no longer escaping faster
-- than an air strike follows (a launched body near its apex, a knocked-away
-- one, a grounded one).
function Brawler.chaseArrived(c,a)
 local b=a.target
 if not b or c.now-(a.pursuitStarted or c.now)&lt;.1 then return false end
 if (b.root.Position-a.root.Position).Magnitude&gt;4.6 then return false end
 local rising=if b.reaction and b.reactionVelocity then b.reactionVelocity.Y else 0
 -- (07/11, Studio + gate, Itachi: the chase "arrived" 4.5 studs under a body
 -- still rising at 25 studs/s, stopped there and both air strikes missed 6-8
 -- studs below it) a body still climbing is followed on until the chaser is
 -- level with it (its air string then follows the rise) or near its apex.
 -- (Integration 07/11: waiting for the apex alone stretched every launch
 -- chase to its full 0.5 s and the strike after it out of its window.)
 if not b.airborne or rising&lt;=12 then return true end
 return rising&lt;=30 and a.root.Position.Y&gt;=b.root.Position.Y-1
end
-- The re-entry windows in which a press is the arrival strike (dash attack on
-- the ground, the air string in the air) or the arrival heavy.
function Brawler.arrival(c,a)
 if a.state=="Dodging" then return c.now&gt;=a.untilTime-.23 end
 if a.state=="Rush" then
  local r=a.rush
  if c.now&gt;=a.untilTime-.15 then return true end
  if r and not r.line and a.target then
   local d=a.target.root.Position-a.root.Position
   return Vector3.new(d.X,0,d.Z).Magnitude&lt;=(r.arrive or 3.6)+1.4
  end
  return false
 end
 if a.state=="Pursuit" then return Brawler.chaseArrived(c,a) end
 if (a.rushArriveUntil or 0)&gt;c.now then return a.state=="Neutral" or (a.state=="Recovery" and a.arrivalRecovery==true) end
 return false
end
-- (É7) What the client needs to guess its own next press the way
-- Brawler.request will read it (sent in the snapshot as `guess`; the
-- prediction test reads the same table). Windows go out as the time left (or
-- until they open), so the client reads them where they will be when its
-- press lands, one round trip after this snapshot (Presentation.viewAt).
function Brawler.guessView(c,a)
 local now=c.now
 local function left(t) return if t then t-now else nil end
 return {
  left=left(a.untilTime),
  cancelAt=left(a.recoveryCancelAt),
  chainOpen=a.state=="Recovery" and a.chainOpen==true,chainIn=(a.chainAt or 0)-now,chainAir=a.chainAir==true,
  combo=a.combo or 0,stringHurt=(a.lastHurt or -10)&gt;(a.stringAt or -10),stringLeft=(a.stringUntil or 0)-now,
  airCombo=a.airCombo or 0,airHurt=(a.lastHurt or -10)&gt;(a.airStringAt or -10),airLeft=(a.airStringUntil or 0)-now,
  airRecentLeft=(a.airStringAt or -10)+1-now,lionLeft=(a.lionUntil or 0)-now,
  riposteLeft=(a.riposteUntil or 0)-now,counterLeft=(a.counterUntil or 0)-now,
  -- a chase or a dash arriving (their own reading, not a timer)
  arrival=(a.state=="Rush" or a.state=="Pursuit") and Brawler.arrival(c,a)==true,
  rushArriveLeft=(a.rushArriveUntil or 0)-now,arrivalRecovery=a.arrivalRecovery==true,
  airDodgeUsed=a.airDodgeUsed==true,flash=(a.flashUntil or 0)&gt;now,
  stance=Brawler.counterStance(a)==true,grab=a.grabVictim~=nil,
  -- a press already waiting (it fires first: the next one lands behind it)
  buffered=a.buffered~=nil,
  -- out of a blow: when the dodge steps out of it (Brawler.recoverable "stand")
  reactionLeft=if a.reaction then (a.reactionUntil or now)-now else nil,
  standIn=Brawler.standIn(c,a),
  -- held up in the air by an air string (Motor: no fall until then)
  airHoldLeft=math.max(0,(a.airHold or 0)-now),
  -- the sprint dodge at him is the chakra dash when it is available
  locked=a.locked==true,rushReadyLeft=(a.rushReadyAt or 0)-now,freeRushLeft=(a.freeRushUntil or 0)-now,
  -- (Audit 03/11) inside an ultimate's sequence (cast or held) nothing
  -- answers: no guess (the bot fires its ultimate now)
  held=a.ultimateHeld==true or a.ultimateRunning==true,
 }
end
-- The closest planted (not flying, not body) seal of Minato's near the target.
function Brawler.nearSeal(c,a,b,radius)
 local best,bestGap
 for _,seal in require(script.Parent.Techniques).seals(c,a,c.now) do
  if not seal.flying and not seal.body then
   local d=seal.position-b.root.Position
   local gap=Vector3.new(d.X,0,d.Z).Magnitude
   if gap&lt;=(radius or 12) and (not bestGap or gap&lt;bestGap) then best,bestGap=seal.position,gap end
  end
 end
 return best
end
-- Where a dash arrives: a step short of the body on the centre line, an angle
-- beside it (fixed in the world at the start, so it tracks the body without
-- spiralling), or a point through it for a committed line.
function Brawler.rushGoal(a,r)
 local b=a.target
 local y=a.root.Position.Y
 local there=Vector3.new(b.root.Position.X,y,b.root.Position.Z)
 if r.offset then return there+r.offset end
 local line=flatUnit(b.root.Position-a.root.Position) or flatUnit(a.root.CFrame.LookVector) or Vector3.new(0,0,-1)
 if r.past then return there+line*r.past end
 return there-line*r.arrive
end
function Brawler.rushPlan(c,a,style,line)
 local tune=Config.Rush
 local r={style=style,speed=tune.Speed*(style.speed or 1),arrive=style.arrive or 3.6,recovery=style.recovery or tune.Recovery,from=a.root.Position}
 if line then
  r.line=line;r.goal=c:clamp(a.root.Position+line*tune.Reposition)
  return r
 end
 local b=a.target
 local toward=flatUnit(b.root.Position-a.root.Position) or flatUnit(a.root.CFrame.LookVector) or Vector3.new(0,0,-1)
 local right=toward:Cross(UP)
 local angle=style.angle or 0
 local sign=nil
 if style.sealAngle then
  -- A planted seal near the target pulls the re-entry onto its side.
  local seal=Brawler.nearSeal(c,a,b)
  if seal then
   sign=if (seal-b.root.Position):Dot(right)&gt;=0 then 1 else -1
   angle=style.sealAngle;r.speed*=style.sealPull or 1;r.sealed=true
  end
 end
 if angle&gt;0 then
  if not sign then
   local dir,stickSide=Brawler.classify(a,a.move or Vector3.zero)
   sign=if dir=="side" then stickSide else (a.rushSide or 1)
   -- With no side asked for, the angle alternates from one dash to the next.
   a.rushSide=-sign
   -- (shuffle: Naruto) not a plain alternation: an irregular side, and every
   -- third entry a wider angle.
   if style.shuffle and dir~="side" then
    a.rushCount=(a.rushCount or 0)+1
    sign=if (a.rushCount*3+1)%5&lt;2 then 1 else -1
    if a.rushCount%3==0 then angle*=1.5 end
   end
  end
  local rad=math.rad(angle)
  r.offset=(-toward*math.cos(rad)+right*sign*math.sin(rad))*r.arrive
  r.side=sign
 end
 if style.past then r.past=style.past;r.commitAt=c.now+(style.commit or 0) end
 r.goal=Brawler.rushGoal(a,r)
 return r
end
-- The dash is over: a short recovery that converts at once into a strike, a
-- heavy or a grab (Brawler.arrival), and into guard / dodge / jump only after
-- Config.Rush.CancelAfter. Nobody answering it leaves a punishable gap.
function Brawler.arrive(c,a)
 local r=a.rush or {}
 a.rush=nil;a.aimIntent=nil
 -- The dash stops where it arrives: the body keeps a step of momentum, not
 -- the dash speed (measured in Studio: live physics slid the root 10-25 studs
 -- past the opponent through the whole recovery).
 Brawler.brake(a,Config.Rush.Carry or 8)
 local recovery=r.recovery or Config.Rush.Recovery
 c:setState(a,"Recovery",recovery)
 a.recoveryCancelAt=c.now+math.min(Config.Rush.CancelAfter,recovery)
 a.arrivalRecovery=true
 a.rushArriveUntil=c.now+Config.Rush.Arrive
 Brawler.event(c,a,"RushArrive")
 c:travelArrive(a)
end
-- Kill a kinetic burst (dash, chase) down to `carry` studs/s along its line.
function Brawler.brake(a,carry)
 local v=a.root.AssemblyLinearVelocity
 local flat=Vector3.new(v.X,0,v.Z)
 local keep=if flat.Magnitude&gt;.1 then flat.Unit*math.min(flat.Magnitude,carry) else Vector3.zero
 a.root.AssemblyLinearVelocity=Vector3.new(keep.X,v.Y,keep.Z)
 a.locomotion=keep
end
-- Itachi's feint: guard or dodge during his dash stops it where he is; an
-- afterimage carries on the illusion of the approach.
function Brawler.feintRush(c,a)
 a.rush=nil;a.rushArriveUntil=0;a.aimIntent=nil;a.travel=nil
 Brawler.brake(a,0)
 c:setState(a,"Neutral",0)
 c:pushImpact(a.root.Position,"afterimage",false,{owner=a.id,fighter=a.fighterId,variant="feint"})
 Brawler.event(c,a,"RushFeint")
 c:cue(a,"FEINT",.5)
end
-- Pad re-engage: sprint + dodge with the stick toward a locked opponent at
-- mid range (Combat:request turns it into the re-engage).
function Brawler.dashIntent(c,a)
 if not a.sprinting or not a.locked or a.airborne or a.wall or a.def.SandFlicker then return false end
 local b=a.target
 if not b or b.health&lt;=0 then return false end
 -- The current push (a dodge goes where the stick is now), or the bot's own.
 local dir=if a.intentOverride then a.intentOverride[1] else (Brawler.classify(a,a.move or Vector3.zero))
 if dir~="forward" then return false end
 local d=b.root.Position-a.root.Position
 return Vector3.new(d.X,0,d.Z).Magnitude&gt;=(Brawler.reentry(a).minRange or Config.Rush.MinRange)
end
function Brawler.releaseGrab(a)
 local b=a.grabVictim
 if b then b.grabbedBy=nil;b.reaction=nil;b.reactionUntil=0;a.grabVictim=nil end
 if a.grabbedBy then a.grabbedBy.grabVictim=nil;a.grabbedBy=nil end
end
-- `cause` (optional): what threw the body (a move or technique name); a wall
-- the flight ends on reports it, so the client can say which blow did it.
function Brawler.react(c,a,kind,velocity,duration,source,cause)
 Brawler.releaseGrab(a)
 -- (Audit 29/10) A hit ends the run: its hand-back threw the body on at the
 -- run's speed on the first free frame after the stun.
 a.strikeCarry=nil
 Bangla.close(a.pending)
 -- A guard break or channel interrupt already set a longer stun: the melee
 -- reaction that follows keeps it instead of shortening it to the move's own.
 duration=math.max(duration,(a.stunFloorUntil or 0)-c.now);a.stunFloorUntil=nil
 a.chainOpen=false;a.recoveryCancelAt=nil
 -- (06/11) the ground keeps the blow: torn where the feet were (before the
 -- reaction marks the body airborne)
 if (kind=="Knockback" or kind=="Launched" or kind=="Knockdown") and typeof(velocity)=="Vector3" then pcall(WorldReaction.blow,c,a,velocity,kind) end
 a.reaction=kind;a.reactionUntil=c.now+duration;a.reactionVelocity=velocity;a.reactionStartedAt=c.now
	 a.reactionSource=source;a.reactionCause=cause
 a.pending=nil;a.buffered=nil;a.attackName=nil;a.guardHeld=false;a.state="Neutral";a.untilTime=c.now
 -- Hit out of it: his own strings and re-entry are over.
 Brawler.resetStrings(a);a.rush=nil;a.arrivalRecovery=nil;a.rushArriveUntil=0
 -- (12/11) A blow taken on the way ends a travel (Combat:travelStart).
 a.travel=nil
 a.locomotion=Vector3.zero
 if airReactions[kind] then a.airborne=true end
 if kind=="Knockdown" then
  a.invulnerableUntil=c.now+duration+.24
  a.groundPose="Knockdown"
  -- Which side the body rolls onto, taken from the incoming direction.
  local from=a.hitFrom or Vector3.zAxis
  a.groundSide=if a.root.CFrame.RightVector:Dot(from)&gt;=0 then 1 else -1
 end
 if kind=="WallSplat" then a.groundPose="Splat" end
 if not airReactions[kind] then a.groundPose=nil end
end
-- Ninja Embodiment (EMB-003): what a struck body may do about the blow now.
-- "stand": an ordinary standing reaction past its share (Config.Agency.Stand);
-- "air": thrown up or juggled, falling, past its share (a launcher holds
-- longer); "tech": knocked down and just landed. nil: no say yet (or none:
-- grabbed, bound, spiked, pinned to a wall, guard broken).
-- (É7) How long until a grounded blow can be stepped out of (the "stand"
-- recovery below), nil when it cannot be.
function Brawler.standIn(c,a)
 local kind=a.reaction
 if not kind or a.airborne then return nil end
 if kind=="Knockback" then return 0 end
 if kind~="HitStun" and kind~="GuardStun" then return nil end
 local tune=Config.Agency
 local started=a.reactionStartedAt or c.now
 local length=math.max((a.reactionUntil or c.now)-started,.01)
 return math.max(started+tune.Stand*length,started+tune.Min)-c.now
end
function Brawler.recoverable(c,a)
 local kind=a.reaction
 if not kind then return nil end
 local tune=Config.Agency
 local started=a.reactionStartedAt or c.now
 local length=math.max((a.reactionUntil or c.now)-started,.01)
 local share=(c.now-started)/length
 if (kind=="HitStun" or kind=="GuardStun") and not a.airborne then
  if share&gt;=tune.Stand and c.now-started&gt;=tune.Min then return "stand" end
  return nil
 end
 if (kind=="Juggled" or kind=="Launched" or kind=="Knockback") and a.airborne and not a.airRecoverUsed then
  -- An air string keeps the body rising, so a juggled body answers past its
  -- share whatever its way; only the earned launcher also waits for its apex.
  local falling=(a.reactionVelocity and a.reactionVelocity.Y or 0)&lt;0
  if kind=="Launched" then if falling and share&gt;=tune.Launched then return "air" end return nil end
  if share&gt;=tune.Air then return "air" end
  return nil
 end
 if kind=="Knockback" and not a.airborne then return "stand" end
 if kind=="Knockdown" and not a.airborne and a.landedAt and c.now-a.landedAt&lt;=tune.Tech then return "tech" end
 return nil
end
-- Take the body back. A "stand" recovery only ends the reaction (the guard or
-- the dodge then proceeds as usual); "air" rights the body in the air; "tech"
-- rolls it out of the knockdown. The price is paid here.
function Brawler.recover(c,a,kind,action)
 local tune=Config.Agency
 if kind=="stand" then
  if action=="Guard" then
   if (a.stamina or 100)&lt;tune.GuardCost then return false,"Exhausted" end
   a.stamina=(a.stamina or 100)-tune.GuardCost
  else
   if a.chakra&lt;tune.StepCost then return false,"Need chakra" end
   a.chakra-=tune.StepCost
  end
 elseif kind=="air" then
  if a.chakra&lt;tune.AirCost then return false,"Need chakra" end
  a.chakra-=tune.AirCost
 end
 local attacker=a.reactionSource or a.target
 local away=if attacker and attacker.root then a.root.Position-attacker.root.Position else -a.root.CFrame.LookVector
 away=Vector3.new(away.X,0,away.Z);away=if away.Magnitude&gt;.05 then away.Unit else -a.root.CFrame.LookVector
 a.reaction=nil;a.reactionUntil=0;a.reactionVelocity=nil;a.groundPose=nil;a.state="Neutral";a.untilTime=c.now
 a.comboHits=0
 if kind=="air" then
  -- Righted in the air: a small lift and drift away from the striker, then
  -- the body falls under its own control (no second air recovery).
  a.airRecoverUsed=true;a.airDodgeUsed=true
  a.root.AssemblyLinearVelocity=away*tune.AirPush+Vector3.new(0,tune.AirLift,0)
  Brawler.event(c,a,"AirRecover");c:cue(a,"RECOVER",.5)
  c:pushImpact(a.root.Position,"recover",false,{owner=a.id,fighter=a.fighterId,kind="air"})
  return true,"Recovered"
 end
 if kind=="tech" then
  -- Rolled out of the fall: up and away, briefly untouchable.
  a.hop={direction=away,remaining=tune.TechDistance,speed=30}
  a.invulnerableUntil=math.max(a.invulnerableUntil or 0,c.now+.3)
  Brawler.event(c,a,"Tech");c:cue(a,"TECH",.5)
  c:pushImpact(a.root.Position,"recover",false,{owner=a.id,fighter=a.fighterId,kind="tech"})
  return true,"Recovered"
 end
 Brawler.event(c,a,"Recover")
 c:pushImpact(a.root.Position,"recover",false,{owner=a.id,fighter=a.fighterId,kind=action=="Guard" and "guard" or "step"})
 return true,"Recovered"
end
function Brawler.start(c,a,name)
 Bangla.close(a.pending)
 -- A strike pressed out of a dash or a chase (the arrival strike) takes over
 -- from it: the burst's speed does not carry the body on through its startup
 -- (Studio: rush -&gt; dash attack slid 1.9 studs into the opponent).
 if a.state=="Rush" or a.state=="Pursuit" then a.rush=nil;a.aimIntent=nil;Brawler.brake(a,Config.Rush.Carry or 8);c:travelArrive(a) end
 a.attackWhiffed=nil
 -- Any new strike drops a pending running-strike hand-back (it is for the
 -- run after the swing, not for the next blow of a string).
 a.strikeCarry=nil
 -- A strike another body may carry out (MoveGraphs proxy: Naruto's clones),
 -- or its solo / awakened form when there is no body for it.
 local proxy,kind
 name,proxy,kind=Bodies.route(c,a,name)
 local spec=table.clone(Attacks[name]);spec.travel*=a.def.CombatTravel or 1
	-- (Stage 6) a string's middle hits (Light4, Light5) use the tuning of the
	-- hit whose clip they borrow (Gaara's lashes keep their reach).
	local profile=a.def.AttackProfile and (a.def.AttackProfile[name] or a.def.AttackProfile[Attacks[name].clip or ""])
	if profile then
		spec.startup*=profile.startup or 1;spec.active*=profile.active or 1;spec.recovery*=profile.recovery or 1;spec.travel*=profile.travel or 1
		spec.travelTime=spec.startup+spec.active;spec.range=profile.range or spec.range;spec.angle=profile.angle
		spec.zone=profile.zone or spec.zone;spec.kind=profile.kind or spec.kind
		spec.chainTool=profile.chainTool;spec.depth=profile.depth or spec.depth;spec.damageScale=profile.damage;spec.offset=profile.offset or spec.offset;spec.width=profile.width or spec.width;spec.impulse=Vector3.new(spec.impulse.X,profile.impulseY or spec.impulse.Y,profile.impulseZ or spec.impulse.Z)
		-- A weapon's reach: the step-in stops further out (Temari's iron fan).
		spec.contact=profile.contact or spec.contact
	end
 -- A drawn kunai (Combat:arm, global): the string and heavy cut with it.
 -- A fighter's own blade (def.Weapon: Kakashi's tanto) cuts further, on the
 -- moves it lists.
 local weapon=a.def.Weapon
 if a.armed and weapon and weapon.Moves[name] then
  spec.range=(spec.range or 5)+weapon.Reach;spec.contact=(spec.contact or 3.2)+weapon.Contact
  spec.damageScale=(spec.damageScale or 1)*weapon.Damage;spec.kind="slash"
 elseif a.armed and not weapon and (name=="Light1" or name=="Light2" or name=="Light3" or name=="Light4" or name=="Light5" or name=="Heavy") then
  spec.range=(spec.range or 5)+.6;spec.contact=(spec.contact or 3.2)+.4
  spec.damageScale=(spec.damageScale or 1)*1.1;spec.kind="slash"
 end
 -- A chakra load (ChakraFlow, hold the modifier): this strike takes it.
 local chakraFlow=require(script.Parent.ChakraFlow).strike(c,a,name,spec)
 -- An awakening that quickens the body (Awakening.Recovery: Naruto's cloak).
 local awake=a.def.Awakening
 if awake and awake.Recovery and (a.awakenUntil or 0)&gt;c.now then spec.recovery*=awake.Recovery end
 -- A strike that opens (no string alive) may be pushed at an enemy body.
 local opener=not Brawler.stringAlive(c,a,spec.air==true)
 a.buffered=nil
 a.attackVariant=nil
 a.hitBlocked=false
 a.attackSerial=(a.attackSerial or 0)+1
 -- String bookkeeping: a chain move records the count it confirms if it
 -- connects (the string continues only while it is alive); a string ender
 -- (third light, route, heavy, grab, slam) closes its string now.
 local air=spec.air==true
 local step=nil
 if spec.chain then
  if not Brawler.stringAlive(c,a,air) then Brawler.breakString(a,air) end
  step=((if air then a.airCombo else a.combo) or 0)+1
 else
  Brawler.breakString(a,air or name=="Slam")
 end
 a.arrivalRecovery=nil
 a.attackName=name;a.attackStarted=c.now;a.hitConfirmed=false;a.chainOpen=false;a.chainAt=c.now+1e9;a.guardHeld=false
 -- The swing must reach the client as fast as the contact it leads to.
 c.urgent=true
 local slamWindow=0
 if name=="Slam" then
  -- Size the descent so the active window provably ends on or near the floor.
  local drop=math.max(6,a.root.Position.Y-(c.match.origin.Y+3.4))
  -- The plunge starts from rest and accelerates at 320 studs/s² up to 118
  -- (Motor.descend): time that fall, not an instant 118, or the window ends in
  -- mid-air and the recovery hovers there.
  local reach=118*118/(2*320)
  local fall=if drop&lt;=reach then math.sqrt(2*drop/320) else 118/320+(drop-reach)/118
  slamWindow=math.clamp(fall+.04,.28,1.1)
 elseif name=="WallDive" then
  -- The dive lasts as long as the flight to the opponent (92 studs/s).
  local gap=(a.target.root.Position-a.root.Position).Magnitude
  slamWindow=math.clamp(gap/88,.16,.5)
 end
 a.pending={kind="Brawl",name=name,spec=spec,hit=false,slamWindow=slamWindow,flow=a.nextFlow==true,step=step,chakraFlow=chakraFlow}
 -- (07/11, Studio: the Chidori Nagashi's current lasted 0.23 s, the pending
 -- strike is gone in recovery) the snapshot keeps the nature to its end.
 a.flowShown=if chakraFlow then {serial=a.attackSerial,nature=chakraFlow} else nil
 if not a.nextFlow then a.flowStreak=0 end
 a.nextFlow=nil
 Bangla.begin(c,a,a.pending)
 a.travelRemaining=spec.travel
 local flat=a.root.CFrame.LookVector*Vector3.new(1,0,1)
 local delta=a.target.root.Position-a.root.Position;delta=delta*Vector3.new(1,0,1)
 -- (Soft lock, user 03/11: free lens, blows thrown at the air behind him)
 -- not locked on, a blow started within SoftLock.Reach steps at him too.
 local soft=a.playerInput and not a.locked and Config.SoftLock
 if delta.Magnitude&gt;.1 and delta.Magnitude&lt;(if soft then soft.Reach else 11) and (flat:Dot(delta.Unit)&gt;.55 or a.locked or soft) then
  -- (the line is the one he stood on at the press: a body that moves after
  -- it is not chased round, Embodiment)
  if soft and flat:Dot(delta.Unit)&lt;math.cos(math.rad(40)) then a.pending.softDir=delta.Unit end
  flat=delta.Unit
 end
 -- The lock stays on the real fighter, but an opener pushed at one of his
 -- bodies (a shadow clone in reach) swings at it (Bodies.aim; Combat turns
 -- and steps toward it).
 local body=opener and not spec.air and Bodies.aim(c,a)
 if body then
  a.pending.aim=body
  local to=body.position-a.root.Position
  flat=Vector3.new(to.X,0,to.Z).Unit
 end
 -- Locked on, a strike started mid-run turns into the opponent during its
 -- startup (Combat:turnToward, bounded rate) instead of snapping in one frame.
	local side=a.root.CFrame.RightVector*(spec.angle or 0)
	a.travelDirection=(flat+side).Unit;a.state="Startup";a.untilTime=c.now+spec.startup
 if proxy then Bodies.bind(c,a,a.pending,proxy,kind) end
 if spec.air or name=="Slam" then
  -- The air hold carries a string that works (or the first swing of a jump,
  -- and the slam): mashed whiffs used to keep a body hovering a stud above the
  -- floor indefinitely (an AI duel showed four seconds of Air1/Air2 over a
  -- knocked-down opponent).
  -- Movement overhaul (Studio, real keys): a jump-in swing with nobody in
  -- reach keeps the jump's momentum and gravity (a sprint leap's air light
  -- froze at the apex, 58 studs/s to 0); the hold is for an air string at a
  -- body in reach.
  local tgt=a.target and a.target.root
  local gap=tgt and (tgt.Position-a.root.Position)
  local inReach=gap~=nil and Vector3.new(gap.X,0,gap.Z).Magnitude&lt;=(spec.range or 5)+4 and math.abs(gap.Y)&lt;10
  if name=="Slam" or (a.airCombo or 0)&gt;=1 or (not a.airSwingUsed and inReach) then
   -- Combat convergence (Studio: the body hung still ~0.4 s after the last
   -- air hit, a hover): the hold covers the swing itself; through the
   -- recovery gravity takes the body back (the juggled body falls with it, so
   -- the string still reaches). The slam keeps its full hold.
   a.airHold=c.now+spec.startup+math.max(spec.active,slamWindow)+(if name=="Slam" then spec.recovery+.18 else .06)
  end
  a.airSwingUsed=true
 end
 -- Lateral routes leave an afterimage where the body was (a flash for Minato).
 if name=="FeintStep" or name=="AirSwitch" or name=="CircleStep" then
  c:pushImpact(a.root.Position,if a.fighterId=="Flashstep" then "quickstep" else "afterimage",false,{owner=a.id,fighter=a.fighterId})
  -- Where the afterimage stays (a skill build's echo payoff turns it into a decoy).
  a.stepFrom=a.root.Position
 end
 if name=="WallDive" then a.airborne=true;a.airHold=c.now+spec.startup end
 Brawler.event(c,a,name)
 return true
end
-- Disengage branch: hop out of the string while a blade (Minato) or a pair of
-- shuriken (Itachi) covers the retreat. Ends the string; buys space, not damage.
-- A body high above its grounded opponent and out of an air string's reach.
-- (É7) Shared geometry: the client's guess reads the same dive.
Brawler.AirDive=ActionContext.AirDive
function Brawler.airDive(c,a)
 local b=a.target
 if not b or b.health&lt;=0 or b.airborne or not a.airborne then return false end
 return ActionContext.airDive(a.root.Position,b.root.Position)
end
function Brawler.disengage(c,a,kind)
 Bangla.close(a.pending);a.pending=nil;a.attackName=nil;a.chainOpen=false;a.buffered=nil
 Brawler.breakString(a,false)
 local away=a.root.Position-a.target.root.Position;away=Vector3.new(away.X,0,away.Z)
 if away.Magnitude&lt;.1 then away=-a.root.CFrame.LookVector end
 local minato=kind=="Kunai"
 a.state="Recovery";a.untilTime=c.now+(if minato then .26 else .32);a.recoveryCancelAt=a.untilTime
 a.hop={direction=away.Unit,remaining=if minato then 5 else 6,speed=if minato then 46 else 38}
 c:beginThrow(a,{kind=kind,release=if minato then .07 else .1,count=if minato then 1 else 2,interval=.07,
  fire=function(index,target)
   local spread=if minato then Vector3.zero else a.root.CFrame.RightVector*(if index==1 then -.7 else .7)
   c:projectile(a,target+spread,if minato then 96 else 84,22,2,if minato then "kunai" else "shuriken")
  end})
 Brawler.event(c,a,"Disengage")
 return true
end
function Brawler.request(c,a,action)
 local relevant=action=="Attack" or action=="Heavy" or action=="Grab" or action=="ThrowUp"
 if not relevant then return nil end
 -- Throw break: grab back right as you are seized and both are thrown apart.
 if action=="Grab" and a.reaction=="Grabbed" and a.grabbedBy and c.now-(a.grabbedAt or -10)&lt;=Config.ThrowBreak then
  local g=a.grabbedBy
  Brawler.releaseGrab(g);Brawler.releaseGrab(a)
  local away=a.root.Position-g.root.Position;away=Vector3.new(away.X,0,away.Z)
  away=if away.Magnitude&gt;.05 then away.Unit else -a.root.CFrame.LookVector
  for _,x in {a,g} do Bangla.close(x.pending);x.pending=nil;x.attackName=nil;x.chainOpen=false;x.state="Recovery";x.untilTime=c.now+.22;x.recoveryCancelAt=c.now+.12 end
  a.hop={direction=away,remaining=3.5,speed=30};g.hop={direction=-away,remaining=3.5,speed=30}
  c:pushImpact(a.root.Position:Lerp(g.root.Position,.5),"clash",true,{direction=away})
  Brawler.event(c,a,"ThrowBreak");c:cue(a,"THROW BREAK",.7);c:cue(g,"THROW BROKEN",.7)
  return true
 end
 if not Brawler.free(a,c.now) then return false,"Reacting" end
 -- A state of the body (the Chidori held in the hand): the strike releases it.
 local released=BodyState.release(c,a,action)
 if released~=nil then return released end
 -- Riposte: right after a clean block or a perfect dodge, a strike comes out
 -- at once and opens a string (its contact is the string's first hit).
 if action=="Attack" and (a.riposteUntil or 0)&gt;c.now and (a.state=="Guarding" or a.state=="Neutral" or a.state=="Dodging" or a.state=="Recovery") and not a.airborne then
  a.riposteUntil=0;a.guardHeld=false;a.state="Neutral";a.untilTime=c.now;a.evade=nil
  Brawler.breakString(a,false);a.lastAttack=c.now
  c:cue(a,"RIPOSTE",.6);Brawler.event(c,a,"Riposte")
  return Brawler.start(c,a,Brawler.riposteMove(c,a))
 end
 if a.wall then
  -- From a wall run a strike becomes a dive at the opponent: height and an
  -- angle the guard has to read.
  local wall=a.wall
  Motor.detach(a,c.now,false)
  local diving=(action=="Attack" or action=="Heavy") and a.state=="Neutral" and a.target and a.target.health&gt;0
   and (a.target.root.Position-a.root.Position).Magnitude&lt;=Config.Wall.DiveRange
  -- (A dive swings round off the wall over its crouched beat, Combat's
  -- WallDive step; free fights showed the one-frame turn as a 125-165 degree snap.)
  if wall.mode~="run" and (action=="Attack" or action=="Heavy") and not diving then
   -- Movement overhaul (Studio): a strike off a climb swung at the wall itself
   -- (the body still faced it). It springs off: the body turns out, toward
   -- the opponent when they are on this side of the wall.
   local out=Vector3.new(wall.normal.X,0,wall.normal.Z)
   if a.target and a.target.root then
    local to=a.target.root.Position-a.root.Position;to=Vector3.new(to.X,0,to.Z)
    if to.Magnitude&gt;.1 and to.Unit:Dot(out)&gt;0 then out=to end
   end
   if out.Magnitude&gt;.05 then a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+out.Unit) end
  end
  if diving then
   return Brawler.start(c,a,"WallDive")
  end
 end
 if a.grabVictim then
  if action=="Attack" or action=="Heavy" or action=="Grab" or action=="ThrowUp" then
   return Brawler.start(c,a,if action=="Heavy" or action=="ThrowUp" then "ThrowUp" else "Throw")
  end
 end
 local pending=a.pending
 local canChain=Brawler.chainWindow(c,a)
 -- Re-entry windows: the end of a dodge, a dash or a chase arrival.
 local canDash=Brawler.arrival(c,a)
 local reentry=canDash and a.state~="Dodging"
 local style=reentry and Brawler.reentry(a)
 -- Rhythm: a chained press made on the beat (around the moment the chain
 -- opens, not mashed early during the swing) becomes a Flow strike. A bonus
 -- only: an off-beat press chains just the same.
 local pressAt=a.pressAt or c.now;a.pressAt=nil
 a.nextFlow=canChain and pressAt&gt;=(a.chainAt or 0)-Config.Flow.Early and pressAt&lt;=(a.chainAt or 0)+Config.Flow.Late
 -- Flying Thunder God arrival: the technique recovery is cancelled by a strike,
 -- so the teleport flows straight into an attack from the new angle. The
 -- arrival strike opens a fresh string.
 local canFlash=(a.state=="TechniqueRecovery" or a.state=="TechniqueActive") and (a.flashUntil or 0)&gt;c.now
  and (a.pending==nil or (a.pending.kind=="Technique" and a.pending.spec.Id=="Flashstep"))
 -- Rotation already repelled a strike and is winding down: the strike comes
 -- straight out of the spin as the counter.
 if action=="Attack" and (a.counterUntil or 0)&gt;c.now and (a.rotationCounterUntil or 0)&gt;c.now and (a.state=="TechniqueActive" or a.state=="TechniqueRecovery") then
  a.pending=nil;a.rotationUntil=0;c:setState(a,"Neutral",0)
  return Brawler.counterStart(c,a)
 end
 -- A strike pressed inside a counter stance (Read, Rotation) waits for the
 -- stance to pay off instead of being refused.
 if action=="Attack" and Brawler.counterStance(a) then a.counterQueued=c.now;return true,"Buffered" end
 if canFlash then
  a.flashUntil=0;a.state="Neutral";a.untilTime=c.now;a.pending=nil;pending=nil
  local gap=(a.target.root.Position-a.root.Position).Magnitude
  -- The arrival strike (Brawler.hit reads it: a chain carried through the jump).
  local function arrival(ok) a.flashStrike=a.attackSerial;return ok end
  if action=="Heavy" then
   if a.airborne then return arrival(Brawler.start(c,a,"Slam")) end
   return arrival(Brawler.start(c,a,"Launcher"))
  end
  if action=="Attack" then
   if a.airborne then Brawler.breakString(a,true);a.lastAirAttack=c.now;return arrival(Brawler.start(c,a,"Air1")) end
   Brawler.breakString(a,false);a.lastAttack=c.now
   -- (05/11, B1 lot 3: Minato's signature is "a mark, then an angle") At
   -- arm's length the arrival strike is his own: out of the crouch he lands
   -- in, the hips unwind and the reverse-grip blade cuts across from the new
   -- side (Flashstep.FlashStrike, on the light's timing). It hits harder and
   -- holds the body longer than a jab, for the string that follows; from
   -- behind it says so.
   if gap&lt;=5.5 and a.fighterId=="Flashstep" then
    local to=a.root.Position-a.target.root.Position;to=Vector3.new(to.X,0,to.Z)
    local look=a.target.root.CFrame.LookVector;look=Vector3.new(look.X,0,look.Z)
    local behind=to.Magnitude&gt;.1 and look.Magnitude&gt;.1 and look.Unit:Dot(to.Unit)&lt;-.2
    local ok=Brawler.start(c,a,"Light1")
    if ok and a.pending then
     local spec=table.clone(a.pending.spec)
     spec.damageScale=(spec.damageScale or 1)*1.5;spec.stun=math.max(spec.stun or .27,.42)
     a.pending.spec=spec;a.pending.fromBehind=behind
     a.attackVariant="FlashStrike"
    end
    return arrival(ok)
   end
   return arrival(Brawler.start(c,a,if gap&gt;5.5 then "DashAttack" else "Light1"))
  end
 end
 if a.state~="Neutral" and a.state~="Guarding" and not canChain and not canDash then
  if bufferable(a) then
   -- Buffer a press made before the outcome of the committed swing, chase,
   -- dash or teleport is known: a press made a few frames early is never
   -- eaten, yet it prepares nothing. It fires when the chain opens (the swing
   -- landed cleanly), on the arrival, or, after a whiff or a block, as a fresh
   -- opener once the full recovery is over. The direction is the one it was
   -- pressed with (or pushed while it waits): Brawler.step.
   local dir,sideSign=Brawler.intent(a)
   a.buffered={action=action,at=c.now,intent={dir,sideSign},explicit=a.intentOverride~=nil,expires=bufferExpiry(a)}
   return true,"Buffered"
  end
  return false,"Committed"
 end
 if action=="Grab" then
  if a.airborne or (a.grabCooldown or 0)&gt;c.now then return false,"Grab unavailable" end
  a.grabCooldown=c.now+1.4;return Brawler.start(c,a,"Grab")
 end
 if action=="ThrowUp" then return false,"No grab" end
 -- Running taijutsu: out of a full sprint the opening strike is the
 -- fighter's own running entry (its DashAttack: Bee's shoulder, Kimimaro's
 -- elbow, Zabuza's handle...; MoveGraphs runStrike names a kicker's flying
 -- kick) and the heavy a sliding sweep. Movement overhaul (Studio, real
 -- keys): the swing carries the run's speed and, after its recovery, hands
 -- part of it back so the run continues (the heavy pays more). Openers only:
 -- the confirmed-hit invariant is untouched.
 if not canChain and not canDash and a.state=="Neutral" and not a.airborne and a.sprinting and a.locomotion.Magnitude&gt;28 and (action=="Attack" or action=="Heavy") then
  local runSpeed=a.locomotion.Magnitude
  local runGraph=Brawler.graph(a) or {}
  -- (User 28/10) Running in is how anyone approaches: the light out of a
  -- run is the string's first blow, carried by the run (it never ends the
  -- exchange); the fighter's running strike (a flying kick that throws the
  -- body away) is a choice, on the heavy.
  local name=if action=="Heavy" then (runGraph.runStrike or "DashAttack") else "Light1"
  if not Attacks[name] then name="FlyingKick" end
  local ok=Brawler.start(c,a,name)
  local p=a.pending
  if ok~=false and p and p.kind=="Brawl" then
   local need=runSpeed*(p.spec.travelTime or .22)*.85
   if need&gt;p.spec.travel then p.spec.travel=need;a.travelRemaining=need end
   -- The run continues after the running strike; the light stays in the string.
   if action=="Heavy" then a.strikeCarry={dir=a.travelDirection,speed=runSpeed*.6,at=c.now} end
   Brawler.event(c,a,"RunningStrike")
  end
  return ok
 end
 local graph=Brawler.graph(a) or {}
 local routes=graph.routes or {}
 -- Inside a confirmed string: its chain window picks routes and heavy
 -- conversions; the light step alone also continues in the short grace after
 -- it (a press a moment late is still the next light, never a route).
 local alive=not a.airborne and Brawler.stringAlive(c,a,false)
 local inChain=canChain and alive
 if action=="Heavy" then
  if a.airborne then
   -- A fighter's own finisher in the same window (MoveGraphs airFinisher,
   -- Rock Lee's lotuses); Sasuke's Lion Combo below stays the default.
   if graph.airFinisher and (a.lionUntil or 0)&gt;c.now and a.target and a.target.health&gt;0 then return Brawler.airFinisher(c,a,graph.airFinisher) end
   -- Lion Combo: after Shadow of the Dancing Leaf, the heavy is a barrage
   -- that ends in a heel drop driving the body into the floor.
   if (a.lionUntil or 0)&gt;c.now and a.target and a.target.health&gt;0 then
    a.lionUntil=0
    -- The flip over the body: the heel comes down from above it.
    local b=a.target
    local look=b.root.Position-a.root.Position;look=Vector3.new(look.X,0,look.Z)
    look=if look.Magnitude&gt;.1 then look.Unit else a.root.CFrame.LookVector
    -- (Continuity blocker) Not a teleport: the body vaults there through
    -- the barrage's startup (Combat's vault step), so the heel comes down
    -- from where the body really went.
    a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+look)
    a.airborne=true
    local ok=Brawler.start(c,a,"Slam")
    if a.pending then a.vault={goal=b.root.Position+Vector3.new(0,2.4,0)-look*1.2,untilTime=c.now+a.pending.spec.startup,serial=a.attackSerial} end
    if a.pending then a.pending.spec.damage=17;a.pending.spec.impulse=Vector3.new(0,-90,8);a.attackVariant="LionBarrage" end
    c:cue(a,"LION COMBO",.9);Brawler.event(c,a,"LionCombo")
    return ok
   end
   -- (04/11, buttons) One air hit in, the heavy spikes him down (the route a
   -- stick pulled away picked); two or more, the plunge below.
   if (a.airCombo or 0)==1 and routes.airDown and Attacks[routes.airDown] and Brawler.stringAlive(c,a,true) then
    a.lastAirAttack=c.now
