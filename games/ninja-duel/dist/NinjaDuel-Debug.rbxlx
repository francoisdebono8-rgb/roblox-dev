	K(1,merge(AIR_I,{root={yaw=-84,roll=26},torso={roll=-16},head={yaw=60,roll=-18},rl={lift=86,out=72,knee=0,ankle=12},ll={lift=20,knee=70},ra={raise=50,out=-6,elbow=120},la={raise=30,out=30,elbow=80}}),"out"),
