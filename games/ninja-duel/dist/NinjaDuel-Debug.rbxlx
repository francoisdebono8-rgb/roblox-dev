      <Item class="ModuleScript" referent="ND107">
        <Properties>
          <string name="Name">Stage</string>
          <ProtectedString name="Source">-- The lane's stadium between duels (QA test of b822ee5, 12/11: « gel à chaque
-- début de duel », about 0.9 s frozen then 1 s of stutter at BEGIN, 6 out of
-- 6). Every Matches:start rebuilt the whole Courtyard (some two thousand
-- parts and meshes, Server/World) next to the two new bodies, and every
-- client received all of it in the same frame and walked it. Now a lane keeps
-- its stadium:
--   * the first one is built ahead, while the player is on the roster, and
--     its pieces reach the world a few at a time (Stage.reveal: PER_FRAME
--     instances a server frame; the Courtyard carries Building=true until the
--     last one is in, the clients wait for it before reading the stadium);
--   * a duel's damage is undone before the next duel (Stage.remember once the
--     stadium is whole, Stage.restore at each start): a cracked wall's colour,
--     a felled trunk's size and place and the tree mesh it carries, the
--     WorldReaction attributes; anything the duel left inside the stadium
--     goes. A piece that went missing (destroyed) rebuilds the stadium.
-- Only the pieces that changed are written, so a restore sends the clients
-- what the last duel broke, nothing else.
local RunService=game:GetService("RunService")
local Stage={}
Stage.PER_FRAME=160
-- What a duel can change on a stadium piece (Server/WorldReaction: cracks,
-- breaks; nothing else in the game writes to the stadium).
Stage.PROPS={"Size","CFrame","Color","Transparency","CanCollide","Material"}
Stage.ATTRIBUTES={"WorldState","WorldIntegrity"}
local jobs=setmetatable({},{__mode="k"})

-- The whole stadium as it stands now (call it on a pristine one).
function Stage.remember(yard)
	local record={yard=yard,known={},parts={},count=0}
	for _,d in yard:GetDescendants() do
		record.known[d]=true
		record.count+=1
		if d:IsA("BasePart") then
			local values={}
			for _,key in Stage.PROPS do values[key]=(d::any)[key] end
			record.parts[d]=values
		end
	end
	return record
end

-- Back to the remembered stadium. Returns whether it is whole (false: a piece
-- is gone, rebuild it) and how many instances were written or removed.
function Stage.restore(record)
	local yard=record.yard
	if not yard or not yard.Parent then return false,0 end
	local seen,changed=0,0
	local strays={}
	for _,d in yard:GetDescendants() do
		if record.known[d] then
			seen+=1
			local values=record.parts[d]
			if values then
				local wrote=false
				for key,value in values do
					if (d::any)[key]~=value then (d::any)[key]=value;wrote=true end
				end
				for _,name in Stage.ATTRIBUTES do
					if d:GetAttribute(name)~=nil then d:SetAttribute(name,nil);wrote=true end
				end
				if wrote then changed+=1 end
			end
		else
			table.insert(strays,d)
		end
	end
	-- Not the stadium's own (a log a duel left under its trunk): out.
	for _,d in strays do
		if d.Parent then d:Destroy();changed+=1 end
	end
	return seen==record.count,changed
end

-- Puts `yard` (built outside the world) under `parent` a few pieces a frame:
-- the floor first (the clients read it), then what the fighters touch, then
-- the decor. `done(yard)` runs once the last piece is in.
function Stage.reveal(yard,parent,done)
	local decor=yard:FindFirstChild("Decor")
	local floor=yard:FindFirstChild("Training floor")
	local pending={}
	for _,child in yard:GetChildren() do
		if child~=decor and child~=floor then table.insert(pending,{child,yard}) end
	end
	if decor then
		for _,child in decor:GetChildren() do table.insert(pending,{child,decor}) end
	end
	for _,entry in pending do entry[1].Parent=nil end
	yard:SetAttribute("Building",true)
	yard.Parent=parent
	local job={pending=pending,next=1,done=done}
	jobs[yard]=job
	task.spawn(function()
		while jobs[yard]==job do
			if Stage.step(yard,Stage.PER_FRAME) then break end
			if RunService.Heartbeat and RunService.Heartbeat.Wait then RunService.Heartbeat:Wait() else task.wait() end
		end
	end)
	return job
end

-- Moves up to `budget` instances in. Returns whether the stadium is complete.
function Stage.step(yard,budget)
	local job=jobs[yard]
	if not job then return true end
	if not yard.Parent then jobs[yard]=nil;return true end
	while job.next&lt;=#job.pending and budget&gt;0 do
		local entry=job.pending[job.next]
		job.next+=1
		entry[1].Parent=entry[2]
		budget-=1+#entry[1]:GetDescendants()
	end
	if job.next&lt;=#job.pending then return false end
	jobs[yard]=nil
	yard:SetAttribute("Building",nil)
	if job.done then job.done(yard) end
	return true
end

-- A duel that starts before the reveal is over gets the rest now.
function Stage.finish(yard)
	return Stage.step(yard,math.huge)
end

function Stage.building(yard)
	return jobs[yard]~=nil
end

return Stage
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND108">
        <Properties>
          <string name="Name">Techniques</string>
          <ProtectedString name="Source">-- Each entry supplies prerequisites and payoff. The combat pipeline owns cost,
-- channel, interruption, active window and recovery for every entry.
local Techniques = {}
local Elements=require(script.Parent.Elements)
-- Flying Thunder God seals. Minato can hold up to two planted kunai, one seal
-- placed on the opponent's body (a marked kunai that connects), and the marked
-- kunai still in flight. The stick chooses between them; with no input the
-- seal closest to the opponent wins, and a kunai in flight always does.
local MAX_PLANTED=2
local BODY_SEAL=5
Techniques.RANGE=90
local function syncAnchor(a)
	-- a.anchor mirrors the newest planted seal for HUD, AI and tooling.
	a.anchor=nil
	for _,entry in a.anchors or {} do if not entry.actor then a.anchor=entry end end
end
local function seals(c,a,now)
	local list={}
	local flying=c:markedInFlight(a)
	if flying then table.insert(list,{position=flying.position,flying=flying}) end
	local known={}
	for _,entry in a.anchors or {} do
		known[entry]=true
		if entry.expires&gt;now and (not entry.actor or entry.actor.health&gt;0) then
			table.insert(list,{position=if entry.actor then entry.actor.root.Position else entry.position,anchor=entry,body=entry.actor~=nil})
		end
	end
	-- A seal written directly into the single legacy slot still counts.
	if a.anchor and not known[a.anchor] and a.anchor.expires&gt;now then table.insert(list,{position=a.anchor.position,anchor=a.anchor}) end
	-- Yellow Flash: a body he has just launched, knocked away or splatted (his
	-- chase window is open) is a destination by itself. No seal is spent on it;
	-- the chase window is.
	local tune=a.def.Awakening
	local b=a.target
	if tune and tune.FlashPursuit and (a.awakenUntil or 0)&gt;now and b and b.health&gt;0 and (a.pursuitUntil or 0)&gt;now then
		local onBody=false
		for _,seal in list do if seal.body then onBody=true end end
		if not onBody then table.insert(list,{position=b.root.Position,body=true,virtual=true}) end
	end
	return list
end
Techniques.seals=seals
-- (Stage 6) Minato at 13: the Flying Thunder God is a prototype (spec
-- Prototype): it only knows the last seal he planted (a kunai still in
-- flight first), never a pick among them. In the Yellow Flash awakening it
-- is whole for a while: the stick picks, a launched body is a destination.
local function prototype(a,now)
	if (a.awakenUntil or 0)&gt;now and a.def.Awakening and a.def.Awakening.FlashWake then return false end
	for _,t in a.def.Techniques or {} do if t.Id=="Flashstep" then return t.Prototype==true end end
	return false
end
local function pick(c,a,now,range)
	local best,bestScore
	if prototype(a,now) then
		for _,seal in seals(c,a,now) do
			if (seal.position-a.root.Position).Magnitude&lt;=range then
				local score=if seal.flying then math.huge else ((seal.anchor and seal.anchor.plantedAt) or 0)
				-- (seals are listed oldest first: a tie goes to the later one)
				if not bestScore or score&gt;=bestScore then best,bestScore=seal,score end
			end
		end
		return best
	end
	local stick=Vector3.new(a.move.X,0,a.move.Z)
	for _,seal in seals(c,a,now) do
		local gap=(seal.position-a.root.Position).Magnitude
		if gap&lt;=range then
			local score
			if seal.flying then score=1000
			else
				local toward=Vector3.new(seal.position.X-a.root.Position.X,0,seal.position.Z-a.root.Position.Z)
				if stick.Magnitude&gt;.4 and toward.Magnitude&gt;2 then
					local dot=stick.Unit:Dot(toward.Unit)
					if dot&gt;.3 then score=500+dot*100-gap*.2 end
				end
				if not score then score=100-(if a.target then (seal.position-a.target.root.Position).Magnitude else gap) end
			end
			if not bestScore or score&gt;bestScore then best,bestScore=seal,score end
		end
	end
	return best
end
Techniques.pickSeal=pick
local function sealOf(c,a,now)
	local seal=pick(c,a,now,math.huge)
	if seal then return seal.position,seal.flying end
	return nil,nil
end
Techniques.sealOf=sealOf
function Techniques.consumeSeal(c,a,seal)
	if seal.virtual then a.pursuitUntil=0;return end
	if seal.flying then seal.flying.dead=true;c:removeProjectile(seal.flying);return end
	local entry=seal.anchor
	if not entry then return end
	if entry.part then entry.part:Destroy() end
	local index=a.anchors and table.find(a.anchors,entry)
	if index then table.remove(a.anchors,index) end
	if a.anchor==entry then a.anchor=nil end
	syncAnchor(a)
end
function Techniques.expireSeals(c,a,now)
	if a.anchor and a.anchor.expires&lt;=now and not (a.anchors and table.find(a.anchors,a.anchor)) then
		if a.anchor.part then a.anchor.part:Destroy() end
		a.anchor=nil
	end
	if not a.anchors then return end
	local changed=false
	for i=#a.anchors,1,-1 do
		local entry=a.anchors[i]
		if entry.expires&lt;=now or (entry.actor and entry.actor.health&lt;=0) then
			if entry.part then entry.part:Destroy() end
			table.remove(a.anchors,i);changed=true
		end
	end
	if changed then syncAnchor(a) end
	-- Skill build (Kunai Recall): running over a planted kunai picks it up.
	local recall=a.def.SealRecall
	if recall and a.health&gt;0 and not a.reaction then Techniques.recall(c,a,now,recall) end
end
-- Kunai Recall (SkillTrees Flashstep.KunaiRecall): standing on one of his own
-- planted kunai removes it and refunds a little chakra. A seal planted under
-- 0.6 s ago is never swallowed by the throw that just planted it.
function Techniques.recall(c,a,now,recall)
	for i=#a.anchors,1,-1 do
		local entry=a.anchors[i]
		if not entry.actor and now-(entry.plantedAt or now)&gt;=.6 then
			local d=entry.position-a.root.Position
			if Vector3.new(d.X,0,d.Z).Magnitude&lt;=recall.Radius and math.abs(d.Y)&lt;4 then
				if entry.part then entry.part:Destroy() end
				table.remove(a.anchors,i);syncAnchor(a)
				a.chakra=math.min(a.def.Chakra or 100,a.chakra+recall.Refund)
				c:cue(a,"KUNAI RECOVERED • +"..recall.Refund.." CHAKRA",.7)
				require(script.Parent.Brawler).event(c,a,"KunaiRecall")
				return entry
			end
		end
	end
	return nil
end
-- Plant a seal on a surface, or on the opponent's body when the kunai connects.
function Techniques.plant(c,a,surface,normal,victim)
	a.anchors=a.anchors or {}
	a.sealSerial=(a.sealSerial or 0)+1
	local entry
	if victim then
		for i=#a.anchors,1,-1 do
			if a.anchors[i].actor then
				if a.anchors[i].part then a.anchors[i].part:Destroy() end
				table.remove(a.anchors,i)
			end
		end
		entry={actor=victim,position=victim.root.Position,expires=c.now+BODY_SEAL,id=a.sealSerial,plantedAt=c.now,
			part=c:effect("Body seal",victim.root.Position,a.color,Vector3.new(.6,.6,.6),BODY_SEAL)}
		c:cue(a,"SEAL ON TARGET • 2 TO FOLLOW",.9)
	else
		local planted={}
		for i,existing in a.anchors do if not existing.actor then table.insert(planted,i) end end
		if #planted&gt;=MAX_PLANTED then
			local oldest=a.anchors[planted[1]]
			if oldest.part then oldest.part:Destroy() end
			table.remove(a.anchors,planted[1])
		end
		local offset=if normal.Y&gt;0.5 then Vector3.new(0,3,0) else normal*3+Vector3.new(0,1,0)
		local at=c:clamp(surface+offset)
		-- Skill build (Seal Ink) may lengthen how long a planted seal holds.
		local life=(a.def.Seals and a.def.Seals.PlantedLife) or 12
		entry={position=at,surface=surface,normal=normal,expires=c.now+life,id=a.sealSerial,plantedAt=c.now,
			part=c:effect("Anchor",surface+normal*0.2,a.color,Vector3.new(1.3,0.2,1.3),life)}
		local count=0
		for _,existing in a.anchors do if not existing.actor then count+=1 end end
		c:cue(a,if count&gt;=1 then "SECOND SEAL PLANTED" else "SEAL PLANTED")
	end
	table.insert(a.anchors,entry)
	syncAnchor(a)
	return entry
end
-- Minato's substitution can reach a planted seal: the farthest one from the
-- attacker that is still in range. Spending a seal to escape is the cost.
function Techniques.escapeSeal(c,a,now)
	local attacker=a.target
	local best,bestGap
	for _,seal in seals(c,a,now) do
		if not seal.flying and not seal.body then
			local gap=(seal.position-a.root.Position).Magnitude
			local fromAttacker=if attacker then (seal.position-attacker.root.Position).Magnitude else gap
			if gap&lt;=70 and fromAttacker&gt;9 and (not bestGap or fromAttacker&gt;bestGap) then best,bestGap=seal,fromAttacker end
		end
	end
	return best
end
Techniques.MarkedBlade = {
	check = function() return true end,
	execute = function(c, a, pending, now)
		local aim=pending.aim or (a.target and a.target.root.Position) or a.root.Position+a.root.CFrame.LookVector*30
		c:projectile(a, aim, 82, pending.spec.Range, pending.spec.Damage, "marked", function(position, normal, victim)
			if a.health &lt;= 0 or c.match.phase ~= "Duel" then return end
			Techniques.plant(c,a,position,normal,victim)
		end)
	end,
}
Techniques.Flashstep = {
	check = function(c, a, _spec, now)
		return pick(c,a,now,Techniques.RANGE)~=nil
	end,
	execute = function(c,a,_pending,now)
		local seal=pick(c,a,now,Techniques.RANGE)
		if not seal then c:cue(a,"SEAL LOST"); return end
		local target=c:clamp(seal.position)
		-- A seal on (or right next to) the opponent puts Minato beside them. The
		-- stick picks the side; with no input he lands on the far side from where
		-- he left. Choosing the side is the mixup.
		local victim=a.target
		local beside=false
		if victim and victim.health&gt;0 then
			local toward=victim.root.Position-seal.position
			local flatGap=Vector3.new(toward.X,0,toward.Z).Magnitude
			if flatGap&lt;7 or seal.body then
				local stick=Vector3.new(a.move.X,0,a.move.Z)
				local side
				if stick.Magnitude&gt;.4 then side=stick.Unit
				else
					side=Vector3.new(victim.root.Position.X-a.root.Position.X,0,victim.root.Position.Z-a.root.Position.Z)
					side=if side.Magnitude&lt;.1 then -victim.root.CFrame.LookVector else side.Unit
				end
				target=c:clamp(Vector3.new(victim.root.Position.X,math.max(victim.root.Position.Y,c.match.origin.Y+3),victim.root.Position.Z)+side*3.4)
				beside=true
			end
		end
		if target.Y&lt;c.match.origin.Y+3 then target=Vector3.new(target.X,c.match.origin.Y+3,target.Z) end
		-- Never relocate into solid geometry, and never accept a client destination.
		local overlaps = workspace:GetPartBoundsInBox(CFrame.new(target),Vector3.new(2.6,4.6,2.6),c:overlapParams())
		for _, p in overlaps do
			if p.CanCollide and not p:IsDescendantOf(a.model) then
				if beside then target=c:clamp(seal.position);beside=false;break end
				c:cue(a,"ARRIVAL BLOCKED"); return
			end
		end
		local departure=a.root.Position
		c:effect("Departure",departure,a.color,Vector3.new(2,5,2),0.3)
		c:relocate(a,target)
		-- Arrive already facing the opponent so the follow-up starts on frame one.
		if victim and victim.health&gt;0 then
			local face=victim.root.Position-a.root.Position;face=Vector3.new(face.X,0,face.Z)
			if face.Magnitude&gt;.1 then a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+face) end
		end
		a.airborne=a.root.Position.Y&gt;c.match.origin.Y+4.2
		c:effect("Arrival",target,a.color,Vector3.new(3,5,3),0.45)
		Techniques.consumeSeal(c,a,seal)
		-- Yellow Flash: every jump leaves its own return point (a floor seal
		-- where he stood) and the arrival stays open longer, so relocations
		-- chain A -&gt; B -&gt; A instead of ending on the first arrival.
		local tune=a.def.Awakening
		local awake=tune~=nil and (a.awakenUntil or 0)&gt;now
		if awake and tune.FlashWake then
			local wake=Techniques.plant(c,a,Vector3.new(departure.X,c.match.origin.Y,departure.Z),Vector3.yAxis)
			wake.wake=true
			require(script.Parent.Brawler).event(c,a,"FlashWake")
		end
		-- The arrival opens a short window in which a strike (or Rasengan, with
		-- almost no wind-up) cancels the technique recovery.
		a.flashUntil=now+(if awake and tune.Arrival then tune.Arrival else .55);a.teleportAt=now
		a.teleportSerial=(a.teleportSerial or 0)+1
		c:pushImpact(target,"teleport",false,{owner=a.id,fighter=a.fighterId,from=departure,to=target,projectile=seal.flying and seal.flying.id,awake=awake,body=seal.virtual==true})
		c:travelStart(a,"teleport","FlyingThunderGod",departure,target,0)
		local left=#seals(c,a,now)
		if seal.virtual then c:cue(a,"YELLOW FLASH • FLYING THUNDER GOD TO THE BODY",.7)
		else c:cue(a,if left&gt;0 then "FLYING THUNDER GOD • "..left.." SEAL"..(if left&gt;1 then "S" else "").." LEFT" else "FLYING THUNDER GOD",.7) end
	end,
}
Techniques.BurstStrike = {
	check = function() return true end,
	execute = function(c,a,pending)
		local Brawler=require(script.Parent.Brawler)
		if pending.variant=="RasenganDrop" then
			-- Airborne (chase, jump, wall): the Rasengan is driven straight down
			-- into the opponent and the floor, ending the air phase.
			Brawler.start(c,a,"Slam")
			local spec=table.clone(a.pending.spec)
			-- Skill build (Rasengan Drive): DropReaction "Spiked" makes the body
			-- bounce once off the floor for a pick-up instead of a flat knockdown.
			spec.damage=pending.spec.Damage*.9;spec.reaction=pending.spec.DropReaction or "Knockdown";spec.impulse=Vector3.new(0,-70,16);spec.stun=.92
			spec.width=6.5;spec.height=8
			a.pending.spec=spec;a.pending.rasengan=true;a.attackVariant="RasenganDrop"
			c:pushImpact(a.root.Position,"burst",false,{owner=a.id,fighter=a.fighterId})
			return
		end
		-- Channel commits chakra; release becomes a travelling physical attack.
		Brawler.start(c,a,"DashAttack")
		a.pending.spec=table.clone(a.pending.spec)
		a.pending.spec.damage=pending.spec.Damage;a.pending.spec.travel=10;a.pending.spec.recovery=.48
		-- Rasengan drives the body away spinning instead of a jab's stagger.
		a.pending.spec.reaction="Knockback";a.pending.spec.impulse=Vector3.new(0,22,70);a.pending.spec.stun=.62
		a.pending.rasengan=true;a.attackVariant="Rasengan"
		a.travelRemaining=10
		if pending.variant=="FlashRasengan" then
			-- Out of a teleport he is already beside the target: a short, fast thrust.
			-- It is an arrival strike too (a combo carried through the jump: Brawler.hit).
			a.pending.spec.travel=5;a.travelRemaining=5;a.pending.spec.recovery=.4
			a.flashStrike=a.attackSerial
		end
		c:pushImpact(a.root.Position,"burst",false,{owner=a.id,fighter=a.fighterId})
	end,
}
Techniques.Read = {
	check = function() return true end,
	execute = function(c,a,pending,now)
		a.readUntil = now + pending.spec.Active
		c:effect("Read",a.root.Position,a.color,Vector3.new(4,0.2,4),pending.spec.Active)
		c:cue(a,"READ WINDOW")
	end,
}
Techniques.NeedleFan = {
	check = function() return true end,
	execute = function(c,a,pending)
		local direction = pending.aim-a.root.Position
		if direction.Magnitude &lt; 0.1 then direction = a.root.CFrame.LookVector end
		-- Five real shuriken in a fan: the centre blade tracks, the outer ones
		-- close the sideways escape.
		local origin=c.launchPoint(a,"Shuriken")
		for _, angle in { -0.2,-0.1,0,0.1,0.2 } do
			local d = CFrame.fromAxisAngle(Vector3.yAxis,angle):VectorToWorldSpace(direction.Unit)
			c:projectile(a,origin+d*pending.spec.Range,74,pending.spec.Range,pending.spec.Damage,"shuriken",nil,{origin=origin})
		end
		-- Shadow Shuriken: two more blades hidden behind the fan, released a beat
		-- later at wherever the opponent went to dodge it.
		for k=1,2 do
			c:schedule(c.now+.26+k*.06,function()
				if a.health&lt;=0 or a.reaction or a.state=="Stunned" or not a.target or a.target.health&lt;=0 then return end
				local victim=a.target
				local lead=victim.root.AssemblyLinearVelocity*Vector3.new(1,0,1)*.18
				if pending.spec.FlankBlades then
					-- Skill build (Flank Blades): each hidden blade is redirected
					-- beside the opponent and comes in from a flank, past a frontal guard.
					local toward=Vector3.new(victim.root.Position.X-a.root.Position.X,0,victim.root.Position.Z-a.root.Position.Z)
					toward=if toward.Magnitude&gt;.1 then toward.Unit else a.root.CFrame.LookVector
					local side=Vector3.new(-toward.Z,0,toward.X)*(if k==1 then -1 else 1)
					-- Beside and a little past the body, like Geometry's meeting point.
					local from=victim.root.Position+side*6+toward*1.5
					c:pushImpact(from,"clash",false,{owner=a.id,direction=-side})
					c:projectile(a,victim.root.Position+lead,86,12,pending.spec.Damage,"shuriken",nil,{origin=from})
					return
				end
				c:projectile(a,victim.root.Position+lead+a.root.CFrame.RightVector*(if k==1 then -.6 else .6),86,pending.spec.Range,pending.spec.Damage,"shuriken")
			end)
		end
		c:cue(a,"SHADOW SHURIKEN",.6)
	end,
}
-- Genjutsu: Mirage. Itachi leaves his image standing where he was and
-- withdraws a few steps straight back behind it, on the very line the
-- opponent is watching: the image covers him. A swing that reaches the image
-- (and not the body) gives the read away: the image breaks, the swing is
-- exposed and Itachi steps through his image with the counter palm. Trusting
-- the body works: walking into the image dissolves it, a blade thrown at him
-- passes through it, and any blow (his or yours) breaks the genjutsu.
local MIRAGE={Withdraw=5.5,Life=2.6,Touch=1.6,Reach=2,Exposed=.55,Counter=1.1,CounterReach=9}
Techniques.MIRAGE=MIRAGE
Techniques.MirageCast = {
	check = function(c,a,spec)
		return c:targetValid(a,a.target,spec.Range,0.35)
	end,
	execute = function(c,a,pending,now)
		if not c:targetValid(a,a.target,pending.spec.Range,0.35) then c:cue(a,"CAST LOST SIGHT"); return end
		local victim = a.target
		-- The Byakugan sees chakra, not light: the image has none.
		if victim.def.Byakugan then
			-- (07/11, Studio: a flash on his head, nothing else) the eye opens on
			-- its own for a moment: he sees Itachi's chakra network, no image.
			victim.sightUntil=math.max(victim.sightUntil or 0,c.now+1.8)
			c:cue(victim,"BYAKUGAN • SEES THROUGH",1);c:cue(a,"GENJUTSU • SEEN THROUGH",1)
			c:pushImpact(a.root.Position,"mirage",false,{owner=a.id,fighter=a.fighterId,phase="seen",victim=victim.id})
			return
		end
		local Motor=require(script.Parent.Motor)
		local image=a.root.Position
		local away=image-victim.root.Position;away=Vector3.new(away.X,0,away.Z)
		away=if away.Magnitude&gt;.1 then away.Unit else -a.root.CFrame.LookVector
		if Motor.travel(a,c,away,MIRAGE.Withdraw)&lt;2.5 then
			-- A wall behind him: the withdrawal becomes a slip to the side (the
			-- stick's side when it points there); the image still stands in front.
			local side=Vector3.new(-away.Z,0,away.X)
			local stick=Vector3.new(a.move.X,0,a.move.Z)
			if stick.Magnitude&gt;.4 and stick:Dot(side)&lt;0 then side=-side end
			if Motor.travel(a,c,side,MIRAGE.Withdraw)&lt;2.5 then Motor.travel(a,c,-side,MIRAGE.Withdraw) end
		end
		local face=victim.root.Position-a.root.Position;face=Vector3.new(face.X,0,face.Z)
		if face.Magnitude&gt;.1 then a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+face) end
		victim.illusionUntil=now+MIRAGE.Life;victim.illusionAt=now;victim.illusionBy=a;victim.illusionKind="image"
		victim.decoyPosition=c:clamp(image)
		c:effect("Echo",victim.decoyPosition,a.color,Vector3.new(2,5,1),MIRAGE.Life)
		c:pushImpact(victim.decoyPosition,"mirage",false,{owner=a.id,fighter=a.fighterId,phase="cast",from=a.root.Position,to=victim.decoyPosition,victim=victim.id})
		c:cue(victim,"GENJUTSU • TRUST THE BODY",MIRAGE.Life)
		c:cue(a,"GENJUTSU • THE IMAGE HOLDS",1)
		require(script.Parent.Brawler).event(c,a,"Mirage")
	end,
}
-- Ends a genjutsu on `a` (the deceived fighter). why: "catch" | "touch" |
-- "break" | "expire"; the client finishes the image accordingly.
function Techniques.breakIllusion(c,a,why)
	local at=a.decoyPosition
	local caster=a.illusionBy
	a.illusionUntil=0;a.decoyPosition=nil;a.illusionBy=nil;a.illusionKind=nil;a.illusionAt=nil
	if at and why~="expire" then
		c:pushImpact(at,"mirage",false,{owner=caster and caster.id,fighter=caster and caster.fighterId,phase=why,victim=a.id})
	end
	if why=="touch" then
		c:cue(a,"GENJUTSU • DISPELLED",.7)
		if caster then c:cue(caster,"GENJUTSU • SEEN THROUGH",.7) end
	end
end
-- Every frame, for every fighter: a genjutsu image ends with its time, with
-- its caster, on any blow after it began (pain breaks it), or when the body
-- walks into the image. A skill-build echo (no kind) only keeps its timer.
function Techniques.stepIllusion(c,a,now)
	if (a.illusionUntil or 0)&lt;=now then
		if a.decoyPosition or a.illusionKind then a.decoyPosition=nil;a.illusionBy=nil;a.illusionKind=nil;a.illusionAt=nil end
		return
	end
	if a.illusionKind~="image" then return end
	local caster=a.illusionBy
	local since=a.illusionAt or now
	if not caster or caster.health&lt;=0 or (a.lastHurt or -10)&gt;since or (caster.lastHurt or -10)&gt;since then
		Techniques.breakIllusion(c,a,"break");return
	end
	local d=a.decoyPosition and a.decoyPosition-a.root.Position
	if d and a.state~="Startup" and a.state~="Active" and Vector3.new(d.X,0,d.Z).Magnitude&lt;=MIRAGE.Touch and math.abs(d.Y)&lt;4 then
		Techniques.breakIllusion(c,a,"touch")
	end
end
-- The swing bit the image: it breaks, the swing is exposed, the counter palm
-- opens with the reach to step through the image to the body.
function Techniques.mirageCatch(c,a,caster,pending,now)
	local legacy=a.illusionKind==nil
	Techniques.breakIllusion(c,a,"catch")
	caster.counterUntil=now+MIRAGE.Counter;caster.bonusUntil=now+MIRAGE.Counter
	caster.counterReach={expires=now+MIRAGE.Counter,max=MIRAGE.CounterReach,variant="MirageCounter"}
	require(script.Parent.Brawler).event(c,caster,"MirageCatch")
	c:cue(caster,"GENJUTSU • CAUGHT • PUNISH",1);c:cue(a,"GENJUTSU • EXPOSED",1)
	pending.spec=table.clone(pending.spec);pending.spec.recovery+=.32
	if not legacy then
		-- Exposed for a moment (a stun the counter reaches), not merely a longer
		-- recovery a dodge could cancel.
		c:schedule(now,function()
			if a.health&gt;0 and a.state=="Recovery" and not a.reaction then c:setState(a,"Stunned",MIRAGE.Exposed) end
		end)
	end
end
-- A committed swing that touched nothing (Combat, end of the active window).
-- Under a genjutsu image, a swing that reached the image is caught; under
-- Sharingan Focus any swing that misses close to Itachi is read. A skill-build
-- echo keeps its own rule: any swing at all while it holds.
function Techniques.whiffRead(c,a,pending,now)
	local caster=a.illusionBy or a.target
	if (a.illusionUntil or 0)&gt;now and caster and caster.health&gt;0 then
		local struck=false
		if a.illusionKind=="image" and a.decoyPosition then
			local d=a.decoyPosition-a.root.Position
			local flat=Vector3.new(d.X,0,d.Z)
			local reach=(pending.spec.range or 6)+MIRAGE.Reach
			struck=flat.Magnitude&lt;=reach and math.abs(d.Y)&lt;6 and (flat.Magnitude&lt;1 or a.root.CFrame.LookVector:Dot(flat.Unit)&gt;.3)
		elseif a.illusionKind==nil then
			struck=caster.fighterId=="Mirage"
		end
		if struck then Techniques.mirageCatch(c,a,caster,pending,now);return end
	end
	local eye=a.target
	local tune=eye and eye.def.Awakening
	if eye and eye.health&gt;0 and tune and tune.WhiffRead and (eye.awakenUntil or 0)&gt;now and not eye.reaction then
		local d=eye.root.Position-a.root.Position
		local flat=Vector3.new(d.X,0,d.Z)
		if flat.Magnitude&lt;=tune.WhiffRead and math.abs(d.Y)&lt;6 and (flat.Magnitude&lt;1 or a.root.CFrame.LookVector:Dot(flat.Unit)&gt;.2) then
			eye.counterUntil=math.max(eye.counterUntil or 0,now+.9);eye.bonusUntil=now+.9
			eye.counterReach={expires=now+.9,max=5,variant="ReadCounter"}
			pending.spec=table.clone(pending.spec);pending.spec.recovery+=.22
			c:pushImpact(eye.root.Position,"read",false,{owner=eye.id,fighter=eye.fighterId,victim=a.id,phase="whiff"})
			c:cue(eye,"SHARINGAN • WHIFF READ • PUNISH",.8);c:cue(a,"READ • EXPOSED",.6)
			require(script.Parent.Brawler).event(c,eye,"WhiffRead")
		end
	end
end
Techniques.Quickstep={
	check=function() return true end,
	execute=function(c,a,pending,now)
		local direction=if a.move.Magnitude&gt;0.2 then a.move else a.root.CFrame.RightVector
		local departure=a.root.Position
		local moved=require(script.Parent.Motor).travel(a,c,direction,11)
		c:effect("Quickstep",a.root.Position,a.color,Vector3.new(2,3,2),0.22)
		c:pushImpact(departure,"quickstep",false,{owner=a.id,fighter=a.fighterId,to=a.root.Position})
		-- Skill build (Quickstep Cut): the step opens the same arrival window as a
		-- teleport, so the new angle converts (strike, launcher or Rasengan).
		local arrival=pending and pending.spec.Arrival
		if arrival and moved&gt;3 then
			a.flashUntil=now+arrival
			c:cue(a,"ANGLE CREATED • STRIKE",arrival)
			return
		end
		c:cue(a,if moved&gt;3 then "ANGLE CREATED" else "ANGLE BLOCKED")
	end,
}
-- Dragon Flame: a Katon on an opponent held by Sasuke's wire runs along the
-- wire and cannot miss.
-- (06/11, Studio) the bind told the player "1 = DRAGON FLAME" while key 1 is
-- the Phoenix Flower and only 4 (the Great Fireball) ran the wire: pressing 1
-- threw flowers past it. Either Katon on the bar now runs the wire while it
-- holds, and the cue names the keys the bar really shows.
local WIRE_FIRE={FireBloom=true,PhoenixFlower=true}
function Techniques.wireFireKeys(a)
	local keys={}
	for i,t in (a.def and a.def.Techniques) or {} do if WIRE_FIRE[t.Id] then table.insert(keys,tostring(i)) end end
	return if #keys&gt;0 then table.concat(keys," OR ") else "KATON"
end
local function dragonFlame(c,a,pending)
	local b=a.wireVictim
	if b and b.reaction=="Bound" and b.boundBy==a and b.health&gt;0 and (a.wireBurnUntil or 0)&lt;=c.now then
		-- (Studio 06/11) the wire stays his until the fire reaches the body: let
		-- go here, the held wire vanished the instant the run began.
		-- (06/11, user: « le katon ne suit pas les fils de Sasuke ») Studio: the
		-- fire burst on the body the instant he breathed it, the wire never
		-- seen burning. The flame runs the wire now, from his mouth to the
		-- body, and the wire holds him until it arrives; a body that slipped
		-- the wire meanwhile (substitution) leaves it burning on nothing.
		local Chakra=require(script.Parent.ChakraCombat)
		local from=Chakra.wireStart(c,a)
		local travel=math.clamp((b.root.Position-from).Magnitude/Chakra.WireRun,.25,.65)
		b.reactionUntil=math.max(b.reactionUntil or 0,c.now+travel+.08)
		a.wireBurnUntil=c.now+travel
		Chakra.dragonRun(c,a,b,travel)
		c:cue(a,"KATON • DRAGON FLAME",1)
		-- (the Great Fireball's damage, whichever Katon key ran the wire)
		local damage=pending.spec.Damage
		for _,t in a.def.Techniques or {} do if t.Id=="FireBloom" then damage=t.Damage or damage end end
		c:schedule(c.now+travel,function()
			if a.wireVictim==b then a.wireVictim=nil end
			if a.health&lt;=0 or c.match.phase~="Duel" then return end
			if b.health&lt;=0 or b.reaction~="Bound" or b.boundBy~=a then return end
			b.boundBy=nil
			c.damageTag="Dragon Flame"
			local hit=c:damage(a,b,damage,true,false)
			c.damageTag=nil
			if c.match.phase~="Duel" then return end
			Chakra.dragonFlame(c,a,b)
			if hit then
				local away=b.root.Position-a.root.Position;away=Vector3.new(away.X,0,away.Z)
				away=if away.Magnitude&gt;.1 then away.Unit else a.root.CFrame.LookVector
				local Brawler=require(script.Parent.Brawler)
				Brawler.react(c,b,"Knockdown",away*30+Vector3.new(0,22,0),.8,a)
			end
		end)
		return true
	end
	return false
end
Techniques.dragonFlame=dragonFlame
-- Great Fireball (or the Dragon Flame on a wired body).
Techniques.FireBloom={check=function() return true end,execute=function(c,a,pending,now)
	if dragonFlame(c,a,pending) then return end
	Elements.fire(c,a,pending,now)
end}
-- Wire Trap: a shuriken trailing ninja wire; a body it reaches is bound.
Techniques.WireTrap={
	check=function() return true end,
	execute=function(c,a,pending)
		local aim=pending.aim or (a.target and a.target.root.Position) or a.root.Position+a.root.CFrame.LookVector*20
		c:projectile(a,aim,86,pending.spec.Range,pending.spec.Damage,"wire",nil,{radius=.7,riders=if pending.spec.WallPin then {wallPin=pending.spec.WallPin} else nil})
		c:cue(a,"WIRE TRAP",.5)
	end,
}
-- `riders` (skill builds): bind = a shorter bind for wired hidden blades;
-- wallPin = {Range, Bind}: a wall close behind the body along the wire ties it
-- against the surface for longer (Wire Pin).
function Techniques.wireBind(c,owner,victim,riders,direction)
	if victim.health&lt;=0 then return end
	local Brawler=require(script.Parent.Brawler)
	local duration=(riders and riders.bind) or 1.0
	local pinned=false
	local pin=riders and riders.wallPin
	local along=direction and Vector3.new(direction.X,0,direction.Z)
	if pin and along and along.Magnitude&gt;.05 then
		local hit=workspace:Raycast(victim.root.Position,along.Unit*pin.Range,c:rayParams(true))
		if hit and math.abs(hit.Normal.Y)&lt;.3 and Brawler.splatSurface(hit.Instance) then
			c:relocate(victim,Vector3.new(hit.Position.X,victim.root.Position.Y,hit.Position.Z)+hit.Normal*1.7)
			duration=pin.Bind;pinned=true
			c:pushImpact(victim.root.Position,"pin",false,{owner=owner.id,normal=hit.Normal})
		end
	end
	Brawler.react(c,victim,"Bound",Vector3.zero,duration,owner)
	victim.boundBy=owner;owner.wireVictim=victim
	-- The wire is a conductor while it holds: Sasuke's lightning may run down it
	-- (ChakraCombat.conduct), bounded from the moment the bind started.
	victim.boundAt=c.now;victim.wireConducts=0
	c:cue(owner,(if pinned then "WIRED TO THE WALL • " else "WIRED • ")..Techniques.wireFireKeys(owner).." = DRAGON FLAME",.9);c:cue(victim,"WIRED • Q TO ESCAPE",.9)
	Brawler.event(c,owner,if pinned then "WirePin" else "WireBind")
end
-- Chidori: the charge is the channel (slowed, interruptible); the release is
-- a straight lightning thrust that ends the fight's momentum either way.
Techniques.Chidori={
	check=function() return true end,
	execute=function(c,a,pending)
		local Brawler=require(script.Parent.Brawler)
		a.stringCancel=nil
		Brawler.start(c,a,"ChidoriThrust")
		if a.pending then a.pending.spec.damage=pending.spec.Damage end
		c:pushImpact(a.root.Position,"chidori",true,{owner=a.id})
		c:cue(a,"CHIDORI",.8)
		-- The risk, said to both: a thrust that touched nothing (not even a guard)
		-- leaves him open for its whole recovery.
		local thrust=a.pending
		local serial=a.attackSerial
		if thrust then
			c:schedule(c.now+thrust.spec.startup+thrust.spec.active+.02,function()
				if a.health&lt;=0 or a.attackSerial~=serial or a.hitConfirmed or a.state~="Recovery" or (a.clashedAt or -10)&gt;c.now-1 then return end
				c:cue(a,"CHIDORI • MISSED • OPEN",.8)
				if a.target and a.target.health&gt;0 then c:cue(a.target,"CHIDORI MISSED • PUNISH",.8) end
				Brawler.event(c,a,"ChidoriMissed")
			end)
		end
	end,
}
-- Gaara ----------------------------------------------------------------
-- Sand Coffin: a wave of sand runs along the ground; a body it reaches is bound
-- (held where it stands) and buried a beat later unless it substitutes out.
function Techniques.bindInSand(c,owner,victim,wet)
	if victim.health&lt;=0 or victim.invulnerableUntil&gt;c.now then return end
	local Brawler=require(script.Parent.Brawler)
	Brawler.react(c,victim,"Bound",Vector3.zero,1.25,owner)
	victim.boundBy=owner
	c:cue(owner,"SAND COFFIN • BOUND",.8);c:cue(victim,"BOUND • Q TO ESCAPE",.9)
	local spec
	for _,t in owner.def.Techniques do if t.Id=="SandCoffin" then spec=t end end
	c:schedule(c.now+1.05,function()
		if victim.reaction~="Bound" or victim.boundBy~=owner or owner.health&lt;=0 or victim.health&lt;=0 then return end
		victim.boundBy=nil
		c.damageTag="Sand Burial"
		-- (Stage 6) wet sand (the Coffin cast at a body in the water) crushes harder.
		c:damage(owner,victim,((spec and spec.Damage) or 18)*(if wet then wet.Damage else 1),false,false)
		c.damageTag=nil
		if c.match.phase~="Duel" or victim.health&lt;=0 then return end
		Brawler.react(c,victim,"Knockdown",Vector3.new(0,16,0),.7,owner)
		c:pushImpact(victim.root.Position,"sandburial",true,{owner=owner.id})
		c:cue(owner,"SAND BURIAL",.8)
	end)
end
Techniques.SandCoffin={
	check=function() return true end,
	execute=function(c,a,pending)
		local aim=pending.aim or (a.target and a.target.root.Position) or a.root.Position+a.root.CFrame.LookVector*20
		local origin=c.launchPoint(a,"Ground")
		local flat=Vector3.new(aim.X-origin.X,0,aim.Z-origin.Z)
		if flat.Magnitude&lt;1 then flat=a.root.CFrame.LookVector*Vector3.new(1,0,1) end
		-- (Stage 6) at a body in the water the sand is wet: slower, harder.
		local wet=a.target and require(script.Parent.Interactions).wetSand(c,a,a.target)
		local p=c:projectile(a,origin+flat.Unit*pending.spec.Range+Vector3.new(0,2,0),(pending.spec.Speed or 46)*(if wet then wet.Speed else 1),pending.spec.Range,4,"sandwave",nil,{origin=origin+Vector3.new(0,1,0),radius=1.8,growth=.6})
		if p and wet then p.wet=wet end
		if not wet then c:cue(a,"SAND COFFIN",.6) end
	end,
}
Techniques.SandShuriken={
	check=function() return true end,
	execute=function(c,a,pending)
		local direction=pending.aim-a.root.Position
		if direction.Magnitude&lt;.1 then direction=a.root.CFrame.LookVector end
		local origin=c.launchPoint(a,"Palm")
		for _,angle in {-.25,-.15,-.05,.05,.15,.25} do
			local d=CFrame.fromAxisAngle(Vector3.yAxis,angle):VectorToWorldSpace(direction.Unit)
			c:projectile(a,origin+d*pending.spec.Range,80,pending.spec.Range,pending.spec.Damage,"sand",nil,{origin=origin,radius=.5})
		end
	end,
}
-- Desert Wave: a wall of sand rises in front of him and throws close
-- attackers away; blades and fire in it are swallowed.
Techniques.DesertWave={
	check=function() return true end,
	execute=function(c,a,pending)
		local Brawler=require(script.Parent.Brawler)
		local reach=pending.spec.Range
		local look=a.root.CFrame.LookVector
		for i=#c.projectiles,1,-1 do
			local p=c.projectiles[i]
			local d=p.position-a.root.Position
			if p.a~=a and d.Magnitude&lt;=reach and look:Dot(d.Unit)&gt;.2 then
				table.remove(c.projectiles,i)
				c:pushImpact(p.position,"deflect",false,{projectile=p.id,kind=p.kind,owner=p.a.id})
			end
		end
		local b=a.target
		if b and b.health&gt;0 then
			local d=b.root.Position-a.root.Position
			local flat=Vector3.new(d.X,0,d.Z)
			if flat.Magnitude&lt;=reach and (flat.Magnitude&lt;2 or look:Dot(flat.Unit)&gt;.25) then
				c.damageTag="Desert Wave"
				local hit=c:damage(a,b,pending.spec.Damage,false,false)
				c.damageTag=nil
				if c.match.phase~="Duel" then return end
				if hit then Brawler.react(c,b,"Knockback",(if flat.Magnitude&gt;.1 then flat.Unit else look)*48+Vector3.new(0,16,0),.55,a) end
			end
		end
		c:pushImpact(a.root.Position+look*4,"sandwall",true,{owner=a.id,direction=look})
		c:cue(a,"DESERT WAVE",.6)
	end,
}
-- Rock Lee (stress-test wave, DEC-015) -----------------------------------
-- Pure taijutsu: nothing here is moulded into a jutsu. His technique is a
-- strike started by the jutsu pipeline (like the Chidori thrust), his tool
-- button a kick (Combat: def.Tool "Deflect") and his escape a kick too
-- (Combat:substitute, Mode "burst"). The lotuses are Brawler.airFinisher.
local LeeRules=require(game:GetService("ReplicatedStorage").NinjaDuel.Rules)
-- Konoha Daisenpū: a spinning kick that crosses the gap and knocks away.
Techniques.LeafGreatWhirlwind={
	check=function() return true end,
	execute=function(c,a,pending)
		local Brawler=require(script.Parent.Brawler)
		a.stringCancel=nil
		Brawler.start(c,a,"GreatWhirlwind")
		if a.pending then a.pending.spec.damage=pending.spec.Damage end
		c:pushImpact(a.root.Position,"afterimage",false,{owner=a.id,fighter=a.fighterId})
		c:cue(a,"LEAF GREAT WHIRLWIND",.7)
	end,
}
-- Blades a kick can send away; fire, wind, palms and sand waves are jutsu
-- volumes and go through.
local DEFLECTABLE={kunai=true,marked=true,shuriken=true,wire=true,sand=true}
Techniques.DEFLECTABLE=DEFLECTABLE
-- An enemy blade near him, or one flying at him from within `Reach`.
function Techniques.bladeIncoming(c,a,tune)
	for _,p in c.projectiles do
		if p.a~=a and DEFLECTABLE[p.kind] and not p.dead and not p.planted then
			local offset=a.root.Position-p.position
			local gap=offset.Magnitude
			if gap&lt;=tune.Radius or (gap&lt;=(tune.Reach or 24) and gap&gt;.1 and p.direction:Dot(offset.Unit)&gt;.6) then return true end
		end
	end
	return false
end
-- One sweep of the kick: every blade inside the frontal arc (Arc: cosine of
-- the half angle) and Radius is kicked out of the air.
function Techniques.deflectSweep(c,a,tune)
	local look=a.root.CFrame.LookVector*Vector3.new(1,0,1)
	look=if look.Magnitude&gt;.05 then look.Unit else Vector3.new(0,0,-1)
	local kicked=0
	for i=#c.projectiles,1,-1 do
		local p=c.projectiles[i]
		if p.a~=a and DEFLECTABLE[p.kind] and not p.planted then
			local d=p.position-a.root.Position
			local flat=Vector3.new(d.X,0,d.Z)
			if d.Magnitude&lt;=tune.Radius and math.abs(d.Y)&lt;5 and (flat.Magnitude&lt;1.2 or look:Dot(flat.Unit)&gt;=tune.Arc) then
				table.remove(c.projectiles,i);p.dead=true
				c:pushImpact(p.position,"deflect",false,{projectile=p.id,kind=p.kind,owner=p.a.id,direction=-p.direction})
				kicked+=1
			end
		end
	end
	if kicked&gt;0 then
		-- The Counter-Rush rule: the next chakra dash is free for a moment.
		a.freeRushUntil=c.now+(tune.FreeRush or .6)
		a.deflected=(a.deflected or 0)+kicked
		require(script.Parent.Brawler).event(c,a,"Deflect")
		c:cue(a,"DEFLECTED • E: FREE RUSH",.7)
	end
	return kicked
end
-- The tool button (Fighters.Leaf.Deflect): a crescent kick whose sweep runs
-- from the press to the end of its active window. It is a real strike on a
-- body in reach; with no blade coming and nobody in reach it does nothing.
function Techniques.deflectKick(c,a)
	local tune=a.def.Deflect
	if not tune then return false,"No tool" end
	if a.reaction or a.wall or a.throwing or not LeeRules.canAct(a,c.now) then return false,"Committed" end
	if (a.deflectReadyAt or 0)&gt;c.now then return false,"Tool recovering" end
	local b=a.target
	local close=b~=nil and b.health&gt;0 and (b.root.Position-a.root.Position).Magnitude&lt;=tune.Radius+2
	if not close and not Techniques.bladeIncoming(c,a,tune) then return false,"Nothing to deflect" end
	local Brawler=require(script.Parent.Brawler)
	a.deflectReadyAt=c.now+tune.Cooldown
	if not Brawler.start(c,a,"DeflectKick") then return false end
	local spec=a.pending.spec
	local serial=a.attackSerial
	local span=spec.startup+spec.active
	Techniques.deflectSweep(c,a,tune)
	for k=1,4 do
		c:schedule(c.now+span*k/4,function()
			if a.health&lt;=0 or a.reaction or a.attackSerial~=serial then return end
			Techniques.deflectSweep(c,a,tune)
		end)
	end
	Brawler.event(c,a,"DeflectKick")
	return true
end
-- The Rupture (Fighters.Leaf.Substitution, Mode "burst"): Combat:substitute
-- has spent the charge and the chakra, given the i-frames and kept him where he
-- is; this is the kick. A close attacker is thrown off. One that was out of
-- reach, guarded or evaded it leaves him a longer recovery to punish.
function Techniques.rupture(c,a,attacker,twist)
	local Brawler=require(script.Parent.Brawler)
	c:pushImpact(a.root.Position,"repel",true,{owner=a.id,fighter=a.fighterId,direction=a.root.CFrame.LookVector})
	Brawler.event(c,a,"Rupture")
	local landed=false
	if attacker and attacker.health&gt;0 then
		local away=attacker.root.Position-a.root.Position
		local flat=Vector3.new(away.X,0,away.Z)
		if flat.Magnitude&lt;=(twist.Radius or 5.5) then
			c.damageTag="Rupture"
			local hit=c:damage(a,attacker,twist.Damage or 4,false,false)
			c.damageTag=nil
			if c.match.phase~="Duel" then return true end
			landed=hit and attacker.impactStyle~="block"
			if landed then
				local push=if flat.Magnitude&gt;.1 then flat.Unit else a.root.CFrame.LookVector
				Brawler.react(c,attacker,"Knockback",push*(twist.Knockback or 40)+Vector3.new(0,12,0),.45,a)
			end
		end
	end
	if not landed then c:setState(a,"Recovery",twist.Whiff or .3) end
	c:cue(a,if landed then "RUPTURE" else "RUPTURE • READ",.7)
	if attacker then c:cue(attacker,if landed then "RUPTURE • THROWN OFF" else "RUPTURE • PUNISH HIS RECOVERY",.7) end
	return true
end
-- Neji -----------------------------------------------------------------
Techniques.ROTATION_REACH=7
Techniques.Rotation={
	check=function() return true end,
	execute=function(c,a,pending,now)
		local active=pending.spec.Active
		a.rotationUntil=now+active;a.rotationHit={};a.rotationDamage=pending.spec.Damage
		-- Skill builds: a wider dome (Reach) and blades sent back (Reflect).
		a.rotationReach=pending.spec.Reach;a.rotationReflect=pending.spec.Reflect
		a.invulnerableUntil=math.max(a.invulnerableUntil,now+active);a.rotationGuardUntil=a.invulnerableUntil
		c:pushImpact(a.root.Position,"rotation",true,{owner=a.id,fighter=a.fighterId,duration=active})
		c:cue(a,"EIGHT TRIGRAMS • ROTATION",.7)
	end,
}
Techniques.VacuumPalm={
	check=function() return true end,
	execute=function(c,a,pending)
		local aim=pending.aim or (a.target and a.target.root.Position) or a.root.Position+a.root.CFrame.LookVector*20
		local origin=c.launchPoint(a,"Palm")
		local flat=Vector3.new(aim.X-origin.X,0,aim.Z-origin.Z)
		if flat.Magnitude&lt;1 then flat=a.root.CFrame.LookVector*Vector3.new(1,0,1) end
		local goal=origin+flat.Unit*pending.spec.Range+Vector3.new(0,math.clamp(aim.Y-origin.Y,-4,2),0)
		-- Skill build (Sealing Palm): a clean hit closes a chakra point at range.
		c:projectile(a,goal,pending.spec.Speed or 96,pending.spec.Range,pending.spec.Damage,"palm",nil,{origin=origin,radius=1.5,growth=2.5,riders=if pending.spec.Tenketsu then {tenketsu=true} else nil})
		c:cue(a,"EIGHT TRIGRAMS • VACUUM PALM",.6)
	end,
}
-- Eight Trigrams Sixty-Four Palms. The opening palm must land (and can be
-- guarded); once it does, the flurry locks the opponent in place, drains its
-- chakra point by point and ends by sealing its techniques. It is the climax of
-- the network: every chakra point already closed adds palms, quickens them and
-- lengthens the seal, and with all of them closed the guard has nothing left
-- to hold the opening palm with. The victim keeps one answer: a substitution.
function Techniques.palmsPlan(points,seal)
	points=math.clamp(points or 0,0,8)
	return {strikes=7+points,interval=math.max(.1,.15-.012*points),final=2.5+.25*points,seal=(seal or 3.5)+.4*points}
end
-- The count called on the k-th of n palms: the six calls (2, 4, 8, 16, 32, 64)
-- spread evenly over the flurry, the first palm already "two", 64 on the last
-- palm only (the one that throws the body).
function Techniques.palmCount(k,n)
	local count=2
	for j=2,6 do if k&gt;=math.floor(j*n/6+.5) then count=2^j end end
	return count
end
-- How far the 64 Palms' stance steps in to reach the body (studs).
Techniques.PALMS_CLOSE=11
Techniques.SixtyFourPalms={
	check=function() return true end,
	-- (Jutsu pass 05/11, from the films: « les 64 paumes ne touchent qu'à 5
	-- studs ») The stance steps in: from a little past his reach (up to
	-- PALMS_CLOSE studs, in sight), the channel glides him to the body, as the
	-- anime's step into the field; farther away the palms still miss. The
	-- glide is the ultimates' (Ultimates.step moves the body on it).
	start=function(c,a,pending)
		local victim=a.target
		if not victim or victim.health&lt;=0 then return end
		local d=victim.root.Position-a.root.Position
		local flat=Vector3.new(d.X,0,d.Z)
		local range=pending.spec.Range or 5
		if flat.Magnitude&lt;=range-.5 or flat.Magnitude&gt;Techniques.PALMS_CLOSE or not c:lineOfSight(a,victim) then return end
		local goal=Vector3.new(victim.root.Position.X,a.root.Position.Y,victim.root.Position.Z)-flat.Unit*3
		a.ultimateGlide={from=a.root.Position,to=c:clamp(goal),t0=c.now,t1=c.now+math.max(.12,(pending.spec.Channel or .22)*.9),face=victim}
	end,
	execute=function(c,a,pending,now)
		local Brawler=require(script.Parent.Brawler)
		local victim=a.target
		local g=a.def.GentleFist
		pending.spec=table.clone(pending.spec)
		local points=if victim and (victim.tenketsuUntil or 0)&gt;now then victim.tenketsu or 0 else 0
		c:pushImpact(a.root.Position,"trigram",false,{owner=a.id,fighter=a.fighterId,points=points})
		local reach=victim and victim.health&gt;0 and c:targetValid(a,victim,pending.spec.Range,.4)
		if not reach or victim.invulnerableUntil&gt;now or (victim.rotationUntil or 0)&gt;now then
			pending.spec.Recovery=.85
			c:cue(a,"64 PALMS • MISSED",.7)
			return
		end
		if g and points&gt;=g.MaxPoints and victim.guardHeld then
			-- Every point closed: the guard collapses under the opening palm.
			victim.guardHeld=false
			if victim.state=="Guarding" then c:setState(victim,"Neutral",0) end
			c:cue(victim,"GUARD BREAK • THE NETWORK IS CLOSED",.9)
			Brawler.event(c,a,"GuardCollapse")
		end
		c.damageTag="64 Palms"
		local opened=c:damage(a,victim,pending.spec.Damage,false,true)
		c.damageTag=nil
		if c.match.phase~="Duel" then return end
		if not opened or victim.impactStyle=="block" then
			pending.spec.Recovery=.7
			c:cue(a,"64 PALMS • GUARDED",.7)
			return
		end
		-- The opening palm is a palm on the network too (no count yet).
		Brawler.gentleFist(c,a,victim,false,"body",true)
		local opening=Brawler.contactImpact(c,victim)
		if opening then opening.move="SixtyFourPalms";opening.fighter=a.fighterId;opening.victim=victim.id end
		-- Lock: Neji holds the technique, the victim is held in place.
		local plan=Techniques.palmsPlan(points,pending.spec.Seal)
		local strikes,interval=plan.strikes,plan.interval
		c:setState(a,"TechniqueActive",strikes*interval+.25)
		a.flurryUntil=now+strikes*interval+.2
		Brawler.react(c,victim,"HitStun",Vector3.zero,strikes*interval+.3,a)
		victim.flurriedBy=a
		c:cue(a,if points&gt;0 then "EIGHT TRIGRAMS • 64 PALMS • "..points.." POINTS OPEN THE WAY" else "EIGHT TRIGRAMS • 64 PALMS",1)
		for k=1,strikes do
			c:schedule(now+k*interval,function()
				if a.health&lt;=0 or a.state~="TechniqueActive" or victim.health&lt;=0 or victim.reaction~="HitStun" or victim.flurriedBy~=a then return end
				local last=k==strikes
				c.damageTag="64 Palms"
				c:damage(a,victim,if last then pending.spec.Damage*plan.final else pending.spec.Damage,false,false)
				c.damageTag=nil
				if c.match.phase~="Duel" or victim.health&lt;=0 then return end
				-- One contact per palm: the blow's own entry becomes the palm, on
				-- the point it closes, carrying the count both players read.
				Brawler.gentleFist(c,a,victim,false,"body",true)
				local count=Techniques.palmCount(k,strikes)
				local entry=Brawler.contactImpact(c,victim)
				if not entry then c:pushImpact(victim.root.Position,"palm",last,{owner=a.id});entry=c.impacts[#c.impacts] end
				entry.style="palm";entry.heavy=last;entry.owner=a.id;entry.fighter=a.fighterId;entry.victim=victim.id;entry.move="SixtyFourPalms"
				entry.direction=a.root.CFrame.LookVector;entry.count=count;entry.strike=k;entry.strikes=strikes;entry.final=last
				c:cue(a,count.." PALMS",.4);c:cue(victim,count.." PALMS",.4)
				if last then
					victim.flurriedBy=nil
					victim.sealedUntil=c.now+plan.seal
					Brawler.sealPoints(c,a,victim)
					local away=victim.root.Position-a.root.Position;away=Vector3.new(away.X,0,away.Z)
					away=if away.Magnitude&gt;.1 then away.Unit else a.root.CFrame.LookVector
					Brawler.react(c,victim,"Knockback",away*46+Vector3.new(0,16,0),.6,a,"SixtyFourPalms")
					c:cue(victim,"64 PALMS • CHAKRA POINTS SEALED",1.2)
				else
					victim.reactionUntil=math.max(victim.reactionUntil,c.now+interval+.15)
				end
			end)
		end
	end,
}
-- Rotation that repelled a strike flows straight into its answer: the dome
-- winds down at once (no full recovery), and a strike pressed during the spin
-- is the twin palm gliding out of it.
function Techniques.rotationCounter(c,a)
	local now=c.now
	local queued=a.counterQueued~=nil and now-a.counterQueued&lt;=.9
	local stop=if queued then now else now+.08
	a.rotationUntil=math.min(a.rotationUntil or 0,stop)
	-- A strike pressed while the dome winds down cancels straight into the counter.
	a.rotationCounterUntil=a.counterUntil
	if a.rotationGuardUntil and math.abs((a.invulnerableUntil or 0)-a.rotationGuardUntil)&lt;1e-6 then a.invulnerableUntil=stop end
	local p=a.pending
	if p and p.kind=="Technique" and p.spec.Id=="Rotation" and a.state=="TechniqueActive" then
		p.spec=table.clone(p.spec);p.spec.Recovery=.04
		a.untilTime=math.min(a.untilTime,stop)
	end
	if queued then
		c:schedule(now,function()
			if a.health&lt;=0 or (a.counterUntil or 0)&lt;=c.now or a.reaction then return end
			if a.state=="TechniqueActive" or a.state=="TechniqueRecovery" then a.pending=nil;a.rotationUntil=0;c:setState(a,"Neutral",0) end
			require(script.Parent.Brawler).counterStart(c,a)
		end)
	end
end
Techniques.PhoenixFlower={check=function() return true end,execute=function(c,a,pending,now)
	-- (on a body his wire holds: the Dragon Flame, see FireBloom)
	if dragonFlame(c,a,pending) then return end
	return Elements.phoenix(c,a,pending,now)
end}
-- Minato's Wind Cut: a crescent of wind thrown off the kunai's edge on the run
-- (the legs never stop). It cuts enemy blades out of its lane, and a body it
-- cuts is thrown a step sideways with a short wind seal on it: the very next
-- Flying Thunder God lands beside that body, on the side the stick picks.
-- A guard stops the gust and keeps no seal.
local BLADES={kunai=true,shuriken=true,marked=true,wire=true}
local WIND={Seal=1.6,Cut=22,Lane=1.4,Radius=1.6}
Techniques.WIND=WIND
local function cutLane(c,a,gust)
	c:schedule(c.now+.015,function()
		if not table.find(c.projectiles,gust) or c.match.phase~="Duel" then return end
		local radius=gust.radius+(gust.growth or 0)*(c.now-gust.born)+WIND.Lane
		for i=#c.projectiles,1,-1 do
			local q=c.projectiles[i]
			if q~=gust and q.a~=a and BLADES[q.kind] and (q.position-gust.position).Magnitude&lt;=radius then
				table.remove(c.projectiles,i)
				c:pushImpact(q.position,"deflect",false,{projectile=q.id,kind=q.kind,owner=q.a.id,direction=-q.direction})
				require(script.Parent.Brawler).event(c,a,"WindCutBlade")
			end
		end
		cutLane(c,a,gust)
	end)
end
function Techniques.windSeal(c,a,b,direction,stick)
	local Brawler=require(script.Parent.Brawler)
	local across=Vector3.new(-direction.Z,0,direction.X)
	across=if across.Magnitude&gt;.05 then across.Unit else a.root.CFrame.RightVector
	if stick and stick.Magnitude&gt;.4 and stick:Dot(across)&lt;0 then across=-across end
	Brawler.react(c,b,if b.airborne then "Juggled" else "HitStun",across*WIND.Cut+(if b.airborne then Vector3.new(0,10,0) else Vector3.zero),.45,a)
	-- A longer seal already on that body (a marked kunai) is kept, not shortened.
	local kept=false
	for _,entry in a.anchors or {} do if entry.actor==b and entry.expires&gt;c.now+WIND.Seal then kept=true end end
	if not kept then
		local entry=Techniques.plant(c,a,b.root.Position,Vector3.yAxis,b)
		entry.expires=c.now+WIND.Seal;entry.wind=true
	end
	c:pushImpact(b.root.Position,"windseal",false,{owner=a.id,fighter=a.fighterId,victim=b.id,direction=across})
	c:cue(a,"WIND CUT • SEALED • FLASH BESIDE IT",.9)
	Brawler.event(c,a,"WindSeal")
end
Techniques.WindCut={
	check=function() return true end,
	execute=function(c,a,pending)
		local spec=pending.spec
		local aim=pending.aim or (a.target and a.target.root.Position) or a.root.Position+a.root.CFrame.LookVector*spec.Range
		local origin=c.launchPoint(a,"Wind")
		local flat=Vector3.new(aim.X-origin.X,0,aim.Z-origin.Z)
		if flat.Magnitude&lt;1 then flat=a.root.CFrame.LookVector*Vector3.new(1,0,1) end
		local goal=origin+flat.Unit*spec.Range+Vector3.new(0,math.clamp(aim.Y-origin.Y,-3,2),0)
		local stick=Vector3.new(a.move.X,0,a.move.Z)
		local gust
		-- Skill build (Gale Chase): a gust that connects also opens the chase.
		gust=c:projectile(a,goal,spec.Speed or 104,spec.Range,spec.Damage,"wind",function(_,_,victim)
			if not victim or victim.health&lt;=0 or a.health&lt;=0 or c.match.phase~="Duel" then return end
			Techniques.windSeal(c,a,victim,gust.direction,stick)
		end,{origin=origin,radius=WIND.Radius,riders=if spec.Chase then {chase=spec.Chase} else nil})
		cutLane(c,a,gust)
		c:cue(a,"WIND CUT",.5)
	end,
}
-- Awakening rules that live on a landed strike (Brawler.hit). Before the
-- reaction: Minato's skill-build Flow chain; the Curse Mark feeding on the
-- fight. After it (awakenedReact): the Curse Mark's extensions.
function Techniques.awakenedHit(c,a,b,p)
	local tune=a.def.Awakening
	if not tune or (a.awakenUntil or 0)&lt;=c.now or b.health&lt;=0 then return end
	-- Skill build (Flow, Minato's awakening): a clean hit right after a teleport
	-- arrival seals the body again, so the relocation chain continues.
	local chain=tune.FlashChain
	if chain and a.teleportAt and c.now-a.teleportAt&lt;.7 then
		local entry=Techniques.plant(c,a,b.root.Position,Vector3.yAxis,b)
		entry.expires=c.now+chain
		c:cue(a,"FLOW • SEALED AGAIN",.7);require(script.Parent.Brawler).event(c,a,"FlowSeal")
	end
	-- Curse Mark: a landed blow quiets the seal for a moment (it feeds on the fight).
	if tune.HealthDrain then a.curseFedUntil=c.now+(tune.Feed or 0);a.curseLanded=c.now end
end
function Techniques.awakenedReact(c,a,b,p)
	local tune=a.def.Awakening
	if not tune or (a.awakenUntil or 0)&lt;=c.now or b.health&lt;=0 then return end
	local Brawler=require(script.Parent.Brawler)
	if tune.Extension and (p.name=="Light3" or p.name=="AirDrive") and b.reaction=="Knockback" and (a.curseHoldReadyAt or 0)&lt;=c.now then
		-- The cursed kick does not let go: a short stagger instead of the
		-- knock-away, and the string stays open for the next route (heavy =
		-- the launcher, which the curse turns into the Dancing Leaf). Once per
		-- exchange: the next ender within 2.5 s knocks away as usual.
		a.curseHoldReadyAt=c.now+2.5
		local v=b.reactionVelocity or Vector3.zero
		local flat=Vector3.new(v.X,0,v.Z)
		flat=if flat.Magnitude&gt;.1 then flat.Unit else a.root.CFrame.LookVector*Vector3.new(1,0,1)
		-- (The knockback just marked the body airborne: judge by its height.)
		if b.root.Position.Y&gt;c.match.origin.Y+4.2 then Brawler.react(c,b,"Juggled",flat*12+Vector3.new(0,14,0),.55,a)
		else b.airborne=false;Brawler.react(c,b,"HitStun",flat*14,.5,a) end
		p.spec.chain=true
		-- A string ender closes its string when it starts (combo model): the
		-- held kick keeps the three confirmed hits, so heavy is the launcher.
		a.combo=math.max(a.combo or 0,3);a.stringAt=c.now
		c:pushImpact(b.root.Position,"curse",false,{owner=a.id,fighter=a.fighterId,victim=b.id})
		c:cue(a,"CURSE MARK • IT DOES NOT LET GO",.6)
		Brawler.event(c,a,"CurseExtension")
	end
	if tune.CursedLeaf and b.reaction=="Launched" and p.name~="LionKick" then Techniques.cursedLeaf(c,a,b) end
end
-- Curse Mark: every launcher becomes the Dancing Leaf (a free chase glued
-- under the body; heavy up there is the Lion Combo).
function Techniques.cursedLeaf(c,a,b)
	local Config=require(game:GetService("ReplicatedStorage").NinjaDuel.Config)
	local Brawler=require(script.Parent.Brawler)
	a.lionUntil=c.now+2.1
	c:schedule(c.now+.12,function()
		if a.health&lt;=0 or b.health&lt;=0 or c.match.phase~="Duel" or not (b.reaction=="Launched" or b.reaction=="Juggled") then return end
		a.chakra+=Config.PursuitCost
		local from=a.root.Position
		if c:request(a,"Pursuit") then
			a.untilTime=c.now+.5;a.shadowUntil=a.untilTime;a.airHold=c.now+1.1
			c:pushImpact(from,"afterimage",false,{owner=a.id,fighter=a.fighterId})
			c:cue(a,"CURSED LEAF • HEAVY = LION COMBO",1)
			Brawler.event(c,a,"CursedLeaf")
		else a.chakra-=Config.PursuitCost end
	end)
end
-- Curse Mark drain: it burns faster while he is not landing blows (hunger),
-- pauses for a moment after each one, and never kills.
-- (06/11, Studio) Lee's gates opened one by one on the server (speed, damage
-- and the drain grew with them) and nothing on screen said so: one label and
-- a faint flush for twenty seconds. Each gate that opens is announced now (its
-- name on screen, a burst on his body) and the snapshot carries which is open.
local GATE_NAMES={"GATE OF OPENING","GATE OF HEALING","GATE OF LIFE","GATE OF PAIN","GATE OF LIMIT"}
function Techniques.gateStep(c,a,now)
	local tune=a.def.Awakening
	if not (tune and tune.Gates) or (a.awakenUntil or 0)&lt;=now or a.health&lt;=0 then a.gateOpen=nil;return end
	local g=tune.Gates
	local gate=math.min(g.Max or 5,1+math.floor((now-(a.awakenedAt or now))/(g.Step or 4))) -- (Combat.gateOf)
	if a.gateAwake~=a.awakenedAt then a.gateAwake=a.awakenedAt;a.gateOpen=gate;return end
	if gate==a.gateOpen then return end
	a.gateOpen=gate
	c:pushImpact(a.root.Position,"gate",gate&gt;=(tune.Gates.Max or 5),{owner=a.id,fighter=a.fighterId,gate=gate})
	c:cue(a,"GATE "..gate.." • "..(GATE_NAMES[gate] or "GATE").." OPEN",1.1)
	if a.target then c:cue(a.target,"LEE • "..(GATE_NAMES[gate] or "GATE").." OPEN",.9) end
	require(script.Parent.Brawler).event(c,a,"Gate"..gate)
end
function Techniques.curseDrain(c,a,dt,now)
	local tune=a.def.Awakening
	Techniques.gateStep(c,a,now)
	if not (tune and tune.HealthDrain) or (a.awakenUntil or 0)&lt;=now or a.health&lt;=1 then a.curseHunger=false;return end
	local rate=tune.HealthDrain
	-- Lee's gates: each one open costs a fifth more of the full drain.
	if tune.Gates then rate*=math.min(tune.Gates.Max or 5,1+math.floor((now-(a.awakenedAt or now))/(tune.Gates.Step or 4)))/(tune.Gates.Max or 5) end
	if (a.curseFedUntil or 0)&gt;now then rate=0
	elseif tune.Hunger and now-(a.curseLanded or a.awakenedAt or now)&gt;1.5 then rate*=tune.Hunger end
	a.curseHunger=rate&gt;tune.HealthDrain
	if rate&gt;0 then a.health=math.max(1,a.health-rate*dt);a.hum.Health=math.max(1,a.health) end
end
-- Naruto (roster wave): his jutsu and his clones' behaviour (Server/Legion).
require(script.Parent.Legion).install(Techniques)
-- (06/11) Kakashi's ninken: Tracking Fang as a pack of bodies (Server/Hounds).
require(script.Parent.Hounds).install(Techniques)
-- Temari (roster wave): her kit registers itself (techniques, the fan gust
-- tool, the updraft payoff, Kamatari, the glide, the wind step).
require(script.Parent.Gale).install(Techniques)
-- (04/11) The seal jutsu that read the other body (Server/SealKits).
require(script.Parent.SealKits).install(Techniques)
-- Roster breadth pass: every technique that names a Family and has no
-- bespoke entry above runs the family's (Server/Families).
for _,kit in {require(script.Parent.Wave1Kit),require(script.Parent.Wave2Kit),require(script.Parent.Wave3Kit),require(script.Parent.Wave4Kit)} do kit.install(Techniques) end
require(script.Parent.Families).install(Techniques,require(game:GetService("ReplicatedStorage").NinjaDuel.Fighters))
return Techniques
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND109">
        <Properties>
          <string name="Name">Tournament</string>
          <ProtectedString name="Source">-- The Prodigy Tournament against the AI (roadmap 04/11, step 2): the eight
-- prodigies of the beta in a bracket of eight, each once (the Chunin exam
-- finals). The player picks his fighter; the seven others take the seven other
-- places. Quarter-finals, semi-finals, final, each match first to two.
--  * His matches are ordinary local duels (Matches:start), the AI a little
--    stronger each round (Server/BuildPresets tiers, where the fighter has one).
--  * The AI-vs-AI matches are played for real in the arena with an autopilot
--    on the first fighter (as the Studio dev tools do), watched from a
--    spectator lens (snapshot `spectate`); SKIP decides one at once from the
--    matchup's win rate measured on the engine (Server/CupOdds: thousands of
--    headless AI-vs-AI fights), so a skipped match is not a coin toss.
--  * Between matches, the bracket (phase "Bracket"). He loses: the rest of
--    the bracket is decided the same way, to show who won. He wins the final:
--    phase "Champion".
-- Client: Client/CupScreen (bracket, spectator banner, champion card).
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Fighters=require(Shared.Fighters)
local BetaRoster=require(Shared.BetaRoster)
local Tournament={};Tournament.__index=Tournament

-- The story's pairings in the quarter-finals (seats 1-2, 3-4, 5-6, 7-8):
-- Naruto–Neji and Sasuke–Gaara (the exam's finals), Lee–Minato (speed
-- against speed), Itachi–Kakashi (Sharingan against Sharingan).
Tournament.Seats={"Legion","GentleFist","Lion","Sand","Leaf","Flashstep","Mirage","Copycat"}
Tournament.RoundNames={"QUARTER-FINAL","SEMI-FINAL","FINAL"}
-- The AI in the player's matches, by round (a tier the fighter's skill tree
-- offers; none: his base kit).
Tournament.Tiers={"Medium","Hard","Boss"}
-- A word before the match (original lines, by fighter, then for the story's
-- own pairs).
Tournament.Lines={
	Legion="I'm not losing to anybody here. Believe it!",
	GentleFist="The outcome was decided before you stepped in.",
	Lion="Get out of my way. I have someone to catch up with.",
	Sand="The sand already knows where you will fall.",
	Leaf="Hard work beats genius. Let me prove it!",
	Flashstep="Blink and it is over. Try not to blink.",
	Mirage="You see the blow. You do not see the one behind it.",
	Copycat="Show me something new. I'll take it with me.",
}
Tournament.Rivals={
	["Legion|GentleFist"]={"Fate? I'll knock that word right out of you!","Then come and fail, like you were always going to."},
	["Lion|Sand"]={"Show me what that sand of yours can really do.","It is already around your feet."},
	["Leaf|Flashstep"]={"My youth is faster than your flash!","Fast is a start. Let's see if it lasts."},
	["Mirage|Copycat"]={"You copy what you see. So see this.","I've seen enough not to blink."},
}

function Tournament.new(matches,odds)
	local self=setmetatable({matches=matches,odds=odds,rng=Random.new()},Tournament)
	if not self.odds then
		local ok,table_=pcall(function() return require(script.Parent.CupOdds) end)
		self.odds=if ok then table_ else {}
	end
	return self
end
-- Match m (1..7): the two seats it opposes (nil while a feeder is undecided).
function Tournament.pair(cup,m)
	if m&lt;=4 then return 2*m-1,2*m end
	if m==5 then return cup.winners[1],cup.winners[2] end
	if m==6 then return cup.winners[3],cup.winners[4] end
	return cup.winners[5],cup.winners[6]
end
function Tournament.roundOf(m) return if m&lt;=4 then 1 elseif m&lt;=6 then 2 else 3 end
-- How likely the fighter on seat a beats the one on seat b (the engine's own
-- AI-vs-AI record; even when unknown).
function Tournament:chance(x,y)
	local row=self.odds[x]
	local p=row and row[y]
	if type(p)~="number" then
		local back=self.odds[y] and self.odds[y][x]
		p=if type(back)=="number" then 1-back else .5
	end
	return math.clamp(p,.1,.9)
end
function Tournament:decide(cup,m)
	local a,b=Tournament.pair(cup,m)
	local win=if self.rng:NextNumber()&lt;self:chance(cup.seats[a],cup.seats[b]) then a else b
	cup.winners[m]=win
	cup.skipped[m]=true
	return win
end
function Tournament:line(x,y)
	local pair=Tournament.Rivals[x.."|"..y]
	if pair then return pair[1],pair[2] end
	local back=Tournament.Rivals[y.."|"..x]
	if back then return back[2],back[1] end
	return Tournament.Lines[x],Tournament.Lines[y]
end
-- What the client draws: the seats, the winners so far, the next match.
function Tournament:view(cup)
	local m=cup.match
	local a,b=Tournament.pair(cup,m)
	local next_=nil
	if not cup.over and a and b then
		local la,lb=self:line(cup.seats[a],cup.seats[b])
		next_={match=m,round=Tournament.roundOf(m),roundName=Tournament.RoundNames[Tournament.roundOf(m)],a=a,b=b,
			mine=(a==cup.me or b==cup.me),lineA=la,lineB=lb}
	end
	return {seats=table.clone(cup.seats),me=cup.me,winners=table.clone(cup.winners),skipped=table.clone(cup.skipped),
		next=next_,over=cup.over==true,champion=cup.champion,out=cup.out,eliminatedIn=cup.eliminatedIn}
end
function Tournament:send(player,s,phase)
	s.phase=phase or "Bracket"
	self.matches:send(player,{phase=s.phase,epoch=s.epoch,cup=self:view(s.cup)})
end

-- ------------------------------------------------------------ flow
function Tournament:start(player,fighter)
	local m=self.matches
	if type(fighter)~="string" or not table.find(BetaRoster,fighter) or not Fighters[fighter] then return false end
	local s=m:session(player)
	if s.online then return false end
	m:destroy(s)
	local seats=table.clone(Tournament.Seats)
	local cup={seats=seats,me=table.find(seats,fighter),winners={},skipped={},match=1,over=false}
	s.cup=cup
	s.epoch+=1
	self:send(player,s)
	return true
end
-- The next match: his own (a duel), or the AI's (watched).
function Tournament:fight(player)
	local m=self.matches
	local s=m:session(player)
	local cup=s.cup
	if not cup or cup.over or s.phase~="Bracket" then return end
	local a,b=Tournament.pair(cup,cup.match)
	if not a or not b then return end
	local mine=a==cup.me or b==cup.me
	local options=nil
	local first,second
	if mine then
		first=cup.seats[cup.me];second=cup.seats[if a==cup.me then b else a]
		local tier=Tournament.Tiers[Tournament.roundOf(cup.match)]
		if tier and require(script.Parent.BuildPresets).ai(second,tier) then options={bot={preset=tier}} end
	else
		first=cup.seats[a];second=cup.seats[b]
	end
	local ok=m:start(player,first,second,false,options)
	if not ok and options then ok=m:start(player,first,second,false,nil) end
	if not ok then return end
	s.cup=cup;s.cupMatch=cup.match;s.cupResolved=false
	if not mine then
		-- The first fighter is the autopilot's; the player only watches.
		local AI=require(script.Parent.AI)
		s.autopilot=true;s.spectate=true
		s.cupPilot=AI.new(s.combat,s.human,(player.UserId%100000)+cup.match*7)
	else
		s.autopilot=nil;s.spectate=nil;s.cupPilot=nil
	end
	-- (B1) his own matches get stronger round by round (easy, normal, hard);
	-- a watched match is two bots at the same level.
	if m.aiLevel then s.ai=require(script.Parent.AI).new(s.combat,s.bot,(player.UserId%100000)+s.epoch,m.aiLevel(s)) end
	m:snapshot(player,s)
end
-- SKIP: an AI-vs-AI match decided at once (from the bracket or while watching).
function Tournament:skip(player)
	local m=self.matches
	local s=m:session(player)
	local cup=s.cup
	if not cup or cup.over then return end
	-- (Audit 04/11) the K.O. on screen is the result: no reroll over it.
	if s.finishing or s.phase=="Result" then return end
	local a,b=Tournament.pair(cup,cup.match)
	if not a or not b or a==cup.me or b==cup.me then return end
	if s.phase=="Duel" or s.phase=="Result" then m:destroy(s) end
	self:decide(cup,cup.match)
	self:advance(player,s)
end
-- A match of the cup has its result (Matches:update calls this once).
function Tournament:matchOver(player,s)
	local cup=s.cup
	if not cup or s.cupResolved or s.cupMatch~=cup.match then return end
	s.cupResolved=true
	local a,b=Tournament.pair(cup,cup.match)
	local mine=a==cup.me or b==cup.me
	local winnerSeat
	if mine then
		local other=if a==cup.me then b else a
		winnerSeat=if s.winner=="PlayerFighter" then cup.me else other
	else
		-- PlayerFighter is the first fighter of the pair (seat a).
		winnerSeat=if s.winner=="PlayerFighter" then a else b
	end
	cup.winners[cup.match]=winnerSeat
	-- (the lens stays the spectator's until the bracket comes back)
	s.cupPilot=nil
	if mine and winnerSeat~=cup.me then
		cup.out=true;cup.eliminatedIn=Tournament.RoundNames[Tournament.roundOf(cup.match)]
	end
	s.cupAdvanceReady=true
end
-- After a result or a skip: the next match, or the end.
function Tournament:advance(player,s)
	local cup=s.cup
	s.cupAdvanceReady=false
	if cup.out then
		-- Out: the rest of the bracket is decided, to show who won.
		for m=cup.match+1,7 do if not cup.winners[m] then cup.match=m;self:decide(cup,m) end end
	end
	if cup.winners[7] then
		cup.over=true
		cup.champion=cup.winners[7]
		if cup.champion==cup.me then
			s.epoch+=1
			s.autopilot=nil;s.spectate=nil;s.cupPilot=nil
			self.matches:destroy(s)
			return self:send(player,s,"Champion")
		end
	else
		cup.match+=1
	end
	s.epoch+=1
	s.autopilot=nil;s.spectate=nil;s.cupPilot=nil
	self.matches:destroy(s)
	self:send(player,s,"Bracket")
end
function Tournament:leave(player)
	self.matches:selection(player)
end

-- Requests that belong to the cup; true when handled.
-- (Security review 04/11, finding 1) CupStart, CupFight, CupSkip and
-- CupLeave build or tear down a whole arena: they share the roster's 0.8 s
-- lifecycle gap (one client could otherwise rebuild it ~13 times a second).
local LIFECYCLE={CupStart=true,CupFight=true,CupSkip=true,CupLeave=true}
function Tournament:request(player,s,action,payload)
	if LIFECYCLE[action] then
		local clock=os.clock()
		if clock-(s.lastLifecycle or -10)&lt;0.8 then return true end
		s.lastLifecycle=clock
	end
	if action=="CupStart" then
		-- (Audit 04/11) and NEW TOURNAMENT once one is over (champion or out).
		if (s.phase=="Selection" and not s.cup) or (s.cup and s.cup.over) then self:start(player,payload.player) end
		return true
	end
	if not s.cup then return false end
	if action=="CupFight" then self:fight(player);return true end
	if action=="CupSkip" then self:skip(player);return true end
	if action=="CupBracket" then
		if s.phase=="Result" and s.cupResolved then self:advance(player,s) end
		return true
	end
	if action=="CupLeave" then self:leave(player);return true end
	-- No rematch inside a cup: the result screen continues the bracket.
	if action=="Rematch" then return true end
	-- Watching: the player's own inputs drive nothing.
	if s.spectate and s.phase=="Duel" then return true end
	return false
end
-- Matches:update, every frame: the autopilot of a watched match, the result.
function Tournament:update(player,s,now)
	if not s.cup then return end
	if s.cupPilot and s.phase=="Duel" and not s.finishing and not (s.introUntil and now&lt;s.introUntil) then
		if s.cupPilot.actor~=s.human then s.cupPilot=require(script.Parent.AI).new(s.combat,s.human,player.UserId%100000) end
		s.cupPilot:update(now)
	end
	if s.phase=="Result" and not s.cupResolved then self:matchOver(player,s) end
end
return Tournament
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND110">
        <Properties>
          <string name="Name">Tutorial</string>
          <ProtectedString name="Source">-- Tutorial v2 (user 02/11: "un vrai tutoriel ... adapté pour chaque perso",
-- "dedans tu pourras t'apercevoir de tous les bugs").
--
-- One curriculum, adapted to the fighter played: the string has his own
-- length, the routes are his (named by their move), the tool is his, every
-- jutsu of his kit is a step of its own, his awakening and ultimate when he
-- has them. Key names come from Shared/Controls (never written by hand).
--
-- Objectives observe the real engine (combat events, accepted presses);
-- setups reset the practice pair, they never fake success.
--
-- Every step is also a probe. While it runs it records what went wrong:
-- presses the fight refused (and why), moments the stick was held while the
-- body was free and did not move (a freeze), the watchdogs that had to let a
-- body go, and a step nobody could finish in time (STUCK: it moves on). Each
-- finished step prints one line ([NinjaDuelTutorial]) and the whole report is
-- Tutorial.report(s) (dev hook op "tutorial"). Server/TutorialBot plays it on
-- its own, for any fighter, in the debug places.
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Controls=require(Shared.Controls)
local FirstMinute=require(Shared.FirstMinute)
local Brawler=require(script.Parent.Brawler)
local Tutorial={}

local K,P=Controls.KeyLabel,Controls.PadLabel
local function flat(v) return Vector3.new(v.X,0,v.Z) end

-- What a fighter's tool is called on screen.
local TOOL_NAME={Kunai="kunai",Shuriken="shuriken",Sand="sand bullet",Deflect="deflecting kick",Gust="fan gust"}
local function toolName(a)
	local mastery=a.def.ToolMastery
	if mastery and mastery.Projectile then return tostring(mastery.Projectile) end
	return TOOL_NAME[a.def.Tool or ""] or string.lower(tostring(a.def.Tool or "tool"))
end
local function moveLabel(name)
	-- "LionKick" -&gt; "Lion Kick"
	return (string.gsub(tostring(name),"(%l)(%u)","%1 %2"))
end
local TECH_KEY={"1","2","3","4","5"}

-- ------------------------------------------------------------------ steps
-- A step: id, title, key, pad (strings or functions of the actor), place
-- ("near" | "far" | "wall" | "air"), bot ("idle" | "heavy" | "channel" |
-- "grab" | "fight"), setup(s,t,now), check(s,t,now) -&gt; done, timeout (s).
local function step(spec) spec.timeout=spec.timeout or 40;spec.place=spec.place or "far";spec.bot=spec.bot or "idle";return spec end

-- The adapted curriculum for this actor (its own copy of every spec).
function Tutorial.plan(a)
	local def=a.def
	local graph=Brawler.graph(a) or {}
	local routes=graph.routes or {}
	local steps={}
	local function add(spec) table.insert(steps,step(spec)) end
	add({id="move",title="Move",key="WASD",pad="L stick",
		check=function(s,t) return t.travel&gt;12 end})
	add({id="sprint",title="Sprint",key="Hold "..K.Sprint.." + move",pad=P.Sprint..", then move",
		check=function(s,t) return s.human.sprinting and s.human.locomotion.Magnitude&gt;28 end})
	add({id="jump",title="Jump and land",key=K.Jump,pad=P.Jump,
		check=function(s,t) local a=s.human;t.seenAir=t.seenAir or a.airborne;return t.seenAir and not a.airborne end})
	add({id="lock",title="Unlock, then lock the target",key=K.Lock.." twice",pad=P.Lock.." twice",
		check=function(s,t) local a=s.human;t.unlocked=t.unlocked or not a.locked;return (t.unlocked or t.ev("Unlock")) and a.locked and t.ev("Lock") end})
	add({id="dodge",title=if def.SandFlicker then "Sand body-flicker" else "Directional dash",key="Direction + "..K.Dodge,pad="L stick + "..P.Dodge,
		check=function(s,t) return t.ev("Dodge") end})
	add({id="wall",title="Run up the wall, then rebound",key="Move into the wall, then "..K.Jump,pad="Push into the wall, then "..P.Jump,place="wall",
		check=function(s,t,now) local a=s.human;t.seenWall=t.seenWall or a.wall~=nil;return t.seenWall and (a.wallJumpUntil or 0)&gt;now end})
	local length=def.StringLength or 4
	add({id="string",title="Land your "..length.."-hit string",key=K.Light.." x"..length,pad=P.Light.." x"..length,place="near",
		check=function(s,t) return t.count("Hit")&gt;=length end})
	add({id="heavy",title="Heavy strike",key=K.Heavy,pad=P.Heavy,place="near",
		check=function(s,t) return t.ok("Heavy") and t.count("Hit")&gt;=1 end})
	if routes.side then
		add({id="routeSide",title="Turn the angle: "..moveLabel(routes.side),key="2 hits, then "..K.Dodge,pad="2 hits, then "..P.Dodge,place="near",
			check=function(s,t) return t.ev("RouteSide") end})
	end
	if routes.down then
		add({id="routeDown",title="Go low: "..moveLabel(routes.down),key="3 hits, then "..K.Heavy,pad="3 hits, then "..P.Heavy,place="near",
			check=function(s,t) return t.ev("RouteDown") end})
	end
	if routes.up then
		add({id="launch",title="Launch: "..moveLabel(def.LauncherMove or "Launcher"),key="2 hits, then "..K.Heavy,pad="2 hits, then "..P.Heavy,place="near",
			check=function(s,t) return t.ev("LaunchHit") end})
	end
	add({id="chase",title="Chase the launched body",key=K.Pursuit.." after the launch",pad=P.Pursuit.." after the launch",place="near",
		setup=function(s,t,now) local c,a,b=s.combat,s.human,s.bot;Brawler.react(c,b,"Launched",Vector3.new(0,48,0),1.2);a.pursuitUntil=now+1.2 end,
		retry=3,
		check=function(s,t) local a,b=s.human,s.bot;return t.ev("Chase") and a.state=="Neutral" and a.airborne and (a.root.Position-b.root.Position).Magnitude&lt;7 end})
	add({id="air",title="Land two aerial strikes",key=K.Light.." twice in the air",pad=P.Light.." twice in the air",place="air",retry=3,
		check=function(s,t) return t.count("AirHit")&gt;=2 end})
	-- (Audit 04/11) the finisher is a table: its name (it printed "table: 0x…").
	local finisher=graph.airFinisher
	add({id="airFinish",title=if finisher then "Finish in the air: "..moveLabel(if type(finisher)=="table" then finisher.name else finisher) else "Finish downward",key=K.Heavy.." in the air",pad=P.Heavy.." in the air",place="air",retry=3,
		check=function(s,t) return t.ev("SlamHit") or t.ev("LionCombo") or (t.ok("Heavy") and t.count("Hit")&gt;=1) end})
	add({id="runStrike",title=if graph.runStrike then "Strike on the run: "..moveLabel(graph.runStrike) else "Strike on the run",key="Sprint at him, then "..K.Light.." or "..K.Heavy,pad="Sprint at him, then "..P.Light.." or "..P.Heavy,
		check=function(s,t) return t.ev("RunningStrike") end})
	add({id="grab",title="Grab, then throw",key=K.Grab..", then "..K.Light.." ("..K.Heavy.." throws upward)",pad=P.Grab..", then "..P.Light,place="near",
		check=function(s,t) return t.ev("ThrowHit") end})
	-- A deflecting tool (Guy's kick) needs something thrown at it: the partner throws.
	add({id="tool",title="Your tool: "..toolName(a),key=if a.def.Tool=="Deflect" then K.Tool.." as his kunai flies" else K.Tool,pad=if a.def.Tool=="Deflect" then P.Tool.." as his kunai flies" else P.Tool,
		bot=if a.def.Tool=="Deflect" then "throw" else "idle",
		check=function(s,t) return t.ok("Tool") end})
	for i,spec in def.Techniques or {} do
		if i&gt;5 then break end
		add({id="jutsu"..i,title="Jutsu "..i..": "..tostring(spec.Name),key=TECH_KEY[i],pad=Controls.TechniquePad[i] or ("Jutsu "..i),
			place=if (spec.Range or 20)&lt;10 then "near" else "far",technique=spec,
			setup=function(s)
				local a=s.human;a.chakra=a.def.Chakra or 100;a.cooldowns={}
				-- (Studio 03/11, Minato: "Condition missing" on every press) A
				-- jutsu that goes to a seal gets one planted behind the partner.
				if spec.Requires=="Anchor" and s.bot and s.combat then
					local b=s.bot
					local away=b.root.Position-a.root.Position;away=Vector3.new(away.X,0,away.Z)
					away=if away.Magnitude&gt;.1 then away.Unit else Vector3.zAxis
					local spot=b.root.Position+away*6
					require(script.Parent.Techniques).plant(s.combat,a,Vector3.new(spot.X,s.origin.Y,spot.Z),Vector3.yAxis)
				end
			end,
			check=function(s,t) return t.ev("Cast:"..tostring(spec.Id)) end})
	end
	-- (04/11) The second page: the first seal jutsu, one press with the page held.
	local seal=def.SealJutsu and def.SealJutsu[1]
	if seal then
		add({id="sealPage",title="Hand seals: "..tostring(seal.Name),key="Hold "..K.WallDetach.." + 1",pad="Hold L2 + R1 + □",
			place=if (seal.Range or 20)&lt;10 then "near" else "far",technique=seal,
			setup=function(s) local a=s.human;a.chakra=a.def.Chakra or 100;a.cooldowns={} end,
			check=function(s,t) return t.ev("Cast:"..tostring(seal.Id)) end})
	end
	add({id="guard",title="Guard the incoming strike",key="Hold "..K.Guard,pad="Hold "..P.Guard,place="near",bot="heavy",
		check=function(s,t) return t.ev("GuardHit") end})
	add({id="evade",title="Dodge the incoming strike",key=K.Dodge.." during his wind-up",pad=P.Dodge.." during his wind-up",place="near",bot="heavy",
		check=function(s,t,now) local a,b=s.human,s.bot;return t.ev("Dodge") and (t.ev("Evaded") or (b.attackName~=nil and now-(b.attackStarted or now)&gt;.46 and a.health==t.health)) end})
	-- (Studio 03/11, against Gaara: his heavy knocks down, and a body on the
	-- floor cannot substitute) The partner hits with his light here.
	-- (05/11, user on the pad: 13 presses of ○, the prompt named D-pad →)
	-- The escape is the dodge button pressed while taking the blow; the body's
	-- own step out (past its share of the stun) is an escape too.
	add({id="substitute",title="Escape after being hit",key=K.Dodge.." as soon as his blow lands",pad=P.Dodge.." as soon as his blow lands",place="near",bot="heavy",strike="Attack",
		check=function(s,t) return t.ev("Substitute") or t.ev("Recover") end})
	-- (Roster run 02/11: STUCK for every fighter from 28 studs: the signs end
	-- before anyone gets there.) In dash reach, as in a duel.
	add({id="interrupt",title="Interrupt his hand signs",key=K.Light.." during the signs",pad=P.Light.." during the signs",place="mid",bot="channel",
		check=function(s,t) return t.ev("Interrupt") end})
	add({id="throwBreak",title="Break his grab",key=K.Grab.." as he seizes you",pad=P.Grab.." as he seizes you",place="near",bot="grab",
		check=function(s,t) return t.ev("ThrowBreak") end})
	if def.Awakening then
		add({id="awaken",title="Awaken: "..tostring(def.Awakening.Name or "awakening"),key=K.Awaken.." (low health)",pad="D-pad ↓ (low health)",
			setup=function(s) local a=s.human;a.awakened=false;a.health=a.def.Health*.3;a.hum.Health=a.health end,
			check=function(s,t) return t.ev("Awaken") end})
	end
	local Ultimates=require(script.Parent.Ultimates)
	local ult=Ultimates.def(a)
	if ult then
		add({id="ultimate",title="Ultimate: "..tostring(ult.Name),key=K.Ultimate.." (bar full)",pad=P.Ultimate.." (bar full)",place="near",
			setup=function(s) s.human.ultimate=Ultimates.MAX end,
			check=function(s,t) return t.ev("UltimateStart") end})
	end
	add({id="win",title="Win the practice duel",key="Use your complete kit",pad="Use your complete kit",place="far",bot="fight",timeout=math.huge,
		check=function() return false end})
	return steps
end

-- (B1 lot 2, DEC-034) The first minute: four prompts, a partner who waits,
-- then a real duel (Server/Matches). Each step moves on by itself after 25 s
-- (a player who does not find the key is not held there), and the panel says
-- what to press on a keyboard, a pad or a phone (Shared/FirstMinute.Touch).
function Tutorial.firstPlan(a)
	local def=a.def
	local steps={}
	local function add(spec) spec.timeout=spec.timeout or 25;spec.touch=FirstMinute.Touch[spec.id];table.insert(steps,step(spec)) end
	add({id="move",title="Move",key="WASD",pad="L stick",check=function(s,t) return t.travel&gt;12 end})
	add({id="string",title="Strike: three hits",key=K.Light.." x3",pad=P.Light.." x3",place="near",
		check=function(s,t) return t.count("Hit")&gt;=3 end})
	add({id="dodge",title="Dodge",key="Direction + "..K.Dodge,pad="L stick + "..P.Dodge,
		check=function(s,t) return t.ev("Dodge") end})
	local spec=FirstMinute.signature(def)
	if spec then
		local slot=FirstMinute.SignatureSlot
		add({id="signature",title="Your signature: "..tostring(spec.Name),key=TECH_KEY[slot],pad=Controls.TechniquePad[slot] or ("Jutsu "..slot),
			place=if (spec.Range or 20)&lt;10 then "near" else "far",technique=spec,
			setup=function(s) local p=s.human;p.chakra=p.def.Chakra or 100;p.cooldowns={} end,
			-- (Studio 04/11, v37: the duel's intro cut the Chidori at its cast,
			-- and a Chidori is held until a strike releases it) done when it
			-- lands on the partner (or 5 s after the cast), then a beat to see it.
			hold=1.6,
			check=function(s,t,now)
				if not t.ev("Cast:"..tostring(spec.Id)) then return false end
				if not t.castAt then t.castAt=now;t.partnerAt=s.bot.health end
				return s.bot.health&lt;t.partnerAt-.5 or now-t.castAt&gt;5
			end})
	end
	return steps
end
-- ----------------------------------------------------------------- driver
function Tutorial.new(s,kind)
	local t={index=1,entered=0,baseline={},travel=0,attackAt=0,report={},timeoutScale=1,first=kind=="first"}
	t.steps=if t.first then Tutorial.firstPlan(s.human) else Tutorial.plan(s.human)
	s.tutorial=t
	return t
end
-- The next step; past the first minute's last one, it is done (the duel).
local function nextStep(s,t,now)
	t.index+=1
	if not t.steps[t.index] then t.index=#t.steps;t.done=true;return end
	Tutorial.enter(s,now)
end
-- Kept for the specs and tools that name the generic order.
Tutorial.Steps=Tutorial.plan({def={Techniques={}},fighterId=""})
function Tutorial.indexOf(s,id)
	for i,spec in s.tutorial.steps do if spec.id==id then return i end end
	return nil
end
local function counter(t,a,name) return (a.events and a.events[name] or 0)-(t.baseline[name] or 0) end
function Tutorial.enter(s,now)
	local t,a,b=s.tutorial,s.human,s.bot
	local spec=t.steps[t.index]
	local c=s.combat;c:clear(true)
	t.entered=now;t.completedAt=nil;t.castAt=nil;t.partnerAt=nil;t.baseline=table.clone(a.events or {});t.travel=0;t.seenAir=false;t.seenWall=false;t.unlocked=false
	t.lastPosition=a.root.Position;t.pressFrom=#(a.pressLog or {});t.stillFor=0;t.freezeOpen=false
	-- A step set up again (a missed launch) keeps its record and its clock.
	local same=t.rec and t.recIndex==t.index and not t.rec.status
	if same then t.rec.attempts+=1
	else t.rec={id=spec.id,title=spec.title,started=now,refused={},freezes=0,watchdogs=0,attempts=1};t.recIndex=t.index;t.stepFrom=now;t.stepPress=#(a.pressLog or {}) end
	for _,actor in {a,b} do
		actor.health=actor.def.Health;actor.hum.Health=actor.health;actor.state="Neutral";actor.untilTime=now;actor.chakra=actor.def.Chakra or 100
		actor.subCharges=2;actor.subCooldown=0;actor.subRegenAt=math.huge;actor.comboHits=0;actor.cooldowns={};actor.invulnerableUntil=0
		actor.reaction=nil;actor.reactionVelocity=nil;actor.groundPose=nil;actor.airHold=0
	end
	t.health=a.health
	b.trainingChannelScale=if spec.bot=="channel" then 3 else 1
	-- (Studio 03/11, Minato against Gaara: the run strike, the grab, the dodge
	-- and the escape never completed) A training partner's sand shield ate
	-- every blow the step asks for. It is down in the drills, up in the fight.
	if b.def.SandShield then
		if spec.bot=="fight" then b.shieldCharges=b.def.SandShield.Charges;b.shieldRegenAt=0
		else b.shieldCharges=0;b.shieldRegenAt=math.huge end
	end
	local place=spec.place
	local near=place=="near" or place=="air"
	local gapA,gapB=if near then 3 elseif place=="mid" then 5 else 14,if near then -2 elseif place=="mid" then -5 else -14
	c:relocate(a,s.origin+Vector3.new(0,3,gapA));c:relocate(b,s.origin+Vector3.new(0,3,gapB))
	if place=="wall" then
		local R=require(script.Parent.World).WALL_RADIUS
		c:relocate(a,s.origin+Vector3.new(R-7,3,0));c:relocate(b,s.origin+Vector3.new(R-17,3,0))
	end
	a.root.CFrame=CFrame.lookAt(a.root.Position,b.root.Position);b.root.CFrame=CFrame.lookAt(b.root.Position,a.root.Position)
	if place=="air" then
		c:relocate(a,s.origin+Vector3.new(0,16,3));c:relocate(b,s.origin+Vector3.new(0,16,-2));a.airborne=true;a.airHold=now+1.8
		Brawler.react(c,b,"Juggled",Vector3.zero,1.8)
	end
	-- A jutsu that needs its target in reach starts within it.
	-- (Roster run 02/11: "Out of range" x5 for Guy, Kakashi, Shino...: a
	-- Sequence, a Zone at the target, a Teleport check their Range without
	-- Requires.) Any jutsu with a reach shorter than the gap starts within it.
	local tech=spec.technique
	if tech and (tech.Requires=="Target" or (tech.Range and tech.Range&lt;(b.root.Position-a.root.Position).Magnitude+2)) then
		local gap=math.clamp((tech.Range or 10)*.5,3,12)
		c:relocate(b,a.root.Position+flat(b.root.Position-a.root.Position).Unit*gap)
		b.root.CFrame=CFrame.lookAt(b.root.Position,a.root.Position)
	end
	if spec.setup then spec.setup(s,t,now) end
	t.attackAt=now+1
end
-- The bot's longest interruptible channel: the one the player learns to break.
function Tutorial.interruptSlot(b)
	local best,bestChannel="Technique1",-1
	for slot,spec in b.def.Techniques do
		-- (Studio 03/11, Kakashi against Naruto: STUCK) not a jutsu that runs
		-- at you once formed (the Rasengan, range 10): hand signs held in place.
		if spec.Interruptible and spec.Channel&gt;bestChannel and not spec.Requires and not spec.Mobile and (spec.Range or 99)&gt;12 then best,bestChannel="Technique"..slot,spec.Channel end
	end
	return best
end

-- -------------------------------------------------------------- the probe
-- Presses the fight refused since the step began, by reason.
local function collectRefusals(t,a)
	local log=a.pressLog or {}
	-- The log keeps its last 40 entries: count from where the step began.
	local from=math.max(1,math.min(t.stepPress or 0,#log)+1)
	if #log&gt;=40 then from=1 end
	local out={}
	for i=from,#log do
		local entry=log[i]
		if entry.t&gt;=(t.stepFrom or t.entered) and not entry.ok and entry.reason then out[entry.reason]=(out[entry.reason] or 0)+1 end
	end
	return out
end
-- A freeze: the stick held, the body alive and free (no reaction, no hold, not
-- committed), and it does not move for 0.4 s. What held it is kept.
local function probeFreeze(s,t,dt,now)
	local a=s.human
	local wants=a.move and flat(a.move).Magnitude&gt;.5
	local step=(a.root.Position-(t.freezeLast or a.root.Position)).Magnitude;t.freezeLast=a.root.Position
	local free=a.health&gt;0 and a.state=="Neutral" and not a.reaction and not a.wall and now&gt;=(a.airHold or 0) and now&gt;=(a.hitstopUntil or 0)
	if wants and free and step&lt;.01 then
		t.stillFor+=dt
		if t.stillFor&gt;=.4 and not t.freezeOpen then
			t.freezeOpen=true;t.rec.freezes+=1
			if not t.rec.freeze then
				local hum=a.hum
				t.rec.freeze={state=a.state,airborne=a.airborne,humState=hum and hum:GetState().Name,walkSpeed=hum and math.floor(hum.WalkSpeed*10)/10,
					anchored=a.root.Anchored,traversal=a.model:GetAttribute("MovementTraversalActive"),locomotion=math.floor(a.locomotion.Magnitude*10)/10,
					held=a.ultimateHeld==true,grounded=a.grounded}
			end
		end
	else t.stillFor=0;t.freezeOpen=false end
end
local function summary(rec)
	local parts={}
	for reason,n in rec.refused do table.insert(parts,reason.."x"..n) end
	table.sort(parts)
	local line=string.format("%s %.1fs",rec.status,rec.ended-rec.started)
	if #parts&gt;0 then line..="  refused: "..table.concat(parts,", ") end
	if rec.freezes&gt;0 then
		local f=rec.freeze or {}
		line..=string.format("  FREEZES %d (state=%s air=%s hum=%s walk=%s anchored=%s traversal=%s held=%s)",rec.freezes,tostring(f.state),tostring(f.airborne),tostring(f.humState),tostring(f.walkSpeed),tostring(f.anchored),tostring(f.traversal),tostring(f.held))
	end
	if rec.watchdogs&gt;0 then line..="  watchdogs: "..rec.watchdogs end
	if rec.attempts&gt;1 then line..="  setups: "..rec.attempts end
	return line
end
local function close(s,t,now,status)
	local a=s.human
	local rec=t.rec
	rec.status=status;rec.ended=now
	rec.refused=collectRefusals(t,a)
	rec.watchdogs=counter(t,a,"WatchdogWakeup")+counter(t,a,"WatchdogReaction")+counter(t,a,"WatchdogGrab")
	rec.line=summary(rec)
	table.insert(t.report,rec)
	print(string.format("[NinjaDuelTutorial] %s %d/%d %s: %s",tostring(a.fighterId),t.index,#t.steps,rec.id,rec.line))
end
function Tutorial.report(s)
	local t=s.tutorial
	if not t then return nil end
	local out={fighter=s.human and s.human.fighterId,steps={},current=t.steps[t.index] and t.steps[t.index].id}
	for _,rec in t.report do table.insert(out.steps,{id=rec.id,title=rec.title,status=rec.status,line=rec.line,refused=rec.refused,freezes=rec.freezes,freeze=rec.freeze,watchdogs=rec.watchdogs}) end
	return out
end

-- ------------------------------------------------------------------- tick
function Tutorial.update(s,now,dt)
	local t,a,b=s.tutorial,s.human,s.bot;local c=s.combat
	if t.done then return end
	if t.entered==0 then Tutorial.enter(s,now) end
	local spec=t.steps[t.index]
	if spec.bot=="fight" then s.ai:update(now);return end
	b.move=Vector3.zero;b.sprinting=false
	local displacement=(a.root.Position-(t.lastPosition or a.root.Position)).Magnitude;t.travel+=math.min(displacement,4);t.lastPosition=a.root.Position
	t.ev=function(name) return counter(t,a,name)&gt;0 end
	t.count=function(name) return counter(t,a,name) end
	t.ok=function(action)
		for i=#(a.pressLog or {}),1,-1 do
			local entry=a.pressLog[i]
			if entry.t&lt;t.entered then break end
			if entry.action==action and entry.ok then return true end
		end
		return false
	end
	probeFreeze(s,t,dt,now)
	if not t.completedAt and spec.check(s,t,now) then t.completedAt=now end
	if t.completedAt and now-t.completedAt&gt;=(spec.hold or .22) then
		close(s,t,now,"PASS");nextStep(s,t,now);return
	end
	-- Nobody finished it in time: a probe that found a wall, not a lesson to
	-- retry forever. It is reported STUCK and the next step begins.
	if now-t.rec.started&gt;=spec.timeout*(t.timeoutScale or 1) then
		close(s,t,now,"STUCK");nextStep(s,t,now);return
	end
	-- The practice partner.
	if spec.bot=="heavy" and now&gt;=t.attackAt then
		if (b.root.Position-a.root.Position).Magnitude&gt;7 then c:relocate(b,a.root.Position+a.root.CFrame.LookVector*5) end
		b.root.CFrame=CFrame.lookAt(b.root.Position,a.root.Position);c:request(b,spec.strike or "Heavy");t.attackAt=now+1.7
	elseif spec.bot=="channel" and now&gt;=t.attackAt then
		b.cooldowns={};b.chakra=b.def.Chakra or 100;c:request(b,Tutorial.interruptSlot(b),a.root.Position);t.attackAt=now+1.4
	elseif spec.bot=="throw" and now&gt;=t.attackAt then
		b.cooldowns={};b.toolCooldown=0;c:request(b,"Tool",a.root.Position);t.attackAt=now+1.6
	elseif spec.bot=="grab" and now&gt;=t.attackAt then
		if (b.root.Position-a.root.Position).Magnitude&gt;4 then c:relocate(b,a.root.Position+a.root.CFrame.LookVector*3.2) end
		b.root.CFrame=CFrame.lookAt(b.root.Position,a.root.Position);b.grabCooldown=0;c:request(b,"Grab");t.attackAt=now+1.8
	end
	-- A failed launch / juggle exercise sets itself up again (same step).
	if spec.retry and now-t.entered&gt;spec.retry then Tutorial.enter(s,now) end
	if a.health&lt;a.def.Health*.3 and spec.id~="awaken" then a.health=a.def.Health;a.hum.Health=a.health end
	if b.health&lt;b.def.Health*.25 then b.health=b.def.Health;b.hum.Health=b.health end
end
function Tutorial.skip(s,now)
	local t=s.tutorial
	if not t or t.done or (not t.first and not t.steps[t.index+1]) then return false end
	close(s,t,now,"SKIP");nextStep(s,t,now)
	return true
end
function Tutorial.snapshot(s)
	local t=s.tutorial;if not t then return nil end
	local step=t.steps[t.index]
	return {index=t.index,total=#t.steps,title=step.title,pad=step.pad,key=step.key,touch=step.touch,id=step.id,first=t.first or nil}
end
return Tutorial
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND111">
        <Properties>
          <string name="Name">TutorialBot</string>
          <ProtectedString name="Source">-- Debug/QA places only (build.py DEBUG_SOURCES). Plays the tutorial on its
-- own for a fighter, through the same Combat:request a player's remote reaches
-- (late presses included: the seat is a player), and returns the tutorial's
-- report: every step PASS / STUCK, with the refusals, the freezes and the
-- watchdogs the probe recorded. A STUCK step is a lead for a bug (or a step
-- this bot does not know how to play: read the line). From the command bar,
-- Server side, in a playtest:
--   require(game.ServerScriptService.NinjaDuelServer.TutorialBot).run(matches-free: uses the dev hook session)
-- or through the dev hook: NinjaDuelDev:Invoke("tutorialRun","Lion") then
-- NinjaDuelDev:Invoke("tutorial") for the report while it runs / when done.
local Tutorial=require(script.Parent.Tutorial)
local Brawler=require(script.Parent.Brawler)
local Bot={}
local function flat(v) return Vector3.new(v.X,0,v.Z) end

-- One script per step id: what a player would press. `s` is the session,
-- `wait(sec)` yields while the duel runs, `alive()` says the step still runs.
local function scripts(s,wait,alive)
	local c=s.combat
	local function A() return s.human end
	local function B() return s.bot end
	local function press(action,aim,opts) return c:request(A(),action,aim,nil,opts) end
	local function toward() local a,b=A(),B();local d=flat(b.root.Position-a.root.Position);return if d.Magnitude&gt;.1 then d.Unit else Vector3.zAxis end
	-- The stick is also published on the body (TutorialStick/TutorialSprint):
	-- the debug client draws the player's own body ahead of the server by the
	-- local stick (Presentation:leadLocal); fed the bot's stick, it draws what a
	-- player holding that stick would see (Client/TutorialProbe).
	local function stick(v) local a=A();a.move=v;a.lastMove=os.clock()+5;Brawler.observe(c,a);a.model:SetAttribute("TutorialStick",v) end
	local function sprint(on) local a=A();a.sprinting=on;a.model:SetAttribute("TutorialSprint",on) end
	local function hold(v,sec) local t0=os.clock();while alive() and os.clock()-t0&lt;sec do stick(v);wait(.05) end end
	local function chain(n,gap) for _=1,n do if not alive() then return end;press("Attack");wait(gap or .24) end end
	local S={}
	S.move=function() hold(toward():Cross(Vector3.yAxis),1.5);stick(Vector3.zero) end
	S.sprint=function() sprint(true);hold(toward():Cross(Vector3.yAxis),1.5);sprint(false);stick(Vector3.zero) end
	S.jump=function() press("Jump");wait(1.2) end
	S.lock=function()
		local a=A();a.locked=false;Brawler.event(c,a,"Unlock");wait(.2)
		a.locked=true;Brawler.event(c,a,"Lock");wait(.4)
	end
	S.dodge=function() stick(toward():Cross(Vector3.yAxis));press("Dodge");wait(.6);stick(Vector3.zero) end
	S.wall=function()
		-- Into the east wall (Tutorial places the body a few strides from it).
		local t0=os.clock()
		while alive() and not A().wall and os.clock()-t0&lt;3 do stick(Vector3.xAxis);wait(.05) end
		wait(.15);press("Jump");wait(.6);stick(Vector3.zero)
	end
	S.string=function() stick(Vector3.zero);chain((A().def.StringLength or 4)+1,.26);wait(.5) end
	S.heavy=function() press("Heavy");wait(1) end
	-- The side route, like the others, opens after two hits (Brawler: combo&gt;=2).
	S.routeSide=function() chain(2,.28);stick(toward():Cross(Vector3.yAxis));press("Attack");wait(.6);stick(Vector3.zero) end
	S.routeDown=function() chain(2,.28);stick(-toward());press("Attack");wait(.6);stick(Vector3.zero) end
	S.launch=function() chain(2,.28);stick(toward());press("Attack");wait(.6);stick(Vector3.zero) end
	S.chase=function() wait(.15);press("Pursuit");wait(.8) end
	S.air=function() press("Attack");wait(.26);press("Attack");wait(.6) end
	S.airFinish=function() press("Heavy");wait(.8) end
	S.runStrike=function()
		local a=A();sprint(true)
		local t0=os.clock()
		while alive() and os.clock()-t0&lt;3 do
			stick(toward())
			local gap=flat(B().root.Position-a.root.Position).Magnitude
			if gap&lt;9 and a.locomotion.Magnitude&gt;28 then press("Attack");break end
			wait(.03)
		end
		sprint(false);wait(.6);stick(Vector3.zero)
	end
	-- Walk into reach first (Gaara and Sasori whiffed from the step's 5 studs:
	-- their grab does not carry the lunge the others do), then seize and throw.
	S.grab=function()
		local t0=os.clock()
		while alive() and os.clock()-t0&lt;1.5 and flat(B().root.Position-A().root.Position).Magnitude&gt;2.8 do stick(toward());wait(.03) end
		stick(Vector3.zero);press("Grab");wait(.4);press("Attack");wait(1.2)
	end
	S.tool=function()
		local a=A()
		if a.def.Tool=="Deflect" then
			-- Kick when the partner's blade is coming (Techniques.bladeIncoming).
			local Techniques=require(script.Parent.Techniques)
			local t0=os.clock()
			while alive() and os.clock()-t0&lt;4 do
				if Techniques.bladeIncoming(c,a,a.def.Deflect) then press("Tool",B().root.Position);wait(.9);return end
				wait(.02)
			end
			return
		end
		press("Tool",B().root.Position);wait(.9)
	end
	for i=1,5 do
		S["jutsu"..i]=function() press("Technique"..i,B().root.Position);wait(1.4) end
	end
	S.guard=function()
		local a=A();a.guardWanted=true;press("Guard")
		local t0=os.clock();while alive() and os.clock()-t0&lt;3 do wait(.05) end
		a.guardWanted=false;press("GuardOff")
	end
	S.evade=function()
		local t0=os.clock()
		while alive() and os.clock()-t0&lt;4 do
			local b=B()
			if b.attackName=="Heavy" and b.state=="Startup" and c.now-(b.attackStarted or c.now)&gt;.12 then
				stick(toward():Cross(Vector3.yAxis));press("Dodge");wait(.6);stick(Vector3.zero);return
			end
			wait(.02)
		end
	end
	S.substitute=function()
		local t0=os.clock()
		while alive() and os.clock()-t0&lt;4 do
			if A().reaction then wait(.05);press("Dodge");wait(.6);return end
			wait(.02)
		end
	end
	S.interrupt=function()
		local t0=os.clock()
		while alive() and os.clock()-t0&lt;5 do
			local b=B()
			if b.state=="TechniqueChannel" then
				local a=A()
				while alive() and B().state=="TechniqueChannel" and flat(B().root.Position-a.root.Position).Magnitude&gt;5 do stick(toward());wait(.03) end
				stick(Vector3.zero);press("Attack");wait(.6);return
			end
			wait(.02)
		end
	end
	S.throwBreak=function()
		local t0=os.clock()
		while alive() and os.clock()-t0&lt;4 do
			if A().reaction=="Grabbed" then press("Grab");wait(.5);return end
			wait(.02)
		end
	end
	S.awaken=function() press("Awaken");wait(1) end
	S.ultimate=function() press("Ultimate");wait(1.5) end
	return S
end

-- Plays the session's tutorial to its last step (the practice duel), each
-- step at most `perStep` seconds of its own timeout, then returns the report.
function Bot.play(s,perStep)
	local t=s.tutorial
	assert(t,"no tutorial running")
	t.timeoutScale=(perStep or 10)/40
	local index,started=0,0
	local function alive() return s.tutorial==t and t.index==index and s.phase=="Duel" end
	local S=scripts(s,task.wait,alive)
	while s.tutorial==t and s.phase=="Duel" do
		local spec=t.steps[t.index]
		if not spec or spec.id=="win" then break end
		if t.index~=index then index=t.index;started=os.clock() end
		local fn=S[spec.id]
		if fn then
			local ok,err=pcall(fn)
			if not ok then warn("[NinjaDuelTutorialBot] "..spec.id..": "..tostring(err)) end
		end
		task.wait(.1)
		if os.clock()-started&gt;(perStep or 10)+2 then task.wait(.1) end
	end
	s.human.move=Vector3.zero;s.human.sprinting=false
	s.human.model:SetAttribute("TutorialStick",nil);s.human.model:SetAttribute("TutorialSprint",nil)
	return Tutorial.report(s)
end
return Bot
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND112">
        <Properties>
          <string name="Name">Ultimates</string>
          <ProtectedString name="Source">-- Ultimates (stage 6, the approved move list, "Ultimes"): one per main
-- fighter, R1 + L1 on the pad (Y on the keyboard) when the ultimate bar is
-- full. The bar fills in the fight, by hitting and by being hit (not only
-- while awakened). The ultimate opens with one quick move: if it reaches,
-- both bodies are taken into a 3-4 s sequence; if it misses, the opponent
-- has an opening. Away from the 8 main fighters (no entry below) the button
-- does nothing. On a wall, R1 + L1 is still the wall detach (Combat routes it).
--
-- (Redone 02/11, user: "globalement tous les mêmes ... les coups sont mal
-- faits ... même effet même sensation à chaque fois".) Each sequence is now
-- a script of its own (Shared/UltimateScripts): the paths both bodies follow
-- in the frame of the catch, its blows, Naruto's real shadow clones, the
-- lens and the cues the client draws. The bodies play authored clips for
-- the whole sequence ("&lt;fighter&gt;.Ultimate" from the press, "Ult.&lt;kind&gt;.Victim"
-- from the catch: tools/blender/ult_clips.py), not the fight's strikes.
local Ultimates={}
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Scripts=require(Shared.UltimateScripts)
Ultimates.Scripts=Scripts

Ultimates.MAX=100
-- Bar gain per point of damage dealt / taken (a fight of ~3 rounds gives
-- one or two ultimates a side).
Ultimates.GAIN={Dealt=1.1,Taken=.8}
-- Each ultimate: the opener's reach, its startup, the sequence length, the
-- total damage (its script's blows, then the last blow), the sequence kind
-- (Shared/UltimateScripts). Keep Startup/Time equal to tools/blender/ult_clips.py ULT.
Ultimates.DEFS={
	Naruto={Name="THOUSAND CLONES",Reach=10,Startup=.24,Time=3.9,Damage=30,Kind="clones"},
	Sasuke={Name="CHIDORI: LION'S STRIKE",Reach=12,Startup=.3,Time=3.6,Damage=32,Kind="lion"},
	Gaara={Name="IMPERIAL DESERT FUNERAL",Reach=26,Startup=.42,Time=3.6,Damage=34,Kind="pyramid"},
	["Rock Lee"]={Name="HIDDEN LOTUS",Reach=9,Startup=.2,Time=3.7,Damage=34,Kind="lotus"},
	Neji={Name="128 PALMS",Reach=8,Startup=.24,Time=3.6,Damage=30,Kind="palms"},
	Itachi={Name="TSUKUYOMI",Reach=20,Startup=.32,Time=4.0,Damage=28,Kind="tsukuyomi"},
	Minato={Name="YELLOW FLASH",Reach=22,Startup=.16,Time=3.4,Damage=30,Kind="flash"},
	Kakashi={Name="CHIDORI: RAIKIRI",Reach=22,Startup=.3,Time=3.4,Damage=34,Kind="raikiri"},
}
for _,u in Ultimates.DEFS do
	local spec=Scripts.KINDS[u.Kind]
	u.Opener=spec.opener;u.Blows=#spec.blows
end
function Ultimates.def(a)
	return Ultimates.DEFS[a.def.Name]
end
local function flat(v) return Vector3.new(v.X,0,v.Z) end

-- Combat:damage, once the amount is final: both bodies fill their bar.
function Ultimates.gain(c,attacker,victim,amount)
	if attacker==victim or amount&lt;=0 or victim.ultimateHeld then return end
	if Ultimates.def(attacker) and not attacker.ultimateRunning then
		attacker.ultimate=math.min(Ultimates.MAX,(attacker.ultimate or 0)+amount*Ultimates.GAIN.Dealt)
	end
	if Ultimates.def(victim) and not victim.ultimateRunning and not victim.ultimateHeld then
		victim.ultimate=math.min(Ultimates.MAX,(victim.ultimate or 0)+amount*Ultimates.GAIN.Taken)
	end
end
function Ultimates.ready(a)
	return Ultimates.def(a)~=nil and (a.ultimate or 0)&gt;=Ultimates.MAX
end

-- A body plays a whole-sequence clip (the snapshot's ultClip / ultElapsed).
local function play(c,x,clip)
	x.ultClip=clip;x.ultAt=c.now;x.ultSerial=(x.ultSerial or 0)+1
end
Ultimates.play=play
local function stopClip(x,clip)
	if x.ultClip==clip then x.ultClip=nil end
end

-- R1 + L1: start the ultimate (the bar is spent at the press).
function Ultimates.start(c,a)
	local Brawler=require(script.Parent.Brawler)
	local u=Ultimates.def(a)
	if not u then return false,"No ultimate" end
	if (a.ultimate or 0)&lt;Ultimates.MAX then return false,"Ultimate not ready" end
	if not Brawler.free(a,c.now) then return false,"Busy" end
	local b=a.target
	if not b or b.health&lt;=0 then return false,"No target" end
	local gap=flat(b.root.Position-a.root.Position)
	if gap.Magnitude&gt;u.Reach or not c:lineOfSight(a,b) then return false,"Out of range" end
	a.ultimate=0
	a.pending=nil;a.guardHeld=false;a.attackName=nil;a.attackVariant=nil
	c:setState(a,"Startup",u.Startup)
	a.invulnerableUntil=math.max(a.invulnerableUntil or 0,c.now+u.Startup)
	local face=if gap.Magnitude&gt;.1 then gap.Unit else flat(a.root.CFrame.LookVector)
	a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+face)
	-- The caster's clip runs from the press (its startup is the clip's start).
	play(c,a,a.fighterId..".Ultimate")
	local spec=Scripts.KINDS[u.Kind]
	-- A lunge closes the gap during the startup (one glide, no teleport).
	if spec.opener=="Lunge" and gap.Magnitude&gt;spec.close then
		local goal=Vector3.new(b.root.Position.X,a.root.Position.Y,b.root.Position.Z)-face*spec.close
		a.ultimateGlide={from=a.root.Position,to=c:clamp(goal),t0=c.now,t1=c.now+u.Startup*.85,face=b}
	end
	c:pushImpact(a.root.Position,"ultimateStart",true,{owner=a.id,fighter=a.fighterId,kind=u.Kind,name=u.Name,victim=b.id})
	c:cue(a,u.Name,1.2)
	Brawler.event(c,a,"UltimateStart")
	c:schedule(c.now+u.Startup,function() Ultimates.connect(c,a,b,u) end)
	return true
end

-- The opener's moment: it reaches or it misses.
function Ultimates.connect(c,a,b,u)
	local Brawler=require(script.Parent.Brawler)
	a.ultimateGlide=nil
	local clip=a.fighterId..".Ultimate"
	if a.health&lt;=0 or c.match.phase~="Duel" or c.match.finishing then stopClip(a,clip);return end
	if a.reaction then stopClip(a,clip);return end -- hit out of the startup: the ultimate is lost
	local gap=flat(b.root.Position-a.root.Position)
	local missed=b.health&lt;=0 or gap.Magnitude&gt;u.Reach*1.25 or (b.invulnerableUntil or 0)&gt;c.now or b.state=="Dodging"
		or (b.rotationUntil or 0)&gt;c.now or not c:lineOfSight(a,b)
	if missed then
		-- The opening: a long recovery, the bar is gone.
		stopClip(a,clip)
		c:setState(a,"Recovery",1.0)
		c:cue(a,"ULTIMATE MISSED",.9);c:cue(b,"OPENING",.8)
		c:pushImpact(a.root.Position,"ultimateMiss",false,{owner=a.id,kind=u.Kind})
		Brawler.event(c,a,"UltimateMiss")
		return
	end
	-- Caught: both bodies belong to the sequence (no input, no damage from
	-- elsewhere) and follow its script.
	Brawler.releaseGrab(b);b.pending=nil;b.guardHeld=false;b.attackName=nil
	if b.ultimateRunning then Ultimates.abort(c,b) end
	a.ultimateRunning=true;b.ultimateHeld=true
	local hold=u.Time+.1
	c:setState(a,"Recovery",hold)
	a.invulnerableUntil=math.max(a.invulnerableUntil or 0,c.now+hold)
	-- The held body: stunned for the whole sequence (a stun, not a wire), its
	-- own clip from the catch.
	Brawler.react(c,b,"HitStun",Vector3.zero,hold,a)
	play(c,b,"Ult."..u.Kind..".Victim")
	local seq=Ultimates.sequence(c,a,b,u)
	c:pushImpact(b.root.Position,"ultimate",true,{owner=a.id,victim=b.id,fighter=a.fighterId,kind=u.Kind,name=u.Name,time=u.Time,
		origin=seq.frame.origin,line=seq.frame.f,casterStart=seq.startA,victimStart=seq.startB})
	c:cue(a,u.Name,u.Time);c:cue(b,u.Name,u.Time)
	Brawler.event(c,a,"Ultimate")
	return seq
end

-- --------------------------------------------------------------- sequences
-- The running sequence: both bodies on their paths (Ultimates.step), the
-- blows at their times, the clones, the last blow at Time-0.3.
local function lookAt(x,y)
	x.root.CFrame=CFrame.lookAt(x.root.Position,Vector3.new(y.root.Position.X,x.root.Position.Y,y.root.Position.Z))
end
function Ultimates.sequence(c,a,b,u)
	local Brawler=require(script.Parent.Brawler)
	local spec=Scripts.KINDS[u.Kind]
	local t0=c.now
	local ground=(c.match.origin and c.match.origin.Y+3) or b.root.Position.Y
	local line=flat(b.root.Position-a.root.Position)
	if line.Magnitude&lt;.1 then line=flat(a.root.CFrame.LookVector) end
	local frame=Scripts.frame(Vector3.new(b.root.Position.X,ground,b.root.Position.Z),line)
	-- (12/11, feel audit M3: Kakashi caught in HitStun turned 155 deg in one
	-- frame, Itachi 176 deg) The caster faces him at once (his own startup
	-- already turned him); the caught body is turned by its path, at a rate
	-- (Ultimates.VICTIM_TURN, Ultimates.step), not snapped here.
	lookAt(a,b)
	local seq={c=c,a=a,b=b,u=u,spec=spec,t0=t0,frame=frame,blows=0,ground=ground,bodies={}}
	seq.startA=frame.anchor(a.root.Position);seq.startB=frame.anchor(b.root.Position)
	-- Faces: the caster at the other body, the held one as it was caught.
	local fixed=-frame.f
	a.ultimatePath={seq=seq,path=spec.caster,start=seq.startA,face="other",other=b,snaps=Scripts.snaps(spec.caster),snapped=0}
	b.ultimatePath={seq=seq,path=spec.victim,start=seq.startB,face="fixed",other=a,fixed=fixed,snaps={},snapped=0}
	a.ultimateSeq=seq
	local function alive() return a.health&gt;0 and b.health&gt;0 and c.match.phase=="Duel" and a.ultimateSeq==seq end
	function seq.at(t,fn) c:schedule(t0+t,function() if alive() then fn() end end) end
	local share=u.Damage*.65/math.max(1,#spec.blows)
	for i,blow in spec.blows do
		seq.at(blow[1],function()
			seq.blows+=1
			c.damageTag=u.Name
			c:chip(a,b,share)
			c.damageTag=nil
			if b.health&lt;=0 or c.match.phase~="Duel" then return end
			b.hitFrom=flat(a.root.Position-b.root.Position)
			c:pushImpact(b.root.Position+Vector3.new(0,.6,0),"ultimateTick",blow[2]==true,{owner=a.id,victim=b.id,kind=u.Kind,index=i,text=blow[3],t=blow[1]})
		end)
	end
	-- Naruto's clones: real bodies (Server/Bodies), each on its own path.
	if spec.clones then
		local Bodies=require(script.Parent.Bodies)
		Bodies.controllers.ult=Ultimates.cloneStep
		for _,clone in spec.clones do
			seq.at(clone.born,function()
				local at=frame.world(Scripts.at(clone.path,clone.born,Vector3.zero))
				local body=Bodies.spawn(c,a,{kind="clone",position=at,ephemeral=true,life=clone.gone-clone.born+.5,mode="ult",airborne=clone.air==true})
				if not body then return end
				body.ult={seq=seq,path=clone.path}
				Bodies.face(body,b.root.Position)
				table.insert(seq.bodies,body)
				for _,act in clone.actions do
					seq.at(act[1],function()
						if not body.alive then return end
						body.state="Active";body.action=act[2];body.variant=nil;body.actionAt=c.now;body.actionSerial+=1
						c:schedule(c.now+.4,function() if body.alive and body.action==act[2] then body.state="Neutral";body.action=nil end end)
					end)
				end
				seq.at(clone.gone,function() if body.alive then Bodies.dispel(c,body,"spent") end end)
			end)
		end
	end
	-- Each script's moments the server must announce (Minato's kunai fan).
	if spec.kunai then
		seq.at(.15,function()
			local points={}
			for i,p in spec.kunai do points[i]=frame.world(p) end
			c:pushImpact(b.root.Position,"ultimateKunai",false,{owner=a.id,victim=b.id,points=points})
		end)
	end
	seq.final=spec.final
	function seq.finish()
		if a.ultimateSeq~=seq then return end
		a.ultimateSeq=nil
		a.ultimateRunning=nil;b.ultimateHeld=nil
		a.ultimatePath=nil;b.ultimatePath=nil
		for _,body in seq.bodies do if body.alive then require(script.Parent.Bodies).dispel(c,body,"spent") end end
		c:schedule(c.now+.3,function() stopClip(b,"Ult."..u.Kind..".Victim") end)
		c:schedule(c.now+.36,function() stopClip(a,a.fighterId..".Ultimate") end)
		if a.health&lt;=0 or b.health&lt;=0 or c.match.phase~="Duel" then stopClip(a,a.fighterId..".Ultimate");stopClip(b,"Ult."..u.Kind..".Victim");return end
		b.invulnerableUntil=0
		local f=seq.final
		local away=flat(b.root.Position-a.root.Position)
		away=if away.Magnitude&gt;.1 then away.Unit else frame.f
		c.damageTag=u.Name
		local landed=c:damage(a,b,u.Damage*.35,true,false)
		c.damageTag=nil
		if c.match.phase~="Duel" or b.health&lt;=0 then return end
		if landed then Brawler.react(c,b,f.reaction,away*f.away+f.push,f.stun,a) end
		c:pushImpact(b.root.Position,"ultimateEnd",true,{owner=a.id,victim=b.id,kind=u.Kind})
		c:setState(a,"Recovery",.35)
	end
	c:schedule(t0+u.Time-.3,function() seq.finish() end)
	return seq
end
-- A sequence cut short (the caster caught in another's ultimate, a KO).
function Ultimates.abort(c,a)
	local seq=a.ultimateSeq
	if not seq then return end
	a.ultimateSeq=nil;a.ultimateRunning=nil
	seq.b.ultimateHeld=nil
	a.ultimatePath=nil;seq.b.ultimatePath=nil
	stopClip(a,a.fighterId..".Ultimate");stopClip(seq.b,"Ult."..seq.u.Kind..".Victim")
	for _,body in seq.bodies do if body.alive then require(script.Parent.Bodies).dispel(c,body,"spent") end end
end

-- A clone of the sequence (Bodies.controllers.ult): carried on its path.
function Ultimates.cloneStep(c,body,dt)
	local ult=body.ult
	if not ult then return end
	local seq=ult.seq
	local p=seq.frame.world(Scripts.at(ult.path,c.now-seq.t0,Vector3.zero))
	body.position=p
	body.airborne=p.Y&gt;seq.ground+.4
	local d=flat(seq.b.root.Position-p)
	if d.Magnitude&gt;.1 then body.look=d.Unit end
end

-- Server step: both bodies on their paths (no physics of their own), and the
-- caster's glide in the startup of a lunge.
Ultimates.VICTIM_TURN=900
function Ultimates.step(c)
	for _,x in c.actors do
		local glide=x.ultimateGlide
		-- A body struck out of its glide stops gliding (the 64 Palms' step in
		-- uses the same glide; an ultimate struck in its startup is lost anyway).
		if glide and x.reaction then x.ultimateGlide=nil;glide=nil end
		if glide then
			local k=math.clamp((c.now-glide.t0)/math.max(1e-3,glide.t1-glide.t0),0,1)
			local p=glide.from:Lerp(glide.to,1-(1-k)^3)
			local look=Vector3.new(glide.face.root.Position.X,p.Y,glide.face.root.Position.Z)
			x.model:PivotTo(if (look-p).Magnitude&gt;.1 then CFrame.lookAt(p,look) else CFrame.new(p))
			x.root.AssemblyLinearVelocity=Vector3.zero
			if k&gt;=1 then x.ultimateGlide=nil end
		end
		local run=x.ultimatePath
		if run then
			local seq=run.seq
			local t=c.now-seq.t0
			local anchor=Scripts.at(run.path,t,run.start)
			local p=seq.frame.world(anchor)
			local flatP=c:clamp(p)
			p=Vector3.new(flatP.X,math.max(p.Y,seq.ground-1),flatP.Z)
			-- A teleport (Minato): the client snaps instead of sliding.
			while run.snapped&lt;#run.snaps and t&gt;=run.snaps[run.snapped+1] do
				run.snapped+=1
				local from=x.root.Position
				x.warpSerial=(x.warpSerial or 0)+1
				c:pushImpact(p,"teleport",false,{owner=x.id,from=from,to=p,kind=seq.u.Kind})
			end
			local face=Scripts.face(run.path,t,run.face)
			local dir
			if face=="fixed" then dir=run.fixed or x.root.CFrame.LookVector
			else
				dir=flat(run.other.root.Position-p)
				if face=="away" then dir=-dir end
			end
			dir=flat(dir)
			-- (12/11, feel audit M3) The caught body turns to its path's facing
			-- at VICTIM_TURN (a blow hauls it round, ~0.2 s for a half turn), as a
			-- held body does (Brawler.GRAB_TURN); it was set in one frame.
			local dt=math.clamp(c.now-(run.lastAt or c.now),0,.1);run.lastAt=c.now
			local look=flat(x.root.CFrame.LookVector)
			if x==seq.b and dir.Magnitude&gt;.05 and look.Magnitude&gt;.05 then
				local want,cur=dir.Unit,look.Unit
				local angle=math.atan2(cur:Cross(want).Y,cur:Dot(want))
				local step=math.clamp(angle,-math.rad(Ultimates.VICTIM_TURN)*dt,math.rad(Ultimates.VICTIM_TURN)*dt)
				dir=CFrame.fromAxisAngle(Vector3.yAxis,step):VectorToWorldSpace(cur)
			end
			x.model:PivotTo(if dir.Magnitude&gt;.05 then CFrame.lookAt(p,p+dir.Unit) else CFrame.new(p))
			x.root.AssemblyLinearVelocity=Vector3.zero
			if p.Y&gt;seq.ground+.4 then x.airborne=true;x.airHold=c.now+.25 end
		end
	end
end

return Ultimates
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND113">
        <Properties>
          <string name="Name">VelmoraAntiCheat</string>
          <ProtectedString name="Source">-- Adapted from Velmora src/server/Combat/CombatAntiCheat.luau.
-- Copyright (c) 2026 Yashveer Singh, MIT.
local Tune=require(game:GetService('ReplicatedStorage').NinjaDuel.VelmoraCombatConfig)
local AntiCheat={}
local last={}
function AntiCheat.check(actor,action,clientTime,now)
	if type(action)~='string' then return false end
	local late=false
	if clientTime~=nil then
		if type(clientTime)~='number' or clientTime~=clientTime then return false end
		local delta=now-clientTime
		if delta&lt;-.05 then return false end
		-- (FEEL 05/11, AVANT defect 3) A press older than the history window
		-- used to be dropped without a word: a hitch or a ping spike ate the
		-- dodge (Studio: 402 ms after a 379 ms frame). Its time only dates the
		-- commit (Combat.attackCommitTime), it grants nothing; up to LateAccept
		-- the press counts as late (the caller drops its time), past it it is
		-- too old to mean anything.
		if delta&gt;Tune.History+Tune.TimestampWindow then
			if delta&gt;(Tune.LateAccept or 0) then return false end
			late=true
		end
	end
	local clock=os.clock();local bucket=last[actor]
	if not bucket then bucket={};last[actor]=bucket end
	local family=if string.match(action,'^Technique') or string.match(action,'^Seal%d') then 'Technique' else action
	local gap=Tune.Rates[family] or .04
	if bucket[family] and clock-bucket[family]&lt;gap then return false end
	bucket[family]=clock
	return true,late
end
function AntiCheat.clear(actor) last[actor]=nil end
return AntiCheat
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND114">
        <Properties>
          <string name="Name">VelmoraDefense</string>
          <ProtectedString name="Source">-- Adapted from Velmora CombatService guard/parry/dodge resolution.
-- Copyright (c) 2026 Yashveer Singh, MIT.
local Tune=require(game:GetService('ReplicatedStorage').NinjaDuel.VelmoraCombatConfig)
local Defense={}
function Defense.init(a)
	a.stamina=100;a.guardPressedAt=-math.huge;a.parryReadyAt=0;a.dodgeStartedAt=-math.huge;a.bloodstepGrantedFor=-math.huge
end
function Defense.guard(a,down,now)
	if down and not a.guardHeld then a.guardPressedAt=now end
	a.guardHeld=down
end
function Defense.dodge(a,now)
	a.dodgeStartedAt=now
	a.invulnerableUntil=math.max(a.invulnerableUntil,now+Tune.DodgeIFrames)
end
-- `melee`: the blow came from the attacker's own body. Only then can a parry
-- stun them; a parried blade, flame or hazard is simply negated.
function Defense.resolve(c,attacker,victim,amount,frontal,melee)
	-- Itachi's Sharingan sees the strike coming: wider windows, and every
	-- clean read opens a counter.
	local eye=victim.def and victim.def.Sharingan
	-- Kakashi's eye only while awakened (stage 6, def.SharinganAwake).
	if eye and victim.def.SharinganAwake and (victim.awakenUntil or 0)&lt;=c.now then eye=nil end
	if eye and (victim.awakenUntil or 0)&gt;c.now and victim.def.Awakening and victim.def.Awakening.Windows then
		local k=victim.def.Awakening.Windows
		eye={ParryWindow=eye.ParryWindow*k,PerfectDodge=eye.PerfectDodge*k,Counter=eye.Counter}
	end
	if victim.invulnerableUntil&gt;c.now then
		local clean=c.now-victim.dodgeStartedAt&lt;=(if eye then eye.PerfectDodge else Tune.BloodstepWindow) and victim.bloodstepGrantedFor~=victim.dodgeStartedAt
		if clean then
			victim.bloodstepGrantedFor=victim.dodgeStartedAt;victim.bonusUntil=c.now+.8;victim.riposteUntil=c.now+.5
			if eye then victim.counterUntil=c.now+eye.Counter;c:cue(victim,'SHARINGAN • PERFECT DODGE • COUNTER')
			else c:cue(victim,'PERFECT DODGE • BLOODSTEP') end
		end
		return 'Evaded',0
	end
	if not frontal or not victim.guardHeld then return 'Hit',amount end
	local since=c.now-victim.guardPressedAt
	local window=if eye then eye.ParryWindow else Tune.ParryWindow
	-- A buff that widens the parry (Neji's Byakugan: Perception).
	local sight=victim.buff
	if sight and c.now&lt;sight.untilT and sight.spec.ParryScale then window*=sight.spec.ParryScale end
	-- Sharingan Focus: the raised guard itself reads. Any frontal blow of the
	-- body that meets it is parried (once per raise; parry cooldown and
	-- stamina still apply) and read. Blades and jutsu keep the eye's window.
	local focus=eye~=nil and melee and victim.def.Awakening and victim.def.Awakening.GuardRead==true and (victim.awakenUntil or 0)&gt;c.now
	if focus then window=1e3 end
	-- Closed chakra points (Gentle Fist) compromise the guard: the parry
	-- window narrows with each one (none left at four) and a blocked blow costs
	-- more stamina.
	local points=Defense.closedPoints(victim,c.now)
	window*=math.max(0,1-.25*points)
	if since&lt;=window and c.now&gt;=victim.parryReadyAt and victim.stamina&gt;=Tune.ParryCost then
		victim.stamina-=Tune.ParryCost;victim.parryReadyAt=c.now+Tune.ParryCooldown;victim.guardPressedAt=-math.huge
		if not melee then c:cue(victim,'DEFLECTED');return 'Parried',0 end
		attacker.pending=nil;attacker.guardHeld=false;c:setState(attacker,'Stunned',Tune.ParryStun)
		if eye then victim.counterUntil=c.now+eye.Counter;c:cue(victim,'SHARINGAN • PARRY • COUNTER')
		else c:cue(victim,'PARRY • PUNISH') end
		if focus then
			victim.bonusUntil=c.now+1;victim.counterReach={expires=c.now+eye.Counter,max=4,variant="ReadCounter"}
			Defense.slip(c,victim,attacker,"focus")
			c:cue(victim,'SHARINGAN FOCUS • READ • COUNTER')
		end
		c:cue(attacker,'PARRIED • EXPOSED')
		return 'Parried',0
	end
	local blockCost=Tune.BlockHitCost*(1+.2*points)
	if victim.stamina&gt;=blockCost then
		victim.stamina-=blockCost
		return 'Blocked',amount*Tune.BlockDamageMultiplier
	end
	victim.guardHeld=false;c:setState(victim,'Stunned',.65);c:cue(victim,'GUARD BREAK')
	return 'GuardBreak',amount
end
-- Chakra points Neji has closed on this fighter (0 once they reopen).
function Defense.closedPoints(a,now)
	return if (a.tenketsuUntil or 0)&gt;now then (a.tenketsu or 0) else 0
end
-- A read: the reader slips a step to the outside of the blow (an afterimage
-- stays where he stood and the swing bites it), turns square to the attacker,
-- and the client shows the eye, the afterimage and the bitten swing ("read").
function Defense.slip(c,reader,attacker,phase)
	local Motor=require(script.Parent.Motor)
	local from=reader.root.Position
	local line=from-attacker.root.Position;line=Vector3.new(line.X,0,line.Z)
	line=if line.Magnitude&gt;.1 then line.Unit else Vector3.new(reader.root.CFrame.LookVector.X,0,reader.root.CFrame.LookVector.Z).Unit
	local side=Vector3.new(-line.Z,0,line.X)
	local stick=Vector3.new(reader.move.X,0,reader.move.Z)
	local sign=if stick.Magnitude&gt;.4 then (if stick:Dot(side)&gt;=0 then 1 else -1) else (reader.slipSide or 1)
	reader.slipSide=-sign
	if Motor.travel(reader,c,side*sign,2.2)&lt;1 then Motor.travel(reader,c,-side*sign,2.2) end
	local face=attacker.root.Position-reader.root.Position;face=Vector3.new(face.X,0,face.Z)
	if face.Magnitude&gt;.1 then reader.root.CFrame=CFrame.lookAt(reader.root.Position,reader.root.Position+face) end
	c:pushImpact(from,"read",false,{owner=reader.id,fighter=reader.fighterId,victim=attacker.id,to=reader.root.Position,phase=phase})
	require(script.Parent.Brawler).event(c,reader,"ReadSlip")
end
-- A strike pressed during the counter stance fires the moment it pays off.
function Defense.fireQueued(c,a)
	if not a.counterQueued or c.now-a.counterQueued&gt;1.1 then return end
	c:schedule(c.now,function()
		if a.health&gt;0 and (a.counterUntil or 0)&gt;c.now and a.state=="Neutral" and not a.reaction then require(script.Parent.Brawler).counterStart(c,a) end
	end)
end
-- Sharingan Read paid off (Combat:damage, a frontal melee blow inside the
-- stance): no damage, the attacker is caught out, the reader slips aside out
-- of the stance at once and the counter palm opens (instantly when the strike
-- was already pressed during the stance). Returns false (no damage).
function Defense.read(c,attacker,victim)
	local now=c.now
	victim.readUntil=0;victim.bonusUntil=now+1.4;victim.counterUntil=now+1.0
	victim.counterReach={expires=now+1.0,max=4,variant="ReadCounter"}
	victim.chakra=math.min(victim.def.Chakra or 100,victim.chakra+10)
	-- (Audit 03/11, the user's own play) exposed as long as a parry leaves
	-- the body (Tune.ParryStun), not 0.5 s.
	attacker.pending=nil;c:setState(attacker,"Stunned",Tune.ParryStun)
	victim.pending=nil;c:setState(victim,"Neutral",0)
	Defense.slip(c,victim,attacker,"read")
	c:cue(victim,"READ • SEEN COMING • PUNISH");c:cue(attacker,"READ • EXPOSED")
	require(script.Parent.Brawler).event(c,victim,"ReadSuccess")
	Defense.fireQueued(c,victim)
	return false
end
function Defense.step(c,a,dt,now)
	if a.guardHeld then
		a.stamina=math.max(0,a.stamina-12*dt)
		if a.stamina&lt;=0 then a.guardHeld=false;c:setState(a,'Stunned',.45);c:cue(a,'GUARD EXHAUSTED') end
	else a.stamina=math.min(100,a.stamina+18*dt) end
end
return Defense
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND115">
        <Properties>
          <string name="Name">VelmoraHitDetection</string>
          <ProtectedString name="Source">-- Adapted from Velmora src/server/Combat/HitDetection.luau.
-- Copyright (c) 2026 Yashveer Singh, MIT.
-- Keeps the donor's short position history, interpolation, reach/cone and world LOS.
local Tune=require(game:GetService('ReplicatedStorage').NinjaDuel.VelmoraCombatConfig)
local HitDetection={}
local history={}
function HitDetection.record(root,t)
	local buf=history[root]
	if not buf then buf={};history[root]=buf end
	table.insert(buf,{t=t,pos=root.Position})
	local cutoff=t-(Tune.History+Tune.TimestampWindow)
	while #buf&gt;2 and buf[1].t&lt;cutoff do table.remove(buf,1) end
end
function HitDetection.positionAt(root,t)
	local buf=history[root]
	if not buf or #buf==0 then return root.Position end
	if t&lt;=buf[1].t then return buf[1].pos end
	if t&gt;=buf[#buf].t then return buf[#buf].pos end
	for i=1,#buf-1 do
		local a,b=buf[i],buf[i+1]
		if t&gt;=a.t and t&lt;=b.t then
			local span=b.t-a.t
			return a.pos:Lerp(b.pos,if span&gt;0 then (t-a.t)/span else 0)
		end
	end
	return buf[#buf].pos
end
function HitDetection.clear(root) history[root]=nil end
function HitDetection.resolve(attackerRoot,range,arcAngle,origin,aim,t,candidates,effects)
	local look=if aim.Magnitude&gt;.001 then aim.Unit else attackerRoot.CFrame.LookVector
	local exclude={effects,attackerRoot.Parent}
	for _,root in candidates do if root.Parent then table.insert(exclude,root.Parent) end end
	local ray=RaycastParams.new();ray.FilterType=Enum.RaycastFilterType.Exclude;ray.FilterDescendantsInstances=exclude;ray.IgnoreWater=true
	local best,bestPos,bestDistance=nil,nil,math.huge
	for _,root in candidates do
		if root~=attackerRoot and root.Parent then
			local pos=HitDetection.positionAt(root,t);local delta=pos-origin;local distance=delta.Magnitude
			if distance&lt;=range and (distance&lt;.001 or math.deg(math.acos(math.clamp(look:Dot(delta.Unit),-1,1)))&lt;=arcAngle) and workspace:Raycast(origin,delta,ray)==nil and distance&lt;bestDistance then
				best,bestPos,bestDistance=root,pos,distance
			end
		end
	end
	return best,bestPos
end
return HitDetection
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND116">
        <Properties>
          <string name="Name">Wave1Kit</string>
          <ProtectedString name="Source">-- Roster 20, batch 1 (Haku, Zabuza, Kimimaro): the batch's server side. All
-- three techniques sets run on the shared families (Server/Families); this
-- module only dresses them. Never a condition on a fighter's name in the
-- shared core: hooks and families.
local Kit={}
function Kit.install(Techniques) end

local ARMS={"LeftUpperArm","RightUpperArm","LeftLowerArm","RightLowerArm"}
local LEGS={"LeftUpperLeg","RightUpperLeg","LeftLowerLeg","RightLowerLeg"}
local TORSO={"UpperTorso","LowerTorso"}
local function paint(model,names,color)
	for _,name in names do local part=model:FindFirstChild(name);if part then part.Color=color end end
end
Kit.paint=paint;Kit.ARMS=ARMS;Kit.LEGS=LEGS;Kit.TORSO=TORSO

function Kit.dress(dressers,kit)
	local wear,face,hairCap,spike,rgb,A,R=kit.wear,kit.face,kit.hairCap,kit.spike,kit.rgb,kit.A,kit.R
	local function sandals(model,def,strap)
		local skin=Color3.fromRGB(table.unpack(def.Skin))
		for _,side in {"Left","Right"} do
			local foot=model:FindFirstChild(side.."Foot");if foot then foot.Color=strap end
			wear(model,side.."Foot","Toes",Vector3.new(.7,.16,.34),CFrame.new(0,.1,-.42),skin)
		end
	end
	local function hideCap(model,color)
		local cap=model:FindFirstChild("Hair");if cap then cap.Color=color;cap.Transparency=1 end
	end

	-- Haku (15): long black hair tied back loosely, two locks at the face, a
	-- green-and-white haori over a dark kimono, the hunter-nin mask pushed to
	-- the side of his head, a wide obi.
	dressers.Haku=function(model,def)
		local hair=rgb(30,30,36)
		local robe=rgb(110,140,112)
		local robeShade=rgb(84,110,88)
		local under=rgb(40,46,52)
		hideCap(model,hair)
		face(model,rgb(70,60,52),hair)
		hairCap(model,hair)
		wear(model,"Head","Fringe",Vector3.new(1.6,.32,.2),CFrame.new(0,.5,-.78),hair)
		for _,side in {-1,1} do
			wear(model,"Head","FaceLock",Vector3.new(.22,1.4,.3),CFrame.new(side*.78,-.3,-.48),hair)
		end
		wear(model,"Head","BackHair",Vector3.new(1.5,1.2,.3),CFrame.new(0,0,.74),hair)
		wear(model,"Head","Tail",Vector3.new(.5,1.6,.4),CFrame.new(0,-.9,.84)*A(R(-12),0,0),hair)
		wear(model,"Head","HairTie",Vector3.new(.56,.16,.46),CFrame.new(0,-.1,.86),rgb(220,220,214))
		-- The mask: white, the Mist's mark, pushed to the side.
		wear(model,"Head","Mask",Vector3.new(.9,1.1,.08),CFrame.new(.84,.1,-.1)*A(0,R(-70),0),rgb(240,240,236))
		wear(model,"Head","MaskMark",Vector3.new(.5,.08,.02),CFrame.new(.88,.36,-.12)*A(0,R(-70),0),rgb(150,40,40))
		paint(model,TORSO,under);paint(model,ARMS,robe);paint(model,LEGS,under)
		wear(model,"UpperTorso","Haori",Vector3.new(2.1,1.7,1.14),CFrame.new(0,-.02,0),robe)
		wear(model,"UpperTorso","Collar",Vector3.new(1.2,.5,1.16),CFrame.new(0,.7,-.02),rgb(226,230,222))
		wear(model,"LowerTorso","Obi",Vector3.new(2.1,.46,1.12),CFrame.new(0,.28,0),robeShade)
		wear(model,"LowerTorso","Skirt",Vector3.new(2.14,.8,1.16),CFrame.new(0,-.36,0),robe)
		for _,side in {"Left","Right"} do
			wear(model,side.."LowerArm","Sleeve",Vector3.new(1.0,.5,1.0),CFrame.new(0,-.2,0),robeShade)
		end
		-- Senbon held in the right hand's fingers (the tool's tell at rest).
		for k=-1,1 do
			wear(model,"RightHand","Senbon",Vector3.new(.04,.04,1.1),CFrame.new(k*.1,-.2,-.3),rgb(220,226,236),Enum.Material.Metal)
		end
		sandals(model,def,rgb(40,46,52))
	end

	-- Zabuza (14): spiky black hair, the forehead protector worn sideways, the
	-- bandage over the mouth, bare arms, grey camouflage trousers, the leather
	-- harness and the great cleaver on his back.
	dressers.Zabuza=function(model,def)
		local hair=rgb(30,30,34)
		local grey=rgb(120,128,130)
		local greyShade=rgb(96,104,108)
		local skin=Color3.fromRGB(table.unpack(def.Skin))
		hideCap(model,hair)
		face(model,rgb(36,34,32),hair)
		hairCap(model,hair)
		for i,s in {{Vector3.new(0,.8,.1),Vector3.new(0,1,.2)},{Vector3.new(-.4,.7,.2),Vector3.new(-.5,.9,.3)},{Vector3.new(.4,.7,.2),Vector3.new(.5,.9,.3)},{Vector3.new(0,.6,.6),Vector3.new(0,.6,1)}} do
			spike(model,s[1],s[2],1.0,.42,.36,hair)
		end
		-- Headband slanted to the side, the Mist's plate.
		wear(model,"Head","Headband",Vector3.new(1.68,.26,1.68),CFrame.new(0,.34,0)*A(0,0,R(-10)),rgb(60,66,70))
		wear(model,"Head","HeadbandPlate",Vector3.new(.86,.3,.06),CFrame.new(.2,.36,-.85)*A(0,R(-14),R(-10)),rgb(176,184,194),Enum.Material.Metal)
		-- The bandage over the mouth and neck.
		wear(model,"Head","Bandage",Vector3.new(1.64,.62,1.64),CFrame.new(0,-.38,-.02),rgb(226,222,210))
		for _,p in model:GetChildren() do if p.Name=="Mouth" then p.Transparency=1 end end
		paint(model,TORSO,grey);paint(model,ARMS,skin);paint(model,LEGS,grey)
		wear(model,"UpperTorso","Harness",Vector3.new(.3,1.9,1.14),CFrame.new(.2,0,0)*A(0,0,R(30)),rgb(70,56,44))
		wear(model,"LowerTorso","Belt",Vector3.new(2.06,.24,1.06),CFrame.new(0,.34,0),rgb(70,56,44))
		for _,side in {"Left","Right"} do
			wear(model,side.."LowerArm","Guard",Vector3.new(.86,.6,.86),CFrame.new(0,-.2,0),greyShade)
			wear(model,side.."LowerLeg","Wrap",Vector3.new(.86,.6,.86),CFrame.new(0,-.2,0),greyShade)
		end
		-- Kubikiribōchō on the back: the great blade, its round hole, the handle.
		wear(model,"UpperTorso","Cleaver",Vector3.new(.16,4.6,1.6),CFrame.new(0,.3,.72)*A(0,R(90),R(-28)),rgb(180,188,196),Enum.Material.Metal)
		wear(model,"UpperTorso","CleaverHole",Vector3.new(.18,.6,.6),CFrame.new(-.9,1.6,.72)*A(0,R(90),R(-28)),rgb(30,30,34))
		wear(model,"UpperTorso","CleaverGrip",Vector3.new(.24,1.3,.24),CFrame.new(1.3,-1.8,.72)*A(0,0,R(-28)),rgb(60,46,36))
		sandals(model,def,rgb(50,54,58))
	end

	-- Kimimaro (13): white hair to the shoulders parted in the middle, two red
	-- dots on the brow, a loose white robe open at the chest, the thick purple
	-- rope belt; bone at the shoulder ready to be drawn.
	dressers.Kimimaro=function(model,def)
		local hair=rgb(236,234,228)
		local robe=rgb(236,232,224)
		local robeShade=rgb(206,200,190)
		hideCap(model,hair)
		face(model,rgb(60,90,60),hair)
		hairCap(model,hair)
		wear(model,"Head","Parting",Vector3.new(1.66,.3,.3),CFrame.new(0,.5,-.74),hair)
		for _,side in {-1,1} do
			wear(model,"Head","SideHair",Vector3.new(.24,1.4,1.0),CFrame.new(side*.84,-.2,.1),hair)
			wear(model,"Head","BrowDot",Vector3.new(.14,.14,.04),CFrame.new(side*.22,.42,-.82),rgb(196,40,48))
		end
		wear(model,"Head","BackHair",Vector3.new(1.6,1.4,.3),CFrame.new(0,-.2,.74),hair)
		paint(model,TORSO,robe);paint(model,ARMS,robe);paint(model,LEGS,robeShade)
		wear(model,"UpperTorso","Robe",Vector3.new(2.1,1.7,1.14),CFrame.new(0,-.02,0),robe)
		wear(model,"UpperTorso","OpenChest",Vector3.new(.5,.9,.06),CFrame.new(0,.2,-.58),Color3.fromRGB(table.unpack(def.Skin)))
		wear(model,"LowerTorso","Rope",Vector3.new(2.2,.5,1.2),CFrame.new(0,.3,0),rgb(110,70,150))
		wear(model,"LowerTorso","RopeKnot",Vector3.new(.6,.6,.4),CFrame.new(0,.3,.62),rgb(110,70,150))
		wear(model,"LowerTorso","Skirt",Vector3.new(2.14,.9,1.16),CFrame.new(0,-.4,0),robe)
		-- The bone at the shoulder (the Camellia's hilt) and a spur at each wrist.
		wear(model,"RightUpperArm","ShoulderBone",Vector3.new(.24,.9,.24),CFrame.new(0,.7,0)*A(R(-20),0,0),rgb(244,238,220))
		for _,side in {"Left","Right"} do
			wear(model,side.."LowerArm","WristSpur",Vector3.new(.14,.6,.14),CFrame.new(0,-.1,.4)*A(R(30),0,0),rgb(244,238,220))
		end
		sandals(model,def,rgb(200,196,186))
	end
end
return Kit
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND117">
        <Properties>
          <string name="Name">Wave2Kit</string>
          <ProtectedString name="Source">-- Roster 20, batch 2 (Shisui, Orochimaru, Kabuto): the batch's server side.
-- Their techniques all run on the shared families; this module dresses them.
local Base=require(script.Parent.Wave1Kit)
local paint,ARMS,LEGS,TORSO=Base.paint,Base.ARMS,Base.LEGS,Base.TORSO
local Kit={}
function Kit.install(Techniques) end
function Kit.dress(dressers,kit)
	local wear,face,hairCap,spike,headband,rgb,A,R=kit.wear,kit.face,kit.hairCap,kit.spike,kit.headband,kit.rgb,kit.A,kit.R
	local function sandals(model,def,strap)
		local skin=Color3.fromRGB(table.unpack(def.Skin))
		for _,side in {"Left","Right"} do
			local foot=model:FindFirstChild(side.."Foot");if foot then foot.Color=strap end
			wear(model,side.."Foot","Toes",Vector3.new(.7,.16,.34),CFrame.new(0,.1,-.42),skin)
		end
	end
	local function hideCap(model,color)
		local cap=model:FindFirstChild("Hair");if cap then cap.Color=color;cap.Transparency=1 end
	end

	-- Shisui (13): thick, messy black curls, the Leaf headband, the high-
	-- collared dark Uchiha shirt with the fan on the back, a short sword
	-- (tantō) at the small of the back, arm guards.
	dressers.Shisui=function(model,def)
		local hair=rgb(24,24,30)
		local shirt=rgb(40,44,60)
		local shade=rgb(30,32,44)
		hideCap(model,hair)
		face(model,rgb(40,30,30),hair)
		hairCap(model,hair)
		for _,s in {{Vector3.new(-.5,.7,-.2),Vector3.new(-.7,.6,-.6)},{Vector3.new(.5,.7,-.2),Vector3.new(.7,.6,-.6)},{Vector3.new(0,.8,.2),Vector3.new(0,1,.2)},
			{Vector3.new(-.6,.4,.4),Vector3.new(-1,.2,.6)},{Vector3.new(.6,.4,.4),Vector3.new(1,.2,.6)},{Vector3.new(0,.4,.7),Vector3.new(0,0,1)}} do
			spike(model,s[1],s[2],.8,.5,.46,hair)
		end
		headband(model)
		paint(model,TORSO,shirt);paint(model,ARMS,shirt);paint(model,LEGS,shade)
		wear(model,"UpperTorso","Collar",Vector3.new(1.4,.5,1.18),CFrame.new(0,.82,.02),shirt)
		-- The Uchiha fan on the back: white handle, red top.
		wear(model,"UpperTorso","FanRed",Vector3.new(.7,.5,.04),CFrame.new(0,.3,.56),rgb(200,40,40))
		wear(model,"UpperTorso","FanWhite",Vector3.new(.7,.36,.04),CFrame.new(0,-.1,.56),rgb(240,240,236))
		wear(model,"UpperTorso","FanHandle",Vector3.new(.14,.5,.04),CFrame.new(0,-.5,.56),rgb(240,240,236))
		wear(model,"LowerTorso","Belt",Vector3.new(2.06,.2,1.06),CFrame.new(0,.34,0),rgb(20,22,28))
		wear(model,"LowerTorso","Tanto",Vector3.new(.16,.16,1.6),CFrame.new(0,.2,.66)*A(0,R(90),R(10)),rgb(30,30,34))
		for _,side in {"Left","Right"} do
			wear(model,side.."LowerArm","ArmGuard",Vector3.new(.86,.6,.86),CFrame.new(0,-.16,0),rgb(150,156,164),Enum.Material.Metal)
			wear(model,side.."LowerLeg","ShinWrap",Vector3.new(.86,.5,.86),CFrame.new(0,-.2,0),rgb(220,220,214))
		end
		sandals(model,def,rgb(30,32,40))
	end

	-- Orochimaru (12): long straight black hair past the shoulders, pale
	-- skin, the purple marks round the eyes, a grey-blue genin outfit with a
	-- purple rope belt, the Leaf headband.
	dressers.Orochimaru=function(model,def)
		local hair=rgb(24,24,30)
		local suit=rgb(70,78,96)
		local shade=rgb(54,60,76)
		hideCap(model,hair)
		face(model,rgb(200,170,60),hair)
		hairCap(model,hair)
		wear(model,"Head","Fringe",Vector3.new(1.6,.36,.2),CFrame.new(0,.5,-.78),hair)
		for _,side in {-1,1} do
			wear(model,"Head","SideHair",Vector3.new(.22,1.8,1.1),CFrame.new(side*.84,-.4,.1),hair)
			wear(model,"Head","EyeMark",Vector3.new(.3,.12,.03),CFrame.new(side*.26,.12,-.83),rgb(130,80,160))
		end
		wear(model,"Head","BackHair",Vector3.new(1.6,2,.3),CFrame.new(0,-.6,.76),hair)
		headband(model)
		paint(model,TORSO,suit);paint(model,ARMS,suit);paint(model,LEGS,shade)
		wear(model,"UpperTorso","Robe",Vector3.new(2.1,1.7,1.14),CFrame.new(0,-.02,0),suit)
		wear(model,"UpperTorso","Lapel",Vector3.new(.5,1.4,.06),CFrame.new(.3,0,-.58)*A(0,0,R(-12)),shade)
		wear(model,"LowerTorso","Rope",Vector3.new(2.2,.4,1.2),CFrame.new(0,.3,0),rgb(110,70,150))
		wear(model,"LowerTorso","RopeKnot",Vector3.new(.5,.5,.4),CFrame.new(0,.3,.62),rgb(110,70,150))
		-- A small white snake curled round the left wrist.
		wear(model,"LeftLowerArm","WristSnake",Vector3.new(.92,.2,.92),CFrame.new(0,-.36,0),rgb(236,234,228))
		for _,side in {"Left","Right"} do
			wear(model,side.."LowerLeg","ShinWrap",Vector3.new(.86,.5,.86),CFrame.new(0,-.2,0),rgb(220,220,214))
		end
		sandals(model,def,rgb(40,44,52))
	end

	-- Kabuto (13): grey hair in a short ponytail, round glasses, the purple
	-- shirt with the white collar, a dark belt with pouches, the Leaf headband.
	dressers.Kabuto=function(model,def)
		local hair=rgb(200,200,206)
		local shirt=rgb(110,84,130)
		local shade=rgb(84,64,100)
		hideCap(model,hair)
		face(model,rgb(40,36,40),hair)
		hairCap(model,hair)
		wear(model,"Head","Fringe",Vector3.new(1.6,.3,.2),CFrame.new(0,.52,-.78),hair)
		wear(model,"Head","Tail",Vector3.new(.4,.9,.36),CFrame.new(0,-.4,.86),hair)
		-- Round glasses: two rims and the bridge.
		for _,side in {-1,1} do
			wear(model,"Head","Lens",Vector3.new(.36,.3,.03),CFrame.new(side*.26,.1,-.86),rgb(220,236,240),Enum.Material.Glass)
			wear(model,"Head","Rim",Vector3.new(.4,.34,.02),CFrame.new(side*.26,.1,-.85),rgb(60,60,66),Enum.Material.Metal)
		end
		wear(model,"Head","Bridge",Vector3.new(.16,.04,.03),CFrame.new(0,.14,-.87),rgb(60,60,66),Enum.Material.Metal)
		headband(model)
		paint(model,TORSO,shirt);paint(model,ARMS,shirt);paint(model,LEGS,shade)
		wear(model,"UpperTorso","Collar",Vector3.new(1.5,.32,1.16),CFrame.new(0,.82,0),rgb(236,234,230))
		wear(model,"LowerTorso","Belt",Vector3.new(2.06,.24,1.06),CFrame.new(0,.34,0),rgb(40,36,44))
		for _,x in {-.6,.6} do wear(model,"LowerTorso","Pouch",Vector3.new(.4,.4,.2),CFrame.new(x,.2,-.58),rgb(60,54,66)) end
		for _,side in {"Left","Right"} do
			wear(model,side.."LowerArm","Wrap",Vector3.new(.86,.4,.86),CFrame.new(0,-.36,0),rgb(220,220,214))
		end
		sandals(model,def,rgb(40,36,44))
	end
end
return Kit
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND118">
        <Properties>
          <string name="Name">Wave3Kit</string>
          <ProtectedString name="Source">-- Roster 20, batch 3 (Deidara, Sasori, Nagato, Killer Bee): the batch's
-- server side. Their techniques run on the shared families; this module
-- dresses them.
local Base=require(script.Parent.Wave1Kit)
local paint,ARMS,LEGS,TORSO=Base.paint,Base.ARMS,Base.LEGS,Base.TORSO
local Kit={}
-- Sasori's puppet: a persistent body (Server/Bodies) on chakra threads. It
-- holds a spot between him and the opponent, off the line, and strikes on
-- its own rhythm (a poisoned blade); his heavy-after-one and his rising
-- strike are carried out by it when it is out (MoveGraphs proxy); cast again,
-- it lunges at the body. One clean blow breaks it (Bodies): then he is a
-- slow lasher with no bodyguard until he makes another.
function Kit.install(Techniques)
	local Bodies=require(script.Parent.Bodies)
	local Families=require(script.Parent.Families)
	local function flat(v) return Vector3.new(v.X,0,v.Z) end
	local function strike(c,body,b,spec)
		local tune=Bodies.tuning(body.owner,body.kind)
		body.state="Startup";body.action="PuppetJab";body.variant=nil;body.actionAt=c.now;body.actionSerial+=1
		body.pendingStrike=spec or {damage=tune.Damage or 4,reach=(tune.Reach or 5.2),reaction="HitStun",push=10,up=3,stun=.34,tag="Puppet",poison=tune.Poison}
	end
	Bodies.controllers.marionette=function(c,body,dt)
		local a=body.owner
		local b=a.target
		if not b or b.health&lt;=0 then return end
		local tune=Bodies.tuning(a,body.kind)
		-- A strike already thrown: its contact on its own timing.
		if body.state=="Startup" and c.now&gt;=body.actionAt+.18 then
			body.state="Active"
			local s=body.pendingStrike or {}
			if Bodies.hitFrom(c,body,b,{damage=s.damage,reach=s.reach,height=6,arc=-.2,reaction=s.reaction,push=s.push,up=s.up,stun=s.stun,tag=s.tag}) then
				-- A guard that held takes the chip, never the venom.
				if s.poison and b.impactStyle~="block" then Families.poison(c,a,b,s.poison) end
				require(script.Parent.Brawler).event(c,a,"PuppetHit")
			end
		elseif body.state=="Active" and c.now&gt;=body.actionAt+.3 then body.state="Recovery"
		elseif body.state=="Recovery" and c.now&gt;=body.actionAt+.55 then body.state="Neutral" end
		local goal,speed
		if body.lunge then
			-- Lunge: straight at the body, the blade on arrival.
			local line=flat(body.position-b.root.Position)
			line=if line.Magnitude&gt;.1 then line.Unit else flat(-b.root.CFrame.LookVector).Unit
			goal=b.root.Position+line*2.4;speed=78
			if flat(body.position-goal).Magnitude&lt;1.2 and body.state=="Neutral" then
				local l=body.lunge;body.lunge=nil
				strike(c,body,b,{damage=l.Damage or 7,reach=5,reaction="Knockback",push=l.Knock or 26,up=l.Lift or 8,stun=.45,tag="Puppet Lunge",poison=l.Poison})
				body.nextStrike=c.now+(tune.Every or 2.2)
			end
		else
			-- Its post: between the two of them, off the line, at blade's reach.
			local line=flat(a.root.Position-b.root.Position)
			line=if line.Magnitude&gt;.1 then line.Unit else flat(-b.root.CFrame.LookVector).Unit
			local around=CFrame.fromAxisAngle(Vector3.yAxis,math.rad(40*body.side)):VectorToWorldSpace(line)
			goal=b.root.Position+around*(tune.Hold or 4.4)
			-- On a short leash: far from him, it comes back to his side.
			if flat(a.root.Position-b.root.Position).Magnitude&gt;(tune.Leash or 34) then goal=a.root.Position+line:Cross(Vector3.yAxis)*body.side*3 end
			speed=tune.Speed or 30
			if body.state=="Neutral" and c.now&gt;=body.nextStrike and flat(b.root.Position-body.position).Magnitude&lt;=(tune.Reach or 5.2)+.6 then
				strike(c,body,b)
				body.nextStrike=c.now+(tune.Every or 2.2)
			end
		end
		goal=Vector3.new(goal.X,c.match.origin.Y+3,goal.Z)
		Bodies.move(c,body,goal,speed,dt)
		Bodies.face(body,b.root.Position)
	end
end
function Kit.dress(dressers,kit)
	local wear,face,hairCap,spike,headband,rgb,A,R=kit.wear,kit.face,kit.hairCap,kit.spike,kit.headband,kit.rgb,kit.A,kit.R
	local function sandals(model,def,strap)
		local skin=Color3.fromRGB(table.unpack(def.Skin))
		for _,side in {"Left","Right"} do
			local foot=model:FindFirstChild(side.."Foot");if foot then foot.Color=strap end
			wear(model,side.."Foot","Toes",Vector3.new(.7,.16,.34),CFrame.new(0,.1,-.42),skin)
		end
	end
	local function hideCap(model,color)
		local cap=model:FindFirstChild("Hair");if cap then cap.Color=color;cap.Transparency=1 end
	end

	-- Deidara (15): long blond hair in a high half-ponytail, a long fringe over
	-- the left eye with the scope, Iwa's flak vest over dark clothes, clay
	-- pouches at both hips.
	dressers.Deidara=function(model,def)
		local hair=rgb(240,210,110)
		local dark=rgb(60,64,80)
		local vest=rgb(140,120,96)
		hideCap(model,hair)
		face(model,rgb(70,110,170),hair)
		hairCap(model,hair)
		wear(model,"Head","Fringe",Vector3.new(.9,1.1,.24),CFrame.new(-.4,.0,-.76)*A(0,0,R(-6)),hair)
		wear(model,"Head","Topknot",Vector3.new(.5,.5,.5),CFrame.new(0,.8,.5),hair)
		wear(model,"Head","Tail",Vector3.new(.5,1.6,.4),CFrame.new(0,-.2,.9)*A(R(-10),0,0),hair)
		for _,side in {-1,1} do wear(model,"Head","SideHair",Vector3.new(.22,1.6,.9),CFrame.new(side*.84,-.4,.2),hair) end
		wear(model,"Head","Scope",Vector3.new(.3,.3,.3),CFrame.new(.62,.18,-.7),rgb(80,90,96),Enum.Material.Metal)
		headband(model)
		paint(model,TORSO,dark);paint(model,ARMS,dark);paint(model,LEGS,dark)
		wear(model,"UpperTorso","Vest",Vector3.new(2.1,1.6,1.14),CFrame.new(0,-.02,0),vest)
		wear(model,"UpperTorso","Collar",Vector3.new(1.5,.3,1.16),CFrame.new(0,.8,.02),rgb(120,100,80))
		wear(model,"LowerTorso","Belt",Vector3.new(2.06,.22,1.06),CFrame.new(0,.34,0),rgb(40,36,30))
		for _,x in {-1.05,1.05} do wear(model,"LowerTorso","ClayPouch",Vector3.new(.36,.5,.6),CFrame.new(x,.1,0),rgb(160,130,90)) end
		-- The mouth on the right palm (a dark slit).
		wear(model,"RightHand","PalmMouth",Vector3.new(.3,.06,.02),CFrame.new(0,-.1,-.32),rgb(120,40,40))
		sandals(model,def,rgb(40,40,48))
	end

	-- Sasori (14): short, untidy red hair, a calm young face, a long sand-
	-- coloured cloak with a red scarf; the thread spools at his fingers and a
	-- folded puppet on his back.
	dressers.Sasori=function(model,def)
		local hair=rgb(176,60,50)
		local cloak=rgb(170,150,120)
		local shade=rgb(130,112,90)
		hideCap(model,hair)
		face(model,rgb(120,70,50),hair)
		hairCap(model,hair)
		for _,s in {{Vector3.new(-.4,.7,-.4),Vector3.new(-.5,.6,-.8)},{Vector3.new(.4,.7,-.4),Vector3.new(.5,.6,-.8)},{Vector3.new(0,.8,0),Vector3.new(0,1,-.2)},{Vector3.new(0,.6,.6),Vector3.new(0,.4,1)}} do
			spike(model,s[1],s[2],.6,.46,.4,hair)
		end
		paint(model,TORSO,cloak);paint(model,ARMS,cloak);paint(model,LEGS,shade)
		wear(model,"UpperTorso","Cloak",Vector3.new(2.16,1.8,1.2),CFrame.new(0,-.06,0),cloak)
		wear(model,"UpperTorso","Scarf",Vector3.new(1.5,.4,1.2),CFrame.new(0,.8,0),rgb(170,40,40))
		wear(model,"LowerTorso","CloakSkirt",Vector3.new(2.2,1.3,1.22),CFrame.new(0,-.6,0),cloak)
		-- The folded puppet on his back: a wooden torso, limbs folded on it.
		wear(model,"UpperTorso","PuppetBack",Vector3.new(1.4,1.7,.5),CFrame.new(0,0,.86),rgb(150,110,74),Enum.Material.Wood)
		wear(model,"UpperTorso","PuppetHead",Vector3.new(.7,.7,.5),CFrame.new(0,1.1,.86),rgb(150,110,74),Enum.Material.Wood)
		for _,side in {"Left","Right"} do
			wear(model,side.."Hand","ThreadRing",Vector3.new(.5,.12,.5),CFrame.new(0,-.2,0),rgb(140,190,240),Enum.Material.Neon)
		end
		sandals(model,def,rgb(80,60,50))
	end

	-- Nagato (12): red hair falling over one eye, thin, a plain dark long
	-- shirt and light trousers; the Rinnegan's ringed eyes.
	dressers.Nagato=function(model,def)
		local hair=rgb(170,40,40)
		hideCap(model,hair)
		face(model,rgb(186,170,220),hair)
		for _,p in model:GetChildren() do
			if p.Name=="Iris" then p.Material=Enum.Material.Neon;p.Transparency=.3;p.Color=rgb(196,176,236) end
		end
		hairCap(model,hair)
		wear(model,"Head","Fringe",Vector3.new(1.0,1.2,.26),CFrame.new(.3,-.06,-.76)*A(0,0,R(8)),hair)
		for _,side in {-1,1} do wear(model,"Head","SideHair",Vector3.new(.22,1.4,1.0),CFrame.new(side*.84,-.3,.1),hair) end
		wear(model,"Head","BackHair",Vector3.new(1.6,1.3,.3),CFrame.new(0,-.3,.74),hair)
		paint(model,TORSO,rgb(60,60,70));paint(model,ARMS,rgb(60,60,70));paint(model,LEGS,rgb(170,166,156))
		wear(model,"UpperTorso","Shirt",Vector3.new(2.06,1.66,1.1),CFrame.new(0,-.02,0),rgb(60,60,70))
		wear(model,"LowerTorso","ShirtHem",Vector3.new(2.1,.7,1.12),CFrame.new(0,-.3,0),rgb(60,60,70))
		wear(model,"UpperTorso","Collar",Vector3.new(1.3,.26,1.12),CFrame.new(0,.82,0),rgb(48,48,56))
		for _,side in {"Left","Right"} do
			wear(model,side.."LowerArm","Bandage",Vector3.new(.86,.5,.86),CFrame.new(0,-.2,0),rgb(220,216,206))
			wear(model,side.."LowerLeg","Wrap",Vector3.new(.86,.5,.86),CFrame.new(0,-.2,0),rgb(220,216,206))
		end
		sandals(model,def,rgb(60,56,52))
	end

	-- Killer Bee (14): white hair cropped short, dark skin, sunglasses, a
	-- white scarf, Kumo's vest worn open, the tattoo on the cheek, a big build.
	dressers["Killer Bee"]=function(model,def)
		local hair=rgb(236,236,230)
		local vest=rgb(200,192,170)
		hideCap(model,hair)
		face(model,rgb(30,30,30),hair)
		hairCap(model,hair)
		wear(model,"Head","Shades",Vector3.new(1.3,.22,.06),CFrame.new(0,.12,-.85),rgb(20,20,24),Enum.Material.Glass)
		wear(model,"Head","Tattoo",Vector3.new(.06,.3,.3),CFrame.new(-.82,-.1,-.3),rgb(40,30,24))
		wear(model,"Head","Headband",Vector3.new(1.66,.24,1.66),CFrame.new(0,.4,0),rgb(40,40,48))
		wear(model,"Head","HeadbandPlate",Vector3.new(.86,.3,.06),CFrame.new(0,.4,-.85),rgb(176,184,194),Enum.Material.Metal)
		paint(model,TORSO,rgb(70,76,60));paint(model,ARMS,Color3.fromRGB(table.unpack(def.Skin)));paint(model,LEGS,rgb(70,76,60))
		wear(model,"UpperTorso","Vest",Vector3.new(2.2,1.7,1.2),CFrame.new(0,-.02,0),vest)
		wear(model,"UpperTorso","Scarf",Vector3.new(1.6,.4,1.24),CFrame.new(0,.82,0),rgb(240,240,236))
		wear(model,"LowerTorso","Belt",Vector3.new(2.1,.26,1.1),CFrame.new(0,.34,0),rgb(40,36,30))
		for _,side in {"Left","Right"} do
			wear(model,side.."UpperArm","Bulk",Vector3.new(1.1,1.0,1.1),CFrame.new(0,0,0),Color3.fromRGB(table.unpack(def.Skin)))
			wear(model,side.."LowerArm","Band",Vector3.new(.9,.3,.9),CFrame.new(0,-.36,0),rgb(240,240,236))
		end
		sandals(model,def,rgb(40,40,40))
	end
end
return Kit
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND119">
        <Properties>
          <string name="Name">Wave4Kit</string>
          <ProtectedString name="Source">-- DEC-026 newcomers (Madara, Hashirama, Hiruzen as children): the batch's
-- server side. Their techniques run on the shared families (Counter with a
-- real answering strike, Burst arcs, a ground Projectile); this module only
-- dresses them. The weapons in their hands are drawn by Client/Wave4FX.
local Base=require(script.Parent.Wave1Kit)
local paint,ARMS,LEGS,TORSO=Base.paint,Base.ARMS,Base.LEGS,Base.TORSO
local Kit={}
function Kit.install(Techniques) end
function Kit.dress(dressers,kit)
	local wear,face,hairCap,spike,rgb,A,R=kit.wear,kit.face,kit.hairCap,kit.spike,kit.rgb,kit.A,kit.R
	local function sandals(model,def,strap)
		local skin=Color3.fromRGB(table.unpack(def.Skin))
		for _,side in {"Left","Right"} do
			local foot=model:FindFirstChild(side.."Foot");if foot then foot.Color=strap end
			wear(model,side.."Foot","Toes",Vector3.new(.7,.16,.34),CFrame.new(0,.1,-.42),skin)
		end
	end
	local function hideCap(model,color)
		local cap=model:FindFirstChild("Hair");if cap then cap.Color=color;cap.Transparency=1 end
	end

	-- Madara (13): navy tunic with a short collar, dark trousers, short messy
	-- black hair, light arm guards; the short sword's scabbard at the left
	-- hip (the blade itself is in his hand while he strikes, Wave4FX).
	dressers.Madara=function(model,def)
		local hair=rgb(24,24,30)
		local navy=rgb(40,46,84)
		local dark=rgb(30,30,36)
		hideCap(model,hair)
		face(model,rgb(30,30,34),hair)
		hairCap(model,hair)
		for _,s in {{Vector3.new(-.5,.6,-.3),Vector3.new(-.7,.2,-.6)},{Vector3.new(.5,.6,-.3),Vector3.new(.7,.2,-.6)},{Vector3.new(0,.8,-.2),Vector3.new(.2,.5,-.9)},
			{Vector3.new(-.4,.5,.5),Vector3.new(-.8,-.2,.8)},{Vector3.new(.4,.5,.5),Vector3.new(.8,-.2,.8)},{Vector3.new(0,.5,.7),Vector3.new(0,-.4,1)}} do
			spike(model,s[1],s[2],.7,.5,.4,hair)
		end
		paint(model,TORSO,navy);paint(model,ARMS,navy);paint(model,LEGS,dark)
		wear(model,"UpperTorso","Tunic",Vector3.new(2.08,1.62,1.12),CFrame.new(0,-.02,0),navy)
		wear(model,"UpperTorso","Collar",Vector3.new(1.3,.34,1.14),CFrame.new(0,.82,.04),rgb(34,38,70))
		-- The fan crest on the back (a white disc over a red one).
		wear(model,"UpperTorso","CrestRed",Vector3.new(.8,.56,.04),CFrame.new(0,.26,.58),rgb(190,40,40))
		wear(model,"UpperTorso","CrestWhite",Vector3.new(.6,.42,.04),CFrame.new(0,.1,.59),rgb(236,236,236))
		wear(model,"LowerTorso","Belt",Vector3.new(2.04,.22,1.06),CFrame.new(0,.34,0),rgb(90,40,40))
		for _,side in {"Left","Right"} do
			wear(model,side.."LowerArm","ArmGuard",Vector3.new(.66,.8,.66),CFrame.new(0,-.05,0),rgb(70,74,86),Enum.Material.Metal)
		end
		wear(model,"LowerTorso","Scabbard",Vector3.new(.2,.24,2.6),CFrame.new(-1.02,.1,.2)*A(R(28),0,0),rgb(30,26,26))
		wear(model,"LowerTorso","Hilt",Vector3.new(.18,.18,.8),CFrame.new(-1.02,.7,-1.0)*A(R(28),0,0),rgb(60,40,30))
		sandals(model,def,rgb(30,30,36))
	end

	-- Hashirama (13): a brick-brown short-sleeved tunic, dark trousers, black
	-- hair of a young length tied at the nape, bare forearms (the wood
	-- sheathes them when he strikes, Wave4FX).
	dressers.Hashirama=function(model,def)
		local hair=rgb(26,22,20)
		local tunic=rgb(150,74,46)
		local dark=rgb(46,40,36)
		local skin=Color3.fromRGB(table.unpack(def.Skin))
		hideCap(model,hair)
		face(model,rgb(60,40,30),hair)
		hairCap(model,hair)
		wear(model,"Head","Fringe",Vector3.new(1.6,.4,.3),CFrame.new(0,.48,-.78),hair)
		wear(model,"Head","NapeTie",Vector3.new(.4,.4,.4),CFrame.new(0,-.1,.92),hair)
		wear(model,"Head","NapeTail",Vector3.new(.36,1.0,.3),CFrame.new(0,-.7,.9)*A(R(-8),0,0),hair)
		paint(model,TORSO,tunic);paint(model,LEGS,dark)
		paint(model,{"LeftUpperArm","RightUpperArm"},tunic);paint(model,{"LeftLowerArm","RightLowerArm"},skin)
		wear(model,"UpperTorso","Tunic",Vector3.new(2.1,1.64,1.14),CFrame.new(0,-.02,0),tunic)
		wear(model,"UpperTorso","Collar",Vector3.new(1.4,.26,1.16),CFrame.new(0,.82,.02),rgb(120,56,36))
		wear(model,"LowerTorso","Sash",Vector3.new(2.08,.3,1.08),CFrame.new(0,.32,0),rgb(70,96,60))
		for _,side in {"Left","Right"} do
			wear(model,side.."LowerArm","Wrap",Vector3.new(.64,.24,.64),CFrame.new(0,-.36,0),rgb(220,210,190))
		end
		sandals(model,def,rgb(60,46,36))
	end

	-- Hiruzen (13): an earth-ochre tunic, short dark trousers, bandaged
	-- forearms, short brown hair brushed up, a young face; the dark wooden
	-- staff is in his hands (Wave4FX).
	dressers.Hiruzen=function(model,def)
		local hair=rgb(92,64,40)
		local ochre=rgb(176,134,70)
		local dark=rgb(54,48,40)
		hideCap(model,hair)
		face(model,rgb(80,60,40),hair)
		hairCap(model,hair)
		for _,s in {{Vector3.new(-.4,.8,-.3),Vector3.new(-.5,1.3,-.4)},{Vector3.new(0,.9,-.3),Vector3.new(0,1.4,-.4)},{Vector3.new(.4,.8,-.3),Vector3.new(.5,1.3,-.4)},
			{Vector3.new(-.3,.8,.3),Vector3.new(-.4,1.2,.5)},{Vector3.new(.3,.8,.3),Vector3.new(.4,1.2,.5)}} do
			spike(model,s[1],s[2],.45,.42,.36,hair)
		end
		paint(model,TORSO,ochre);paint(model,ARMS,ochre);paint(model,LEGS,dark)
		wear(model,"UpperTorso","Tunic",Vector3.new(2.08,1.62,1.12),CFrame.new(0,-.02,0),ochre)
		wear(model,"UpperTorso","Collar",Vector3.new(1.4,.26,1.14),CFrame.new(0,.82,.02),rgb(140,104,54))
		wear(model,"LowerTorso","Belt",Vector3.new(2.04,.22,1.06),CFrame.new(0,.34,0),rgb(60,46,30))
		wear(model,"LowerTorso","ShurikenPouch",Vector3.new(.5,.4,.4),CFrame.new(.9,.1,.5),rgb(70,60,46))
		for _,side in {"Left","Right"} do
			wear(model,side.."LowerArm","Bandage",Vector3.new(.66,.9,.66),CFrame.new(0,-.04,0),rgb(232,226,210))
		end
		sandals(model,def,rgb(50,42,34))
	end
end
return Kit
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND120">
        <Properties>
          <string name="Name">World</string>
          <ProtectedString name="Source">local World = {}
local Animation=require(script.Parent.Animation)
local Looks=require(script.Parent.Looks)
local LookMeshes=require(script.Parent.LookMeshes)
local ArenaMeshes=require(script.Parent.ArenaMeshes)
local Face=require(game:GetService("ReplicatedStorage").NinjaDuel.Face)
local Appearance=require(game:GetService("ReplicatedStorage").NinjaDuel.Appearance)
local Fighters=require(game:GetService("ReplicatedStorage").NinjaDuel.Fighters)
local function part(parent, name, size, cf, color, material)
	local p = Instance.new("Part")
	p.Name, p.Size, p.CFrame = name, size, cf
	p.Color, p.Material = color, material or Enum.Material.SmoothPlastic
	p.Anchored, p.TopSurface, p.BottomSurface = true, Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end
World.part = part
-- --------------------------------------------------------------- arena
-- The Konoha Chunin Exam finals stadium, as close as the block toolkit allows:
-- a round field of packed earth and grass, bushes along the foot of a very tall
-- circular wall of pale panels (the wall fighters run up), a few big trees on
-- the field, spectator stands crowning the wall under white pavilions with
-- golden roofs, the larger Kage box, the participants' balcony and the gate.
-- Combat contract: flat floor at the origin plane; the wall segments are the
-- NinjaWall surfaces just outside the fighters' round limit.
local function rgb(r,g,b) return Color3.fromRGB(r,g,b) end
local PALETTE={
	grass=rgb(104,136,70),grassDark=rgb(84,116,58),earth=rgb(178,152,110),earthDark=rgb(150,126,92),
	wall=rgb(218,216,196),wallSeam=rgb(178,180,160),wallBand=rgb(196,198,178),
	brick=rgb(152,74,52),brickDark=rgb(118,56,40),plaster=rgb(238,236,226),
	roof=rgb(222,164,58),roofDark=rgb(176,120,38),trim=rgb(70,62,56),wood=rgb(120,84,54),woodDark=rgb(84,58,38),
	leaf=rgb(70,112,58),leafDark=rgb(52,90,48),bark=rgb(96,70,50),
}
-- The Chunin Exam finals stadium at a believable scale for 12-year-olds: about
-- 58 body heights across (the anime's proportions), walls about 15 tall. A
-- long open floor for range, pursuit and blades; the wall is a destination,
-- not the edge of every exchange (convergence 2 addendum, DEC-015).
World.WALL_RADIUS=145
local function deco(parent,name,size,cf,color,material,shape)
	local p=part(parent,name,size,cf,color,material)
	p.CanCollide=false;p.CanQuery=false;p.CanTouch=false
	if shape then p.Shape=shape end
	return p
end
-- A flat disc lying on the floor (cylinder axis pointing up).
local function disc(parent,name,radius,y,center,color,material)
	local p=deco(parent,name,Vector3.new(.06,radius*2,radius*2),CFrame.new(center+Vector3.new(0,y,0))*CFrame.Angles(0,0,math.pi/2),color,material,Enum.PartType.Cylinder)
	-- The ground the eye sees (a flat skin over the floor, out of queries):
	-- broken ground takes its material and colour (WorldReaction.skinAt).
	pcall(function() game:GetService("CollectionService"):AddTag(p,"NinjaGroundSkin") end)
	return p
end
local function label(target,face,text,color,font)
	local gui=Instance.new("SurfaceGui");gui.Face=face;gui.CanvasSize=Vector2.new(400,400);gui.LightInfluence=1;gui.Parent=target
	local t=Instance.new("TextLabel");t.Size=UDim2.fromScale(1,1);t.BackgroundTransparency=1;t.Text=text;t.TextColor3=color
	t.Font=font or Enum.Font.GothamBlack;t.TextScaled=true;t.Parent=gui
	return gui
end
local function spectator(folder,at,facing,seed,still)
	local parent=Instance.new("Model");parent.Name=if still then "Spectator" else "SpectatorFigure";parent.Parent=folder
	local tones={rgb(70,96,74),rgb(70,86,120),rgb(120,70,62),rgb(140,120,90),rgb(96,80,110),rgb(60,64,72),rgb(150,140,128),rgb(86,104,76)}
	local skin={rgb(232,198,166),rgb(204,166,136),rgb(176,134,104)}
	local body=deco(parent,"Spectator",Vector3.new(1.3,2.0,.9),CFrame.lookAt(at+Vector3.new(0,1.0,0),at+Vector3.new(0,1.0,0)+facing),tones[seed%#tones+1],Enum.Material.SmoothPlastic)
	body.CastShadow=false
	local head=deco(parent,"SpectatorHead",Vector3.new(.95,.95,.95),body.CFrame*CFrame.new(0,1.45,0),skin[seed%#skin+1],Enum.Material.SmoothPlastic,Enum.PartType.Ball)
	head.CastShadow=false
	if still then return end
	deco(parent,"SpectatorHair",Vector3.new(1.0,.45,1.0),head.CFrame*CFrame.new(0,.28,.05),if seed%4==0 then rgb(220,190,120) else rgb(36,30,28),Enum.Material.SmoothPlastic).CastShadow=false
end
local function tree(parent,at,height,spread,meshes)
	-- Field trees: a real trunk (cover and line of sight) under a loose crown.
	local trunk=part(parent,"Field tree",Vector3.new(2.6,height,2.6),CFrame.new(at+Vector3.new(0,height/2,0)),PALETTE.bark,Enum.Material.Wood)
	trunk.Shape=Enum.PartType.Block
	-- (EMB-004) The trunk carries its crown and branches (they fall with it)
	-- and may break.
	trunk:SetAttribute("WorldBreakable",true)
	parent=trunk
	if meshes then
		-- The Blender crown (stage 5), carried by the trunk like the balls.
		ArenaMeshes.place(trunk,"Crown",CFrame.new(at+Vector3.new(0,height+spread*.3,0))*CFrame.Angles(0,(at.X*.13+at.Z*.07)%6.28,0),spread/10)
		return trunk
	end
	local crown=deco(parent,"Crown",Vector3.new(spread*2,spread*1.4,spread*2),CFrame.new(at+Vector3.new(0,height+spread*.3,0)),PALETTE.leaf,Enum.Material.Grass,Enum.PartType.Ball)
	crown.Size=Vector3.one*spread*1.9
	for k=0,4 do
		local a=k/5*math.pi*2
		deco(parent,"Crown",Vector3.one*spread*(1.1+(k%2)*.25),CFrame.new(at+Vector3.new(math.sin(a)*spread*.75,height-spread*.1+(k%3)*.8,math.cos(a)*spread*.75)),
			if k%2==0 then PALETTE.leafDark else PALETTE.leaf,Enum.Material.Grass,Enum.PartType.Ball)
	end
	for k=0,2 do
		local a=k/3*math.pi*2+.4
		deco(parent,"Branch",Vector3.new(.9,spread*1.1,.9),CFrame.new(at+Vector3.new(0,height*.72,0))*CFrame.Angles(0,a,math.rad(48))*CFrame.new(0,spread*.5,0),PALETTE.bark,Enum.Material.Wood)
	end
	return trunk
end
-- A white pavilion with a golden curved roof sitting on the stands.
local function pavilion(parent,cf,width,depth,height,tiers)
	deco(parent,"Pavilion",Vector3.new(width,height,depth),cf*CFrame.new(0,height/2,0),PALETTE.plaster,Enum.Material.SmoothPlastic)
	for k=-math.floor(width/6),math.floor(width/6) do
		deco(parent,"Window",Vector3.new(2.6,height*.38,.2),cf*CFrame.new(k*5.2,height*.58,-depth/2-.05),PALETTE.trim,Enum.Material.SmoothPlastic)
	end
	deco(parent,"Base trim",Vector3.new(width+.4,.8,depth+.4),cf*CFrame.new(0,.4,0),PALETTE.trim,Enum.Material.Wood)
	local y=height
	for tier=1,tiers do
		local w=width+6-tier*3;local d=depth+6-tier*3
		local pitch=math.rad(24)
		for _,side in {-1,1} do
			deco(parent,"Roof",Vector3.new(w,.9,d/2+1),cf*CFrame.new(0,y+1.1,side*(d/4))*CFrame.Angles(side*-pitch,0,0),PALETTE.roof,Enum.Material.SmoothPlastic)
			-- Up-turned eaves at the four corners.
			for _,ex in {-1,1} do
				deco(parent,"Eave",Vector3.new(2.2,.7,2.2),cf*CFrame.new(ex*(w/2-.6),y+.4,side*(d/2+.4))*CFrame.Angles(side*math.rad(-20),0,ex*math.rad(18)),PALETTE.roofDark,Enum.Material.SmoothPlastic)
			end
		end
		deco(parent,"Ridge",Vector3.new(w+.6,.7,.9),cf*CFrame.new(0,y+1.1+math.tan(pitch)*(d/4)+.6,0),PALETTE.roofDark,Enum.Material.SmoothPlastic)
		if tier&lt;tiers then
			deco(parent,"Upper storey",Vector3.new(w-6,4,d-6),cf*CFrame.new(0,y+3.6,0),PALETTE.plaster,Enum.Material.SmoothPlastic)
			y+=4.6
		end
	end
end
local function atmosphere()
	local Lighting=game:GetService("Lighting")
	if Lighting:FindFirstChild("NinjaDuelAtmosphere") then return end
	-- Bright exam-day afternoon, as in the anime: clear sky, warm sun, soft haze.
	Lighting.ClockTime=14.6;Lighting.GeographicLatitude=30
	Lighting.Brightness=3;Lighting.EnvironmentDiffuseScale=.7;Lighting.EnvironmentSpecularScale=.3
	Lighting.Ambient=rgb(104,104,104);Lighting.OutdoorAmbient=rgb(150,146,138)
	pcall(function() Lighting.Technology=Enum.Technology.Future end)
	pcall(function() Lighting.LightingStyle=Enum.LightingStyle.Realistic end)
	local atmo=Instance.new("Atmosphere");atmo.Name="NinjaDuelAtmosphere";atmo.Density=.26;atmo.Offset=.1
	atmo.Color=rgb(214,222,226);atmo.Decay=rgb(140,150,160);atmo.Glare=.2;atmo.Haze=.9;atmo.Parent=Lighting
	local cc=Instance.new("ColorCorrectionEffect");cc.Name="NinjaDuelGrade";cc.Saturation=.14;cc.Contrast=.06;cc.Brightness=.02;cc.TintColor=rgb(255,250,242);cc.Parent=Lighting
	local bloom=Instance.new("BloomEffect");bloom.Name="NinjaDuelBloom";bloom.Intensity=.45;bloom.Size=24;bloom.Threshold=1.5;bloom.Parent=Lighting
	local rays=Instance.new("SunRaysEffect");rays.Name="NinjaDuelRays";rays.Intensity=.04;rays.Spread=.6;rays.Parent=Lighting
end
World.atmosphere=atmosphere
-- --------------------------------------------- the stadium, Blender pass 2
-- (User 29/10 17:01-17:03, with reference pictures.) Inside, one tall smooth
-- wall of pale concrete panels; outside, the red domed bowl; the spectators
-- only in the buildings on the north rim; a sandy field with grass patches
-- and tufts, bushes and trees along the wall, the middle open (no posts,
-- crates, rocks or lanterns). Gameplay parts are the same as the part-built
-- stadium: the floor, the wall-run panels and their invisible cap, the
-- participants' balcony, the field trees' trunks (cover, breakable).
local WING_W,WING_TIERS=50,4
local function wingSeats()
	local out={}
	for i=0,WING_TIERS-1 do
		local y=2+(i+1)*1.25
		local z=-8.4+i*2.9+1.0
		local x=-WING_W/2+2
		while x&lt;=WING_W/2-2 do table.insert(out,Vector3.new(x,y,z));x+=2.3 end
	end
	return out
end
local function dressedArena(folder,decor,origin)
	local R=World.WALL_RADIUS
	local wallH,height=40,76
	local top=wallH+1.2
	local function asset(name,cf,scale) return ArenaMeshes.place(decor,name,cf,scale) end
	local rand=Random.new(29)
	-- Light packed earth (user 29/10 17:36-17:45: less sand, a bit more earth,
	-- light like the references, no layered patches), round so it stops under
	-- the bowl (Server/WorldReaction reads its material for broken ground).
	local floor=part(folder,"Training floor",Vector3.new(2,2*(R+28),2*(R+28)),CFrame.new(origin-Vector3.new(0,1,0))*CFrame.Angles(0,0,math.pi/2),rgb(184,158,114),Enum.Material.SmoothPlastic)
	floor.Shape=Enum.PartType.Cylinder
	-- (06/11) The floor became SmoothPlastic for its look (29/10) and
	-- WorldReaction stopped reading it as earth: from then on the arena kept
	-- no mark at all (impacts=0 in Studio). It declares its class.
	floor:SetAttribute("WorldMaterial","earth")
	-- Its grain: the earth texture at half strength over the light colour
	-- (17:42-17:45: "un mix" of the flat light ground and the textured one).
	local grain=part(decor,"Floor grain",floor.Size,floor.CFrame+Vector3.new(0,.012,0),rgb(196,172,128),Enum.Material.Ground)
	grain.Shape=Enum.PartType.Cylinder;grain.Transparency=.5
	grain.CanCollide=false;grain.CanQuery=false;grain.CanTouch=false;grain.CastShadow=false
	part(decor,"Village ground",Vector3.new(1700,2,1700),CFrame.new(origin-Vector3.new(0,1.3,0)),rgb(84,120,62),Enum.Material.Grass).CanCollide=false
	-- The wall-run panels and the cap above them (invisible: the meshes show).
	local segments=116
	local width=2*math.pi*(R+1)/segments+.3
	for k=0,segments-1 do
		local a=k/segments*math.pi*2
		local dir=Vector3.new(math.sin(a),0,math.cos(a))
		local at=origin+dir*(R+1)+Vector3.new(0,wallH/2,0)
		local look=CFrame.lookAt(at,origin+Vector3.new(0,wallH/2,0))
		local w=part(folder,"Boundary",Vector3.new(width,wallH,2),look,PALETTE.wall,Enum.Material.Concrete)
		w:SetAttribute("NinjaWall",true);w.Transparency=1;w.CastShadow=false
		local cap=part(folder,"Boundary cap",Vector3.new(width,height-wallH,2),look*CFrame.new(0,height/2,0),PALETTE.wall,Enum.Material.SmoothPlastic)
		cap.Transparency=1;cap.CanQuery=false;cap.CanTouch=false;cap.CastShadow=false
	end
	for k=0,7 do
		local slice=CFrame.new(origin)*CFrame.Angles(0,k*math.pi/4,0)
		asset("WallSector",slice);asset("ShellSector",slice)
	end
	-- North rim: the hall (its gallery is World's Kage box) and four wings.
	-- The hall is the tallest and widest building (scale HS): its base sits on
	-- the rim with its face on the wall, its gallery out over the field.
	local HS=1.35
	local kage=origin+Vector3.new(0,wallH+16*HS,-(R-.5+11*HS))
	local kageCF=CFrame.lookAt(kage,Vector3.new(origin.X,kage.Y,origin.Z))
	asset("Hall",kageCF,HS)
	for _,x in {-4,4} do spectator(decor,(kageCF*CFrame.new(x*HS,.8*HS,-10*HS)).Position,(origin-kage)*Vector3.new(1,0,1),if x&lt;0 then 5 else 2) end
	local seed=0
	for _,w in {{.34,1},{.7,.8}} do
		for _,sg in {-1,1} do
			local az=math.pi+sg*w[1]
			local at=origin+Vector3.new(math.sin(az)*(R+9),top,math.cos(az)*(R+9))
			local cf=CFrame.lookAt(at,Vector3.new(origin.X,at.Y,origin.Z))
			asset("Wing",cf,w[2])
			for _,seat in wingSeats() do
				seed+=1
				if seed%4~=0 then
					local p=cf*CFrame.new(seat*w[2]+Vector3.new(((seed*37)%3-1)*.2,0,0))
					spectator(decor,p.Position-Vector3.new(0,.15,0),(origin-p.Position)*Vector3.new(1,0,1),seed,seed%3==0)
				end
			end
		end
	end
	-- Participants' balcony on the east wall (a real ledge), in the wall's tones.
	local east=CFrame.lookAt(origin+Vector3.new(R-4,24,0),origin+Vector3.new(0,24,0))
	part(folder,"Participants balcony",Vector3.new(26,1.2,8),east,rgb(110,78,54),Enum.Material.Wood)
	deco(decor,"Balcony rail",Vector3.new(26,1.6,.3),east*CFrame.new(0,1.4,-3.9),rgb(110,78,54),Enum.Material.Wood)
	for _,x in {-12,-4,4,12} do deco(decor,"Balcony bracket",Vector3.new(.8,3,.8),east*CFrame.new(x,-2,1.5)*CFrame.Angles(math.rad(35),0,0),rgb(80,56,40),Enum.Material.Wood) end
	deco(decor,"Balcony opening",Vector3.new(16,9,.2),east*CFrame.new(0,5,3.95),rgb(34,32,30),Enum.Material.SmoothPlastic)
	for _,x in {-13.4,13.4} do deco(decor,"Balcony side",Vector3.new(.8,11,8.4),east*CFrame.new(x,5.4,0),rgb(204,206,196),Enum.Material.Concrete) end
	deco(decor,"Balcony awning",Vector3.new(28.4,.8,9.4),east*CFrame.new(0,11.2,-.4)*CFrame.Angles(math.rad(-10),0,0),rgb(212,156,62),Enum.Material.SmoothPlastic)
	for k=-3,3 do spectator(decor,(east*CFrame.new(k*2,.5,.2)).Position,-east.LookVector*-1,k+20) end
	-- The competitors' doorways (south and west).
	asset("Gate",CFrame.lookAt(origin+Vector3.new(0,8,R-.4),origin+Vector3.new(0,8,0)))
	asset("Gate",CFrame.lookAt(origin+Vector3.new(-(R-.4),8,0),origin+Vector3.new(0,8,0)))
	-- Bushes along the foot of the wall.
	for k=0,47 do
		local a=k/48*math.pi*2+rand:NextNumber(-.04,.04)
		if math.abs(a-math.pi/2)&gt;.12 then
			asset("Bush",CFrame.new(origin+Vector3.new(math.sin(a)*(R-4.5),0,math.cos(a)*(R-4.5)))*CFrame.Angles(0,a*7,0),1+(k%3)*.2)
		end
	end
	-- Field trees: an invisible trunk part (cover, line of sight, breakable;
	-- the mesh is its child and falls with it), the whole tree in Blender.
	for _,spot in {{.55,112,.9},{1.6,104,.8},{2.4,110,.85},{3.3,98,.75},{3.9,116,.95},{5.3,106,.85},{6.0,92,.75}} do
		local at=origin+Vector3.new(math.sin(spot[1])*spot[2],0,math.cos(spot[1])*spot[2])
		local h=15*spot[3]
		local trunk=part(folder,"Field tree",Vector3.new(2.2*spot[3],h,2.2*spot[3]),CFrame.new(at+Vector3.new(0,h/2,0)),PALETTE.bark,Enum.Material.Wood)
		trunk.Transparency=1;trunk.CastShadow=false
		trunk:SetAttribute("WorldBreakable",true)
		ArenaMeshes.place(trunk,"Tree",CFrame.new(at)*CFrame.Angles(0,spot[1]*3,0),spot[3])
	end
	-- The forest round the stadium, seen over the rim.
	for k=0,69 do
		local a=k/70*math.pi*2+rand:NextNumber(-.03,.03)
		local r=R+40+rand:NextNumber(0,60)
		asset("Tree",CFrame.new(origin+Vector3.new(math.sin(a)*r,0,math.cos(a)*r))*CFrame.Angles(0,a*5,0),rand:NextNumber(1.4,2.1))
	end
	-- Grass on the earth: patches and tufts, thicker toward the wall.
	for k=0,39 do
		local a=rand:NextNumber(0,math.pi*2);local r=55+(R-65)*math.sqrt(rand:NextNumber())
		asset(({"GrassA","GrassB","GrassC"})[k%3+1],CFrame.new(origin+Vector3.new(math.sin(a)*r,.02,math.cos(a)*r))*CFrame.Angles(0,a,0),rand:NextNumber(.8,1.4))
	end
	for k=0,69 do
		local a=rand:NextNumber(0,math.pi*2);local r=45+(R-53)*math.sqrt(rand:NextNumber())
		asset("Tufts",CFrame.new(origin+Vector3.new(math.sin(a)*r,0,math.cos(a)*r))*CFrame.Angles(0,a,0),rand:NextNumber(.8,1.3))
	end
	atmosphere()
	return folder
end
function World.arena(parent, origin)
	local folder = Instance.new("Folder"); folder.Name = "Courtyard"; folder.Parent = parent
	local decor=Instance.new("Folder");decor.Name="Decor";decor.Parent=folder
	local C=PALETTE
	local R=World.WALL_RADIUS
	local height=76
	-- Stage 5: the Blender scenery (Server/ArenaMeshes) replaces the part-built
	-- decor when its meshes are loaded; the gameplay parts are the same.
	local M=ArenaMeshes.ready()
	local function asset(name,cf,scale) return ArenaMeshes.place(decor,name,cf,scale) end
	if M and ArenaMeshes.Data.Hall then return dressedArena(folder,decor,origin) end
	-- Field: grass with a broad packed-earth centre and worn patches.
	part(folder,"Training floor",Vector3.new(460,2,460),CFrame.new(origin-Vector3.new(0,1,0)),C.grass,Enum.Material.Grass)
	disc(decor,"Earth",92,.03,origin,C.earth,Enum.Material.Ground)
	for k=0,17 do
		local a=k/18*math.pi*2+.3
		local r=68+((k*37)%5)*7
		disc(decor,"Earth patch",18+((k*53)%4)*5,.035,origin+Vector3.new(math.sin(a)*r,0,math.cos(a)*r),if k%3==0 then C.earthDark else C.earth,Enum.Material.Ground)
	end
	-- Worn grass islands: clusters of overlapping small patches, never one
	-- perfect circle, so the field reads as trampled ground.
	for k=0,15 do
		local a=k/16*math.pi*2+1.1
		local r=30+((k*29)%4)*12
		local center=origin+Vector3.new(math.sin(a)*r,0,math.cos(a)*r)
		for j=0,4 do
			local b=j*1.7+k
			local offset=Vector3.new(math.sin(b)*(2+j*1.3),0,math.cos(b)*(1.5+j))
			disc(decor,"Grass tuft",1.6+((j*13+k)%4)*.9,.045,center+offset,if j%2==0 then C.grassDark else C.grass,Enum.Material.Grass)
		end
	end
	-- The field wall: 40 tall (about eight body heights, a long wall run), on a
	-- dark stone base course, with pilasters and a cornice; the stands rise
	-- behind and above it like the finals stadium's bowl. Each panel is a
	-- wall-run surface; an invisible cap keeps bodies inside up to the old 76.
	local wallH=40
	local segments=116
	local width=2*math.pi*(R+1)/segments+.3
	for k=0,segments-1 do
		local a=k/segments*math.pi*2
		local dir=Vector3.new(math.sin(a),0,math.cos(a))
		local at=origin+dir*(R+1)+Vector3.new(0,wallH/2,0)
		local look=CFrame.lookAt(at,origin+Vector3.new(0,wallH/2,0))
		local w=part(folder,"Boundary",Vector3.new(width,wallH,2),look,C.wall,Enum.Material.Concrete)
		w:SetAttribute("NinjaWall",true)
		local cap=part(folder,"Boundary cap",Vector3.new(width,height-wallH,2),look*CFrame.new(0,(height)/2,0),C.wall,Enum.Material.SmoothPlastic)
		cap.Transparency=1;cap.CanQuery=false;cap.CanTouch=false;cap.CastShadow=false
		if M then continue end
		deco(decor,"Seam",Vector3.new(.25,wallH-4,.1),look*CFrame.new(width/2,2,-1.02),C.wallSeam,Enum.Material.Concrete)
		deco(decor,"Band",Vector3.new(width,.9,.12),look*CFrame.new(0,wallH/2-12,-1.03),C.wallBand,Enum.Material.Concrete)
		deco(decor,"Base course",Vector3.new(width,4,.7),look*CFrame.new(0,-wallH/2+2,-1.3),rgb(120,116,104),Enum.Material.Slate)
		deco(decor,"Cornice",Vector3.new(width,1.4,1.4),look*CFrame.new(0,wallH/2-.4,-1.6),C.wallSeam,Enum.Material.Concrete)
		if k%4==0 then deco(decor,"Pilaster",Vector3.new(2.2,wallH-4,.9),look*CFrame.new(0,2,-1.4),C.wallBand,Enum.Material.Concrete) end
		deco(decor,"Outer face",Vector3.new(width,wallH,.6),look*CFrame.new(0,0,1.3),C.brick,Enum.Material.Brick)
		deco(decor,"Parapet",Vector3.new(width,1.6,1),look*CFrame.new(0,wallH/2+.8,-.2),C.brickDark,Enum.Material.Brick)
	end
	if M then
		for k=0,7 do
			local slice=CFrame.new(origin)*CFrame.Angles(0,k*math.pi/4,0)
			asset("WallSector",slice);asset("StandSector",slice)
		end
	end
	-- Tournament banners hang from the cornice between the pilasters.
	for k=0,21 do
		local a=k/22*math.pi*2+math.pi/22
		local dir=Vector3.new(math.sin(a),0,math.cos(a))
		local at=origin+dir*(R-(if M then 1.75 else .35))+Vector3.new(0,wallH-9.5,0)
		local look=CFrame.lookAt(at,origin+Vector3.new(0,wallH-9.5,0))
		local cloth=deco(decor,"Wall banner",Vector3.new(5.6,15,.12),look,if k%2==0 then rgb(170,40,36) else rgb(232,226,210),Enum.Material.SmoothPlastic)
		deco(decor,"Banner rod",Vector3.new(6.4,.35,.35),look*CFrame.new(0,7.6,0),rgb(70,52,36),Enum.Material.Wood)
		local gui=label(cloth,Enum.NormalId.Front,if k%3==0 then "火" elseif k%3==1 then "忍" else "試",if k%2==0 then rgb(232,226,210) else rgb(170,40,36))
		-- Match the cloth's proportions so the character is not squashed.
		gui.CanvasSize=Vector2.new(220,590)
	end
	-- Bushes along the foot of the wall.
	if M then
		for k=0,65 do
			local a=k/66*math.pi*2
			asset("Bush",CFrame.new(origin+Vector3.new(math.sin(a)*(R-2.4),1.2,math.cos(a)*(R-2.4)))*CFrame.Angles(0,a*5,0),1+(k%3)*.2)
		end
	end
	for k=0,(if M then -1 else 131) do
		local a=k/132*math.pi*2+((k*17)%5)*.01
		local r=R-1.6-((k*29)%3)*.6
		local size=3.4+((k*41)%4)*.7
		deco(decor,"Bush",Vector3.one*size,CFrame.new(origin+Vector3.new(math.sin(a)*r,size*.32,math.cos(a)*r)),if k%3==0 then C.leafDark else C.leaf,Enum.Material.Grass,Enum.PartType.Ball)
	end
	-- The bowl: seven stepped rings of seats rising back from the parapet, cut
	-- by stone aisles, full of spectators (the front rings cheer: FX:crowdOf).
	local seed=0
	local tiers=7
	local rise,depth=2.9,3.6
	local function isAisle(a)
		-- The Blender stands have two stairways per 45-degree slice.
		if M then local u=(a/(math.pi*2)*16-.5)%1 return u&lt;.035 or u&gt;.965 end
		return (a*12/(math.pi*2))%1&lt;.045
	end
	for tier=1,tiers do
		local radius=R+2.6+tier*depth
		local floorY=wallH+tier*rise
		local steps=math.floor(radius*2*math.pi/8)
		for k=0,steps-1 do
			local a=k/steps*math.pi*2
			local at=origin+Vector3.new(math.sin(a)*radius,floorY,math.cos(a)*radius)
			local look=CFrame.lookAt(at,Vector3.new(origin.X,at.Y,origin.Z))
			local aisle=isAisle(a)
			if not M then deco(decor,"Stand",Vector3.new(radius*2*math.pi/steps+.3,rise+.4,depth+.2),look*CFrame.new(0,-(rise+.4)/2,0),if aisle then C.wallBand elseif tier%2==0 then C.wood else C.woodDark,if aisle then Enum.Material.Concrete else Enum.Material.Wood) end
			if not aisle then
				for _,x in (if tier&lt;=3 then {-2,2} else {0}) do
					seed+=1
					if seed%5~=0 then
						local seat=look*CFrame.new(x+((seed*37)%3-1)*.25,0,.3)
						spectator(decor,seat.Position,(origin-seat.Position)*Vector3.new(1,0,1),seed,tier&gt;3)
					end
				end
			end
		end
	end
	local backR=R+2.6+(tiers+1)*depth
	local backTop=wallH+tiers*rise+6
	-- The back wall of the bowl, with roofed sections over the upper rings.
	local backSegments=96
	for k=0,(if M then -1 else backSegments-1) do
		local a=k/backSegments*math.pi*2
		local at=origin+Vector3.new(math.sin(a)*backR,(wallH+backTop)/2,math.cos(a)*backR)
		local look=CFrame.lookAt(at,Vector3.new(origin.X,at.Y,origin.Z))
		deco(decor,"Stand back",Vector3.new(2*math.pi*backR/backSegments+.3,backTop-wallH,1.4),look,C.brick,Enum.Material.Brick)
		if k%8&lt;4 then
			-- An awning over the top rings, on posts, tilted toward the field.
			local roof=look*CFrame.new(0,(backTop-wallH)/2+.6,-7)*CFrame.Angles(math.rad(-14),0,0)
			deco(decor,"Stand roof",Vector3.new(2*math.pi*backR/backSegments+.4,.6,15),roof,rgb(96,74,62),Enum.Material.Slate)
			if k%2==0 then deco(decor,"Roof post",Vector3.new(.6,8,.6),look*CFrame.new(0,(backTop-wallH)/2-3.4,-13.4),C.trim,Enum.Material.Wood) end
		end
	end
	-- Pavilions on the rim of the bowl.
	for k=0,11 do
		local a=k/12*math.pi*2+math.pi/12
		if math.abs(math.sin(a/2))&gt;.18 then -- (the Kage box takes the north)
			local at=origin+Vector3.new(math.sin(a)*(backR+5),backTop-.5,math.cos(a)*(backR+5))
			local cf=CFrame.lookAt(at,Vector3.new(origin.X,at.Y,origin.Z))
			if M then asset("Pavilion",cf) else pavilion(decor,cf,18,10,8,1) end
		end
	end
	-- The Kage box (north): a two-storey pavilion built out over the upper rings,
	-- its balcony above the field with the two Kage watching.
	local kage=origin+Vector3.new(0,wallH+16,-(R+12))
	local kageCF=CFrame.lookAt(kage,Vector3.new(origin.X,kage.Y,origin.Z))
	if M then
		asset("KageBox",kageCF)
	else
		deco(decor,"Kage base",Vector3.new(30,16,22),kageCF*CFrame.new(0,-8,4),C.brick,Enum.Material.Brick)
		pavilion(decor,kageCF,34,16,11,2)
		deco(decor,"Kage box",Vector3.new(16,1,6),kageCF*CFrame.new(0,.5,-10.5),C.trim,Enum.Material.Wood)
		deco(decor,"Kage rail",Vector3.new(16,1.6,.3),kageCF*CFrame.new(0,1.8,-13.4),C.wood,Enum.Material.Wood)
	end
	for _,x in {-4,4} do spectator(decor,(kageCF*CFrame.new(x,1,-11)).Position,(origin-kage)*Vector3.new(1,0,1),if x&lt;0 then 5 else 2) end
	local plaque=deco(decor,"Kage plaque",Vector3.new(4,4,.3),kageCF*CFrame.new(0,8.5,-8.2),C.plaster,Enum.Material.SmoothPlastic)
	label(plaque,Enum.NormalId.Front,"火",rgb(190,40,36))
	-- Participants' balcony on the east wall: a real ledge (elevation and a
	-- vertical route: run up the wall beside it and step on, or drop from it
	-- into a dive), set in a roofed alcove with the corridor behind it.
	local east=CFrame.lookAt(origin+Vector3.new(R-4,24,0),origin+Vector3.new(0,24,0))
	part(folder,"Participants balcony",Vector3.new(26,1.2,8),east,C.woodDark,Enum.Material.Wood)
	deco(decor,"Balcony rail",Vector3.new(26,1.6,.3),east*CFrame.new(0,1.4,-3.9),C.wood,Enum.Material.Wood)
	for _,x in {-12,-4,4,12} do deco(decor,"Balcony bracket",Vector3.new(.8,3,.8),east*CFrame.new(x,-2,1.5)*CFrame.Angles(math.rad(35),0,0),C.trim,Enum.Material.Wood) end
	deco(decor,"Balcony corridor",Vector3.new(10,8,.2),east*CFrame.new(0,4.6,3.95),rgb(34,30,28),Enum.Material.SmoothPlastic)
	for _,x in {-13.4,13.4} do deco(decor,"Balcony side",Vector3.new(.8,11,8.4),east*CFrame.new(x,5.4,0),if M then rgb(168,46,38) else C.wallBand,Enum.Material.Concrete) end
	deco(decor,"Balcony awning",Vector3.new(28.4,.8,9.4),east*CFrame.new(0,11.2,-.4)*CFrame.Angles(math.rad(-10),0,0),if M then rgb(60,70,82) else C.roofDark,Enum.Material.SmoothPlastic)
	for k=-3,3 do spectator(decor,(east*CFrame.new(k*2,.5,.2)).Position,-east.LookVector*-1,k+20) end
	-- The competitors' gates (south and west): heavy wooden doors in a stone frame.
	local function gate(cf)
		deco(decor,"Gate",Vector3.new(18,16,.2),cf*CFrame.new(0,0,.15),rgb(30,28,26),Enum.Material.SmoothPlastic)
		for _,x in {-4.4,4.4} do
			local door=cf*CFrame.new(x,-.2,-.1)
			deco(decor,"Gate door",Vector3.new(8.4,15.4,.5),door,rgb(104,72,46),Enum.Material.WoodPlanks)
			for _,y in {-5,0,5} do deco(decor,"Gate band",Vector3.new(8.4,.4,.08),door*CFrame.new(0,y,-.29),rgb(52,50,50),Enum.Material.Metal) end
			deco(decor,"Gate ring",Vector3.new(.7,.7,.1),door*CFrame.new(if x&lt;0 then 3.4 else -3.4,0,-.33),rgb(150,120,60),Enum.Material.Metal,Enum.PartType.Cylinder)
		end
		deco(decor,"Gate lintel",Vector3.new(22,2.4,1.6),cf*CFrame.new(0,8.8,-.6),rgb(120,116,104),Enum.Material.Slate)
		for _,x in {-10.4,10.4} do deco(decor,"Gate post",Vector3.new(2.2,17,1.6),cf*CFrame.new(x,.4,-.6),rgb(120,116,104),Enum.Material.Slate) end
	end
	if M then
		asset("Gate",CFrame.lookAt(origin+Vector3.new(0,8,R-.4),origin+Vector3.new(0,8,0)))
		asset("Gate",CFrame.lookAt(origin+Vector3.new(-(R-.4),8,0),origin+Vector3.new(0,8,0)))
		-- The drum tower over the south gate, seen above the stands.
		asset("GateTower",CFrame.lookAt(origin+Vector3.new(0,0,backR+22),origin),1.6)
	else
		gate(CFrame.lookAt(origin+Vector3.new(0,8,R-.05),origin+Vector3.new(0,8,0)))
		gate(CFrame.lookAt(origin+Vector3.new(-(R-.05),8,0),origin+Vector3.new(0,8,0)))
	end
	-- The ground outside the stadium, so it never floats in the sky.
	part(decor,"Village ground",Vector3.new(1700,2,1700),CFrame.new(origin-Vector3.new(0,1.3,0)),C.grassDark,Enum.Material.Grass).CanCollide=false
	-- Field trees: line of sight and something to fight around, as in the finals.
	for _,spot in {{.55,112,38,10},{1.6,104,33,9},{2.4,110,36,9.5},{3.3,98,31,8.5},{3.9,116,40,10.5},{5.3,106,35,9.5},{6.0,92,29,8}} do
		tree(folder,origin+Vector3.new(math.sin(spot[1])*spot[2],0,math.cos(spot[1])*spot[2]),spot[3],spot[4],M)
	end
	-- Weathered boulders for low cover (they stop blades and fire), in a ring
	-- around the open middle (a clear centre to fight in; cover, trunks and the
	-- wall at its edge to drive a body into or break).
	for _,spot in {{1.5,78,1.1},{4.6,74,1.1},{.2,84,1.4},{2.9,80,1.3},{5.7,82,1.3}} do
		local at=origin+Vector3.new(math.sin(spot[1])*spot[2],2*spot[3],math.cos(spot[1])*spot[2])
		local k=spot[3]
		local cover=part(folder,"Cover",Vector3.new(7,4,4)*k,CFrame.new(at)*CFrame.Angles(0,spot[1],0),rgb(128,124,114),Enum.Material.Slate)
		-- (EMB-004) A boulder may shatter; its cap and chip go with it.
		cover:SetAttribute("WorldBreakable",true)
		deco(cover,"Rock cap",Vector3.new(5,2.6,3.4)*k,CFrame.new(at+Vector3.new(-.5,2.2,0)*k)*CFrame.Angles(0,spot[1]+.3,math.rad(8)),rgb(140,136,124),Enum.Material.Slate)
		deco(cover,"Rock chip",Vector3.new(2.2,1.4,1.8)*k,CFrame.new(at+Vector3.new(3.6,-1.3,1.6)*k)*CFrame.Angles(0,spot[1]*2,math.rad(14)),rgb(118,114,106),Enum.Material.Slate)
	end
	-- (User 28/10: "still no destruction of objects".) The trees and boulders
	-- stand 75-115 studs out, where a duel rarely goes. In the fighting zone
	-- (25-55 studs) there are now things to break: the three wooden training
	-- posts of Team 7's test, crates of the exam's supplies and stone lanterns.
	-- They are cover, they stop a thrown body, and a heavy blow, a fireball or a
	-- body driven into them breaks them (WorldReaction: integrity scales with
	-- their thickness, so they go far sooner than a trunk).
	local function breakable(name,size,cf,color,material,integrity)
		local p=part(folder,name,size,cf,color,material)
		p:SetAttribute("WorldBreakable",true)
		p:SetAttribute("WorldToughness",integrity)
		return p
	end
	for k,spot in {{.9,34},{1.15,37},{1.4,34}} do
		local at=origin+Vector3.new(math.sin(spot[1])*spot[2],2.6,math.cos(spot[1])*spot[2])
		local post=breakable("Training post",Vector3.new(1.7,5.2,1.7),CFrame.new(at)*CFrame.Angles(0,k*.7,0),PALETTE.wood,Enum.Material.Wood,55)
		deco(post,"Post rope",Vector3.new(.25,1.85,1.85),CFrame.new(at+Vector3.new(0,.9,0))*CFrame.Angles(0,0,math.pi/2),rgb(196,180,140),Enum.Material.Fabric,Enum.PartType.Cylinder)
	end
	for _,spot in {{3.6,46,0},{3.75,49,1},{3.5,50,2},{5.0,44,0},{5.15,47,1},{2.2,52,0}} do
		local at=origin+Vector3.new(math.sin(spot[1])*spot[2],1.4,math.cos(spot[1])*spot[2])
		local crate=breakable("Supply crate",Vector3.new(2.8,2.8,2.8),CFrame.new(at)*CFrame.Angles(0,spot[1]*3+spot[3],0),rgb(150,112,70),Enum.Material.WoodPlanks,30)
		deco(crate,"Crate band",Vector3.new(2.9,.3,2.9),crate.CFrame*CFrame.new(0,.7,0),PALETTE.woodDark,Enum.Material.Wood)
		deco(crate,"Crate band",Vector3.new(2.9,.3,2.9),crate.CFrame*CFrame.new(0,-.7,0),PALETTE.woodDark,Enum.Material.Wood)
	end
	for _,spot in {{.3,54},{2.7,40},{4.3,56},{5.8,42}} do
		local at=origin+Vector3.new(math.sin(spot[1])*spot[2],0,math.cos(spot[1])*spot[2])
		local lantern=breakable("Stone lantern",Vector3.new(1.6,3.6,1.6),CFrame.new(at+Vector3.new(0,1.8,0)),rgb(150,146,134),Enum.Material.Slate,65)
		deco(lantern,"Lantern roof",Vector3.new(2.8,.7,2.8),CFrame.new(at+Vector3.new(0,4.0,0))*CFrame.Angles(0,math.pi/4,0),rgb(126,122,112),Enum.Material.Slate)
		deco(lantern,"Lantern light",Vector3.new(1.0,.9,1.0),CFrame.new(at+Vector3.new(0,3.1,0)),rgb(240,200,120),Enum.Material.Neon)
	end
	-- The forest of Konoha around the stadium, seen over the stands.
	for k=0,47 do
		local a=k/48*math.pi*2+.07
		local r=R+62+((k*53)%5)*7
		local at=origin+Vector3.new(math.sin(a)*r,0,math.cos(a)*r)
		local h=50+((k*31)%4)*7
		if M then
			asset(if k%3==0 then "BroadTree" else "PineTree",CFrame.new(at)*CFrame.Angles(0,a*3,0),(1+((k*31)%4)*.12)*1.3)
			continue
		end
		deco(decor,"Forest trunk",Vector3.new(3,h,3),CFrame.new(at+Vector3.new(0,h/2,0)),C.bark,Enum.Material.Wood)
		deco(decor,"Forest crown",Vector3.one*(26+((k*13)%4)*5),CFrame.new(at+Vector3.new(0,h,0)),if k%2==0 then C.leafDark else C.leaf,Enum.Material.Grass,Enum.PartType.Ball)
	end
	-- A few leaves drifting over the field.
	local sky=deco(decor,"Leaf source",Vector3.new(260,1,260),CFrame.new(origin+Vector3.new(0,78,0)),C.leaf,Enum.Material.SmoothPlastic)
	sky.Transparency=1
	local leaves=Instance.new("ParticleEmitter");leaves.Name="Leaves"
	leaves.Texture="rbxasset://textures/particles/sparkles_main.dds";leaves.Rate=7;leaves.Lifetime=NumberRange.new(9,13)
	leaves.Speed=NumberRange.new(2,4);leaves.EmissionDirection=Enum.NormalId.Bottom;leaves.SpreadAngle=Vector2.new(30,30)
	leaves.Color=ColorSequence.new(rgb(120,160,80));leaves.LightEmission=.1;leaves.Size=NumberSequence.new(.35)
	leaves.Rotation=NumberRange.new(0,360);leaves.RotSpeed=NumberRange.new(-90,90);leaves.Acceleration=Vector3.new(1.2,-.6,.4)
	leaves.Parent=sky
	atmosphere()
	return folder
end
local function fighterGroup()
	local physics=game:GetService("PhysicsService")
	pcall(function()
		if not physics:IsCollisionGroupRegistered("NinjaFighters") then physics:RegisterCollisionGroup("NinjaFighters") end
		physics:CollisionGroupSetCollidable("NinjaFighters","NinjaFighters",false)
	end)
end
-- (DEC-036) The prodigy whose look a body wears, with the body's own colours:
-- the kit `def` fights, this dresses. A prodigy's own body is his own def
-- (the same table: he is built exactly as before).
local byName=nil
function World.lookDef(body,def)
	if not body then return def end
	local base=def
	if body.look~=nil and body.look~=def.Name then
		if not byName then
			byName={}
			for _,d in Fighters do if type(d)=="table" and d.Name and not byName[d.Name] then byName[d.Name]=d end end
		end
		base=byName[body.look] or def
	end
	local out=nil
	for _,key in Appearance.COLOURS do
		local v=body[string.lower(key)]
		if v~=nil then out=out or setmetatable({},{__index=base});out[key]=v end
	end
	return out or base
end
-- `worn` (optional, a Shared/Appearance body): what the fighter looks like;
-- the kit `def` decides everything else. Without one, the prodigy's own body.
function World.rig(parent, def, cf, name, worn)
	fighterGroup()
	local model = Instance.new("Model"); model.Name=name; model.Parent=parent
	local look=World.lookDef(worn,def)
	local skin=Color3.fromRGB(table.unpack(look.Skin))
	local outfit=Color3.fromRGB(table.unpack(look.Outfit))
	local pants=Color3.fromRGB(35,43,54)
	local color=Color3.fromRGB(table.unpack(look.Color))
	local root=part(model,"HumanoidRootPart",Vector3.new(2,2,1),cf,outfit)
	root.Transparency=1
	local function body(name,size,offset,tint)
		return part(model,name,size,cf*CFrame.new(offset),tint)
	end
	local lower=body("LowerTorso",Vector3.new(2,1,1),Vector3.new(0,0,0),outfit)
	local upper=body("UpperTorso",Vector3.new(2,1.4,1),Vector3.new(0,1.15,0),outfit)
	local head=body("Head",Vector3.new(1.5,1.5,1.5),Vector3.new(0,2.45,0),skin)
	local hum=Instance.new("Humanoid")
	hum.RigType=Enum.HumanoidRigType.R15; hum.RequiresNeck=true; hum.BreakJointsOnDeath=false
	hum.MaxHealth=def.Health; hum.Health=def.Health; hum.WalkSpeed=def.Speed
	hum.UseJumpPower=true; hum.JumpPower=68; hum.HipHeight=2
	hum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None; hum.Parent=model
	Instance.new("Animator",hum)
	local joints={}
	local function joint(name,p0,p1,c0,c1)
		local m=Instance.new("Motor6D");m.Name=name;m.Part0=p0;m.Part1=p1;m.C0=CFrame.new(c0);m.C1=CFrame.new(c1);m.Parent=p0
		joints[name]=m;return m
	end
	joint("Root",root,lower,Vector3.zero,Vector3.zero)
	joint("Waist",lower,upper,Vector3.new(0,0.65,0),Vector3.new(0,-0.5,0))
	joint("Neck",upper,head,Vector3.new(0,0.9,0),Vector3.new(0,-0.55,0))
	for _,side in {-1,1} do
		local prefix=if side==-1 then "Left" else "Right"
		local armTop=body(prefix.."UpperArm",Vector3.new(0.8,1.1,0.8),Vector3.new(side*1.45,0.72,0),outfit)
		local armLow=body(prefix.."LowerArm",Vector3.new(0.76,0.95,0.76),Vector3.new(side*1.45,-0.28,0),outfit)
		local hand=body(prefix.."Hand",Vector3.new(0.72,0.5,0.72),Vector3.new(side*1.45,-1.0,0),skin)
		local legTop=body(prefix.."UpperLeg",Vector3.new(0.85,1.1,0.85),Vector3.new(side*0.5,-0.85,0),pants)
		local legLow=body(prefix.."LowerLeg",Vector3.new(0.8,1.05,0.8),Vector3.new(side*0.5,-1.75,0),pants)
		local foot=body(prefix.."Foot",Vector3.new(0.8,0.42,1.15),Vector3.new(side*0.5,-2.55,-0.15),pants)
		joint(prefix.."Shoulder",upper,armTop,Vector3.new(side*1.05,0.45,0),Vector3.new(-side*0.4,0.5,0))
		joint(prefix.."Elbow",armTop,armLow,Vector3.new(0,-0.55,0),Vector3.new(0,0.45,0))
		joint(prefix.."Wrist",armLow,hand,Vector3.new(0,-0.48,0),Vector3.new(0,0.25,0))
		joint(prefix.."Hip",lower,legTop,Vector3.new(side*0.5,-0.55,0),Vector3.new(0,0.5,0))
		joint(prefix.."Knee",legTop,legLow,Vector3.new(0,-0.55,0),Vector3.new(0,0.5,0))
		joint(prefix.."Ankle",legLow,foot,Vector3.new(0,-0.5,0),Vector3.new(0,0.2,0.15))
	end
	local hair=body("Hair",Vector3.new(1.65,0.55,1.65),Vector3.new(0,3,0),Color3.fromRGB(table.unpack(look.Hair)))
	joint("HairJoint",head,hair,Vector3.new(0,0.57,0),Vector3.new(0,-0.25,0))
	local sash=body("Sash",Vector3.new(2.1,0.25,1.1),Vector3.new(0,-0.4,0),color)
	joint("SashJoint",lower,sash,Vector3.new(0,-0.4,0),Vector3.zero)
	local eyes=body("Eyes",Vector3.new(0.85,0.1,0.05),Vector3.new(0,2.6,-0.76),Color3.fromRGB(24,31,38))
	joint("EyeJoint",head,eyes,Vector3.new(0,0.15,-0.76),Vector3.zero)
	for _,piece in model:GetChildren() do
		if piece:IsA("BasePart") then
			piece.Anchored=false
			piece.CanCollide=piece==root
			piece.CanQuery=piece==root or piece==lower or piece==upper or piece==head
			piece.Massless=piece~=root
		end
	end
	World.dress(model,def,worn)
	model.PrimaryPart=root; root:SetNetworkOwner(nil)
	-- Fighters pass through each other physically; Combat keeps them apart.
	for _,p in model:GetDescendants() do if p:IsA("BasePart") then p.CollisionGroup="NinjaFighters" end end
	return model,hum,root,joints
end
-- --------------------------------------------------------------- costumes
-- Cosmetic layers welded onto the R15 body parts: silhouettes that read as the
-- two shinobi at combat distance. Massless, never collide, never block queries.
local function wear(model,bodyName,name,size,offset,color,material,class)
	local body=model:FindFirstChild(bodyName)
	if not body then return nil end
	local p=Instance.new(class or "Part")
	p.Name=name;p.Size=size;p.CFrame=body.CFrame*offset;p.Color=color;p.Material=material or Enum.Material.SmoothPlastic
	p.Anchored=false;p.CanCollide=false;p.CanQuery=false;p.CanTouch=false;p.Massless=true;p.CastShadow=true
	p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth
	local weld=Instance.new("WeldConstraint");weld.Part0=body;weld.Part1=p;weld.Parent=p
	p.Parent=model
	return p
end
World.wear=wear
local function cyl(p)
	if p then p.Shape=Enum.PartType.Cylinder end
	return p
end
local A=CFrame.Angles
local R=math.rad
local function headband(model,slashed)
	wear(model,"Head","Headband",Vector3.new(1.66,.24,1.66),CFrame.new(0,.36,0),rgb(28,36,58),Enum.Material.SmoothPlastic)
	wear(model,"Head","HeadbandPlate",Vector3.new(.86,.3,.06),CFrame.new(0,.36,-.85),rgb(176,184,194),Enum.Material.Metal)
	-- The Leaf symbol, reduced to a readable spiral mark.
	wear(model,"Head","LeafMark",Vector3.new(.3,.14,.02),CFrame.new(0,.38,-.89),rgb(70,78,90),Enum.Material.Metal)
	if slashed then wear(model,"Head","Slash",Vector3.new(.92,.04,.03),CFrame.new(0,.36,-.86)*A(0,0,R(-8)),rgb(30,30,34),Enum.Material.Metal) end
	for _,side in {-1,1} do
		wear(model,"Head","HeadbandTail",Vector3.new(.16,.55,.08),CFrame.new(side*.25,.18,.84)*A(R(18),0,R(side*10)),rgb(28,36,58),Enum.Material.SmoothPlastic)
	end
end
local function face(model,eye,brow)
	local eyes=model:FindFirstChild("Eyes")
	if eyes then eyes.Transparency=1 end
	for _,side in {-1,1} do
		wear(model,"Head","Eye",Vector3.new(.3,.17,.04),CFrame.new(side*.3,.08,-.8),rgb(245,245,240))
		wear(model,"Head","Iris",Vector3.new(.15,.15,.03),CFrame.new(side*.3,.07,-.825),eye,Enum.Material.SmoothPlastic)
		wear(model,"Head","Brow",Vector3.new(.34,.06,.04),CFrame.new(side*.3,.27,-.8)*A(0,0,R(side*-8)),brow)
	end
	wear(model,"Head","Mouth",Vector3.new(.28,.04,.03),CFrame.new(0,-.36,-.78),rgb(120,70,64))
end
-- Smooth rounded hair cap over the crown.
local function hairCap(model,color)
	local cap=wear(model,"Head","HairCap",Vector3.new(1.98,1.3,2.02),CFrame.new(0,.5,.08),color)
	if cap then
		local mesh=Instance.new("SpecialMesh");mesh.MeshType=Enum.MeshType.Sphere;mesh.Parent=cap
	end
	return cap
end
-- A tapered lock: a long thin wedge whose point sits `length` along `direction`
-- from `base` (head space).
local function spike(model,base,direction,length,width,height,color)
	local d=direction.Unit
	local center=base+d*length*.5
	local up=if math.abs(d.Y)&gt;.9 then Vector3.zAxis else Vector3.yAxis
	local cf=CFrame.lookAt(center,center+d,up)
	return wear(model,"Head","HairSpike",Vector3.new(width,height,length),cf,color,Enum.Material.SmoothPlastic,"WedgePart")
end
-- Young prodigies (12-14), not adult final forms: practical genin/chunin gear,
-- bigger heads and lighter builds, with only hints of who they will become.
local function dressMinato(model,def)
	local hair=rgb(250,216,98)
	local hairShade=rgb(228,182,60)
	local navy=rgb(34,52,92)
	local navyDark=rgb(24,34,60)
	local light=rgb(226,230,232)
	local accent=rgb(236,110,44)
	local cap=model:FindFirstChild("Hair");if cap then cap.Color=hair;cap.Transparency=1 end
	face(model,rgb(70,140,220),hairShade)
	hairCap(model,hair)
	-- Spiky but younger mane: shorter locks, two framing bangs.
	local spikes={
		{Vector3.new(0,.78,.25),Vector3.new(0,.4,1),.9,.6,.38},
		{Vector3.new(-.45,.66,.28),Vector3.new(-.5,.35,1),.82,.5,.34},
		{Vector3.new(.45,.66,.28),Vector3.new(.5,.35,1),.82,.5,.34},
		{Vector3.new(0,.45,.62),Vector3.new(0,-.05,1),.78,.66,.38},
		{Vector3.new(-.5,.3,.58),Vector3.new(-.55,-.3,.9),.7,.48,.32},
		{Vector3.new(.5,.3,.58),Vector3.new(.55,-.3,.9),.7,.48,.32},
		{Vector3.new(0,-.12,.68),Vector3.new(0,-.7,.75),.6,.6,.3},
		{Vector3.new(-.72,.5,.05),Vector3.new(-1,.5,.35),.52,.4,.28},
		{Vector3.new(.72,.5,.05),Vector3.new(1,.5,.35),.52,.4,.28},
		{Vector3.new(-.25,.82,-.2),Vector3.new(-.35,1,-.25),.45,.38,.28},
		{Vector3.new(.25,.82,-.2),Vector3.new(.35,1,-.25),.45,.38,.28},
	}
	for index,s in spikes do spike(model,s[1],s[2],s[3],s[4],s[5],if index%2==0 then hairShade else hair) end
	for _,x in {-.38,0,.38} do spike(model,Vector3.new(x,.62,-.55),Vector3.new(x*.4,-.75,-.55),.5,.42,.24,hair) end
	for _,side in {-1,1} do
		wear(model,"Head","Bang",Vector3.new(.2,.95,.34),CFrame.new(side*.8,-.05,-.42)*A(R(4),0,R(side*4)),hair)
		wear(model,"Head","SideHair",Vector3.new(.16,.8,.8),CFrame.new(side*.8,.08,.3),hair)
	end
	wear(model,"Head","BackHair",Vector3.new(1.6,1.0,.26),CFrame.new(0,.05,.74),hair)
	headband(model,false)
	-- Navy zip-up with a high collar, a light open half-vest (the seed of the
	-- future cloak, no rank marks), kunai holster on the right thigh.
	for _,name in {"UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm","LeftLowerArm","RightLowerArm"} do
		local part=model:FindFirstChild(name);if part then part.Color=navy end
	end
	wear(model,"UpperTorso","Collar",Vector3.new(1.25,.36,1.02),CFrame.new(0,.8,.02),navy)
	wear(model,"UpperTorso","Zip",Vector3.new(.06,1.3,.03),CFrame.new(0,0,-.52),light)
	wear(model,"UpperTorso","HalfVestBack",Vector3.new(2.12,1.36,.08),CFrame.new(0,-.02,.56),light)
	for _,side in {-1,1} do
		wear(model,"UpperTorso","HalfVestFront",Vector3.new(.62,1.3,.08),CFrame.new(side*.72,-.05,-.56),light)
		wear(model,"UpperTorso","HalfVestSide",Vector3.new(.08,1.32,1.12),CFrame.new(side*1.04,-.03,0),light)
		wear(model,"UpperTorso","VestTrim",Vector3.new(.64,.08,.1),CFrame.new(side*.72,-.66,-.56),accent)
	end
	wear(model,"UpperTorso","VestTrimBack",Vector3.new(2.14,.08,.1),CFrame.new(0,-.66,.56),accent)
	wear(model,"LowerTorso","Belt",Vector3.new(2.06,.24,1.06),CFrame.new(0,.28,0),navyDark)
	wear(model,"LowerTorso","ToolPouch",Vector3.new(.7,.42,.3),CFrame.new(0,.12,.62),rgb(70,80,92))
	wear(model,"RightUpperLeg","ThighWrap",Vector3.new(.9,.4,.9),CFrame.new(0,.05,0),light)
	wear(model,"RightUpperLeg","Holster",Vector3.new(.24,.5,.5),CFrame.new(.5,-.05,0),navyDark)
	cyl(wear(model,"RightUpperLeg","HolsterRing",Vector3.new(.06,.22,.22),CFrame.new(.55,.3,0),rgb(120,126,134),Enum.Material.Metal))
	for _,side in {"Left","Right"} do
		local legLow=model:FindFirstChild(side.."LowerLeg");if legLow then legLow.Color=navyDark end
		local legTop=model:FindFirstChild(side.."UpperLeg");if legTop then legTop.Color=navyDark end
		wear(model,side.."LowerLeg","ShinWrap",Vector3.new(.84,.55,.84),CFrame.new(0,-.15,0),light)
		local foot=model:FindFirstChild(side.."Foot");if foot then foot.Color=rgb(28,36,56) end
		wear(model,side.."Foot","Toes",Vector3.new(.7,.16,.34),CFrame.new(0,.1,-.42),Color3.fromRGB(table.unpack(def.Skin)))
		wear(model,side.."LowerArm","Cuff",Vector3.new(.8,.18,.8),CFrame.new(0,-.38,0),light)
	end
end
-- Uchiha fan crest: red upper disc, white lower disc in front, short handle.
local function crest(model,body,offset,scale)
	cyl(wear(model,body,"CrestRed",Vector3.new(.04,.66*scale,.66*scale),offset*CFrame.new(0,.12*scale,0)*A(0,R(90),0),rgb(200,30,36)))
	cyl(wear(model,body,"CrestWhite",Vector3.new(.04,.46*scale,.46*scale),offset*CFrame.new(0,-.06*scale,-.02)*A(0,R(90),0),rgb(238,238,236)))
	wear(model,body,"CrestHandle",Vector3.new(.09*scale,.34*scale,.03),offset*CFrame.new(0,-.4*scale,-.02),rgb(238,238,236))
end
local function dressItachi(model,def)
	local hair=rgb(22,22,28)
	local shirt=rgb(48,52,68)
	local dark=rgb(22,22,30)
	local gray=rgb(132,136,146)
	local cap=model:FindFirstChild("Hair");if cap then cap.Color=hair;cap.Transparency=1 end
	face(model,rgb(200,20,30),hair)
	for _,p in model:GetChildren() do if p.Name=="Iris" then p.Material=Enum.Material.Neon end end
	-- Sharingan: a pupil and three tomoe on each red iris.
	for _,side in {-1,1} do
		wear(model,"Head","Pupil",Vector3.new(.045,.045,.02),CFrame.new(side*.3,.07,-.842),rgb(12,8,10))
		for k=0,2 do
			local a=math.rad(90+k*120)
			wear(model,"Head","Tomoe",Vector3.new(.032,.032,.02),CFrame.new(side*.3+math.cos(a)*.048,.07+math.sin(a)*.048,-.842),rgb(12,8,10))
		end
	end
	hairCap(model,hair)
	-- Long dark hair tied low, centre-parted bangs framing the face.
	for _,side in {-1,1} do
		wear(model,"Head","Bang",Vector3.new(.24,1.15,.42),CFrame.new(side*.76,-.12,-.42)*A(R(3),0,R(side*3)),hair)
		wear(model,"Head","SideHair",Vector3.new(.18,1.0,.9),CFrame.new(side*.8,-.02,.25),hair)
	end
	for _,x in {-.42,-.12,.18,.45} do
		wear(model,"Head","Fringe",Vector3.new(.32,.42,.26),CFrame.new(x,.52,-.68)*A(R(196),0,0),hair,Enum.Material.SmoothPlastic,"WedgePart")
	end
	wear(model,"Head","BackHair",Vector3.new(1.62,1.2,.3),CFrame.new(0,-.05,.72),hair)
	cyl(wear(model,"Head","Ponytail",Vector3.new(1.0,.24,.24),CFrame.new(0,-.85,.86)*A(0,0,R(80))*A(0,R(10),0),hair))
	headband(model,false)
	-- Village-era Uchiha: dark high-collared shirt with the clan crest on the
	-- back, grey arm guards, shuriken holster. No cloak, no rings.
	for _,name in {"UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm"} do
		local part=model:FindFirstChild(name);if part then part.Color=shirt end
	end
	wear(model,"UpperTorso","HighCollar",Vector3.new(1.45,.55,1.12),CFrame.new(0,.86,.04),shirt)
	crest(model,"UpperTorso",CFrame.new(0,.1,.53)*A(0,R(180),0),1.2)
	for _,side in {"Left","Right"} do
		wear(model,side.."LowerArm","ArmGuard",Vector3.new(.84,.72,.84),CFrame.new(0,-.05,0),gray,Enum.Material.Metal)
		wear(model,side.."UpperArm","Sleeve",Vector3.new(.86,.5,.86),CFrame.new(0,.28,0),shirt)
		local legLow=model:FindFirstChild(side.."LowerLeg");if legLow then legLow.Color=dark end
		local legTop=model:FindFirstChild(side.."UpperLeg");if legTop then legTop.Color=dark end
		wear(model,side.."LowerLeg","ShinWrap",Vector3.new(.84,.55,.84),CFrame.new(0,-.15,0),rgb(206,206,198))
		local foot=model:FindFirstChild(side.."Foot");if foot then foot.Color=rgb(28,28,36) end
		wear(model,side.."Foot","Toes",Vector3.new(.7,.16,.34),CFrame.new(0,.1,-.42),Color3.fromRGB(table.unpack(def.Skin)))
	end
	wear(model,"LowerTorso","Belt",Vector3.new(2.06,.22,1.06),CFrame.new(0,.3,0),dark)
	wear(model,"RightUpperLeg","ThighWrap",Vector3.new(.9,.36,.9),CFrame.new(0,.05,0),rgb(206,206,198))
	wear(model,"RightUpperLeg","Holster",Vector3.new(.24,.5,.5),CFrame.new(.5,-.05,0),dark)
end
-- Neji at the Chunin Exam (13): cream high-collared Hyuga top, dark shorts,
-- bandaged right arm and thigh, long hair tied at the end, Byakugan eyes.
local function dressNeji(model,def)
	local hair=rgb(52,36,30)
	local robe=rgb(232,226,212)
	local robeShade=rgb(204,196,182)
	local shorts=rgb(72,54,46)
	local bandage=rgb(240,238,230)
	local skin=Color3.fromRGB(table.unpack(def.Skin))
	local cap=model:FindFirstChild("Hair");if cap then cap.Color=hair;cap.Transparency=1 end
	face(model,rgb(198,192,232),hair)
	-- Byakugan: pale irises with no pupil; the veins show when it flares.
	for _,p in model:GetChildren() do
		if p.Name=="Eye" then p.Color=rgb(242,240,252) end
		if p.Name=="Iris" then p.Material=Enum.Material.Neon;p.Transparency=.2 end
	end
	for _,side in {-1,1} do
		for k=0,2 do
			local vein=wear(model,"Head","ByakuganVein",Vector3.new(.035,.2,.02),CFrame.new(side*(.52+k*.06),.08+(k-1)*.07,-.79)*A(0,0,R(side*(30-k*30))),rgb(150,138,196))
			if vein then vein.Transparency=1 end
		end
	end
	hairCap(model,hair)
	for _,side in {-1,1} do
		wear(model,"Head","Bang",Vector3.new(.22,1.32,.4),CFrame.new(side*.74,-.24,-.44)*A(R(2),0,R(side*2)),hair)
		wear(model,"Head","SideHair",Vector3.new(.18,1.25,.95),CFrame.new(side*.8,-.14,.22),hair)
	end
	-- Centre parting: two smooth panels over the forehead, no spikes.
	for _,x in {-.36,.36} do
		wear(model,"Head","Fringe",Vector3.new(.62,.3,.16),CFrame.new(x,.5,-.7)*A(R(8),0,R(if x&gt;0 then -10 else 10)),hair)
	end
	wear(model,"Head","BackHair",Vector3.new(1.66,1.45,.3),CFrame.new(0,-.14,.72),hair)
	wear(model,"UpperTorso","LongHair",Vector3.new(.72,1.5,.22),CFrame.new(0,.32,.62),hair)
	wear(model,"UpperTorso","HairTie",Vector3.new(.5,.12,.26),CFrame.new(0,-.38,.63),rgb(240,236,226))
	wear(model,"UpperTorso","HairTip",Vector3.new(.4,.48,.2),CFrame.new(0,-.68,.62),hair)
	headband(model,false)
	for _,name in {"UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm"} do
		local part=model:FindFirstChild(name);if part then part.Color=robe end
	end
	wear(model,"UpperTorso","HighCollar",Vector3.new(1.42,.5,1.1),CFrame.new(0,.86,.04),robe)
	wear(model,"UpperTorso","Overlap",Vector3.new(.08,1.3,.04),CFrame.new(-.32,-.05,-.53)*A(0,0,R(-10)),robeShade)
	wear(model,"LowerTorso","WaistTie",Vector3.new(2.06,.26,1.06),CFrame.new(0,.3,0),robeShade)
	for _,side in {"Left","Right"} do
		local legTop=model:FindFirstChild(side.."UpperLeg");if legTop then legTop.Color=shorts end
		local legLow=model:FindFirstChild(side.."LowerLeg");if legLow then legLow.Color=skin end
		wear(model,side.."LowerLeg","ShinWrap",Vector3.new(.84,.5,.84),CFrame.new(0,-.2,0),rgb(48,52,70))
		local foot=model:FindFirstChild(side.."Foot");if foot then foot.Color=rgb(40,46,66) end
		wear(model,side.."Foot","Toes",Vector3.new(.7,.16,.34),CFrame.new(0,.1,-.42),skin)
		wear(model,side.."UpperArm","Sleeve",Vector3.new(.88,.36,.88),CFrame.new(0,-.2,0),robe)
	end
	local leftArm=model:FindFirstChild("LeftLowerArm");if leftArm then leftArm.Color=skin end
	local rightArm=model:FindFirstChild("RightLowerArm");if rightArm then rightArm.Color=bandage end
	for k=0,2 do wear(model,"RightLowerArm","BandageLine",Vector3.new(.84,.04,.84),CFrame.new(0,.25-k*.25,0)*A(0,0,R(8)),rgb(212,208,198)) end
	wear(model,"RightUpperLeg","ThighBandage",Vector3.new(.88,.5,.88),CFrame.new(0,0,0),bandage)
	wear(model,"RightUpperLeg","Holster",Vector3.new(.24,.5,.5),CFrame.new(.5,-.05,0),rgb(48,52,70))
end
-- Sasuke at the Chunin Exam (12): dark blue high-collared shirt with the
-- Uchiha fan on the back, light shorts, white arm warmers, the Leaf headband,
-- black hair swept back into spikes, a two-tomoe Sharingan. The cursed seal
-- marks are there but hidden until he awakens it.
local function dressSasuke(model,def)
	local hair=rgb(24,26,40)
	local hairShade=rgb(36,40,62)
	local shirt=rgb(34,40,72)
	local shorts=rgb(222,216,204)
	local warmer=rgb(236,236,232)
	local skin=Color3.fromRGB(table.unpack(def.Skin))
	local cap=model:FindFirstChild("Hair");if cap then cap.Color=hair;cap.Transparency=1 end
	face(model,rgb(200,20,30),hair)
	for _,p in model:GetChildren() do if p.Name=="Iris" then p.Material=Enum.Material.Neon end end
	for _,side in {-1,1} do
		wear(model,"Head","Pupil",Vector3.new(.045,.045,.02),CFrame.new(side*.3,.07,-.842),rgb(12,8,10))
		for k=0,1 do
			local a=math.rad(90+k*180)
			wear(model,"Head","Tomoe",Vector3.new(.034,.034,.02),CFrame.new(side*.3+math.cos(a)*.05,.07+math.sin(a)*.05,-.842),rgb(12,8,10))
		end
	end
	hairCap(model,hair)
	-- Swept back: long spikes pointing back and up behind the crown, two long
	-- bangs framing the face, a short fringe over the headband.
	local back={
		{Vector3.new(0,.62,.5),Vector3.new(0,.55,1),1.05,.62,.4},
		{Vector3.new(-.45,.5,.5),Vector3.new(-.45,.5,1),.95,.52,.36},
		{Vector3.new(.45,.5,.5),Vector3.new(.45,.5,1),.95,.52,.36},
		{Vector3.new(0,.25,.66),Vector3.new(0,.25,1),.9,.6,.38},
		{Vector3.new(-.5,.12,.6),Vector3.new(-.55,.15,1),.8,.46,.32},
		{Vector3.new(.5,.12,.6),Vector3.new(.55,.15,1),.8,.46,.32},
		{Vector3.new(0,.8,.2),Vector3.new(0,.9,.7),.7,.5,.32},
		{Vector3.new(-.3,-.1,.68),Vector3.new(-.2,-.2,1),.7,.44,.3},
		{Vector3.new(.3,-.1,.68),Vector3.new(.2,-.2,1),.7,.44,.3},
	}
	for index,s in back do spike(model,s[1],s[2],s[3],s[4],s[5],if index%2==0 then hairShade else hair) end
	for _,x in {-.34,0,.34} do spike(model,Vector3.new(x,.66,-.55),Vector3.new(x*.3,-.8,-.5),.46,.4,.22,hair) end
	for _,side in {-1,1} do
		wear(model,"Head","Bang",Vector3.new(.2,1.2,.36),CFrame.new(side*.78,-.2,-.44)*A(R(2),0,R(side*6)),hair)
		wear(model,"Head","SideHair",Vector3.new(.16,.85,.85),CFrame.new(side*.8,.05,.28),hair)
	end
	headband(model,false)
	-- The cursed seal (hidden): three black flame marks on the left of the neck.
	for k=0,2 do
		local mark=wear(model,"Head","CurseMark",Vector3.new(.05,.22,.14),CFrame.new(-.78,-.42+k*.18,.08-k*.12)*A(R(20*k),0,R(10)),rgb(12,10,14))
		if mark then mark.Transparency=1 end
	end
	for _,name in {"UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm"} do
		local part=model:FindFirstChild(name);if part then part.Color=shirt end
	end
	wear(model,"UpperTorso","HighCollar",Vector3.new(1.5,.62,1.16),CFrame.new(0,.86,.04),shirt)
	crest(model,"UpperTorso",CFrame.new(0,.1,.53)*A(0,R(180),0),1.25)
	wear(model,"LowerTorso","Belt",Vector3.new(2.06,.22,1.06),CFrame.new(0,.3,0),rgb(30,30,36))
	for _,side in {"Left","Right"} do
		local armLow=model:FindFirstChild(side.."LowerArm");if armLow then armLow.Color=warmer end
		wear(model,side.."UpperArm","Sleeve",Vector3.new(.86,.42,.86),CFrame.new(0,.3,0),shirt)
		local legTop=model:FindFirstChild(side.."UpperLeg");if legTop then legTop.Color=shorts end
		local legLow=model:FindFirstChild(side.."LowerLeg");if legLow then legLow.Color=skin end
		wear(model,side.."LowerLeg","ShinWrap",Vector3.new(.84,.42,.84),CFrame.new(0,-.28,0),rgb(40,46,70))
		local foot=model:FindFirstChild(side.."Foot");if foot then foot.Color=rgb(36,40,62) end
		wear(model,side.."Foot","Toes",Vector3.new(.7,.16,.34),CFrame.new(0,.1,-.42),skin)
	end
	wear(model,"RightUpperLeg","ThighWrap",Vector3.new(.9,.38,.9),CFrame.new(0,-.1,0),warmer)
	wear(model,"RightUpperLeg","Holster",Vector3.new(.24,.5,.5),CFrame.new(.5,-.1,0),rgb(40,46,70))
	wear(model,"LowerTorso","ToolPouch",Vector3.new(.66,.4,.3),CFrame.new(0,.1,.62),rgb(70,64,58))
end
-- Gaara at the Chunin Exam (12): spiky red hair, 愛 on the forehead, dark rings
-- round pale eyes, a dark one-piece with the white sash that carries the sand
-- gourd on his back.
local function dressGaara(model,def)
	local hair=rgb(170,44,36)
	local hairShade=rgb(140,32,28)
	local suit=rgb(70,44,50)
	local suitDark=rgb(46,30,36)
	local sash=rgb(232,226,212)
	local gourd=rgb(206,170,118)
	local gourdDark=rgb(170,134,90)
	local skin=Color3.fromRGB(table.unpack(def.Skin))
	local cap=model:FindFirstChild("Hair");if cap then cap.Color=hair;cap.Transparency=1 end
	face(model,rgb(120,190,170),skin)
	-- No eyebrows; the sleepless dark rings around the eyes.
	for _,p in model:GetChildren() do
		if p.Name=="Brow" then p.Transparency=1 end
		if p.Name=="Eye" then p.Color=rgb(236,240,232) end
	end
	for _,side in {-1,1} do
		wear(model,"Head","EyeRing",Vector3.new(.4,.27,.03),CFrame.new(side*.3,.08,-.79),rgb(34,26,30))
	end
	-- 愛 above the left eye, in red.
	local mark=wear(model,"Head","LoveMark",Vector3.new(.3,.3,.02),CFrame.new(-.36,.42,-.8),rgb(176,30,34))
	if mark then
		local gui=Instance.new("SurfaceGui");gui.Face=Enum.NormalId.Front;gui.CanvasSize=Vector2.new(60,60);gui.LightInfluence=1;gui.Parent=mark
		local t=Instance.new("TextLabel");t.Size=UDim2.fromScale(1,1);t.BackgroundTransparency=1;t.Text="愛";t.TextScaled=true
		t.TextColor3=rgb(176,30,34);t.Font=Enum.Font.GothamBold;t.Parent=gui
		mark.Transparency=1
	end
	hairCap(model,hair)
	local spikes={
		{Vector3.new(0,.8,.1),Vector3.new(0,1,.3),.7,.5,.34},
		{Vector3.new(-.42,.7,.1),Vector3.new(-.6,.8,.3),.65,.46,.32},
		{Vector3.new(.42,.7,.1),Vector3.new(.6,.8,.3),.65,.46,.32},
		{Vector3.new(0,.5,.55),Vector3.new(0,.3,1),.7,.5,.34},
		{Vector3.new(-.5,.4,.5),Vector3.new(-.6,.2,1),.6,.42,.3},
		{Vector3.new(.5,.4,.5),Vector3.new(.6,.2,1),.6,.42,.3},
		{Vector3.new(-.72,.45,-.05),Vector3.new(-1,.4,.1),.48,.38,.26},
		{Vector3.new(.72,.45,-.05),Vector3.new(1,.4,.1),.48,.38,.26},
	}
	for index,s in spikes do spike(model,s[1],s[2],s[3],s[4],s[5],if index%2==0 then hairShade else hair) end
	-- Short messy fringe; no headband (he wears it on the sash).
	for _,x in {-.42,-.14,.14,.42} do spike(model,Vector3.new(x,.62,-.56),Vector3.new(x*.5,-.7,-.6),.44,.34,.2,hair) end
	for _,name in {"UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm","LeftUpperLeg","RightUpperLeg"} do
		local part=model:FindFirstChild(name);if part then part.Color=suit end
	end
	for _,side in {"Left","Right"} do
		local armLow=model:FindFirstChild(side.."LowerArm");if armLow then armLow.Color=suitDark end
		local legLow=model:FindFirstChild(side.."LowerLeg");if legLow then legLow.Color=suitDark end
		local foot=model:FindFirstChild(side.."Foot");if foot then foot.Color=rgb(40,34,40) end
		wear(model,side.."Foot","Toes",Vector3.new(.7,.16,.34),CFrame.new(0,.1,-.42),skin)
	end
	wear(model,"UpperTorso","Collar",Vector3.new(1.3,.34,1.06),CFrame.new(0,.82,.02),suitDark)
	-- The sash across the chest (right shoulder to left hip) with the headband plate.
	wear(model,"UpperTorso","Sash",Vector3.new(.34,2.2,1.12),CFrame.new(0,0,0)*CFrame.Angles(0,0,math.rad(-38)),sash)
	wear(model,"UpperTorso","SashPlate",Vector3.new(.5,.3,.06),CFrame.new(-.2,.1,-.58)*CFrame.Angles(0,0,math.rad(-38)),rgb(176,184,194),Enum.Material.Metal)
	wear(model,"LowerTorso","Belt",Vector3.new(2.06,.22,1.06),CFrame.new(0,.3,0),suitDark)
	-- The gourd: two stacked bellies and a cork, strapped across the back.
	local belly=wear(model,"UpperTorso","Gourd",Vector3.new(1.9,1.9,1.5),CFrame.new(.1,-.4,1.25),gourd,Enum.Material.Sand)
	if belly then belly.Shape=Enum.PartType.Ball end
	local top=wear(model,"UpperTorso","GourdTop",Vector3.new(1.3,1.3,1.1),CFrame.new(.3,.75,1.2),gourd,Enum.Material.Sand)
	if top then top.Shape=Enum.PartType.Ball end
	cyl(wear(model,"UpperTorso","GourdNeck",Vector3.new(.4,.55,.55),CFrame.new(.42,1.42,1.18)*CFrame.Angles(0,0,math.rad(90)),gourdDark,Enum.Material.Wood))
	wear(model,"UpperTorso","GourdBand",Vector3.new(1.95,.16,1.55),CFrame.new(.1,.2,1.2),rgb(120,92,62),Enum.Material.Fabric)
end
-- Rock Lee at the Chunin Exam (13, stress-test wave): the green one-piece
-- training suit, orange leg warmers, the Leaf headband worn as a red belt,
-- bandaged hands, a glossy black bowl cut over thick eyebrows and big round
-- eyes. A genin's kit only: no vest, nothing of an adult jonin.
local function dressLee(model,def)
	local hair=rgb(16,16,20)
	local suit=rgb(52,140,66)
	local suitDark=rgb(38,110,50)
	local warmer=rgb(236,128,38)
	local warmerDark=rgb(204,104,28)
	local belt=rgb(186,36,40)
	local bandage=rgb(238,234,222)
	local skin=Color3.fromRGB(table.unpack(def.Skin))
	local cap=model:FindFirstChild("Hair");if cap then cap.Color=hair;cap.Transparency=1 end
	face(model,rgb(14,14,18),hair)
	-- Big round eyes with small dark irises; the thin brows give way to his own.
	for _,p in model:GetChildren() do
		if p.Name=="Eye" then p.Size=Vector3.new(.32,.27,.04) end
		if p.Name=="Iris" then p.Size=Vector3.new(.1,.1,.03) end
		if p.Name=="Brow" then p.Transparency=1 end
	end
	for _,side in {-1,1} do
		wear(model,"Head","ThickBrow",Vector3.new(.42,.15,.05),CFrame.new(side*.3,.31,-.82)*A(0,0,R(side*-6)),hair)
	end
	-- The bowl cut: a smooth glossy cap, a fringe cut straight across the
	-- forehead, straight sides down to the jaw.
	local bowl=hairCap(model,hair)
	if bowl then bowl.Reflectance=.12 end
	wear(model,"Head","BowlFringe",Vector3.new(1.72,.34,.18),CFrame.new(0,.5,-.8),hair)
	for _,side in {-1,1} do
		wear(model,"Head","BowlSide",Vector3.new(.18,.95,1.3),CFrame.new(side*.86,.12,.02),hair)
	end
	wear(model,"Head","BowlBack",Vector3.new(1.72,1.15,.26),CFrame.new(0,.08,.78),hair)
	-- The one-piece suit, from the collar to the ankles.
	for _,name in {"UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm","LeftLowerArm","RightLowerArm","LeftUpperLeg","RightUpperLeg","LeftLowerLeg","RightLowerLeg"} do
		local part=model:FindFirstChild(name);if part then part.Color=suit end
	end
	wear(model,"UpperTorso","Collar",Vector3.new(1.3,.22,1.06),CFrame.new(0,.76,.02),suitDark)
	-- The Leaf headband, worn as a red belt with the plate in front.
	wear(model,"LowerTorso","HeadbandBelt",Vector3.new(2.08,.28,1.08),CFrame.new(0,.28,0),belt,Enum.Material.SmoothPlastic)
	wear(model,"LowerTorso","BeltPlate",Vector3.new(.8,.3,.06),CFrame.new(0,.28,-.57),rgb(176,184,194),Enum.Material.Metal)
	wear(model,"LowerTorso","LeafMark",Vector3.new(.28,.13,.02),CFrame.new(0,.3,-.61),rgb(70,78,90),Enum.Material.Metal)
	for _,side in {-1,1} do
		wear(model,"LowerTorso","BeltTail",Vector3.new(.16,.6,.06),CFrame.new(side*.22,.02,.56)*A(R(-10),0,R(side*8)),belt,Enum.Material.SmoothPlastic)
	end
	for _,side in {"Left","Right"} do
		-- Orange leg warmers from the knee to the ankle, rolled at both ends.
		wear(model,side.."LowerLeg","LegWarmer",Vector3.new(.98,.92,.98),CFrame.new(0,-.06,0),warmer,Enum.Material.SmoothPlastic)
		wear(model,side.."LowerLeg","WarmerRoll",Vector3.new(1.02,.16,1.02),CFrame.new(0,.42,0),warmerDark,Enum.Material.SmoothPlastic)
		wear(model,side.."LowerLeg","WarmerCuff",Vector3.new(1.04,.18,1.04),CFrame.new(0,-.5,0),warmerDark,Enum.Material.SmoothPlastic)
		local foot=model:FindFirstChild(side.."Foot");if foot then foot.Color=rgb(40,48,72) end
		wear(model,side.."Foot","Toes",Vector3.new(.7,.16,.34),CFrame.new(0,.1,-.42),skin)
		-- Hands wrapped in bandages for training, a few turns up the wrist.
		local hand=model:FindFirstChild(side.."Hand");if hand then hand.Color=bandage end
		for k=0,1 do
			wear(model,side.."LowerArm","BandageWrap",Vector3.new(.8,.07,.8),CFrame.new(0,-.36+k*.14,0)*A(0,0,R(6)),rgb(222,216,202))
		end
	end
end
-- Naruto in Part I (13, the Chunin Exam to the Valley of the End): the orange
-- jumpsuit with blue shoulders and the white standing collar, the red Uzumaki
-- spiral on the back, the blue-cloth headband, spiky blond hair, blue eyes,
-- three whisker marks on each cheek, a kunai holster on the bandaged right
-- thigh, blue sandals. A genin's kit, nothing of Part II. Flat SmoothPlastic.
local function dressNaruto(model,def)
	local hair=rgb(250,206,70)
	local hairShade=rgb(226,170,40)
	local orange=rgb(244,130,36)
	local orangeDark=rgb(214,104,24)
	local blue=rgb(36,52,110)
	local cloth=rgb(40,62,140)
	local white=rgb(238,236,228)
	local skin=Color3.fromRGB(table.unpack(def.Skin))
	local cap=model:FindFirstChild("Hair");if cap then cap.Color=hair;cap.Transparency=1 end
	face(model,rgb(60,130,230),hairShade)
	for _,side in {-1,1} do
		for k=0,2 do
			wear(model,"Head","Whisker",Vector3.new(.28,.03,.02),CFrame.new(side*.46,-.14-k*.09,-.78)*A(0,0,R(side*(8-k*8))),rgb(80,58,46))
		end
	end
	hairCap(model,hair)
	-- Spikes all round, wilder than Minato's, a ragged fringe over the headband.
	local spikes={
		{Vector3.new(0,.82,.2),Vector3.new(0,.75,.6),.95,.6,.38},
		{Vector3.new(-.42,.74,.25),Vector3.new(-.6,.6,.5),.9,.52,.36},
		{Vector3.new(.42,.74,.25),Vector3.new(.6,.6,.5),.9,.52,.36},
		{Vector3.new(0,.5,.62),Vector3.new(0,.15,1),.85,.62,.38},
		{Vector3.new(-.5,.34,.56),Vector3.new(-.6,0,.9),.78,.5,.34},
		{Vector3.new(.5,.34,.56),Vector3.new(.6,0,.9),.78,.5,.34},
		{Vector3.new(-.74,.56,.05),Vector3.new(-1,.45,.2),.62,.44,.3},
		{Vector3.new(.74,.56,.05),Vector3.new(1,.45,.2),.62,.44,.3},
		{Vector3.new(-.3,.86,-.22),Vector3.new(-.4,1,-.2),.55,.4,.3},
		{Vector3.new(.3,.86,-.22),Vector3.new(.4,1,-.2),.55,.4,.3},
		{Vector3.new(0,-.1,.7),Vector3.new(0,-.6,.8),.6,.6,.3},
		{Vector3.new(-.62,.1,.4),Vector3.new(-.9,-.2,.5),.55,.42,.28},
		{Vector3.new(.62,.1,.4),Vector3.new(.9,-.2,.5),.55,.42,.28},
	}
	for index,s in spikes do spike(model,s[1],s[2],s[3],s[4],s[5],if index%2==0 then hairShade else hair) end
	for _,x in {-.4,-.13,.13,.4} do spike(model,Vector3.new(x,.6,-.55),Vector3.new(x*.5,-.75,-.6),.5,.4,.22,hair) end
	headband(model,false)
	for _,p in model:GetChildren() do if p.Name=="Headband" or p.Name=="HeadbandTail" then p.Color=cloth end end
	-- The jumpsuit, from the collar to the ankles.
	for _,name in {"UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm","LeftLowerArm","RightLowerArm","LeftUpperLeg","RightUpperLeg","LeftLowerLeg","RightLowerLeg"} do
		local part=model:FindFirstChild(name);if part then part.Color=orange end
	end
	wear(model,"UpperTorso","ShoulderPanel",Vector3.new(2.06,.42,1.06),CFrame.new(0,.52,0),blue)
	for _,side in {"Left","Right"} do wear(model,side.."UpperArm","ShoulderCap",Vector3.new(.86,.4,.86),CFrame.new(0,.36,0),blue) end
	wear(model,"UpperTorso","Collar",Vector3.new(1.36,.42,1.1),CFrame.new(0,.86,.02),white)
	wear(model,"UpperTorso","Zip",Vector3.new(.06,1.1,.03),CFrame.new(0,-.1,-.52),white)
	cyl(wear(model,"UpperTorso","ZipRing",Vector3.new(.04,.2,.2),CFrame.new(0,.5,-.56)*A(0,R(90),0),white))
	-- The red Uzumaki spiral on the back.
	cyl(wear(model,"UpperTorso","Spiral",Vector3.new(.04,.78,.78),CFrame.new(0,-.08,.53)*A(0,R(90),0),rgb(196,40,36)))
	cyl(wear(model,"UpperTorso","SpiralInner",Vector3.new(.045,.38,.38),CFrame.new(.06,-.06,.535)*A(0,R(90),0),orange))
	for _,side in {"Left","Right"} do
		wear(model,side.."LowerArm","Cuff",Vector3.new(.82,.16,.82),CFrame.new(0,-.4,0),orangeDark)
		wear(model,side.."LowerLeg","PantCuff",Vector3.new(.86,.18,.86),CFrame.new(0,-.42,0),orangeDark)
		local foot=model:FindFirstChild(side.."Foot");if foot then foot.Color=cloth end
		wear(model,side.."Foot","Toes",Vector3.new(.7,.16,.34),CFrame.new(0,.1,-.42),skin)
	end
	wear(model,"RightUpperLeg","ThighBandage",Vector3.new(.9,.42,.9),CFrame.new(0,0,0),white)
	wear(model,"RightUpperLeg","Holster",Vector3.new(.24,.5,.5),CFrame.new(.5,-.05,0),blue)
	wear(model,"LowerTorso","ToolPouch",Vector3.new(.66,.4,.3),CFrame.new(0,.1,.62),rgb(70,64,58))
end
-- Temari between the Chunin Exam and the Sasuke retrieval (15, roster wave):
-- sandy hair in four short spiky tufts, the Sand headband on the forehead, the
-- light lilac short kimono with a crimson obi, fishnet at the elbows and knees,
-- bare legs and sandals. The iron fan is not costume: GaleFX carries it (on the
-- back at rest, in the hand for the fight). All flat SmoothPlastic.
local function dressTemari(model,def)
	local hair=rgb(226,196,120)
	local hairShade=rgb(196,164,92)
	local kimono=rgb(186,170,204)
	local kimonoShade=rgb(160,144,182)
	local obi=rgb(176,40,52)
	local mesh=rgb(62,62,70)
	local skin=Color3.fromRGB(table.unpack(def.Skin))
	local cap=model:FindFirstChild("Hair");if cap then cap.Color=hair;cap.Transparency=1 end
	face(model,rgb(52,112,96),hairShade)
	hairCap(model,hair)
	-- Four short tufts at the back, two each side, pointing out and down.
	for _,s in {{Vector3.new(-.55,.3,.5),Vector3.new(-.75,.35,.6)},{Vector3.new(.55,.3,.5),Vector3.new(.75,.35,.6)},
		{Vector3.new(-.5,-.25,.6),Vector3.new(-.7,-.45,.55)},{Vector3.new(.5,-.25,.6),Vector3.new(.7,-.45,.55)}} do
		local lock=spike(model,s[1],s[2],.95,.5,.32,hair)
		if lock then lock.Name="TemariPonytail" end
		local tie=wear(model,"Head","HairTie",Vector3.new(.2,.2,.2),CFrame.new(s[1]),rgb(60,46,40))
		if tie then tie.Shape=Enum.PartType.Ball end
	end
	-- A fringe parted to the side, short locks framing the face.
	for _,x in {-.4,-.08,.26} do spike(model,Vector3.new(x,.62,-.56),Vector3.new(x*.4-.1,-.75,-.55),.48,.4,.22,hair) end
	for _,side in {-1,1} do wear(model,"Head","Bang",Vector3.new(.18,.7,.32),CFrame.new(side*.8,.1,-.4)*A(R(4),0,R(side*4)),hair) end
	-- The Sand headband on the forehead.
	wear(model,"Head","Headband",Vector3.new(1.66,.24,1.66),CFrame.new(0,.36,0),rgb(40,40,48))
	wear(model,"Head","HeadbandPlate",Vector3.new(.86,.3,.06),CFrame.new(0,.36,-.85),rgb(176,184,194),Enum.Material.Metal)
	wear(model,"Head","SandMark",Vector3.new(.26,.12,.02),CFrame.new(0,.37,-.89),rgb(70,78,90),Enum.Material.Metal)
	-- The kimono: top, short sleeves, the skirt over the thighs, the crossed collar.
	for _,name in {"UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm","LeftUpperLeg","RightUpperLeg"} do
		local part=model:FindFirstChild(name);if part then part.Color=kimono end
	end
	wear(model,"UpperTorso","KimonoCollar",Vector3.new(.08,1.0,.04),CFrame.new(-.18,.25,-.53)*A(0,0,R(-28)),kimonoShade)
	wear(model,"UpperTorso","KimonoCollar",Vector3.new(.08,1.0,.04),CFrame.new(.18,.25,-.53)*A(0,0,R(28)),kimonoShade)
	wear(model,"LowerTorso","KimonoSkirt",Vector3.new(2.16,1.35,1.2),CFrame.new(0,-.62,0),kimono)
	wear(model,"LowerTorso","KimonoHem",Vector3.new(2.2,.1,1.24),CFrame.new(0,-1.3,0),kimonoShade)
	-- The crimson obi and its knot at the back.
	wear(model,"LowerTorso","Obi",Vector3.new(2.12,.5,1.12),CFrame.new(0,.36,0),obi)
	wear(model,"LowerTorso","ObiKnot",Vector3.new(.7,.42,.3),CFrame.new(0,.38,.66),obi)
	for _,side in {"Left","Right"} do
		wear(model,side.."UpperArm","Sleeve",Vector3.new(.9,.5,.9),CFrame.new(0,.25,0),kimono)
		local armLow=model:FindFirstChild(side.."LowerArm");if armLow then armLow.Color=skin end
		local legLow=model:FindFirstChild(side.."LowerLeg");if legLow then legLow.Color=skin end
		-- Fishnet at the elbows and knees.
		wear(model,side.."LowerArm","Fishnet",Vector3.new(.8,.36,.8),CFrame.new(0,.3,0),mesh)
		wear(model,side.."LowerLeg","Fishnet",Vector3.new(.84,.4,.84),CFrame.new(0,.36,0),mesh)
		local foot=model:FindFirstChild(side.."Foot");if foot then foot.Color=rgb(44,46,62) end
		wear(model,side.."Foot","Toes",Vector3.new(.7,.16,.34),CFrame.new(0,.1,-.42),skin)
	end
end
local function soften(model)
	local head=model:FindFirstChild("Head")
	if head and not head:FindFirstChildOfClass("SpecialMesh") then
		-- A slightly larger, rounded head reads as a 12-14 year old, not an adult.
		local mesh=Instance.new("SpecialMesh");mesh.MeshType=Enum.MeshType.Head;mesh.Scale=Vector3.new(1.24,1.26,1.24);mesh.Parent=head
	end
end
-- Costumes of the roster breadth pass register here by fighter name, built
-- from the same helpers (Server/Costumes*: install(dressers, kit)).
World.dressers={}
-- A drawn face for a fighter whose costume has none: eyes in the fighter's
-- own hair colour family for the brows, a calm look.
function World.defaultFace(model,def)
	local head=model:FindFirstChild("Head")
	if not head then return end
	local hx,hy,hz=head.Size.X/2,head.Size.Y/2,head.Size.Z/2
	local saved=Face.BoxProfile
	Face.BoxProfile={{-hy,hx*.96,hz*.99,7},{-hy*.6,hx,hz,9},{hy*.6,hx,hz,9},{hy,hx*.96,hz*.99,7}}
	Face.useShape("box")
	local hair=Color3.fromRGB(table.unpack(def.Hair or {40,32,30}))
	local iris=if def.Iris then Color3.fromRGB(table.unpack(def.Iris)) else Color3.fromRGB(table.unpack(def.Color or {80,70,60})):Lerp(Color3.fromRGB(30,26,30),.45)
	pcall(Face.build,model,{iris=iris,irisDark=iris:Lerp(Color3.new(0,0,0),.5),skin=Color3.fromRGB(table.unpack(def.Skin or {250,224,200})),
		brow=hair:Lerp(Color3.new(0,0,0),.15),lash=Color3.fromRGB(26,22,28),mood="calm",sclera=Vector2.new(.3,.27),eyeX=.3,eyeY=-.04})
	Face.useShape("can")
	Face.BoxProfile=saved
end
-- `def` is the kit; `body` (optional) the look worn (DEC-036). The costume
-- is the look's; the pieces that serve a technique are marked KitItem.
function World.dress(model,def,body)
	def=World.lookDef(body,def)
	soften(model)
	-- The rig's coloured test sash is replaced by each costume's own belt.
	local sash=model:FindFirstChild("Sash");if sash then sash.Transparency=1 end
	-- The 8 main fighters wear the final-beta looks (Server/Looks): body
	-- form, head gear fitted to the head, cone hair, drawn faces.
	local look=Looks.dressers[def.Name]
	if look then
		local hair=model:FindFirstChild("Hair");if hair then hair.Transparency=1 end
		-- Blender meshes when they are loaded (Server/LookMeshes): the face is
		-- then drawn on their squarer head.
		local meshes=LookMeshes.ready(def.Name)
		Face.useShape(if meshes then "box" else "can")
		look(model,def)
		Face.useShape("can")
		if meshes then LookMeshes.dress(model,def.Name) end
	elseif def.Name=="Minato" then dressMinato(model,def) elseif def.Name=="Itachi" then dressItachi(model,def) elseif def.Name=="Neji" then dressNeji(model,def)
	elseif def.Name=="Sasuke" then dressSasuke(model,def) elseif def.Name=="Gaara" then dressGaara(model,def) end
	if not look then
		if def.Name=="Rock Lee" then dressLee(model,def) end
		if def.Name=="Naruto" then dressNaruto(model,def) end
		if def.Name=="Temari" then dressTemari(model,def) end
		local custom=World.dressers[def.Name]
		if custom then custom(model,def) end
	end
	-- (UI pass 02/11, user: "homogeneity... the eyes") The twelve fighters
	-- without a final look kept the rig's black eye bar while the eight others
	-- have drawn faces: every fighter now gets a drawn face, fitted to the
	-- square head (a near-square profile at the head's own half size).
	if not look and not model:FindFirstChild("FaceEye") then World.defaultFace(model,def) end
	-- Hair and head gear never shadow the face; the body still casts.
	local head=model:FindFirstChild("Head")
	for _,p in model:GetChildren() do
		if p:IsA("BasePart") and p.Name~="HumanoidRootPart" then
			local weld=p:FindFirstChildOfClass("WeldConstraint")
			p.CastShadow=not (p==head or (weld and weld.Part0==head))
		end
	end
	World.markKitItems(model,def)
end
-- (DEC-036, AVATAR-001 step 2) The pieces of the worn look that serve one of
-- its prodigy's techniques (Shared/Appearance.KitItems) carry KitItem = that
-- prodigy's id. Marking only: no rule of play reads it yet.
function World.markKitItems(model,lookDef)
	local owner=nil
	for id,d in Fighters do if d==lookDef or (type(d)=="table" and d.Name==lookDef.Name) then owner=id;break end end
	if not owner or not Appearance.KitItems[owner] then return end
	-- (Costume pieces are the model's own children, as dress reads them above.)
	for _,p in model:GetChildren() do
		if p:IsA("BasePart") and Appearance.isKitItem(owner,p.Name) then p:SetAttribute("KitItem",owner) end
	end
end
-- The breadth-pass costume modules get the costume helpers (no require back
-- into World: one install line per module).
local COSTUME_KIT={wear=wear,cyl=cyl,headband=headband,face=face,hairCap=hairCap,spike=spike,rgb=rgb,A=A,R=R}
require(script.Parent.Costumes).install(World.dressers,COSTUME_KIT)
for _,kit in {require(script.Parent.Wave1Kit),require(script.Parent.Wave2Kit),require(script.Parent.Wave3Kit),require(script.Parent.Wave4Kit)} do kit.dress(World.dressers,COSTUME_KIT) end
function World.pose(a,now,dt)
 Animation.step(a,now)
end
return World
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND121">
        <Properties>
          <string name="Name">WorldReaction</string>
          <ProtectedString name="Source">-- Ninja Embodiment (DEC-027, EMB-004): the arena answers what happens in it.
--
-- One shared rule for every contact with the world: a body thrown into a tree,
-- a spike into the floor, a fireball on a boulder, a blade into a trunk, a heavy
-- strike that met a wall instead of a body, a burning zone on the grass. Each is
-- an `impact` with a position, a surface, an energy and a contact kind (blunt,
-- slash, pierce, blast, energy) plus an optional element. The surface's
-- material class decides the answer (a crater in earth, a crack in stone, a cut
-- or a hole in wood, a scorch under fire), wears the part's integrity, and a
-- breakable part that runs out of it breaks (a tree falls, a boulder shatters).
--
-- Nothing here names a fighter or a technique: a new technique gets world
-- reactions by declaring its contact kind / element (spec.world, p.world), or
-- by default from its strike kind or projectile kind.
--
-- Authority and budget: the server owns every scar and break; scars are plain
-- anchored non-colliding parts in the match folder (they replicate on their
-- own and survive round resets: the arena keeps the fight's memory for the
-- whole match), bounded by Config.World.MaxScars (oldest first out), merged
-- into a nearby scar of the same kind instead of stacking, and the rubble of
-- breaks is bounded by Config.World.MaxRubble. A new match builds a new arena.
local Config=require(game:GetService("ReplicatedStorage").NinjaDuel.Config)

local WorldReaction={}

local TUNE=Config.World

-- Material classes (Enum.Material name -&gt; class). A part may override with the
-- WorldMaterial attribute.
WorldReaction.Materials={
	Grass="earth",LeafyGrass="earth",Ground="earth",Mud="earth",Sand="earth",Snow="earth",
	Wood="wood",WoodPlanks="wood",
	Slate="stone",Rock="stone",Basalt="stone",Granite="stone",Concrete="stone",Brick="stone",Cobblestone="stone",
	Pavement="stone",Limestone="stone",Sandstone="stone",Marble="stone",CrackedLava="stone",
	Ice="brittle",Glass="brittle",Neon="brittle",
	Metal="metal",DiamondPlate="metal",CorrodedMetal="metal",
}
-- Per class: base integrity (a 2.6-stud-thick part; scaled by its thickness),
-- the scar colors, and how the class takes each contact kind:
--   wear: integrity lost per unit of energy; scar: the mark it leaves.
WorldReaction.Classes={
	earth={integrity=math.huge,dark=Color3.fromRGB(88,70,52),burn=Color3.fromRGB(34,30,26),
		blunt={wear=0,scar="crater"},slash={wear=0,scar="furrow"},pierce={wear=0,scar="puncture"},
		blast={wear=0,scar="crater"},energy={wear=0,scar="trench"}},
	wood={integrity=120,dark=Color3.fromRGB(62,44,30),burn=Color3.fromRGB(26,22,20),
		blunt={wear=.8,scar="crack"},slash={wear=1,scar="cut"},pierce={wear=.25,scar="puncture"},
		blast={wear=1.1,scar="splinter"},energy={wear=1.4,scar="hole"}},
	stone={integrity=200,dark=Color3.fromRGB(84,80,74),burn=Color3.fromRGB(40,38,36),
		blunt={wear=.7,scar="crack"},slash={wear=.35,scar="scratch"},pierce={wear=.08,scar="chip"},
		blast={wear=.8,scar="crater"},energy={wear=1,scar="gouge"}},
	brittle={integrity=30,dark=Color3.fromRGB(180,200,210),burn=Color3.fromRGB(60,60,60),
		blunt={wear=1.4,scar="crack"},slash={wear=1,scar="crack"},pierce={wear=1,scar="crack"},
		blast={wear=1.6,scar="crack"},energy={wear=1.6,scar="crack"}},
	metal={integrity=math.huge,dark=Color3.fromRGB(70,70,74),burn=Color3.fromRGB(30,30,32),
		blunt={wear=0,scar="dent"},slash={wear=0,scar="scratch"},pierce={wear=0,scar=nil},
		blast={wear=0,scar="dent"},energy={wear=0,scar="gouge"}},
}
-- Elements add their own mark and wear on top of the contact.
--   fire: scorches anything, burns wood faster; lightning: chars and drills;
--   wind: cuts; water: darkens (wet) and puts out nothing here (no fire state).
WorldReaction.Elements={
	fire={scar="scorch",wear={wood=1.6,earth=0,stone=.4,brittle=1,metal=0}},
	lightning={scar="char",wear={wood=1.3,earth=0,stone=1.1,brittle=1.5,metal=0}},
	wind={scar="cut",wear={wood=.8,earth=0,stone=.3,brittle=1,metal=0}},
	water={scar="wet",wear={wood=0,earth=0,stone=0,brittle=0,metal=0}},
}
-- Strike kinds (Attacks spec.kind) -&gt; contact kind.
WorldReaction.StrikeKinds={slash="slash",tenketsu="pierce",palm="blunt",kick="blunt",strike="blunt",heavy="blunt",
	launch="blunt",sweep="blunt",spike="blunt"}
-- Projectile kinds -&gt; contact kind and element (a family projectile declares
-- its own with spec.World / p.world).
WorldReaction.Projectiles={
	shuriken={contact="pierce"},kunai={contact="pierce"},marked={contact="pierce"},needle={contact="pierce"},
	senbon={contact="pierce"},tool={contact="pierce"},wire={contact="slash"},bone={contact="pierce"},
	fireball={contact="blast",element="fire"},phoenix={contact="blast",element="fire"},
	wind={contact="slash",element="wind"},gale={contact="slash",element="wind"},kamatari={contact="slash",element="wind"},
	palm={contact="blunt"},sand={contact="blunt"},
}

-- ------------------------------------------------------------------ records
local function state(c)
	local w=c.world
	if not w then
		w={parts=setmetatable({},{__mode="k"}),scars={},rubble={},embeds={},
			stats={impacts=0,scars=0,merged=0,breaks=0,smash=0,embeds=0}}
		c.world=w
	end
	return w
end
WorldReaction.state=state

function WorldReaction.classOf(part)
	local declared=part:GetAttribute("WorldMaterial")
	if declared and WorldReaction.Classes[declared] then return declared end
	local name=part.Material and part.Material.Name or "Plastic"
	return WorldReaction.Materials[name]
end
-- Thickness factor: a thin plank breaks sooner than a trunk, a big boulder later.
local function thickness(part)
	local s=part.Size
	local thin=math.min(s.X,s.Y,s.Z)
	return math.clamp(thin/2.6,.6,2.2)
end
function WorldReaction.record(c,part)
	local w=state(c)
	local rec=w.parts[part]
	if rec then return rec end
	local class=WorldReaction.classOf(part)
	if not class then return nil end
	local base=WorldReaction.Classes[class].integrity
	local max=if base==math.huge then math.huge else base*thickness(part)
	-- A prop may declare its own (a crate goes to one heavy blow).
	local declared=part:GetAttribute("WorldToughness")
	if type(declared)=="number" then max=declared end
	rec={class=class,max=max,integrity=max,state="Intact",breakable=part:GetAttribute("WorldBreakable")==true,color=part.Color}
	w.parts[part]=rec
	return rec
end

-- ------------------------------------------------------------------ scars
local function folderOf(c)
	local w=state(c)
	if w.folder and w.folder.Parent then return w.folder end
	local root=c.match and (c.match.folder or (c.match.effects and c.match.effects.Parent))
	if not root then return nil end
	local f=Instance.new("Folder");f.Name="WorldMemory";f.Parent=root
	w.folder=f
	return f
end
-- A deterministic "random" from a position (the same impact draws the same
-- crack on every server; nothing about the world uses math.random).
local function hash(v)
	local x=math.sin(v.X*12.9898+v.Y*78.233+v.Z*37.719)*43758.5453
	return x-math.floor(x)
end
-- An orthonormal frame on the surface: X along the normal.
local function surfaceFrame(position,normal,along)
	local n=if normal.Magnitude&gt;.01 then normal.Unit else Vector3.yAxis
	local t=along and (along-n*along:Dot(n)) or nil
	if not t or t.Magnitude&lt;.05 then
		t=n:Cross(if math.abs(n.Y)&lt;.9 then Vector3.yAxis else Vector3.xAxis)
	end
	t=t.Unit
	return CFrame.fromMatrix(position,n,t)
end
-- Scar shapes: size grows with energy, capped per kind.
local SHAPES={
	crater={round=true,depth=.1,grow=1/8,min=2.2,max=8},
	trench={round=false,depth=.1,grow=1/16,min=1.2,max=6,width=.9},
	furrow={round=false,depth=.08,grow=1/14,min=1.4,max=5,width=.35},
	puncture={round=true,depth=.08,grow=0,min=.35,max=.5},
	crack={round=false,depth=.06,grow=1/14,min=1,max=4.2,width=.18,cross=true},
	cut={round=false,depth=.06,grow=1/12,min=1.2,max=4.5,width=.14},
	scratch={round=false,depth=.05,grow=1/18,min=.8,max=3,width=.08},
	splinter={round=true,depth=.12,grow=1/26,min=.8,max=2.4},
	hole={round=true,depth=.14,grow=1/30,min=.7,max=2},
	chip={round=true,depth=.06,grow=0,min=.4,max=.6},
	gouge={round=true,depth=.12,grow=1/26,min=.7,max=2.4},
	dent={round=true,depth=.05,grow=1/30,min=.6,max=1.8},
	scorch={round=true,depth=.04,grow=1/14,min=1.4,max=7,burn=true,transparency=.12},
	char={round=true,depth=.04,grow=1/18,min=1,max=4,burn=true,transparency=.08},
	wet={round=true,depth=.03,grow=1/12,min=1.6,max=6,transparency=.45},
	-- (06/11) the furrow a body ploughs sliding on its back: wide, shallow,
	-- in relief (the ground pushed up on both sides), its own budget
	skid={round=false,depth=.06,grow=1/20,min=1.2,max=2.6,width=.7},
}
WorldReaction.Shapes=SHAPES
local function scarSize(kind,energy)
	local s=SHAPES[kind]
	return math.clamp(s.min+energy*s.grow,s.min,s.max)
end
local function evict(list,max)
	while #list&gt;max do
		local old=table.remove(list,1)
		if old.part then old.part:Destroy() end
	end
end
local RELIEF={crater=true,gouge=true,trench=true,crack=true,skid=true}
local okCS,CS=pcall(function() return game:GetService("CollectionService") end)
if not okCS then CS=nil end
-- What the ground looks like at a point: the topmost flat skin over the floor
-- there (World's earth and grass discs), else the surface itself.
function WorldReaction.skinAt(position,surface)
	local best,bestY=nil,-math.huge
	for _,p in (if CS then CS:GetTagged("NinjaGroundSkin") else {}) do
		if p.Parent then
			local r=math.max(p.Size.Y,p.Size.Z)*.5
			local d=Vector3.new(p.Position.X-position.X,0,p.Position.Z-position.Z).Magnitude
			if d&lt;=r and math.abs(p.Position.Y-position.Y)&lt;1.5 and p.Position.Y&gt;bestY then best,bestY=p,p.Position.Y end
		end
	end
	if best then return best.Material,best.Color end
	if typeof(surface)=="Instance" and surface:IsA("BasePart") then return surface.Material,surface.Color end
	return Enum.Material.Ground,Color3.fromRGB(120,96,70)
end
local function chunk(parent,cf,size,material,color)
	local c=Instance.new("Part")
	c.Name="Scar chunk";c.Anchored=true;c.CanCollide=false;c.CanQuery=false;c.CanTouch=false;c.CastShadow=true
	c.Size=size;c.CFrame=cf;c.Material=material;c.Color=color
	c.TopSurface=Enum.SurfaceType.Smooth;c.BottomSurface=Enum.SurfaceType.Smooth
	c.Parent=parent
	return c
end
-- (Studio check 28/10: the first relief was a ring of small green grass cubes
-- round a black ink star, too small for a Great Fireball.) Broken ground in
-- the series (a Rasengan, a Chidori into the floor, Lee's kicks): a bowl
-- pushed down, SLABS of the same ground torn up round it and leaning out,
-- loose stones, and a few cracks running out of the rim as real grooves.
local function relief(scar,palette)
	local p=scar.part
	for _,ch in p:GetChildren() do if ch.Name=="Scar chunk" then ch:Destroy() end end
	local material,skin=WorldReaction.skinAt(scar.position,scar.surface)
	-- Grass breaks into the earth under it.
	if material==Enum.Material.Grass then material=Enum.Material.Ground;skin=skin:Lerp(Color3.fromRGB(110,88,62),.7) end
	-- (06/11, user: « c'est pas encore des vrais blocs de pierre qui se
	-- cassent ») the arena's packed earth is a flat SmoothPlastic for its look,
	-- and Ground at its colour renders a dark olive brown (Studio 06/11: a pile
	-- of chocolate cubes on the light floor). Broken, it is blocks of packed,
	-- stony earth of the floor's own colour: Sandstone.
	if material==Enum.Material.SmoothPlastic or material==Enum.Material.Plastic then material=Enum.Material.Sandstone end
	local slab=skin:Lerp(Color3.new(0,0,0),.12)
	local under=skin:Lerp(palette.dark,.6)
	-- The bowl itself: the torn ground, darker, never black.
	p.Material=material;p.Color=under
	local size=scar.size
	local base=scar.frame*CFrame.new(-SHAPES[scar.kind].depth*.5,0,0)
	local seed=scar.position
	if scar.kind=="skid" then
		-- (06/11, Studio: slabs along a slide read as piles of planks) A body
		-- ploughing the ground leaves a furrow: the groove a shade darker than
		-- the floor, the earth pushed up into a low lip on both sides.
		p.Color=skin:Lerp(palette.dark,.4);p.Transparency=.1
		local width=SHAPES.skid.width or .7
		for _,sideSign in {1,-1} do
			local h=hash(seed+Vector3.new(sideSign,2,3))
			chunk(p,base*CFrame.new(.05,sideSign*(width*.5+.12),0)*CFrame.Angles(sideSign*math.rad(24+h*12),0,0),
				Vector3.new(.12,.3,size*(.85+h*.2)),material,slab)
		end
		return
	end
	if SHAPES[scar.kind].round then
		-- (06/11, user: « les cratères sont mieux mais trop répétitifs », « les
		-- fissures noires reviennent trop souvent ») Every crater was the same
		-- star: the same frame on a flat floor, its slabs evenly round it, its
		-- 3-6 black cracks at the same angles. Each one now has its own turn,
		-- its own oval, gaps in its rim (a side that held), its slabs leaning
		-- more or less, and at most two cracks, of the torn ground's colour, a
		-- small one none at all.
		local r=size*.5
		local spin=hash(seed+Vector3.new(9,1,4))*math.pi*2
		local squash=.72+hash(seed+Vector3.new(2,8,5))*.28
		local lean=18+hash(seed+Vector3.new(6,3,7))*26
		local function around(a,d)
			return math.cos(a+spin)*d,math.sin(a+spin)*d*squash
		end
		-- Slabs round the rim: wide, thin, their outer edge up.
		local n=math.clamp(math.floor(3+size*(.9+hash(seed+Vector3.new(4,4,1))*.7)),5,12)
		local gapAt=hash(seed+Vector3.new(1,6,2))*math.pi*2
		local gapWidth=.6+hash(seed+Vector3.new(3,2,9))*1.2
		for k=1,n do
			local h=hash(seed+Vector3.new(k,k*1.7,k*2.3))
			local a=(k/n)*math.pi*2+(h-.5)*1.1
			local off=math.abs((a-gapAt+math.pi)%(2*math.pi)-math.pi)
			if off&gt;=gapWidth*.5 and h&gt;.12 then
				local w=r*(.45+h*.5)
				local y,z=around(a,r*(.88+h*.2))
				local at=base*CFrame.new(.12+h*.15,y,z)
				-- face the centre, then lift the outer edge (pitch about the tangent)
				local cf=at*CFrame.Angles(a+spin,0,0)*CFrame.Angles(0,0,math.rad(lean+h*24))
				-- plates, not blocks (Studio: thick ones read as boxes)
				chunk(p,cf,Vector3.new(.16+h*.16,w*(.6+h*.3),w),material,if k%3==0 then under else slab)
			end
		end
		-- Loose stones thrown just outside, more on one side.
		local throw=hash(seed+Vector3.new(7,7,2))*math.pi*2
		for k=1,math.clamp(math.floor(size*(.8+hash(seed+Vector3.new(5,1,1)))),2,8) do
			local h=hash(seed+Vector3.new(k*5,k*.3,k*1.1))
			local a=throw+(h-.5)*3.4
			local y,z=around(a,r*(1.05+h*.8))
			local st=.22+h*.4
			chunk(p,base*CFrame.new(st*.4,y,z)*CFrame.Angles(h*3,h*5,h*2),Vector3.new(st,st*1.2,st*.9),material,slab)
		end
		-- At most two cracks out of the rim, none for a small crater: grooves of
		-- the torn ground's colour, three segments each that turn and narrow.
		local cracks=if size&lt;3.2 then 0 else math.floor(hash(seed+Vector3.new(8,2,6))*3)
		local groove=under:Lerp(palette.dark,.35)
		for k=1,cracks do
			local h=hash(seed+Vector3.new(k*7,k*3,k))
			local a=spin+h*math.pi*2
			local len=r*(.4+h*.7)/3
			local y,z=around(a-spin,r*.92)
			-- (turned a quarter: the groove runs out from the rim, not along it)
			local at=base*CFrame.new(.015,y,z)*CFrame.Angles(a-math.pi/2,0,0)
			for seg=1,3 do
				local turn=math.rad((hash(seed+Vector3.new(k,seg*2.1,seg))-.5)*50)
				at=at*CFrame.Angles(turn,0,0)
				chunk(p,at*CFrame.new(0,0,len*.5),Vector3.new(.03,.16-seg*.035,len*1.05),Enum.Material.SmoothPlastic,groove)
				at=at*CFrame.new(0,0,len)
			end
		end
	else
		-- A crack / trench: the line itself dark, the ground on both sides
		-- broken into slabs pushed up and apart.
		-- (06/11) fewer, bigger slabs, thick and half sunk, their inner edge
		-- lifted out of the line (Studio: many small slabs read as a pile of
		-- cubes), and a few loose stones thrown along it.
		local width=(SHAPES[scar.kind].width or .3)
		local n=math.clamp(math.floor(2+size*.7),3,6)
		for k=1,n do
			local h=hash(seed+Vector3.new(k*3,k,k*.5))
			local z=(k/(n+1)-.5)*size*1.05
			local sideSign=if k%2==0 then 1 else -1
			local len=size/n*(1.15+h*.45)
			local w=math.max(.7,width*2+size*.14)*(.8+h*.45)
			local thick=.32+h*.3
			local at=base*CFrame.new(thick*.12,sideSign*(width*.5+w*.42),z)
			local cf=at*CFrame.Angles(sideSign*math.rad(14+h*22),0,0)*CFrame.Angles(0,math.rad((h-.5)*16),0)
			chunk(p,cf,Vector3.new(thick,w,len),material,if k%3==0 then under else slab)
		end
		for k=1,math.clamp(math.floor(size*.8),2,5) do
			local h=hash(seed+Vector3.new(k*5.3,k*.7,k*2.9))
			local sideSign=if h&gt;.5 then 1 else -1
			local st=.22+h*.3
			chunk(p,base*CFrame.new(st*.35,sideSign*(width+.5+h*1.2),(h-.5)*size*.9)*CFrame.Angles(h*4,h*6,h*3),Vector3.new(st,st*1.3,st),material,slab)
		end
	end
end
local function draw(scar,class)
	local s=SHAPES[scar.kind]
	local p=scar.part
	local palette=WorldReaction.Classes[class] or WorldReaction.Classes.stone
	if s.round then
		p.Shape=Enum.PartType.Cylinder
		p.Size=Vector3.new(s.depth,scar.size,scar.size)
		p.CFrame=scar.frame
	else
		p.Shape=Enum.PartType.Block
		p.Size=Vector3.new(s.depth,s.width or .2,scar.size)
		p.CFrame=scar.frame
	end
	p.Color=if scar.kind=="wet" then Color3.fromRGB(40,52,64) elseif s.burn then palette.burn else palette.dark
	p.Transparency=s.transparency or 0
	-- (User 28/10: "it does not crack the ground, it prints something on it".)
	-- A crater, a gouge, a trench or a crack is drawn in RELIEF: the floor's own
	-- material is broken and lifted - a lip of tilted chunks round a crater, the
	-- slabs on both sides of a crack pushed up and apart - over the dark recess.
	if RELIEF[scar.kind] then relief(scar,palette) end
end
-- Leave (or deepen) a scar. Returns the scar entry.
-- (08/11, F7 tool: a crater floating 33 studs up, on the courtyard's invisible
-- boundary) A mark is drawn only on what the eye sees. An invisible collider
-- (the courtyard's Boundary, a field tree's box round its Blender mesh)
-- carries none; its wear still counts, so a tree still cracks and falls.
WorldReaction.INVISIBLE=.95
function WorldReaction.visible(part)
	return not (part and part:IsA("BasePart") and part.Transparency&gt;=WorldReaction.INVISIBLE)
end
function WorldReaction.scar(c,kind,surface,position,normal,energy,along,class)
	if not SHAPES[kind] or not WorldReaction.visible(surface) then return nil end
	local w=state(c)
	-- The same mark close to an old one deepens it instead of stacking parts.
	for k=#w.scars,1,-1 do
		local old=w.scars[k]
		if old.kind==kind and old.surface==surface and (old.position-position).Magnitude&lt;math.max(.8,old.size*.45) then
			old.size=math.min(SHAPES[kind].max,old.size+math.max(.15,scarSize(kind,energy)*.25))
			old.marks+=1
			old.energy=math.max(old.energy or 0,energy)
			old.expires=c.now+WorldReaction.life(old)
			if old.part then draw(old,old.class) end
			w.stats.merged+=1
			-- Most recent stays last: it is the freshest memory.
			table.remove(w.scars,k);table.insert(w.scars,old)
			return old
		end
	end
	-- (06/11, Studio: every Great Fireball left a crater AND a crack at its
	-- centre, slabs and dark lines piled in the bowl) One blow, one break: a
	-- crack inside a crater is the crater's; a new crater takes the cracks
	-- already in its bowl.
	if kind=="crack" or kind=="cut" or kind=="scratch" then
		for _,old in w.scars do
			if (old.kind=="crater" or old.kind=="gouge") and old.part and old.surface==surface and (old.position-position).Magnitude&lt;old.size*.5 then return old end
		end
	elseif kind=="crater" then
		local reach=scarSize(kind,energy)*.5
		for k=#w.scars,1,-1 do
			local old=w.scars[k]
			if (old.kind=="crack" or old.kind=="cut" or old.kind=="scratch") and old.surface==surface and (old.position-position).Magnitude&lt;reach then
				table.remove(w.scars,k);WorldReaction.fade(c,old)
			end
		end
	end
	local folder=folderOf(c)
	-- Clear of the surface: a flush mark z-fought into a dark ring outline.
	local lift=SHAPES[kind].depth*.5+.06
	local frame=surfaceFrame(position+normal*lift,normal,along)
	if not SHAPES[kind].round and not along then
		-- An unaimed crack runs in a direction drawn from where it is.
		frame=frame*CFrame.Angles(math.pi*2*hash(position),0,0)
	end
	local size=scarSize(kind,energy)
	-- (06/11) craters of one size read as stamps: each its own, within a third
	if kind=="crater" or kind=="gouge" then size*=.74+hash(position+Vector3.new(3,1,7))*.34 end
	local entry={kind=kind,surface=surface,position=position,normal=normal,size=size,frame=frame,class=class,marks=1,at=c.now,
		energy=energy,floor=normal.Y&gt;.6}
	entry.expires=c.now+WorldReaction.life(entry)
	if folder then
		local p=Instance.new("Part")
		p.Name="Scar "..kind;p.Anchored=true;p.CanCollide=false;p.CanQuery=false;p.CanTouch=false;p.CastShadow=false
		p.Material=Enum.Material.SmoothPlastic
		p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth
		entry.part=p
		draw(entry,class)
		p:SetAttribute("WorldScar",kind)
		p.Parent=folder
		if SHAPES[kind].cross then
			-- A crack branches once (a second thin line, same part budget: it
			-- is drawn as a child of the first and leaves with it).
			local branch=Instance.new("Part")
			branch.Name="Scar branch";branch.Anchored=true;branch.CanCollide=false;branch.CanQuery=false;branch.CanTouch=false;branch.CastShadow=false
			branch.Size=Vector3.new(p.Size.X,p.Size.Y,p.Size.Z*.55);branch.Color=p.Color;branch.Material=p.Material
			branch.CFrame=frame*CFrame.Angles(.5+hash(position+Vector3.one)*.6,0,0)*CFrame.new(0,0,p.Size.Z*.22)
			branch.Parent=p
		end
	end
	table.insert(w.scars,entry)
	w.stats.scars+=1
	if kind=="skid" then
		-- Skids have their own budget (a slide lays several): they never push
		-- a crater or a scorch out of the floor's.
		entry.expires=c.now+TUNE.Skid.Fade
		local n=0
		for _,s2 in w.scars do if s2.kind=="skid" then n+=1 end end
		while n&gt;TUNE.Skid.Max do
			for k,s2 in w.scars do
				if s2.kind=="skid" then table.remove(w.scars,k);WorldReaction.fade(c,s2);n-=1;break end
			end
		end
	elseif entry.floor then
		-- The floor's own budget: the oldest floor mark leaves first.
		local n=0
		for _,s2 in w.scars do if s2.floor and s2.kind~="skid" then n+=1 end end
		while n&gt;TUNE.MaxFloorScars do
			for k,s2 in w.scars do
				if s2.floor and s2.kind~="skid" then table.remove(w.scars,k);WorldReaction.fade(c,s2);n-=1;break end
			end
		end
	end
	evict(w.scars,TUNE.MaxScars)
	return entry
end
-- How long a mark stays: a heavy one (or one deepened again and again) for
-- the fight's big moments, a lesser one only for the exchange that made it.
function WorldReaction.life(scar)
	local major=(scar.energy or 0)&gt;=TUNE.MajorEnergy or (scar.marks or 1)&gt;=3
	return if major then TUNE.Fade.Major else TUNE.Fade.Minor
end
-- A mark leaving: it sinks back into the floor (fades) instead of popping.
local okTween,Tween=pcall(function() return game:GetService("TweenService") end)
if not okTween then Tween=nil end
function WorldReaction.fade(c,scar)
	local p=scar.part
	scar.part=nil
	if not p then return end
	if Tween and typeof and typeof(p)=="Instance" then
		local info=TweenInfo.new(TUNE.Fade.Out,Enum.EasingStyle.Quad,Enum.EasingDirection.In)
		for _,d in p:GetDescendants() do
			if d:IsA("BasePart") then Tween:Create(d,info,{Transparency=1}):Play()
			elseif d:IsA("Decal") then Tween:Create(d,info,{Transparency=1}):Play() end
		end
		Tween:Create(p,info,{Transparency=1}):Play()
		task.delay(TUNE.Fade.Out+.05,function() p:Destroy() end)
	else
		p:Destroy()
	end
end
-- Once per server step: the marks whose time has come fade out.
function WorldReaction.step(c)
	local w=c.world
	if not w then return end
	for k=#w.scars,1,-1 do
		local scar=w.scars[k]
		if scar.expires and c.now&gt;=scar.expires then
			table.remove(w.scars,k)
			WorldReaction.fade(c,scar)
			w.stats.faded=(w.stats.faded or 0)+1
		end
	end
end

-- ------------------------------------------------------------------ breaks
local function rubble(c,at,size,color,material,direction)
	local w=state(c)
	local folder=folderOf(c)
	if not folder then return end
	for k=1,TUNE.RubblePerBreak do
		local h=hash(at+Vector3.new(k,k*2,k*3))
		local a=(k/TUNE.RubblePerBreak+h*.3)*math.pi*2
		local r=size*(.5+h*.7)
		local push=direction*size*.6
		local s=size*(.22+h*.18)
		local p=Instance.new("Part")
		p.Name="Rubble";p.Anchored=true;p.CanCollide=false;p.CanQuery=false;p.CanTouch=false
		p.Size=Vector3.new(s,s*.7,s*.9);p.Color=color;p.Material=material
		p.CFrame=CFrame.new(Vector3.new(at.X+math.cos(a)*r+push.X,at.Y+s*.3,at.Z+math.sin(a)*r+push.Z))*CFrame.Angles(h*3,a,h*2)
		p.Parent=folder
		table.insert(w.rubble,{part=p})
	end
	evict(w.rubble,TUNE.MaxRubble)
end
-- A tall part (a trunk) falls away from the blow; a squat one (a boulder)
-- shatters into a low mound. Either way what is left is low: it no longer
-- hides a body, stops a blade at head height or takes a wall splat.
function WorldReaction.breakPart(c,part,rec,at,direction)
	local w=state(c)
	rec.state="Broken";rec.integrity=0
	part:SetAttribute("WorldState","Broken");part:SetAttribute("WorldIntegrity",0)
	w.stats.breaks+=1
	-- The marks it carried belonged to the old shape: they go with it (the
	-- rubble and the stump are its memory now).
	for k=#w.scars,1,-1 do
		local scar=w.scars[k]
		if scar.surface==part then
			if scar.part then scar.part:Destroy() end
			table.remove(w.scars,k)
		end
	end
	local flat=Vector3.new(direction.X,0,direction.Z)
	flat=if flat.Magnitude&gt;.05 then flat.Unit else Vector3.xAxis
	local size,cf=part.Size,part.CFrame
	local bottom=cf.Position.Y-size.Y/2
	if size.Y&gt;math.max(size.X,size.Z)*2 then
		local cut=TUNE.StumpHeight
		local base=Vector3.new(cf.Position.X,bottom,cf.Position.Z)
		part.Size=Vector3.new(size.X,cut,size.Z)
		part.CFrame=CFrame.new(base+Vector3.new(0,cut/2,0))*cf.Rotation
		-- The rest of the trunk (and everything it carries) tips over the cut.
		local pivot=CFrame.new(base+Vector3.new(0,cut,0))
		local axis=Vector3.yAxis:Cross(flat).Unit
		local fall=pivot*CFrame.fromAxisAngle(axis,math.rad(84))*pivot:Inverse()
		local log=Instance.new("Part")
		log.Name="Fallen "..part.Name;log.Anchored=true;log.CanCollide=false;log.CanQuery=false;log.CanTouch=false
		log.Size=Vector3.new(size.X,size.Y-cut,size.Z);log.Color=part.Color;log.Material=part.Material
		log.CFrame=fall*CFrame.new(base+Vector3.new(0,cut+(size.Y-cut)/2,0))
		log.Parent=folderOf(c) or part
		for _,child in part:GetChildren() do
			if child:IsA("BasePart") then child.CFrame=fall*child.CFrame;child.CanCollide=false end
		end
		WorldReaction.scar(c,"crater",nil,base+flat*(size.Y*.55),Vector3.yAxis,40,flat,"earth")
	else
		local keep=TUNE.MoundShare
		part.Size=Vector3.new(size.X*.9,size.Y*keep,size.Z*.9)
		part.CFrame=CFrame.new(Vector3.new(cf.Position.X,bottom+size.Y*keep/2,cf.Position.Z))*cf.Rotation
		for _,child in part:GetChildren() do
			if child:IsA("BasePart") then
				child.Size*=.55;child.CanCollide=false
				child.CFrame=CFrame.new(Vector3.new(child.Position.X,bottom+child.Size.Y*.4,child.Position.Z)+flat*size.X*.4)*child.CFrame.Rotation
			end
		end
	end
	part.Color=WorldReaction.Classes[rec.class].dark:Lerp(rec.color,.5)
	rubble(c,Vector3.new(at.X,bottom,at.Z),math.max(1,math.min(size.X,size.Z)*.5),part.Color,part.Material,flat)
	c:pushImpact(at,"worldbreak",true,{normal=-flat,material=rec.class,direction=flat})
end

-- ------------------------------------------------------------------ impacts
-- hit: {part, position, normal, energy, contact, element, direction, source}
-- Returns {class, scar, wear, state, broken} or nil (no material: a body, a
-- prop without a class, or too little energy to mark anything).
function WorldReaction.impact(c,hit)
	local part=hit.part
	if not part or not part.Parent or part:GetAttribute("WorldScar") then return nil end
	local rec=WorldReaction.record(c,part)
	if not rec then return nil end
	local w=state(c)
	local energy=hit.energy or 0
	local contact=hit.contact or "blunt"
	local profile=WorldReaction.Classes[rec.class]
	local answer=profile[contact] or profile.blunt
	local element=hit.element and WorldReaction.Elements[hit.element]
	w.stats.impacts+=1
	if energy&lt;TUNE.MinEnergy then return nil end
	local normal=hit.normal or Vector3.yAxis
	local position=hit.position
	local direction=hit.direction or -normal
	-- The mark of the contact, then the mark of the element. The floor keeps
	-- only what weighed something (TUNE.GroundEnergy / GroundElement): the
	-- arena tells the fight without turning into a minefield. A zone (a
	-- burning patch) leaves its element's mark, never a crater.
	local scar=answer.scar
	local floor=normal.Y&gt;.6
	local entry=nil
	if scar and not hit.zone and (not floor or energy&gt;=TUNE.GroundEnergy) then
		entry=WorldReaction.scar(c,scar,part,position,normal,energy,if contact=="slash" or contact=="energy" then direction else nil,rec.class)
	end
	if element and element.scar and (not floor or energy&gt;=TUNE.GroundElement) then WorldReaction.scar(c,element.scar,part,position+normal*.02,normal,energy,nil,rec.class) end
	if contact=="pierce" and (rec.class=="wood" or rec.class=="earth") then
		-- A blade that stays: a world fact (an anchor a technique can read).
		table.insert(w.embeds,{position=position,normal=normal,part=part,owner=hit.source,at=c.now})
		w.stats.embeds+=1
		while #w.embeds&gt;TUNE.MaxEmbeds do table.remove(w.embeds,1) end
	end
	-- Wear.
	local wear=energy*answer.wear
	if element then wear+=energy*(element.wear[rec.class] or 0)*.5 end
	local result={class=rec.class,scar=scar,element=hit.element,wear=wear,state=rec.state,broken=false}
	if rec.state=="Broken" or rec.max==math.huge or wear&lt;=0 then return result end
	rec.integrity=math.max(0,rec.integrity-wear)
	local share=rec.integrity/rec.max
	part:SetAttribute("WorldIntegrity",math.floor(share*100+.5)/100)
	if rec.state=="Intact" and share&lt;=TUNE.CrackedShare then
		rec.state="Cracked";part:SetAttribute("WorldState","Cracked")
		part.Color=rec.color:Lerp(profile.dark,.35)
	end
	if share&lt;=0 then
		if rec.breakable then
			WorldReaction.breakPart(c,part,rec,position,direction)
			result.broken=true
		else
			-- A structural surface (the stadium wall, the floor) never goes:
			-- it keeps a sliver and carries its marks.
			rec.integrity=rec.max*.02
		end
	end
	result.state=rec.state
	return result
end

-- ------------------------------------------------------------------ hooks
-- A body carried into a surface (a wall splat, a knockback into a tree).
-- `velocity` (optional): the body's flight, the way a broken trunk falls.
-- Returns the impact result.
function WorldReaction.body(c,a,hit,speed,velocity)
	if speed&lt;TUNE.BodySpeed then return nil end
	-- A body pressed against the same surface frame after frame hit it once.
	if a.worldHitPart==hit.Instance and c.now-(a.worldHitAt or -1)&lt;TUNE.BodyRepeat then return nil end
	a.worldHitPart=hit.Instance;a.worldHitAt=c.now
	local energy=speed*TUNE.BodyEnergy
	local result=WorldReaction.impact(c,{part=hit.Instance,position=hit.Position,normal=hit.Normal,energy=energy,contact="blunt",
		direction=if velocity and velocity.Magnitude&gt;.1 then velocity.Unit else -hit.Normal,source=a.reactionSource and a.reactionSource.id})
	if result and result.broken then state(c).stats.smash+=1 end
	return result
end
-- A body slammed onto the floor (spike, landed slam).
function WorldReaction.landing(c,a,hit,fall)
	if fall&lt;TUNE.LandingSpeed then return nil end
	if a.worldHitPart==hit.Instance and c.now-(a.worldHitAt or -1)&lt;TUNE.BodyRepeat then return nil end
	a.worldHitPart=hit.Instance;a.worldHitAt=c.now
	return WorldReaction.impact(c,{part=hit.Instance,position=Vector3.new(a.root.Position.X,hit.Position.Y,a.root.Position.Z),normal=hit.Normal,
		energy=fall*TUNE.BodyEnergy,contact="blunt",source=a.reactionSource and a.reactionSource.id})
end
-- (06/11) A blow that throws a body (a knockback, a launcher, a heavy) tears
-- the ground where its feet were: a crack for a push, a small crater for a
-- launch up. Only blows strong enough (TUNE.Blow.Speed) and grounded bodies.
local BLOW_EVERY=1.5
function WorldReaction.blow(c,a,velocity,kind)
	if not velocity or a.airborne then return nil end
	local speed=velocity.Magnitude
	-- a body taken off its feet (a sweep) hits the ground even when the blow is slow
	-- (06/11, user: « les fissures noires reviennent trop souvent ») a plain
	-- push needs a big one now (half again the launch threshold), and a body
	-- tears the ground at most once in BLOW_EVERY seconds.
	local need=if kind=="Knockdown" then TUNE.Blow.Speed*.4 elseif kind=="Knockback" then TUNE.Blow.Speed*1.5 else TUNE.Blow.Speed
	if speed&lt;need or c.now-(a.blowMarkAt or -math.huge)&lt;BLOW_EVERY then return nil end
	local hit=workspace:Raycast(a.root.Position,Vector3.new(0,-4.2,0),c:rayParams(true))
	if not hit or hit.Normal.Y&lt;.6 then return nil end
	local rec=WorldReaction.record(c,hit.Instance)
	if not rec then return nil end
	a.blowMarkAt=c.now
	local flat=Vector3.new(velocity.X,0,velocity.Z)
	local up=kind=="Launched" or velocity.Y&gt;flat.Magnitude
	local energy=math.max(speed*TUNE.Blow.Energy,if kind=="Knockdown" then 40 else 0)
	return WorldReaction.scar(c,if up then "crater" else "crack",hit.Instance,hit.Position,hit.Normal,energy,
		if flat.Magnitude&gt;.1 then flat.Unit else nil,rec.class)
end
-- (06/11) A body sliding on the floor ploughs it: a skid mark every
-- TUNE.Skid.Every seconds along its slide.
function WorldReaction.skid(c,a,skid)
	local speed=skid.Magnitude
	if speed&lt;TUNE.Skid.Speed or c.now-(a.skidMarkAt or -1)&lt;TUNE.Skid.Every then return nil end
	a.skidMarkAt=c.now
	local hit=workspace:Raycast(a.root.Position,Vector3.new(0,-4.2,0),c:rayParams(true))
	if not hit or hit.Normal.Y&lt;.6 then return nil end
	local rec=WorldReaction.record(c,hit.Instance)
	if not rec then return nil end
	return WorldReaction.scar(c,"skid",hit.Instance,hit.Position-skid.Unit*.6,hit.Normal,speed*2,skid.Unit,rec.class)
end
-- (06/11, user: « beaucoup d'attaques restent dans le ciel et pas sur le
-- sol ») A big thing that lands ON A BODY (a Great Fireball, a Water Dragon,
-- an Earth Dragon, a Rasengan's wave...) used to leave nothing: only a flight
-- that reached a surface marked the world. The ground under the body takes
-- the blow now, by the same rules (contact, element, the floor's threshold).
function WorldReaction.below(c,position,energy,contact,element,direction)
	local hit=workspace:Raycast(position+Vector3.new(0,1,0),Vector3.new(0,-9,0),c:rayParams(true))
	if not hit or hit.Normal.Y&lt;.6 then return nil end
	return WorldReaction.impact(c,{part=hit.Instance,position=hit.Position,normal=hit.Normal,energy=energy,contact=contact or "blunt",
		element=element,direction=direction})
end
function WorldReaction.projectileOnBody(c,p,position)
	local declared=p.world or (p.family and p.family.World) or WorldReaction.Projectiles[p.kind]
	local big=(p.radius or 0)&gt;=1.2 or p.heavy or (declared and declared.element)
	if not big then return nil end
	local contact=declared and declared.contact or "blunt"
	if contact=="pierce" or contact=="slash" then contact="blunt" end
	local element=(declared and declared.element) or (if p.infusion and WorldReaction.Elements[p.infusion] then p.infusion else nil)
	local energy=(p.damage or 2)*TUNE.ProjectileEnergy+(p.radius or 0)*6
	return WorldReaction.below(c,position,energy,contact,element,p.direction)
end
-- A projectile reached a surface.
function WorldReaction.projectile(c,p,hit)
	local declared=p.world or (p.family and p.family.World) or WorldReaction.Projectiles[p.kind]
	local contact=declared and declared.contact or (if (p.radius or 0)&gt;1.2 then "blunt" else "pierce")
	local element=(declared and declared.element) or (if p.infusion and WorldReaction.Elements[p.infusion] then p.infusion else nil)
	local energy=(p.damage or 2)*TUNE.ProjectileEnergy+(p.radius or 0)*6
	return WorldReaction.impact(c,{part=hit.Instance,position=hit.Position,normal=hit.Normal,energy=energy,contact=contact,element=element,
		direction=p.direction,source=p.a and p.a.id})
end
-- A strike whose swing met no body: if the world is in front of it, the world
-- takes it (a heavy blow into a trunk, a lightning thrust into stone).
function WorldReaction.strike(c,a,pending)
	local spec=pending.spec or {}
	local declared=spec.world
	if declared==false then return nil end
	local reach=(spec.contact or 3.6)+(spec.range or 4)*.4
	local look=a.root.CFrame.LookVector
	local from=a.root.Position+Vector3.new(0,.6,0)
	local hit=workspace:Raycast(from,look*reach,c:rayParams(true))
	-- Low props (a crate) sit under a chest-high swing: a kick finds them.
	if not hit or math.abs(hit.Normal.Y)&gt;.6 then
		hit=workspace:Raycast(from-Vector3.new(0,2.2,0),look*reach,c:rayParams(true))
		if hit and not hit.Instance:GetAttribute("WorldBreakable") then hit=nil end
	end
	if not hit or math.abs(hit.Normal.Y)&gt;.6 then return nil end
	local contact=(declared and declared.contact) or WorldReaction.StrikeKinds[spec.kind or ""] or "blunt"
	local heavy=Config.World.HeavyKinds[spec.kind or ""] or spec.reaction=="Knockdown" or spec.reaction=="Launched"
	local energy=(spec.damage or 4)*TUNE.StrikeEnergy*(if heavy then 1.6 else 1)
	return WorldReaction.impact(c,{part=hit.Instance,position=hit.Position,normal=hit.Normal,energy=energy,contact=contact,
		element=(declared and declared.element) or spec.element,direction=look,source=a.id})
end
-- A burning (or otherwise elemental) zone marks the ground under it.
function WorldReaction.zone(c,position,radius,element)
	if not WorldReaction.Elements[element or ""] then return nil end
	local hit=workspace:Raycast(position+Vector3.new(0,2,0),Vector3.new(0,-8,0),c:rayParams(true))
	if not hit then return nil end
	return WorldReaction.impact(c,{part=hit.Instance,position=hit.Position,normal=hit.Normal,energy=radius*TUNE.ZoneEnergy,contact="blast",element=element,zone=true})
end
-- (06/11, user: « vérifie aussi le dégât au sol de toutes les attaques… il y a
-- beaucoup d'attaques qui restent dans le ciel et pas sur le sol ») The ground
-- audit (tools/studio/probes/ground_audit_server.luau, every strike and jutsu
-- of the eight fighters) found whole jutsu that left the arena clean: the
-- floor was only marked when a flight or a thrown body reached it. Now every
-- contact that weighs something marks the ground UNDER it, whatever it met:
-- one table read from Combat:pushImpact, by the contact's style, or by its
-- kind for a family look. {scar, energy, element, line=along its direction,
-- heavy=only the heavy version, foot=at the caster's feet (owner) instead
-- of the contact's point}. A contact high in the air (no floor within 9
-- studs) leaves nothing: it did not reach the ground.
WorldReaction.ContactMarks={
	-- (06/11) no crack for a combo's last light blow any more: a crack on
	-- every third hit covered the floor in black lines
	slam={"crater",62},landing={"crack",44},
	chidori={"trench",72,"lightning",line=true,heavy=true,foot=true},
	rasengan={"crater",80},uzumaki={"crack",46},sandburial={"crater",56},summon={"crater",96},
	gate={"crater",52,foot=true},awaken={"crack",58,foot=true},rotation={"crater",66,foot=true},
	trigram={"crack",52,foot=true},greatgust={"furrow",60,"wind",line=true},cyclone={"furrow",44,"wind"},
	crush={"crater",52,heavy=true},sandwall={"crack",46},
}
WorldReaction.KindMarks={
	-- family looks (SealJutsu Kind): explosions, earth, sand, summons
	fireball={"crater",70,"fire"},clay={"crater",72,"fire"},clonepop={"crack",50},
	earthwall={"crack",58},earthhand={"crater",56},earthdragon={"trench",76,line=true},
	sandarm={"trench",60,line=true},sandspike={"crater",54},quicksand={"crater",44},
	toadwater={"crater",90,"water"},hasangeki={"furrow",58,line=true},lightning={"cut",46,"lightning",line=true},
}
local function actorById(c,id)
	if id==nil then return nil end
	for _,x in c.actors or {} do if x.id==id then return x end end
	return nil
end
-- The ground under `position` takes a mark of `kind` (and its element's).
function WorldReaction.ground(c,position,kind,energy,along,element)
	local hit=workspace:Raycast(position+Vector3.new(0,1,0),Vector3.new(0,-9,0),c:rayParams(true))
	if not hit or hit.Normal.Y&lt;.6 or hit.Instance:GetAttribute("WorldScar") then return nil end
	local rec=WorldReaction.record(c,hit.Instance)
	if not rec then return nil end
	state(c).stats.impacts+=1
	local entry=WorldReaction.scar(c,kind,hit.Instance,hit.Position,hit.Normal,energy,along,rec.class)
	local el=element and WorldReaction.Elements[element]
	if el and el.scar then WorldReaction.scar(c,el.scar,hit.Instance,hit.Position+hit.Normal*.02,hit.Normal,energy*.8,nil,rec.class) end
	return entry
end
function WorldReaction.contact(c,entry)
	local style=entry.style
	local spec=WorldReaction.ContactMarks[style or ""]
	if (style=="look" or style=="cast") and entry.kind then spec=WorldReaction.KindMarks[entry.kind] end
	if not spec or (spec.heavy and not entry.heavy) or not entry.position then return nil end
	local position=entry.position
	local owner=actorById(c,entry.owner)
	if spec.foot and owner and owner.root then position=owner.root.Position end
	local along=nil
	if spec.line then
		local d=entry.direction
		if typeof(d)~="Vector3" and owner and owner.root then d=owner.root.CFrame.LookVector end
		if typeof(d)=="Vector3" then
			d=Vector3.new(d.X,0,d.Z)
			if d.Magnitude&gt;.05 then along=d.Unit end
		end
		-- a line runs ahead of where it starts
		if along and spec.foot then position+=along*2.2 end
	end
	return WorldReaction.ground(c,position,spec[1],spec[2],along,spec[3])
end
-- What the world still remembers (inspect, audit, perception later).
function WorldReaction.summary(c)
	local w=state(c)
	local cracked,broken=0,0
	for _,rec in w.parts do
		if rec.state=="Cracked" then cracked+=1 elseif rec.state=="Broken" then broken+=1 end
	end
	return {scars=#w.scars,rubble=#w.rubble,embeds=#w.embeds,cracked=cracked,broken=broken,stats=table.clone(w.stats)}
end

return WorldReaction
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND122">
        <Properties>
          <string name="Name">Zones</string>
          <ProtectedString name="Source">-- Persistent typed zones (ROSTER_WAVE_HOOKS H06), beside Combat's hazards
-- (which only burn): pieces of the arena that rewrite movement and flight for
-- a few seconds. A zone is data {kind, owner, shape, life}; KINDS says what a
-- kind does to bodies and to projectiles, the client draws each kind its own
-- way (GaleFX: wind, never fire), Combat:clear empties the list and the
-- snapshot carries it (Matches:view `zones`). First user: Temari (wind lanes,
-- updraft columns). Server authority only.
local Brawler=require(script.Parent.Brawler)
local Motor=require(script.Parent.Motor)
local Zones={}
-- Physical objects the wind turns aside, carries or sends back; fire it
-- feeds. Jutsu volumes (palms, sand waves, wind blades) go through.
local OBJECT={kunai=true,marked=true,shuriken=true,wire=true,sand=true,needle=true}
local FIRE={fireball=true,phoenix=true}
-- What a blade sent back becomes (a marked kunai loses its seal, a wire its wire).
local RETURN={kunai="kunai",marked="kunai",shuriken="shuriken",wire="shuriken",sand="sand",needle="shuriken"}
Zones.OBJECT=OBJECT;Zones.FIRE=FIRE;Zones.RETURN=RETURN
--   lane    origin (on the floor), flat direction, length, half width, height
--   column  origin (on the floor), radius, height
-- Wind: walking into it x headwind, with it x tailwind (the stick decides);
-- a free body is carried downwind (more in the air); a chakra dash straight
-- up it breaks there (+dashBreak recovery; not the owner's); a blade flying up it is
-- turned aside (x deflect speed, a short flight left), one riding it goes x
-- ride faster and +rideDamage; fire crossing it grows (x feed radius, x
-- feedDamage), whoever threw it. The owner gets `refund` chakra per blade
-- turned aside. Updraft: a body thrown up in it falls at `fall` at most, a free
-- airborne body is held at `hold`.
Zones.KINDS={
	Wind={shape="lane",height=9,headwind=.7,tailwind=1.15,carry=4,airCarry=11,dashBreak=.25,deflect=.75,flightLeft=12,ride=1.4,rideDamage=1,feed=1.5,feedDamage=1.2,refund=2},
	Updraft={shape="column",height=18,fall=-6,hold=-4},
}
local function flat(v) return Vector3.new(v.X,0,v.Z) end
-- spec: origin, direction, length, width, radius, height, life, carrier (a
-- projectile whose flight lays the lane: it grows as the projectile flies and
-- stops where it ended), reflect (blades going up it are sent back instead).
function Zones.add(c,owner,kind,spec)
	local tune=Zones.KINDS[kind]
	assert(tune,"Unknown zone kind "..tostring(kind))
	c.zones=c.zones or {}
	c.zoneSerial=(c.zoneSerial or 0)+1
	local direction=spec.direction and flat(spec.direction)
	local z={id=c.zoneSerial,kind=kind,tune=tune,owner=owner,origin=spec.origin,born=c.now,expires=c.now+(spec.life or 3),
		direction=if direction and direction.Magnitude&gt;.01 then direction.Unit else Vector3.zAxis,length=spec.length or 0,
		width=spec.width or 3,radius=spec.radius or 3,height=spec.height or tune.height,carrier=spec.carrier,reflect=spec.reflect==true,
		touched=setmetatable({},{__mode="k"})}
	z.reach=if z.carrier then 0 else z.length
	table.insert(c.zones,z)
	c.urgent=true
	return z
end
-- Inside the zone? For a lane, also how far along it.
function Zones.inside(z,position)
	local d=position-z.origin
	if d.Y&lt;-2.5 or d.Y&gt;z.height then return false end
	if z.tune.shape=="column" then return flat(d).Magnitude&lt;=z.radius,0 end
	local along=d.X*z.direction.X+d.Z*z.direction.Z
	if along&lt;0 or along&gt;z.reach then return false end
	return Vector3.new(d.X-z.direction.X*along,0,d.Z-z.direction.Z*along).Magnitude&lt;=z.width,along
end
-- Walking with or against the wind: the multiplier on this actor's speed this
-- frame (Combat:updateActor folds it into speedScale, which Place1Movement and
-- Motor.step both read).
function Zones.speedScale(c,a)
	local list=c.zones
	if not list or #list==0 or not a.move then return 1 end
	local move=flat(a.move)
	if move.Magnitude&lt;.2 then return 1 end
	move=move.Unit
	local scale=1
	for _,z in list do
		local tune=z.tune
		if tune.headwind and Zones.inside(z,a.root.Position) then
			local along=move:Dot(z.direction)
			scale*=if along&lt;0 then 1+(tune.headwind-1)*-along else 1+(tune.tailwind-1)*along
		end
	end
	return scale
end
-- Fire feeds on wind: the flight goes on from here (re-announced), bigger and hotter.
function Zones.feed(c,p,owner,factor,damage)
	local radius=(p.radius or 0)+(p.growth or 0)*math.max(0,c.now-p.born)
	c:redirect(p)
	p.radius=math.max(radius,1)*factor;p.damage*=damage;p.fed=(p.fed or 0)+1
	c:pushImpact(p.position,"windfeed",false,{projectile=p.id,kind=p.kind,owner=owner.id,fighter=owner.fighterId,direction=p.direction})
	Brawler.event(c,owner,"WindFeed")
end
-- A blade sent back at its thrower: the old flight ends, a new one (owned by
-- the wind's owner) leaves from where it was.
function Zones.sendBack(c,p,owner)
	local thrower=p.a
	p.dead=true
	local index=table.find(c.projectiles,p)
	if index then table.remove(c.projectiles,index) end
	c:pushImpact(p.position,"deflect",false,{projectile=p.id,kind=p.kind,owner=thrower.id,direction=-p.direction})
	if thrower.health&lt;=0 or owner.target~=thrower then return nil end
	local gap=(thrower.root.Position-p.position).Magnitude
	local back=c:projectile(owner,thrower.root.Position,math.max(p.speed,80)*1.1,gap+10,p.damage,RETURN[p.kind] or "kunai",nil,{origin=p.position,radius=p.radius})
	back.bounced=true
	-- An infused blade keeps its chakra on the way back (like a ricochet).
	if p.chakra then require(script.Parent.ChakraCombat).inherit(back,p) end
	return back
end
-- One projectile entering one lane (once per lane).
local function flight(c,z,p)
	local tune=z.tune
	local owner=z.owner
	if FIRE[p.kind] then Zones.feed(c,p,owner,tune.feed,tune.feedDamage);return end
	if not OBJECT[p.kind] then return end
	local course=flat(p.direction)
	if course.Magnitude&lt;.05 then return end
	local along=course.Unit:Dot(z.direction)
	if along&lt;=-.35 then
		-- Up the lane: turned aside out of it, or (Kirikiri Mai) sent back.
		owner.chakra=math.min(owner.def.Chakra or 100,owner.chakra+(tune.refund or 0))
		if z.reflect then
			Zones.sendBack(c,p,owner)
			Brawler.event(c,owner,"WindReturn")
			return
		end
		local d=p.position-z.origin
		local across=Vector3.new(d.X,0,d.Z)-z.direction*(d.X*z.direction.X+d.Z*z.direction.Z)
		local side=if across.Magnitude&gt;.2 then across.Unit else z.direction:Cross(Vector3.yAxis).Unit
		p.remaining=math.min(p.remaining,tune.flightLeft)
		c:redirect(p,z.direction*.5+side*.85+Vector3.new(0,.15,0),p.speed*tune.deflect)
		c:pushImpact(p.position,"winddeflect",false,{owner=owner.id,fighter=owner.fighterId,kind=p.kind,direction=p.direction,zone=z.id})
		Brawler.event(c,owner,"WindDeflect")
	elseif along&gt;=.35 then
		-- Riding it: faster and harder, on the same line.
		c:redirect(p,nil,p.speed*tune.ride)
		p.damage+=tune.rideDamage
		Brawler.event(c,owner,"WindRide")
	end
end
local FREE={Neutral=true,Guarding=true,Recovery=true,Startup=true,Active=true,TechniqueChannel=true,TechniqueActive=true,TechniqueRecovery=true}
local function body(c,a,dt)
	for _,z in c.zones do
		if Zones.inside(z,a.root.Position) then
			local tune=z.tune
			if tune.carry then
				-- The wind carries a free body downwind (a dash, a chase or a
				-- reaction is its own motion).
				if not a.reaction and not a.wall and not a.grabbedBy and FREE[a.state] then
					Motor.travel(a,c,z.direction,(if a.airborne then tune.airCarry else tune.carry)*dt)
				elseif a.state=="Rush" and a.rush and a.rush.goal and z.owner~=a and not a.rush.windBroken then
					-- A chakra dash straight up someone's wind breaks there: it
					-- stops in the lane and stumbles (a longer recovery). Go
					-- round the lane, or over it.
					local way=flat(a.rush.goal-a.root.Position)
					if way.Magnitude&gt;.5 and way.Unit:Dot(z.direction)&lt;-.35 then
						a.rush.windBroken=true
						a.rush.recovery=(a.rush.recovery or .2)+tune.dashBreak
						a.untilTime=math.min(a.untilTime,c.now)
						c:pushImpact(a.root.Position,"windbreak",false,{owner=z.owner.id,fighter=z.owner.fighterId,victim=a.id,direction=z.direction,zone=z.id})
						c:cue(a,"THE WIND BREAKS THE DASH",.6)
						Brawler.event(c,z.owner,"WindBreak")
					end
				end
			elseif tune.fall then
				local v=a.reactionVelocity
				if a.reaction and a.airborne and v and (v.Y&lt;tune.fall or a.reaction=="Launched" or a.reaction=="Juggled") then
					-- Thrown up in it: it comes down slowly and is held while the
					-- column stands (in reach of the wind; a substitution escapes).
					if v.Y&lt;tune.fall then a.reactionVelocity=Vector3.new(v.X*.9,tune.fall,v.Z*.9) end
					if a.reaction=="Launched" or a.reaction=="Juggled" then a.reactionUntil=math.max(a.reactionUntil or 0,c.now+.05) end
				elseif not a.reaction and a.airborne and a.state~="Pursuit" and a.state~="Rush" then
					local w=a.root.AssemblyLinearVelocity
					if w.Y&lt;tune.hold then a.root.AssemblyLinearVelocity=Vector3.new(w.X,tune.hold,w.Z) end
				end
			end
		end
	end
end
-- Every frame, before the projectiles move: expiry, lanes laid by their
-- carrier, then bodies and flights inside the zones.
function Zones.step(c,dt)
	local list=c.zones
	if not list or #list==0 then return end
	for i=#list,1,-1 do
		local z=list[i]
		if c.now&gt;=z.expires then
			table.remove(list,i);c.urgent=true
		elseif z.carrier then
			local p=z.carrier
			if p.dead or not table.find(c.projectiles,p) then z.carrier=nil
			else
				local d=p.position-z.origin
				z.reach=math.clamp(d.X*z.direction.X+d.Z*z.direction.Z,z.reach,z.length)
			end
		end
	end
	if #list==0 then return end
	for _,a in c.actors do
		if a.health&gt;0 then body(c,a,dt) end
		if c.match.phase~="Duel" then return end
	end
	for _,p in table.clone(c.projectiles) do
		if not p.dead and not p.planted and (p.speed or 0)&gt;0 then
			for _,z in list do
				if z.tune.shape=="lane" and not z.touched[p] and Zones.inside(z,p.position) then
					z.touched[p]=true
					flight(c,z,p)
					if p.dead then break end
				end
			end
		end
	end
end
-- What the client draws (each kind its own way).
function Zones.snapshot(c,now)
	local out={}
	for _,z in c.zones or {} do
		table.insert(out,{id=z.id,kind=z.kind,owner=z.owner.id,origin=z.origin,direction=z.direction,length=z.reach,width=z.width,
			radius=z.radius,height=z.height,remaining=math.max(0,z.expires-now),life=z.expires-z.born,reflect=z.reflect})
	end
	return out
end
function Zones.clear(c)
	if c.zones then table.clear(c.zones) end
end
return Zones
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="ND123">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMinZoomDistance">8</float>
      <float name="CameraMaxZoomDistance">32</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="ND124">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="ND125">
        <Properties>
          <string name="Name">NinjaDuelClient</string>
        </Properties>
        <Item class="ModuleScript" referent="ND126">
          <Properties>
            <string name="Name">ArenaDress</string>
            <ProtectedString name="Source">-- The stadium as this screen shows it (look pass 03/11, user: "the brightness,
-- the graphics, everything that shows on the screen"). The stadium the server
-- builds (Server/World, the user's 29/10 layout) stays exactly as it is; this
-- client adds, on its own copy only, what makes it read as a place where a
-- tournament is fought rather than an empty yard:
--   * the tournament's colours on the pale wall: tall cloth banners with a
--     brushed character hanging from the cornice, a vermilion band with an
--     ink line round the whole wall;
--   * weight where the wall meets the ground: soot at its foot and a soft
--     shadow on the earth, so the wall stands on the field instead of floating;
--   (no mark in the middle of the field: user 03/11, the floor stays clear);
--   * air: dust lit by the sun hanging over the field, leaves drifting down.
-- Nothing here collides, is hit by a ray or touches a duel: every part is
-- CanCollide/CanQuery/CanTouch false and lives in a folder the server never sees.
local RunService=game:GetService("RunService")
local ArenaDress={}

local WALL_RADIUS=145
local WALL_HEIGHT=40
local INK=Color3.fromRGB(26,20,26)
local VERMILION=Color3.fromRGB(176,42,34)
local PAPER=Color3.fromRGB(238,230,212)
local function rgb(r,g,b) return Color3.fromRGB(r,g,b) end

local function part(parent,props)
	local p=Instance.new("Part")
	p.Anchored=true;p.CanCollide=false;p.CanQuery=false;p.CanTouch=false;p.CastShadow=false
	p.Material=Enum.Material.SmoothPlastic;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth
	for k,v in props do (p::any)[k]=v end
	p.Parent=parent
	return p
end

-- A ring of flat or upright pieces round the arena: `make(cf,width)` for each.
local function around(radius,segments,make)
	local width=2*math.pi*radius/segments+.12
	for k=0,segments-1 do
		local a=k/segments*math.pi*2
		make(a,width)
	end
end

local function banners(folder,origin)
	local cloths={}
	local glyphs={"火","忍","試","闘","影","葉"}
	for k=0,17 do
		local a=k/18*math.pi*2+math.pi/18
		-- Clear of the two gates (south +Z, west -X) and the balcony (east +X).
		local s,c=math.sin(a),math.cos(a)
		local nearGate=(c&gt;.97) or (s&lt;-.97) or (s&gt;.96)
		if not nearGate then
			local dir=Vector3.new(s,0,c)
			local top=origin+dir*(WALL_RADIUS-1.9)+Vector3.new(0,WALL_HEIGHT-1.2,0)
			local hang=CFrame.lookAt(top,Vector3.new(origin.X,top.Y,origin.Z))
			local red=k%2==0
			local swinging={}
			local function hung(p) table.insert(swinging,{p,hang:ToObjectSpace(p.CFrame)});return p end
			local cloth=part(folder,{Name="Banner",Size=Vector3.new(8,24,.14),CFrame=hang*CFrame.new(0,-12,0),
				Color=if red then VERMILION else PAPER,Material=Enum.Material.Fabric})
			hung(cloth)
			-- The cloth's tail, cut in a swallowtail.
			for _,x in {-1.5,1.5} do
				hung(part(folder,{Name="BannerTail",Size=Vector3.new(4,2,.14),CFrame=cloth.CFrame*CFrame.new(x*1.33,-12.9,0)*CFrame.Angles(0,0,math.rad(x&gt;0 and 18 or -18)),
					Color=if red then VERMILION else PAPER,Material=Enum.Material.Fabric}))
			end
			-- Ink border down both edges.
			for _,x in {-3.8,3.8} do
				hung(part(folder,{Name="BannerEdge",Size=Vector3.new(.4,24,.16),CFrame=cloth.CFrame*CFrame.new(x,0,-.02),Color=INK}))
			end
			part(folder,{Name="BannerRod",Size=Vector3.new(9.4,.5,.5),CFrame=hang*CFrame.new(0,.1,0),Color=rgb(60,42,30),Material=Enum.Material.Wood})
			for _,x in {-4.8,4.8} do
				part(folder,{Name="BannerKnob",Size=Vector3.new(.7,.7,.7),Shape=Enum.PartType.Ball,CFrame=hang*CFrame.new(x,.1,0),Color=rgb(196,150,60),Material=Enum.Material.Metal})
			end
			local gui=Instance.new("SurfaceGui")
			gui.Face=Enum.NormalId.Front;gui.SizingMode=Enum.SurfaceGuiSizingMode.FixedSize;gui.CanvasSize=Vector2.new(240,720)
			gui.LightInfluence=1;gui.Parent=cloth
			-- A disc of the other colour, the character brushed in it.
			local disc=Instance.new("Frame")
			disc.AnchorPoint=Vector2.new(.5,.5);disc.Position=UDim2.fromOffset(120,190);disc.Size=UDim2.fromOffset(180,180)
			disc.BackgroundColor3=if red then PAPER else VERMILION;disc.BorderSizePixel=0;disc.Parent=gui
			local round=Instance.new("UICorner");round.CornerRadius=UDim.new(.5,0);round.Parent=disc
			local glyph=Instance.new("TextLabel")
			glyph.BackgroundTransparency=1;glyph.Size=UDim2.fromScale(1,1);glyph.Text=glyphs[k%#glyphs+1]
			glyph.Font=Enum.Font.GothamBlack;glyph.TextScaled=true;glyph.TextColor3=INK;glyph.Parent=disc
			local pad=Instance.new("UIPadding");pad.PaddingTop=UDim.new(.16,0);pad.PaddingBottom=UDim.new(.16,0);pad.Parent=disc
			-- Under it, the tournament's name in a column of small characters.
			local col=Instance.new("TextLabel")
			col.BackgroundTransparency=1;col.Position=UDim2.fromOffset(90,320);col.Size=UDim2.fromOffset(60,320)
			col.Text="中\n忍\n選\n抜";col.Font=Enum.Font.GothamBold;col.TextScaled=true
			col.TextColor3=if red then PAPER else INK;col.TextTransparency=.15;col.Parent=gui
			table.insert(cloths,{hang=hang,phase=k*1.7,parts=swinging})
		end
	end
	return cloths
end

local function wallBands(folder,origin)
	-- Vermilion band with an ink line under it, round the inner face.
	around(WALL_RADIUS-.55,116,function(a,width)
		local dir=Vector3.new(math.sin(a),0,math.cos(a))
		local base=origin+dir*(WALL_RADIUS-.55)
		local function band(name,y,h,color,depth,transparency)
			local at=base+Vector3.new(0,y,0)-dir*depth
			part(folder,{Name=name,Size=Vector3.new(width,h,.12),CFrame=CFrame.lookAt(at,Vector3.new(origin.X,at.Y,origin.Z)),Color=color,Transparency=transparency or 0})
		end
		band("WallBand",8.4,2.2,VERMILION,0)
		band("WallLine",7.05,.36,INK,0)
		band("WallLineTop",9.6,.2,INK,0,.2)
		-- Soot at the wall's foot, fading up.
		band("WallSoot",.9,1.8,INK,.02,.55)
		band("WallSoot",2.4,1.4,INK,.03,.78)
		band("WallSoot",3.7,1.4,INK,.04,.9)
		-- A soft shadow on the earth along the foot.
		local ground=origin+dir*(WALL_RADIUS-3.2)+Vector3.new(0,.06,0)
		part(folder,{Name="WallShade",Size=Vector3.new(width,.05,6),CFrame=CFrame.lookAt(ground,Vector3.new(origin.X,ground.Y,origin.Z)),Color=INK,Transparency=.8})
		local far=origin+dir*(WALL_RADIUS-8.2)+Vector3.new(0,.055,0)
		part(folder,{Name="WallShade",Size=Vector3.new(width*.96,.05,4.4),CFrame=CFrame.lookAt(far,Vector3.new(origin.X,far.Y,origin.Z)),Color=INK,Transparency=.9})
	end)
end

local function air(folder,origin)
	-- Dust hanging in the sun over the field.
	local volume=part(folder,{Name="SunDust",Size=Vector3.new(200,26,200),CFrame=CFrame.new(origin+Vector3.new(0,14,0)),Transparency=1})
	local dust=Instance.new("ParticleEmitter")
	dust.Name="Dust";dust.Texture="rbxasset://textures/particles/sparkles_main.dds"
	dust.Shape=Enum.ParticleEmitterShape.Box;dust.ShapeStyle=Enum.ParticleEmitterShapeStyle.Volume
	dust.Rate=34;dust.Lifetime=NumberRange.new(7,12);dust.Speed=NumberRange.new(.2,.6)
	dust.SpreadAngle=Vector2.new(180,180);dust.Acceleration=Vector3.new(.25,.05,.1)
	dust.Color=ColorSequence.new(rgb(255,236,200));dust.LightEmission=.9;dust.LightInfluence=0
	dust.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(.3,.16),NumberSequenceKeypoint.new(1,0)})
	dust.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(.3,.35),NumberSequenceKeypoint.new(1,1)})
	dust.Parent=volume
	-- Leaves from the forest round the stadium, a few at a time.
	local sky=part(folder,{Name="LeafSky",Size=Vector3.new(280,1,280),CFrame=CFrame.new(origin+Vector3.new(0,70,0)),Transparency=1})
	local leaves=Instance.new("ParticleEmitter")
	leaves.Name="Leaves";leaves.Texture="rbxasset://textures/particles/sparkles_main.dds"
	leaves.Rate=9;leaves.Lifetime=NumberRange.new(10,14);leaves.Speed=NumberRange.new(2,4)
	leaves.EmissionDirection=Enum.NormalId.Bottom;leaves.SpreadAngle=Vector2.new(35,35)
	leaves.Color=ColorSequence.new(rgb(118,152,70),rgb(196,150,70));leaves.LightEmission=0;leaves.LightInfluence=1
	leaves.Size=NumberSequence.new(.42);leaves.Squash=NumberSequence.new(-.5)
	leaves.Rotation=NumberRange.new(0,360);leaves.RotSpeed=NumberRange.new(-120,120);leaves.Acceleration=Vector3.new(1.4,-.7,.5)
	leaves.Parent=sky
end

-- The field's grass patches (Server/ArenaMeshes) a shade softer and a little
-- thin, so the earth shows at their edges and they lie in it, not on it.
local function settle(courtyard)
	local decor=courtyard:FindFirstChild("Decor")
	if not decor then return end
	for _,d in decor:GetChildren() do
		if d:IsA("BasePart") and (d.Name=="GrassA_Grass" or d.Name=="GrassB_Grass" or d.Name=="GrassC_Grass") then
			d.Color=d.Color:Lerp(rgb(150,146,90),.2)
		end
	end
end

function ArenaDress.dress(courtyard)
	if courtyard:GetAttribute("Dressed") then return end
	local floor=courtyard:FindFirstChild("Training floor")
	if not floor then return end
	courtyard:SetAttribute("Dressed",true)
	local origin=floor.Position+Vector3.new(0,1,0)
	local folder=Instance.new("Folder");folder.Name="NinjaDuelArenaDress";folder.Parent=workspace
	local ok,err=pcall(function()
		settle(courtyard)
		wallBands(folder,origin)
		air(folder,origin)
		local cloths=banners(folder,origin)
		-- The banners breathe in the wind, out of step.
		local last=0
		local connection
		connection=RunService.Heartbeat:Connect(function()
			if not folder.Parent or not courtyard.Parent then connection:Disconnect();folder:Destroy();return end
			local t=os.clock()
			if t-last&lt;1/30 then return end
			last=t
			for _,b in cloths do
				local swing=math.sin(t*.9+b.phase)*math.rad(2.2)+math.sin(t*2.3+b.phase*2)*math.rad(.6)
				local pivot=b.hang*CFrame.Angles(swing,0,0)
				for _,entry in b.parts do entry[1].CFrame=pivot*entry[2] end
			end
		end)
	end)
	if not ok then warn("[NinjaDuel] arena dress: "..tostring(err)) end
end

-- (QA 12/11, gel au BEGIN) The stadium's content fetched while the player is
-- still on the roster (meshes, textures), not at the first BEGIN.
function ArenaDress.preload(courtyard)
	local ok,provider=pcall(function() return game:GetService("ContentProvider") end)
	if not ok or not provider then return end
	pcall(function() provider:PreloadAsync({courtyard}) end)
end

function ArenaDress.start()
	local function check(d)
		if d.Name=="Courtyard" and d:IsA("Folder") then
			task.spawn(function()
				-- (QA 12/11) A lane's stadium now comes a few pieces a frame
				-- (Server/Stage, Building until the last one): dressed and
				-- fetched once it is whole.
				while d.Parent and d:GetAttribute("Building") do task.wait(.25) end
				task.wait(.5)
				if d.Parent then ArenaDress.dress(d);ArenaDress.preload(d) end
			end)
		end
	end
	for _,d in workspace:GetDescendants() do check(d) end
	workspace.DescendantAdded:Connect(check)
end
return ArenaDress
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND127">
          <Properties>
            <string name="Name">AuthoredClips</string>
            <ProtectedString name="Source">-- GENERATED by tools/blender/clips_to_luau.py from the Blender pipeline
