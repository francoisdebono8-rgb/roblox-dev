	K(0,merge(AIR_LE,{root={pitch=-8},torso={pitch=-16,yaw=-20},ra={raise=150,out=20,elbow=90},la={raise=150,out=20,elbow=90},rl={lift=70,knee=110},ll={lift=60,knee=100}})),
