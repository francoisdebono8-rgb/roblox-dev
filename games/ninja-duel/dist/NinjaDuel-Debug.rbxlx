	K(2,n({root={y=-.58,z=-.48,yaw=-14,pitch=10},torso={yaw=-32,pitch=6},ra=PALM_R,la={raise=40,out=10,twist=-40,elbow=96},lf={z=-1.05},rf={z=.7,x=.2}})),
