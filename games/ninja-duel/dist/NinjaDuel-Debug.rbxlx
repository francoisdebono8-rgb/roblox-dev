	K(2,merge(AIR_M,{root={yaw=84,roll=-14,pitch=8},torso={yaw=22},rl={lift=76,out=70,twist=-30,knee=10,ankle=-20},ll={lift=30,knee=80},ra={raise=20,out=80,elbow=20},la={raise=30,out=70,elbow=30}})),
