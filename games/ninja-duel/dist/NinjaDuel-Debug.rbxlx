		{name="Head__Skin",body="Head",mesh="rbxassetid://123370620912339",offset=Vector3.new(-0,-0.045,0),size=Vector3.new(1.8,1.81,1.72),color=Color3.fromRGB(250,226,204),material="SmoothPlastic",reflectance=0},
		{name="LeftFoot__Heel",body="LeftFoot",mesh="rbxassetid://90494648962885",offset=Vector3.new(0,0.035,0.105),size=Vector3.new(0.8,0.37,0.95),color=Color3.fromRGB(26,32,70),material="SmoothPlastic",reflectance=0},
		{name="LeftFoot__Sole",body="LeftFoot",mesh="rbxassetid://87146271240363",offset=Vector3.new(0,-0.2,-0.02),size=Vector3.new(0.78,0.1,1.18),color=Color3.fromRGB(60,48,44),material="SmoothPlastic",reflectance=0},
		{name="LeftFoot__Toes",body="LeftFoot",mesh="rbxassetid://100768542029528",offset=Vector3.new(0,-0.1,-0.44),size=Vector3.new(0.62,0.2,0.34),color=Color3.fromRGB(250,226,204),material="SmoothPlastic",reflectance=0},
		{name="LeftHand__Fist",body="LeftHand",mesh="rbxassetid://75573010813458",offset=Vector3.new(-0.005,0,-0.0475),size=Vector3.new(0.49,0.58,0.575),color=Color3.fromRGB(250,226,204),material="SmoothPlastic",reflectance=0},
		{name="LeftLowerArm__Forearm",body="LeftLowerArm",mesh="rbxassetid://114668390279396",offset=Vector3.new(-0.0016,0.05,-0.0011),size=Vector3.new(0.69,1.1,0.674),color=Color3.fromRGB(214,214,224),material="SmoothPlastic",reflectance=0},
		{name="LeftLowerLeg__AnkleStrap",body="LeftLowerLeg",mesh="rbxassetid://101648578885471",offset=Vector3.new(0,-0.42,-0),size=Vector3.new(0.88,0.16,0.86),color=Color3.fromRGB(26,32,70),material="SmoothPlastic",reflectance=0},
		{name="LeftLowerLeg__Shin",body="LeftLowerLeg",mesh="rbxassetid://102009746839524",offset=Vector3.new(0.0053,0.03,-0.0049),size=Vector3.new(0.86,1.18,0.84),color=Color3.fromRGB(250,226,204),material="SmoothPlastic",reflectance=0},
		{name="LeftLowerLeg__Wrap",body="LeftLowerLeg",mesh="rbxassetid://138062205027788",offset=Vector3.new(0,0.18,-0),size=Vector3.new(0.92,0.56,0.9),color=Color3.fromRGB(238,236,230),material="SmoothPlastic",reflectance=0},
		{name="LeftUpperArm__Arm",body="LeftUpperArm",mesh="rbxassetid://116784683633552",offset=Vector3.new(-0,-0.325,0),size=Vector3.new(0.72,0.67,0.68),color=Color3.fromRGB(250,226,204),material="SmoothPlastic",reflectance=0},
		{name="LeftUpperArm__Sleeve",body="LeftUpperArm",mesh="rbxassetid://111034934538035",offset=Vector3.new(0.0024,0.325,-0.0006),size=Vector3.new(0.7956,0.75,0.7644),color=Color3.fromRGB(36,46,96),material="SmoothPlastic",reflectance=0},
		{name="LeftUpperLeg__Thigh",body="LeftUpperLeg",mesh="rbxassetid://115187077232187",offset=Vector3.new(0,0.01,0.0022),size=Vector3.new(0.9,1.34,0.8625),color=Color3.fromRGB(238,236,230),material="SmoothPlastic",reflectance=0},
		{name="LowerTorso__Hips",body="LowerTorso",mesh="rbxassetid://136784710337797",offset=Vector3.new(0.0015,0,-0.0024),size=Vector3.new(1.7278,1.24,1.008),color=Color3.fromRGB(238,236,230),material="SmoothPlastic",reflectance=0},
		{name="RightFoot__Heel",body="RightFoot",mesh="rbxassetid://80118597085961",offset=Vector3.new(0,0.035,0.105),size=Vector3.new(0.8,0.37,0.95),color=Color3.fromRGB(26,32,70),material="SmoothPlastic",reflectance=0},
		{name="RightFoot__Sole",body="RightFoot",mesh="rbxassetid://105409213787688",offset=Vector3.new(0,-0.2,-0.02),size=Vector3.new(0.78,0.1,1.18),color=Color3.fromRGB(60,48,44),material="SmoothPlastic",reflectance=0},
		{name="RightFoot__Toes",body="RightFoot",mesh="rbxassetid://120506006522238",offset=Vector3.new(0,-0.1,-0.44),size=Vector3.new(0.62,0.2,0.34),color=Color3.fromRGB(250,226,204),material="SmoothPlastic",reflectance=0},
		{name="RightHand__Fist",body="RightHand",mesh="rbxassetid://74211298474882",offset=Vector3.new(0.005,0,-0.0475),size=Vector3.new(0.49,0.58,0.575),color=Color3.fromRGB(250,226,204),material="SmoothPlastic",reflectance=0},
		{name="RightLowerArm__Forearm",body="RightLowerArm",mesh="rbxassetid://74395359532936",offset=Vector3.new(-0.0016,0.05,-0.0011),size=Vector3.new(0.69,1.1,0.674),color=Color3.fromRGB(214,214,224),material="SmoothPlastic",reflectance=0},
		{name="RightLowerLeg__AnkleStrap",body="RightLowerLeg",mesh="rbxassetid://79018734192940",offset=Vector3.new(0,-0.42,-0),size=Vector3.new(0.88,0.16,0.86),color=Color3.fromRGB(26,32,70),material="SmoothPlastic",reflectance=0},
		{name="RightLowerLeg__Shin",body="RightLowerLeg",mesh="rbxassetid://79184593768874",offset=Vector3.new(0.0053,0.03,-0.0049),size=Vector3.new(0.86,1.18,0.84),color=Color3.fromRGB(250,226,204),material="SmoothPlastic",reflectance=0},
		{name="RightLowerLeg__Wrap",body="RightLowerLeg",mesh="rbxassetid://140226564280294",offset=Vector3.new(0,0.18,-0),size=Vector3.new(0.92,0.56,0.9),color=Color3.fromRGB(238,236,230),material="SmoothPlastic",reflectance=0},
		{name="RightUpperArm__Arm",body="RightUpperArm",mesh="rbxassetid://110444007451726",offset=Vector3.new(0,-0.325,0),size=Vector3.new(0.72,0.67,0.68),color=Color3.fromRGB(250,226,204),material="SmoothPlastic",reflectance=0},
		{name="RightUpperArm__Sleeve",body="RightUpperArm",mesh="rbxassetid://97301049065878",offset=Vector3.new(0.0024,0.325,-0.0006),size=Vector3.new(0.7956,0.75,0.7644),color=Color3.fromRGB(36,46,96),material="SmoothPlastic",reflectance=0},
		{name="RightUpperLeg__Thigh",body="RightUpperLeg",mesh="rbxassetid://90152206521093",offset=Vector3.new(0,0.01,0.0022),size=Vector3.new(0.9,1.34,0.8625),color=Color3.fromRGB(238,236,230),material="SmoothPlastic",reflectance=0},
		{name="UpperTorso__Chest",body="UpperTorso",mesh="rbxassetid://72496504002946",offset=Vector3.new(-0,0.191,0),size=Vector3.new(1.8,1.702,1.6),color=Color3.fromRGB(36,46,96),material="SmoothPlastic",reflectance=0},
		{name="UpperTorso__RoundelRed",body="UpperTorso",mesh="rbxassetid://78444132513057",offset=Vector3.new(-0,0.12,0.505),size=Vector3.new(0.6,0.6,0.06),color=Color3.fromRGB(214,40,40),material="SmoothPlastic",reflectance=0},
		{name="UpperTorso__RoundelWhite",body="UpperTorso",mesh="rbxassetid://119865189331349",offset=Vector3.new(-0,-0.03,0.52),size=Vector3.new(0.6,0.3,0.06),color=Color3.fromRGB(246,244,240),material="SmoothPlastic",reflectance=0},
	}},
}
