		{ Id = "CurseBlood", Name = "Blood for Chakra", Branch = "Curse Mark", Kind = "awakening", Major = true, Cost = 14, Requires = { "CurseControl" },
			Effects = { { "def.Awakening.BloodChakra", "set", true } },
			Shows = "Under the Curse Mark the chakra a technique lacks is paid with health (never down to a KO): Chidori at an empty reserve.",
