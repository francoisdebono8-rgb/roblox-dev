<?xml version='1.0' encoding='utf-8'?>
<roblox version="4">
  <Item class="Workspace" referent="ND1">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">140</float>
      <float name="FallenPartsDestroyHeight">-100</float>
    </Properties>
  </Item>
  <Item class="ReplicatedStorage" referent="ND2">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="ND3">
      <Properties>
        <string name="Name">NinjaDuel</string>
      </Properties>
      <Item class="ModuleScript" referent="ND4">
        <Properties>
          <string name="Name">AnimationBindings</string>
          <ProtectedString name="Source">-- After publishing the retargeted Bangla sequences under the experience owner,
-- replace these zeros with that owner's R15 animation IDs (not the original R6 IDs).
return {Punch=0,HardSmack=0,MegaPunch=0,Parry=0}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND5">
        <Properties>
          <string name="Name">Attacks</string>
          <ProtectedString name="Source">-- Bangla three-strike M1 foundation; air/grab/launch branches are Ninja Duel glue.
local Combo=require(script.Parent.BanglaCombo)
local function move(startup,active,recovery,damage,travel,reaction,impulse,stun)
 return {startup=startup,active=active,recovery=recovery,damage=damage,travel=travel,
  travelTime=startup+active,reaction=reaction or "HitStun",impulse=impulse or Vector3.new(0,0,7),stun=stun or 0.27,
  range=7.8,width=5.5,height=6,blockable=true,
  -- Contact distance (root to root) where the step-in stops: an arm's length
  -- for hand strikes. Closer, the two bodies visibly merge mid-string.
  contact=3.6}
end
local attacks={
 Light1=move(.09,.12,Combo.comboDelay-.22,Combo.Damage.Punch,3.2),
 Light2=move(.10,.12,Combo.comboDelay-.23,Combo.Damage.HardSmack,3.5),
 Light3=move(.12,.14,Combo.comboDelay-.26,Combo.Damage.MegaPunch,4.2,"Knockback",Vector3.new(0,14,50),.48),
 Heavy=move(.30,.17,.52,14,5.4,"Knockdown",Vector3.new(0,12,34),.68),
 Launcher=move(.17,.14,.28,8,3.2,"Launched",Vector3.new(0,58,13),1.18),
 DashAttack=move(.07,.15,.27,7,8.2,"HitStun",Vector3.new(0,3,13),.31),
 Air1=move(.08,.13,.18,6,2.8,"Juggled",Vector3.new(0,15,8),.62),
 Air2=move(.09,.14,.19,7,3.1,"Juggled",Vector3.new(0,10,12),.64),
 Slam=move(.15,.20,.38,11,2.8,"Knockdown",Vector3.new(0,-78,10),.86),
 Grab=move(.18,.14,.5,0,2,"Grabbed",Vector3.zero,.8),
 Throw=move(.12,.1,.34,10,0,"Knockdown",Vector3.new(0,18,48),.7),
 ThrowUp=move(.12,.1,.3,7,0,"Launched",Vector3.new(0,50,10),1.1),
 -- Character branches (directional input inside a confirmed string).
 -- Minato: a sidestep cut that swings him around the opponent's guard.
 AngleStep=move(.08,.1,.2,6,1.2,"HitStun",Vector3.new(0,0,9),.3),
 -- Itachi: a low spinning sweep that trades the string for a knockdown,
 -- and the palm that answers a successful Read.
 Sweep=move(.12,.14,.34,7,1.6,"Knockdown",Vector3.new(0,6,12),.62),
 CounterPalm=move(.05,.12,.3,10,2.6,"Knockback",Vector3.new(0,14,46),.5),
 -- From a wall run: a diving strike at the opponent (active window sized to the flight).
 WallDive=move(.1,.3,.32,9,0,"Knockdown",Vector3.new(0,10,30),.62),
 -- Neji: twin palms driven from the hips (heavy after one clean palm, or the
 -- counter after Rotation).
 PalmThrust=move(.11,.14,.34,10,3.4,"Knockback",Vector3.new(0,12,62),.52),
 -- Minato: a knee driven up into the body after one clean cut. The opponent is
 -- popped to waist height: continue on the ground, jump after it, or chase.
 KneeStrike=move(.08,.12,.3,7,2.6,"Juggled",Vector3.new(0,26,4),.62),
 -- Running taijutsu: out of a full sprint, a flying kick (strike) and a
 -- sliding sweep (heavy). The run is the wind-up; a whiff overshoots.
 FlyingKick=move(.1,.16,.32,9,10,"Knockback",Vector3.new(0,14,48),.5),
 -- Riposte: out of a clean block or a perfect dodge, an instant strike that
 -- opens the string (block -&gt; riposte -&gt; combo).
 Riposte=move(.05,.12,.26,8,2.6,"HitStun",Vector3.new(0,5,12),.36),
 -- Gaara: sand erupts under the opponent at range and throws them up.
 SandPillar=move(.27,.14,.5,9,0,"Launched",Vector3.new(0,54,4),1.1),
 SlideSweep=move(.12,.18,.38,8,11,"Knockdown",Vector3.new(0,8,18),.62),
 -- Lateral routes: Itachi's feint step (an afterimage stays, he reappears at
 -- the flank) and Neji's circular step onto a chakra point. Both keep the string.
 FeintStep=move(.1,.12,.22,6,0,"HitStun",Vector3.new(0,4,9),.34),
 CircleStep=move(.09,.12,.22,6,0,"HitStun",Vector3.new(0,3,8),.34),
 -- Air routes after an air hit: drive the body away (toward a wall), spike it
 -- into the floor (it bounces once), or vault to its other side.
 AirDrive=move(.08,.13,.22,7,3,"Knockback",Vector3.new(0,8,48),.5),
 AirSpike=move(.09,.12,.24,7,2,"Spiked",Vector3.new(0,-72,6),.9),
 AirSwitch=move(.1,.14,.2,6,0,"Juggled",Vector3.new(0,13,9),.6),
 -- Sasuke: an acrobatic rising kick he follows into the air, a vault over the
 -- opponent into a back kick, and the Chidori thrust (started by the jutsu).
 LionKick=move(.15,.14,.28,8,3,"Launched",Vector3.new(0,50,5),1.25),
 VaultKick=move(.12,.12,.24,7,0,"HitStun",Vector3.new(0,6,12),.36),
 ChidoriThrust=move(.04,.26,.62,22,15,"Knockback",Vector3.new(0,12,70),.7),
}
-- Reach of the body that lands each strike (see `contact` in move()).
for name,gap in {Light3=4.0,Heavy=3.9,FlyingKick=4.0,PalmThrust=3.7,CounterPalm=3.7,KneeStrike=3.2,Sweep=3.5,Grab=2.6,Throw=2.6,ThrowUp=2.6,Slam=3.0,WallDive=2.6} do
 if attacks[name] then attacks[name].contact=gap end
end

for name,spec in attacks do
 if not Combo.Actions[name] then spec.depth=spec.range*.8;spec.offset=spec.range*.4
 else
  -- The string's donor volume (1 to 3 studs ahead) stopped short of the
  -- contact distance: it now reaches a quarter stud past it.
  spec.depth=spec.contact+.25-1;spec.offset=(1+spec.contact+.25)/2
 end
 spec.animation=name;spec.feedback=spec.reaction;spec.chain=name=="Light1" or name=="Light2" or name=="Air1" or name=="Air2" or name=="DashAttack" or name=="AngleStep" or name=="Riposte"
  or name=="FeintStep" or name=="CircleStep" or name=="AirSwitch" or name=="VaultKick"
 spec.air=name=="Air1" or name=="Air2" or name=="AirDrive" or name=="AirSpike" or name=="AirSwitch"
end
-- Hitstop is not authored per move any more: weight comes from Combat.Hitstop so
-- a light jab cannot be given a heavy stop by accident.
local motion={
 Light1={side=1,twist=30,lean=8,arm=82,step=1.05},
 Light2={side=-1,twist=34,lean=10,arm=88,step=1.08},
 Light3={side=1,twist=72,lean=12,arm=102,step=1.2},
 Heavy={side=-1,twist=48,lean=25,arm=116,step=1.3},
 Launcher={side=1,twist=20,lean=-24,arm=112,step=1.15},
 DashAttack={side=1,twist=36,lean=28,arm=96,step=1.35},
 Air1={side=1,twist=38,lean=12,arm=98,step=1.1},
 Air2={side=-1,twist=44,lean=18,arm=104,step=1.15},
 Slam={side=1,twist=12,lean=46,arm=128,step=1.2},
 Grab={side=1,twist=10,lean=18,arm=72,step=1.05},
 Throw={side=1,twist=70,lean=22,arm=92,step=1.1},
 ThrowUp={side=-1,twist=28,lean=-30,arm=110,step=1.1},
 AngleStep={side=1,twist=40,lean=10,arm=90,step=1.1},
 Sweep={side=-1,twist=60,lean=20,arm=60,step=1.0},
 CounterPalm={side=1,twist=30,lean=16,arm=100,step=1.2},
 WallDive={side=1,twist=24,lean=42,arm=80,step=1.2},
 PalmThrust={side=1,twist=20,lean=18,arm=100,step=1.25},
 KneeStrike={side=1,twist=16,lean=14,arm=70,step=1.15},
 FlyingKick={side=1,twist=10,lean=-12,arm=60,step=1.3},
 Riposte={side=1,twist=24,lean=12,arm=92,step=1.2},
 SandPillar={side=1,twist=10,lean=-6,arm=120,step=1},
 SlideSweep={side=1,twist=14,lean=-20,arm=40,step=1.3},
 FeintStep={side=-1,twist=30,lean=10,arm=90,step=1.1},
 CircleStep={side=1,twist=40,lean=8,arm=90,step=1.05},
 AirDrive={side=1,twist=20,lean=-10,arm=60,step=1},
 AirSpike={side=1,twist=10,lean=40,arm=120,step=1},
 AirSwitch={side=-1,twist=60,lean=10,arm=80,step=1},
 LionKick={side=1,twist=10,lean=-30,arm=100,step=1.15},
 VaultKick={side=-1,twist=70,lean=10,arm=60,step=1.1},
 ChidoriThrust={side=1,twist=20,lean=30,arm=110,step=1.4},
}
for name,pose in motion do for key,value in pose do attacks[name][key]=value end end
for _,name in {"Light1","Light2","Light3"} do attacks[name].width=5;attacks[name].height=5;attacks[name].range=6 end
attacks.AngleStep.width=5;attacks.AngleStep.range=6.5;attacks.AngleStep.orbit=17
attacks.Sweep.height=3.5;attacks.Sweep.width=6.5;attacks.Sweep.range=6.5
attacks.WallDive.width=6;attacks.WallDive.height=8;attacks.WallDive.range=7.5;attacks.WallDive.facing=-.45
attacks.FlyingKick.range=7.5;attacks.FlyingKick.width=5.5
attacks.SandPillar.range=12.5;attacks.SandPillar.width=6;attacks.SandPillar.height=8;attacks.SandPillar.depth=11;attacks.SandPillar.offset=6;attacks.SandPillar.facing=.25
attacks.SlideSweep.range=7.5;attacks.SlideSweep.height=3.5;attacks.SlideSweep.width=6.5
attacks.FeintStep.width=5;attacks.FeintStep.range=6.5;attacks.FeintStep.orbit=34
attacks.CircleStep.width=5;attacks.CircleStep.range=6;attacks.CircleStep.orbit=28
attacks.AirSwitch.orbit=40;attacks.AirSwitch.width=6;attacks.AirSwitch.height=7
attacks.AirSpike.height=7;attacks.AirDrive.height=7
attacks.VaultKick.width=5.5;attacks.VaultKick.range=6.5;attacks.VaultKick.orbit=50
attacks.ChidoriThrust.range=7;attacks.ChidoriThrust.width=4.5
-- Where a strike lands and what it is: the victim's body answers the blow it
-- actually took (head snaps, body folds, legs are taken away, ...).
local ZONE={Light1="head",Light2="body",Light3="body",Heavy="body",Launcher="chin",DashAttack="body",Air1="body",Air2="head",
 Slam="body",AngleStep="body",Sweep="legs",CounterPalm="body",WallDive="body",PalmThrust="body",KneeStrike="body",FlyingKick="head",
 Riposte="head",SlideSweep="legs",SandPillar="legs",FeintStep="body",CircleStep="body",AirDrive="body",AirSpike="head",AirSwitch="head",
 LionKick="chin",VaultKick="head",ChidoriThrust="body",
 Throw="body",ThrowUp="body",Grab="body"}
local KIND={Light3="kick",Heavy="heavy",Launcher="launch",Air2="kick",Slam="slam",Sweep="sweep",SlideSweep="sweep",KneeStrike="knee",
 FlyingKick="kick",WallDive="kick",SandPillar="launch",AirDrive="kick",AirSpike="spike",AirSwitch="kick",PalmThrust="palm",CounterPalm="palm",
 LionKick="launch",VaultKick="kick",ChidoriThrust="heavy"}
for name,spec in attacks do spec.zone=ZONE[name] or "body";spec.kind=KIND[name] or "strike" end
attacks.Grab.range=4.6;attacks.Grab.blockable=false;attacks.Throw.blockable=false;attacks.ThrowUp.blockable=false
return attacks
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND6">
        <Properties>
          <string name="Name">BanglaCombo</string>
          <ProtectedString name="Source">-- Adapted from BanglaBattlegrounds StarterPack/Punch/PunchMoves (Dewan Mukto, MIT).
-- Input and cooldown authority moved to the server; no Tool or independent input loop.
local Combo={maxComboCount=3,comboDelay=.5,resetDelay=1.1}
function Combo.next(actor,now)
 local comboTimer=now-actor.lastAttack
 local comboCount=actor.combo
 local maxComboCount=Combo.maxComboCount
 local comboDelay=Combo.resetDelay
 -- Donor combo progression, retained verbatim with per-actor state.
 if comboTimer &lt;= comboDelay then
  comboCount = comboCount + 1
  if comboCount &gt; maxComboCount then
   comboCount = 1
  end
 else
  comboCount = 1
 end
 actor.combo=comboCount;actor.lastAttack=now
 return 'Light'..comboCount
end
Combo.Actions={Light1='Punch',Light2='HardSmack',Light3='MegaPunch'}
-- Donor server damageValues and Animation objects, never supplied by clients.
-- MegaPunch tuned 25 -&gt; 18 for Ninja Duel pacing (a three-hit string is no
-- longer a third of a health bar); Punch and HardSmack keep the donor values.
Combo.Damage={Punch=5,HardSmack=10,MegaPunch=18}
Combo.AnimationIds={Punch=18342131933,HardSmack=18342045122,MegaPunch=18341956985,Parry=18341905406}
return Combo
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND7">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">-- Tunable V0 values; no client-supplied balance values are accepted.
return {
	Version = "0.13.0-arena-combo",
	ArenaRadius = 143, ArenaHeight = 76, WalkSpeed = 19, JumpPower = 68, Chakra = 100,
	ChakraRegen = 9, GuardDrain = 19, GuardChip = 0.12,
	GuardBreak = 0.65, HitStun = 0.22, InterruptStun = 0.42,
	ComboReset = 1.05, MeleeRange = 7.6, MeleeFacing = 0.18,
	DodgeCost = 10, DodgeCooldown = 0.8, DodgeTime = 0.32, DodgeIFrames = 0.22,
	DodgeSpeed = 61, GuardSpeed = 8, ChannelSpeed = 7,
	ToolCost = 4, PursuitCost = 8, PursuitWindow = 0.85, PursuitRange = 46, PursuitSpeed = 74,
	-- (PursuitCost is the one re-engage price: the chase and the chakra dash.)
	-- Kawarimi: a limited escape that recharges. Usable while being hit (or
	-- grabbed, juggled, pinned), never as a neutral dodge. The attacker gets a
	-- short window to track the reappearance.
	Substitution = {Cost = 15, Charges = 2, Recharge = 9, Cooldown = 1.1, Window = 0.42, Distance = 8, Track = 0.75},
	-- Damage scaling inside one combo: the first hits land in full, every later
	-- hit is worth less, and a combo that runs too long ends in a knockdown.
	ComboScaling = {Free = 2, Step = 0.12, Floor = 0.35, Reset = 0.45, MaxHits = 11},
	Clash = {Window = 0.07, Push = 4.5},
	-- Re-engage (CORE_COMBAT_CONVERGENCE_2 §3): one contextual action (E; on a pad
	-- × inside a chase window, sprint + ○ toward outside one). Inside a window it
	-- is the chase, outside it is this chakra dash at a locked opponent; both cost
	-- PursuitCost. The arrival converts at once into a strike, a heavy or a grab;
	-- guard, dodge or jump only after CancelAfter, so a predictable dash is
	-- punished. Unlocked, the dash is a straight Reposition-stud burst. Each
	-- prodigy re-enters his own way (MoveGraphs[...].reengage).
	Rush = {Cost = 8, Speed = 90, Range = 48, MinRange = 7, MaxTime = 0.55, Cooldown = 0.9, Arrive = 0.3, Recovery = 0.22, CancelAfter = 0.1, Reposition = 18},
	-- Combo model (§1): strings count confirmed hits only. Grace: a press from
	-- neutral this long after a chain window still continues the string.
	-- Buffer: a press made during a committed swing waits this long past its
	-- active window. Intent: a push stronger than IntentStrong is remembered for
	-- IntentWindow seconds; toward is within acos(Toward) of the line to the
	-- opponent, away within acos(Away) of the line away from him, side between.
	Combo = {Grace = 0.18, Buffer = 0.3, IntentStrong = 0.45, IntentWindow = 0.22, Toward = 0.64, Away = 0.57},
	-- Awakening: once per match, at low health, a fighter-specific power-up.
	Awaken = {Threshold = 0.35, Duration = 12},
	-- Rhythm: a chained strike pressed on the beat (not mashed early) is a Flow strike.
	Flow = {Early = 0.07, Late = 0.13, Damage = 1.15, Stop = 0.035},
	ThrowBreak = 0.35,
	RoundsToWin = 2,
	-- Where each fighter starts (studs from the centre): far enough apart that
	-- the round opens on an approach, not on a punch.
	StartDistance = 24,
	-- Server-side Animator playback (donor clips, default locomotion). Off: the
	-- client motion engine animates every body.
	DonorAnimations = false,
	Wall = {Detect = 3.4, Clearance = 1.7, RiseSpeed = 23, SideSpeed = 30, MaxTime = 1.65,
		ReboundUp = 61, ReboundAway = 29, ReattachDelay = 0.4,
		-- Wall combat: splat state, pins, tech window and the dive from a wall run.
		SplatSpeed = 17, SplatTime = 0.62, SplatDamage = 3, PinTime = 0.42, PinMax = 2,
		TechFrom = 0.05, TechUntil = 0.34, TechCost = 12, DiveRange = 50},
	RequestRate = 24, RequestBurst = 32, SnapshotInterval = 0.066,
	Movement = { SprintSpeed = 45, GroundAcceleration = 170, GroundDeceleration = 290, TurnAcceleration = 360, AirAcceleration = 76,
		BurstAcceleration = 520, BurstWindow = 0.16,
		-- Ninja jump at Gravity 140, gravity integrated once: ~12 studs apex and
		-- ~0.83 s of flight at scale 1 (JumpScale stretches it per fighter).
		-- HardLandVelocity sits above every fighter's own jump landing (~67 max),
		-- so only a real drop (~25 studs) lands heavy.
		JumpVelocity = 58, JumpCooldown = 0.4, AttackWalkSpeed = 12, HardLandVelocity = 84, FallbackGravity = 140,
		HardLandRecovery = 0.14, SoftLandRecovery = 0.04, HardLandSpeed = 14,
		MeleeTravelTime = 0.28, PursuitRecovery = 0.22 },
	-- Neutral rhythm (convergence §8): jutsu are paced (Gap + Jitter seconds
	-- between two, punishes excepted), a fast approach into melee range is read
	-- before the strike (guard / sidestep / counter-poke, no reaction latency:
	-- a guess), probing at range uses tools and step-in feints, and a fighter
	-- that just got hit backs off to neutral instead of mashing back.
	AI = { Tick = 0.18, Reaction = 0.38, Aggression = 0.72, Defense = 0.58, Technique = 0.34,
		TechniqueGap = 2.6, TechniqueJitter = 2.6, ReadGuard = 0.3, ReadDodge = 0.16, ReadPoke = 0.22, GuardRead = 0.07,
		Feint = 0.1, ProbeTool = 2.4, Disengage = 0.45, WallRun = 0.35 },
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND8">
        <Properties>
          <string name="Name">Controls</string>
          <ProtectedString name="Source">-- Semantic bindings shared by client, HUD and QA.
-- Keyboard is grouped around WASD so combat never needs a reach across the board;
-- PS5: the face buttons keep the existing layout; R1 modifies jutsu.
local Controls = {
	Keyboard = {
		-- Home row first: the actions used constantly sit under the left hand and
		-- the mouse, and substitution stays deliberately out of the way on X.
		Light = Enum.UserInputType.MouseButton1,
		Heavy = Enum.UserInputType.MouseButton2,
		Jump = Enum.KeyCode.Space,
		Dodge = Enum.KeyCode.Q,
		Guard = Enum.KeyCode.F,
		Grab = Enum.KeyCode.V,
		Tool = Enum.KeyCode.R,
		Pursuit = Enum.KeyCode.E,
		Substitute = Enum.KeyCode.X,
		Feint = Enum.KeyCode.G,
		WallDetach = Enum.KeyCode.C,
		Lock = Enum.KeyCode.LeftShift,
		Sprint = Enum.KeyCode.LeftControl,
		Technique5 = Enum.KeyCode.Five,
		Awaken = Enum.KeyCode.T,
		Skip = Enum.KeyCode.Escape,
	},
	Gamepad = {
		Light = Enum.KeyCode.ButtonX,
		Heavy = Enum.KeyCode.ButtonY,
		Jump = Enum.KeyCode.ButtonA,
		Dodge = Enum.KeyCode.ButtonB,
		Guard = Enum.KeyCode.ButtonL1,
		Tool = Enum.KeyCode.ButtonR2,
		Grab = Enum.KeyCode.ButtonL2,
		Lock = Enum.KeyCode.ButtonR3,
		Sprint = Enum.KeyCode.ButtonL3,
		Modifier = Enum.KeyCode.ButtonR1,
		Technique5 = Enum.KeyCode.DPadUp,
		Awaken = Enum.KeyCode.DPadDown,
		-- Re-engage on a pad is never a D-pad press (CORE_COMBAT_CONVERGENCE_2 §3):
		-- × chases inside a chase window (Input), and outside one a dodge (○)
		-- toward a locked opponent while sprinting (L3) is the chakra dash (the
		-- server reads the sprint and the stick: Brawler.dashIntent).
		Substitute = Enum.KeyCode.DPadRight,
		Skip = Enum.KeyCode.ButtonSelect,
	},
	-- Human-readable key names so HUD and tutorial copy cannot drift from bindings.
	KeyLabel = {
		Light = "LMB", Heavy = "RMB", Jump = "SPACE", Dodge = "Q", Guard = "F",
		Grab = "V", Tool = "R", Pursuit = "E", Substitute = "X", Feint = "G",
		WallDetach = "C", Lock = "SHIFT", Sprint = "CTRL", Technique5 = "5", Awaken = "T", Skip = "ESC",
	},
	-- HUD copy for the keyboard layout, kept next to the bindings it documents.
	Hint = "LMB light \u{00B7} RMB heavy",
	Help = "WASD move   SPACE jump   Q dodge   LMB light   RMB heavy   F guard   V grab / throw break   E re-engage (chase / chakra dash)   R tool   X substitute   G feint   T awaken   CTRL sprint   SHIFT lock   1-5 jutsu",
	-- The directional combo grammar, shared by every fighter.
	Grammar = "CLEAN HITS  2 hits → toward + LMB: launch · away + LMB: sweep  |  1 hit → side + LMB: angle  |  air hit → direction + LMB: drive / spike / switch  |  away + R in a string: retreat",
	GrammarPad = "CLEAN HITS  2 hits → toward + □: launch · away + □: sweep  |  1 hit → side + □: angle  |  air hit → direction + □: drive / spike / switch  |  away + R2 in a string: retreat",
	HelpPad = "L move · L3 sprint   R camera · R3 lock   □ light   △ heavy   ○ dodge / escape   × jump / chase   sprint + ○ toward: chakra dash   L1 guard   L2 grab   R2 tool   R1 + face: jutsu   D-pad → escape · ↓ awaken · ↑ jutsu 5",
	PadLabel = {Light="□",Heavy="△",Dodge="○",Jump="×",Guard="L1",Modifier="R1",Grab="L2",Tool="R2",Sprint="L3",Lock="R3",Pursuit="×",Dash="L3 + ○",Substitute="D-pad →",Feint="R1 + L2",WallDetach="R1 + L1"},
	TechniquePad = {"R1 + ×","R1 + □","R1 + △","R1 + ○","D-pad ↑"},
}

function Controls.comboHelp(graph,pad)
 local light=if pad then "□" else "LMB"
 local tool=if pad then "R2" else "R"
 local routes=graph.routes or {}
 local parts={"CLEAN HITS"}
 if routes.up then table.insert(parts,"2 hits → toward + "..light..": launch") end
 if routes.down then table.insert(parts,"2 hits → away + "..light..": sweep") end
 if routes.side then table.insert(parts,"1 hit → side + "..light..": angle") end
 local air={}
 if routes.airUp then table.insert(air,"toward: drive") end
 if routes.airDown then table.insert(air,"away: spike") end
 if routes.airSide then table.insert(air,"side: switch") end
 if #air&gt;0 then table.insert(parts,"Air hit + "..light.." → "..table.concat(air," / ")) end
 if graph.disengage then table.insert(parts,"away + "..tool.." in string: retreat") end
 return table.concat(parts,"  ·  ")
end
function Controls.isGamepad(kind)
 return kind~=nil and kind.Name:match("^Gamepad")~=nil
end
return Controls
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND9">
        <Properties>
          <string name="Name">Fighters</string>
          <ProtectedString name="Source">return {
	Flashstep = {
		Name = "Minato", FullName = "Minato Namikaze", Age = 13, Title = "THE FAST PRODIGY", Color = { 82, 177, 244 },
		Routes = "↑ rising kick (seals the body: 2 follows it up)  ·  ↓ spinning leg sweep (plants a marked kunai)  ·  ←→ angle step  ·  air: push kick / axe kick / flash switch",
		Description = "Decision speed. Kunai placement, angle changes and an unfinished teleport seal.",
		Health = 125, Chakra = 110, ChakraRegen = 8, Speed = 19.5, SprintScale = 1.12, JumpScale = 1.1, AirControlScale = 1.15, AccelerationScale = 1.15,
		CombatTravel = 1.18, CombatDamage = 1, DashScale = 1.15, GuardStrength = 0.10, PreferredRange = 6,
		ComboToolCancel = true, CombatStyle = "Angles", Tool = "Kunai",
		-- Shared ninja tools: everyone throws; mastery changes what a throw does.
		-- Minato: one fast kunai, the quickest recovery (the seals are his art).
		ToolMastery = { Kind = "kunai", Count = 1, Speed = 96, Damage = 3, Recover = .55 },
		-- Awakening: the Yellow Flash. Relocations chain: every Flying Thunder God
		-- leaves a seal where he stood (FlashWake), a body he launched or knocked
		-- away is a destination by itself (FlashPursuit), the arrival stays open
		-- longer; faster legs and techniques back almost at once.
		Awakening = { Name = "YELLOW FLASH", Speed = 1.18, Regen = 1.5, Cooldown = 0.4, FlashWake = true, FlashPursuit = true, Arrival = 0.8, Color = { 255, 214, 92 } },
		AttackProfile = {
			Light1={startup=.82,recovery=.9,travel=1.08,angle=.24,kind="slash"},Light2={startup=.84,recovery=.9,travel=1.12,angle=-.3,kind="palm"},
			Light3={startup=.82,recovery=.88,travel=1.2,angle=.36,impulseZ=52},Launcher={startup=.72,travel=1.16,impulseY=62},
			DashAttack={startup=.78,travel=1.16,angle=-.18},Air1={startup=.8,angle=.24},Air2={startup=.82,angle=-.3},Slam={startup=.78,recovery=.86},
		},
		Skin = { 225, 196, 166 }, Hair = { 225, 228, 212 }, Outfit = { 45, 104, 156 },
		Techniques = {
			-- Thrown while running: the seal travels as a real kunai and can be
			-- reached mid-flight by Flying Thunder God.
			{ Id = "MarkedBlade", Name = "Marked Kunai", Mobile = true, Throw = "MarkedKunai", Cost = 10, Channel = 0.12, Active = 0.02, Recovery = 0, Cooldown = 2.2, Interruptible = true, Range = 66, Damage = 6, Hint = "Plants a seal (two held at most) • a hit seals the body" },
			{ Id = "Flashstep", Name = "Flying Thunder God", Cost = 16, Channel = 0.06, Active = 0.04, Recovery = 0.2, Cooldown = 1.5, Interruptible = true, Flow = true, Range = 90, Requires = "Anchor", Hint = "Stick picks the seal and the side • strike or 3 on arrival" },
			{ Id = "BurstStrike", Name = "Rasengan", Cost = 24, Channel = 0.3, Active = 0.08, Recovery = 0.5, Cooldown = 5.5, Interruptible = true, Range = 8, Damage = 20, Hint = "Instant after a teleport • plunges when airborne • ends a clean string" },
			{ Id = "Quickstep", Name = "Quickstep", Cost = 12, Channel = 0.11, Active = 0.08, Recovery = 0.21, Cooldown = 2.3, Interruptible = true, Flow = true, Range = 12, Hint = "Create an angle • no guaranteed hit" },
			-- Thrown off the kunai's edge on the run: cuts enemy blades out of its
			-- lane; a body it cuts is thrown a step sideways with a short wind seal
			-- (Flying Thunder God lands beside it). Techniques.WindCut.
			{ Id = "WindCut", Name = "Wind Cut", Element = "Wind", Mobile = true, Throw = "Kunai", Cost = 14, Channel = 0.16, Active = 0.02, Recovery = 0, Cooldown = 3.2, Interruptible = true, Range = 40, Speed = 104, Damage = 6, Hint = "Thrown on the run • cuts blades in its lane • a cut body is marked: 2 lands beside it" },
		},
	},
	Mirage = {
		Name = "Itachi", FullName = "Itachi Uchiha", Age = 13, Title = "THE SHARINGAN PRODIGY", Color = { 222, 70, 80 },
		Routes = "↑ rising palm (shuriken cover the climb)  ·  ↓ reaping sweep  ·  ←→ feint step (an afterimage stays)  ·  air: side kick / hammer drop / hook switch",
		Description = "Sharingan already awakened. Reads, precise shuriken, deception and Katon fire.",
		Health = 145, Chakra = 125, ChakraRegen = 7.2, Speed = 18, SprintScale = 1.0, JumpScale = 0.98, AirControlScale = 0.95, AccelerationScale = 0.98,
		CombatTravel = 0.98, CombatDamage = 1.1, DashScale = 0.98, GuardStrength = 0.08, PreferredRange = 10,
		-- The Sharingan (three tomoe at 13): it sees strikes coming. Wider parry
		-- and perfect-dodge windows, each successful one opens a counter, and a
		-- raised guard tracks a teleport instead of being crossed up.
		Sharingan = { ParryWindow = 0.3, PerfectDodge = 0.22, Counter = 0.9 },
		ComboToolCancel = true, CombatStyle = "Control", Tool = "Shuriken",
		-- Itachi: a pair of shuriken; side + tool is Shuriken Geometry (a wide
		-- blade struck by a second one, redirected into the flank); his blades
		-- ricochet off walls and cover once; in the air he fans three down.
		ToolMastery = { Kind = "shuriken", Count = 2, Speed = 84, Damage = 2, Recover = .75, Geometry = true, Ricochet = true, AirSpread = 3 },
		-- Awakening: Sharingan focus. His raised guard reads (any frontal blow
		-- that meets it is parried and read: he slips aside, it bites the
		-- afterimage), every swing that misses close to him is read
		-- (WhiffRead, studs), cheaper and faster jutsu.
		Awakening = { Name = "SHARINGAN FOCUS", Speed = 1.06, Regen = 1.4, Cooldown = 0.6, CostScale = 0.6, Windows = 1.5, GuardRead = true, WhiffRead = 9, Color = { 230, 40, 50 } },
		AttackProfile = {
			Light1={startup=.96,recovery=.9,travel=.92,range=6.6},Light2={startup=.98,recovery=.88,travel=.9,range=7,chainTool=true,kind="palm"},
			Light3={startup=1.02,recovery=1.0,travel=.86,impulseZ=60,kind="kick"},Heavy={startup=.98,recovery=1.02,travel=.9},
			Launcher={startup=1.0,travel=.86,impulseY=53,impulseZ=20},DashAttack={startup=.95,travel=.92},
			Air1={startup=.98,travel=.9},Air2={startup=1.0,travel=.88},Slam={startup=1.0,recovery=1.0},
		},
		Skin = { 197, 164, 143 }, Hair = { 30, 31, 43 }, Outfit = { 69, 49, 66 },
		Techniques = {
			{ Id = "Read", Name = "Sharingan Read", Cost = 14, Channel = 0.1, Active = 1.0, Recovery = 0.2, Cooldown = 3.6, Interruptible = false, Range = 10, Hint = "Read one frontal strike: he slips aside, it bites the afterimage • strike in the stance = instant counter" },
			{ Id = "NeedleFan", Name = "Shadow Shuriken", Cost = 18, Channel = 0.26, Active = 0.08, Recovery = 0.26, Cooldown = 3.6, Interruptible = true, Flow = true, Range = 56, Damage = 2, Hint = "Five blades, then two hidden ones aimed at the dodge" },
			-- His image stays where he stood and he withdraws behind it, on the
			-- opponent's line of sight: a swing that reaches the image is caught
			-- (Techniques.MirageCast / whiffRead).
			{ Id = "MirageCast", Name = "Genjutsu: Mirage", Cost = 26, Channel = 0.42, Active = 0.06, Recovery = 0.2, Cooldown = 7, Interruptible = true, Flow = true, Range = 23, Requires = "Target", Hint = "His image stays, he withdraws behind it • a swing at the image is caught • trust the body" },
			{ Id = "FireBloom", Name = "Great Fireball", Element = "Fire", Cost = 26, Channel = 0.55, Active = 0.42, Recovery = 0.36, Cooldown = 5.5, Interruptible = true, Feintable = true, Range = 76, Speed = 58, Damage = 16, Hint = "A miss leaves the lane burning" },
			{ Id = "PhoenixFlower", Name = "Phoenix Flower", Element = "Fire", Cost = 20, Channel = 0.3, Active = 0.32, Recovery = 0.3, Cooldown = 5, Interruptible = true, Range = 60, Speed = 72, Damage = 4, Hint = "Five small flames fanned at the opponent • pressure" },
		},
	},
	-- Third prototype: the Hyuga genius at the Chunin Exam finals. Pure taijutsu
	-- with a different engine: palms that attack chakra, not health alone.
	GentleFist = {
		Name = "Neji", FullName = "Neji Hyuga", Age = 13, Title = "THE HYUGA GENIUS", Color = { 176, 196, 255 },
		Routes = "↑ palm heel under the chin  ·  ↓ low rotation sweep (closes two points)  ·  ←→ circular step onto a chakra point  ·  air: twin palms / descending palm / spinning palm",
		Description = "Byakugan and the Gentle Fist. Palms that close chakra points, a perfect rotation defence.",
		Health = 135, Chakra = 115, ChakraRegen = 7.6, Speed = 18.5, SprintScale = 1.0, JumpScale = 0.98, AirControlScale = 0.95, AccelerationScale = 1.02,
		CombatTravel = 1.0, CombatDamage = 0.95, DashScale = 1.0, GuardStrength = 0.1, PreferredRange = 5,
		ComboToolCancel = true, CombatStyle = "GentleFist", Tool = "Kunai",
		-- Neji: standard kunai, secondary to the Gentle Fist.
		ToolMastery = { Kind = "kunai", Count = 1, Speed = 86, Damage = 3, Recover = .85 },
		-- Awakening: Byakugan full field. No blind spot; he sees the whole network:
		-- a clean palm closes two chakra points (Points) and a palm that breaks a
		-- jutsu being moulded seals the techniques (ChannelCut, s); palms drain more.
		Awakening = { Name = "BYAKUGAN FULL FIELD", Speed = 1.08, Damage = 1.06, Regen = 1.5, Cooldown = 0.6, NoBlindSpot = true, Drain = 1.8, Points = 2, ChannelCut = 1.5, Color = { 200, 214, 255 } },
		-- Byakugan: near-360-degree sight. His guard covers every side except a
		-- narrow blind spot straight behind, and genjutsu decoys do not fool him.
		Byakugan = { BlindSpot = 0.9 },
		-- Gentle Fist: every palm drains chakra (even through a guard) and a clean
		-- one closes a chakra point, slowing the victim's chakra recovery.
		GentleFist = { Drain = 6, GuardDrain = 3, RegenCut = 0.15, MaxPoints = 4, Duration = 5 },
		AttackProfile = {
			Light1={startup=.92,recovery=.9,travel=1.0,range=6.4,kind="tenketsu",zone="body"},Light2={startup=.94,recovery=.9,travel=1.0,range=6.6,kind="tenketsu"},
			Light3={startup=1.0,recovery=.96,travel=1.05,impulseZ=54,kind="palm"},Heavy={startup=1.02,recovery=1.0,kind="palm"},
			Launcher={startup=.98,travel=.95,impulseY=56},DashAttack={startup=.94,travel=1.02},
			Air1={startup=.96},Air2={startup=.98},Slam={startup=1.0},
		},
		Skin = { 228, 202, 178 }, Hair = { 52, 36, 30 }, Outfit = { 226, 220, 206 },
		Techniques = {
			{ Id = "Rotation", Name = "Rotation", Cost = 24, Channel = 0.04, Active = 0.55, Recovery = 0.24, Cooldown = 6, Interruptible = false, Range = 7, Damage = 6, Hint = "Spinning dome • repels strikes and blades • counter after" },
			{ Id = "VacuumPalm", Name = "Vacuum Palm", Cost = 14, Channel = 0.18, Active = 0.06, Recovery = 0.26, Cooldown = 2.8, Interruptible = true, Flow = true, Range = 32, Speed = 96, Damage = 7, Hint = "Air-pressure palm • pushes into walls • ends a clean string" },
			{ Id = "SixtyFourPalms", Name = "64 Palms", Cost = 30, Channel = 0.22, Active = 0.12, Recovery = 0.4, Cooldown = 10, Interruptible = true, Range = 5, Damage = 3, Hint = "Point blank • each closed point adds palms and seal time • four closed: the guard collapses" },
		},
	},
	-- Fourth playable prototype: Sasuke at the Chunin Exam (12). Faster and
	-- more aggressive than his brother, a kicking taijutsu base, fire, wire and
	-- the Chidori he has just learned: one opening becomes a mobile assault,
	-- but every big commitment can be punished.
	Lion = {
		Name = "Sasuke", FullName = "Sasuke Uchiha", Age = 12, Title = "THE ROOKIE OF THE YEAR", Color = { 92, 132, 255 },
		Routes = "↑ rising kick into Shadow of the Dancing Leaf (heavy in the air: LION COMBO)  ·  ↓ low kick sweep  ·  ←→ vault over into a back kick  ·  air: drive / axe kick / switch",
		Description = "Pressure. Kicks, wire and fire. A launcher he follows into the air and a Chidori that ends everything — or him.",
		Health = 120, Chakra = 105, ChakraRegen = 7.5, Speed = 19, SprintScale = 1.1, JumpScale = 1.15, AirControlScale = 1.15, AccelerationScale = 1.12,
		CombatTravel = 1.12, CombatDamage = 1.05, DashScale = 1.08, GuardStrength = 0.08, PreferredRange = 6,
		ComboToolCancel = true, CombatStyle = "Lion", Tool = "Shuriken",
		-- Aggressive shuriken use: a fast pair and a short recovery.
		ToolMastery = { Kind = "shuriken", Count = 2, Speed = 92, Damage = 2, Recover = .6 },
		-- Two-tomoe Sharingan: smaller windows than Itachi's, the same idea.
		Sharingan = { ParryWindow = 0.24, PerfectDodge = 0.18, Counter = 0.7 },
		-- The cursed seal: faster and harder, but it eats his body while it burns.
		-- His kicks do not let go (Extension: the third kick and the air drive
		-- stagger instead of knocking away, the string stays open), every
		-- launcher becomes the Dancing Leaf (CursedLeaf), the drain doubles when
		-- he stops landing blows (Hunger) and pauses after each one (Feed, s),
		-- and the cursed body takes more (Vulnerability).
		Awakening = { Name = "CURSE MARK", Speed = 1.15, Damage = 1.12, Regen = 1.3, Cooldown = 0.6, HealthDrain = 1.4, Hunger = 2, Feed = 0.6, Vulnerability = 0.12, Extension = true, CursedLeaf = true, Color = { 120, 60, 200 } },
		AttackProfile = {
			Light1={startup=.9,recovery=.95},Light2={startup=.95,range=6.6,kind="kick"},Light3={startup=1.05,impulseZ=56,range=6.8},
			DashAttack={travel=1.1},Air1={startup=.92},Air2={startup=.92},
		},
		Skin = { 236, 210, 190 }, Hair = { 24, 26, 40 }, Outfit = { 34, 40, 72 },
		Techniques = {
			{ Id = "FireBloom", Name = "Great Fireball", Element = "Fire", Cost = 24, Channel = 0.5, Active = 0.4, Recovery = 0.36, Cooldown = 5.5, Interruptible = true, Feintable = true, Range = 70, Speed = 58, Damage = 15, Hint = "On a wired opponent: Dragon Flame runs along the wire" },
			{ Id = "PhoenixFlower", Name = "Phoenix Flower", Element = "Fire", Cost = 20, Channel = 0.28, Active = 0.32, Recovery = 0.3, Cooldown = 5, Interruptible = true, Range = 56, Speed = 72, Damage = 4, HiddenBlades = true, Hint = "Flames with two shuriken hidden inside" },
			{ Id = "WireTrap", Name = "Wire Trap", Cost = 18, Channel = 0.18, Active = 0.08, Recovery = 0.3, Cooldown = 6, Interruptible = true, Range = 34, Damage = 3, Hint = "A wired shuriken binds • then 1 for Dragon Flame" },
			{ Id = "Chidori", Name = "Chidori", Element = "Lightning", Cost = 34, Channel = 0.62, Active = 0.05, Recovery = 0.1, Cooldown = 9, Interruptible = true, Range = 20, Damage = 22, Hint = "Charge, then a lightning thrust • a miss leaves him open" },
		},
	},
	-- Fourth prototype: Gaara at the Chunin Exam (12). A slow, patient
	-- controller: the sand blocks for him, strikes at range and binds.
	Sand = {
		Name = "Gaara", FullName = "Gaara of the Sand", Age = 12, Title = "THE SAND PRODIGY", Color = { 222, 176, 112 },
		Description = "The sand fights for him: an automatic shield, long sand lashes and a coffin that binds. Slow, patient, crushing.",
		Health = 140, Chakra = 130, ChakraRegen = 7, Speed = 16.5, SprintScale = 0.85, JumpScale = 0.9, AirControlScale = 0.85, AccelerationScale = 0.85,
		CombatTravel = 0.2, CombatDamage = 1, DashScale = 1, GuardStrength = 0.1, PreferredRange = 11,
		ComboToolCancel = true, CombatStyle = "Sand", Tool = "Sand",
		-- Sand shield: while charged it stops hits by itself (not while he is
		-- attacking or already hurt). A heavy blow, a third string hit or a
		-- Rasengan breaks it outright; charges come back one at a time.
		SandShield = { Charges = 3, Regen = 3.5, Break = 17 },
		-- His heavy is not a punch: sand erupts under the opponent at range.
		HeavyMove = "SandPillar", LauncherMove = "SandPillar",
		-- Dodge: a sand body-flicker (instant reposition) instead of a roll.
		SandFlicker = { Distance = 12 },
		Awakening = { Name = "SHUKAKU'S SAND", Speed = 1.12, Damage = 1.12, Regen = 1.6, Cooldown = 0.5, ShieldRegen = 2, Color = { 222, 176, 112 } },
		AttackProfile = {
			-- Sand lashes: long, narrow volumes in front of him.
			-- Slower than a fist, long to recover and light: the reach is paid for
			-- (pokes that set up the pillar and the coffin, not a damage string).
			Light1={startup=1.45,recovery=1.3,travel=.25,range=8.5,depth=7.5,offset=4.3,width=3.4,damage=.8},Light2={startup=1.45,recovery=1.3,travel=.25,range=8.5,depth=7.5,offset=4.3,width=3.4,damage=.5},
			Light3={startup=1.5,recovery=1.35,travel=.25,range=9,depth=8,offset=4.5,width=4.2,impulseZ=56,damage=.5},DashAttack={startup=1.1,travel=.8,range=8.5},
			Air1={startup=1.1,range=8},Air2={startup=1.1,range=8},Slam={startup=1.1},
		},
		Skin = { 236, 214, 196 }, Hair = { 164, 42, 34 }, Outfit = { 52, 46, 52 },
		Techniques = {
			{ Id = "SandCoffin", Name = "Sand Coffin", Cost = 26, Channel = 0.35, Active = 0.1, Recovery = 0.35, Cooldown = 8, Interruptible = true, Range = 30, Speed = 46, Damage = 18, Hint = "A wave of sand binds, then crushes • substitution escapes" },
			{ Id = "SandShuriken", Name = "Sand Shuriken", Cost = 16, Channel = 0.25, Active = 0.08, Recovery = 0.25, Cooldown = 3.5, Interruptible = true, Range = 38, Damage = 3, Hint = "Six hardened sand blades" },
			{ Id = "DesertWave", Name = "Desert Wave", Element = "Earth", Cost = 22, Channel = 0.26, Active = 0.2, Recovery = 0.3, Cooldown = 6, Interruptible = true, Range = 12, Damage = 7, Hint = "A wall of sand throws close attackers away" },
		},
	},
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND10">
        <Properties>
          <string name="Name">MoveGraphs</string>
          <ProtectedString name="Source">-- Character move graphs: the data half of each fighter's combat identity.
-- Shared fundamentals (strings, launcher, chase, air route, defence) live in
-- Brawler/Combat; what a fighter does *differently* inside them is declared
-- here, so a new prodigy adds a table entry plus only the bespoke code its kit
-- really needs.
--
-- Directional combo grammar (shared by every fighter, interpreted by each).
-- Hits are CONFIRMED hits (a whiff or a blocked strike restarts the string);
-- the stick is read relative to the opponent through a short memory
-- (Config.Combo), so a push released a moment before the press still counts.
--   routes.up      stick toward the opponent + strike, 2+ hits in: launcher
--   routes.down    stick away + strike, 2+ hits in: low route (sweep)
--   routes.side    stick left/right + strike, 1+ hit in: lateral route
--   routes.airUp / airDown / airSide   the same grammar after an air hit:
--                  drive away, spike down, switch sides
--   disengage      stick away + tool inside a string: hop out behind a throw
--   onRoute[name]  what that fighter's version of a route adds (a seal, blades)
--   heavyAfterOne  heavy after one clean hit, and the heavy on a re-engage
--                  arrival (chase or chakra dash)
--   stringCancels[techniqueId] techniques that may cancel a clean string
--                              (with a shortened wind-up)
--   blockCancels[action]       actions still allowed out of a blocked light
--   readCounter                move started by the next press after a Read
--   reengage       how the prodigy re-enters (Combat:reengage / chase / rush):
--                  speed (x Config.Rush.Speed), arrive (studs short of the
--                  body), angle (degrees off the line he arrives on), chase
--                  (seconds of a chase), recovery (an unanswered arrival),
--                  minRange, and the style's own rules: sealAngle/sealPull
--                  (a planted seal near the target), afterimage + feint (guard
--                  or dodge aborts the dash), commit + past (the line is fixed
--                  after `commit` s and aims `past` studs through the body),
--                  dashDamage (the arrival strike). `name` reaches the client.
return {
	Flashstep={
		routes={up="Launcher",down="Sweep",side="AngleStep",airUp="AirDrive",airDown="AirSpike",airSide="AirSwitch"},
		disengage="Kunai",
		-- The rising kick leaves a seal on the body (2 follows it up); the leg
		-- sweep plants a marked kunai where the opponent fell.
		onRoute={Launcher="bodySeal",Sweep="floorSeal"},
		-- Heavy after one clean cut: a rising knee that pops the opponent up.
		heavyAfterOne="KneeStrike",
		stringCancels={BurstStrike=true},
		blockCancels={},
		-- Surgical: the fastest re-entry, onto an angle beside the body; a seal
		-- planted near the target pulls him onto its side, wider and quicker.
		reengage={name="flash",speed=1.3,arrive=3.2,angle=32,sealAngle=58,sealPull=1.12,chase=.24,recovery=.14},
	},
	Mirage={
		routes={up="Launcher",down="Sweep",side="FeintStep",airUp="AirDrive",airDown="AirSpike",airSide="AirSwitch"},
		disengage="Shuriken",
		-- The rising palm is covered by two shuriken thrown up after the body;
		-- the feint step leaves an afterimage where he stood.
		onRoute={Launcher="coverBlades",AirDrive="coverBlades"},
		-- Heavy after one clean strike: the palm that drives the opponent away
		-- (toward a wall when one is near) instead of the launcher.
		heavyAfterOne="CounterPalm",
		-- Body attack -&gt; projectile cover: a clean string ends in Shadow Shuriken.
		stringCancels={NeedleFan=true},
		blockCancels={Tool=true},
		readCounter="CounterPalm",
		-- Calm and deceptive: a slower approach that leaves an afterimage where
		-- he started, arrives a little aside, and can be aborted (guard or dodge).
		reengage={name="mirage",speed=.8,arrive=3.8,angle=18,afterimage=true,feint=true,chase=.34,recovery=.2},
	},
	GentleFist={
		routes={up="Launcher",down="Sweep",side="CircleStep",airUp="AirDrive",airDown="AirSpike",airSide="AirSwitch"},
		disengage="Kunai",
		-- Every Gentle Fist route closes chakra points; the low routes (the sweep
		-- and the descending air palm) close two.
		onRoute={Sweep="tenketsu",AirSpike="tenketsu"},
		-- Heavy after a single clean palm: a twin-palm thrust that drives the
		-- opponent away (into a wall when one is near) instead of the launcher.
		heavyAfterOne="PalmThrust",
		stringCancels={VacuumPalm=true},
		blockCancels={},
		-- After Rotation repels an attack, the next press is the palm thrust.
		readCounter="PalmThrust",
		-- Compact and direct: straight down the centre line, tighter, and from
		-- closer than anyone else.
		reengage={name="palm",speed=1.02,arrive=2.9,angle=0,minRange=5,chase=.3,recovery=.18},
	},
	Lion={
		routes={up="LionKick",down="Sweep",side="VaultKick",airUp="AirDrive",airDown="AirSpike",airSide="AirSwitch"},
		disengage="Shuriken",
		-- The rising kick is followed into the air at once (Shadow of the
		-- Dancing Leaf); a heavy there is the Lion Combo.
		onRoute={LionKick="shadowLeaf"},
		heavyAfterOne="KneeStrike",
		stringCancels={Chidori=true},
		blockCancels={},
		-- Explosive and committed: fast, his line is fixed almost at once and aims
		-- through the body (a side-step makes him overshoot), the arrival strike
		-- hits harder, an unanswered arrival recovers longest.
		reengage={name="lion",speed=1.15,arrive=2.8,angle=0,commit=.06,past=2.6,dashDamage=1.15,chase=.28,recovery=.3},
	},
	Sand={
		routes={up="SandPillar",down="Sweep"},
		-- One lash, then the pillar: sand erupts under the opponent.
		heavyAfterOne="SandPillar",
		stringCancels={SandCoffin=true},
		blockCancels={Tool=true},
	},
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND11">
        <Properties>
          <string name="Name">OnlineProtocol</string>
          <ProtectedString name="Source">-- Online 1v1 (NET-001): shared tunables and the request vocabulary of the
-- online flow. Authority stays in Server/Online and Server/Matches; nothing in
-- here is ever read back from a client.
return table.freeze({
	-- Seconds both players get to confirm (or change) their fighter once paired;
	-- the duel starts when both confirm or when the time runs out.
	PickTime=15,
	-- Private duel codes: short, upper case, no look-alike characters (0/O, 1/I/L).
	CodeLength=5,
	CodeAlphabet="ABCDEFGHJKMNPQRSTUVWXYZ23456789",
	-- Minimum gap between two lobby requests of one player (same as the local duel).
	LifecycleGap=0.8,
	-- Requests that enter or leave the online flow from the roster / waiting screen.
	Lifecycle=table.freeze({Queue=true,Host=true,Join=true,Cancel=true}),
	-- The only requests an online fighter may send during a fight. Anything else
	-- is ignored before it reaches Combat.
	Combat=table.freeze({Move=true,Attack=true,Heavy=true,Jump=true,JumpOff=true,Dodge=true,Guard=true,GuardOff=true,
		Grab=true,Tool=true,Pursuit=true,Substitute=true,Feint=true,WallDetach=true,Awaken=true,
		Technique1=true,Technique2=true,Technique3=true,Technique4=true,Technique5=true}),
})
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND12">
        <Properties>
          <string name="Name">Rules</string>
          <ProtectedString name="Source">-- Pure policy shared by server combat and headless tests. Authority lives on server.
local Rules = {}
local free = { Neutral = true, Guarding = true }
function Rules.finite(n)
	return type(n) == "number" and n == n and math.abs(n) &lt; 1e6
end
function Rules.canAct(a, now)
	return a.health &gt; 0 and free[a.state] == true and now &gt;= (a.lockUntil or 0)
end
function Rules.technique(a, spec, now, prerequisites)
	if not Rules.canAct(a, now) then return false, "Committed" end
	if (a.cooldowns[spec.Id] or 0) &gt; now then return false, "Cooldown" end
	if a.chakra &lt; spec.Cost then return false, "Need chakra" end
	if not prerequisites then return false, "Condition missing" end
	return true
end
function Rules.reserve(a, spec, now)
	a.chakra -= spec.Cost
	a.cooldowns[spec.Id] = now + spec.Cooldown
	a.state = "TechniqueChannel"
	a.untilTime = now + spec.Channel
end
function Rules.consumeToken(bucket, now, rate, burst)
	bucket.tokens = math.min(burst, bucket.tokens + math.max(0, now - bucket.time) * rate)
	bucket.time = now
	if bucket.tokens &lt; 1 then return false end
	bucket.tokens -= 1
	return true
end
function Rules.interruptible(a)
	return a.state == "TechniqueChannel" and a.pending ~= nil and a.pending.spec.Interruptible == true
end
function Rules.isGuard(a, frontal)
	return a.state == "Guarding" and frontal and a.chakra &gt; 0
end
return Rules
</ProtectedString>
        </Properties>
      </Item>
