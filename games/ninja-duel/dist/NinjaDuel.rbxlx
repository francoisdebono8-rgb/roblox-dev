      <Item class="ModuleScript" referent="ND4">
        <Properties>
          <string name="Name">AnimationBindings</string>
          <ProtectedString name="Source">-- After publishing the retargeted Bangla sequences under the experience owner,
-- replace these zeros with that owner's R15 animation IDs (not the original R6 IDs).
return {Punch=0,HardSmack=0,MegaPunch=0,Parry=0}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND5">
        <Properties>
          <string name="Name">Attacks</string>
          <ProtectedString name="Source">-- Bangla three-strike M1 foundation; air/grab/launch branches are Ninja Duel glue.
local Combo=require(script.Parent.BanglaCombo)
local function move(startup,active,recovery,damage,travel,reaction,impulse,stun)
 return {startup=startup,active=active,recovery=recovery,damage=damage,travel=travel,
  travelTime=startup+active,reaction=reaction or "HitStun",impulse=impulse or Vector3.new(0,0,7),stun=stun or 0.27,
  range=7.8,width=5.5,height=6,blockable=true}
end
local attacks={
 Light1=move(.10,.12,Combo.comboDelay-.22,Combo.Damage.Punch,2.8),
 Light2=move(.11,.12,Combo.comboDelay-.23,Combo.Damage.HardSmack,3.2),
 Light3=move(.13,.13,Combo.comboDelay-.26,Combo.Damage.MegaPunch,3.5,"Knockback",Vector3.new(0,12,43),.4),
 Heavy=move(.28,.17,.48,16,4.5,"Knockdown",Vector3.new(0,12,28),.65),
 Launcher=move(.18,.14,.28,9,2.5,"Launched",Vector3.new(0,52,11),1.15),
 DashAttack=move(.08,.15,.29,7,7,"HitStun",Vector3.new(0,0,9),.29),
 Air1=move(.09,.13,.19,6,2.5,"Juggled",Vector3.new(0,13,5),.6),
 Air2=move(.11,.13,.20,7,2.5,"Juggled",Vector3.new(0,15,5),.6),
 Slam=move(.17,.18,.37,13,2,"Knockdown",Vector3.new(0,-65,8),.8),
 Grab=move(.18,.14,.5,0,2,"Grabbed",Vector3.zero,.8),
 Throw=move(.12,.1,.34,10,0,"Knockdown",Vector3.new(0,18,48),.7),
 ThrowUp=move(.12,.1,.3,7,0,"Launched",Vector3.new(0,50,10),1.1),
}

for name,spec in attacks do
 if not Combo.Actions[name] then spec.depth=spec.range*.8;spec.offset=spec.range*.4 end
 spec.animation=name;spec.feedback=spec.reaction;spec.chain=name=="Light1" or name=="Light2" or name=="Air1" or name=="Air2" or name=="DashAttack"
end
for _,name in {"Light1","Light2","Light3"} do attacks[name].width=5;attacks[name].height=5;attacks[name].range=6 end
attacks.Grab.range=4.6;attacks.Grab.blockable=false;attacks.Throw.blockable=false;attacks.ThrowUp.blockable=false
return attacks
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND6">
        <Properties>
          <string name="Name">BanglaCombo</string>
          <ProtectedString name="Source">-- Adapted from BanglaBattlegrounds StarterPack/Punch/PunchMoves (Dewan Mukto, MIT).
-- Input and cooldown authority moved to the server; no Tool or independent input loop.
local Combo={maxComboCount=3,comboDelay=.5,resetDelay=1.1}
function Combo.next(actor,now)
 local comboTimer=now-actor.lastAttack
 local comboCount=actor.combo
 local maxComboCount=Combo.maxComboCount
 local comboDelay=Combo.resetDelay
 -- Donor combo progression, retained verbatim with per-actor state.
 if comboTimer &lt;= comboDelay then
  comboCount = comboCount + 1
  if comboCount &gt; maxComboCount then
   comboCount = 1
  end
 else
  comboCount = 1
 end
 actor.combo=comboCount;actor.lastAttack=now
 return 'Light'..comboCount
end
Combo.Actions={Light1='Punch',Light2='HardSmack',Light3='MegaPunch'}
-- Donor server damageValues and Animation objects, never supplied by clients.
Combo.Damage={Punch=5,HardSmack=10,MegaPunch=25}
Combo.AnimationIds={Punch=18342131933,HardSmack=18342045122,MegaPunch=18341956985,Parry=18341905406}
return Combo
</ProtectedString>
        </Properties>
      </Item>
