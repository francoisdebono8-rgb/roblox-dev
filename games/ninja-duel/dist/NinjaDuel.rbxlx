      </Item>
      <Item class="ModuleScript" referent="ND28">
        <Properties>
          <string name="Name">DonorAnimations</string>
          <ProtectedString name="Source">-- R6 -&gt; R15 compatibility only; transforms/times remain the donor choreography.
local Donor={}
local basis={
 Torso=CFrame.Angles(-math.pi/2,0,math.pi),Head=CFrame.Angles(-math.pi/2,0,math.pi),
 ['Right Arm']=CFrame.Angles(0,math.pi/2,0),['Left Arm']=CFrame.Angles(0,-math.pi/2,0),
 ['Right Leg']=CFrame.Angles(0,math.pi/2,0),['Left Leg']=CFrame.Angles(0,-math.pi/2,0),
}
local mapped={Head='Head',['Right Arm']='RightUpperArm',['Left Arm']='LeftUpperArm',
 ['Right Leg']='RightUpperLeg',['Left Leg']='LeftUpperLeg'}
local function pose(parent,name,cf,weight)
 local p=Instance.new('Pose');p.Name=name;p.CFrame=cf;p.Weight=weight or 1;p.Parent=parent;return p
end
function Donor.retarget(sequence)
 local result=Instance.new('KeyframeSequence');result.Name=sequence.Name..'_R15';result.Loop=sequence.Loop;result.Priority=sequence.Priority
 for _,frame in sequence:GetKeyframes() do
  local key=Instance.new('Keyframe');key.Name=frame.Name;key.Time=frame.Time;key.Parent=result
  local byName={};for _,p in frame:GetDescendants() do if p:IsA('Pose') then byName[p.Name]=p end end
  local source=byName.Torso
  local root=pose(key,'HumanoidRootPart',CFrame.identity,0)
  local torsoCF=if source then basis.Torso*source.CFrame*basis.Torso:Inverse() else CFrame.identity
  local lower=pose(root,'LowerTorso',torsoCF)
  local upper=pose(lower,'UpperTorso',CFrame.identity)
  for old,name in mapped do
   local src=byName[old]
   if src then
    local b=basis[old]
    local cf=b*src.CFrame*b:Inverse()
    local p=pose(if old:find('Leg') then lower else upper,name,cf,src.Weight)
    p.EasingStyle=src.EasingStyle;p.EasingDirection=src.EasingDirection
   end
  end
  for _,child in frame:GetChildren() do if child:IsA('KeyframeMarker') then child:Clone().Parent=key end end
 end
 return result
end
return Donor
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND29">
        <Properties>
          <string name="Name">Elements</string>
          <ProtectedString name="Source">-- Element families define different gameplay primitives. Fire and Wind are
-- equipped in this slice; the other families reserve explicit behavior seams.
local Elements={
	Families={
		Fire={primitive="TravellingBlast",counter="Sidestep the fireball, then punish the recovery"},
		Lightning={primitive="PrecisionBurst",counter="Bait the committed line"},
		Wind={primitive="Displacement",counter="Sidestep the cutting lane"},
		Water={primitive="MovingControlVolume",counter="Cross behind the wave"},
		Earth={primitive="SolidGroundCover",counter="Reposition around cover"},
	},
}
-- Katon: Great Fireball. Released from the mouth after the hand signs, it is a
-- real travelling volume that grows as it flies, bursts on contact and leaves
-- burning ground behind.
function Elements.fire(c,a,pending,now)
	local spec=pending.spec
	local aim=pending.aim or (a.target and a.target.root.Position) or a.root.Position+a.root.CFrame.LookVector*spec.Range
	local origin=c.launchPoint(a,"Fireball")
	-- Fire travels flat and slightly down onto the opponent's body, never into
	-- the sky when the aim point is a little high.
	local delta=aim-origin
	local flat=Vector3.new(delta.X,0,delta.Z)
	if flat.Magnitude&lt;1 then flat=a.root.CFrame.LookVector*Vector3.new(1,0,1) end
	local drop=math.clamp(delta.Y,-flat.Magnitude*.35,flat.Magnitude*.08)
	local target=origin+flat.Unit*spec.Range+Vector3.new(0,drop*spec.Range/math.max(flat.Magnitude,1),0)
	c:projectile(a,target,spec.Speed or 54,spec.Range,spec.Damage,"fireball",nil,{origin=origin,radius=2.4,growth=2.2,heavy=true})
	c:cue(a,"KATON • GREAT FIREBALL")
end
-- Katon: Phoenix Flower. Five small flames released one after another, each
-- re-aimed at the opponent with a lateral offset: a fan that follows the
-- target and pressures a sidestep, with small burning patches where they land.
function Elements.phoenix(c,a,pending,now)
	local spec=pending.spec
	local offsets={0,-5,5,-2.5,2.5}
	for k,offset in offsets do
		c:schedule(now+(k-1)*.06,function()
			if a.health&lt;=0 or a.reaction or a.state=="Stunned" then return end
			local victim=a.target
			local goal=if victim and victim.health&gt;0 then victim.root.Position+victim.root.AssemblyLinearVelocity*Vector3.new(1,0,1)*.15 else a.root.Position+a.root.CFrame.LookVector*spec.Range
			local origin=c.launchPoint(a,"Fireball")
			local flat=Vector3.new(goal.X-origin.X,0,goal.Z-origin.Z)
			if flat.Magnitude&lt;1 then flat=a.root.CFrame.LookVector*Vector3.new(1,0,1) end
			local side=Vector3.new(-flat.Unit.Z,0,flat.Unit.X)
			local aim=goal+side*offset+Vector3.new(0,-.6,0)
			c:projectile(a,aim,spec.Speed or 68,spec.Range,spec.Damage,"phoenix",nil,{origin=origin,radius=.9,growth=.35})
		end)
	end
	-- Sasuke hides two shuriken inside the flames.
	if spec.HiddenBlades then
		for k=1,2 do
			c:schedule(now+.14+k*.07,function()
				if a.health&lt;=0 or a.reaction or a.state=="Stunned" or not a.target or a.target.health&lt;=0 then return end
				local side=a.root.CFrame.RightVector*(if k==1 then -1.5 else 1.5)
				-- Skill build (Wired Flames): the hidden blades trail wire and bind.
				if spec.WiredBlades then
					c:projectile(a,a.target.root.Position+side,90,spec.Range,2,"wire",nil,{riders={bind=spec.WiredBlades}})
				else
					c:projectile(a,a.target.root.Position+side,90,spec.Range,2,"shuriken")
				end
			end)
		end
	end
	c:cue(a,"KATON • PHOENIX FLOWER")
end
function Elements.wind(c,a,pending)
	local aim=pending.aim
	if (aim-a.root.Position).Magnitude&lt;1 then aim=a.root.Position+a.root.CFrame.LookVector*pending.spec.Range end
	-- Skill build (Gale Chase): a gust that connects opens the chase window.
	c:projectile(a,aim,88,pending.spec.Range,pending.spec.Damage,"wind",nil,{radius=1.4,riders=if pending.spec.Chase then {chase=pending.spec.Chase} else nil})
	c:cue(a,"WIND • CUTTING LANE")
end
return Elements
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="ND30">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("NinjaDuel")
Players.CharacterAutoLoads=false
local remote=Instance.new("RemoteEvent"); remote.Name="Action"; remote.Parent=Shared
local Matches=require(script.Parent.Matches)
local matches=Matches.new(remote)
remote.OnServerEvent:Connect(function(player,payload) matches:request(player,payload) end)
Players.PlayerAdded:Connect(function(player) matches:selection(player) end)
Players.PlayerRemoving:Connect(function(player) matches:remove(player) end)
for _,player in Players:GetPlayers() do matches:selection(player) end
RunService.Heartbeat:Connect(function(dt) matches:update(dt,workspace:GetServerTimeNow()) end)
-- Studio-only playtest hooks (no effect in a live server).
if RunService:IsStudio() and workspace:GetAttribute("NinjaDuelDebug")==true then
	require(script.Parent.DevHooks).install(matches)
end
-- Available only in the separately built native QA place; never in the playable artifact.
if RunService:IsStudio() and workspace:GetAttribute("NinjaDuelQA")==true then
	task.spawn(function() require(script.Parent.NativeQA).run(matches) end)
end
print("[NinjaDuel] BUILD "..Shared.BuildFingerprint.Value)
print("[NinjaDuel] Ready — select a fighter and start the duel")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND31">
        <Properties>
          <string name="Name">Matches</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Config=require(Shared.Config)
local Fighters=require(Shared.Fighters)
local Rules=require(Shared.Rules)
local World=require(script.Parent.World)
local Combat=require(script.Parent.Combat)
local AI=require(script.Parent.AI)
local Tutorial=require(script.Parent.Tutorial)
local AntiCheat=require(script.Parent.VelmoraAntiCheat)
local Techniques=require(script.Parent.Techniques)
local Online=require(script.Parent.Online)
local SkillBuilds=require(script.Parent.SkillBuilds)
local BuildPresets=require(script.Parent.BuildPresets)
local Matches={}; Matches.__index=Matches
-- Skill builds (PROG-001..003) are resolved and validated here, on the server:
-- a spec is {nodes={...}, unlocked={[id]=true}} (unlocked = the profile's set)
-- or, for the AI, {preset="Hard"}; with a ranked bracket the build must also
-- fit its budget. Returns true + kit (nil = no build) or false + reason.
function Matches.resolveKit(fighterId,spec,bracket)
	if spec==nil then return true,nil end
	if type(spec)~="table" then return false,"Invalid build" end
	local nodes=spec.nodes
	if spec.preset~=nil then
		nodes=BuildPresets.ai(fighterId,spec.preset)
		if not nodes then return false,"Unknown AI preset" end
	end
	local kit,reason
	if bracket~=nil then kit,reason=SkillBuilds.admit(bracket,fighterId,nodes,spec.unlocked)
	else kit,reason=SkillBuilds.build(fighterId,nodes,{unlocked=spec.unlocked}) end
	if not kit then return false,reason end
	return true,kit
end
function Matches.new(remote)
	local folder=Instance.new("Folder"); folder.Name="NinjaDuels"; folder.Parent=workspace
	local self=setmetatable({remote=remote,folder=folder,sessions={},nextLane=0,epoch=0},Matches)
	-- Online 1v1 (queue, private codes, two-player duels) on the same sessions.
	self.online=Online.new(self)
	return self
end
-- Each duel owns a stage far from every other one.
function Matches.laneOrigin(lane)
	return Vector3.new((lane-1)*520,0,0)
end
function Matches:send(player,data)
	if player.Parent==Players then self.remote:FireClient(player,data) end
end
function Matches:session(player)
	if self.sessions[player] then return self.sessions[player] end
	self.nextLane+=1
	local s={phase="Selection",lane=self.nextLane,bucket={tokens=Config.RequestBurst,time=os.clock()},lastLifecycle=-10,epoch=0}
	self.sessions[player]=s; return s
end
function Matches:destroy(s)
	if s.combat then s.combat:clear() end
	if s.human then AntiCheat.clear(s.human) end
	if s.folder then s.folder:Destroy() end
	s.tutorial=nil; s.folder=nil; s.combat=nil; s.ai=nil; s.human=nil; s.bot=nil
end
function Matches:selection(player,notice)
	local s=self:session(player)
	if s.online and self.online then self.online:leave(player,s) end
	self:destroy(s)
	player.Character=nil; s.phase="Selection"; s.epoch+=1
	self:send(player,{phase="Selection",epoch=s.epoch,notice=notice})
end
-- `options` (optional): {player=spec, bot=spec, bracket=id} skill builds (see
-- Matches.resolveKit). An invalid or over-budget build refuses the start. No
-- options: both fighters are exactly today's kits.
function Matches:start(player,playerId,botId,training,options)
	local s=self:session(player)
	if not Fighters[playerId] or not Fighters[botId] then return false end
	local playerKit,botKit
	if options~=nil then
		if type(options)~="table" then return false,"Invalid options" end
		local ok,result=Matches.resolveKit(playerId,options.player,options.bracket)
		if not ok then return false,result end
		playerKit=result
		ok,result=Matches.resolveKit(botId,options.bot,options.bracket)
		if not ok then return false,result end
		botKit=result
	end
	self:destroy(s); s.epoch+=1
	s.playerId=playerId; s.botId=botId; s.winner=nil; s.phase="Duel"; s.origin=Matches.laneOrigin(s.lane)
	s.options=options
	s.folder=Instance.new("Folder"); s.folder.Name="Duel_"..s.lane; s.folder.Parent=self.folder
	s.effects=Instance.new("Folder"); s.effects.Name="Effects"; s.effects.Parent=s.folder
	World.arena(s.folder,s.origin)
	s.combat=Combat.new(s); s.combat.now=workspace:GetServerTimeNow()
	local function actor(id,def,position,look,kit)
		local model,hum,root,joints=World.rig(s.folder,Fighters[def],CFrame.lookAt(position,look),id)
		return s.combat:add(id,model,hum,root,joints,def,kit)
	end
	s.human=actor("PlayerFighter",playerId,s.origin+Vector3.new(0,3,Config.StartDistance),s.origin+Vector3.new(0,3,-Config.StartDistance),playerKit)
	s.bot=actor("AIFighter",botId,s.origin+Vector3.new(0,3,-Config.StartDistance),s.origin+Vector3.new(0,3,Config.StartDistance),botKit)
	s.human.target=s.bot; s.bot.target=s.human; s.human.locked=true; s.bot.locked=true
	player.Character=s.human.model
	s.ai=AI.new(s.combat,s.bot,player.UserId%100000+ s.epoch)
	s.finishing=false
	-- Tournament rounds: first to two (one in training).
	s.round=1;s.wins={PlayerFighter=0,AIFighter=0};s.roundsToWin=if training then 1 else Config.RoundsToWin
	s.finish=function(winner,_loser)
		self:roundOver(s,winner,function() self:snapshot(player,s) end,function() self:nextRound(player,s) end)
	end
	s.tutorial=nil; if training then Tutorial.new(s) end
	-- Tournament framing: both fighters are shown before the round begins.
	s.introUntil=if training then nil else s.combat.now+2.6
	local epoch=s.epoch
	s.human.hum.Died:Connect(function() if s.epoch==epoch and s.phase=="Duel" then s.human.health=0; s.human.state="Defeated"; s.finish(s.bot,s.human) end end)
	s.bot.hum.Died:Connect(function() if s.epoch==epoch and s.phase=="Duel" then s.bot.health=0; s.bot.state="Defeated"; s.finish(s.human,s.bot) end end)
	self:snapshot(player,s)
	return true
end
-- A round is won. Shared by the local duel and the online duel: `notify` sends
-- the snapshots, `advance` starts the next round.
function Matches:roundOver(s,winner,notify,advance)
	if s.phase~="Duel" or s.finishing then return end
	-- The finishing blow gets a beat: the world holds, the camera eases out
	-- and K.O. is called before the next round or the result screen.
	s.finishing=true; s.winner=winner.id
	s.wins[winner.id]=(s.wins[winner.id] or 0)+1
	local decided=s.wins[winner.id]&gt;=s.roundsToWin
	s.matchPoint=decided
	local finishEpoch=s.epoch
	notify()
	task.delay(if decided then 1.5 else 1.9,function()
		if s.epoch~=finishEpoch or not s.finishing or s.phase~="Duel" then return end
		s.finishing=false
		if not decided then advance();return end
		s.phase="Result"; s.combat:clear(true)
		for _,a in s.combat.actors do World.pose(a,s.combat.now,0.1) end
		for _,a in s.combat.actors do a.hum.WalkSpeed=0; a.root.Anchored=true end
		notify()
	end)
end
function Matches:nextRound(player,s)
	self:resetRound(s)
	s.ai=AI.new(s.combat,s.bot,player.UserId%100000+s.epoch)
	self:snapshot(player,s)
end
-- Next round: same stage and bodies, fresh fighters, a short intro. A new
-- epoch tells the client to reset its presentation like a fresh duel. The
-- first actor (the player, or online seat 1) restarts on +Z, the second on -Z.
function Matches:resetRound(s)
	local c=s.combat
	local first,second=c.actors[1],c.actors[2]
	s.epoch+=1;s.round+=1;s.winner=nil;s.matchPoint=false
	c:clear(true)
	for _,a in c.actors do
		a.health=a.def.Health;a.hum.Health=a.health;a.chakra=a.def.Chakra or Config.Chakra;a.cooldowns={}
		a.subCharges=Config.Substitution.Charges;a.subCooldown=0;a.subRegenAt=math.huge
		a.state="Neutral";a.untilTime=0;a.koStyle=nil;a.koAirborne=nil;a.groundPose=nil;a.reaction=nil;a.reactionVelocity=nil
		a.stamina=100;a.hitstopUntil=0;a.root.Anchored=false;a.hum.WalkSpeed=a.def.Speed
		a.shieldCharges=a.def.SandShield and a.def.SandShield.Charges or 0
	end
	c:relocate(first,s.origin+Vector3.new(0,3,Config.StartDistance));c:relocate(second,s.origin+Vector3.new(0,3,-Config.StartDistance))
	first.root.CFrame=CFrame.lookAt(first.root.Position,second.root.Position)
	second.root.CFrame=CFrame.lookAt(second.root.Position,first.root.Position)
	s.introUntil=c.now+1.8
end
function Matches:snapshot(player,s)
	self:send(player,self:view(s,s,s.human,s.bot))
end
-- The duel seen from one side: `human` is the viewer's own actor and `bot` the
-- opponent (its model is named bot.id); `winner` reads "PlayerFighter" when
-- the viewer won. `cursor` holds this viewer's impact feed position: the local
-- session itself, or an online seat.
function Matches:view(s,cursor,mine,theirs)
	local now=s.combat.now
	-- Every Flying Thunder God seal the client should draw: planted kunai
	-- (surface + normal) and the seal riding on the opponent's body.
	local function sealList(a)
		local list={}
		for _,seal in Techniques.seals(s.combat,a,now) do
			local entry=seal.anchor
			if entry then
				table.insert(list,{id=entry.id or 0,surface=entry.surface or seal.position,normal=entry.normal or Vector3.yAxis,
					remaining=math.max(0,entry.expires-now),body=entry.actor and entry.actor.id,wind=entry.wind==true,wake=entry.wake==true})
			end
		end
		return list
	end
	local function data(a)
		local ready={}
		for i,spec in a.def.Techniques do
			ready[i]={id=spec.Id,name=spec.Name,cost=spec.Cost,remaining=math.max(0,(a.cooldowns[spec.Id] or 0)-now),condition=not spec.Requires or (spec.Requires=="Anchor" and Techniques.sealOf(s.combat,a,now)~=nil) or (spec.Requires=="Target" and s.combat:targetValid(a,a.target,spec.Range,0.35))}
		end
		return {id=a.id,fighterId=a.fighterId,fighter=a.def.Name,health=a.health,maxHealth=a.def.Health,chakra=a.chakra,maxChakra=a.def.Chakra or Config.Chakra,stamina=a.stamina or 100,state=a.state,
			techniques=ready,position=a.root.Position,channel=if a.state=="TechniqueChannel" then math.max(0,a.untilTime-s.combat.now) else 0,
			anchor=a.anchor and a.anchor.position,illusion=math.max(0,a.illusionUntil-s.combat.now),decoy=a.decoyPosition,
			cue=if a.cueUntil&gt;s.combat.now then a.cue else "",dodge=math.max(0,a.dodgeUntil-s.combat.now),read=math.max(0,a.readUntil-s.combat.now),
			speed=a.locomotion.Magnitude,airborne=a.airborne,sprinting=a.model:GetAttribute("MovementSprinting")==true,
			landStrong=a.model:GetAttribute("MovementHardLanding")==true,pursuit=math.max(0,a.pursuitUntil-s.combat.now),combo=a.combo,
			subCharges=a.subCharges,wall=a.wall~=nil,reaction=a.reaction,guardImpact=math.max(0,(a.guardImpact or 0)-s.combat.now),attackName=a.attackName,attackElapsed=s.combat.now-(a.attackStarted or 0),airHold=a.airHold,impactSerial=a.impactSerial or 0,impactHeavy=a.impactHeavy,impactStyle=a.impactStyle,
			hitFrom=a.hitFrom,hitAngle=a.hitAngle,hitStrength=a.hitStrength or 0,hitZone=a.hitZone,hitKind=a.hitKind,hitTwist=a.hitTwist,groundPose=a.groundPose,groundSide=a.groundSide,koStyle=a.koStyle,koAirborne=a.koAirborne,reactionElapsed=math.max(0,s.combat.now-(a.reactionStartedAt or s.combat.now)),events=a.events,velocity=if a.state=="Dodging" then (a.dodgeDirection or Vector3.zero)*35 else a.root.AssemblyLinearVelocity,
			-- Presentation timing for throws, casts, teleports and variants:
			-- elapsed values are measured on the server clock the client shares.
			attackSerial=a.attackSerial or 0,attackVariant=a.attackVariant,
			throwSerial=a.throwSerial or 0,throwKind=a.throwKind,throwElapsed=now-(a.throwStarted or -10),throwRelease=a.throwRelease or .1,
			castId=a.castId,castElapsed=now-(a.castStarted or now),
			anchorSurface=a.anchor and a.anchor.surface,anchorNormal=a.anchor and a.anchor.normal,anchorRemaining=a.anchor and math.max(0,a.anchor.expires-now) or 0,
			teleportSerial=a.teleportSerial or 0,flash=(a.flashUntil or 0)&gt;now,lookVector=a.root.CFrame.LookVector,
			-- Phase 4: combo scaling, recharging substitution, seals, wall state.
			comboHits=a.comboHits or 0,comboDamage=a.comboDamage or 0,
			subRegen=if (a.subRegenAt or math.huge)&lt;math.huge then math.max(0,a.subRegenAt-now) else 0,
			seals=sealList(a),splatNormal=if a.reaction=="WallSplat" then a.splatNormal else nil,
			splatElapsed=if a.reaction=="WallSplat" then now-(a.splatAt or now) else nil,
			counter=math.max(0,(a.counterUntil or 0)-now),warpSerial=a.warpSerial or 0,
			shield=a.shieldCharges or 0,shieldMax=a.def.SandShield and a.def.SandShield.Charges or 0,bound=a.reaction=="Bound",
			awaken=math.max(0,(a.awakenUntil or 0)-now),
			awakenReady=a.def.Awakening~=nil and not a.awakened and a.health&gt;0 and a.health&lt;=a.def.Health*Config.Awaken.Threshold,
			-- Neji: Rotation dome, closed chakra points and sealed techniques.
			rotation=(a.rotationUntil or 0)&gt;now,tenketsu=if (a.tenketsuUntil or 0)&gt;now then a.tenketsu or 0 else 0,
			sealed=math.max(0,(a.sealedUntil or 0)-now),
			-- Identity cues: which chakra points are closed on this body (body
			-- locations the client lights), a severed network, the kind of
			-- genjutsu it is under, a hungry Curse Mark.
			tenketsuPoints=if (a.tenketsuUntil or 0)&gt;now then table.clone(a.tenketsuPoints or {}) else {},
			tenketsuSevere=(a.tenketsuUntil or 0)&gt;now and (a.tenketsu or 0)&gt;=4,
			illusionKind=if (a.illusionUntil or 0)&gt;now then a.illusionKind else nil,
			curseHunger=a.curseHunger==true}
	end
	-- Live projectiles: straight constant-speed flights the client reproduces
	-- exactly on the shared server clock, so blades and fire never stutter.
	local projectiles={}
	for _,p in s.combat.projectiles do
		table.insert(projectiles,{id=p.id,kind=p.kind,origin=p.origin,direction=p.direction,speed=p.speed,born=p.born,range=p.range,owner=p.a.id,radius=p.radius,growth=p.growth})
	end
	local hazards={}
	for _,h in s.combat.hazards do
		table.insert(hazards,{position=h.position,radius=h.radius,remaining=math.max(0,h.expires-now),kind=h.kind,owner=h.a.id})
	end
	-- Only contacts the client has not been sent yet; remotes are ordered and
	-- reliable, and the client still filters by serial.
	local feed={}
	local sent=if cursor.impactEpoch==s.epoch then (cursor.sentImpact or 0) else 0
	for _,impact in s.combat.impacts do if impact.serial&gt;sent then table.insert(feed,impact) end end
	cursor.sentImpact=s.combat.impactSerial or 0;cursor.impactEpoch=s.epoch
	local wins=s.wins or {}
	return {phase=s.phase,epoch=s.epoch,winner=s.winner and (if s.winner==mine.id then "PlayerFighter" else "AIFighter"),tutorial=Tutorial.snapshot(s),origin=s.origin,human=data(mine),bot=data(theirs),impacts=feed,impactSerial=s.combat.impactSerial or 0,
		projectiles=projectiles,hazards=hazards,serverNow=now,intro=math.max(0,(s.introUntil or 0)-now),ko=s.finishing==true,
		round=s.round or 1,wins={human=wins[mine.id] or 0,bot=wins[theirs.id] or 0},roundsToWin=s.roundsToWin or 1,matchPoint=s.matchPoint}
end
function Matches:request(player,payload)
	local s=self:session(player); local clock=os.clock()
	if not Rules.consumeToken(s.bucket,clock,Config.RequestRate,Config.RequestBurst) then return end
	if type(payload)~="table" or type(payload.action)~="string" or #payload.action&gt;24 then return end
	local action=payload.action
	if action=="Ready" then
		if s.online and self.online then self.online:refresh(player,s)
		elseif s.phase=="Selection" then self:send(player,{phase="Selection",epoch=s.epoch}) else self:snapshot(player,s) end
		return
	end
	if payload.epoch~=s.epoch then return end
	-- The online flow owns every request of a player who is in it.
	if self.online and self.online:request(player,s,action,payload,clock) then return end
	if action=="TutorialSkip" and s.tutorial then self:selection(player);s.tutorial=nil;return end
	if action=="Start" or action=="Tutorial" or action=="Rematch" or action=="Selection" then
		if clock-s.lastLifecycle&lt;0.8 then return end
		if (action=="Start" or action=="Tutorial") and s.phase=="Selection" then
			if type(payload.player)~="string" or type(payload.bot)~="string" then return end
			s.lastLifecycle=clock; self:start(player,payload.player,payload.bot,action=="Tutorial")
		elseif action=="Rematch" and (s.phase=="Result" or s.finishing) then
			s.lastLifecycle=clock; self:start(player,s.playerId,s.botId,s.tutorial~=nil,s.options)
		elseif action=="Selection" and (s.phase=="Result" or s.finishing or s.tutorial) then s.lastLifecycle=clock; self:selection(player) end
		return
	end
	if s.phase~="Duel" or not s.human then return end
	self:act(s,s.human,payload,clock)
end
-- One player's input to their own actor: validated intent only, never state.
-- Shared by the local duel (s.human) and the online duel (each seat's actor);
-- the anti-cheat timing and rate state is kept per actor, so per player.
function Matches:act(s,actor,payload,clock)
	local action=payload.action
	if action~="Move" and not AntiCheat.check(actor,action,payload.clientTime,workspace:GetServerTimeNow()) then
		-- Diagnostics for latency tests: how many presses were refused, and how
		-- old the last refused one was (late packets vs rate limit).
		actor.refusedInputs=(actor.refusedInputs or 0)+1
		actor.refusedAge=if type(payload.clientTime)=="number" then workspace:GetServerTimeNow()-payload.clientTime else nil
		return
	end
	local function vector(v)
		return typeof(v)=="Vector3" and Rules.finite(v.X) and Rules.finite(v.Y) and Rules.finite(v.Z)
	end
	if action=="Move" then
		if s.autopilot or s.scripted or s.finishing then return end
		if not vector(payload.direction) or payload.direction.Magnitude&gt;1.01 or math.abs(payload.direction.Y)&gt;0.01 then return end
		actor.move=payload.direction; actor.lastMove=clock
		if type(payload.sprint)=="boolean" then actor.sprinting=payload.sprint end
		if type(payload.locked)=="boolean" then
			if actor.locked~=payload.locked then require(script.Parent.Brawler).event(s.combat,actor,if payload.locked then "Lock" else "Unlock") end
			actor.locked=payload.locked
		end
		-- Directional memory for routes: a strong push is kept for a moment even
		-- when it falls between two server frames (Brawler.observe).
		require(script.Parent.Brawler).observe(s.combat,actor)
		return
	end
	-- An action carries the same validated movement intent as Move. This keeps
 -- directional routes/dodges atomic with the button press, without granting
 -- the client authority over a route, state, cooldown or hit.
 if payload.direction~=nil and (not vector(payload.direction) or payload.direction.Magnitude&gt;1.01 or math.abs(payload.direction.Y)&gt;.01) then return end
 local aim=nil
	if payload.aim~=nil then
		if not vector(payload.aim) or (payload.aim-actor.root.Position).Magnitude&gt;150 then return end
		aim=payload.aim
	end
	if payload.direction~=nil and not (s.autopilot or s.scripted or s.finishing) then
  actor.move=payload.direction;actor.lastMove=clock
  if type(payload.sprint)=="boolean" then actor.sprinting=payload.sprint end
 end
 -- The held guard key is an intent that outlives a refused press (Combat
 -- re-raises it once free). Only players send it; the AI guards per tick.
 if action=="Guard" then actor.guardWanted=true elseif action=="GuardOff" then actor.guardWanted=false end
 local ok,reason=s.combat:request(actor,action,aim,payload.clientTime)
	if not ok and reason~="Committed" and reason~="Intro" then s.combat:cue(actor,string.upper(reason)) end
end
function Matches:update(dt,now)
	for player,s in self.sessions do
		-- Online players' duels are stepped once each by Online:update below.
		if s.phase=="Duel" and not s.online then
			if os.clock()-s.human.lastMove&gt;0.4 then s.human.move=Vector3.zero end
			s.combat:update(math.min(dt,0.1),now)
			if s.phase=="Duel" then
				local intro=s.introUntil and now&lt;s.introUntil
				if s.tutorial then Tutorial.update(s,now,dt) elseif not s.botFrozen and not intro and not s.finishing then s.ai:update(now) end
			end
		end
		-- Regular cadence, plus an immediate packet when a contact, throw or
		-- teleport happened so presentation never waits a full interval.
		local urgent=s.combat and s.combat.urgent and now&gt;=(s.lastUrgent or 0)+.03
		if s.combat and (now&gt;=(s.nextSnapshot or 0) or urgent) then
			s.nextSnapshot=now+Config.SnapshotInterval; s.combat.urgent=false; s.lastUrgent=now; self:snapshot(player,s)
		end
	end
	if self.online then self.online:update(dt,now) end
end
function Matches:remove(player)
	local s=self.sessions[player]
	if s then
		-- A disconnect forfeits an online fight and frees queue entries and codes.
		if s.online and self.online then self.online:leave(player,s) end
		self:destroy(s); self.sessions[player]=nil
	end
end
return Matches
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND32">
        <Properties>
          <string name="Name">Motor</string>
          <ProtectedString name="Source">-- Server movement authority. This module owns locomotion, landing and safe
-- action travel; AI and human actors use the same movement profile.
local Config=require(game:GetService("ReplicatedStorage").NinjaDuel.Config)
local Place1Movement=require(script.Parent.Place1Movement)
local Place1Parkour=require(script.Parent.Place1Parkour)
-- This adapter retains swept action travel and the NinjaWall extension only.
-- Place1 owns free locomotion/jump/air steering/mantle/wall-hop at runtime.
local Motor={}
local function donor(a,c)
 if not a.movementDonor then a.movementDonor=Place1Movement.new(a,c);a.parkourDonor=Place1Parkour.new(a,c) end
 return a.movementDonor,a.parkourDonor
end
function Motor.reset(a)
 if a.parkourDonor then a.parkourDonor.reset() end
 a.movementDonor=nil;a.parkourDonor=nil
end
local UP=Vector3.yAxis
local function flat(v) return Vector3.new(v.X,0,v.Z) end
function Motor.grounded(a,c)
	local p=RaycastParams.new(); p.FilterType=Enum.RaycastFilterType.Exclude
	p.FilterDescendantsInstances={a.model,c.match.effects}
	p.RespectCanCollide=true
	return workspace:Raycast(a.root.Position,Vector3.new(0,-3.6,0),p)~=nil
end
function Motor.jump(a,c,now)
 local movement,parkour=donor(a,c)
 if parkour.jump() then return true end
 return movement.jump(Motor.grounded(a,c))
end
function Motor.detach(a,now,rebound)
	local wall=a.wall
	if not wall then return false end
	a.wall=nil; a.wallNext=now+Config.Wall.ReattachDelay
	if rebound then a.wallJumpUntil=now+0.22 end
	if rebound and a.parkourDonor then a.parkourDonor.rebound(wall.normal)
 else a.root.AssemblyLinearVelocity=wall.normal*12+UP*8 end
	a.airborne=true
	return true
end
function Motor.tryWall(a,c,now)
	if a.wall or now&lt;(a.wallNext or 0) or a.move.Magnitude&lt;0.25 or a.state~="Neutral" then return false end
	local heading=flat(a.move)
	if heading.Magnitude&lt;0.25 then return false end
 local _,parkour=donor(a,c)
 local hit=parkour.wallSurface()
	if not hit or not hit.Instance:GetAttribute("NinjaWall") or math.abs(hit.Normal.Y)&gt;0.18 then return false end
	if heading.Unit:Dot(-hit.Normal)&lt;0.45 then return false end
	a.wall={part=hit.Instance,normal=hit.Normal,untilTime=now+Config.Wall.MaxTime}
	a.airborne=true;a.airDodgeUsed=false
	c:cue(a,"WALL RUN • SPACE REBOUND / C DETACH",0.8)
	return true
end
function Motor.stepWall(a,c,dt,now)
	local wall=a.wall
	if not wall then return false end
	if now&gt;=wall.untilTime or not wall.part.Parent or a.state=="Stunned" or a.state=="Defeated" then
		Motor.detach(a,now,false);return false
	end
	local p=RaycastParams.new();p.FilterType=Enum.RaycastFilterType.Exclude
	p.FilterDescendantsInstances={a.model,c.match.effects};p.RespectCanCollide=true
	local hit=workspace:Raycast(a.root.Position, -wall.normal*Config.Wall.Detect,p)
	if not hit or hit.Instance~=wall.part or hit.Normal:Dot(wall.normal)&lt;0.72 then
		Motor.detach(a,now,false);return false
	end
	local into=math.max(0,flat(a.move):Dot(-wall.normal))
	local side=flat(a.move)+wall.normal*into
	local motion=side*Config.Wall.SideSpeed+UP*Config.Wall.RiseSpeed*math.max(0.2,into)
	local target=hit.Position+wall.normal*Config.Wall.Clearance+motion*dt
	if target.Y&gt;wall.part.Position.Y+wall.part.Size.Y*0.5+1 then Motor.detach(a,now,true);return false end
	local obstacle=workspace:Raycast(a.root.Position,target-a.root.Position,p)
	if obstacle and obstacle.Instance~=wall.part then Motor.detach(a,now,false);return false end
	a.root.CFrame=CFrame.lookAt(c:clamp(target),c:clamp(target)-wall.normal)
	a.root.AssemblyLinearVelocity=Vector3.zero
	a.hum.AutoRotate=false;a.hum:Move(Vector3.zero,false)
	a.locomotion=side*Config.Wall.SideSpeed
	return true
end
function Motor.travel(a,c,direction,distance)
	local v=flat(direction)
	if v.Magnitude&lt;0.01 or distance&lt;=0 then return 0 end
	local start=a.root.Position
	local vector=v.Unit*distance
	local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances={a.model,c.match.effects}
	params.RespectCanCollide=true
	local hit=workspace:Raycast(start,vector,params)
	local advance=if hit then math.max(0,hit.Distance-2.1) else vector.Magnitude
	local target=c:clamp(start+v.Unit*advance)
	a.root.CFrame=CFrame.new(target)*a.root.CFrame.Rotation
	return (target-start).Magnitude
end
-- Full 3D swept travel used by chase and controlled victim trajectories.
function Motor.flight(a,c,delta)
 if delta.Magnitude&lt;.001 then return nil end
 local params=c:rayParams(true);params.RespectCanCollide=true
 local hit=workspace:Raycast(a.root.Position,delta.Unit*(delta.Magnitude+1.4),params)
 local movement=if hit then delta.Unit*math.max(0,hit.Distance-1.4) else delta
 local target=c:clamp(a.root.Position+movement)
 -- Root centre stays above the floor; actor body geometry is cosmetic.
 a.root.CFrame=CFrame.new(target)*a.root.CFrame.Rotation
 a.root.AssemblyLinearVelocity=Vector3.zero
 return hit
end
-- Continuous aimed motion in three dimensions. The swept helper above teleports
-- the root along a line, which made chase and slam read as
-- advance -&gt; correction -&gt; advance. Kinetic motion instead accelerates a real
-- velocity towards the target and integrates it, so the server position and the
-- replicated velocity never disagree.
local function paramsFor(a,c)
	local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances={a.model,c.match.effects};params.RespectCanCollide=true
	return params
end
local function approach(current,target,delta)
	if target&gt;current then return math.min(target,current+delta) end
	return math.max(target,current-delta)
end
function Motor.move(a,c,aim,dt)
	local velocity=a.root.AssemblyLinearVelocity
	local offset=aim.target-a.root.Position
	if offset.Magnitude&lt;.02 then return 0 end
	local desired=offset.Unit*aim.speed
	local accel=aim.acceleration or 200
	local target=Vector3.new(
		approach(velocity.X,desired.X,accel*dt),
		approach(velocity.Y,desired.Y,accel*dt),
		approach(velocity.Z,desired.Z,accel*dt))
	local floor=c.match and c.match.origin.Y+3 or -math.huge
	-- With Studio physics live, the velocity set last frame has already moved the
	-- root; integrating it by hand as well doubled rush/chase speed and made them
	-- advance in visible jerks (measured natively). Hand integration is kept for a
	-- body nothing else steps (headless harness, a stalled root).
	local here=a.root.Position
	local last=a.kineticLast
	local live=last~=nil and c.now-last.at&lt;.1 and (here-last.position).Magnitude&gt;math.max(.01,last.speed*dt*.25)
	if live then
		local vy=if here.Y+target.Y*dt&lt;floor then 0 else target.Y
		a.root.AssemblyLinearVelocity=Vector3.new(target.X,vy,target.Z)
		a.fallSpeed=if vy&lt;0 then math.max(a.fallSpeed or 0,-vy) else 0
		a.kineticLast={at=c.now,position=here,speed=target.Magnitude}
		return Vector3.new(target.X*dt,0,target.Z*dt).Magnitude
	end
	-- Integrate the horizontal part by hand: server-owned actors must move even
	-- when no physics solver is stepping them. Vertical follows the same velocity
	-- unless the floor stops it, which also keeps grounded actors on the ground.
	local deltaPos=Vector3.new(target.X*dt,0,target.Z*dt)
	local advance=deltaPos
	if deltaPos.Magnitude&gt;.0001 then
		local hit=workspace:Raycast(a.root.Position,deltaPos,paramsFor(a,c))
		if hit then advance=deltaPos.Unit*math.max(0,hit.Distance-1.9) end
	end
	local nextY=a.root.Position.Y+target.Y*dt
	local blockedFloor=nextY&lt;floor
	local y=if blockedFloor then floor else nextY
	local nextPosition=c:clamp(Vector3.new(a.root.Position.X+advance.X,y,a.root.Position.Z+advance.Z))
	a.root.CFrame=CFrame.new(nextPosition)*a.root.CFrame.Rotation
	a.root.AssemblyLinearVelocity=Vector3.new(target.X,if blockedFloor then 0 else target.Y,target.Z)
	a.fallSpeed=if target.Y&lt;0 then math.max(a.fallSpeed or 0,-target.Y) else 0
	a.kineticLast={at=c.now,position=nextPosition,speed=target.Magnitude}
	return advance.Magnitude
end
-- Vertical partner of Motor.move, used by the slam plunge.
function Motor.descend(a,c,speed,dt)
	local velocity=a.root.AssemblyLinearVelocity
	local vertical=approach(velocity.Y,-math.abs(speed),320*dt)
	local delta=Vector3.new(0,vertical*dt,0)
	local hit=workspace:Raycast(a.root.Position,delta,paramsFor(a,c))
	if hit then
		a.root.CFrame=CFrame.new(c:clamp(hit.Position+hit.Normal*1.9))*a.root.CFrame.Rotation
		a.root.AssemblyLinearVelocity=Vector3.new(velocity.X,0,velocity.Z)
		return true
	end
	a.root.CFrame=CFrame.new(c:clamp(a.root.Position+delta))*a.root.CFrame.Rotation
	a.root.AssemblyLinearVelocity=Vector3.new(velocity.X,vertical,velocity.Z)
	return false
end
function Motor.step(a,c,dt,now)
	local profile=Config.Movement
 donor(a,c)
	if not a.wall then Motor.tryWall(a,c,now) end
	if Motor.stepWall(a,c,dt,now) then return false end
	local vertical=a.root.AssemblyLinearVelocity.Y
	if vertical&lt;0 then a.fallSpeed=math.max(a.fallSpeed or 0,-vertical) end
	local grounded=Motor.grounded(a,c)
	if grounded and a.airborne and now&gt;(a.takeoffUntil or 0) and a.root.AssemblyLinearVelocity.Y&lt;=5 then
		a.airborne=false; a.airDodgeUsed=false; a.airHold=0
		local falling=a.fallSpeed or 0;a.fallSpeed=0
		-- Only a real drop costs speed. A standard or sprint jump lands below
		-- HardLandVelocity and keeps its momentum straight into the next step.
		local hard=falling&gt;profile.HardLandVelocity
		a.landUntil=if hard then now+profile.HardLandRecovery else nil
		a.model:SetAttribute("MovementLandedAt",now)
		a.model:SetAttribute("MovementHardLanding",hard)
		c:effect("Land dust",a.root.Position-Vector3.new(0,2.8,0),a.color,Vector3.new(3,0.15,3),0.15)
	end
	if not grounded then a.airborne=true end
 local movement,parkour=donor(a,c)
 a.grounded=grounded
 if parkour.step() then return false end
 local sprinting=movement.step(dt,grounded)
 -- Gravity fallback for server-owned actors with no client simulation. Real
 -- physics owns a falling root; this only pulls back a body that has stalled in
 -- the air, which is what used to leave a fighter hovering after a slam. When
 -- the solver already moved the root since the last step, applying it too would
 -- integrate gravity twice: a rocket hop, a crash landing, half the air time.
 local airY=a.root.Position.Y
 if not grounded and a.reaction==nil and not a.wall then
  local velocity=a.root.AssemblyLinearVelocity
  -- First airborne step only records: the solver gets one frame to show it is live.
  local stalled=a.fallbackAirY~=nil and math.abs(airY-a.fallbackAirY)&lt;math.max(.005,math.abs(a.fallbackAirVY or 0)*dt*.25)
  if stalled then
   local fall=math.min(70,velocity.Y-Config.Movement.FallbackGravity*dt)
   a.root.CFrame=CFrame.new(c:clamp(a.root.Position+Vector3.new(0,fall*dt,0)))*a.root.CFrame.Rotation
   a.root.AssemblyLinearVelocity=Vector3.new(velocity.X,fall,velocity.Z)
  end
  a.fallbackAirY=a.root.Position.Y;a.fallbackAirVY=a.root.AssemblyLinearVelocity.Y
 else
  a.fallbackAirY=nil;a.fallbackAirVY=nil
 end
 local locomotion=a.locomotion
 -- The awakening's speed bonus (speedScale) is part of the limit: the donor
 -- movement already asks for it, and clamping it back here cancelled it.
 local limit=(if sprinting then profile.SprintSpeed*(a.def.SprintScale or 1) else a.def.Speed)*(a.speedScale or 1)
 if a.state=="Guarding" then limit=Config.GuardSpeed
 elseif a.state=="TechniqueChannel" then limit=Config.ChannelSpeed
 elseif a.state=="Stunned" or a.state=="Defeated" or a.state=="Dodging" or a.state=="Pursuit" or a.state=="Rush" then limit=0
 elseif a.state~="Neutral" then limit=profile.AttackWalkSpeed end
 if a.aimIntent then
  -- Chase and slam supply their own continuous motion for this frame.
  Motor.move(a,c,a.aimIntent,dt)
  a.locomotion=Vector3.new(a.root.AssemblyLinearVelocity.X,0,a.root.AssemblyLinearVelocity.Z)
  a.hum.WalkSpeed=a.locomotion.Magnitude
  a.hum:Move(if a.locomotion.Magnitude&gt;.01 then a.locomotion.Unit else Vector3.zero)
  a.model:SetAttribute("MovementBase","Kinetic")
  return grounded
 end
 if a.grabVictim then limit=math.min(limit,5) end
 if now&lt;(a.landUntil or 0) then limit=math.min(limit,profile.HardLandSpeed) end
	 if locomotion.Magnitude&gt;limit then locomotion=locomotion.Unit*limit end
	 a.locomotion=locomotion
	 a.hum.WalkSpeed=locomotion.Magnitude
	 a.hum:Move(if locomotion.Magnitude&gt;.01 then locomotion.Unit else Vector3.zero,false)
 a.model:SetAttribute("MovementBase","Place1")
	return grounded
end
return Motor
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND33">
        <Properties>
          <string name="Name">Online</string>
          <ProtectedString name="Source">-- Online 1v1 (NET-001): casual queue, private duel codes, a short fighter
-- pick, then a duel between two players on the same server-authoritative
-- Combat as the local duel, with the same rounds, KO beat and result.
--  * Each player's requests drive only their own actor, through the local
--    duel's validation, per-player rate limit and anti-cheat (Matches:act).
--  * No AI is ever created or updated for an online duel.
--  * Every viewer receives the local-duel snapshot from their own side:
--    `human` is their actor and `bot` the opponent, whose model in the shared
--    duel folder is named `bot.id`; `winner` and `wins` are mapped the same way.
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Config=require(Shared.Config)
local Fighters=require(Shared.Fighters)
local Protocol=require(Shared.OnlineProtocol)
local World=require(script.Parent.World)
local Combat=require(script.Parent.Combat)
local AntiCheat=require(script.Parent.VelmoraAntiCheat)
local Online={};Online.__index=Online
function Online.new(matches)
	return setmetatable({matches=matches,queue={},codes={},duels={},freeLanes={},rng=Random.new()},Online)
end
local function fighter(id)
	return if type(id)=="string" and #id&lt;=24 and Fighters[id]~=nil then id else nil
end
local function nameOf(player)
	local name=player.DisplayName
	if type(name)~="string" or name=="" then name=player.Name end
	return if type(name)=="string" and name~="" then name else "Opponent"
end
-- A typed code: spaces dropped, case folded, exact length and alphabet.
local function cleanCode(code)
	if type(code)~="string" or #code&gt;16 then return nil end
	code=string.upper((string.gsub(code,"%s","")))
	if #code~=Protocol.CodeLength or string.match(code,"^[A-Z0-9]+$")==nil then return nil end
	return code
end
Online.cleanCode=cleanCode
function Online:newCode()
	local alphabet=Protocol.CodeAlphabet
	for _=1,32 do
		local chars={}
		for i=1,Protocol.CodeLength do
			local k=self.rng:NextInteger(1,#alphabet)
			chars[i]=string.sub(alphabet,k,k)
		end
		local code=table.concat(chars)
		if not self.codes[code] then return code end
	end
	return nil
end
-- Online duels draw lanes from the local sessions' counter (never the same
-- stage position) and hand them back when they are disposed.
function Online:claimLane()
	local lane=table.remove(self.freeLanes)
	if lane then return lane end
	self.matches.nextLane+=1
	return self.matches.nextLane
end
function Online:notice(player,s,message)
	self.matches:send(player,{phase="Selection",epoch=s.epoch,notice=message})
end
function Online:waiting(s)
	local o=s.online
	return {phase="Queue",epoch=s.epoch,online={mode=if o.kind=="host" then "private" else "casual",code=o.entry.code}}
end
-- From the roster: join the casual queue, host a private code or join one.
function Online:enter(player,s,action,payload)
	local id=fighter(payload.player)
	if not id then return self:notice(player,s,"CHOOSE A FIGHTER FIRST") end
	local entry={player=player,session=s,fighter=id}
	if action=="Join" then
		local code=cleanCode(payload.code)
		local host=code and self.codes[code]
		if not host or host.player==player then return self:notice(player,s,"NO PRIVATE DUEL WITH THIS CODE") end
		self.codes[code]=nil;host.session.online=nil
		self:pair(host,entry,"private",code)
		return
	end
	if action=="Host" then
		entry.code=self:newCode()
		if not entry.code then return self:notice(player,s,"NO FREE CODE — TRY AGAIN") end
		self.codes[entry.code]=entry
		s.online={kind="host",entry=entry}
	else
		table.insert(self.queue,entry)
		s.online={kind="queue",entry=entry}
	end
	s.phase="Queue";s.epoch+=1
	self.matches:send(player,self:waiting(s))
	-- Casual queue: first come, first paired.
	while #self.queue&gt;=2 do
		local first=table.remove(self.queue,1);local second=table.remove(self.queue,1)
		first.session.online=nil;second.session.online=nil
		self:pair(first,second,"casual")
	end
end
-- Two players are paired: the duel exists from here, starting with the pick.
-- Its epoch starts above both players' own, so no client drops its packets.
function Online:pair(first,second,mode,code)
	local d={online=true,mode=mode,code=code,phase="Pick",epoch=0,seats={},lane=self:claimLane(),
		pickUntil=workspace:GetServerTimeNow()+Protocol.PickTime}
	d.origin=self.matches.laneOrigin(d.lane)
	for index,entry in {first,second} do
		local seat={index=index,player=entry.player,session=entry.session,fighter=entry.fighter,name=nameOf(entry.player),
			present=true,ready=false,rematch=false}
		d.seats[index]=seat
		entry.session.online={kind="duel",duel=d,seat=seat}
		d.epoch=math.max(d.epoch,entry.session.epoch)
	end
	d.epoch+=1
	self.duels[d]=true
	self:broadcast(d)
	return d
end
-- Every present player gets the duel from their own side; their session
-- follows the duel's phase and epoch, which their requests must carry back.
function Online:broadcast(d)
	for _,seat in d.seats do
		if seat.present then
			seat.session.phase=d.phase;seat.session.epoch=d.epoch
			self.matches:send(seat.player,self:packet(d,seat))
		end
	end
end
function Online:packet(d,seat)
	local other=d.seats[3-seat.index]
	local info={mode=d.mode,code=d.code,opponent=other.name,opponentLeft=not other.present,forfeit=d.forfeit==true,
		me=seat.fighter,them=other.fighter,ready=seat.ready,theirReady=other.ready,rematch=seat.rematch,theirRematch=other.rematch}
	if d.phase=="Pick" then
		info.remaining=math.max(0,d.pickUntil-workspace:GetServerTimeNow())
		return {phase="Pick",epoch=d.epoch,online=info}
	end
	local view=self.matches:view(d,seat,seat.actor,other.actor)
	view.online=info
	return view
end
function Online:refresh(player,s)
	local o=s.online
	if o.kind=="duel" then self.matches:send(player,self:packet(o.duel,o.seat))
	else self.matches:send(player,self:waiting(s)) end
end
function Online:pick(d,seat,action,payload)
	if seat.ready then return end
	if action=="Pick" then
		local id=fighter(payload.player)
		if id and id~=seat.fighter then seat.fighter=id;self:broadcast(d) end
	elseif action=="Confirm" then
		seat.ready=true
		if d.seats[1].ready and d.seats[2].ready then self:fight(d) else self:broadcast(d) end
	end
end
-- The fight: a fresh stage in the duel's lane, one actor per player and the
-- local duel's tournament rounds. A rematch rebuilds it the same way.
function Online:fight(d)
	local m=self.matches
	self:teardown(d)
	d.phase="Duel";d.winner=nil;d.forfeit=nil;d.finishing=false;d.matchPoint=false
	d.folder=Instance.new("Folder");d.folder.Name="Online_"..d.lane;d.folder.Parent=m.folder
	d.effects=Instance.new("Folder");d.effects.Name="Effects";d.effects.Parent=d.folder
	World.arena(d.folder,d.origin)
	local c=Combat.new(d);c.now=workspace:GetServerTimeNow();d.combat=c
	for index,seat in d.seats do
		local side=if index==1 then 1 else -1
		local from=d.origin+Vector3.new(0,3,side*Config.StartDistance)
		local id="Duelist"..index
		local model,hum,root,joints=World.rig(d.folder,Fighters[seat.fighter],CFrame.lookAt(from,d.origin+Vector3.new(0,3,-side*Config.StartDistance)),id)
		seat.actor=c:add(id,model,hum,root,joints,seat.fighter)
		-- Two players: both start locked on, as the local duel's fighters do.
		seat.actor.locked=true
		seat.ready=false;seat.rematch=false;seat.sentImpact=nil;seat.impactEpoch=nil
	end
	local a,b=d.seats[1].actor,d.seats[2].actor
	a.target=b;b.target=a
	for _,seat in d.seats do
		if seat.present then
			seat.player.Character=seat.actor.model
			-- The body stays server-simulated even as the player's character.
			pcall(function() seat.actor.root:SetNetworkOwner(nil) end)
		end
	end
	d.round=1;d.wins={[a.id]=0,[b.id]=0};d.roundsToWin=Config.RoundsToWin
	d.introUntil=c.now+2.6
	d.finish=function(winner)
		m:roundOver(d,winner,function() self:broadcast(d) end,function() m:resetRound(d);self:broadcast(d) end)
	end
	for _,seat in d.seats do
		local actor,other=seat.actor,d.seats[3-seat.index].actor
		actor.hum.Died:Connect(function()
			if d.combat==c and d.phase=="Duel" then actor.health=0;actor.state="Defeated";d.finish(other,actor) end
		end)
	end
	d.epoch+=1
	self:broadcast(d)
end
function Online:rematch(d,seat)
	local other=d.seats[3-seat.index]
	if seat.rematch or not other.present then return end
	seat.rematch=true
	if other.rematch then self:fight(d) else self:broadcast(d) end
end
function Online:teardown(d)
	local c=d.combat
	d.combat=nil
	if c then
		c:clear()
		for _,a in c.actors do AntiCheat.clear(a) end
	end
	for _,seat in d.seats do
		if seat.actor and seat.present and seat.player.Character==seat.actor.model then seat.player.Character=nil end
		seat.actor=nil
	end
	if d.folder then d.folder:Destroy() end
	d.folder=nil;d.effects=nil
end
function Online:dispose(d)
	if not self.duels[d] then return end
	self.duels[d]=nil
	self:teardown(d)
	table.insert(self.freeLanes,d.lane)
end
-- The fight ends early: the player who stays wins, unless the final knockout
-- had already decided the match (its winner stands).
function Online:forfeit(d,stay)
	if not (d.finishing and d.matchPoint) then d.winner=stay.actor.id;d.forfeit=true end
	d.finishing=false;d.matchPoint=true;d.phase="Result"
	local c=d.combat
	c:clear(true)
	for _,a in c.actors do World.pose(a,c.now,.1);a.hum.WalkSpeed=0;a.root.Anchored=true end
end
-- A player leaves the online flow (cancel, back to the roster, disconnect).
-- Waiting entries are withdrawn; a fight in progress is forfeited to the
-- player who stays; the duel and its stage go once nobody is left in it.
function Online:leave(player,s)
	local o=s.online
	if not o then return end
	s.online=nil
	if o.kind=="queue" then
		local index=table.find(self.queue,o.entry)
		if index then table.remove(self.queue,index) end
		return
	elseif o.kind=="host" then
		if self.codes[o.entry.code]==o.entry then self.codes[o.entry.code]=nil end
		return
	end
	local d,seat=o.duel,o.seat
	seat.present=false
	s.epoch=math.max(s.epoch,d.epoch)
	if seat.actor and player.Character==seat.actor.model then player.Character=nil end
	local other=d.seats[3-seat.index]
	if other.present then
		if d.phase=="Pick" then
			-- No fight yet: the pairing is void and the other player is told why.
			other.present=false;other.session.online=nil
			other.session.epoch=math.max(other.session.epoch,d.epoch)
			self.matches:selection(other.player,"OPPONENT LEFT")
		else
			if d.phase=="Duel" then self:forfeit(d,other) end
			self:broadcast(d)
		end
	end
	if not other.present then self:dispose(d) end
end
-- Returns true when the request belongs to the online flow (handled or
-- deliberately ignored); false hands it to the local duel.
function Online:request(player,s,action,payload,clock)
	local o=s.online
	local gap=clock-s.lastLifecycle&gt;=Protocol.LifecycleGap
	if not o then
		if not Protocol.Lifecycle[action] then return false end
		if action~="Cancel" and s.phase=="Selection" and gap then
			s.lastLifecycle=clock
			self:enter(player,s,action,payload)
		end
		return true
	end
	if o.kind~="duel" then
		-- Waiting in the queue or on a private code: only cancelling is possible.
		if action=="Cancel" and gap then s.lastLifecycle=clock;self.matches:selection(player) end
		return true
	end
	local d,seat=o.duel,o.seat
	if d.phase=="Duel" then
		if Protocol.Combat[action] and seat.actor then self.matches:act(d,seat.actor,payload,clock) end
		return true
	end
	if d.phase=="Pick" and (action=="Pick" or action=="Confirm") then
		self:pick(d,seat,action,payload)
	elseif action=="Cancel" or action=="Selection" then
		if gap then s.lastLifecycle=clock;self.matches:selection(player) end
	elseif action=="Rematch" and d.phase=="Result" and gap then
		s.lastLifecycle=clock;self:rematch(d,seat)
	end
	return true
end
function Online:update(dt,now)
	for d in table.clone(self.duels) do
		if not self.duels[d] then continue end
		if d.phase=="Pick" then
			if now&gt;=d.pickUntil then self:fight(d)
			elseif now&gt;=(d.nextPick or 0) then d.nextPick=now+1;self:broadcast(d) end
			continue
		end
		local c=d.combat
		if not c then continue end
		if d.phase=="Duel" then
			-- The local duel's idle rule, for both players.
			for _,seat in d.seats do if os.clock()-seat.actor.lastMove&gt;0.4 then seat.actor.move=Vector3.zero end end
			c:update(math.min(dt,0.1),now)
		end
		-- Regular cadence, plus an immediate packet on a contact, throw or teleport.
		local urgent=c.urgent and now&gt;=(d.lastUrgent or 0)+.03
		if d.combat==c and (now&gt;=(d.nextSnapshot or 0) or urgent) then
			d.nextSnapshot=now+Config.SnapshotInterval;c.urgent=false;d.lastUrgent=now;self:broadcast(d)
		end
	end
end
-- Read-only state for Studio tooling (DevHooks "online").
function Online:summary()
	local duels={}
	for d in self.duels do
		local seats={}
		for _,seat in d.seats do
			local a=seat.actor
			table.insert(seats,{name=seat.name,fighter=seat.fighter,present=seat.present,ready=seat.ready,rematch=seat.rematch,
				health=a and a.health,state=a and a.state,refusedInputs=a and a.refusedInputs or 0,refusedAge=a and a.refusedAge})
		end
		table.insert(duels,{mode=d.mode,phase=d.phase,lane=d.lane,round=d.round,winner=d.winner,forfeit=d.forfeit,seats=seats})
	end
	local codes=0
	for _ in self.codes do codes+=1 end
	return {queued=#self.queue,codes=codes,duels=duels}
end
return Online
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND34">
        <Properties>
          <string name="Name">Place1Movement</string>
          <ProtectedString name="Source">-- Adapted directly from Place1 FirstPersonMovementController (alexkkork, MIT).
-- Per-actor/server execution replaces LocalPlayer, UI, input listeners and FPS camera.
-- Ground sprint/stamina, takeoff momentum, bunny-hop and air steering are donor code.
local Movement={}
function Movement.new(a,c)
 local profile=require(game:GetService("ReplicatedStorage").NinjaDuel.Config).Movement
 local WALK_SPEED=a.def.Speed
 local SPRINT_SPEED=profile.SprintSpeed*(a.def.SprintScale or 1)
 local JUMP_VERTICAL_SPEED=profile.JumpVelocity*(a.def.JumpScale or 1)
 local WALK_BHOP_SPEED=36
 local SPRINT_BHOP_SPEED=62*(a.def.SprintScale or 1)
 local STAMINA_DRAIN_SECONDS=60
 local STAMINA_REGEN_SECONDS=18
 local STAMINA_REGEN_DELAY=.85
 local EXHAUSTED_RECOVERY=.12
 local AIR_CONTROL_ACCELERATION=profile.AirAcceleration*(a.def.AirControlScale or 1)
 local AIR_ACCELERATION_SPEED_CAP=72
 local MOMENTUM_CARRY_CAP=120
 local currentCharacter,currentHumanoid,currentRoot=a.model,a.hum,a.root
 local stamina,regenDelayRemaining,exhausted,sprinting=1,0,false,false
 local lastGroundHorizontalVelocity=Vector3.zero
 local groundLocomotion=Vector3.zero
 -- Movement rhythm state (sprint and standstill bursts).
 local wasSprinting,burstUntil,burstReadyAt=false,0,0
 local lastJumpRequestAt=-math.huge
 local sprintInputs,jumpInputs='Sprint','Jump'
 local function anyHeld(kind) return kind=='Sprint' and a.sprinting end
 local function movementIsBlocked(_character)
  return a.wall~=nil or a.reaction~=nil or a.state~='Neutral'
   or a.model:GetAttribute('MovementTraversalActive')==true
 end
 local function setCharacterAttribute(name,value) a.model:SetAttribute(name,value) end
local function horizontalOf(vector)
	return Vector3.new(vector.X, 0, vector.Z)
end

local function moveVectorToward(current, target, maximumDelta)
	local difference = target - current
	local distance = difference.Magnitude
	if distance == 0 or distance &lt;= maximumDelta then
		return target
	end
	return current + difference / distance * maximumDelta
end

local function preserveTakeoffMomentum()
	local character = currentCharacter
	local root = currentRoot
	if not character or not root or not root.Parent or movementIsBlocked(character) then
		return
	end

	local velocity = root.AssemblyLinearVelocity
	local currentHorizontal = horizontalOf(velocity)
	local carry = lastGroundHorizontalVelocity
	local carrySpeed = carry.Magnitude
	if carrySpeed &lt;= currentHorizontal.Magnitude + 0.1 then
		return
	end

	if carrySpeed &gt; MOMENTUM_CARRY_CAP then
		carry = carry.Unit * MOMENTUM_CARRY_CAP
	end
	root.AssemblyLinearVelocity = Vector3.new(carry.X, velocity.Y, carry.Z)
end

local function applyAirControl(deltaTime, desiredSprint)
	local root = currentRoot
	local humanoid = currentHumanoid
	if not root or not humanoid then
		return
	end

	local moveDirection = horizontalOf(a.move)
	if moveDirection.Magnitude &lt; 0.05 then
		return
	end
	moveDirection = moveDirection.Unit

	local velocity = root.AssemblyLinearVelocity
	local horizontal = horizontalOf(velocity)
	local currentSpeed = horizontal.Magnitude
	local requestedSpeed = desiredSprint and SPRINT_SPEED or WALK_SPEED
	local targetSpeed
	if currentSpeed &gt; AIR_ACCELERATION_SPEED_CAP then
		targetSpeed = currentSpeed
	else
		targetSpeed = math.min(math.max(currentSpeed, requestedSpeed), AIR_ACCELERATION_SPEED_CAP)
	end

	local targetHorizontal = moveDirection * targetSpeed
	local steeredHorizontal = moveVectorToward(
		horizontal,
		targetHorizontal,
		AIR_CONTROL_ACCELERATION * deltaTime
	)
	local allowedSpeed = math.max(currentSpeed, AIR_ACCELERATION_SPEED_CAP)
	if steeredHorizontal.Magnitude &gt; allowedSpeed then
		steeredHorizontal = steeredHorizontal.Unit * allowedSpeed
	end

	if (steeredHorizontal - horizontal).Magnitude &gt; 0.001 then
		root.AssemblyLinearVelocity = Vector3.new(steeredHorizontal.X, velocity.Y, steeredHorizontal.Z)
	end
end

local function requestGroundJump()
	local character = currentCharacter
	local humanoid = currentHumanoid
	local root = currentRoot
	if not character or not humanoid or not root or movementIsBlocked(character)
		or humanoid.Health &lt;= 0 or not a.grounded then
		return
	end
	local now = c.now
	if now - lastJumpRequestAt &lt; 0.12 then
		return
	end
	lastJumpRequestAt = now

	local jumpDirection = horizontalOf(a.move)
	if jumpDirection.Magnitude &gt; 0.05 then
		jumpDirection = jumpDirection.Unit
		local fastHop = sprinting or anyHeld(sprintInputs)
		local targetHopSpeed = fastHop and SPRINT_BHOP_SPEED or WALK_BHOP_SPEED
		local currentVelocity = root.AssemblyLinearVelocity
		local currentHorizontal = horizontalOf(currentVelocity)
		local boostedSpeed = math.max(currentHorizontal.Magnitude, targetHopSpeed)
		local boosted = jumpDirection * math.min(boostedSpeed, MOMENTUM_CARRY_CAP)
		root.AssemblyLinearVelocity = Vector3.new(boosted.X, currentVelocity.Y, boosted.Z)
		lastGroundHorizontalVelocity = boosted
	end
	-- The Humanoid applies its own JumpPower when it enters Jumping; keep it equal
	-- to the authored takeoff speed so the two never disagree.
	humanoid.JumpPower = JUMP_VERTICAL_SPEED
	humanoid.Jump = true
	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	local takeoffVelocity = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(
		takeoffVelocity.X,
		math.max(takeoffVelocity.Y, JUMP_VERTICAL_SPEED),
		takeoffVelocity.Z
	)
	character:SetAttribute("MovementLastJumpAt", c.now)
	character:SetAttribute(
		"MovementLastJumpHorizontalSpeed",
		horizontalOf(root.AssemblyLinearVelocity).Magnitude
	)
	character:SetAttribute("MovementLastJumpVerticalSpeed", root.AssemblyLinearVelocity.Y)
end

local function updateMovement(deltaTime)
	local character = currentCharacter
	local humanoid = currentHumanoid
	local root = currentRoot
	if not character or not humanoid or not root or humanoid.Health &lt;= 0 then
		return
	end

	local blocked = movementIsBlocked(character)
	local grounded = a.grounded
	local horizontalVelocity = horizontalOf(root.AssemblyLinearVelocity)
	local groundSpeed = horizontalVelocity.Magnitude
	local hasMoveInput = a.move.Magnitude &gt; 0.05
	local wantsSprint = anyHeld(sprintInputs) and hasMoveInput

	if exhausted and stamina &gt;= EXHAUSTED_RECOVERY then
		exhausted = false
	end

	sprinting = not blocked and wantsSprint and not exhausted and stamina &gt; 0
	if sprinting then
		stamina = math.max(0, stamina - deltaTime / STAMINA_DRAIN_SECONDS)
		regenDelayRemaining = STAMINA_REGEN_DELAY
		if stamina &lt;= 0 then
			stamina = 0
			exhausted = true
			sprinting = false
		end
	else
		regenDelayRemaining = math.max(0, regenDelayRemaining - deltaTime)
		if regenDelayRemaining == 0 then
			stamina = math.min(1, stamina + deltaTime / STAMINA_REGEN_SECONDS)
		end
	end

	local desiredWalkSpeed = (sprinting and SPRINT_SPEED or WALK_SPEED)*(a.speedScale or 1)
	if grounded then
		local input=horizontalOf(a.move)
		local target=Vector3.zero
		if not blocked and input.Magnitude&gt;.05 then
			-- A backpedal or side step is slower than running where the body faces.
			local face=horizontalOf(root.CFrame.LookVector)
			local along=if face.Magnitude&gt;.01 then face.Unit:Dot(input.Unit) else 1
			local scale=if along&lt;-.3 then .72 elseif along&lt;.5 then .88 else 1
			target=input.Unit*desiredWalkSpeed*scale
		end
		local acceleration=profile.GroundAcceleration*(a.def.AccelerationScale or 1)
		-- Rhythm: ordinary steps carry weight; a sprint that starts, or a move
		-- committed from a near standstill, bursts. Fast moments read as fast
		-- because the rest is not.
		if sprinting and not wasSprinting then burstUntil=c.now+(profile.BurstWindow or .16) end
		if target.Magnitude&gt;.05 and groundLocomotion.Magnitude&lt;desiredWalkSpeed*.35 and c.now&gt;=(burstReadyAt or 0) then
			burstUntil=c.now+(profile.BurstWindow or .16)*.6;burstReadyAt=c.now+.5
		end
		wasSprinting=sprinting
		if target.Magnitude&lt;.05 then acceleration=profile.GroundDeceleration
		elseif c.now&lt;(burstUntil or 0) then acceleration=profile.BurstAcceleration or acceleration
		elseif groundLocomotion.Magnitude&gt;.05 and groundLocomotion.Unit:Dot(target.Unit)&lt;.45 then acceleration=profile.TurnAcceleration end
		groundLocomotion=moveVectorToward(groundLocomotion,target,acceleration*deltaTime)
		if groundLocomotion.Magnitude&lt;.03 then groundLocomotion=Vector3.zero end
		lastGroundHorizontalVelocity=groundLocomotion
		humanoid.WalkSpeed=groundLocomotion.Magnitude
		humanoid:Move(if groundLocomotion.Magnitude&gt;.01 then groundLocomotion.Unit else Vector3.zero,false)
		a.locomotion=groundLocomotion
	else
		-- Preserve the last grounded vector at takeoff, then bend it gradually in air.
		groundLocomotion=horizontalVelocity
		a.locomotion=horizontalVelocity
	end

	if not blocked then

		if anyHeld(jumpInputs) and grounded then
			requestGroundJump()
		end

		if not grounded then
			applyAirControl(deltaTime, sprinting)
			a.locomotion=horizontalOf(root.AssemblyLinearVelocity)
		end
	end

	setCharacterAttribute("MovementSprinting", sprinting)
	setCharacterAttribute("MovementStamina", stamina)
	setCharacterAttribute("MovementGroundSpeed", groundSpeed)
end


 local api={}
 function api.step(dt,grounded)
  a.grounded=grounded
  updateMovement(math.min(dt,.1))
  return sprinting
 end
 function api.jump(grounded)
  a.grounded=grounded
  local previous=lastJumpRequestAt
  requestGroundJump()
  if lastJumpRequestAt~=previous then
   preserveTakeoffMomentum()
   a.airborne=true;a.airDodgeUsed=false;a.takeoffUntil=c.now+.18
   return true
  end
  return false
 end
 return api
end
return Movement
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND35">
        <Properties>
          <string name="Name">Place1Parkour</string>
          <ProtectedString name="Source">-- Adapted directly from Place1 ParkourTraversalController (alexkkork, MIT).
-- Per-actor server authority; semantic Jump API instead of donor UIS listeners.
-- Mantle detection/clearance/Bezier arc and multi-direction wall hops are retained.
local Parkour={}
function Parkour.new(a,c)
local MANTLE_REACH = 3.6
local MIN_LEDGE_HEIGHT = 0.7
local MAX_LEDGE_HEIGHT = 5.7
local MANTLE_CHECK_INTERVAL = 0.055
local MANTLE_COOLDOWN = 0.34
local WALL_HOP_REACH = 3.25
local WALL_HOP_AWAY_SPEED = 58
local WALL_HOP_UP_SPEED = 64
local WALL_HOP_COOLDOWN = 0.15
local MAX_WALL_HOPS = 2

 local character,humanoid,rootPart=a.model,a.hum,a.root
 local rayParams=c:rayParams(true);rayParams.RespectCanCollide=true
 local overlapParams=c:overlapParams();overlapParams.RespectCanCollide=true;overlapParams.MaxParts=32
local traversing = false
local mantleStartCFrame = CFrame.identity
local mantleTargetCFrame = CFrame.identity
local mantleStartedAt = 0
local mantleDuration = 0.42
local mantleHeight = 0
local savedWalkSpeed: number? = nil
local savedAutoRotate: boolean? = nil
local lastMantleAt = -math.huge
local lastMantleCheckAt = -math.huge

local jumpKeyHeld = false
local jumpPulseExpiresAt = 0
local wallHopCount = 0
local lastWallHopAt = -math.huge
local lastGroundedAt = c.now

local function horizontal(vector: Vector3): Vector3
	return Vector3.new(vector.X, 0, vector.Z)
end

local function safeUnit(vector: Vector3, fallback: Vector3): Vector3
	if vector.Magnitude &gt; 1e-4 then
		return vector.Unit
	end
	return fallback
end

local function standingRootOffset(currentHumanoid: Humanoid, currentRoot: BasePart): number
	if currentHumanoid.RigType == Enum.HumanoidRigType.R6 then
		local currentCharacter = character
		local torso = currentCharacter and currentCharacter:FindFirstChild("Torso")
		local leg = currentCharacter and (
			currentCharacter:FindFirstChild("Left Leg")
			or currentCharacter:FindFirstChild("Right Leg")
		)
		if torso and torso:IsA("BasePart") and leg and leg:IsA("BasePart") then
			return torso.Size.Y * 0.5 + leg.Size.Y
		end
		return 3
	end
	return math.max(2.2, currentHumanoid.HipHeight + currentRoot.Size.Y * 0.5)
end

local function setCharacterAttribute(name: string, value: any)
	local currentCharacter = character
	if currentCharacter and currentCharacter.Parent then
		currentCharacter:SetAttribute(name, value)
	end
end

local function hasAnyBooleanAttribute(instance: Instance, names: {string}): boolean
	local cursor: Instance? = instance
	while cursor do
		for _, name in names do
			if cursor:GetAttribute(name) == true then
				return true
			end
		end
		cursor = cursor.Parent
	end
	return false
end

local function mantleBlocked(instance: Instance): boolean
	return hasAnyBooleanAttribute(instance, {"NoParkour", "NoClimb", "NoMantle"})
end

local function wallHopBlocked(instance: Instance): boolean
	return hasAnyBooleanAttribute(instance, {"NoParkour", "NoClimb", "NoWallHop"})
end

local function isJumpHeld(): boolean
	return jumpKeyHeld or c.now &lt; jumpPulseExpiresAt
end

local function canUseMovement(): boolean
	local currentCharacter = character
	local currentHumanoid = humanoid
	local currentRoot = rootPart
	return (a.state=="Neutral" or a.state=="Recovery") and not a.reaction and not a.wall
		and currentCharacter ~= nil
		and currentCharacter.Parent ~= nil
		and currentHumanoid ~= nil
		and currentHumanoid.Parent ~= nil
		and currentHumanoid.Health &gt; 0
		and not currentHumanoid.Sit
		and currentRoot ~= nil
		and currentRoot.Parent ~= nil
end

local function clearanceIsOpen(
	targetPosition: Vector3,
	characterHeight: number,
	wallPart: BasePart,
	topPart: BasePart
): boolean
	local params = overlapParams
	if not params then
		return false
	end

	local clearanceSize = Vector3.new(2.35, characterHeight, 1.85)
	local clearanceCenter = targetPosition + Vector3.new(0, characterHeight * 0.5 + 0.14, 0)
	local parts = workspace:GetPartBoundsInBox(CFrame.new(clearanceCenter), clearanceSize, params)
	for _, part in parts do
		if part.CanCollide and part ~= wallPart and part ~= topPart then
			return false
		end
	end
	return true
end

local function findMantleCandidate(): (CFrame?, number?, BasePart?)
	local currentHumanoid = humanoid
	local currentRoot = rootPart
	local params = rayParams
	if not currentHumanoid or not currentRoot or not params then
		return nil, nil, nil
	end

	local moveDirection = horizontal(a.move)
	if moveDirection.Magnitude &lt; 0.12 then
		return nil, nil, nil
	end
	moveDirection = moveDirection.Unit

	local rootOffset = standingRootOffset(currentHumanoid, currentRoot)
	local feetY = currentRoot.Position.Y - rootOffset
	local groundHit = workspace:Raycast(
		currentRoot.Position + Vector3.new(0, 0.1, 0),
		Vector3.new(0, -(rootOffset + 1.25), 0),
		params
	)
	if groundHit and groundHit.Normal.Y &gt; 0.55 then
		feetY = groundHit.Position.Y
	end
	local wallOrigin = Vector3.new(currentRoot.Position.X, feetY + 0.58, currentRoot.Position.Z)
	local wallHit = workspace:Raycast(wallOrigin, moveDirection * MANTLE_REACH, params)
	if not wallHit or not wallHit.Instance:IsA("BasePart") then
		return nil, nil, nil
	end

	local wallPart = wallHit.Instance
	if not wallPart.Anchored or not wallPart.CanCollide or math.abs(wallHit.Normal.Y) &gt; 0.4 then
		return nil, nil, nil
	end
	if mantleBlocked(wallPart) then
		return nil, nil, nil
	end

	local outwardNormal = safeUnit(horizontal(wallHit.Normal), -moveDirection)
	if moveDirection:Dot(-outwardNormal) &lt; 0.45 then
		return nil, nil, nil
	end

	local insidePoint = wallHit.Position - outwardNormal * 1.2
	local topOrigin = Vector3.new(insidePoint.X, feetY + MAX_LEDGE_HEIGHT + 1.4, insidePoint.Z)
	local topHit = workspace:Raycast(topOrigin, Vector3.new(0, -(MAX_LEDGE_HEIGHT + 2.2), 0), params)
	if not topHit or not topHit.Instance:IsA("BasePart") then
		return nil, nil, nil
	end

	local topPart = topHit.Instance
	if not topPart.Anchored or not topPart.CanCollide or topHit.Normal.Y &lt; 0.72 then
		return nil, nil, nil
	end
	if mantleBlocked(topPart) then
		return nil, nil, nil
	end

	local ledgeHeight = topHit.Position.Y - feetY
	if ledgeHeight &lt; MIN_LEDGE_HEIGHT or ledgeHeight &gt; MAX_LEDGE_HEIGHT then
		return nil, nil, nil
	end

	local characterHeight = math.clamp(rootOffset + 2.3, 4.4, 6.7)
	local landingSurfacePosition = topHit.Position - outwardNormal * 0.32
	if not clearanceIsOpen(landingSurfacePosition, characterHeight, wallPart, topPart) then
		return nil, nil, nil
	end

	local targetRootY = topHit.Position.Y + rootOffset + 0.12
	local targetPosition = Vector3.new(landingSurfacePosition.X, targetRootY, landingSurfacePosition.Z)
	local facing = -outwardNormal
	local targetCFrame = CFrame.lookAt(targetPosition, targetPosition + facing)
	return targetCFrame, ledgeHeight, topPart
end

local function restoreMantleOwnership()
	local currentHumanoid = humanoid
	if currentHumanoid and currentHumanoid.Parent then
		if savedWalkSpeed ~= nil then
			currentHumanoid.WalkSpeed = savedWalkSpeed
		end
		if savedAutoRotate ~= nil then
			currentHumanoid.AutoRotate = savedAutoRotate
		end
	end
	savedWalkSpeed = nil
	savedAutoRotate = nil
end

local function finishMantle(reason: string, cancelled: boolean)
	if not traversing then
		return
	end

	local currentHumanoid = humanoid
	local currentRoot = rootPart
	traversing = false
	lastMantleAt = c.now
	setCharacterAttribute("MovementTraversalActive", false)
	setCharacterAttribute("MovementTraversalType", "")
	setCharacterAttribute("MovementTraversalState", if cancelled then "Cancelled" else "Completed")
	setCharacterAttribute("MovementTraversalEndReason", reason)
	restoreMantleOwnership()
 if cancelled and currentHumanoid and currentRoot and currentHumanoid.Health&gt;0 then
  currentHumanoid:ChangeState(if a.grounded then Enum.HumanoidStateType.Running else Enum.HumanoidStateType.Freefall)
 end

	if not cancelled and currentHumanoid and currentRoot and currentHumanoid.Health &gt; 0 then
		currentRoot.CFrame = mantleTargetCFrame
		currentRoot.AssemblyLinearVelocity = horizontal(mantleTargetCFrame.LookVector) * 8 + Vector3.new(0, -1.5, 0)
		currentHumanoid:ChangeState(Enum.HumanoidStateType.Running)
	end
end

local function startMantle(targetCFrame: CFrame, ledgeHeight: number, topPart: BasePart)
	local currentCharacter = character
	local currentHumanoid = humanoid
	local currentRoot = rootPart
	if traversing or not currentCharacter or not currentHumanoid or not currentRoot then
		return
	end
	if currentCharacter:GetAttribute("MovementSliding") == true then
		return
	end

	traversing = true
	mantleStartCFrame = currentRoot.CFrame
	mantleTargetCFrame = targetCFrame
	mantleStartedAt = c.now
	mantleHeight = ledgeHeight
	mantleDuration = math.clamp(0.22 + ledgeHeight * 0.022, 0.24, 0.36)
	savedWalkSpeed = currentHumanoid.WalkSpeed
	savedAutoRotate = currentHumanoid.AutoRotate
	currentHumanoid.WalkSpeed = 0
	currentHumanoid.AutoRotate = false
	currentHumanoid:ChangeState(Enum.HumanoidStateType.Physics)
	currentRoot.AssemblyLinearVelocity = Vector3.zero

	setCharacterAttribute("MovementTraversalActive", true)
	setCharacterAttribute("MovementTraversalType", "Mantle")
	setCharacterAttribute("MovementTraversalState", "Active")
	setCharacterAttribute("MovementTraversalEndReason", "")
	setCharacterAttribute("MovementMantleHeight", ledgeHeight)
	setCharacterAttribute("MovementMantleDuration", mantleDuration)
	setCharacterAttribute("MovementMantleStartedAt", c.now)
	setCharacterAttribute("MovementMantleSurface", topPart:GetFullName())
end

local function attemptMantle()
	if traversing or not canUseMovement() then
		return
	end
	local currentCharacter = character
	local currentHumanoid = humanoid
	if not currentCharacter or not currentHumanoid then
		return
	end
	if currentCharacter:GetAttribute("MovementSliding") == true
		or currentCharacter:GetAttribute("MovementTraversalActive") == true then
		return
	end
	local slideJumpAt = currentCharacter:GetAttribute("MovementSlideJumpAt")
	if typeof(slideJumpAt) == "number" and c.now - slideJumpAt &lt; 0.32 then
		return
	end
	local state = currentHumanoid:GetState()
	if state == Enum.HumanoidStateType.Seated or state == Enum.HumanoidStateType.Swimming
		or state == Enum.HumanoidStateType.Climbing or state == Enum.HumanoidStateType.Dead then
		return
	end
	if c.now - lastMantleAt &lt; MANTLE_COOLDOWN then
		return
	end

	local targetCFrame, ledgeHeight, topPart = findMantleCandidate()
	if targetCFrame and ledgeHeight and topPart then
		startMantle(targetCFrame, ledgeHeight, topPart)
	end
end

local function updateMantle(now: number)
	if not traversing then
		return
	end
	local currentHumanoid = humanoid
	local currentRoot = rootPart
	if not canUseMovement() or not currentHumanoid or not currentRoot or currentHumanoid.Health &lt;= 0 then
		finishMantle("CharacterUnavailable", true)
		return
	end

	local normalizedTime = math.clamp((now - mantleStartedAt) / mantleDuration, 0, 1)
	local smoothTime = normalizedTime * normalizedTime * (3 - 2 * normalizedTime)
	local startPosition = mantleStartCFrame.Position
	local targetPosition = mantleTargetCFrame.Position
	local controlPosition = startPosition:Lerp(targetPosition, 0.48)
		+ Vector3.new(0, math.max(0.8, mantleHeight * 0.24), 0)
	local inverse = 1 - smoothTime
	local position = startPosition * (inverse * inverse)
		+ controlPosition * (2 * inverse * smoothTime)
		+ targetPosition * (smoothTime * smoothTime)

	local startFacing = safeUnit(horizontal(mantleStartCFrame.LookVector), horizontal(mantleTargetCFrame.LookVector))
	local targetFacing = safeUnit(horizontal(mantleTargetCFrame.LookVector), startFacing)
	local facing = safeUnit(startFacing:Lerp(targetFacing, smoothTime), targetFacing)
	currentHumanoid.WalkSpeed = 0
	currentHumanoid.AutoRotate = false
	currentRoot.AssemblyLinearVelocity = Vector3.zero
	position=c:clamp(position)
	currentRoot.CFrame = CFrame.lookAt(position, position + facing)

	if normalizedTime &gt;= 1 then
		finishMantle("Completed", false)
	end
end

local function appendUniqueDirection(directions: {Vector3}, candidate: Vector3)
	candidate = horizontal(candidate)
	if candidate.Magnitude &lt; 0.1 then
		return
	end
	candidate = candidate.Unit
	for _, direction in directions do
		if direction:Dot(candidate) &gt; 0.96 then
			return
		end
	end
	table.insert(directions, candidate)
end

local function findWallHopSurface(): RaycastResult?
	local currentHumanoid = humanoid
	local currentRoot = rootPart
	local params = rayParams
	if not currentHumanoid or not currentRoot or not params then
		return nil
	end

	local directions: {Vector3} = {}
	local look = horizontal(currentRoot.CFrame.LookVector)
	local right = horizontal(currentRoot.CFrame.RightVector)
	local velocity = horizontal(currentRoot.AssemblyLinearVelocity)
	appendUniqueDirection(directions, currentHumanoid.MoveDirection)
	appendUniqueDirection(directions, velocity)
	appendUniqueDirection(directions, look)
	appendUniqueDirection(directions, -look)
	appendUniqueDirection(directions, right)
	appendUniqueDirection(directions, -right)
	appendUniqueDirection(directions, -velocity)

	local bestHit: RaycastResult? = nil
	local bestDistance = math.huge
	local origin = currentRoot.Position + Vector3.new(0, 0.25, 0)
	for _, direction in directions do
		local hit = workspace:Raycast(origin, direction * WALL_HOP_REACH, params)
		if hit and hit.Instance:IsA("BasePart") then
			local part = hit.Instance
			local distance = (hit.Position - origin).Magnitude
			if part.Anchored and part.CanCollide and math.abs(hit.Normal.Y) &lt; 0.35
				and not wallHopBlocked(part) and distance &lt; bestDistance then
				bestHit = hit
				bestDistance = distance
			end
		end
	end
	return bestHit
end

local function attemptWallHop(forcedNormal: Vector3?)
	if traversing or wallHopCount &gt;= MAX_WALL_HOPS or not canUseMovement() then
		return
	end
	local currentCharacter = character
	local currentHumanoid = humanoid
	local currentRoot = rootPart
	if not currentCharacter or not currentHumanoid or not currentRoot then
		return
	end
	if currentCharacter:GetAttribute("MovementSliding") == true
		or currentCharacter:GetAttribute("MovementTraversalActive") == true then
		return
	end
	local now = c.now
	if (not forcedNormal and (currentHumanoid.FloorMaterial ~= Enum.Material.Air or now - lastGroundedAt &lt; 0.13))
		or now - lastWallHopAt &lt; WALL_HOP_COOLDOWN then
		return
	end

	local hit = findWallHopSurface()
	if not forcedNormal and (not hit or not hit.Instance:IsA("BasePart")) then
		return
	end

	local away = safeUnit(horizontal(forcedNormal or hit.Normal), -horizontal(currentRoot.CFrame.LookVector))
	local currentHorizontal = horizontal(currentRoot.AssemblyLinearVelocity)
	local tangentCarry = currentHorizontal - away * currentHorizontal:Dot(away)
	if tangentCarry.Magnitude &gt; 28 then
		tangentCarry = tangentCarry.Unit * 28
	end

	wallHopCount += 1
	lastWallHopAt = now
	currentHumanoid.JumpPower = WALL_HOP_UP_SPEED
	currentHumanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	currentRoot.AssemblyLinearVelocity = away * WALL_HOP_AWAY_SPEED
		+ tangentCarry * 0.55
		+ Vector3.new(0, WALL_HOP_UP_SPEED, 0)
	setCharacterAttribute("MovementWallHopCount", wallHopCount)
	setCharacterAttribute("MovementLastWallHopAt", c.now)
	setCharacterAttribute("MovementLastWallHopSurface", if hit then hit.Instance:GetFullName() else "NinjaWall")
	a.airborne=true;a.airDodgeUsed=false;a.takeoffUntil=c.now+.18
	return true
end


 local api={}
 function api.jump()
  jumpPulseExpiresAt=c.now+.34
  attemptMantle()
  if traversing then return true end
  return attemptWallHop()==true
 end
 function api.rebound(normal) return attemptWallHop(normal)==true end
 function api.wallSurface() return findWallHopSurface() end
 function api.step()
  if a.grounded then lastGroundedAt=c.now;wallHopCount=0 end
  updateMantle(c.now)
  if not traversing and isJumpHeld() and c.now-lastMantleCheckAt&gt;=MANTLE_CHECK_INTERVAL then
   lastMantleCheckAt=c.now;attemptMantle()
  end
  if traversing then a.airborne=true;a.hum:Move(Vector3.zero);a.locomotion=Vector3.zero end
  return traversing
 end
 function api.reset() finishMantle('SessionReset',true);wallHopCount=0;jumpPulseExpiresAt=0 end
 return api
end
return Parkour
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND36">
        <Properties>
          <string name="Name">ProfileRepository</string>
          <ProtectedString name="Source">-- Progression profile persistence (PROG-001). One key per profile; an
-- exclusive leased writer (session lock) with fenced revisions; every write is
-- a fixed snapshot with an idempotency token, so an ambiguous UpdateAsync is
-- retried without applying twice; a failed or corrupt read never becomes a
-- writable default. Lease/fence/retry logic from Codex's foundation (29a9ec1),
-- rebased on the skill profile (ProfileSchema), without economy.
--
-- Store adapter contract: update(key, transform) (UpdateAsync semantics: the
-- transform may run more than once and returns nil to abort) and read(key).
-- Repo.memoryStore() is the deterministic test double; Repo.dataStore() is the
-- real Roblox adapter, never created implicitly. No game script loads profiles
-- yet (player lifecycle, BindToClose and budgets are the next step).
local S=require(script.Parent.ProfileSchema)
local Repo={};Repo.__index=Repo
Repo.Config={LeaseSeconds=120,SaveInterval=30,MaxRetries=3,
	StoreName="NinjaDuel_Progression",DevStoreName="NinjaDuel_Progression_DEV",Scope="skills_v1"}
function Repo.new(store,options)
	options=options or {}
	assert(store and type(store.update)=="function" and type(store.read)=="function","Store adapter required")
	local owner=options.owner or game:GetService("HttpService"):GenerateGUID(false)
	assert(S.id(owner),"Owner token required")
	return setmetatable({store=store,config=options.config or Repo.Config,owner=owner,clock=options.clock or os.time,
		sleep=options.sleep or task.wait,handles={},loading={}},Repo)
end
local function keyOf(id) return "p_"..id end
function Repo:_update(key,transform)
	local reason
	for attempt=1,self.config.MaxRetries do
		local ok,result=pcall(function() return self.store:update(key,transform) end)
		if ok then return true,result end
		reason=tostring(result)
		if attempt&lt;self.config.MaxRetries then self.sleep(math.min(2,.2*2^(attempt-1))) end
	end
	return false,reason
end
-- A stored record: {envelopeVersion, revision, lease={owner,expires}, profile, lastWrite}.
local function envelope(raw)
	if raw==nil then return nil end
	assert(S.serializable(raw) and type(raw)=="table" and raw.envelopeVersion==1 and S.integer(raw.revision),"Corrupt/future envelope")
	if raw.lease then
		assert(type(raw.lease)=="table" and S.id(raw.lease.owner) and type(raw.lease.expires)=="number" and raw.lease.expires==raw.lease.expires and math.abs(raw.lease.expires)&lt;1e12,"Invalid lease")
	end
	local p,reason=S.migrate(raw.profile)
	assert(p,reason)
	local result=S.copy(raw)
	result.profile=p
	return result
end
-- Acquire the lease and the profile (a missing profile starts fresh; a corrupt,
-- foreign or locked one is refused and left untouched).
function Repo:load(id)
	if not S.profileId(id) then return nil,"Profile id required" end
	if self.loading[id] then return nil,"Load busy" end
	if self.handles[id] then return nil,"Already loaded" end
	self.loading[id]=true
	local reason
	local ok,value=self:_update(keyOf(id),function(raw)
		local okRead,current=pcall(envelope,raw)
		if not okRead then reason=tostring(current);return nil end
		local now=self.clock()
		if current and current.profile.id~=id then reason="Identity mismatch";return nil end
		if current and current.lease and current.lease.owner~=self.owner and current.lease.expires&gt;now then reason="Session locked";return nil end
		current=current or {envelopeVersion=1,revision=0,profile=S.new(id)}
		current.revision+=1
		current.lease={owner=self.owner,expires=now+self.config.LeaseSeconds}
		return current
	end)
	self.loading[id]=nil
	if not ok or not value then return nil,reason or value or "Load failed" end
	local h={id=id,data=S.copy(value.profile),revision=value.revision,leaseUntil=value.lease.expires,state="Ready",busy=false,writeNumber=0,lastSave=self.clock()}
	self.handles[id]=h
	return h
end
function Repo:ready(h)
	if self.handles[h.id]~=h or h.state~="Ready" or h.busy then return false,"Profile not ready / busy" end
	if self.clock()&gt;=h.leaseUntil then h.state="Lost";return false,"Lease expired" end
	return true
end
function Repo:view(h) return S.copy(h.data),h.state end
-- Run a ProfileSchema command on the loaded profile (in memory until saved).
function Repo:apply(h,sequence,kind,args)
	local ready,reason=self:ready(h)
	if not ready then return false,reason end
	local ok,data,result,replayed=pcall(S.apply,h.data,sequence,kind,args)
	if not ok then return false,tostring(data) end
	h.data=data
	return true,S.copy(result),replayed
end
function Repo:save(h,release)
	if self.handles[h.id]~=h or h.busy or h.state=="Closed" or h.state=="Lost" then return false,"Profile unavailable / busy" end
	if self.clock()&gt;=h.leaseUntil then h.state="Lost";return false,"Lease expired" end
	h.busy=true
	if not h.pending then
		local valid,reason=S.validate(h.data)
		if not valid then h.busy=false;return false,reason end
		h.writeNumber+=1
		h.pending={token=self.owner..":"..h.writeNumber,revision=h.revision,data=S.copy(h.data),release=release==true}
	end
	local packet=h.pending
	local reason
	local ok,value=self:_update(keyOf(h.id),function(raw)
		local okRead,current=pcall(envelope,raw)
		if not okRead then reason=tostring(current);return nil end
		local now=self.clock()
		-- An ambiguous write that did commit is recognised by its token.
		if current and current.lastWrite==packet.token and current.revision==packet.revision+1 then return current end
		if not current or current.profile.id~=h.id or current.revision~=packet.revision or not current.lease
			or current.lease.owner~=self.owner or current.lease.expires&lt;=now then reason="Writer fence / lease lost";return nil end
		current.profile=S.copy(packet.data);current.revision+=1;current.lastWrite=packet.token
		current.lease=if packet.release then nil else {owner=self.owner,expires=now+self.config.LeaseSeconds}
		return current
	end)
	h.busy=false
	if not ok then h.state="SaveUncertain";return false,value end
	if not value then h.state="Lost";return false,reason or "Save rejected" end
	h.pending=nil;h.revision=value.revision;h.lastSave=self.clock()
	if packet.release then h.state="Closed";self.handles[h.id]=nil
	else
		if not value.lease or value.lease.owner~=self.owner or value.lease.expires&lt;=self.clock() then h.state="Lost";return false,"Lease lost after commit" end
		h.leaseUntil=value.lease.expires;h.state="Ready"
	end
	if release and not packet.release then return self:save(h,true) end
	return true
end
-- Read-only check of a stored profile; never creates one.
function Repo:verify(id)
	if not S.profileId(id) then return nil,"Profile id required" end
	local ok,value=pcall(function() return self.store:read(keyOf(id)) end)
	if not ok then return nil,tostring(value) end
	if value==nil then return nil,"Missing saved profile" end
	local valid,record=pcall(envelope,value)
	if not valid then return nil,tostring(record) end
	if record.profile.id~=id then return nil,"Identity mismatch" end
	return record
end
-- Explicit host scheduling (periodic save + lease renewal); never installed by itself.
function Repo:pulse()
	local failures={}
	for id,h in self.handles do
		if not h.busy and (h.state=="SaveUncertain" or self.clock()-h.lastSave&gt;=self.config.SaveInterval) then
			local ok,reason=self:save(h)
			if not ok then failures[id]=reason end
		end
	end
	return failures
end
function Repo:closeAll()
	local failures={}
	for id,h in self.handles do
		local ok,reason=self:save(h,true)
		if not ok then failures[id]=reason end
	end
	return failures
end

-- In-memory store: deterministic UpdateAsync stand-in with fault injection
-- (failBefore: unavailable; failAfter: commits then errors; repeatTransform:
-- runs the transform twice). Copies emulate the serialization boundary.
local Memory={};Memory.__index=Memory
function Repo.memoryStore(data)
	return setmetatable({data=S.copy(data or {}),failBefore=0,failAfter=0,repeatTransform=false,calls=0},Memory)
end
function Memory:update(key,transform)
	self.calls+=1
	if self.failBefore&gt;0 then self.failBefore-=1;error("Simulated store unavailable") end
	local value=transform(S.copy(self.data[key]))
	if self.repeatTransform then value=transform(S.copy(self.data[key])) end
	if value==nil then return nil end
	assert(S.serializable(value),"Invalid serialized record")
	self.data[key]=S.copy(value)
	if self.failAfter&gt;0 then self.failAfter-=1;error("Simulated ambiguous commit") end
	return S.copy(value)
end
function Memory:read(key)
	if self.failBefore&gt;0 then self.failBefore-=1;error("Simulated read unavailable") end
	return S.copy(self.data[key])
end

-- Real Roblox DataStore adapter, guarded: never created unless enabled=true.
-- In Studio it only opens the DEV store (Studio sessions can never touch live
-- data); on a live server it also requires live=true. Keys are validated.
local DataStore={};DataStore.__index=DataStore
function Repo.validKey(key)
	return type(key)=="string" and #key&lt;=50 and (string.match(key,"^p_u_%d+$")~=nil or string.match(key,"^p_dev_[%w_%-]+$")~=nil)
end
function Repo.dataStore(options)
	options=options or {}
	if options.enabled~=true then return nil,"Persistence disabled" end
	local name
	if game:GetService("RunService"):IsStudio() then name=Repo.Config.DevStoreName
	elseif options.live==true then name=Repo.Config.StoreName
	else return nil,"Live persistence requires live=true" end
	local store=game:GetService("DataStoreService"):GetDataStore(name,Repo.Config.Scope)
	return setmetatable({store=store,name=name},DataStore)
end
function DataStore:update(key,transform)
	assert(Repo.validKey(key),"Invalid profile key")
	return self.store:UpdateAsync(key,transform)
end
function DataStore:read(key)
	assert(Repo.validKey(key),"Invalid profile key")
	local options=Instance.new("DataStoreGetOptions");options.UseCache=false
	return self.store:GetAsync(key,options)
end
return Repo
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND37">
        <Properties>
          <string name="Name">ProfileSchema</string>
          <ProtectedString name="Source">-- Fighter progression profile (PROG-001). Per fighter: the skill points earned,
-- the nodes unlocked with them and the saved builds (one may be selected).
-- Versioned and JSON-safe, validated on every load and every commit, never
-- repaired silently. Points are granted by the server only: no currency, no
-- purchase. Serialization limits, the command ledger and the refusal to repair
-- come from Codex's foundation (29a9ec1), without its pack/collection economy.
local SkillBuilds=require(script.Parent.SkillBuilds)
local S={Version=1,MaxPoints=999,MaxBuilds=8,MaxSequence=1000000000}
S.copy=SkillBuilds.copy
function S.integer(n,max)
	return type(n)=="number" and n==n and n&gt;=0 and n%1==0 and n&lt;=(max or S.MaxSequence)
end
function S.id(v)
	return type(v)=="string" and #v&gt;0 and #v&lt;=64 and string.match(v,"^[%w_.:%-]+$")~=nil
end
-- Live players are u_&lt;UserId&gt;; tooling and tests use dev_&lt;name&gt;.
function S.profileId(v)
	return type(v)=="string" and #v&lt;=40 and (string.match(v,"^u_%d+$")~=nil or string.match(v,"^dev_[%w_%-]+$")~=nil)
end
function S.buildName(v)
	return type(v)=="string" and #v&gt;=1 and #v&lt;=24 and string.match(v,"^[%w _%-]+$")~=nil
end
-- Bounded JSON-safe data: finite numbers, short strings, no cycles, arrays
-- without holes, string or array keys only.
function S.serializable(value)
	local seen,nodes,bytes={},0,0
	local function walk(v,depth)
		nodes+=1
		if nodes&gt;20000 or depth&gt;16 then return false end
		if type(v)=="number" then return v==v and math.abs(v)&lt;math.huge end
		if type(v)=="boolean" or v==nil then return true end
		if type(v)=="string" then bytes+=#v;return #v&lt;=2048 and bytes&lt;1000000 end
		if type(v)~="table" or seen[v] then return false end
		seen[v]=true
		local numeric,text,count=false,false,0
		for k,item in v do
			count+=1
			if type(k)=="number" then numeric=true;if not S.integer(k,20000) or k&lt;1 then return false end
			elseif type(k)=="string" then text=true else return false end
			if not walk(k,depth+1) or not walk(item,depth+1) then return false end
		end
		if numeric and (text or count~=#v) then return false end
		seen[v]=nil
		return true
	end
	return walk(value,0)
end
function S.new(id)
	assert(S.profileId(id),"Profile id must be u_&lt;UserId&gt; or dev_&lt;name&gt;")
	return {schemaVersion=S.Version,id=id,fighters={},sequence=0}
end
function S.fighter() return {earned=0,unlocked={},builds={}} end
-- Skill points spent on unlocks (derived, never stored).
function S.spent(fighterId,record)
	local total=0
	for id in record.unlocked do
		local node=SkillBuilds.node(fighterId,id)
		total+=if node then node.Cost else 0
	end
	return total
end
local function unlockReady(fighterId,node,unlocked)
	for _,need in node.Requires or {} do if not unlocked[need] then return false,node.Id.." requires "..need end end
	if node.RequiresAny then
		for _,need in node.RequiresAny do if unlocked[need] then return true end end
		return false,node.Id.." requires one of "..table.concat(node.RequiresAny,", ")
	end
	return true
end
local function fighterValid(fighterId,record)
	if type(record)~="table" or not S.integer(record.earned,S.MaxPoints) then return false,"points" end
	if type(record.unlocked)~="table" or type(record.builds)~="table" then return false,"record" end
	for id,flag in record.unlocked do
		local node=SkillBuilds.node(fighterId,id)
		if flag~=true or not node then return false,"unknown unlocked node "..tostring(id) end
		local ok,reason=unlockReady(fighterId,node,record.unlocked)
		if not ok then return false,reason end
	end
	if S.spent(fighterId,record)&gt;record.earned then return false,"more points spent than earned" end
	local count=0
	for name,build in record.builds do
		count+=1
		if count&gt;S.MaxBuilds or not S.buildName(name) or type(build)~="table" or type(build.nodes)~="table" then return false,"builds" end
		local ok,reason=SkillBuilds.validate(fighterId,build.nodes,{unlocked=record.unlocked})
		if not ok then return false,"build "..name..": "..reason end
	end
	if record.selected~=nil and record.builds[record.selected]==nil then return false,"selected build missing" end
	return true
end
function S.validate(p)
	if not S.serializable(p) then return false,"Unsafe serialized data" end
	if type(p)~="table" or p.schemaVersion~=S.Version or not S.profileId(p.id) or not S.integer(p.sequence) or type(p.fighters)~="table" then return false,"Profile header/version" end
	for fighterId,record in p.fighters do
		if not SkillBuilds.tree(fighterId) then return false,"No skill tree for "..tostring(fighterId) end
		local ok,reason=fighterValid(fighterId,record)
		if not ok then return false,fighterId..": "..reason end
	end
	local last=p.lastCommand
	if last~=nil and (type(last)~="table" or last.sequence~=p.sequence or not S.id(last.kind)) then return false,"Command ledger" end
	return true
end
-- Only the current version exists; a future or unknown one is refused, never
-- rewritten by an older server.
function S.migrate(raw)
	if not S.serializable(raw) or type(raw)~="table" or raw.schemaVersion~=S.Version then return nil,"Unknown/future schema" end
	local p=S.copy(raw)
	local ok,reason=S.validate(p)
	if not ok then return nil,reason end
	return p
end
-- Commands: server-side mutations, run on a copy by S.apply (an error aborts
-- the whole command). Refusals are errors with a readable reason.
local function record(p,fighterId)
	assert(SkillBuilds.tree(fighterId),"No skill tree for "..tostring(fighterId))
	p.fighters[fighterId]=p.fighters[fighterId] or S.fighter()
	return p.fighters[fighterId]
end
local function buildCount(r)
	local n=0
	for _ in r.builds do n+=1 end
	return n
end
S.Commands={}
-- Points come from the server only (match rewards, tooling): never a purchase.
function S.Commands.grant(p,args)
	assert(S.integer(args.amount,S.MaxPoints) and args.amount&gt;0,"Invalid amount")
	local r=record(p,args.fighter)
	assert(r.earned+args.amount&lt;=S.MaxPoints,"Point cap")
	r.earned+=args.amount
	return {fighter=args.fighter,earned=r.earned}
end
-- Unlock with earned points. Both options of an exclusive choice may be
-- unlocked; the build decides which one is active.
function S.Commands.unlock(p,args)
	local r=record(p,args.fighter)
	local node=SkillBuilds.node(args.fighter,args.node)
	assert(node,"Unknown node")
	assert(SkillBuilds.wired(args.fighter,node.Id),"Node not available yet")
	assert(not r.unlocked[node.Id],"Already unlocked")
	local ready,reason=unlockReady(args.fighter,node,r.unlocked)
	assert(ready,reason)
	assert(r.earned-S.spent(args.fighter,r)&gt;=node.Cost,"Not enough skill points")
	r.unlocked[node.Id]=true
	return {fighter=args.fighter,node=node.Id,free=r.earned-S.spent(args.fighter,r)}
end
function S.Commands.saveBuild(p,args)
	local r=record(p,args.fighter)
	assert(S.buildName(args.name),"Invalid build name")
	assert(r.builds[args.name]~=nil or buildCount(r)&lt;S.MaxBuilds,"Too many builds")
	local ok,reason=SkillBuilds.validate(args.fighter,args.nodes,{unlocked=r.unlocked})
	assert(ok,reason)
	local nodes=SkillBuilds.apply(args.fighter,args.nodes).nodes
	r.builds[args.name]={nodes=nodes}
	return {fighter=args.fighter,name=args.name,cost=SkillBuilds.cost(args.fighter,nodes)}
end
function S.Commands.deleteBuild(p,args)
	local r=record(p,args.fighter)
	assert(r.builds[args.name],"Unknown build")
	r.builds[args.name]=nil
	if r.selected==args.name then r.selected=nil end
	return {fighter=args.fighter,deleted=args.name}
end
-- name=nil selects the base fighter (no node active).
function S.Commands.selectBuild(p,args)
	local r=record(p,args.fighter)
	assert(args.name==nil or r.builds[args.name],"Unknown build")
	r.selected=args.name
	return {fighter=args.fighter,selected=args.name}
end
-- Copy/validate/commit. The same sequence and kind replays the stored result
-- (an ambiguous save or a repeated request never applies twice); an older or
-- skipped sequence is refused.
function S.apply(profile,sequence,kind,args)
	assert(S.integer(sequence) and sequence&gt;0,"Invalid command sequence")
	if sequence==profile.sequence and profile.lastCommand and profile.lastCommand.kind==kind then
		return S.copy(profile),S.copy(profile.lastCommand.result),true
	end
	assert(sequence==profile.sequence+1,"Stale or gapped command")
	local command=S.Commands[kind]
	assert(command,"Unknown command")
	assert(type(args)=="table" and S.serializable(args),"Invalid arguments")
	local p=S.copy(profile)
	local result=command(p,args)
	p.sequence=sequence;p.lastCommand={sequence=sequence,kind=kind,result=S.copy(result)}
	local ok,reason=S.validate(p)
	assert(ok,reason)
	return p,result,false
end
-- The nodes of a fighter's selected build (nil = base fighter): what a lobby
-- passes to Matches/SkillBuilds.admit together with the unlocked set.
function S.selection(p,fighterId)
	local r=p.fighters[fighterId]
	if not r then return nil,{} end
	local build=r.selected and r.builds[r.selected]
	return build and S.copy(build.nodes),S.copy(r.unlocked)
end
return S
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND38">
        <Properties>
          <string name="Name">SkillBuilds</string>
          <ProtectedString name="Source">-- Skill builds (PROG-001/002). Pure, server-side: validates a fighter's ACTIVE
-- skill nodes and applies them onto copies of the fighter definition and move
-- graph. The result (a "kit") is what Combat:add gives the actor; without a kit
-- the actor uses Fighters/MoveGraphs directly, so no build means today's fighter.
--
-- Hook contract: a node effect only targets data the runtime reads. Canonical
-- numeric fields need a declared bound (RATIO); fields absent from the base kit
-- must be declared in OPTIONAL with the code that reads them. A node is "wired"
-- when every field it touches has a live reader; unwired nodes stay data-only
-- and cannot be activated (except in design tooling with allowUnwired).
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Fighters=require(Shared.Fighters)
local MoveGraphs=require(Shared.MoveGraphs)
local Attacks=require(Shared.Attacks)
local Trees=require(script.Parent.SkillTrees)
local SkillBuilds={Trees=Trees}

SkillBuilds.KINDS={stat=true,property=true,route=true,airwall=true,counter=true,substitution=true,tool=true,jutsu=true,awakening=true}
SkillBuilds.LORE={CANON_YOUNG=true,PLAUSIBLE_YOUNG=true,GAMEPLAY_LIBERTY=true}
-- Every tree must reach this many skill points at its maximum (design), so a
-- 120+ endgame bracket still leaves choices.
SkillBuilds.DESIGN_MAX={120,150}
SkillBuilds.MAX_NODES=40
-- Route payoff kinds Brawler.routePayoff knows.
local PAYOFFS={bodySeal=true,floorSeal=true,coverBlades=true,shadowLeaf=true,tenketsu=true,echo=true}
-- Mild, bounded changes of canonical numbers: {min, max} ratio to the base value.
local RATIO={
	["def.Health"]={1,1.08},["def.Chakra"]={1,1.12},["def.ChakraRegen"]={1,1.12},
	["def.ToolMastery.Recover"]={.8,1},["def.ToolMastery.AirSpread"]={1,1.7},
	["def.Sharingan.ParryWindow"]={1,1.15},["def.Sharingan.PerfectDodge"]={1,1.15},
	["def.GentleFist.Drain"]={1,1.2},["def.GentleFist.Duration"]={1,1.35},
	["def.Byakugan.BlindSpot"]={1,1.06},["def.Awakening.HealthDrain"]={.65,1},
	["tech.Cost"]={.75,1},["tech.Cooldown"]={.7,1},["tech.Channel"]={.7,1},["tech.Active"]={1,1.4},["tech.Range"]={1,1.3},
}
-- Technique fields the shared pipeline reads for every technique, and the
-- techniques whose own implementation reads spec.Range.
local TECH_FIELDS={Cost=true,Cooldown=true,Channel=true,Active=true,Recovery=true}
local RANGE_READ={MarkedBlade=true,WindCut=true,NeedleFan=true,MirageCast=true,FireBloom=true,PhoenixFlower=true,VacuumPalm=true,SixtyFourPalms=true,WireTrap=true}
-- Fields absent from the base kit, each read by one explicit hook (Hook names
-- the reader). Kind: "attack" | "technique" (map key) | "payoff". Value: the
-- only accepted value; Values: accepted strings; Max/Min: absolute numeric
-- bounds; Default+Ratio: bounds relative to the implicit default; Fields: table
-- schema. Wired=false marks a declared hook that is not implemented yet.
SkillBuilds.OPTIONAL={
	["def.LauncherMove"]={Kind="attack",Hook="Brawler.request: heavy after two clean hits"},
	["graph.readCounter"]={Kind="attack",Hook="Brawler.request: strike inside a counter window"},
	["graph.stringCancels.*"]={Key="technique",Value=true,Hook="Combat:request: string cancel"},
	["graph.onRoute.*"]={Key="attack",Kind="payoff",Hook="Brawler.routePayoff"},
	["graph.blockCancels.Tool"]={Value=true,Hook="Combat:request: Tool after a blocked string"},
	["graph.wallBounce.*"]={Key="attack",Value=true,Hook="Brawler.wallFollow"},
	["def.Seals.PlantedLife"]={Default=12,Ratio={1,1.3},Hook="Techniques.plant"},
	["def.SealRecall"]={Fields={Radius={Max=5},Refund={Max=8}},Hook="Techniques.expireSeals"},
	["def.ArrivalThrow"]={Fields={Damage={Max=3}},Hook="Combat:arrivalThrow"},
	["def.Substitution"]={Fields={Mode={Values={flank=true}},Counter={Max=.8},PlantDeparture="boolean",FreeRush={Max=1}},Hook="Combat:substitute / Combat:rush"},
	["def.ParrySeal"]={Max=2.5,Hook="Combat:parryRider"},
	["def.ParryRedirect"]={Fields={Points={Max=2},Counter={Max=.8}},Hook="Combat:parryRider"},
	["def.WallSteer"]={Fields={Moves="table",Range={Max=16},Cone={Max=.8}},Hook="Brawler.hit (knockback aim)"},
	["def.ToolMastery.AirSpread"]={Min=2,Max=5,Hook="Combat:request: Tool in the air"},
	["def.ToolMastery.Chase"]={Max=.8,Hook="Combat:projectileHit (bounced blade)"},
	["def.ToolMastery.FireBlades"]={Fields={Damage={Max=2},Patch={Max=2}},Hook="Combat:igniteBlade / Combat:projectileHit"},
	["def.Awakening.FlashChain"]={Max=2.5,Hook="Brawler.hit"},
	["def.Awakening.Reflex"]={Max=2,Hook="Combat:reflexEcho"},
	["def.Awakening.GuardPoints"]={Value=true,Hook="Brawler.gentleFist"},
	["def.Awakening.BloodChakra"]={Value=true,Hook="Combat:curseBlood"},
	["tech.Quickstep.Arrival"]={Max=.45,Hook="Techniques.Quickstep"},
	["tech.WindCut.Chase"]={Max=1,Hook="Elements.wind / Combat:projectileHit"},
	["tech.BurstStrike.DropReaction"]={Values={Spiked=true},Hook="Techniques.BurstStrike"},
	["tech.NeedleFan.FlankBlades"]={Value=true,Hook="Techniques.NeedleFan"},
	["tech.VacuumPalm.Tenketsu"]={Value=true,Hook="Techniques.VacuumPalm / Combat:projectileHit"},
	["tech.Rotation.Reach"]={Default=7,Ratio={1,1.2},Hook="Techniques.Rotation / Combat:stepRotation"},
	["tech.Rotation.Reflect"]={Value=true,Hook="Combat:stepRotation"},
	["tech.SixtyFourPalms.Seal"]={Default=3.5,Ratio={1,1.3},Hook="Techniques.SixtyFourPalms"},
	["tech.WireTrap.WallPin"]={Fields={Range={Max=12},Bind={Max=1.5}},Hook="Techniques.wireBind"},
	["tech.PhoenixFlower.WiredBlades"]={Max=1,Hook="Elements.phoenix"},
	["tech.Chidori.WallCharge"]={Min=.25,Max=.62,Hook="Combat:request (Chidori from a wall run)"},
}
-- Ranked brackets (PROG-002): inside a bracket every fighter may ACTIVATE at
-- most Budget skill points, whatever he has unlocked. Progression gives more
-- build choices, not more power inside the same bracket.
SkillBuilds.Brackets={
	{Id="Fundamentals",Budget=50,Enabled=true,Label="50 SP - fundamentals"},
	{Id="Identity",Budget=80,Enabled=true,Label="80 SP - stronger fighter identity"},
	{Id="Advanced",Budget=100,Enabled=true,Label="100 SP - advanced builds"},
	{Id="Endgame",Budget=150,Enabled=false,Label="120+ SP - endgame / special (later)"},
}

local function copy(value)
	if type(value)~="table" then return value end
	local out={}
	for k,v in value do out[k]=copy(v) end
	return out
end
SkillBuilds.copy=copy
local function split(path)
	local parts={}
	for part in string.gmatch(path,"[^%.]+") do table.insert(parts,part) end
	return parts
end
local function techniqueOf(def,id)
	for _,spec in def.Techniques or {} do if spec.Id==id then return spec end end
	return nil
end
-- The table holding a path's leaf, and the leaf key. Missing intermediate
-- tables are created only when `create` is set (optional rule tables).
local function locate(kit,path,create)
	local parts=split(path)
	local node,start
	if parts[1]=="def" then node=kit.def;start=2
	elseif parts[1]=="graph" then node=kit.graph;start=2
	elseif parts[1]=="tech" then node=techniqueOf(kit.def,parts[2]);start=3
	else return nil end
	if type(node)~="table" or #parts&lt;start then return nil end
	for k=start,#parts-1 do
		local child=node[parts[k]]
		if child==nil and create then child={};node[parts[k]]=child end
		if type(child)~="table" then return nil end
		node=child
	end
	return node,parts[#parts]
end
local function canonical(fighterId,path)
	local holder,key=locate({def=Fighters[fighterId],graph=MoveGraphs[fighterId] or {}},path,false)
	if holder==nil then return nil end
	return holder[key]
end
local function optionalOf(path)
	local spec=SkillBuilds.OPTIONAL[path]
	if spec then return spec,nil end
	local parent,key=string.match(path,"^(.+)%.([^%.]+)$")
	if parent then
		spec=SkillBuilds.OPTIONAL[parent..".*"]
		if spec then return spec,key end
	end
	return nil,nil
end
SkillBuilds.optionalOf=optionalOf
local function ratioOf(path,spec)
	if RATIO[path] then return RATIO[path] end
	local field=string.match(path,"^tech%.[%w]+%.(%w+)$")
	if field and RATIO["tech."..field] then return RATIO["tech."..field] end
	return spec and spec.Ratio
end

local index={}
local function nodesOf(fighterId)
	local tree=Trees[fighterId]
	if not tree then return nil end
	if not index[fighterId] then
		local map={}
		for order,node in tree.Nodes do map[node.Id]={node=node,order=order} end
		index[fighterId]=map
	end
	return index[fighterId]
end
function SkillBuilds.tree(fighterId) return Trees[fighterId] end
function SkillBuilds.node(fighterId,id)
	local map=nodesOf(fighterId)
	local entry=map and map[id]
	return entry and entry.node
end
-- A node is live when every field it touches has an implemented reader.
function SkillBuilds.wired(fighterId,id)
	local node=SkillBuilds.node(fighterId,id)
	if not node then return false end
	for _,effect in node.Effects do
		local spec=optionalOf(effect[1])
		if spec and spec.Wired==false then return false end
	end
	return true
end
function SkillBuilds.unwired(fighterId)
	local list={}
	for _,node in (Trees[fighterId] or {Nodes={}}).Nodes do
		if not SkillBuilds.wired(fighterId,node.Id) then table.insert(list,node.Id) end
	end
	return list
end
-- Nodes in tree order (the order effects stack in).
local function ordered(fighterId,set)
	local list={}
	for _,node in Trees[fighterId].Nodes do if set[node.Id] then table.insert(list,node.Id) end end
	return list
end
function SkillBuilds.cost(fighterId,nodes)
	local total=0
	for _,id in nodes do
		local node=SkillBuilds.node(fighterId,id)
		if node then total+=node.Cost end
	end
	return total
end
-- Validate an ACTIVE build. opts.budget: maximum skill points (ranked bracket);
-- opts.unlocked: set of unlocked node ids (profile); opts.allowUnwired: design
-- tooling only. Returns true, total cost or false, reason.
function SkillBuilds.validate(fighterId,nodes,opts)
	opts=opts or {}
	local map=nodesOf(fighterId)
	if not map then return false,"No skill tree for "..tostring(fighterId) end
	if type(nodes)~="table" then return false,"Invalid build" end
	local count=0
	for _ in nodes do count+=1 end
	if count~=#nodes or count&gt;SkillBuilds.MAX_NODES then return false,"Invalid build" end
	local active,total={},0
	for _,id in nodes do
		if type(id)~="string" or not map[id] then return false,"Unknown node "..tostring(id) end
		if active[id] then return false,"Duplicate node "..id end
		active[id]=true;total+=map[id].node.Cost
	end
	local groups={}
	for _,id in ordered(fighterId,active) do
		local node=map[id].node
		if not opts.allowUnwired and not SkillBuilds.wired(fighterId,id) then return false,"Node not available yet: "..id end
		if opts.unlocked and opts.unlocked[id]~=true then return false,"Node locked: "..id end
		for _,need in node.Requires or {} do
			if not active[need] then return false,id.." requires "..need end
		end
		if node.RequiresAny then
			local any=false
			for _,need in node.RequiresAny do if active[need] then any=true end end
			if not any then return false,id.." requires one of "..table.concat(node.RequiresAny,", ") end
		end
		if node.Exclusive then
			if groups[node.Exclusive] then return false,"Exclusive choice "..node.Exclusive..": "..groups[node.Exclusive].." or "..id end
			groups[node.Exclusive]=id
		end
	end
	if opts.budget and total&gt;opts.budget then return false,string.format("Build costs %d SP, budget is %d",total,opts.budget) end
	return true,total
end
-- Apply nodes (assumed valid) onto copies of the canonical kit. Effects stack in
-- tree order, so a build gives the same kit whatever order it was listed in.
function SkillBuilds.apply(fighterId,nodes)
	assert(Trees[fighterId] and Fighters[fighterId],"No skill tree for "..tostring(fighterId))
	local kit={fighterId=fighterId,def=copy(Fighters[fighterId]),graph=copy(MoveGraphs[fighterId] or {}),nodes={},spent=0}
	local active={}
	for _,id in nodes or {} do
		assert(SkillBuilds.node(fighterId,id),"Unknown node "..tostring(id))
		active[id]=true
	end
	for _,node in Trees[fighterId].Nodes do
		if active[node.Id] then
			for _,effect in node.Effects do
				local path,op,value=effect[1],effect[2],effect[3]
				local holder,key=locate(kit,path,true)
				assert(holder,"Unresolved effect path "..path)
				if op=="set" then holder[key]=copy(value)
				else
					local spec=optionalOf(path)
					local start=holder[key]
					if start==nil and spec then start=spec.Default end
					assert(type(start)=="number" and type(value)=="number","Numeric effect on a non-number: "..path)
					holder[key]=if op=="add" then start+value else start*value
				end
			end
			table.insert(kit.nodes,node.Id);kit.spent+=node.Cost
		end
	end
	return kit
end
-- Validate then apply: the only way server code should obtain a kit.
function SkillBuilds.build(fighterId,nodes,opts)
	local ok,reason=SkillBuilds.validate(fighterId,nodes,opts)
	if not ok then return nil,reason end
	return SkillBuilds.apply(fighterId,nodes)
end
function SkillBuilds.bracket(id)
	for _,bracket in SkillBuilds.Brackets do if bracket.Id==id then return bracket end end
	return nil
end
-- Ranked admission: what a player may ACTIVATE in a bracket queue. The server
-- calls this with the profile's unlocked set; an over-budget, locked or
-- inconsistent build is refused, never trimmed.
function SkillBuilds.admit(bracketId,fighterId,nodes,unlocked,opts)
	local bracket=SkillBuilds.bracket(bracketId)
	if not bracket then return nil,"Unknown bracket" end
	if not bracket.Enabled and not (opts and opts.allowClosed) then return nil,"Bracket closed" end
	local kit,reason=SkillBuilds.build(fighterId,nodes,{budget=bracket.Budget,unlocked=unlocked})
	if not kit then return nil,reason end
	kit.bracket=bracket.Id;kit.budget=bracket.Budget
	return kit
end
function SkillBuilds.checkBrackets(list)
	local errors,seen,previous={}, {},0
	local enabled=0
	for _,bracket in list or SkillBuilds.Brackets do
		if type(bracket.Id)~="string" or seen[bracket.Id] then table.insert(errors,"bracket id "..tostring(bracket.Id)) end
		seen[bracket.Id or ""]=true
		if type(bracket.Budget)~="number" or bracket.Budget%1~=0 or bracket.Budget&lt;=previous then table.insert(errors,"bracket budgets must be increasing integers ("..tostring(bracket.Id)..")") end
		previous=if type(bracket.Budget)=="number" then bracket.Budget else previous
		if bracket.Enabled then enabled+=1 end
	end
	if enabled==0 then table.insert(errors,"no open bracket") end
	return errors
end
-- Drop nodes whose requirements are missing (until stable), keep tree order.
local function prune(fighterId,list)
	local set={}
	for _,id in list do set[id]=true end
	local changed=true
	while changed do
		changed=false
		for id in table.clone(set) do
			local node=SkillBuilds.node(fighterId,id)
			local ok=true
			for _,need in node.Requires or {} do if not set[need] then ok=false end end
			if node.RequiresAny then
				local any=false
				for _,need in node.RequiresAny do if set[need] then any=true end end
				ok=ok and any
			end
			if not ok then set[id]=nil;changed=true end
		end
	end
	return ordered(fighterId,set)
end
-- Every largest build: all nodes, one option per exclusive group (each combination).
function SkillBuilds.maximalBuilds(fighterId,wiredOnly)
	local groups,order,fixed={}, {}, {}
	for _,node in Trees[fighterId].Nodes do
		if not wiredOnly or SkillBuilds.wired(fighterId,node.Id) then
			if node.Exclusive then
				if not groups[node.Exclusive] then groups[node.Exclusive]={};table.insert(order,node.Exclusive) end
				table.insert(groups[node.Exclusive],node.Id)
			else table.insert(fixed,node.Id) end
		end
	end
	local builds={fixed}
	for _,name in order do
		local grown={}
		for _,build in builds do
			for _,id in groups[name] do
				local option=table.clone(build);table.insert(option,id);table.insert(grown,option)
			end
		end
		builds=grown
	end
	for i,build in builds do builds[i]=prune(fighterId,build) end
	return builds
end
-- Highest cost of a valid build (wiredOnly: what can actually be activated).
function SkillBuilds.maxCost(fighterId,wiredOnly)
	local best=0
	for _,build in SkillBuilds.maximalBuilds(fighterId,wiredOnly) do best=math.max(best,SkillBuilds.cost(fighterId,build)) end
	return best
end
local function checkValue(fighterId,path,op,value,errors)
	local base=canonical(fighterId,path)
	local spec,key=optionalOf(path)
	local function fail(message) table.insert(errors,path..": "..message) end
	if op~="set" and op~="add" and op~="mul" then return fail("unknown op "..tostring(op)) end
	local root,tech,field=string.match(path,"^(%a+)%.([%w]+)%.?([%w]*)")
	if root=="tech" then
		if not techniqueOf(Fighters[fighterId],tech) then return fail("unknown technique") end
		local leaf=string.match(path,"^tech%.[%w]+%.(%w+)$")
		if not spec and not TECH_FIELDS[leaf or ""] and not (leaf=="Range" and RANGE_READ[tech]) then return fail("technique field not read by the runtime") end
	elseif root~="def" and root~="graph" then return fail("unknown root")
	end
	if field=="" and root=="tech" then return fail("technique field missing") end
	if base==nil and not spec then return fail("no canonical value and no declared hook") end
	if op=="add" or op=="mul" then
		local start=if base~=nil then base else spec and spec.Default
		if type(value)~="number" or type(start)~="number" then return fail("numeric op needs numbers") end
		if not ratioOf(path,spec) and not (spec and (spec.Max or spec.Min)) then return fail("no bound declared") end
		return
	end
	if base~=nil then
		-- A node may scale a base number; it never replaces part of the base kit.
		if type(base)~="number" or type(value)~="number" then return fail("would replace part of the base kit") end
		if not ratioOf(path,spec) then return fail("no bound declared") end
		return
	end
	if spec.Key=="technique" and not techniqueOf(Fighters[fighterId],key) then return fail("unknown technique key") end
	if spec.Key=="attack" and not Attacks[key] then return fail("unknown move key") end
	if spec.Kind=="attack" and not Attacks[value] then return fail("unknown move") end
	if spec.Kind=="payoff" and not PAYOFFS[value] then return fail("unknown route payoff") end
	if spec.Value~=nil and value~=spec.Value then return fail("value must be "..tostring(spec.Value)) end
	if spec.Values and not spec.Values[value] then return fail("value not allowed") end
	if spec.Max or spec.Min or spec.Default then
		if type(value)~="number" then return fail("number expected") end
	end
	if spec.Fields then
		if type(value)~="table" then return fail("table expected") end
		for name,item in value do
			local rule=spec.Fields[name]
			if rule==nil then fail("unexpected field "..tostring(name))
			elseif type(rule)=="string" then if type(item)~=rule then fail(name.." must be a "..rule) end
			else
				if rule.Values then if not rule.Values[item] then fail(name.." not allowed") end
				elseif type(item)~="number" or item&lt;=0 or (rule.Max and item&gt;rule.Max) then fail(name.." out of bounds") end
			end
		end
	end
end
-- Tree integrity (PROG-001 contract). Returns a list of errors (empty = valid).
function SkillBuilds.checkTree(fighterId)
	local errors={}
	local function fail(message) table.insert(errors,fighterId..": "..message) end
	local tree=Trees[fighterId]
	if not tree or tree.Fighter~=fighterId or not Fighters[fighterId] or not MoveGraphs[fighterId] then fail("tree/fighter/graph mismatch");return errors end
	local ids,kinds,groups={}, {}, {}
	for _,node in tree.Nodes do
		local id=node.Id
		if type(id)~="string" or not string.match(id,"^%a%w*$") or #id&gt;32 or ids[id] then fail("bad or duplicate id "..tostring(id)) end
		ids[id or ""]=node
		if type(node.Name)~="string" or type(node.Branch)~="string" then fail(tostring(id)..": name/branch") end
		if not SkillBuilds.KINDS[node.Kind] then fail(tostring(id)..": kind "..tostring(node.Kind)) end
		kinds[node.Kind or ""]=true
		if type(node.Cost)~="number" or node.Cost%1~=0 or node.Cost&lt;1 or node.Cost&gt;20 then fail(tostring(id)..": cost") end
		if type(node.Shows)~="string" or #node.Shows&lt;20 or type(node.Counter)~="string" or #node.Counter&lt;10 then fail(tostring(id)..": Shows/Counter text") end
		if not SkillBuilds.LORE[node.Lore] then fail(tostring(id)..": lore label") end
		if type(node.Effects)~="table" or #node.Effects==0 then fail(tostring(id)..": no effect") end
		if node.Exclusive then groups[node.Exclusive]=(groups[node.Exclusive] or 0)+1 end
		local addsBehaviour=false
		for _,effect in node.Effects or {} do
			local path,op,value=effect[1],effect[2],effect[3]
			if type(path)~="string" then fail(tostring(id)..": effect path");continue end
			local before=#errors
			checkValue(fighterId,path,op,value,errors)
			for k=before+1,#errors do errors[k]=fighterId.."."..tostring(id)..": "..errors[k] end
			if op=="set" and canonical(fighterId,path)==nil then addsBehaviour=true end
			if node.Kind=="stat" and path~="def.Health" and path~="def.Chakra" and path~="def.ChakraRegen" then fail(tostring(id)..": a stat node only changes health or chakra") end
		end
		if node.Major then
			if node.Kind=="stat" then fail(tostring(id)..": a major node cannot be a stat") end
			-- DO/SEE: a major node adds a rule, route or behaviour the base kit lacks.
			if not addsBehaviour then fail(tostring(id)..": a major node must add behaviour, not only scale a number") end
			if #node.Shows&lt;40 then fail(tostring(id)..": a major node must explain what changes") end
		end
	end
	for name,count in groups do if count&lt;2 then fail("exclusive group "..name.." needs two options") end end
	for kind in SkillBuilds.KINDS do if not kinds[kind] then fail("no "..kind.." node") end end
	-- Requirements exist, cannot sit in the node's own exclusive group, no cycle.
	for _,node in tree.Nodes do
		for _,need in node.Requires or {} do
			local other=ids[need]
			if not other or need==node.Id then fail(tostring(node.Id).." requires unknown "..tostring(need))
			elseif node.Exclusive and other.Exclusive==node.Exclusive then fail(tostring(node.Id).." requires its own exclusive alternative") end
		end
		for _,need in node.RequiresAny or {} do if not ids[need] then fail(tostring(node.Id).." requires unknown "..tostring(need)) end end
	end
	local state={}
	local function visit(id)
		if state[id]=="open" then fail("prerequisite cycle at "..id);return end
		if state[id] then return end
		state[id]="open"
		local node=ids[id]
		for _,need in node and node.Requires or {} do if ids[need] then visit(need) end end
		for _,need in node and node.RequiresAny or {} do if ids[need] then visit(need) end end
		state[id]="done"
	end
	for _,node in tree.Nodes do if type(node.Id)=="string" then visit(node.Id) end end
	if #errors&gt;0 then return errors end
	-- Design maximum and bounds on every largest build.
	local design=SkillBuilds.maxCost(fighterId,false)
	if design&lt;SkillBuilds.DESIGN_MAX[1] or design&gt;SkillBuilds.DESIGN_MAX[2] then fail("design maximum "..design.." SP outside "..SkillBuilds.DESIGN_MAX[1].."-"..SkillBuilds.DESIGN_MAX[2]) end
	for _,build in SkillBuilds.maximalBuilds(fighterId,false) do
		local ok,reason=SkillBuilds.validate(fighterId,build,{allowUnwired=true})
		if not ok then fail("largest build invalid: "..reason) end
		local kit=SkillBuilds.apply(fighterId,build)
		for _,id in build do
			for _,effect in SkillBuilds.node(fighterId,id).Effects do
				local path=effect[1]
				local holder,key=locate(kit,path,false)
				local final=holder and holder[key]
				if type(final)=="number" then
					local spec=optionalOf(path)
					local base=canonical(fighterId,path)
					if base==nil and spec then base=spec.Default end
					local ratio=if base then ratioOf(path,spec) else nil
					if ratio and base and base~=0 then
						local r=final/base
						if r&lt;ratio[1]-1e-9 or r&gt;ratio[2]+1e-9 then fail(path.." ends at "..final.." ("..string.format("%.3f",r).."x base)") end
					end
					if spec and spec.Max and final&gt;spec.Max+1e-9 then fail(path.." above "..spec.Max) end
					if spec and spec.Min and final&lt;spec.Min-1e-9 then fail(path.." below "..spec.Min) end
					if string.match(path,"%.Channel$") and final&lt;.04 then fail(path.." channel below 0.04 s") end
				end
			end
		end
	end
	return errors
end
return SkillBuilds
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND39">
        <Properties>
          <string name="Name">SkillTrees</string>
          <ProtectedString name="Source">-- Fighter skill trees (PROG-001). Server data: what skill points buy for each
-- CORE4 prodigy. The base fighter (no node active) is exactly the kit declared
-- in Fighters/MoveGraphs; a node deepens a mechanic the fighter already has, it
-- never repairs an incomplete kit. SkillBuilds validates and applies them.
--
-- Node fields
--   Id           stable identifier, saved in profiles: never rename or recycle
--   Kind         stat | property | route | airwall | counter | substitution |
--                tool | jutsu | awakening
--   Major        must change what the player can DO or SEE (never a bare number)
--   Cost         skill points to unlock it, and to activate it in a build
--   Branch       presentation group
--   Requires     every listed node first (active in a build, unlocked to unlock)
--   RequiresAny  at least one of the listed nodes first
--   Exclusive    choice group: at most one node of the group in an active build
--   Effects      {path, op, value}. path: "def.&lt;field&gt;", "tech.&lt;TechniqueId&gt;.&lt;field&gt;"
--                or "graph.&lt;field&gt;"; op: set | add | mul. Applied in tree order on
--                copies of Fighters/MoveGraphs (SkillBuilds.apply).
--   Shows        what changes for the player
--   Counter      what the opponent can answer
--   Lore         DEC-005 label (CANON_YOUNG / PLAUSIBLE_YOUNG / GAMEPLAY_LIBERTY)
return {
	-- Minato: a network of prepared destinations, not teleport spam. Seals,
	-- relocation that converts, angles and a Rasengan that finishes.
	Flashstep = { Fighter = "Flashstep", Nodes = {
		{ Id = "SealInk", Name = "Seal Ink", Branch = "Seals", Kind = "property", Cost = 4,
			Effects = { { "def.Seals.PlantedLife", "set", 15 } },
			Shows = "Planted seals hold 15 s instead of 12: a prepared destination outlives one exchange.",
			Counter = "Still two planted seals at most, each one drawn on the floor.", Lore = "GAMEPLAY_LIBERTY" },
		{ Id = "LongSeal", Name = "Long Seal", Branch = "Seals", Kind = "property", Cost = 3,
			Effects = { { "tech.MarkedBlade.Range", "mul", 1.18 } },
			Shows = "Marked Kunai flies 78 studs instead of 66 before it drops and plants.",
			Counter = "A longer throw is a slower anchor; a guard still drops it at the feet.", Lore = "GAMEPLAY_LIBERTY" },
		{ Id = "SealCraft", Name = "Seal Craft", Branch = "Seals", Kind = "property", Cost = 4,
			Effects = { { "tech.MarkedBlade.Cooldown", "mul", 0.82 } },
			Shows = "Marked Kunai is ready again after 1.8 s instead of 2.2 s.",
			Counter = "Same 10 chakra per seal; Rotation and a guard still answer it.", Lore = "GAMEPLAY_LIBERTY" },
		{ Id = "KunaiRecall", Name = "Kunai Recall", Branch = "Seals", Kind = "tool", Major = true, Cost = 10, Requires = { "SealInk" },
			Effects = { { "def.SealRecall", "set", { Radius = 3.5, Refund = 5 } } },
			Shows = "Running over one of his planted kunai picks it up: the seal leaves the floor and 5 chakra comes back. The run draws the geometry.",
			Counter = "The pickup spot is a known destination, and a recovered kunai is one escape seal less.", Lore = "PLAUSIBLE_YOUNG" },
		{ Id = "ReturnSeal", Name = "Return Seal", Branch = "Seals", Kind = "substitution", Major = true, Cost = 10, Requires = { "SealCraft" },
			Effects = { { "def.Substitution", "set", { PlantDeparture = true } } },
			Shows = "Every substitution leaves a seal where Minato stood: Flying Thunder God can bring him straight back into the exchange.",
			Counter = "The seal marks the return point: stand on it, or punish the arrival.", Lore = "GAMEPLAY_LIBERTY" },
		{ Id = "FlashEconomy", Name = "Light Seal", Branch = "Flash", Kind = "property", Cost = 5,
			Effects = { { "tech.Flashstep.Cost", "add", -2 } },
			Shows = "Flying Thunder God costs 14 chakra instead of 16.",
			Counter = "A seal is still required and spent; the Sharingan guard still tracks the arrival.", Lore = "GAMEPLAY_LIBERTY" },
		{ Id = "StringFlash", Name = "Cut and Flash", Branch = "Flash", Kind = "route", Major = true, Cost = 12, Requires = { "FlashEconomy" },
			Effects = { { "graph.stringCancels.Flashstep", "set", true } },
			Shows = "A clean string can cancel into Flying Thunder God: the combo jumps to a seal and resumes from the new angle.",
			Counter = "Costs 16 chakra and a seal; no seal, no cancel; the Sharingan guard follows the arrival.", Lore = "GAMEPLAY_LIBERTY" },
		{ Id = "AirSwitchSeal", Name = "Switch Seal", Branch = "Flash", Kind = "airwall", Major = true, Cost = 9, Requires = { "FlashEconomy" }, Exclusive = "AirSeal",
			Effects = { { "graph.onRoute.AirSwitch", "set", "bodySeal" } },
			Shows = "The air side switch leaves a 1.8 s seal on the body: the teleport follows it up in the air.",
			Counter = "Air dodge or substitution before the seal is used; it expires fast.", Lore = "GAMEPLAY_LIBERTY" },
		{ Id = "SpikeAnchor", Name = "Spike Anchor", Branch = "Flash", Kind = "airwall", Major = true, Cost = 9, Requires = { "FlashEconomy" }, Exclusive = "AirSeal",
			Effects = { { "graph.onRoute.AirSpike", "set", "floorSeal" } },
			Shows = "The air spike plants a marked kunai where the body lands: the knockdown becomes a destination.",
			Counter = "The seal is on the floor in plain sight; the wake-up can move away from it.", Lore = "GAMEPLAY_LIBERTY" },
		{ Id = "AirExit", Name = "Air Exit", Branch = "Flash", Kind = "airwall", Major = true, Cost = 9, RequiresAny = { "AirSwitchSeal", "SpikeAnchor" },
			Effects = { { "def.ArrivalThrow", "set", { Damage = 2 } } },
			Shows = "Tool during an air arrival throws a kunai straight down that plants a seal: a landing or an escape prepared mid-air.",
			Counter = "It spends the arrival strike and 4 chakra; the planted seal is visible.", Lore = "GAMEPLAY_LIBERTY" },
		{ Id = "ParrySeal", Name = "Seal on the Parry", Branch = "Flash", Kind = "counter", Major = true, Cost = 9, Requires = { "FlashEconomy" },
			Effects = { { "def.ParrySeal", "set", 1.8 } },
			Shows = "A parried strike leaves a 1.8 s seal on the attacker: the parry converts into a teleport behind the stunned body.",
			Counter = "Feints and throws bait the parry; the seal is short.", Lore = "GAMEPLAY_LIBERTY" },
		{ Id = "YellowFlow", Name = "Flow", Branch = "Flash", Kind = "awakening", Major = true, Cost = 14, Requires = { "StringFlash" },
			Effects = { { "def.Awakening.FlashChain", "set", 1.8 } },
			Shows = "Awakened, a clean hit within 0.7 s of a teleport arrival seals the body again (1.8 s): the relocation chain lasts as long as he keeps landing.",
			Counter = "Guard or parry breaks the chain; 16 chakra per jump; once per match.", Lore = "GAMEPLAY_LIBERTY" },
		{ Id = "QuickstepCut", Name = "Quickstep Cut", Branch = "Jutsu", Kind = "route", Major = true, Cost = 10,
			Effects = { { "tech.Quickstep.Arrival", "set", 0.35 } },
			Shows = "After Quickstep a strike cancels the recovery like a teleport arrival (light, launcher, or an instant Rasengan): the angle now converts.",
			Counter = "The step is short and readable; a guard facing the new side stops it.", Lore = "PLAUSIBLE_YOUNG" },
		{ Id = "GaleChase", Name = "Gale Chase", Branch = "Jutsu", Kind = "jutsu", Major = true, Cost = 8, Requires = { "QuickstepCut" },
			Effects = { { "tech.WindCut.Chase", "set", 0.8 } },
			Shows = "A Wind Cut that connects opens the chase (E) for 0.8 s: the gust becomes a re-entry.",
			Counter = "Side-step the lane; a guarded gust opens nothing.", Lore = "GAMEPLAY_LIBERTY" },
		{ Id = "RasenganFocus", Name = "Rasengan Focus", Branch = "Jutsu", Kind = "property", Cost = 4,
			Effects = { { "tech.BurstStrike.Cost", "add", -3 } },
			Shows = "Rasengan costs 21 chakra instead of 24.",
			Counter = "Same wind-up and recovery: interrupt or punish it.", Lore = "GAMEPLAY_LIBERTY" },
		{ Id = "RasenganDrive", Name = "Rasengan Drive", Branch = "Jutsu", Kind = "jutsu", Major = true, Cost = 10, Requires = { "RasenganFocus" },
			Effects = { { "tech.BurstStrike.DropReaction", "set", "Spiked" } },
			Shows = "The plunging Rasengan spikes the body into the floor: it bounces once for a pick-up instead of a flat knockdown.",
			Counter = "Air dodge or substitution before the plunge; the bounce happens once per combo.", Lore = "GAMEPLAY_LIBERTY" },
		{ Id = "DeepReserves", Name = "Deep Reserves", Branch = "Body", Kind = "stat", Cost = 4,
			Effects = { { "def.Chakra", "add", 6 } },
			Shows = "Chakra reserve 116 instead of 110.", Counter = "Gentle Fist drains it all the same.", Lore = "PLAUSIBLE_YOUNG" },
		{ Id = "Endurance", Name = "Endurance", Branch = "Body", Kind = "stat", Cost = 4,
			Effects = { { "def.Health", "add", 5 } },
			Shows = "Health 130 instead of 125.", Counter = "Still the second lightest body.", Lore = "PLAUSIBLE_YOUNG" },
		{ Id = "QuickHands", Name = "Quick Hands", Branch = "Body", Kind = "tool", Cost = 3,
			Effects = { { "def.ToolMastery.Recover", "add", -0.07 } },
			Shows = "A neutral kunai throw recovers in 0.48 s instead of 0.55 s.", Counter = "Same single blade and chakra cost.", Lore = "CANON_YOUNG" },
	} },
	-- Itachi: calm control. Reads, deception, shuriken geometry and fire that
	-- turn the opponent's own action into his opening.
	Mirage = { Fighter = "Mirage", Nodes = {
		{ Id = "QuickRead", Name = "Quick Read", Branch = "Sharingan", Kind = "property", Cost = 5,
			Effects = { { "tech.Read.Cooldown", "mul", 0.84 } },
			Shows = "Sharingan Read is ready again after 3 s instead of 3.6 s.",
			Counter = "Projectiles, grabs and flank strikes still ignore the Read.", Lore = "PLAUSIBLE_YOUNG" },
		{ Id = "EconomicRead", Name = "Economic Read", Branch = "Sharingan", Kind = "property", Cost = 4,
			Effects = { { "tech.Read.Cost", "add", -2 } },
			Shows = "Sharingan Read costs 12 chakra instead of 14.",
			Counter = "Waiting it out still works: the stance commits him for 1.2 s.", Lore = "PLAUSIBLE_YOUNG" },
		{ Id = "ReadCancel", Name = "Read Cancel", Branch = "Sharingan", Kind = "route", Major = true, Cost = 10, Requires = { "QuickRead" }, Exclusive = "ReadStyle",
			Effects = { { "graph.stringCancels.Read", "set", true } },
			Shows = "A clean string can end in the Read stance: the opponent's retaliation is read and punished by the counter palm.",
			Counter = "Do not retaliate frontally: wait, throw, or grab the stance.", Lore = "PLAUSIBLE_YOUNG" },
		{ Id = "PatientRead", Name = "Patient Read", Branch = "Sharingan", Kind = "counter", Cost = 6, Requires = { "QuickRead" }, Exclusive = "ReadStyle",
			Effects = { { "tech.Read.Active", "mul", 1.35 } },
			Shows = "The Read window lasts 1.35 s instead of 1 s.",
			Counter = "He stays rooted in the stance longer: throw or reposition.", Lore = "PLAUSIBLE_YOUNG" },
		{ Id = "MirageReflex", Name = "Mirage Reflex", Branch = "Sharingan", Kind = "awakening", Major = true, Cost = 14, RequiresAny = { "ReadCancel", "PatientRead" },
			Effects = { { "def.Awakening.Reflex", "set", 1.5 } },
			Shows = "Under Sharingan Focus, a perfect dodge or a parry leaves a 1.5 s genjutsu decoy on the attacker: the next swing at it is caught.",
			Counter = "Trust the body, not the afterimage; the Byakugan sees through it; once per match.", Lore = "PLAUSIBLE_YOUNG" },
		{ Id = "CrowCounter", Name = "Crow Counter", Branch = "Sharingan", Kind = "substitution", Major = true, Cost = 10, Requires = { "EconomicRead" },
			Effects = { { "def.Substitution", "set", { Counter = 0.6 } } },
			Shows = "After a substitution behind the attacker, his next strike within 0.6 s is the counter palm.",
			Counter = "The attacker's tracking window (E) still reaches the reappearance; a guard facing back stops the palm.", Lore = "GAMEPLAY_LIBERTY" },
		{ Id = "Precision", Name = "Precision", Branch = "Shuriken", Kind = "tool", Cost = 3,
			Effects = { { "def.ToolMastery.Recover", "add", -0.1 } },
			Shows = "A neutral shuriken pair recovers in 0.65 s instead of 0.75 s.", Counter = "Same blades, same chakra cost.", Lore = "CANON_YOUNG" },
		{ Id = "WideFan", Name = "Wide Fan", Branch = "Shuriken", Kind = "tool", Cost = 5,
			Effects = { { "def.ToolMastery.AirSpread", "add", 2 } },
			Shows = "In the air he fans five shuriken down instead of three.", Counter = "A guard still blocks the fan; side-step the spread.", Lore = "CANON_YOUNG" },
		{ Id = "RicochetChase", Name = "Ricochet Chase", Branch = "Shuriken", Kind = "tool", Major = true, Cost = 9, Requires = { "Precision" },
			Effects = { { "def.ToolMastery.Chase", "set", 0.6 } },
			Shows = "A ricochet or Geometry blade that lands opens the chase (E) for 0.6 s: the redirected blade becomes a re-entry.",
			Counter = "Guard the flank; the chase still costs 8 chakra.", Lore = "PLAUSIBLE_YOUNG" },
		{ Id = "FlankBlades", Name = "Flank Blades", Branch = "Shuriken", Kind = "jutsu", Major = true, Cost = 10, Requires = { "Precision" },
			Effects = { { "tech.NeedleFan.FlankBlades", "set", true } },
			Shows = "Shadow Shuriken's two hidden blades are redirected beside the opponent and arrive from both flanks, past a frontal guard.",
			Counter = "Byakugan sight, a late dodge, or hitting Itachi during the channel cancels them.", Lore = "CANON_YOUNG" },
		{ Id = "FeintEcho", Name = "Feint Echo", Branch = "Taijutsu", Kind = "route", Major = true, Cost = 9,
			Effects = { { "graph.onRoute.FeintStep", "set", "echo" } },
			Shows = "A feint step that lands leaves its afterimage as a 1.2 s genjutsu decoy: swinging at it gives the read away.",
			Counter = "Strike the real body, not the afterimage; the Byakugan is immune.", Lore = "PLAUSIBLE_YOUNG" },
		{ Id = "WallPalm", Name = "Wall Palm", Branch = "Taijutsu", Kind = "airwall", Major = true, Cost = 10, Requires = { "FeintEcho" },
			Effects = { { "def.WallSteer", "set", { Moves = { CounterPalm = true }, Range = 14, Cone = 0.7 } } },
			Shows = "The counter palm drives the body toward a wall within 14 studs and 45 degrees: it splats and the wall phase begins.",
