  <Item class="ServerScriptService" referent="ND15">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="ND16">
      <Properties>
        <string name="Name">NinjaDuelServer</string>
      </Properties>
      <Item class="ModuleScript" referent="ND17">
        <Properties>
          <string name="Name">AI</string>
          <ProtectedString name="Source">local Config=require(game:GetService("ReplicatedStorage").NinjaDuel.Config)
local AI={}; AI.__index=AI
function AI.new(combat,actor,seed)
	return setmetatable({combat=combat,actor=actor,nextTick=0,observed=nil,observedAt=0,guardUntil=0,rng=Random.new(seed or 23)},AI)
end
function AI:update(now)
	local c,a=self.combat,self.actor; local target=a.target; local tune=Config.AI
	if c.match.phase~="Duel" or a.health&lt;=0 or target.health&lt;=0 then a.move=Vector3.zero; return end
	if now&lt;self.nextTick then return end
	self.nextTick=now+tune.Tick
	if (a.state=="Stunned" or a.reaction) and a.subCharges&gt;0 and a.chakra&gt;=Config.Substitution.Cost and self.rng:NextNumber()&lt;0.42 then
		c:request(a,"Substitute")
	end
	local position=if a.decoyPosition and a.illusionUntil&gt;now then a.decoyPosition else target.root.Position
	local delta=position-a.root.Position; delta=Vector3.new(delta.X,0,delta.Z)
	local distance=delta.Magnitude; local toward=if distance&gt;0.1 then delta.Unit else Vector3.zAxis
	if a.state~="Dodging" and not a.wall then a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+toward) end
	local tangent=Vector3.new(-toward.Z,0,toward.X)
	local desired=a.def.PreferredRange or 7
	local radial=if distance&gt;desired+2 then 1 elseif distance&lt;desired-2 then -0.6 else 0
	a.move=(toward*radial+tangent*math.sin(now*0.7)*0.7)
	a.sprinting=distance&gt;desired+6
	if a.move.Magnitude&gt;1 then a.move=a.move.Unit end
	if now&gt;=self.guardUntil and a.state=="Guarding" then c:request(a,"GuardOff") end
	if target.state~=self.observed then self.observed=target.state; self.observedAt=now end
	local reacted=now-self.observedAt&gt;=tune.Reaction
	local danger=target.state=="Startup" or target.state=="TechniqueChannel"
	-- A newly observed telegraph may alter movement, but cannot trigger an
	-- instant defensive action or coincidental interrupt before reaction latency.
	if danger and not reacted then return end
	if reacted and danger and distance&lt;9 then
		if target.state=="TechniqueChannel" and distance&lt;=6.8 and self.rng:NextNumber()&lt;tune.Aggression then
			c:request(a,"Attack"); return
		end
		if self.rng:NextNumber()&lt;tune.Defense then
			if self.rng:NextNumber()&lt;0.45 then c:request(a,"Dodge")
			else c:request(a,"Guard"); self.guardUntil=now+0.5 end
			return
		end
	end
	if a.grabVictim then c:request(a,if self.rng:NextNumber()&lt;.4 then "Heavy" else "Attack");return end
	if a.pursuitUntil&gt;now and distance&gt;8 and distance&lt;Config.PursuitRange and self.rng:NextNumber()&lt;0.58 then
		c:request(a,"Pursuit"); return
	end
	if a.state=="Recovery" and a.chainOpen then
		c:request(a,if a.airborne then (if (a.airCombo or 0)&gt;=2 then "Heavy" else "Attack") elseif a.combo&gt;=2 and self.rng:NextNumber()&lt;.55 then "Heavy" else "Attack");return
	end
	if a.state~="Neutral" or a.reaction then return end
	if a.chakra&lt;18 then a.move=-toward+tangent*0.2; return end
	if distance&gt;7 and distance&lt;30 and self.rng:NextNumber()&lt;(if a.def.Name=="Itachi" then 0.24 else 0.18) then
		if c:request(a,"Tool",target.root.Position) then return end
	end
	-- Choose by capabilities/technique identifiers, never by a second bot combat engine.
	if self.rng:NextNumber()&lt;tune.Technique then
		for slot,spec in a.def.Techniques do
			local use=false; local aim=target.root.Position
			if spec.Id=="MarkedBlade" then use=not a.anchor and distance&gt;9; aim=position+target.hum.MoveDirection*2-Vector3.new(0,3,0)
			elseif spec.Id=="Flashstep" then use=a.anchor~=nil and distance&gt;10
			elseif spec.Id=="BurstStrike" then use=distance&lt;7 and (target.state=="Recovery" or target.state=="Stunned" or target.state=="TechniqueRecovery")
			elseif spec.Id=="Read" then use=distance&lt;8 and danger and reacted
			elseif spec.Id=="NeedleFan" then use=distance&gt;8 and distance&lt;27
			elseif spec.Id=="MirageCast" then use=distance&gt;10 and distance&lt;21 and (target.state=="Recovery" or target.state=="Guarding" or self.rng:NextNumber()&lt;0.18) end
			if spec.Id=="FireBloom" then use=distance&lt;15 and (target.state=="Recovery" or target.state=="Guarding" or self.rng:NextNumber()&lt;0.28) end
			if spec.Id=="WindCut" then use=distance&gt;8 and distance&lt;28 end
			if spec.Id=="Quickstep" then use=distance&gt;9 and distance&lt;20 and self.rng:NextNumber()&lt;0.25 end
			if use and c:request(a,"Technique"..slot,aim) then return end
		end
	end
	if distance&lt;8 and self.rng:NextNumber()&lt;tune.Aggression then
		c:request(a,if a.grabVictim then "Attack" elseif distance&lt;5 and self.rng:NextNumber()&lt;.12 then "Grab" elseif self.rng:NextNumber()&lt;.16 then "Heavy" else "Attack")
	end
	if distance&gt;6 and distance&lt;17 and self.rng:NextNumber()&lt;0.1 then c:request(a,"Jump") end
	-- Sidestep cover when the direct route is obstructed.
	local block=workspace:Raycast(a.root.Position,toward*6,c:rayParams(true))
	if block then a.move=tangent; c:request(a,"Jump") end
end
return AI
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND18">
        <Properties>
          <string name="Name">Animation</string>
          <ProtectedString name="Source">-- Bangla PunchMoves animation playback, adapted for server-owned human and AI R15.
-- Combat uses imported choreography; the previous procedural punch fallback is removed.
local Shared=game:GetService('ReplicatedStorage').NinjaDuel
local Combo=require(Shared.BanglaCombo)
local Bindings=require(Shared.AnimationBindings)
local Donor=require(script.Parent.DonorAnimations)
local RunService=game:GetService('RunService')
local Provider=game:GetService('KeyframeSequenceProvider')
local ServerStorage=game:GetService('ServerStorage')
local Animation={}
local catalog={Idle=656117400,Run=656118852,Walk=656121766,Jump=656117878,Fall=656115606,Climb=656114359}
local cache,failures,loading={},{},{}
local function resolve(name)
 if Bindings[name] and Bindings[name]&gt;0 then return 'rbxassetid://'..Bindings[name] end
 if not RunService:IsStudio() then return nil,'Publish the retargeted '..name..' R15 sequence and fill AnimationBindings.' end
 if cache[name] then return cache[name] end
 if failures[name] then return nil,failures[name] end
 if loading[name] then
  local deadline=os.clock()+15
  repeat task.wait(.05) until not loading[name] or os.clock()&gt;=deadline
  return cache[name],failures[name] or 'Animation fetch still pending'
 end
 loading[name]=true
 local ok,value=pcall(function()
 local seq=Provider:GetKeyframeSequenceAsync('rbxassetid://'..Combo.AnimationIds[name])
 local r15=Donor.retarget(seq);seq:Destroy()
 local folder=ServerStorage:FindFirstChild('BanglaR15Sequences')
 if not folder then folder=Instance.new('Folder');folder.Name='BanglaR15Sequences';folder.Parent=ServerStorage end
 r15.Name=name;r15.Parent=folder
 return Provider:RegisterKeyframeSequence(r15)
 end)
 loading[name]=nil
 if ok then cache[name]=value;return value end
 failures[name]=tostring(value);return nil,failures[name]
end
function Animation.attach(a)
 if a.model:GetAttribute('SkipDonorAnimationQA') then return false end
 local animator=a.hum:FindFirstChildOfClass('Animator');if not animator then return false end
 local player={tracks={},instances={},current=nil,currentEvent=nil};a.animation=player
 a.model:SetAttribute('AuthoredAnimations',true)
 a.model:SetAttribute('DonorAnimationStatus','Loading')
 task.spawn(function()
  for name,id in catalog do
   local asset=Instance.new('Animation');asset.AnimationId='rbxassetid://'..id
   local ok,track=pcall(function() return animator:LoadAnimation(asset) end)
   if a.animation~=player then if ok then track:Destroy() end;asset:Destroy();return end
   table.insert(player.instances,asset)
   if ok then track.Priority=Enum.AnimationPriority.Movement;track.Looped=name=='Idle' or name=='Run' or name=='Walk' or name=='Climb';player.tracks[name]=track end
  end
  local ready=true
  for name in Combo.AnimationIds do
   local ok,id,reason=pcall(resolve,name)
   if a.animation~=player then return end
   if ok and id then
    local asset=Instance.new('Animation');asset.Name=name;asset.AnimationId=id
    local loaded,track=pcall(function() return animator:LoadAnimation(asset) end)
    table.insert(player.instances,asset)
    if loaded then track.Priority=Enum.AnimationPriority.Action;player.tracks[name]=track
    else ready=false;warn('[NinjaDuelAnimation] BLOCKED '..name..': '..tostring(track)) end
   else ready=false;warn('[NinjaDuelAnimation] BLOCKED '..name..': '..tostring(reason or id)) end
  end
  a.model:SetAttribute('DonorAnimationStatus',if ready then 'Ready' else 'Blocked')
 end)
 return true
end
local function choose(a,now)
 if a.health&lt;=0 then return nil end
 if a.state=='Startup' or a.state=='Active' or a.state=='Recovery' and a.attackName and now-a.attackStarted&lt;.5 then
  local action=Combo.Actions[a.attackName]
  -- Missing ninja branches reuse the imported moves; no local pose timeline.
  action=action or (if a.attackName=='Air1' or a.attackName=='DashAttack' then 'Punch' elseif a.attackName=='Air2' then 'HardSmack' else 'MegaPunch')
  return action,a.attackStarted
 end
 if a.reaction or a.state=='Stunned' then return nil end
 if a.state=='Guarding' then return 'Parry',0 end
 if a.state=='TechniqueChannel' then return 'Parry',a.untilTime end
 if a.wall then return 'Climb',0 end
 if a.airborne then return if a.root.AssemblyLinearVelocity.Y&gt;0 then 'Jump' else 'Fall',0 end
 if a.locomotion.Magnitude&gt;2 then return if a.locomotion.Magnitude&gt;30 then 'Run' else 'Walk',0 end
 return 'Idle',0
end
function Animation.step(a,now)
 local p=a.animation;if not p then return false end
 local name,event=choose(a,now)
 if p.current~=name or p.currentEvent~=event then
  if p.current and p.tracks[p.current] then p.tracks[p.current]:Stop(.08) end
  p.current=name;p.currentEvent=event
  if name and p.tracks[name] then p.tracks[name]:Play(.06) end
 elseif name and p.tracks[name] and not p.tracks[name].IsPlaying and (name=='Idle' or name=='Run' or name=='Walk' or name=='Climb' or name=='Parry') then
  p.tracks[name]:Play(.08)
 end
 if (name=='Run' or name=='Walk') and p.tracks[name] then p.tracks[name]:AdjustSpeed(math.clamp(a.locomotion.Magnitude/(if name=='Run' then 32 else 18),.75,1.7)) end
 return true
end
function Animation.clear(a)
 local p=a.animation;a.animation=nil;if not p then return end
 for _,track in p.tracks do track:Stop(0);track:Destroy() end
 for _,asset in p.instances do asset:Destroy() end
end
return Animation
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND19">
        <Properties>
          <string name="Name">BanglaCombat</string>
          <ProtectedString name="Source">-- Adapted from BanglaBattlegrounds ServerScriptService/StarterCombat.
-- Copyright (c) 2024 Dewan Mukto, MIT (vendor/bangla/LICENSE).
-- Retained: forward hitbox, per-swing Hits, damage table, parry seam, hit counter,
-- BasicPunch emission and swing/contact sounds. Changes: one validated actor API,
-- deterministic broadphase for anchored hitboxes, active-window lifetime/cleanup,
-- collision occlusion, and Ninja Duel's guard/chakra/damage authority.
local Debris=game:GetService('Debris')
local assets=game:GetService('ReplicatedStorage').NinjaDuel:WaitForChild('BanglaAssets')
local Combo=require(game:GetService('ReplicatedStorage').NinjaDuel.BanglaCombo)
local Bangla={}
local weaponSounds={['Light Melee']='rbxassetid://8595980577',['Heavy Melee']='rbxassetid://9117969717'}
local function sound(parent,id)
 local s=Instance.new('Sound');s.SoundId=id;s.Volume=.5;s.Parent=parent
 s:Play();Debris:AddItem(s,1.5)
end
function Bangla.begin(c,a,p)
 local hitbox=Instance.new('Part')
 hitbox.Name='BanglaHitbox';hitbox.Anchored=true;hitbox.CanCollide=false
 hitbox.CanQuery=false;hitbox.CanTouch=false;hitbox.Transparency=1
 hitbox.Size=Vector3.new(5,5,2)
 hitbox.CFrame=a.root.CFrame*CFrame.new(0,0,-2)
 hitbox.Parent=c.match.effects
 p.donor={hitbox=hitbox,Hits={},action=Combo.Actions[p.name] or 'MegaPunch'}
 -- The donor used Debris for lifetime; c.effects also cleans interrupted swings.
 table.insert(c.effects,{part=hitbox,expires=c.now+p.spec.startup+p.spec.active+.05})
 sound(a.root,'rbxassetid://5835032207')
 a.model:SetAttribute('CombatBase','BanglaBattlegrounds')
end
function Bangla.close(p)
 if p and p.donor then p.donor.hitbox:Destroy() end
end
function Bangla.tryHit(c,a,p)
 local donor=p.donor;local target=a.target
 if not donor or not donor.hitbox.Parent or not target or target.health&lt;=0 then return false end
 -- Same donor forward volume; missing air/grab mechanics supply their bounded shape.
 local hitbox=donor.hitbox
 hitbox.Size=Vector3.new(p.spec.width or 5,p.spec.height or 5,p.spec.depth or 2)
 hitbox.CFrame=a.root.CFrame*CFrame.new(0,0,-(p.spec.offset or 2))
 local params=OverlapParams.new();params.FilterType=Enum.RaycastFilterType.Include
 params.FilterDescendantsInstances={target.model}
 -- Touched on a teleported anchored part was unreliable; query the same volume.
 for _,hit in workspace:GetPartBoundsInBox(hitbox.CFrame,hitbox.Size,params) do
  if hit:IsDescendantOf(target.model) and not donor.Hits[target.id] then
   if not c:targetValid(a,target,p.spec.range,.05) then continue end
   donor.Hits[target.id]=true
   local delta=a.root.Position-target.root.Position
   local frontal=delta.Magnitude&lt;.001 or target.root.CFrame.LookVector:Dot(delta.Unit)&gt;.15
   local guarded=target.state=='Guarding' and target.chakra&gt;0 and frontal
   local protected=target.state=='TechniqueChannel' and target.pending and not target.pending.spec.Interruptible
   local damage=if Combo.Actions[p.name] then Combo.Damage[donor.action] else p.spec.damage
   local success=c:damage(a,target,damage*(a.def.CombatDamage or 1),false,true)
   if success then
    local weaponType=if donor.action=='MegaPunch' then 'Heavy Melee' else 'Light Melee'
    sound(target.root,weaponSounds[weaponType])
    local vfx=if donor.action=='MegaPunch' then 'ComboPunch' else 'BasicPunch'
    local basicPunch=assets.VFX[vfx].Attachment:Clone()
    basicPunch.Parent=target.root
    for _,v in basicPunch:GetChildren() do
     if v:IsA('ParticleEmitter') then v:Emit(v:GetAttribute('EmitCount') or 1) end
    end
    Debris:AddItem(basicPunch,.25)
    if c.now-(a.donorLastHit or -10)&gt;2 then a.donorHitCount=0 end
    a.donorHitCount=(a.donorHitCount or 0)+1;a.donorLastHit=c.now
   end
   return success,guarded,protected
  end
 end
 return false
end
return Bangla
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND20">
        <Properties>
          <string name="Name">BanglaEvade</string>
          <ProtectedString name="Source">-- performEvade from Bangla WalkRunHandler (Dewan Mukto, MIT), adapted.
-- One finite server tick loop replaces leaked RenderStepped connections. No global
-- gravity change; swept travel preserves walls, lane boundaries and root facing.
local Evade={}
function Evade.begin(a,c)
 local direction=if a.move.Magnitude&gt;.1 then a.move.Unit else a.root.CFrame.RightVector
 local evadeDistance=14*(a.def.DashScale or 1)
 local evadeDuration=.32
 a.evade={targetPosition=a.root.Position+direction*evadeDistance,startTime=c.now,duration=evadeDuration}
end
function Evade.step(a,c,travel)
 local e=a.evade;if not e then return end
 local rootPart=a.root
 local targetPosition=e.targetPosition
 local evadeDuration=e.duration
 local startTime=e.startTime
 local elapsedTime=c.now-startTime
 if elapsedTime&lt;evadeDuration then
  -- Donor's moving-origin interpolation, applied through the collision seam.
  local position=rootPart.Position:Lerp(targetPosition,elapsedTime/evadeDuration)
  local delta=position-rootPart.Position
  travel(a,c,delta,delta.Magnitude)
  rootPart.AssemblyLinearVelocity=Vector3.zero
 else a.evade=nil end
end
return Evade
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND21">
        <Properties>
          <string name="Name">Brawler</string>
          <ProtectedString name="Source">local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Attacks=require(Shared.Attacks)
local Motor=require(script.Parent.Motor)
local Bangla=require(script.Parent.BanglaCombat)
local Combo=require(Shared.BanglaCombo)
-- Adapter: reaction/air/grab mechanics missing from the donor; ground M1
-- progression and all strike hit volumes/damage/feedback run through Bangla.
local Brawler={}
local airReactions={Launched=true,Juggled=true,Knockback=true,Knockdown=true,WallSplat=true}
function Brawler.free(a,now)
 return a.reaction==nil or now&gt;=(a.reactionUntil or 0)
end
function Brawler.event(c,a,event)
 a.events=a.events or {};a.events[event]=(a.events[event] or 0)+1
 if c.match.onCombatEvent then c.match.onCombatEvent(a,event) end
end
function Brawler.releaseGrab(a)
 local b=a.grabVictim
 if b then b.grabbedBy=nil;b.reaction=nil;b.reactionUntil=0;a.grabVictim=nil end
 if a.grabbedBy then a.grabbedBy.grabVictim=nil;a.grabbedBy=nil end
end
function Brawler.react(c,a,kind,velocity,duration)
 Brawler.releaseGrab(a)
 Bangla.close(a.pending)
 a.reaction=kind;a.reactionUntil=c.now+duration;a.reactionVelocity=velocity
 a.pending=nil;a.buffered=nil;a.guardHeld=false;a.state="Neutral";a.untilTime=c.now
 a.locomotion=Vector3.zero
 if airReactions[kind] then a.airborne=true end
 if kind=="Knockdown" then a.invulnerableUntil=c.now+duration+.24 end
end
function Brawler.start(c,a,name)
 Bangla.close(a.pending)
 local spec=table.clone(Attacks[name]);spec.travel*=a.def.CombatTravel or 1
 a.buffered=nil
 a.attackName=name;a.attackStarted=c.now;a.hitConfirmed=false;a.chainOpen=false;a.guardHeld=false
 a.pending={kind="Brawl",name=name,spec=spec,hit=false}
 Bangla.begin(c,a,a.pending)
 a.travelRemaining=spec.travel
 local flat=a.root.CFrame.LookVector*Vector3.new(1,0,1)
 local delta=a.target.root.Position-a.root.Position;delta=delta*Vector3.new(1,0,1)
 if delta.Magnitude&gt;.1 and delta.Magnitude&lt;11 and flat:Dot(delta.Unit)&gt;.55 then flat=delta.Unit end
 a.travelDirection=flat.Unit;a.state="Startup";a.untilTime=c.now+spec.startup
 if name=="Air1" or name=="Air2" or name=="Slam" then a.airHold=c.now+spec.startup+spec.active+spec.recovery+.18 end
 Brawler.event(c,a,name)
 return true
end
function Brawler.request(c,a,action)
 local relevant=action=="Attack" or action=="Heavy" or action=="Grab" or action=="ThrowUp"
 if not relevant then return nil end
 if not Brawler.free(a,c.now) then return false,"Reacting" end
 if a.wall then Motor.detach(a,c.now,false) end
 if a.grabVictim then
  if action=="Attack" or action=="Heavy" or action=="Grab" or action=="ThrowUp" then
   return Brawler.start(c,a,if action=="Heavy" or action=="ThrowUp" then "ThrowUp" else "Throw")
  end
 end
 local pending=a.pending
 local canChain=a.state=="Recovery" and a.chainOpen and c.now&gt;=(a.chainAt or 0)
 local canDash=a.state=="Dodging" and c.now&gt;=a.untilTime-.16
 if a.state~="Neutral" and a.state~="Guarding" and not canChain and not canDash then
  if pending and pending.kind=="Brawl" and (a.state=="Active" or a.state=="Recovery" or (a.state=="Startup" and c.now&gt;=a.untilTime-.07)) then a.buffered={action=action,expires=c.now+.24} end
  return false,"Committed"
 end
 if action=="Grab" then
  if a.airborne or (a.grabCooldown or 0)&gt;c.now then return false,"Grab unavailable" end
  a.grabCooldown=c.now+1.4;return Brawler.start(c,a,"Grab")
 end
 if action=="ThrowUp" then return false,"No grab" end
 if action=="Heavy" then
  if a.airborne then return Brawler.start(c,a,"Slam") end
  if canChain and a.combo&gt;=2 then a.combo=0;return Brawler.start(c,a,"Launcher") end
  return Brawler.start(c,a,"Heavy")
 end
 if a.airborne then
  a.airCombo=if c.now-(a.lastAirAttack or 0)&gt;.8 then 1 else (a.airCombo or 0)%2+1
  a.lastAirAttack=c.now;return Brawler.start(c,a,"Air"..a.airCombo)
 end
 local name=Combo.next(a,c.now)
 return Brawler.start(c,a,if canDash then "DashAttack" else name)
end
function Brawler.hit(c,a,p)
 local b=a.target;local spec=p.spec
 if p.name=="Throw" or p.name=="ThrowUp" then
  b=a.grabVictim
  if not b or b.health&lt;=0 then return false end
  Brawler.releaseGrab(a)
  local direction=if a.move.Magnitude&gt;.2 then a.move.Unit else a.root.CFrame.LookVector
  a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+direction)
 end
 local success,guarded,protected
 if p.name~="Throw" and p.name~="ThrowUp" then
  -- Grab has no donor damage action; donor contact volume still validates it.
  if p.name=="Grab" then
   if not c:targetValid(a,b,spec.range,.05) then return false end
   local donor=p.donor
   donor.hitbox.CFrame=a.root.CFrame*CFrame.new(0,0,-2)
   local params=OverlapParams.new();params.FilterType=Enum.RaycastFilterType.Include;params.FilterDescendantsInstances={b.model}
   if #workspace:GetPartBoundsInBox(donor.hitbox.CFrame,donor.hitbox.Size,params)==0 then return false end
  else
   success,guarded,protected=Bangla.tryHit(c,a,p)
   if not success then return false end
  end
 end
 if p.name=="Grab" then
  if b.invulnerableUntil&gt;c.now or b.grabbedBy or b.reaction=="Wakeup" then return false end
  Brawler.releaseGrab(b);b.pending=nil;b.state="Neutral";b.guardHeld=false
  b.lastHurt=c.now; b.reaction="Grabbed";b.reactionUntil=c.now+.8;b.grabbedBy=a;a.grabVictim=b
  a.grabUntil=c.now+.8;Brawler.event(c,a,"GrabHit");return true
 end
 if p.name=="Throw" or p.name=="ThrowUp" then
  success=c:damage(a,b,spec.damage*(a.def.CombatDamage or 1),false,true)
 end
 if not success or b.health&lt;=0 then return success end
 if protected then return true end
 if guarded then
  Brawler.event(c,b,"GuardHit")
  if p.name=="Heavy" or p.name=="Slam" then b.chakra=math.max(0,b.chakra-25) end
  if b.chakra&lt;=0 then Brawler.react(c,b,"GuardStun",Vector3.zero,.6);b.guardHeld=false
  else b.guardImpact=c.now+.15 end
  return true
 end
 local impulse=a.root.CFrame.LookVector*spec.impulse.Z+Vector3.yAxis*spec.impulse.Y
 Brawler.react(c,b,spec.reaction,impulse,spec.stun)
 if spec.reaction=="Launched" then a.pursuitUntil=c.now+1.15;Brawler.event(c,a,"LaunchHit") end
 if p.name=="Air1" or p.name=="Air2" then Brawler.event(c,a,"AirHit") end
 if p.name=="Slam" then Brawler.event(c,a,"SlamHit");a.airHold=0 end
 if p.name=="Throw" or p.name=="ThrowUp" then Brawler.event(c,a,"ThrowHit") end
 Brawler.event(c,a,"Hit");return true
end
function Brawler.step(c,a,dt)
 if a.buffered and c.now&gt;a.buffered.expires then a.buffered=nil end
 if a.grabVictim then
  local b=a.grabVictim
  if c.now&gt;=(a.grabUntil or 0) or a.health&lt;=0 or b.health&lt;=0 then Brawler.releaseGrab(a)
  else
   local pos=a.root.Position+a.root.CFrame.LookVector*2.6
   local delta=pos-b.root.Position
   local grip=b.root.Position+(if delta.Magnitude&gt;.001 then delta.Unit*math.min(delta.Magnitude,26*dt) else Vector3.zero)
   b.root.CFrame=CFrame.lookAt(grip,a.root.Position);b.root.AssemblyLinearVelocity=Vector3.zero;b.hum:Move(Vector3.zero)
  end
 end
 if a.reaction then
  if a.reaction=="Grabbed" then return true end
  if c.now&gt;=a.reactionUntil then
   if a.reaction=="Knockdown" or a.reaction=="WallSplat" then a.reaction="Wakeup";a.reactionUntil=c.now+.24;a.invulnerableUntil=c.now+.24
   else a.reaction=nil;a.reactionVelocity=nil end
  end
  if a.reaction then
   a.hum:Move(Vector3.zero);a.root.AssemblyLinearVelocity=Vector3.zero
   local velocity=a.reactionVelocity or Vector3.zero
   if airReactions[a.reaction] then
    velocity+=Vector3.new(0,-75*dt,0)
    local hit=Motor.flight(a,c,velocity*dt)
    if hit then
     if hit.Normal.Y&gt;.5 and velocity.Y&lt;0 then
      if a.reaction=="Knockdown" then a.reactionUntil=math.min(a.reactionUntil,c.now+.55);Brawler.event(c,a,"LandedSlam") end
      velocity=Vector3.zero
     elseif math.abs(hit.Normal.Y)&lt;.2 and hit.Instance:GetAttribute("NinjaWall") then
      a.reaction="WallSplat";a.reactionUntil=c.now+.35;velocity=hit.Normal*10;Brawler.event(c,a,"WallSplat")
     end
    end
   else Motor.travel(a,c,velocity,velocity.Magnitude*dt);velocity*=math.exp(-dt*14) end
   a.reactionVelocity=velocity;return true
  end
 end
 local p=a.pending
 if p and p.kind=="Brawl" then
  if a.state=="Active" and not p.hit then
   p.hit=Brawler.hit(c,a,p);a.hitConfirmed=p.hit or a.hitConfirmed
  end
 end
 if a.buffered and c.now&lt;=a.buffered.expires and a.state=="Recovery" and a.chainOpen and c.now&gt;=a.chainAt then
  local action=a.buffered.action;a.buffered=nil;Brawler.request(c,a,action)
 end
 return false
end
return Brawler
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND22">
        <Properties>
          <string name="Name">Combat</string>
          <ProtectedString name="Source">local Shared = game:GetService("ReplicatedStorage").NinjaDuel
local Config = require(Shared.Config)
local Fighters = require(Shared.Fighters)
local Rules = require(Shared.Rules)
local World = require(script.Parent.World)
local Motor = require(script.Parent.Motor)
local Animation = require(script.Parent.Animation)
local Techniques = require(script.Parent.Techniques)
local Brawler = require(script.Parent.Brawler)
local Bangla = require(script.Parent.BanglaCombat)
local Evade = require(script.Parent.BanglaEvade)
local Combat = {}; Combat.__index = Combat
function Combat.new(match)
	return setmetatable({match=match,now=0,actors={},effects={},projectiles={},hazards={}},Combat)
end
function Combat:add(id,model,hum,root,joints,definition)
	local def = Fighters[definition]
	local a = { id=id,fighterId=definition,model=model,hum=hum,root=root,joints=joints,def=def,health=def.Health,
		chakra=def.Chakra or Config.Chakra,state="Neutral",untilTime=0,lockUntil=0,cooldowns={},move=Vector3.zero,
		combo=0,lastAttack=-10,readUntil=0,illusionUntil=0,bonusUntil=0,dodgeUntil=0,invulnerableUntil=0,
		color=Color3.fromRGB(table.unpack(def.Color)),guardHeld=false,lastMove=0, cue="",cueUntil=0,
		locomotion=Vector3.zero,sprinting=false,airborne=false,airDodgeUsed=false,landUntil=0,
		pursuitUntil=0,travelRemaining=0,travelDirection=Vector3.zero,chainOpen=false,hitConfirmed=false,
		subCharges=Config.Substitution.Charges,subCooldown=0,lastHurt=-10,neutralToolAt=0,wall=nil,wallNext=0 }
	table.insert(self.actors,a)
	Animation.attach(a)
	return a
end
function Combat:clamp(p)
	local o=self.match.origin; local r=Config.ArenaRadius
	return Vector3.new(math.clamp(p.X,o.X-r,o.X+r),math.clamp(p.Y,o.Y+3,o.Y+Config.ArenaHeight),math.clamp(p.Z,o.Z-r,o.Z+r))
end
function Combat:relocate(a,p)
	local look=a.root.CFrame.LookVector
	a.model:PivotTo(CFrame.lookAt(self:clamp(p),self:clamp(p)+Vector3.new(look.X,0,look.Z)))
	a.root.AssemblyLinearVelocity=Vector3.zero
end
function Combat:rayParams(excludeActors)
	local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude
	local exclude={self.match.effects}
	if excludeActors then for _,a in self.actors do table.insert(exclude,a.model) end end
	params.FilterDescendantsInstances=exclude
	return params
end
function Combat:overlapParams()
	local p=OverlapParams.new(); p.FilterType=Enum.RaycastFilterType.Exclude
	local exclude={self.match.effects}; for _,a in self.actors do table.insert(exclude,a.model) end
	p.FilterDescendantsInstances=exclude; return p
end
function Combat:lineOfSight(a,b)
	local delta=b.root.Position-a.root.Position
	return workspace:Raycast(a.root.Position,delta,self:rayParams(true)) == nil
end
function Combat:targetValid(a,b,range,facing)
	if not b or b.health&lt;=0 then return false end
	local delta=b.root.Position-a.root.Position
	if delta.Magnitude&gt;range then return false end
	if delta.Magnitude&gt;0.1 and a.root.CFrame.LookVector:Dot(delta.Unit)&lt;facing then return false end
	return self:lineOfSight(a,b)
end
function Combat:effect(name,p,color,size,lifetime)
	local v=World.part(self.match.effects,name,size,CFrame.new(p),color,Enum.Material.Neon)
	v.CanCollide=false; v.CanQuery=false; v.Transparency=0.4
	table.insert(self.effects,{part=v,expires=self.now+lifetime})
	return v
end
function Combat:addHazard(a,position,radius,duration,damage,kind)
	local hazard={a=a,position=position,radius=radius,expires=self.now+duration,damage=damage,kind=kind,lastHit={}}
	table.insert(self.hazards,hazard)
	return hazard
end
function Combat:cue(a,message,duration)
	a.cue=message; a.cueUntil=self.now+(duration or 1.1)
	if self.match.onCue then self.match.onCue(a,message) end
end
function Combat:setState(a,state,duration)
	a.state=state; a.untilTime=self.now+duration
end
function Combat:damage(attacker,victim,amount,heavy,readEligible)
	if self.match.phase~="Duel" or victim.health&lt;=0 or attacker.health&lt;=0 then return false end
	if victim.invulnerableUntil&gt;self.now then Brawler.event(self,victim,"Evaded"); self:cue(victim,"EVADED"); return false end
	if victim.wall then Motor.detach(victim,self.now,false) end
	local delta=attacker.root.Position-victim.root.Position
	local frontal=delta.Magnitude&lt;0.1 or victim.root.CFrame.LookVector:Dot(delta.Unit)&gt;0.15
	if readEligible and frontal and victim.readUntil&gt;self.now then
		victim.readUntil=0; victim.bonusUntil=self.now+1.4; victim.chakra=math.min(victim.def.Chakra or Config.Chakra,victim.chakra+10)
		attacker.pending=nil; self:setState(attacker,"Stunned",0.48)
		self:setState(victim,"Neutral",0)
		self:cue(victim,"READ SUCCESS • PUNISH"); self:cue(attacker,"READ • EXPOSED")
		return false
	end
	local guarded=Rules.isGuard(victim,frontal)
	if guarded then
		victim.chakra=math.max(0,victim.chakra-amount*1.6)
		amount*=victim.def.GuardStrength or Config.GuardChip
		self:cue(victim,"GUARDED")
		if victim.chakra&lt;=0 then
			victim.guardHeld=false; self:setState(victim,"Stunned",Config.GuardBreak); self:cue(victim,"GUARD BREAK")
		end
	else
		local interrupted=Rules.interruptible(victim)
		local protected= victim.state=="TechniqueChannel" and victim.pending and not victim.pending.spec.Interruptible
		if not protected then
			Brawler.releaseGrab(victim)
			victim.pending=nil; victim.readUntil=0; victim.guardHeld=false
			self:setState(victim,"Stunned",if interrupted then Config.InterruptStun else Config.HitStun)
			if interrupted then Brawler.event(self,attacker,"Interrupt"); self:cue(victim,"INTERRUPTED"); self:cue(attacker,"CHANNEL INTERRUPTED") end
		end
	end
	if attacker.bonusUntil&gt;self.now then amount*=1.35; attacker.bonusUntil=0 end
	victim.lastHurt=self.now
	victim.health=math.max(0,victim.health-amount); victim.hum.Health=victim.health
	victim.impactSerial=(victim.impactSerial or 0)+1; victim.impactHeavy=heavy or amount&gt;=12
	Brawler.event(self,attacker,"Damage"); if guarded then Brawler.event(self,victim,"GuardHit") end
	self:effect("Impact",victim.root.Position,if guarded then Color3.fromRGB(221,203,152) else attacker.color,Vector3.new(2,2,2),0.12)
	if heavy and not guarded and victim.health&gt;0 then
		attacker.pursuitUntil=self.now+Config.PursuitWindow
		self:cue(attacker,"LAUNCH • E TO PURSUE",Config.PursuitWindow)
		local push=Vector3.new(-delta.X,0,-delta.Z)
		if push.Magnitude&gt;0.1 then Brawler.react(self,victim,"Launched",push.Unit*22+Vector3.new(0,42,0),.9) end
	end
	if victim.health&lt;=0 then
		Brawler.releaseGrab(victim); victim.reaction=nil
		victim.state="Defeated"; victim.pending=nil; victim.move=Vector3.zero
		self.match.finish(attacker,victim)
	end
	attacker.hitConfirmed=true
	return true
end
function Combat:strike(a,damage,range,facing,heavy)
	if self:targetValid(a,a.target,range,facing) then return self:damage(a,a.target,damage,heavy,true) end
	return false
end
function Combat:projectile(a,aim,speed,range,damage,kind,onSurface)
	local start=a.root.Position+a.root.CFrame.LookVector*1.4
	local delta=aim-start
	if delta.Magnitude&lt;0.1 then delta=a.root.CFrame.LookVector end
	local visual=self:effect(kind,start,a.color,if kind=="blade" then Vector3.new(0.7,0.7,0.2) else Vector3.new(0.15,0.15,1.5),range/speed+0.15)
	if kind=="wind" then visual.Size=Vector3.new(3,.12,1.2);visual.Color=Color3.fromRGB(172,238,208) end
	if kind=="blade" then visual.CFrame=CFrame.new(start)*CFrame.Angles(0,0,math.pi/4) end
	table.insert(self.projectiles,{a=a,position=start,direction=delta.Unit,speed=speed,remaining=range,damage=damage,part=visual,onSurface=onSurface,kind=kind})
end
function Combat:request(a,action,aim)
	if self.match.phase~="Duel" or a.health&lt;=0 then return false,"No duel" end
	if action=="GuardOff" then
		a.guardHeld=false
		if a.state=="Guarding" then self:setState(a,"Neutral",0) end
		return true
	end
	if action=="JumpOff" then
		if a.airborne and a.root.AssemblyLinearVelocity.Y&gt;22 and self.now&lt;(a.takeoffUntil or 0)+0.18 then
			local v=a.root.AssemblyLinearVelocity
			a.root.AssemblyLinearVelocity=Vector3.new(v.X,v.Y*0.66,v.Z)
		end
		return true
	end
	if action=="WallDetach" then Motor.detach(a,self.now,false); return true end
	if action=="Dodge" and not Brawler.free(a,self.now) then action="Substitute" end
	if action=="Substitute" then
		local tune=Config.Substitution
		if a.subCharges&lt;=0 or self.now&lt;a.subCooldown then return false,"No substitution" end
		if a.chakra&lt;tune.Cost then return false,"Need chakra" end
		if self.now-a.lastHurt&gt;tune.Window or (a.state~="Stunned" and Brawler.free(a,self.now)) then return false,"No escape window" end
		local away=a.root.Position-a.target.root.Position
		away=Vector3.new(away.X,0,away.Z)
		if away.Magnitude&lt;0.1 then away=a.root.CFrame.RightVector end
		local departure=a.root.Position
		local moved=Motor.travel(a,self,away,tune.Distance)
		if moved&lt;2 then return false,"Escape blocked" end
		a.subCharges-=1; a.chakra-=tune.Cost; a.subCooldown=self.now+tune.Cooldown
		a.subUntil=self.now+0.17
		Brawler.releaseGrab(a); a.reaction=nil; a.reactionVelocity=nil; a.airHold=0
		Brawler.event(self,a,"Substitute"); a.pending=nil; a.guardHeld=false; a.invulnerableUntil=self.now+0.16
		self:setState(a,"Recovery",0.16)
		self:effect("Afterimage",departure,a.color,Vector3.new(2,4,2),0.35)
		self:effect("Substitution",a.root.Position,a.color,Vector3.new(3,4,3),0.25)
		self:cue(a,"SUBSTITUTION • REPOSITIONED")
		return true
	end
	if action=="Feint" then
		local pending=a.pending
		if a.state~="TechniqueChannel" or not pending or not pending.spec.Feintable then return false,"No feint window" end
		if self.now&gt;a.untilTime-pending.spec.Channel*0.5 then return false,"Feint too late" end
		a.chakra=math.min(a.def.Chakra or Config.Chakra,a.chakra+pending.spec.Cost*0.35)
		a.pending=nil; self:setState(a,"Recovery",0.24); self:cue(a,"FEINT • CHAKRA PARTIAL")
		return true
	end
	local handled,reason=Brawler.request(self,a,action)
	if handled~=nil then return handled,reason end
	if not Brawler.free(a,self.now) then return false,"Reacting" end
	if action=="Pursuit" then
		if a.pursuitUntil&lt;=self.now or a.target.health&lt;=0 then return false,"No pursuit" end
		if a.chakra&lt;Config.PursuitCost then return false,"Need chakra" end
		if (a.target.root.Position-a.root.Position).Magnitude&gt;Config.PursuitRange then return false,"Too far" end
		if a.state~="Neutral" and a.state~="Recovery" and a.state~="TechniqueRecovery" then return false,"Committed" end
		a.chakra-=Config.PursuitCost; a.pursuitUntil=0
		a.reaction=nil; a.airborne=true; a.airHold=self.now+.75
		Brawler.event(self,a,"Chase")
		self:setState(a,"Pursuit",0.24)
		self:effect("Pursuit",a.root.Position,a.color,Vector3.new(2,4,2),0.35)
		return true
	end
	if action=="Jump" then
		if a.wall then Motor.detach(a,self.now,true); return true end
		if a.state~="Neutral" and a.state~="Recovery" then return false,"Committed" end
		return Motor.jump(a,self,self.now),"Airborne"
	end
	if action=="Tool" then
		if not Rules.canAct(a,self.now) or self.now&lt;a.neutralToolAt then return false,"Tool recovering" end
		if a.wall then Motor.detach(a,self.now,false) end
		a.neutralToolAt=self.now+(if a.def.Name=="Minato" then 0.7 else 0.9)
		self:projectile(a,aim or a.target.root.Position,if a.def.Name=="Minato" then 76 else 69,34,if a.def.Name=="Minato" then 4 else 5,"tool")
		self:setState(a,"Recovery",0.12); self:cue(a,"PROJECTILE")
		return true
	end
	local chain=action=="Attack" and a.state=="Recovery" and a.chainOpen and self.now&gt;a.chainAt
	if not chain and not Rules.canAct(a,self.now) then return false,"Committed" end
	if action=="Guard" then Brawler.event(self,a,"Guard"); a.guardHeld=true; self:setState(a,"Guarding",0); return true end
	if action=="Dodge" then
		if a.chakra&lt;Config.DodgeCost then return false,"Need chakra" end
		if a.airborne and a.airDodgeUsed then return false,"Air dodge used" end
		if a.dodgeUntil&gt;self.now then return false,"Cooldown" end
		a.chakra-=Config.DodgeCost; a.dodgeUntil=self.now+Config.DodgeCooldown
		if a.wall then Motor.detach(a,self.now,false) end
		if a.airborne then a.airDodgeUsed=true end
		a.dodgeDirection=if a.move.Magnitude&gt;0.1 then a.move.Unit else a.root.CFrame.RightVector
		a.invulnerableUntil=self.now+Config.DodgeIFrames; a.guardHeld=false
		Evade.begin(a,self)
		Brawler.event(self,a,"Dodge"); self:setState(a,"Dodging",Config.DodgeTime); self:effect("Dodge",a.root.Position,a.color,Vector3.new(2,4,1),0.2)
		return true
	end
	if self.match.techniquesDisabled then return false,"Techniques disabled" end
	local slot=tonumber(string.match(action,"^Technique([1-5])$"))
	local spec=slot and a.def.Techniques[slot]
 if spec and (a.trainingChannelScale or 1)~=1 then spec=table.clone(spec);spec.Channel*=a.trainingChannelScale end
	if not spec then return false,"Unknown action" end
	local technique=Techniques[spec.Id]
	local ok,reason=Rules.technique(a,spec,self.now,technique.check(self,a,spec,self.now))
	if not ok then return false,reason end
	if a.wall then Motor.detach(a,self.now,false) end
	Brawler.event(self,a,"Technique"); Rules.reserve(a,spec,self.now); a.guardHeld=false
	a.pending={kind="Technique",spec=spec,implementation=technique,aim=aim or a.target.root.Position}
	local offset=a.pending.aim-a.root.Position
	local flat=Vector3.new(offset.X,0,offset.Z)
	if flat.Magnitude&gt;0.1 then a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+flat) end
	if spec.Element=="Fire" then
  local telegraph=self:effect("Fire telegraph",a.root.Position+a.root.CFrame.LookVector*8-Vector3.new(0,2.7,0),Color3.fromRGB(255,175,95),Vector3.new(.06,11.6,11.6),spec.Channel)
  telegraph.Shape=Enum.PartType.Cylinder;telegraph.CFrame*=CFrame.Angles(0,0,math.pi/2);telegraph.Transparency=.82
 end
 self:cue(a,spec.Name.." • PREPARING",spec.Channel)
	self:effect("Channel",a.root.Position-Vector3.new(0,2.8,0),a.color,Vector3.new(4,0.12,4),spec.Channel)
	return true
end
function Combat:updateActor(a,dt)
	local now=self.now
	if a.health&lt;=0 then a.hum:Move(Vector3.zero); return end
	if a.anchor and a.anchor.expires&lt;=now then a.anchor.part:Destroy(); a.anchor=nil end
	if a.illusionUntil&lt;=now then a.decoyPosition=nil end
	if a.state=="Guarding" then
		a.chakra=math.max(0,a.chakra-Config.GuardDrain*dt)
		if a.chakra&lt;=0 then a.guardHeld=false; self:setState(a,"Stunned",Config.GuardBreak); self:cue(a,"GUARD BREAK") end
	elseif a.state~="TechniqueChannel" and a.state~="Stunned" then
		a.chakra=math.min(a.def.Chakra or Config.Chakra,a.chakra+(a.def.ChakraRegen or Config.ChakraRegen)*dt)
	end
	if a.state~="Neutral" and a.state~="Guarding" and a.untilTime&lt;=now then
		local pending=a.pending
		if a.state=="Startup" and pending then
			self:setState(a,"Active",pending.spec.active)
		elseif a.state=="Active" then
			Bangla.close(pending)
			a.pending=nil; self:setState(a,"Recovery",if pending then pending.spec.recovery else .22)
			a.chainOpen=a.hitConfirmed and pending and pending.kind=="Brawl" and pending.spec.chain==true
			a.chainAt=now+0.035
		elseif a.state=="TechniqueChannel" and pending then
			-- State changes before payoff so simultaneous channels resolve deterministically.
			self:setState(a,"TechniqueActive",pending.spec.Active)
			pending.implementation.execute(self,a,pending,now)
		elseif a.state=="TechniqueActive" and pending then
			a.pending=nil; self:setState(a,"TechniqueRecovery",pending.spec.Recovery)
		else
			a.pending=nil; self:setState(a,"Neutral",0)
		end
	end
	if self.match.phase~="Duel" then a.hum:Move(Vector3.zero); return end
 if a.state~="Dodging" then a.evade=nil end
	if Brawler.step(self,a,dt) then World.pose(a,now,dt); return end
	if a.locked and (a.state=="Neutral" or a.state=="Guarding") then
		a.hum.AutoRotate=false
		local toward=a.target.root.Position-a.root.Position; toward=Vector3.new(toward.X,0,toward.Z)
		if toward.Magnitude&gt;0.1 then a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+toward) end
	else a.hum.AutoRotate=not a.locked end
	if a.state=="Dodging" then
		Evade.step(a,self,Motor.travel)
	elseif a.state=="Pursuit" then
		local toTarget=a.target.root.Position-a.root.Position
		if toTarget.Magnitude&gt;3 then Motor.flight(a,self,toTarget.Unit*math.min(100*dt,toTarget.Magnitude-3)) end
	elseif (a.state=="Startup" or a.state=="Active") and a.pending and a.pending.kind=="Brawl" and (a.attackName=="Air1" or a.attackName=="Air2" or a.attackName=="Slam") then
  local delta=a.target.root.Position-a.root.Position
  if delta.Magnitude&lt;10 and self:lineOfSight(a,a.target) then
   local correction=Vector3.new(0,math.clamp(delta.Y,-40*dt,40*dt),0)
   if math.abs(delta.Y)&lt;.6 then correction=Vector3.zero end
   Motor.flight(a,self,correction)
  end
 elseif (a.state=="Startup" or a.state=="Active") and a.pending and a.pending.kind=="Brawl" and a.travelRemaining&gt;0 then
		local toTarget=a.target.root.Position-a.root.Position
		local flatTarget=Vector3.new(toTarget.X,0,toTarget.Z)
		if flatTarget.Magnitude&gt;2.6 then
			local distance=math.min(a.travelRemaining,a.pending.spec.travel*dt/a.pending.spec.travelTime,flatTarget.Magnitude-2.6)
			a.travelRemaining-=Motor.travel(a,self,a.travelDirection,distance)
		end
	end
	if now&lt;(a.airHold or 0) and a.airborne then
		a.root.AssemblyLinearVelocity=Vector3.zero; a.hum:Move(Vector3.zero)
	else Motor.step(a,self,dt,now) end
	-- Server-owned humanoids + server-clamped arena coordinates.
	local p=a.root.Position
	if math.abs(p.X-self.match.origin.X)&gt;Config.ArenaRadius or math.abs(p.Z-self.match.origin.Z)&gt;Config.ArenaRadius or p.Y&lt;self.match.origin.Y-3 then self:relocate(a,p) end
	World.pose(a,now,dt)
end
function Combat:updateProjectiles(dt)
	for i=#self.projectiles,1,-1 do
		local p=self.projectiles[i]
		if not p or self.match.phase~="Duel" then return end
		local step=p.direction*math.min(p.speed*dt,p.remaining)
		local ray=RaycastParams.new(); ray.FilterType=Enum.RaycastFilterType.Exclude
		ray.FilterDescendantsInstances={self.match.effects,p.a.model}
		local hit=workspace:Raycast(p.position,step,ray)
		local done=false
		if hit then
			if hit.Instance:IsDescendantOf(p.a.target.model) then
				local damaged=self:damage(p.a,p.a.target,p.damage,false,false)
				if damaged and p.kind=="wind" then
					p.a.target.root.AssemblyLinearVelocity=p.direction*37+Vector3.new(0,14,0)
				end
				if self.match.phase~="Duel" then return end
				-- A blade also leaves an anchor beneath its struck target.
				if p.onSurface then p.onSurface(hit.Position,hit.Normal) end
			elseif p.onSurface and hit.Instance.CanCollide then p.onSurface(hit.Position,hit.Normal) end
			done=true
		end
		p.position+=step; p.remaining-=step.Magnitude
		if p.part.Parent then p.part.CFrame=CFrame.lookAt(p.position,p.position+p.direction) end
		if done or p.remaining&lt;=0 or p.a.health&lt;=0 then p.part:Destroy(); table.remove(self.projectiles,i) end
	end
end
function Combat:updateHazards()
	for i=#self.hazards,1,-1 do
		local h=self.hazards[i]
		if self.now&gt;=h.expires or h.a.health&lt;=0 then table.remove(self.hazards,i)
		else
			local target=h.a.target
			local delta=target.root.Position-h.position
			local flat=Vector3.new(delta.X,0,delta.Z)
			if target.health&gt;0 and flat.Magnitude&lt;=h.radius and math.abs(delta.Y)&lt;6 and self.now-(h.lastHit[target] or -10)&gt;0.48 then
				local ray=workspace:Raycast(h.position,target.root.Position-h.position,self:rayParams(true))
				if not ray then
					h.lastHit[target]=self.now
					self:damage(h.a,target,h.damage*0.34,false,false)
				end
			end
		end
	end
end
function Combat:update(dt,now)
	self.now=now
	if self.match.phase~="Duel" then return end
	for _,a in self.actors do
		if self.match.phase~="Duel" then break end
		self:updateActor(a,dt)
	end
	if self.match.phase=="Duel" then self:updateProjectiles(dt); self:updateHazards() end
	for i=#self.effects,1,-1 do
		local e=self.effects[i]
		if e.expires&lt;=now or not e.part.Parent then e.part:Destroy(); table.remove(self.effects,i) end
	end
end
function Combat:clear(preserveAnimations)
	for _,a in self.actors do
		if not preserveAnimations then Animation.clear(a) end
		Bangla.close(a.pending); Motor.reset(a);
		Brawler.releaseGrab(a); a.reaction=nil; a.reactionVelocity=nil; a.buffered=nil; a.airHold=0; a.pursuitUntil=0; a.chainOpen=false
		a.state=if a.health&gt;0 then "Neutral" else "Defeated"; a.guardHeld=false; a.readUntil=0; a.bonusUntil=0; a.dodgeUntil=0; a.invulnerableUntil=0; a.travelRemaining=0
		a.evade=nil;a.donorHitCount=0;a.donorLastHit=nil; a.combo=0;a.lastAttack=-10;
		a.attackName=nil; a.attackStarted=0; a.pending=nil; a.anchor=nil; a.illusionUntil=0; a.decoyPosition=nil; a.move=Vector3.zero; a.wall=nil
		a.hum:Move(Vector3.zero); a.root.AssemblyLinearVelocity=Vector3.zero; a.locomotion=Vector3.zero; a.airborne=false
	end
	self.match.effects:ClearAllChildren(); table.clear(self.effects); table.clear(self.projectiles); table.clear(self.hazards)
end
return Combat
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND23">
        <Properties>
          <string name="Name">DonorAnimations</string>
          <ProtectedString name="Source">-- R6 -&gt; R15 compatibility only; transforms/times remain the donor choreography.
local Donor={}
local basis={
 Torso=CFrame.Angles(-math.pi/2,0,math.pi),Head=CFrame.Angles(-math.pi/2,0,math.pi),
 ['Right Arm']=CFrame.Angles(0,math.pi/2,0),['Left Arm']=CFrame.Angles(0,-math.pi/2,0),
 ['Right Leg']=CFrame.Angles(0,math.pi/2,0),['Left Leg']=CFrame.Angles(0,-math.pi/2,0),
}
local mapped={Head='Head',['Right Arm']='RightUpperArm',['Left Arm']='LeftUpperArm',
 ['Right Leg']='RightUpperLeg',['Left Leg']='LeftUpperLeg'}
local function pose(parent,name,cf,weight)
 local p=Instance.new('Pose');p.Name=name;p.CFrame=cf;p.Weight=weight or 1;p.Parent=parent;return p
end
function Donor.retarget(sequence)
 local result=Instance.new('KeyframeSequence');result.Name=sequence.Name..'_R15';result.Loop=sequence.Loop;result.Priority=sequence.Priority
 for _,frame in sequence:GetKeyframes() do
  local key=Instance.new('Keyframe');key.Name=frame.Name;key.Time=frame.Time;key.Parent=result
  local byName={};for _,p in frame:GetDescendants() do if p:IsA('Pose') then byName[p.Name]=p end end
  local source=byName.Torso
  local root=pose(key,'HumanoidRootPart',CFrame.identity,0)
  local torsoCF=if source then basis.Torso*source.CFrame*basis.Torso:Inverse() else CFrame.identity
  local lower=pose(root,'LowerTorso',torsoCF)
  local upper=pose(lower,'UpperTorso',CFrame.identity)
  for old,name in mapped do
   local src=byName[old]
   if src then
    local b=basis[old]
    local cf=b*src.CFrame*b:Inverse()
    local p=pose(if old:find('Leg') then lower else upper,name,cf,src.Weight)
    p.EasingStyle=src.EasingStyle;p.EasingDirection=src.EasingDirection
   end
  end
  for _,child in frame:GetChildren() do if child:IsA('KeyframeMarker') then child:Clone().Parent=key end end
 end
 return result
end
return Donor
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND24">
        <Properties>
          <string name="Name">Elements</string>
          <ProtectedString name="Source">-- Element families define different gameplay primitives. Fire and Wind are
-- equipped in this slice; the other families reserve explicit behavior seams.
local Elements={
	Families={
		Fire={primitive="AreaPressure",counter="Leave the telegraphed fan"},
		Lightning={primitive="PrecisionBurst",counter="Bait the committed line"},
		Wind={primitive="Displacement",counter="Sidestep the cutting lane"},
		Water={primitive="MovingControlVolume",counter="Cross behind the wave"},
		Earth={primitive="SolidGroundCover",counter="Reposition around cover"},
	},
}
function Elements.fire(c,a,pending,now)
	local spec=pending.spec
	local center=a.root.Position+a.root.CFrame.LookVector*8
	local visual=c:effect("Fire Bloom",center,Color3.fromRGB(255,111,48),Vector3.new(9,1,9),0.82)
	visual.Shape=Enum.PartType.Cylinder;visual.Size=Vector3.new(.08,11.6,11.6)
 visual.CFrame=CFrame.new(center-Vector3.new(0,2.7,0))*CFrame.Angles(0,0,math.pi/2);visual.Transparency=.68
 for i=-2,2 do
  local p=c:effect("Flame",center+a.root.CFrame.RightVector*i*1.65+Vector3.new(0,-.5,0),Color3.fromRGB(255,155+i*12,55),Vector3.new(1.7,3+math.abs(i)*.4,1.7),.36)
  p.Shape=Enum.PartType.Ball;p.Transparency=.25
 end
	c:cue(a,"FIRE • FAN ACTIVE")
	local hazard=c:addHazard(a,center,5.8,0.82,spec.Damage,"Fire")
	-- Immediate pressure is still subject to real range, facing and sight.
	if c:targetValid(a,a.target,spec.Range,0.32) then
		local delta=a.target.root.Position-center
		if Vector3.new(delta.X,0,delta.Z).Magnitude&lt;=6.5 then
			if c:damage(a,a.target,spec.Damage,false,false) then hazard.lastHit[a.target]=now end
		end
	end
end
function Elements.wind(c,a,pending)
	local aim=pending.aim
	if (aim-a.root.Position).Magnitude&lt;1 then aim=a.root.Position+a.root.CFrame.LookVector*pending.spec.Range end
	c:projectile(a,aim,88,pending.spec.Range,pending.spec.Damage,"wind")
	c:cue(a,"WIND • CUTTING LANE")
end
return Elements
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="ND25">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("NinjaDuel")
Players.CharacterAutoLoads=false
local remote=Instance.new("RemoteEvent"); remote.Name="Action"; remote.Parent=Shared
local Matches=require(script.Parent.Matches)
local matches=Matches.new(remote)
remote.OnServerEvent:Connect(function(player,payload) matches:request(player,payload) end)
Players.PlayerAdded:Connect(function(player) matches:selection(player) end)
Players.PlayerRemoving:Connect(function(player) matches:remove(player) end)
for _,player in Players:GetPlayers() do matches:selection(player) end
RunService.Heartbeat:Connect(function(dt) matches:update(dt,workspace:GetServerTimeNow()) end)
-- Available only in the separately built native QA place; never in the playable artifact.
if RunService:IsStudio() and workspace:GetAttribute("NinjaDuelQA")==true then
	task.spawn(function() require(script.Parent.NativeQA).run(matches) end)
end
print("[NinjaDuel] BUILD "..Shared.BuildFingerprint.Value)
print("[NinjaDuel] Ready — select a fighter and start the duel")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND26">
        <Properties>
          <string name="Name">Matches</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Config=require(Shared.Config)
local Fighters=require(Shared.Fighters)
local Rules=require(Shared.Rules)
local World=require(script.Parent.World)
local Combat=require(script.Parent.Combat)
local AI=require(script.Parent.AI)
local Tutorial=require(script.Parent.Tutorial)
local Matches={}; Matches.__index=Matches
function Matches.new(remote)
	local folder=Instance.new("Folder"); folder.Name="NinjaDuels"; folder.Parent=workspace
	return setmetatable({remote=remote,folder=folder,sessions={},nextLane=0,epoch=0},Matches)
end
function Matches:send(player,data)
	if player.Parent==Players then self.remote:FireClient(player,data) end
end
function Matches:session(player)
	if self.sessions[player] then return self.sessions[player] end
	self.nextLane+=1
	local s={phase="Selection",lane=self.nextLane,bucket={tokens=Config.RequestBurst,time=os.clock()},lastLifecycle=-10,epoch=0}
	self.sessions[player]=s; return s
end
function Matches:destroy(s)
	if s.combat then s.combat:clear() end
	if s.folder then s.folder:Destroy() end
	s.tutorial=nil; s.folder=nil; s.combat=nil; s.ai=nil; s.human=nil; s.bot=nil
end
function Matches:selection(player)
	local s=self:session(player); self:destroy(s)
	player.Character=nil; s.phase="Selection"; s.epoch+=1
	self:send(player,{phase="Selection",epoch=s.epoch})
end
function Matches:start(player,playerId,botId,training)
	local s=self:session(player)
	if not Fighters[playerId] or not Fighters[botId] then return false end
	self:destroy(s); s.epoch+=1
	s.playerId=playerId; s.botId=botId; s.winner=nil; s.phase="Duel"; s.origin=Vector3.new((s.lane-1)*240,0,0)
	s.folder=Instance.new("Folder"); s.folder.Name="Duel_"..s.lane; s.folder.Parent=self.folder
	s.effects=Instance.new("Folder"); s.effects.Name="Effects"; s.effects.Parent=s.folder
	World.arena(s.folder,s.origin)
	s.combat=Combat.new(s); s.combat.now=workspace:GetServerTimeNow()
	local function actor(id,def,position,look)
		local model,hum,root,joints=World.rig(s.folder,Fighters[def],CFrame.lookAt(position,look),id)
		return s.combat:add(id,model,hum,root,joints,def)
	end
	s.human=actor("PlayerFighter",playerId,s.origin+Vector3.new(0,3,14),s.origin+Vector3.new(0,3,-14))
	s.bot=actor("AIFighter",botId,s.origin+Vector3.new(0,3,-14),s.origin+Vector3.new(0,3,14))
	s.human.target=s.bot; s.bot.target=s.human; s.human.locked=true
	player.Character=s.human.model
	s.ai=AI.new(s.combat,s.bot,player.UserId%100000+ s.epoch)
	s.finish=function(winner,_loser)
		if s.phase~="Duel" then return end
		s.phase="Result"; s.winner=winner.id; s.combat:clear(true)
		for _,a in s.combat.actors do World.pose(a,s.combat.now,0.1) end
		for _,a in s.combat.actors do a.hum.WalkSpeed=0; a.root.Anchored=true end
		self:snapshot(player,s)
	end
	s.tutorial=nil; if training then Tutorial.new(s) end
	local epoch=s.epoch
	s.human.hum.Died:Connect(function() if s.epoch==epoch and s.phase=="Duel" then s.human.health=0; s.human.state="Defeated"; s.finish(s.bot,s.human) end end)
	s.bot.hum.Died:Connect(function() if s.epoch==epoch and s.phase=="Duel" then s.bot.health=0; s.bot.state="Defeated"; s.finish(s.human,s.bot) end end)
	self:snapshot(player,s)
	return true
end
function Matches:snapshot(player,s)
	local function data(a)
		local ready={}
		for i,spec in a.def.Techniques do
			ready[i]={id=spec.Id,name=spec.Name,cost=spec.Cost,remaining=math.max(0,(a.cooldowns[spec.Id] or 0)-s.combat.now),condition=not spec.Requires or (spec.Requires=="Anchor" and a.anchor~=nil) or (spec.Requires=="Target" and s.combat:targetValid(a,a.target,spec.Range,0.35))}
		end
		return {id=a.id,fighterId=a.fighterId,fighter=a.def.Name,health=a.health,maxHealth=a.def.Health,chakra=a.chakra,maxChakra=a.def.Chakra or Config.Chakra,state=a.state,
			techniques=ready,position=a.root.Position,channel=if a.state=="TechniqueChannel" then math.max(0,a.untilTime-s.combat.now) else 0,
			anchor=a.anchor and a.anchor.position,illusion=math.max(0,a.illusionUntil-s.combat.now),decoy=a.decoyPosition,
			cue=if a.cueUntil&gt;s.combat.now then a.cue else "",dodge=math.max(0,a.dodgeUntil-s.combat.now),read=math.max(0,a.readUntil-s.combat.now),
			speed=a.locomotion.Magnitude,airborne=a.airborne,pursuit=math.max(0,a.pursuitUntil-s.combat.now),combo=a.combo,
			subCharges=a.subCharges,wall=a.wall~=nil,reaction=a.reaction,attackName=a.attackName,attackElapsed=s.combat.now-(a.attackStarted or 0),airHold=a.airHold,impactSerial=a.impactSerial or 0,impactHeavy=a.impactHeavy,events=a.events,velocity=a.root.AssemblyLinearVelocity}
	end
	self:send(player,{phase=s.phase,epoch=s.epoch,winner=s.winner,tutorial=Tutorial.snapshot(s),origin=s.origin,human=data(s.human),bot=data(s.bot)})
end
function Matches:request(player,payload)
	local s=self:session(player); local clock=os.clock()
	if not Rules.consumeToken(s.bucket,clock,Config.RequestRate,Config.RequestBurst) then return end
	if type(payload)~="table" or type(payload.action)~="string" or #payload.action&gt;24 then return end
	local action=payload.action
	if action=="Ready" then
		if s.phase=="Selection" then self:send(player,{phase="Selection",epoch=s.epoch}) else self:snapshot(player,s) end
		return
	end
	if payload.epoch~=s.epoch then return end
	if action=="TutorialSkip" and s.tutorial then self:selection(player);s.tutorial=nil;return end
	if action=="Start" or action=="Tutorial" or action=="Rematch" or action=="Selection" then
		if clock-s.lastLifecycle&lt;0.8 then return end
		if (action=="Start" or action=="Tutorial") and s.phase=="Selection" then
			if type(payload.player)~="string" or type(payload.bot)~="string" then return end
			s.lastLifecycle=clock; self:start(player,payload.player,payload.bot,action=="Tutorial")
		elseif action=="Rematch" and s.phase=="Result" then
			s.lastLifecycle=clock; self:start(player,s.playerId,s.botId,s.tutorial~=nil)
		elseif action=="Selection" and (s.phase=="Result" or s.tutorial) then s.lastLifecycle=clock; self:selection(player) end
		return
	end
	if s.phase~="Duel" or not s.human then return end
	local function vector(v)
		return typeof(v)=="Vector3" and Rules.finite(v.X) and Rules.finite(v.Y) and Rules.finite(v.Z)
	end
	if action=="Move" then
		if not vector(payload.direction) or payload.direction.Magnitude&gt;1.01 or math.abs(payload.direction.Y)&gt;0.01 then return end
		s.human.move=payload.direction; s.human.lastMove=clock
		if type(payload.sprint)=="boolean" then s.human.sprinting=payload.sprint end
		if type(payload.locked)=="boolean" then
			if s.human.locked~=payload.locked then require(script.Parent.Brawler).event(s.combat,s.human,if payload.locked then "Lock" else "Unlock") end
			s.human.locked=payload.locked
		end
		return
	end
	local aim=nil
	if payload.aim~=nil then
		if not vector(payload.aim) or (payload.aim-s.human.root.Position).Magnitude&gt;150 then return end
		aim=payload.aim
	end
	local ok,reason=s.combat:request(s.human,action,aim)
	if not ok and reason~="Committed" then s.combat:cue(s.human,string.upper(reason)) end
end
function Matches:update(dt,now)
	for player,s in self.sessions do
		if s.phase=="Duel" then
			if os.clock()-s.human.lastMove&gt;0.4 then s.human.move=Vector3.zero end
			s.combat:update(math.min(dt,0.1),now)
			if s.phase=="Duel" then
				if s.tutorial then Tutorial.update(s,now,dt) else s.ai:update(now) end
			end
		end
		if s.combat and now&gt;=(s.nextSnapshot or 0) then
			s.nextSnapshot=now+Config.SnapshotInterval; self:snapshot(player,s)
		end
	end
end
function Matches:remove(player)
	local s=self.sessions[player]
	if s then self:destroy(s); self.sessions[player]=nil end
end
return Matches
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND27">
        <Properties>
          <string name="Name">Motor</string>
          <ProtectedString name="Source">-- Server movement authority. This module owns locomotion, landing and safe
-- action travel; AI and human actors use the same movement profile.
local Config=require(game:GetService("ReplicatedStorage").NinjaDuel.Config)
local Place1Movement=require(script.Parent.Place1Movement)
local Place1Parkour=require(script.Parent.Place1Parkour)
-- This adapter retains swept action travel and the NinjaWall extension only.
-- Place1 owns free locomotion/jump/air steering/mantle/wall-hop at runtime.
local Motor={}
local function donor(a,c)
 if not a.movementDonor then a.movementDonor=Place1Movement.new(a,c);a.parkourDonor=Place1Parkour.new(a,c) end
 return a.movementDonor,a.parkourDonor
end
function Motor.reset(a)
 if a.parkourDonor then a.parkourDonor.reset() end
 a.movementDonor=nil;a.parkourDonor=nil
end
local UP=Vector3.yAxis
local function flat(v) return Vector3.new(v.X,0,v.Z) end
function Motor.grounded(a,c)
	local p=RaycastParams.new(); p.FilterType=Enum.RaycastFilterType.Exclude
	p.FilterDescendantsInstances={a.model,c.match.effects}
	p.RespectCanCollide=true
	return workspace:Raycast(a.root.Position,Vector3.new(0,-3.6,0),p)~=nil
end
function Motor.jump(a,c,now)
 local movement,parkour=donor(a,c)
 if parkour.jump() then return true end
 return movement.jump(Motor.grounded(a,c))
end
function Motor.detach(a,now,rebound)
	local wall=a.wall
	if not wall then return false end
	a.wall=nil; a.wallNext=now+Config.Wall.ReattachDelay
	if rebound then a.wallJumpUntil=now+0.22 end
	if rebound and a.parkourDonor then a.parkourDonor.rebound(wall.normal)
 else a.root.AssemblyLinearVelocity=wall.normal*12+UP*8 end
	a.airborne=true
	return true
end
function Motor.tryWall(a,c,now)
	if a.wall or now&lt;(a.wallNext or 0) or a.move.Magnitude&lt;0.25 or a.state~="Neutral" then return false end
	local heading=flat(a.move)
	if heading.Magnitude&lt;0.25 then return false end
 local _,parkour=donor(a,c)
 local hit=parkour.wallSurface()
	if not hit or not hit.Instance:GetAttribute("NinjaWall") or math.abs(hit.Normal.Y)&gt;0.18 then return false end
	if heading.Unit:Dot(-hit.Normal)&lt;0.45 then return false end
	a.wall={part=hit.Instance,normal=hit.Normal,untilTime=now+Config.Wall.MaxTime}
	a.airborne=true;a.airDodgeUsed=false
	c:cue(a,"WALL RUN • SPACE REBOUND / C DETACH",0.8)
	return true
end
function Motor.stepWall(a,c,dt,now)
	local wall=a.wall
	if not wall then return false end
	if now&gt;=wall.untilTime or not wall.part.Parent or a.state=="Stunned" or a.state=="Defeated" then
		Motor.detach(a,now,false);return false
	end
	local p=RaycastParams.new();p.FilterType=Enum.RaycastFilterType.Exclude
	p.FilterDescendantsInstances={a.model,c.match.effects};p.RespectCanCollide=true
	local hit=workspace:Raycast(a.root.Position, -wall.normal*Config.Wall.Detect,p)
	if not hit or hit.Instance~=wall.part or hit.Normal:Dot(wall.normal)&lt;0.72 then
		Motor.detach(a,now,false);return false
	end
	local into=math.max(0,flat(a.move):Dot(-wall.normal))
	local side=flat(a.move)+wall.normal*into
	local motion=side*Config.Wall.SideSpeed+UP*Config.Wall.RiseSpeed*math.max(0.2,into)
	local target=hit.Position+wall.normal*Config.Wall.Clearance+motion*dt
	if target.Y&gt;wall.part.Position.Y+wall.part.Size.Y*0.5+1 then Motor.detach(a,now,true);return false end
	local obstacle=workspace:Raycast(a.root.Position,target-a.root.Position,p)
	if obstacle and obstacle.Instance~=wall.part then Motor.detach(a,now,false);return false end
	a.root.CFrame=CFrame.lookAt(c:clamp(target),c:clamp(target)-wall.normal)
	a.root.AssemblyLinearVelocity=Vector3.zero
	a.hum.AutoRotate=false;a.hum:Move(Vector3.zero,false)
	a.locomotion=side*Config.Wall.SideSpeed
	return true
end
function Motor.travel(a,c,direction,distance)
	local v=flat(direction)
	if v.Magnitude&lt;0.01 or distance&lt;=0 then return 0 end
	local start=a.root.Position
	local vector=v.Unit*distance
	local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances={a.model,c.match.effects}
	params.RespectCanCollide=true
	local hit=workspace:Raycast(start,vector,params)
	local advance=if hit then math.max(0,hit.Distance-2.1) else vector.Magnitude
	local target=c:clamp(start+v.Unit*advance)
	a.root.CFrame=CFrame.new(target)*a.root.CFrame.Rotation
	return (target-start).Magnitude
end
-- Full 3D swept travel used by chase and controlled victim trajectories.
function Motor.flight(a,c,delta)
 if delta.Magnitude&lt;.001 then return nil end
 local params=c:rayParams(true);params.RespectCanCollide=true
 local hit=workspace:Raycast(a.root.Position,delta.Unit*(delta.Magnitude+1.4),params)
 local movement=if hit then delta.Unit*math.max(0,hit.Distance-1.4) else delta
 local target=c:clamp(a.root.Position+movement)
 -- Root centre stays above the floor; actor body geometry is cosmetic.
 a.root.CFrame=CFrame.new(target)*a.root.CFrame.Rotation
 a.root.AssemblyLinearVelocity=Vector3.zero
 return hit
end
function Motor.step(a,c,dt,now)
	local profile=Config.Movement
 donor(a,c)
	if not a.wall then Motor.tryWall(a,c,now) end
	if Motor.stepWall(a,c,dt,now) then return false end
	local grounded=Motor.grounded(a,c)
	if grounded and a.airborne and now&gt;(a.takeoffUntil or 0) and a.root.AssemblyLinearVelocity.Y&lt;=5 then
		a.airborne=false; a.airDodgeUsed=false
		local falling=math.abs(a.root.AssemblyLinearVelocity.Y)
		a.landUntil=now+(if falling&gt;profile.HardLandVelocity then profile.HardLandRecovery else profile.SoftLandRecovery)
		c:effect("Land dust",a.root.Position-Vector3.new(0,2.8,0),a.color,Vector3.new(3,0.15,3),0.15)
	end
	if not grounded then a.airborne=true end
 local movement,parkour=donor(a,c)
 a.grounded=grounded
 if parkour.step() then return false end
 local sprinting=movement.step(dt,grounded)
 local limit=a.hum.WalkSpeed
 if a.state=="Guarding" then limit=Config.GuardSpeed
 elseif a.state=="TechniqueChannel" then limit=Config.ChannelSpeed
 elseif a.state=="Stunned" or a.state=="Defeated" or a.state=="Dodging" or a.state=="Pursuit" then limit=0
 elseif a.state~="Neutral" then limit=profile.AttackWalkSpeed end
 if a.grabVictim then limit=math.min(limit,5) end
 if now&lt;(a.landUntil or 0) then limit=math.min(limit,profile.HardLandSpeed) end
 a.hum.WalkSpeed=limit
 a.hum:Move(if limit&gt;0 then a.move else Vector3.zero,false)
 a.locomotion=a.move*limit
 a.model:SetAttribute("MovementBase","Place1")
	return grounded
end
return Motor
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND28">
        <Properties>
          <string name="Name">Place1Movement</string>
          <ProtectedString name="Source">-- Adapted directly from Place1 FirstPersonMovementController (alexkkork, MIT).
-- Per-actor/server execution replaces LocalPlayer, UI, input listeners and FPS camera.
-- Ground sprint/stamina, takeoff momentum, bunny-hop and air steering are donor code.
local Movement={}
function Movement.new(a,c)
 local WALK_SPEED=a.def.Speed
 local SPRINT_SPEED=44*(a.def.SprintScale or 1)
 local JUMP_VERTICAL_SPEED=60*(a.def.JumpScale or 1)
 local WALK_BHOP_SPEED=36
 local SPRINT_BHOP_SPEED=62*(a.def.SprintScale or 1)
 local STAMINA_DRAIN_SECONDS=60
 local STAMINA_REGEN_SECONDS=18
 local STAMINA_REGEN_DELAY=.85
 local EXHAUSTED_RECOVERY=.12
 local AIR_CONTROL_ACCELERATION=72*(a.def.AirControlScale or 1)
 local AIR_ACCELERATION_SPEED_CAP=72
 local MOMENTUM_CARRY_CAP=120
 local currentCharacter,currentHumanoid,currentRoot=a.model,a.hum,a.root
 local stamina,regenDelayRemaining,exhausted,sprinting=1,0,false,false
 local lastGroundHorizontalVelocity=Vector3.zero
 local lastJumpRequestAt=-math.huge
 local sprintInputs,jumpInputs='Sprint','Jump'
 local function anyHeld(kind) return kind=='Sprint' and a.sprinting end
 local function movementIsBlocked(_character)
  return a.wall~=nil or a.reaction~=nil or a.state~='Neutral'
   or a.model:GetAttribute('MovementTraversalActive')==true
 end
 local function setCharacterAttribute(name,value) a.model:SetAttribute(name,value) end
local function horizontalOf(vector)
	return Vector3.new(vector.X, 0, vector.Z)
end

local function moveVectorToward(current, target, maximumDelta)
	local difference = target - current
	local distance = difference.Magnitude
	if distance == 0 or distance &lt;= maximumDelta then
		return target
	end
	return current + difference / distance * maximumDelta
end

local function preserveTakeoffMomentum()
	local character = currentCharacter
	local root = currentRoot
	if not character or not root or not root.Parent or movementIsBlocked(character) then
		return
	end

	local velocity = root.AssemblyLinearVelocity
	local currentHorizontal = horizontalOf(velocity)
	local carry = lastGroundHorizontalVelocity
	local carrySpeed = carry.Magnitude
	if carrySpeed &lt;= currentHorizontal.Magnitude + 0.1 then
		return
	end

	if carrySpeed &gt; MOMENTUM_CARRY_CAP then
		carry = carry.Unit * MOMENTUM_CARRY_CAP
	end
	root.AssemblyLinearVelocity = Vector3.new(carry.X, velocity.Y, carry.Z)
end

local function applyAirControl(deltaTime, desiredSprint)
	local root = currentRoot
	local humanoid = currentHumanoid
	if not root or not humanoid then
		return
	end

	local moveDirection = horizontalOf(a.move)
	if moveDirection.Magnitude &lt; 0.05 then
		return
	end
	moveDirection = moveDirection.Unit

	local velocity = root.AssemblyLinearVelocity
	local horizontal = horizontalOf(velocity)
	local currentSpeed = horizontal.Magnitude
	local requestedSpeed = desiredSprint and SPRINT_SPEED or WALK_SPEED
	local targetSpeed
	if currentSpeed &gt; AIR_ACCELERATION_SPEED_CAP then
		targetSpeed = currentSpeed
	else
		targetSpeed = math.min(math.max(currentSpeed, requestedSpeed), AIR_ACCELERATION_SPEED_CAP)
	end

	local targetHorizontal = moveDirection * targetSpeed
	local steeredHorizontal = moveVectorToward(
		horizontal,
		targetHorizontal,
		AIR_CONTROL_ACCELERATION * deltaTime
	)
	local allowedSpeed = math.max(currentSpeed, AIR_ACCELERATION_SPEED_CAP)
	if steeredHorizontal.Magnitude &gt; allowedSpeed then
		steeredHorizontal = steeredHorizontal.Unit * allowedSpeed
	end

	if (steeredHorizontal - horizontal).Magnitude &gt; 0.001 then
		root.AssemblyLinearVelocity = Vector3.new(steeredHorizontal.X, velocity.Y, steeredHorizontal.Z)
	end
end

local function requestGroundJump()
	local character = currentCharacter
	local humanoid = currentHumanoid
	local root = currentRoot
	if not character or not humanoid or not root or movementIsBlocked(character)
		or humanoid.Health &lt;= 0 or not a.grounded then
		return
	end
	local now = c.now
	if now - lastJumpRequestAt &lt; 0.12 then
		return
	end
	lastJumpRequestAt = now

	local jumpDirection = horizontalOf(a.move)
	if jumpDirection.Magnitude &gt; 0.05 then
		jumpDirection = jumpDirection.Unit
		local fastHop = sprinting or anyHeld(sprintInputs)
		local targetHopSpeed = fastHop and SPRINT_BHOP_SPEED or WALK_BHOP_SPEED
		local currentVelocity = root.AssemblyLinearVelocity
		local currentHorizontal = horizontalOf(currentVelocity)
		local boostedSpeed = math.max(currentHorizontal.Magnitude, targetHopSpeed)
		local boosted = jumpDirection * math.min(boostedSpeed, MOMENTUM_CARRY_CAP)
		root.AssemblyLinearVelocity = Vector3.new(boosted.X, currentVelocity.Y, boosted.Z)
		lastGroundHorizontalVelocity = boosted
	end
	humanoid.Jump = true
	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	local takeoffVelocity = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(
		takeoffVelocity.X,
		math.max(takeoffVelocity.Y, JUMP_VERTICAL_SPEED),
		takeoffVelocity.Z
	)
	character:SetAttribute("MovementLastJumpAt", c.now)
	character:SetAttribute(
		"MovementLastJumpHorizontalSpeed",
		horizontalOf(root.AssemblyLinearVelocity).Magnitude
	)
	character:SetAttribute("MovementLastJumpVerticalSpeed", root.AssemblyLinearVelocity.Y)
end

local function updateMovement(deltaTime)
	local character = currentCharacter
	local humanoid = currentHumanoid
	local root = currentRoot
	if not character or not humanoid or not root or humanoid.Health &lt;= 0 then
		return
	end

	local blocked = movementIsBlocked(character)
	local grounded = a.grounded
	local horizontalVelocity = horizontalOf(root.AssemblyLinearVelocity)
	local groundSpeed = horizontalVelocity.Magnitude
	local hasMoveInput = a.move.Magnitude &gt; 0.05
	local wantsSprint = anyHeld(sprintInputs) and hasMoveInput

	if grounded then
		lastGroundHorizontalVelocity = horizontalVelocity
	end

	if exhausted and stamina &gt;= EXHAUSTED_RECOVERY then
		exhausted = false
	end

	sprinting = not blocked and wantsSprint and not exhausted and stamina &gt; 0
	if sprinting then
		stamina = math.max(0, stamina - deltaTime / STAMINA_DRAIN_SECONDS)
		regenDelayRemaining = STAMINA_REGEN_DELAY
		if stamina &lt;= 0 then
			stamina = 0
			exhausted = true
			sprinting = false
		end
	else
		regenDelayRemaining = math.max(0, regenDelayRemaining - deltaTime)
		if regenDelayRemaining == 0 then
			stamina = math.min(1, stamina + deltaTime / STAMINA_REGEN_SECONDS)
		end
	end

	if not blocked then
		local desiredWalkSpeed = sprinting and SPRINT_SPEED or WALK_SPEED
		if math.abs(humanoid.WalkSpeed - desiredWalkSpeed) &gt; 0.01 then
			humanoid.WalkSpeed = desiredWalkSpeed
		end

		if anyHeld(jumpInputs) and grounded then
			requestGroundJump()
		end

		if not grounded then
			applyAirControl(deltaTime, sprinting)
		end
	end

	setCharacterAttribute("MovementSprinting", sprinting)
	setCharacterAttribute("MovementStamina", stamina)
	setCharacterAttribute("MovementGroundSpeed", groundSpeed)
end


 local api={}
 function api.step(dt,grounded)
  a.grounded=grounded
  currentHumanoid:Move(a.move,false)
  updateMovement(math.min(dt,.1))
  a.locomotion=a.move*currentHumanoid.WalkSpeed
  return sprinting
 end
 function api.jump(grounded)
  a.grounded=grounded
  local previous=lastJumpRequestAt
  requestGroundJump()
  if lastJumpRequestAt~=previous then
   preserveTakeoffMomentum()
   a.airborne=true;a.airDodgeUsed=false;a.takeoffUntil=c.now+.18
   return true
  end
  return false
 end
 return api
end
return Movement
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND29">
        <Properties>
          <string name="Name">Place1Parkour</string>
          <ProtectedString name="Source">-- Adapted directly from Place1 ParkourTraversalController (alexkkork, MIT).
-- Per-actor server authority; semantic Jump API instead of donor UIS listeners.
-- Mantle detection/clearance/Bezier arc and multi-direction wall hops are retained.
local Parkour={}
function Parkour.new(a,c)
local MANTLE_REACH = 3.6
local MIN_LEDGE_HEIGHT = 0.7
local MAX_LEDGE_HEIGHT = 5.7
local MANTLE_CHECK_INTERVAL = 0.055
local MANTLE_COOLDOWN = 0.34
local WALL_HOP_REACH = 3.25
local WALL_HOP_AWAY_SPEED = 58
local WALL_HOP_UP_SPEED = 64
local WALL_HOP_COOLDOWN = 0.15
local MAX_WALL_HOPS = 2

 local character,humanoid,rootPart=a.model,a.hum,a.root
 local rayParams=c:rayParams(true);rayParams.RespectCanCollide=true
 local overlapParams=c:overlapParams();overlapParams.RespectCanCollide=true;overlapParams.MaxParts=32
local traversing = false
local mantleStartCFrame = CFrame.identity
local mantleTargetCFrame = CFrame.identity
local mantleStartedAt = 0
local mantleDuration = 0.42
local mantleHeight = 0
local savedWalkSpeed: number? = nil
local savedAutoRotate: boolean? = nil
local lastMantleAt = -math.huge
local lastMantleCheckAt = -math.huge

local jumpKeyHeld = false
local jumpPulseExpiresAt = 0
local wallHopCount = 0
local lastWallHopAt = -math.huge
local lastGroundedAt = c.now

local function horizontal(vector: Vector3): Vector3
	return Vector3.new(vector.X, 0, vector.Z)
end

local function safeUnit(vector: Vector3, fallback: Vector3): Vector3
	if vector.Magnitude &gt; 1e-4 then
		return vector.Unit
	end
	return fallback
end

local function standingRootOffset(currentHumanoid: Humanoid, currentRoot: BasePart): number
	if currentHumanoid.RigType == Enum.HumanoidRigType.R6 then
		local currentCharacter = character
		local torso = currentCharacter and currentCharacter:FindFirstChild("Torso")
		local leg = currentCharacter and (
			currentCharacter:FindFirstChild("Left Leg")
			or currentCharacter:FindFirstChild("Right Leg")
		)
		if torso and torso:IsA("BasePart") and leg and leg:IsA("BasePart") then
			return torso.Size.Y * 0.5 + leg.Size.Y
		end
		return 3
	end
	return math.max(2.2, currentHumanoid.HipHeight + currentRoot.Size.Y * 0.5)
end

local function setCharacterAttribute(name: string, value: any)
	local currentCharacter = character
	if currentCharacter and currentCharacter.Parent then
		currentCharacter:SetAttribute(name, value)
	end
end

local function hasAnyBooleanAttribute(instance: Instance, names: {string}): boolean
	local cursor: Instance? = instance
	while cursor do
		for _, name in names do
			if cursor:GetAttribute(name) == true then
				return true
			end
		end
		cursor = cursor.Parent
	end
	return false
end

local function mantleBlocked(instance: Instance): boolean
	return hasAnyBooleanAttribute(instance, {"NoParkour", "NoClimb", "NoMantle"})
end

local function wallHopBlocked(instance: Instance): boolean
	return hasAnyBooleanAttribute(instance, {"NoParkour", "NoClimb", "NoWallHop"})
end

local function isJumpHeld(): boolean
	return jumpKeyHeld or c.now &lt; jumpPulseExpiresAt
end

local function canUseMovement(): boolean
	local currentCharacter = character
	local currentHumanoid = humanoid
	local currentRoot = rootPart
	return (a.state=="Neutral" or a.state=="Recovery") and not a.reaction and not a.wall
		and currentCharacter ~= nil
		and currentCharacter.Parent ~= nil
		and currentHumanoid ~= nil
		and currentHumanoid.Parent ~= nil
		and currentHumanoid.Health &gt; 0
		and not currentHumanoid.Sit
		and currentRoot ~= nil
		and currentRoot.Parent ~= nil
end

local function clearanceIsOpen(
	targetPosition: Vector3,
	characterHeight: number,
	wallPart: BasePart,
	topPart: BasePart
): boolean
	local params = overlapParams
	if not params then
		return false
	end

	local clearanceSize = Vector3.new(2.35, characterHeight, 1.85)
	local clearanceCenter = targetPosition + Vector3.new(0, characterHeight * 0.5 + 0.14, 0)
	local parts = workspace:GetPartBoundsInBox(CFrame.new(clearanceCenter), clearanceSize, params)
	for _, part in parts do
		if part.CanCollide and part ~= wallPart and part ~= topPart then
			return false
		end
	end
	return true
end

local function findMantleCandidate(): (CFrame?, number?, BasePart?)
	local currentHumanoid = humanoid
	local currentRoot = rootPart
	local params = rayParams
	if not currentHumanoid or not currentRoot or not params then
		return nil, nil, nil
	end

	local moveDirection = horizontal(a.move)
	if moveDirection.Magnitude &lt; 0.12 then
		return nil, nil, nil
	end
	moveDirection = moveDirection.Unit

	local rootOffset = standingRootOffset(currentHumanoid, currentRoot)
	local feetY = currentRoot.Position.Y - rootOffset
	local groundHit = workspace:Raycast(
		currentRoot.Position + Vector3.new(0, 0.1, 0),
		Vector3.new(0, -(rootOffset + 1.25), 0),
		params
	)
	if groundHit and groundHit.Normal.Y &gt; 0.55 then
		feetY = groundHit.Position.Y
	end
	local wallOrigin = Vector3.new(currentRoot.Position.X, feetY + 0.58, currentRoot.Position.Z)
	local wallHit = workspace:Raycast(wallOrigin, moveDirection * MANTLE_REACH, params)
	if not wallHit or not wallHit.Instance:IsA("BasePart") then
		return nil, nil, nil
	end

	local wallPart = wallHit.Instance
	if not wallPart.Anchored or not wallPart.CanCollide or math.abs(wallHit.Normal.Y) &gt; 0.4 then
		return nil, nil, nil
	end
	if mantleBlocked(wallPart) then
		return nil, nil, nil
	end

	local outwardNormal = safeUnit(horizontal(wallHit.Normal), -moveDirection)
	if moveDirection:Dot(-outwardNormal) &lt; 0.45 then
		return nil, nil, nil
	end

	local insidePoint = wallHit.Position - outwardNormal * 1.2
	local topOrigin = Vector3.new(insidePoint.X, feetY + MAX_LEDGE_HEIGHT + 1.4, insidePoint.Z)
	local topHit = workspace:Raycast(topOrigin, Vector3.new(0, -(MAX_LEDGE_HEIGHT + 2.2), 0), params)
	if not topHit or not topHit.Instance:IsA("BasePart") then
		return nil, nil, nil
	end

	local topPart = topHit.Instance
	if not topPart.Anchored or not topPart.CanCollide or topHit.Normal.Y &lt; 0.72 then
		return nil, nil, nil
	end
	if mantleBlocked(topPart) then
		return nil, nil, nil
	end

	local ledgeHeight = topHit.Position.Y - feetY
	if ledgeHeight &lt; MIN_LEDGE_HEIGHT or ledgeHeight &gt; MAX_LEDGE_HEIGHT then
		return nil, nil, nil
	end

	local characterHeight = math.clamp(rootOffset + 2.3, 4.4, 6.7)
	local landingSurfacePosition = topHit.Position - outwardNormal * 0.32
	if not clearanceIsOpen(landingSurfacePosition, characterHeight, wallPart, topPart) then
		return nil, nil, nil
	end

	local targetRootY = topHit.Position.Y + rootOffset + 0.12
	local targetPosition = Vector3.new(landingSurfacePosition.X, targetRootY, landingSurfacePosition.Z)
	local facing = -outwardNormal
	local targetCFrame = CFrame.lookAt(targetPosition, targetPosition + facing)
	return targetCFrame, ledgeHeight, topPart
end

local function restoreMantleOwnership()
	local currentHumanoid = humanoid
	if currentHumanoid and currentHumanoid.Parent then
		if savedWalkSpeed ~= nil then
			currentHumanoid.WalkSpeed = savedWalkSpeed
		end
		if savedAutoRotate ~= nil then
			currentHumanoid.AutoRotate = savedAutoRotate
		end
	end
	savedWalkSpeed = nil
	savedAutoRotate = nil
end

local function finishMantle(reason: string, cancelled: boolean)
	if not traversing then
		return
	end

	local currentHumanoid = humanoid
	local currentRoot = rootPart
	traversing = false
	lastMantleAt = c.now
	setCharacterAttribute("MovementTraversalActive", false)
	setCharacterAttribute("MovementTraversalType", "")
	setCharacterAttribute("MovementTraversalState", if cancelled then "Cancelled" else "Completed")
	setCharacterAttribute("MovementTraversalEndReason", reason)
	restoreMantleOwnership()
 if cancelled and currentHumanoid and currentRoot and currentHumanoid.Health&gt;0 then
  currentHumanoid:ChangeState(if a.grounded then Enum.HumanoidStateType.Running else Enum.HumanoidStateType.Freefall)
 end

	if not cancelled and currentHumanoid and currentRoot and currentHumanoid.Health &gt; 0 then
		currentRoot.CFrame = mantleTargetCFrame
		currentRoot.AssemblyLinearVelocity = horizontal(mantleTargetCFrame.LookVector) * 8 + Vector3.new(0, -1.5, 0)
		currentHumanoid:ChangeState(Enum.HumanoidStateType.Running)
	end
end

local function startMantle(targetCFrame: CFrame, ledgeHeight: number, topPart: BasePart)
	local currentCharacter = character
	local currentHumanoid = humanoid
	local currentRoot = rootPart
	if traversing or not currentCharacter or not currentHumanoid or not currentRoot then
		return
	end
	if currentCharacter:GetAttribute("MovementSliding") == true then
		return
	end

	traversing = true
	mantleStartCFrame = currentRoot.CFrame
	mantleTargetCFrame = targetCFrame
	mantleStartedAt = c.now
	mantleHeight = ledgeHeight
	mantleDuration = math.clamp(0.22 + ledgeHeight * 0.022, 0.24, 0.36)
	savedWalkSpeed = currentHumanoid.WalkSpeed
	savedAutoRotate = currentHumanoid.AutoRotate
	currentHumanoid.WalkSpeed = 0
	currentHumanoid.AutoRotate = false
	currentHumanoid:ChangeState(Enum.HumanoidStateType.Physics)
	currentRoot.AssemblyLinearVelocity = Vector3.zero

	setCharacterAttribute("MovementTraversalActive", true)
	setCharacterAttribute("MovementTraversalType", "Mantle")
	setCharacterAttribute("MovementTraversalState", "Active")
	setCharacterAttribute("MovementTraversalEndReason", "")
	setCharacterAttribute("MovementMantleHeight", ledgeHeight)
	setCharacterAttribute("MovementMantleDuration", mantleDuration)
	setCharacterAttribute("MovementMantleStartedAt", c.now)
	setCharacterAttribute("MovementMantleSurface", topPart:GetFullName())
end

local function attemptMantle()
	if traversing or not canUseMovement() then
		return
	end
	local currentCharacter = character
	local currentHumanoid = humanoid
	if not currentCharacter or not currentHumanoid then
		return
	end
	if currentCharacter:GetAttribute("MovementSliding") == true
		or currentCharacter:GetAttribute("MovementTraversalActive") == true then
		return
	end
	local slideJumpAt = currentCharacter:GetAttribute("MovementSlideJumpAt")
	if typeof(slideJumpAt) == "number" and c.now - slideJumpAt &lt; 0.32 then
		return
	end
	local state = currentHumanoid:GetState()
	if state == Enum.HumanoidStateType.Seated or state == Enum.HumanoidStateType.Swimming
		or state == Enum.HumanoidStateType.Climbing or state == Enum.HumanoidStateType.Dead then
		return
	end
	if c.now - lastMantleAt &lt; MANTLE_COOLDOWN then
		return
	end

	local targetCFrame, ledgeHeight, topPart = findMantleCandidate()
	if targetCFrame and ledgeHeight and topPart then
		startMantle(targetCFrame, ledgeHeight, topPart)
	end
end

local function updateMantle(now: number)
	if not traversing then
		return
	end
	local currentHumanoid = humanoid
	local currentRoot = rootPart
	if not canUseMovement() or not currentHumanoid or not currentRoot or currentHumanoid.Health &lt;= 0 then
		finishMantle("CharacterUnavailable", true)
		return
	end

	local normalizedTime = math.clamp((now - mantleStartedAt) / mantleDuration, 0, 1)
	local smoothTime = normalizedTime * normalizedTime * (3 - 2 * normalizedTime)
	local startPosition = mantleStartCFrame.Position
	local targetPosition = mantleTargetCFrame.Position
	local controlPosition = startPosition:Lerp(targetPosition, 0.48)
		+ Vector3.new(0, math.max(0.8, mantleHeight * 0.24), 0)
	local inverse = 1 - smoothTime
	local position = startPosition * (inverse * inverse)
		+ controlPosition * (2 * inverse * smoothTime)
		+ targetPosition * (smoothTime * smoothTime)

	local startFacing = safeUnit(horizontal(mantleStartCFrame.LookVector), horizontal(mantleTargetCFrame.LookVector))
	local targetFacing = safeUnit(horizontal(mantleTargetCFrame.LookVector), startFacing)
	local facing = safeUnit(startFacing:Lerp(targetFacing, smoothTime), targetFacing)
	currentHumanoid.WalkSpeed = 0
	currentHumanoid.AutoRotate = false
	currentRoot.AssemblyLinearVelocity = Vector3.zero
	position=c:clamp(position)
	currentRoot.CFrame = CFrame.lookAt(position, position + facing)

	if normalizedTime &gt;= 1 then
		finishMantle("Completed", false)
	end
end

local function appendUniqueDirection(directions: {Vector3}, candidate: Vector3)
	candidate = horizontal(candidate)
	if candidate.Magnitude &lt; 0.1 then
		return
	end
	candidate = candidate.Unit
	for _, direction in directions do
		if direction:Dot(candidate) &gt; 0.96 then
			return
		end
	end
	table.insert(directions, candidate)
end

local function findWallHopSurface(): RaycastResult?
	local currentHumanoid = humanoid
	local currentRoot = rootPart
	local params = rayParams
	if not currentHumanoid or not currentRoot or not params then
		return nil
	end

	local directions: {Vector3} = {}
	local look = horizontal(currentRoot.CFrame.LookVector)
	local right = horizontal(currentRoot.CFrame.RightVector)
	local velocity = horizontal(currentRoot.AssemblyLinearVelocity)
	appendUniqueDirection(directions, currentHumanoid.MoveDirection)
	appendUniqueDirection(directions, velocity)
	appendUniqueDirection(directions, look)
	appendUniqueDirection(directions, -look)
	appendUniqueDirection(directions, right)
	appendUniqueDirection(directions, -right)
	appendUniqueDirection(directions, -velocity)

	local bestHit: RaycastResult? = nil
	local bestDistance = math.huge
	local origin = currentRoot.Position + Vector3.new(0, 0.25, 0)
	for _, direction in directions do
		local hit = workspace:Raycast(origin, direction * WALL_HOP_REACH, params)
		if hit and hit.Instance:IsA("BasePart") then
			local part = hit.Instance
			local distance = (hit.Position - origin).Magnitude
			if part.Anchored and part.CanCollide and math.abs(hit.Normal.Y) &lt; 0.35
				and not wallHopBlocked(part) and distance &lt; bestDistance then
				bestHit = hit
				bestDistance = distance
			end
		end
	end
	return bestHit
end

local function attemptWallHop(forcedNormal: Vector3?)
	if traversing or wallHopCount &gt;= MAX_WALL_HOPS or not canUseMovement() then
		return
	end
	local currentCharacter = character
	local currentHumanoid = humanoid
	local currentRoot = rootPart
	if not currentCharacter or not currentHumanoid or not currentRoot then
		return
	end
	if currentCharacter:GetAttribute("MovementSliding") == true
		or currentCharacter:GetAttribute("MovementTraversalActive") == true then
		return
	end
	local now = c.now
	if (not forcedNormal and (currentHumanoid.FloorMaterial ~= Enum.Material.Air or now - lastGroundedAt &lt; 0.13))
		or now - lastWallHopAt &lt; WALL_HOP_COOLDOWN then
		return
	end

	local hit = findWallHopSurface()
	if not forcedNormal and (not hit or not hit.Instance:IsA("BasePart")) then
		return
	end

	local away = safeUnit(horizontal(forcedNormal or hit.Normal), -horizontal(currentRoot.CFrame.LookVector))
	local currentHorizontal = horizontal(currentRoot.AssemblyLinearVelocity)
	local tangentCarry = currentHorizontal - away * currentHorizontal:Dot(away)
	if tangentCarry.Magnitude &gt; 28 then
		tangentCarry = tangentCarry.Unit * 28
	end

	wallHopCount += 1
	lastWallHopAt = now
	currentHumanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	currentRoot.AssemblyLinearVelocity = away * WALL_HOP_AWAY_SPEED
		+ tangentCarry * 0.55
		+ Vector3.new(0, WALL_HOP_UP_SPEED, 0)
	setCharacterAttribute("MovementWallHopCount", wallHopCount)
	setCharacterAttribute("MovementLastWallHopAt", c.now)
	setCharacterAttribute("MovementLastWallHopSurface", if hit then hit.Instance:GetFullName() else "NinjaWall")
	a.airborne=true;a.airDodgeUsed=false;a.takeoffUntil=c.now+.18
	return true
end


 local api={}
 function api.jump()
  jumpPulseExpiresAt=c.now+.34
  attemptMantle()
  if traversing then return true end
  return attemptWallHop()==true
 end
 function api.rebound(normal) return attemptWallHop(normal)==true end
 function api.wallSurface() return findWallHopSurface() end
 function api.step()
  if a.grounded then lastGroundedAt=c.now;wallHopCount=0 end
  updateMantle(c.now)
  if not traversing and isJumpHeld() and c.now-lastMantleCheckAt&gt;=MANTLE_CHECK_INTERVAL then
   lastMantleCheckAt=c.now;attemptMantle()
  end
  if traversing then a.airborne=true;a.hum:Move(Vector3.zero);a.locomotion=Vector3.zero end
  return traversing
 end
 function api.reset() finishMantle('SessionReset',true);wallHopCount=0;jumpPulseExpiresAt=0 end
 return api
end
return Parkour
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND30">
        <Properties>
          <string name="Name">Techniques</string>
          <ProtectedString name="Source">-- Each entry supplies prerequisites and payoff. The combat pipeline owns cost,
-- channel, interruption, active window and recovery for every entry.
local Techniques = {}
local Elements=require(script.Parent.Elements)
Techniques.MarkedBlade = {
	check = function() return true end,
	execute = function(c, a, pending, now)
		c:projectile(a, pending.aim, 62, pending.spec.Range, pending.spec.Damage, "blade", function(position, normal)
			if a.health &lt;= 0 or c.match.phase ~= "Duel" then return end
			if a.anchor then a.anchor.part:Destroy() end
			local offset=if normal.Y&gt;0.5 then Vector3.new(0,3,0) else normal*3+Vector3.new(0,1,0)
			local at = c:clamp(position + offset)
			local p = c:effect("Anchor", position + normal*0.2, a.color, Vector3.new(1.3,0.2,1.3), 12)
			a.anchor = { position = at, expires = c.now + 12, part = p }
			c:cue(a,"ANCHOR PLACED")
		end)
	end,
}
Techniques.Flashstep = {
	check = function(c, a, _spec, now)
		return a.anchor ~= nil and a.anchor.expires &gt; now and (a.anchor.position-a.root.Position).Magnitude &lt;= 40
	end,
	execute = function(c,a,_pending,now)
		local anchor = a.anchor
		if not anchor or anchor.expires &lt;= now then c:cue(a,"ANCHOR EXPIRED"); return end
		local target = anchor.position
		-- Never relocate into solid geometry, and never accept a client destination.
		local overlaps = workspace:GetPartBoundsInBox(CFrame.new(target),Vector3.new(3,5,3),c:overlapParams())
		for _, p in overlaps do
			if p.CanCollide and not p:IsDescendantOf(a.model) then c:cue(a,"ARRIVAL BLOCKED"); return end
		end
		c:effect("Departure",a.root.Position,a.color,Vector3.new(2,5,2),0.3)
		c:relocate(a,target)
		c:effect("Arrival",target,a.color,Vector3.new(3,5,3),0.45)
		anchor.part:Destroy(); a.anchor = nil
		c:cue(a,"FLASHSTEP • RECOVERING")
	end,
}
Techniques.BurstStrike = {
	check = function() return true end,
	execute = function(c,a,pending)
		-- Channel commits chakra; release becomes a travelling physical attack.
		require(script.Parent.Brawler).start(c,a,"DashAttack")
		a.pending.spec=table.clone(a.pending.spec)
		a.pending.spec.damage=pending.spec.Damage;a.pending.spec.travel=10;a.pending.spec.recovery=.48
		a.travelRemaining=10

	end,
}
Techniques.Read = {
	check = function() return true end,
	execute = function(c,a,pending,now)
		a.readUntil = now + pending.spec.Active
		c:effect("Read",a.root.Position,a.color,Vector3.new(4,0.2,4),pending.spec.Active)
		c:cue(a,"READ WINDOW")
	end,
}
Techniques.NeedleFan = {
	check = function() return true end,
	execute = function(c,a,pending)
		local direction = pending.aim-a.root.Position
		if direction.Magnitude &lt; 0.1 then direction = a.root.CFrame.LookVector end
		for _, angle in { -0.13,0,0.13 } do
			local d = CFrame.fromAxisAngle(Vector3.yAxis,angle):VectorToWorldSpace(direction.Unit)
			c:projectile(a,a.root.Position+d*pending.spec.Range,54,pending.spec.Range,pending.spec.Damage,"needle")
		end
	end,
}
Techniques.MirageCast = {
	check = function(c,a,spec)
		return c:targetValid(a,a.target,spec.Range,0.35)
	end,
	execute = function(c,a,pending,now)
		if not c:targetValid(a,a.target,pending.spec.Range,0.35) then c:cue(a,"CAST LOST SIGHT"); return end
		local victim = a.target
		victim.illusionUntil = now+3
		victim.decoyPosition = c:clamp(a.root.Position + a.root.CFrame.RightVector*7)
		c:effect("Echo",victim.decoyPosition,a.color,Vector3.new(2,5,1),3)
		c:cue(victim,"MIRAGE • TRUST THE BODY",3)
		c:cue(a,"ECHO ACTIVE",3)
	end,
}
Techniques.Quickstep={
	check=function() return true end,
	execute=function(c,a)
		local direction=if a.move.Magnitude&gt;0.2 then a.move else a.root.CFrame.RightVector
		local moved=require(script.Parent.Motor).travel(a,c,direction,11)
		c:effect("Quickstep",a.root.Position,a.color,Vector3.new(2,3,2),0.22)
		c:cue(a,if moved&gt;3 then "ANGLE CREATED" else "ANGLE BLOCKED")
	end,
}
Techniques.FireBloom={check=function() return true end,execute=Elements.fire}
Techniques.WindCut={check=function() return true end,execute=Elements.wind}
return Techniques
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND31">
        <Properties>
          <string name="Name">Tutorial</string>
          <ProtectedString name="Source">-- Objectives observe the real engine; setups reset the practice pair, never fake success.
local Brawler=require(script.Parent.Brawler)
local Tutorial={}
Tutorial.Steps={
 {title="Move",pad="Left stick",key="W A S D",kind="Move"},
 {title="Sprint",pad="Click LS, then move",key="Hold CTRL + move",kind="Sprint"},
 {title="Jump and land",pad="A / Cross",key="SPACE",kind="Land"},
 {title="Unlock, then lock the target",pad="Click RS twice",key="SHIFT twice",kind="Lock"},
 {title="Directional dash",pad="Left stick + B / Circle",key="Direction + Q",event="Dodge"},
 {title="Run up the wall, then rebound",pad="Push LS into wall, then A",key="Move into wall, SPACE",kind="Wall"},
 {title="Land three light strikes",pad="X / Square three times",key="LMB three times",kind="Combo"},
 {title="Branch into a launcher",pad="X, X, then Y / Triangle",key="LMB, LMB, T",event="LaunchHit"},
 {title="Chase the launched target",pad="A / Cross after launch",key="E after launch",kind="Chase"},
 {title="Land two aerial strikes",pad="X / Square twice in air",key="LMB twice in air",kind="AirCombo"},
 {title="Finish downward",pad="Y / Triangle in air",key="T in air",event="SlamHit"},
 {title="Guard the incoming strike",pad="Hold LB / L1",key="Hold F",event="GuardHit"},
 {title="Dodge the incoming strike",pad="B / Circle during windup",key="Q during windup",kind="Evade"},
 {title="Escape after being hit",pad="B / Circle just after contact",key="X just after contact",event="Substitute"},
 {title="Grab, then throw",pad="LT / L2, then X (Y throws upward)",key="V, then LMB (T upward)",event="ThrowHit"},
 {title="Perform a character technique",pad="Hold RB / R1 + A",key="1",kind="Technique"},
 {title="Interrupt the telegraphed technique",pad="X / Square during hand signs",key="LMB during hand signs",kind="Interrupt"},
 {title="Win the practice duel",pad="Use your complete kit",key="Use your complete kit",kind="Win"},
}
function Tutorial.new(s)
 local t={index=1,entered=0,baseline={},travel=0,seenAir=false,seenWall=false,unlocked=false,attackAt=0};s.tutorial=t;return t
end
function Tutorial.enter(s,now)
 local t,a,b=s.tutorial,s.human,s.bot;t.entered=now;t.completedAt=nil;t.baseline=table.clone(a.events or {});t.travel=0;t.seenAir=false;t.seenWall=false;t.unlocked=false;t.health=a.health;t.lastPosition=a.root.Position
 local c=s.combat;c:clear(true)
 for _,actor in {a,b} do actor.health=actor.def.Health;actor.hum.Health=actor.health;actor.state="Neutral";actor.chakra=actor.def.Chakra;actor.subCharges=2;actor.subCooldown=0;actor.cooldowns={};actor.invulnerableUntil=0 end
 t.health=a.health
 b.trainingChannelScale=if t.index==17 and b.fighterId=="Flashstep" then 3 else 1
 local near=t.index&gt;=7 and t.index~=16
 c:relocate(a,s.origin+Vector3.new(0,3,if near then 3 else 14));c:relocate(b,s.origin+Vector3.new(0,3,if near then -2 else -14))
 if t.index==6 then c:relocate(a,s.origin+Vector3.new(24,3,0));c:relocate(b,s.origin+Vector3.new(16,3,0)) end
 a.root.CFrame=CFrame.lookAt(a.root.Position,b.root.Position);b.root.CFrame=CFrame.lookAt(b.root.Position,a.root.Position)
 if t.index==9 then Brawler.react(c,b,"Launched",Vector3.new(0,48,0),1.2);a.pursuitUntil=now+1.2 end
 if t.index==10 or t.index==11 then
  c:relocate(a,s.origin+Vector3.new(0,16,3));c:relocate(b,s.origin+Vector3.new(0,16,-2));a.airborne=true;a.airHold=now+1.8
  Brawler.react(c,b,"Juggled",Vector3.zero,1.8)
 end
 t.attackAt=now+1
end
function Tutorial.update(s,now,dt)
 local t,a,b=s.tutorial,s.human,s.bot;local c=s.combat
 if t.entered==0 then Tutorial.enter(s,now) end
 local spec=Tutorial.Steps[t.index]
 b.move=Vector3.zero;b.sprinting=false
 if t.index==18 then s.ai:update(now);return end
 local displacement=(a.root.Position-(t.lastPosition or a.root.Position)).Magnitude;t.travel+=math.min(displacement,4);t.lastPosition=a.root.Position
 local function event(name) return (a.events and a.events[name] or 0)&gt;(t.baseline[name] or 0) end
 local done=spec.event and event(spec.event)
 if spec.kind=="Move" then done=t.travel&gt;12
 elseif spec.kind=="Sprint" then done=a.sprinting and a.locomotion.Magnitude&gt;30
 elseif spec.kind=="Land" then t.seenAir=t.seenAir or a.airborne;done=t.seenAir and not a.airborne
 elseif spec.kind=="Lock" then t.unlocked=t.unlocked or not a.locked;done=(t.unlocked or event("Unlock")) and a.locked and event("Lock")
 elseif spec.kind=="Wall" then t.seenWall=t.seenWall or a.wall~=nil;done=t.seenWall and (a.wallJumpUntil or 0)&gt;now
 elseif spec.kind=="Combo" then done=(a.events and a.events.Hit or 0)-(t.baseline.Hit or 0)&gt;=3
 elseif spec.kind=="Chase" then done=event("Chase") and a.state=="Neutral" and a.airborne and (a.root.Position-b.root.Position).Magnitude&lt;7
 elseif spec.kind=="AirCombo" then done=(a.events and a.events.AirHit or 0)-(t.baseline.AirHit or 0)&gt;=2
 elseif spec.kind=="Technique" then done=event("Technique") and a.state=="TechniqueRecovery"
 elseif spec.kind=="Evade" then done=event("Dodge") and (event("Evaded") or (b.attackName=="Heavy" and now-(b.attackStarted or now)&gt;.46 and a.health==t.health))
 elseif spec.kind=="Interrupt" then done=event("Interrupt") end
 if done and not t.completedAt then t.completedAt=now end
 if t.completedAt and now-t.completedAt&gt;=.22 then t.index+=1;Tutorial.enter(s,now);return end
 if (t.index==12 or t.index==13 or t.index==14) and now&gt;=t.attackAt then
  if (b.root.Position-a.root.Position).Magnitude&gt;7 then c:relocate(b,a.root.Position+a.root.CFrame.LookVector*5) end
  b.root.CFrame=CFrame.lookAt(b.root.Position,a.root.Position);c:request(b,"Heavy");t.attackAt=now+1.7
 end
 if t.index==17 and now&gt;=t.attackAt then
  b.cooldowns={};b.chakra=b.def.Chakra;c:request(b,if b.fighterId=="Mirage" then "Technique4" else "Technique1",a.root.Position);t.attackAt=now+1.4
 end
 -- Failed launch/juggle exercises reset quickly without skipping their objectives.
 if (t.index==9 or t.index==10 or t.index==11) and now-t.entered&gt;3 then Tutorial.enter(s,now) end
 if a.health&lt;a.def.Health*.3 then a.health=a.def.Health;a.hum.Health=a.health end
 if b.health&lt;b.def.Health*.25 then b.health=b.def.Health;b.hum.Health=b.health end
end
function Tutorial.snapshot(s)
 local t=s.tutorial;if not t then return nil end
 local step=Tutorial.Steps[t.index]
 return {index=t.index,total=#Tutorial.Steps,title=step.title,pad=step.pad,key=step.key}
end
return Tutorial
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND32">
        <Properties>
          <string name="Name">World</string>
          <ProtectedString name="Source">local World = {}
local Animation=require(script.Parent.Animation)
local function part(parent, name, size, cf, color, material)
	local p = Instance.new("Part")
	p.Name, p.Size, p.CFrame = name, size, cf
	p.Color, p.Material = color, material or Enum.Material.SmoothPlastic
	p.Anchored, p.TopSurface, p.BottomSurface = true, Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end
World.part = part
function World.arena(parent, origin)
	local folder = Instance.new("Folder"); folder.Name = "Courtyard"; folder.Parent = parent
	local stone, dark = Color3.fromRGB(151, 145, 122), Color3.fromRGB(56, 65, 57)
	part(folder, "Training floor", Vector3.new(160, 2, 160), CFrame.new(origin - Vector3.new(0, 1, 0)), stone, Enum.Material.Slate)
	for _, x in { -1, 1 } do
		part(folder, "Boundary", Vector3.new(2, 25, 162), CFrame.new(origin + Vector3.new(x*81, 11.5, 0)), dark, Enum.Material.Concrete)
		part(folder, "Boundary", Vector3.new(162, 25, 2), CFrame.new(origin + Vector3.new(0, 11.5, x*81)), dark, Enum.Material.Concrete)
		local wall=part(folder,"Ninja wall",Vector3.new(3,23,26),CFrame.new(origin+Vector3.new(x*28,11.5,0)),dark,Enum.Material.Slate)
		wall:SetAttribute("NinjaWall",true)
		local ledge=part(folder,"Wall ledge",Vector3.new(10,1,29),CFrame.new(origin+Vector3.new(x*28,23,0)),stone,Enum.Material.Concrete)
		ledge.CanQuery=true
		for _, z in { -1, 1 } do
			local at = origin + Vector3.new(x*58, 0, z*58)
			part(folder, "Pillar", Vector3.new(3, 14, 3), CFrame.new(at + Vector3.new(0, 7, 0)), dark)
			part(folder, "Lantern", Vector3.new(4, 1, 4), CFrame.new(at + Vector3.new(0, 12, 0)), Color3.fromRGB(233, 198, 130), Enum.Material.Neon)
		end
	end
	for _, z in { -40, 40 } do
		part(folder, "Cover", Vector3.new(8, 4, 3), CFrame.new(origin + Vector3.new(18, 2, z)), dark, Enum.Material.Slate)
		part(folder,"Step platform",Vector3.new(14,1.2,14),CFrame.new(origin+Vector3.new(-17,7,z)),stone,Enum.Material.Concrete)
	end
	for i = -3, 3 do
		local stripe = part(folder, "Inlay", Vector3.new(0.09, 0.02, 146), CFrame.new(origin + Vector3.new(i*12, 0.02, 0)), Color3.fromRGB(147, 161, 156))
		stripe.CanCollide = false; stripe.CanQuery = false
	end
	for _,side in {-1,1} do
		part(folder,"Training beam",Vector3.new(1.2,1.2,28),CFrame.new(origin+Vector3.new(side*28,20,0)),Color3.fromRGB(109,73,46),Enum.Material.Wood)
	end
	local ring = part(folder, "Duel circle", Vector3.new(0.03, 24, 24), CFrame.new(origin + Vector3.new(0, 0.04, 0))*CFrame.Angles(0,0,math.pi/2), Color3.fromRGB(157,175,165))
	ring.Shape = Enum.PartType.Cylinder; ring.CanCollide = false; ring.CanQuery = false
	return folder
end
function World.rig(parent, def, cf, name)
	local model = Instance.new("Model"); model.Name=name; model.Parent=parent
	local skin=Color3.fromRGB(table.unpack(def.Skin))
	local outfit=Color3.fromRGB(table.unpack(def.Outfit))
	local pants=Color3.fromRGB(35,43,54)
	local color=Color3.fromRGB(table.unpack(def.Color))
	local root=part(model,"HumanoidRootPart",Vector3.new(2,2,1),cf,outfit)
	root.Transparency=1
	local function body(name,size,offset,tint)
		return part(model,name,size,cf*CFrame.new(offset),tint)
	end
	local lower=body("LowerTorso",Vector3.new(2,1,1),Vector3.new(0,0,0),outfit)
	local upper=body("UpperTorso",Vector3.new(2,1.4,1),Vector3.new(0,1.15,0),outfit)
	local head=body("Head",Vector3.new(1.5,1.5,1.5),Vector3.new(0,2.45,0),skin)
	local hum=Instance.new("Humanoid")
	hum.RigType=Enum.HumanoidRigType.R15; hum.RequiresNeck=true; hum.BreakJointsOnDeath=false
	hum.MaxHealth=def.Health; hum.Health=def.Health; hum.WalkSpeed=def.Speed
	hum.UseJumpPower=true; hum.JumpPower=68; hum.HipHeight=2
	hum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None; hum.Parent=model
	Instance.new("Animator",hum)
	local joints={}
	local function joint(name,p0,p1,c0,c1)
		local m=Instance.new("Motor6D");m.Name=name;m.Part0=p0;m.Part1=p1;m.C0=CFrame.new(c0);m.C1=CFrame.new(c1);m.Parent=p0
		joints[name]=m;return m
	end
	joint("Root",root,lower,Vector3.zero,Vector3.zero)
	joint("Waist",lower,upper,Vector3.new(0,0.65,0),Vector3.new(0,-0.5,0))
	joint("Neck",upper,head,Vector3.new(0,0.9,0),Vector3.new(0,-0.55,0))
	for _,side in {-1,1} do
		local prefix=if side==-1 then "Left" else "Right"
		local armTop=body(prefix.."UpperArm",Vector3.new(0.8,1.1,0.8),Vector3.new(side*1.45,0.72,0),outfit)
		local armLow=body(prefix.."LowerArm",Vector3.new(0.76,0.95,0.76),Vector3.new(side*1.45,-0.28,0),outfit)
		local hand=body(prefix.."Hand",Vector3.new(0.72,0.5,0.72),Vector3.new(side*1.45,-1.0,0),skin)
		local legTop=body(prefix.."UpperLeg",Vector3.new(0.85,1.1,0.85),Vector3.new(side*0.5,-0.85,0),pants)
		local legLow=body(prefix.."LowerLeg",Vector3.new(0.8,1.05,0.8),Vector3.new(side*0.5,-1.75,0),pants)
		local foot=body(prefix.."Foot",Vector3.new(0.8,0.42,1.15),Vector3.new(side*0.5,-2.55,-0.15),pants)
		joint(prefix.."Shoulder",upper,armTop,Vector3.new(side*1.05,0.45,0),Vector3.new(-side*0.4,0.5,0))
		joint(prefix.."Elbow",armTop,armLow,Vector3.new(0,-0.55,0),Vector3.new(0,0.45,0))
		joint(prefix.."Wrist",armLow,hand,Vector3.new(0,-0.48,0),Vector3.new(0,0.25,0))
		joint(prefix.."Hip",lower,legTop,Vector3.new(side*0.5,-0.55,0),Vector3.new(0,0.5,0))
		joint(prefix.."Knee",legTop,legLow,Vector3.new(0,-0.55,0),Vector3.new(0,0.5,0))
		joint(prefix.."Ankle",legLow,foot,Vector3.new(0,-0.5,0),Vector3.new(0,0.2,0.15))
	end
	local hair=body("Hair",Vector3.new(1.65,0.55,1.65),Vector3.new(0,3,0),Color3.fromRGB(table.unpack(def.Hair)))
	joint("HairJoint",head,hair,Vector3.new(0,0.57,0),Vector3.new(0,-0.25,0))
	local sash=body("Sash",Vector3.new(2.1,0.25,1.1),Vector3.new(0,-0.4,0),color)
	joint("SashJoint",lower,sash,Vector3.new(0,-0.4,0),Vector3.zero)
	local eyes=body("Eyes",Vector3.new(0.85,0.1,0.05),Vector3.new(0,2.6,-0.76),Color3.fromRGB(24,31,38))
	joint("EyeJoint",head,eyes,Vector3.new(0,0.15,-0.76),Vector3.zero)
	for _,piece in model:GetChildren() do
		if piece:IsA("BasePart") then
			piece.Anchored=false
			piece.CanCollide=piece==root
			piece.CanQuery=piece==root or piece==lower or piece==upper or piece==head
			piece.Massless=piece~=root
		end
	end
	model.PrimaryPart=root; root:SetNetworkOwner(nil)
	return model,hum,root,joints
end
-- Imported combat clips and Roblox catalogue movement tracks play on the server.
function World.pose(a,now,dt)
 Animation.step(a,now)
end
return World
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="ND33">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMinZoomDistance">8</float>
      <float name="CameraMaxZoomDistance">32</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="ND34">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="ND35">
        <Properties>
          <string name="Name">NinjaDuelClient</string>
        </Properties>
        <Item class="ModuleScript" referent="ND36">
          <Properties>
            <string name="Name">Camera</string>
            <ProtectedString name="Source">local Camera={}; Camera.__index=Camera
function Camera.new()
	local self=setmetatable({locked=true,look=Vector2.zero,yaw=0,pitch=.28,lastEpoch=-1,lastHealth=nil,lastEnemyHealth=nil,shakeUntil=0,shakeSize=0,rng=Random.new()},Camera)
 local UIS=game:GetService("UserInputService")
 UIS.InputChanged:Connect(function(input)
  if input.UserInputType==Enum.UserInputType.MouseMovement and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
   self.yaw+=input.Delta.X*.004;self.pitch=math.clamp(self.pitch-input.Delta.Y*.003,.08,.9)
  end
 end)
 return self
end
function Camera:update(data,dt)
	local camera=workspace.CurrentCamera
	if not data or data.phase=="Selection" then
		self.lastHealth=nil; self.lastEnemyHealth=nil; camera.FieldOfView=70
		camera.CameraType=Enum.CameraType.Scriptable
		camera.CFrame=CFrame.lookAt(Vector3.new(42,38,45),Vector3.new(0,0,0)); return
	end
	local character=game:GetService("Players").LocalPlayer.Character
	local root=character and character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	camera.CameraType=Enum.CameraType.Scriptable
	if self.lastEpoch~=data.epoch then self.lastHealth=data.human.health; self.lastEnemyHealth=data.bot.health;self.yaw=0;self.pitch=.28 end
	if self.lastHealth and data.human.health&lt;self.lastHealth then
		local damage=self.lastHealth-data.human.health
		self.shakeSize=if damage&gt;=12 then 0.37 else 0.18
		self.shakeUntil=os.clock()+0.13
	end
	if self.lastEnemyHealth and data.bot.health&lt;self.lastEnemyHealth then
		local damage=self.lastEnemyHealth-data.bot.health
		self.shakeSize=if damage&gt;=12 then 0.28 else 0.1
		self.shakeUntil=os.clock()+0.1
	end
	self.lastHealth=data.human.health
	self.lastEnemyHealth=data.bot.health
	local targetFov=70+math.clamp((data.human.speed or 0)*0.18,0,8)+(if data.human.wall then 3 else 0)
	camera.FieldOfView+=(targetFov-camera.FieldOfView)*(1-math.exp(-dt*7))
	local a=root.Position
	local folder=root.Parent.Parent
	local bot=folder and folder:FindFirstChild("AIFighter")
	local b=bot and bot:FindFirstChild("HumanoidRootPart")
	local target=if b then b.Position else data.bot.position
	local flat=Vector3.new(target.X-a.X,0,target.Z-a.Z)
	if flat.Magnitude&lt;0.01 then flat=-Vector3.zAxis end
	local distance=(target-a).Magnitude
	local focus=a:Lerp(target,0.5)+Vector3.new(0,1.5,0)
	self.yaw+=(self.look.X or 0)*dt*2.2;self.pitch=math.clamp(self.pitch-(self.look.Y or 0)*dt,0.08,.9)
	local behind=if self.locked then (CFrame.Angles(0,self.yaw,0):VectorToWorldSpace(-flat.Unit)) else Vector3.new(math.sin(self.yaw),0,math.cos(self.yaw))
	if not self.locked then focus=a+Vector3.new(0,1.5,0) end
	local desired=a+behind*math.clamp(17+distance*0.32,18,31)+Vector3.new(0,7+self.pitch*15+math.abs(target.Y-a.Y)*.32,0)
	local ray=RaycastParams.new(); ray.FilterType=Enum.RaycastFilterType.Exclude
	local exclude={character};if bot then table.insert(exclude,bot) end
	local effects=folder and folder:FindFirstChild("Effects");if effects then table.insert(exclude,effects) end
	ray.FilterDescendantsInstances=exclude
	local hit=workspace:Raycast(focus,desired-focus,ray)
	if hit then desired=hit.Position+hit.Normal*0.7 end
	local cf=CFrame.lookAt(desired,focus)
	if os.clock()&lt;self.shakeUntil then
		cf*=CFrame.new(self.rng:NextNumber(-1,1)*self.shakeSize,self.rng:NextNumber(-1,1)*self.shakeSize,0)
	end
	if self.lastEpoch~=data.epoch then camera.CFrame=cf; self.lastEpoch=data.epoch
	else camera.CFrame=camera.CFrame:Lerp(cf,1-math.exp(-dt*10)) end
end
return Camera
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND37">
          <Properties>
            <string name="Name">Input</string>
            <ProtectedString name="Source">local CAS=game:GetService("ContextActionService")
local UIS=game:GetService("UserInputService")
local Controls=require(game:GetService("ReplicatedStorage").NinjaDuel.Controls)
local Input={};Input.__index=Input
function Input.new(send,getState,toggleLock,camera)
 local self=setmetatable({send=send,getState=getState,keys={},stick=Vector2.zero,look=Vector2.zero,sprinting=false,modifier=false,camera=camera},Input)
 local function bind(name,keys,callback)
  CAS:BindActionAtPriority("Ninja"..name,function(_,state,object)
   if UIS:GetFocusedTextBox() then return Enum.ContextActionResult.Pass end
   if getState().phase~="Duel" then return Enum.ContextActionResult.Pass end
   callback(state,object)
   return Enum.ContextActionResult.Sink
  end,false,3000,table.unpack(keys))
 end
 local function begin(state) return state==Enum.UserInputState.Begin end
 for _,key in {Enum.KeyCode.W,Enum.KeyCode.A,Enum.KeyCode.S,Enum.KeyCode.D} do
  bind(key.Name,{key},function(state) self.keys[key.Name]=begin(state) end)
 end
 bind("MoveStick",{Enum.KeyCode.Thumbstick1},function(state,obj)
  self.stick=if state==Enum.UserInputState.End or state==Enum.UserInputState.Cancel then Vector2.zero else Vector2.new(obj.Position.X,obj.Position.Y)
 end)
 bind("LookStick",{Enum.KeyCode.Thumbstick2},function(state,obj)
  self.look=if state==Enum.UserInputState.End or state==Enum.UserInputState.Cancel then Vector2.zero else Vector2.new(obj.Position.X,obj.Position.Y)
  camera.look=self.look
 end)
 bind("Modifier",Controls.Modifier,function(state) self.modifier=begin(state) end)
 local function face(state,normal,slot)
  if begin(state) then send(if self.modifier then "Technique"..slot else normal) end
 end
 bind("Light",Controls.Light,function(state) face(state,"Attack",2) end)
 bind("Heavy",Controls.Heavy,function(state) face(state,"Heavy",3) end)
 bind("Dodge",Controls.Dodge,function(state) face(state,"Dodge",4) end)
 bind("Jump",Controls.Jump,function(state)
  if begin(state) then
   local h=getState().human
   face(state,if h and h.pursuit&gt;0 then "Pursuit" else "Jump",1)
  elseif state==Enum.UserInputState.End then send("JumpOff") end
 end)
 bind("Guard",Controls.Guard,function(state) send(if begin(state) then "Guard" else "GuardOff") end)
 bind("Tool",Controls.Tool,function(state) if begin(state) then send("Tool") end end)
 bind("Grab",Controls.Grab,function(state) if begin(state) then send("Grab") end end)
 bind("Lock",Controls.Lock,function(state) if begin(state) then toggleLock() end end)
 bind("Sprint",Controls.Sprint,function(state,obj)
  if obj.KeyCode==Enum.KeyCode.ButtonL3 then if begin(state) then self.sprinting=not self.sprinting end
  else self.sprinting=begin(state) end
 end)
 bind("Technique5",Controls.Technique5,function(state) if begin(state) then send("Technique5") end end)
 bind("Skip",Controls.Skip,function(state) if begin(state) and getState().tutorial then send("TutorialSkip") end end)
 for i,key in {Enum.KeyCode.One,Enum.KeyCode.Two,Enum.KeyCode.Three,Enum.KeyCode.Four} do
  bind("Technique"..i,{key},function(state) if begin(state) then send("Technique"..i) end end)
 end
 for name,key in {Substitute=Enum.KeyCode.X,WallDetach=Enum.KeyCode.C,Feint=Enum.KeyCode.G,Pursuit=Enum.KeyCode.E} do
  bind(name,{key},function(state) if begin(state) then send(name) end end)
 end
 UIS.WindowFocusReleased:Connect(function() self:reset();send("GuardOff");send("Move",Vector3.zero) end)
 return self
end
function Input:reset()
 table.clear(self.keys);self.stick=Vector2.zero;self.look=Vector2.zero;self.modifier=false;self.sprinting=false;self.camera.look=Vector2.zero
end
function Input:direction(camera)
 local stick=if self.stick.Magnitude&gt;.15 then self.stick else Vector2.zero
 local x=stick.X+(if self.keys.D then 1 else 0)-(if self.keys.A then 1 else 0)
 local z=stick.Y+(if self.keys.W then 1 else 0)-(if self.keys.S then 1 else 0)
 local look=camera.CFrame.LookVector*Vector3.new(1,0,1)
 if look.Magnitude&lt;.01 then look=-Vector3.zAxis end
 local right=Vector3.new(-look.Unit.Z,0,look.Unit.X)
 local v=right*x+look.Unit*z
 return if v.Magnitude&gt;1 then v.Unit else v
end
return Input
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="ND38">
          <Properties>
            <string name="Name">Main</string>
            <ProtectedString name="Source">local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local player=Players.LocalPlayer
local shared=game:GetService("ReplicatedStorage"):WaitForChild("NinjaDuel")
local remote=shared:WaitForChild("Action")
pcall(function() game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Health,false); game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Chat,false); game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList,false) end)
local UI=require(script.Parent.UI)
local Input=require(script.Parent.Input)
local Camera=require(script.Parent.Camera)
local Presentation=require(script.Parent.Presentation)
local presentation=Presentation.new()
local camera=Camera.new(); local current={phase="Selection",epoch=0}; local ui; local input
local mouse=player:GetMouse()
local function send(action,extra)
	local payload={action=action,epoch=current.epoch}
	if action=="Move" then payload.direction=extra; payload.locked=camera.locked; payload.sprint=input and input.sprinting or false
	elseif type(extra)=="table" then for k,v in extra do payload[k]=v end
	elseif action=="Tool" or string.match(action,"^Technique") then
		local gamepad=game:GetService("UserInputService"):GetLastInputType().Name:match("Gamepad")~=nil
		local hit=if gamepad and current.bot then current.bot.position else mouse.Hit.Position
		if gamepad and action=="Technique1" and current.human and current.human.fighterId=="Flashstep" then hit-=Vector3.new(0,2.8,0) end
		local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and (hit-root.Position).Magnitude&lt;=140 then payload.aim=hit end
	end
	remote:FireServer(payload)
end
ui=UI.new(player:WaitForChild("PlayerGui"),send)
input=Input.new(send,function() return current end,function() camera.locked=not camera.locked;send("Move",input:direction(workspace.CurrentCamera)) end,camera)
-- Disable the default movement controller; server receives finite normalized intent.
local playerModule=player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")
require(playerModule):GetControls():Disable()
remote.OnClientEvent:Connect(function(data)
	if data.epoch&lt;(current.epoch or 0) then return end
	if data.epoch~=current.epoch or data.phase~=current.phase then input:reset() end
	if data.epoch~=current.epoch then camera.locked=true end
	current=data; presentation.receivedAt=os.clock(); ui:render(data)
end)
local nextMove=0
RunService.RenderStepped:Connect(function(dt)
	camera:update(current,dt)
	presentation:update(current,dt)
	if current.phase=="Duel" and os.clock()&gt;=nextMove then
		nextMove=os.clock()+0.08; send("Move",input:direction(workspace.CurrentCamera))
	end
end)
send("Ready")
print("[NinjaDuel] Client ready")
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND39">
          <Properties>
            <string name="Name">Presentation</string>
            <ProtectedString name="Source">-- Combat animation/feedback comes from the imported Bangla server components.
-- This client module retains only Ninja Duel's Itachi deception visual.
local Presentation={};Presentation.__index=Presentation
function Presentation.new() return setmetatable({ghosts={}},Presentation) end
function Presentation:illusion(data,model)
 local active=data.phase=="Duel" and data.human.illusion&gt;0 and data.human.decoy
 local opponent=model and model.Parent and model.Parent:FindFirstChild("AIFighter")
 active=active and opponent~=nil
 if active and opponent and not self.echo then
  local ghost=opponent:Clone();ghost.Name="LocalAfterimage"
  for _,v in ghost:GetDescendants() do
   if v:IsA("BasePart") then v.Anchored=true;v.CanCollide=false;v.CanQuery=false;v.Transparency=math.max(v.Transparency,.72)
   elseif v:IsA("Humanoid") or v:IsA("Sound") or v:IsA("Trail") then v:Destroy() end
  end
  ghost.Parent=workspace;self.echo=ghost;self.echoEpoch=data.epoch
 end
 if self.echo then
  if not active or self.echoEpoch~=data.epoch then self.echo:Destroy();self.echo=nil
  else self.echo:PivotTo(CFrame.new(data.human.decoy)*opponent:GetPivot().Rotation) end
 end
end
function Presentation:update(data,_dt)
 if not data.human then
  if self.echo then self.echo:Destroy();self.echo=nil end
  return
 end
 self:illusion(data,game:GetService("Players").LocalPlayer.Character)
end
return Presentation
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND40">
          <Properties>
            <string name="Name">UI</string>
            <ProtectedString name="Source">local Fighters=require(game:GetService("ReplicatedStorage").NinjaDuel.Fighters)
local GuiService=game:GetService("GuiService")
local UIS=game:GetService("UserInputService")
local Tween=game:GetService("TweenService")
local UI={}; UI.__index=UI
local palette={bg=Color3.fromRGB(14,22,30),panel=Color3.fromRGB(25,36,47),text=Color3.fromRGB(235,240,232),muted=Color3.fromRGB(154,174,181),blue=Color3.fromRGB(82,177,244),red=Color3.fromRGB(222,106,137)}
local function create(class,parent,props)
	local x=Instance.new(class)
	for k,v in props do x[k]=v end
	x.Parent=parent; return x
end
local function frame(parent,position,size,color)
	return create("Frame",parent,{Position=position,Size=size,BackgroundColor3=color or palette.panel,BorderSizePixel=0})
end
local function text(parent,value,position,size,fontSize,color)
	return create("TextLabel",parent,{Text=value,Position=position,Size=size,TextSize=fontSize or 16,Font=Enum.Font.GothamMedium,TextColor3=color or palette.text,BackgroundTransparency=1,TextXAlignment=Enum.TextXAlignment.Left,TextWrapped=true})
end
local function button(parent,value,position,size,callback,color)
	local b=create("TextButton",parent,{Text=value,Position=position,Size=size,TextSize=16,Font=Enum.Font.GothamBold,TextColor3=palette.text,BackgroundColor3=color or palette.panel,BorderSizePixel=0,AutoButtonColor=true})
	create("UICorner",b,{CornerRadius=UDim.new(0,6)})
	b.Activated:Connect(callback); return b
end
local function portrait(parent,def,position)
	local vp=create("ViewportFrame",parent,{Position=position,Size=UDim2.new(0,100,0,116),BackgroundTransparency=1,Ambient=Color3.fromRGB(185,185,185),LightColor=Color3.new(1,1,1),LightDirection=Vector3.new(-1,-1,-1)})
	local function p(size,at,color)
		create("Part",vp,{Size=size,CFrame=CFrame.new(at),Color=Color3.fromRGB(table.unpack(color)),Anchored=true})
	end
	p(Vector3.new(2,2,1),Vector3.zero,def.Outfit)
	p(Vector3.new(1.5,1.5,1.5),Vector3.new(0,1.6,0),def.Skin)
	p(Vector3.new(1.65,0.55,1.65),Vector3.new(0,2.12,0),def.Hair)
	for _,s in {-1,1} do p(Vector3.new(1,2,1),Vector3.new(s*1.5,0,0),def.Outfit) end
	p(Vector3.new(2.1,0.25,1.1),Vector3.new(0,-0.65,0),def.Color)
	local camera=create("Camera",vp,{CFrame=CFrame.lookAt(Vector3.new(4,2.8,-8),Vector3.new(0,0.7,0))})
	vp.CurrentCamera=camera
end
function UI.new(parent,send)
	local self=setmetatable({player="Flashstep",bot="Mirage",send=send,selectionButtons={}},UI)
	self.gui=create("ScreenGui",parent,{Name="NinjaDuelHUD",ResetOnSpawn=false,IgnoreGuiInset=false,ZIndexBehavior=Enum.ZIndexBehavior.Sibling})
	self.selection=frame(self.gui,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.bg)
	local shell=frame(self.selection,UDim2.fromScale(.5,.5),UDim2.fromOffset(780,510),palette.bg)
	shell.AnchorPoint=Vector2.new(.5,.5)
	local scale=create("UIScale",shell,{Scale=1})
	local function resize() scale.Scale=math.min(1,workspace.CurrentCamera.ViewportSize.X/850,workspace.CurrentCamera.ViewportSize.Y/610) end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(resize);resize()
	create("UISizeConstraint",shell,{MinSize=Vector2.new(780,510),MaxSize=Vector2.new(780,510)})
	text(shell,"NINJA DUEL",UDim2.fromOffset(0,0),UDim2.fromOffset(780,48),38)
	text(shell,"TRAINING COURT  /  MINATO × ITACHI",UDim2.fromOffset(2,51),UDim2.fromOffset(760,25),13,palette.muted)
	text(shell,"Choose your fighter. Learn the exchange.",UDim2.fromOffset(2,85),UDim2.fromOffset(760,30),20)
	for i,id in {"Flashstep","Mirage"} do
		local def=Fighters[id]; local x=(i-1)*400
		local card=frame(shell,UDim2.fromOffset(x,135),UDim2.fromOffset(380,215))
		local accent=Color3.fromRGB(table.unpack(def.Color))
		frame(card,UDim2.fromOffset(0,0),UDim2.fromOffset(380,3),accent)
		portrait(card,def,UDim2.fromOffset(12,20))
		text(card,def.Name,UDim2.fromOffset(128,21),UDim2.fromOffset(235,35),26,accent)
		text(card,def.Title,UDim2.fromOffset(128,61),UDim2.fromOffset(235,20),11,palette.muted)
		text(card,def.Description,UDim2.fromOffset(128,90),UDim2.fromOffset(235,58),14)
		text(card,string.format("%d HP  •  %d chakra  •  %d speed  •  %s",def.Health,def.Chakra,def.Speed,if id=="Flashstep" then "Agile" else "Precise"),UDim2.fromOffset(18,176),UDim2.fromOffset(345,23),12,palette.muted)
	end
	text(shell,"YOUR FIGHTER",UDim2.fromOffset(0,371),UDim2.fromOffset(360,20),12,palette.muted)
	text(shell,"AI OPPONENT",UDim2.fromOffset(400,371),UDim2.fromOffset(360,20),12,palette.muted)
	for i,id in {"Flashstep","Mirage"} do
		self.selectionButtons["player"..id]=button(shell,Fighters[id].Name,UDim2.fromOffset((i-1)*194,400),UDim2.fromOffset(186,36),function() self.player=id; self:refreshSelection() end)
		self.selectionButtons["bot"..id]=button(shell,Fighters[id].Name,UDim2.fromOffset(400+(i-1)*194,400),UDim2.fromOffset(186,36),function() self.bot=id; self:refreshSelection() end)
	end
	self.startButton=button(shell,"DUEL  →",UDim2.fromOffset(400,459),UDim2.fromOffset(380,45),function() send("Start",{player=self.player,bot=self.bot}) end,Color3.fromRGB(36,88,109))
	self.tutorialButton=button(shell,"INTERACTIVE TUTORIAL",UDim2.fromOffset(0,459),UDim2.fromOffset(380,45),function() send("Tutorial",{player=self.player,bot=self.bot}) end)
	self.hud=frame(self.gui,UDim2.fromScale(0,0),UDim2.fromScale(1,1)); self.hud.BackgroundTransparency=1
	local function meter(parent,name,pos,color)
		local box=frame(parent,pos,UDim2.fromOffset(290,60))
		local label=text(box,name,UDim2.fromOffset(14,7),UDim2.fromOffset(262,20),15)
		local track=frame(box,UDim2.fromOffset(14,31),UDim2.fromOffset(262,6),palette.bg)
		local fill=frame(track,UDim2.fromOffset(0,0),UDim2.fromScale(1,1),color)
		local status=text(box,"",UDim2.fromOffset(14,41),UDim2.fromOffset(262,16),10,palette.muted)
		return {box=box,label=label,fill=fill,status=status}
	end
	self.hp=meter(self.hud,"",UDim2.fromOffset(22,20),palette.blue)
	self.enemy=meter(self.hud,"",UDim2.new(1,-312,0,20),palette.red)
	self.chakra=meter(self.hud,"CHAKRA",UDim2.new(0,22,1,-160),palette.blue)
	self.cue=text(self.hud,"",UDim2.new(0.5,-250,0,128),UDim2.fromOffset(500,36),22); self.cue.TextXAlignment=Enum.TextXAlignment.Center
	self.channel=text(self.hud,"",UDim2.new(0.5,-250,0,165),UDim2.fromOffset(500,28),15,palette.muted); self.channel.TextXAlignment=Enum.TextXAlignment.Center
	self.techniqueButtons={}
	for i=1,5 do
		local box=frame(self.hud,UDim2.new(0.5,-418+(i-1)*168,1,-78),UDim2.fromOffset(160,48))
		self.techniqueButtons[i]={title=text(box,"",UDim2.fromOffset(8,5),UDim2.fromOffset(146,26),13),status=text(box,"",UDim2.fromOffset(8,27),UDim2.fromOffset(146,16),10,palette.muted),box=box}
	end
	self.help=text(self.hud,"WASD move  CTRL sprint  SPACE jump/wall rebound  C detach  LMB chain/air  R tool  F guard  Q dash  X substitute  G feint  E pursue  1–5 techniques  SHIFT lock",UDim2.new(0.5,-600,1,-34),UDim2.fromOffset(1200,25),11,palette.muted)
	self.help.TextXAlignment=Enum.TextXAlignment.Center
	self.hint=text(self.hud,"",UDim2.new(0.5,-260,0,199),UDim2.fromOffset(520,30),13,palette.muted); self.hint.TextXAlignment=Enum.TextXAlignment.Center
	self.result=frame(self.gui,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.bg); self.result.BackgroundTransparency=0.2
	local resultBox=frame(self.result,UDim2.new(0.5,-240,0.5,-140),UDim2.fromOffset(480,280))
	self.resultTitle=text(resultBox,"",UDim2.fromOffset(30,24),UDim2.fromOffset(420,50),32)
	text(resultBox,"Read the commitment. Find a better opening.",UDim2.fromOffset(30,85),UDim2.fromOffset(420,45),15,palette.muted)
	self.rematchButton=button(resultBox,"REMATCH",UDim2.fromOffset(30,151),UDim2.fromOffset(420,42),function() send("Rematch") end,Color3.fromRGB(36,88,109))
	button(resultBox,"RETURN TO SELECTION",UDim2.fromOffset(30,211),UDim2.fromOffset(420,42),function() send("Selection") end)
	-- A small displaced indicator during Mirage; real body remains visible and controllable.
	self.echo=create("BillboardGui",self.gui,{Name="FalseTarget",Size=UDim2.fromOffset(130,38),AlwaysOnTop=true,Enabled=false})
	local echoLabel=text(self.echo,"◇  ECHO?",UDim2.fromScale(0,0),UDim2.fromScale(1,1),17,palette.red); echoLabel.TextXAlignment=Enum.TextXAlignment.Center
	self.tutorialPanel=frame(self.hud,UDim2.new(.5,-250,0,94),UDim2.fromOffset(500,88),palette.bg)
	self.tutorialTitle=text(self.tutorialPanel,"",UDim2.fromOffset(16,9),UDim2.fromOffset(470,26),18)
	self.tutorialPrompt=text(self.tutorialPanel,"",UDim2.fromOffset(16,40),UDim2.fromOffset(470,38),13,palette.muted)
	GuiService.AutoSelectGuiEnabled=true
	self:refreshSelection(); self:render({phase="Selection"})
	return self
end
function UI:refreshSelection()
	for key,b in self.selectionButtons do
		local selected=key=="player"..self.player or key=="bot"..self.bot
		b.BackgroundColor3=if selected then Color3.fromRGB(48,96,117) else palette.panel
	end
end
function UI:render(data)
	if self.lastPhase~=data.phase then
		GuiService.SelectedObject=if data.phase=="Selection" then self.startButton elseif data.phase=="Result" then self.rematchButton else nil
		self.lastPhase=data.phase
	end
	local pad=UIS:GetLastInputType().Name:match("Gamepad")~=nil
	self.tutorialPanel.Visible=data.tutorial~=nil and data.phase=="Duel"
	if data.tutorial then
		self.tutorialTitle.Text=data.tutorial.index.." / "..data.tutorial.total.."  "..data.tutorial.title
		self.tutorialPrompt.Text=(if pad then data.tutorial.pad else data.tutorial.key).."  •  "..(if pad then "View / touchpad to skip" else "ESC to skip")
	end
	self.selection.Visible=data.phase=="Selection"; self.hud.Visible=data.phase=="Duel"; self.result.Visible=data.phase=="Result"
	self.echo.Enabled=false
	if data.phase=="Selection" then return end
	local h,b=data.human,data.bot
	if not h or not b then return end
	self.hp.label.Text=h.fighter.."  /  YOU"; self.enemy.label.Text=b.fighter.."  /  AI"
	Tween:Create(self.hp.fill,TweenInfo.new(.12),{Size=UDim2.fromScale(math.clamp(h.health/h.maxHealth,0,1),1)}):Play()
	Tween:Create(self.enemy.fill,TweenInfo.new(.12),{Size=UDim2.fromScale(math.clamp(b.health/b.maxHealth,0,1),1)}):Play()
	self.hp.status.Text=string.format("%d / %d",math.ceil(h.health),h.maxHealth)
	self.enemy.status.Text=string.format("%d / %d",math.ceil(b.health),b.maxHealth)
	self.chakra.label.Text=string.format("CHAKRA  %d / %d",math.floor(h.chakra),h.maxChakra); self.chakra.fill.Size=UDim2.fromScale(h.chakra/h.maxChakra,1)
	self.chakra.status.Text=string.format("Substitution %d charges  •  %s",h.subCharges or 0,if h.wall then "WALL RUN" elseif h.dodge&gt;0 then string.format("Dash %.1fs",h.dodge) else "Dash ready")
	self.cue.Text=""
	self.channel.Text=""
	for i,tech in h.techniques do
		local ui=self.techniqueButtons[i];ui.box.Visible=true; ui.title.Text=(if pad then ({"RB+A","RB+X","RB+Y","RB+B","↑"})[i] else tostring(i)).."  "..tech.name
		ui.status.Text=if tech.remaining&gt;0 then string.format("%.1fs",tech.remaining) elseif not tech.condition then "Needs setup" elseif h.chakra&lt;tech.cost then "Need chakra" else tech.cost.." chakra"
		ui.box.BackgroundColor3=if tech.remaining==0 and tech.condition and h.chakra&gt;=tech.cost then Color3.fromRGB(30,57,69) else palette.panel
	end
	for i=#h.techniques+1,5 do self.techniqueButtons[i].box.Visible=false end
	self.hint.Text=if h.pursuit&gt;0 then (if pad then "A / Cross — chase" else "E — chase") else ""
	self.help.Text=if pad then "X light   Y heavy / launcher / slam   B dodge / escape   LB guard   LT grab   RT tool   RB + face jutsu   LS sprint   RS lock" else "LMB light   T heavy / launcher / slam   Q dodge   X escape   F guard   V grab   R tool   E chase   CTRL sprint   SHIFT lock"
	self.resultTitle.Text=if data.winner=="PlayerFighter" then "VICTORY" else "DEFEAT"
	if h.illusion&gt;0 and data.phase=="Duel" then
		local character=game:GetService("Players").LocalPlayer.Character
		local folder=character and character.Parent
		local effects=folder and folder:FindFirstChild("Effects")
		local echo=effects and effects:FindFirstChild("Echo")
		if echo then self.echo.Adornee=echo; self.echo.Enabled=true end
	end
end
return UI
</ProtectedString>
