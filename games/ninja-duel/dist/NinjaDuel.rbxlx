  <Item class="ServerScriptService" referent="ND19">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="ND20">
      <Properties>
        <string name="Name">NinjaDuelServer</string>
      </Properties>
      <Item class="ModuleScript" referent="ND21">
        <Properties>
          <string name="Name">AI</string>
          <ProtectedString name="Source">local Config=require(game:GetService("ReplicatedStorage").NinjaDuel.Config)
local Techniques=require(script.Parent.Techniques)
local Brawler=require(script.Parent.Brawler)
local AI={}; AI.__index=AI
function AI.new(combat,actor,seed)
	return setmetatable({combat=combat,actor=actor,nextTick=0,observed=nil,observedAt=0,guardUntil=0,rng=Random.new(seed or 23)},AI)
end
local function slotOf(a,id)
	for slot,spec in a.def.Techniques do if spec.Id==id then return "Technique"..slot,spec end end
	return nil
end
-- A press with an explicit route intent. The stick memory (Brawler.observe)
-- keeps the latest strong push for a moment; the bot's approach must never
-- turn into a route it did not choose, so it declares the one it wants.
local function press(c,a,action,dir,sideSign,aim)
	a.intentOverride={dir or "neutral",sideSign or 0}
	local ok,reason=c:request(a,action,aim)
	a.intentOverride=nil
	return ok,reason
end
-- How keen each prodigy is to re-engage (chakra dash from mid range, chase in
-- a window): Sasuke presses after the body, Itachi waits for it.
local DASH={Flashstep=1.1,Mirage=.75,GentleFist=1,Lion=1.45}
local CHASE={Flashstep=.62,Mirage=.5,GentleFist=.58,Lion=.74}
local function plantedSeals(a)
	local count=0
	for _,entry in a.anchors or {} do if not entry.actor then count+=1 end end
	return count
end
-- Defence first: wall tech on the impact, and a substitution decided once per
-- combo (like a player choosing when to spend it), not rolled every tick.
function AI:defend(now)
	local c,a=self.combat,self.actor
	if a.reaction=="WallSplat" then
		local elapsed=now-(a.splatAt or now)
		if self.techPlan==nil then self.techPlan=self.rng:NextNumber()&lt;.5 end
		if self.techPlan and elapsed&gt;=Config.Wall.TechFrom+.03 and elapsed&lt;=Config.Wall.TechUntil then
			if c:request(a,"Dodge") then self.techPlan=nil;return true end
		end
	else self.techPlan=nil end
	-- Incoming blades or fire: guard or sidestep once, at reaction speed.
	if a.state=="Neutral" and not a.reaction and not a.wall and now&gt;=(self.projectileReact or 0) then
		for _,p in c.projectiles do
			if p.a~=a then
				local offset=a.root.Position-p.position
				local gap=offset.Magnitude
				if gap&lt;16 and gap&gt;2 and p.direction:Dot(offset.Unit)&gt;.92 then
					self.projectileReact=now+.6
					-- Neji answers blades and fire with Rotation when it is ready.
					local rotation=slotOf(a,"Rotation")
					if rotation and gap&lt;11 and self.rng:NextNumber()&lt;.55 and c:request(a,rotation) then return true end
					local roll=self.rng:NextNumber()
					if roll&lt;.35 then
						c:request(a,"Guard");self.guardUntil=now+.35;return true
					elseif roll&lt;.6 and a.dodgeUntil&lt;=now then
						a.move=Vector3.new(-p.direction.Z,0,p.direction.X)*(if self.rng:NextNumber()&lt;.5 then 1 else -1)
						if c:request(a,"Dodge") then return true end
					end
					break
				end
			end
		end
	end
	-- Grabbed: try to break the throw on reaction.
	if a.reaction=="Grabbed" and a.grabbedAt and now-a.grabbedAt&gt;.12 and self.rng:NextNumber()&lt;.45 then
		if c:request(a,"Grab") then return true end
	end
	-- Low on health: awaken (once per match).
	if not a.awakened and a.def.Awakening and a.health&lt;=a.def.Health*Config.Awaken.Threshold and not a.reaction and self.rng:NextNumber()&lt;.4 then
		if c:request(a,"Awaken") then return true end
	end
	local hits=a.comboHits or 0
	if hits==0 then self.subPlan=nil end
	if hits&gt;0 and self.subPlan==nil then
		self.subPlan=if self.rng:NextNumber()&lt;.5 then 3+math.floor(self.rng:NextNumber()*3) else false
	end
	local hurt=a.state=="Stunned" or (a.reaction~=nil and a.reaction~="Wakeup")
	if hurt and self.subPlan and hits&gt;=self.subPlan and a.subCharges&gt;0 and a.chakra&gt;=Config.Substitution.Cost then
		if c:request(a,"Substitute") then self.subPlan=false;return true end
	end
	return false
end
function AI:update(now)
	local c,a=self.combat,self.actor; local target=a.target; local tune=Config.AI
	if c.match.phase~="Duel" or a.health&lt;=0 or target.health&lt;=0 then a.move=Vector3.zero; return end
	if now&lt;self.nextTick then return end
	self.nextTick=now+tune.Tick
	if a.state~="Rush" then self.feinted=nil end
	if self:defend(now) then return end
	-- Genjutsu: sometimes the bot sees through the decoy, sometimes it does not.
	if a.illusionUntil&gt;now then
		if self.illusionSeen==nil then self.illusionSeen=self.rng:NextNumber()&lt;.35 end
	else self.illusionSeen=nil end
	local fooled=a.decoyPosition and a.illusionUntil&gt;now and not self.illusionSeen
	local position=if fooled then a.decoyPosition else target.root.Position
	local delta=position-a.root.Position; delta=Vector3.new(delta.X,0,delta.Z)
	local distance=delta.Magnitude; local toward=if distance&gt;0.1 then delta.Unit else Vector3.zAxis
	-- Facing is Combat:faceLocked's job (the bot is locked like the player): a
	-- lookAt snap on every 0.18 s decision made the body pivot in visible jerks.
	local tangent=Vector3.new(-toward.Z,0,toward.X);local minato=a.def.Name=="Minato"
	local desired=a.def.PreferredRange or 7
	-- Rhythm: press for a while, then probe at range (spacing, reading), and
	-- breathe after a combo lands instead of restarting at once.
	if now&gt;=(self.modeUntil or 0) then
		local wasProbing=self.probing
		self.probing=not self.probing and self.rng:NextNumber()&lt;.55
		self.modeUntil=now+(if self.probing then 1.6+self.rng:NextNumber()*2 else 2.2+self.rng:NextNumber()*2.6)
		self.probeRange=8+self.rng:NextNumber()*12
		-- A probe often resolves into an entry: the press opens with a dash.
		if wasProbing and not self.probing then self.entryUntil=now+1.2 end
	end
	local downed=target.reaction=="Knockdown" or target.reaction=="Wakeup" or (target.reaction=="Knockback" and target.airborne==false)
	if downed and not self.wasDowned and a.pursuitUntil&lt;=now then self.breathUntil=now+.35+self.rng:NextNumber()*.5 end
	self.wasDowned=downed
	-- Got hit and out of it: back off into neutral (reset, tools, reads)
	-- instead of mashing straight back in.
	local hurt=a.reaction~=nil or a.state=="Stunned"
	if self.wasHurt and not hurt and self.rng:NextNumber()&lt;tune.Disengage then
		self.probing=true;self.modeUntil=now+1.2+self.rng:NextNumber()*1.4;self.probeRange=10+self.rng:NextNumber()*8
	end
	self.wasHurt=hurt
	local calm=self.probing or now&lt;(self.breathUntil or 0)
	-- Probing happens at tool range: spacing, throws and reads before running in.
	if self.probing then desired+=self.probeRange or 14 elseif calm then desired+=4 end
	-- Genjutsu image (Itachi's Mirage): hold the line behind the image while it
	-- stands; the opponent has to come to it (blades still fly through it).
	local holding=target.illusionBy==a and (target.illusionUntil or 0)&gt;now
	if holding then desired=distance end
	local radial=if distance&gt;desired+2 then 1 elseif distance&lt;desired-2 then -0.6 else 0
	-- Lateral movement is committed for a beat, then changes side: readable
	-- repositioning, not a sine-wave drift around the opponent.
	if now&gt;=(self.strafeUntil or 0) then
		self.strafeSign=if self.rng:NextNumber()&lt;.5 then 1 else -1
		self.strafeUntil=now+.6+self.rng:NextNumber()*(if minato then .7 else 1.1)
		self.strafeAmount=if self.rng:NextNumber()&lt;.2 then 0 else (if minato then .95 else .6)
	end
	-- Pressing in from range: straight at them, angling only on the last
	-- steps. Two sprinting fighters offset the same way (velocity turns at a
	-- bounded rate) orbit each other forever instead of meeting.
	local lateral=self.strafeAmount or .5
	if radial&gt;0 and not calm then lateral*=if distance&gt;desired+8 then 0 else .35 end
	if holding then lateral=0 end
	a.move=(toward*radial+tangent*(self.strafeSign or 1)*lateral)
	-- Space is a resource: backing off drifts toward the open middle, so the
	-- wall is a choice (wall run, splat) and not where every retreat ends.
	local centre=(a.root.Position-c.match.origin)*Vector3.new(1,0,1)
	local edge=math.clamp((centre.Magnitude-(Config.ArenaRadius-45))/30,0,1)
	if edge&gt;0 and radial&lt;.5 and centre.Magnitude&gt;.1 then a.move-=centre.Unit*edge*.9 end
	a.sprinting=distance&gt;desired+6 and not calm
	if calm then a.move*=.7 end
	-- Step-in feint at probing range: two quick steps in, then out of reach,
	-- often with a blade on the way out.
	if self.feintOut then
		if now&lt;self.feintOut then
			a.move=-toward+tangent*(self.strafeSign or 1)*.4;a.sprinting=false
			if edge&gt;0 and centre.Magnitude&gt;.1 then a.move-=centre.Unit*edge end
			if self.feintThrow and now&gt;=self.feintThrow then self.feintThrow=nil;c:request(a,"Tool",target.root.Position) end
		else self.feintOut=nil end
	elseif self.feintIn then
		if now&lt;self.feintIn then a.move=toward;a.sprinting=true
		else self.feintIn=nil;self.feintOut=now+.35+self.rng:NextNumber()*.2
			self.feintThrow=if self.rng:NextNumber()&lt;.45 then now+.12 else nil
			Brawler.event(c,a,"FeintStep")
		end
	elseif self.probing and a.state=="Neutral" and not a.airborne and distance&gt;9 and distance&lt;19 and self.rng:NextNumber()&lt;tune.Feint then
		self.feintIn=now+.22+self.rng:NextNumber()*.12
	end
	if a.move.Magnitude&gt;1 then a.move=a.move.Unit end
	if now&gt;=self.guardUntil and a.state=="Guarding" then c:request(a,"GuardOff") end
	-- Wall run: rise along the wall, then dive at the opponent.
	local fromCenter=(a.root.Position-c.match.origin)*Vector3.new(1,0,1)
	local outward=if fromCenter.Magnitude&gt;.1 then fromCenter.Unit else Vector3.xAxis
	if a.wall then
		self.wallSince=self.wallSince or now
		local along=Vector3.new(-a.wall.normal.Z,0,a.wall.normal.X)
		a.move=(-a.wall.normal*.7+along*(self.wallSide or 1)*.7).Unit
		if now-self.wallSince&gt;.3 and (target.root.Position-a.root.Position).Magnitude&lt;=Config.Wall.DiveRange and self.rng:NextNumber()&lt;.55 then
			c:request(a,"Attack")
		end
		return
	end
	self.wallSince=nil
	if self.wallRun and now&lt;self.wallRun and a.state=="Neutral" and not a.reaction then
		a.move=(outward+tangent*.25).Unit;a.sprinting=true
		return
	end
	if fromCenter.Magnitude&gt;Config.ArenaRadius-22 and distance&gt;11 and distance&lt;44 and a.state=="Neutral" and not a.airborne and self.rng:NextNumber()&lt;tune.WallRun then
		self.wallRun=now+1.1;self.wallSide=if self.rng:NextNumber()&lt;.5 then 1 else -1
		return
	end
	if target.state~=self.observed then
  if target.state=="Startup" or target.state=="TechniqueChannel" then self.threatAt=now end
  self.observed=target.state;self.observedAt=now
 end
	-- Reads: an opponent stepping into melee range is answered before the
	-- strike lands. Not a reaction (no latency): a guess, taken once per entry
	-- - guard (a parry when the timing lands), sidestep or counter-poke.
	local closing=(target.locomotion or Vector3.zero):Dot(-toward)
	local entering=distance&lt;8.5 and (self.lastDistance or 99)&gt;=8.5 and closing&gt;4
	self.lastDistance=distance
	local free=a.state=="Neutral" and not a.reaction and not a.airborne
	if entering and free then
		local roll=self.rng:NextNumber()
		if roll&lt;tune.ReadGuard then
			c:request(a,"Guard");self.guardUntil=now+.42;return
		elseif roll&lt;tune.ReadGuard+tune.ReadDodge and a.dodgeUntil&lt;=now then
			a.move=tangent*(self.strafeSign or 1)
			if c:request(a,"Dodge") then return end
		elseif roll&lt;tune.ReadGuard+tune.ReadDodge+tune.ReadPoke and distance&lt;7.5 then
			if c:request(a,"Attack") then return end
		end
	end
	-- Toe to toe with a fighter who is not swinging yet: sometimes hold a
	-- guard in anticipation (a parry if the strike comes right then).
	if free and distance&lt;7 and target.state=="Neutral" and not target.reaction and self.rng:NextNumber()&lt;tune.GuardRead then
		c:request(a,"Guard");self.guardUntil=now+.28+self.rng:NextNumber()*.22;return
	end
	local reacted=now-self.observedAt&gt;=tune.Reaction
	local danger=target.state=="Startup" or target.state=="TechniqueChannel"
	local reactedThreat=reacted and (target.state=="Startup" or target.state=="Active")
 -- Remember the wind-up through Active/Recovery: short attacks used to erase
 -- the observation before reaction latency elapsed, so defense never fired.
 local remembered=self.threatAt and now-self.threatAt&gt;=tune.Reaction and now-self.threatAt&lt;.9
 if remembered and distance&lt;9 and a.state=="Neutral" and not a.reaction then
  self.threatAt=nil
  if target.state=="Recovery" then
   a.move=toward;a.sprinting=true
   if distance&lt;6 then c:request(a,"Attack") else c:request(a,"Dodge") end
  elseif minato then
   a.move=tangent;c:request(a,"Dodge")
  else
   c:request(a,"Guard");self.guardUntil=now+.36
  end
  return
 end
	-- Neji: a strike about to land at close range is a Rotation read.
	if reactedThreat and a.state=="Neutral" and distance&lt;6.5 and slotOf(a,"Rotation") and self.rng:NextNumber()&lt;.3 then
		if c:request(a,(slotOf(a,"Rotation"))) then return end
	end
	if a.state=="Startup" and a.attackName=="Heavy" and now-a.attackStarted&gt;.08 and self.rng:NextNumber()&lt;(if minato then .18 else .3) then c:request(a,"Feint");return end
	-- A newly observed telegraph may alter movement, but cannot trigger an
	-- instant defensive action or coincidental interrupt before reaction latency.
	if danger and not reacted then return end
	if reacted and danger and distance&lt;9 then
		if target.state=="TechniqueChannel" and distance&lt;=6.8 and self.rng:NextNumber()&lt;tune.Aggression then
			c:request(a,"Attack"); return
		end
		if self.rng:NextNumber()&lt;tune.Defense then
			if self.rng:NextNumber()&lt;0.45 then c:request(a,"Dodge")
			else c:request(a,"Guard"); self.guardUntil=now+0.5 end
			return
		end
	end
	if a.grabVictim then c:request(a,if self.rng:NextNumber()&lt;.4 then "Heavy" else "Attack");return end
	-- Re-engage: Itachi sometimes turns his dash into a feint (a guard and a
	-- read) instead of arriving; on arrival the bot converts with the dash
	-- strike, the quick heavy or, close to a guard, a grab.
	if a.state=="Rush" then
		if a.fighterId=="Mirage" and not self.feinted and distance&lt;10 then
			self.feinted=true
			if self.rng:NextNumber()&lt;.3 and c:request(a,"Guard") then self.guardUntil=now+.3;return end
		end
		press(c,a,"Attack");return
	end
	if (a.rushArriveUntil or 0)&gt;now and not a.airborne then
		local roll=self.rng:NextNumber()
		if target.state=="Guarding" and distance&lt;4.5 and roll&lt;.45 then press(c,a,"Grab")
		elseif roll&lt;.2 then press(c,a,"Heavy")
		else press(c,a,"Attack") end
		return
	end
	-- Sasuke under the rising body: one strike, then the Lion Combo.
	if (a.lionUntil or 0)&gt;now and a.airborne and a.state=="Neutral" then
		press(c,a,if (a.airCombo or 0)&gt;=1 and self.rng:NextNumber()&lt;.7 then "Heavy" else "Attack");return
	end
	-- Wired opponent: Dragon Flame at once.
	if a.wireVictim and a.wireVictim.reaction=="Bound" and a.state=="Neutral" then
		local fire=slotOf(a,"FireBloom")
		if fire and c:request(a,fire,target.root.Position) then return end
	end
	-- A read that landed (Read or a caught genjutsu): cash it in.
	-- A counter with a reach (a caught genjutsu image, a repelled strike) glides to the body.
	local counterRange=8+(if a.counterReach and a.counterReach.expires&gt;now then a.counterReach.max else 0)
	if (a.counterUntil or 0)&gt;now and distance&lt;counterRange then a.move=toward;c:request(a,"Attack");return end
	-- Flying Thunder God arrival: strike from the new angle, or Rasengan at once.
	if (a.flashUntil or 0)&gt;now then
		local rasengan=slotOf(a,"BurstStrike")
		if rasengan and self.rng:NextNumber()&lt;.35 and c:request(a,rasengan) then return end
		c:request(a,if self.rng:NextNumber()&lt;.3 then "Heavy" else "Attack");return
	end
	-- The opponent is pinned against a wall: pursue, extend, bounce or pin it.
	if target.reaction=="WallSplat" then
		local gap=(target.root.Position-a.root.Position).Magnitude
		if gap&lt;7 then a.move=toward;c:request(a,if self.rng:NextNumber()&lt;.45 then "Heavy" else "Attack");return end
		if a.pursuitUntil&gt;now and gap&lt;Config.PursuitRange and c:request(a,"Pursuit") then return end
		if not minato and gap&lt;32 and c:request(a,"Tool",target.root.Position) then return end
		a.move=toward;a.sprinting=true;return
	end
	-- A marked kunai that is about to pass the opponent is a teleport cue.
	if minato and a.state=="Neutral" then
		local seal=Techniques.sealOf(c,a,now)
		if seal and (seal-target.root.Position).Magnitude&lt;7 and (c:markedInFlight(a) or self.rng:NextNumber()&lt;.5) then
			local slot=slotOf(a,"Flashstep")
			if slot and c:request(a,slot) then return end
		end
	end
	if a.pursuitUntil&gt;now and distance&gt;8 and distance&lt;Config.PursuitRange and self.rng:NextNumber()&lt;(CHASE[a.fighterId] or .58) then
		c:request(a,"Pursuit"); return
	end
	if a.state=="Recovery" and a.chainOpen then
		-- In the air Minato may finish with a plunging Rasengan instead of the slam.
		if a.airborne and minato and (a.airCombo or 0)&gt;=1 and self.rng:NextNumber()&lt;.25 then
			local rasengan=slotOf(a,"BurstStrike")
			if rasengan and c:request(a,rasengan) then return end
		end
		-- The directional grammar: the stick picks the route, so the bot sets it
		-- explicitly (an approach held by accident must not pick a launcher).
		local roll=self.rng:NextNumber()
		if a.airborne then
			if (a.airCombo or 0)&gt;=2 and roll&lt;.4 then a.move=Vector3.zero;press(c,a,"Heavy");return end
			if (a.airCombo or 0)&gt;=1 then
				if roll&lt;.22 then a.move=-toward;press(c,a,"Attack","back");return
				elseif roll&lt;.42 then a.move=toward;press(c,a,"Attack","forward");return
				elseif roll&lt;.54 then
					local sign=if self.rng:NextNumber()&lt;.5 then 1 else -1
					a.move=tangent*sign;press(c,a,"Attack","side",sign);return
				end
			end
			a.move=Vector3.zero;press(c,a,"Attack");return
		end
		-- Neji: end a string with Vacuum Palm.
		if a.fighterId=="GentleFist" and a.combo&gt;=2 and roll&lt;.18 then
			local palm=slotOf(a,"VacuumPalm")
			if palm and c:request(a,palm,target.root.Position) then return end
		end
		local nearWall=fromCenter.Magnitude&gt;Config.ArenaRadius-22
		if a.combo&gt;=2 then
			if roll&lt;.3 then a.move=toward;press(c,a,"Attack","forward");return end -- launcher
			if roll&lt;.46 then a.move=-toward;press(c,a,"Attack","back");return end -- low route
			if roll&lt;.56 then a.move=Vector3.zero;press(c,a,"Heavy");return end
		elseif a.combo==1 and roll&lt;.2 then a.move=Vector3.zero;press(c,a,"Heavy");return end
		if roll&lt;.7 and roll&gt;=.56 then
			local sign=if self.rng:NextNumber()&lt;.5 then 1 else -1
			a.move=tangent*sign;press(c,a,"Attack","side",sign);return
		end
		if roll&gt;=.92 then
			-- Tool inside the string; away + tool hops out behind it.
			local away=not nearWall and self.rng:NextNumber()&gt;=.5
			a.move=if away then -toward else Vector3.zero
			press(c,a,"Tool",if away then "back" else "neutral",0,target.root.Position);return
		end
		a.move=Vector3.zero;press(c,a,"Attack");return
	end
	if a.state~="Neutral" or a.reaction then return end
	if a.chakra&lt;18 then a.move=-toward+tangent*0.2; return end
	if distance&gt;7 and distance&lt;46 and self.rng:NextNumber()&lt;(if a.def.Name=="Itachi" then 0.11 else 0.09)*(if self.probing then tune.ProbeTool else 1) and target.state~="Guarding" then
		-- A tool master sometimes throws the geometry instead (side + tool).
		if a.def.ToolMastery and a.def.ToolMastery.Geometry and self.rng:NextNumber()&lt;.4 then
			a.move=tangent*(if self.rng:NextNumber()&lt;.5 then 1 else -1)
		end
		if c:request(a,"Tool",target.root.Position) then return end
	end
	-- Choose by capabilities/technique identifiers, never by a second bot combat engine.
	-- Jutsu are paced: after one, a few seconds of movement, tools and reads
	-- before the next. A close punish (stunned, bound, or recovering within
	-- reach) is not; a recovery seen from range is still neutral.
	local punish=target.state=="Stunned" or target.reaction=="Bound"
		or ((target.state=="Recovery" or target.state=="TechniqueRecovery") and distance&lt;7)
	if self.rng:NextNumber()&lt;tune.Technique and (now&gt;=(self.techReadyAt or 0) or punish) then
		for slot,spec in a.def.Techniques do
			local use=false; local aim=target.root.Position
			if spec.Id=="MarkedBlade" then use=plantedSeals(a)&lt;2 and not c:markedInFlight(a) and distance&gt;8; aim=position+target.hum.MoveDirection*3
			elseif spec.Id=="Flashstep" then local seal=Techniques.sealOf(c,a,now);use=seal~=nil and (distance&gt;14 or (seal-target.root.Position).Magnitude&lt;7)
			elseif spec.Id=="BurstStrike" then use=distance&lt;7 and (target.state=="Recovery" or target.state=="Stunned" or target.state=="TechniqueRecovery")
			elseif spec.Id=="Read" then use=distance&lt;8 and danger and reacted
			elseif spec.Id=="NeedleFan" then use=distance&gt;8 and distance&lt;36
			elseif spec.Id=="MirageCast" then use=distance&gt;10 and distance&lt;21 and (target.state=="Recovery" or target.state=="Guarding" or self.rng:NextNumber()&lt;0.18) end
			if spec.Id=="FireBloom" then use=distance&gt;6 and distance&lt;46 and c:lineOfSight(a,target) and (target.state=="Recovery" or target.state=="TechniqueChannel" or self.rng:NextNumber()&lt;0.32) end
			if spec.Id=="WireTrap" then use=distance&gt;7 and distance&lt;28 and c:lineOfSight(a,target) and self.rng:NextNumber()&lt;.4 end
			if spec.Id=="Chidori" then use=distance&gt;4 and distance&lt;16 and (target.state=="Recovery" or target.state=="TechniqueRecovery" or target.state=="Stunned" or target.reaction=="Bound" or self.rng:NextNumber()&lt;.06) end
			if spec.Id=="FireBloom" and a.wireVictim and a.wireVictim.reaction=="Bound" then use=true end
			if spec.Id=="SandCoffin" then use=distance&gt;7 and distance&lt;28 and c:lineOfSight(a,target) and self.rng:NextNumber()&lt;.45 end
			if spec.Id=="SandShuriken" then use=distance&gt;9 and distance&lt;34 and self.rng:NextNumber()&lt;.5 end
			if spec.Id=="DesertWave" then use=distance&lt;8 and (target.state=="Startup" or target.state=="Rush" or target.state=="Active" or self.rng:NextNumber()&lt;.25) end
			if spec.Id=="VacuumPalm" then use=distance&gt;7 and distance&lt;24 and c:lineOfSight(a,target) and self.rng:NextNumber()&lt;.45 end
			if spec.Id=="SixtyFourPalms" then use=distance&lt;4.6 and (target.state=="Recovery" or target.state=="Stunned" or target.state=="TechniqueRecovery" or target.state=="TechniqueChannel") end
			if spec.Id=="Rotation" then use=false end
			if spec.Id=="PhoenixFlower" then use=distance&gt;9 and distance&lt;34 and c:lineOfSight(a,target) and self.rng:NextNumber()&lt;.5 end
			if spec.Id=="WindCut" then use=distance&gt;8 and distance&lt;28 end
			if spec.Id=="Quickstep" then use=distance&gt;9 and distance&lt;20 and self.rng:NextNumber()&lt;0.25 end
			if use and c:request(a,"Technique"..slot,aim) then
				self.techReadyAt=now+(tune.TechniqueGap or 0)+self.rng:NextNumber()*(tune.TechniqueJitter or 0);return
			end
		end
	end
	local whiff=target.state=="Recovery" and (target.attackName=="Heavy" or not target.hitConfirmed)
	if whiff and distance&lt;10 then a.move=toward;a.sprinting=true;c:request(a,"Attack");return end
	-- Probing or breathing: no fresh melee initiation, only punishes and reads.
	if calm then return end
	local reach=(a.def.AttackProfile and a.def.AttackProfile.Light1 and a.def.AttackProfile.Light1.range or 6)+1.5
	if distance&lt;math.max(8,reach) and self.rng:NextNumber()&lt;tune.Aggression then
		c:request(a,if a.grabVictim then "Attack" elseif distance&lt;5 and self.rng:NextNumber()&lt;.12 then "Grab" elseif self.rng:NextNumber()&lt;.16 then "Heavy" else "Attack")
	end
	-- Out-ranged (sand lashes): close the gap instead of waiting at its edge.
	local theirs=(target.def.AttackProfile and target.def.AttackProfile.Light1 and target.def.AttackProfile.Light1.range or 6)
	if theirs&gt;reach and distance&gt;reach-1 and distance&lt;theirs+3 and target.state~="Startup" then
		a.move=toward;a.sprinting=true
		if distance&gt;Config.Rush.MinRange+.5 and self.rng:NextNumber()&lt;.3 and c:request(a,"Pursuit") then return end
		if self.rng:NextNumber()&lt;.2 then c:request(a,"Dodge");return end
	end
	if distance&gt;6 and distance&lt;17 and self.rng:NextNumber()&lt;0.1 then c:request(a,"Jump") end
	-- Chakra dash in from mid range when the opponent is not attacking (nor
	-- holding a guard the arrival would run into); Neji closes in from closer.
	local dashFrom=if a.fighterId=="GentleFist" then 7.5 else 11
	-- Keener at the start of a press and from far away (walking twenty studs
	-- into a zoner is the slow answer).
	local keen=.1*(DASH[a.fighterId] or 1)
	if (self.entryUntil or 0)&gt;now then keen*=4 elseif distance&gt;desired+10 then keen*=2 end
	if not calm and distance&gt;dashFrom and distance&lt;44 and target.state~="Startup" and target.state~="TechniqueChannel" and target.state~="Guarding"
		and self.rng:NextNumber()&lt;keen then
		if c:request(a,"Pursuit") then self.entryUntil=nil;return end
	end
	-- Sidestep cover when the direct route is obstructed.
	local block=workspace:Raycast(a.root.Position,toward*6,c:rayParams(true))
	if block then a.move=tangent; c:request(a,"Jump") end
end
return AI
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND22">
        <Properties>
          <string name="Name">Animation</string>
          <ProtectedString name="Source">-- Bangla PunchMoves animation playback, adapted for server-owned human and AI R15.
-- Combat uses imported choreography; the previous procedural punch fallback is removed.
local Shared=game:GetService('ReplicatedStorage').NinjaDuel
local Combo=require(Shared.BanglaCombo)
local Bindings=require(Shared.AnimationBindings)
local Donor=require(script.Parent.DonorAnimations)
local RunService=game:GetService('RunService')
local Provider=game:GetService('KeyframeSequenceProvider')
local ServerStorage=game:GetService('ServerStorage')
local Animation={}
local catalog={Idle=656117400,Run=656118852,Walk=656121766,Jump=656117878,Fall=656115606,Climb=656114359}
local cache,failures,loading={},{},{}
local function resolve(name)
 if Bindings[name] and Bindings[name]&gt;0 then return 'rbxassetid://'..Bindings[name] end
 if not RunService:IsStudio() then return nil,'Publish the retargeted '..name..' R15 sequence and fill AnimationBindings.' end
 if cache[name] then return cache[name] end
 if failures[name] then return nil,failures[name] end
 if loading[name] then
  local deadline=os.clock()+15
  repeat task.wait(.05) until not loading[name] or os.clock()&gt;=deadline
  return cache[name],failures[name] or 'Animation fetch still pending'
 end
 loading[name]=true
 local ok,value=pcall(function()
 local seq=Provider:GetKeyframeSequenceAsync('rbxassetid://'..Combo.AnimationIds[name])
 local r15=Donor.retarget(seq);seq:Destroy()
 local folder=ServerStorage:FindFirstChild('BanglaR15Sequences')
 if not folder then folder=Instance.new('Folder');folder.Name='BanglaR15Sequences';folder.Parent=ServerStorage end
 r15.Name=name;r15.Parent=folder
 return Provider:RegisterKeyframeSequence(r15)
 end)
 loading[name]=nil
 if ok then cache[name]=value;return value end
 failures[name]=tostring(value);return nil,failures[name]
end
function Animation.attach(a)
 if a.model:GetAttribute('SkipDonorAnimationQA') then return false end
 local animator=a.hum:FindFirstChildOfClass('Animator');if not animator then return false end
 local player={tracks={},instances={},current=nil,currentEvent=nil};a.animation=player
 a.model:SetAttribute('AuthoredAnimations',true)
 a.model:SetAttribute('DonorAnimationStatus','Loading')
 task.spawn(function()
  for name,id in catalog do
   local asset=Instance.new('Animation');asset.AnimationId='rbxassetid://'..id
   local ok,track=pcall(function() return animator:LoadAnimation(asset) end)
   if a.animation~=player then if ok then track:Destroy() end;asset:Destroy();return end
   table.insert(player.instances,asset)
   if ok then track.Priority=Enum.AnimationPriority.Movement;track.Looped=name=='Idle' or name=='Run' or name=='Walk' or name=='Climb';player.tracks[name]=track end
  end
  local ready=true
  for name in Combo.AnimationIds do
   local ok,id,reason=pcall(resolve,name)
   if a.animation~=player then return end
   if ok and id then
    local asset=Instance.new('Animation');asset.Name=name;asset.AnimationId=id
    local loaded,track=pcall(function() return animator:LoadAnimation(asset) end)
    table.insert(player.instances,asset)
    if loaded then track.Priority=Enum.AnimationPriority.Action;player.tracks[name]=track
    else ready=false;warn('[NinjaDuelAnimation] BLOCKED '..name..': '..tostring(track)) end
   else ready=false;warn('[NinjaDuelAnimation] BLOCKED '..name..': '..tostring(reason or id)) end
  end
  a.model:SetAttribute('DonorAnimationStatus',if ready then 'Ready' else 'Blocked')
 end)
 return true
end
local function choose(a,now)
 if a.health&lt;=0 then return nil end
 if a.state=='Startup' or a.state=='Active' or a.state=='Recovery' and a.attackName and now-a.attackStarted&lt;.5 then
  local action=Combo.Actions[a.attackName]
  -- Missing ninja branches reuse the imported moves; no local pose timeline.
  action=action or (if a.attackName=='Air1' or a.attackName=='DashAttack' then 'Punch' elseif a.attackName=='Air2' then 'HardSmack' else 'MegaPunch')
  return action,a.attackStarted
 end
 if a.reaction or a.state=='Stunned' then return nil end
 if a.state=='Guarding' then return 'Parry',0 end
 if a.state=='TechniqueChannel' then return 'Parry',a.untilTime end
 if a.wall then return 'Climb',0 end
 if a.airborne then return if a.root.AssemblyLinearVelocity.Y&gt;0 then 'Jump' else 'Fall',0 end
 if a.locomotion.Magnitude&gt;2 then return if a.locomotion.Magnitude&gt;30 then 'Run' else 'Walk',0 end
 return 'Idle',0
end
function Animation.step(a,now)
 local p=a.animation;if not p then return false end
 local name,event=choose(a,now)
 if p.current~=name or p.currentEvent~=event then
  if p.current and p.tracks[p.current] then p.tracks[p.current]:Stop(.08) end
  p.current=name;p.currentEvent=event
  if name and p.tracks[name] then p.tracks[name]:Play(.06) end
 elseif name and p.tracks[name] and not p.tracks[name].IsPlaying and (name=='Idle' or name=='Run' or name=='Walk' or name=='Climb' or name=='Parry') then
  p.tracks[name]:Play(.08)
 end
 if (name=='Run' or name=='Walk') and p.tracks[name] then p.tracks[name]:AdjustSpeed(math.clamp(a.locomotion.Magnitude/(if name=='Run' then 32 else 18),.75,1.7)) end
 return true
end
function Animation.clear(a)
 local p=a.animation;a.animation=nil;if not p then return end
 for _,track in p.tracks do track:Stop(0);track:Destroy() end
 for _,asset in p.instances do asset:Destroy() end
end
return Animation
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND23">
        <Properties>
          <string name="Name">BanglaCombat</string>
          <ProtectedString name="Source">-- Adapted from BanglaBattlegrounds ServerScriptService/StarterCombat.
-- Copyright (c) 2024 Dewan Mukto, MIT (vendor/bangla/LICENSE).
-- Retained: forward hitbox, per-swing Hits, damage table, parry seam, hit counter,
-- BasicPunch emission and swing/contact sounds. Changes: one validated actor API,
-- deterministic broadphase for anchored hitboxes, active-window lifetime/cleanup,
-- collision occlusion, and Ninja Duel's guard/chakra/damage authority.
local Debris=game:GetService('Debris')
local assets=game:GetService('ReplicatedStorage').NinjaDuel:WaitForChild('BanglaAssets')
local Combo=require(game:GetService('ReplicatedStorage').NinjaDuel.BanglaCombo)
local Bangla={}
local function sound(parent,id)
 local s=Instance.new('Sound');s.SoundId=id;s.Volume=.5;s.Parent=parent
 s:Play();Debris:AddItem(s,1.5)
end
function Bangla.begin(c,a,p)
 local hitbox=Instance.new('Part')
 hitbox.Name='BanglaHitbox';hitbox.Anchored=true;hitbox.CanCollide=false
 hitbox.CanQuery=false;hitbox.CanTouch=false;hitbox.Transparency=1
 hitbox.Size=Vector3.new(5,5,2)
 hitbox.CFrame=a.root.CFrame*CFrame.new(0,0,-2)
 hitbox.Parent=c.match.effects
 p.donor={hitbox=hitbox,Hits={},action=Combo.Actions[p.name] or 'MegaPunch'}
 -- The donor used Debris for lifetime; c.effects also cleans interrupted swings.
 table.insert(c.effects,{part=hitbox,expires=c.now+p.spec.startup+p.spec.active+.05})
 sound(a.root,'rbxassetid://5835032207')
 a.model:SetAttribute('CombatBase','BanglaBattlegrounds')
end
function Bangla.close(p)
 if p and p.donor then p.donor.hitbox:Destroy() end
end
function Bangla.tryHit(c,a,p)
 local donor=p.donor;local target=a.target
 if not donor or not donor.hitbox.Parent or not target or target.health&lt;=0 then return false end
 -- Same donor forward volume; missing air/grab mechanics supply their bounded shape.
 local hitbox=donor.hitbox
 hitbox.Size=Vector3.new(p.spec.width or 5,p.spec.height or 5,p.spec.depth or 2)
 hitbox.CFrame=a.root.CFrame*CFrame.new(0,0,-(p.spec.offset or 2))
 local params=OverlapParams.new();params.FilterType=Enum.RaycastFilterType.Include
 params.FilterDescendantsInstances={target.model}
 -- Touched on a teleported anchored part was unreliable; query the same volume.
 for _,hit in workspace:GetPartBoundsInBox(hitbox.CFrame,hitbox.Size,params) do
  if hit:IsDescendantOf(target.model) and not donor.Hits[target.id] then
   if not c:targetValid(a,target,p.spec.range,p.spec.facing or .05) then continue end
   donor.Hits[target.id]=true
   local delta=a.root.Position-target.root.Position
   local frontal=delta.Magnitude&lt;.001 or target.root.CFrame.LookVector:Dot(delta.Unit)&gt;.15
   local guarded=target.state=='Guarding' and target.chakra&gt;0 and frontal
   local protected=target.state=='TechniqueChannel' and target.pending and not target.pending.spec.Interruptible
   local damage=if Combo.Actions[p.name] then Combo.Damage[donor.action] else p.spec.damage
   c.damageTag=if p.rasengan then "Rasengan" else p.name
   -- A Flow strike (chained on the beat) lands a little harder.
   local flow=if p.flow then require(game:GetService("ReplicatedStorage").NinjaDuel.Config).Flow.Damage else 1
   local success=c:damage(a,target,damage*(a.def.CombatDamage or 1)*flow*(p.spec.damageScale or 1),false,true)
   c.damageTag=nil
   -- The defence resolution (guard, Byakugan sight, guard break) is the truth.
   if success then guarded=target.impactStyle=='block' end
   if success then
    -- Contact audio comes from the client's impact feed (VelmoraHitFeedback);
    -- a replicated server Sound here doubled every hit, out of sync.
    local vfx=if donor.action=='MegaPunch' then 'ComboPunch' else 'BasicPunch'
    local basicPunch=assets.VFX[vfx].Attachment:Clone()
    basicPunch.Parent=target.root
    for _,v in basicPunch:GetChildren() do
     if v:IsA('ParticleEmitter') then v:Emit(v:GetAttribute('EmitCount') or 1) end
    end
    Debris:AddItem(basicPunch,.25)
    if c.now-(a.donorLastHit or -10)&gt;2 then a.donorHitCount=0 end
    a.donorHitCount=(a.donorHitCount or 0)+1;a.donorLastHit=c.now
   end
   return success,guarded,protected
  end
 end
 return false
end
return Bangla
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND24">
        <Properties>
          <string name="Name">BanglaEvade</string>
          <ProtectedString name="Source">-- performEvade from Bangla WalkRunHandler (Dewan Mukto, MIT), adapted.
-- One finite server tick loop replaces leaked RenderStepped connections. No global
-- gravity change; swept travel preserves walls, lane boundaries and root facing.
local Evade={}
function Evade.begin(a,c)
 local direction=if a.move.Magnitude&gt;.1 then a.move.Unit else a.root.CFrame.RightVector
 local evadeDistance=14*(a.def.DashScale or 1)
 local evadeDuration=.32
 a.evade={startPosition=a.root.Position,targetPosition=a.root.Position+direction*evadeDistance,startTime=c.now,duration=evadeDuration,direction=direction}
end
function Evade.step(a,c,travel)
 local e=a.evade;if not e then return end
 local rootPart=a.root
 local targetPosition=e.targetPosition
 local evadeDuration=e.duration
 local startTime=e.startTime
 local elapsedTime=c.now-startTime
 if elapsedTime&lt;evadeDuration then
  local t=math.clamp(elapsedTime/evadeDuration,0,1)
  -- Fast launch, soft brake: distance stays deterministic without the donor's
  -- moving-origin snap near the end of the evade. Quadratic, not cubic: the
  -- cubic left at 3x the mean speed (~2 studs in the first frame), which read
  -- as a pop in Studio; same distance and duration.
  local eased=1-(1-t)^2
  local position=e.startPosition:Lerp(targetPosition,eased)
  local delta=position-rootPart.Position
  travel(a,c,delta,delta.Magnitude)
  -- Turn into the dash at a bounded rate instead of snapping 90 degrees in a frame.
  local dt=math.max(1/240,c.now-(e.lastAt or startTime));e.lastAt=c.now
  if e.direction.Magnitude&gt;.1 then c:turnToward(a,e.direction,dt,900) end
  rootPart.AssemblyLinearVelocity=Vector3.zero
 else a.evade=nil end
end
return Evade
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND25">
        <Properties>
          <string name="Name">Brawler</string>
          <ProtectedString name="Source">local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Attacks=require(Shared.Attacks)
local Motor=require(script.Parent.Motor)
local Bangla=require(script.Parent.BanglaCombat)
local MoveGraphs=require(Shared.MoveGraphs)
local Config=require(Shared.Config)
local Rules=require(Shared.Rules)
-- Adapter: reaction/air/grab mechanics missing from the donor; all strike hit
-- volumes/damage/feedback run through Bangla. String progression is Ninja
-- Duel's own (confirmed hits, below), no longer the donor's press counter.
local Brawler={}
local airReactions={Launched=true,Juggled=true,Knockback=true,Knockdown=true,WallSplat=true,Spiked=true}
local TUNE=Config.Combo
local UP=Vector3.yAxis
local function flatUnit(v)
 local f=Vector3.new(v.X,0,v.Z)
 return if f.Magnitude&gt;.01 then f.Unit else nil
end
-- The move graph this actor fights with: its skill build's copy when it has
-- one (Combat:add), otherwise the canonical MoveGraphs entry.
function Brawler.graph(a)
 return a.graph or MoveGraphs[a.fighterId]
end
function Brawler.free(a,now)
 return a.reaction==nil or now&gt;=(a.reactionUntil or 0)
end
function Brawler.event(c,a,event)
 a.events=a.events or {};a.events[event]=(a.events[event] or 0)+1
 if c.match.onCombatEvent then c.match.onCombatEvent(a,event) end
end
-- Combo model (CORE_COMBAT_CONVERGENCE_2 §1). A string is counted in
-- CONFIRMED hits: a press, a startup, a buffered input or a whiff never
-- advances it.
--   a.combo / a.airCombo   confirmed hits of the current ground / air string
--   a.stringUntil / a.airStringUntil   until then a press from neutral still
--                          continues it (chain window plus Config.Combo.Grace)
--   a.stringAt             when its last hit was confirmed (a hit taken since
--                          breaks it)
--   pending.step           the count a chain move confirms if it connects
-- Light step = confirmed hits + 1 (third light ends the string); routes ask for
-- confirmed hits; a whiff, a blocked strike or a hit taken restarts at Light1.
function Brawler.chainWindow(c,a)
 return a.state=="Recovery" and a.chainOpen==true and c.now&gt;=(a.chainAt or 0)
end
function Brawler.stringAlive(c,a,air)
 local count=if air then a.airCombo else a.combo
 if (count or 0)&lt;1 then return false end
 if air and not a.airborne then return false end
 if (a.lastHurt or -10)&gt;((if air then a.airStringAt else a.stringAt) or -10) then return false end
 if Brawler.chainWindow(c,a) and (a.chainAir==true)==(air==true) then return true end
 return c.now&lt;=((if air then a.airStringUntil else a.stringUntil) or 0)
end
function Brawler.breakString(a,air)
 if air then a.airCombo=0;a.airStringUntil=0 else a.combo=0;a.stringUntil=0 end
end
function Brawler.resetStrings(a)
 Brawler.breakString(a,false);Brawler.breakString(a,true)
end
-- The swing connected (cleanly, or into armour or a sand shield): it is the
-- string's next confirmed hit.
function Brawler.confirm(c,a,p)
 if p.spec.air then a.airCombo=p.step;a.airStringAt=c.now else a.combo=p.step;a.stringAt=c.now end
end
-- The swing's outcome is known (end of its active window): a clean chain hit
-- keeps its string alive for the chain window plus the grace; a whiff or a
-- blocked hit ends it, so the next press is an opener again.
function Brawler.settle(c,a,p)
 local air=p.spec.air==true
 if a.chainOpen then
  a.chainAir=air
  if air then a.airStringUntil=a.untilTime+TUNE.Grace else a.stringUntil=a.untilTime+TUNE.Grace end
 elseif p.spec.chain then
  Brawler.breakString(a,air)
 end
end
-- Directional intent, relative to the opponent (CORE_COMBAT_CONVERGENCE_2 §1.6):
-- "forward" (toward him), "back" (away), "side" (+1 to the right of the line to
-- him, -1 to the left), or nil for a weak push. Toward and away are wide cones
-- (Config.Combo.Toward/Away), so a camera a few degrees off still reads the
-- route the player meant.
function Brawler.classify(a,stick)
 local m=Vector3.new(stick.X,0,stick.Z)
 if m.Magnitude&lt;TUNE.IntentStrong then return nil,0 end
 local line=a.target and a.target.root and flatUnit(a.target.root.Position-a.root.Position)
 line=line or flatUnit(a.root.CFrame.LookVector) or Vector3.new(0,0,-1)
 local u=m.Unit
 local along=u:Dot(line)
 if along&gt;=TUNE.Toward then return "forward",0 end
 if along&lt;=-TUNE.Away then return "back",0 end
 return "side",if u:Dot(line:Cross(UP))&gt;=0 then 1 else -1
end
-- The directional memory: the latest strong push, sampled every frame and at
-- every packet, so a stick released (or crossing the threshold) a moment
-- before the press still picks the route it was pushed for.
function Brawler.observe(c,a)
 a.intentAt=c.now
 local dir,sideSign=Brawler.classify(a,a.move or Vector3.zero)
 if dir then a.intentMemory={dir=dir,side=sideSign,at=c.now} end
end
-- Movement intent read when a press lands: this is what turns one string into
-- a small move graph per character. The current strong push first, else the
-- latest strong push inside Config.Combo.IntentWindow, else neutral. A
-- buffered press replays its own intent (intentOverride); the AI sets one too.
function Brawler.intent(a,now)
 if a.intentOverride then return a.intentOverride[1],a.intentOverride[2] end
 local dir,sideSign=Brawler.classify(a,a.move or Vector3.zero)
 if dir then return dir,sideSign end
 local memory=a.intentMemory
 now=now or a.intentAt or 0
 if memory and now-memory.at&lt;=TUNE.IntentWindow then return memory.dir,memory.side end
 return "neutral",0
end
-- Presses made while the body is committed wait for its outcome: a swing
-- before its contact is known, a chase or a dash before the arrival, a
-- teleport before it lands.
local function bufferable(a)
 local p=a.pending
 if p and p.kind=="Brawl" and (a.state=="Startup" or a.state=="Active") then return true end
 if a.state=="Pursuit" or a.state=="Rush" then return true end
 return p~=nil and p.kind=="Technique" and p.spec.Id=="Flashstep" and (a.state=="TechniqueChannel" or a.state=="TechniqueActive")
end
local function bufferExpiry(a)
 local p=a.pending
 local active=0
 if p and a.state=="Startup" and p.kind=="Brawl" then active=p.spec.active
 elseif p and a.state=="TechniqueChannel" then active=p.spec.Active or 0 end
 return a.untilTime+active+TUNE.Buffer
end
-- Re-engage (CORE_COMBAT_CONVERGENCE_2 §3) -----------------------------------
local REENTRY={name="dash",speed=1,arrive=3.6,angle=0,chase=.3}
function Brawler.reentry(a)
 local graph=Brawler.graph(a)
 return (graph and graph.reengage) or REENTRY
end
-- A chase is over once the body is within reach and no longer escaping faster
-- than an air strike follows (a launched body near its apex, a knocked-away
-- one, a grounded one).
function Brawler.chaseArrived(c,a)
 local b=a.target
 if not b or c.now-(a.pursuitStarted or c.now)&lt;.1 then return false end
 if (b.root.Position-a.root.Position).Magnitude&gt;4.6 then return false end
 local rising=if b.reaction and b.reactionVelocity then b.reactionVelocity.Y else 0
 return rising&lt;=30 or not b.airborne
end
-- The re-entry windows in which a press is the arrival strike (dash attack on
-- the ground, the air string in the air) or the arrival heavy.
function Brawler.arrival(c,a)
 if a.state=="Dodging" then return c.now&gt;=a.untilTime-.23 end
 if a.state=="Rush" then
  local r=a.rush
  if c.now&gt;=a.untilTime-.15 then return true end
  if r and not r.line and a.target then
   local d=a.target.root.Position-a.root.Position
   return Vector3.new(d.X,0,d.Z).Magnitude&lt;=(r.arrive or 3.6)+1.4
  end
  return false
 end
 if a.state=="Pursuit" then return Brawler.chaseArrived(c,a) end
 if (a.rushArriveUntil or 0)&gt;c.now then return a.state=="Neutral" or (a.state=="Recovery" and a.arrivalRecovery==true) end
 return false
end
-- The closest planted (not flying, not body) seal of Minato's near the target.
function Brawler.nearSeal(c,a,b,radius)
 local best,bestGap
 for _,seal in require(script.Parent.Techniques).seals(c,a,c.now) do
  if not seal.flying and not seal.body then
   local d=seal.position-b.root.Position
   local gap=Vector3.new(d.X,0,d.Z).Magnitude
   if gap&lt;=(radius or 12) and (not bestGap or gap&lt;bestGap) then best,bestGap=seal.position,gap end
  end
 end
 return best
end
-- Where a dash arrives: a step short of the body on the centre line, an angle
-- beside it (fixed in the world at the start, so it tracks the body without
-- spiralling), or a point through it for a committed line.
function Brawler.rushGoal(a,r)
 local b=a.target
 local y=a.root.Position.Y
 local there=Vector3.new(b.root.Position.X,y,b.root.Position.Z)
 if r.offset then return there+r.offset end
 local line=flatUnit(b.root.Position-a.root.Position) or flatUnit(a.root.CFrame.LookVector) or Vector3.new(0,0,-1)
 if r.past then return there+line*r.past end
 return there-line*r.arrive
end
function Brawler.rushPlan(c,a,style,line)
 local tune=Config.Rush
 local r={style=style,speed=tune.Speed*(style.speed or 1),arrive=style.arrive or 3.6,recovery=style.recovery or tune.Recovery,from=a.root.Position}
 if line then
  r.line=line;r.goal=c:clamp(a.root.Position+line*tune.Reposition)
  return r
 end
 local b=a.target
 local toward=flatUnit(b.root.Position-a.root.Position) or flatUnit(a.root.CFrame.LookVector) or Vector3.new(0,0,-1)
 local right=toward:Cross(UP)
 local angle=style.angle or 0
 local sign=nil
 if style.sealAngle then
  -- A planted seal near the target pulls the re-entry onto its side.
  local seal=Brawler.nearSeal(c,a,b)
  if seal then
   sign=if (seal-b.root.Position):Dot(right)&gt;=0 then 1 else -1
   angle=style.sealAngle;r.speed*=style.sealPull or 1;r.sealed=true
  end
 end
 if angle&gt;0 then
  if not sign then
   local dir,stickSide=Brawler.classify(a,a.move or Vector3.zero)
   sign=if dir=="side" then stickSide else (a.rushSide or 1)
   -- With no side asked for, the angle alternates from one dash to the next.
   a.rushSide=-sign
  end
  local rad=math.rad(angle)
  r.offset=(-toward*math.cos(rad)+right*sign*math.sin(rad))*r.arrive
  r.side=sign
 end
 if style.past then r.past=style.past;r.commitAt=c.now+(style.commit or 0) end
 r.goal=Brawler.rushGoal(a,r)
 return r
end
-- The dash is over: a short recovery that converts at once into a strike, a
-- heavy or a grab (Brawler.arrival), and into guard / dodge / jump only after
-- Config.Rush.CancelAfter. Nobody answering it leaves a punishable gap.
function Brawler.arrive(c,a)
 local r=a.rush or {}
 a.rush=nil
 local recovery=r.recovery or Config.Rush.Recovery
 c:setState(a,"Recovery",recovery)
 a.recoveryCancelAt=c.now+math.min(Config.Rush.CancelAfter,recovery)
 a.arrivalRecovery=true
 a.rushArriveUntil=c.now+Config.Rush.Arrive
 Brawler.event(c,a,"RushArrive")
end
-- Itachi's feint: guard or dodge during his dash stops it where he is; an
-- afterimage carries on the illusion of the approach.
function Brawler.feintRush(c,a)
 a.rush=nil;a.rushArriveUntil=0;a.aimIntent=nil
 c:setState(a,"Neutral",0)
 c:pushImpact(a.root.Position,"afterimage",false,{owner=a.id,fighter=a.fighterId,variant="feint"})
 Brawler.event(c,a,"RushFeint")
 c:cue(a,"FEINT",.5)
end
-- Pad re-engage: sprint + dodge with the stick toward a locked opponent at
-- mid range (Combat:request turns it into the re-engage).
function Brawler.dashIntent(c,a)
 if not a.sprinting or not a.locked or a.airborne or a.wall or a.def.SandFlicker then return false end
 local b=a.target
 if not b or b.health&lt;=0 then return false end
 -- The current push (a dodge goes where the stick is now), or the bot's own.
 local dir=if a.intentOverride then a.intentOverride[1] else (Brawler.classify(a,a.move or Vector3.zero))
 if dir~="forward" then return false end
 local d=b.root.Position-a.root.Position
 return Vector3.new(d.X,0,d.Z).Magnitude&gt;=(Brawler.reentry(a).minRange or Config.Rush.MinRange)
end
function Brawler.releaseGrab(a)
 local b=a.grabVictim
 if b then b.grabbedBy=nil;b.reaction=nil;b.reactionUntil=0;a.grabVictim=nil end
 if a.grabbedBy then a.grabbedBy.grabVictim=nil;a.grabbedBy=nil end
end
function Brawler.react(c,a,kind,velocity,duration,source)
 Brawler.releaseGrab(a)
 Bangla.close(a.pending)
 -- A guard break or channel interrupt already set a longer stun: the melee
 -- reaction that follows keeps it instead of shortening it to the move's own.
 duration=math.max(duration,(a.stunFloorUntil or 0)-c.now);a.stunFloorUntil=nil
 a.chainOpen=false;a.recoveryCancelAt=nil
 a.reaction=kind;a.reactionUntil=c.now+duration;a.reactionVelocity=velocity
	 a.reactionSource=source
 a.pending=nil;a.buffered=nil;a.attackName=nil;a.guardHeld=false;a.state="Neutral";a.untilTime=c.now
 -- Hit out of it: his own strings and re-entry are over.
 Brawler.resetStrings(a);a.rush=nil;a.arrivalRecovery=nil;a.rushArriveUntil=0
 a.locomotion=Vector3.zero
 if airReactions[kind] then a.airborne=true end
 if kind=="Knockdown" then
  a.invulnerableUntil=c.now+duration+.24
  a.groundPose="Knockdown"
  -- Which side the body rolls onto, taken from the incoming direction.
  local from=a.hitFrom or Vector3.zAxis
  a.groundSide=if a.root.CFrame.RightVector:Dot(from)&gt;=0 then 1 else -1
 end
 if kind=="WallSplat" then a.groundPose="Splat" end
 if not airReactions[kind] then a.groundPose=nil end
end
function Brawler.start(c,a,name)
 Bangla.close(a.pending)
 local spec=table.clone(Attacks[name]);spec.travel*=a.def.CombatTravel or 1
	local profile=a.def.AttackProfile and a.def.AttackProfile[name]
	if profile then
		spec.startup*=profile.startup or 1;spec.active*=profile.active or 1;spec.recovery*=profile.recovery or 1;spec.travel*=profile.travel or 1
		spec.travelTime=spec.startup+spec.active;spec.range=profile.range or spec.range;spec.angle=profile.angle
		spec.zone=profile.zone or spec.zone;spec.kind=profile.kind or spec.kind
		spec.chainTool=profile.chainTool;spec.depth=profile.depth or spec.depth;spec.damageScale=profile.damage;spec.offset=profile.offset or spec.offset;spec.width=profile.width or spec.width;spec.impulse=Vector3.new(spec.impulse.X,profile.impulseY or spec.impulse.Y,profile.impulseZ or spec.impulse.Z)
	end
 a.buffered=nil
 a.attackVariant=nil
 a.hitBlocked=false
 a.attackSerial=(a.attackSerial or 0)+1
 -- String bookkeeping: a chain move records the count it confirms if it
 -- connects (the string continues only while it is alive); a string ender
 -- (third light, route, heavy, grab, slam) closes its string now.
 local air=spec.air==true
 local step=nil
 if spec.chain then
  if not Brawler.stringAlive(c,a,air) then Brawler.breakString(a,air) end
  step=((if air then a.airCombo else a.combo) or 0)+1
 else
  Brawler.breakString(a,air or name=="Slam")
 end
 a.arrivalRecovery=nil
 a.attackName=name;a.attackStarted=c.now;a.hitConfirmed=false;a.chainOpen=false;a.chainAt=c.now+1e9;a.guardHeld=false
 -- The swing must reach the client as fast as the contact it leads to.
 c.urgent=true
 local slamWindow=0
 if name=="Slam" then
  -- Size the descent so the active window provably ends on or near the floor.
  local drop=math.max(6,a.root.Position.Y-(c.match.origin.Y+3.4))
  -- The plunge starts from rest and accelerates at 320 studs/s² up to 118
  -- (Motor.descend): time that fall, not an instant 118, or the window ends in
  -- mid-air and the recovery hovers there.
  local reach=118*118/(2*320)
  local fall=if drop&lt;=reach then math.sqrt(2*drop/320) else 118/320+(drop-reach)/118
  slamWindow=math.clamp(fall+.04,.28,1.1)
 elseif name=="WallDive" then
  -- The dive lasts as long as the flight to the opponent (92 studs/s).
  local gap=(a.target.root.Position-a.root.Position).Magnitude
  slamWindow=math.clamp(gap/88,.16,.5)
 end
 a.pending={kind="Brawl",name=name,spec=spec,hit=false,slamWindow=slamWindow,flow=a.nextFlow==true,step=step}
 if not a.nextFlow then a.flowStreak=0 end
 a.nextFlow=nil
 Bangla.begin(c,a,a.pending)
 a.travelRemaining=spec.travel
 local flat=a.root.CFrame.LookVector*Vector3.new(1,0,1)
 local delta=a.target.root.Position-a.root.Position;delta=delta*Vector3.new(1,0,1)
 if delta.Magnitude&gt;.1 and delta.Magnitude&lt;11 and (flat:Dot(delta.Unit)&gt;.55 or a.locked) then flat=delta.Unit end
 -- Locked on, a strike started mid-run turns into the opponent during its
 -- startup (Combat:turnToward, bounded rate) instead of snapping in one frame.
	local side=a.root.CFrame.RightVector*(spec.angle or 0)
	a.travelDirection=(flat+side).Unit;a.state="Startup";a.untilTime=c.now+spec.startup
 if spec.air or name=="Slam" then a.airHold=c.now+spec.startup+math.max(spec.active,slamWindow)+spec.recovery+.18 end
 -- Lateral routes leave an afterimage where the body was (a flash for Minato).
 if name=="FeintStep" or name=="AirSwitch" or name=="CircleStep" then
  c:pushImpact(a.root.Position,if a.fighterId=="Flashstep" then "quickstep" else "afterimage",false,{owner=a.id,fighter=a.fighterId})
  -- Where the afterimage stays (a skill build's echo payoff turns it into a decoy).
  a.stepFrom=a.root.Position
 end
 if name=="WallDive" then a.airborne=true;a.airHold=c.now+spec.startup end
 Brawler.event(c,a,name)
 return true
end
-- Disengage branch: hop out of the string while a blade (Minato) or a pair of
-- shuriken (Itachi) covers the retreat. Ends the string; buys space, not damage.
function Brawler.disengage(c,a,kind)
 Bangla.close(a.pending);a.pending=nil;a.attackName=nil;a.chainOpen=false;a.buffered=nil
 Brawler.breakString(a,false)
 local away=a.root.Position-a.target.root.Position;away=Vector3.new(away.X,0,away.Z)
 if away.Magnitude&lt;.1 then away=-a.root.CFrame.LookVector end
 local minato=kind=="Kunai"
 a.state="Recovery";a.untilTime=c.now+(if minato then .26 else .32);a.recoveryCancelAt=a.untilTime
 a.hop={direction=away.Unit,remaining=if minato then 5 else 6,speed=if minato then 46 else 38}
 c:beginThrow(a,{kind=kind,release=if minato then .07 else .1,count=if minato then 1 else 2,interval=.07,
  fire=function(index,target)
   local spread=if minato then Vector3.zero else a.root.CFrame.RightVector*(if index==1 then -.7 else .7)
   c:projectile(a,target+spread,if minato then 96 else 84,22,2,if minato then "kunai" else "shuriken")
  end})
 Brawler.event(c,a,"Disengage")
 return true
end
function Brawler.request(c,a,action)
 local relevant=action=="Attack" or action=="Heavy" or action=="Grab" or action=="ThrowUp"
 if not relevant then return nil end
 -- Throw break: grab back right as you are seized and both are thrown apart.
 if action=="Grab" and a.reaction=="Grabbed" and a.grabbedBy and c.now-(a.grabbedAt or -10)&lt;=Config.ThrowBreak then
  local g=a.grabbedBy
  Brawler.releaseGrab(g);Brawler.releaseGrab(a)
  local away=a.root.Position-g.root.Position;away=Vector3.new(away.X,0,away.Z)
  away=if away.Magnitude&gt;.05 then away.Unit else -a.root.CFrame.LookVector
  for _,x in {a,g} do Bangla.close(x.pending);x.pending=nil;x.attackName=nil;x.chainOpen=false;x.state="Recovery";x.untilTime=c.now+.22;x.recoveryCancelAt=c.now+.12 end
  a.hop={direction=away,remaining=3.5,speed=30};g.hop={direction=-away,remaining=3.5,speed=30}
  c:pushImpact(a.root.Position:Lerp(g.root.Position,.5),"clash",true,{direction=away})
  Brawler.event(c,a,"ThrowBreak");c:cue(a,"THROW BREAK",.7);c:cue(g,"THROW BROKEN",.7)
  return true
 end
 if not Brawler.free(a,c.now) then return false,"Reacting" end
 -- Riposte: right after a clean block or a perfect dodge, a strike comes out
 -- at once and opens a string (its contact is the string's first hit).
 if action=="Attack" and (a.riposteUntil or 0)&gt;c.now and (a.state=="Guarding" or a.state=="Neutral" or a.state=="Dodging" or a.state=="Recovery") and not a.airborne then
  a.riposteUntil=0;a.guardHeld=false;a.state="Neutral";a.untilTime=c.now;a.evade=nil
  Brawler.breakString(a,false);a.lastAttack=c.now
  c:cue(a,"RIPOSTE",.6);Brawler.event(c,a,"Riposte")
  return Brawler.start(c,a,"Riposte")
 end
 if a.wall then
  -- From a wall run a strike becomes a dive at the opponent: height and an
  -- angle the guard has to read.
  Motor.detach(a,c.now,false)
  if (action=="Attack" or action=="Heavy") and a.state=="Neutral" and a.target and a.target.health&gt;0
   and (a.target.root.Position-a.root.Position).Magnitude&lt;=Config.Wall.DiveRange then
   return Brawler.start(c,a,"WallDive")
  end
 end
 if a.grabVictim then
  if action=="Attack" or action=="Heavy" or action=="Grab" or action=="ThrowUp" then
   return Brawler.start(c,a,if action=="Heavy" or action=="ThrowUp" then "ThrowUp" else "Throw")
  end
 end
 local pending=a.pending
 local canChain=Brawler.chainWindow(c,a)
 -- Re-entry windows: the end of a dodge, a dash or a chase arrival.
 local canDash=Brawler.arrival(c,a)
 local reentry=canDash and a.state~="Dodging"
 local style=reentry and Brawler.reentry(a)
 -- Rhythm: a chained press made on the beat (around the moment the chain
 -- opens, not mashed early during the swing) becomes a Flow strike. A bonus
 -- only: an off-beat press chains just the same.
 local pressAt=a.pressAt or c.now;a.pressAt=nil
 a.nextFlow=canChain and pressAt&gt;=(a.chainAt or 0)-Config.Flow.Early and pressAt&lt;=(a.chainAt or 0)+Config.Flow.Late
 -- Flying Thunder God arrival: the technique recovery is cancelled by a strike,
 -- so the teleport flows straight into an attack from the new angle. The
 -- arrival strike opens a fresh string.
 local canFlash=(a.state=="TechniqueRecovery" or a.state=="TechniqueActive") and (a.flashUntil or 0)&gt;c.now
  and (a.pending==nil or (a.pending.kind=="Technique" and a.pending.spec.Id=="Flashstep"))
 -- Rotation already repelled a strike and is winding down: the strike comes
 -- straight out of the spin as the counter.
 if action=="Attack" and (a.counterUntil or 0)&gt;c.now and (a.rotationCounterUntil or 0)&gt;c.now and (a.state=="TechniqueActive" or a.state=="TechniqueRecovery") then
  a.pending=nil;a.rotationUntil=0;c:setState(a,"Neutral",0)
  return Brawler.counterStart(c,a)
 end
 -- A strike pressed inside a counter stance (Read, Rotation) waits for the
 -- stance to pay off instead of being refused.
 if action=="Attack" and Brawler.counterStance(a) then a.counterQueued=c.now;return true,"Buffered" end
 if canFlash then
  a.flashUntil=0;a.state="Neutral";a.untilTime=c.now;a.pending=nil;pending=nil
  local gap=(a.target.root.Position-a.root.Position).Magnitude
  if action=="Heavy" then
   if a.airborne then return Brawler.start(c,a,"Slam") end
   return Brawler.start(c,a,"Launcher")
  end
  if action=="Attack" then
   if a.airborne then Brawler.breakString(a,true);a.lastAirAttack=c.now;return Brawler.start(c,a,"Air1") end
   Brawler.breakString(a,false);a.lastAttack=c.now
   return Brawler.start(c,a,if gap&gt;5.5 then "DashAttack" else "Light1")
  end
 end
 if a.state~="Neutral" and a.state~="Guarding" and not canChain and not canDash then
  if bufferable(a) then
   -- Buffer a press made before the outcome of the committed swing, chase,
   -- dash or teleport is known: a press made a few frames early is never
   -- eaten, yet it prepares nothing. It fires when the chain opens (the swing
   -- landed cleanly), on the arrival, or, after a whiff or a block, as a fresh
   -- opener once the full recovery is over. The direction is the one it was
   -- pressed with (or pushed while it waits): Brawler.step.
   local dir,sideSign=Brawler.intent(a)
   a.buffered={action=action,at=c.now,intent={dir,sideSign},explicit=a.intentOverride~=nil,expires=bufferExpiry(a)}
   return true,"Buffered"
  end
  return false,"Committed"
 end
 if action=="Grab" then
  if a.airborne or (a.grabCooldown or 0)&gt;c.now then return false,"Grab unavailable" end
  a.grabCooldown=c.now+1.4;return Brawler.start(c,a,"Grab")
 end
 if action=="ThrowUp" then return false,"No grab" end
 -- Running taijutsu: out of a full sprint the strike becomes a flying kick
 -- and the heavy a sliding sweep.
 if not canChain and not canDash and a.state=="Neutral" and not a.airborne and a.sprinting and a.locomotion.Magnitude&gt;30 then
  if action=="Attack" then return Brawler.start(c,a,"FlyingKick") end
  if action=="Heavy" then return Brawler.start(c,a,"SlideSweep") end
 end
 local graph=Brawler.graph(a) or {}
 local routes=graph.routes or {}
 -- Inside a confirmed string: its chain window picks routes and heavy
 -- conversions; the light step alone also continues in the short grace after
 -- it (a press a moment late is still the next light, never a route).
 local alive=not a.airborne and Brawler.stringAlive(c,a,false)
 local inChain=canChain and alive
 if action=="Heavy" then
  if a.airborne then
   -- Lion Combo: after Shadow of the Dancing Leaf, the heavy is a barrage
   -- that ends in a heel drop driving the body into the floor.
   if (a.lionUntil or 0)&gt;c.now and a.target and a.target.health&gt;0 then
    a.lionUntil=0
    -- The flip over the body: the heel comes down from above it.
    local b=a.target
    local look=b.root.Position-a.root.Position;look=Vector3.new(look.X,0,look.Z)
    look=if look.Magnitude&gt;.1 then look.Unit else a.root.CFrame.LookVector
    c:relocate(a,b.root.Position+Vector3.new(0,2.4,0)-look*1.2)
    a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+look)
    a.airborne=true
    local ok=Brawler.start(c,a,"Slam")
    if a.pending then a.pending.spec.damage=17;a.pending.spec.impulse=Vector3.new(0,-90,8);a.attackVariant="LionBarrage" end
    c:cue(a,"LION COMBO",.9);Brawler.event(c,a,"LionCombo")
    return ok
   end
   return Brawler.start(c,a,"Slam")
  end
  if inChain and a.combo==1 and graph.heavyAfterOne then return Brawler.start(c,a,graph.heavyAfterOne) end
  if inChain and a.combo&gt;=2 then return Brawler.start(c,a,a.def.LauncherMove or "Launcher") end
  -- Heavy on a re-engage arrival: the prodigy's quick heavy (knee, palm),
  -- except on a body pinned to a wall, where the heavy is the wall bounce.
  if reentry and graph.heavyAfterOne and not (a.target and a.target.reaction=="WallSplat") then
   Brawler.event(c,a,"ArrivalHeavy");return Brawler.start(c,a,graph.heavyAfterOne)
  end
  return Brawler.start(c,a,a.def.HeavyMove or "Heavy")
 end
 if a.airborne then
  -- Air grammar: after a confirmed air hit the stick picks the follow-up.
  local airAlive=Brawler.stringAlive(c,a,true)
  if canChain and airAlive and (a.airCombo or 0)&gt;=1 then
   local dir,sideSign=Brawler.intent(a)
   local route=if dir=="forward" then routes.airUp elseif dir=="back" then routes.airDown elseif dir=="side" then routes.airSide else nil
   if route then
    a.angleSide=sideSign;a.lastAirAttack=c.now
    Brawler.event(c,a,"Route");return Brawler.start(c,a,route)
   end
  end
  if not airAlive then Brawler.breakString(a,true) end
  a.lastAirAttack=c.now
  return Brawler.start(c,a,if (a.airCombo or 0)%2==0 then "Air1" else "Air2")
 end
 -- A successful Read (Itachi) pays off with the graph's counter on the next press.
 if action=="Attack" and graph.readCounter and (a.counterUntil or 0)&gt;c.now and not canChain then
  return Brawler.counterStart(c,a)
 end
 -- Directional combo grammar: inside a confirmed string the stick picks the
 -- route. Toward the opponent launches, away goes low, sideways turns the
 -- angle; each fighter answers with its own move.
 if action=="Attack" and inChain then
  local dir,sideSign=Brawler.intent(a)
  local route=nil
  if dir=="forward" and a.combo&gt;=2 then route=routes.up
  elseif dir=="back" and a.combo&gt;=2 then route=routes.down
  elseif dir=="side" and a.combo&gt;=1 then route=routes.side end
  if route and Attacks[route] then
   a.angleSide=sideSign;a.lastAttack=c.now
   Brawler.event(c,a,"Route");Brawler.event(c,a,if dir=="forward" then "RouteUp" elseif dir=="back" then "RouteDown" else "RouteSide")
   return Brawler.start(c,a,route)
  end
 end
 -- The light step follows the confirmed hits: Light1 opens, Light2 after one
 -- confirmed hit, Light3 (the string's end) after two. Out of a string (a
 -- whiff, a block, a pause, a hit taken) it is Light1 again.
 if not alive then Brawler.breakString(a,false) end
 local name="Light"..math.min((a.combo or 0)+1,3)
 a.lastAttack=c.now
 -- Context finisher (Neji): with three chakra points closed, the third palm
 -- becomes the twin-palm thrust that throws the body away.
 if name=="Light3" and a.def.GentleFist and a.target and (a.target.tenketsuUntil or 0)&gt;c.now and (a.target.tenketsu or 0)&gt;=3 then
  return Brawler.start(c,a,"PalmThrust")
 end
 if canDash then
  local ok=Brawler.start(c,a,"DashAttack")
  -- Sasuke's explosive re-entry: the arrival strike lands harder.
  if reentry and style and style.dashDamage and a.pending then
   a.pending.spec.damageScale=(a.pending.spec.damageScale or 1)*style.dashDamage
  end
  return ok
 end
 return Brawler.start(c,a,name)
end
-- What a fighter's own version of a route adds on contact.
function Brawler.routePayoff(c,a,b,p)
 local graph=Brawler.graph(a)
 local kind=graph and graph.onRoute and graph.onRoute[p.name]
 if not kind or b.health&lt;=0 then return end
 local Techniques=require(script.Parent.Techniques)
 if kind=="bodySeal" then
  -- Minato: the rising kick leaves a short seal on the body: 2 follows it up.
  local entry=Techniques.plant(c,a,b.root.Position,Vector3.yAxis,b)
  entry.expires=c.now+1.8
  c:cue(a,"SEALED • 2 TO FOLLOW UP",.8)
 elseif kind=="floorSeal" then
  -- Minato: the sweep plants a marked kunai where the opponent falls.
  local floor=Vector3.new(b.root.Position.X,c.match.origin.Y,b.root.Position.Z)
  Techniques.plant(c,a,floor,Vector3.yAxis)
 elseif kind=="coverBlades" then
  -- Itachi: two shuriken follow the body up, keeping it in the air.
  c:schedule(c.now+.2,function()
   if a.health&lt;=0 or b.health&lt;=0 or c.match.phase~="Duel" then return end
   c:beginThrow(a,{kind="Shuriken",release=.06,count=2,interval=.08,fire=function(index,target)
    local spread=a.root.CFrame.RightVector*(if index==1 then -.6 else .6)
    c:projectile(a,target+spread,92,30,1.5,"shuriken")
   end})
  end)
 elseif kind=="shadowLeaf" then
  -- Sasuke: Shadow of the Dancing Leaf. He shoots up after the rising body
  -- (a free chase); a heavy up there is the Lion Combo.
  a.lionUntil=c.now+2.1
  c:schedule(c.now+.12,function()
   if a.health&lt;=0 or b.health&lt;=0 or c.match.phase~="Duel" or not (b.reaction=="Launched" or b.reaction=="Juggled") then return end
   a.chakra+=Config.PursuitCost
   local from=a.root.Position
   if c:request(a,"Pursuit") then
    -- The shadow sticks to the rising body up to its apex, then hangs there.
    a.untilTime=c.now+.5;a.shadowUntil=a.untilTime;a.airHold=c.now+1.1
    c:pushImpact(from,"afterimage",false,{owner=a.id,fighter=a.fighterId})
    c:cue(a,"SHADOW OF THE DANCING LEAF • HEAVY = LION COMBO",1)
    Brawler.event(c,a,"ShadowLeaf")
   else a.chakra-=Config.PursuitCost end
  end)
 elseif kind=="tenketsu" then
  -- Neji: the low route strikes a second chakra point.
  Brawler.gentleFist(c,a,b,false)
 elseif kind=="echo" then
  -- Itachi (skill build Feint Echo): the feint step's afterimage stays as a
  -- genjutsu decoy; a swing at it is caught (Combat: MirageCatch on a whiff).
  if b.def.Byakugan then c:cue(b,"BYAKUGAN • SEES THROUGH",.8);return end
  b.illusionUntil=c.now+1.2
  b.decoyPosition=c:clamp(a.stepFrom or a.root.Position)
  c:effect("Echo",b.decoyPosition,a.color,Vector3.new(2,5,1),1.2)
  c:pushImpact(a.root.Position,"mirage",false,{owner=a.id,fighter=a.fighterId,to=b.decoyPosition})
  c:cue(a,"ECHO LEFT",.8);c:cue(b,"MIRAGE • TRUST THE BODY",1.2)
 end
end
function Brawler.stopStyle(p)
 if p.name=="Slam" then return "slam" end
 if p.name=="Launcher" or p.name=="ThrowUp" then return "launcher" end
 if p.name=="Heavy" or p.name=="Throw" or p.name=="Light3" then return "finisher" end
 if p.spec and p.spec.air then return "air" end
 return "light"
end
-- Surfaces a flying body can be slammed into: the stadium wall, the field
-- trees and the boulders.
function Brawler.splatSurface(part)
 return part:GetAttribute("NinjaWall")==true or part.Name=="Field tree" or part.Name=="Cover"
end
-- Wall splat: a body carried into a wall hard enough sticks to it for a
-- moment. The attacker chooses: pursue (E), pin it with lighter hits or
-- blades, bounce it back out with a heavy blow, or reset. The defender can
-- tech off the wall on the impact (Q), spend a substitution, or take it.
function Brawler.splat(c,a,hit)
 local tune=Config.Wall
 local normal=Vector3.new(hit.Normal.X,0,hit.Normal.Z)
 normal=if normal.Magnitude&gt;.05 then normal.Unit else -a.root.CFrame.LookVector
 a.reaction="WallSplat";a.reactionUntil=c.now+tune.SplatTime;a.splatAt=c.now;a.splatNormal=normal;a.splatPart=hit.Instance
 a.wallSplats=(a.wallSplats or 0)+1
 a.reactionVelocity=Vector3.zero;a.groundPose="Splat";a.invulnerableUntil=c.now
 a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+normal)
 a.hitstopUntil=math.max(a.hitstopUntil or 0,c.now+.07)
 Brawler.event(c,a,"WallSplat")
 c:pushImpact(hit.Position,"wall",true,{normal=normal,owner=a.id})
 local source=a.reactionSource
 if source and source.health&gt;0 then
  c.damageTag="wall";c:damage(source,a,tune.SplatDamage,false,false);c.damageTag=nil
  if c.match.phase~="Duel" then return end
  a.reaction="WallSplat";a.state="Neutral";a.untilTime=c.now
  source.pursuitUntil=math.max(source.pursuitUntil or 0,c.now+.8)
  Brawler.event(c,source,"WallConvert")
  c:cue(source,"WALL SPLAT • E PURSUE • HEAVY BOUNCE",.8)
 end
 c:cue(a,"WALL SPLAT • Q ON IMPACT TO TECH",.6)
end
-- Wall Palm (skill build): the nearest wall the body can be driven into, within
-- steer.Range and a cone of +-acos(steer.Cone) around the attacker's facing.
-- Returns the flat direction toward it, or nil (the strike keeps its own line).
function Brawler.wallAim(c,a,b,steer)
 local look=a.root.CFrame.LookVector*Vector3.new(1,0,1)
 if look.Magnitude&lt;.05 then return nil end
 look=look.Unit
 local half=math.acos(math.clamp(steer.Cone,-1,1))
 local params=c:rayParams(true)
 local best,bestDistance
 for k=-2,2 do
  local dir=CFrame.fromAxisAngle(Vector3.yAxis,half*k/2):VectorToWorldSpace(look)
  local hit=workspace:Raycast(b.root.Position,dir*steer.Range,params)
  if hit and math.abs(hit.Normal.Y)&lt;.3 and Brawler.splatSurface(hit.Instance) and (not bestDistance or hit.Distance&lt;bestDistance) then
   best,bestDistance=dir,hit.Distance
  end
 end
 if best then c:cue(a,"WALL READ",.6);Brawler.event(c,a,"WallSteer") end
 return best
end
-- Keep a splatted body on the wall a little longer (lighter hits, blades).
function Brawler.pin(c,b,duration,source)
 if b.reaction~="WallSplat" or (b.splatPins or 0)&gt;=Config.Wall.PinMax then return false end
 b.splatPins=(b.splatPins or 0)+1
 b.reactionUntil=math.max(b.reactionUntil,c.now+duration)
 b.reactionVelocity=Vector3.zero
 c:pushImpact(b.root.Position,"pin",false,{owner=source and source.id,normal=b.splatNormal})
 if source then c:cue(source,"WALL PIN",.5) end
 return true
end
-- Hits on a pinned body: a heavy blow (heavy, launcher, Rasengan, dive) bounces
-- it off the wall back into the open for a fresh air phase; lighter hits pin
-- it for a short extension. Both are limited, so a wall is a phase, not a trap.
function Brawler.wallFollow(c,a,b,p)
 -- graph.wallBounce (skill build Trigram Rebound): extra moves that bounce too.
 local bounce=(Brawler.graph(a) or {}).wallBounce
 local heavy=p.name=="Heavy" or p.name=="Launcher" or p.name=="Slam" or p.name=="WallDive" or p.rasengan==true or (bounce~=nil and bounce[p.name]==true)
 if heavy and not b.wallBounced then
  b.wallBounced=true
  local out=b.splatNormal or -a.root.CFrame.LookVector
  Brawler.react(c,b,"Launched",out*24+Vector3.new(0,46,0),1.05,a)
  b.hitstopUntil=math.max(b.hitstopUntil or 0,c.now+.07);a.hitstopUntil=math.max(a.hitstopUntil or 0,c.now+.04)
  a.pursuitUntil=c.now+1.1
  c:pushImpact(b.root.Position-out*1.2,"wallbounce",true,{normal=out,owner=b.id})
  Brawler.event(c,a,"WallBounce");c:cue(a,"WALL BOUNCE • E TO PURSUE",.9)
  return true
 end
 if not heavy and Brawler.pin(c,b,Config.Wall.PinTime,a) then Brawler.event(c,a,"WallPin");return true end
 return false
end
-- Clash: both strikes became active together, facing, in reach. Neither
-- lands; both fighters are pushed apart into a fresh close-range neutral.
function Brawler.clash(c,a,p)
 local b=a.target
 local q=b and b.pending
 if not q or q.kind~="Brawl" or (b.state~="Active" and b.state~="Startup") or b.target~=a or b.hitConfirmed or a.hitConfirmed then return false end
 if q.name=="Grab" or q.name=="Throw" or q.name=="ThrowUp" then return false end
 -- Simultaneous means the two active frames start within the clash window
 -- (the other swing may be a frame or two from becoming active).
 local other=if b.state=="Active" then (b.activeAt or 10) else b.untilTime
 if math.abs((a.activeAt or -10)-other)&gt;Config.Clash.Window then return false end
 local delta=b.root.Position-a.root.Position
 local flat=Vector3.new(delta.X,0,delta.Z)
 if flat.Magnitude&lt;.1 or delta.Magnitude&gt;math.max(p.spec.range or 6,q.spec.range or 6)+1.5 then return false end
 if a.root.CFrame.LookVector:Dot(flat.Unit)&lt;.4 or b.root.CFrame.LookVector:Dot(-flat.Unit)&lt;.4 then return false end
 for _,x in {a,b} do
  Bangla.close(x.pending);x.pending=nil;x.attackName=nil;x.chainOpen=false;x.buffered=nil;x.travelRemaining=0
  -- Neither strike landed: both strings start over.
  Brawler.resetStrings(x)
  x.state="Recovery";x.untilTime=c.now+.24;x.recoveryCancelAt=c.now+.12
  x.hitstopUntil=math.max(x.hitstopUntil or 0,c.now+.08)
 end
 a.hop={direction=-flat.Unit,remaining=Config.Clash.Push,speed=30}
 b.hop={direction=flat.Unit,remaining=Config.Clash.Push,speed=30}
 c:pushImpact(a.root.Position:Lerp(b.root.Position,.5),"clash",true,{direction=flat.Unit})
 Brawler.event(c,a,"Clash");Brawler.event(c,b,"Clash")
 c:cue(a,"CLASH",.6);c:cue(b,"CLASH",.6)
 return true
end
-- Neji's Gentle Fist: palms reach the chakra network. Every palm drains
-- chakra, even through a guard; a clean one closes a chakra point, which slows
-- the victim's chakra recovery for a few seconds (stacks up to four). Each
-- closed point is a real place on the body: the snapshot lists them
-- (tenketsuPoints) and the client lights them, so the network is seen closing.
-- Which point closes follows where the palm landed (the strike's zone).
local TENKETSU_ORDER={
 head={"throat","leftShoulder","rightShoulder","heart","solar","navel","leftHip","rightHip"},
 chin={"throat","heart","leftShoulder","rightShoulder","solar","navel","leftHip","rightHip"},
 body={"heart","solar","navel","leftShoulder","rightShoulder","throat","leftHip","rightHip"},
 legs={"navel","leftHip","rightHip","solar","heart","throat","leftShoulder","rightShoulder"},
}
Brawler.TENKETSU_ORDER=TENKETSU_ORDER
-- Close one point on b; nil when every point is already closed (the palm then
-- only keeps them closed longer).
function Brawler.closePoint(c,a,b,zone)
 local g=a.def.GentleFist
 if (b.tenketsuUntil or 0)&lt;=c.now then b.tenketsu=0;b.tenketsuPoints={} end
 b.tenketsuPoints=b.tenketsuPoints or {}
 b.tenketsuUntil=c.now+g.Duration;b.tenketsuCut=g.RegenCut
 if #b.tenketsuPoints&gt;=g.MaxPoints then b.tenketsu=#b.tenketsuPoints;return nil end
 local closed={}
 for _,id in b.tenketsuPoints do closed[id]=true end
 local point
 for _,id in TENKETSU_ORDER[zone or "body"] or TENKETSU_ORDER.body do if not closed[id] then point=id;break end end
 if not point then return nil end
 table.insert(b.tenketsuPoints,point)
 b.tenketsu=#b.tenketsuPoints
 local severe=b.tenketsu&gt;=g.MaxPoints
 c:pushImpact(b.root.Position,"tenketsu",false,{owner=a.id,fighter=a.fighterId,victim=b.id,point=point,count=b.tenketsu,severe=severe})
 Brawler.event(c,a,"PointClosed")
 if severe then c:cue(b,"CHAKRA NETWORK SEALED",1);Brawler.event(c,a,"Severed") end
 return point
end
-- Every point at once (the last of the Sixty-Four Palms).
function Brawler.sealPoints(c,a,b)
 for _=1,a.def.GentleFist.MaxPoints do if not Brawler.closePoint(c,a,b,"body") then break end end
end
-- `zone`: where the palm landed (defaults to the body's last hit zone);
-- `palm`: a melee contact whose generic hit feedback becomes the palm's.
function Brawler.gentleFist(c,a,b,guarded,zone,palm)
 local g=a.def.GentleFist
 local tune=a.def.Awakening
 local awake=(a.awakenUntil or 0)&gt;c.now and tune
 local boost=if awake then (tune.Drain or 1) else 1
 -- Skill build (Full Field Points): awakened, the palms reach the points
 -- through a guard (full drain and a closed point).
 local through=guarded and awake and tune.GuardPoints==true
 if through then c:cue(a,"FULL FIELD • THROUGH THE GUARD",.5) end
 b.chakra=math.max(0,b.chakra-(if guarded and not through then g.GuardDrain else g.Drain)*boost)
 if guarded and not through then return end
 -- The contact reads as a palm on the network, not a punch: the generic light
 -- hit this blow pushed takes the palm's feedback (sound, flash, camera).
 if palm then
  local last=c.impacts and c.impacts[#c.impacts]
  if last and last.at==c.now and last.style=="light" and (last.position-b.root.Position).Magnitude&lt;1 then last.style="palm";last.owner=a.id end
 end
 zone=zone or b.hitZone or "body"
 -- Byakugan Full Field: he sees the whole network, a clean palm closes two.
 for _=1,(if awake and tune.Points and not guarded then tune.Points else 1) do Brawler.closePoint(c,a,b,zone) end
 -- Full Field: a palm that breaks a jutsu being moulded cuts the flow itself.
 if awake and tune.ChannelCut and b.interruptedAt==c.now then
  b.sealedUntil=math.max(b.sealedUntil or 0,c.now+tune.ChannelCut)
  c:cue(a,"BYAKUGAN • CHAKRA FLOW CUT",.8);c:cue(b,"CHAKRA FLOW SEALED • NO JUTSU",.9)
  Brawler.event(c,a,"FlowCut")
 end
end
-- Counter stances (Itachi's Read, Neji's Rotation): a strike pressed while the
-- stance holds is kept and fires the moment the stance reads or repels.
function Brawler.counterStance(a)
 local p=a.pending
 return (a.state=="TechniqueChannel" or a.state=="TechniqueActive") and p~=nil and p.kind=="Technique" and (p.spec.Id=="Read" or p.spec.Id=="Rotation")
end
-- The graph's counter (CounterPalm, PalmThrust...) out of a read, a repel or a
-- caught genjutsu. With a reach (a caught image, a repelled body) it glides the
-- distance to the body instead of swinging at the air.
function Brawler.counterStart(c,a)
 local graph=Brawler.graph(a) or {}
 if not graph.readCounter or not a.target then return false end
 a.counterUntil=0;a.counterQueued=nil
 local reach=a.counterReach;a.counterReach=nil
 -- The counter opens a fresh string (combo model: hits, not presses).
 Brawler.breakString(a,false)
 local ok=Brawler.start(c,a,graph.readCounter)
 local p=a.pending
 if ok and p and reach and reach.expires&gt;c.now then
  local d=a.target.root.Position-a.root.Position
  local need=math.clamp(Vector3.new(d.X,0,d.Z).Magnitude-(p.spec.contact or 3.6),0,reach.max)
  if need&gt;p.spec.travel then p.spec.travel=need;a.travelRemaining=need end
  a.attackVariant=reach.variant
 end
 Brawler.event(c,a,"Counter")
 return ok
end
function Brawler.hit(c,a,p)
 local b=a.target;local spec=p.spec
 if p.name=="Throw" or p.name=="ThrowUp" then
  b=a.grabVictim
  if not b or b.health&lt;=0 then return false end
  Brawler.releaseGrab(a)
  local direction=if a.move.Magnitude&gt;.2 then a.move.Unit else a.root.CFrame.LookVector
  a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+direction)
 end
 local success,guarded,protected
 if p.name~="Throw" and p.name~="ThrowUp" then
	-- Two strikes meeting in the same instant cancel out.
	if p.name~="Grab" and Brawler.clash(c,a,p) then return false end
	if p.spec.chainTool and not p.chainToolFired then
		p.chainToolFired=true;c:projectile(a,b.root.Position,88,11,2,"needle");Brawler.event(c,a,"ChainTool")
	end
  -- Grab has no donor damage action; donor contact volume still validates it.
  if p.name=="Grab" then
   if not c:targetValid(a,b,spec.range,.05) then return false end
   local donor=p.donor
   donor.hitbox.CFrame=a.root.CFrame*CFrame.new(0,0,-2)
   local params=OverlapParams.new();params.FilterType=Enum.RaycastFilterType.Include;params.FilterDescendantsInstances={b.model}
   if #workspace:GetPartBoundsInBox(donor.hitbox.CFrame,donor.hitbox.Size,params)==0 then return false end
  else
   success,guarded,protected=Bangla.tryHit(c,a,p)
   if not success then return false end
  end
 end
 if p.name=="Grab" then
  if b.invulnerableUntil&gt;c.now or b.grabbedBy or b.reaction=="Wakeup" then return false end
  Brawler.releaseGrab(b);b.pending=nil;b.state="Neutral";b.guardHeld=false
  b.lastHurt=c.now; b.reaction="Grabbed";b.reactionUntil=c.now+.8;b.grabbedBy=a;a.grabVictim=b;b.grabbedAt=c.now
  a.grabUntil=c.now+.8;Brawler.event(c,a,"GrabHit");return true
 end
 if p.name=="Throw" or p.name=="ThrowUp" then
  c.damageTag=p.name;success=c:damage(a,b,spec.damage*(a.def.CombatDamage or 1),false,true);c.damageTag=nil
 end
 if not success or b.health&lt;=0 then return success end
 if protected then return true end
 if a.def.GentleFist then Brawler.gentleFist(c,a,b,guarded,p.spec.zone,true) end
 if p.flow and not guarded and b.health&gt;0 then
  a.flowStreak=(a.flowStreak or 0)+1
  b.hitstopUntil=math.max(b.hitstopUntil or 0,c.now+Config.Flow.Stop)
  c:pushImpact(b.root.Position,"flow",false,{owner=a.id,fighter=a.fighterId,count=a.flowStreak})
  c:cue(a,if a.flowStreak&gt;1 then "FLOW ×"..a.flowStreak else "FLOW",.6)
  Brawler.event(c,a,"Flow")
 end
 if guarded then
  a.hitBlocked=true
  b.riposteUntil=c.now+.34
	 c:applyHitstop(a,b,"block",false)
  Brawler.event(c,b,"GuardHit")
  if p.name=="Heavy" or p.name=="Slam" then b.chakra=math.max(0,b.chakra-25) end
  if b.chakra&lt;=0 then Brawler.react(c,b,"GuardStun",Vector3.zero,.6);b.guardHeld=false
	else
		b.guardImpact=c.now+.18
		local push=if p.name=="Heavy" or p.name=="Slam" or p.name=="Light3" then 1.15 else .42
		Motor.travel(b,c,a.root.CFrame.LookVector,push)
	end
  return true
 end
 local forward=a.root.CFrame.LookVector
 -- Skill build (Wall Palm): the knockback of the listed moves aims at a wall
 -- in reach in front of the attacker, when there is one.
 local steer=a.def.WallSteer
 if steer and steer.Moves[p.name] then forward=Brawler.wallAim(c,a,b,steer) or forward end
 local impulse=forward*spec.impulse.Z+Vector3.yAxis*spec.impulse.Y
 -- What the body took: the client answers a head snap, a fold, a swept base.
 b.hitZone=spec.zone;b.hitKind=spec.kind;b.hitTwist=(spec.side or 1)*(if (a.angleSide or 0)~=0 and spec.orbit then a.angleSide else 1)
 Brawler.routePayoff(c,a,b,p)
 -- Awakening rules on a landed strike (Techniques.awakenedHit/awakenedReact).
 local Techniques=require(script.Parent.Techniques)
 Techniques.awakenedHit(c,a,b,p)
 -- Move-specific weight: a light jab must not stop the fight, a slam must land hard.
 c:applyHitstop(a,b,Brawler.stopStyle(p),false)
 if b.reaction=="WallSplat" and Brawler.wallFollow(c,a,b,p) then Brawler.event(c,a,"Hit");return true end
 Brawler.react(c,b,spec.reaction,impulse,spec.stun,a)
 Techniques.awakenedReact(c,a,b,p)
 -- A combo that runs too long drops the body out of it (with wake-up cover).
 if (b.comboHits or 0)&gt;=Config.ComboScaling.MaxHits and b.reaction~="Knockdown" then
  Brawler.react(c,b,"Knockdown",Vector3.new(impulse.X*.3,math.min(impulse.Y,0)-18,impulse.Z*.3),.5,a)
  c:cue(a,"COMBO LIMIT",.7);Brawler.event(c,a,"ComboLimit")
  return true
 end
 if spec.reaction=="Launched" then a.pursuitUntil=c.now+1.15;Brawler.event(c,a,"LaunchHit") end
 -- Knock-away -&gt; chase -&gt; re-entry: a body sent flying by a strike can be
 -- chased down (E) for a fresh exchange.
 if spec.reaction=="Knockback" and b.reaction=="Knockback" then
  a.pursuitUntil=math.max(a.pursuitUntil or 0,c.now+.8)
  c:cue(a,"KNOCK AWAY • E TO CHASE",.7)
 end
 if p.name=="Air1" or p.name=="Air2" then Brawler.event(c,a,"AirHit") end
 if p.name=="Slam" then Brawler.event(c,a,"SlamHit");a.airHold=0 end
 if p.name=="Throw" or p.name=="ThrowUp" then
  Brawler.event(c,a,"ThrowHit")
  -- Projection -&gt; pursuit: the thrown body can be chased to where it lands.
  if p.name=="Throw" then a.pursuitUntil=math.max(a.pursuitUntil or 0,c.now+.9);c:cue(a,"THROWN • E TO CHASE",.8) end
 end
 Brawler.event(c,a,"Hit");return true
end
function Brawler.step(c,a,dt)
 if a.buffered and c.now&gt;a.buffered.expires then a.buffered=nil end
 if a.grabVictim then
  local b=a.grabVictim
  if c.now&gt;=(a.grabUntil or 0) or a.health&lt;=0 or b.health&lt;=0 then Brawler.releaseGrab(a)
  else
   local pos=a.root.Position+a.root.CFrame.LookVector*2.6
   local delta=pos-b.root.Position
   local grip=b.root.Position+(if delta.Magnitude&gt;.001 then delta.Unit*math.min(delta.Magnitude,26*dt) else Vector3.zero)
   b.root.CFrame=CFrame.lookAt(grip,a.root.Position);b.root.AssemblyLinearVelocity=Vector3.zero;b.hum:Move(Vector3.zero)
  end
 end
 if a.reaction then
  if a.reaction=="Grabbed" then return true end
  -- Bound in sand: held in place until the burial or a substitution.
  if a.reaction=="Bound" and c.now&lt;a.reactionUntil then
   a.hum:Move(Vector3.zero);a.root.AssemblyLinearVelocity=Vector3.zero
   return true
  end
  if c.now&gt;=a.reactionUntil then
   if a.reaction=="WallSplat" and a.airborne and a.root.Position.Y&gt;c.match.origin.Y+5 then
    -- Released high on the wall: drop to the floor, then wake up.
    local normal=a.splatNormal or Vector3.zero
    a.reaction="Knockdown";a.reactionUntil=c.now+.9;a.reactionVelocity=normal*7+Vector3.new(0,-6,0)
    a.groundPose="Knockdown";a.invulnerableUntil=c.now+1.1
   elseif a.reaction=="Knockdown" or a.reaction=="WallSplat" then a.reaction="Wakeup";a.reactionUntil=c.now+.24;a.invulnerableUntil=c.now+.24
   else
    a.reaction=nil;a.reactionVelocity=nil
    -- Fully recovered: drop the grounded presentation state with it.
    a.groundPose=nil
   end
  end
  if a.reaction then
   a.hum:Move(Vector3.zero);a.root.AssemblyLinearVelocity=Vector3.zero
   local velocity=a.reactionVelocity or Vector3.zero
   if a.reaction=="WallSplat" then
    -- Pinned: slide slowly down the wall instead of falling off it.
    velocity=Vector3.new(0,math.max(velocity.Y-30*dt,-11),0)
    local hit=Motor.flight(a,c,velocity*dt)
    if hit and hit.Normal.Y&gt;.5 then velocity=Vector3.zero;a.airborne=false;a.landedAt=c.now end
   elseif airReactions[a.reaction] then
    velocity+=Vector3.new(0,-75*dt,0)
    local hit=Motor.flight(a,c,velocity*dt)
    if hit then
     if hit.Normal.Y&gt;.5 and velocity.Y&lt;0 and a.reaction=="Spiked" and not a.groundBounced then
      -- Ground bounce: the spike drives the body into the floor and it pops
      -- back up once, low, for a pick-up.
      a.groundBounced=true;a.reaction="Juggled";a.reactionUntil=c.now+.62
      velocity=Vector3.new(velocity.X*.3,30,velocity.Z*.3)
      c:pushImpact(a.root.Position-Vector3.new(0,2.6,0),"groundbounce",true,{victim=a.id})
      Brawler.event(c,a,"GroundBounce")
      a.reactionVelocity=velocity;return true
     end
     if hit.Normal.Y&gt;.5 and velocity.Y&lt;0 then
      if a.reaction=="Spiked" then a.reaction="Knockdown";a.groundPose="Knockdown";a.reactionUntil=c.now+.6;a.invulnerableUntil=c.now+.85 end
      if a.reaction=="Knockdown" then a.reactionUntil=math.min(a.reactionUntil,c.now+.55);Brawler.event(c,a,"LandedSlam") end
      -- The body is on the floor now: stop reporting it as airborne so the
      -- presentation plays the grounded pose instead of an air reaction.
      a.airborne=false
      a.landedAt=c.now
      velocity=Vector3.zero
     elseif math.abs(hit.Normal.Y)&lt;.3 and Brawler.splatSurface(hit.Instance) and -velocity:Dot(hit.Normal)&gt;=Config.Wall.SplatSpeed and (a.wallSplats or 0)&lt;2 then
      Brawler.splat(c,a,hit)
      if c.match.phase~="Duel" or not a.reaction then return true end
      velocity=a.reactionVelocity or Vector3.zero
     end
    end
   else
    -- A light hit (HitStun) slides the body back ~0.9 stud, enough for the
    -- string to drive forward instead of the attacker walking into it.
    Motor.travel(a,c,velocity,velocity.Magnitude*dt);velocity*=math.exp(-dt*(if a.reaction=="HitStun" then 8 else 14))
   end
		 a.reactionVelocity=velocity;return true
  end
 end
 local p=a.pending
 if p and p.kind=="Brawl" then
  if a.state=="Active" and not p.hit then
   -- Re-check every active frame. A single early test used to mark the whole
   -- swing as a whiff, so a target that entered the volume one frame later
   -- took no damage from a visibly connected strike.
   -- Contact is this swing's own: a blade, a burn or a cover shuriken landing
   -- while it is out (they also set hitConfirmed) is not the strike connecting.
   a.hitConfirmed=false
   local hit=Brawler.hit(c,a,p)
   if (hit or a.hitConfirmed) and not p.contact then
    p.contact=true
    -- The string's next confirmed hit (a guarded strike confirms nothing).
    if p.step and not a.hitBlocked then Brawler.confirm(c,a,p) end
   end
   p.hit=hit or nil
   a.hitConfirmed=p.contact==true
  end
 end
 local buffered=a.buffered
 if buffered and c.now&gt;buffered.expires then a.buffered=nil;buffered=nil end
 if buffered and not a.reaction and not (a.throwing and c.now&lt;a.throwing.release) then
  -- Released on the chain (the swing before it landed cleanly), on a re-entry
  -- arrival, or once the body is free again: after a whiff or a block the
  -- buffered press is a fresh opener that waited out the whole recovery.
  local canFlash=(a.flashUntil or 0)&gt;c.now and (a.state=="TechniqueRecovery" or a.state=="TechniqueActive")
   and (a.pending==nil or (a.pending.kind=="Technique" and a.pending.spec.Id=="Flashstep"))
  if Brawler.chainWindow(c,a) or Brawler.arrival(c,a) or canFlash or Rules.canAct(a,c.now) then
   a.buffered=nil;a.pressAt=buffered.at
   -- The direction: a strong push made while it waited wins (the latest
   -- intent), else the one it was pressed with.
   local memory=a.intentMemory
   a.intentOverride=if memory and memory.at&gt;buffered.at and not buffered.explicit then {memory.dir,memory.side} else buffered.intent
   Brawler.request(c,a,buffered.action)
   a.intentOverride=nil
  end
 end
 return false
end
return Brawler
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND26">
        <Properties>
          <string name="Name">BuildPresets</string>
          <ProtectedString name="Source">-- Example ranked builds (PROG-002) and AI budget builds (PROG-003). Every
-- preset is an ordinary build of the fighter's skill tree: Matches validates it
-- through SkillBuilds like a player's, so an AI gets choices, never hidden
-- stats. AI presets favour nodes the current AI already exercises (passive
-- rules, routes, defence riders) over inputs it never makes.
local Presets={}
-- Budget per AI tier: Min/Max skill points, or within NearMax of the fighter's
-- playable maximum (SkillBuilds.maxCost(fighter,true)).
Presets.AITiers={
	{Id="Beginner",Min=20,Max=30},
	{Id="Medium",Min=40,Max=50},
	{Id="Hard",Min=60,Max=70},
	{Id="Boss",Min=80,Max=100},
	{Id="Legendary",NearMax=8},
}
Presets.AI={
	Flashstep={
		Beginner={Why="Seals that survive his substitution: the base loop, a little more forgiving.",
			Nodes={"FlashEconomy","SealCraft","ReturnSeal","DeepReserves","Endurance"}},
		Medium={Why="Adds the air spike that plants a destination and a cheaper Rasengan.",
			Nodes={"FlashEconomy","SealCraft","ReturnSeal","DeepReserves","Endurance","SpikeAnchor","RasenganFocus","QuickHands"}},
		Hard={Why="Rasengan drive pick-ups, longer seals and a parry that seals the attacker.",
			Nodes={"FlashEconomy","SealCraft","ReturnSeal","DeepReserves","Endurance","SpikeAnchor","RasenganFocus","QuickHands","RasenganDrive","SealInk","ParrySeal"}},
		Boss={Why="The full relocation fighter: string teleports and air exits.",
			Nodes={"FlashEconomy","SealCraft","ReturnSeal","DeepReserves","Endurance","SpikeAnchor","RasenganFocus","QuickHands","RasenganDrive","SealInk","ParrySeal","StringFlash","AirExit","LongSeal"}},
		Legendary={Why="Everything, with the floor-seal air spike.",
			Nodes={"SealInk","LongSeal","SealCraft","KunaiRecall","ReturnSeal","FlashEconomy","StringFlash","SpikeAnchor","AirExit","ParrySeal","YellowFlow","QuickstepCut","GaleChase","RasenganFocus","RasenganDrive","DeepReserves","Endurance","QuickHands"}},
	},
	Mirage={
		Beginner={Why="Crow counter and blades: calm defence first.",
			Nodes={"EconomicRead","CrowCounter","Precision","WideFan","SteadyBreath"}},
		Medium={Why="A longer Read and ricochets that lead to a chase.",
			Nodes={"EconomicRead","CrowCounter","Precision","WideFan","SteadyBreath","QuickRead","PatientRead","RicochetChase"}},
		Hard={Why="Feint echoes and the palm that finds the wall.",
			Nodes={"EconomicRead","CrowCounter","Precision","WideFan","SteadyBreath","QuickRead","PatientRead","RicochetChase","FeintEcho","WallPalm","Composure"}},
		Boss={Why="Flank blades and burning geometry: every angle is covered.",
			Nodes={"EconomicRead","CrowCounter","Precision","WideFan","SteadyBreath","QuickRead","PatientRead","RicochetChase","FeintEcho","WallPalm","Composure","FlankBlades","FireTempo","FireGeometry"}},
		Legendary={Why="Everything, with the patient Read and the awakened reflex.",
			Nodes={"QuickRead","EconomicRead","PatientRead","MirageReflex","CrowCounter","Precision","WideFan","RicochetChase","FlankBlades","FeintEcho","WallPalm","ShortSigns","PhoenixVolley","FireTempo","FireGeometry","SteadyBreath","Composure"}},
	},
	GentleFist={
		Beginner={Why="The Rotation defence and a second point on the circular step.",
			Nodes={"SwiftRotation","WideDome","PrecisePalms","PointStep","Conditioning"}},
		Medium={Why="Blades come back off the dome; the vacuum palm closes points.",
			Nodes={"SwiftRotation","WideDome","PrecisePalms","PointStep","Conditioning","ReturningRotation","VacuumEconomy","SealingPalm"}},
		Hard={Why="The outside-step substitution and deeper points.",
			Nodes={"SwiftRotation","WideDome","PrecisePalms","PointStep","Conditioning","ReturningRotation","VacuumEconomy","SealingPalm","NarrowBlindSpot","OutsideStep","DeepPoints"}},
		Boss={Why="Redirecting parries, wall rebounds and a lasting seal.",
			Nodes={"SwiftRotation","WideDome","PrecisePalms","PointStep","Conditioning","ReturningRotation","VacuumEconomy","SealingPalm","NarrowBlindSpot","OutsideStep","DeepPoints","RedirectParry","TrigramRebound","LingeringSeal"}},
		Legendary={Why="Everything, with the 64 Palms string ender.",
			Nodes={"PrecisePalms","DeepPoints","PointStep","PalmBarrage","FullFieldPoints","SwiftRotation","WideDome","ReturningRotation","NarrowBlindSpot","RedirectParry","OutsideStep","VacuumEconomy","SealingPalm","LingeringSeal","TrigramRebound","Conditioning","ChakraControl","ChakraReserve"}},
	},
	Lion={
		Beginner={Why="The Dancing Leaf from the heavy and cheaper fire.",
			Nodes={"DancingLeaf","FireMastery","PhoenixTempo","Stamina","ChakraFlow"}},
		Medium={Why="Wired flames into the Dragon Flame, sharper eyes.",
			Nodes={"DancingLeaf","FireMastery","PhoenixTempo","Stamina","ChakraFlow","ShurikenFan","WiredFlames","SharperEyes"}},
		Hard={Why="Sharingan counters, a faster Chidori, a lighter curse.",
			Nodes={"DancingLeaf","FireMastery","PhoenixTempo","Stamina","ChakraFlow","ShurikenFan","WiredFlames","SharperEyes","SharinganCounter","ChidoriFocus","CurseControl"}},
		Boss={Why="Blood for chakra and the counter-rush: the cornered assault.",
			Nodes={"DancingLeaf","FireMastery","PhoenixTempo","Stamina","ChakraFlow","ShurikenFan","WiredFlames","SharperEyes","SharinganCounter","ChidoriFocus","CurseControl","CurseBlood","CounterRush"}},
		Legendary={Why="Everything, with the wired flames.",
			Nodes={"DancingLeaf","SharperEyes","SharinganCounter","CounterRush","ShurikenFan","BlockedTool","WireCancel","WiredFlames","FireMastery","PhoenixTempo","ChidoriFocus","ChidoriEconomy","WallChidori","CurseControl","CurseBlood","Stamina","ChakraFlow","Reserves"}},
	},
}
-- One example build per ranked bracket: what a fighter looks like at that budget.
Presets.Ranked={
	Flashstep={
		Fundamentals={Why="Teleport strings, kunai recall and the quickstep cut.",
			Nodes={"FlashEconomy","StringFlash","SealInk","KunaiRecall","QuickstepCut","DeepReserves","Endurance"}},
		Identity={Why="The air chain: switch seal and air exits.",
			Nodes={"FlashEconomy","StringFlash","SealInk","KunaiRecall","QuickstepCut","DeepReserves","Endurance","AirSwitchSeal","AirExit","SealCraft","LongSeal","QuickHands"}},
		Advanced={Why="Return seals and the gust that re-enters.",
			Nodes={"FlashEconomy","StringFlash","SealInk","KunaiRecall","QuickstepCut","DeepReserves","Endurance","AirSwitchSeal","AirExit","SealCraft","LongSeal","QuickHands","ReturnSeal","RasenganFocus","GaleChase"}},
		Endgame={Why="The whole tree with the switch seal.",
			Nodes={"SealInk","LongSeal","SealCraft","KunaiRecall","ReturnSeal","FlashEconomy","StringFlash","AirSwitchSeal","AirExit","ParrySeal","YellowFlow","QuickstepCut","GaleChase","RasenganFocus","RasenganDrive","DeepReserves","Endurance","QuickHands"}},
	},
	Mirage={
		Fundamentals={Why="Read cancels, ricochet chases, the feint echo and the crow counter.",
			Nodes={"QuickRead","ReadCancel","Precision","RicochetChase","FeintEcho","EconomicRead","CrowCounter"}},
		Identity={Why="Geometry everywhere: wall palm, wide fan, flank blades.",
			Nodes={"QuickRead","ReadCancel","Precision","RicochetChase","FeintEcho","EconomicRead","CrowCounter","WallPalm","WideFan","FlankBlades","SteadyBreath"}},
		Advanced={Why="Adds burning geometry.",
			Nodes={"QuickRead","ReadCancel","Precision","RicochetChase","FeintEcho","EconomicRead","CrowCounter","WallPalm","WideFan","FlankBlades","SteadyBreath","FireTempo","FireGeometry","Composure"}},
		Endgame={Why="The whole tree with the Read cancel.",
			Nodes={"QuickRead","EconomicRead","ReadCancel","MirageReflex","CrowCounter","Precision","WideFan","RicochetChase","FlankBlades","FeintEcho","WallPalm","ShortSigns","PhoenixVolley","FireTempo","FireGeometry","SteadyBreath","Composure"}},
	},
	GentleFist={
		Fundamentals={Why="Kaiten cancels, returning blades, redirecting parries.",
			Nodes={"PrecisePalms","KaitenCancel","SwiftRotation","ReturningRotation","NarrowBlindSpot","RedirectParry","Conditioning"}},
		Identity={Why="Points everywhere: step, sealing palm, outside step.",
			Nodes={"PrecisePalms","KaitenCancel","SwiftRotation","ReturningRotation","NarrowBlindSpot","RedirectParry","Conditioning","PointStep","VacuumEconomy","SealingPalm","OutsideStep","ChakraControl"}},
		Advanced={Why="Wall rebounds and a wider dome.",
			Nodes={"PrecisePalms","KaitenCancel","SwiftRotation","ReturningRotation","NarrowBlindSpot","RedirectParry","Conditioning","PointStep","VacuumEconomy","SealingPalm","OutsideStep","ChakraControl","TrigramRebound","WideDome","DeepPoints"}},
		Endgame={Why="The whole tree with the 64 Palms ender.",
			Nodes={"PrecisePalms","DeepPoints","PointStep","PalmBarrage","FullFieldPoints","SwiftRotation","WideDome","ReturningRotation","NarrowBlindSpot","RedirectParry","OutsideStep","VacuumEconomy","SealingPalm","LingeringSeal","TrigramRebound","Conditioning","ChakraControl","ChakraReserve"}},
	},
	Lion={
		Fundamentals={Why="Dancing Leaf from the heavy, Sharingan counters, wire cancels.",
			Nodes={"DancingLeaf","SharperEyes","SharinganCounter","BlockedTool","WireCancel","ChidoriFocus","Stamina"}},
		Identity={Why="Wire pins on the walls and the counter-rush.",
			Nodes={"DancingLeaf","SharperEyes","SharinganCounter","BlockedTool","WireCancel","ChidoriFocus","Stamina","ShurikenFan","WirePin","CounterRush","FireMastery","ChakraFlow"}},
		Advanced={Why="A cheaper, faster Chidori and a lighter curse.",
			Nodes={"DancingLeaf","SharperEyes","SharinganCounter","BlockedTool","WireCancel","ChidoriFocus","Stamina","ShurikenFan","WirePin","CounterRush","FireMastery","ChakraFlow","CurseControl","ChidoriEconomy","PhoenixTempo","Reserves"}},
		Endgame={Why="The whole tree with the wall wire.",
			Nodes={"DancingLeaf","SharperEyes","SharinganCounter","CounterRush","ShurikenFan","BlockedTool","WireCancel","WirePin","FireMastery","PhoenixTempo","ChidoriFocus","ChidoriEconomy","WallChidori","CurseControl","CurseBlood","Stamina","ChakraFlow","Reserves"}},
	},
}
function Presets.tier(id)
	for _,tier in Presets.AITiers do if tier.Id==id then return tier end end
	return nil
end
-- A copy of a preset's node list, or nil when it does not exist.
function Presets.ai(fighterId,tier)
	local preset=Presets.AI[fighterId] and Presets.AI[fighterId][tier]
	return preset and table.clone(preset.Nodes)
end
function Presets.ranked(fighterId,bracketId)
	local preset=Presets.Ranked[fighterId] and Presets.Ranked[fighterId][bracketId]
	return preset and table.clone(preset.Nodes)
end
return Presets
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND27">
        <Properties>
          <string name="Name">Combat</string>
          <ProtectedString name="Source">local Shared = game:GetService("ReplicatedStorage").NinjaDuel
local Config = require(Shared.Config)
local Fighters = require(Shared.Fighters)
local Rules = require(Shared.Rules)
local World = require(script.Parent.World)
local Motor = require(script.Parent.Motor)
local Animation = require(script.Parent.Animation)
local Techniques = require(script.Parent.Techniques)
local Brawler = require(script.Parent.Brawler)
local Bangla = require(script.Parent.BanglaCombat)
local Evade = require(script.Parent.BanglaEvade)
local HitDetection = require(script.Parent.VelmoraHitDetection)
local Defense = require(script.Parent.VelmoraDefense)
local Combat = {}; Combat.__index = Combat
function Combat.new(match)
	return setmetatable({match=match,now=0,actors={},effects={},projectiles={},hazards={},historyAt=0,impacts={},impactSerial=0,projectileSerial=0},Combat)
end
-- Where a thrown or breathed object physically leaves the body. Server-side
-- approximation of the animated hand/mouth so the projectile's first frame is
-- where the throwing arm actually is, not the middle of the chest.
local LAUNCH={
	Kunai={side=1.15,up=.95,forward=1.1},MarkedKunai={side=1.15,up=1.05,forward=1.1},Palm={side=.2,up=.9,forward=1.9},Ground={side=0,up=-2.2,forward=2.2},
	Shuriken={side=-1.1,up=.9,forward=1.2},Fireball={side=0,up=2.1,forward=2.6},Wind={side=.6,up=1,forward=2.2},
}
function Combat.launchPoint(a,kind)
	local spec=LAUNCH[kind] or {side=0,up=.6,forward=1.4}
	local cf=a.root.CFrame
	return cf.Position+cf.RightVector*spec.side+Vector3.yAxis*spec.up+cf.LookVector*spec.forward
end
-- `kit` (optional) is a validated skill build from SkillBuilds: its own copy
-- of the definition and move graph with the active nodes applied. Without one
-- the actor reads Fighters/MoveGraphs directly: today's fighter, unchanged.
function Combat:add(id,model,hum,root,joints,definition,kit)
	assert(kit==nil or kit.fighterId==definition,"Skill build does not belong to "..tostring(definition))
	local def = if kit then kit.def else Fighters[definition]
	if kit then hum.MaxHealth=def.Health;hum.Health=def.Health;hum.WalkSpeed=def.Speed end
	local a = { id=id,fighterId=definition,model=model,hum=hum,root=root,joints=joints,def=def,health=def.Health,
		graph=kit and kit.graph,build=kit and {nodes=table.clone(kit.nodes),spent=kit.spent,bracket=kit.bracket},
		chakra=def.Chakra or Config.Chakra,state="Neutral",untilTime=0,lockUntil=0,cooldowns={},move=Vector3.zero,
		combo=0,lastAttack=-10,readUntil=0,illusionUntil=0,bonusUntil=0,dodgeUntil=0,invulnerableUntil=0,
		color=Color3.fromRGB(table.unpack(def.Color)),guardHeld=false,lastMove=0, cue="",cueUntil=0,
		locomotion=Vector3.zero,sprinting=false,airborne=false,airDodgeUsed=false,landUntil=0,
		pursuitUntil=0,travelRemaining=0,travelDirection=Vector3.zero,chainOpen=false,hitConfirmed=false,airHold=0,
		subCharges=Config.Substitution.Charges,subCooldown=0,subRegenAt=math.huge,lastHurt=-10,neutralToolAt=0,wall=nil,wallNext=0,
		comboHits=0,comboDamage=0,anchors={},
		shieldCharges=def.SandShield and def.SandShield.Charges or 0,shieldRegenAt=0 }
	table.insert(self.actors,a)
	Defense.init(a)
	-- The client motion engine owns every pose. Server Animator tracks (Roblox
	-- default walk/run/idle, donor punches) replicate to clients and overwrote
	-- that motion, so they only play when explicitly enabled.
	if Config.DonorAnimations then Animation.attach(a) end
	return a
end
-- The tournament stage is round: positions are held inside a circle so no
-- corner of the old square limit reaches into the stands.
function Combat:clamp(p)
	local o=self.match.origin; local r=Config.ArenaRadius
	local flat=Vector3.new(p.X-o.X,0,p.Z-o.Z)
	if flat.Magnitude&gt;r then flat=flat.Unit*r end
	return Vector3.new(o.X+flat.X,math.clamp(p.Y,o.Y+3,o.Y+Config.ArenaHeight),o.Z+flat.Z)
end
function Combat:relocate(a,p)
	-- A real teleport (seal, substitution, setup): the client snaps on it and
	-- smooths everything else.
	a.warpSerial=(a.warpSerial or 0)+1
	local look=a.root.CFrame.LookVector
	a.model:PivotTo(CFrame.lookAt(self:clamp(p),self:clamp(p)+Vector3.new(look.X,0,look.Z)))
	a.root.AssemblyLinearVelocity=Vector3.zero
end
function Combat:rayParams(excludeActors)
	local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude
	local exclude={self.match.effects}
	if excludeActors then for _,a in self.actors do table.insert(exclude,a.model) end end
	params.FilterDescendantsInstances=exclude
	return params
end
function Combat:overlapParams()
	local p=OverlapParams.new(); p.FilterType=Enum.RaycastFilterType.Exclude
	local exclude={self.match.effects}; for _,a in self.actors do table.insert(exclude,a.model) end
	p.FilterDescendantsInstances=exclude; return p
end
function Combat:lineOfSight(a,b)
	local delta=b.root.Position-a.root.Position
	return workspace:Raycast(a.root.Position,delta,self:rayParams(true)) == nil
end
function Combat:targetValid(a,b,range,facing)
	if not b or b.health&lt;=0 then return false end
	local roots={};for _,candidate in self.actors do table.insert(roots,candidate.root) end
	local angle=math.deg(math.acos(math.clamp(facing,-1,1)))
	-- Resolve each active-window sample against the newest recorded pose; the short
	-- history keeps interpolation stable without freezing a target at button-down.
	local root=HitDetection.resolve(a.root,range,angle,a.root.Position,a.root.CFrame.LookVector,self.now,roots,self.match.effects)
	return root==b.root
end
-- Server effects are logical markers only (anchor, echo, hitbox lifetimes).
-- Everything the player sees is drawn by the client from the snapshot and the
-- contact feed; the old translucent neon blocks read as debug geometry.
function Combat:effect(name,p,color,size,lifetime)
	local v=World.part(self.match.effects,name,size,CFrame.new(p),color,Enum.Material.Neon)
	v.CanCollide=false; v.CanQuery=false; v.CanTouch=false; v.Transparency=1; v.CastShadow=false
	table.insert(self.effects,{part=v,expires=self.now+lifetime})
	return v
end
function Combat:addHazard(a,position,radius,duration,damage,kind)
	local hazard={a=a,position=position,radius=radius,expires=self.now+duration,damage=damage,kind=kind,lastHit={}}
	table.insert(self.hazards,hazard)
	return hazard
end
-- Hitstop budget by impact weight. Only the defender stops, and only briefly:
-- freezing both actors on every light made a normal combo read as
-- move -&gt; stop -&gt; move -&gt; stop.
local HITSTOP={light=0,air=0,block=.01,finisher=.05,launcher=.06,parry=.075,slam=.09,jutsu=.065,default=.025}
Combat.Hitstop=HITSTOP
function Combat:applyHitstop(attacker,victim,style,heavy)
	local stop=HITSTOP[style] or (if heavy then HITSTOP.default else 0)
	if stop&lt;=0 then return stop end
	victim.hitstopUntil=math.max(victim.hitstopUntil or 0,self.now+stop)
	-- The attacker only joins on a genuinely heavy contact.
	if heavy then attacker.hitstopUntil=math.max(attacker.hitstopUntil or 0,self.now+stop*.5) end
	return stop
end
-- Short feed of contacts that actually happened. Snapshots carry it so the
-- client can layer sound and VFX on the real contact frame, never on the press.
function Combat:pushImpact(position,style,heavy,extra)
	local feed=self.impacts or {}
	self.impacts=feed
	self.impactSerial=(self.impactSerial or 0)+1
	local role="neutral"
	for _,actor in self.actors do
		if actor.root and (actor.root.Position-position).Magnitude&lt;4.5 then
			role=if actor.health&gt;0 then "victim" else "neutral"
			break
		end
	end
	local entry={style=style,at=self.now,position=position,heavy=heavy==true,serial=self.impactSerial,role=role}
	-- Optional context (projectile id, surface normal, teleport endpoints, owner)
	-- so the client can finish the exact object it was drawing.
	if extra then for k,v in extra do entry[k]=v end end
	table.insert(feed,entry)
	while #feed&gt;12 do table.remove(feed,1) end
	-- Contacts are worth a snapshot now rather than at the next 50 ms tick.
	self.urgent=true
	return self.impactSerial
end
function Combat:cue(a,message,duration)
	a.cue=message; a.cueUntil=self.now+(duration or 1.1)
	if self.match.onCue then self.match.onCue(a,message) end
end
function Combat:setState(a,state,duration)
	a.state=state; a.untilTime=self.now+duration
	-- Chain and cancel windows belong to the attack recovery that computes them
	-- right after this call; any other state change must not inherit stale ones
	-- (a substitution or awaken recovery used to open a string-cancel). The
	-- same holds for a re-engage arrival (Brawler.arrive sets it after this).
	a.chainOpen=false; a.recoveryCancelAt=nil; a.arrivalRecovery=nil
end
-- Strikes that crack Gaara's sand shield outright (the rest each cost a charge).
local SHIELD_BREAKERS={Heavy=true,Launcher=true,Light3=true,Slam=true,KneeStrike=true,FlyingKick=true,PalmThrust=true,CounterPalm=true,WallDive=true,SandPillar=true}
function Combat:damage(attacker,victim,amount,heavy,readEligible)
	if self.match.phase~="Duel" or self.match.finishing or victim.health&lt;=0 or attacker.health&lt;=0 then return false end
	-- Inside Rotation nothing reaches Neji; the dome answers on its own step.
	if (victim.rotationUntil or 0)&gt;self.now then return false end
	if victim.wall then Motor.detach(victim,self.now,false) end
	-- A blade is judged from where it came from (a redirected shuriken reaches
	-- the flank even when the thrower stands in front).
	local delta=(self.hitOrigin or attacker.root.Position)-victim.root.Position
	local frontal=delta.Magnitude&lt;0.1 or victim.root.CFrame.LookVector:Dot(delta.Unit)&gt;0.15
	-- Byakugan: the guard covers every side but a narrow blind spot behind.
	if victim.def.Byakugan and delta.Magnitude&gt;=0.1 then
		local full=(victim.awakenUntil or 0)&gt;self.now and victim.def.Awakening and victim.def.Awakening.NoBlindSpot
		frontal=full or victim.root.CFrame.LookVector:Dot(delta.Unit)&gt;-victim.def.Byakugan.BlindSpot
	end
	-- Sharingan tracking: a raised guard follows a teleport instead of being crossed up.
	if not frontal and victim.def.Sharingan and victim.guardHeld and attacker.teleportAt and self.now-attacker.teleportAt&lt;.7 then
		frontal=true
		local flat=Vector3.new(delta.X,0,delta.Z)
		if flat.Magnitude&gt;.1 then victim.root.CFrame=CFrame.lookAt(victim.root.Position,victim.root.Position+flat) end
		self:cue(victim,"SHARINGAN • TRACKED",.7)
	end
	-- Sharingan Read: the blow is seen coming (VelmoraDefense.read).
	if readEligible and frontal and victim.readUntil&gt;self.now then return Defense.read(self,attacker,victim) end
	-- Gaara's sand shield stops the hit by itself while it has charges.
	local shield=victim.def.SandShield
	-- Not while he is attacking or recovering from it: a whiffed lash is the opening.
	if shield and (victim.shieldCharges or 0)&gt;0 and victim.state~="Startup" and victim.state~="Active" and victim.state~="Recovery" and victim.state~="Stunned"
		and not victim.reaction and not victim.grabbedBy and victim.invulnerableUntil&lt;=self.now then
		local breaking=heavy or amount&gt;=shield.Break or SHIELD_BREAKERS[attacker.attackName or ""]==true
		victim.shieldCharges=if breaking then 0 else victim.shieldCharges-1
		victim.shieldRegenAt=self.now+shield.Regen
		-- The sand absorbs the blow but the string keeps its rhythm: pressing on
		-- (light, light, third hit) is how the shield is cracked.
		attacker.hitConfirmed=true
		local face=if delta.Magnitude&gt;.1 then delta.Unit else victim.root.CFrame.LookVector
		self:pushImpact(victim.root.Position+face*1.6,"sandshield",breaking,{owner=victim.id,direction=face})
		Brawler.event(self,victim,"SandShield")
		if breaking then
			self:setState(victim,"Stunned",.5)
			self:cue(victim,"SAND SHIELD BROKEN",.8);self:cue(attacker,"SAND SHIELD BROKEN",.8)
		else self:cue(victim,"SAND SHIELD",.4) end
		return false
	end
	local counterBefore=victim.counterUntil
	local outcome,resolved=Defense.resolve(self,attacker,victim,amount,frontal,readEligible)
	-- Skill build (Mirage Reflex): the read that just opened a Sharingan counter
	-- also leaves a genjutsu decoy while awakened.
	if (outcome=="Evaded" or outcome=="Parried") and victim.counterUntil~=counterBefore then self:reflexEcho(victim,attacker) end
	-- A guard break keeps its full stun through the melee reaction that follows.
	if outcome=="GuardBreak" then victim.stunFloorUntil=victim.untilTime end
	if outcome=="Evaded" then Brawler.event(self,victim,"Evaded");self:cue(victim,"EVADED");return false end
	if outcome=="Parried" then
		Brawler.event(self,victim,"Parry")
		if readEligible then Brawler.event(self,attacker,"Parried") end
		local style=if readEligible then "parry" else "deflect"
		victim.impactStyle=style;victim.impactAt=self.now
		self:pushImpact(victim.root.Position,style,false)
		self:effect("Parry",victim.root.Position,Color3.fromRGB(255,236,145),Vector3.new(3.8,3.8,3.8),.16)
		if readEligible then self:parryRider(victim,attacker) end
		return false
	end
	amount=resolved
	local guarded=outcome=="Blocked"
	if guarded then
		self:cue(victim,"GUARDED")
	else
		local interrupted=Rules.interruptible(victim)
		local protected= victim.state=="TechniqueChannel" and victim.pending and not victim.pending.spec.Interruptible
		if not protected then
			Brawler.releaseGrab(victim)
			victim.pending=nil; victim.readUntil=0; victim.guardHeld=false
			if outcome~="GuardBreak" then self:setState(victim,"Stunned",if interrupted then Config.InterruptStun else Config.HitStun) end
			if interrupted then victim.stunFloorUntil=victim.untilTime end
			if interrupted then victim.interruptedAt=self.now; Brawler.event(self,attacker,"Interrupt"); self:cue(victim,"INTERRUPTED"); self:cue(attacker,"CHANNEL INTERRUPTED") end
		end
	end
	if attacker.bonusUntil&gt;self.now then amount*=1.35; attacker.bonusUntil=0 end
	if (attacker.awakenUntil or 0)&gt;self.now then amount*=attacker.def.Awakening.Damage or 1 end
	-- An awakening with a price (the Curse Mark): the body that carries it takes more.
	if (victim.awakenUntil or 0)&gt;self.now and victim.def.Awakening then amount*=1+(victim.def.Awakening.Vulnerability or 0) end
	-- Combo scaling: the opening hits of a combo land in full, every later hit
	-- is worth less. Long routes stay possible; they just stop being lethal.
	if not guarded then
		local tune=Config.ComboScaling
		local n=victim.comboHits or 0
		if n&gt;=tune.Free then amount*=math.max(tune.Floor,1-tune.Step*(n-tune.Free+1)) end
		victim.comboHits=n+1;victim.comboDamage=(victim.comboDamage or 0)+amount;victim.comboBy=attacker
	end
	victim.lastHurt=self.now
	victim.health=math.max(0,victim.health-amount); victim.hum.Health=math.max(1,victim.health)
	-- Studio tooling only: where damage comes from, to tune fight length.
	if self.damageLog then table.insert(self.damageLog,{t=self.now,by=attacker.fighterId,amount=amount,tag=self.damageTag or "other",hits=victim.comboHits}) end
	victim.impactSerial=(victim.impactSerial or 0)+1; victim.impactHeavy=heavy or amount&gt;=12
	local style=(if guarded then "block" elseif heavy and amount&gt;=16 then "slam" elseif heavy then "launcher" elseif amount&gt;=20 then "finisher" else "light")
	victim.impactStyle=style
	victim.impactAt=self.now
	-- Direction and weight of the contact so the victim's body can answer the
	-- hit it actually took instead of playing one generic recoil.
	local toward=Vector3.new(delta.X,0,delta.Z)
	if toward.Magnitude&gt;.05 then
		victim.hitFrom=toward.Unit
		local facing=Vector3.new(victim.root.CFrame.LookVector.X,0,victim.root.CFrame.LookVector.Z)
		if facing.Magnitude&gt;.05 then
			facing=facing.Unit
			victim.hitAngle=math.deg(math.atan2(facing:Cross(victim.hitFrom).Y,facing:Dot(victim.hitFrom)))
		else
			victim.hitAngle=0
		end
	else
		victim.hitFrom=Vector3.zAxis
		victim.hitAngle=0
	end
	victim.hitStrength=math.clamp(amount/26,0,1)
	-- Seed the stop; Brawler adds the exact per-move weight once it knows the move.
	self:applyHitstop(attacker,victim,style,heavy)
	self:pushImpact(victim.root.Position,style,victim.impactHeavy)
	Brawler.event(self,attacker,"Damage"); if guarded then Brawler.event(self,victim,"GuardHit") end
	self:effect("Impact",victim.root.Position,if guarded then Color3.fromRGB(221,203,152) else attacker.color,Vector3.new(2,2,2),0.12)
	if heavy and not guarded and victim.health&gt;0 then
		attacker.pursuitUntil=self.now+Config.PursuitWindow
		self:cue(attacker,"LAUNCH • E TO PURSUE",Config.PursuitWindow)
		local push=Vector3.new(-delta.X,0,-delta.Z)
		if push.Magnitude&gt;0.1 then Brawler.react(self,victim,"Launched",push.Unit*22+Vector3.new(0,42,0),.9) end
	end
	if victim.health&lt;=0 then
		Brawler.releaseGrab(victim); victim.reaction=nil
		victim.state="Defeated"; victim.pending=nil; victim.move=Vector3.zero
		-- Remember the blow that ended it so the KO body matches the final hit.
		victim.koStyle=style
		victim.koAirborne=victim.airborne==true
		-- The last blow freezes for a beat on both bodies.
		attacker.hitstopUntil=self.now+.22;victim.hitstopUntil=self.now+.22
		attacker.pending=nil;attacker.move=Vector3.zero
		self.match.finish(attacker,victim)
	end
	attacker.hitConfirmed=true
	return true
end
function Combat:strike(a,damage,range,facing,heavy)
	if self:targetValid(a,a.target,range,facing) then return self:damage(a,a.target,damage,heavy,true) end
	return false
end
-- Skill-build hooks (SkillBuilds.OPTIONAL). Each reads one optional field of
-- the actor's definition; canonical kits never carry these fields.
-- Parry riders: ParrySeal (Minato) seals the stunned attacker for a teleport;
-- ParryRedirect (Neji) turns him aside, closes a point and opens a counter.
function Combat:parryRider(victim,attacker)
	if attacker.health&lt;=0 then return end
	local seal=victim.def.ParrySeal
	if seal then
		local entry=Techniques.plant(self,victim,attacker.root.Position,Vector3.yAxis,attacker)
		entry.expires=self.now+seal
		self:cue(victim,"PARRY • SEALED • 2 TO FOLLOW",.8)
		Brawler.event(self,victim,"ParrySeal")
	end
	local redirect=victim.def.ParryRedirect
	if redirect then
		local away=attacker.root.Position-victim.root.Position;away=Vector3.new(away.X,0,away.Z)
		if away.Magnitude&gt;.1 then
			-- A quarter turn aside: his chest no longer faces the palm that follows.
			local aside=Vector3.new(-away.Z,0,away.X).Unit
			attacker.root.CFrame=CFrame.lookAt(attacker.root.Position,attacker.root.Position+aside)
		end
		if victim.def.GentleFist then for _=1,redirect.Points or 1 do Brawler.gentleFist(self,victim,attacker,false) end end
		if redirect.Counter then victim.counterUntil=math.max(victim.counterUntil or 0,self.now+redirect.Counter) end
		self:pushImpact(attacker.root.Position,"deflect",false,{owner=victim.id})
		self:cue(victim,"REDIRECTED • COUNTER",.8);self:cue(attacker,"REDIRECTED",.6)
		Brawler.event(self,victim,"Redirect")
	end
end
-- Mirage Reflex (Itachi's awakening): the clean read that just opened a
-- Sharingan counter leaves a genjutsu decoy on the attacker.
function Combat:reflexEcho(victim,attacker)
	local tune=victim.def.Awakening
	local reflex=tune and tune.Reflex
	if not reflex or (victim.awakenUntil or 0)&lt;=self.now or attacker==victim or attacker.health&lt;=0 or attacker.def.Byakugan then return end
	attacker.illusionUntil=self.now+reflex
	attacker.decoyPosition=self:clamp(victim.root.Position+victim.root.CFrame.RightVector*5)
	self:effect("Echo",attacker.decoyPosition,victim.color,Vector3.new(2,5,1),reflex)
	self:pushImpact(victim.root.Position,"mirage",false,{owner=victim.id,fighter=victim.fighterId,to=attacker.decoyPosition})
	self:cue(victim,"FOCUS • MIRAGE REFLEX",.8);self:cue(attacker,"MIRAGE • TRUST THE BODY",reflex)
	Brawler.event(self,victim,"MirageReflex")
end
-- Blood for Chakra (Sasuke's Curse Mark): awakened, the chakra a technique
-- lacks is paid with health, never down to a KO.
function Combat:curseBlood(a,spec)
	local tune=a.def.Awakening
	if not (tune and tune.BloodChakra) or (a.awakenUntil or 0)&lt;=self.now or a.chakra&gt;=spec.Cost then return false end
	if (a.cooldowns[spec.Id] or 0)&gt;self.now or (a.sealedUntil or 0)&gt;self.now or self.match.techniquesDisabled then return false end
	local debt=spec.Cost-a.chakra
	if a.health&lt;=debt+1 then return false end
	a.health-=debt;a.hum.Health=math.max(1,a.health);a.chakra=spec.Cost
	self:cue(a,"CURSE MARK • BLOOD FOR CHAKRA",.8)
	Brawler.event(self,a,"BloodChakra")
	return true
end
-- Air Exit (Minato): Tool during a teleport arrival in the air throws a marked
-- kunai straight down; where it lands becomes a seal. nil when not applicable.
function Combat:arrivalThrow(a)
	local throw=a.def.ArrivalThrow
	if not throw or (a.flashUntil or 0)&lt;=self.now or not a.airborne or a.throwing
		or (a.state~="TechniqueRecovery" and a.state~="TechniqueActive") then return nil end
	if a.chakra&lt;Config.ToolCost then return false,"Need chakra" end
	a.chakra-=Config.ToolCost
	a.flashUntil=0;a.pending=nil;self:setState(a,"Neutral",0)
	a.neutralToolAt=self.now+((a.def.ToolMastery and a.def.ToolMastery.Recover) or .55)
	local below=Vector3.new(a.root.Position.X,self.match.origin.Y,a.root.Position.Z)
	self:beginThrow(a,{kind="MarkedKunai",release=.08,count=1,aim=below,fire=function(_,target)
		self:projectile(a,target,96,40,throw.Damage or 2,"marked",function(position,normal,victim)
			if a.health&lt;=0 or self.match.phase~="Duel" then return end
			Techniques.plant(self,a,position,normal,victim)
		end)
	end})
	self:cue(a,"SEAL BELOW",.6)
	Brawler.event(self,a,"ArrivalThrow")
	return true
end
-- Projectile kinds: "kunai", "marked" (Minato's seal kunai), "shuriken",
-- "fireball" and "wind". Legacy names ("blade", "needle", "tool") still work.
local KIND_ALIAS={blade="marked",needle="shuriken",tool="kunai"}
local LAUNCH_FOR={kunai="Kunai",marked="MarkedKunai",shuriken="Shuriken",fireball="Fireball",wind="Wind"}
-- Straight, constant-speed flights: the client reproduces the exact path from
-- (origin, direction, speed, born) and only needs the end event from the feed.
function Combat:projectile(a,aim,speed,range,damage,kind,onSurface,opts)
	opts=opts or {}
	kind=KIND_ALIAS[kind] or kind
	local start=opts.origin or Combat.launchPoint(a,LAUNCH_FOR[kind] or "Kunai")
	local delta=aim-start
	if delta.Magnitude&lt;0.1 then delta=a.root.CFrame.LookVector end
	self.projectileSerial=(self.projectileSerial or 0)+1
	local p={id=self.projectileSerial,a=a,origin=start,position=start,direction=delta.Unit,speed=speed,range=range,remaining=range,
		damage=damage,onSurface=onSurface,kind=kind,born=self.now,radius=opts.radius or 0,growth=opts.growth or 0,
		reaction=opts.reaction,impulse=opts.impulse,explode=opts.explode,heavy=opts.heavy,
		-- Skill-build riders (chase, chakra point, wall pin, bind): see projectileRiders.
		riders=opts.riders}
	table.insert(self.projectiles,p)
	self.urgent=true
	return p
end
function Combat:removeProjectile(p)
	for i=#self.projectiles,1,-1 do
		if self.projectiles[i]==p then table.remove(self.projectiles,i) end
	end
end
-- The marked kunai that is still travelling, if any: Minato can relocate onto
-- it mid-flight, which is the whole point of the seal.
function Combat:markedInFlight(a)
	for _,p in self.projectiles do
		if p.a==a and p.kind=="marked" then return p end
	end
	return nil
end
-- Throws keep the thrower in Neutral so locomotion continues: the arm releases
-- on its authored frame while the legs keep running.
function Combat:beginThrow(a,spec)
	a.throwSerial=(a.throwSerial or 0)+1
	a.throwing={kind=spec.kind,started=self.now,release=self.now+spec.release,nextRelease=self.now+spec.release,
		count=spec.count or 1,fired=0,interval=spec.interval or .07,aim=spec.aim,fire=spec.fire,serial=a.throwSerial}
	a.throwKind=spec.kind;a.throwStarted=self.now;a.throwRelease=spec.release
	self.urgent=true
end
function Combat:stepThrow(a)
	local throw=a.throwing
	if not throw then return end
	if a.health&lt;=0 or a.reaction or a.state=="Stunned" or a.state=="Defeated" or a.state=="Dodging" then
		a.throwing=nil;return
	end
	while a.throwing==throw and self.now&gt;=throw.nextRelease and throw.fired&lt;throw.count do
		throw.fired+=1
		-- Re-aim at release against the live target, unless an explicit point was
		-- chosen: a throw tracks the opponent the arm is actually throwing at.
		local aim=throw.aim or (a.target and a.target.root.Position) or (a.root.Position+a.root.CFrame.LookVector*20)
		throw.fire(throw.fired,aim)
		throw.nextRelease+=throw.interval
	end
	if a.throwing==throw and throw.fired&gt;=throw.count then a.throwing=nil end
end
-- Facing while locked on. Small moves around the opponent are strafes with
-- the chest on them; a committed run (held away from them, sprinting, or from
-- far) turns the body into the run, three-quarters toward the opponent, so a
-- fighter never slides around a point like a mannequin. The turn is
-- progressive; guarding always squares up.
-- Turn the root toward a flat direction at a bounded angular speed (deg/s).
-- Instant lookAt writes read as the body teleporting its facing (measured up
-- to 175 degrees in one frame) and drag the planted feet with them.
function Combat:turnToward(a,direction,dt,rate)
	local want=Vector3.new(direction.X,0,direction.Z)
	if want.Magnitude&lt;.01 then return end
	want=want.Unit
	local current=Vector3.new(a.root.CFrame.LookVector.X,0,a.root.CFrame.LookVector.Z)
	current=if current.Magnitude&gt;.01 then current.Unit else want
	local angle=math.atan2(current:Cross(want).Y,current:Dot(want))
	local step=math.clamp(angle,-math.rad(rate)*dt,math.rad(rate)*dt)
	local look=CFrame.fromAxisAngle(Vector3.yAxis,step):VectorToWorldSpace(current)
	a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+look)
end
function Combat:faceLocked(a,dt)
	local toward=a.target.root.Position-a.root.Position;toward=Vector3.new(toward.X,0,toward.Z)
	if toward.Magnitude&lt;.1 then return end
	local target=toward.Unit
	local distance=toward.Magnitude
	local intent=Vector3.new(a.move.X,0,a.move.Z)
	local desired=target
	local committed=false
	if a.state=="Neutral" and intent.Magnitude&gt;.4 then
		local moveDir=intent.Unit
		local along=target:Dot(moveDir) -- 1 toward, -1 away, 0 around
		if along&lt;.55 then a.awayHeld=(a.awayHeld or 0)+dt else a.awayHeld=0 end
		committed=a.sprinting or (a.awayHeld or 0)&gt;.3 or (distance&gt;16 and along&lt;.55)
		-- Close in and retreating a step: a backpedal keeps the chest on them.
		if along&lt;-.5 and distance&lt;10 and not a.sprinting then committed=false end
		if committed then
			local look=if distance&lt;12 then .45 else .2
			desired=(moveDir+target*look).Unit
		end
	else a.awayHeld=0 end
	local current=Vector3.new(a.root.CFrame.LookVector.X,0,a.root.CFrame.LookVector.Z)
	if current.Magnitude&lt;.01 then current=desired end
	current=current.Unit
	local angle=math.atan2(current:Cross(desired).Y,current:Dot(desired))
	local rate=math.rad(if committed then 540 else 760)*dt
	local turn=math.clamp(angle,-rate,rate)
	local look=CFrame.fromAxisAngle(Vector3.yAxis,turn):VectorToWorldSpace(current)
	a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+look)
	a.facingCommitted=committed
end
-- Kawarimi. A limited escape from a combo: two charges that come back one at a
-- time, a chakra cost, and a short tracking window for the attacker so a
-- predictable substitution can still be punished. Each prodigy reappears in
-- his own way: Minato on a planted seal if he has one, Itachi as a crow clone
-- behind the attacker, otherwise a short hop away.
function Combat:substitute(a)
	local tune=Config.Substitution
	if a.subCharges&lt;=0 then return false,"No substitution" end
	if self.now&lt;a.subCooldown then return false,"Substitution recovering" end
	if a.chakra&lt;tune.Cost then return false,"Need chakra" end
	local hurt=(a.reaction~=nil and a.reaction~="Wakeup" and not (a.reaction=="Knockdown" and not a.airborne))
		or a.state=="Stunned" or self.now-a.lastHurt&lt;=tune.Window
	if not hurt then return false,"No escape window" end
	local attacker=a.target
	local departure=a.root.Position
	local destination,mode=nil,"hop"
	-- Skill-build twist (SkillBuilds def.Substitution); nil for canonical kits.
	local twist=a.def.Substitution
	local seal=a.fighterId=="Flashstep" and Techniques.escapeSeal(self,a,self.now)
	if seal then
		destination=self:clamp(seal.position);mode="seal"
	elseif a.fighterId=="Mirage" and attacker and attacker.health&gt;0 then
		local back=-attacker.root.CFrame.LookVector*Vector3.new(1,0,1)
		if back.Magnitude&gt;.1 then
			local spot=self:clamp(Vector3.new(attacker.root.Position.X,self.match.origin.Y+3,attacker.root.Position.Z)+back.Unit*5.5)
			if self:openSpot(attacker,spot) then destination=spot;mode="crow" end
		end
	elseif twist and twist.Mode=="flank" and attacker and attacker.health&gt;0 then
		-- Neji's outside step: reappear on the attacker's flank, on the side he
		-- was already on, else the other one.
		local right=attacker.root.CFrame.RightVector*Vector3.new(1,0,1)
		if right.Magnitude&gt;.1 then
			right=right.Unit
			local first=if (a.root.Position-attacker.root.Position):Dot(right)&gt;=0 then 1 else -1
			for _,sign in {first,-first} do
				local spot=self:clamp(Vector3.new(attacker.root.Position.X,self.match.origin.Y+3,attacker.root.Position.Z)+right*sign*5)
				if self:openSpot(attacker,spot) then destination=spot;mode="flank";break end
			end
		end
	end
	if destination then
		self:relocate(a,destination)
	else
		local away=a.root.Position-(if attacker then attacker.root.Position else a.root.Position-a.root.CFrame.LookVector)
		away=Vector3.new(away.X,0,away.Z)
		if away.Magnitude&lt;0.1 then away=a.root.CFrame.RightVector end
		-- Pinned against a wall the straight escape is blocked: slide along it.
		local moved=Motor.travel(a,self,away,tune.Distance)
		if moved&lt;2 then
			local side=Vector3.new(-away.Z,0,away.X)
			moved=Motor.travel(a,self,side,tune.Distance)
			if moved&lt;2 then moved=Motor.travel(a,self,-side,tune.Distance) end
		end
		if moved&lt;2 then return false,"Escape blocked" end
	end
	if attacker then
		local face=attacker.root.Position-a.root.Position;face=Vector3.new(face.X,0,face.Z)
		if face.Magnitude&gt;.1 then a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+face) end
	end
	if a.subCharges&gt;=tune.Charges then a.subRegenAt=self.now+tune.Recharge end
	a.subCharges-=1; a.chakra-=tune.Cost; a.subCooldown=self.now+tune.Cooldown
	a.subUntil=self.now+0.17
	Brawler.releaseGrab(a); a.reaction=nil; a.reactionVelocity=nil; a.airHold=0; a.throwing=nil;a.groundPose=nil
	a.airborne=a.root.Position.Y&gt;self.match.origin.Y+4.2
	if seal then Techniques.consumeSeal(self,a,seal) end
	-- Skill-build twist riders: a seal left where he stood (Return Seal), a
	-- counter window (Crow Counter, Outside Step), a free counter-rush.
	local extra=""
	if twist then
		if twist.PlantDeparture then
			Techniques.plant(self,a,Vector3.new(departure.X,self.match.origin.Y,departure.Z),Vector3.yAxis)
			extra=" • SEAL LEFT"
		end
		if twist.Counter then a.counterUntil=self.now+twist.Counter;extra=extra.." • COUNTER" end
		if twist.FreeRush then a.freeRushUntil=self.now+twist.FreeRush;extra=extra.." • E: COUNTER-RUSH" end
	end
	Brawler.event(self,a,"Substitute"); a.pending=nil; a.guardHeld=false; a.invulnerableUntil=self.now+0.24
	a.comboHits=0;a.comboDamage=0
	self:setState(a,"Recovery",0.14)
	-- The attacker may read the reappearance: a short chase window.
	if attacker and attacker.health&gt;0 then
		attacker.pursuitUntil=math.max(attacker.pursuitUntil,self.now+tune.Track)
		self:cue(attacker,"SUBSTITUTION • E TO TRACK",tune.Track)
	end
	self:pushImpact(departure,"substitute",false,{owner=a.id,fighter=a.fighterId,to=a.root.Position,mode=mode})
	self:effect("Afterimage",departure,a.color,Vector3.new(2,4,2),0.35)
	self:effect("Substitution",a.root.Position,a.color,Vector3.new(3,4,3),0.25)
	self:cue(a,(if mode=="seal" then "SUBSTITUTION • TO THE SEAL" elseif mode=="crow" then "SUBSTITUTION • CROW CLONE" elseif mode=="flank" then "SUBSTITUTION • OUTSIDE STEP" else "SUBSTITUTION • REPOSITIONED")..extra)
	return true
end
-- A reappearance point next to `attacker` is usable when nothing solid fills it
-- and the attacker has a clear line to it.
function Combat:openSpot(attacker,spot)
	for _,part in workspace:GetPartBoundsInBox(CFrame.new(spot),Vector3.new(2.6,4.6,2.6),self:overlapParams()) do
		if part.CanCollide then return false end
	end
	return workspace:Raycast(attacker.root.Position,spot-attacker.root.Position,self:rayParams(true))==nil
end
-- Wall tech: pinned against a wall, a well-timed dodge kicks off it. Too early
-- (before the impact settles) or too late and the pin holds.
-- Re-engage (CORE_COMBAT_CONVERGENCE_2 §3): ONE contextual action — keyboard
-- E; on a pad × inside a chase window, sprint + ○ toward outside one. Inside a
-- chase window (knock-away, launch, throw, wall splat or bounce, a substitution
-- to track) it is the chase; outside it is the chakra dash at a locked
-- opponent. Same chakra either way; each prodigy re-enters his own way
-- (MoveGraphs[...].reengage, Brawler.rushPlan).
function Combat:reengage(a)
	if a.pursuitUntil&gt;self.now and a.target.health&gt;0 then return self:chase(a) end
	return self:rush(a)
end
-- The chase: reach the knocked-away / launched / thrown body in three
-- dimensions (motion in updateActor). The strike that connected and opened the
-- window (a launcher, the third light, a palm thrust...) may be cancelled into
-- it at once: E pressed on the knock-away is never eaten by its active frames.
function Combat:chase(a)
	if a.chakra&lt;Config.PursuitCost then return false,"Need chakra" end
	if (a.target.root.Position-a.root.Position).Magnitude&gt;Config.PursuitRange then return false,"Too far" end
	local launchCancel=a.hitConfirmed and (a.state=="Active" or a.state=="Recovery")
		and a.pending~=nil and a.pending.kind=="Brawl"
	if a.state~="Neutral" and a.state~="Recovery" and a.state~="TechniqueRecovery" and not launchCancel then return false,"Committed" end
	if launchCancel then Bangla.close(a.pending);a.pending=nil;a.hitstopUntil=0 end
	local style=Brawler.reentry(a)
	a.chakra-=Config.PursuitCost; a.pursuitUntil=0
	a.reaction=nil; a.airborne=true
	a.pursuitStarted=self.now
	-- A body still rising fast (a chase pressed on the launch itself) is
	-- followed up to where an air strike can catch it, not dropped at 0.24 s.
	local b=a.target
	local rising=if b.reaction and b.reactionVelocity then math.max(0,b.reactionVelocity.Y) else 0
	local duration=(style.chase or .3)+math.clamp((rising-30)/75,0,.3)
	a.pursuitDuration=duration
	-- The side of the body the chase arrives on: the attacker's own.
	local line=Vector3.new(b.root.Position.X-a.root.Position.X,0,b.root.Position.Z-a.root.Position.Z)
	a.pursuitLine=if line.Magnitude&gt;.2 then line.Unit else Vector3.new(a.root.CFrame.LookVector.X,0,a.root.CFrame.LookVector.Z).Unit
	a.airHold=self.now+duration+.45
	Brawler.breakString(a,false)
	Brawler.event(self,a,"Chase");Brawler.event(self,a,"Reengage")
	self:setState(a,"Pursuit",duration)
	self:effect("Pursuit",a.root.Position,a.color,Vector3.new(2,4,2),0.35)
	self:pushImpact(a.root.Position,"chase",false,{owner=a.id,fighter=a.fighterId,variant=style.name,mode="chase"})
	return true
end
-- Chakra dash. A committed burst at a locked opponent from neutral (or out of
-- a recovery's cancel point), a straight reposition when unlocked. It is not
-- armoured: a blade, a guard or a read answers it. The arrival (Brawler.arrive)
-- converts at once into the dash attack, the quick heavy or a grab, but guards
-- only after Config.Rush.CancelAfter: a predictable dash is punished.
function Combat:rush(a)
	local tune=Config.Rush
	local style=Brawler.reentry(a)
	local cancel=a.state=="Recovery" and self.now&gt;=(a.recoveryCancelAt or math.huge)
	if not Rules.canAct(a,self.now) and not cancel then return false,"Committed" end
	if a.airborne or a.wall or a.reaction then return false,"No chakra dash" end
	-- Skill build (Counter-Rush): right after a substitution the dash is free.
	local free=(a.freeRushUntil or 0)&gt;self.now
	if a.chakra&lt;Config.PursuitCost and not free then return false,"Need chakra" end
	if self.now&lt;(a.rushReadyAt or 0) then return false,"Cooldown" end
	local gap=(a.target.root.Position-a.root.Position).Magnitude
	local line=nil
	if a.locked==false then
		-- Unlocked: no homing, a straight burst along the stick (or the facing).
		local stick=Vector3.new(a.move.X,0,a.move.Z)
		local look=a.root.CFrame.LookVector
		line=if stick.Magnitude&gt;.2 then stick.Unit else Vector3.new(look.X,0,look.Z).Unit
	else
		if gap&lt;(style.minRange or tune.MinRange) then return false,"Too close" end
		if gap&gt;tune.Range then return false,"Too far" end
	end
	if cancel then Bangla.close(a.pending) end
	if free then a.freeRushUntil=nil;self:cue(a,"COUNTER-RUSH",.5) else a.chakra-=Config.PursuitCost end
	a.rushReadyAt=self.now+tune.Cooldown
	a.pending=nil;a.attackName=nil;a.guardHeld=false;a.chainOpen=false
	-- A re-entry opens a fresh string on arrival.
	Brawler.breakString(a,false)
	local departure=a.root.Position
	local plan=Brawler.rushPlan(self,a,style,line)
	local travel=if line then tune.Reposition else gap
	local duration=math.clamp(travel/plan.speed+.12,.12,tune.MaxTime*(style.time or 1))
	self:setState(a,"Rush",duration)
	a.rush=plan
	a.rushArriveUntil=self.now+duration+tune.Arrive
	Brawler.event(self,a,"Rush");Brawler.event(self,a,"Reengage")
	-- Itachi: the approach starts from an afterimage left where he stood.
	if style.afterimage then self:pushImpact(departure,"afterimage",false,{owner=a.id,fighter=a.fighterId,variant="reengage"}) end
	self:pushImpact(departure,"chase",false,{owner=a.id,fighter=a.fighterId,variant=style.name,mode="dash",to=plan.goal,sealed=plan.sealed})
	return true
end
-- Awakening: once per match, below a third of health. A shockwave buys space,
-- chakra comes back, and each prodigy's own strength is pushed for a while.
function Combat:awaken(a)
	local tune=a.def.Awakening
	if not tune or a.awakened then return false,"No awakening" end
	if a.health&gt;a.def.Health*Config.Awaken.Threshold then return false,"Not yet" end
	if not Brawler.free(a,self.now) then return false,"Reacting" end
	a.awakened=true;a.awakenUntil=self.now+Config.Awaken.Duration;a.awakenedAt=self.now;a.curseLanded=self.now;a.curseFedUntil=0
	a.chakra=math.min(a.def.Chakra or Config.Chakra,a.chakra+40)
	a.cooldowns={}
	a.invulnerableUntil=math.max(a.invulnerableUntil,self.now+.45)
	a.pending=nil;a.guardHeld=false;self:setState(a,"Recovery",.3)
	local b=a.target
	if b and b.health&gt;0 then
		local away=b.root.Position-a.root.Position;away=Vector3.new(away.X,0,away.Z)
		if away.Magnitude&lt;9 and away.Magnitude&gt;.05 then Brawler.react(self,b,"Knockback",away.Unit*34+Vector3.new(0,12,0),.45,a) end
	end
	a.hitstopUntil=self.now+.12
	self:pushImpact(a.root.Position,"awaken",true,{owner=a.id,fighter=a.fighterId})
	self:cue(a,"AWAKENING • "..tune.Name,1.4)
	if b then self:cue(b,"OPPONENT AWAKENED",1) end
	Brawler.event(self,a,"Awaken")
	return true
end
-- Awakened techniques recover faster (and Itachi's cost less).
function Combat:awakenTechnique(a,spec)
	if (a.awakenUntil or 0)&lt;=self.now then return end
	local tune=a.def.Awakening
	a.cooldowns[spec.Id]=self.now+spec.Cooldown*(tune.Cooldown or 1)
	if tune.CostScale then a.chakra=math.min(a.def.Chakra or Config.Chakra,a.chakra+spec.Cost*(1-tune.CostScale)) end
end
function Combat:wallTech(a)
	local tune=Config.Wall
	local elapsed=self.now-(a.splatAt or -10)
	if elapsed&lt;tune.TechFrom or elapsed&gt;tune.TechUntil or (a.hitstopUntil or 0)&gt;self.now then
		a.techLockUntil=self.now+.25
		return false,"Tech missed"
	end
	if (a.techLockUntil or 0)&gt;self.now then return false,"Tech missed" end
	if a.chakra&lt;tune.TechCost then return false,"Need chakra" end
	local normal=a.splatNormal or -a.root.CFrame.LookVector
	normal=Vector3.new(normal.X,0,normal.Z)
	normal=if normal.Magnitude&gt;.05 then normal.Unit else -a.root.CFrame.LookVector
	a.chakra-=tune.TechCost
	a.reaction=nil;a.reactionVelocity=nil;a.groundPose=nil;a.comboHits=0;a.comboDamage=0
	-- Kick off along the stick (sideways along the wall or straight out).
	local stick=Vector3.new(a.move.X,0,a.move.Z)
	local along=stick-normal*stick:Dot(normal)
	local out=normal*30+(if along.Magnitude&gt;.3 then along.Unit*18 else Vector3.zero)
	a.root.AssemblyLinearVelocity=out+Vector3.new(0,36,0)
	a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+normal)
	a.airborne=true;a.airDodgeUsed=false;a.takeoffUntil=self.now+.12;a.wallNext=self.now+.35
	a.invulnerableUntil=self.now+.28
	self:setState(a,"Recovery",.16)
	Brawler.event(self,a,"WallTech")
	self:pushImpact(a.root.Position-normal*1.2,"walltech",false,{owner=a.id,fighter=a.fighterId,normal=normal})
	self:cue(a,"WALL TECH")
	if a.target then self:cue(a.target,"WALL TECH • RESET",.7) end
	return true
end
function Combat:request(a,action,aim,clientTime)
	if self.match.phase~="Duel" or a.health&lt;=0 then return false,"No duel" end
	if self.match.introUntil and self.now&lt;self.match.introUntil then return false,"Intro" end
	if self.match.finishing then return false,"Intro" end
	-- The press carries its own stick (Matches:act): remember it as intent.
	Brawler.observe(self,a)
	if action=="GuardOff" then
		Defense.guard(a,false,self.now)
		if a.state=="Guarding" then self:setState(a,"Neutral",0) end
		return true
	end
	if action=="JumpOff" then
		if a.airborne and a.root.AssemblyLinearVelocity.Y&gt;22 and self.now&lt;(a.takeoffUntil or 0)+0.18 then
			local v=a.root.AssemblyLinearVelocity
			a.root.AssemblyLinearVelocity=Vector3.new(v.X,v.Y*0.66,v.Z)
		end
		return true
	end
	if action=="WallDetach" then Motor.detach(a,self.now,false); return true end
	-- Pinned against a wall, the dodge button is a timed wall tech, never a
	-- substitution: a mistimed tech must not silently spend a charge.
	if action=="Dodge" and a.reaction=="WallSplat" then return self:wallTech(a) end
	if action=="Dodge" and not Brawler.free(a,self.now) then action="Substitute" end
	if action=="Substitute" then return self:substitute(a) end
	if action=="Awaken" then return self:awaken(a) end
	if action=="Feint" then
		local pending=a.pending
		if a.state=="Startup" and pending and pending.kind=="Brawl" and pending.name=="Heavy" and self.now-a.attackStarted&lt;=pending.spec.startup*.62 then
			Bangla.close(pending);a.pending=nil;a.attackName=nil;a.travelRemaining=0;a.chakra=math.max(0,a.chakra-4)
			self:setState(a,"Recovery",.09);self:cue(a,"HEAVY FEINT • MOVE");Brawler.event(self,a,"Feint")
			return true
		end
		if a.state~="TechniqueChannel" or not pending or not pending.spec.Feintable then return false,"No feint window" end
		if self.now&gt;a.untilTime-pending.spec.Channel*0.5 then return false,"Feint too late" end
		a.chakra=math.min(a.def.Chakra or Config.Chakra,a.chakra+pending.spec.Cost*0.35)
		a.pending=nil; self:setState(a,"Recovery",0.24); self:cue(a,"FEINT • CHAKRA PARTIAL")
		return true
	end
	-- The throwing arm owns the body until the blade leaves the hand; after the
	-- release the follow-up is free, which is what lets a kunai lead a rush.
	local throwHeld=a.throwing and self.now&lt;a.throwing.release
	if throwHeld and (action=="Attack" or action=="Heavy" or action=="Grab" or action=="Tool" or string.match(action,"^Technique")) then
		return false,"Committed"
	end
	-- (The light step is no longer resolved here: Brawler.request reads it from
	-- the confirmed hits when the press actually starts a strike.)
	if action=="Attack" or action=="Heavy" or action=="Grab" then a.attackCommitTime=clientTime or self.now end
	local handled,reason=Brawler.request(self,a,action)
	if handled~=nil then return handled,reason end
	if not Brawler.free(a,self.now) then return false,"Reacting" end
	-- Itachi's re-entry is a feint he can abort: guard or dodge stops the dash.
	if (action=="Guard" or action=="Dodge") and a.state=="Rush" and Brawler.reentry(a).feint then Brawler.feintRush(self,a) end
	if (action=="Guard" or action=="Dodge") and (a.state=="Recovery" or a.state=="TechniqueRecovery") and self.now&gt;=(a.recoveryCancelAt or math.huge) then
		a.pending=nil;self:setState(a,"Neutral",0)
	end
	-- Pad re-engage: sprint + dodge toward a locked opponent at mid range is the
	-- re-engage (chase in a window, chakra dash outside); anything else, or a
	-- re-engage that is not available (cooldown, chakra), stays a dodge.
	if action=="Dodge" and Brawler.dashIntent(self,a) then
		local ok,why=self:reengage(a)
		if ok then return ok,why end
	end
	if action=="Pursuit" then return self:reengage(a) end
	if action=="Jump" then
		if a.wall then Motor.detach(a,self.now,true); return true end
		if a.state~="Neutral" and a.state~="Recovery" then return false,"Committed" end
		-- Like a guard or a dodge, a jump leaves a recovery only at its cancel
		-- point: a whiff (or an unanswered dash) cannot hop out of its punish.
		if a.state=="Recovery" and self.now&lt;(a.recoveryCancelAt or 0) then return false,"Committed" end
		return Motor.jump(a,self,self.now),"Airborne"
	end
	if action=="Tool" then
		if a.def.ArrivalThrow then
			local thrown,refusal=self:arrivalThrow(a)
			if thrown~=nil then return thrown,refusal end
		end
		local graph=Brawler.graph(a) or {}
		local chainCancel=a.def.ComboToolCancel and a.state=="Recovery" and (a.chainOpen or (a.hitBlocked and graph.blockCancels and graph.blockCancels.Tool)) and self.now&gt;=(a.chainAt or 0)
		if (not chainCancel and not Rules.canAct(a,self.now)) or self.now&lt;a.neutralToolAt then return false,"Tool recovering" end
		if a.throwing then return false,"Throwing" end
		-- A neutral throw costs a little chakra so blades pressure, not spam;
		-- the throw that cancels a confirmed string stays free.
		if not chainCancel and a.chakra&lt;Config.ToolCost then return false,"Need chakra" end
		if not chainCancel then a.chakra-=Config.ToolCost end
		-- Stick away + tool inside a string: hop out of it behind the throw.
		local disengage=graph.disengage
		if chainCancel and a.chainOpen and disengage and Brawler.intent(a)=="back" then
			a.neutralToolAt=self.now+.5
			return Brawler.disengage(self,a,disengage)
		end
		if chainCancel then a.pending=nil;a.attackName=nil;a.chainOpen=false;self:setState(a,"Neutral",0);Brawler.event(self,a,"ChainTool") end
		-- Throwing lowers the guard: a blade never leaves a fully blocking body.
		if a.state=="Guarding" then Defense.guard(a,false,self.now);self:setState(a,"Neutral",0) end
		if a.wall then Motor.detach(a,self.now,false) end
		if a.def.Tool=="Sand" then
			a.neutralToolAt=self.now+(if chainCancel then .42 else .6)
			self:beginThrow(a,{kind="Sand",release=.12,count=1,aim=aim,fire=function(_,target)
				self:projectile(a,target,90,if chainCancel then 20 else 56,3,"sand",nil,{origin=self.launchPoint(a,"Palm"),radius=.6})
			end})
			self:cue(a,"SAND BULLET",.5)
			return true
		end
		local mastery=a.def.ToolMastery or {Kind="kunai",Count=1,Speed=90,Damage=3,Recover=.75}
		local blade=mastery.Kind=="kunai"
		a.neutralToolAt=self.now+(if chainCancel then .42 else mastery.Recover)
		local range=if chainCancel then 20 else 62
		-- Shuriken Geometry (mastery): side + tool throws one blade wide and a
		-- second that strikes it beside the opponent; both fly into the flank.
		local dir,sideSign=Brawler.intent(a)
		if mastery.Geometry and dir=="side" and not chainCancel and a.target and a.target.health&gt;0 then
			return self:shurikenGeometry(a,sideSign)
		end
		-- In the air a master fans several blades down at the opponent.
		local count=if a.airborne and mastery.AirSpread then mastery.AirSpread else mastery.Count
		self:beginThrow(a,{kind=if blade then "Kunai" else "Shuriken",release=if blade then .1 else .13,
			count=count,interval=if count&gt;2 then .05 else .08,aim=aim,
			fire=function(index,target)
				local spread=Vector3.zero
				if count&gt;1 then spread=a.root.CFrame.RightVector*((index-(count+1)/2)*(if count&gt;2 then 1.6 else 1.8)) end
				self:projectile(a,target+spread,mastery.Speed,range,mastery.Damage,if blade then "kunai" else "shuriken")
			end})
		self:cue(a,if chainCancel then "CHAIN TOOL • KEEP PRESSURE" else (if blade then "KUNAI" else "SHURIKEN"))
		return true
	end
	-- Melee -&gt; technique: Minato may spend a confirmed string on Rasengan with
	-- a shortened wind-up. It is a read/finisher, not a neutral button.
	a.stringCancel=nil
	local cancelSlot=tonumber(string.match(action,"^Technique([1-5])$"))
	local cancelSpec=cancelSlot and a.def.Techniques[cancelSlot]
	-- Skill build (Blood for Chakra): the Curse Mark pays what the reserve lacks
	-- before the usual checks, for a cancel or a neutral cast alike.
	if cancelSpec and a.def.Awakening and a.def.Awakening.BloodChakra and ((a.state=="Recovery" and a.chainOpen) or Rules.canAct(a,self.now))
		and Techniques[cancelSpec.Id].check(self,a,cancelSpec,self.now) then self:curseBlood(a,cancelSpec) end
	local cancelGraph=Brawler.graph(a) or {}
	-- The technique's own condition is checked before the string is spent (a
	-- teleport cancel needs a seal); the original cancels have none.
	if cancelSpec and cancelGraph.stringCancels and cancelGraph.stringCancels[cancelSpec.Id] and a.state=="Recovery" and a.chainOpen and self.now&gt;=(a.chainAt or 0)
		and (a.cooldowns[cancelSpec.Id] or 0)&lt;=self.now and a.chakra&gt;=cancelSpec.Cost and Techniques[cancelSpec.Id].check(self,a,cancelSpec,self.now) then
		Bangla.close(a.pending);a.pending=nil;a.attackName=nil;a.chainOpen=false;a.state="Neutral";a.untilTime=self.now
		a.stringCancel=cancelSpec.Id
	end
	-- Flying Thunder God arrival: the Rasengan is already forming in the hand,
	-- so it cancels the teleport recovery with almost no wind-up.
	a.flashCancel=nil
	local arriving=(a.flashUntil or 0)&gt;self.now and (a.state=="TechniqueRecovery" or a.state=="TechniqueActive")
		and (a.pending==nil or a.pending.spec.Id=="Flashstep")
	if cancelSpec and cancelSpec.Id=="BurstStrike" and arriving
		and (a.cooldowns[cancelSpec.Id] or 0)&lt;=self.now and a.chakra&gt;=cancelSpec.Cost then
		a.flashUntil=0;a.state="Neutral";a.untilTime=self.now;a.pending=nil
		a.flashCancel=true
	end
	-- Dragon Flame: with the wire still holding the body, the fire runs along
	-- it at once (the wire throw's recovery is cancelled, the signs are short).
	a.wireCancel=nil
	local wired=a.wireVictim and a.wireVictim.reaction=="Bound" and a.wireVictim.boundBy==a
	if cancelSpec and cancelSpec.Id=="FireBloom" and wired and (a.state=="TechniqueRecovery" or a.state=="Neutral" or a.state=="Recovery")
		and (a.cooldowns[cancelSpec.Id] or 0)&lt;=self.now and a.chakra&gt;=cancelSpec.Cost then
		a.state="Neutral";a.untilTime=self.now;a.pending=nil
		a.wireCancel=true
	end
	local chain=action=="Attack" and a.state=="Recovery" and a.chainOpen and self.now&gt;a.chainAt
	if not chain and not Rules.canAct(a,self.now) then return false,"Committed" end
	if action=="Guard" then Brawler.event(self,a,"Guard");Defense.guard(a,true,self.now);self:setState(a,"Guarding",0);return true end
	if action=="Dodge" and a.def.SandFlicker and not a.airborne then
		-- Gaara's dodge: a sand body-flicker, an instant reposition.
		if a.chakra&lt;Config.DodgeCost then return false,"Need chakra" end
		if a.dodgeUntil&gt;self.now then return false,"Cooldown" end
		a.chakra-=Config.DodgeCost;a.dodgeUntil=self.now+Config.DodgeCooldown
		local direction=if a.move.Magnitude&gt;.1 then a.move.Unit else -a.root.CFrame.LookVector
		local from=a.root.Position
		Motor.travel(a,self,direction,a.def.SandFlicker.Distance)
		a.warpSerial=(a.warpSerial or 0)+1
		a.invulnerableUntil=self.now+.24;Defense.guard(a,false,self.now);Defense.dodge(a,self.now)
		self:setState(a,"Recovery",.14)
		self:pushImpact(from,"sandflicker",false,{owner=a.id,fighter=a.fighterId,to=a.root.Position})
		Brawler.event(self,a,"Dodge")
		return true
	end
	if action=="Dodge" then
		if a.chakra&lt;Config.DodgeCost then return false,"Need chakra" end
		if a.airborne and a.airDodgeUsed then return false,"Air dodge used" end
		if a.dodgeUntil&gt;self.now then return false,"Cooldown" end
		a.chakra-=Config.DodgeCost; a.dodgeUntil=self.now+Config.DodgeCooldown
		if a.wall then Motor.detach(a,self.now,false) end
		if a.airborne then a.airDodgeUsed=true end
		a.dodgeDirection=if a.move.Magnitude&gt;0.1 then a.move.Unit else a.root.CFrame.RightVector
		a.invulnerableUntil=self.now+Config.DodgeIFrames;Defense.guard(a,false,self.now);Defense.dodge(a,self.now)
		Evade.begin(a,self)
		self:pushImpact(a.root.Position,"dodge",false)
		Brawler.event(self,a,"Dodge"); self:setState(a,"Dodging",Config.DodgeTime); self:effect("Dodge",a.root.Position,a.color,Vector3.new(2,4,1),0.2)
		return true
	end
	if self.match.techniquesDisabled then return false,"Techniques disabled" end
	if string.match(action,"^Technique") and (a.sealedUntil or 0)&gt;self.now then return false,"Chakra points sealed" end
	local slot=tonumber(string.match(action,"^Technique([1-5])$"))
	local spec=slot and a.def.Techniques[slot]
 if spec and (a.trainingChannelScale or 1)~=1 then spec=table.clone(spec);spec.Channel*=a.trainingChannelScale end
	if not spec then return false,"Unknown action" end
	local technique=Techniques[spec.Id]
	-- A string cancel shortens the wind-up to .14 s; a technique that is already
	-- quicker (a teleport, the Read, Rotation) keeps its own.
	if a.stringCancel==spec.Id then spec=table.clone(spec);spec.Channel=math.min(spec.Channel,.14) end
	a.stringCancel=nil
	if a.wireCancel and spec.Id=="FireBloom" then spec=table.clone(spec);spec.Channel=.16 end
	a.wireCancel=nil
	-- Context: the same Rasengan is a different tool after a teleport (instant
	-- thrust) and in the air (a plunge that ends the air phase).
	local variant=nil
	if spec.Id=="BurstStrike" then
		if a.flashCancel then spec=table.clone(spec);spec.Channel=.05;variant="FlashRasengan"
		elseif a.airborne then spec=table.clone(spec);spec.Channel=math.min(spec.Channel,.12);variant="RasenganDrop" end
	end
	-- Skill build (Wall Chidori): charged from a wall run, he hangs on the wall
	-- for a shorter charge, then the thrust dives at the opponent.
	if spec.Id=="Chidori" and spec.WallCharge and a.wall then spec=table.clone(spec);spec.Channel=math.min(spec.Channel,spec.WallCharge);variant="WallChidori" end
	a.flashCancel=nil
	local ok,reason=Rules.technique(a,spec,self.now,technique.check(self,a,spec,self.now))
	if not ok then return false,reason end
	if a.wall then Motor.detach(a,self.now,false) end
	if spec.Mobile then
		-- A thrown technique (Minato's marked kunai): chakra and cooldown are
		-- committed now, but the body stays in Neutral so the legs keep moving
		-- while the arm throws; the payoff fires on the release frame.
		Brawler.event(self,a,"Technique"); a.chakra-=spec.Cost; a.cooldowns[spec.Id]=self.now+spec.Cooldown; a.guardHeld=false
		-- Same for a thrown technique: no guard pose (and guard speed) without a guard.
		if a.state=="Guarding" then self:setState(a,"Neutral",0) end
		self:awakenTechnique(a,spec)
		a.castId=spec.Id;a.castStarted=self.now
		local pending={kind="Technique",spec=spec,implementation=technique,aim=aim}
		self:beginThrow(a,{kind=spec.Throw or "MarkedKunai",release=spec.Channel,count=1,aim=aim,fire=function(_,target)
			pending.aim=target
			technique.execute(self,a,pending,self.now)
			Brawler.event(self,a,"TechniqueResolved")
		end})
		self:cue(a,spec.Name,.6)
		return true
	end
	Brawler.event(self,a,"Technique"); Rules.reserve(a,spec,self.now); a.guardHeld=false
	self:awakenTechnique(a,spec)
	a.pending={kind="Technique",spec=spec,implementation=technique,aim=aim or a.target.root.Position,variant=variant}
	a.castId=spec.Id;a.castStarted=self.now
	local offset=a.pending.aim-a.root.Position
	local flat=Vector3.new(offset.X,0,offset.Z)
	a.castFace=nil
	if flat.Magnitude&gt;0.1 then
		-- A small correction snaps (unseen); a large one turns through the
		-- channel instead of teleporting the facing on the first frame.
		local look=Vector3.new(a.root.CFrame.LookVector.X,0,a.root.CFrame.LookVector.Z)
		if look.Magnitude&lt;.01 or look.Unit:Dot(flat.Unit)&gt;=.82 then a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+flat)
		else a.castFace=flat.Unit end
	end
	self:cue(a,spec.Name.." • PREPARING",spec.Channel)
	if variant=="WallChidori" then
		-- Held off the wall for the whole charge (the hover window zeroes the fall).
		a.airborne=true;a.airHold=self.now+spec.Channel+.05
		self:cue(a,"CHIDORI • FROM THE WALL",spec.Channel)
	end
	self:effect("Channel",a.root.Position-Vector3.new(0,2.8,0),a.color,Vector3.new(4,0.12,4),spec.Channel)
	self:pushImpact(a.root.Position,"cast",false,{owner=a.id,fighter=a.fighterId,technique=spec.Id,channel=spec.Channel})
	return true
end
function Combat:updateActor(a,dt)
	local now=self.now
	if a.health&lt;=0 then a.hum:Move(Vector3.zero); return end
	-- Movement intents last exactly one frame; each control block re-declares its own.
	a.aimIntent=nil
	-- Directional memory for routes: the latest strong push, every frame.
	Brawler.observe(self,a)
	Defense.step(self,a,dt,now)
	Techniques.expireSeals(self,a,now)
	-- A combo ends once the victim has been free to act for a moment.
	if a.reaction or a.state=="Stunned" then a.freeSince=nil elseif not a.freeSince then a.freeSince=now end
	if a.freeSince and now-a.freeSince&gt;=Config.ComboScaling.Reset and (a.comboHits&gt;0 or (a.wallSplats or 0)&gt;0) then a.comboHits=0;a.comboDamage=0;a.wallSplats=0;a.splatPins=0;a.wallBounced=false;a.groundBounced=false end
	-- Substitution charges come back one at a time.
	if a.subCharges&lt;Config.Substitution.Charges and now&gt;=a.subRegenAt then
		a.subCharges+=1
		a.subRegenAt=if a.subCharges&lt;Config.Substitution.Charges then now+Config.Substitution.Recharge else math.huge
		self:cue(a,"SUBSTITUTION READY",.6)
	end
	Techniques.stepIllusion(self,a,now)
	if a.state~="TechniqueChannel" and a.state~="Stunned" then
		local regen=a.def.ChakraRegen or Config.ChakraRegen
		-- Closed chakra points (Gentle Fist) slow the recovery.
		if (a.tenketsuUntil or 0)&gt;now then regen*=math.max(.2,1-(a.tenketsuCut or .15)*(a.tenketsu or 0)) end
		if (a.awakenUntil or 0)&gt;now then regen*=a.def.Awakening.Regen or 1 end
		a.chakra=math.min(a.def.Chakra or Config.Chakra,a.chakra+regen*dt)
	end
	if (a.rotationUntil or 0)&gt;now then self:stepRotation(a) end
	if a.def.SandShield and a.shieldCharges&lt;a.def.SandShield.Charges and now&gt;=(a.shieldRegenAt or 0) then
		a.shieldCharges+=1
		local rate=if (a.awakenUntil or 0)&gt;now then (a.def.Awakening.ShieldRegen or 1) else 1
		a.shieldRegenAt=now+a.def.SandShield.Regen/rate
	end
	a.speedScale=if (a.awakenUntil or 0)&gt;now then (a.def.Awakening.Speed or 1) else 1
	-- The curse mark burns the body that carries it (never to a KO), faster
	-- while it goes hungry (Techniques.curseDrain).
	Techniques.curseDrain(self,a,dt,now)
	-- Rooted while spinning or striking the sixty-four palms.
	if (a.rotationUntil or 0)&gt;now or (a.flurryUntil or 0)&gt;now then a.move=Vector3.zero end
	if now&lt;(a.hitstopUntil or 0) then
		-- Weight, not a pause: the swing clock keeps running so the animation never
		-- drifts behind the hitbox, and only the frozen body is held still.
		a.hum:Move(Vector3.zero)
		if a.reaction then a.root.AssemblyLinearVelocity=Vector3.zero end
		World.pose(a,now,dt);return
	end
	if a.state~="Neutral" and a.state~="Guarding" and a.untilTime&lt;=now then
		local pending=a.pending
		if a.state=="Startup" and pending then
			-- The slam's active window is its sized descent; everything else uses
			-- the authored active duration.
			self:setState(a,"Active",if pending.slamWindow and pending.slamWindow&gt;0 then pending.slamWindow else pending.spec.active)
			a.activeAt=now
		elseif a.state=="Active" then
			Bangla.close(pending)
			-- The swing's own contact (Brawler.step), never a blade or a burn that
			-- landed while it was out.
			local brawl=pending~=nil and pending.kind=="Brawl"
			a.hitConfirmed=brawl and pending.contact==true
			-- A committed swing that never touched anything: report the whiff so
			-- the client can answer with air movement instead of silence.
			if brawl and not a.hitConfirmed then
				self:pushImpact(a.root.Position+a.root.CFrame.LookVector*2.2,"whiff",false)
				-- Genjutsu image / Sharingan Focus: a swing at the wrong place is read.
				Techniques.whiffRead(self,a,pending,now)
			end
			local recovery=if pending then pending.spec.recovery else .22
			a.pending=nil; self:setState(a,"Recovery",recovery)
			-- Cancel philosophy: a string continues only on a clean hit. On block the
			-- attacker keeps a dodge cancel (and Itachi a shuriken cancel); a whiff
			-- keeps its full recovery.
			a.chainOpen=a.hitConfirmed and not a.hitBlocked and brawl and pending.spec.chain==true
			a.chainAt=now
			-- Combo model: a clean chain hit keeps its string for the chain window
			-- plus the grace; a whiff or a block ends it (the next press opens).
			if brawl then Brawler.settle(self,a,pending) end
			local whiffHeavy=brawl and pending.name=="Heavy" and not a.hitConfirmed
			a.recoveryCancelAt=if whiffHeavy then a.untilTime else now+recovery*(if a.hitConfirmed then .36 else .72)
		elseif a.state=="Rush" then
			-- The dash is over: its arrival (Brawler.arrive).
			Brawler.arrive(self,a)
		elseif a.state=="Pursuit" then
			-- The chase arrived: a short window in which a press is the arrival
			-- strike (air string up there, dash attack on the ground) or heavy.
			a.pending=nil;a.attackName=nil;self:setState(a,"Neutral",0)
			a.rushArriveUntil=now+Config.Rush.Arrive
		elseif a.state=="TechniqueChannel" and pending then
			-- State changes before payoff so simultaneous channels resolve deterministically.
			self:setState(a,"TechniqueActive",pending.spec.Active)
			pending.implementation.execute(self,a,pending,now)
			Brawler.event(self,a,"TechniqueResolved")
		elseif a.state=="TechniqueActive" and pending then
			a.pending=nil; self:setState(a,"TechniqueRecovery",pending.spec.Recovery)
			-- A utility jutsu (Flow) yields the second half of its recovery to a
			-- guard or a dodge: it flows back into movement instead of freezing.
			if pending.spec.Flow then a.recoveryCancelAt=now+pending.spec.Recovery*.5 end
		else
			a.pending=nil;a.attackName=nil; self:setState(a,"Neutral",0)
		end
	end
	if self.match.phase~="Duel" then a.hum:Move(Vector3.zero); return end
 if a.state~="Dodging" then a.evade=nil end
	self:stepThrow(a)
	-- A guard key still held through a hit, a recovery or a throw comes back up
	-- as soon as the fighter is free. The automatic raise leaves guardPressedAt
	-- alone, so it never grants a fresh parry window.
	if a.guardWanted and a.state=="Neutral" and not a.guardHeld and not a.throwing and not a.reaction
		and not a.grabbedBy and not a.pending and Rules.canAct(a,now) then
		a.guardHeld=true;self:setState(a,"Guarding",0)
	end
	if a.hop then
		local step=math.min(a.hop.remaining,a.hop.speed*dt)
		a.hop.remaining-=step
		Motor.travel(a,self,a.hop.direction,step)
		if a.hop.remaining&lt;=.01 or a.reaction then a.hop=nil end
	end
	if a.castId and not a.pending and not a.throwing and a.state~="TechniqueRecovery" then a.castId=nil end
	-- A cast that started off-line turns into its aim through the channel.
	if a.castFace then
		if (a.state=="TechniqueChannel" or a.state=="TechniqueActive") and (a.rotationUntil or 0)&lt;=now then self:turnToward(a,a.castFace,dt,1440)
		elseif a.state~="TechniqueChannel" and a.state~="TechniqueActive" then a.castFace=nil end
	end
	if Brawler.step(self,a,dt) then World.pose(a,now,dt); return end
	if a.locked and (a.state=="Neutral" or a.state=="Guarding") then
		a.hum.AutoRotate=false
		self:faceLocked(a,dt)
	else a.hum.AutoRotate=not a.locked end
	if a.state=="Dodging" then
		Evade.step(a,self,Motor.travel)
	elseif a.state=="Pursuit" and (a.shadowUntil or 0)&gt;now then
		-- Shadow of the Dancing Leaf: glued just behind and below the rising
		-- body, closing the gap in proportion to it (no overshoot, no bobbing).
		local b=a.target
		local back=a.root.Position-b.root.Position;back=Vector3.new(back.X,0,back.Z)
		back=if back.Magnitude&gt;.1 then back.Unit else -b.root.CFrame.LookVector
		local point=b.root.Position+back*2.1-Vector3.new(0,1.1,0)
		local offset=point-a.root.Position
		a.airborne=true
		a.aimIntent={target=point,speed=math.clamp(offset.Magnitude*16,0,140),acceleration=3200}
		local flat=Vector3.new(-back.X,0,-back.Z)
		a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+flat)
	elseif a.state=="Pursuit" then
		-- Reach the victim in three dimensions, but kinetically: the chase keeps
		-- a continuous velocity instead of being teleported frame by frame. A
		-- body in a reaction flies on its reactionVelocity (its root velocity is
		-- held at zero), so that is what the chase leads. It arrives on its own
		-- side of the body, a step short and a little below, facing it, and ends
		-- as soon as the body is within reach and an air strike can follow it.
		local b=a.target
		local elapsed=now-(a.pursuitStarted or now)
		local remaining=math.max(.04,(a.pursuitDuration or .24)-elapsed)
		local velocity=if b.reaction and b.reactionVelocity then b.reactionVelocity else b.root.AssemblyLinearVelocity
		local lead=math.min(remaining,.15)
		local fall=if b.reaction and b.airborne then 37.5*lead*lead else 0
		local predicted=b.root.Position+velocity*lead-Vector3.new(0,fall,0)
		local line=a.pursuitLine or Vector3.new(a.root.CFrame.LookVector.X,0,a.root.CFrame.LookVector.Z).Unit
		local point=predicted-line*2.6-Vector3.new(0,.6,0)
		local toward=point-a.root.Position
		local distance=(b.root.Position-a.root.Position).Magnitude
		local face=Vector3.new(b.root.Position.X-a.root.Position.X,0,b.root.Position.Z-a.root.Position.Z)
		if face.Magnitude&gt;.3 then a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+face) end
		if Brawler.chaseArrived(self,a) then
			a.untilTime=math.min(a.untilTime,now)
		elseif toward.Magnitude&gt;.2 then
			-- Reach the window in time, then ease in on approach so the chaser
			-- never overshoots its own target and snaps back.
			local speed=math.clamp(toward.Magnitude/math.max(remaining,.06),70,420)
			if distance&lt;7 then speed=math.min(speed,60+distance*distance*3) end
			a.aimIntent={target=point,speed=speed,acceleration=1600}
		end
	elseif a.state=="Rush" then
		-- Chakra dash toward its arrival point (Brawler.rushPlan): a step short of
		-- the body, an angle beside it, or a committed line through it.
		local r=a.rush
		if not r then a.untilTime=math.min(a.untilTime,now)
		else
			local b=a.target
			if not r.line and (not r.commitAt or now&lt;r.commitAt) then r.goal=Brawler.rushGoal(a,r) end
			local toTarget=Vector3.new(b.root.Position.X-a.root.Position.X,0,b.root.Position.Z-a.root.Position.Z)
			local toGoal=Vector3.new(r.goal.X-a.root.Position.X,0,r.goal.Z-a.root.Position.Z)
			local committed=r.line~=nil or (r.commitAt~=nil and now&gt;=r.commitAt)
			local face=if committed then toGoal elseif toTarget.Magnitude&gt;.1 then toTarget else toGoal
			if face.Magnitude&gt;.1 then a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+face) end
			if toGoal.Magnitude&lt;.6 or (not r.line and toTarget.Magnitude&lt;=r.arrive) then a.untilTime=math.min(a.untilTime,now)
			else a.aimIntent={target=a.root.Position+toGoal,speed=r.speed,acceleration=1100} end
		end
	elseif (a.state=="Startup" or a.state=="Active") and a.pending and a.pending.kind=="Brawl" and a.attackName=="WallDive" then
		-- Wall dive: a beat crouched against the wall (held by airHold), then a
		-- straight lunge at the opponent's body.
		local delta=a.target.root.Position-a.root.Position
		local flat=Vector3.new(delta.X,0,delta.Z)
		if flat.Magnitude&gt;.1 then a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+flat) end
		if a.state=="Active" and delta.Magnitude&gt;2.8 then
			a.aimIntent={target=a.target.root.Position-delta.Unit*2.4,speed=92,acceleration=2600}
		end
	elseif a.state=="Active" and a.pending and a.pending.kind=="Brawl" and a.attackName=="Slam" then
  -- The slam owns a continuous plunge: a constant downward velocity with bounded
  -- acceleration, plus a gentle drift onto the victim. No per-frame correction.
  local delta=a.target.root.Position-a.root.Position
  local horizontal=Vector3.new(delta.X,0,delta.Z)
  if horizontal.Magnitude&gt;2.7 then
   -- Horizontal only: an aimed move toward a point at the same height braked
   -- the plunge (vertical velocity pulled toward 0) and moved it twice.
   Motor.travel(a,self,horizontal,math.min(horizontal.Magnitude-2.7,42*dt))
  end
  if a.airborne then
   local landed=Motor.descend(a,self,118,dt)
   if landed or a.root.Position.Y&lt;=self.match.origin.Y+3.6 then
    a.hum:ChangeState(Enum.HumanoidStateType.Landed)
    a.airborne=false;a.airHold=0
    a.root.AssemblyLinearVelocity=Vector3.zero
   end
  end
	elseif (a.state=="Startup" or a.state=="Active") and a.pending and a.pending.kind=="Brawl" and a.pending.spec.air and not a.pending.spec.orbit then
  local delta=a.target.root.Position-a.root.Position
  if delta.Magnitude&lt;10 and self:lineOfSight(a,a.target) then
		 local horizontal=Vector3.new(delta.X,0,delta.Z)
		 local planar=if horizontal.Magnitude&gt;2.7 then horizontal.Unit*math.min(horizontal.Magnitude-2.7,30*dt) else Vector3.zero
		 local vertical=math.clamp(delta.Y,-48*dt,48*dt)
		 if math.abs(delta.Y)&lt;.45 then vertical=0 end
		 local correction=planar+Vector3.new(0,vertical,0)
   Motor.flight(a,self,correction)
  end
 elseif (a.state=="Startup" or a.state=="Active") and a.pending and a.pending.kind=="Brawl" and a.travelRemaining&gt;0 then
		local toTarget=a.target.root.Position-a.root.Position
		local flatTarget=Vector3.new(toTarget.X,0,toTarget.Z)
		local gap=a.pending.spec.contact or 3.6
		if flatTarget.Magnitude&gt;gap then
			local elapsed=now-(a.attackStarted or now)
			local progress=math.clamp(elapsed/a.pending.spec.travelTime,0,1)
			local drive=.32+1.18*math.sin(progress*math.pi)
			if flatTarget.Magnitude&gt;.1 then a.travelDirection=(a.travelDirection:Lerp(flatTarget.Unit,math.min(1,dt*10))).Unit end
			local distance=math.min(a.travelRemaining,a.pending.spec.travel*drive*dt/a.pending.spec.travelTime,flatTarget.Magnitude-gap)
			a.travelRemaining-=Motor.travel(a,self,a.travelDirection,distance)
		end
	end
 local attack=a.pending
 if attack and attack.kind=="Brawl" and (a.state=="Startup" or a.state=="Active") then
  local delta=a.target.root.Position-a.root.Position
  local flat=Vector3.new(delta.X,0,delta.Z)
  -- A locked strike starting up to 11 studs out turns into the opponent here
  -- (Brawler.start no longer snaps the body round in one frame).
  if flat.Magnitude&gt;2 and flat.Magnitude&lt;(if a.state=="Startup" and a.locked then 11 else 9) then
   local tangent=Vector3.new(-flat.Z,0,flat.X).Unit
   local spec=attack.spec
   if spec.orbit and a.state~="Recovery" then
    -- Lateral routes: swing around the opponent's guard while striking (an
    -- air switch vaults all the way to the other side).
    if spec.air then Motor.flight(a,self,tangent*(a.angleSide or 1)*dt*spec.orbit)
    else Motor.travel(a,self,tangent*(a.angleSide or 1),dt*spec.orbit) end
   elseif a.fighterId=="Flashstep" and spec.angle then
    Motor.travel(a,self,tangent*(if spec.angle&lt;0 then -1 else 1),dt*(if a.airborne then 9 else 7))
   elseif a.fighterId=="Mirage" and a.state=="Active" and a.hitConfirmed and (attack.name=="Light3" or attack.name=="Air2") then
    Motor.travel(a,self,-flat,dt*9)
   end
   self:turnToward(a,flat,dt,1080)
  end
 end
	if a.landedAtSerial~=a.model:GetAttribute("MovementLandedAt") then
		a.landedAtSerial=a.model:GetAttribute("MovementLandedAt")
		-- Only a real drop shakes the lens and throws debris; a ninja jump lands
		-- light (Motor still leaves its small dust ring).
		if a.landedAtSerial and a.model:GetAttribute("MovementHardLanding")==true then self:pushImpact(a.root.Position,"landing",false) end
	end
	if a.aimIntent then
		-- Chase, slam drift and any other aimed motion outrank the hover window;
		-- hovering exists to hold a fighter still, never to cancel their movement.
		Motor.step(a,self,dt,now)
	elseif a.state=="Active" and a.attackName=="Slam" and a.airborne then
		-- The slam branch above already drove this frame's plunge; holding the
		-- body here would zero it every frame (a ~5 studs/s float, not a dive).
	elseif now&lt;(a.airHold or 0) and a.airborne then
		a.root.AssemblyLinearVelocity=Vector3.zero; a.hum:Move(Vector3.zero)
	else Motor.step(a,self,dt,now) end
	-- Server-owned humanoids + server-clamped arena coordinates.
	local p=a.root.Position
	if Vector3.new(p.X-self.match.origin.X,0,p.Z-self.match.origin.Z).Magnitude&gt;Config.ArenaRadius or p.Y&lt;self.match.origin.Y-3 then self:relocate(a,p) end
	World.pose(a,now,dt)
end
local IMPACT_STYLE={wire="shuriken",kunai="kunai",marked="kunai",shuriken="shuriken",wind="jutsu",fireball="fire",phoenix="ember",palm="palmburst",sand="sandhit",sandwave="sandburst"}
-- Eight Trigrams Rotation: blades and fire near the dome are deflected, and an
-- opponent inside it is thrown out once. Repelling a strike opens a counter.
local REFLECTED={kunai="kunai",shuriken="shuriken",marked="kunai"}
function Combat:stepRotation(a)
	-- Skill builds: a wider dome (rotationReach) and blades sent back at their
	-- thrower (rotationReflect), both set by Techniques.Rotation from the spec.
	local reach=a.rotationReach or Techniques.ROTATION_REACH or 7
	for i=#self.projectiles,1,-1 do
		local p=self.projectiles[i]
		if p.a~=a and (p.position-a.root.Position).Magnitude&lt;=reach+1.5 then
			table.remove(self.projectiles,i)
			self:pushImpact(p.position,"deflect",false,{projectile=p.id,kind=p.kind,owner=p.a.id,direction=-p.direction})
			Brawler.event(self,a,"Deflect")
			local thrower=p.a
			if a.rotationReflect and REFLECTED[p.kind] and thrower.health&gt;0 and a.target==thrower then
				local gap=(thrower.root.Position-p.position).Magnitude
				local back=self:projectile(a,thrower.root.Position,p.speed,gap+8,p.damage,REFLECTED[p.kind],nil,{origin=p.position})
				back.bounced=true
				Brawler.event(self,a,"Reflect")
			end
		end
	end
	local b=a.target
	a.rotationHit=a.rotationHit or {}
	if b and b.health&gt;0 and not a.rotationHit[b] and (b.root.Position-a.root.Position).Magnitude&lt;=reach then
		a.rotationHit[b]=true
		local attacking=b.state=="Startup" or b.state=="Active" or b.state=="Pursuit"
		local away=b.root.Position-a.root.Position;away=Vector3.new(away.X,0,away.Z)
		away=if away.Magnitude&gt;.1 then away.Unit else a.root.CFrame.LookVector
		self.damageTag="Rotation"
		local hit=self:damage(a,b,a.rotationDamage or 6,false,false)
		self.damageTag=nil
		if self.match.phase~="Duel" then return end
		-- The dome throws a body that was only standing in it out, even through a
		-- guard; a strike it turns aside staggers out of the dome instead, still
		-- inside the palm that answers (Techniques.rotationCounter).
		if hit then
			if attacking and b.airborne then Brawler.react(self,b,"Juggled",away*16+Vector3.new(0,14,0),.6,a)
			elseif attacking then Brawler.react(self,b,"HitStun",away*20,.6,a)
			else Brawler.react(self,b,"Knockback",away*48+Vector3.new(0,18,0),.55,a) end
		end
		self:pushImpact(b.root.Position,"repel",true,{owner=a.id,direction=away})
		if attacking then
			a.counterUntil=self.now+.9
			a.counterReach={expires=self.now+.9,max=7,variant="TrigramCounter"}
			Brawler.event(self,a,"Repel")
			self:cue(a,"ROTATION • REPELLED • COUNTER",.8);self:cue(b,"REPELLED",.6)
			Techniques.rotationCounter(self,a)
		end
	end
end
-- Delayed releases (hidden shuriken, the Phoenix Flower volley). Each entry
-- re-checks its owner when it fires, so a hit fighter never keeps throwing.
function Combat:schedule(at,fn)
	self.scheduled=self.scheduled or {}
	table.insert(self.scheduled,{at=at,fn=fn})
end
function Combat:runScheduled()
	local list=self.scheduled
	if not list or #list==0 then return end
	local due={}
	for i=#list,1,-1 do if list[i].at&lt;=self.now then table.insert(due,1,list[i]);table.remove(list,i) end end
	for _,entry in due do
		if self.match.phase~="Duel" then return end
		entry.fn()
	end
end
local function closestOnSegment(a,b,point)
	local ab=b-a
	local length=ab:Dot(ab)
	if length&lt;1e-6 then return a end
	return a+ab*math.clamp((point-a):Dot(ab)/length,0,1)
end
-- A Katon blast: the impact flash, a short splash, then flames that keep the
-- ground dangerous for a moment.
function Combat:fireExplosion(p,position,direct)
	local target=p.a.target
	-- A blast that misses the body becomes space denial: a wider patch of
	-- burning ground that holds the lane for a few seconds.
	if direct then self:addHazard(p.a,position,5.5,1.5,p.damage*.6,"Fire")
	else self:addHazard(p.a,position,7.5,3.2,p.damage*.45,"Fire") end
	if not direct and target and target.health&gt;0 then
		local delta=target.root.Position-position
		if delta.Magnitude&lt;=7.5 and workspace:Raycast(position,delta,self:rayParams(true))==nil then
			self.damageTag="splash"
			self:damage(p.a,target,p.damage*.5,false,false)
			self.damageTag=nil
		end
	end
end
-- Skill-build riders (SkillBuilds) on a clean projectile hit: a chase window
-- (Wind Cut, or a ricochet/Geometry blade with ToolMastery.Chase), a closed
-- chakra point (Vacuum Palm) and the fire patch of a blade that crossed the
-- thrower's burning ground. Inert for canonical kits.
function Combat:projectileRiders(p,target)
	local riders=p.riders or {}
	local owner=p.a
	local mastery=owner.def.ToolMastery
	local chase=riders.chase
	if not chase and p.bounced and p.kind=="shuriken" and mastery and mastery.Chase then chase=mastery.Chase end
	if chase then
		owner.pursuitUntil=math.max(owner.pursuitUntil or 0,self.now+chase)
		self:cue(owner,if p.kind=="wind" then "GUST • E TO CHASE" else "BLADE • E TO PURSUE",chase)
		Brawler.event(self,owner,"RiderChase")
	end
	if riders.tenketsu and owner.def.GentleFist and target.health&gt;0 then
		Brawler.gentleFist(self,owner,target,false)
		self:cue(owner,"VACUUM PALM • POINT CLOSED",.6)
	end
	if p.ignited and mastery and mastery.FireBlades then
		self:addHazard(owner,Vector3.new(target.root.Position.X,self.match.origin.Y+.5,target.root.Position.Z),2.5,mastery.FireBlades.Patch,p.damage,"Fire")
	end
end
-- Fire Geometry (skill build): a thrower's shuriken that crosses his own
-- burning ground catches fire once (+damage, an ember on the client).
function Combat:igniteBlade(p)
	local fire=p.a.def.ToolMastery.FireBlades
	for _,h in self.hazards do
		if h.a==p.a and h.kind=="Fire" then
			local d=p.position-h.position
			if Vector3.new(d.X,0,d.Z).Magnitude&lt;=h.radius and math.abs(d.Y)&lt;6 then
				p.ignited=true;p.damage+=fire.Damage
				self:pushImpact(p.position,"ember",false,{projectile=p.id,kind=p.kind,owner=p.a.id,direction=p.direction})
				Brawler.event(self,p.a,"BladeIgnited")
				return true
			end
		end
	end
	return false
end
function Combat:projectileHit(p,target,position,normal)
	local style=IMPACT_STYLE[p.kind] or "shuriken"
	self:pushImpact(position,style,p.kind=="fireball",{projectile=p.id,kind=p.kind,normal=normal,owner=p.a.id,victim=target.id,direction=p.direction})
	-- The entry still finishes the blade on the client; it only reads as a body
	-- hit once the defence has resolved. A blade that was evaded, parried or
	-- absorbed ends silently ("spent"): the defence pushed its own effect.
	local entry=self.impacts[#self.impacts]
	self.damageTag=p.kind
	self.hitOrigin=position-p.direction*4
	local damaged=self:damage(p.a,target,p.damage,false,false)
	if not damaged and entry and entry.projectile==p.id then entry.style="spent";entry.heavy=false end
	self.hitOrigin=nil
	self.damageTag=nil
	if self.match.phase~="Duel" then return end
	local guarded=target.impactStyle=="block"
	if damaged and not guarded then
		if p.kind=="sandwave" then
			Techniques.bindInSand(self,p.a,target)
		elseif p.kind=="wire" then
			Techniques.wireBind(self,p.a,target,p.riders,p.direction)
		elseif p.kind=="palm" then
			-- Vacuum Palm: a wall of air that carries the body away.
			local push=Vector3.new(p.direction.X,0,p.direction.Z)
			if push.Magnitude&lt;.05 then push=p.a.root.CFrame.LookVector end
			Brawler.react(self,target,"Knockback",push.Unit*54+Vector3.new(0,12,0),.5,p.a)
		elseif p.kind=="wind" then
			target.root.AssemblyLinearVelocity=p.direction*37+Vector3.new(0,14,0)
		elseif p.kind=="fireball" then
			local push=Vector3.new(p.direction.X,0,p.direction.Z)
			if push.Magnitude&lt;.05 then push=p.a.root.CFrame.LookVector end
			Brawler.react(self,target,"Knockback",push.Unit*44+Vector3.new(0,20,0),.55,p.a)
		end
		if p.riders or p.bounced or p.ignited then self:projectileRiders(p,target) end
	end
