		{ Id = "WallChidori", Name = "Wall Chidori", Branch = "Katon &amp; Chidori", Kind = "jutsu", Major = true, Cost = 12, Requires = { "ChidoriFocus" },
			Effects = { { "tech.Chidori.WallCharge", "set", 0.3 } },
