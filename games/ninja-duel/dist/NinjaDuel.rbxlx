</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND40">
        <Properties>
          <string name="Name">Techniques</string>
          <ProtectedString name="Source">-- Each entry supplies prerequisites and payoff. The combat pipeline owns cost,
-- channel, interruption, active window and recovery for every entry.
local Techniques = {}
local Elements=require(script.Parent.Elements)
-- Flying Thunder God seals. Minato can hold up to two planted kunai, one seal
-- placed on the opponent's body (a marked kunai that connects), and the marked
-- kunai still in flight. The stick chooses between them; with no input the
-- seal closest to the opponent wins, and a kunai in flight always does.
local MAX_PLANTED=2
local BODY_SEAL=5
Techniques.RANGE=90
local function syncAnchor(a)
	-- a.anchor mirrors the newest planted seal for HUD, AI and tooling.
	a.anchor=nil
	for _,entry in a.anchors or {} do if not entry.actor then a.anchor=entry end end
end
local function seals(c,a,now)
	local list={}
	local flying=c:markedInFlight(a)
	if flying then table.insert(list,{position=flying.position,flying=flying}) end
	local known={}
	for _,entry in a.anchors or {} do
		known[entry]=true
		if entry.expires&gt;now and (not entry.actor or entry.actor.health&gt;0) then
			table.insert(list,{position=if entry.actor then entry.actor.root.Position else entry.position,anchor=entry,body=entry.actor~=nil})
		end
	end
	-- A seal written directly into the single legacy slot still counts.
	if a.anchor and not known[a.anchor] and a.anchor.expires&gt;now then table.insert(list,{position=a.anchor.position,anchor=a.anchor}) end
	-- Yellow Flash: a body he has just launched, knocked away or splatted (his
	-- chase window is open) is a destination by itself. No seal is spent on it;
	-- the chase window is.
	local tune=a.def.Awakening
	local b=a.target
	if tune and tune.FlashPursuit and (a.awakenUntil or 0)&gt;now and b and b.health&gt;0 and (a.pursuitUntil or 0)&gt;now then
		local onBody=false
		for _,seal in list do if seal.body then onBody=true end end
		if not onBody then table.insert(list,{position=b.root.Position,body=true,virtual=true}) end
	end
	return list
end
Techniques.seals=seals
local function pick(c,a,now,range)
	local best,bestScore
	local stick=Vector3.new(a.move.X,0,a.move.Z)
	for _,seal in seals(c,a,now) do
		local gap=(seal.position-a.root.Position).Magnitude
		if gap&lt;=range then
			local score
			if seal.flying then score=1000
			else
				local toward=Vector3.new(seal.position.X-a.root.Position.X,0,seal.position.Z-a.root.Position.Z)
				if stick.Magnitude&gt;.4 and toward.Magnitude&gt;2 then
					local dot=stick.Unit:Dot(toward.Unit)
					if dot&gt;.3 then score=500+dot*100-gap*.2 end
				end
				if not score then score=100-(if a.target then (seal.position-a.target.root.Position).Magnitude else gap) end
			end
			if not bestScore or score&gt;bestScore then best,bestScore=seal,score end
		end
	end
	return best
end
Techniques.pickSeal=pick
local function sealOf(c,a,now)
	local seal=pick(c,a,now,math.huge)
	if seal then return seal.position,seal.flying end
	return nil,nil
end
Techniques.sealOf=sealOf
function Techniques.consumeSeal(c,a,seal)
	if seal.virtual then a.pursuitUntil=0;return end
	if seal.flying then seal.flying.dead=true;c:removeProjectile(seal.flying);return end
	local entry=seal.anchor
	if not entry then return end
	if entry.part then entry.part:Destroy() end
	local index=a.anchors and table.find(a.anchors,entry)
	if index then table.remove(a.anchors,index) end
	if a.anchor==entry then a.anchor=nil end
	syncAnchor(a)
end
function Techniques.expireSeals(c,a,now)
	if a.anchor and a.anchor.expires&lt;=now and not (a.anchors and table.find(a.anchors,a.anchor)) then
		if a.anchor.part then a.anchor.part:Destroy() end
		a.anchor=nil
	end
	if not a.anchors then return end
	local changed=false
	for i=#a.anchors,1,-1 do
		local entry=a.anchors[i]
		if entry.expires&lt;=now or (entry.actor and entry.actor.health&lt;=0) then
			if entry.part then entry.part:Destroy() end
			table.remove(a.anchors,i);changed=true
		end
	end
	if changed then syncAnchor(a) end
	-- Skill build (Kunai Recall): running over a planted kunai picks it up.
	local recall=a.def.SealRecall
	if recall and a.health&gt;0 and not a.reaction then Techniques.recall(c,a,now,recall) end
end
-- Kunai Recall (SkillTrees Flashstep.KunaiRecall): standing on one of his own
-- planted kunai removes it and refunds a little chakra. A seal planted under
-- 0.6 s ago is never swallowed by the throw that just planted it.
function Techniques.recall(c,a,now,recall)
	for i=#a.anchors,1,-1 do
		local entry=a.anchors[i]
		if not entry.actor and now-(entry.plantedAt or now)&gt;=.6 then
			local d=entry.position-a.root.Position
			if Vector3.new(d.X,0,d.Z).Magnitude&lt;=recall.Radius and math.abs(d.Y)&lt;4 then
				if entry.part then entry.part:Destroy() end
				table.remove(a.anchors,i);syncAnchor(a)
				a.chakra=math.min(a.def.Chakra or 100,a.chakra+recall.Refund)
				c:cue(a,"KUNAI RECOVERED • +"..recall.Refund.." CHAKRA",.7)
				require(script.Parent.Brawler).event(c,a,"KunaiRecall")
				return entry
			end
		end
	end
	return nil
end
-- Plant a seal on a surface, or on the opponent's body when the kunai connects.
function Techniques.plant(c,a,surface,normal,victim)
	a.anchors=a.anchors or {}
	a.sealSerial=(a.sealSerial or 0)+1
	local entry
	if victim then
		for i=#a.anchors,1,-1 do
			if a.anchors[i].actor then
				if a.anchors[i].part then a.anchors[i].part:Destroy() end
				table.remove(a.anchors,i)
			end
		end
		entry={actor=victim,position=victim.root.Position,expires=c.now+BODY_SEAL,id=a.sealSerial,plantedAt=c.now,
			part=c:effect("Body seal",victim.root.Position,a.color,Vector3.new(.6,.6,.6),BODY_SEAL)}
		c:cue(a,"SEAL ON TARGET • 2 TO FOLLOW",.9)
	else
		local planted={}
		for i,existing in a.anchors do if not existing.actor then table.insert(planted,i) end end
		if #planted&gt;=MAX_PLANTED then
			local oldest=a.anchors[planted[1]]
			if oldest.part then oldest.part:Destroy() end
			table.remove(a.anchors,planted[1])
		end
		local offset=if normal.Y&gt;0.5 then Vector3.new(0,3,0) else normal*3+Vector3.new(0,1,0)
		local at=c:clamp(surface+offset)
		-- Skill build (Seal Ink) may lengthen how long a planted seal holds.
		local life=(a.def.Seals and a.def.Seals.PlantedLife) or 12
		entry={position=at,surface=surface,normal=normal,expires=c.now+life,id=a.sealSerial,plantedAt=c.now,
			part=c:effect("Anchor",surface+normal*0.2,a.color,Vector3.new(1.3,0.2,1.3),life)}
		local count=0
		for _,existing in a.anchors do if not existing.actor then count+=1 end end
		c:cue(a,if count&gt;=1 then "SECOND SEAL PLANTED" else "SEAL PLANTED")
	end
	table.insert(a.anchors,entry)
	syncAnchor(a)
	return entry
end
-- Minato's substitution can reach a planted seal: the farthest one from the
-- attacker that is still in range. Spending a seal to escape is the cost.
function Techniques.escapeSeal(c,a,now)
	local attacker=a.target
	local best,bestGap
	for _,seal in seals(c,a,now) do
		if not seal.flying and not seal.body then
			local gap=(seal.position-a.root.Position).Magnitude
			local fromAttacker=if attacker then (seal.position-attacker.root.Position).Magnitude else gap
			if gap&lt;=70 and fromAttacker&gt;9 and (not bestGap or fromAttacker&gt;bestGap) then best,bestGap=seal,fromAttacker end
		end
	end
	return best
end
Techniques.MarkedBlade = {
	check = function() return true end,
	execute = function(c, a, pending, now)
		local aim=pending.aim or (a.target and a.target.root.Position) or a.root.Position+a.root.CFrame.LookVector*30
		c:projectile(a, aim, 82, pending.spec.Range, pending.spec.Damage, "marked", function(position, normal, victim)
			if a.health &lt;= 0 or c.match.phase ~= "Duel" then return end
			Techniques.plant(c,a,position,normal,victim)
		end)
	end,
}
Techniques.Flashstep = {
	check = function(c, a, _spec, now)
		return pick(c,a,now,Techniques.RANGE)~=nil
	end,
	execute = function(c,a,_pending,now)
		local seal=pick(c,a,now,Techniques.RANGE)
		if not seal then c:cue(a,"SEAL LOST"); return end
		local target=c:clamp(seal.position)
		-- A seal on (or right next to) the opponent puts Minato beside them. The
		-- stick picks the side; with no input he lands on the far side from where
		-- he left. Choosing the side is the mixup.
		local victim=a.target
		local beside=false
		if victim and victim.health&gt;0 then
			local toward=victim.root.Position-seal.position
			local flatGap=Vector3.new(toward.X,0,toward.Z).Magnitude
			if flatGap&lt;7 or seal.body then
				local stick=Vector3.new(a.move.X,0,a.move.Z)
				local side
				if stick.Magnitude&gt;.4 then side=stick.Unit
				else
					side=Vector3.new(victim.root.Position.X-a.root.Position.X,0,victim.root.Position.Z-a.root.Position.Z)
					side=if side.Magnitude&lt;.1 then -victim.root.CFrame.LookVector else side.Unit
				end
				target=c:clamp(Vector3.new(victim.root.Position.X,math.max(victim.root.Position.Y,c.match.origin.Y+3),victim.root.Position.Z)+side*3.4)
				beside=true
			end
		end
		if target.Y&lt;c.match.origin.Y+3 then target=Vector3.new(target.X,c.match.origin.Y+3,target.Z) end
		-- Never relocate into solid geometry, and never accept a client destination.
		local overlaps = workspace:GetPartBoundsInBox(CFrame.new(target),Vector3.new(2.6,4.6,2.6),c:overlapParams())
		for _, p in overlaps do
			if p.CanCollide and not p:IsDescendantOf(a.model) then
				if beside then target=c:clamp(seal.position);beside=false;break end
				c:cue(a,"ARRIVAL BLOCKED"); return
			end
		end
		local departure=a.root.Position
		c:effect("Departure",departure,a.color,Vector3.new(2,5,2),0.3)
		c:relocate(a,target)
		-- Arrive already facing the opponent so the follow-up starts on frame one.
		if victim and victim.health&gt;0 then
			local face=victim.root.Position-a.root.Position;face=Vector3.new(face.X,0,face.Z)
			if face.Magnitude&gt;.1 then a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+face) end
		end
		a.airborne=a.root.Position.Y&gt;c.match.origin.Y+4.2
		c:effect("Arrival",target,a.color,Vector3.new(3,5,3),0.45)
		Techniques.consumeSeal(c,a,seal)
		-- Yellow Flash: every jump leaves its own return point (a floor seal
		-- where he stood) and the arrival stays open longer, so relocations
		-- chain A -&gt; B -&gt; A instead of ending on the first arrival.
		local tune=a.def.Awakening
		local awake=tune~=nil and (a.awakenUntil or 0)&gt;now
		if awake and tune.FlashWake then
			local wake=Techniques.plant(c,a,Vector3.new(departure.X,c.match.origin.Y,departure.Z),Vector3.yAxis)
			wake.wake=true
			require(script.Parent.Brawler).event(c,a,"FlashWake")
		end
		-- The arrival opens a short window in which a strike (or Rasengan, with
		-- almost no wind-up) cancels the technique recovery.
		a.flashUntil=now+(if awake and tune.Arrival then tune.Arrival else .55);a.teleportAt=now
		a.teleportSerial=(a.teleportSerial or 0)+1
		c:pushImpact(target,"teleport",false,{owner=a.id,fighter=a.fighterId,from=departure,to=target,projectile=seal.flying and seal.flying.id,awake=awake,body=seal.virtual==true})
		local left=#seals(c,a,now)
		if seal.virtual then c:cue(a,"YELLOW FLASH • FLYING THUNDER GOD TO THE BODY",.7)
		else c:cue(a,if left&gt;0 then "FLYING THUNDER GOD • "..left.." SEAL"..(if left&gt;1 then "S" else "").." LEFT" else "FLYING THUNDER GOD",.7) end
	end,
}
Techniques.BurstStrike = {
	check = function() return true end,
	execute = function(c,a,pending)
		local Brawler=require(script.Parent.Brawler)
		if pending.variant=="RasenganDrop" then
			-- Airborne (chase, jump, wall): the Rasengan is driven straight down
			-- into the opponent and the floor, ending the air phase.
			Brawler.start(c,a,"Slam")
			local spec=table.clone(a.pending.spec)
			-- Skill build (Rasengan Drive): DropReaction "Spiked" makes the body
			-- bounce once off the floor for a pick-up instead of a flat knockdown.
			spec.damage=pending.spec.Damage*.9;spec.reaction=pending.spec.DropReaction or "Knockdown";spec.impulse=Vector3.new(0,-70,16);spec.stun=.92
			spec.width=6.5;spec.height=8
			a.pending.spec=spec;a.pending.rasengan=true;a.attackVariant="RasenganDrop"
			c:pushImpact(a.root.Position,"burst",false,{owner=a.id,fighter=a.fighterId})
			return
		end
		-- Channel commits chakra; release becomes a travelling physical attack.
		Brawler.start(c,a,"DashAttack")
		a.pending.spec=table.clone(a.pending.spec)
		a.pending.spec.damage=pending.spec.Damage;a.pending.spec.travel=10;a.pending.spec.recovery=.48
		-- Rasengan drives the body away spinning instead of a jab's stagger.
		a.pending.spec.reaction="Knockback";a.pending.spec.impulse=Vector3.new(0,22,70);a.pending.spec.stun=.62
		a.pending.rasengan=true;a.attackVariant="Rasengan"
		a.travelRemaining=10
		if pending.variant=="FlashRasengan" then
			-- Out of a teleport he is already beside the target: a short, fast thrust.
			a.pending.spec.travel=5;a.travelRemaining=5;a.pending.spec.recovery=.4
		end
		c:pushImpact(a.root.Position,"burst",false,{owner=a.id,fighter=a.fighterId})
	end,
}
Techniques.Read = {
	check = function() return true end,
	execute = function(c,a,pending,now)
		a.readUntil = now + pending.spec.Active
		c:effect("Read",a.root.Position,a.color,Vector3.new(4,0.2,4),pending.spec.Active)
		c:cue(a,"READ WINDOW")
	end,
}
Techniques.NeedleFan = {
	check = function() return true end,
	execute = function(c,a,pending)
		local direction = pending.aim-a.root.Position
		if direction.Magnitude &lt; 0.1 then direction = a.root.CFrame.LookVector end
		-- Five real shuriken in a fan: the centre blade tracks, the outer ones
		-- close the sideways escape.
		local origin=c.launchPoint(a,"Shuriken")
		for _, angle in { -0.2,-0.1,0,0.1,0.2 } do
			local d = CFrame.fromAxisAngle(Vector3.yAxis,angle):VectorToWorldSpace(direction.Unit)
			c:projectile(a,origin+d*pending.spec.Range,74,pending.spec.Range,pending.spec.Damage,"shuriken",nil,{origin=origin})
		end
		-- Shadow Shuriken: two more blades hidden behind the fan, released a beat
		-- later at wherever the opponent went to dodge it.
		for k=1,2 do
			c:schedule(c.now+.26+k*.06,function()
				if a.health&lt;=0 or a.reaction or a.state=="Stunned" or not a.target or a.target.health&lt;=0 then return end
				local victim=a.target
				local lead=victim.root.AssemblyLinearVelocity*Vector3.new(1,0,1)*.18
				if pending.spec.FlankBlades then
					-- Skill build (Flank Blades): each hidden blade is redirected
					-- beside the opponent and comes in from a flank, past a frontal guard.
					local toward=Vector3.new(victim.root.Position.X-a.root.Position.X,0,victim.root.Position.Z-a.root.Position.Z)
					toward=if toward.Magnitude&gt;.1 then toward.Unit else a.root.CFrame.LookVector
					local side=Vector3.new(-toward.Z,0,toward.X)*(if k==1 then -1 else 1)
					-- Beside and a little past the body, like Geometry's meeting point.
					local from=victim.root.Position+side*6+toward*1.5
					c:pushImpact(from,"clash",false,{owner=a.id,direction=-side})
					c:projectile(a,victim.root.Position+lead,86,12,pending.spec.Damage,"shuriken",nil,{origin=from})
					return
				end
				c:projectile(a,victim.root.Position+lead+a.root.CFrame.RightVector*(if k==1 then -.6 else .6),86,pending.spec.Range,pending.spec.Damage,"shuriken")
			end)
		end
		c:cue(a,"SHADOW SHURIKEN",.6)
	end,
}
-- Genjutsu: Mirage. Itachi leaves his image standing where he was and
-- withdraws a few steps straight back behind it, on the very line the
-- opponent is watching: the image covers him. A swing that reaches the image
-- (and not the body) gives the read away: the image breaks, the swing is
-- exposed and Itachi steps through his image with the counter palm. Trusting
-- the body works: walking into the image dissolves it, a blade thrown at him
-- passes through it, and any blow (his or yours) breaks the genjutsu.
local MIRAGE={Withdraw=5.5,Life=2.6,Touch=1.6,Reach=2,Exposed=.55,Counter=1.1,CounterReach=9}
Techniques.MIRAGE=MIRAGE
Techniques.MirageCast = {
	check = function(c,a,spec)
		return c:targetValid(a,a.target,spec.Range,0.35)
	end,
	execute = function(c,a,pending,now)
		if not c:targetValid(a,a.target,pending.spec.Range,0.35) then c:cue(a,"CAST LOST SIGHT"); return end
		local victim = a.target
		-- The Byakugan sees chakra, not light: the image has none.
		if victim.def.Byakugan then
			c:cue(victim,"BYAKUGAN • SEES THROUGH",1);c:cue(a,"GENJUTSU • SEEN THROUGH",1)
			c:pushImpact(a.root.Position,"mirage",false,{owner=a.id,fighter=a.fighterId,phase="seen",victim=victim.id})
			return
		end
		local Motor=require(script.Parent.Motor)
		local image=a.root.Position
		local away=image-victim.root.Position;away=Vector3.new(away.X,0,away.Z)
		away=if away.Magnitude&gt;.1 then away.Unit else -a.root.CFrame.LookVector
		if Motor.travel(a,c,away,MIRAGE.Withdraw)&lt;2.5 then
			-- A wall behind him: the withdrawal becomes a slip to the side (the
			-- stick's side when it points there); the image still stands in front.
			local side=Vector3.new(-away.Z,0,away.X)
			local stick=Vector3.new(a.move.X,0,a.move.Z)
			if stick.Magnitude&gt;.4 and stick:Dot(side)&lt;0 then side=-side end
			if Motor.travel(a,c,side,MIRAGE.Withdraw)&lt;2.5 then Motor.travel(a,c,-side,MIRAGE.Withdraw) end
		end
		local face=victim.root.Position-a.root.Position;face=Vector3.new(face.X,0,face.Z)
		if face.Magnitude&gt;.1 then a.root.CFrame=CFrame.lookAt(a.root.Position,a.root.Position+face) end
		victim.illusionUntil=now+MIRAGE.Life;victim.illusionAt=now;victim.illusionBy=a;victim.illusionKind="image"
		victim.decoyPosition=c:clamp(image)
		c:effect("Echo",victim.decoyPosition,a.color,Vector3.new(2,5,1),MIRAGE.Life)
		c:pushImpact(victim.decoyPosition,"mirage",false,{owner=a.id,fighter=a.fighterId,phase="cast",from=a.root.Position,to=victim.decoyPosition,victim=victim.id})
		c:cue(victim,"GENJUTSU • TRUST THE BODY",MIRAGE.Life)
		c:cue(a,"GENJUTSU • THE IMAGE HOLDS",1)
		require(script.Parent.Brawler).event(c,a,"Mirage")
	end,
}
-- Ends a genjutsu on `a` (the deceived fighter). why: "catch" | "touch" |
-- "break" | "expire"; the client finishes the image accordingly.
function Techniques.breakIllusion(c,a,why)
	local at=a.decoyPosition
	local caster=a.illusionBy
	a.illusionUntil=0;a.decoyPosition=nil;a.illusionBy=nil;a.illusionKind=nil;a.illusionAt=nil
	if at and why~="expire" then
		c:pushImpact(at,"mirage",false,{owner=caster and caster.id,fighter=caster and caster.fighterId,phase=why,victim=a.id})
	end
	if why=="touch" then
		c:cue(a,"GENJUTSU • DISPELLED",.7)
		if caster then c:cue(caster,"GENJUTSU • SEEN THROUGH",.7) end
	end
end
-- Every frame, for every fighter: a genjutsu image ends with its time, with
-- its caster, on any blow after it began (pain breaks it), or when the body
-- walks into the image. A skill-build echo (no kind) only keeps its timer.
function Techniques.stepIllusion(c,a,now)
	if (a.illusionUntil or 0)&lt;=now then
		if a.decoyPosition or a.illusionKind then a.decoyPosition=nil;a.illusionBy=nil;a.illusionKind=nil;a.illusionAt=nil end
		return
	end
	if a.illusionKind~="image" then return end
	local caster=a.illusionBy
	local since=a.illusionAt or now
	if not caster or caster.health&lt;=0 or (a.lastHurt or -10)&gt;since or (caster.lastHurt or -10)&gt;since then
		Techniques.breakIllusion(c,a,"break");return
	end
	local d=a.decoyPosition and a.decoyPosition-a.root.Position
	if d and a.state~="Startup" and a.state~="Active" and Vector3.new(d.X,0,d.Z).Magnitude&lt;=MIRAGE.Touch and math.abs(d.Y)&lt;4 then
		Techniques.breakIllusion(c,a,"touch")
	end
end
-- The swing bit the image: it breaks, the swing is exposed, the counter palm
-- opens with the reach to step through the image to the body.
function Techniques.mirageCatch(c,a,caster,pending,now)
	local legacy=a.illusionKind==nil
	Techniques.breakIllusion(c,a,"catch")
	caster.counterUntil=now+MIRAGE.Counter;caster.bonusUntil=now+MIRAGE.Counter
	caster.counterReach={expires=now+MIRAGE.Counter,max=MIRAGE.CounterReach,variant="MirageCounter"}
	require(script.Parent.Brawler).event(c,caster,"MirageCatch")
	c:cue(caster,"GENJUTSU • CAUGHT • PUNISH",1);c:cue(a,"GENJUTSU • EXPOSED",1)
	pending.spec=table.clone(pending.spec);pending.spec.recovery+=.32
	if not legacy then
		-- Exposed for a moment (a stun the counter reaches), not merely a longer
		-- recovery a dodge could cancel.
		c:schedule(now,function()
			if a.health&gt;0 and a.state=="Recovery" and not a.reaction then c:setState(a,"Stunned",MIRAGE.Exposed) end
		end)
	end
end
-- A committed swing that touched nothing (Combat, end of the active window).
-- Under a genjutsu image, a swing that reached the image is caught; under
-- Sharingan Focus any swing that misses close to Itachi is read. A skill-build
-- echo keeps its own rule: any swing at all while it holds.
function Techniques.whiffRead(c,a,pending,now)
	local caster=a.illusionBy or a.target
	if (a.illusionUntil or 0)&gt;now and caster and caster.health&gt;0 then
		local struck=false
		if a.illusionKind=="image" and a.decoyPosition then
			local d=a.decoyPosition-a.root.Position
			local flat=Vector3.new(d.X,0,d.Z)
			local reach=(pending.spec.range or 6)+MIRAGE.Reach
			struck=flat.Magnitude&lt;=reach and math.abs(d.Y)&lt;6 and (flat.Magnitude&lt;1 or a.root.CFrame.LookVector:Dot(flat.Unit)&gt;.3)
		elseif a.illusionKind==nil then
			struck=caster.fighterId=="Mirage"
		end
		if struck then Techniques.mirageCatch(c,a,caster,pending,now);return end
	end
	local eye=a.target
	local tune=eye and eye.def.Awakening
	if eye and eye.health&gt;0 and tune and tune.WhiffRead and (eye.awakenUntil or 0)&gt;now and not eye.reaction then
		local d=eye.root.Position-a.root.Position
		local flat=Vector3.new(d.X,0,d.Z)
		if flat.Magnitude&lt;=tune.WhiffRead and math.abs(d.Y)&lt;6 and (flat.Magnitude&lt;1 or a.root.CFrame.LookVector:Dot(flat.Unit)&gt;.2) then
			eye.counterUntil=math.max(eye.counterUntil or 0,now+.9);eye.bonusUntil=now+.9
			eye.counterReach={expires=now+.9,max=5,variant="ReadCounter"}
			pending.spec=table.clone(pending.spec);pending.spec.recovery+=.22
			c:pushImpact(eye.root.Position,"read",false,{owner=eye.id,fighter=eye.fighterId,victim=a.id,phase="whiff"})
			c:cue(eye,"SHARINGAN • WHIFF READ • PUNISH",.8);c:cue(a,"READ • EXPOSED",.6)
			require(script.Parent.Brawler).event(c,eye,"WhiffRead")
		end
	end
end
Techniques.Quickstep={
	check=function() return true end,
	execute=function(c,a,pending,now)
		local direction=if a.move.Magnitude&gt;0.2 then a.move else a.root.CFrame.RightVector
		local departure=a.root.Position
		local moved=require(script.Parent.Motor).travel(a,c,direction,11)
		c:effect("Quickstep",a.root.Position,a.color,Vector3.new(2,3,2),0.22)
		c:pushImpact(departure,"quickstep",false,{owner=a.id,fighter=a.fighterId,to=a.root.Position})
		-- Skill build (Quickstep Cut): the step opens the same arrival window as a
		-- teleport, so the new angle converts (strike, launcher or Rasengan).
		local arrival=pending and pending.spec.Arrival
		if arrival and moved&gt;3 then
			a.flashUntil=now+arrival
			c:cue(a,"ANGLE CREATED • STRIKE",arrival)
			return
		end
		c:cue(a,if moved&gt;3 then "ANGLE CREATED" else "ANGLE BLOCKED")
	end,
}
-- Great Fireball; on an opponent held by Sasuke's wire it becomes the Dragon
-- Flame: the fire runs along the wire and cannot miss.
Techniques.FireBloom={check=function() return true end,execute=function(c,a,pending,now)
	local b=a.wireVictim
	if b and b.reaction=="Bound" and b.boundBy==a and b.health&gt;0 then
		a.wireVictim=nil;b.boundBy=nil
		c.damageTag="Dragon Flame"
		local hit=c:damage(a,b,pending.spec.Damage,true,false)
		c.damageTag=nil
		if c.match.phase~="Duel" then return end
		c:pushImpact(b.root.Position,"fire",true,{owner=a.id,normal=Vector3.yAxis,from=a.root.Position})
		if hit then
			local away=b.root.Position-a.root.Position;away=Vector3.new(away.X,0,away.Z)
			away=if away.Magnitude&gt;.1 then away.Unit else a.root.CFrame.LookVector
			local Brawler=require(script.Parent.Brawler)
			Brawler.react(c,b,"Knockdown",away*30+Vector3.new(0,22,0),.8,a)
		end
		c:cue(a,"KATON • DRAGON FLAME",1)
		return
	end
	Elements.fire(c,a,pending,now)
end}
-- Wire Trap: a shuriken trailing ninja wire; a body it reaches is bound.
Techniques.WireTrap={
	check=function() return true end,
	execute=function(c,a,pending)
		local aim=pending.aim or (a.target and a.target.root.Position) or a.root.Position+a.root.CFrame.LookVector*20
		c:projectile(a,aim,86,pending.spec.Range,pending.spec.Damage,"wire",nil,{radius=.7,riders=if pending.spec.WallPin then {wallPin=pending.spec.WallPin} else nil})
		c:cue(a,"WIRE TRAP",.5)
	end,
}
-- `riders` (skill builds): bind = a shorter bind for wired hidden blades;
-- wallPin = {Range, Bind}: a wall close behind the body along the wire ties it
-- against the surface for longer (Wire Pin).
function Techniques.wireBind(c,owner,victim,riders,direction)
	if victim.health&lt;=0 then return end
	local Brawler=require(script.Parent.Brawler)
	local duration=(riders and riders.bind) or 1.0
	local pinned=false
	local pin=riders and riders.wallPin
	local along=direction and Vector3.new(direction.X,0,direction.Z)
	if pin and along and along.Magnitude&gt;.05 then
		local hit=workspace:Raycast(victim.root.Position,along.Unit*pin.Range,c:rayParams(true))
		if hit and math.abs(hit.Normal.Y)&lt;.3 and Brawler.splatSurface(hit.Instance) then
			c:relocate(victim,Vector3.new(hit.Position.X,victim.root.Position.Y,hit.Position.Z)+hit.Normal*1.7)
			duration=pin.Bind;pinned=true
			c:pushImpact(victim.root.Position,"pin",false,{owner=owner.id,normal=hit.Normal})
		end
	end
	Brawler.react(c,victim,"Bound",Vector3.zero,duration,owner)
	victim.boundBy=owner;owner.wireVictim=victim
	c:cue(owner,if pinned then "WIRED TO THE WALL • 1 = DRAGON FLAME" else "WIRED • 1 = DRAGON FLAME",.9);c:cue(victim,"WIRED • X TO ESCAPE",.9)
	Brawler.event(c,owner,if pinned then "WirePin" else "WireBind")
end
-- Chidori: the charge is the channel (slowed, interruptible); the release is
-- a straight lightning thrust that ends the fight's momentum either way.
Techniques.Chidori={
	check=function() return true end,
	execute=function(c,a,pending)
		local Brawler=require(script.Parent.Brawler)
		a.stringCancel=nil
		Brawler.start(c,a,"ChidoriThrust")
		if a.pending then a.pending.spec.damage=pending.spec.Damage end
		c:pushImpact(a.root.Position,"chidori",true,{owner=a.id})
		c:cue(a,"CHIDORI",.8)
	end,
}
-- Gaara ----------------------------------------------------------------
-- Sand Coffin: a wave of sand runs along the ground; a body it reaches is bound
-- (held where it stands) and buried a beat later unless it substitutes out.
function Techniques.bindInSand(c,owner,victim)
	if victim.health&lt;=0 or victim.invulnerableUntil&gt;c.now then return end
	local Brawler=require(script.Parent.Brawler)
	Brawler.react(c,victim,"Bound",Vector3.zero,1.25,owner)
	victim.boundBy=owner
	c:cue(owner,"SAND COFFIN • BOUND",.8);c:cue(victim,"BOUND • X TO ESCAPE",.9)
	local spec
	for _,t in owner.def.Techniques do if t.Id=="SandCoffin" then spec=t end end
	c:schedule(c.now+1.05,function()
		if victim.reaction~="Bound" or victim.boundBy~=owner or owner.health&lt;=0 or victim.health&lt;=0 then return end
		victim.boundBy=nil
		c.damageTag="Sand Burial"
		c:damage(owner,victim,(spec and spec.Damage) or 18,false,false)
		c.damageTag=nil
		if c.match.phase~="Duel" or victim.health&lt;=0 then return end
		Brawler.react(c,victim,"Knockdown",Vector3.new(0,16,0),.7,owner)
		c:pushImpact(victim.root.Position,"sandburial",true,{owner=owner.id})
		c:cue(owner,"SAND BURIAL",.8)
	end)
end
Techniques.SandCoffin={
	check=function() return true end,
	execute=function(c,a,pending)
		local aim=pending.aim or (a.target and a.target.root.Position) or a.root.Position+a.root.CFrame.LookVector*20
		local origin=c.launchPoint(a,"Ground")
		local flat=Vector3.new(aim.X-origin.X,0,aim.Z-origin.Z)
		if flat.Magnitude&lt;1 then flat=a.root.CFrame.LookVector*Vector3.new(1,0,1) end
		c:projectile(a,origin+flat.Unit*pending.spec.Range+Vector3.new(0,2,0),pending.spec.Speed or 46,pending.spec.Range,4,"sandwave",nil,{origin=origin+Vector3.new(0,1,0),radius=1.8,growth=.6})
		c:cue(a,"SAND COFFIN",.6)
	end,
}
Techniques.SandShuriken={
	check=function() return true end,
	execute=function(c,a,pending)
		local direction=pending.aim-a.root.Position
		if direction.Magnitude&lt;.1 then direction=a.root.CFrame.LookVector end
		local origin=c.launchPoint(a,"Palm")
		for _,angle in {-.25,-.15,-.05,.05,.15,.25} do
			local d=CFrame.fromAxisAngle(Vector3.yAxis,angle):VectorToWorldSpace(direction.Unit)
			c:projectile(a,origin+d*pending.spec.Range,80,pending.spec.Range,pending.spec.Damage,"sand",nil,{origin=origin,radius=.5})
		end
	end,
}
-- Desert Wave: a wall of sand rises in front of him and throws close
-- attackers away; blades and fire in it are swallowed.
Techniques.DesertWave={
	check=function() return true end,
	execute=function(c,a,pending)
		local Brawler=require(script.Parent.Brawler)
		local reach=pending.spec.Range
		local look=a.root.CFrame.LookVector
		for i=#c.projectiles,1,-1 do
			local p=c.projectiles[i]
			local d=p.position-a.root.Position
			if p.a~=a and d.Magnitude&lt;=reach and look:Dot(d.Unit)&gt;.2 then
				table.remove(c.projectiles,i)
				c:pushImpact(p.position,"deflect",false,{projectile=p.id,kind=p.kind,owner=p.a.id})
			end
		end
		local b=a.target
		if b and b.health&gt;0 then
			local d=b.root.Position-a.root.Position
			local flat=Vector3.new(d.X,0,d.Z)
			if flat.Magnitude&lt;=reach and (flat.Magnitude&lt;2 or look:Dot(flat.Unit)&gt;.25) then
				c.damageTag="Desert Wave"
				local hit=c:damage(a,b,pending.spec.Damage,false,false)
				c.damageTag=nil
				if c.match.phase~="Duel" then return end
				if hit then Brawler.react(c,b,"Knockback",(if flat.Magnitude&gt;.1 then flat.Unit else look)*48+Vector3.new(0,16,0),.55,a) end
			end
		end
		c:pushImpact(a.root.Position+look*4,"sandwall",true,{owner=a.id,direction=look})
		c:cue(a,"DESERT WAVE",.6)
	end,
}
-- Neji -----------------------------------------------------------------
Techniques.ROTATION_REACH=7
Techniques.Rotation={
	check=function() return true end,
	execute=function(c,a,pending,now)
		local active=pending.spec.Active
		a.rotationUntil=now+active;a.rotationHit={};a.rotationDamage=pending.spec.Damage
		-- Skill builds: a wider dome (Reach) and blades sent back (Reflect).
		a.rotationReach=pending.spec.Reach;a.rotationReflect=pending.spec.Reflect
		a.invulnerableUntil=math.max(a.invulnerableUntil,now+active);a.rotationGuardUntil=a.invulnerableUntil
		c:pushImpact(a.root.Position,"rotation",true,{owner=a.id,fighter=a.fighterId,duration=active})
		c:cue(a,"EIGHT TRIGRAMS • ROTATION",.7)
	end,
}
Techniques.VacuumPalm={
	check=function() return true end,
	execute=function(c,a,pending)
		local aim=pending.aim or (a.target and a.target.root.Position) or a.root.Position+a.root.CFrame.LookVector*20
		local origin=c.launchPoint(a,"Palm")
		local flat=Vector3.new(aim.X-origin.X,0,aim.Z-origin.Z)
		if flat.Magnitude&lt;1 then flat=a.root.CFrame.LookVector*Vector3.new(1,0,1) end
		local goal=origin+flat.Unit*pending.spec.Range+Vector3.new(0,math.clamp(aim.Y-origin.Y,-4,2),0)
		-- Skill build (Sealing Palm): a clean hit closes a chakra point at range.
		c:projectile(a,goal,pending.spec.Speed or 96,pending.spec.Range,pending.spec.Damage,"palm",nil,{origin=origin,radius=1.5,growth=2.5,riders=if pending.spec.Tenketsu then {tenketsu=true} else nil})
		c:cue(a,"EIGHT TRIGRAMS • VACUUM PALM",.6)
	end,
}
-- Eight Trigrams Sixty-Four Palms. The opening palm must land (and can be
-- guarded); once it does, the flurry locks the opponent in place, drains its
-- chakra point by point and ends by sealing its techniques. It is the climax of
-- the network: every chakra point already closed adds palms, quickens them and
-- lengthens the seal, and with all of them closed the guard has nothing left
-- to hold the opening palm with. The victim keeps one answer: a substitution.
local COUNTS={"2 PALMS","4 PALMS","8 PALMS","16 PALMS","32 PALMS","64 PALMS"}
function Techniques.palmsPlan(points,seal)
	points=math.clamp(points or 0,0,8)
	return {strikes=7+points,interval=math.max(.1,.15-.012*points),final=2.5+.25*points,seal=(seal or 3.5)+.4*points}
end
Techniques.SixtyFourPalms={
	check=function() return true end,
	execute=function(c,a,pending,now)
		local Brawler=require(script.Parent.Brawler)
		local victim=a.target
		local g=a.def.GentleFist
		pending.spec=table.clone(pending.spec)
		local points=if victim and (victim.tenketsuUntil or 0)&gt;now then victim.tenketsu or 0 else 0
		c:pushImpact(a.root.Position,"trigram",false,{owner=a.id,fighter=a.fighterId,points=points})
		local reach=victim and victim.health&gt;0 and c:targetValid(a,victim,pending.spec.Range,.4)
		if not reach or victim.invulnerableUntil&gt;now or (victim.rotationUntil or 0)&gt;now then
			pending.spec.Recovery=.85
			c:cue(a,"64 PALMS • MISSED",.7)
			return
		end
		if g and points&gt;=g.MaxPoints and victim.guardHeld then
			-- Every point closed: the guard collapses under the opening palm.
			victim.guardHeld=false
			if victim.state=="Guarding" then c:setState(victim,"Neutral",0) end
			c:cue(victim,"GUARD BREAK • THE NETWORK IS CLOSED",.9)
			Brawler.event(c,a,"GuardCollapse")
		end
		c.damageTag="64 Palms"
		local opened=c:damage(a,victim,pending.spec.Damage,false,true)
		c.damageTag=nil
		if c.match.phase~="Duel" then return end
		if not opened or victim.impactStyle=="block" then
			pending.spec.Recovery=.7
			c:cue(a,"64 PALMS • GUARDED",.7)
			return
		end
		Brawler.gentleFist(c,a,victim,false,"body")
		-- Lock: Neji holds the technique, the victim is held in place.
		local plan=Techniques.palmsPlan(points,pending.spec.Seal)
		local strikes,interval=plan.strikes,plan.interval
		c:setState(a,"TechniqueActive",strikes*interval+.25)
		a.flurryUntil=now+strikes*interval+.2
		Brawler.react(c,victim,"HitStun",Vector3.zero,strikes*interval+.3,a)
		victim.flurriedBy=a
		c:cue(a,if points&gt;0 then "EIGHT TRIGRAMS • 64 PALMS • "..points.." POINTS OPEN THE WAY" else "EIGHT TRIGRAMS • 64 PALMS",1)
		for k=1,strikes do
			c:schedule(now+k*interval,function()
				if a.health&lt;=0 or a.state~="TechniqueActive" or victim.health&lt;=0 or victim.reaction~="HitStun" or victim.flurriedBy~=a then return end
				local last=k==strikes
				c.damageTag="64 Palms"
				c:damage(a,victim,if last then pending.spec.Damage*plan.final else pending.spec.Damage,false,false)
				c.damageTag=nil
				if c.match.phase~="Duel" or victim.health&lt;=0 then return end
				Brawler.gentleFist(c,a,victim,false,"body")
				c:pushImpact(victim.root.Position,"palm",last,{owner=a.id,direction=a.root.CFrame.LookVector})
				c:cue(a,COUNTS[math.min(#COUNTS,k)] or "64 PALMS",.4)
				if last then
					victim.flurriedBy=nil
					victim.sealedUntil=c.now+plan.seal
					Brawler.sealPoints(c,a,victim)
					local away=victim.root.Position-a.root.Position;away=Vector3.new(away.X,0,away.Z)
					away=if away.Magnitude&gt;.1 then away.Unit else a.root.CFrame.LookVector
					Brawler.react(c,victim,"Knockback",away*46+Vector3.new(0,16,0),.6,a)
					c:cue(victim,"CHAKRA POINTS SEALED",1.2)
				else
					victim.reactionUntil=math.max(victim.reactionUntil,c.now+interval+.15)
				end
			end)
		end
	end,
}
-- Rotation that repelled a strike flows straight into its answer: the dome
-- winds down at once (no full recovery), and a strike pressed during the spin
-- is the twin palm gliding out of it.
function Techniques.rotationCounter(c,a)
	local now=c.now
	local queued=a.counterQueued~=nil and now-a.counterQueued&lt;=.9
	local stop=if queued then now else now+.08
	a.rotationUntil=math.min(a.rotationUntil or 0,stop)
	-- A strike pressed while the dome winds down cancels straight into the counter.
	a.rotationCounterUntil=a.counterUntil
	if a.rotationGuardUntil and math.abs((a.invulnerableUntil or 0)-a.rotationGuardUntil)&lt;1e-6 then a.invulnerableUntil=stop end
	local p=a.pending
	if p and p.kind=="Technique" and p.spec.Id=="Rotation" and a.state=="TechniqueActive" then
		p.spec=table.clone(p.spec);p.spec.Recovery=.04
		a.untilTime=math.min(a.untilTime,stop)
	end
	if queued then
		c:schedule(now,function()
			if a.health&lt;=0 or (a.counterUntil or 0)&lt;=c.now or a.reaction then return end
			if a.state=="TechniqueActive" or a.state=="TechniqueRecovery" then a.pending=nil;a.rotationUntil=0;c:setState(a,"Neutral",0) end
			require(script.Parent.Brawler).counterStart(c,a)
		end)
	end
end
Techniques.PhoenixFlower={check=function() return true end,execute=Elements.phoenix}
-- Minato's Wind Cut: a crescent of wind thrown off the kunai's edge on the run
-- (the legs never stop). It cuts enemy blades out of its lane, and a body it
-- cuts is thrown a step sideways with a short wind seal on it: the very next
-- Flying Thunder God lands beside that body, on the side the stick picks.
-- A guard stops the gust and keeps no seal.
local BLADES={kunai=true,shuriken=true,marked=true,wire=true}
local WIND={Seal=1.6,Cut=22,Lane=1.4,Radius=1.6}
Techniques.WIND=WIND
local function cutLane(c,a,gust)
	c:schedule(c.now+.015,function()
		if not table.find(c.projectiles,gust) or c.match.phase~="Duel" then return end
		local radius=gust.radius+(gust.growth or 0)*(c.now-gust.born)+WIND.Lane
		for i=#c.projectiles,1,-1 do
			local q=c.projectiles[i]
			if q~=gust and q.a~=a and BLADES[q.kind] and (q.position-gust.position).Magnitude&lt;=radius then
				table.remove(c.projectiles,i)
				c:pushImpact(q.position,"deflect",false,{projectile=q.id,kind=q.kind,owner=q.a.id,direction=-q.direction})
				require(script.Parent.Brawler).event(c,a,"WindCutBlade")
			end
		end
		cutLane(c,a,gust)
	end)
end
function Techniques.windSeal(c,a,b,direction,stick)
	local Brawler=require(script.Parent.Brawler)
	local across=Vector3.new(-direction.Z,0,direction.X)
	across=if across.Magnitude&gt;.05 then across.Unit else a.root.CFrame.RightVector
	if stick and stick.Magnitude&gt;.4 and stick:Dot(across)&lt;0 then across=-across end
	Brawler.react(c,b,if b.airborne then "Juggled" else "HitStun",across*WIND.Cut+(if b.airborne then Vector3.new(0,10,0) else Vector3.zero),.45,a)
	-- A longer seal already on that body (a marked kunai) is kept, not shortened.
	local kept=false
	for _,entry in a.anchors or {} do if entry.actor==b and entry.expires&gt;c.now+WIND.Seal then kept=true end end
	if not kept then
		local entry=Techniques.plant(c,a,b.root.Position,Vector3.yAxis,b)
		entry.expires=c.now+WIND.Seal;entry.wind=true
	end
	c:pushImpact(b.root.Position,"windseal",false,{owner=a.id,fighter=a.fighterId,victim=b.id,direction=across})
	c:cue(a,"WIND CUT • SEALED • FLASH BESIDE IT",.9)
	Brawler.event(c,a,"WindSeal")
end
Techniques.WindCut={
	check=function() return true end,
	execute=function(c,a,pending)
		local spec=pending.spec
		local aim=pending.aim or (a.target and a.target.root.Position) or a.root.Position+a.root.CFrame.LookVector*spec.Range
		local origin=c.launchPoint(a,"Wind")
		local flat=Vector3.new(aim.X-origin.X,0,aim.Z-origin.Z)
		if flat.Magnitude&lt;1 then flat=a.root.CFrame.LookVector*Vector3.new(1,0,1) end
		local goal=origin+flat.Unit*spec.Range+Vector3.new(0,math.clamp(aim.Y-origin.Y,-3,2),0)
		local stick=Vector3.new(a.move.X,0,a.move.Z)
		local gust
		-- Skill build (Gale Chase): a gust that connects also opens the chase.
		gust=c:projectile(a,goal,spec.Speed or 104,spec.Range,spec.Damage,"wind",function(_,_,victim)
			if not victim or victim.health&lt;=0 or a.health&lt;=0 or c.match.phase~="Duel" then return end
			Techniques.windSeal(c,a,victim,gust.direction,stick)
		end,{origin=origin,radius=WIND.Radius,riders=if spec.Chase then {chase=spec.Chase} else nil})
		cutLane(c,a,gust)
		c:cue(a,"WIND CUT",.5)
	end,
}
-- Awakening rules that live on a landed strike (Brawler.hit). Before the
-- reaction: Minato's skill-build Flow chain; the Curse Mark feeding on the
-- fight. After it (awakenedReact): the Curse Mark's extensions.
function Techniques.awakenedHit(c,a,b,p)
	local tune=a.def.Awakening
	if not tune or (a.awakenUntil or 0)&lt;=c.now or b.health&lt;=0 then return end
	-- Skill build (Flow, Minato's awakening): a clean hit right after a teleport
	-- arrival seals the body again, so the relocation chain continues.
	local chain=tune.FlashChain
	if chain and a.teleportAt and c.now-a.teleportAt&lt;.7 then
		local entry=Techniques.plant(c,a,b.root.Position,Vector3.yAxis,b)
		entry.expires=c.now+chain
		c:cue(a,"FLOW • SEALED AGAIN",.7);require(script.Parent.Brawler).event(c,a,"FlowSeal")
	end
	-- Curse Mark: a landed blow quiets the seal for a moment (it feeds on the fight).
	if tune.HealthDrain then a.curseFedUntil=c.now+(tune.Feed or 0);a.curseLanded=c.now end
end
function Techniques.awakenedReact(c,a,b,p)
	local tune=a.def.Awakening
	if not tune or (a.awakenUntil or 0)&lt;=c.now or b.health&lt;=0 then return end
	local Brawler=require(script.Parent.Brawler)
	if tune.Extension and (p.name=="Light3" or p.name=="AirDrive") and b.reaction=="Knockback" and (a.curseHoldReadyAt or 0)&lt;=c.now then
		-- The cursed kick does not let go: a short stagger instead of the
		-- knock-away, and the string stays open for the next route (heavy =
		-- the launcher, which the curse turns into the Dancing Leaf). Once per
		-- exchange: the next ender within 2.5 s knocks away as usual.
		a.curseHoldReadyAt=c.now+2.5
		local v=b.reactionVelocity or Vector3.zero
		local flat=Vector3.new(v.X,0,v.Z)
		flat=if flat.Magnitude&gt;.1 then flat.Unit else a.root.CFrame.LookVector*Vector3.new(1,0,1)
		-- (The knockback just marked the body airborne: judge by its height.)
		if b.root.Position.Y&gt;c.match.origin.Y+4.2 then Brawler.react(c,b,"Juggled",flat*12+Vector3.new(0,14,0),.55,a)
		else b.airborne=false;Brawler.react(c,b,"HitStun",flat*14,.5,a) end
		p.spec.chain=true
		-- A string ender closes its string when it starts (combo model): the
		-- held kick keeps the three confirmed hits, so heavy is the launcher.
		a.combo=math.max(a.combo or 0,3);a.stringAt=c.now
		c:pushImpact(b.root.Position,"curse",false,{owner=a.id,fighter=a.fighterId,victim=b.id})
		c:cue(a,"CURSE MARK • IT DOES NOT LET GO",.6)
		Brawler.event(c,a,"CurseExtension")
	end
	if tune.CursedLeaf and b.reaction=="Launched" and p.name~="LionKick" then Techniques.cursedLeaf(c,a,b) end
end
-- Curse Mark: every launcher becomes the Dancing Leaf (a free chase glued
-- under the body; heavy up there is the Lion Combo).
function Techniques.cursedLeaf(c,a,b)
	local Config=require(game:GetService("ReplicatedStorage").NinjaDuel.Config)
	local Brawler=require(script.Parent.Brawler)
	a.lionUntil=c.now+2.1
	c:schedule(c.now+.12,function()
		if a.health&lt;=0 or b.health&lt;=0 or c.match.phase~="Duel" or not (b.reaction=="Launched" or b.reaction=="Juggled") then return end
		a.chakra+=Config.PursuitCost
		local from=a.root.Position
		if c:request(a,"Pursuit") then
			a.untilTime=c.now+.5;a.shadowUntil=a.untilTime;a.airHold=c.now+1.1
			c:pushImpact(from,"afterimage",false,{owner=a.id,fighter=a.fighterId})
			c:cue(a,"CURSED LEAF • HEAVY = LION COMBO",1)
			Brawler.event(c,a,"CursedLeaf")
		else a.chakra-=Config.PursuitCost end
	end)
end
-- Curse Mark drain: it burns faster while he is not landing blows (hunger),
-- pauses for a moment after each one, and never kills.
function Techniques.curseDrain(c,a,dt,now)
	local tune=a.def.Awakening
	if not (tune and tune.HealthDrain) or (a.awakenUntil or 0)&lt;=now or a.health&lt;=1 then a.curseHunger=false;return end
	local rate=tune.HealthDrain
	if (a.curseFedUntil or 0)&gt;now then rate=0
	elseif tune.Hunger and now-(a.curseLanded or a.awakenedAt or now)&gt;1.5 then rate*=tune.Hunger end
	a.curseHunger=rate&gt;tune.HealthDrain
	if rate&gt;0 then a.health=math.max(1,a.health-rate*dt);a.hum.Health=math.max(1,a.health) end
end
return Techniques
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND41">
        <Properties>
          <string name="Name">Tutorial</string>
          <ProtectedString name="Source">-- Objectives observe the real engine; setups reset the practice pair, never fake success.
local Brawler=require(script.Parent.Brawler)
local Tutorial={}
Tutorial.Steps={
 {title="Move",pad="L stick",key="W A S D",kind="Move"},
 {title="Sprint",pad="L3, then move",key="Hold CTRL + move",kind="Sprint"},
 {title="Jump and land",pad="×",key="SPACE",kind="Land"},
 {title="Unlock, then lock the target",pad="R3 twice",key="SHIFT twice",kind="Lock"},
 {title="Directional dash",pad="L stick + ○",key="Direction + Q",event="Dodge"},
 {title="Run up the wall, then rebound",pad="Push L stick into wall, then ×",key="Move into wall, then SPACE",kind="Wall"},
 {title="Land three light strikes",pad="□ three times",key="LMB three times",kind="Combo"},
 {title="Branch into a launcher",pad="□, □, then toward + □ (or △)",key="LMB, LMB, then toward + LMB (or RMB)",event="LaunchHit"},
 {title="Chase the launched target",pad="× after launch",key="E or SPACE after launch",kind="Chase"},
 {title="Land two aerial strikes",pad="□ twice in air",key="LMB twice in air",kind="AirCombo"},
 {title="Finish downward",pad="△ in air",key="RMB in air",event="SlamHit"},
 {title="Guard the incoming strike",pad="Hold L1",key="Hold F",event="GuardHit"},
 {title="Dodge the incoming strike",pad="○ during windup",key="Q during windup",kind="Evade"},
 {title="Escape after being hit",pad="○ just after contact",key="X just after contact",event="Substitute"},
 {title="Grab, then throw",pad="L2, then □ (△ throws upward)",key="V, then LMB (RMB throws upward)",event="ThrowHit"},
 {title="Perform a character technique",pad="Hold R1 + ×",key="1",kind="Technique"},
 {title="Interrupt the telegraphed technique",pad="□ during hand signs",key="LMB during hand signs",kind="Interrupt"},
 {title="Go low: two hits, then away + strike",pad="□, □, then away + □",key="LMB, LMB, then away + LMB",event="RouteDown"},
 {title="Turn the angle: one hit, then sideways + strike",pad="□, then sideways + □",key="LMB, then sideways + LMB",event="RouteSide"},
 {title="Win the practice duel",pad="Use your complete kit",key="Use your complete kit",kind="Win"},
}
function Tutorial.new(s)
 local t={index=1,entered=0,baseline={},travel=0,seenAir=false,seenWall=false,unlocked=false,attackAt=0};s.tutorial=t;return t
end
function Tutorial.enter(s,now)
 local t,a,b=s.tutorial,s.human,s.bot;t.entered=now;t.completedAt=nil;t.baseline=table.clone(a.events or {});t.travel=0;t.seenAir=false;t.seenWall=false;t.unlocked=false;t.health=a.health;t.lastPosition=a.root.Position
 local c=s.combat;c:clear(true)
 for _,actor in {a,b} do actor.health=actor.def.Health;actor.hum.Health=actor.health;actor.state="Neutral";actor.chakra=actor.def.Chakra;actor.subCharges=2;actor.subCooldown=0;actor.subRegenAt=math.huge;actor.comboHits=0;actor.cooldowns={};actor.invulnerableUntil=0 end
 t.health=a.health
 b.trainingChannelScale=if t.index==17 then 3 else 1
 local near=t.index&gt;=7 and t.index~=16
 c:relocate(a,s.origin+Vector3.new(0,3,if near then 3 else 14));c:relocate(b,s.origin+Vector3.new(0,3,if near then -2 else -14))
 -- Wall step: start a few strides from the stadium wall (east side).
 if t.index==6 then local R=require(script.Parent.World).WALL_RADIUS;c:relocate(a,s.origin+Vector3.new(R-7,3,0));c:relocate(b,s.origin+Vector3.new(R-17,3,0)) end
 a.root.CFrame=CFrame.lookAt(a.root.Position,b.root.Position);b.root.CFrame=CFrame.lookAt(b.root.Position,a.root.Position)
 if t.index==9 then Brawler.react(c,b,"Launched",Vector3.new(0,48,0),1.2);a.pursuitUntil=now+1.2 end
 if t.index==10 or t.index==11 then
  c:relocate(a,s.origin+Vector3.new(0,16,3));c:relocate(b,s.origin+Vector3.new(0,16,-2));a.airborne=true;a.airHold=now+1.8
  Brawler.react(c,b,"Juggled",Vector3.zero,1.8)
 end
 t.attackAt=now+1
end
-- The bot's longest interruptible channel: the one the player learns to break.
function Tutorial.interruptSlot(b)
 local best,bestChannel="Technique1",-1
 for slot,spec in b.def.Techniques do
  if spec.Interruptible and spec.Channel&gt;bestChannel and not spec.Requires and not spec.Mobile then best,bestChannel="Technique"..slot,spec.Channel end
 end
 return best
end
function Tutorial.update(s,now,dt)
 local t,a,b=s.tutorial,s.human,s.bot;local c=s.combat
 if t.entered==0 then Tutorial.enter(s,now) end
 local spec=Tutorial.Steps[t.index]
 b.move=Vector3.zero;b.sprinting=false
 if spec.kind=="Win" then s.ai:update(now);return end
 local displacement=(a.root.Position-(t.lastPosition or a.root.Position)).Magnitude;t.travel+=math.min(displacement,4);t.lastPosition=a.root.Position
 local function event(name) return (a.events and a.events[name] or 0)&gt;(t.baseline[name] or 0) end
 local done=spec.event and event(spec.event)
 if spec.kind=="Move" then done=t.travel&gt;12
 elseif spec.kind=="Sprint" then done=a.sprinting and a.locomotion.Magnitude&gt;30
 elseif spec.kind=="Land" then t.seenAir=t.seenAir or a.airborne;done=t.seenAir and not a.airborne
 elseif spec.kind=="Lock" then t.unlocked=t.unlocked or not a.locked;done=(t.unlocked or event("Unlock")) and a.locked and event("Lock")
 elseif spec.kind=="Wall" then t.seenWall=t.seenWall or a.wall~=nil;done=t.seenWall and (a.wallJumpUntil or 0)&gt;now
 elseif spec.kind=="Combo" then done=(a.events and a.events.Hit or 0)-(t.baseline.Hit or 0)&gt;=3
 elseif spec.kind=="Chase" then done=event("Chase") and a.state=="Neutral" and a.airborne and (a.root.Position-b.root.Position).Magnitude&lt;7
 elseif spec.kind=="AirCombo" then done=(a.events and a.events.AirHit or 0)-(t.baseline.AirHit or 0)&gt;=2
 elseif spec.kind=="Technique" then done=event("TechniqueResolved") or (event("Technique") and a.state=="TechniqueRecovery")
 elseif spec.kind=="Evade" then done=event("Dodge") and (event("Evaded") or (b.attackName=="Heavy" and now-(b.attackStarted or now)&gt;.46 and a.health==t.health))
 elseif spec.kind=="Interrupt" then done=event("Interrupt") end
 if done and not t.completedAt then t.completedAt=now end
 if t.completedAt and now-t.completedAt&gt;=.22 then t.index+=1;Tutorial.enter(s,now);return end
 if (t.index==12 or t.index==13 or t.index==14) and now&gt;=t.attackAt then
  if (b.root.Position-a.root.Position).Magnitude&gt;7 then c:relocate(b,a.root.Position+a.root.CFrame.LookVector*5) end
  b.root.CFrame=CFrame.lookAt(b.root.Position,a.root.Position);c:request(b,"Heavy");t.attackAt=now+1.7
 end
 if t.index==17 and now&gt;=t.attackAt then
  b.cooldowns={};b.chakra=b.def.Chakra;c:request(b,Tutorial.interruptSlot(b),a.root.Position);t.attackAt=now+1.4
 end
 -- Failed launch/juggle exercises reset quickly without skipping their objectives.
 if (t.index==9 or t.index==10 or t.index==11) and now-t.entered&gt;3 then Tutorial.enter(s,now) end
 if a.health&lt;a.def.Health*.3 then a.health=a.def.Health;a.hum.Health=a.health end
 if b.health&lt;b.def.Health*.25 then b.health=b.def.Health;b.hum.Health=b.health end
end
function Tutorial.snapshot(s)
 local t=s.tutorial;if not t then return nil end
 local step=Tutorial.Steps[t.index]
 return {index=t.index,total=#Tutorial.Steps,title=step.title,pad=step.pad,key=step.key}
end
return Tutorial
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND42">
        <Properties>
          <string name="Name">VelmoraAntiCheat</string>
          <ProtectedString name="Source">-- Adapted from Velmora src/server/Combat/CombatAntiCheat.luau.
-- Copyright (c) 2026 Yashveer Singh, MIT.
local Tune=require(game:GetService('ReplicatedStorage').NinjaDuel.VelmoraCombatConfig)
local AntiCheat={}
local last={}
function AntiCheat.check(actor,action,clientTime,now)
	if type(action)~='string' then return false end
	if clientTime~=nil then
		if type(clientTime)~='number' or clientTime~=clientTime then return false end
		local delta=now-clientTime
		if delta&lt;-.05 or delta&gt;Tune.History+Tune.TimestampWindow then return false end
	end
	local clock=os.clock();local bucket=last[actor]
	if not bucket then bucket={};last[actor]=bucket end
	local family=if string.match(action,'^Technique') then 'Technique' else action
	local gap=Tune.Rates[family] or .04
	if bucket[family] and clock-bucket[family]&lt;gap then return false end
	bucket[family]=clock
	return true
end
function AntiCheat.clear(actor) last[actor]=nil end
return AntiCheat
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND43">
        <Properties>
          <string name="Name">VelmoraDefense</string>
          <ProtectedString name="Source">-- Adapted from Velmora CombatService guard/parry/dodge resolution.
-- Copyright (c) 2026 Yashveer Singh, MIT.
local Tune=require(game:GetService('ReplicatedStorage').NinjaDuel.VelmoraCombatConfig)
local Defense={}
function Defense.init(a)
	a.stamina=100;a.guardPressedAt=-math.huge;a.parryReadyAt=0;a.dodgeStartedAt=-math.huge;a.bloodstepGrantedFor=-math.huge
end
function Defense.guard(a,down,now)
	if down and not a.guardHeld then a.guardPressedAt=now end
	a.guardHeld=down
end
function Defense.dodge(a,now)
	a.dodgeStartedAt=now
	a.invulnerableUntil=math.max(a.invulnerableUntil,now+Tune.DodgeIFrames)
end
-- `melee`: the blow came from the attacker's own body. Only then can a parry
-- stun them; a parried blade, flame or hazard is simply negated.
function Defense.resolve(c,attacker,victim,amount,frontal,melee)
	-- Itachi's Sharingan sees the strike coming: wider windows, and every
	-- clean read opens a counter.
	local eye=victim.def and victim.def.Sharingan
	if eye and (victim.awakenUntil or 0)&gt;c.now and victim.def.Awakening and victim.def.Awakening.Windows then
		local k=victim.def.Awakening.Windows
		eye={ParryWindow=eye.ParryWindow*k,PerfectDodge=eye.PerfectDodge*k,Counter=eye.Counter}
	end
	if victim.invulnerableUntil&gt;c.now then
		local clean=c.now-victim.dodgeStartedAt&lt;=(if eye then eye.PerfectDodge else Tune.BloodstepWindow) and victim.bloodstepGrantedFor~=victim.dodgeStartedAt
		if clean then
			victim.bloodstepGrantedFor=victim.dodgeStartedAt;victim.bonusUntil=c.now+.8;victim.riposteUntil=c.now+.5
			if eye then victim.counterUntil=c.now+eye.Counter;c:cue(victim,'SHARINGAN • PERFECT DODGE • COUNTER')
			else c:cue(victim,'PERFECT DODGE • BLOODSTEP') end
		end
		return 'Evaded',0
	end
	if not frontal or not victim.guardHeld then return 'Hit',amount end
	local since=c.now-victim.guardPressedAt
	local window=if eye then eye.ParryWindow else Tune.ParryWindow
	-- Sharingan Focus: the raised guard itself reads. Any frontal blow of the
	-- body that meets it is parried (once per raise; parry cooldown and
	-- stamina still apply) and read. Blades and jutsu keep the eye's window.
	local focus=eye~=nil and melee and victim.def.Awakening and victim.def.Awakening.GuardRead==true and (victim.awakenUntil or 0)&gt;c.now
	if focus then window=1e3 end
	-- Closed chakra points (Gentle Fist) compromise the guard: the parry
	-- window narrows with each one (none left at four) and a blocked blow costs
	-- more stamina.
	local points=Defense.closedPoints(victim,c.now)
	window*=math.max(0,1-.25*points)
	if since&lt;=window and c.now&gt;=victim.parryReadyAt and victim.stamina&gt;=Tune.ParryCost then
		victim.stamina-=Tune.ParryCost;victim.parryReadyAt=c.now+Tune.ParryCooldown;victim.guardPressedAt=-math.huge
		if not melee then c:cue(victim,'DEFLECTED');return 'Parried',0 end
		attacker.pending=nil;attacker.guardHeld=false;c:setState(attacker,'Stunned',Tune.ParryStun)
		if eye then victim.counterUntil=c.now+eye.Counter;c:cue(victim,'SHARINGAN • PARRY • COUNTER')
		else c:cue(victim,'PARRY • PUNISH') end
		if focus then
			victim.bonusUntil=c.now+1;victim.counterReach={expires=c.now+eye.Counter,max=4,variant="ReadCounter"}
			Defense.slip(c,victim,attacker,"focus")
			c:cue(victim,'SHARINGAN FOCUS • READ • COUNTER')
		end
		c:cue(attacker,'PARRIED • EXPOSED')
		return 'Parried',0
	end
	local blockCost=Tune.BlockHitCost*(1+.2*points)
	if victim.stamina&gt;=blockCost then
		victim.stamina-=blockCost
		return 'Blocked',amount*Tune.BlockDamageMultiplier
	end
	victim.guardHeld=false;c:setState(victim,'Stunned',.65);c:cue(victim,'GUARD BREAK')
	return 'GuardBreak',amount
end
-- Chakra points Neji has closed on this fighter (0 once they reopen).
function Defense.closedPoints(a,now)
	return if (a.tenketsuUntil or 0)&gt;now then (a.tenketsu or 0) else 0
end
-- A read: the reader slips a step to the outside of the blow (an afterimage
-- stays where he stood and the swing bites it), turns square to the attacker,
-- and the client shows the eye, the afterimage and the bitten swing ("read").
function Defense.slip(c,reader,attacker,phase)
	local Motor=require(script.Parent.Motor)
	local from=reader.root.Position
	local line=from-attacker.root.Position;line=Vector3.new(line.X,0,line.Z)
	line=if line.Magnitude&gt;.1 then line.Unit else Vector3.new(reader.root.CFrame.LookVector.X,0,reader.root.CFrame.LookVector.Z).Unit
	local side=Vector3.new(-line.Z,0,line.X)
	local stick=Vector3.new(reader.move.X,0,reader.move.Z)
	local sign=if stick.Magnitude&gt;.4 then (if stick:Dot(side)&gt;=0 then 1 else -1) else (reader.slipSide or 1)
	reader.slipSide=-sign
	if Motor.travel(reader,c,side*sign,2.2)&lt;1 then Motor.travel(reader,c,-side*sign,2.2) end
	local face=attacker.root.Position-reader.root.Position;face=Vector3.new(face.X,0,face.Z)
	if face.Magnitude&gt;.1 then reader.root.CFrame=CFrame.lookAt(reader.root.Position,reader.root.Position+face) end
	c:pushImpact(from,"read",false,{owner=reader.id,fighter=reader.fighterId,victim=attacker.id,to=reader.root.Position,phase=phase})
	require(script.Parent.Brawler).event(c,reader,"ReadSlip")
end
-- A strike pressed during the counter stance fires the moment it pays off.
function Defense.fireQueued(c,a)
	if not a.counterQueued or c.now-a.counterQueued&gt;1.1 then return end
	c:schedule(c.now,function()
		if a.health&gt;0 and (a.counterUntil or 0)&gt;c.now and a.state=="Neutral" and not a.reaction then require(script.Parent.Brawler).counterStart(c,a) end
	end)
end
-- Sharingan Read paid off (Combat:damage, a frontal melee blow inside the
-- stance): no damage, the attacker is caught out, the reader slips aside out
-- of the stance at once and the counter palm opens (instantly when the strike
-- was already pressed during the stance). Returns false (no damage).
function Defense.read(c,attacker,victim)
	local now=c.now
	victim.readUntil=0;victim.bonusUntil=now+1.4;victim.counterUntil=now+1.0
	victim.counterReach={expires=now+1.0,max=4,variant="ReadCounter"}
	victim.chakra=math.min(victim.def.Chakra or 100,victim.chakra+10)
	attacker.pending=nil;c:setState(attacker,"Stunned",.5)
	victim.pending=nil;c:setState(victim,"Neutral",0)
	Defense.slip(c,victim,attacker,"read")
	c:cue(victim,"READ • SEEN COMING • PUNISH");c:cue(attacker,"READ • EXPOSED")
	require(script.Parent.Brawler).event(c,victim,"ReadSuccess")
	Defense.fireQueued(c,victim)
	return false
end
function Defense.step(c,a,dt,now)
	if a.guardHeld then
		a.stamina=math.max(0,a.stamina-12*dt)
		if a.stamina&lt;=0 then a.guardHeld=false;c:setState(a,'Stunned',.45);c:cue(a,'GUARD EXHAUSTED') end
	else a.stamina=math.min(100,a.stamina+18*dt) end
end
return Defense
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND44">
        <Properties>
          <string name="Name">VelmoraHitDetection</string>
          <ProtectedString name="Source">-- Adapted from Velmora src/server/Combat/HitDetection.luau.
-- Copyright (c) 2026 Yashveer Singh, MIT.
-- Keeps the donor's short position history, interpolation, reach/cone and world LOS.
local Tune=require(game:GetService('ReplicatedStorage').NinjaDuel.VelmoraCombatConfig)
local HitDetection={}
local history={}
function HitDetection.record(root,t)
	local buf=history[root]
	if not buf then buf={};history[root]=buf end
	table.insert(buf,{t=t,pos=root.Position})
	local cutoff=t-(Tune.History+Tune.TimestampWindow)
	while #buf&gt;2 and buf[1].t&lt;cutoff do table.remove(buf,1) end
end
function HitDetection.positionAt(root,t)
	local buf=history[root]
	if not buf or #buf==0 then return root.Position end
	if t&lt;=buf[1].t then return buf[1].pos end
	if t&gt;=buf[#buf].t then return buf[#buf].pos end
	for i=1,#buf-1 do
		local a,b=buf[i],buf[i+1]
		if t&gt;=a.t and t&lt;=b.t then
			local span=b.t-a.t
			return a.pos:Lerp(b.pos,if span&gt;0 then (t-a.t)/span else 0)
		end
	end
	return buf[#buf].pos
end
function HitDetection.clear(root) history[root]=nil end
function HitDetection.resolve(attackerRoot,range,arcAngle,origin,aim,t,candidates,effects)
	local look=if aim.Magnitude&gt;.001 then aim.Unit else attackerRoot.CFrame.LookVector
	local exclude={effects,attackerRoot.Parent}
	for _,root in candidates do if root.Parent then table.insert(exclude,root.Parent) end end
	local ray=RaycastParams.new();ray.FilterType=Enum.RaycastFilterType.Exclude;ray.FilterDescendantsInstances=exclude;ray.IgnoreWater=true
	local best,bestPos,bestDistance=nil,nil,math.huge
	for _,root in candidates do
		if root~=attackerRoot and root.Parent then
			local pos=HitDetection.positionAt(root,t);local delta=pos-origin;local distance=delta.Magnitude
			if distance&lt;=range and (distance&lt;.001 or math.deg(math.acos(math.clamp(look:Dot(delta.Unit),-1,1)))&lt;=arcAngle) and workspace:Raycast(origin,delta,ray)==nil and distance&lt;bestDistance then
				best,bestPos,bestDistance=root,pos,distance
			end
		end
	end
	return best,bestPos
end
return HitDetection
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="ND45">
        <Properties>
          <string name="Name">World</string>
          <ProtectedString name="Source">local World = {}
local Animation=require(script.Parent.Animation)
local function part(parent, name, size, cf, color, material)
	local p = Instance.new("Part")
	p.Name, p.Size, p.CFrame = name, size, cf
	p.Color, p.Material = color, material or Enum.Material.SmoothPlastic
	p.Anchored, p.TopSurface, p.BottomSurface = true, Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end
World.part = part
-- --------------------------------------------------------------- arena
-- The Konoha Chunin Exam finals stadium, as close as the block toolkit allows:
-- a round field of packed earth and grass, bushes along the foot of a very tall
-- circular wall of pale panels (the wall fighters run up), a few big trees on
-- the field, spectator stands crowning the wall under white pavilions with
-- golden roofs, the larger Kage box, the participants' balcony and the gate.
-- Combat contract: flat floor at the origin plane; the wall segments are the
-- NinjaWall surfaces just outside the fighters' round limit.
local function rgb(r,g,b) return Color3.fromRGB(r,g,b) end
local PALETTE={
	grass=rgb(104,136,70),grassDark=rgb(84,116,58),earth=rgb(178,152,110),earthDark=rgb(150,126,92),
	wall=rgb(218,216,196),wallSeam=rgb(178,180,160),wallBand=rgb(196,198,178),
	brick=rgb(152,74,52),brickDark=rgb(118,56,40),plaster=rgb(238,236,226),
	roof=rgb(222,164,58),roofDark=rgb(176,120,38),trim=rgb(70,62,56),wood=rgb(120,84,54),woodDark=rgb(84,58,38),
	leaf=rgb(70,112,58),leafDark=rgb(52,90,48),bark=rgb(96,70,50),
}
-- The Chunin Exam finals stadium at a believable scale for 12-year-olds: about
-- 58 body heights across (the anime's proportions), walls about 15 tall. A
-- long open floor for range, pursuit and blades; the wall is a destination,
-- not the edge of every exchange (convergence 2 addendum, DEC-015).
World.WALL_RADIUS=145
local function deco(parent,name,size,cf,color,material,shape)
	local p=part(parent,name,size,cf,color,material)
	p.CanCollide=false;p.CanQuery=false;p.CanTouch=false
	if shape then p.Shape=shape end
	return p
end
-- A flat disc lying on the floor (cylinder axis pointing up).
local function disc(parent,name,radius,y,center,color,material)
	return deco(parent,name,Vector3.new(.06,radius*2,radius*2),CFrame.new(center+Vector3.new(0,y,0))*CFrame.Angles(0,0,math.pi/2),color,material,Enum.PartType.Cylinder)
end
local function label(target,face,text,color,font)
	local gui=Instance.new("SurfaceGui");gui.Face=face;gui.CanvasSize=Vector2.new(400,400);gui.LightInfluence=1;gui.Parent=target
	local t=Instance.new("TextLabel");t.Size=UDim2.fromScale(1,1);t.BackgroundTransparency=1;t.Text=text;t.TextColor3=color
	t.Font=font or Enum.Font.GothamBlack;t.TextScaled=true;t.Parent=gui
	return gui
end
local function spectator(folder,at,facing,seed)
	local parent=Instance.new("Model");parent.Name="SpectatorFigure";parent.Parent=folder
	local tones={rgb(70,96,74),rgb(70,86,120),rgb(120,70,62),rgb(140,120,90),rgb(96,80,110),rgb(60,64,72),rgb(150,140,128),rgb(86,104,76)}
	local skin={rgb(232,198,166),rgb(204,166,136),rgb(176,134,104)}
	local body=deco(parent,"Spectator",Vector3.new(1.3,2.0,.9),CFrame.lookAt(at+Vector3.new(0,1.0,0),at+Vector3.new(0,1.0,0)+facing),tones[seed%#tones+1],Enum.Material.SmoothPlastic)
	body.CastShadow=false
	local head=deco(parent,"SpectatorHead",Vector3.new(.95,.95,.95),body.CFrame*CFrame.new(0,1.45,0),skin[seed%#skin+1],Enum.Material.SmoothPlastic,Enum.PartType.Ball)
	head.CastShadow=false
	deco(parent,"SpectatorHair",Vector3.new(1.0,.45,1.0),head.CFrame*CFrame.new(0,.28,.05),if seed%4==0 then rgb(220,190,120) else rgb(36,30,28),Enum.Material.SmoothPlastic).CastShadow=false
end
local function tree(parent,at,height,spread)
	-- Field trees: a real trunk (cover and line of sight) under a loose crown.
	local trunk=part(parent,"Field tree",Vector3.new(2.6,height,2.6),CFrame.new(at+Vector3.new(0,height/2,0)),PALETTE.bark,Enum.Material.Wood)
	trunk.Shape=Enum.PartType.Block
	local crown=deco(parent,"Crown",Vector3.new(spread*2,spread*1.4,spread*2),CFrame.new(at+Vector3.new(0,height+spread*.3,0)),PALETTE.leaf,Enum.Material.Grass,Enum.PartType.Ball)
	crown.Size=Vector3.one*spread*1.9
	for k=0,4 do
		local a=k/5*math.pi*2
		deco(parent,"Crown",Vector3.one*spread*(1.1+(k%2)*.25),CFrame.new(at+Vector3.new(math.sin(a)*spread*.75,height-spread*.1+(k%3)*.8,math.cos(a)*spread*.75)),
			if k%2==0 then PALETTE.leafDark else PALETTE.leaf,Enum.Material.Grass,Enum.PartType.Ball)
	end
	for k=0,2 do
		local a=k/3*math.pi*2+.4
		deco(parent,"Branch",Vector3.new(.9,spread*1.1,.9),CFrame.new(at+Vector3.new(0,height*.72,0))*CFrame.Angles(0,a,math.rad(48))*CFrame.new(0,spread*.5,0),PALETTE.bark,Enum.Material.Wood)
	end
	return trunk
end
-- A white pavilion with a golden curved roof sitting on the stands.
local function pavilion(parent,cf,width,depth,height,tiers)
	deco(parent,"Pavilion",Vector3.new(width,height,depth),cf*CFrame.new(0,height/2,0),PALETTE.plaster,Enum.Material.SmoothPlastic)
	for k=-math.floor(width/6),math.floor(width/6) do
		deco(parent,"Window",Vector3.new(2.6,height*.38,.2),cf*CFrame.new(k*5.2,height*.58,-depth/2-.05),PALETTE.trim,Enum.Material.SmoothPlastic)
	end
	deco(parent,"Base trim",Vector3.new(width+.4,.8,depth+.4),cf*CFrame.new(0,.4,0),PALETTE.trim,Enum.Material.Wood)
	local y=height
	for tier=1,tiers do
		local w=width+6-tier*3;local d=depth+6-tier*3
		local pitch=math.rad(24)
		for _,side in {-1,1} do
			deco(parent,"Roof",Vector3.new(w,.9,d/2+1),cf*CFrame.new(0,y+1.1,side*(d/4))*CFrame.Angles(side*-pitch,0,0),PALETTE.roof,Enum.Material.SmoothPlastic)
			-- Up-turned eaves at the four corners.
			for _,ex in {-1,1} do
				deco(parent,"Eave",Vector3.new(2.2,.7,2.2),cf*CFrame.new(ex*(w/2-.6),y+.4,side*(d/2+.4))*CFrame.Angles(side*math.rad(-20),0,ex*math.rad(18)),PALETTE.roofDark,Enum.Material.SmoothPlastic)
			end
		end
		deco(parent,"Ridge",Vector3.new(w+.6,.7,.9),cf*CFrame.new(0,y+1.1+math.tan(pitch)*(d/4)+.6,0),PALETTE.roofDark,Enum.Material.SmoothPlastic)
		if tier&lt;tiers then
			deco(parent,"Upper storey",Vector3.new(w-6,4,d-6),cf*CFrame.new(0,y+3.6,0),PALETTE.plaster,Enum.Material.SmoothPlastic)
			y+=4.6
		end
	end
end
local function atmosphere()
	local Lighting=game:GetService("Lighting")
	if Lighting:FindFirstChild("NinjaDuelAtmosphere") then return end
	-- Bright exam-day afternoon, as in the anime: clear sky, warm sun, soft haze.
	Lighting.ClockTime=14.6;Lighting.GeographicLatitude=30
	Lighting.Brightness=3;Lighting.EnvironmentDiffuseScale=.7;Lighting.EnvironmentSpecularScale=.3
	Lighting.Ambient=rgb(104,104,104);Lighting.OutdoorAmbient=rgb(150,146,138)
	pcall(function() Lighting.Technology=Enum.Technology.ShadowMap end)
	local atmo=Instance.new("Atmosphere");atmo.Name="NinjaDuelAtmosphere";atmo.Density=.26;atmo.Offset=.1
	atmo.Color=rgb(214,222,226);atmo.Decay=rgb(140,150,160);atmo.Glare=.2;atmo.Haze=.9;atmo.Parent=Lighting
	local cc=Instance.new("ColorCorrectionEffect");cc.Name="NinjaDuelGrade";cc.Saturation=.14;cc.Contrast=.06;cc.Brightness=.02;cc.TintColor=rgb(255,250,242);cc.Parent=Lighting
	local bloom=Instance.new("BloomEffect");bloom.Name="NinjaDuelBloom";bloom.Intensity=.45;bloom.Size=24;bloom.Threshold=1.5;bloom.Parent=Lighting
	local rays=Instance.new("SunRaysEffect");rays.Name="NinjaDuelRays";rays.Intensity=.04;rays.Spread=.6;rays.Parent=Lighting
end
World.atmosphere=atmosphere
function World.arena(parent, origin)
	local folder = Instance.new("Folder"); folder.Name = "Courtyard"; folder.Parent = parent
	local decor=Instance.new("Folder");decor.Name="Decor";decor.Parent=folder
	local C=PALETTE
	local R=World.WALL_RADIUS
	local height=76
	-- Field: grass with a broad packed-earth centre and worn patches.
	part(folder,"Training floor",Vector3.new(460,2,460),CFrame.new(origin-Vector3.new(0,1,0)),C.grass,Enum.Material.Grass)
	disc(decor,"Earth",92,.03,origin,C.earth,Enum.Material.Ground)
	for k=0,17 do
		local a=k/18*math.pi*2+.3
		local r=68+((k*37)%5)*7
		disc(decor,"Earth patch",18+((k*53)%4)*5,.035,origin+Vector3.new(math.sin(a)*r,0,math.cos(a)*r),if k%3==0 then C.earthDark else C.earth,Enum.Material.Ground)
	end
	-- Worn grass islands: clusters of overlapping small patches, never one
	-- perfect circle, so the field reads as trampled ground.
	for k=0,15 do
		local a=k/16*math.pi*2+1.1
		local r=30+((k*29)%4)*12
		local center=origin+Vector3.new(math.sin(a)*r,0,math.cos(a)*r)
		for j=0,4 do
			local b=j*1.7+k
			local offset=Vector3.new(math.sin(b)*(2+j*1.3),0,math.cos(b)*(1.5+j))
			disc(decor,"Grass tuft",1.6+((j*13+k)%4)*.9,.045,center+offset,if j%2==0 then C.grassDark else C.grass,Enum.Material.Grass)
		end
	end
	-- The tall panelled wall. Each segment is a wall-run surface.
	local segments=116
	local width=2*math.pi*(R+1)/segments+.3
	for k=0,segments-1 do
		local a=k/segments*math.pi*2
		local dir=Vector3.new(math.sin(a),0,math.cos(a))
		local at=origin+dir*(R+1)+Vector3.new(0,height/2,0)
		local look=CFrame.lookAt(at,origin+Vector3.new(0,height/2,0))
		local w=part(folder,"Boundary",Vector3.new(width,height,2),look,C.wall,Enum.Material.Concrete)
		w:SetAttribute("NinjaWall",true)
		deco(decor,"Seam",Vector3.new(.25,height,.1),look*CFrame.new(width/2,0,-1.02),C.wallSeam,Enum.Material.Concrete)
		deco(decor,"Band",Vector3.new(width,1.2,.1),look*CFrame.new(0,height/2-6,-1.02),C.wallBand,Enum.Material.Concrete)
		deco(decor,"Footing",Vector3.new(width,2.2,.6),look*CFrame.new(0,-height/2+1.1,-1.2),C.wallSeam,Enum.Material.Concrete)
		-- Brick outer face and the parapet in front of the first row of seats.
		deco(decor,"Outer face",Vector3.new(width,height,.6),look*CFrame.new(0,0,1.3),C.brick,Enum.Material.Brick)
		deco(decor,"Parapet",Vector3.new(width,1.2,1),look*CFrame.new(0,height/2+.6,-.4),C.brickDark,Enum.Material.Brick)
	end
	-- Tournament banners hang down the wall between the stands and the field.
	for k=0,21 do
		local a=k/22*math.pi*2+math.pi/22
		local dir=Vector3.new(math.sin(a),0,math.cos(a))
		local at=origin+dir*(R-.15)+Vector3.new(0,height-13,0)
		local look=CFrame.lookAt(at,origin+Vector3.new(0,height-13,0))
		local cloth=deco(decor,"Wall banner",Vector3.new(6.5,18,.12),look,if k%2==0 then rgb(170,40,36) else rgb(232,226,210),Enum.Material.Fabric)
		deco(decor,"Banner rod",Vector3.new(7.4,.35,.35),look*CFrame.new(0,9.1,0),rgb(70,52,36),Enum.Material.Wood)
		local gui=label(cloth,Enum.NormalId.Front,if k%3==0 then "火" elseif k%3==1 then "忍" else "試",if k%2==0 then rgb(232,226,210) else rgb(170,40,36))
		-- Match the cloth's proportions so the character is not squashed.
		gui.CanvasSize=Vector2.new(220,600)
	end
	-- Bushes along the foot of the wall.
	for k=0,131 do
		local a=k/132*math.pi*2+((k*17)%5)*.01
		local r=R-1.6-((k*29)%3)*.6
		local size=3.4+((k*41)%4)*.7
		deco(decor,"Bush",Vector3.one*size,CFrame.new(origin+Vector3.new(math.sin(a)*r,size*.32,math.cos(a)*r)),if k%3==0 then C.leafDark else C.leaf,Enum.Material.Grass,Enum.PartType.Ball)
	end
	-- Stands crowning the wall: rising tiers full of spectators.
	local seed=0
	local top=height
	for tier=1,4 do
		local radius=R+3+tier*3.4
		local steps=math.floor(radius*2*math.pi/7.2)
		for k=0,steps-1 do
			local a=k/steps*math.pi*2
			local at=origin+Vector3.new(math.sin(a)*radius,top+tier*2.1-.6,math.cos(a)*radius)
			local look=CFrame.lookAt(at,Vector3.new(origin.X,at.Y,origin.Z))
			deco(decor,"Stand",Vector3.new(6.8,tier*2.1+1,3.6),look*CFrame.new(0,-(tier*2.1+1)/2+.8,0),if tier%2==0 then C.wood else C.woodDark,Enum.Material.Wood)
			seed+=1
			if seed%4~=0 then
				local seat=look*CFrame.new(((seed*37)%5-2)*.9,.8,.4)
				spectator(decor,seat.Position,(origin-seat.Position)*Vector3.new(1,0,1),seed)
			end
		end
	end
	-- Pavilions on the stands; the Kage box is the large two-storey one (north).
	for k=0,17 do
		local a=k/18*math.pi*2+math.pi/18
		local at=origin+Vector3.new(math.sin(a)*(R+20),top+5,math.cos(a)*(R+20))
		pavilion(decor,CFrame.lookAt(at,Vector3.new(origin.X,at.Y,origin.Z)),18,10,8,1)
	end
	local kage=origin+Vector3.new(0,top+6,-(R+16))
	local kageCF=CFrame.lookAt(kage,Vector3.new(origin.X,kage.Y,origin.Z))
	pavilion(decor,kageCF,34,16,11,2)
	local box=deco(decor,"Kage box",Vector3.new(14,6,4),kageCF*CFrame.new(0,4,-9.6),C.trim,Enum.Material.Wood)
	for _,x in {-4,4} do spectator(decor,(kageCF*CFrame.new(x,1.4,-8.6)).Position,(origin-kage)*Vector3.new(1,0,1),if x&lt;0 then 5 else 2) end
	local plaque=deco(decor,"Kage plaque",Vector3.new(4,4,.3),kageCF*CFrame.new(0,8.5,-9.9),C.plaster,Enum.Material.SmoothPlastic)
	label(plaque,Enum.NormalId.Front,"火",rgb(190,40,36))
	box.Transparency=0
	-- Participants' balcony on the east wall, and the arena gate to the south.
	-- The participants' balcony is a real ledge (elevation and a vertical route):
	-- run up the wall beside it and step onto it, or drop from it into a dive.
	local east=CFrame.lookAt(origin+Vector3.new(R-4,24,0),origin+Vector3.new(0,24,0))
	part(folder,"Participants balcony",Vector3.new(26,1.2,8),east,C.woodDark,Enum.Material.Wood)
	deco(decor,"Balcony rail",Vector3.new(26,1.6,.3),east*CFrame.new(0,1.4,-3.9),C.wood,Enum.Material.Wood)
	for _,x in {-12,-4,4,12} do deco(decor,"Balcony bracket",Vector3.new(.8,3,.8),east*CFrame.new(x,-2,1.5)*CFrame.Angles(math.rad(35),0,0),C.trim,Enum.Material.Wood) end
	for k=-3,3 do spectator(decor,(east*CFrame.new(k*2,.5,.2)).Position,-east.LookVector*-1,k+20) end
	local south=CFrame.lookAt(origin+Vector3.new(0,8,R-.05),origin+Vector3.new(0,8,0))
	-- The competitors' gate: two heavy wooden doors in a dark frame.
	deco(decor,"Gate",Vector3.new(18,16,.2),south*CFrame.new(0,0,.15),rgb(30,28,26),Enum.Material.SmoothPlastic)
	for _,x in {-4.4,4.4} do
		local door=south*CFrame.new(x,-.2,-.1)
		deco(decor,"Gate door",Vector3.new(8.4,15.4,.5),door,rgb(104,72,46),Enum.Material.WoodPlanks)
		for _,y in {-5,0,5} do deco(decor,"Gate band",Vector3.new(8.4,.4,.08),door*CFrame.new(0,y,-.29),rgb(52,50,50),Enum.Material.Metal) end
		deco(decor,"Gate ring",Vector3.new(.7,.7,.1),door*CFrame.new(if x&lt;0 then 3.4 else -3.4,0,-.33),rgb(150,120,60),Enum.Material.Metal,Enum.PartType.Cylinder)
	end
	deco(decor,"Gate lintel",Vector3.new(21,2,.8),south*CFrame.new(0,8.6,-.2),C.trim,Enum.Material.Wood)
	for _,x in {-10,10} do deco(decor,"Gate post",Vector3.new(1.6,16,.8),south*CFrame.new(x,0,-.2),C.trim,Enum.Material.Wood) end
	-- Field trees: line of sight and something to fight around, as in the finals.
	for _,spot in {{.55,112,38,10},{1.6,104,33,9},{2.4,110,36,9.5},{3.3,98,31,8.5},{3.9,116,40,10.5},{5.3,106,35,9.5},{6.0,92,29,8}} do
		tree(folder,origin+Vector3.new(math.sin(spot[1])*spot[2],0,math.cos(spot[1])*spot[2]),spot[3],spot[4])
	end
	-- Weathered boulders for low cover (they stop blades and fire), spread so
	-- every approach has something to run around.
	for _,spot in {{1.5,40,1.1},{4.6,36,1.1},{.2,70,1.4},{2.9,64,1.3},{5.7,62,1.3}} do
		local at=origin+Vector3.new(math.sin(spot[1])*spot[2],2*spot[3],math.cos(spot[1])*spot[2])
		local k=spot[3]
		part(folder,"Cover",Vector3.new(7,4,4)*k,CFrame.new(at)*CFrame.Angles(0,spot[1],0),rgb(128,124,114),Enum.Material.Slate)
		deco(decor,"Rock cap",Vector3.new(5,2.6,3.4)*k,CFrame.new(at+Vector3.new(-.5,2.2,0)*k)*CFrame.Angles(0,spot[1]+.3,math.rad(8)),rgb(140,136,124),Enum.Material.Slate)
		deco(decor,"Rock chip",Vector3.new(2.2,1.4,1.8)*k,CFrame.new(at+Vector3.new(3.6,-1.3,1.6)*k)*CFrame.Angles(0,spot[1]*2,math.rad(14)),rgb(118,114,106),Enum.Material.Slate)
	end
	-- The forest of Konoha around the stadium, seen over the stands.
	for k=0,47 do
		local a=k/48*math.pi*2+.07
		local r=R+42+((k*53)%5)*6
		local at=origin+Vector3.new(math.sin(a)*r,0,math.cos(a)*r)
		local h=50+((k*31)%4)*7
		deco(decor,"Forest trunk",Vector3.new(3,h,3),CFrame.new(at+Vector3.new(0,h/2,0)),C.bark,Enum.Material.Wood)
		deco(decor,"Forest crown",Vector3.one*(26+((k*13)%4)*5),CFrame.new(at+Vector3.new(0,h,0)),if k%2==0 then C.leafDark else C.leaf,Enum.Material.Grass,Enum.PartType.Ball)
	end
	-- A few leaves drifting over the field.
	local sky=deco(decor,"Leaf source",Vector3.new(260,1,260),CFrame.new(origin+Vector3.new(0,78,0)),C.leaf,Enum.Material.SmoothPlastic)
	sky.Transparency=1
	local leaves=Instance.new("ParticleEmitter");leaves.Name="Leaves"
	leaves.Texture="rbxasset://textures/particles/sparkles_main.dds";leaves.Rate=7;leaves.Lifetime=NumberRange.new(9,13)
	leaves.Speed=NumberRange.new(2,4);leaves.EmissionDirection=Enum.NormalId.Bottom;leaves.SpreadAngle=Vector2.new(30,30)
	leaves.Color=ColorSequence.new(rgb(120,160,80));leaves.LightEmission=.1;leaves.Size=NumberSequence.new(.35)
	leaves.Rotation=NumberRange.new(0,360);leaves.RotSpeed=NumberRange.new(-90,90);leaves.Acceleration=Vector3.new(1.2,-.6,.4)
	leaves.Parent=sky
	atmosphere()
	return folder
end
local function fighterGroup()
	local physics=game:GetService("PhysicsService")
	pcall(function()
		if not physics:IsCollisionGroupRegistered("NinjaFighters") then physics:RegisterCollisionGroup("NinjaFighters") end
		physics:CollisionGroupSetCollidable("NinjaFighters","NinjaFighters",false)
	end)
end
function World.rig(parent, def, cf, name)
	fighterGroup()
	local model = Instance.new("Model"); model.Name=name; model.Parent=parent
	local skin=Color3.fromRGB(table.unpack(def.Skin))
	local outfit=Color3.fromRGB(table.unpack(def.Outfit))
	local pants=Color3.fromRGB(35,43,54)
	local color=Color3.fromRGB(table.unpack(def.Color))
	local root=part(model,"HumanoidRootPart",Vector3.new(2,2,1),cf,outfit)
	root.Transparency=1
	local function body(name,size,offset,tint)
		return part(model,name,size,cf*CFrame.new(offset),tint)
	end
	local lower=body("LowerTorso",Vector3.new(2,1,1),Vector3.new(0,0,0),outfit)
	local upper=body("UpperTorso",Vector3.new(2,1.4,1),Vector3.new(0,1.15,0),outfit)
	local head=body("Head",Vector3.new(1.5,1.5,1.5),Vector3.new(0,2.45,0),skin)
	local hum=Instance.new("Humanoid")
	hum.RigType=Enum.HumanoidRigType.R15; hum.RequiresNeck=true; hum.BreakJointsOnDeath=false
	hum.MaxHealth=def.Health; hum.Health=def.Health; hum.WalkSpeed=def.Speed
	hum.UseJumpPower=true; hum.JumpPower=68; hum.HipHeight=2
	hum.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None; hum.Parent=model
	Instance.new("Animator",hum)
	local joints={}
	local function joint(name,p0,p1,c0,c1)
		local m=Instance.new("Motor6D");m.Name=name;m.Part0=p0;m.Part1=p1;m.C0=CFrame.new(c0);m.C1=CFrame.new(c1);m.Parent=p0
		joints[name]=m;return m
	end
	joint("Root",root,lower,Vector3.zero,Vector3.zero)
	joint("Waist",lower,upper,Vector3.new(0,0.65,0),Vector3.new(0,-0.5,0))
	joint("Neck",upper,head,Vector3.new(0,0.9,0),Vector3.new(0,-0.55,0))
	for _,side in {-1,1} do
		local prefix=if side==-1 then "Left" else "Right"
		local armTop=body(prefix.."UpperArm",Vector3.new(0.8,1.1,0.8),Vector3.new(side*1.45,0.72,0),outfit)
		local armLow=body(prefix.."LowerArm",Vector3.new(0.76,0.95,0.76),Vector3.new(side*1.45,-0.28,0),outfit)
		local hand=body(prefix.."Hand",Vector3.new(0.72,0.5,0.72),Vector3.new(side*1.45,-1.0,0),skin)
		local legTop=body(prefix.."UpperLeg",Vector3.new(0.85,1.1,0.85),Vector3.new(side*0.5,-0.85,0),pants)
		local legLow=body(prefix.."LowerLeg",Vector3.new(0.8,1.05,0.8),Vector3.new(side*0.5,-1.75,0),pants)
		local foot=body(prefix.."Foot",Vector3.new(0.8,0.42,1.15),Vector3.new(side*0.5,-2.55,-0.15),pants)
		joint(prefix.."Shoulder",upper,armTop,Vector3.new(side*1.05,0.45,0),Vector3.new(-side*0.4,0.5,0))
		joint(prefix.."Elbow",armTop,armLow,Vector3.new(0,-0.55,0),Vector3.new(0,0.45,0))
		joint(prefix.."Wrist",armLow,hand,Vector3.new(0,-0.48,0),Vector3.new(0,0.25,0))
		joint(prefix.."Hip",lower,legTop,Vector3.new(side*0.5,-0.55,0),Vector3.new(0,0.5,0))
		joint(prefix.."Knee",legTop,legLow,Vector3.new(0,-0.55,0),Vector3.new(0,0.5,0))
		joint(prefix.."Ankle",legLow,foot,Vector3.new(0,-0.5,0),Vector3.new(0,0.2,0.15))
	end
	local hair=body("Hair",Vector3.new(1.65,0.55,1.65),Vector3.new(0,3,0),Color3.fromRGB(table.unpack(def.Hair)))
	joint("HairJoint",head,hair,Vector3.new(0,0.57,0),Vector3.new(0,-0.25,0))
	local sash=body("Sash",Vector3.new(2.1,0.25,1.1),Vector3.new(0,-0.4,0),color)
	joint("SashJoint",lower,sash,Vector3.new(0,-0.4,0),Vector3.zero)
	local eyes=body("Eyes",Vector3.new(0.85,0.1,0.05),Vector3.new(0,2.6,-0.76),Color3.fromRGB(24,31,38))
	joint("EyeJoint",head,eyes,Vector3.new(0,0.15,-0.76),Vector3.zero)
	for _,piece in model:GetChildren() do
		if piece:IsA("BasePart") then
			piece.Anchored=false
			piece.CanCollide=piece==root
			piece.CanQuery=piece==root or piece==lower or piece==upper or piece==head
			piece.Massless=piece~=root
		end
	end
	World.dress(model,def)
	model.PrimaryPart=root; root:SetNetworkOwner(nil)
	-- Fighters pass through each other physically; Combat keeps them apart.
	for _,p in model:GetDescendants() do if p:IsA("BasePart") then p.CollisionGroup="NinjaFighters" end end
	return model,hum,root,joints
end
-- --------------------------------------------------------------- costumes
-- Cosmetic layers welded onto the R15 body parts: silhouettes that read as the
-- two shinobi at combat distance. Massless, never collide, never block queries.
local function wear(model,bodyName,name,size,offset,color,material,class)
	local body=model:FindFirstChild(bodyName)
	if not body then return nil end
	local p=Instance.new(class or "Part")
	p.Name=name;p.Size=size;p.CFrame=body.CFrame*offset;p.Color=color;p.Material=material or Enum.Material.SmoothPlastic
	p.Anchored=false;p.CanCollide=false;p.CanQuery=false;p.CanTouch=false;p.Massless=true;p.CastShadow=true
	p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth
	local weld=Instance.new("WeldConstraint");weld.Part0=body;weld.Part1=p;weld.Parent=p
	p.Parent=model
	return p
end
World.wear=wear
local function cyl(p)
	if p then p.Shape=Enum.PartType.Cylinder end
	return p
end
local A=CFrame.Angles
local R=math.rad
local function headband(model,slashed)
	wear(model,"Head","Headband",Vector3.new(1.66,.24,1.66),CFrame.new(0,.36,0),rgb(28,36,58),Enum.Material.SmoothPlastic)
	wear(model,"Head","HeadbandPlate",Vector3.new(.86,.3,.06),CFrame.new(0,.36,-.85),rgb(176,184,194),Enum.Material.Metal)
	-- The Leaf symbol, reduced to a readable spiral mark.
	wear(model,"Head","LeafMark",Vector3.new(.3,.14,.02),CFrame.new(0,.38,-.89),rgb(70,78,90),Enum.Material.Metal)
	if slashed then wear(model,"Head","Slash",Vector3.new(.92,.04,.03),CFrame.new(0,.36,-.86)*A(0,0,R(-8)),rgb(30,30,34),Enum.Material.Metal) end
	for _,side in {-1,1} do
		wear(model,"Head","HeadbandTail",Vector3.new(.16,.55,.08),CFrame.new(side*.25,.18,.84)*A(R(18),0,R(side*10)),rgb(28,36,58),Enum.Material.SmoothPlastic)
	end
end
local function face(model,eye,brow)
	local eyes=model:FindFirstChild("Eyes")
	if eyes then eyes.Transparency=1 end
	for _,side in {-1,1} do
		wear(model,"Head","Eye",Vector3.new(.3,.17,.04),CFrame.new(side*.3,.08,-.8),rgb(245,245,240))
		wear(model,"Head","Iris",Vector3.new(.15,.15,.03),CFrame.new(side*.3,.07,-.825),eye,Enum.Material.SmoothPlastic)
		wear(model,"Head","Brow",Vector3.new(.34,.06,.04),CFrame.new(side*.3,.27,-.8)*A(0,0,R(side*-8)),brow)
	end
	wear(model,"Head","Mouth",Vector3.new(.28,.04,.03),CFrame.new(0,-.36,-.78),rgb(120,70,64))
end
-- Smooth rounded hair cap over the crown.
local function hairCap(model,color)
	local cap=wear(model,"Head","HairCap",Vector3.new(1.98,1.3,2.02),CFrame.new(0,.5,.08),color)
	if cap then
		local mesh=Instance.new("SpecialMesh");mesh.MeshType=Enum.MeshType.Sphere;mesh.Parent=cap
	end
	return cap
end
-- A tapered lock: a long thin wedge whose point sits `length` along `direction`
-- from `base` (head space).
local function spike(model,base,direction,length,width,height,color)
	local d=direction.Unit
	local center=base+d*length*.5
	local up=if math.abs(d.Y)&gt;.9 then Vector3.zAxis else Vector3.yAxis
	local cf=CFrame.lookAt(center,center+d,up)
	return wear(model,"Head","HairSpike",Vector3.new(width,height,length),cf,color,Enum.Material.SmoothPlastic,"WedgePart")
end
-- Young prodigies (12-14), not adult final forms: practical genin/chunin gear,
-- bigger heads and lighter builds, with only hints of who they will become.
local function dressMinato(model,def)
	local hair=rgb(250,216,98)
	local hairShade=rgb(228,182,60)
	local navy=rgb(34,52,92)
	local navyDark=rgb(24,34,60)
	local light=rgb(226,230,232)
	local accent=rgb(236,110,44)
	local cap=model:FindFirstChild("Hair");if cap then cap.Color=hair;cap.Transparency=1 end
	face(model,rgb(70,140,220),hairShade)
	hairCap(model,hair)
	-- Spiky but younger mane: shorter locks, two framing bangs.
	local spikes={
		{Vector3.new(0,.78,.25),Vector3.new(0,.4,1),.9,.6,.38},
		{Vector3.new(-.45,.66,.28),Vector3.new(-.5,.35,1),.82,.5,.34},
		{Vector3.new(.45,.66,.28),Vector3.new(.5,.35,1),.82,.5,.34},
		{Vector3.new(0,.45,.62),Vector3.new(0,-.05,1),.78,.66,.38},
		{Vector3.new(-.5,.3,.58),Vector3.new(-.55,-.3,.9),.7,.48,.32},
		{Vector3.new(.5,.3,.58),Vector3.new(.55,-.3,.9),.7,.48,.32},
		{Vector3.new(0,-.12,.68),Vector3.new(0,-.7,.75),.6,.6,.3},
		{Vector3.new(-.72,.5,.05),Vector3.new(-1,.5,.35),.52,.4,.28},
		{Vector3.new(.72,.5,.05),Vector3.new(1,.5,.35),.52,.4,.28},
		{Vector3.new(-.25,.82,-.2),Vector3.new(-.35,1,-.25),.45,.38,.28},
		{Vector3.new(.25,.82,-.2),Vector3.new(.35,1,-.25),.45,.38,.28},
	}
	for index,s in spikes do spike(model,s[1],s[2],s[3],s[4],s[5],if index%2==0 then hairShade else hair) end
	for _,x in {-.38,0,.38} do spike(model,Vector3.new(x,.62,-.55),Vector3.new(x*.4,-.75,-.55),.5,.42,.24,hair) end
	for _,side in {-1,1} do
		wear(model,"Head","Bang",Vector3.new(.2,.95,.34),CFrame.new(side*.8,-.05,-.42)*A(R(4),0,R(side*4)),hair)
		wear(model,"Head","SideHair",Vector3.new(.16,.8,.8),CFrame.new(side*.8,.08,.3),hair)
	end
	wear(model,"Head","BackHair",Vector3.new(1.6,1.0,.26),CFrame.new(0,.05,.74),hair)
	headband(model,false)
	-- Navy zip-up with a high collar, a light open half-vest (the seed of the
	-- future cloak, no rank marks), kunai holster on the right thigh.
	for _,name in {"UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm","LeftLowerArm","RightLowerArm"} do
		local part=model:FindFirstChild(name);if part then part.Color=navy end
	end
	wear(model,"UpperTorso","Collar",Vector3.new(1.25,.36,1.02),CFrame.new(0,.8,.02),navy)
	wear(model,"UpperTorso","Zip",Vector3.new(.06,1.3,.03),CFrame.new(0,0,-.52),light)
	wear(model,"UpperTorso","HalfVestBack",Vector3.new(2.12,1.36,.08),CFrame.new(0,-.02,.56),light)
	for _,side in {-1,1} do
		wear(model,"UpperTorso","HalfVestFront",Vector3.new(.62,1.3,.08),CFrame.new(side*.72,-.05,-.56),light)
		wear(model,"UpperTorso","HalfVestSide",Vector3.new(.08,1.32,1.12),CFrame.new(side*1.04,-.03,0),light)
		wear(model,"UpperTorso","VestTrim",Vector3.new(.64,.08,.1),CFrame.new(side*.72,-.66,-.56),accent)
	end
	wear(model,"UpperTorso","VestTrimBack",Vector3.new(2.14,.08,.1),CFrame.new(0,-.66,.56),accent)
	wear(model,"LowerTorso","Belt",Vector3.new(2.06,.24,1.06),CFrame.new(0,.28,0),navyDark)
	wear(model,"LowerTorso","ToolPouch",Vector3.new(.7,.42,.3),CFrame.new(0,.12,.62),rgb(70,80,92))
	wear(model,"RightUpperLeg","ThighWrap",Vector3.new(.9,.4,.9),CFrame.new(0,.05,0),light)
	wear(model,"RightUpperLeg","Holster",Vector3.new(.24,.5,.5),CFrame.new(.5,-.05,0),navyDark)
	cyl(wear(model,"RightUpperLeg","HolsterRing",Vector3.new(.06,.22,.22),CFrame.new(.55,.3,0),rgb(120,126,134),Enum.Material.Metal))
	for _,side in {"Left","Right"} do
		local legLow=model:FindFirstChild(side.."LowerLeg");if legLow then legLow.Color=navyDark end
		local legTop=model:FindFirstChild(side.."UpperLeg");if legTop then legTop.Color=navyDark end
		wear(model,side.."LowerLeg","ShinWrap",Vector3.new(.84,.55,.84),CFrame.new(0,-.15,0),light)
		local foot=model:FindFirstChild(side.."Foot");if foot then foot.Color=rgb(28,36,56) end
		wear(model,side.."Foot","Toes",Vector3.new(.7,.16,.34),CFrame.new(0,.1,-.42),Color3.fromRGB(table.unpack(def.Skin)))
		wear(model,side.."LowerArm","Cuff",Vector3.new(.8,.18,.8),CFrame.new(0,-.38,0),light)
	end
end
-- Uchiha fan crest: red upper disc, white lower disc in front, short handle.
local function crest(model,body,offset,scale)
	cyl(wear(model,body,"CrestRed",Vector3.new(.04,.66*scale,.66*scale),offset*CFrame.new(0,.12*scale,0)*A(0,R(90),0),rgb(200,30,36)))
	cyl(wear(model,body,"CrestWhite",Vector3.new(.04,.46*scale,.46*scale),offset*CFrame.new(0,-.06*scale,-.02)*A(0,R(90),0),rgb(238,238,236)))
	wear(model,body,"CrestHandle",Vector3.new(.09*scale,.34*scale,.03),offset*CFrame.new(0,-.4*scale,-.02),rgb(238,238,236))
end
local function dressItachi(model,def)
	local hair=rgb(22,22,28)
	local shirt=rgb(48,52,68)
	local dark=rgb(22,22,30)
	local gray=rgb(132,136,146)
	local cap=model:FindFirstChild("Hair");if cap then cap.Color=hair;cap.Transparency=1 end
	face(model,rgb(200,20,30),hair)
	for _,p in model:GetChildren() do if p.Name=="Iris" then p.Material=Enum.Material.Neon end end
	-- Sharingan: a pupil and three tomoe on each red iris.
	for _,side in {-1,1} do
		wear(model,"Head","Pupil",Vector3.new(.045,.045,.02),CFrame.new(side*.3,.07,-.842),rgb(12,8,10))
		for k=0,2 do
			local a=math.rad(90+k*120)
			wear(model,"Head","Tomoe",Vector3.new(.032,.032,.02),CFrame.new(side*.3+math.cos(a)*.048,.07+math.sin(a)*.048,-.842),rgb(12,8,10))
		end
	end
	hairCap(model,hair)
	-- Long dark hair tied low, centre-parted bangs framing the face.
	for _,side in {-1,1} do
		wear(model,"Head","Bang",Vector3.new(.24,1.15,.42),CFrame.new(side*.76,-.12,-.42)*A(R(3),0,R(side*3)),hair)
		wear(model,"Head","SideHair",Vector3.new(.18,1.0,.9),CFrame.new(side*.8,-.02,.25),hair)
	end
	for _,x in {-.42,-.12,.18,.45} do
		wear(model,"Head","Fringe",Vector3.new(.32,.42,.26),CFrame.new(x,.52,-.68)*A(R(196),0,0),hair,Enum.Material.SmoothPlastic,"WedgePart")
	end
	wear(model,"Head","BackHair",Vector3.new(1.62,1.2,.3),CFrame.new(0,-.05,.72),hair)
	cyl(wear(model,"Head","Ponytail",Vector3.new(1.0,.24,.24),CFrame.new(0,-.85,.86)*A(0,0,R(80))*A(0,R(10),0),hair))
	headband(model,false)
	-- Village-era Uchiha: dark high-collared shirt with the clan crest on the
	-- back, grey arm guards, shuriken holster. No cloak, no rings.
	for _,name in {"UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm"} do
		local part=model:FindFirstChild(name);if part then part.Color=shirt end
	end
	wear(model,"UpperTorso","HighCollar",Vector3.new(1.45,.55,1.12),CFrame.new(0,.86,.04),shirt)
	crest(model,"UpperTorso",CFrame.new(0,.1,.53)*A(0,R(180),0),1.2)
	for _,side in {"Left","Right"} do
		wear(model,side.."LowerArm","ArmGuard",Vector3.new(.84,.72,.84),CFrame.new(0,-.05,0),gray,Enum.Material.Metal)
		wear(model,side.."UpperArm","Sleeve",Vector3.new(.86,.5,.86),CFrame.new(0,.28,0),shirt)
		local legLow=model:FindFirstChild(side.."LowerLeg");if legLow then legLow.Color=dark end
		local legTop=model:FindFirstChild(side.."UpperLeg");if legTop then legTop.Color=dark end
		wear(model,side.."LowerLeg","ShinWrap",Vector3.new(.84,.55,.84),CFrame.new(0,-.15,0),rgb(206,206,198))
		local foot=model:FindFirstChild(side.."Foot");if foot then foot.Color=rgb(28,28,36) end
		wear(model,side.."Foot","Toes",Vector3.new(.7,.16,.34),CFrame.new(0,.1,-.42),Color3.fromRGB(table.unpack(def.Skin)))
	end
	wear(model,"LowerTorso","Belt",Vector3.new(2.06,.22,1.06),CFrame.new(0,.3,0),dark)
	wear(model,"RightUpperLeg","ThighWrap",Vector3.new(.9,.36,.9),CFrame.new(0,.05,0),rgb(206,206,198))
	wear(model,"RightUpperLeg","Holster",Vector3.new(.24,.5,.5),CFrame.new(.5,-.05,0),dark)
end
-- Neji at the Chunin Exam (13): cream high-collared Hyuga top, dark shorts,
-- bandaged right arm and thigh, long hair tied at the end, Byakugan eyes.
local function dressNeji(model,def)
	local hair=rgb(52,36,30)
	local robe=rgb(232,226,212)
	local robeShade=rgb(204,196,182)
	local shorts=rgb(72,54,46)
	local bandage=rgb(240,238,230)
	local skin=Color3.fromRGB(table.unpack(def.Skin))
	local cap=model:FindFirstChild("Hair");if cap then cap.Color=hair;cap.Transparency=1 end
	face(model,rgb(198,192,232),hair)
	-- Byakugan: pale irises with no pupil; the veins show when it flares.
	for _,p in model:GetChildren() do
		if p.Name=="Eye" then p.Color=rgb(242,240,252) end
		if p.Name=="Iris" then p.Material=Enum.Material.Neon;p.Transparency=.2 end
	end
	for _,side in {-1,1} do
		for k=0,2 do
			local vein=wear(model,"Head","ByakuganVein",Vector3.new(.035,.2,.02),CFrame.new(side*(.52+k*.06),.08+(k-1)*.07,-.79)*A(0,0,R(side*(30-k*30))),rgb(150,138,196))
			if vein then vein.Transparency=1 end
		end
	end
	hairCap(model,hair)
	for _,side in {-1,1} do
		wear(model,"Head","Bang",Vector3.new(.22,1.32,.4),CFrame.new(side*.74,-.24,-.44)*A(R(2),0,R(side*2)),hair)
		wear(model,"Head","SideHair",Vector3.new(.18,1.25,.95),CFrame.new(side*.8,-.14,.22),hair)
	end
	-- Centre parting: two smooth panels over the forehead, no spikes.
	for _,x in {-.36,.36} do
		wear(model,"Head","Fringe",Vector3.new(.62,.3,.16),CFrame.new(x,.5,-.7)*A(R(8),0,R(if x&gt;0 then -10 else 10)),hair)
	end
	wear(model,"Head","BackHair",Vector3.new(1.66,1.45,.3),CFrame.new(0,-.14,.72),hair)
	wear(model,"UpperTorso","LongHair",Vector3.new(.72,1.5,.22),CFrame.new(0,.32,.62),hair)
	wear(model,"UpperTorso","HairTie",Vector3.new(.5,.12,.26),CFrame.new(0,-.38,.63),rgb(240,236,226))
	wear(model,"UpperTorso","HairTip",Vector3.new(.4,.48,.2),CFrame.new(0,-.68,.62),hair)
	headband(model,false)
	for _,name in {"UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm"} do
		local part=model:FindFirstChild(name);if part then part.Color=robe end
	end
	wear(model,"UpperTorso","HighCollar",Vector3.new(1.42,.5,1.1),CFrame.new(0,.86,.04),robe)
	wear(model,"UpperTorso","Overlap",Vector3.new(.08,1.3,.04),CFrame.new(-.32,-.05,-.53)*A(0,0,R(-10)),robeShade)
	wear(model,"LowerTorso","WaistTie",Vector3.new(2.06,.26,1.06),CFrame.new(0,.3,0),robeShade)
	for _,side in {"Left","Right"} do
		local legTop=model:FindFirstChild(side.."UpperLeg");if legTop then legTop.Color=shorts end
		local legLow=model:FindFirstChild(side.."LowerLeg");if legLow then legLow.Color=skin end
		wear(model,side.."LowerLeg","ShinWrap",Vector3.new(.84,.5,.84),CFrame.new(0,-.2,0),rgb(48,52,70))
		local foot=model:FindFirstChild(side.."Foot");if foot then foot.Color=rgb(40,46,66) end
		wear(model,side.."Foot","Toes",Vector3.new(.7,.16,.34),CFrame.new(0,.1,-.42),skin)
		wear(model,side.."UpperArm","Sleeve",Vector3.new(.88,.36,.88),CFrame.new(0,-.2,0),robe)
	end
	local leftArm=model:FindFirstChild("LeftLowerArm");if leftArm then leftArm.Color=skin end
	local rightArm=model:FindFirstChild("RightLowerArm");if rightArm then rightArm.Color=bandage end
	for k=0,2 do wear(model,"RightLowerArm","BandageLine",Vector3.new(.84,.04,.84),CFrame.new(0,.25-k*.25,0)*A(0,0,R(8)),rgb(212,208,198)) end
	wear(model,"RightUpperLeg","ThighBandage",Vector3.new(.88,.5,.88),CFrame.new(0,0,0),bandage)
	wear(model,"RightUpperLeg","Holster",Vector3.new(.24,.5,.5),CFrame.new(.5,-.05,0),rgb(48,52,70))
end
-- Sasuke at the Chunin Exam (12): dark blue high-collared shirt with the
-- Uchiha fan on the back, light shorts, white arm warmers, the Leaf headband,
-- black hair swept back into spikes, a two-tomoe Sharingan. The cursed seal
-- marks are there but hidden until he awakens it.
local function dressSasuke(model,def)
	local hair=rgb(24,26,40)
	local hairShade=rgb(36,40,62)
	local shirt=rgb(34,40,72)
	local shorts=rgb(222,216,204)
	local warmer=rgb(236,236,232)
	local skin=Color3.fromRGB(table.unpack(def.Skin))
	local cap=model:FindFirstChild("Hair");if cap then cap.Color=hair;cap.Transparency=1 end
	face(model,rgb(200,20,30),hair)
	for _,p in model:GetChildren() do if p.Name=="Iris" then p.Material=Enum.Material.Neon end end
	for _,side in {-1,1} do
		wear(model,"Head","Pupil",Vector3.new(.045,.045,.02),CFrame.new(side*.3,.07,-.842),rgb(12,8,10))
		for k=0,1 do
			local a=math.rad(90+k*180)
			wear(model,"Head","Tomoe",Vector3.new(.034,.034,.02),CFrame.new(side*.3+math.cos(a)*.05,.07+math.sin(a)*.05,-.842),rgb(12,8,10))
		end
	end
	hairCap(model,hair)
	-- Swept back: long spikes pointing back and up behind the crown, two long
	-- bangs framing the face, a short fringe over the headband.
	local back={
		{Vector3.new(0,.62,.5),Vector3.new(0,.55,1),1.05,.62,.4},
		{Vector3.new(-.45,.5,.5),Vector3.new(-.45,.5,1),.95,.52,.36},
		{Vector3.new(.45,.5,.5),Vector3.new(.45,.5,1),.95,.52,.36},
		{Vector3.new(0,.25,.66),Vector3.new(0,.25,1),.9,.6,.38},
		{Vector3.new(-.5,.12,.6),Vector3.new(-.55,.15,1),.8,.46,.32},
		{Vector3.new(.5,.12,.6),Vector3.new(.55,.15,1),.8,.46,.32},
		{Vector3.new(0,.8,.2),Vector3.new(0,.9,.7),.7,.5,.32},
		{Vector3.new(-.3,-.1,.68),Vector3.new(-.2,-.2,1),.7,.44,.3},
		{Vector3.new(.3,-.1,.68),Vector3.new(.2,-.2,1),.7,.44,.3},
	}
	for index,s in back do spike(model,s[1],s[2],s[3],s[4],s[5],if index%2==0 then hairShade else hair) end
	for _,x in {-.34,0,.34} do spike(model,Vector3.new(x,.66,-.55),Vector3.new(x*.3,-.8,-.5),.46,.4,.22,hair) end
	for _,side in {-1,1} do
		wear(model,"Head","Bang",Vector3.new(.2,1.2,.36),CFrame.new(side*.78,-.2,-.44)*A(R(2),0,R(side*6)),hair)
		wear(model,"Head","SideHair",Vector3.new(.16,.85,.85),CFrame.new(side*.8,.05,.28),hair)
	end
	headband(model,false)
	-- The cursed seal (hidden): three black flame marks on the left of the neck.
	for k=0,2 do
		local mark=wear(model,"Head","CurseMark",Vector3.new(.05,.22,.14),CFrame.new(-.78,-.42+k*.18,.08-k*.12)*A(R(20*k),0,R(10)),rgb(12,10,14))
		if mark then mark.Transparency=1 end
	end
	for _,name in {"UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm"} do
		local part=model:FindFirstChild(name);if part then part.Color=shirt end
	end
	wear(model,"UpperTorso","HighCollar",Vector3.new(1.5,.62,1.16),CFrame.new(0,.86,.04),shirt)
	crest(model,"UpperTorso",CFrame.new(0,.1,.53)*A(0,R(180),0),1.25)
	wear(model,"LowerTorso","Belt",Vector3.new(2.06,.22,1.06),CFrame.new(0,.3,0),rgb(30,30,36))
	for _,side in {"Left","Right"} do
		local armLow=model:FindFirstChild(side.."LowerArm");if armLow then armLow.Color=warmer end
		wear(model,side.."UpperArm","Sleeve",Vector3.new(.86,.42,.86),CFrame.new(0,.3,0),shirt)
		local legTop=model:FindFirstChild(side.."UpperLeg");if legTop then legTop.Color=shorts end
		local legLow=model:FindFirstChild(side.."LowerLeg");if legLow then legLow.Color=skin end
		wear(model,side.."LowerLeg","ShinWrap",Vector3.new(.84,.42,.84),CFrame.new(0,-.28,0),rgb(40,46,70))
		local foot=model:FindFirstChild(side.."Foot");if foot then foot.Color=rgb(36,40,62) end
		wear(model,side.."Foot","Toes",Vector3.new(.7,.16,.34),CFrame.new(0,.1,-.42),skin)
	end
	wear(model,"RightUpperLeg","ThighWrap",Vector3.new(.9,.38,.9),CFrame.new(0,-.1,0),warmer)
	wear(model,"RightUpperLeg","Holster",Vector3.new(.24,.5,.5),CFrame.new(.5,-.1,0),rgb(40,46,70))
	wear(model,"LowerTorso","ToolPouch",Vector3.new(.66,.4,.3),CFrame.new(0,.1,.62),rgb(70,64,58))
end
-- Gaara at the Chunin Exam (12): spiky red hair, 愛 on the forehead, dark rings
-- round pale eyes, a dark one-piece with the white sash that carries the sand
-- gourd on his back.
local function dressGaara(model,def)
	local hair=rgb(170,44,36)
	local hairShade=rgb(140,32,28)
	local suit=rgb(70,44,50)
	local suitDark=rgb(46,30,36)
	local sash=rgb(232,226,212)
	local gourd=rgb(206,170,118)
	local gourdDark=rgb(170,134,90)
	local skin=Color3.fromRGB(table.unpack(def.Skin))
	local cap=model:FindFirstChild("Hair");if cap then cap.Color=hair;cap.Transparency=1 end
	face(model,rgb(120,190,170),skin)
	-- No eyebrows; the sleepless dark rings around the eyes.
	for _,p in model:GetChildren() do
		if p.Name=="Brow" then p.Transparency=1 end
		if p.Name=="Eye" then p.Color=rgb(236,240,232) end
	end
	for _,side in {-1,1} do
		wear(model,"Head","EyeRing",Vector3.new(.4,.27,.03),CFrame.new(side*.3,.08,-.79),rgb(34,26,30))
	end
	-- 愛 above the left eye, in red.
	local mark=wear(model,"Head","LoveMark",Vector3.new(.3,.3,.02),CFrame.new(-.36,.42,-.8),rgb(176,30,34))
	if mark then
		local gui=Instance.new("SurfaceGui");gui.Face=Enum.NormalId.Front;gui.CanvasSize=Vector2.new(60,60);gui.LightInfluence=1;gui.Parent=mark
		local t=Instance.new("TextLabel");t.Size=UDim2.fromScale(1,1);t.BackgroundTransparency=1;t.Text="愛";t.TextScaled=true
		t.TextColor3=rgb(176,30,34);t.Font=Enum.Font.GothamBold;t.Parent=gui
		mark.Transparency=1
	end
	hairCap(model,hair)
	local spikes={
		{Vector3.new(0,.8,.1),Vector3.new(0,1,.3),.7,.5,.34},
		{Vector3.new(-.42,.7,.1),Vector3.new(-.6,.8,.3),.65,.46,.32},
		{Vector3.new(.42,.7,.1),Vector3.new(.6,.8,.3),.65,.46,.32},
		{Vector3.new(0,.5,.55),Vector3.new(0,.3,1),.7,.5,.34},
		{Vector3.new(-.5,.4,.5),Vector3.new(-.6,.2,1),.6,.42,.3},
		{Vector3.new(.5,.4,.5),Vector3.new(.6,.2,1),.6,.42,.3},
		{Vector3.new(-.72,.45,-.05),Vector3.new(-1,.4,.1),.48,.38,.26},
		{Vector3.new(.72,.45,-.05),Vector3.new(1,.4,.1),.48,.38,.26},
	}
	for index,s in spikes do spike(model,s[1],s[2],s[3],s[4],s[5],if index%2==0 then hairShade else hair) end
	-- Short messy fringe; no headband (he wears it on the sash).
	for _,x in {-.42,-.14,.14,.42} do spike(model,Vector3.new(x,.62,-.56),Vector3.new(x*.5,-.7,-.6),.44,.34,.2,hair) end
	for _,name in {"UpperTorso","LowerTorso","LeftUpperArm","RightUpperArm","LeftUpperLeg","RightUpperLeg"} do
		local part=model:FindFirstChild(name);if part then part.Color=suit end
	end
	for _,side in {"Left","Right"} do
		local armLow=model:FindFirstChild(side.."LowerArm");if armLow then armLow.Color=suitDark end
		local legLow=model:FindFirstChild(side.."LowerLeg");if legLow then legLow.Color=suitDark end
		local foot=model:FindFirstChild(side.."Foot");if foot then foot.Color=rgb(40,34,40) end
		wear(model,side.."Foot","Toes",Vector3.new(.7,.16,.34),CFrame.new(0,.1,-.42),skin)
	end
	wear(model,"UpperTorso","Collar",Vector3.new(1.3,.34,1.06),CFrame.new(0,.82,.02),suitDark)
	-- The sash across the chest (right shoulder to left hip) with the headband plate.
	wear(model,"UpperTorso","Sash",Vector3.new(.34,2.2,1.12),CFrame.new(0,0,0)*CFrame.Angles(0,0,math.rad(-38)),sash)
	wear(model,"UpperTorso","SashPlate",Vector3.new(.5,.3,.06),CFrame.new(-.2,.1,-.58)*CFrame.Angles(0,0,math.rad(-38)),rgb(176,184,194),Enum.Material.Metal)
	wear(model,"LowerTorso","Belt",Vector3.new(2.06,.22,1.06),CFrame.new(0,.3,0),suitDark)
	-- The gourd: two stacked bellies and a cork, strapped across the back.
	local belly=wear(model,"UpperTorso","Gourd",Vector3.new(1.9,1.9,1.5),CFrame.new(.1,-.4,1.25),gourd,Enum.Material.Sand)
	if belly then belly.Shape=Enum.PartType.Ball end
	local top=wear(model,"UpperTorso","GourdTop",Vector3.new(1.3,1.3,1.1),CFrame.new(.3,.75,1.2),gourd,Enum.Material.Sand)
	if top then top.Shape=Enum.PartType.Ball end
	cyl(wear(model,"UpperTorso","GourdNeck",Vector3.new(.4,.55,.55),CFrame.new(.42,1.42,1.18)*CFrame.Angles(0,0,math.rad(90)),gourdDark,Enum.Material.Wood))
	wear(model,"UpperTorso","GourdBand",Vector3.new(1.95,.16,1.55),CFrame.new(.1,.2,1.2),rgb(120,92,62),Enum.Material.Fabric)
end
local function soften(model)
	local head=model:FindFirstChild("Head")
	if head and not head:FindFirstChildOfClass("SpecialMesh") then
		-- A slightly larger, rounded head reads as a 12-14 year old, not an adult.
		local mesh=Instance.new("SpecialMesh");mesh.MeshType=Enum.MeshType.Head;mesh.Scale=Vector3.new(1.24,1.26,1.24);mesh.Parent=head
	end
end
function World.dress(model,def)
	soften(model)
	-- The rig's coloured test sash is replaced by each costume's own belt.
	local sash=model:FindFirstChild("Sash");if sash then sash.Transparency=1 end
	if def.Name=="Minato" then dressMinato(model,def) elseif def.Name=="Itachi" then dressItachi(model,def) elseif def.Name=="Neji" then dressNeji(model,def)
	elseif def.Name=="Sasuke" then dressSasuke(model,def) elseif def.Name=="Gaara" then dressGaara(model,def) end
	-- Hair and head gear never shadow the face; the body still casts.
	local head=model:FindFirstChild("Head")
	for _,p in model:GetChildren() do
		if p:IsA("BasePart") and p.Name~="HumanoidRootPart" then
			local weld=p:FindFirstChildOfClass("WeldConstraint")
			p.CastShadow=not (p==head or (weld and weld.Part0==head))
		end
	end
end
function World.pose(a,now,dt)
 Animation.step(a,now)
end
return World
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="ND46">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMinZoomDistance">8</float>
      <float name="CameraMaxZoomDistance">32</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="ND47">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="ND48">
        <Properties>
          <string name="Name">NinjaDuelClient</string>
        </Properties>
        <Item class="ModuleScript" referent="ND49">
          <Properties>
            <string name="Name">Camera</string>
            <ProtectedString name="Source">-- Duel camera. A locked third-person rig that keeps both fighters readable:
--  * it sits behind the player on the line to the opponent, a little over the
--    shoulder, and *orbits* (speed-limited) when the fighters swap sides, so a
--    Minato teleport behind the opponent turns the view around instead of
--    leaving the camera on the wrong side of the fight;
--  * distance and height grow with separation and vertical gap, so launchers,
--    chases and slams stay in frame;
--  * framing modes blend over several frames; impact shake and FOV kicks are
--    reserved for heavy moments.
local Camera={}; Camera.__index=Camera
local framing={
 Ground={distance=15,height=5.2,fov=68,lift=1.6,side=.32},
 Launcher={distance=18,height=4,fov=72,lift=4.5,side=.36},
 Pursuit={distance=21,height=6,fov=78,lift=3,side=.4},
 AirCombo={distance=19,height=3.5,fov=74,lift=2.5,side=.4},
 Slam={distance=19,height=10,fov=76,lift=-1.5,side=.34},
 Wall={distance=22,height=8,fov=75,lift=3,side=.5},
}
local function mode(h,b)
 if h.attackName=="Slam" or b.attackName=="Slam" then return "Slam" end
 if h.state=="Pursuit" or b.state=="Pursuit" then return "Pursuit" end
 if h.wall or b.wall or h.reaction=="WallSplat" or b.reaction=="WallSplat" then return "Wall" end
 if h.reaction=="Launched" or b.reaction=="Launched" then return "Launcher" end
 -- Air combo framing is for fighting in the air, not for every jump: an
 -- ordinary ninja jump keeps the ground rig and its vertical tracking.
 local function airFight(x) return x.airborne and (x.attackName~=nil or x.reaction~=nil) end
 if airFight(h) or airFight(b) then return "AirCombo" end
 return "Ground"
end
local function wrap(angle)
 return (angle+math.pi)%(2*math.pi)-math.pi
end
function Camera.new()
	local self=setmetatable({locked=true,look=Vector2.zero,yaw=0,pitch=.22,lastEpoch=-1,lastHealth=nil,lastEnemyHealth=nil,
		shakeUntil=0,shakeSize=0,fovKick=0,focus=nil,boomAngle=nil,distance=nil,rng=Random.new(),zoom=0,mode=nil},Camera)
 local UIS=game:GetService("UserInputService")
 -- Right mouse owns the heavy attack, so orbit and zoom are always live
 -- instead of needing a held modifier. Free-look only applies unlocked.
 UIS.InputChanged:Connect(function(input)
  if input.UserInputType==Enum.UserInputType.MouseMovement and not self.locked then
   self.yaw+=input.Delta.X*.004;self.pitch=math.clamp(self.pitch-input.Delta.Y*.003,.04,.9)
  elseif input.UserInputType==Enum.UserInputType.MouseWheel then
   self.zoom=math.clamp(self.zoom-input.Position.Z*1.4,-6,12)
  end
 end)
 return self
end
-- Locked, yaw is an offset from "behind the player"; unlocked it is an
-- absolute heading. Convert on toggle so the lens stays where it is instead of
-- swinging to world north (and dragging the movement axes with it).
function Camera:setLocked(locked)
 if locked==self.locked then return end
 if locked then self.yaw=0 else self.yaw=self.boomAngle or self.yaw end
 self.locked=locked
end
-- Impact-driven impulse. Small events must not make the camera twitch: only a
-- finisher, launcher, parry, slam, teleport or big jutsu earns a reaction.
local IMPULSE={
 whiff={0,0},spent={0,0},kunai={0,0},shuriken={0,0},stick={0,0},fade={0,0},cast={0,0},chase={.02,1.2},dodge={.01,.25},substitute={.02,.4},
 light={.02,.3},air={.025,.45},landing={.04,.6},block={.04,.6},quickstep={.015,.8},teleport={.03,2.2},mirage={0,0},burst={.02,1},
 launcher={.1,1.3},finisher={.13,1.6},parry={.14,1.7},jutsu={.15,1.8},fire={.32,3.2},
 slam={.26,2.6},wall={.14,1.1},wallbounce={.2,2.0},clash={.12,1.6},walltech={.02,.4},pin={.02,.25},ember={.02,.35},palm={.015,.2},palmburst={.06,.9},flow={.03,.6},awaken={.12,2.4},groundbounce={.18,1.8},chidori={.1,2.2},afterimage={0,0},deflect={.01,.2},repel={.1,1.3},rotation={.04,.9},trigram={0,0},
}
function Camera:impulse(style,role)
	local spec=IMPULSE[style] or IMPULSE.light
	if not spec or (spec[1]&lt;=0 and spec[2]&lt;=0) then return end
	local weight=if role=="victim" then 1.25 elseif role=="neutral" then .6 else .85
	local now=os.clock()
	self.shakeSize=math.max(self.shakeSize or 0,spec[1]*weight)
	self.fovKick=math.max(self.fovKick or 0,spec[2]*weight)
	self.shakeUntil=math.max(self.shakeUntil or 0,now+(if style=="slam" or style=="fire" then .18 else .07))
	-- A decisive blow gets a beat of space: the lens eases back, then settles.
	local SETTLE={finisher=1.6,launcher=1.2,slam=2.4,wallbounce=2.4,wall=1.4,clash=1.4,repel=1.8,parry=1.4,fire=2}
	if SETTLE[style] then self.settleSize=math.max(if now&lt;(self.settleUntil or 0) then self.settleSize or 0 else 0,SETTLE[style]);self.settleUntil=now+.75 end
end
function Camera:update(data,dt)
	local camera=workspace.CurrentCamera
	-- Roster, online queue and fighter pick: no duel on screen yet.
	if not data or (data.phase~="Duel" and data.phase~="Result") or not data.human or not data.bot then
		self.lastHealth=nil; self.lastEnemyHealth=nil; camera.FieldOfView=70
		camera.CameraType=Enum.CameraType.Scriptable
		-- Slow establishing orbit over the training ground behind the menu.
		local t=os.clock()*.06
		camera.CFrame=CFrame.lookAt(Vector3.new(math.sin(t)*88,38,math.cos(t)*88),Vector3.new(0,8,0)); return
	end
	local character=game:GetService("Players").LocalPlayer.Character
	local root=character and character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	camera.CameraType=Enum.CameraType.Scriptable
	local fresh=self.lastEpoch~=data.epoch
	if fresh then self.lastHealth=data.human.health; self.lastEnemyHealth=data.bot.health;self.yaw=0;self.pitch=.22;self.focus=nil;self.boomAngle=nil;self.distance=nil;self.sprint=0;self.wasSprinting=false;self.lastImpactSerial=data.human.impactSerial or 0 end
	-- Fallback only: the impact-style impulse above owns normal reactions.
	-- Only a new contact counts: a health drain (curse mark) carries a stale
	-- impactHeavy and must not shake the lens every snapshot.
	local serial=data.human.impactSerial or 0
	if self.lastHealth and data.human.health&lt;self.lastHealth and serial~=self.lastImpactSerial then
		local damage=self.lastHealth-data.human.health
		if data.human.impactHeavy or damage&gt;=12 then
			self.shakeSize=math.max(self.shakeSize or 0,.2);self.fovKick=math.max(self.fovKick or 0,2);self.shakeUntil=math.max(self.shakeUntil or 0,os.clock()+.12)
		end
	end
	self.lastImpactSerial=serial
	self.lastHealth=data.human.health
	self.lastEnemyHealth=data.bot.health
	-- Frame the bodies where they are drawn (smoothed), not the stepping roots.
	local presentation=self.presentation
	local a=(presentation and presentation:visualRoot("human")) or root.Position
	local folder=root.Parent and root.Parent.Parent
	-- The opponent's model is named by its id (AIFighter locally, a duelist online).
	local bot=folder and folder:FindFirstChild(data.bot.id or "AIFighter")
	local b=bot and bot:FindFirstChild("HumanoidRootPart")
	local target=(presentation and presentation:visualRoot("bot")) or (if b then b.Position else data.bot.position)
	local flat=Vector3.new(target.X-a.X,0,target.Z-a.Z)
	if flat.Magnitude&lt;.01 then flat=-Vector3.zAxis end
	local separation=flat.Magnitude
	local vertical=math.abs(target.Y-a.Y)
	local aerial=data.human.airborne or data.bot.airborne or vertical&gt;5
	local pursuit=data.human.state=="Pursuit" or data.bot.state=="Pursuit"
	local slam=data.human.attackName=="Slam" or data.bot.attackName=="Slam"
	local selected=mode(data.human,data.bot)
	self.mode=selected
	local frame=framing[selected]
	-- Look-stick / unlocked mouse orbit.
	self.yaw+=(self.look.X or 0)*dt*2.4;self.pitch=math.clamp(self.pitch-(self.look.Y or 0)*dt,.04,.9)
	-- Boom heading: behind the player on the player-&gt;opponent line, offset over
	-- the shoulder. When the fighters swap sides the heading orbits around at a
	-- bounded angular speed rather than staying on the old side.
	local behind=-flat.Unit
	local desiredAngle
	if self.locked then
		desiredAngle=math.atan2(behind.X,behind.Z)+self.yaw+frame.side
	else
		desiredAngle=self.yaw
	end
	if not self.boomAngle then self.boomAngle=desiredAngle end
	local delta=wrap(desiredAngle-self.boomAngle)
	-- A large swing (teleport behind, cross-up) turns faster than a small drift.
	local maxRate=if math.abs(delta)&gt;1.4 then math.rad(420) else math.rad(240)
	local step=delta*(1-math.exp(-dt*(if math.abs(delta)&gt;1.4 then 7 else 5)))
	step=math.clamp(step,-maxRate*dt,maxRate*dt)
	self.boomAngle=wrap(self.boomAngle+step)
	local boom=Vector3.new(math.sin(self.boomAngle),0,math.cos(self.boomAngle))
	-- Focus: between the fighters, biased towards the player, raised for air.
	local bias=if separation&lt;=26 then .42 else math.max(.3,.42-(separation-26)*.004)
	local targetFocus=a:Lerp(target,bias)+Vector3.new(0,frame.lift,0)
	-- Sprint feel: only the player's own sprint (never the opponent's) eases
	-- in a wider lens, a slightly tighter and lower boom and a longer lead, so
	-- the floor streams past without the camera falling behind the body.
	local sprintTarget=if data.human.sprinting and (data.human.speed or 0)&gt;24 then 1 else 0
	local sprint=self.sprint or 0
	sprint+=(sprintTarget-sprint)*(1-math.exp(-dt*(if sprintTarget&gt;sprint then 6 else 3)))
	if sprintTarget==1 and not self.wasSprinting then self.fovKick=math.max(self.fovKick or 0,2.5) end
	self.sprint=sprint;self.wasSprinting=sprintTarget==1
	-- Lead a little where the player is going so a run is framed ahead of it.
	local moving=presentation and presentation:visualVelocity("human")
	if moving then
		local lead=Vector3.new(moving.X,0,moving.Z)*.11
		local leadCap=2.6+sprint*2.4
		if lead.Magnitude&gt;leadCap then lead=lead.Unit*leadCap end
		self.lead=(self.lead or Vector3.zero):Lerp(lead,1-math.exp(-dt*4))
		targetFocus+=self.lead
	end
	if not self.locked then targetFocus=a+Vector3.new(0,1.6,0) end
	local focusRate=if aerial or pursuit then 13 else 9
	self.focus=if self.focus then self.focus:Lerp(targetFocus,1-math.exp(-dt*focusRate)) else targetFocus
	local focus=self.focus
	local settle=math.max(0,(self.settleUntil or 0)-os.clock())/.75
	-- K.O.: a slow drift around the finish while the lens eases out.
	if data.ko then self.yaw+=dt*.3 end
	local spread=math.min(math.max(0,separation-7),19)*.68+math.max(0,separation-26)*.32
	local wantDistance=math.clamp(frame.distance-sprint*1.5+spread+vertical*.3+self.zoom+(self.settleSize or 0)*math.sin(settle*math.pi*.5)+(if data.ko then 6 else 0),12,48)
	self.distance=if self.distance then self.distance+(wantDistance-self.distance)*(1-math.exp(-dt*4)) else wantDistance
	local height=frame.height-sprint*.6+self.pitch*9+vertical*.28+math.min(math.max(0,separation-10)*.1,4)
	if slam then height+=math.clamp(-(data.human.velocity and data.human.velocity.Y or 0)*.04,0,4) end
	local desired=focus+boom*self.distance+Vector3.new(0,height,0)
	-- Match intro: a slow orbit that presents both fighters, then the normal
	-- rig takes over from wherever the orbit ended.
	if (data.intro or 0)&gt;0 then
		local mid=a:Lerp(target,.5)
		local turn=self.boomAngle+math.rad(70)-(data.intro/2.6)*math.rad(110)
		focus=mid+Vector3.new(0,2.6,0)
		desired=focus+Vector3.new(math.sin(turn),0,math.cos(turn))*(separation*.5+13)+Vector3.new(0,3.2,0)
		self.focus=focus
	end
	self.fovKick*=math.exp(-dt*9)
	local speed=data.human.speed or 0
	local targetFov=frame.fov+math.clamp(separation*.08,0,5)+math.clamp(speed*.05,0,2)+sprint*5+self.fovKick
	camera.FieldOfView+=(targetFov-camera.FieldOfView)*(1-math.exp(-dt*(if pursuit or slam then 8 else 5)))
	-- Keep the lens out of walls and cover; effects and fighters never block it.
	local ray=RaycastParams.new(); ray.FilterType=Enum.RaycastFilterType.Exclude
	local exclude={character};if bot then table.insert(exclude,bot) end
	local effects=folder and folder:FindFirstChild("Effects");if effects then table.insert(exclude,effects) end
	local fx=workspace:FindFirstChild("NinjaDuelFX");if fx then table.insert(exclude,fx) end
	ray.FilterDescendantsInstances=exclude
	-- Fighting-space props (slabs, cover, posts, platforms) never shove the lens
	-- into the player's back: the camera looks through them and they fade.
	-- Only the floor and the bowl's boundary still stop the lens.
	local faded={}
	local hit=workspace:Raycast(focus,desired-focus,ray)
	for _=1,4 do
		if not hit or hit.Instance.Name=="Training floor" or hit.Instance.Name=="Boundary" then break end
		faded[hit.Instance]=true
		table.insert(exclude,hit.Instance)
		ray.FilterDescendantsInstances=exclude
		hit=workspace:Raycast(focus,desired-focus,ray)
	end
	for part in self.faded or {} do if not faded[part] and part.Parent then part.LocalTransparencyModifier=0 end end
	for part in faded do part.LocalTransparencyModifier=.72 end
	self.faded=faded
	if hit then
		local offset=desired-focus
		local full=offset.Magnitude
		local allowed=math.max(0,hit.Distance-1.2)
		local lost=math.clamp(full-allowed,0,full)
		-- The closer the wall pushes the lens, the higher it rises over the fight:
		-- continuous in the push, so a fight along the wall never snaps the view.
		desired=focus+offset.Unit*math.max(allowed,4.5)+Vector3.new(0,lost*.6,0)
		local check=workspace:Raycast(focus,desired-focus,ray)
		if check then desired=check.Position+check.Normal*1.2 end
	end
	local cf=CFrame.lookAt(desired,focus)
	-- Shake is an offset on top of the smoothed rig (applied last, never fed
	-- back into the follow), so it is neither damped away nor left behind.
	-- A continuous, decaying oscillation (~7-10 Hz) rather than a fresh random
	-- offset every frame: random per-frame offsets read as the whole image
	-- jumping (measured natively), an oscillation reads as an impact.
	local shake=CFrame.identity
	local clock=os.clock()
	if clock&lt;self.shakeUntil then
		local amp=self.shakeSize*math.clamp((self.shakeUntil-clock)/.18,0,1)
		shake=CFrame.new(math.sin(clock*47)*amp,math.sin(clock*61+1.3)*amp*.8,0)
	end
	-- Studio capture aid: on high-DPI Windows the Studio window only shows the
	-- top-left two thirds of the play viewport, so tooling can ask for the view
	-- to be re-aimed at that visible region. Never active outside Studio.
	local studio=game:GetService("RunService"):IsStudio()
	-- Studio film camera (tooling only): a low side view of both fighters, the
	-- way a fighting-game camera shows feet, ground contact and body mechanics.
	local film=studio and workspace:GetAttribute("NinjaDuelFilmCam")
	if film then
		local mid=a:Lerp(target,.5)
		local line=Vector3.new(target.X-a.X,0,target.Z-a.Z)
		if line.Magnitude&lt;.1 then line=Vector3.xAxis end
		local side=line.Unit:Cross(Vector3.yAxis)
		local dist=(if type(film)=="number" then film else 0)+math.max(11,separation*.75+8)
		local look=mid+Vector3.new(0,-.4,0)
		cf=CFrame.lookAt(look+side*dist+Vector3.new(0,1.2,0),look)
		camera.FieldOfView=50
	end
	if studio and workspace:GetAttribute("NinjaDuelCaptureShift") then
		-- Turn about the world vertical, then pitch, and rebuild with a world up
		-- so the horizon never rolls.
		local look=CFrame.fromAxisAngle(Vector3.yAxis,math.rad(-21)):VectorToWorldSpace(cf.LookVector)
		look=(look-Vector3.yAxis*math.tan(math.rad(12))).Unit
		cf=CFrame.lookAt(cf.Position,cf.Position+look)
	end
	if film then camera.CFrame=cf;self.rigCF=nil;return end
	if fresh or not self.rigCF then self.rigCF=cf; self.lastEpoch=data.epoch
	else
		-- Follow tightly enough for teleports, but never jump more than a few
		-- studs in one frame.
		local base=self.rigCF
		local nextCF=base:Lerp(cf,1-math.exp(-dt*(if aerial or pursuit or slam then 15 else 11)))
		local move=nextCF.Position-base.Position
		local limit=math.max(3.5,520*dt)
		if move.Magnitude&gt;limit then nextCF=CFrame.new(base.Position+move.Unit*limit)*nextCF.Rotation end
		self.rigCF=nextCF
	end
	camera.CFrame=self.rigCF*shake
end
return Camera
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND50">
          <Properties>
            <string name="Name">Effects</string>
            <ProtectedString name="Source">-- Client-side combat VFX. Everything here is presentation driven by the server
-- snapshot and contact feed: real 3D kunai and shuriken flying on the exact
-- server path, planted Flying Thunder God seals, the Katon fireball, teleport
-- flashes, substitution logs, Itachi's crows, Rasengan and burning ground.
-- Nothing in this module can change gameplay.
local Debris=game:GetService("Debris")
local TweenService=game:GetService("TweenService")
local FX={};FX.__index=FX

local TEX={
	fire="rbxasset://textures/particles/fire_main.dds",
	smoke="rbxasset://textures/particles/smoke_main.dds",
	spark="rbxasset://textures/particles/sparkles_main.dds",
	fireSpark="rbxasset://textures/particles/fire_sparks_main.dds",
	core="rbxasset://textures/particles/explosion01_core_main.dds",
	shock="rbxasset://textures/particles/explosion01_shockwave_main.dds",
	glow="rbxasset://textures/particles/forcefield_glow_main.dds",
	vortex="rbxasset://textures/particles/forcefield_vortex_main.dds",
}
local SOUND={
	whoosh="rbxassetid://5835032207",
	hit="rbxassetid://8595980577",
	heavy="rbxassetid://9117969717",
	boom="rbxasset://sounds/impact_explosion_03.mp3",
	land="rbxasset://sounds/action_jump_land.mp3",
	jump="rbxasset://sounds/action_jump.mp3",
	getUp="rbxasset://sounds/action_get_up.mp3",
}
-- Contacts that bring the crowd to its feet, by strength.
local CHEER={chidori=1,groundbounce=.8,slam=1,launcher=.7,finisher=.8,fire=1,teleport=.9,parry=.8,substitute=.4,burst=.8,clash=.9,wall=.6,wallbounce=1,walltech=.5,repel=.9,trigram=.7}
local HYUGA=Color3.fromRGB(190,208,255)
-- Visual time runs a hair behind the server clock, like the bodies, so a blade
-- leaves the throwing hand on the frame the arm releases it.
FX.DELAY=.06
local STEEL=Color3.fromRGB(64,68,76)
local STEEL_EDGE=Color3.fromRGB(150,158,170)
local MINATO=Color3.fromRGB(255,214,92)
local LION=Color3.fromRGB(150,180,255)
local CURSE=Color3.fromRGB(120,60,200)
local MINATO_CORE=Color3.fromRGB(255,248,214)
local SHARINGAN=Color3.fromRGB(230,36,44)
local WIND=Color3.fromRGB(190,255,226)

local function new(class,props,parent)
	local x=Instance.new(class)
	for k,v in props do x[k]=v end
	if parent then x.Parent=parent end
	return x
end
local function block(parent,size,cf,color,material,class)
	local p=new(class or "Part",{Size=size,CFrame=cf,Color=color,Material=material or Enum.Material.SmoothPlastic,
		Anchored=true,CanCollide=false,CanQuery=false,CanTouch=false,CastShadow=false,
		TopSurface=Enum.SurfaceType.Smooth,BottomSurface=Enum.SurfaceType.Smooth},parent)
	return p
end
local function sound(parent,id,volume,speed)
	local s=new("Sound",{SoundId=id,Volume=volume or .4,PlaybackSpeed=speed or 1,RollOffMaxDistance=160,RollOffMinDistance=12},parent)
	s:Play();Debris:AddItem(s,3)
	return s
end
local function tween(object,time,goal,style,direction)
	local t=TweenService:Create(object,TweenInfo.new(time,style or Enum.EasingStyle.Quad,direction or Enum.EasingDirection.Out),goal)
	t:Play();return t
end
local function seq(points)
	local keys={}
	for _,p in points do table.insert(keys,ColorSequenceKeypoint.new(p[1],p[2])) end
	return ColorSequence.new(keys)
end
local function num(points)
	local keys={}
	for _,p in points do table.insert(keys,NumberSequenceKeypoint.new(p[1],p[2],p[3] or 0)) end
	return NumberSequence.new(keys)
end
local function emitter(parent,props)
	local e=new("ParticleEmitter",{Enabled=false,LightInfluence=0,ZOffset=.5},parent)
	for k,v in props do e[k]=v end
	return e
end
local function anchorPart(parent,position)
	return block(parent,Vector3.new(.2,.2,.2),CFrame.new(position),Color3.new(),Enum.Material.SmoothPlastic)
end
-- Weld every piece of a model to its (anchored) root so one CFrame write moves
-- the whole object.
local function weldAll(root,parts)
	for _,p in parts do
		if p~=root then
			p.Anchored=false;p.Massless=true
			local w=new("WeldConstraint",{Part0=root,Part1=p},root)
			w.Name="Hold"
		end
	end
end
-- One half of a tapered leaf. Wedge local Y is the width axis (full at the back,
-- zero at the front edge), X the thickness. `tip` = -1 puts the point towards
-- -Z, +1 towards +Z; `side` picks the half.
local function taper(parent,center,width,length,thick,side,tip,color,material)
	local rot=CFrame.Angles(0,0,-side*math.pi/2)
	if tip&gt;0 then rot=rot*CFrame.Angles(0,math.pi,0) end
	local cf=center*CFrame.new(side*width*.25,0,0)*rot
	return block(parent,Vector3.new(thick,width*.5,length),cf,color,material or Enum.Material.Metal,"WedgePart")
end
local function leaf(parent,center,width,front,back,thick,color,material)
	local list={}
	for _,side in {-1,1} do
		table.insert(list,taper(parent,center*CFrame.new(0,0,-front*.5),width,front,thick,side,-1,color,material))
		table.insert(list,taper(parent,center*CFrame.new(0,0,back*.5),width,back,thick,side,1,color,material))
	end
	return list
end
local function ring(parent,center,radius,count,size,color,material)
	local list={}
	for i=0,count-1 do
		local a=i/count*math.pi*2
		local cf=center*CFrame.Angles(a,0,0)*CFrame.new(0,radius,0)
		table.insert(list,block(parent,Vector3.new(size,size*.9,radius*2*math.pi/count*1.15),cf,color,material or Enum.Material.Metal))
	end
	return list
end

-- ------------------------------------------------------------------ models
-- Kunai built along -Z (point first). The grip centre is the origin, so the
-- same model sits correctly in a hand and flies point-first.
function FX.buildKunai(marked)
	local model=new("Model",{Name=if marked then "MarkedKunai" else "Kunai"})
	local root=block(model,Vector3.new(.1,.1,.1),CFrame.new(),Color3.new(),nil);root.Name="Root";root.Transparency=1
	local parts={}
	local handle=block(model,Vector3.new(.62,.12,.12),CFrame.new(0,0,.1)*CFrame.Angles(0,math.pi/2,0),Color3.fromRGB(36,34,38),Enum.Material.Fabric)
	handle.Shape=Enum.PartType.Cylinder;table.insert(parts,handle)
	for i=-1,1 do
		local band=block(model,Vector3.new(.045,.145,.145),CFrame.new(0,0,.1+i*.19)*CFrame.Angles(0,math.pi/2,0),Color3.fromRGB(122,108,88),Enum.Material.Fabric)
		band.Shape=Enum.PartType.Cylinder;table.insert(parts,band)
	end
	for _,p in ring(model,CFrame.new(0,0,.55),.13,8,.05,STEEL) do table.insert(parts,p) end
	local guard=block(model,Vector3.new(.22,.06,.08),CFrame.new(0,0,-.22),STEEL,Enum.Material.Metal);table.insert(parts,guard)
	-- Leaf blade: widest a third of the way up, long point.
	for _,p in leaf(model,CFrame.new(0,0,-.46),.34,.66,.22,.05,STEEL) do table.insert(parts,p) end
	-- Bright edge along the centre line so the blade reads at combat speed.
	table.insert(parts,block(model,Vector3.new(.02,.055,.82),CFrame.new(0,0,-.5),STEEL_EDGE,Enum.Material.Metal))
	if marked then
		-- Minato's three-pronged kunai: two swept side prongs, and the sealing
		-- formula tag wrapped on the grip.
		for _,side in {-1,1} do
			local base=CFrame.new(side*.12,0,-.3)*CFrame.Angles(0,side*math.rad(28),0)
			for _,p in leaf(model,base*CFrame.new(0,0,-.08),.14,.3,.06,.04,STEEL) do table.insert(parts,p) end
		end
		local tag=block(model,Vector3.new(.2,.02,.42),CFrame.new(0,.075,.12),Color3.fromRGB(236,226,196),Enum.Material.SmoothPlastic)
		tag.Name="SealTag";table.insert(parts,tag)
		for i=-1,1 do
			table.insert(parts,block(model,Vector3.new(.012,.024,.3-math.abs(i)*.08),CFrame.new(i*.05,.088,.12),Color3.fromRGB(30,32,40),Enum.Material.SmoothPlastic))
		end
	end
	weldAll(root,parts)
	model.PrimaryPart=root
	return model
end
-- Four-point shuriken, flat in the XZ plane, spun about its own Y axis.
function FX.buildShuriken()
	local model=new("Model",{Name="Shuriken"})
	local root=block(model,Vector3.new(.1,.1,.1),CFrame.new(),Color3.new());root.Name="Root";root.Transparency=1
	local parts={}
	local disc=block(model,Vector3.new(.07,.46,.46),CFrame.Angles(0,0,math.pi/2),STEEL,Enum.Material.Metal)
	disc.Shape=Enum.PartType.Cylinder;table.insert(parts,disc)
	local hole=block(model,Vector3.new(.08,.13,.13),CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(18,18,22),Enum.Material.SmoothPlastic)
	hole.Shape=Enum.PartType.Cylinder;table.insert(parts,hole)
	for i=0,3 do
		local base=CFrame.Angles(0,i*math.pi/2,0)*CFrame.new(0,0,-.3)
		for _,p in leaf(model,base*CFrame.new(0,0,-.05),.2,.42,.1,.04,STEEL) do table.insert(parts,p) end
		table.insert(parts,block(model,Vector3.new(.015,.05,.38),base*CFrame.new(0,0,-.22),STEEL_EDGE,Enum.Material.Metal))
	end
	weldAll(root,parts)
	model.PrimaryPart=root
	return model
end
local function addTrail(root,a,b,color,lifetime,transparency,width)
	local a0=new("Attachment",{Position=a},root)
	local a1=new("Attachment",{Position=b},root)
	return new("Trail",{Attachment0=a0,Attachment1=a1,Color=ColorSequence.new(color),LightEmission=.7,
		Transparency=num({{0,transparency or .35},{1,1}}),Lifetime=lifetime or .12,FaceCamera=true,WidthScale=num({{0,width or 1},{1,.2}})},root)
end
function FX.buildFireball()
	local model=new("Model",{Name="GreatFireball"})
	local root=block(model,Vector3.new(1,1,1),CFrame.new(),Color3.fromRGB(255,240,180),Enum.Material.Neon);root.Name="Root"
	root.Shape=Enum.PartType.Ball;root.Transparency=.05
	local mid=block(model,Vector3.new(1,1,1),CFrame.new(),Color3.fromRGB(255,150,40),Enum.Material.Neon);mid.Shape=Enum.PartType.Ball;mid.Transparency=.35;mid.Name="Mid"
	local outer=block(model,Vector3.new(1,1,1),CFrame.new(),Color3.fromRGB(230,70,20),Enum.Material.Neon);outer.Shape=Enum.PartType.Ball;outer.Transparency=.62;outer.Name="Outer"
	weldAll(root,{mid,outer})
	local at=new("Attachment",{},root)
	emitter(at,{Name="Flames",Enabled=true,Texture=TEX.fire,Rate=140,Lifetime=NumberRange.new(.25,.5),Speed=NumberRange.new(2,7),SpreadAngle=Vector2.new(180,180),
		Color=seq({{0,Color3.fromRGB(255,240,170)},{.35,Color3.fromRGB(255,140,40)},{.75,Color3.fromRGB(200,50,20)},{1,Color3.fromRGB(60,20,10)}}),
		LightEmission=1,Size=num({{0,3},{.4,5},{1,1.5}}),Transparency=num({{0,.15},{.7,.4},{1,1}}),Drag=3,RotSpeed=NumberRange.new(-120,120),Rotation=NumberRange.new(0,360),ZOffset=1})
	emitter(at,{Name="Smoke",Enabled=true,Texture=TEX.smoke,Rate=26,Lifetime=NumberRange.new(.7,1.2),Speed=NumberRange.new(1,3),SpreadAngle=Vector2.new(180,180),
		Color=ColorSequence.new(Color3.fromRGB(60,48,44)),LightEmission=0,Size=num({{0,3},{1,8}}),Transparency=num({{0,.55},{1,1}}),Drag=2})
	emitter(at,{Name="Embers",Enabled=true,Texture=TEX.fireSpark,Rate=40,Lifetime=NumberRange.new(.4,.8),Speed=NumberRange.new(6,14),SpreadAngle=Vector2.new(180,180),
		Color=ColorSequence.new(Color3.fromRGB(255,190,90)),LightEmission=1,Size=num({{0,.35},{1,0}}),Acceleration=Vector3.new(0,6,0)})
	new("PointLight",{Color=Color3.fromRGB(255,140,60),Brightness=4,Range=28,Shadows=false},root)
	model.PrimaryPart=root
	return model
end
function FX.buildWind()
	local model=new("Model",{Name="WindBlade"})
	local root=block(model,Vector3.new(.1,.1,.1),CFrame.new(),Color3.new());root.Name="Root";root.Transparency=1
	local parts={}
	for i=-3,3 do
		local a=i*math.rad(16)
		local p=block(model,Vector3.new(1.3,.06,.35),CFrame.Angles(0,a,0)*CFrame.new(0,0,-1.6+math.abs(i)*.18),Color3.fromRGB(200,255,232),Enum.Material.Neon)
		p.Transparency=.35+math.abs(i)*.08;table.insert(parts,p)
	end
	weldAll(root,parts)
	addTrail(root,Vector3.new(-2.2,0,0),Vector3.new(2.2,0,0),Color3.fromRGB(190,255,226),.16,.55,1)
	model.PrimaryPart=root
	return model
end

-- ------------------------------------------------------------------ state
function FX.new()
	local folder=Instance.new("Folder");folder.Name="NinjaDuelFX";folder.Parent=workspace
	return setmetatable({folder=folder,projectiles={},stuck={},seals={},hazards={},auras={},rasengan={},epoch=nil,
		clock=0,cache={}},FX)
end
function FX:reset()
	self.folder:ClearAllChildren()
	table.clear(self.projectiles);table.clear(self.stuck);table.clear(self.seals);table.clear(self.hazards);table.clear(self.rasengan)
	for _,aura in self.auras do if aura.trail then aura.trail.Enabled=false end end
end
local function serverNow() return workspace:GetServerTimeNow() end
function FX:visualTime() return serverNow()-FX.DELAY end
local BUILD={kunai=function() return FX.buildKunai(false) end,marked=function() return FX.buildKunai(true) end,wire=function() return FX.buildShuriken() end,
	shuriken=FX.buildShuriken,fireball=FX.buildFireball,wind=FX.buildWind,
	-- Vacuum Palm: a pale ring of compressed air (sized by the flight radius).
	palm=function()
		local model=new("Model",{Name="VacuumPalm"})
		local root=block(model,Vector3.new(.1,.1,.1),CFrame.new(),Color3.new());root.Name="Root";root.Transparency=1
		local ring=block(model,Vector3.new(.3,3,3),CFrame.Angles(0,math.pi/2,0),Color3.fromRGB(214,228,255),Enum.Material.Neon);ring.Name="Ring"
		ring.Shape=Enum.PartType.Cylinder;ring.Transparency=.62
		local core=block(model,Vector3.new(.2,1.6,1.6),CFrame.Angles(0,math.pi/2,0)*CFrame.new(-.4,0,0),Color3.fromRGB(240,246,255),Enum.Material.Neon);core.Name="Core"
		core.Shape=Enum.PartType.Cylinder;core.Transparency=.45
		weldAll(root,{ring,core})
		addTrail(root,Vector3.new(0,1.2,0),Vector3.new(0,-1.2,0),Color3.fromRGB(206,222,255),.12,.6,1)
		model.PrimaryPart=root
		return model
	end,
	-- Phoenix Flower: the same fire build, shrunk and dimmer.
	phoenix=function()
		local model=FX.buildFireball()
		local light=model.PrimaryPart:FindFirstChildOfClass("PointLight");if light then light.Range=12;light.Brightness=2.5 end
		local at=model.PrimaryPart:FindFirstChildOfClass("Attachment")
		local smoke=at and at:FindFirstChild("Smoke");if smoke then smoke.Rate=8 end
		local flames=at and at:FindFirstChild("Flames");if flames then flames.Rate=60 end
		return model
	end}
-- Snapshot sync: create visuals for newly announced projectiles, mark the ones
-- the server no longer reports.
function FX:sync(data)
	if data.epoch~=self.epoch then self.epoch=data.epoch;self:reset() end
	-- The two fighters' model names in this duel (online they are not the AI names).
	if data.human and data.bot then self.fighterIds={data.human.id,data.bot.id} end
	local live={}
	for _,p in data.projectiles or {} do
		live[p.id]=true
		local entry=self.projectiles[p.id]
		if not entry then
			local build=BUILD[p.kind] or BUILD.kunai
			local model=build()
			model.Parent=self.folder
			local root=model.PrimaryPart
			if p.kind=="kunai" or p.kind=="marked" then
				addTrail(root,Vector3.new(0,.06,.2),Vector3.new(0,-.06,.2),if p.kind=="marked" then MINATO else Color3.fromRGB(220,226,236),.1,.5,1)
			elseif p.kind=="shuriken" or p.kind=="wire" then
				addTrail(root,Vector3.new(-.35,0,0),Vector3.new(.35,0,0),Color3.fromRGB(226,232,240),.08,.6,1)
			end
			if p.kind=="wire" then
				-- Ninja wire: a thin line from the thrower's hand to the blade.
				local owner=self.fighters and self.fighters:FindFirstChild(p.owner or "")
				local hand=owner and owner:FindFirstChild("RightHand")
				if hand then
					local a0=new("Attachment",{Name="WireStart"},hand)
					local a1=new("Attachment",{Name="WireEnd"},root)
					new("Beam",{Attachment0=a0,Attachment1=a1,Width0=.06,Width1=.06,Color=ColorSequence.new(Color3.fromRGB(210,214,220)),LightEmission=.3,FaceCamera=true,Segments=2},root)
					Debris:AddItem(a0,1.2)
				end
			end
			entry={data=p,model=model,root=root,spin=math.random()*math.pi*2,hidden=true}
			self.projectiles[p.id]=entry
			for _,d in model:GetDescendants() do if d:IsA("BasePart") then d.LocalTransparencyModifier=1 end end
			if p.kind=="fireball" then
				sound(root,SOUND.boom,.35,.55)
			elseif p.kind=="phoenix" then
				sound(root,SOUND.whoosh,.25,.7)
			elseif p.kind=="palm" then
				sound(root,SOUND.whoosh,.45,.6)
			elseif p.kind=="kunai" or p.kind=="marked" or p.kind=="shuriken" or p.kind=="wire" then
				sound(root,SOUND.whoosh,.28,if p.kind=="shuriken" then 1.5 else 1.25)
			end
		end
		entry.data=p;entry.missingSince=nil
	end
	for id,entry in self.projectiles do
		if not live[id] and not entry.missingSince then entry.missingSince=os.clock() end
	end
end
function FX:finishProjectile(id)
	local entry=self.projectiles[id]
	if not entry then return nil end
	self.projectiles[id]=nil
	local root=entry.root
	-- Let a trail finish fading instead of cutting it.
	for _,d in entry.model:GetDescendants() do
		if d:IsA("BasePart") then d.Transparency=1 elseif d:IsA("ParticleEmitter") then d.Enabled=false elseif d:IsA("PointLight") then d.Enabled=false end
	end
	Debris:AddItem(entry.model,.6)
	return entry,root
end
function FX:stepProjectiles(dt)
	local t=self:visualTime()
	for id,entry in self.projectiles do
		local p=entry.data
		local age=t-p.born
		if entry.missingSince and os.clock()-entry.missingSince&gt;.35 then
			self:finishProjectile(id)
			continue
		end
		local hidden=age&lt;0
		if hidden~=entry.hidden then
			entry.hidden=hidden
			for _,d in entry.model:GetDescendants() do if d:IsA("BasePart") then d.LocalTransparencyModifier=if hidden then 1 else 0 end end
		end
		local travel=math.clamp(age,0,p.range/p.speed)*p.speed
		local position=p.origin+p.direction*travel
		local look=CFrame.lookAt(position,position+p.direction)
		local cf
		if p.kind=="kunai" or p.kind=="marked" then
			-- Point first, with a slow roll so the blade catches the light.
			entry.spin+=dt*14
			cf=look*CFrame.Angles(0,0,entry.spin)
		elseif p.kind=="shuriken" or p.kind=="wire" then
			entry.spin+=dt*42
			cf=look*CFrame.Angles(0,entry.spin,0)*CFrame.Angles(0,0,math.rad(8))
		elseif p.kind=="fireball" or p.kind=="phoenix" then
			local radius=(p.radius or 2.4)+(p.growth or 0)*math.max(0,age)
			local wobble=1+math.sin(os.clock()*31)*.05
			entry.root.Size=Vector3.one*radius*1.15*wobble
			local mid=entry.model:FindFirstChild("Mid");local outer=entry.model:FindFirstChild("Outer")
			if mid then mid.Size=Vector3.one*radius*1.7 end
			if outer then outer.Size=Vector3.one*radius*2.25*wobble end
			local flames=entry.root:FindFirstChildOfClass("Attachment")
			if flames then
				local f=flames:FindFirstChild("Flames");if f then f.Size=num({{0,radius*1.1},{.4,radius*1.9},{1,radius*.6}}) end
			end
			cf=look*CFrame.Angles(0,0,os.clock()*3)
		elseif p.kind=="palm" then
			local radius=(p.radius or 1.5)+(p.growth or 0)*math.max(0,age)
			local ring=entry.model:FindFirstChild("Ring");local core=entry.model:FindFirstChild("Core")
			if ring then ring.Size=Vector3.new(.3,radius*2.2,radius*2.2) end
			if core then core.Size=Vector3.new(.2,radius*1.2,radius*1.2) end
			cf=look
		else
			cf=look
		end
		entry.root.CFrame=cf
	end
end

-- ------------------------------------------------------------------ helpers
local function flash(parent,position,color,from,to,time,transparency)
	local ball=block(parent,Vector3.one*from,CFrame.new(position),color,Enum.Material.Neon)
	ball.Shape=Enum.PartType.Ball;ball.Transparency=transparency or .15
	tween(ball,time,{Size=Vector3.one*to,Transparency=1})
	Debris:AddItem(ball,time+.05)
	return ball
end
-- The floor under a point, ignoring bodies and effects: marks laid on the
-- ground (scorch, trigrams, burning lanes) must never land on a fighter.
local function floorUnder(fx,position,up,depth)
	local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
	local exclude={fx.folder}
	if fx.fighters then table.insert(exclude,fx.fighters) end
	params.FilterDescendantsInstances=exclude
	return workspace:Raycast(position+Vector3.new(0,up,0),Vector3.new(0,-depth,0),params)
end
local function shockRing(parent,position,color,from,to,time,normal)
	local up=normal or Vector3.yAxis
	local cf=CFrame.lookAt(position,position+up)*CFrame.Angles(0,math.pi/2,0)
	local ring=block(parent,Vector3.new(.12,from,from),cf,color,Enum.Material.Neon)
	ring.Shape=Enum.PartType.Cylinder;ring.Transparency=.3
	tween(ring,time,{Size=Vector3.new(.04,to,to),Transparency=1})
	Debris:AddItem(ring,time+.05)
end
local function burst(parent,position,props,count)
	local holder=anchorPart(parent,position);holder.Transparency=1
	local at=new("Attachment",{},holder)
	local e=emitter(at,props)
	e:Emit(count)
	Debris:AddItem(holder,3)
	return holder
end
local function smokePuff(parent,position,color,count,size)
	burst(parent,position,{Texture=TEX.smoke,Lifetime=NumberRange.new(.5,.9),Speed=NumberRange.new(4,9),SpreadAngle=Vector2.new(180,180),
		Color=ColorSequence.new(color or Color3.fromRGB(236,236,240)),LightEmission=0,Size=num({{0,size or 2.2},{1,(size or 2.2)*2.6}}),
		Transparency=num({{0,.15},{1,1}}),Drag=6,RotSpeed=NumberRange.new(-60,60),Rotation=NumberRange.new(0,360)},count or 18)
end
local function sparks(parent,position,color,count,speed)
	burst(parent,position,{Texture=TEX.spark,Lifetime=NumberRange.new(.15,.35),Speed=NumberRange.new(speed or 18,(speed or 18)*1.8),SpreadAngle=Vector2.new(180,180),
		Color=ColorSequence.new(color),LightEmission=1,Size=num({{0,.45},{1,0}}),Drag=5},count or 14)
end
-- A translucent copy of a fighter's current pose: afterimages for teleports,
-- dodges and substitutions.
function FX:ghost(model,color,time,transparency)
	if not model then return end
	local holder=new("Model",{Name="Afterimage"},self.folder)
	for _,d in model:GetChildren() do
		if d:IsA("BasePart") and d.Name~="HumanoidRootPart" and d.Transparency&lt;.9 then
			local g=block(holder,d.Size,d.CFrame,color,Enum.Material.Neon,if d:IsA("WedgePart") then "WedgePart" else "Part")
			if d:IsA("Part") then g.Shape=d.Shape end
			g.Transparency=transparency or .45
			tween(g,time,{Transparency=1,Size=d.Size*1.08})
		end
	end
	Debris:AddItem(holder,time+.1)
	return holder
end
local function crows(parent,position,count,spread)
	for i=1,count do
		local bird=new("Model",{Name="Crow"},parent)
		local body=block(bird,Vector3.new(.35,.3,.8),CFrame.new(position),Color3.fromRGB(14,14,18),Enum.Material.SmoothPlastic)
		local wingL=block(bird,Vector3.new(.9,.05,.4),CFrame.new(position),Color3.fromRGB(10,10,14),Enum.Material.SmoothPlastic,"WedgePart")
		local wingR=block(bird,Vector3.new(.9,.05,.4),CFrame.new(position),Color3.fromRGB(10,10,14),Enum.Material.SmoothPlastic,"WedgePart")
		local direction=Vector3.new(math.random()-.5,.35+math.random()*.6,math.random()-.5).Unit
		local distance=(spread or 9)*(0.6+math.random()*.7)
		local start=position+Vector3.new((math.random()-.5)*1.5,(math.random()-.5)*2,(math.random()-.5)*1.5)
		local finish=start+direction*distance
		local life=.55+math.random()*.35
		local t0=os.clock()
		task.spawn(function()
			while bird.Parent and os.clock()-t0&lt;life do
				local k=(os.clock()-t0)/life
				local at=start:Lerp(finish,1-(1-k)^2)
				local cf=CFrame.lookAt(at,at+direction)
				local flap=math.sin(os.clock()*34+i)*.9
				body.CFrame=cf
				wingL.CFrame=cf*CFrame.new(-.45,0,0)*CFrame.Angles(0,0,flap)
				wingR.CFrame=cf*CFrame.new(.45,0,0)*CFrame.Angles(0,0,-flap)
				local fade=math.clamp((k-.6)/.4,0,1)
				body.Transparency=fade;wingL.Transparency=fade;wingR.Transparency=fade
				task.wait()
			end
			bird:Destroy()
		end)
	end
	smokePuff(parent,position,Color3.fromRGB(40,36,44),10,1.6)
end
FX.crows=crows

-- ----------------------------------------------------------------- identity
-- Restrained per-fighter feedback for the identity rules (all server-driven):
-- Itachi's read (eye glint, the afterimage the swing bites) and genjutsu image,
-- Neji's closed chakra points, Minato's wind seal and Yellow Flash, Sasuke's
-- curse. Nothing here can change gameplay.
-- Where each chakra point Neji can close sits on the body (bone, offset from
-- its centre; -Z is the front). Ids: Brawler.TENKETSU_ORDER on the server.
local TENKETSU={
	throat={"Head",CFrame.new(0,-.5,-.42)},heart={"UpperTorso",CFrame.new(-.32,.22,-.52)},solar={"UpperTorso",CFrame.new(0,-.3,-.52)},
	navel={"LowerTorso",CFrame.new(0,.08,-.52)},leftShoulder={"LeftUpperArm",CFrame.new(0,.3,-.3)},rightShoulder={"RightUpperArm",CFrame.new(0,.3,-.3)},
	leftHip={"LowerTorso",CFrame.new(-.52,-.12,-.46)},rightHip={"LowerTorso",CFrame.new(.52,-.12,-.46)},
}
FX.TENKETSU=TENKETSU
local function find(folder,id) return folder and id and folder:FindFirstChild(id) end
function FX.tenketsuWorld(model,id)
	local spec=TENKETSU[id or ""]
	local part=spec and model and model:FindFirstChild(spec[1])
	if not part then return nil,nil end
	return (part.CFrame*spec[2]).Position,part
end
-- Two red points and a thin glint across the eyes: the Sharingan reading.
local function eyeGlint(parent,model)
	local head=model and model:FindFirstChild("Head")
	if not head then return end
	for _,x in {-.22,.22} do flash(parent,(head.CFrame*CFrame.new(x,.1,-.62)).Position,SHARINGAN,.12,.55,.22,0) end
	local streak=block(parent,Vector3.new(1,.05,.05),head.CFrame*CFrame.new(0,.1,-.64),SHARINGAN,Enum.Material.Neon)
	streak.Transparency=.1
	tween(streak,.26,{Size=Vector3.new(2.4,.02,.02),Transparency=1})
	Debris:AddItem(streak,.3)
	local light=new("PointLight",{Color=SHARINGAN,Brightness=4,Range=8,Shadows=false},head)
	tween(light,.3,{Brightness=0})
	Debris:AddItem(light,.35)
end
FX.eyeGlint=eyeGlint
-- Sharingan Read / Focus read: the eyes, the afterimage where he stood that
-- the swing bites, a dry cut. A whiff read is the eyes and a ring only.
function FX:readCue(impact,folder)
	local reader=find(folder,impact.owner)
	eyeGlint(self.folder,reader)
	local at=impact.position
	if impact.phase=="whiff" then
		local victim=find(folder,impact.victim)
		local root=victim and victim:FindFirstChild("HumanoidRootPart")
		if root then shockRing(self.folder,root.Position-Vector3.new(0,2.6,0),SHARINGAN,1,5,.25) end
		sound(anchorPart(self.folder,at),SOUND.whoosh,.22,2.6)
		return
	end
	if reader then
		local ghost=self:ghost(reader,SHARINGAN,.34,.35)
		local root=reader:FindFirstChild("HumanoidRootPart")
		if ghost and root then
			-- The body may already be drawn at its new spot: leave the copy where he stood.
			local shift=at-root.Position
			ghost:PivotTo(ghost:GetPivot()+Vector3.new(shift.X,0,shift.Z))
		end
	end
	flash(self.folder,at+Vector3.new(0,.5,0),Color3.fromRGB(255,240,236),.3,2.8,.14,.2)
	sparks(self.folder,at+Vector3.new(0,.5,0),Color3.fromRGB(255,220,220),8,16)
	sound(anchorPart(self.folder,at),SOUND.whoosh,.34,2.3)
	sound(anchorPart(self.folder,at),SOUND.hit,.18,.6)
	self:cheer(.6)
end
-- Genjutsu: Mirage. cast = a red ripple under the deceived body as the image
-- takes; catch = the image breaks where the swing bit it; touch/break = it
-- dissolves; seen = the Byakugan shrugs it off. A skill-build echo: red smoke.
function FX:mirageCue(impact,folder)
	local at=impact.position
	local caster=find(folder,impact.owner)
	local phase=impact.phase
	if phase=="cast" then
		local victim=find(folder,impact.victim)
		local root=victim and victim:FindFirstChild("HumanoidRootPart")
		if root then shockRing(self.folder,root.Position-Vector3.new(0,2.6,0),SHARINGAN,2,9,.45) end
		flash(self.folder,at,Color3.fromRGB(150,24,34),1,4,.3,.55)
		eyeGlint(self.folder,caster)
		sound(anchorPart(self.folder,at),SOUND.whoosh,.3,.55)
	elseif phase=="catch" then
		for _=1,12 do
			local dir=Vector3.new(math.random()-.5,math.random()*.8,math.random()-.5)
			dir=if dir.Magnitude&gt;.01 then dir.Unit else Vector3.yAxis
			local shard=block(self.folder,Vector3.new(.3,.5,.06),CFrame.lookAt(at,at+dir)*CFrame.new(0,(math.random()-.5)*3,0),SHARINGAN,Enum.Material.Neon)
			shard.Transparency=.25
			tween(shard,.4,{CFrame=shard.CFrame+dir*(2+math.random()*3),Transparency=1,Size=Vector3.new(.05,.2,.02)})
			Debris:AddItem(shard,.45)
		end
		flash(self.folder,at,SHARINGAN,1,6,.22,.15)
		smokePuff(self.folder,at,Color3.fromRGB(60,24,30),12,1.6)
		eyeGlint(self.folder,caster)
		sound(anchorPart(self.folder,at),SOUND.hit,.4,.7)
		self:cheer(.8)
	elseif phase=="seen" then
		local victim=find(folder,impact.victim)
		local head=victim and victim:FindFirstChild("Head")
		if head then flash(self.folder,head.Position,HYUGA,.4,2.4,.2,.2) end
	elseif phase=="touch" or phase=="break" then
		smokePuff(self.folder,at,Color3.fromRGB(70,40,46),6,1.2)
	else
		smokePuff(self.folder,at+Vector3.new(0,1,0),Color3.fromRGB(60,24,30),10,1.6)
		if impact.to then smokePuff(self.folder,impact.to+Vector3.new(0,1,0),Color3.fromRGB(60,24,30),6,1.2) end
	end
end
-- Gentle Fist: a pinpoint flash on the exact point that closed, a short chakra
-- pulse and a dry tick; a sealed network (every point) rings once, deeper.
function FX:tenketsuCue(impact,folder)
	local victim=find(folder,impact.victim)
	local at,part=FX.tenketsuWorld(victim,impact.point)
	at=at or impact.position
	local severe=impact.severe==true
	flash(self.folder,at,HYUGA,.12,if severe then 1.6 else 1.05,.14,0)
	shockRing(self.folder,at,HYUGA,.3,if severe then 4.6 else 3,.22,part and part.CFrame.LookVector or nil)
	sparks(self.folder,at,HYUGA,if severe then 10 else 5,8)
	sound(anchorPart(self.folder,at),SOUND.hit,.26,1.95)
	if severe then
		sound(anchorPart(self.folder,at),SOUND.heavy,.32,.6)
		local torso=victim and victim:FindFirstChild("UpperTorso")
		if torso then shockRing(self.folder,torso.Position,HYUGA,1,7,.4) end
	end
end
-- Wind Cut: a pale crescent where the cut throws the body aside; the wind seal
-- then rides on it (FX:seal draws it in the wind's colour).
function FX:windSealCue(impact)
	local at=impact.position
	local across=impact.direction or Vector3.xAxis
	local slash=block(self.folder,Vector3.new(.1,3.2,.25),CFrame.lookAt(at,at+across)*CFrame.Angles(0,0,math.rad(35)),WIND,Enum.Material.Neon)
	slash.Transparency=.2
	tween(slash,.22,{Size=Vector3.new(.04,4.2,.08),Transparency=1})
	Debris:AddItem(slash,.25)
	flash(self.folder,at,MINATO,.3,2,.16,.3)
	sound(anchorPart(self.folder,at),SOUND.whoosh,.34,1.9)
end
-- Curse Mark: the kick that does not let go flares purple on the body.
function FX:curseCue(impact)
	local at=impact.position
	flash(self.folder,at,CURSE,.4,3.2,.2,.2)
	sparks(self.folder,at,Color3.fromRGB(170,120,255),10,18)
	sound(anchorPart(self.folder,at),SOUND.heavy,.28,1.4)
end
-- The genjutsu image (Presentation:illusion): a frozen copy of `source` in its
-- current pose. "deceived": exactly the fighter, with a faint red outline that
-- pulses now and then (the tell); "caster": a red translucent afterimage, so
-- Itachi's player sees the trap he left. Its pivot is the copied root.
function FX:image(source,mode)
	if not source then return nil end
	local archivable=source.Archivable
	source.Archivable=true
	local ok,copy=pcall(function() return source:Clone() end)
	source.Archivable=archivable
	if not ok or not copy then return nil end
	copy.Name="GenjutsuImage"
	for _,d in copy:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored=true;d.CanCollide=false;d.CanQuery=false;d.CanTouch=false;d.CastShadow=false
			d.LocalTransparencyModifier=0
			if mode=="caster" and d.Transparency&lt;.95 then d.Color=SHARINGAN;d.Material=Enum.Material.SmoothPlastic;d.Transparency=math.max(d.Transparency,.62) end
		elseif d:IsA("Humanoid") or d:IsA("Sound") or d:IsA("Trail") or d:IsA("ParticleEmitter") or d:IsA("Light") or d:IsA("Beam") or d:IsA("BaseScript") or d:IsA("Highlight") then
			d:Destroy()
		end
	end
	if mode=="deceived" then
		new("Highlight",{Name="Tell",FillTransparency=1,OutlineColor=SHARINGAN,OutlineTransparency=1,DepthMode=Enum.HighlightDepthMode.Occluded},copy)
	end
	copy.Parent=self.folder
	return copy
end
-- Persistent identity cues, every frame (FX:fighter): Neji's closed points stay
-- lit on the body that carries them (pulsing fast once the network is sealed,
-- chakra leaking), Byakugan Full Field lays its field, a hungry Curse Mark
-- flickers.
function FX:identity(model,actor,aura)
	local root=model:FindFirstChild("HumanoidRootPart")
	local alive=(actor.health or 1)&gt;0
	local severe=actor.tenketsuSevere==true and alive
	aura.points=aura.points or {}
	local live={}
	for _,id in (if alive then actor.tenketsuPoints else nil) or {} do
		live[id]=true
		local entry=aura.points[id]
		if not entry or not entry.dot.Parent then
			local dot=block(self.folder,Vector3.one*.18,CFrame.new(),HYUGA,Enum.Material.Neon);dot.Shape=Enum.PartType.Ball
			entry={dot=dot,born=os.clock()};aura.points[id]=entry
		end
		local at=FX.tenketsuWorld(model,id)
		if at then entry.dot.CFrame=CFrame.new(at) end
		local pulse=.5+.5*math.sin((os.clock()-entry.born)*(if severe then 14 else 5))
		entry.dot.Transparency=(if severe then .05 else .3)+pulse*.35
		entry.dot.Size=Vector3.one*(if severe then .26 else .18)
	end
	for id,entry in aura.points do if not live[id] then entry.dot:Destroy();aura.points[id]=nil end end
	local torso=model:FindFirstChild("UpperTorso") or root
	if severe and not aura.leak and torso then
		local at=new("Attachment",{Name="ChakraLeak"},torso)
		aura.leak=new("ParticleEmitter",{Texture=TEX.glow,Rate=10,Lifetime=NumberRange.new(.4,.7),Speed=NumberRange.new(1,2.5),SpreadAngle=Vector2.new(180,180),
			Color=ColorSequence.new(HYUGA),LightEmission=.6,LightInfluence=0,Size=num({{0,.35},{1,0}}),Transparency=num({{0,.4},{1,1}})},at)
	elseif not severe and aura.leak then
		aura.leak.Enabled=false;Debris:AddItem(aura.leak.Parent,.8);aura.leak=nil
	end
	if actor.fighterId=="GentleFist" and root then
		local full=(actor.awaken or 0)&gt;0 and alive
		if full and (not aura.field or not aura.field.Parent) then
			local ring=block(self.folder,Vector3.new(.06,16,16),root.CFrame,HYUGA,Enum.Material.Neon);ring.Shape=Enum.PartType.Cylinder;ring.Transparency=.9
			aura.field=ring
		elseif not full and aura.field then
			tween(aura.field,.3,{Transparency=1});Debris:AddItem(aura.field,.35);aura.field=nil
		end
		if aura.field then aura.field.CFrame=CFrame.new(root.Position-Vector3.new(0,2.9,0))*CFrame.Angles(0,0,math.pi/2) end
	end
	if actor.fighterId=="Lion" and (actor.awaken or 0)&gt;0 and actor.curseHunger and alive then
		local on=math.sin(os.clock()*18)&gt;0
		for _,mark in aura.marks or {} do mark.Transparency=if on then .5 else 0 end
	end
end

-- ------------------------------------------------------------------ contacts
local function modelFor(folder,id)
	return folder and folder:FindFirstChild(id or "")
end
function FX:impact(impact,folder)
	local style=impact.style
	local position=impact.position
	if not position then return end
	if impact.projectile then
		local entry=self.projectiles[impact.projectile]
		local direction=impact.direction or (entry and entry.data.direction) or Vector3.zAxis
		if entry then self:finishProjectile(impact.projectile) end
		if style=="stick" and (impact.kind=="kunai" or impact.kind=="marked" or impact.kind=="shuriken") then
			self:stick(impact.kind,position,impact.normal or Vector3.yAxis,direction,impact.owner)
		end
	end
	if CHEER[style] then self:cheer(CHEER[style]) end
	if style=="fire" then
		self:explosion(position,impact.normal)
	elseif style=="teleport" then
		self:teleport(impact.from or position,impact.to or position,modelFor(folder,impact.owner),impact.awake)
	elseif style=="substitute" then
		self:substitute(position,impact.to,impact.fighter,modelFor(folder,impact.owner))
	elseif style=="mirage" then
		self:mirageCue(impact,folder)
	elseif style=="read" then
		self:readCue(impact,folder)
	elseif style=="tenketsu" then
		self:tenketsuCue(impact,folder)
	elseif style=="windseal" then
		self:windSealCue(impact)
	elseif style=="curse" then
		self:curseCue(impact)
	elseif style=="chase" then
		local model=modelFor(folder,impact.owner)
		-- Each prodigy's re-entry reads differently (server: MoveGraphs reengage):
		-- Minato a clean flash, Itachi a lingering copy, Neji a small chakra
		-- pulse, Sasuke an explosive kick-off. Unknown variants keep the plain look.
		local variant=impact.variant
		local tone=if impact.fighter=="Flashstep" then MINATO elseif impact.fighter=="GentleFist" then HYUGA elseif impact.fighter=="Lion" then LION else Color3.fromRGB(150,40,60)
		self:ghost(model,tone,if variant=="mirage" then .45 else .22,if variant=="mirage" then .4 else .55)
		if variant=="flash" then flash(self.folder,position,MINATO,1,4,.14,.3)
		elseif variant=="palm" then flash(self.folder,position,HYUGA,.5,3,.12,.25)
		elseif variant=="lion" then sparks(self.folder,position-Vector3.new(0,2.4,0),LION,10,18) end
		smokePuff(self.folder,position-Vector3.new(0,2.6,0),Color3.fromRGB(200,190,170),if variant=="lion" then 14 elseif variant=="flash" then 4 else 8,if variant=="lion" then 1.9 else 1.4)
		sound(anchorPart(self.folder,position),SOUND.whoosh,.35,if variant=="flash" then 1.15 elseif variant=="lion" then .7 else .8)
	elseif style=="dodge" then
		local nearest
		for _,name in self.fighterIds or {"PlayerFighter","AIFighter"} do
			local m=modelFor(folder,name);local r=m and m:FindFirstChild("HumanoidRootPart")
			if r and (r.Position-position).Magnitude&lt;4 then nearest=m end
		end
		if nearest then self:ghost(nearest,Color3.fromRGB(200,220,255),.2,.6) end
		smokePuff(self.folder,position-Vector3.new(0,2.6,0),Color3.fromRGB(196,186,166),6,1.2)
	elseif style=="quickstep" then
		local model=modelFor(folder,impact.owner)
		flash(self.folder,position,MINATO,1,4,.16,.3)
		if model then self:ghost(model,MINATO,.2,.5) end
	elseif style=="cast" then
		local model=modelFor(folder,impact.owner)
		local hands=model and model:FindFirstChild("RightHand")
		if hands then
			local color=if impact.technique=="FireBloom" or impact.technique=="PhoenixFlower" then Color3.fromRGB(255,120,50) elseif impact.technique=="MirageCast" or impact.technique=="Read" then Color3.fromRGB(220,30,40)
				elseif impact.technique=="WindCut" then Color3.fromRGB(170,255,220) else Color3.fromRGB(140,200,255)
			sparks(self.folder,hands.Position,color,10,8)
		end
	elseif style=="landing" then
		smokePuff(self.folder,position-Vector3.new(0,2.7,0),Color3.fromRGB(190,178,150),6,1.1)
		sound(anchorPart(self.folder,position),SOUND.land,.35,1.05)
	elseif style=="slam" then
		smokePuff(self.folder,position-Vector3.new(0,2.4,0),Color3.fromRGB(176,160,130),22,2.6)
		shockRing(self.folder,position-Vector3.new(0,2.6,0),Color3.fromRGB(255,214,160),3,22,.32)
	elseif style=="launcher" or style=="finisher" then
		shockRing(self.folder,position,Color3.fromRGB(255,236,200),2,9,.2,impact.direction)
	elseif style=="kunai" or style=="shuriken" then
		sparks(self.folder,position,Color3.fromRGB(255,236,200),10,20)
	elseif style=="parry" then
		sparks(self.folder,position,Color3.fromRGB(255,246,180),22,26)
		flash(self.folder,position,Color3.fromRGB(255,250,220),1,6,.14,.2)
	elseif style=="burst" then
		local model=modelFor(folder,impact.owner)
		if model then self:ghost(model,Color3.fromRGB(140,200,255),.25,.5) end
	elseif style=="clash" then
		-- Two strikes meeting: a hard white-gold flash and a ring across the line
		-- between the fighters, nothing else. It has to read instantly.
		local across=impact.direction or Vector3.zAxis
		sparks(self.folder,position,Color3.fromRGB(255,244,200),28,34)
		flash(self.folder,position,Color3.fromRGB(255,252,232),1,7,.16,.1)
		shockRing(self.folder,position,Color3.fromRGB(255,232,170),2,14,.26,across)
		sound(anchorPart(self.folder,position),SOUND.whoosh,.5,2.2)
	elseif style=="wall" or style=="wallbounce" then
		-- Impact on the wall: a ring flat on the surface, dust pushed out of it and
		-- a few chips of stone.
		local normal=impact.normal or Vector3.zAxis
		local big=style=="wallbounce"
		shockRing(self.folder,position+normal*.15,Color3.fromRGB(236,226,200),2,if big then 16 else 11,if big then .34 else .26,normal)
		smokePuff(self.folder,position+normal*.8,Color3.fromRGB(196,188,168),if big then 22 else 14,if big then 2.6 else 2)
		for k=1,(if big then 7 else 4) do
			local chip=block(self.folder,Vector3.new(.4,.3,.35),CFrame.new(position+normal*.5)*CFrame.Angles(math.random()*6,math.random()*6,0),Color3.fromRGB(186,178,160),Enum.Material.Concrete)
			local out=(normal+Vector3.new((math.random()-.5)*1.4,math.random()*.9,(math.random()-.5)*1.4)).Unit
			tween(chip,.45,{CFrame=chip.CFrame+out*(2.5+math.random()*3)+Vector3.new(0,-1.5,0),Transparency=1},Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
			Debris:AddItem(chip,.5)
		end
		if big then sparks(self.folder,position+normal,Color3.fromRGB(255,226,170),14,22) end
	elseif style=="walltech" then
		local model=modelFor(folder,impact.owner)
		if model then self:ghost(model,Color3.fromRGB(220,230,255),.2,.55) end
		local normal=impact.normal or Vector3.zAxis
		smokePuff(self.folder,position,Color3.fromRGB(226,222,210),12,1.8)
		shockRing(self.folder,position,Color3.fromRGB(220,232,255),1.5,8,.22,normal)
		sound(anchorPart(self.folder,position),SOUND.whoosh,.4,1.3)
	elseif style=="pin" then
		sparks(self.folder,position,Color3.fromRGB(255,236,200),8,16)
	elseif style=="flow" then
		-- On the beat: a crisp white-blue ring at the contact, nothing heavy.
		local count=impact.count or 1
		flash(self.folder,position,Color3.fromRGB(220,236,255),.6,3+math.min(count,4),.12,.15)
		shockRing(self.folder,position,Color3.fromRGB(200,226,255),1,6+math.min(count,4)*1.5,.18)
	elseif style=="awaken" then
		local model=modelFor(folder,impact.owner)
		local tone=if impact.fighter=="Flashstep" then MINATO elseif impact.fighter=="GentleFist" then HYUGA elseif impact.fighter=="Lion" then CURSE else Color3.fromRGB(230,40,50)
		if model then self:ghost(model,tone,.35,.4) end
		flash(self.folder,position,tone,2,14,.35,.2)
		shockRing(self.folder,position-Vector3.new(0,2.6,0),tone,3,24,.45)
		smokePuff(self.folder,position-Vector3.new(0,2.4,0),Color3.fromRGB(214,206,190),20,2.6)
		self:cheer(1)
	elseif style=="palmburst" then
		local along=impact.direction or Vector3.zAxis
		shockRing(self.folder,position,Color3.fromRGB(220,232,255),2,12,.24,along)
		smokePuff(self.folder,position,Color3.fromRGB(226,230,240),10,1.8)
	elseif style=="palm" then
		-- A Gentle Fist palm: a small, sharp chakra flash; no debris.
		flash(self.folder,position,HYUGA,.5,impact.heavy and 6 or 3,.12,.25)
		sparks(self.folder,position,HYUGA,impact.heavy and 16 or 6,impact.heavy and 22 or 12)
	elseif style=="deflect" then
		sparks(self.folder,position,Color3.fromRGB(230,240,255),12,24)
	elseif style=="repel" then
		shockRing(self.folder,position,HYUGA,3,16,.3,impact.direction)
		smokePuff(self.folder,position-Vector3.new(0,2.4,0),Color3.fromRGB(214,206,190),14,2)
	elseif style=="rotation" then
		shockRing(self.folder,position-Vector3.new(0,2.6,0),HYUGA,4,18,.5)
		smokePuff(self.folder,position-Vector3.new(0,2.6,0),Color3.fromRGB(214,206,190),18,2.4)
	elseif style=="trigram" then
		self:trigram(position)
	elseif style=="ember" then
		flash(self.folder,position,Color3.fromRGB(255,170,80),.8,4.5,.18,.2)
		sparks(self.folder,position,Color3.fromRGB(255,170,80),10,14)
	elseif style=="afterimage" then
		-- A lateral route: the body leaves a fading copy where it stood.
		local model=modelFor(folder,impact.owner)
		if model then self:ghost(model,if impact.fighter=="GentleFist" then HYUGA elseif impact.fighter=="Lion" then LION else Color3.fromRGB(150,40,60),.3,.45) end
		smokePuff(self.folder,position-Vector3.new(0,2.6,0),Color3.fromRGB(196,186,166),5,1)
	elseif style=="chidori" then
		flash(self.folder,position,Color3.fromRGB(170,200,255),1,6,.18,.25)
		sparks(self.folder,position,Color3.fromRGB(200,225,255),24,30)
	elseif style=="groundbounce" then
		-- A spiked body hits the floor and pops back up: dust ring and cracks.
		smokePuff(self.folder,position,Color3.fromRGB(176,160,130),16,2.2)
		shockRing(self.folder,position+Vector3.new(0,.1,0),Color3.fromRGB(255,226,180),2,13,.26)
		sound(anchorPart(self.folder,position),SOUND.land,.6,.7)
	end
end
-- Eight trigrams drawn on the ground around Neji for the sixty-four palms.
function FX:trigram(position)
	local floor=floorUnder(self,position,2,10)
	local at=if floor then floor.Position+Vector3.new(0,.05,0) else position-Vector3.new(0,2.9,0)
	local glyph=new("Model",{Name="Trigrams"},self.folder)
	local base=CFrame.new(at)*CFrame.Angles(0,0,math.pi/2)
	local disc=block(glyph,Vector3.new(.04,15,15),base,HYUGA,Enum.Material.SmoothPlastic);disc.Shape=Enum.PartType.Cylinder;disc.Transparency=.9
	local inner=block(glyph,Vector3.new(.05,3.4,3.4),base,Color3.fromRGB(236,240,255),Enum.Material.Neon);inner.Shape=Enum.PartType.Cylinder;inner.Transparency=.5
	for k=0,7 do
		local a=k/8*math.pi*2
		for line=0,2 do
			local broken=(k+line)%3==0
			local radius=5+line*.55
			local cf=CFrame.new(at+Vector3.new(math.sin(a)*radius,.02,math.cos(a)*radius))*CFrame.Angles(0,a,0)
			if broken then
				for _,side in {-1,1} do block(glyph,Vector3.new(.55,.05,.16),cf*CFrame.new(side*.42,0,0),HYUGA,Enum.Material.Neon) end
			else
				block(glyph,Vector3.new(1.4,.05,.16),cf,HYUGA,Enum.Material.Neon)
			end
		end
	end
	for _,d in glyph:GetDescendants() do if d:IsA("BasePart") then d.Transparency=math.max(d.Transparency,.35) end end
	flash(self.folder,at+Vector3.new(0,1,0),HYUGA,1,8,.25,.4)
	task.delay(1.6,function()
		for _,d in glyph:GetDescendants() do if d:IsA("BasePart") then tween(d,.4,{Transparency=1}) end end
	end)
	Debris:AddItem(glyph,2.1)
end
-- A thrown blade that missed stays embedded where it landed for a moment.
function FX:stick(kind,position,normal,direction,owner)
	if kind=="marked" then return end -- the seal renderer owns planted marked kunai
	local model=if kind=="shuriken" then FX.buildShuriken() else FX.buildKunai(false)
	model.Parent=self.folder
	local into=direction.Unit
	if into:Dot(normal)&gt;-.2 then into=(into-normal*1.2).Unit end
	local depth=if kind=="shuriken" then .25 else .45
	local cf=CFrame.lookAt(position-into*depth,position-into*depth+into)
	if kind=="shuriken" then cf=cf*CFrame.Angles(math.rad(80),0,0) end
	model:PivotTo(cf)
	sparks(self.folder,position,Color3.fromRGB(255,226,170),6,12)
	task.delay(2.6,function()
		for _,d in model:GetDescendants() do if d:IsA("BasePart") then tween(d,.4,{Transparency=1}) end end
		Debris:AddItem(model,.5)
	end)
end
function FX:explosion(position,normal)
	local holder=anchorPart(self.folder,position);holder.Transparency=1
	sound(holder,SOUND.boom,.75,.95)
	flash(self.folder,position,Color3.fromRGB(255,236,170),3,15,.35,.05)
	flash(self.folder,position,Color3.fromRGB(255,120,40),5,19,.5,.35)
	shockRing(self.folder,position,Color3.fromRGB(255,170,90),4,26,.38,normal)
	burst(self.folder,position,{Texture=TEX.fire,Lifetime=NumberRange.new(.45,.9),Speed=NumberRange.new(14,30),SpreadAngle=Vector2.new(180,180),
		Color=seq({{0,Color3.fromRGB(255,240,170)},{.4,Color3.fromRGB(255,130,40)},{1,Color3.fromRGB(80,24,10)}}),LightEmission=1,
		Size=num({{0,4},{.5,7},{1,2}}),Transparency=num({{0,.1},{1,1}}),Drag=4,RotSpeed=NumberRange.new(-90,90),Rotation=NumberRange.new(0,360)},34)
	burst(self.folder,position,{Texture=TEX.smoke,Lifetime=NumberRange.new(1.2,2.2),Speed=NumberRange.new(6,14),SpreadAngle=Vector2.new(180,180),
		Color=ColorSequence.new(Color3.fromRGB(56,48,46)),LightEmission=0,Size=num({{0,5},{1,14}}),Transparency=num({{0,.35},{1,1}}),Drag=3,Acceleration=Vector3.new(0,5,0)},18)
	burst(self.folder,position,{Texture=TEX.fireSpark,Lifetime=NumberRange.new(.6,1.2),Speed=NumberRange.new(20,44),SpreadAngle=Vector2.new(180,180),
		Color=ColorSequence.new(Color3.fromRGB(255,196,110)),LightEmission=1,Size=num({{0,.5},{1,0}}),Drag=2,Acceleration=Vector3.new(0,-30,0)},40)
	local light=new("PointLight",{Color=Color3.fromRGB(255,150,70),Brightness=9,Range=40,Shadows=false},holder)
	tween(light,.7,{Brightness=0})
	-- Scorched ground under the blast.
	local floor=floorUnder(self,position,2,12)
	if floor then
		local scorch=block(self.folder,Vector3.new(.05,9,9),CFrame.new(floor.Position+floor.Normal*.04)*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(24,18,16),Enum.Material.Slate)
		scorch.Shape=Enum.PartType.Cylinder;scorch.Transparency=.25
		task.delay(3.5,function() tween(scorch,1.5,{Transparency=1}) end)
		Debris:AddItem(scorch,5.2)
	end
end
function FX:teleport(from,to,model,awake)
	-- Yellow flash: a body-shaped afterimage where he stood, a single bright
	-- streak along the path, and a flash + shockwave where he reappears.
	if model then self:ghost(model,MINATO,.28,.25) end
	flash(self.folder,from,MINATO_CORE,1.5,7,.2,.05)
	local delta=to-from
	if delta.Magnitude&gt;1 then
		local streak=block(self.folder,Vector3.new(.35,.35,delta.Magnitude),CFrame.lookAt(from:Lerp(to,.5),to),MINATO,Enum.Material.Neon)
		streak.Transparency=.15
		tween(streak,.16,{Size=Vector3.new(.02,.02,delta.Magnitude),Transparency=1})
		Debris:AddItem(streak,.2)
	end
	flash(self.folder,to,MINATO_CORE,2,9,.22,0)
	flash(self.folder,to,MINATO,4,12,.32,.4)
	shockRing(self.folder,to-Vector3.new(0,2.6,0),MINATO,2,16,.3)
	sparks(self.folder,to,MINATO,18,24)
	if awake then
		-- Yellow Flash: a second, wider ring at the arrival and a flash left at
		-- the departure (the seal he leaves there): the chain has a rhythm.
		shockRing(self.folder,to-Vector3.new(0,2.6,0),MINATO_CORE,3,22,.4)
		flash(self.folder,from,MINATO,1,5,.3,.3)
	end
	local holder=anchorPart(self.folder,to);holder.Transparency=1
	sound(holder,SOUND.whoosh,.55,1.6)
	local light=new("PointLight",{Color=MINATO,Brightness=8,Range=24,Shadows=false},holder)
	tween(light,.35,{Brightness=0})
	Debris:AddItem(holder,1)
end
function FX:substitute(position,to,fighter,model)
	if model then self:ghost(model,Color3.fromRGB(220,220,230),.18,.5) end
	smokePuff(self.folder,position,Color3.fromRGB(240,240,244),22,2.4)
	if fighter=="Mirage" then
		crows(self.folder,position,10,11)
	else
		-- The classic: a wooden log takes the hit in his place.
		local log=block(self.folder,Vector3.new(4.2,1.3,1.3),CFrame.new(position)*CFrame.Angles(0,math.random()*math.pi,math.rad(70)),Color3.fromRGB(122,84,52),Enum.Material.Wood)
		log.Shape=Enum.PartType.Cylinder;log.Anchored=false;log.CanCollide=true;log.Massless=false
		log.AssemblyLinearVelocity=Vector3.new(0,6,0)
		task.delay(1.6,function() if log.Parent then tween(log,.4,{Transparency=1}) end end)
		Debris:AddItem(log,2.1)
	end
	if to then smokePuff(self.folder,to,Color3.fromRGB(236,236,240),8,1.4) end
	sound(anchorPart(self.folder,position),SOUND.whoosh,.4,.9)
end

-- ------------------------------------------------------------------ persistent
-- Planted Flying Thunder God seals: a real three-pronged kunai in the surface
-- and a slowly pulsing seal formula around it.
function FX:seal(owner,actor,folder)
	local live={}
	for _,info in (actor and actor.seals) or {} do
		local key=tostring(owner)..":"..tostring(info.id)
		live[key]=true
		local entry=self.seals[key]
		if info.body then
			-- A seal riding on the opponent: a small glowing formula on the back.
			local model=folder and folder:FindFirstChild(info.body)
			local torso=model and (model:FindFirstChild("UpperTorso") or model:FindFirstChild("HumanoidRootPart"))
			if torso then
				if not entry then
					local glyph=new("Model",{Name="Body seal"},self.folder)
					local tone=if info.wind then WIND else MINATO
					local disc=block(glyph,Vector3.new(.03,1.5,1.5),torso.CFrame,tone,Enum.Material.Neon);disc.Shape=Enum.PartType.Cylinder;disc.Transparency=.35
					local marks={}
					for i=0,5 do table.insert(marks,block(glyph,Vector3.new(.04,.08,.36),torso.CFrame,tone,Enum.Material.Neon)) end
					local light=new("PointLight",{Color=tone,Brightness=2,Range=7,Shadows=false},disc)
					entry={glyph=glyph,disc=disc,marks=marks,light=light,body=true,born=os.clock()}
					self.seals[key]=entry
					flash(self.folder,torso.Position,tone,.6,4,.2,.2)
				end
				local back=torso.CFrame*CFrame.new(0,.1,.62)
				local base=CFrame.lookAt(back.Position,back.Position+torso.CFrame.LookVector*-1)*CFrame.Angles(0,math.pi/2,0)
				entry.disc.CFrame=base
				for i,mark in entry.marks do
					mark.CFrame=base*CFrame.Angles((i-1)/6*math.pi*2+os.clock()*2,0,0)*CFrame.new(0,.5,0)
				end
				local pulse=.5+.5*math.sin((os.clock()-entry.born)*7)
				entry.disc.Transparency=.25+pulse*.3
				entry.light.Brightness=1.5+pulse*1.5
			end
		elseif info.surface then
			local surface=info.surface
			local normal=info.normal or Vector3.yAxis
			if not entry then
				local model=FX.buildKunai(true)
				model.Parent=self.folder
				local into=-normal
				local tilt=(if math.abs(normal.Y)&gt;.7 then Vector3.xAxis else Vector3.yAxis)*.35
				local axis=(into+tilt).Unit
				model:PivotTo(CFrame.lookAt(surface-axis*.55,surface-axis*.55+axis))
				local glyph=new("Model",{Name="Seal"},self.folder)
				local base=CFrame.lookAt(surface+normal*.03,surface+normal*1.03)*CFrame.Angles(0,math.pi/2,0)
				local disc=block(glyph,Vector3.new(.03,3.2,3.2),base,MINATO,Enum.Material.Neon);disc.Shape=Enum.PartType.Cylinder;disc.Transparency=.8
				for i=0,5 do
					local a=i/6*math.pi*2
					local mark=block(glyph,Vector3.new(.04,.12,.7),base*CFrame.Angles(a,0,0)*CFrame.new(0,1.1,0),MINATO,Enum.Material.Neon)
					mark.Transparency=.35
				end
				local light=new("PointLight",{Color=MINATO,Brightness=1.5,Range=9,Shadows=false},disc)
				entry={model=model,glyph=glyph,disc=disc,light=light,surface=surface,born=os.clock()}
				self.seals[key]=entry
				flash(self.folder,surface,MINATO,.6,3.5,.2,.2)
			end
			local pulse=.5+.5*math.sin((os.clock()-entry.born)*4)
			-- The last seconds of a seal flicker so its expiry is readable.
			local fading=(info.remaining or 12)&lt;2 and math.sin(os.clock()*30)&gt;0
			entry.disc.Transparency=if fading then .95 else .72+pulse*.18
			entry.light.Brightness=if fading then .3 else 1+pulse*1.2
		end
	end
	for key,entry in self.seals do
		if string.sub(key,1,#tostring(owner)+1)==tostring(owner)..":" and not live[key] then
			if entry.model then
				for _,d in entry.model:GetDescendants() do if d:IsA("BasePart") then tween(d,.15,{Transparency=1}) end end
				Debris:AddItem(entry.model,.2)
			end
			Debris:AddItem(entry.glyph,.2)
			self.seals[key]=nil
		end
	end
end
-- Built-in Roblox sounds (shipped with every client, Mac and PC).
function FX:jumpSound(position) sound(anchorPart(self.folder,position),SOUND.jump,.28,1.1) end
function FX:getUpSound(position) sound(anchorPart(self.folder,position),SOUND.getUp,.25,1.15) end
function FX:hazardsStep(data)
	local live={}
	for _,h in data.hazards or {} do
		local key=string.format("%s:%.1f:%.1f:%.1f",tostring(h.kind),h.position.X,h.position.Y,h.position.Z)
		live[key]=true
		local entry=self.hazards[key]
		if not entry then
			local floor=floorUnder(self,h.position,3,14)
			local at=if floor then floor.Position else h.position
			local holder=anchorPart(self.folder,at);holder.Transparency=1;holder.Size=Vector3.new(h.radius*1.6,.2,h.radius*1.6)
			local e=new("ParticleEmitter",{Texture=TEX.fire,Rate=60,Lifetime=NumberRange.new(.4,.8),Speed=NumberRange.new(3,7),
				SpreadAngle=Vector2.new(12,12),EmissionDirection=Enum.NormalId.Top,Shape=Enum.ParticleEmitterShape.Box,
				Color=seq({{0,Color3.fromRGB(255,220,140)},{.5,Color3.fromRGB(255,110,40)},{1,Color3.fromRGB(90,30,12)}}),LightEmission=1,LightInfluence=0,
				Size=num({{0,1.4},{.4,2.4},{1,.4}}),Transparency=num({{0,.2},{1,1}}),RotSpeed=NumberRange.new(-80,80),Rotation=NumberRange.new(0,360)},holder)
			local light=new("PointLight",{Color=Color3.fromRGB(255,130,60),Brightness=3,Range=h.radius*3,Shadows=false},holder)
			entry={holder=holder,emitter=e,light=light}
			self.hazards[key]=entry
		end
		entry.light.Brightness=2.4+math.sin(os.clock()*22)*.6+math.sin(os.clock()*9)*.5
		entry.emitter.Rate=if h.remaining&lt;.4 then 25 else 60
	end
	for key,entry in self.hazards do
		if not live[key] then
			entry.emitter.Enabled=false;tween(entry.light,.3,{Brightness=0})
			Debris:AddItem(entry.holder,1);self.hazards[key]=nil
		end
	end
end
-- Battle wear: as health drops (75 / 50 / 25 %), dirt, scuffs, small grazes
-- and darkened cloth accumulate on the body. Feedback, not gore.
local WEAR={
	-- {body part, size, offset, kind}
	{ {"UpperTorso",Vector3.new(.7,.5,.05),CFrame.new(.35,-.2,-.53),"dirt"},{"RightUpperLeg",Vector3.new(.5,.6,.05),CFrame.new(0,-.1,-.5),"dirt"},{"LeftLowerArm",Vector3.new(.45,.4,.05),CFrame.new(0,0,-.43),"dirt"} },
	{ {"UpperTorso",Vector3.new(.55,.35,.05),CFrame.new(-.4,.35,.53),"dirt"},{"LeftUpperLeg",Vector3.new(.55,.45,.05),CFrame.new(.1,.2,-.5),"tear"},{"Head",Vector3.new(.18,.06,.03),CFrame.new(.42,-.18,-.78),"graze"},{"RightUpperArm",Vector3.new(.5,.12,.05),CFrame.new(0,-.35,-.45),"tear"} },
	{ {"LowerTorso",Vector3.new(.8,.3,.05),CFrame.new(-.2,0,-.53),"dirt"},{"RightLowerArm",Vector3.new(.2,.08,.03),CFrame.new(.05,.1,-.44),"graze"},{"LeftLowerLeg",Vector3.new(.5,.5,.05),CFrame.new(0,.2,-.45),"dirt"},{"UpperTorso",Vector3.new(.3,.5,.05),CFrame.new(.1,.1,-.535),"tear"} },
}
local WEAR_LOOK={dirt={Color3.fromRGB(96,78,58),.35},tear={Color3.fromRGB(40,34,32),.25},graze={Color3.fromRGB(150,46,40),.2}}
function FX:wear(model,actor,aura)
	local ratio=(actor.health or 1)/math.max(1,actor.maxHealth or 1)
	local level=if ratio&lt;=.25 then 3 elseif ratio&lt;=.5 then 2 elseif ratio&lt;=.75 then 1 else 0
	aura.wear=aura.wear or 0
	-- A new round restores health on the same bodies: the wear starts over
	-- instead of opening round two fully worn (and unable to build again).
	if aura.wear&gt;0 and level==0 and ratio&gt;=.99 then
		for _,p in model:GetDescendants() do if p.Name=="BattleWear" then p:Destroy() end end
		for part,color in aura.cloth or {} do if part.Parent then part.Color=color end end
		aura.cloth=nil;aura.wear=0
	end
	while aura.wear&lt;level do
		aura.wear+=1
		for _,spec in WEAR[aura.wear] do
			local body=model:FindFirstChild(spec[1])
			if body and body:IsA("BasePart") then
				local look=WEAR_LOOK[spec[4]]
				local mark=block(model,spec[2],body.CFrame*spec[3],look[1],Enum.Material.SmoothPlastic)
				mark.Name="BattleWear";mark.Anchored=false;mark.Massless=true;mark.Transparency=look[2];mark.CastShadow=false
				new("WeldConstraint",{Part0=body,Part1=mark},mark)
			end
		end
		if aura.wear==3 then
			-- Low health: cloth looks dusty and darker.
			for _,p in model:GetChildren() do
				if p:IsA("BasePart") and p.Name~="HumanoidRootPart" and p.Name~="BattleWear" and p.Transparency&lt;1 and p.Material~=Enum.Material.Neon then
					aura.cloth=aura.cloth or {};aura.cloth[p]=aura.cloth[p] or p.Color
					p.Color=p.Color:Lerp(Color3.fromRGB(110,92,74),.14)
				end
			end
		end
	end
end
-- Per-fighter identity layer: Minato's speed trail and Rasengan, Itachi's
-- Sharingan glow and fire breath. Restrained: it switches on only for the
-- moments it describes.
function FX:fighter(model,actor,dt)
	if not model or not actor then return end
	local aura=self.auras[model]
	local root=model:FindFirstChild("HumanoidRootPart")
	if not root then return end
	if not aura then
		aura={}
		self.auras[model]=aura
		local minato=actor.fighterId=="Flashstep"
		local color=if minato then MINATO elseif actor.fighterId=="GentleFist" then HYUGA elseif actor.fighterId=="Lion" then LION else Color3.fromRGB(170,30,48)
		local veins={}
		for _,p in model:GetChildren() do if p.Name=="ByakuganVein" then table.insert(veins,p) end end
		aura.veins=veins
		aura.trail=addTrail(root,Vector3.new(0,1.6,.3),Vector3.new(0,-1.9,.3),color,if minato then .16 else .12,.62,1)
		aura.trail.Enabled=false
		local irises={}
		for _,p in model:GetChildren() do if p.Name=="Iris" then table.insert(irises,p) end end
		aura.irises=irises
		local head=model:FindFirstChild("Head")
		local marks={}
		for _,p in model:GetChildren() do if p.Name=="CurseMark" then table.insert(marks,p) end end
		aura.marks=marks
		if head and (actor.fighterId=="Mirage" or actor.fighterId=="Lion") then
			aura.eyeLight=new("PointLight",{Color=Color3.fromRGB(255,40,40),Brightness=0,Range=5,Shadows=false},head)
		end
	end
	self:wear(model,actor,aura)
	local speed=actor.speed or 0
	local fast=actor.state=="Dodging" or actor.state=="Pursuit" or actor.state=="Rush" or (actor.awaken or 0)&gt;0 or actor.flash or (actor.fighterId=="Flashstep" and speed&gt;34)
	aura.trail.Enabled=fast==true and (actor.health or 1)&gt;0
	-- Itachi's Sharingan is always awake; it flares while he reads, casts,
	-- counters, or during the intro.
	if (actor.fighterId=="Mirage" or actor.fighterId=="Lion") and aura.irises then
		local lit=(actor.read or 0)&gt;0 or (actor.counter or 0)&gt;0 or actor.castId=="MirageCast" or actor.castId=="Read" or actor.castId=="FireBloom"
			or actor.castId=="PhoenixFlower" or actor.castId=="Chidori" or (actor.intro or 0)&gt;0 or (actor.awaken or 0)&gt;0
		for _,iris in aura.irises do
			iris.Material=Enum.Material.Neon
			iris.Color=if lit then Color3.fromRGB(255,36,36) else Color3.fromRGB(205,18,28)
		end
		if aura.eyeLight then aura.eyeLight.Brightness=if lit then 2.2 else .5 end
	end
	-- Awakening: a chakra mantle that rises off the body for the whole state.
	local awake=(actor.awaken or 0)&gt;0 and (actor.health or 1)&gt;0
	if awake and not aura.mantle then
		local torso=model:FindFirstChild("UpperTorso") or root
		local tone=if actor.fighterId=="Flashstep" then MINATO elseif actor.fighterId=="GentleFist" then HYUGA elseif actor.fighterId=="Lion" then CURSE else Color3.fromRGB(230,40,50)
		local at=new("Attachment",{Name="AwakenMantle"},torso)
		local e=new("ParticleEmitter",{Texture=TEX.fire,Rate=55,Lifetime=NumberRange.new(.35,.6),Speed=NumberRange.new(2,5),SpreadAngle=Vector2.new(30,30),
			EmissionDirection=Enum.NormalId.Top,Shape=Enum.ParticleEmitterShape.Box,Color=ColorSequence.new(tone),LightEmission=1,LightInfluence=0,
			Size=num({{0,1.6},{.5,1.2},{1,0}}),Transparency=num({{0,.45},{1,1}}),Acceleration=Vector3.new(0,6,0)},at)
		local light=new("PointLight",{Color=tone,Brightness=2.5,Range=12,Shadows=false},at)
		aura.mantle={attachment=at,emitter=e,light=light}
	elseif not awake and aura.mantle then
		aura.mantle.emitter.Enabled=false
		Debris:AddItem(aura.mantle.attachment,1)
		aura.mantle=nil
	end
	for _,mark in aura.marks or {} do mark.Transparency=if awake then 0 else 1 end
	-- Bound: wire coiled around the chest and arms while the bind holds.
	local bound=actor.bound==true and (actor.health or 1)&gt;0
	if bound and not aura.binding then
		local torso=model:FindFirstChild("UpperTorso") or root
		local holder=new("Model",{Name="Binding"},self.folder)
		local coils={}
		for k=0,2 do
			local coil=block(holder,Vector3.new(.08,2.9,2.9),torso.CFrame*CFrame.new(0,-.5+k*.45,0)*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(196,200,208),Enum.Material.Metal)
			coil.Shape=Enum.PartType.Cylinder;coil.Transparency=.15
			table.insert(coils,{part=coil,offset=CFrame.new(0,-.5+k*.45,0)*CFrame.Angles(0,0,math.pi/2)})
		end
		aura.binding={holder=holder,coils=coils,torso=torso}
		sound(torso,SOUND.whoosh,.4,2)
	elseif not bound and aura.binding then
		aura.binding.holder:Destroy()
		aura.binding=nil
	end
	if aura.binding then
		for _,c in aura.binding.coils do c.part.CFrame=aura.binding.torso.CFrame*c.offset end
	end
	-- Sasuke: the Chidori crackles in the right hand from the charge to the thrust.
	local chidori=(actor.castId=="Chidori" and (actor.state=="TechniqueChannel" or actor.state=="TechniqueActive"))
		or (actor.attackName=="ChidoriThrust" and (actor.state=="Startup" or actor.state=="Active"))
	if chidori and not aura.chidori and (actor.health or 1)&gt;0 then
		local hand=model:FindFirstChild("RightHand") or root
		local at=new("Attachment",{Name="Chidori"},hand)
		local e=new("ParticleEmitter",{Texture=TEX.spark,Rate=220,Lifetime=NumberRange.new(.05,.14),Speed=NumberRange.new(6,16),SpreadAngle=Vector2.new(180,180),
			Color=ColorSequence.new(Color3.fromRGB(190,220,255)),LightEmission=1,LightInfluence=0,Size=num({{0,1.1},{1,0}}),Transparency=num({{0,0},{1,1}}),
			Rotation=NumberRange.new(0,360),RotSpeed=NumberRange.new(-400,400)},at)
		local core=new("ParticleEmitter",{Texture=TEX.glow,Rate=40,Lifetime=NumberRange.new(.08,.12),Speed=NumberRange.new(0,0),
			Color=ColorSequence.new(Color3.fromRGB(220,236,255)),LightEmission=1,LightInfluence=0,Size=num({{0,1.4},{1,1.0}}),Transparency=num({{0,.2},{1,1}})},at)
		local light=new("PointLight",{Color=Color3.fromRGB(150,190,255),Brightness=1.6,Range=8,Shadows=false},at)
		aura.chidori={attachment=at,emitter=e,core=core,light=light}
		sound(hand,SOUND.whoosh,.5,2.6)
	elseif not chidori and aura.chidori then
		aura.chidori.emitter.Enabled=false;aura.chidori.core.Enabled=false
		Debris:AddItem(aura.chidori.attachment,.4)
		aura.chidori=nil
	end
	if aura.chidori then aura.chidori.light.Brightness=1.2+math.random()*1.4 end
	-- Neji: the Byakugan veins stand out while it is focused; the Rotation dome.
	if actor.fighterId=="GentleFist" then
		local focused=(actor.intro or 0)&gt;0 or actor.castId~=nil or (actor.counter or 0)&gt;0 or actor.rotation==true or (actor.awaken or 0)&gt;0
		for _,vein in aura.veins or {} do vein.Transparency=if focused then 0 else 1 end
		local dome=aura.dome
		if actor.rotation and not dome then
			local holder=new("Model",{Name="Rotation"},self.folder)
			local shell=block(holder,Vector3.one*12,root.CFrame,Color3.fromRGB(200,220,255),Enum.Material.Glass);shell.Shape=Enum.PartType.Ball;shell.Transparency=.86
			local inner=block(holder,Vector3.one*9,root.CFrame,Color3.fromRGB(236,244,255),Enum.Material.ForceField);inner.Shape=Enum.PartType.Ball;inner.Transparency=.55
			local bands={}
			for k=1,3 do
				local band=block(holder,Vector3.new(.12,12.4,12.4),root.CFrame,HYUGA,Enum.Material.Neon);band.Shape=Enum.PartType.Cylinder;band.Transparency=.7
				table.insert(bands,band)
			end
			local light=new("PointLight",{Color=HYUGA,Brightness=4,Range=18,Shadows=false},shell)
			dome={holder=holder,shell=shell,inner=inner,bands=bands,light=light,born=os.clock()}
			aura.dome=dome
			sound(shell,SOUND.whoosh,.5,.45)
		end
		if dome then
			if actor.rotation then
				local grow=math.clamp((os.clock()-dome.born)/.12,.3,1)
				local center=root.CFrame*CFrame.new(0,-.6,0)
				dome.shell.CFrame=center;dome.shell.Size=Vector3.one*12*grow
				dome.inner.CFrame=center*CFrame.Angles(0,os.clock()*20,0);dome.inner.Size=Vector3.one*9*grow
				for k,band in dome.bands do
					band.CFrame=center*CFrame.Angles(0,os.clock()*(18+k*4),0)*CFrame.Angles(0,0,math.rad(60*k))
					band.Size=Vector3.new(.12,12.4*grow,12.4*grow)
				end
			else
				aura.dome=nil
				for _,d in dome.holder:GetDescendants() do if d:IsA("BasePart") then tween(d,.18,{Transparency=1,Size=d.Size*1.15}) end end
				Debris:AddItem(dome.holder,.25)
			end
		end
	end
	-- Rasengan forms in the right hand during the channel and stays through the strike.
	local rasengan=(actor.castId=="BurstStrike" and (actor.state=="TechniqueChannel" or actor.state=="TechniqueActive"))
		or ((actor.attackVariant=="Rasengan" or actor.attackVariant=="RasenganDrop") and (actor.state=="Startup" or actor.state=="Active"))
	local orb=self.rasengan[model]
	local hand=model:FindFirstChild("RightHand")
	if rasengan and hand then
		if not orb then
			local holder=new("Model",{Name="Rasengan"},self.folder)
			local core=block(holder,Vector3.one*.6,hand.CFrame,Color3.fromRGB(235,250,255),Enum.Material.Neon);core.Shape=Enum.PartType.Ball
			local shell=block(holder,Vector3.one*1.5,hand.CFrame,Color3.fromRGB(110,190,255),Enum.Material.Neon);shell.Shape=Enum.PartType.Ball;shell.Transparency=.45
			local bands={}
			for i=1,3 do
				local band=block(holder,Vector3.new(.06,1.7,1.7),hand.CFrame,Color3.fromRGB(190,230,255),Enum.Material.Neon)
				band.Shape=Enum.PartType.Cylinder;band.Transparency=.55;table.insert(bands,band)
			end
			local at=new("Attachment",{},core)
			local e=new("ParticleEmitter",{Texture=TEX.vortex,Rate=40,Lifetime=NumberRange.new(.15,.3),Speed=NumberRange.new(0,1),
				Color=ColorSequence.new(Color3.fromRGB(150,210,255)),LightEmission=1,LightInfluence=0,Size=num({{0,1.6},{1,.4}}),
				Transparency=num({{0,.3},{1,1}}),RotSpeed=NumberRange.new(400,700),Rotation=NumberRange.new(0,360),LockedToPart=true},at)
			new("PointLight",{Color=Color3.fromRGB(120,190,255),Brightness=3,Range=12,Shadows=false},core)
			orb={holder=holder,core=core,shell=shell,bands=bands,emitter=e,born=os.clock()}
			self.rasengan[model]=orb
			sound(core,SOUND.whoosh,.3,.5)
		end
		local grow=math.clamp((os.clock()-orb.born)/.25,.2,1)
		local center=hand.CFrame*CFrame.new(0,-.75,-.35)
		orb.core.CFrame=center;orb.core.Size=Vector3.one*.65*grow
		orb.shell.CFrame=center;orb.shell.Size=Vector3.one*1.55*grow*(1+math.sin(os.clock()*40)*.05)
		for i,band in orb.bands do
			band.CFrame=center*CFrame.Angles(os.clock()*(9+i*3),os.clock()*(7-i*2),i)
			band.Size=Vector3.new(.06,1.75*grow,1.75*grow)
		end
	elseif orb then
		self.rasengan[model]=nil
		orb.emitter.Enabled=false
		flash(self.folder,orb.core.Position,Color3.fromRGB(170,220,255),1.5,5,.2,.2)
		orb.holder:Destroy()
	end
	-- Katon: embers gather at the mouth during the hand signs, then the breath.
	if actor.fighterId=="Mirage" then
		local head=model:FindFirstChild("Head")
		local casting=(actor.castId=="FireBloom" or actor.castId=="PhoenixFlower") and (actor.state=="TechniqueChannel" or actor.state=="TechniqueActive")
		if casting and head then
			if not aura.mouth then
				local at=new("Attachment",{Position=Vector3.new(0,-.25,-.8)},head)
				aura.mouth=new("ParticleEmitter",{Texture=TEX.fire,Rate=0,Lifetime=NumberRange.new(.15,.3),Speed=NumberRange.new(4,10),
					SpreadAngle=Vector2.new(18,18),EmissionDirection=Enum.NormalId.Front,Color=seq({{0,Color3.fromRGB(255,230,150)},{1,Color3.fromRGB(255,90,30)}}),
					LightEmission=1,LightInfluence=0,Size=num({{0,.6},{1,1.6}}),Transparency=num({{0,.2},{1,1}})},at)
				aura.mouthLight=new("PointLight",{Color=Color3.fromRGB(255,140,60),Brightness=0,Range=10,Shadows=false},at)
			end
			local breathing=actor.state=="TechniqueActive"
			aura.mouth.Rate=if breathing then 90 else 14
			aura.mouthLight.Brightness=if breathing then 4 else 1.2
		elseif aura.mouth then
			aura.mouth.Rate=0;aura.mouthLight.Brightness=0
		end
	end
	self:identity(model,actor,aura)
end
-- ----------------------------------------------------------------- crowd
-- The stands react to the fight: big moments bring spectators to their feet,
-- banners sway in the wind. Local-only motion of anchored decor.
function FX:crowdOf(folder)
	if self.crowdFolder==folder then return end
	self.crowdFolder=folder
	self.crowd={};self.banners={}
	local yard=folder and folder:FindFirstChild("Courtyard")
	local decor=yard and yard:FindFirstChild("Decor")
	if not decor then return end
	for _,m in decor:GetChildren() do
		if m.Name=="SpectatorFigure" then
			local parts={}
			for _,p in m:GetChildren() do if p:IsA("BasePart") then table.insert(parts,{part=p,base=p.CFrame}) end end
			table.insert(self.crowd,{parts=parts,phase=math.random()*math.pi*2,speed=7+math.random()*4})
		elseif m.Name=="Banner" or m.Name=="Pavilion banner" then
			table.insert(self.banners,{part=m,base=m.CFrame,phase=math.random()*math.pi*2})
		end
	end
end
function FX:cheer(strength)
	self.cheerStart=os.clock()
	self.cheerStrength=math.max(strength,if self.cheerStart and os.clock()-self.cheerStart&lt;.4 then self.cheerStrength or 0 else 0)
end
function FX:ambient(dt)
	local t=os.clock()
	for _,b in self.banners or {} do
		if b.part.Parent then
			local h=b.part.Size.Y
			local angle=math.rad(math.sin(t*1.3+b.phase)*3+math.sin(t*3.1+b.phase)*1)
			b.part.CFrame=b.base*CFrame.new(0,h/2,0)*CFrame.Angles(angle,0,0)*CFrame.new(0,-h/2,0)
		end
	end
	local elapsed=t-(self.cheerStart or -10)
	local active=elapsed&lt;1.1
	if active or self.cheering then
		local strength=(self.cheerStrength or 0)*(1-math.clamp((elapsed-.6)/.5,0,1))
		for _,fig in self.crowd or {} do
			local lift=if active then math.abs(math.sin(t*fig.speed+fig.phase))*.75*strength else 0
			for _,entry in fig.parts do
				if entry.part.Parent then entry.part.CFrame=entry.base+Vector3.new(0,lift,0) end
			end
		end
		self.cheering=active
	end
end
function FX:update(data,dt,folder)
	self.fighters=folder
	if not data or data.phase~="Duel" then
		if self.epoch~=nil and data and data.phase=="Selection" then self.epoch=nil;self:reset() end
		self:stepProjectiles(dt)
		return
	end
	self:stepProjectiles(dt)
	self:hazardsStep(data)
	self:crowdOf(folder)
	self:ambient(dt)
	for _,key in {"human","bot"} do
		local actor=data[key]
		if actor then
			actor.intro=data.intro
			self:seal(actor.id or key,actor,folder)
			local model=folder and folder:FindFirstChild(actor.id or "")
			self:fighter(model,actor,dt)
		end
	end
end
return FX
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND51">
          <Properties>
            <string name="Name">Input</string>
            <ProtectedString name="Source">local CAS=game:GetService("ContextActionService")
local UIS=game:GetService("UserInputService")
local Controls=require(game:GetService("ReplicatedStorage").NinjaDuel.Controls)
local Input={};Input.__index=Input
local KEYBOARD,GAMEPAD=Controls.Keyboard,Controls.Gamepad
local function key(code) return {code} end
local function both(action) return {KEYBOARD[action],GAMEPAD[action]} end
local function padObject(object)
 return Controls.isGamepad(object.UserInputType) or object.KeyCode.Name:match("^Button")~=nil
  or object.KeyCode.Name:match("^DPad")~=nil or object.KeyCode.Name:match("^Thumbstick")~=nil
end
local function released(state) return state==Enum.UserInputState.End or state==Enum.UserInputState.Cancel end
function Input.new(send,getState,toggleLock,camera)
 local self=setmetatable({send=send,getState=getState,keys={},stick=Vector2.zero,look=Vector2.zero,
  sprinting=false,modifier=false,camera=camera,pad=Controls.isGamepad(UIS:GetLastInputType()),held={},guards={},jumps={}},Input)
 local function bind(name,keys,callback)
  local list={};for _,code in keys do if code then table.insert(list,code) end end
  CAS:BindActionAtPriority("Ninja"..name,function(_,state,object)
   if UIS:GetFocusedTextBox() or getState().phase~="Duel" or (name=="Skip" and not getState().tutorial) then return Enum.ContextActionResult.Pass end
   local stick=object.KeyCode==Enum.KeyCode.Thumbstick1 or object.KeyCode==Enum.KeyCode.Thumbstick2
   if not released(state) and (not stick or object.Position.Magnitude&gt;.15) then self.pad=padObject(object) end
   callback(state,object)
   return Enum.ContextActionResult.Sink
  end,false,3000,table.unpack(list))
 end
 local function begin(state) return state==Enum.UserInputState.Begin end
 -- Schmitt thresholds: an analog trigger crossing its press threshold emits
 -- once. Change events while it is held never become repeated attacks.
 local function pressed(state,object)
  local code=object.KeyCode
  local id=if object.UserInputType==Enum.UserInputType.MouseButton1 or object.UserInputType==Enum.UserInputType.MouseButton2 then object.UserInputType.Name else code.Name
  if code==GAMEPAD.Grab or code==GAMEPAD.Tool then
   if released(state) or object.Position.Z&lt;=.25 then self.held[id]=nil;return false end
   if object.Position.Z&gt;=.55 and not self.held[id] then self.held[id]=true;return true end
   return false
  end
  if released(state) then self.held[id]=nil;return false end
  if begin(state) and not self.held[id] then self.held[id]=true;return true end
  return false
 end
 for _,code in {Enum.KeyCode.W,Enum.KeyCode.A,Enum.KeyCode.S,Enum.KeyCode.D} do
  bind(code.Name,key(code),function(state)
   if begin(state) then self.keys[code.Name]=true elseif released(state) then self.keys[code.Name]=nil end
  end)
 end
 bind("MoveStick",key(Enum.KeyCode.Thumbstick1),function(state,obj)
  self.stick=if released(state) then Vector2.zero else Vector2.new(obj.Position.X,obj.Position.Y)
 end)
 bind("LookStick",key(Enum.KeyCode.Thumbstick2),function(state,obj)
  self.look=if released(state) then Vector2.zero else Vector2.new(obj.Position.X,obj.Position.Y)
  camera.look=self.look
 end)
 bind("Modifier",key(GAMEPAD.Modifier),function(state)
  if begin(state) then self.modifier=true elseif released(state) then self.modifier=false end
 end)
 local function face(state,object,normal,slot)
  if pressed(state,object) then
   local modified=padObject(object) and self.modifier
   send(if modified then "Technique"..slot else normal)
   return not modified
  end
  return false
 end
 bind("Light",both("Light"),function(state,obj) face(state,obj,"Attack",2) end)
 bind("Heavy",both("Heavy"),function(state,obj) face(state,obj,"Heavy",3) end)
 bind("Dodge",both("Dodge"),function(state,obj) face(state,obj,"Dodge",4) end)
 bind("Jump",both("Jump"),function(state,obj)
  local id=if padObject(obj) then obj.KeyCode.Name else obj.UserInputType.Name..obj.KeyCode.Name
  if released(state) then
   if self.jumps[id] then self.jumps[id]=nil;send("JumpOff") end
   pressed(state,obj)
  else
   local h=getState().human;local action=if h and h.pursuit&gt;0 then "Pursuit" else "Jump"
   if face(state,obj,action,1) and action=="Jump" then self.jumps[id]=true end
  end
 end)
 bind("Guard",both("Guard"),function(state,obj)
  local id=obj.KeyCode.Name
  if released(state) then
   if self.guards[id] then
    self.guards[id]=nil
    if next(self.guards)==nil then send("GuardOff") end
   end
   pressed(state,obj)
  elseif pressed(state,obj) then
   if padObject(obj) and self.modifier then send("WallDetach")
   else
    local already=next(self.guards)~=nil;self.guards[id]=true
    if not already then send("Guard") end
   end
  end
 end)
 bind("Tool",both("Tool"),function(state,obj) if pressed(state,obj) then send("Tool") end end)
 bind("Grab",both("Grab"),function(state,obj)
  if pressed(state,obj) then send(if padObject(obj) and self.modifier then "Feint" else "Grab") end
 end)
 bind("Lock",both("Lock"),function(state,obj) if pressed(state,obj) then toggleLock() end end)
 bind("Sprint",both("Sprint"),function(state,obj)
  if obj.KeyCode==GAMEPAD.Sprint then if pressed(state,obj) then self.sprinting=not self.sprinting end
  elseif begin(state) then self.sprinting=true elseif released(state) then self.sprinting=false end
 end)
 for _,action in {"Substitute","WallDetach","Feint","Pursuit"} do
  bind(action.."Key",key(KEYBOARD[action]),function(state,obj) if pressed(state,obj) then send(action) end end)
 end
 for _,action in {"Technique5","Awaken"} do
  bind(action,both(action),function(state,obj) if pressed(state,obj) then send(action) end end)
 end
 -- Pad re-engage has no button of its own: × in a chase window (Jump above),
 -- else ○ toward a locked opponent while sprinting. The Dodge packet already
 -- carries the stick and the sprint toggle; the server turns it into the dash.
 bind("SubstitutePad",key(GAMEPAD.Substitute),function(state,obj) if pressed(state,obj) then send("Substitute") end end)
 bind("Skip",both("Skip"),function(state,obj) if pressed(state,obj) and getState().tutorial then send("TutorialSkip") end end)
 for index,code in {Enum.KeyCode.One,Enum.KeyCode.Two,Enum.KeyCode.Three,Enum.KeyCode.Four} do
  bind("Technique"..index,key(code),function(state,obj) if pressed(state,obj) then send("Technique"..index) end end)
 end
 local function blur()
  local jumping=next(self.jumps)~=nil
  self:reset();send("GuardOff");if jumping then send("JumpOff") end;send("Move",Vector3.zero)
 end
 UIS.WindowFocusReleased:Connect(blur)
 UIS.TextBoxFocused:Connect(blur)
 UIS.GamepadDisconnected:Connect(function() if self.pad then blur();self.pad=false end end)
 UIS.LastInputTypeChanged:Connect(function(kind)
  -- Moving the cursor while using the pad must not erase the PS5 prompts.
  if kind~=Enum.UserInputType.MouseMovement then self.pad=Controls.isGamepad(kind) end
 end)
 return self
end
function Input:reset()
 table.clear(self.keys);table.clear(self.held);table.clear(self.guards);table.clear(self.jumps)
 self.stick=Vector2.zero;self.look=Vector2.zero;self.modifier=false;self.sprinting=false;self.camera.look=Vector2.zero
end
function Input:direction(camera)
 -- The current device owns movement; a resting controller cannot steer WASD.
 local stick=if self.pad and self.stick.Magnitude&gt;.15 then self.stick else Vector2.zero
 local x=stick.X+(if self.keys.D and not self.pad then 1 else 0)-(if self.keys.A and not self.pad then 1 else 0)
 local z=stick.Y+(if self.keys.W and not self.pad then 1 else 0)-(if self.keys.S and not self.pad then 1 else 0)
 local look=camera.CFrame.LookVector*Vector3.new(1,0,1)
 if look.Magnitude&lt;.01 then look=-Vector3.zAxis end
 local right=Vector3.new(-look.Unit.Z,0,look.Unit.X)
 local v=right*x+look.Unit*z
 return if v.Magnitude&gt;1 then v.Unit else v
end
return Input
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="ND52">
          <Properties>
            <string name="Name">Main</string>
            <ProtectedString name="Source">local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local player=Players.LocalPlayer
local shared=game:GetService("ReplicatedStorage"):WaitForChild("NinjaDuel")
local remote=shared:WaitForChild("Action")
pcall(function() game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Health,false); game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Chat,false); game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList,false) end)
local UI=require(script.Parent.UI)
local Input=require(script.Parent.Input)
local Camera=require(script.Parent.Camera)
local Presentation=require(script.Parent.Presentation)
local presentation=Presentation.new()
local camera=Camera.new(); local current={phase="Selection",epoch=0}; local ui; local input
camera.presentation=presentation
local mouse=player:GetMouse()
local function send(action,extra)
	local payload={action=action,epoch=current.epoch}
	if current.phase=="Duel" and action~="Move" then
  payload.clientTime=workspace:GetServerTimeNow()
  -- Sample intent at the press, not at the previous 80 ms movement tick.
  if input then payload.direction=input:direction(workspace.CurrentCamera);payload.sprint=input.sprinting end
 end
	if action=="Move" then payload.direction=extra; payload.locked=camera.locked; payload.sprint=input and input.sprinting or false
	elseif type(extra)=="table" then for k,v in extra do payload[k]=v end
	elseif action=="Tool" or string.match(action,"^Technique") then
		local gamepad=input and input.pad
		local hit=if gamepad and current.bot then current.bot.position else mouse.Hit.Position
		if gamepad and action=="Technique1" and current.human and current.human.fighterId=="Flashstep" then hit-=Vector3.new(0,2.8,0) end
		local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and (hit-root.Position).Magnitude&lt;=140 then payload.aim=hit end
	end
	remote:FireServer(payload)
end
ui=UI.new(player:WaitForChild("PlayerGui"),send)
-- Debug/QA places only: the Studio dev panel (F6, DevClient). While it is open
-- Input sees a non-Duel state, so no combat binding fires behind the panel.
local dev
input=Input.new(send,function() return if dev and dev.panelOpen then dev.blocked else current end,function() camera:setLocked(not camera.locked);send("Move",input:direction(workspace.CurrentCamera)) end,camera)
-- Disable the default movement controller; server receives finite normalized intent.
local playerModule=player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")
require(playerModule):GetControls():Disable()
remote.OnClientEvent:Connect(function(data)
	if data.epoch&lt;(current.epoch or 0) then return end
	if data.epoch~=current.epoch or data.phase~=current.phase then input:reset() end
	if data.epoch~=current.epoch then camera.locked=true end
	data.gamepad=input.pad
	current=data; presentation.receivedAt=os.clock(); presentation:impacts(data,camera); ui:render(data)
end)
local nextMove=0
RunService:BindToRenderStep("NinjaDuelCamera",Enum.RenderPriority.Camera.Value,function(dt)
	-- Last moment before the frame is drawn: the replicated roots have their
	-- final positions for this frame, so the smoothed bodies and the camera agree.
	presentation:smoothStep(current,dt)
	presentation:update(current,dt)
	camera:update(current,dt)
	if current.phase=="Duel" and os.clock()&gt;=nextMove then
		nextMove=os.clock()+0.08; send("Move",input:direction(workspace.CurrentCamera))
	end
end)
-- Studio-only diagnostics channel (created by the server's DevHooks).
if RunService:IsStudio() then
	task.spawn(function()
		local log=shared:WaitForChild("NinjaDuelDevLog",10) or game:GetService("ReplicatedStorage"):WaitForChild("NinjaDuelDevLog",10)
		if not log then return end
		game:GetService("LogService").MessageOut:Connect(function(message,kind)
			if kind==Enum.MessageType.MessageError or kind==Enum.MessageType.MessageWarning then log:FireServer("log",string.sub(message,1,400)) end
		end)
		-- Smoothness probe: per rendered frame, the apparent acceleration of each
		-- fighter's head (what the eye follows) and root. A visual jump shows up
		-- as an acceleration spike.
		local probe={frames=0,headSpikes=0,rootSpikes=0,headMax=0,rootMax=0}
		local track={}
		local trace={}
		RunService:BindToRenderStep("NinjaDuelProbe",Enum.RenderPriority.Camera.Value+1,function(dt)
			if current.phase~="Duel" or dt&lt;=0 then return end
			local folder=player.Character and player.Character.Parent
			for _,model in {player.Character,Presentation.opponent(current,folder)} do
				for _,partName in {"Head","HumanoidRootPart"} do
					local part=model and model:FindFirstChild(partName)
					if part then
						local key=model.Name..partName
						local st=track[key] or {}
						local p=part.Position
						if model==player.Character and #trace&lt;90 and partName=="Head" then
							local vr=presentation:visualRoot("human")
							local root=model:FindFirstChild("HumanoidRootPart")
							local lt=model:FindFirstChild("LowerTorso")
							local joint=lt and lt:FindFirstChild("Root") or (root and root:FindFirstChild("Root"))
							table.insert(trace,string.format("H%.2f off%.2f lt%.2f tf%.2f",(p-(st.p or p)).Magnitude,vr and root and (vr-root.Position).Magnitude or -1,
								lt and root and (lt.Position-root.Position).Magnitude or -1,joint and joint.Transform.Position.Magnitude or -1))
						end
						if st.p then
							local v=(p-st.p)/dt
							if st.v then
								local acc=(v-st.v).Magnitude/dt
								local head=partName=="Head"
								if head then probe.frames+=1 end
								if acc&gt;900 and v.Magnitude&lt;150 then
									if head then probe.headSpikes+=1 else probe.rootSpikes+=1 end
								end
								if head then probe.headMax=math.max(probe.headMax,acc) else probe.rootMax=math.max(probe.rootMax,acc) end
							end
							st.v=v
						end
						st.p=p;track[key]=st
					end
				end
			end
		end)
		log.OnClientEvent:Connect(function(kind)
			if kind=="probe" then
				local out=table.clone(probe);out.trace=table.concat(trace," ")
				log:FireServer("info",{probe=out})
				probe={frames=0,headSpikes=0,rootSpikes=0,headMax=0,rootMax=0};trace={}
				return
			end
			if kind=="info" then
				local cam=workspace.CurrentCamera
				local gui={}
				local hud=player.PlayerGui:FindFirstChild("NinjaDuelHUD")
				if hud then
					for _,g in hud:GetDescendants() do
						if g:IsA("GuiObject") and #gui&lt;40 and (g.Parent==hud or (g.Parent and g.Parent.Parent==hud)) then
							table.insert(gui,string.format("%s vis=%s pos=%s size=%s",g:GetFullName():sub(-40),tostring(g.Visible),tostring(g.AbsolutePosition),tostring(g.AbsoluteSize)))
						end
					end
				end
				log:FireServer("info",{presented=presentation.presented,camera=cam.CFrame,fov=cam.FieldOfView,focus=camera.focus,mode=camera.mode,boomAngle=camera.boomAngle,distance=camera.distance,viewport=cam.ViewportSize,gui=table.concat(gui," || ")})
			end
		end)
	end)
end
-- The normal build has no DevClient module, so this stays inert there.
local devModule=RunService:IsStudio() and script.Parent:FindFirstChild("DevClient")
if devModule then
	task.spawn(function()
		local ok,err=pcall(function()
			dev=require(devModule).install({player=player,input=input,presentation=presentation,camera=camera,ui=ui,state=function() return current end,send=send})
		end)
		if not ok then warn("[NinjaDuel] dev panel unavailable: "..tostring(err)) end
	end)
end
send("Ready")
print("[NinjaDuel] Client ready")
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND53">
          <Properties>
            <string name="Name">Presentation</string>
            <ProtectedString name="Source">-- Velmora's additive combat motion and hit feedback, retaining Ninja Duel's
-- deception visual. Rendering is continuous: bodies are drawn on a smoothed
-- track of their replicated roots instead of jumping once per network packet.
local Motion=require(script.Parent.VelmoraMotionEngine)
local Feedback=require(script.Parent.VelmoraHitFeedback)
local Effects=require(script.Parent.Effects)
local Presentation={};Presentation.__index=Presentation
local LOCOMOTION_POSE_SPEED=26
function Presentation.new()
	return setmetatable({last={},recoil={},impactSerial=0,impactEpoch=nil,clocks={},botModel=nil,fx=Effects.new(),smooth={}},Presentation)
end
-- The opponent's body in the viewer's duel folder: the server names it by the
-- id it sends as data.bot.id ("AIFighter" against the AI, a duelist online).
function Presentation.opponent(data,folder)
	return folder and folder:FindFirstChild(data and data.bot and data.bot.id or "AIFighter")
end
-- The replicated root of a server-owned fighter only moves every other
-- rendered frame (physics replication at ~30 Hz against a 60 Hz render), so a
-- body drawn on it advances in jerks. Each fighter is instead drawn on a short
-- interpolated track of its replicated positions, a fixed ~45 ms behind: the
-- motion is continuous every frame. A real teleport still snaps.
local TRACK_DELAY,TRACK_SNAP,TRACK_MAX,TRACK_SAMPLES=.045,45,12,8
local function yawOf(cf)
	local look=cf.LookVector
	return math.atan2(-look.X,-look.Z)
end
local function lerpAngle(a,b,t)
	local d=(b-a+math.pi)%(2*math.pi)-math.pi
	return a+d*t
end
function Presentation:smoothRoot(key,actualCF,dt,warp)
	local now=os.clock()
	local st=self.smooth[key]
	if not st then st={samples={},vel=Vector3.zero};self.smooth[key]=st end
	local samples=st.samples
	local actual=actualCF.Position
	local newest=samples[#samples]
	if (warp and warp~=st.warp) or (newest and (actual-newest.p).Magnitude&gt;TRACK_SNAP) then
		table.clear(samples);newest=nil;st.vel=Vector3.zero;st.pos=nil
	end
	st.warp=warp
	local yaw=yawOf(actualCF)
	if not newest or (actual-newest.p).Magnitude&gt;1e-4 or math.abs(lerpAngle(newest.yaw,yaw,1)-newest.yaw)&gt;1e-4 then
		table.insert(samples,{t=now,p=actual,yaw=yaw})
		while #samples&gt;TRACK_SAMPLES do table.remove(samples,1) end
	elseif now-newest.t&gt;.1 then
		-- Standing still: keep the track anchored to the present.
		newest.t=now
	end
	local at=now-TRACK_DELAY
	local pos,face=samples[#samples].p,samples[#samples].yaw
	if at&lt;=samples[1].t then pos,face=samples[1].p,samples[1].yaw
	else
		for i=#samples-1,1,-1 do
			local a,b=samples[i],samples[i+1]
			if at&gt;=a.t then
				local span=b.t-a.t
				local t=if span&gt;1e-4 then math.clamp((at-a.t)/span,0,1) else 1
				pos=a.p:Lerp(b.p,t);face=lerpAngle(a.yaw,b.yaw,t)
				break
			end
		end
	end
	local offset=pos-actual
	if offset.Magnitude&gt;TRACK_MAX then pos=actual+offset.Unit*TRACK_MAX end
	-- Velocity of the drawn body: what the legs and lean must match.
	if st.pos then
		local v=(pos-st.pos)/math.max(dt,1/240)
		st.vel=st.vel:Lerp(v,math.min(1,dt*18))
	end
	st.pos=pos;st.yaw=face
	return CFrame.new(pos)*CFrame.Angles(0,face,0)
end
function Presentation:visualRoot(key)
	local st=self.smooth[key]
	return st and st.pos
end
function Presentation:visualVelocity(key)
	local st=self.smooth[key]
	return st and st.vel
end
-- Just before rendering: the replicated roots have their positions for this
-- frame; advance each track and draw the body on it (position and facing).
function Presentation:smoothStep(data,dt)
	if not data or data.phase~="Duel" then return end
	local character=game:GetService("Players").LocalPlayer.Character
	local folder=character and character.Parent
	for key,model in {human=character,bot=Presentation.opponent(data,folder)} do
		local root=model and model:FindFirstChild("HumanoidRootPart")
		local actor=data[key]
		if root and not root.Anchored and actor then
			-- The true replicated pose: if the root still sits exactly where we
			-- drew it last frame, no new packet arrived since.
			local st=self.smooth[key]
			local actualCF=root.CFrame
			if st and st.drawnCF and st.replicatedCF and (actualCF.Position-st.drawnCF.Position).Magnitude&lt;1e-3
				and actualCF.LookVector:Dot(st.drawnCF.LookVector)&gt;.99999 then actualCF=st.replicatedCF end
			local drawn=self:smoothRoot(key,actualCF,math.max(dt,1/240),actor.warpSerial)
			st=self.smooth[key]
			st.replicatedCF=actualCF
			-- Draw the whole body on the track for this frame only; the next
			-- replication packet overwrites the client copy, never the server.
			local target=drawn
			if (target.Position-root.Position).Magnitude&gt;1e-4 or target.LookVector:Dot(root.CFrame.LookVector)&lt;.99999 then
				model:PivotTo(target*root.CFrame:Inverse()*model:GetPivot())
			end
			st.drawnCF=root.CFrame
		end
	end
end
-- Contact feed straight from the server: play the impact on the frame the hit
-- happened, so sound and VFX never lead or lag the animation.
function Presentation:impacts(data,camera)
 -- Projectiles first, so a contact in the same packet can finish its blade.
 if data.phase=="Duel" then self.fx:sync(data) end
 if not data.impacts then return end
 -- The server restarts its contact serial with every duel.
 if self.impactEpoch~=data.epoch then self.impactEpoch=data.epoch;self.impactSerial=0 end
 local serial=data.impactSerial or 0
 if serial&lt;=self.impactSerial then return end
 local character=game:GetService("Players").LocalPlayer.Character
 local folder=character and character.Parent
 for _,impact in data.impacts do
  if impact.serial==nil or impact.serial&gt;self.impactSerial then
   Feedback.impact(impact.style or "light",impact.position)
   self.fx:impact(impact,folder)
   if camera and camera.impulse then camera:impulse(impact.style,impact.role,impact) end
  end
 end
 self.impactSerial=serial
end
-- Genjutsu image. The server says who is deceived (illusion + decoy on that
-- actor). Seen by the deceived player, the image IS Itachi: a frozen copy in
-- his stance facing them, with a faint red outline pulsing now and then (the
-- tell), and the real body behind it drawn faint. Seen by Itachi's player, the
-- image is a red translucent afterimage of himself: he sees the trap he left.
function Presentation.fade(model,amount)
 if not model then return end
 for _,d in model:GetDescendants() do if d:IsA("BasePart") then d.LocalTransparencyModifier=amount end end
end
function Presentation:clearEcho()
 local echo=self.echo
 if not echo then return end
 if echo.model then echo.model:Destroy() end
 if echo.mode=="deceived" then Presentation.fade(echo.source,0) end
 self.echo=nil
end
-- Which view of the genjutsu this client draws: "deceived" (my fighter is
-- under it), "caster" (the opponent is under mine) or nil.
function Presentation.illusionView(data)
 if not data or data.phase~="Duel" then return nil end
 if data.human and (data.human.illusion or 0)&gt;0 and data.human.decoy then return "deceived",data.human.decoy end
 if data.bot and (data.bot.illusion or 0)&gt;0 and data.bot.decoy then return "caster",data.bot.decoy end
 return nil
end
function Presentation:illusion(data,model)
 local folder=model and model.Parent
 local opponent=Presentation.opponent(data,folder)
 local mode,decoy=Presentation.illusionView(data)
 local source=if mode=="deceived" then opponent elseif mode=="caster" then model else nil
 local watcher=if mode=="deceived" then model else opponent
 if not source then mode=nil end
 local echo=self.echo
 if echo and (echo.mode~=mode or echo.epoch~=data.epoch or echo.source~=source) then self:clearEcho();echo=nil end
 if not mode then return end
 if not echo then
  echo={mode=mode,epoch=data.epoch,source=source,model=self.fx:image(source,mode),born=os.clock()}
  self.echo=echo
 end
 if mode=="deceived" then Presentation.fade(source,.55) end
 local image=echo.model
 if not image then return end
 local root=watcher and watcher:FindFirstChild("HumanoidRootPart")
 local look=if root then Vector3.new(root.Position.X-decoy.X,0,root.Position.Z-decoy.Z) else Vector3.zero
 if look.Magnitude&lt;.1 then look=Vector3.zAxis end
 local t=os.clock()-echo.born
 local at=decoy+Vector3.new(0,math.sin(t*5)*.03,0)
 image:PivotTo(CFrame.lookAt(at,at+look.Unit))
 local tell=image:FindFirstChild("Tell")
 if tell then tell.OutlineTransparency=1-.45*math.max(0,math.sin(t*7))^8 end
end
-- Local presentation clocks: an attack animates from the frame it was first
-- seen, so a late or jittery packet cannot make the body jump backwards.
local function clockFor(self,key,actor,now)
 local clock=self.clocks[key]
 if not clock then clock={};self.clocks[key]=clock end
 -- A new swing restarts the clock even when it repeats the same move name.
 if actor.attackName~=clock.attackName or (actor.attackSerial or 0)~=clock.attackSerial then
  -- Start the clip where the server already is: a snapshot arrives up to an
  -- interval late, and a clip restarted at 0 trailed the real contact (the
  -- launcher's kick was cut off by the chase before it ever showed).
  clock.attackName=actor.attackName;clock.attackSerial=actor.attackSerial or 0
  clock.attackAt=now-math.clamp(actor.attackElapsed or 0,0,.12)
 end
 -- A fresh contact restarts the recoil even when it repeats the same reaction
 -- kind (Light1 -&gt; Light2 are both HitStun), so every hit reads as a hit.
 if actor.reaction~=clock.reaction or (actor.reaction and (actor.impactSerial or 0)~=clock.impactSerial) then
  clock.reaction=actor.reaction;clock.reactionAt=now
 end
 clock.impactSerial=actor.impactSerial or 0
 clock.attackElapsed=if actor.attackName then now-clock.attackAt else 0
 clock.reactionElapsed=if actor.reaction then now-clock.reactionAt else 0
 return clock
end
function Presentation:update(data,dt)
 dt=math.max(dt or 1/60,.001)
 -- One presentation tick per rendered frame; every pose below reads this clock.
 Motion.tick(dt)
 local players=game:GetService("Players")
 if not data.human then
  self:clearEcho()
  self.fx:update(data,dt,nil)
  return
 end
 if self.epoch~=data.epoch then
  -- Character switch, rematch or a fresh duel: the only place a hard reset is
  -- right. Normal presentation never snaps the skeleton.
  self.epoch=data.epoch
  table.clear(self.clocks);table.clear(self.last);table.clear(self.smooth)
  if players.LocalPlayer.Character then Motion.reset(players.LocalPlayer.Character) end
  if self.botModel then Motion.reset(self.botModel) end
 end
 local now=os.clock()
 local character=players.LocalPlayer.Character
 self:illusion(data,character)
 local folder=character and character.Parent
 local bot=Presentation.opponent(data,folder)
 self.botModel=bot
 local models={human=character,bot=bot}
 for key,model in models do
  local actor=data[key];local previous=self.last[key]
  if model and actor then
   -- The motion engine owns every joint. A Humanoid Animator (run locally for
   -- the player's own character) resets the joints between our write and the
   -- render, which left the body in its rest pose; remove it on this client.
   local humanoid=model:FindFirstChildOfClass("Humanoid")
   local animator=humanoid and humanoid:FindFirstChildOfClass("Animator")
   if animator then animator:Destroy() end
   local clock=clockFor(self,key,actor,now)
   local root=model:FindFirstChild("HumanoidRootPart")
   -- The body is drawn on a smoothed track of the replicated root (see
   -- Presentation:smoothStep, run just before each frame is rendered).
   -- Take-off and get-up sounds, from the state change itself.
   if previous and not previous.airborne and actor.airborne and root and root.AssemblyLinearVelocity.Y&gt;15 and not actor.reaction then self.fx:jumpSound(root.Position) end
   if previous and previous.reaction=="Wakeup" and actor.reaction~="Wakeup" and root then self.fx:getUpSound(root.Position) end
   if previous and previous.airborne and not actor.airborne then
    -- Landing compression lasts a few frames; a soft landing barely shows.
    self.landingUntil=now+(if actor.landStrong then .22 else .1)
   end
   -- Health lost without a new contact (burn, sand): a slow drain such as the
   -- curse mark (~0.1 HP per snapshot) is not a hit and spawns nothing.
   if previous and actor.health&lt;=previous.health-1 and actor.impactSerial==(previous.impactSerial or -1) then
    local damage=previous.health-actor.health
    if root then Feedback.burst(root.Position,if actor.cue=="GUARDED" then Color3.fromRGB(255,235,160) else Color3.fromRGB(255,91,74),damage,actor.cue=="GUARDED") end
   end
   if actor.events and previous and actor.events.Parry and actor.events.Parry&gt;(previous.parry or 0) then
    if root then Feedback.burst(root.Position,Color3.fromRGB(255,245,176),0,true) end
   end
   -- Locomotion is posed from the rig's live velocity, not a 10 Hz value.
   local tracked=self:visualVelocity(key)
   local velocity=if root then root.AssemblyLinearVelocity else actor.velocity
   if tracked and velocity then velocity=Vector3.new(tracked.X,velocity.Y,tracked.Z) end
   local planar=if velocity then Vector3.new(velocity.X,0,velocity.Z).Magnitude else 0
   local speed=math.max(actor.speed or 0,planar)
   -- Everything the presentation contract needs, with locally measured clocks so
   -- a late packet cannot make the body replay its wind-up.
   local visual=table.clone(actor)
   -- A dash is server-driven translation: pose it from its declared direction.
   visual.velocity=if actor.state=="Dodging" then actor.velocity else velocity
   visual.speed=speed
   visual.reactionElapsed=clock.reactionElapsed
   visual.attackElapsed=clock.attackElapsed
   visual.landing=self.landingUntil~=nil and now&lt;self.landingUntil
   visual.intro=data.intro
   local other=if key=="human" then "bot" else "human"
   visual.lookAt=self:visualRoot(other) or (data[other] and data[other].position)
   -- Throws and casts run on the shared server clock (slightly behind, like the
   -- projectiles), so the blade leaves the hand on the frame it starts flying.
   if data.serverNow then
    local visualNow=workspace:GetServerTimeNow()-Effects.DELAY
    if actor.throwElapsed then visual.throwElapsed=visualNow-(data.serverNow-actor.throwElapsed) end
    if actor.castElapsed then visual.castElapsed=workspace:GetServerTimeNow()-(data.serverNow-actor.castElapsed) end
    if actor.channel then visual.channel=math.max(0,actor.channel-(workspace:GetServerTimeNow()-data.serverNow)) end
   end
   Motion.weapon(model,visual)
   self.presented=self.presented or {}
   self.presented[key]=string.format("%s hp=%s state=%s",tostring(Motion.present(model,visual,clock,dt)),tostring(visual.health),tostring(visual.state))
   self.last[key]={health=actor.health,attackName=actor.attackName,parry=actor.events and actor.events.Parry or 0,
    impactSerial=actor.impactSerial or 0,airborne=actor.airborne,reaction=actor.reaction}
  end
 end
 self.fx:update(data,dt,folder)
end
return Presentation
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND54">
          <Properties>
            <string name="Name">UI</string>
            <ProtectedString name="Source">-- Prodigy Tournament interface: roster/selection, online queue and fighter
-- pick, duel HUD, match intro and result framing. Presentation only; every
-- value comes from the snapshot.
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Fighters=require(Shared.Fighters)
local Controls=require(Shared.Controls)
local MoveGraphs=require(Shared.MoveGraphs)
local Protocol=require(Shared.OnlineProtocol)
local GuiService=game:GetService("GuiService")
local UIS=game:GetService("UserInputService")
local Tween=game:GetService("TweenService")
local UI={}; UI.__index=UI
local palette={
	ink=Color3.fromRGB(16,15,20),panel=Color3.fromRGB(28,26,32),paper=Color3.fromRGB(240,232,212),
	text=Color3.fromRGB(240,236,226),muted=Color3.fromRGB(170,164,150),red=Color3.fromRGB(190,40,36),
	gold=Color3.fromRGB(230,184,86),blue=Color3.fromRGB(82,177,244),crimson=Color3.fromRGB(222,70,80),
	track=Color3.fromRGB(46,42,48),locked=Color3.fromRGB(38,36,42),
}
local TITLE_FONT=Enum.Font.Bangers
local BODY_FONT=Enum.Font.GothamBold
local function create(class,parent,props)
	local x=Instance.new(class)
	for k,v in props do x[k]=v end
	x.Parent=parent; return x
end
local function frame(parent,position,size,color,transparency)
	return create("Frame",parent,{Position=position,Size=size,BackgroundColor3=color or palette.panel,BorderSizePixel=0,BackgroundTransparency=transparency or 0})
end
local function text(parent,value,position,size,fontSize,color,font,align)
	return create("TextLabel",parent,{Text=value,Position=position,Size=size,TextSize=fontSize or 16,Font=font or BODY_FONT,
		TextColor3=color or palette.text,BackgroundTransparency=1,TextXAlignment=align or Enum.TextXAlignment.Left,TextWrapped=true})
end
local function corner(parent,radius) return create("UICorner",parent,{CornerRadius=UDim.new(0,radius or 6)}) end
local function stroke(parent,color,thickness) return create("UIStroke",parent,{Color=color or palette.ink,Thickness=thickness or 2}) end
local function button(parent,value,position,size,callback,color)
	local b=create("TextButton",parent,{Text=value,Position=position,Size=size,TextSize=24,Font=TITLE_FONT,TextColor3=palette.text,
		BackgroundColor3=color or palette.panel,BorderSizePixel=0,AutoButtonColor=true})
	corner(b,6)
	b.Activated:Connect(callback); return b
end
local function accentOf(def) return Color3.fromRGB(table.unpack(def.Color)) end
-- A tiny posed figure built from the fighter's palette.
local function portrait(parent,def,position,size)
	local vp=create("ViewportFrame",parent,{Position=position,Size=size or UDim2.fromOffset(100,116),BackgroundTransparency=1,
		Ambient=Color3.fromRGB(190,186,180),LightColor=Color3.new(1,1,1),LightDirection=Vector3.new(-1,-1,-1)})
	local function p(sz,at,color)
		create("Part",vp,{Size=sz,CFrame=CFrame.new(at),Color=if typeof(color)=="Color3" then color else Color3.fromRGB(table.unpack(color)),Anchored=true})
	end
	p(Vector3.new(2,2,1),Vector3.zero,def.Outfit)
	p(Vector3.new(1.6,1.6,1.6),Vector3.new(0,1.7,0),def.Skin)
	p(Vector3.new(1.8,.7,1.8),Vector3.new(0,2.55,0),def.Hair)
	p(Vector3.new(1.7,.25,1.7),Vector3.new(0,2.1,0),Color3.fromRGB(28,36,58))
	for _,s in {-1,1} do p(Vector3.new(.9,2,.9),Vector3.new(s*1.45,0,0),def.Outfit) end
	local camera=create("Camera",vp,{CFrame=CFrame.lookAt(Vector3.new(3.5,2.6,-7.5),Vector3.new(0,.9,0))})
	vp.CurrentCamera=camera
	return vp
end
local ROSTER_SLOTS=20
function UI.new(parent,send)
	local self=setmetatable({player="Flashstep",bot="Mirage",send=send,selectionButtons={},introShown=nil},UI)
	self.gui=create("ScreenGui",parent,{Name="NinjaDuelHUD",ResetOnSpawn=false,IgnoreGuiInset=true,ZIndexBehavior=Enum.ZIndexBehavior.Sibling})
	-- ------------------------------------------------------------ selection
	self.selection=frame(self.gui,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.ink,.08)
	local shell=frame(self.selection,UDim2.fromScale(.5,.5),UDim2.fromOffset(900,668),palette.ink,1)
	shell.AnchorPoint=Vector2.new(.5,.5)
	local scale=create("UIScale",shell,{Scale=1})
	local function resize() scale.Scale=math.min(1.2,workspace.CurrentCamera.ViewportSize.X/980,workspace.CurrentCamera.ViewportSize.Y/728) end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(resize);resize()
	frame(shell,UDim2.fromOffset(0,74),UDim2.fromOffset(900,4),palette.red)
	text(shell,"PRODIGY TOURNAMENT",UDim2.fromOffset(0,0),UDim2.fromOffset(620,72),64,palette.paper,TITLE_FONT)
	text(shell,"天才忍者大会",UDim2.fromOffset(620,10),UDim2.fromOffset(280,56),40,palette.red,BODY_FONT,Enum.TextXAlignment.Right)
	text(shell,"Twenty future legends. Twelve to fourteen years old. One stage — before they become who they are meant to be.",
		UDim2.fromOffset(2,86),UDim2.fromOffset(896,40),16,palette.muted)
	-- Roster: the two prodigies who have arrived, and the slots still empty.
	local grid=frame(shell,UDim2.fromOffset(0,136),UDim2.fromOffset(900,230),palette.ink,1)
	-- CORE4, then Gaara as the first stress-test fighter of the next wave (DEC-015).
	local playable={"Flashstep","Mirage","GentleFist","Lion","Sand"}
	for index=1,ROSTER_SLOTS do
		local col=(index-1)%10;local row=math.floor((index-1)/10)
		local slot=frame(grid,UDim2.fromOffset(col*90,row*116),UDim2.fromOffset(84,108),palette.locked)
		corner(slot,6)
		local id=playable[index]
		if id then
			local def=Fighters[id]
			slot.BackgroundColor3=palette.panel
			stroke(slot,accentOf(def),2)
			portrait(slot,def,UDim2.fromOffset(2,2),UDim2.fromOffset(80,78))
			text(slot,string.upper(def.Name),UDim2.fromOffset(0,80),UDim2.fromOffset(84,26),20,accentOf(def),TITLE_FONT,Enum.TextXAlignment.Center)
			local pick=create("TextButton",slot,{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text=""})
			pick.Activated:Connect(function()
				if self.picking then self:choose(id);return end
				self.player=id
				if self.bot==id then self.bot=playable[index%#playable+1] end
				self:refreshSelection()
			end)
			self.selectionButtons["slot"..id]=slot
		else
			text(slot,"?",UDim2.fromOffset(0,14),UDim2.fromOffset(84,56),48,Color3.fromRGB(70,66,74),TITLE_FONT,Enum.TextXAlignment.Center)
			text(slot,"PRODIGY "..index,UDim2.fromOffset(0,78),UDim2.fromOffset(84,22),14,Color3.fromRGB(96,90,98),TITLE_FONT,Enum.TextXAlignment.Center)
		end
	end
	-- Matchup panel.
	self.matchup=text(shell,"",UDim2.fromOffset(0,372),UDim2.fromOffset(900,44),38,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
	self.matchupNote=text(shell,"",UDim2.fromOffset(0,410),UDim2.fromOffset(900,34),13,palette.muted,BODY_FONT,Enum.TextXAlignment.Center)
	-- The selected fighter's reading of the shared combo grammar.
	self.routeNote=text(shell,"",UDim2.fromOffset(0,440),UDim2.fromOffset(900,16),12,palette.gold,BODY_FONT,Enum.TextXAlignment.Center)
	text(shell,"YOU",UDim2.fromOffset(0,460),UDim2.fromOffset(200,18),14,palette.muted)
	self.opponentLabel=text(shell,"OPPONENT (AI)",UDim2.fromOffset(470,460),UDim2.fromOffset(430,18),14,palette.muted)
	-- Fighter buttons share each half of the panel, however many are playable.
	-- During an online pick the left half is yours, the right shows the opponent's.
	local stride=math.floor(430/#playable)
	for i,id in playable do
		self.selectionButtons["player"..id]=button(shell,string.upper(Fighters[id].Name),UDim2.fromOffset((i-1)*stride,480),UDim2.fromOffset(stride-6,40),function()
			if self.picking then self:choose(id);return end
			self.player=id; self:refreshSelection()
		end)
		self.selectionButtons["bot"..id]=button(shell,string.upper(Fighters[id].Name),UDim2.fromOffset(470+(i-1)*stride,480),UDim2.fromOffset(stride-6,40),function()
			if self.picking then return end
			self.bot=id; self:refreshSelection()
		end)
	end
	self.startButton=button(shell,"ENTER THE STAGE",UDim2.fromOffset(470,540),UDim2.fromOffset(430,52),function()
		if self.picking then send("Confirm") else send("Start",{player=self.player,bot=self.bot}) end
	end,palette.red)
	self.tutorialButton=button(shell,"TRAINING (TUTORIAL)",UDim2.fromOffset(0,540),UDim2.fromOffset(430,52),function()
		if self.picking then send("Cancel") else send("Tutorial",{player=self.player,bot=self.bot}) end
	end)
	-- Online 1v1 with the fighter chosen above: casual queue, or a private duel
	-- by code (host one, or type a friend's code and join).
	self.onlineRow=frame(shell,UDim2.fromOffset(0,604),UDim2.fromOffset(900,40),palette.ink,1)
	self.queueButton=button(self.onlineRow,"ONLINE DUEL",UDim2.fromOffset(0,0),UDim2.fromOffset(290,40),function() send("Queue",{player=self.player}) end)
	self.hostButton=button(self.onlineRow,"HOST PRIVATE DUEL",UDim2.fromOffset(300,0),UDim2.fromOffset(290,40),function() send("Host",{player=self.player}) end)
	local codeBox=create("TextBox",self.onlineRow,{Position=UDim2.fromOffset(600,0),Size=UDim2.fromOffset(170,40),Text="",PlaceholderText="CODE",
		TextSize=24,Font=TITLE_FONT,TextColor3=palette.text,PlaceholderColor3=palette.muted,BackgroundColor3=palette.panel,BorderSizePixel=0,ClearTextOnFocus=false})
	corner(codeBox,6)
	codeBox:GetPropertyChangedSignal("Text"):Connect(function()
		local clean=string.sub(string.gsub(string.upper(codeBox.Text),"[^A-Z0-9]",""),1,Protocol.CodeLength)
		if clean~=codeBox.Text then codeBox.Text=clean end
	end)
	self.codeBox=codeBox
	self.joinButton=button(self.onlineRow,"JOIN",UDim2.fromOffset(780,0),UDim2.fromOffset(120,40),function() send("Join",{player=self.player,code=codeBox.Text}) end)
	self.notice=text(shell,"",UDim2.fromOffset(0,648),UDim2.fromOffset(900,18),13,palette.gold,BODY_FONT,Enum.TextXAlignment.Center)
	-- ------------------------------------------------------------------ HUD
	self.hud=frame(self.gui,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.ink,1)
	local hudScale=create("UIScale",self.hud,{Scale=1})
	self.hudScale=hudScale
	local function plate(side)
		local right=side=="right"
		local box=frame(self.hud,if right then UDim2.new(1,-24,0,18) else UDim2.fromOffset(24,18),UDim2.fromOffset(440,92),palette.ink,.25)
		box.AnchorPoint=Vector2.new(if right then 1 else 0,0)
		corner(box,8)
		local align=if right then Enum.TextXAlignment.Right else Enum.TextXAlignment.Left
		local name=text(box,"",UDim2.fromOffset(14,4),UDim2.fromOffset(412,34),32,palette.paper,TITLE_FONT,align)
		local title=text(box,"",UDim2.fromOffset(14,36),UDim2.fromOffset(412,16),12,palette.muted,BODY_FONT,align)
		local track=frame(box,UDim2.fromOffset(14,56),UDim2.fromOffset(412,14),palette.track)
		corner(track,4)
		local lag=frame(track,UDim2.fromScale(0,0),UDim2.fromScale(1,1),Color3.fromRGB(240,220,190))
		corner(lag,4)
		local fill=frame(track,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.gold)
		corner(fill,4)
		if right then lag.AnchorPoint=Vector2.new(1,0);lag.Position=UDim2.fromScale(1,0);fill.AnchorPoint=Vector2.new(1,0);fill.Position=UDim2.fromScale(1,0) end
		local chakraTrack=frame(box,UDim2.fromOffset(14,74),UDim2.fromOffset(412,6),palette.track)
		local chakra=frame(chakraTrack,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.blue)
		if right then chakra.AnchorPoint=Vector2.new(1,0);chakra.Position=UDim2.fromScale(1,0) end
		local status=text(box,"",UDim2.fromOffset(14,80),UDim2.fromOffset(412,12),10,palette.muted,BODY_FONT,align)
		-- Substitution charges: two diamonds, the recharging one fills up.
		local pips={}
		for k=1,2 do
			local x=if right then 14+(k-1)*26 else 404-(k-1)*26
			local pip=frame(box,UDim2.fromOffset(x,12),UDim2.fromOffset(16,16),palette.track)
			pip.Rotation=45;pip.ClipsDescendants=true
			local fill=frame(pip,UDim2.fromScale(0,1),UDim2.fromScale(1,1),palette.paper)
			fill.AnchorPoint=Vector2.new(0,1)
			pips[k]={pip=pip,fill=fill}
		end
		local subLabel=text(box,"SUB",UDim2.fromOffset(if right then 68 else 314,14),UDim2.fromOffset(36,12),10,palette.muted,BODY_FONT,
			if right then Enum.TextXAlignment.Left else Enum.TextXAlignment.Right)
		-- Round wins: small medallions under the plate.
		local medals={}
		for k=1,2 do
			local m=frame(box,UDim2.fromOffset(if right then 412-(k-1)*20 else 14+(k-1)*20,96),UDim2.fromOffset(14,14),palette.track)
			corner(m,7);table.insert(medals,m)
		end
		return {box=box,name=name,title=title,fill=fill,lag=lag,chakra=chakra,status=status,pips=pips,subLabel=subLabel,medals=medals}
	end
	self.hp=plate("left")
	self.enemy=plate("right")
	self.round=text(self.hud,"ROUND 1",UDim2.new(.5,-120,0,22),UDim2.fromOffset(240,30),26,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
	self.roundSub=text(self.hud,"PRODIGY TOURNAMENT",UDim2.new(.5,-120,0,50),UDim2.fromOffset(240,16),11,palette.muted,BODY_FONT,Enum.TextXAlignment.Center)
	self.cue=text(self.hud,"",UDim2.new(.5,-300,0,124),UDim2.fromOffset(600,40),30,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
	create("UIStroke",self.cue,{Color=palette.ink,Thickness=2,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
	self.channel=text(self.hud,"",UDim2.new(.5,-250,0,166),UDim2.fromOffset(500,28),15,palette.muted,BODY_FONT,Enum.TextXAlignment.Center)
	self.statusLine=text(self.hud,"",UDim2.new(0,24,1,-118),UDim2.fromOffset(420,16),12,palette.muted)
	-- Combo counters: yours on the left, the opponent's on you on the right.
	local function counter(side)
		local right=side=="right"
		local box=frame(self.hud,if right then UDim2.new(1,-40,.36,0) else UDim2.new(0,40,.36,0),UDim2.fromOffset(220,90),palette.ink,1)
		box.AnchorPoint=Vector2.new(if right then 1 else 0,0)
		local align=if right then Enum.TextXAlignment.Right else Enum.TextXAlignment.Left
		local hits=text(box,"",UDim2.fromOffset(0,0),UDim2.fromOffset(220,56),54,palette.paper,TITLE_FONT,align)
		create("UIStroke",hits,{Color=palette.ink,Thickness=3,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
		local detail=text(box,"",UDim2.fromOffset(0,56),UDim2.fromOffset(220,18),14,palette.gold,BODY_FONT,align)
		create("UIStroke",detail,{Color=palette.ink,Thickness=1.5,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
		return {box=box,hits=hits,detail=detail,shown=0}
	end
	self.comboMine=counter("left")
	self.comboTheirs=counter("right")
	self.techniqueButtons={}
	for i=1,5 do
		local box=frame(self.hud,UDim2.new(.5,-440+(i-1)*178,1,-122),UDim2.fromOffset(170,58),palette.ink,.2)
		corner(box,8)
		local key=text(box,"",UDim2.fromOffset(8,4),UDim2.fromOffset(154,18),14,palette.gold,TITLE_FONT)
		local title=text(box,"",UDim2.fromOffset(8,22),UDim2.fromOffset(154,20),18,palette.paper,TITLE_FONT)
		local status=text(box,"",UDim2.fromOffset(8,43),UDim2.fromOffset(154,12),11,palette.muted)
		local cool=frame(box,UDim2.fromScale(0,1),UDim2.fromScale(1,0),palette.ink,.35)
		cool.AnchorPoint=Vector2.new(0,1);corner(cool,8)
		self.techniqueButtons[i]={box=box,key=key,title=title,status=status,cool=cool}
	end
	self.help=text(self.hud,Controls.Help,UDim2.new(.5,-640,1,-30),UDim2.fromOffset(1280,22),11,palette.muted,BODY_FONT,Enum.TextXAlignment.Center)
	self.grammar=text(self.hud,Controls.Grammar,UDim2.new(.5,-640,1,-48),UDim2.fromOffset(1280,18),11,Color3.fromRGB(196,176,130),BODY_FONT,Enum.TextXAlignment.Center)
	self.hint=text(self.hud,"",UDim2.new(.5,-260,0,200),UDim2.fromOffset(520,30),18,palette.gold,TITLE_FONT,Enum.TextXAlignment.Center)
	self.ko=text(self.hud,"K.O.",UDim2.new(.5,-300,.3,0),UDim2.fromOffset(600,130),120,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
	create("UIStroke",self.ko,{Color=palette.red,Thickness=5,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
	self.ko.Visible=false
	-- ---------------------------------------------------------------- intro
	self.intro=frame(self.gui,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.ink,1)
	self.introLeft=frame(self.intro,UDim2.new(0,0,.62,0),UDim2.new(.5,0,0,110),palette.ink,.15)
	self.introRight=frame(self.intro,UDim2.new(.5,0,.62,0),UDim2.new(.5,0,0,110),palette.ink,.15)
	self.introLeftName=text(self.introLeft,"",UDim2.new(0,40,0,6),UDim2.new(1,-80,0,64),64,palette.paper,TITLE_FONT)
	self.introLeftTitle=text(self.introLeft,"",UDim2.new(0,42,0,70),UDim2.new(1,-80,0,26),18,palette.muted)
	self.introRightName=text(self.introRight,"",UDim2.new(0,40,0,6),UDim2.new(1,-80,0,64),64,palette.paper,TITLE_FONT,Enum.TextXAlignment.Right)
	self.introRightTitle=text(self.introRight,"",UDim2.new(0,40,0,70),UDim2.new(1,-82,0,26),18,palette.muted,BODY_FONT,Enum.TextXAlignment.Right)
	self.introVs=text(self.intro,"VS",UDim2.new(.5,-80,.62,8),UDim2.fromOffset(160,96),88,palette.red,TITLE_FONT,Enum.TextXAlignment.Center)
	create("UIStroke",self.introVs,{Color=palette.paper,Thickness=3,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
	self.introRound=text(self.intro,"",UDim2.new(.5,-400,.5,-48),UDim2.fromOffset(800,40),30,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
	self.introBegin=text(self.intro,"",UDim2.new(.5,-400,.38,-60),UDim2.fromOffset(800,120),120,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
	create("UIStroke",self.introBegin,{Color=palette.red,Thickness=4,ApplyStrokeMode=Enum.ApplyStrokeMode.Contextual})
	self.intro.Visible=false
	-- --------------------------------------------------------------- result
	self.result=frame(self.gui,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.ink,.25)
	local resultBox=frame(self.result,UDim2.new(.5,-300,.5,-170),UDim2.fromOffset(600,340),palette.ink,.1)
	corner(resultBox,10)
	stroke(resultBox,palette.red,3)
	self.resultBox=resultBox
	self.resultTitle=text(resultBox,"",UDim2.fromOffset(30,18),UDim2.fromOffset(540,70),72,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
	self.resultName=text(resultBox,"",UDim2.fromOffset(30,92),UDim2.fromOffset(540,36),30,palette.gold,TITLE_FONT,Enum.TextXAlignment.Center)
	self.resultNote=text(resultBox,"",UDim2.fromOffset(30,132),UDim2.fromOffset(540,44),15,palette.muted,BODY_FONT,Enum.TextXAlignment.Center)
	self.rematchButton=button(resultBox,"REMATCH",UDim2.fromOffset(30,196),UDim2.fromOffset(540,52),function() send("Rematch") end,palette.red)
	button(resultBox,"RETURN TO THE ROSTER",UDim2.fromOffset(30,260),UDim2.fromOffset(540,52),function() send("Selection") end)
	-- ---------------------------------------------------------- online queue
	self.queue=frame(self.gui,UDim2.fromScale(0,0),UDim2.fromScale(1,1),palette.ink,.25)
	local queueBox=frame(self.queue,UDim2.new(.5,-300,.5,-150),UDim2.fromOffset(600,300),palette.ink,.1)
	corner(queueBox,10)
	stroke(queueBox,palette.red,3)
	self.queueTitle=text(queueBox,"",UDim2.fromOffset(30,18),UDim2.fromOffset(540,56),48,palette.paper,TITLE_FONT,Enum.TextXAlignment.Center)
	self.queueCode=text(queueBox,"",UDim2.fromOffset(30,80),UDim2.fromOffset(540,70),72,palette.gold,TITLE_FONT,Enum.TextXAlignment.Center)
	self.queueNote=text(queueBox,"",UDim2.fromOffset(30,154),UDim2.fromOffset(540,44),15,palette.muted,BODY_FONT,Enum.TextXAlignment.Center)
	self.cancelButton=button(queueBox,"CANCEL",UDim2.fromOffset(30,222),UDim2.fromOffset(540,52),function() send("Cancel") end)
	self.queue.Visible=false
	-- The genjutsu image carries no label: the world shows it (Presentation:illusion).
	self.tutorialPanel=frame(self.hud,UDim2.new(.5,-260,0,84),UDim2.fromOffset(520,90),palette.ink,.15)
	corner(self.tutorialPanel,8)
	self.tutorialTitle=text(self.tutorialPanel,"",UDim2.fromOffset(16,6),UDim2.fromOffset(490,30),24,palette.paper,TITLE_FONT)
	self.tutorialPrompt=text(self.tutorialPanel,"",UDim2.fromOffset(16,40),UDim2.fromOffset(490,40),14,palette.muted)
	GuiService.AutoSelectGuiEnabled=true
	-- HUD scale follows the viewport so plates and slots never leave the screen.
	local function fitHud()
		local size=workspace.CurrentCamera.ViewportSize
		local s=math.clamp(math.min(size.X/1500,size.Y/860),.55,1.25)
		-- Studio capture aid (see Camera): shrink the HUD into the visible region.
		if game:GetService("RunService"):IsStudio() and workspace:GetAttribute("NinjaDuelCaptureShift") then s*=.66 end
		hudScale.Scale=s
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fitHud);fitHud()
	self:refreshSelection(); self:render({phase="Selection"})
	return self
end
function UI:refreshSelection()
	-- During an online pick the right half shows the opponent's live choice.
	local other=if self.picking and Fighters[self.opponentPick or ""] then self.opponentPick else self.bot
	for key,b in self.selectionButtons do
		local selected=key=="player"..self.player or key=="bot"..other or key=="slot"..self.player
		b.BackgroundColor3=if selected then Color3.fromRGB(120,36,34) else palette.panel
	end
	local p,o=Fighters[self.player],Fighters[other]
	self.matchup.Text=string.upper((p.FullName or p.Name).."  VS  "..(o.FullName or o.Name))
	self.matchupNote.Text=(p.Description or "").."\n"..(o.Description or "")
	self.routeNote.Text=if p.Routes then string.upper(p.Name).." STRINGS  "..p.Routes else ""
end
-- Online pick: your fighter changes until you confirm; the server echoes it.
function UI:choose(id)
	if self.onlineInfo and self.onlineInfo.ready then return end
	self.player=id;self:refreshSelection();self.send("Pick",{player=id})
end
-- Roster, online waiting screen and online pick (the roster in versus mode).
function UI:lobby(data)
	local online=data.online
	self.picking=data.phase=="Pick" and online~=nil
	if self.picking then
		if Fighters[online.me or ""] then self.player=online.me end
		self.opponentPick=online.them
		self.opponentLabel.Text="OPPONENT  •  "..string.upper(online.opponent or "")..(if online.theirReady then "  •  READY" else "")
		self.startButton.Text=if online.ready then "READY  •  WAITING FOR OPPONENT" else "READY"
		self.tutorialButton.Text="LEAVE"
		self.notice.Text=string.format("ONLINE 1v1  •  THE DUEL STARTS IN %d s",math.ceil(online.remaining or 0))
	else
		self.opponentPick=nil
		self.opponentLabel.Text="OPPONENT (AI)"
		self.startButton.Text="ENTER THE STAGE"
		self.tutorialButton.Text="TRAINING (TUTORIAL)"
		self.notice.Text=data.notice or ""
	end
	self.onlineRow.Visible=data.phase=="Selection"
	if data.phase=="Queue" then
		local private=online~=nil and online.mode=="private"
		self.queueTitle.Text=if private then "PRIVATE DUEL" else "SEARCHING FOR AN OPPONENT"
		self.queueCode.Text=if private then (online.code or "") else ""
		self.queueNote.Text=if private then "Share this code: your friend types it next to JOIN on the roster screen."
			else "Casual 1v1  •  you meet the next player who searches."
	end
	self:refreshSelection()
end
local function fullName(actor)
	local def=Fighters[actor.fighterId]
	return string.upper(def and def.FullName or actor.fighter or "")
end
local function subtitle(actor)
	local def=Fighters[actor.fighterId]
	if not def then return "" end
	return string.format("AGE %d  •  %s",def.Age or 13,def.Title or "")
end
-- Server cues name keyboard keys; a pad player reads the pad button instead
-- (labels from Controls, so the copy cannot drift from the bindings).
function UI.padCue(cue)
	local P=Controls.PadLabel
	cue=cue:gsub("SPACE REBOUND",P.Jump.." REBOUND"):gsub("C DETACH",P.WallDetach.." DETACH")
	cue=cue:gsub("• E ","• "..P.Pursuit.." "):gsub("X TO ESCAPE",P.Substitute.." TO ESCAPE")
	cue=cue:gsub("• 1 = ","• "..Controls.TechniquePad[1].." = ")
	return cue
end
function UI:render(data)
	local pad=if data.gamepad~=nil then data.gamepad else Controls.isGamepad(UIS:GetLastInputType())
	self.tutorialPanel.Visible=data.tutorial~=nil and data.phase=="Duel"
	if data.tutorial then
		self.tutorialTitle.Text=data.tutorial.index.." / "..data.tutorial.total.."  "..data.tutorial.title
		self.tutorialPrompt.Text=(if pad then data.tutorial.pad else data.tutorial.key).."  •  "..(if pad then "Touchpad to skip" else "ESC to skip")
	end
	local introActive=data.phase=="Duel" and (data.intro or 0)&gt;0
	self.onlineInfo=data.online
	self.selection.Visible=data.phase=="Selection" or data.phase=="Pick"; self.hud.Visible=data.phase=="Duel" and not introActive; self.result.Visible=data.phase=="Result"
	self.queue.Visible=data.phase=="Queue"
	self.intro.Visible=introActive
	-- Gamepad focus moves only after the matching screen is visible.
	if self.lastPhase~=data.phase then
		GuiService.SelectedObject=if data.phase=="Selection" or data.phase=="Pick" then self.startButton elseif data.phase=="Result" then self.rematchButton
			elseif data.phase=="Queue" then self.cancelButton else nil
		self.lastPhase=data.phase
	end
	if data.phase~="Duel" and data.phase~="Result" then self:lobby(data);return end
	local h,b=data.human,data.bot
	if not h or not b then return end
	if introActive then
		self.introLeftName.Text=fullName(h);self.introLeftTitle.Text=subtitle(h)
		self.introRightName.Text=fullName(b);self.introRightTitle.Text=subtitle(b)
		self.introLeftName.TextColor3=accentOf(Fighters[h.fighterId]);self.introRightName.TextColor3=accentOf(Fighters[b.fighterId])
		self.introRound.Text="PRODIGY TOURNAMENT  —  ROUND "..(data.round or 1)..(if (data.round or 1)&gt;1 and (data.wins and (data.wins.human==1 and data.wins.bot==1)) then "  •  FINAL ROUND" else "")
		self.introBegin.Text=if data.intro&lt;.75 then "始め!  BEGIN" else ""
		if self.introShown~=data.epoch then
			self.introShown=data.epoch
			self.introLeft.Position=UDim2.new(-.5,0,.62,0);self.introRight.Position=UDim2.new(1,0,.62,0)
			Tween:Create(self.introLeft,TweenInfo.new(.45,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Position=UDim2.new(0,0,.62,0)}):Play()
			Tween:Create(self.introRight,TweenInfo.new(.45,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Position=UDim2.new(.5,0,.62,0)}):Play()
		end
		return
	end
	if data.ko and not self.ko.Visible then
		self.ko.TextSize=170
		Tween:Create(self.ko,TweenInfo.new(.35,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{TextSize=120}):Play()
	end
	self.ko.Visible=data.ko==true
	self.round.Text=if data.matchPoint and data.ko then "MATCH" else "ROUND "..(data.round or 1)
	self.hp.name.Text=fullName(h);self.hp.title.Text=subtitle(h).."  •  YOU"
	self.enemy.name.Text=fullName(b);self.enemy.title.Text=(if data.online then string.upper(data.online.opponent or "OPPONENT") else "AI").."  •  "..subtitle(b)
	for _,pair in {{self.hp,h},{self.enemy,b}} do
		local widget,actor=pair[1],pair[2]
		local ratio=math.clamp(actor.health/actor.maxHealth,0,1)
		widget.fill.Size=UDim2.fromScale(ratio,1)
		widget.fill.BackgroundColor3=if ratio&gt;.5 then palette.gold elseif ratio&gt;.25 then Color3.fromRGB(236,134,60) else palette.red
		Tween:Create(widget.lag,TweenInfo.new(.6,Enum.EasingStyle.Quad,Enum.EasingDirection.In,0,false,.25),{Size=UDim2.fromScale(ratio,1)}):Play()
		widget.chakra.Size=UDim2.fromScale(math.clamp(actor.chakra/actor.maxChakra,0,1),1)
		widget.status.Text=string.format("%d / %d",math.ceil(actor.health),actor.maxHealth)
		-- Gentle Fist effects on this fighter.
		if (actor.sealed or 0)&gt;0 then widget.status.Text..=string.format("   •   CHAKRA SEALED %.1fs",actor.sealed)
		elseif (actor.tenketsu or 0)&gt;0 then widget.status.Text..=string.format("   •   CHAKRA POINTS -%d%%%s",actor.tenketsu*15,if actor.tenketsuSevere then "  •  SEALED" else "") end
		local won=if actor==h then (data.wins and data.wins.human or 0) else (data.wins and data.wins.bot or 0)
		for k,m in widget.medals do
			m.Visible=(data.roundsToWin or 1)&gt;1 and k&lt;=(data.roundsToWin or 1)
			m.BackgroundColor3=if k&lt;=won then palette.gold else palette.track
		end
		local charges=actor.subCharges or 0
		for k,pip in widget.pips do
			local level=if k&lt;=charges then 1 elseif k==charges+1 and (actor.subRegen or 0)&gt;0 then 1-math.clamp((actor.subRegen or 0)/9,0,1) else 0
			pip.fill.Size=UDim2.fromScale(1,level)
			pip.fill.BackgroundColor3=if k&lt;=charges then palette.paper else palette.muted
		end
	end
	-- Combo counters with the damage scale of the next hit.
	for _,pair in {{self.comboMine,b},{self.comboTheirs,h}} do
		local widget,victim=pair[1],pair[2]
		local hits=victim.comboHits or 0
		if hits&gt;=2 then
			local scale=math.max(.35,1-.12*math.max(0,hits-1))
			widget.hits.Text=hits.." HITS"
			widget.detail.Text=string.format("%d DMG  •  NEXT x%.2f",math.floor((victim.comboDamage or 0)+.5),scale)
			widget.box.Visible=true
			if hits~=widget.shown then
				widget.shown=hits
				widget.hits.TextSize=64
				Tween:Create(widget.hits,TweenInfo.new(.18,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{TextSize=54}):Play()
			end
		else
			widget.box.Visible=false;widget.shown=0
		end
	end
	self.statusLine.Text=string.format("STAMINA %d   •   SUBSTITUTION %d   •   %s",math.floor(h.stamina or 100),h.subCharges or 0,
		if h.wall then "WALL RUN" elseif h.dodge&gt;0 then string.format("DASH %.1fs",h.dodge) else "DASH READY")
	-- Only decisive moments speak; routine cues stay silent.
	local cue=h.cue or ""
	local loud=cue:find("READ") or cue:find("PARRY") or cue:find("PERFECT") or cue:find("FLYING THUNDER") or cue:find("GUARD BREAK") or cue:find("WALL ")
		or cue:find("CLASH") or cue:find("SUBSTITUTION •") or cue:find("SEAL") or cue:find("COMBO LIMIT") or cue:find("GENJUTSU")
		or cue:find("PALMS") or cue:find("ROTATION") or cue:find("BYAKUGAN") or cue:find("SHARINGAN")
		or cue:find("FLOW") or cue:find("AWAKEN") or cue:find("THROW BREAK") or cue:find("KNOCK AWAY") or cue:find("RIPOSTE")
		-- Caught in wire or sand: the way out must be on screen.
		or cue:find("WIRED") or cue:find("BOUND")
	if loud and pad then cue=UI.padCue(cue) end
	self.cue.Text=if loud then cue else ""
	self.channel.Text=""
	for i,tech in h.techniques do
		local ui=self.techniqueButtons[i]
		ui.box.Visible=true
		ui.key.Text=if pad then Controls.TechniquePad[i] else string.format("%d",i)
		ui.title.Text=string.upper(tech.name)
		local ready=tech.remaining==0 and tech.condition and h.chakra&gt;=tech.cost
		ui.status.Text=if tech.remaining&gt;0 then string.format("%.1fs",tech.remaining) elseif not tech.condition then "NEEDS A SEAL / TARGET" elseif h.chakra&lt;tech.cost then "NEED CHAKRA" else tech.cost.." CHAKRA"
		if tech.id=="Flashstep" and #(h.seals or {})&gt;0 and tech.remaining==0 then
			local count=#(h.seals or {})
			ui.status.Text=count.." SEAL"..(if count&gt;1 then "S" else "").."  •  "..ui.status.Text
		end
		ui.box.BackgroundTransparency=if ready then .05 else .35
		ui.title.TextColor3=if ready then palette.paper else palette.muted
		ui.cool.Size=UDim2.fromScale(1,math.clamp(tech.remaining/6,0,1))
	end
	for i=#h.techniques+1,5 do self.techniqueButtons[i].box.Visible=false end
	local techOpen=h.reaction=="WallSplat" and (h.splatElapsed or 9)&lt;.34
	self.hint.Text=if techOpen then (if pad then "○ — WALL TECH" else "Q — WALL TECH")
		elseif b.reaction=="WallSplat" and h.pursuit&gt;0 then (if pad then "× — PURSUE  •  △ — WALL BOUNCE" else Controls.KeyLabel.Pursuit.." — PURSUE  •  RMB — WALL BOUNCE")
		elseif (h.counter or 0)&gt;0 then (if pad then "□ — COUNTER" else "LMB — COUNTER")
		elseif h.awakenReady then (if pad then "D-PAD ↓ — AWAKEN" else "T — AWAKEN")
		elseif h.wall then (if pad then "× — REBOUND  •  R1 + L1 — DETACH" else "SPACE — REBOUND  •  C — DETACH")
		elseif h.state=="Startup" and h.attackName=="Heavy" then (if pad then "R1 + L2 — FEINT" else "G — FEINT")
		elseif h.reaction=="Grabbed" then (if pad then "L2 — THROW BREAK" else "V — THROW BREAK")
		elseif h.pursuit&gt;0 then (if pad then "× — CHASE" else Controls.KeyLabel.Pursuit.." / SPACE — CHASE")
		elseif (h.combo or 0)&gt;=2 and h.state=="Recovery" and not h.airborne and (h.comboHits or 0)==0 and b.reaction then Controls.comboHelp(MoveGraphs[h.fighterId] or {},pad)
		else ""
	self.help.Text=if pad then Controls.HelpPad else Controls.Help
	self.grammar.Text=Controls.comboHelp(MoveGraphs[h.fighterId] or {},pad)
	local won=data.winner=="PlayerFighter"
	local winner=if won then h else b
	self.resultTitle.Text=(if won then "VICTORY" else "DEFEAT")..(if (data.roundsToWin or 1)&gt;1 and data.wins then string.format("  %d–%d",data.wins.human or 0,data.wins.bot or 0) else "")
	self.resultTitle.TextColor3=if won then palette.gold else palette.crimson
	self.resultName.Text=fullName(winner).."  ADVANCES"
	self.resultNote.Text=if won then "The judges saw it too. The bracket waits for no one." else "Read the commitment. Find a better opening — prodigies learn fastest from defeat."
	-- Online: a rematch needs both players; a forfeit says so.
	local online=data.online
	self.rematchButton.Text=if not online then "REMATCH" elseif online.opponentLeft then "OPPONENT LEFT" elseif online.rematch then "WAITING FOR OPPONENT…"
		elseif online.theirRematch then "REMATCH  •  OPPONENT IS READY" else "REMATCH"
	if online and online.forfeit then
		self.resultTitle.Text=(if won then "VICTORY" else "DEFEAT").."  •  FORFEIT"
		self.resultNote.Text="Your opponent left the duel. The win is yours."
	end
end
return UI
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND55">
          <Properties>
            <string name="Name">VelmoraHitFeedback</string>
            <ProtectedString name="Source">-- Impact presentation. Adapted from Velmora src/client/Combat/HitFeedback.luau
-- (Copyright (c) 2026 Yashveer Singh, MIT), extended with a style hierarchy so
-- small hits, finishers, launchers and slams do not feel identical.
-- Every effect is driven by a server-reported contact, never by a button press.
local Debris=game:GetService("Debris")
local TweenService=game:GetService("TweenService")
local Feedback={}
-- Audio stays on assets already imported and verified by this project; extra
-- cues are declared here so adding one later is a one-line change.
local AUDIO={light="rbxassetid://8595980577",heavy="rbxassetid://9117969717",whiff="rbxassetid://5835032207"}
local LOOPED={}
-- style -&gt; shard count, light range, colour, pitch, volume, tint of the target
local look={
 light   ={shards=5, range=7,  color=Color3.fromRGB(255,214,170),pitch=1.18,volume=.32,hit=Color3.fromRGB(255,238,214)},
 finisher={shards=6, range=9,  color=Color3.fromRGB(255,186,120),pitch=0.94,volume=.42,hit=Color3.fromRGB(255,220,180)},
 launcher={shards=5, range=9,  color=Color3.fromRGB(196,226,255),pitch=0.86,volume=.40,hit=Color3.fromRGB(226,240,255)},
 air     ={shards=6, range=8,  color=Color3.fromRGB(212,232,255),pitch=1.06,volume=.34,hit=Color3.fromRGB(232,244,255)},
 slam    ={shards=9,range=13, color=Color3.fromRGB(255,158,96),pitch=0.72,volume=.52,hit=Color3.fromRGB(255,206,168)},
 block   ={shards=8, range=9,  color=Color3.fromRGB(226,206,150),pitch=1.32,volume=.34,hit=Color3.fromRGB(240,228,190)},
 parry   ={shards=7,range=11, color=Color3.fromRGB(255,244,168),pitch=1.42,volume=.46,hit=Color3.fromRGB(255,250,214)},
 jutsu   ={shards=6,range=11, color=Color3.fromRGB(255,146,92),pitch=0.9, volume=.44,hit=Color3.fromRGB(255,196,150)},
 kunai   ={shards=4, range=6,  color=Color3.fromRGB(206,216,226),pitch=1.34,volume=.26,hit=Color3.fromRGB(230,236,242)},
 shuriken={shards=4, range=6,  color=Color3.fromRGB(198,210,224),pitch=1.5, volume=.24,hit=Color3.fromRGB(230,236,242)},
 dodge   ={shards=5, range=6,  color=Color3.fromRGB(168,206,238),pitch=1.26,volume=.22,hit=Color3.fromRGB(206,226,242)},
 substitute={shards=7,range=8, color=Color3.fromRGB(196,196,214),pitch=1.0, volume=.30,hit=Color3.fromRGB(226,226,240)},
 whiff   ={shards=2, range=4,  color=Color3.fromRGB(176,188,200),pitch=1.6, volume=.14,hit=Color3.fromRGB(200,208,218)},
 landing ={shards=6, range=7,  color=Color3.fromRGB(170,158,132),pitch=0.8, volume=.26,hit=Color3.fromRGB(206,196,172)},
 wall    ={shards=5, range=8,  color=Color3.fromRGB(184,178,158),pitch=0.86,volume=.30,hit=Color3.fromRGB(214,208,186)},
 wallbounce={shards=8,range=12,color=Color3.fromRGB(255,206,150),pitch=0.74,volume=.48,hit=Color3.fromRGB(255,224,190)},
 clash   ={shards=9, range=12, color=Color3.fromRGB(255,240,190),pitch=1.25,volume=.5, hit=Color3.fromRGB(255,250,224)},
 walltech={shards=4, range=6,  color=Color3.fromRGB(206,222,255),pitch=1.3, volume=.22,hit=Color3.fromRGB(226,236,255)},
 pin     ={shards=3, range=5,  color=Color3.fromRGB(220,224,232),pitch=1.5, volume=.22,hit=Color3.fromRGB(236,240,246)},
 ember   ={shards=4, range=7,  color=Color3.fromRGB(255,170,90),pitch=1.1, volume=.26,hit=Color3.fromRGB(255,214,170)},
 palm    ={shards=3, range=6,  color=Color3.fromRGB(196,212,255),pitch=1.3, volume=.26,hit=Color3.fromRGB(226,234,255)},
 flow    ={shards=4, range=7,  color=Color3.fromRGB(214,232,255),pitch=1.45,volume=.3, hit=Color3.fromRGB(236,244,255)},
 awaken  ={shards=8, range=14, color=Color3.fromRGB(255,236,190),pitch=0.7, volume=.5, hit=Color3.fromRGB(255,244,220)},
 palmburst={shards=6,range=10, color=Color3.fromRGB(214,226,255),pitch=0.9, volume=.38,hit=Color3.fromRGB(232,238,255)},
 deflect ={shards=4, range=6,  color=Color3.fromRGB(226,236,255),pitch=1.5, volume=.22,hit=Color3.fromRGB(240,244,255)},
 repel   ={shards=7, range=11, color=Color3.fromRGB(200,216,255),pitch=0.84,volume=.44,hit=Color3.fromRGB(228,236,255)},
 rotation={shards=2, range=10, color=Color3.fromRGB(200,216,255),pitch=0.7, volume=.2, hit=Color3.fromRGB(228,236,255)},
 trigram ={shards=0, range=9,  color=Color3.fromRGB(200,216,255),pitch=0.8, volume=.16,hit=Color3.fromRGB(228,236,255)},
}
local function anchorAt(position)
	local anchor=Instance.new("Part")
	anchor.Name="LocalImpact";anchor.Anchored=true;anchor.CanCollide=false;anchor.CanQuery=false
	anchor.Transparency=1;anchor.Size=Vector3.one;anchor.Position=position;anchor.Parent=workspace
	return anchor
end
local function playSound(parent,id,pitch,volume)
	if not id then return end
	local sound=Instance.new("Sound")
	sound.SoundId=id;sound.Volume=volume or .3;sound.PlaybackSpeed=pitch or 1
	sound.RollOffMaxDistance=120;sound.Parent=parent
	sound:Play()
	Debris:AddItem(sound,2)
end
function Feedback.burst(position,color,damage,blocked)
	local anchor=anchorAt(position)
	local light=Instance.new("PointLight");light.Color=color;light.Brightness=(if blocked then 5 else 3);light.Range=(if blocked then 11 else 8);light.Parent=anchor
	TweenService:Create(light,TweenInfo.new(.2),{Brightness=0}):Play()
	for i=1,(if blocked then 10 else 7) do
		local shard=Instance.new("Part");shard.Anchored=true;shard.CanCollide=false;shard.CanQuery=false;shard.Material=Enum.Material.Neon;shard.Color=color;shard.Size=Vector3.new(.08,.08,math.random(5,11)/10);shard.CFrame=CFrame.lookAt(position,position+Vector3.new(math.random()-0.5,math.random()-0.5,math.random()-0.5));shard.Parent=workspace
		TweenService:Create(shard,TweenInfo.new(.18,Enum.EasingStyle.Quad),{CFrame=shard.CFrame*CFrame.new(0,0,-math.random(2,5)),Transparency=1}):Play();Debris:AddItem(shard,.22)
	end
	if damage and damage&gt;0 then
		local bill=Instance.new("BillboardGui");bill.Size=UDim2.fromOffset(80,40);bill.StudsOffset=Vector3.new(0,2.5,0);bill.AlwaysOnTop=true;bill.Parent=anchor
		local label=Instance.new("TextLabel");label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=1;label.Text=string.format("-%d",math.floor(damage+.5));label.TextColor3=color;label.TextStrokeTransparency=.15;label.Font=Enum.Font.GothamBlack;label.TextScaled=true;label.Parent=bill
		TweenService:Create(bill,TweenInfo.new(.45),{StudsOffset=Vector3.new(0,4.5,0)}):Play();TweenService:Create(label,TweenInfo.new(.45),{TextTransparency=1,TextStrokeTransparency=1}):Play()
	end
	Debris:AddItem(anchor,.55)
end
-- One contact, one coherent reaction. Only the layers the style warrants.
-- Moves that are not a body contact (a dodge, a substitution, a wall tech, a
-- spin) sound like air, never like a punch; flow rides on its "light" entry.
local AIR_CUE={whiff=true,dodge=true,substitute=true,walltech=true,rotation=true,deflect=true}
-- Real contacts without a look of their own keep the generic hit layer.
local CONTACT_FALLBACK={fire=true,fireball=true,chidori=true,groundbounce=true,sandhit=true,sandburst=true,sandburial=true,sandshield=true}
function Feedback.impact(style,position)
	-- Only styles with a contact look get shards and a hit sound. Casts, chases,
	-- fades, sticks and afterimages have their own effects (FX:impact).
	local spec=look[style] or (CONTACT_FALLBACK[style] and look.light)
	if not spec then return end
	local anchor=anchorAt(position)
	local cue=(if style=="light" then "light" elseif AIR_CUE[style] then "whiff" else "heavy")
	if style~="flow" then playSound(anchor,AUDIO[cue],spec.pitch,spec.volume) end
	local light=Instance.new("PointLight")
	light.Color=spec.color;light.Brightness=(if style=="parry" or style=="slam" then 8 else 4)
	light.Range=spec.range;light.Parent=anchor
	TweenService:Create(light,TweenInfo.new(if style=="slam" then .28 else .17),{Brightness=0}):Play()
	local spread=if style=="slam" then 1.1 elseif style=="whiff" then 2.4 else .7
	local distance=if style=="whiff" then 2 else math.max(1.4,spec.range*.32)
	for _=1,spec.shards do
		local direction=Vector3.new(math.random()-0.5,math.random()-0.5,math.random()-0.5)
		if direction.Magnitude&lt;.01 then direction=Vector3.yAxis end
		local shard=Instance.new("Part")
		shard.Anchored=true;shard.CanCollide=false;shard.CanQuery=false;shard.Material=Enum.Material.Neon
		shard.Color=spec.color;shard.Size=Vector3.new(.08,.08,math.random(5,12)/10)
		shard.CFrame=CFrame.lookAt(position,position+direction.Unit)*CFrame.Angles(0,0,math.random()*math.pi)
		shard.Parent=workspace
		local travel=CFrame.new(direction.Unit*(distance*(0.6+math.random()*.8)*spread))
		TweenService:Create(shard,TweenInfo.new(if style=="slam" then .26 else .18,Enum.EasingStyle.Quad),{CFrame=shard.CFrame*travel,Transparency=1}):Play()
		Debris:AddItem(shard,.3)
	end
	if style=="wall" then
		-- Wall dust: a flat puff pushed away from the surface, no screen shake.
		for i=1,7 do
			local puff=Instance.new("Part")
			puff.Anchored=true;puff.CanCollide=false;puff.CanQuery=false
			puff.Material=Enum.Material.Slate;puff.Color=Color3.fromRGB(176,170,152)
			puff.Size=Vector3.new(.3,.3,.3);puff.Transparency=.35
			puff.CFrame=CFrame.new(position+Vector3.new((math.random()-.5)*2,(math.random()-.5)*2,(math.random()-.5)*2))
			puff.Parent=workspace
			TweenService:Create(puff,TweenInfo.new(.32,Enum.EasingStyle.Quad),
				{Size=Vector3.new(1.6,1.6,1.6),Transparency=1}):Play()
			Debris:AddItem(puff,.38)
		end
	end
	if style=="slam" or style=="landing" then
		local ring=Instance.new("Part")
		ring.Anchored=true;ring.CanCollide=false;ring.CanQuery=false;ring.Material=Enum.Material.Neon
		ring.Color=spec.color;ring.Shape=Enum.PartType.Cylinder;ring.Size=Vector3.new(.12,3,3)
		ring.CFrame=CFrame.new(position-Vector3.new(0,2.4,0))*CFrame.Angles(0,0,math.pi/2)
		ring.Transparency=.25;ring.Parent=workspace
		TweenService:Create(ring,TweenInfo.new(.28,Enum.EasingStyle.Quad),{Size=Vector3.new(.12,13,13),Transparency=1}):Play()
		Debris:AddItem(ring,.34)
	end
	Debris:AddItem(anchor,.45)
	return spec
end
-- Hitstop-scaled impulse; the camera reads this instead of re-deriving it.
function Feedback.impulse(style)
	local spec=look[style] or look.light
	return {shake=spec.range/26, fov=(spec.range-6)*.42}
end
return Feedback
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ND56">
          <Properties>
            <string name="Name">VelmoraMotionEngine</string>
            <ProtectedString name="Source">-- Ninja Duel body animation. Started from Velmora's additive R15 layer (MIT) and
-- rebuilt into a full-body authored animation system:
--
--  * the presentation owns every joint it animates (it keeps its own pose state
--    instead of blending against whatever the Animator wrote this frame);
--  * grounded poses place the feet with two-bone leg IK, so stances crouch,
--    lunge and land with planted feet instead of floating or sliding;
--  * attacks, throws, hand signs and reactions are multi-key clips authored with
--    anatomical controls (raise / out / twist / elbow ...), so elbows and knees
--    bend the right way;
--  * locomotion is a real gait: stride, foot lift, pelvis/torso counter-twist,
--    arm swing, and the anime "ninja run" when sprinting or chasing.
--
-- Every joint is damped towards its target with an angular speed limit, so no
-- state change can snap the body. Presentation only: combat authority stays on
-- the server.
local Shared=game:GetService("ReplicatedStorage").NinjaDuel
local Attacks=require(Shared.Attacks)
local Fighters=require(Shared.Fighters)
-- Weapon models come from the VFX module; required lazily so headless tools
-- that only pose skeletons do not need its services.
local Effects=nil
local Motion={}
local rad=math.rad
local CF=CFrame.new
local ANG=CFrame.Angles
local IDENTITY=CFrame.identity

local JOINTS={
	Root={"HumanoidRootPart","Root"},Waist={"LowerTorso","Waist"},Neck={"UpperTorso","Neck"},
	Right={"UpperTorso","RightShoulder"},Left={"UpperTorso","LeftShoulder"},
	RightElbow={"RightUpperArm","RightElbow"},LeftElbow={"LeftUpperArm","LeftElbow"},
	RightWrist={"RightLowerArm","RightWrist"},LeftWrist={"LeftLowerArm","LeftWrist"},
	RightHip={"LowerTorso","RightHip"},LeftHip={"LowerTorso","LeftHip"},
	RightKnee={"RightUpperLeg","RightKnee"},LeftKnee={"LeftUpperLeg","LeftKnee"},
	RightAnkle={"RightLowerLeg","RightAnkle"},LeftAnkle={"LeftLowerLeg","LeftAnkle"},
}
local UPPER={Waist=true,Neck=true,Right=true,Left=true,RightElbow=true,LeftElbow=true,RightWrist=true,LeftWrist=true}

-- ------------------------------------------------------------------ state
local states=setmetatable({},{__mode="k"})
local function stateOf(char)
	local s=states[char]
	if not s then s={motors={},pose={},phase=0,clock=0};states[char]=s end
	return s
end
local function motor(char,key)
	local s=stateOf(char)
	local cached=s.motors[key]
	if cached~=nil then return cached or nil end
	local d=JOINTS[key];local part=char and char:FindFirstChild(d[1]);local m=part and part:FindFirstChild(d[2])
	local found=if m and m:IsA("Motor6D") then m else nil
	-- Only cache a positive lookup: a rig can still be assembling.
	if found then s.motors[key]=found end
	return found
end
-- A simulated presentation clock advanced once per rendered frame: identical on
-- 30 Hz and 120 Hz clients, deterministic in tests.
local elapsedTime=0
function Motion.tick(dt)
	if dt and dt&gt;0 then elapsedTime+=math.min(dt,.1) end
	return elapsedTime
end
function Motion.now() return elapsedTime end

-- Damping rate per layer, and a hard angular speed limit (deg/s) so a sudden
-- target change still travels instead of teleporting.
local RATE={attack=42,throw=32,cast=24,recoil=36,guard=26,defense=26,locomotion=22,air=14,ground=12,wall=16,chase=22,chainIn=26,kick=43}
local KICK_SPEED=1600 -- deg/s cap for a free (kicking) leg during a strike
local CHAIN_IN=.08 -- seconds of a chained strike during which the upper body eases in
local CHAIN_IN_SPEED=800 -- deg/s cap per upper-body joint meanwhile (a strike may whip at 2280)
local MAX_SPEED=1750
local function angleBetween(a,b)
	local _,angle=(a:Inverse()*b):ToAxisAngle()
	return math.abs(angle)
end
-- Write one joint: damp the owned pose towards the target, limit the angular
-- step, then publish it as the Motor6D transform.
local function write(char,key,target,rate,dt)
	local joint=motor(char,key)
	if not joint then return end
	local s=stateOf(char)
	if not dt then s.pose[key]=target;joint.Transform=target;return end
	local current=s.pose[key] or joint.Transform
	local alpha=1-math.exp(-(rate or RATE.locomotion)*dt)
	local nextCF=current:Lerp(target,alpha)
	local step=angleBetween(current,nextCF)
	-- Strikes may whip faster than ordinary motion so their shape reads.
	local limit=rad(if rate==RATE.chainIn then CHAIN_IN_SPEED elseif rate==RATE.kick then KICK_SPEED elseif (rate or 0)&gt;=RATE.attack then 2280 else MAX_SPEED)*dt
	if step&gt;limit and step&gt;1e-6 then nextCF=current:Lerp(nextCF,limit/step) end
	-- Translation (only the Root carries any) is speed-limited too.
	local move=nextCF.Position-current.Position
	local maxMove=14*dt
	if move.Magnitude&gt;maxMove then nextCF=CF(current.Position+move.Unit*maxMove)*nextCF.Rotation end
	s.pose[key]=nextCF
	joint.Transform=nextCF
end
local LEG_SIDE={RightHip="R",RightKnee="R",RightAnkle="R",LeftHip="L",LeftKnee="L",LeftAnkle="L"}
local legIK
local function apply(char,targets,rate,dt,upperRate,legRate)
	local feet=targets.__feet
	for key in JOINTS do
		local side=LEG_SIDE[key]
		if not (feet and side and feet[side]) then
			local r=if upperRate and UPPER[key] then upperRate elseif legRate and side then legRate else rate
			write(char,key,targets[key] or IDENTITY,r,dt)
		end
	end
	if feet then
		-- The hips are damped; a planted foot must not be. Solve each planted leg
		-- against the hips as drawn this frame and set it almost at once.
		local s=stateOf(char)
		local hips=s.pose.Root or targets.Root
		for side,f in feet do
			local prefix=if side=="R" then "Right" else "Left"
			local hip,knee,ankle=legIK(hips,if side=="R" then 1 else -1,f.ankle,f.yaw,f.toe)
			write(char,prefix.."Hip",hip,60,dt);write(char,prefix.."Knee",knee,60,dt);write(char,prefix.."Ankle",ankle,60,dt)
		end
	end
end

-- ------------------------------------------------------------- pose builder
-- Anatomical controls, degrees / studs:
--   root  {x,y,z,pitch,yaw,roll}  pitch + leans forward, yaw + turns right,
--         roll + tilts the top to the right; y &lt; 0 crouches.
--   torso {pitch,yaw,roll}         same conventions, upper body on the hips.
--   head  {pitch,yaw,roll}
--   ra/la {raise,out,twist,elbow,wrist,wroll}  raise + lifts the arm forward,
--         out + away from the body, twist + rotates it inward, elbow + flexes.
--   rf/lf {x,y,z,yaw,toe}  IK foot target offset from the rest ankle (x right,
--         z backwards, y up) for planted feet;
--   rl/ll {lift,out,twist,knee,ankle}  free leg (air, kicks): lift + raises the
--         thigh forward, knee + flexes.
local L1,L2=1.05,1.0
local ANKLE_Y=-2.6 -- rest ankle height relative to HumanoidRootPart centre
local function ori(o)
	if not o then return IDENTITY end
	return ANG(rad(-(o.pitch or 0)),rad(-(o.yaw or 0)),rad(-(o.roll or 0)))
end
local function armCF(side,a)
	a=a or {}
	local shoulder=ANG(rad(a.raise or 0),0,0)*ANG(0,0,rad((a.out or 0)*side))*ANG(0,rad((a.twist or 0)*side),0)
	return shoulder,ANG(rad(a.elbow or 0),0,0),ANG(rad(a.wrist or 0),0,rad((a.wroll or 0)*side))
end
local function legFK(side,l)
	l=l or {}
	return ANG(rad(l.lift or 0),0,0)*ANG(0,0,rad((l.out or 0)*side))*ANG(0,rad((l.twist or 0)*side),0),ANG(rad(-(l.knee or 0)),0,0),ANG(rad(l.ankle or 0),0,0)
end
-- Two-bone IK in the LowerTorso frame: thigh/shin lengths are the rig's real
-- joint spacing; knees point forward (and a little out); the foot stays flat.
function legIK(rootCF,side,ankle,footYaw,toe)
	local hip=rootCF*Vector3.new(.5*side,-.55,0)
	local inv=rootCF.Rotation:Inverse()
	local d=inv*(ankle-hip)
	local u=if d.Magnitude&gt;1e-4 then d.Unit else Vector3.new(0,-1,0)
	local D=math.clamp(d.Magnitude,.45,L1+L2-1e-3)
	local bend=math.pi-math.acos(math.clamp((L1*L1+L2*L2-D*D)/(2*L1*L2),-1,1))
	local a=math.acos(math.clamp((L1*L1+D*D-L2*L2)/(2*L1*D),-1,1))
	local hint=Vector3.new(side*.18,0,-1).Unit
	local w=hint-u*hint:Dot(u)
	if w.Magnitude&lt;1e-3 then w=Vector3.new(0,0,-1) end
	w=w.Unit
	local up=-(u*math.cos(a)+w*math.sin(a))
	local x=w:Cross(up)
	if x.Magnitude&lt;1e-3 then x=Vector3.xAxis end
	x=x.Unit
	local z=x:Cross(up).Unit
	local hipCF=CFrame.fromMatrix(Vector3.zero,x,up,z)
	local kneeCF=ANG(-bend,0,0)
	local foot=(hipCF*kneeCF):Inverse()*inv*ANG(0,rad(-(footYaw or 0)),0)*ANG(rad(toe or 0),0,0)
	return hipCF,kneeCF,foot
end
local function rootCFOf(spec)
	local r=spec.root or {}
	return CF(r.x or 0,r.y or 0,r.z or 0)*ori(r)
end
-- Spec -&gt; joint transforms. Unspecified parts stay at rest.
local function build(spec)
	local out={}
	local rootCF=rootCFOf(spec)
	out.Root=rootCF
	out.Waist=ori(spec.torso)
	out.Neck=ori(spec.head)
	out.Right,out.RightElbow,out.RightWrist=armCF(1,spec.ra)
	out.Left,out.LeftElbow,out.LeftWrist=armCF(-1,spec.la)
	for _,side in {1,-1} do
		local prefix=if side==1 then "Right" else "Left"
		local free=if side==1 then spec.rl else spec.ll
		if free then
			-- A free leg (air, kicks) is posed directly.
			out[prefix.."Hip"],out[prefix.."Knee"],out[prefix.."Ankle"]=legFK(side,free)
		else
			-- Otherwise the foot is planted (at rest unless told where) and the
			-- leg is solved to reach it, whatever the hips are doing.
			local foot=(if side==1 then spec.rf else spec.lf) or {}
			local ankle=Vector3.new(.5*side+(foot.x or 0),ANKLE_Y+(foot.y or 0),foot.z or 0)
			out[prefix.."Hip"],out[prefix.."Knee"],out[prefix.."Ankle"]=legIK(rootCF,side,ankle,foot.yaw,foot.toe)
			-- Remember the planted foot: apply() re-solves the leg against the
			-- hips actually drawn this frame, so the foot stays where it was put.
			out.__feet=out.__feet or {}
			out.__feet[if side==1 then "R" else "L"]={ankle=ankle,yaw=foot.yaw or 0,toe=foot.toe or 0}
		end
	end
	return out
end
local cache=setmetatable({},{__mode="k"})
local function built(spec)
	local c=cache[spec]
	if not c then c=build(spec);cache[spec]=c end
	return c
end
local function blend(a,b,t)
	if t&lt;=0 then return a end
	if t&gt;=1 then return b end
	local out={}
	for key in JOINTS do out[key]=(a[key] or IDENTITY):Lerp(b[key] or IDENTITY,t) end
	local fa,fb=a.__feet,b.__feet
	if fa and fb then
		for _,side in {"R","L"} do
			local x,y=fa[side],fb[side]
			if x and y then
				out.__feet=out.__feet or {}
				out.__feet[side]={ankle=x.ankle:Lerp(y.ankle,t),yaw=x.yaw+(y.yaw-x.yaw)*t,toe=x.toe+(y.toe-x.toe)*t}
			end
		end
	end
	return out
end
-- Deep merge: `over` replaces numeric fields of `base`; tables are merged.
local function merge(base,over)
	local out={}
	for k,v in base do out[k]=if type(v)=="table" then table.clone(v) else v end
	for k,v in over or {} do
		if type(v)=="table" and type(out[k])=="table" and not v.replace then
			for kk,vv in v do out[k][kk]=vv end
		else
			out[k]=if type(v)=="table" then table.clone(v) else v
		end
	end
	return out
end
local function smooth(t) t=math.clamp(t,0,1);return t*t*(3-2*t) end
local function easeOut(t) t=math.clamp(t,0,1);return 1-(1-t)*(1-t)*(1-t) end
local function easeIn(t) t=math.clamp(t,0,1);return t*t*t end
local EASE={smooth=smooth,out=easeOut,["in"]=easeIn,linear=function(t) return math.clamp(t,0,1) end}

-- ---------------------------------------------------------------- stances
-- Minato: light and coiled, lead foot forward, kunai hand low in reverse grip,
-- lead hand open. Itachi: upright and square, economical, left hand ready.
local STANCE={
	Flashstep={root={y=-.42,pitch=9,yaw=24},torso={pitch=5,yaw=-14},head={pitch=-6,yaw=-11},
		ra={raise=34,out=14,twist=24,elbow=98,wrist=-22},la={raise=58,out=2,twist=12,elbow=78,wrist=8},
		rf={x=.22,z=.78,yaw=32},lf={x=-.08,z=-.72,yaw=-4},breath=1.6,tempo=7.5},
	Mirage={root={y=-.2,pitch=3,yaw=14},torso={pitch=2,yaw=-8},head={pitch=1,yaw=-7},
		ra={raise=14,out=9,twist=8,elbow=32,wrist=0},la={raise=42,out=-6,twist=24,elbow=84,wrist=10},
		rf={x=.12,z=.5,yaw=22},lf={x=0,z=-.46,yaw=-2},breath=.7,tempo=5},
}
-- Neji: the Gentle Fist stance. Side-on and low, lead palm extended toward the
-- opponent, rear palm guarding the centre line.
STANCE.GentleFist={root={y=-.62,pitch=6,yaw=38},torso={pitch=4,yaw=-14},head={pitch=-2,yaw=-22},
	la={raise=80,out=-6,twist=-40,elbow=26,wrist=-46},ra={raise=56,out=-30,twist=40,elbow=96,wrist=-36},
	rf={x=.32,z=.92,yaw=64},lf={x=-.18,z=-.95,yaw=-6},breath=.8,tempo=5.5}
-- Sasuke: low and forward, lead hand out, rear hand by the chin, coiled to kick.
STANCE.Lion={root={y=-.5,pitch=10,yaw=30},torso={pitch=6,yaw=-14},head={pitch=-6,yaw=-14},
	la={raise=66,out=6,twist=10,elbow=64,wrist=0},ra={raise=52,out=-16,twist=24,elbow=118,wrist=0},
	rf={x=.26,z=.84,yaw=38},lf={x=-.1,z=-.76,yaw=-6},breath=1.3,tempo=7}
-- Motion families: the character production framework (DEC-015). A fighter
-- names the body language it is built from (stance, gait, clip set), its
-- weapon family and its intro; a new fighter declares `Motion = {body=...,
-- weapons=..., clips=...}` in Fighters instead of silently inheriting Minato.
-- Bespoke stance/clips by its own id still win over the family.
local FAMILY={
	Flashstep={body="Flashstep",weapons="kunai",springy=true},
	Mirage={body="Mirage",weapons="shuriken",springy=false},
	GentleFist={body="GentleFist",weapons="palms",springy=false},
	Lion={body="Lion",weapons="wire",springy=true},
	Sand={body="Sand",weapons="none",springy=false},
}
local function familyOf(id)
	local f=FAMILY[id]
	if f then return f end
	local def=Fighters[id]
	if def and def.Motion then return def.Motion end
	return FAMILY.Flashstep
end
Motion.familyOf=familyOf
-- Gaara: upright and still, arms folded across the chest, feet close. He does
-- not fight with his body: the sand moves, he barely does.
STANCE.Sand={root={y=-.06,pitch=0,yaw=6},torso={pitch=-2,yaw=-2},head={pitch=6,yaw=-4},
	ra={raise=62,out=-42,twist=44,elbow=122,wrist=0},la={raise=58,out=-46,twist=40,elbow=118,wrist=0},
	rf={x=.06,z=.22,yaw=8},lf={x=-.06,z=-.2,yaw=-4},breath=.35,tempo=3.6}
local function stance(id) return STANCE[id] or STANCE[familyOf(id).body] or STANCE.Flashstep end
-- Gait families: springy (Minato, Sasuke) or controlled (Itachi, Neji).
local SPRINGY={Flashstep=true,Lion=true}
local function springy(id)
	local f=familyOf(id)
	if f.springy~=nil then return f.springy end
	return SPRINGY[f.body]==true
end

-- ---------------------------------------------------------- attack clips
-- Keys are placed on the move's own timeline: 0 = start, 1 = end of startup
-- (contact), 2 = end of active, 3 = end of recovery. `w` fades the clip out
-- over the tail of recovery so the body returns into its stance.
local function K(at,pose,ease) return {at=at,pose=pose,ease=ease or "smooth"} end
local M=STANCE.Flashstep
local I=STANCE.Mirage
local function m(over) return merge(M,over) end
local function i(over) return merge(I,over) end
local N=STANCE.GentleFist
local function n(over) return merge(N,over) end
local CLIPS={Flashstep={},Mirage={},GentleFist={},Lion={},Sand={}}
-- Gaara ---------------------------------------------------------------
-- He barely moves: one hand unfolds and flicks the sand out, then folds back.
local G=STANCE.Sand
local function g(over) return merge(G,over) end
