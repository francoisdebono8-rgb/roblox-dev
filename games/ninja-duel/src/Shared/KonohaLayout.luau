-- A base position (x, z) on the minimap: 0..1 across (west to east), 0..1 down (north to south).
function M.toMap(x:number,z:number):Vector2
	return Vector2.new((x+M.HalfX)/(2*M.HalfX),(z-M.MinZ)/(M.MaxZ-M.MinZ))
end
-- The district a base position stands in (the smallest rectangle holding it).
function M.districtAt(x:number,z:number)
	local best,area=nil,math.huge
	for _,d in M.Districts do
		if x>=d.x0 and x<=d.x1 and z>=d.z0 and z<=d.z1 then
			local a=(d.x1-d.x0)*(d.z1-d.z0)
			if a<area then best,area=d,a end
		end
	end
	return best
end
-- The points of interest a minimap shows at a zoom tier (1 = whole village).
function M.poisFor(tier:number)
	local out={}
	for _,p in M.Pois do if p.tier<=tier then table.insert(out,p) end end
	return out
end
return M
