local C=require('../src/Shared/Config')
local P=require('../src/Shared/Profile')
local E=require('../src/Shared/Economy')
local A=require('../src/Shared/Actions')
local count=0
local function test(name,fn) local ok,err=pcall(fn); if not ok then error(name..': '..tostring(err)) end; count+=1; print('PASS '..name) end
local function weapon(id,r,locked,displayed) return {Id=id,Blueprint=1,Rarity=r or 1,Mutation=1,Locked=locked or false,Displayed=displayed or false} end
local function fresh() return P.new(1000) end
for name,list in pairs({rarities=C.Rarities,mutations=C.Mutations}) do test(name..' probability config',function() local sum=0; for _,v in ipairs(list) do assert(v.Weight>=0 and v.Multiplier>=1); sum+=v.Weight end; assert(math.abs(sum-100)<.0001) end) end
test('nonnegative economy and insufficient funds',function() local d=fresh(); assert(not A.upgrade(d,'Value')); assert(not A.zone(d)); assert(d.Coins==0); A.credit(d,-10); assert(d.Coins==0) end)
test('double sell and locked/displayed protection',function() local d=fresh(); d.Inventory={weapon('a'),weapon('b',1,true),weapon('c',1,false,true)}; assert(A.sell(d,'a')); assert(not A.sell(d,'a')); assert(not A.sell(d,'b')); assert(not A.sell(d,'c')); assert(d.Coins==14) end)
test('merge consumes once and preserves first mutation',function() local d=fresh(); d.Inventory={weapon('a'),weapon('b'),weapon('c')}; d.Inventory[1].Mutation=5; assert(A.merge(d,{'a','b','c'},'d')); assert(#d.Inventory==1 and d.Inventory[1].Rarity==2 and d.Inventory[1].Mutation==5); assert(not A.merge(d,{'a','b','c'},'e')) end)
test('merge locked displayed duplicates and wrong rarity rejected',function() for _,mode in ipairs({'Locked','Displayed','Rarity'}) do local d=fresh(); d.Inventory={weapon('a'),weapon('b'),weapon('c')}; d.Inventory[2][mode]=mode=='Rarity' and 2 or true; assert(not A.merge(d,{'a','b','c'},'d')); assert(#d.Inventory==3) end; local d=fresh(); d.Inventory={weapon('a')}; assert(not A.merge(d,{'a','a','a'},'b')) end)
test('cooldown and hammer limit',function() local d=fresh(); assert(A.forge(d,0,math.random,'a')); assert(not A.forge(d,1,math.random,'b')); assert(not A.finish(d,1,math.random)); assert(not A.hammer(d,1)); assert(A.hammer(d,3.6)); assert(not A.hammer(d,3.6)); assert(A.hammer(d,5)); assert(A.hammer(d,6.3)); assert(not A.hammer(d,7)); assert(A.finish(d,8,math.random)); assert(#d.Inventory==1); assert(not A.finish(d,9,math.random)) end)
test('upgrade maximum',function() local d=fresh(); d.Coins=1e10; for _=1,C.Upgrades.Speed.Max do assert(A.upgrade(d,'Speed')) end; local n=d.Coins; assert(not A.upgrade(d,'Speed')); assert(d.Coins==n) end)
test('zone unlock only once per tier',function() local d=fresh(); d.Coins=27500; assert(A.zone(d)); assert(d.Coins==25000 and d.Zone==2); assert(A.zone(d)); assert(d.Coins==0 and d.Zone==3); assert(not A.zone(d)) end)
test('prestige resets documented fields only',function() local d=fresh(); d.Coins=150000; d.Zone=3; d.Collection['1']=true; d.Inventory={weapon('a')}; d.Owned.Starter=true; d.Stats.Forged=7; d.Upgrades.Speed=4; d.Receipts.x=true; assert(A.prestige(d)); assert(d.Coins==0 and d.Zone==1 and #d.Inventory==1 and d.Upgrades.Speed==0); assert(d.Prestige==1 and d.Collection['1'] and d.Owned.Starter and d.Stats.Forged==7 and d.Receipts.x) end)
test('receipt idempotency',function() local d=fresh(); assert(A.receipt(d,'receipt','Small')); local n=d.Coins; assert(A.receipt(d,'receipt','Small')); assert(d.Coins==n); assert(not A.receipt(d,'bad','Missing')) end)
test('load round trip and old schema migration',function() local d=fresh(); d.Coins=133; d.Inventory={weapon('a')}; d.Collection['1']=true; d.Receipts.a=true; local next=P.load(d,2000); assert(next.Coins==133 and #next.Inventory==1 and next.Receipts.a); local old=P.load({Coins=12},2000); assert(old.Schema==C.Schema and old.Coins==12 and old.Upgrades.Speed==0); assert(not pcall(P.load,{Schema=100},2000)) end)
test('corrupt input sanitation and duplicate IDs',function() local d=P.load({Coins=0/0,Inventory={weapon('a'),weapon('a'),{Id='bad',Blueprint=-1}}},1000); assert(d.Coins==0 and #d.Inventory==1) end)
test('offline cap and clock reversal',function() local d=fresh(); d.Inventory={weapon('a',6,false,true)}; assert(E.offline(d,999999)==math.floor(E.income(d)*7200)); assert(E.offline(d,100)==0) end)
test('pass benefit applied once',function() local d=fresh(); assert(A.pass(d,'Starter',1000)); local n=d.Coins; assert(A.pass(d,'Starter',2000)); assert(d.Coins==n and d.LuckUntil==1600); A.pass(d,'DisplaySlots',1000); A.pass(d,'DisplaySlots',1000); assert(E.slots(d)==6) end)
test('nil product IDs safe and coin pack capped',function() local d=fresh(); for _,p in pairs(C.Monetization) do assert(p.Id==nil) end; d.Prestige=100000; d.Zone=3; d.Upgrades.Value=12; d.Upgrades.Speed=12; assert(E.coinPack(d,'Small')==C.Monetization.Small.Cap) end)
test('rack capacity and no merge of rack weapons',function() local d=fresh(); for i=1,5 do table.insert(d.Inventory,weapon(tostring(i))) end; for i=1,4 do assert(A.display(d,tostring(i))) end; assert(not A.display(d,'5')); assert(not A.mergePreview(d)); assert(A.display(d,'1')); assert(A.display(d,'5')) end)
test('inventory cap',function() local d=fresh(); for i=1,E.capacity(d) do table.insert(d.Inventory,weapon(tostring(i))) end; assert(not A.forge(d,0,math.random,'overflow')) end)
test('manual heat gate and perfect timing use server time',function()
 local d=fresh(); assert(A.forge(d,10,math.random,'perfect'))
 local c=d.Craft; assert(not A.hammer(d,c.HeatEnd-.01))
 for hit=0,2 do local ok,perfect=A.hammer(d,c.HeatEnd+c.Duration*.58/3*(hit+.5)); assert(ok and perfect) end
 assert(not A.finish(d,c.Ready-.01,math.random))
 local w=A.finish(d,c.Ready,math.random); assert(w and w.Perfect)
 local base=E.value(d,w); w.Perfect=false; assert(base>E.value(d,w))
end)
test('manual input required and auto receives standard quality',function()
 local d=fresh(); A.forge(d,0,math.random,'manual'); assert(not A.finish(d,99,math.random)); assert(d.Craft)
 d.Craft=nil; assert(A.forge(d,0,math.random,'auto',true)); assert(not A.hammer(d,4)); local w=A.finish(d,8,math.random); assert(w and not w.Perfect)
end)
test('material stock consumed once, locked materials and bad keys rejected',function()
 local d=fresh(); assert(not A.material(d,5)); assert(not A.material(d,0/0)); assert(A.material(d,2)); assert(not A.forge(d,0,math.random,'a')); d.Coins=10; d.Materials.Steel=2
 assert(A.forge(d,0,math.random,'a')); assert(d.Coins==10 and d.Materials.Steel==1); assert(not A.forge(d,0,math.random,'b')); assert(d.Materials.Steel==1); assert(not A.material(d,1))
end)
test('modular fields migrate and survive merge and reload',function()
 local d=fresh(); d.Inventory={weapon('a'),weapon('b'),weapon('c')}; local w=d.Inventory[1]; w.Material=3; w.Blade=3; w.Guard=2; w.Handle=3; w.Secret=true; w.Perfect=true
 assert(A.merge(d,{'a','b','c'},'result')); local loaded=P.load(d,2000); local r=loaded.Inventory[1]
 assert(r.Material==3 and r.Blade==3 and r.Guard==2 and r.Handle==3 and r.Secret and r.Perfect)
 assert(loaded.Discoveries['Rarity:2'] and loaded.Discoveries['Blueprint:1'])
end)
test('collection unlocks durable milestones without repeated rewards',function()
 local B=require('../src/Shared/Collection'); local d=fresh()
 for i=1,9 do B.mark(d,{Blueprint=i,Material=1,Blade=1,Guard=1,Handle=1,Rarity=1,Mutation=1}) end
 local found,total,p=B.progress(d); assert(found<=total and p>=.25 and B.rewards(d).Slots==1); assert(E.slots(d)==5)
 B.mark(d,{Blueprint=1,Rarity=1,Mutation=1}); assert(E.slots(d)==5); local loaded=P.load(d,2000); assert(B.rewards(loaded).Slots==1)
end)
test('starter gift waits for space, locks Rare or Epic, grants once',function()
 local d=fresh(); A.pass(d,'Starter',1000); for i=1,E.capacity(d) do table.insert(d.Inventory,weapon(tostring(i))) end
 assert(not A.claimStarter(d,math.random)); table.remove(d.Inventory)
 local w=A.claimStarter(d,function() return .99 end); assert(w and w.Rarity==4 and w.Locked and not w.Secret)
 assert(not A.claimStarter(d,math.random)); local rejoin=P.load(d,2000); assert(not A.claimStarter(rejoin,math.random))
end)
test('equipped weapon is unique and protected from sell merge display',function()
 local d=fresh(); d.Inventory={weapon('a'),weapon('b'),weapon('c')}; assert(A.equip(d,'a')); assert(d.Equipped=='a')
 assert(not A.sell(d,'a')); assert(not A.display(d,'a')); assert(not A.merge(d,{'a','b','c'},'x')); assert(not A.mergePreview(d))
 assert(A.equip(d,'b')); assert(d.Equipped=='b'); assert(A.equip(d,'b')); assert(d.Equipped==nil)
end)
test('collection zone gate stock cap and two economic properties',function()
 local d=fresh(); assert(not A.collect(d,5,1000)); assert(A.collect(d,1,1000)); assert(d.Materials.Iron==8)
 d.Materials.Iron=C.MaterialCap; assert(not A.collect(d,1,1000))
 local axe={Blueprint=3,Rarity=4,Material=2,Mutation=1}; local scythe={Blueprint=8,Rarity=6,Material=5,Mutation=1}
 assert(E.properties(axe).Mining>E.properties(scythe).Mining)
 local katana={Blueprint=7,Rarity=4,Material=5,Mutation=4}; assert(E.properties(katana).Luck>E.properties(scythe).Luck)
end)
test('coin packs do not fund direct player payments and boost receipts extend once',function()
 local d=fresh(); A.receipt(d,'paid','Small'); assert(d.Coins>0 and d.MarketFunds==0)
 A.credit(d,20); assert(d.MarketFunds==20); A.receipt(d,'resource','ResourceBoost'); local untilTime=d.ResourceUntil
 A.receipt(d,'resource','ResourceBoost'); assert(d.ResourceUntil==untilTime)
end)
test('book preserves first found best roll and all five permanent milestones',function()
 local B=require('../src/Shared/Collection'); local d=fresh(); local w=weapon('first'); w.Material=1; w.FoundAt=1000
 B.mark(d,w,14,1000); local first=d.Book['Blueprint:1']; assert(first.FirstFound==1000 and first.BestValue==14)
 w.Rarity=6; B.mark(d,w,140,1500); assert(first.FirstFound==1000 and first.BestValue==140 and first.Weapon.Rarity==6)
 for i=1,9 do B.mark(d,{Id='catalogue'..i,Blueprint=i,Rarity=(i-1)%6+1,Mutation=(i-1)%5+1,Material=(i-1)%5+1,Perfect=true,Secret=true},100+i,1600) end
 local found,total,p=B.progress(d); assert(p==1 and found==total)
 local rewards=B.rewards(d); assert(rewards.Luck>0 and rewards.Slots==1 and rewards.Skin and rewards.Title and rewards.Master)
 d.Inventory={}; local loaded=P.load(d,2000); assert(loaded.Book['Blueprint:1'].FirstFound==1000 and loaded.Book['Blueprint:1'].BestValue==140)
 loaded.Discoveries={}; assert(B.rewards(loaded).Master,'Earned rewards must survive future catalogue expansion')
end)
test('prestige long-term bonuses and cost cannot inflate exponentially',function()
 local d=fresh(); d.Prestige=100000; assert(E.multiplier(d)<=2); assert(E.prestigeCost(d)>C.PrestigeCost); assert(E.speed(d)>=C.ForgeMinimumSeconds)
end)
print('ALL '..count..' CORE TESTS PASSED')
