<?xml version='1.0' encoding='utf-8'?>
<roblox version="4">
  <Item class="Workspace" referent="WFT1">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <float name="FallenPartsDestroyHeight">-100</float>
    </Properties>
  </Item>
  <Item class="ServerScriptService" referent="WFT2">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="WFT10">
