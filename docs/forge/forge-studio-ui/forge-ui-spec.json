{
  "status": "future-ui-contract",
  "activation_rule": "all_five_functional_v2_complete_and_user_explicitly_opens_ui_programme",
  "breakpoints_px": [
    240,
    320,
    400,
    560
  ],
  "heights_px": [
    360,
    640,
    900
  ],
  "common": {
    "spacing_px": {
      "micro": 4,
      "normal": 8,
      "outer": 12,
      "major": 16,
      "exceptional": 24
    },
    "control_height_px": {
      "min": 30,
      "max": 34
    },
    "interactive_target_min_px": 28,
    "card_radius_px": {
      "min": 4,
      "max": 8
    },
    "border_px": 1,
    "typography_px": {
      "metadata": [
        12,
        13
      ],
      "body": [
        13,
        14
      ],
      "section": [
        14,
        15
      ],
      "work_title": [
        16,
        18
      ],
      "product_title": [
        18,
        20
      ]
    },
    "themes": [
      "Dark",
      "Light"
    ],
    "required_component_states": [
      "rest",
      "hover",
      "pressed",
      "selected",
      "focus",
      "disabled"
    ],
    "required_workflow_states": [
      "empty",
      "draft",
      "preview_ready",
      "stale",
      "blocked",
      "success"
    ],
    "prohibited": [
      "horizontal_form_scroll_at_240",
      "hidden_primary_action",
      "fake_controls",
      "fabricated_values",
      "raw_lua_stack_prefixes",
      "faux_metal_functional_controls",
      "heavy_glow",
      "generic_recolored_clone_layout"
    ]
  },
  "plugins": {
    "PresetForge": {
      "accent": "#D1A348",
      "signature": [
        "recipe_library",
        "recipe_identity",
        "targets",
        "before_after_changes"
      ],
      "primary_flow": [
        "recipe",
        "targets",
        "preview",
        "apply"
      ],
      "preserve": [
        "local_project_semantics",
        "exact_preview_scope",
        "native_undo_redo"
      ]
    },
    "SchemaForge": {
      "accent": "#63D6AE",
      "signature": [
        "contract_context",
        "findings_list",
        "finding_detail",
        "expected_actual",
        "safe_repair"
      ],
      "primary_flow": [
        "contract",
        "audit",
        "finding_detail",
        "preview_repairs",
        "apply_missing_only"
      ],
      "preserve": [
        "explicit_contracts",
        "missing_only_repair",
        "subset_integrity",
        "stale_plan_protection"
      ]
    },
    "CurveForge": {
      "accent": "#4D7DD2",
      "signature": [
        "ordered_points",
        "mode",
        "path_preview"
      ],
      "primary_flow": [
        "path",
        "output_mode",
        "preview",
        "build_or_regenerate"
      ],
      "preserve": [
        "2_to_8_points",
        "cable_repeat",
        "source_preservation",
        "native_undo_redo"
      ]
    },
    "AccessForge": {
      "accent": "#A34BC5",
      "signature": [
        "start_end",
        "industrial_mode",
        "assembly_preview",
        "dimensions"
      ],
      "primary_flow": [
        "mode",
        "endpoints",
        "settings",
        "preview",
        "build_or_regenerate"
      ],
      "preserve": [
        "straight_switchback_catwalk",
        "marker_semantics",
        "user_content_protection",
        "native_undo_redo"
      ]
    },
    "JointForge": {
      "accent": "#D77A3E",
      "signature": [
        "endpoint_relationship",
        "create_batch_inspect",
        "joint_state",
        "operation_preview"
      ],
      "primary_flow": [
        "assign_or_inspect",
        "configure",
        "preview",
        "apply"
      ],
      "preserve": [
        "supported_joint_types",
        "explicit_endpoints",
        "conflict_policy",
        "removal_confirmation",
        "native_undo_redo"
      ]
    }
  }
}
