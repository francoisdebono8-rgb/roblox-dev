        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">Curve</string>
            <string name="Source"><![CDATA[local Curve = {}

function Curve.sample(points)
	assert(#points >= 2 and #points <= 8, "Use 2 to 8 ordered control points.")
	for i, p in ipairs(points) do
		assert(p.X == p.X and p.Y == p.Y and p.Z == p.Z and p.Magnitude < 100000, "Invalid control point position.")
		if i > 1 then assert((p - points[i - 1]).Magnitude >= 0.05, "Adjacent control points must be distinct.") end
	end
	local samples, lengths, total = { points[1] }, { 0 }, 0
	for i = 1, #points - 1 do
		local b, c = points[i], points[i + 1]
		local a, d = points[i - 1] or (2 * b - c), points[i + 2] or (2 * c - b)
		for step = 1, 64 do
			local t = step / 64
			local p = 0.5 * ((2 * b) + (-a + c) * t + (2 * a - 5 * b + 4 * c - d) * t * t + (-a + 3 * b - 3 * c + d) * t * t * t)
			local distance = (p - samples[#samples]).Magnitude
			if distance > 1e-6 then
				total += distance; table.insert(samples, p); table.insert(lengths, total)
			end
		end
	end
	assert(total > 0.05 and total < 10000, "Path length must be between 0.05 and 10000 studs.")
	return { positions = samples, lengths = lengths, length = total }
end

function Curve.at(path, distance)
	distance = math.clamp(distance, 0, path.length)
	local low, high = 2, #path.lengths
	while low < high do
		local mid = math.floor((low + high) / 2)
		if path.lengths[mid] < distance then low = mid + 1 else high = mid end
	end
	local a, b = path.positions[low - 1], path.positions[low]
	return a:Lerp(b, (distance - path.lengths[low - 1]) / (path.lengths[low] - path.lengths[low - 1]))
end

function Curve.frame(path, distance)
	local position = Curve.at(path, distance)
	local direction = (Curve.at(path, math.min(path.length, distance + 0.02)) - Curve.at(path, math.max(0, distance - 0.02))).Unit
	local up = if math.abs(direction:Dot(Vector3.yAxis)) > 0.98 then Vector3.zAxis else Vector3.yAxis
	return CFrame.lookAt(position, position + direction, up)
end

return Curve
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Engine</string>
            <string name="Source"><![CDATA[local Curve = require(script.Parent.Curve)
local Settings = require(script.Parent.Settings)
local Engine = {}

local function sourceParts(source)
	assert(source and source:IsDescendantOf(workspace) and (source:IsA("BasePart") or source:IsA("Model")), "Choose one source Part or Model in Workspace.")
	local parts = 0
	local all = source:GetDescendants(); table.insert(all, source)
	for _, item in ipairs(all) do
		assert(item.Archivable, "Source and descendants must be Archivable.")
		assert(not item:IsA("LuaSourceContainer"), "Repeated sources must not contain scripts.")
		if item:IsA("BasePart") then parts += 1 end
		if item:IsA("JointInstance") or item:IsA("WeldConstraint") or item:IsA("NoCollisionConstraint") then
			for _, p in pairs({ item.Part0, item.Part1 }) do assert(p == source or p:IsDescendantOf(source), "Source has a joint to an external object.") end
		elseif item:IsA("Constraint") then
			for _, a in pairs({ item.Attachment0, item.Attachment1 }) do assert(a:IsDescendantOf(source), "Source has an external attachment.") end
		elseif item:IsA("ObjectValue") and item.Value then
			assert(item.Value == source or item.Value:IsDescendantOf(source), "Source has an external object reference.")
		end
	end
	assert(parts > 0 and #all <= 1000, "Source must contain parts and at most 1000 instances.")
	return parts, #all
end

function Engine.plan(controls, settings, source, rotation)
	local config, positions, seen = Settings.validate(settings), {}, {}
	assert(#controls >= 2 and #controls <= 8, "Assign 2 to 8 ordered BaseParts.")
	for _, part in ipairs(controls) do
		assert(typeof(part) == "Instance" and part:IsA("BasePart") and part:IsDescendantOf(workspace), "A control point is invalid or was deleted.")
		assert(not seen[part], "Duplicate control point."); seen[part] = true
		table.insert(positions, part.Position)
	end
	local path = Curve.sample(positions)
	local plan = { controls = table.clone(controls), positions = positions, settings = config, path = path, source = source, distances = {} }
	if config.Mode == "Cable" then
		local count = math.ceil(path.length / config.SegmentLength)
		assert(count <= 512, "More than 512 segments. Increase segment length.")
		for i = 0, count do table.insert(plan.distances, path.length * i / count) end
	else
		local _, instances = sourceParts(source)
		plan.sourcePivot = source:GetPivot()
		plan.rotation = rotation or (Curve.frame(path, 0).Rotation:Inverse() * plan.sourcePivot.Rotation)
		assert(typeof(plan.rotation) == "CFrame", "Invalid rotation metadata.")
		if config.Distribution == "Count" then
			for i = 1, config.Count do
				local t = if config.Endpoints then (i - 1) / (config.Count - 1) else i / (config.Count + 1)
				table.insert(plan.distances, path.length * t)
			end
		else
			local count = math.floor(path.length / config.Spacing)
			assert(count <= 500, "More than 500 copies. Increase spacing.")
			if config.Endpoints then table.insert(plan.distances, 0) end
			for i = 1, count do
				if i * config.Spacing < path.length - 1e-5 then table.insert(plan.distances, i * config.Spacing) end
			end
			if config.Endpoints then table.insert(plan.distances, path.length) end
		end
		assert(#plan.distances > 0 and #plan.distances <= 500, "Spacing produces no copies or exceeds 500 copies.")
		assert(instances * #plan.distances <= 5000, "Output exceeds 5000 instances. Reduce copies or source complexity.")
	end
	return plan
end

function Engine.check(plan)
	assert(not plan.used, "Preview again before building.")
	for i, part in ipairs(plan.controls) do
		assert(part:IsDescendantOf(workspace) and part.Position == plan.positions[i], "Control points changed. Preview again.")
	end
	if plan.settings.Mode == "Repeat" then sourceParts(plan.source); assert(plan.source:GetPivot() == plan.sourcePivot, "Source moved. Preview again.") end
end

function Engine.output(plan)
	local output = Instance.new("Model"); output.Name = "Output"
	local ok, err = pcall(function()
		local s = plan.settings
		if s.Mode == "Cable" then
			local function part(name, shape, size, cf)
				local p = Instance.new("Part")
				p.Name, p.Shape, p.Size, p.CFrame = name, shape, size, cf
				p.Color, p.Material = s.Color, Enum.Material[s.Material]
				p.Anchored, p.CanCollide, p.CastShadow = s.Anchored, s.CanCollide, s.CastShadow
				p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
				p.Parent = output
			end
			for i = 2, #plan.distances do
				local a, b = Curve.at(plan.path, plan.distances[i - 1]), Curve.at(plan.path, plan.distances[i])
				assert((b - a).Magnitude >= 0.001, "Degenerate segment. Adjust control points or density.")
				local direction = (b - a).Unit
				local up = if math.abs(direction:Dot(Vector3.yAxis)) > 0.98 then Vector3.zAxis else Vector3.yAxis
				part(string.format("Segment%03d", i - 1), Enum.PartType.Cylinder, Vector3.new((b - a).Magnitude, s.Diameter, s.Diameter), CFrame.lookAt((a + b) / 2, b, up) * CFrame.Angles(0, math.pi / 2, 0))
				if i < #plan.distances then part(string.format("Joint%03d", i - 1), Enum.PartType.Ball, Vector3.one * s.Diameter, CFrame.new(b)) end
			end
		else
			for i, distance in ipairs(plan.distances) do
				local clone = plan.source:Clone()
				clone.Name = string.format("Copy%03d", i); clone.Parent = output
				local cf = Curve.frame(plan.path, distance)
				if s.Orient then
					if s.PreserveRotation then cf *= plan.rotation end
				else cf = CFrame.new(cf.Position) * plan.sourcePivot.Rotation end
				clone:PivotTo(cf)
			end
		end
	end)
	if not ok then output:Destroy(); error(err) end
	return output
end

function Engine.metadata(plan)
	local data = Instance.new("Folder"); data.Name = "CurveForgeData"
	data:SetAttribute("Version", 1)
	for key, value in pairs(plan.settings) do data:SetAttribute(key, value) end
	data:SetAttribute("RotationOffset", plan.rotation or CFrame.identity)
	for i, control in ipairs(plan.controls) do
		local ref = Instance.new("ObjectValue"); ref.Name = tostring(i); ref.Value = control; ref.Parent = data
	end
	local source = Instance.new("ObjectValue"); source.Name = "Source"; source.Value = plan.source; source.Parent = data
	return data
end

function Engine.load(model)
	assert(model and model:IsA("Model") and model:IsDescendantOf(workspace), "Select one generated CurveForge Model.")
	local data, output = model:FindFirstChild("CurveForgeData"), model:FindFirstChild("Output")
	assert(data and data:IsA("Folder") and data:GetAttribute("Version") == 1 and output and output:IsA("Model"), "Not a supported CurveForge model.")
	local controls, settings = {}, {}
	for key in pairs(Settings.defaults) do settings[key] = data:GetAttribute(key) end
	for i = 1, 8 do
		local ref = data:FindFirstChild(tostring(i))
		if ref then assert(ref:IsA("ObjectValue") and ref.Value, "A saved control point was deleted."); table.insert(controls, ref.Value) end
	end
	local source = data:FindFirstChild("Source")
	assert(source and source:IsA("ObjectValue"), "Invalid source metadata.")
	local rotation = data:GetAttribute("RotationOffset")
	local plan = Engine.plan(controls, settings, source.Value, rotation)
	return plan, data, output
end

function Engine.apply(plan, history, target)
	assert(not game:GetService("RunService"):IsRunning(), "Stop simulation before building.")
	Engine.check(plan)
	local oldData, oldOutput
	if target then
		local _; _, oldData, oldOutput = Engine.load(target)
		for _, p in ipairs(plan.controls) do assert(not p:IsDescendantOf(target), "Control points cannot be inside the output being replaced.") end
		assert(not plan.source or not plan.source:IsDescendantOf(target), "Source cannot be inside the output being replaced.")
	end
	local output, data = Engine.output(plan), Engine.metadata(plan)
	local id = history:TryBeginRecording("CurveForge", if target then "Regenerate CurveForge" else "Build CurveForge")
	if not id then output:Destroy(); data:Destroy(); error("Undo recording unavailable. Finish the other operation and retry.") end
	local model = target or Instance.new("Model")
	local ok, err = pcall(function()
		if not target then model.Name = "CurveForge_" .. plan.settings.Mode end
		if oldOutput then oldOutput.Parent = nil; oldData.Parent = nil end
		output.Parent, data.Parent = model, model
		if not target then model.Parent = workspace end
		history:FinishRecording(id, Enum.FinishRecordingOperation.Commit)
	end)
	if not ok then
		output:Destroy(); data:Destroy()
		if target then oldOutput.Parent, oldData.Parent = target, target else model:Destroy() end
		pcall(function() history:FinishRecording(id, Enum.FinishRecordingOperation.Cancel) end)
		error(err)
	end
	plan.used = true
	return model
end

function Engine.newPath(history, origin)
	assert(not game:GetService("RunService"):IsRunning(), "Stop simulation before editing.")
	local id = history:TryBeginRecording("CurveForgeMarkers", "New CurveForge path")
	assert(id, "Undo recording unavailable.")
	local folder, controls = Instance.new("Folder"), {}
	folder.Name = "CurveForge_Controls"
	local ok, err = pcall(function()
		for i, offset in ipairs({ Vector3.new(-12, 0, 0), Vector3.new(-4, 3, 0), Vector3.new(4, 3, 4), Vector3.new(12, 0, 4) }) do
			local p = Instance.new("Part"); p.Name = string.format("Point%02d", i); p.Shape = Enum.PartType.Ball
			p.Size, p.Position = Vector3.one * 0.8, origin + offset
			p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = true, false, false, true, false
			p.Color, p.Transparency = Color3.fromRGB(251, 199, 77), 0.4; p.Parent = folder
			table.insert(controls, p)
		end
		folder.Parent = workspace
		history:FinishRecording(id, Enum.FinishRecordingOperation.Commit)
	end)
	if not ok then folder:Destroy(); pcall(function() history:FinishRecording(id, Enum.FinishRecordingOperation.Cancel) end); error(err) end
	return controls
end

return Engine
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Settings</string>
            <string name="Source"><![CDATA[local Settings = {}
Settings.defaults = { Mode = "Cable", Diameter = 0.4, SegmentLength = 1, Color = Color3.fromRGB(52, 179, 161), Material = "SmoothPlastic", Anchored = true, CanCollide = false, CastShadow = true, Distribution = "Spacing", Spacing = 3, Count = 12, Orient = true, PreserveRotation = true, Endpoints = true }
Settings.materials = { "SmoothPlastic", "Plastic", "Metal", "DiamondPlate", "Wood", "Concrete", "Neon", "Glass" }
local bounds = { Diameter = { 0.05, 50 }, SegmentLength = { 0.1, 100 }, Spacing = { 0.1, 1000 }, Count = { 2, 500 } }
function Settings.validate(settings)
	local result = {}
	for key, default in pairs(Settings.defaults) do
		local value = settings[key]
		assert(typeof(value) == typeof(default), "Invalid setting: " .. key)
		if bounds[key] then
			assert(value == value and value >= bounds[key][1] and value <= bounds[key][2], key .. " outside supported range " .. bounds[key][1] .. " to " .. bounds[key][2])
		end
		result[key] = value
	end
	assert(result.Count % 1 == 0, "Count must be a whole number.")
	assert(result.Mode == "Cable" or result.Mode == "Repeat", "Unsupported output mode.")
	assert(result.Distribution == "Spacing" or result.Distribution == "Count", "Unsupported distribution.")
	assert(table.find(Settings.materials, result.Material), "Unsupported material.")
	for _, v in ipairs({ result.Color.R, result.Color.G, result.Color.B }) do assert(v == v and v >= 0 and v <= 1, "Invalid color.") end
	return result
end
return Settings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">View</string>
            <string name="Source"><![CDATA[local Engine = require(script.Parent.Engine)
local Settings = require(script.Parent.Settings)
local View = {}
local colors = { bg = Color3.fromRGB(30, 32, 35), panel = Color3.fromRGB(47, 51, 56), text = Color3.fromRGB(238, 241, 243), muted = Color3.fromRGB(174, 183, 194), accent = Color3.fromRGB(40, 149, 132), error = Color3.fromRGB(255, 153, 126) }
local function el(class, parent, props)
	local item = Instance.new(class)
	for key, value in pairs(props) do item[key] = value end
	item.Parent = parent; return item
end
local function stack(parent)
	el("UIListLayout", parent, { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder })
end
local function label(parent, text, size, color)
	return el("TextLabel", parent, { Text = text, Font = Enum.Font.SourceSans, TextSize = size or 15, TextColor3 = color or colors.text, BackgroundTransparency = 1, Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left })
end
local function button(parent, text, callback, accent)
	local b = el("TextButton", parent, { Name = text, Text = text, Font = Enum.Font.SourceSansSemibold, TextSize = 15, TextWrapped = true, TextColor3 = colors.text, BackgroundColor3 = accent and colors.accent or colors.panel, BorderSizePixel = 0, Size = UDim2.new(1, -6, 0, 30) })
	b.Activated:Connect(callback); return b
end
local function row(parent, count)
	local r = el("Frame", parent, { BackgroundTransparency = 1, Size = UDim2.new(1, -6, 0, 30) })
	el("UIGridLayout", r, { CellSize = UDim2.new(1 / count, -5, 1, 0), CellPadding = UDim2.fromOffset(5, 0), SortOrder = Enum.SortOrder.LayoutOrder })
	return r
end

function View.mount(widget, selection, history)
	local state = { controls = {}, settings = table.clone(Settings.defaults), confirmed = false, message = "", watches = {} }
	local root = el("Frame", widget, { Name = "CurveForgeUI", BackgroundColor3 = colors.bg, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1) })
	local body = el("ScrollingFrame", root, { Name = "Workflow", Position = UDim2.fromOffset(12, 10), Size = UDim2.new(1, -24, 1, -20), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 5, BackgroundTransparency = 1, BorderSizePixel = 0 })
	local render, watch, preview
	local disposed, generation = false, 0
	local function invalidate() state.plan = nil end
	local function act(fn)
		return function()
			state.message = ""; state.failed = false
			local ok, err = pcall(fn)
			if not ok then state.message = tostring(err); state.failed = true end
			render()
		end
	end
	preview = function()
		assert(state.confirmed, "Confirm the displayed point order first.")
		state.plan = Engine.plan(state.controls, state.settings, state.source, state.rotation)
		state.message = string.format("%.1f studs | %d %s", state.plan.path.length, #state.plan.distances - (state.settings.Mode == "Cable" and 1 or 0), state.settings.Mode == "Cable" and "segments" or "copies")
	end
	local function changed()
		invalidate(); generation += 1
		local stamp = generation
		task.delay(0.2, function()
			if disposed or stamp ~= generation then return end
			if state.confirmed then
				local ok, err = pcall(preview)
				state.failed = not ok; if not ok then state.message = tostring(err) end
			end
			render()
		end)
	end
	watch = function()
		for _, c in ipairs(state.watches) do c:Disconnect() end
		state.watches = {}
		for _, p in ipairs(state.controls) do
			table.insert(state.watches, p:GetPropertyChangedSignal("CFrame"):Connect(changed))
			table.insert(state.watches, p.AncestryChanged:Connect(changed))
		end
		if state.source then
			local list = state.source:GetDescendants(); table.insert(list, state.source)
			for _, p in ipairs(list) do table.insert(state.watches, p.Changed:Connect(changed)) end
			table.insert(state.watches, state.source.DescendantAdded:Connect(function() watch(); changed() end))
			table.insert(state.watches, state.source.DescendantRemoving:Connect(changed))
		end
	end
	local function input(parent, key, title)
		local r = row(parent, 2); label(r, title, 14, colors.muted)
		local box = el("TextBox", r, { Name = key, Text = tostring(state.settings[key]), ClearTextOnFocus = false, Font = Enum.Font.Code, TextSize = 14, TextColor3 = colors.text, BackgroundColor3 = colors.panel, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1) })
		box:GetPropertyChangedSignal("Text"):Connect(invalidate)
		box.FocusLost:Connect(act(function()
			state.settings[key] = tonumber(box.Text) or box.Text
			if state.confirmed then preview() end
		end))
	end
	local function toggle(parent, key, title)
		button(parent, (state.settings[key] and "[x] " or "[ ] ") .. title, act(function()
			state.settings[key] = not state.settings[key]; invalidate(); if state.confirmed then preview() end
		end))
	end
	local function choose(parent, key, options)
		local r = row(parent, #options)
		for _, option in ipairs(options) do
			button(r, option, act(function() state.settings[key] = option; invalidate(); if state.confirmed then preview() end end), state.settings[key] == option)
		end
	end
	local function viewport(plan)
		local view = el("ViewportFrame", body, { Name = "Preview", Size = UDim2.new(1, -6, 0, 180), BackgroundColor3 = Color3.fromRGB(21, 25, 29), BorderSizePixel = 0, Ambient = Color3.fromRGB(190, 190, 190), LightDirection = Vector3.new(-1, -2, -1) })
		local world = Instance.new("WorldModel"); world.Parent = view
		local model = Engine.output(plan); model.Parent = world
		local cf, size = model:GetBoundingBox()
		local camera = Instance.new("Camera"); camera.FieldOfView = 45
		camera.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0.4, 0.5, 1).Unit * math.max(size.Magnitude * 1.6, 4), cf.Position)
		camera.Parent = view; view.CurrentCamera = camera
	end
	render = function()
		if disposed then return end
		local scroll = body.CanvasPosition
		body:ClearAllChildren(); stack(body)
		label(body, "CurveForge  /  1.0", 22)
		if state.message ~= "" then label(body, state.message, 14, state.failed and colors.error or colors.muted) end
		label(body, "PATH", 15, colors.accent)
		local actions = row(body, 2)
		button(actions, "New Path", act(function()
			local camera = workspace.CurrentCamera
			state.controls = Engine.newPath(history, camera and (camera.CFrame.Position + camera.CFrame.LookVector * 25) or Vector3.new(0, 5, 0))
			state.confirmed, state.target, state.rotation = true, nil, nil
			watch(); preview(); selection:Set(state.controls)
		end))
		button(actions, "Use selected points", act(function()
			local list = selection:Get()
			assert(#list >= 2 and #list <= 8, "Select 2 to 8 BaseParts.")
			for _, p in ipairs(list) do assert(p:IsA("BasePart") and p:IsDescendantOf(workspace), "Select BaseParts in Workspace only.") end
			state.controls, state.confirmed, state.target, state.rotation = table.clone(list), false, nil, nil
			invalidate(); watch()
		end))
		for i, p in ipairs(state.controls) do
			local r = row(body, 4)
			local pointButton = button(r, tostring(i) .. ". " .. p.Name, act(function() selection:Set({ p }) end))
			pointButton.TextWrapped = false; pointButton.TextTruncate = Enum.TextTruncate.AtEnd
			button(r, "Up", act(function() if i > 1 then state.controls[i], state.controls[i - 1] = state.controls[i - 1], p end; state.confirmed = false; state.rotation = nil; invalidate() end))
			button(r, "Down", act(function() if i < #state.controls then state.controls[i], state.controls[i + 1] = state.controls[i + 1], p end; state.confirmed = false; state.rotation = nil; invalidate() end))
			button(r, "Remove", act(function() table.remove(state.controls, i); state.confirmed = false; invalidate(); watch() end))
		end
		if #state.controls > 0 and not state.confirmed then button(body, "Confirm displayed order", act(function() state.confirmed = true; preview() end), true) end
		label(body, "OUTPUT MODE", 15, colors.accent); choose(body, "Mode", { "Cable", "Repeat" })
		label(body, "SETTINGS", 15, colors.accent)
		if state.settings.Mode == "Cable" then
			input(body, "Diameter", "Diameter (studs)"); input(body, "SegmentLength", "Segment length")
			local swatches = row(body, 6)
			for _, rgb in ipairs({ {52,179,161}, {61,65,73}, {234,187,65}, {221,91,73}, {199,206,211}, {69,139,213} }) do
				local color = Color3.fromRGB(unpack(rgb))
				local b = button(swatches, "", act(function() state.settings.Color = color; invalidate(); if state.confirmed then preview() end end))
				b.BackgroundColor3 = color
			end
			local c = state.settings.Color
			local rgb = el("TextBox", body, { Name = "ColorRGB", Text = string.format("%d, %d, %d", math.round(c.R * 255), math.round(c.G * 255), math.round(c.B * 255)), PlaceholderText = "R, G, B", ClearTextOnFocus = false, Font = Enum.Font.Code, TextSize = 14, TextColor3 = colors.text, BackgroundColor3 = colors.panel, BorderSizePixel = 0, Size = UDim2.new(1, -6, 0, 28) })
			rgb:GetPropertyChangedSignal("Text"):Connect(invalidate)
			rgb.FocusLost:Connect(act(function()
				local r, g, b = rgb.Text:match("^%s*(%d+)%s*,%s*(%d+)%s*,%s*(%d+)%s*$")
				assert(r and tonumber(r) <= 255 and tonumber(g) <= 255 and tonumber(b) <= 255, "Color requires R, G, B values from 0 to 255.")
				state.settings.Color = Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b)); if state.confirmed then preview() end
			end))
			button(body, "Material: " .. state.settings.Material, act(function() state.materialMenu = not state.materialMenu end))
			if state.materialMenu then
				for _, material in ipairs(Settings.materials) do button(body, material, act(function() state.settings.Material = material; state.materialMenu = false; invalidate(); if state.confirmed then preview() end end)) end
			end
			local toggles = row(body, 3); toggle(toggles, "Anchored", "Anchored"); toggle(toggles, "CanCollide", "Collide"); toggle(toggles, "CastShadow", "Shadow")
		else
			button(body, "Source: " .. (state.source and state.source.Name or "Choose selection"), act(function()
				local list = selection:Get(); assert(#list == 1, "Select one source Part or Model.")
				state.source, state.rotation = list[1], nil; watch(); invalidate(); if state.confirmed then preview() end
			end))
			choose(body, "Distribution", { "Spacing", "Count" })
			input(body, state.settings.Distribution, state.settings.Distribution == "Spacing" and "Spacing (studs)" or "Copy count")
			toggle(body, "Orient", "Tangent orientation"); toggle(body, "PreserveRotation", "Preserve local rotation offset"); toggle(body, "Endpoints", "Include endpoints")
		end
		label(body, "PREVIEW / BUILD", 15, colors.accent)
		if state.plan then
			local ok, err = pcall(viewport, state.plan)
			if not ok then invalidate(); label(body, tostring(err), 14, colors.error) end
		end
		local actions2 = row(body, 2)
		button(actions2, "Preview", act(preview))
		button(actions2, state.target and "Regenerate" or "Build", act(function()
			assert(state.plan, "Preview a valid path first.")
			local model = Engine.apply(state.plan, history, state.target)
			state.target, state.rotation = model, state.plan.rotation
			invalidate(); selection:Set({ model }); state.message = "Complete. Studio Undo restores the previous state."
		end), true)
		label(body, "EDIT EXISTING", 15, colors.accent)
		button(body, "Edit Selected CurveForge Model", act(function()
			local list = selection:Get(); assert(#list == 1, "Select one CurveForge output model.")
			local plan = Engine.load(list[1])
			state.controls, state.settings, state.source, state.rotation = plan.controls, plan.settings, plan.source, plan.rotation
			state.target, state.confirmed, state.plan = list[1], true, plan
			watch(); state.message = "Loaded: " .. list[1].Name
		end))
		body.CanvasPosition = scroll
	end
	render()
	return function() disposed = true; for _, c in ipairs(state.watches) do c:Disconnect() end; root:Destroy() end
end
return View
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Suite</string>
          <string name="Source"><![CDATA[return function(modules)
	local Engine, Curve, Settings = require(modules.Engine), require(modules.Curve), require(modules.Settings)
	local history = game:GetService("ChangeHistoryService")
	assert(not game:GetService("RunService"):IsRunning(), "Execute in edit mode.")
	local passed, failed, fixture, generated = 0, 0, nil, {}
	local function part(position, name)
		local p = Instance.new("Part"); p.Name = name or "Control"; p.Position = position; p.Anchored = true; p.Parent = fixture; return p
	end
	local function controls(positions)
		local result = {}; for _, p in ipairs(positions) do table.insert(result, part(p)) end; return result
	end
	local function settings(extra)
		local s = table.clone(Settings.defaults); for k, v in pairs(extra or {}) do s[k] = v end; return s
	end
	local function reject(fn) assert(not pcall(fn), "Expected safe rejection") end
	local function apply(plan, target)
		history:SetWaypoint("CurveForge fixture baseline")
		local model = Engine.apply(plan, history, target); if not target then table.insert(generated, model) end; return model
	end
	local function test(name, fn)
		fixture = Instance.new("Folder"); fixture.Name = "CurveForgeTestFixture"; fixture.Parent = workspace
		local ok, err = pcall(fn)
		if ok then passed += 1; print("[CurveForgeTests][PASS] " .. name) else failed += 1; warn("[CurveForgeTests][FAIL] " .. name .. ": " .. tostring(err)) end
		fixture:Destroy(); for _, m in ipairs(generated) do m:Destroy() end; generated = {}
	end
	test("2-point straight path / endpoints / read-only preview", function()
		local c = controls({ Vector3.zero, Vector3.new(20, 0, 0) }); local before = #workspace:GetDescendants()
		local plan = Engine.plan(c, settings()); assert(math.abs(plan.path.length - 20) < 0.001)
		assert(Curve.at(plan.path, 0) == c[1].Position and Curve.at(plan.path, 20) == c[2].Position)
		local output = Engine.output(plan); assert(output.Parent == nil and #workspace:GetDescendants() == before); output:Destroy()
	end)
	test("4-point curved path / controls interpolated", function()
		local c = controls({ Vector3.zero, Vector3.new(5, 8, 0), Vector3.new(12, 2, 4), Vector3.new(20, 4, 0) })
		local plan = Engine.plan(c, settings()); assert(plan.path.length > 20)
		for _, p in ipairs(c) do local found = false; for _, v in ipairs(plan.path.positions) do if (p.Position - v).Magnitude < 1e-4 then found = true end end; assert(found) end
	end)
	test("vertical and 3D orientation / cable gap continuity / collision flags", function()
		local c = controls({ Vector3.zero, Vector3.new(0, 10, 0), Vector3.new(8, 15, 7), Vector3.new(10, 20, 2) })
		for _, collide in ipairs({ true, false }) do
			local plan = Engine.plan(c, settings({ CanCollide = collide, CastShadow = false }))
			local output = Engine.output(plan)
			for i = 1, #plan.distances - 1 do
				local p = output:FindFirstChild(string.format("Segment%03d", i)); assert(p and p.CanCollide == collide and not p.CastShadow)
				local a, b = Curve.at(plan.path, plan.distances[i]), Curve.at(plan.path, plan.distances[i + 1])
				local tip1, tip2 = p.CFrame:PointToWorldSpace(Vector3.new(p.Size.X / 2, 0, 0)), p.CFrame:PointToWorldSpace(Vector3.new(-p.Size.X / 2, 0, 0))
				assert(math.min((tip1 - a).Magnitude, (tip2 - a).Magnitude) < 1e-4)
				assert(math.min((tip1 - b).Magnitude, (tip2 - b).Magnitude) < 1e-4)
				if i < #plan.distances - 1 then local joint = output:FindFirstChild(string.format("Joint%03d", i)); assert((joint.Position - b).Magnitude < 1e-4 and joint.Size.Y == p.Size.Y) end
			end
			output:Destroy()
		end
	end)
	test("repeat spacing / count / endpoints / scale / tangent rotation", function()
		local c = controls({ Vector3.zero, Vector3.new(20, 0, 0) })
		local source = part(Vector3.new(30, 2, 0), "Source"); source.Size = Vector3.new(1, 3, 2); source.CFrame *= CFrame.Angles(0, 0.3, 0)
		for _, config in ipairs({ { Mode = "Repeat", Spacing = 5 }, { Mode = "Repeat", Distribution = "Count", Count = 7, Endpoints = false }, { Mode = "Repeat", Distribution = "Count", Count = 3, Orient = false }, { Mode = "Repeat", Spacing = 5, PreserveRotation = false } }) do
			local plan = Engine.plan(c, settings(config), source); local output = Engine.output(plan)
			assert(#output:GetChildren() == (config.Count or 5))
			for i, d in ipairs(plan.distances) do
				local copy = output:FindFirstChild(string.format("Copy%03d", i)); assert(copy.Size == source.Size and (copy.Position - Curve.at(plan.path, d)).Magnitude < 1e-4)
				if not plan.settings.Orient or plan.settings.PreserveRotation then assert(copy.CFrame.Rotation:FuzzyEq(source.CFrame.Rotation, 1e-4)) else assert(copy.CFrame.LookVector:Dot(Vector3.xAxis) > 0.999) end
			end
			if not plan.settings.Endpoints then assert(plan.distances[1] > 0 and plan.distances[#plan.distances] < 20) end
			output:Destroy()
		end
	end)
	test("Build native one-step Undo / Redo / unrelated objects preserved", function()
		local c = controls({ Vector3.zero, Vector3.new(20, 0, 0) }); local other = part(Vector3.new(90, 5, 0)); local cf = other.CFrame
		local model = apply(Engine.plan(c, settings())); assert(model.Parent == workspace)
		history:Undo(); task.wait(); assert(model.Parent == nil and other.Parent == fixture and other.CFrame == cf and c[1].Parent == fixture)
		history:Redo(); task.wait(); assert(model.Parent == workspace and other.CFrame == cf)
	end)
	test("Repeat Model / reopen metadata / Regenerate / native Undo / source unchanged", function()
		local c = controls({ Vector3.zero, Vector3.new(20, 0, 0) })
		local source = Instance.new("Model"); source.Parent = fixture
		local p = part(Vector3.new(30, 5, 0)); p.Parent = source
		local q = part(Vector3.new(31, 6, 0)); q.Parent = source
		local pose, size = p.CFrame, p.Size
		local model = apply(Engine.plan(c, settings({ Mode = "Repeat", Distribution = "Count", Count = 3 }), source))
		local old = model.Output; local loaded = Engine.load(model)
		loaded.settings.Count = 5; c[2].Position += Vector3.new(0, 5, 0)
		local plan = Engine.plan(loaded.controls, loaded.settings, source, loaded.rotation)
		apply(plan, model); assert(#model.Output:GetChildren() == 5 and p.CFrame == pose and p.Size == size and #source:GetChildren() == 2)
		history:Undo(); task.wait(); assert(model.Output == old and #old:GetChildren() == 3 and p.CFrame == pose)
		history:Redo(); task.wait(); assert(#model.Output:GetChildren() == 5 and p.CFrame == pose)
	end)
	test("invalid / deleted / stale controls / settings / output limits", function()
		local c = controls({ Vector3.zero, Vector3.new(20, 0, 0) })
		reject(function() Engine.plan({ c[1], c[1] }, settings()) end)
		reject(function() Engine.plan(c, settings({ Diameter = 0 / 0 })) end)
		reject(function() Engine.plan(c, settings({ Material = "Fake" })) end)
		local plan = Engine.plan(c, settings()); c[1].Position += Vector3.one
		reject(function() Engine.apply(plan, history) end)
		plan = Engine.plan(c, settings()); c[2]:Destroy(); reject(function() Engine.apply(plan, history) end)
		local long = controls({ Vector3.zero, Vector3.new(1000, 0, 0) }); reject(function() Engine.plan(long, settings({ SegmentLength = 0.1 })) end)
	end)
	test("scripted sources rejected / external references / unavailable Undo / rollback", function()
		local c = controls({ Vector3.zero, Vector3.new(20, 0, 0) }); local source = part(Vector3.new(30, 0, 0))
		local scriptItem = Instance.new("Script"); scriptItem.Parent = source
		reject(function() Engine.plan(c, settings({ Mode = "Repeat" }), source) end); scriptItem:Destroy()
		local ref = Instance.new("ObjectValue"); ref.Value = c[1]; ref.Parent = source
		reject(function() Engine.plan(c, settings({ Mode = "Repeat" }), source) end); ref:Destroy()
		local before = #workspace:GetDescendants()
		reject(function() Engine.apply(Engine.plan(c, settings()), { TryBeginRecording = function() return nil end }) end)
		assert(#workspace:GetDescendants() == before)
		local badHistory = { TryBeginRecording = function() return "test" end, FinishRecording = function(_, _, operation) if operation == Enum.FinishRecordingOperation.Commit then error("Injected failure") end end }
		reject(function() Engine.apply(Engine.plan(c, settings()), badHistory) end); assert(#workspace:GetDescendants() == before)
		local model = apply(Engine.plan(c, settings())); local old = model.Output
		reject(function() Engine.apply(Engine.plan(c, settings({ Diameter = 1 })), badHistory, model) end); assert(model.Output == old)
	end)
	test("New Path markers / native Undo / widget mounts without project mutation", function()
		history:SetWaypoint("Marker baseline")
		local c = Engine.newPath(history, Vector3.new(0, 5, 0)); local folder = c[1].Parent
		history:Undo(); task.wait(); assert(folder.Parent == nil)
		history:Redo(); task.wait(); assert(folder.Parent == workspace and #c == 4); folder:Destroy()
		local gui = Instance.new("ScreenGui"); local before = #workspace:GetDescendants()
		local dispose = require(modules.View).mount(gui, game:GetService("Selection"), history)
		assert(gui:FindFirstChild("CurveForgeUI") and #workspace:GetDescendants() == before); dispose(); gui:Destroy()
	end)
	print(string.format("[CurveForgeTests] %d passed / %d failed", passed, failed))
	return failed == 0
end
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="10">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>