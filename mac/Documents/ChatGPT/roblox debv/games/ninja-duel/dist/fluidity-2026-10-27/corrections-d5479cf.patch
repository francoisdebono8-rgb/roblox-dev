-	Grammar = "CLEAN HITS  2 hits → toward + LMB: launch · away + LMB: sweep  |  1 hit → side + LMB: angle  |  air hit → direction + LMB: drive / spike / switch  |  away + R in a string: retreat",
-	GrammarPad = "CLEAN HITS  2 hits → toward + □: launch · away + □: sweep  |  1 hit → side + □: angle  |  air hit → direction + □: drive / spike / switch  |  away + R2 in a string: retreat",
+	Grammar = "CLEAN HITS  2 hits → new toward input + LMB: launch · away + LMB: sweep  |  1 hit → new side input + LMB: angle  |  air hit → direction + LMB: drive / spike / switch  |  away + R in a string: retreat",
+	GrammarPad = "CLEAN HITS  2 hits → new toward input + □: launch · away + □: sweep  |  1 hit → new side input + □: angle  |  air hit → direction + □: drive / spike / switch  |  away + R2 in a string: retreat",
 	HelpPad = "L move · L3 sprint   R camera · R3 lock   □ light   △ heavy   ○ dodge / escape   × jump / chase   sprint + ○ toward: chakra dash   L1 guard   L2 grab   R2 tool   R1 + R2 chakra   R1 + face: jutsu   D-pad → escape · ↓ awaken · ↑ jutsu 5",
 	PadLabel = {Light="□",Heavy="△",Dodge="○",Jump="×",Guard="L1",Modifier="R1",Grab="L2",Tool="R2",Chakra="R1 + R2",Sprint="L3",Lock="R3",Pursuit="×",Dash="L3 + ○",Substitute="D-pad →",Feint="R1 + L2",WallDetach="R1 + L1"},
 	TechniquePad = {"R1 + ×","R1 + □","R1 + △","R1 + ○","D-pad ↑"},
@@ -633,14 +633,14 @@ function Controls.comboHelp(graph,pad)
  local tool=if pad then "R2" else "R"
  local routes=graph.routes or {}
  local parts={"CLEAN HITS"}
- if routes.up then table.insert(parts,"2 hits → toward + "..light..": launch") end
- if routes.down then table.insert(parts,"2 hits → away + "..light..": sweep") end
- if routes.side then table.insert(parts,"1 hit → side + "..light..": angle") end
+ if routes.up then table.insert(parts,"2 hits → new toward input + "..light..": launch") end
+ if routes.down then table.insert(parts,"2 hits → new away input + "..light..": sweep") end
+ if routes.side then table.insert(parts,"1 hit → new side input + "..light..": angle") end
  local air={}
  if routes.airUp then table.insert(air,"toward: drive") end
  if routes.airDown then table.insert(air,"away: spike") end
  if routes.airSide then table.insert(air,"side: switch") end
- if #air&gt;0 then table.insert(parts,"Air hit + "..light.." → "..table.concat(air," / ")) end
