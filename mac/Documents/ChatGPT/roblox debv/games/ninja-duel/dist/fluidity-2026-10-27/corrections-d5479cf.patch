index 0000000..9d3e8f0
--- /dev/null
+++ b/games/ninja-duel/tests/Fluidity.spec.luau
@@ -0,0 +1,142 @@
+-- Movement transitions: gameplay owns a trajectory until it ends or is interrupted.
+local H=require('./Harness')
+local V=H.V
+local Brawler=H.load('Server/Brawler')
+local passed=0
+local function test(name,fn)
+ local ok,err=pcall(fn)
+ if not ok then error(name..': '..tostring(err),0) end
+ passed+=1;print('PASS '..name)
+end
+local function airborne()
+ local c,a,b=H.duel('Lion','Flashstep')
+ c:relocate(a,V.new(0,15,5));c:relocate(b,V.new(0,17,0))
+ a.root.CFrame=H.C.lookAt(a.root.Position,V.new(0,15,0))
+ b.root.CFrame=H.C.lookAt(b.root.Position,V.new(0,17,5))
+ a.airborne=true;b.airborne=true
+ a.root.AssemblyLinearVelocity=V.new(8,24,-12)
+ b.root.AssemblyLinearVelocity=V.new(0,20,0)
+ return c,a,b
+end
+
+test('an unconfirmed air swing keeps the leap instead of magnetising to a freely jumping rival',function()
+ local c,a,b=airborne()
+ assert(c:request(a,'Attack'))
+ assert(a.airHold<=c.now,'a free air swing freezes the leap')
+ c.now+=1/60;c:updateActor(a,1/60)
+ assert(a.root.AssemblyLinearVelocity.Y>0,'the attack erased the rising velocity')
+ assert(math.abs(a.root.Position.Y-15)<.05 and a.root.Position.Z>=4.75,'the swing added attraction beyond its existing momentum')
+end)
+
