 function Brawler.contextual(c,a,only)
  local x=Brawler.situation(c,a)
  if not x then return nil end
- return ActionContext.resolve(x,Brawler.graph(a),Attacks,only)
+ local move,tag=ActionContext.resolve(x,Brawler.graph(a),Attacks,only)
+ -- Walking into range must not silently choose a heavy knee, flying kick or
+ -- launch. Those remain explicit heavy/sprint/confirmed-route decisions.
+ if not only and move and not x.airborne and not a.sprinting then
+  local reaction=Attacks[move].reaction
+  if tag=="run" or tag=="wall" or ((tag=="close" or tag=="aside" or tag=="flank") and (reaction=="Juggled" or reaction=="Launched" or reaction=="Knockback" or reaction=="Knockdown")) then return nil end
+ end
+ return move,tag
 end
 local WALL_ONLY={wall=true}
 -- The strike a riposte (or a counter stance's answer) comes out as: the
@@ -5495,6 +5502,11 @@ end
 -- every packet, so a stick released (or crossing the threshold) a moment
 -- before the press still picks the route it was pushed for.
 function Brawler.observe(c,a)
+ local move=a.steering or a.move or Vector3.zero
+ local previous=a.routeMove or Vector3.zero
+ -- Physical axes stay fixed even when the camera or target circles the body.
+ if move.Magnitude&gt;.15 and (previous.Magnitude&lt;=.15 or previous.Unit:Dot(move.Unit)&lt;.7) then a.routeChangedAt=c.now end
+ a.routeMove=move
  a.intentAt=c.now
  local dir,sideSign=Brawler.classify(a,a.move or Vector3.zero)
  if dir then a.intentMemory={dir=dir,side=sideSign,at=c.now} end
@@ -5515,6 +5527,15 @@ end
 -- Presses made while the body is committed wait for its outcome: a swing
 -- before its contact is known, a chase or a dash before the arrival, a
 -- teleport before it lands.
+-- Holding forward to approach is movement, not a request to launch. A
